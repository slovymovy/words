                        "entry_id": "3b6da3ec-cc09-3d69-a0ef-8f70ec4cad7d",
                        "glosses": [
                            "Verständigung verschiedener Unternehmen über die Absatzmenge und/oder den Preis für Güter"
                        ],
                        "tags": [],
