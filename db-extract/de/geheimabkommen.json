                                "example_id": "375622cd-2178-4bda-a25d-19c4acce72dd",
                                "sense_id": "6176848b-53dc-3433-8c22-5d0ad479433a",
                                "text": "„Die Briten hatten nämlich mit den Franzosen und den Russen ein Geheimabkommen über eine Aufteilung des Nahen Ostens geschlossen.“"
                            },
                            {
                                "example_id": "96f0106e-7843-4e57-9f68-57ffab17571f",
                                "sense_id": "6176848b-53dc-3433-8c22-5d0ad479433a",
                                "text": "„Ein Geheimabkommen der europäischen Notenbanken sorgt für Wirbel. Still und leise sollen die Währungshüter Finanzpapiere im Wert von mehr als 500 Milliarden Euro aufgekauft haben.“"
                            }
                        ],
