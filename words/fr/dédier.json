{
    "word_family": [
        "dédicace",
        "dédicacer",
        "dédicataire",
        "dédicatoire"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef5f091d-5831-3e66-ad10-6e63756c0eae",
                    "sense_definition": "Inscrire ou adresser une œuvre artistique ou littéraire en hommage ou en témoignage d'affection à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hommage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain a choisi de <w>dédier</w> son premier roman à ses parents pour les remercier."
                        },
                        {
                            "text": "Elle a décidé de <w>dédier</w> cette chanson émouvante à son public fidèle."
                        }
                    ],
                    "synonyms": [
                        "dédicacer"
                    ],
                    "common_phrases": [
                        "dédier un livre",
                        "dédier une chanson"
                    ]
                },
                {
                    "sense_id": "7bb50c88-d953-3778-a5f8-4427f885e998",
                    "sense_definition": "Consacrer entièrement du temps, des ressources ou des efforts à une tâche ou à une cause.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consécration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chercheur a choisi de <w>dédier</w> sa carrière entière à la protection de l'environnement."
                        },
                        {
                            "text": "La direction de l'entreprise veut <w>dédier</w> ces nouvelles ressources au projet d'innovation."
                        }
                    ],
                    "synonyms": [
                        "consacrer",
                        "vouer"
                    ],
                    "common_phrases": [
                        "dédier son temps",
                        "dédier des ressources",
                        "dédier sa vie"
                    ]
                },
                {
                    "sense_id": "3ead6a85-7fc8-392e-897c-bdc007f4c5b0",
                    "sense_definition": "Consacrer solennellement un lieu, un autel ou un édifice au culte divin ou à un saint.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "culte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'évêque est venu spécialement dans le village pour <w>dédier</w> la nouvelle église."
                        },
                        {
                            "text": "Les habitants ont choisi de <w>dédier</w> cette ancienne chapelle à leur saint patron."
                        }
                    ],
                    "synonyms": [
                        "consacrer"
                    ],
                    "antonyms": [
                        "profaner"
                    ],
                    "common_phrases": [
                        "dédier une église",
                        "dédier un autel",
                        "dédier une chapelle"
                    ]
                }
            ]
        }
    ]
}