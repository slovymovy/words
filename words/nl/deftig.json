{
    "word_family": [
        "deftigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f316c078-d1d1-3c63-bd2b-9de64042b2e0",
                    "sense_definition": "keurig en goed verzorgd in uiterlijk of gedrag",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "netjes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij ziet er altijd erg <w>deftig</w> uit in zijn nieuwe pak.",
                            "target_lang_translations": {
                                "en": "He always looks very <w>smart</w> in his new suit.",
                                "fr": "Il a toujours l'air très <w>élégant</w> dans son nouveau costume."
                            }
                        },
                        {
                            "text": "Voor het diner trokken ze hun <w>deftige</w> kleren aan.",
                            "target_lang_translations": {
                                "en": "They put on their <w>formal</w> clothes for the dinner.",
                                "fr": "Pour le dîner, ils ont mis leurs vêtements <w>chics</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "chic"
                    ],
                    "common_phrases": [
                        "deftige kleren",
                        "deftig gekleed"
                    ],
                    "target_lang_definitions": {
                        "en": "neat and well-groomed in appearance or behavior",
                        "fr": "Soigné, élégant et convenable dans son apparence ou son comportement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "smart",
                                "target_lang_sense_clarification": "well-dressed and neat"
                            },
                            {
                                "target_lang_word": "proper",
                                "target_lang_sense_clarification": "behaving in a correct and respectable way"
                            },
                            {
                                "target_lang_word": "respectable",
                                "target_lang_sense_clarification": "having a good reputation and appearance"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "chic",
                                "target_lang_sense_clarification": "élégant et soigné dans la tenue ou l'allure"
                            },
                            {
                                "target_lang_word": "élégant",
                                "target_lang_sense_clarification": "qui a de la distinction et de la grâce vestimentaire"
                            },
                            {
                                "target_lang_word": "soigné",
                                "target_lang_sense_clarification": "fait ou habillé avec recherche et propreté"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01fad5b6-2edd-31c7-a6e1-e2562258bdb6",
                    "sense_definition": "behorend tot of passend bij een hogere sociale klasse",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij wonen in een <w>deftige</w> buurt met grote villa's.",
                            "target_lang_translations": {
                                "en": "They live in a <w>posh</w> neighborhood with large villas.",
                                "fr": "Ils habitent dans un quartier <w>huppé</w> avec de grandes villas."
                            }
                        },
                        {
                            "text": "In die <w>deftige</w> buurt staan alleen maar dure huizen.",
                            "target_lang_translations": {
                                "en": "In that <w>upscale</w> neighborhood, there are only expensive houses.",
                                "fr": "Dans ce quartier <w>bourgeois</w>, il n'y a que des maisons chères."
                            }
                        }
                    ],
                    "synonyms": [
                        "voornaam"
                    ],
                    "common_phrases": [
                        "deftige buurt",
                        "deftige familie"
                    ],
                    "target_lang_definitions": {
