                    }
                ],
                "senses": [
                    {
                        "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                        "entry_id": "491e554c-dd58-3ca0-9237-feeaf9d351cb",
                        "glosses": [
                            "Abnahme der Zahl der Arten, Aussterben von Pflanzen, Tieren und Pilzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d780016-7206-45f9-986c-8d62b04a750b",
                                "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                                "text": "„Klimakrise und Artenschwund zeigen, dass wir unser Verhältnis zur Natur verändern müssen.“"
                            },
                            {
                                "example_id": "11425912-3325-4ba9-92a7-36b04f2d63f2",
                                "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                                "text": "„Die Hauptursache für den Artenschwund ist noch immer der Lebensraumverlust.“"
                            },
                            {
                                "example_id": "3d80c3e6-82c3-4e2f-89ef-9d3c3a9ca186",
                                "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                                "text": "„Forscher sind sich einig: Wir erleben den größten Artenschwund seit dem Aussterben der Dinosaurier.“"
                            },
                            {
                                "example_id": "b2c404a5-1acd-4214-9093-fd53041e4d23",
                                "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                                "text": "„Das Ziel der UN-Konvention aus dem Jahr 2002, den Artenschwund bis 2010 zu bremsen, wird klar verfehlt werden, warnt die Weltnaturschutzunion IUCN.“"
                            },
                            {
                                "example_id": "7dcd4427-06b3-4921-beaf-0e4565786ddf",
                                "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                                "text": "„Den 9,3 Milliarden US-Dollar für Artenschutz stehen aber rund 500 Milliarden gegenüber, die jährlich in fossile Energie und andere Aktivitäten fließen, die den Artenschwund befördern, heißt es in dem Bericht.“"
                            },
                            {
                                "example_id": "29bd52f7-bf79-4896-a010-7fff967816c9",
                                "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                                "text": "„die Zahl der Vögel sinkt seit Jahren deutlich. Nun zeigt eine neue Studie, dass auch die Lichtverschmutzung markant zum Artenschwund beiträgt.“"
                            },
                            {
                                "example_id": "36bf022b-68f9-40c1-88b2-88068463385d",
                                "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                                "text": "„Unter den Opfern des Artenschwunds sind so alltägliche Insekten wie Wespen und Bienen.“"
                            },
                            {
                                "example_id": "608db2d0-9c93-495e-9676-609b2f16a0ed",
                                "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                                "text": "„Viele Landschaftsbestandteile sind bereits zerstört, der Artenschwund an Tieren, Pflanzen und Pilzen ist dramatisch.“"
                            },
                            {
                                "example_id": "a8c4c6b7-ab54-4281-a413-fdaf1bb256bb",
                                "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                                "text": "[Schlagzeile:] „Biodiversität – Besonders rascher Artenschwund im Süßwasser“"
                            },
                            {
                                "example_id": "9777c47b-db99-47ab-bd6d-0ce7e6178fac",
                                "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                                "text": "„Dieser plattentektonische Prozess hatte gravierende Folgen für Atmosphäre, Klima und Biosphäre und gilt allgemein als primäre Ursache für das Massenaussterben mit einem Artenschwund von annähernd 70 bis 75 Prozent.“"
                            },
                            {
                                "example_id": "8260525e-19d8-4e2e-86a5-3e45be300f3f",
                                "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                                "text": "„So könnten bis zum Jahr 2100 knapp 40 Prozent der weltweiten Landflächen von der einsetzenden Umwandlung der bestehenden Klimate betroffen sein, mit der Gefahr von umfangreichem Artenschwund und großflächiger Entwaldung.“"
                            },
                            {
                                "example_id": "14f8b652-74bf-4e62-bb53-a85be63c6342",
                                "sense_id": "76f143c4-bfe8-3283-888e-392312285369",
                                "text": "„Für Hermann Hötker, Leiter des Michael-Otto-Instituts im NABU, ist die Situation dramatisch: »Der Artenschwund in landwirtschaftlich genutzten Flächen ist tatsächlich eines der größten Umweltprobleme, das wir hierzulande beobachten können.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
