                        "examples": [
                            {
                                "example_id": "87290725-b855-47ee-9865-810c298030df",
                                "sense_id": "41854658-a1f4-3eef-a6ef-d9dcd7aac481",
                                "text": "„Leitende Angestellte aus Singapur, die duschen und in schönster Ruhe scheißen wollen, mit allen Geräuscheffekten, ohne andere Reisende sehen und hören zu müssen, die dasselbe tun, können hierher kommen und alles der Firmenkreditkarte belasten.“"
                            },
                            {
                                "example_id": "4d7750fd-697c-48a0-a892-0d9cae5538e7",
                                "sense_id": "41854658-a1f4-3eef-a6ef-d9dcd7aac481",
                                "text": "„Den Staatsanwalt interessiert, warum M., obwohl er die Firmenkreditkarte für Privates strapaziert hatte, abgefertigt wurde.“"
                            }
                        ],
