                                "target_lang_sense_clarification": "obecné zařízení na chytání zvířat"
                            },
                            {
                                "target_lang_word": "oko",
                                "target_lang_sense_clarification": "smyčka na chytání zvěře"
                            },
                            {
                                "target_lang_word": "osidlo",
                                "target_lang_sense_clarification": "archaičtější výraz pro past"
                            }
                        ],
                        "zh": [
