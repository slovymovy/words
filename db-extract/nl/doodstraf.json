                            }
                        ]
                    },
                    {
                        "translation_id": "dd894356-3be8-4c01-8520-8c21f2c3173b",
                        "source_entry_id": "0e6cef0f-3abc-3a6a-9199-6395dd87d414",
                        "source_sense_id": "6551f68a-d2dc-363a-9188-352766e1bd00",
                        "source_sense_description": "als straf gedood worden",
                        "target_lang_word": "death penalty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "death penalty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "693efe5a-2c84-327b-82f3-9ca6ddc10983",
                                        "entry_id": "7d3d3d26-0da2-3de5-9ddd-4935b7260bfa",
                                        "glosses": [
                                            "A punishment in which the offender is put to death by the state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb88dbb5-eac2-4035-8d89-dc78aeb6acc6",
                                                "sense_id": "693efe5a-2c84-327b-82f3-9ca6ddc10983",
                                                "text": "And if you would like one more fact about this worthy, he was responsible for an Act on the statute book abolishing the death penalty for cattle rustling."
                                            },
                                            {
                                                "example_id": "9c93a7b7-10eb-4cef-8a47-00eb9a5de8b8",
                                                "sense_id": "693efe5a-2c84-327b-82f3-9ca6ddc10983",
                                                "text": "Joe Biden deserves the death penalty and Jonald Trump bad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40aecd09-c0f4-4a07-a0c9-5528c1eba495",
                        "source_entry_id": "0e6cef0f-3abc-3a6a-9199-6395dd87d414",
                        "source_sense_id": "6551f68a-d2dc-363a-9188-352766e1bd00",
                        "source_sense_description": "als straf gedood worden",
                        "target_lang_word": "peine de mort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peine de mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd399375-d596-3c76-a4c8-ba4bb823a380",
                                        "entry_id": "627b4d21-1b6f-3cad-b813-9bd7ee0d3f4e",
                                        "glosses": [
                                            "Peine capitale, châtiment qui consiste dans la suppression de la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fcff6ce-f1a0-43a9-9256-8ca2d1df60bc",
                                                "sense_id": "dd399375-d596-3c76-a4c8-ba4bb823a380",
                                                "text": "Je viens prier non les dieux, mais les législateurs, […], d’effacer du code des Français les lois de sang qui commandent des meurtres juridiques, […]. Je veux leur prouver, nᵒ 1 que la peine de mort est essentiellement injuste ; nᵒ 2 qu’elle n’est pas la plus réprimante des peines, et qu'elle multiplie les crimes beaucoup plus qu’elle ne les prévient."
                                            },
                                            {
                                                "example_id": "b15debc4-3d95-453a-9e67-3deb508db0ac",
                                                "sense_id": "dd399375-d596-3c76-a4c8-ba4bb823a380",
                                                "text": "[…] pour ma part, j’écoutais avidement : cette question de la peine de mort appliquée, soit par la corde, soit par le fer, soit par le poison, m’ayant toujours singulièrement préoccupé comme question d’humanité."
                                            },
                                            {
                                                "example_id": "58a2a8bf-f861-42d5-8c16-bd5fb9459c45",
                                                "sense_id": "dd399375-d596-3c76-a4c8-ba4bb823a380",
                                                "text": "Le président Grévy, qui était fort intelligent, avait aboli virtuellement la peine de mort, en ne l’appliquant jamais. Que ses successeurs n’ont-ils imité son exemple !"
                                            },
                                            {
                                                "example_id": "dd184379-5c1d-473d-b93c-c1f0f135d66d",
                                                "sense_id": "dd399375-d596-3c76-a4c8-ba4bb823a380",
                                                "text": "— La peine de mort est devenue une pratique intolérable, depuis qu’on n’y attache plus l’idée d’expiation, qui est toute théologique."
                                            },
                                            {
                                                "example_id": "c229d7b0-1b8f-46ab-b0d8-3cbf94b2aca8",
                                                "sense_id": "dd399375-d596-3c76-a4c8-ba4bb823a380",
                                                "text": "Un édit alla jusqu’à prononcer la peine de mort contre les trafiquants."
                                            },
                                            {
                                                "example_id": "813bd241-f68e-4437-abc0-bde33fd2f983",
                                                "sense_id": "dd399375-d596-3c76-a4c8-ba4bb823a380",
                                                "text": "La peine de mort fut prononcée en Nébouzan en 1596, en la personne de Jean Beauliès, cagot de Cieutat, pour meurtre, assassinat, incendie, […]. Il fut mis sur un tombereau, la hart au cou et conduit sur la place publique de Cieutat où a été dressé la potence et où il doit être pendu et étranglé."
                                            },
                                            {
                                                "example_id": "846e1719-fbb8-4cb0-87e6-7c11a655e3e3",
                                                "sense_id": "dd399375-d596-3c76-a4c8-ba4bb823a380",
                                                "text": "Alors que les régimes démocratiques de par le monde continuent à abolir la peine de mort ou à cesser d’y recourir, Donald Trump et William Barr font en sorte que les États-Unis figurent maintenant aux côtés de régimes autoritaires comme la Chine, l’Iran ou l’Arabie saoudite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
