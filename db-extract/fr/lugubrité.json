                        "glosses": [
                            "Caractère de ce qui est lugubre."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f7270916-d211-4b2b-88ed-20f08c7d9d92",
                                "sense_id": "2e58ce6c-5112-3846-a174-11ed10e2a364",
                                "text": "[…] ses feuilles manquent de symétrie et sont à peine aussi larges que celles de la belladonne, elle n’offre pas comme celle-ci une lugubrité repoussante, on ne peut pas dire que sa couleur indique sa vénénosité."
                            },
                            {
                                "example_id": "029703f9-2a17-4ad6-80fb-223a4d0f37ae",
                                "sense_id": "2e58ce6c-5112-3846-a174-11ed10e2a364",
                                "text": "Le vieux lac n'avait rien perdu de sa lugubrité, ni le pensionnat de sa sinistritude."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa0ad44d-8966-4c92-a9c9-dace4e867ad8",
                        "source_entry_id": "f3580dcc-1c33-3fd5-a0cd-e2d1605d15e9",
