                                "example_id": "c4e30048-81e6-44cf-ba0d-4cc13501c6d9",
                                "sense_id": "7a9ba290-7079-317c-89a3-1babe72c5e6c",
                                "text": "„Als er auf die Straße hinaushumpelte, kroch einer der Männer, auf die er von der Hotelveranda aus geschossen hatte, auf den Bürgersteig zu.“"
                            },
                            {
                                "example_id": "9d6b118c-01e6-4084-b202-832d5cf4b2a1",
                                "sense_id": "7a9ba290-7079-317c-89a3-1babe72c5e6c",
                                "text": "„Wir haben gesucht, hatte mir Violet am Tag zuvor gesagt, als wir uns für einen gemeinsamen Eistee auf der Hotelveranda niedergelassen hatten.“"
                            }
                        ],
