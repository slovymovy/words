                    {
                        "translation_id": "af3ab62d-ed10-438c-bd6b-16782e7732d4",
                        "source_entry_id": "55fc90ba-debd-3190-9ec6-bc265ef4df90",
                        "source_sense_description": "characteristic of a traitor",
                        "target_lang_word": "untreu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untreu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3af97f02-e095-3cd3-95da-78730bf4c007",
                                        "entry_id": "ae41446a-d5ec-3d77-8fda-f4939f3a851d",
                                        "glosses": [
                                            "mit anderen sexuelle Beziehungen unterhaltend"
                                        ],
                                        "tags": [
                                            "in einer dauernden Partnerbeziehung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85a9b797-eed4-4245-a788-fa14d38d079a",
                                                "sense_id": "3af97f02-e095-3cd3-95da-78730bf4c007",
                                                "text": "Schon nach zwei Wochen wurde der frisch Vermählte seiner Gattin untreu."
                                            },
                                            {
                                                "example_id": "4a457ea0-be4a-4a27-8e03-9f56b3fcf79c",
                                                "sense_id": "3af97f02-e095-3cd3-95da-78730bf4c007",
                                                "text": "»Männer haben Angst, dass ihre Frauen ihnen untreu werden könnten, wenn sie sexuell nicht befriedigt werden«, sagt Hebba Kotb."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bdaba072-ab1e-39aa-8285-796eca28fc5b",
                                        "entry_id": "ae41446a-d5ec-3d77-8fda-f4939f3a851d",
                                        "glosses": [
                                            "für eine früher wichtige Person oder Sache nicht mehr eintretend, an diesen nicht mehr interessiert"
                                        ],
                                        "tags": [
                                            "auch adverbiell",
                                            "meist in Verbindung mit einem Dativobjekt und dem Verb werden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d2c468f-c597-499c-a073-e29e9e036e46",
                                                "sense_id": "bdaba072-ab1e-39aa-8285-796eca28fc5b",
                                                "text": "Péter Esterházy: Oh, ich bin dem Fußball schon etwas untreu geworden."
                                            },
                                            {
                                                "example_id": "3901a4a7-193e-4095-b6c7-24dc295e81d4",
                                                "sense_id": "bdaba072-ab1e-39aa-8285-796eca28fc5b",
                                                "text": "In Flensburg sind selbst die treuesten Freunde ihrer Oper zuletzt untreu geworden, im Besucherbuch wurde der Ton rau."
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "16c45de4-c79d-3564-94d4-136850dfa7fb",
                                        "entry_id": "ae41446a-d5ec-3d77-8fda-f4939f3a851d",
                                        "glosses": [
                                            "eine Verpflichtung nicht einhaltend"
                                        ],
                                        "tags": [
                                            "auch adverbiell",
                                            "meist in Verbindung mit einem Dativobjekt und dem Verb werden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475e64db-aabb-4081-9b75-b12ea79abd2e",
                                                "sense_id": "16c45de4-c79d-3564-94d4-136850dfa7fb",
                                                "text": "Der Abt jedenfalls glaubt, er würde seinem Auftrag, christliche Botschaften zu verbreiten, \"untreu\", wenn er die modernen Medieninstrumente dafür nicht nutzte."
                                            },
                                            {
                                                "example_id": "2c9eac0a-57d6-4051-8c87-dff71385fd3f",
                                                "sense_id": "16c45de4-c79d-3564-94d4-136850dfa7fb",
                                                "text": "Dirigiert von den Fahndern soll ein damaliger untreuer Bankangestellter ein Maulwurf gewesen sein, der auftragsgemäß geheime Unterlagen der Bank besorgt habe."
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "2511eedd-6918-3fc5-a83b-b8887e14bb48",
                                        "entry_id": "ae41446a-d5ec-3d77-8fda-f4939f3a851d",
                                        "glosses": [
                                            "gegen seine Ideale, Prinzipien oder Überzeugungen handelnd"
                                        ],
                                        "tags": [
                                            "auch adverbiell",
                                            "meist in Verbindung mit einem Dativobjekt und dem Verb werden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ebbd6fb-8c23-4d0e-b3f6-ea57e4a4ec39",
                                                "sense_id": "2511eedd-6918-3fc5-a83b-b8887e14bb48",
                                                "text": "Seine Frau beklagte, er werde dort seiner Begabung untreu, doch was am Schreibtisch entstand, gibt ihr unrecht."
                                            },
                                            {
                                                "example_id": "529f9c74-a616-40bc-8a50-052ca91a318c",
                                                "sense_id": "2511eedd-6918-3fc5-a83b-b8887e14bb48",
                                                "text": "Ohne den Dialekt wäre sich der Südbadener untreu."
                                            }
                                        ],
                                        "sense_index_json": "\"2c\""
                                    }
                                ]
                            }
                        ]
