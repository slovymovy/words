                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a3516c-d796-4078-9e58-8ac1a8cc1a0c",
                                "sense_id": "06d0b46d-d4fc-3112-a598-351b4d4c899f",
                                "text": "„Hier sind sie zu Hause, wandern in Familienverbänden umher und gehen, wohin sie wollen.“"
                            },
                            {
                                "example_id": "e71a793e-5cc1-4b00-b673-2b377e185672",
                                "sense_id": "06d0b46d-d4fc-3112-a598-351b4d4c899f",
                                "text": "„Versierte Baumarkt-Kunden kommen im Familienverband zum Einkauf und riegeln die Regalreihe, in der sich gerade ein Verkäufer befindet, handstreichartig von beiden Seiten ab.“"
                            }
                        ],
