                ],
                "senses": [
                    {
                        "sense_id": "7f4d57f4-d25b-321c-a52d-742c4cff976f",
                        "entry_id": "1135d44a-6d29-310c-9841-084a8168faad",
                        "glosses": [
                            "(naturnahe) Fläche, auf der viele Wildblumen wachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "299df756-6b58-457c-9323-7f2655c11345",
                                "sense_id": "7f4d57f4-d25b-321c-a52d-742c4cff976f",
                                "text": "„[…] Eine Wildblumenwiese anzulegen, ist keine große Sache.“"
                            },
                            {
                                "example_id": "9e38fc37-a16f-4dce-9abd-12da2bdf1088",
                                "sense_id": "7f4d57f4-d25b-321c-a52d-742c4cff976f",
                                "text": "„In Kooperation mit dem NABU (Naturschutzbund Deutschland) sollen eine Streuobstwiese, Wildblumenwiesen, Insektenhotels und Nistkästen angelegt werden.“"
                            },
                            {
                                "example_id": "90132226-d1b3-4852-846e-4bc611fa91b8",
                                "sense_id": "7f4d57f4-d25b-321c-a52d-742c4cff976f",
                                "text": "„Um ideale Bedingungen für eine Wildblumenwiese zu schaffen, wird […] ein magerer, nährstoffarmer Boden benötigt – anders als beim Intensivrasen, der am besten auf einem nährstoffreichen Boden gedeiht.“"
                            },
                            {
                                "example_id": "8eb4aaa0-d807-45c4-8688-675694d0f6b3",
                                "sense_id": "7f4d57f4-d25b-321c-a52d-742c4cff976f",
                                "text": "„Da blühen jetzt Dahlien und Kapuzinerkresse, ein Zierkürbis wächst neben einer kleinen Wildblumenwiese, Feuerbohnen neben Rosen.“"
                            },
                            {
                                "example_id": "f8bb623d-cb67-4499-acad-3674fd7032bd",
                                "sense_id": "7f4d57f4-d25b-321c-a52d-742c4cff976f",
                                "text": "„Damit unterstützen Sie die Artenvielfalt und die Insekten in Ihrer Umgebung. Pflegearm sind Wildblumenwiesen und -säume außerdem.“"
                            },
                            {
                                "example_id": "3fad0fda-3ca4-449f-840d-dc2be796e135",
                                "sense_id": "7f4d57f4-d25b-321c-a52d-742c4cff976f",
                                "text": "„[…] viel wertvoller ist […] eine Hecke aus heimischen Sträuchern, eine Wildblumenwiese oder eine kleine Brennnesselecke.“"
                            },
                            {
                                "example_id": "57d3002b-2e2c-43b0-8059-cfa8a4f03ff5",
                                "sense_id": "7f4d57f4-d25b-321c-a52d-742c4cff976f",
                                "text": "„Eine Wildblumenwiese sorgt nicht nur für eine bunte Blütenvielfalt, sondern lockt auch viele Nützlinge an.“"
                            },
                            {
                                "example_id": "b38197ac-39d0-46c1-a4e7-a86b36980e9d",
                                "sense_id": "7f4d57f4-d25b-321c-a52d-742c4cff976f",
                                "text": "„Wildblumenwiesen machen nicht besonders viel Arbeit und müssen maximal zwei Mal im Jahr gemäht werden - einmal im Sommer und ein zweites Mal im Herbst.“"
                            },
                            {
                                "example_id": "ed704921-9e57-41ae-ace6-2d396ad3d662",
                                "sense_id": "7f4d57f4-d25b-321c-a52d-742c4cff976f",
                                "text": "Eine Wildblumenwiese sollten Sie 1-2 x im Jahr auf eine Höhe von 8 -10 cm mähen und das Mähgut abfahren."
                            },
                            {
                                "example_id": "82ff6676-1841-4e08-bd74-1aafe1217924",
                                "sense_id": "7f4d57f4-d25b-321c-a52d-742c4cff976f",
                                "text": "„Eine große Wildblumenwiese ist schön anzusehen. Für kleinere Gärten ist sie aber oft unpraktisch. Die Lösung: eine kleine Wildblumeninsel in der Rasenfläche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
