                "senses": [
                    {
                        "sense_id": "be42a564-42b6-39ea-91f6-b96f3a1d9bf4",
                        "entry_id": "725cf2b3-5c18-39e9-89a8-f1ae6033dc8e",
                        "glosses": [
                            "chinesische Provinz im Nordwesten der Volksrepublik China"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af471aa-04f9-4351-a5ca-c0339f38aaca",
                                "sense_id": "be42a564-42b6-39ea-91f6-b96f3a1d9bf4",
                                "text": "Lanzhou ist die Hauptstadt von Gansu."
