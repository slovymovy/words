                        "target_lang_word": "café à chats",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "café à chats",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19c214c9-4bb6-3040-a662-bb0b8f2e539d",
                                        "entry_id": "8ea1125c-cdb6-3e83-ade6-ea848ccc18c3",
                                        "glosses": [
                                            "Café qui héberge des chats avec lesquels les clients peuvent interagir tout en dégustant une boisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe56ec40-4c90-4f25-ae8a-f985433a76ba",
                                                "sense_id": "19c214c9-4bb6-3040-a662-bb0b8f2e539d",
                                                "text": "Une lettre l’informait que le bracelet provenait d’un temple de Pékin et que le gilet était un cadeau pour Galileo, trouvé dans un café à chats où elles étaient allées à Hong Kong."
                                            },
                                            {
                                                "example_id": "bfd24e1c-12c2-4cb4-a399-8274b5683c92",
                                                "sense_id": "19c214c9-4bb6-3040-a662-bb0b8f2e539d",
                                                "text": "Outre les bars à oxygène pour se ressourcer, les cafés à chats pour savourer son thé macha avec une boule de poil ronronnante sur les genoux, on s’attarde sur les cosmétiques !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
