                    {
                        "sense_id": "fe05a058-227c-3e34-a3e8-f07b64c49ac6",
                        "entry_id": "fe5eb65a-8151-349f-afc0-7dd15f9f5c49",
                        "glosses": [
                            "eine runde Vorführfläche im Zirkus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c49c9f40-24ad-4e47-9b4d-a9244baf4dc8",
                                "sense_id": "fe05a058-227c-3e34-a3e8-f07b64c49ac6",
                                "text": "Ein sibirischer Tiger hat einen Dompteur in der Manege angegriffen und zerfleischt."
                            },
                            {
                                "example_id": "9dad23ab-da12-4b9a-aacc-04a6b61869f0",
                                "sense_id": "fe05a058-227c-3e34-a3e8-f07b64c49ac6",
                                "text": "„Also gehen beide in die Manege.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1adca6c-4369-4f83-ad0f-2c849991af55",
