                    {
                        "sense_id": "315644e7-1b9f-3d92-94cb-84393803e3db",
                        "entry_id": "62bc393d-5db3-341d-892b-ff2c9e2b1875",
                        "glosses": [
                            "Nepenthes vleesetende plant die insecten vangt in een met een vloeistof gevulde beker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c966864-fda2-40fc-bdba-b5a2a0c50c9b",
                                "sense_id": "315644e7-1b9f-3d92-94cb-84393803e3db",
                                "text": "Thorogood heeft zijn verhalen rijkelijk geïllustreerd, met prachtige kleurrijke prenten van de beschreven planten en hun bloemen. Zo sta je zelfs nog zonder een woord gelezen te hebben naast hem op een bergmassief op Borneo, waar de mist tussen de bomen opstijgt en druppels water langs de bekerplanten omlaagglijden."
                            },
                            {
                                "example_id": "23b7fa98-6c05-47af-87d2-457154b4cced",
                                "sense_id": "315644e7-1b9f-3d92-94cb-84393803e3db",
                                "text": "Vleesetende bekerplanten zoals deze Nepenthes veitchii zijn voorbeelden van fytotelmata, met water gevulde holten in planten die een miniatuur-ecosysteempje bevatten."
                            }
                        ]
                    }
