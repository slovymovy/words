                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8942c6d8-dab7-490a-8403-26d4577de293",
                        "source_entry_id": "a86060a1-d200-3e7f-aea3-a2eaeb6f3b42",
                        "target_lang_word": "proportional",
                        "target_lang_code": "en",
