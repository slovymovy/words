                "senses": [
                    {
                        "sense_id": "510a0f05-694d-3f78-93f9-b61c1802b4e3",
                        "entry_id": "0ba0ddeb-a660-3d58-8b0f-0483416559fb",
                        "glosses": [
                            "Vrille par laquelle des plantes s'accrochent à des supports."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "decaa08b-b985-4150-9134-a3c3449f3083",
                                "sense_id": "510a0f05-694d-3f78-93f9-b61c1802b4e3",
                                "text": "Les paysans disposent de dizaines de mots pour désigner les petits tortillons verts grâce auxquels la vigne s’accroche à son support : cornes , filets , martinets , fourchettes , nilles , vrilles , vrillons , etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cdbd4c4-2d74-3158-9d8e-f9eb012cded0",
                        "entry_id": "0ba0ddeb-a660-3d58-8b0f-0483416559fb",
                        "glosses": [
                            "Manchon mobile qui entoure la poignée d'une manivelle pour protéger la main du frottement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ef6a36d-2c3a-4400-9aa2-3ba5ebc308ca",
                                "sense_id": "9cdbd4c4-2d74-3158-9d8e-f9eb012cded0",
                                "text": "La manivelle de fer conduit la chaleur et frotte la paume, la main en est deux fois blessée. Il suffit d’emboutir une nille sur la poignée, un manchon mobile désolidarisé de l’arbre pour que la main s’en trouve bien."
                            }
                        ]
                    },
                    {
                        "sense_id": "df704a75-17fc-3c20-ab92-279258c2f46e",
                        "entry_id": "0ba0ddeb-a660-3d58-8b0f-0483416559fb",
                        "glosses": [
                            "Pièce métallique en forme de X qui unit la meule supérieure à son axe dans un moulin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbfcbea1-86a2-4c94-9ed0-80492a3255d9",
                                "sense_id": "df704a75-17fc-3c20-ab92-279258c2f46e",
                                "text": "La nille étant placée pardessus la meule donnera l'avantage de laisser la meule pleine par dessous , en sorte que le grain commencera à se moudre en entrant..."
                            }
                        ]
                    },
                    {
                        "sense_id": "981cf340-f762-310b-8377-7da079057e8b",
                        "entry_id": "0ba0ddeb-a660-3d58-8b0f-0483416559fb",
                        "glosses": [
                            "Articulation des doigts, phalange.  ^([1])"
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "dd43cfa5-d21c-4ff2-b7cb-8066a645a079",
                                "sense_id": "981cf340-f762-310b-8377-7da079057e8b",
                                "text": "J'ai les nilles enflées depuis deux jours."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e005c46-cb4e-3832-b763-cc654fc86ad7",
                        "entry_id": "0ba0ddeb-a660-3d58-8b0f-0483416559fb",
                        "glosses": [
                            "Petit piton de métal où passe une clavette pour tenir vitres et surtout vitraux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e44b872-f3f2-49fa-ba24-5d405d8440d4",
                                "sense_id": "5e005c46-cb4e-3832-b763-cc654fc86ad7",
                                "text": "Une barre de fer, appelée barlotière, et scellée dans la pierre, d’un meneau à l’autre, était placée à chaque division; cette barre était armée de nilles percées de manière à recevoir des clavettes. Les panneaux étaient ainsi retenus latéralement par les rainures pratiquées dans la pierre , à leur jonction par les nilles et leurs petites clavettes, et de plus, soutenus dans le milieu par des verges de fer mince."
                            }
                        ]
                    },
                    {
                        "sense_id": "1290aa82-4f4f-371b-98bb-eb8b85b1ffc2",
                        "entry_id": "0ba0ddeb-a660-3d58-8b0f-0483416559fb",
                        "glosses": [
                            "Croix ancrée étroite et menue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d07001c9-4e48-43da-b740-eab4de74d7a0",
                                "sense_id": "1290aa82-4f4f-371b-98bb-eb8b85b1ffc2",
                                "text": "NILLE, en terme de Blason, se dit d’une espèce de croix ancrée beaucoup plus étroite & menue qu’à l’ordinaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ff386e7-5f77-3421-9a18-2313d2fe374e",
                        "entry_id": "0ba0ddeb-a660-3d58-8b0f-0483416559fb",
                        "glosses": [
                            "Roue en bois qui servait aux boyaudiers à tordre les boyaux."
                        ],
