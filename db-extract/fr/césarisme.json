                        "entry_id": "85a6a79f-e0d3-35be-9945-ef493afbc5e7",
                        "glosses": [
                            "Forme de gouvernement personnel et autoritaire qui s’exerce avec l’assentiment du peuple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7b18881-36b7-4570-8468-03a34d8e2b66",
                                "sense_id": "0face72d-cf1a-33bf-b889-77156abb1560",
                                "text": "Le gouvernement de Napoléon III a souvent été considéré comme un césarisme."
                            },
                            {
                                "example_id": "b6cebb51-c91e-4444-9f55-25679b8f91a4",
                                "sense_id": "0face72d-cf1a-33bf-b889-77156abb1560",
                                "text": "En d’autres termes encore, en un autre terme, le premier Empire ne fut point ce que nous nommons un césarisme."
                            }
                        ]
                    }
                ],
