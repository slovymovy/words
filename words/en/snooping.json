{
    "word_family": [
        "snoop",
        "snooper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16754741-3fe9-3f4a-b0c3-46e7c5be72b2",
                    "sense_definition": "present participle and gerund of <w>snoop</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "investigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>snooping</w> around in my private desk drawers.",
                            "target_lang_translations": {
                                "cs": "Přestaň <w>slídit</w> v mých soukromých šuplících u stolu."
                            }
                        },
                        {
                            "text": "He was caught <w>snooping</w> through his neighbor's mail.",
                            "target_lang_translations": {
                                "cs": "Byl přistižen, jak <w>špicluje</w> v sousedově poště."
                            }
                        }
                    ],
                    "synonyms": [
                        "prying",
                        "spying"
                    ],
                    "common_phrases": [
                        "snooping around"
                    ],
                    "target_lang_definitions": {
                        "cs": "činnost spočívající v tajném vyzvídání nebo slídění v cizích soukromých věcech"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "slídění",
                                "target_lang_sense_clarification": "obecné označení pro neoprávněné vyzvídání"
                            },
                            {
                                "target_lang_word": "špiclování",
                                "target_lang_sense_clarification": "neformální výraz pro tajné sledování"
                            },
                            {
                                "target_lang_word": "vyzvídání",
                                "target_lang_sense_clarification": "aktivní snaha zjistit informace, které mají zůstat skryté"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b4ad35e2-2ed4-3b68-b11b-2c8e665d9e91",
                    "sense_definition": "The act of secretly spying or investigating someone's private affairs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "investigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was accused of illegal <w>snooping</w> into the personal lives of its employees.",
                            "target_lang_translations": {
                                "cs": "Společnost byla obviněna z nelegálního <w>špehování</w> osobního života svých zaměstnanců."
                            }
                        },
                        {
                            "text": "She felt that his constant <w>snooping</w> was a major violation of her privacy.",
                            "target_lang_translations": {
                                "cs": "Měla pocit, že jeho neustálé <w>slídění</w> je hrubým narušením jejího soukromí."
                            }
                        }
                    ],
                    "synonyms": [
                        "espionage",
                        "prying"
                    ],
                    "target_lang_definitions": {
                        "cs": "akt tajného sledování nebo vyšetřování soukromých záležitostí jiné osoby"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "slídění",
                                "target_lang_sense_clarification": "akt narušování soukromí"
                            },
                            {
                                "target_lang_word": "špehování",
                                "target_lang_sense_clarification": "systematičtější forma sledování"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}