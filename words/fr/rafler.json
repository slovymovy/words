    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "40022502-7092-31bc-bd0f-a8becb0e4b8a",
                    "sense_definition": "Remporter massivement des prix, des trophées ou la totalité des gains lors d'une compétition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette jeune athlète espère <w>rafler</w> toutes les médailles d'or lors de ce championnat."
                        },
                        {
                            "text": "Le joueur a surpris ses adversaires à la table et a fini par <w>rafler</w> la mise."
                        }
                    ],
                    "synonyms": [
                        "décrocher",
                        "remporter"
                    ],
                    "antonyms": [
                        "perdre"
                    ],
                    "common_phrases": [
                        "rafler la mise",
                        "rafler tous les prix"
                    ]
                },
                {
                    "sense_id": "14435ac1-51f7-375f-b259-86459e0b45c2",
                    "sense_definition": "Prendre rapidement ou dérober des biens sans rien laisser.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les cambrioleurs ont réussi à <w>rafler</w> tous les bijoux conservés dans la chambre."
                        },
                        {
                            "text": "Un individu s'est approché discrètement pour <w>rafler</w> le sac posé sur la table."
                        }
                    ],
                    "synonyms": [
                        "dérober",
                        "chiper",
                        "voler",
                        "faucher"
                    ],
                    "antonyms": [
                        "restituer"
                    ],
                    "common_phrases": [
                        "tout rafler"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "03a4bfd5-925b-3ed7-8efd-1ede0a533bb4",
                    "sense_definition": "Arrêter ou capturer collectivement des personnes au cours d'une opération policière.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les forces de l'ordre ont <w>raflé</w> des dizaines de suspects lors de cette intervention nocturne."
                        },
                        {
