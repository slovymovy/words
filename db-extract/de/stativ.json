                    {
                        "sense_id": "bda077ae-3cd0-3636-8077-3611d18e4621",
                        "entry_id": "61097c7c-ee3e-3ed2-833a-cb6550ca01f0",
                        "glosses": [
                            "meist dreibeiniges Gestell zum Aufstellen von Kameras oder Messgeräten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c50a92e-92bf-43d9-9ddc-b6030c4affc6",
                                "sense_id": "bda077ae-3cd0-3636-8077-3611d18e4621",
                                "text": "Um die Kamera stabilisieren zu können, brauchten sie ein Stativ."
                            },
                            {
                                "example_id": "0c558859-555b-4cef-9776-f281ca51998a",
                                "sense_id": "bda077ae-3cd0-3636-8077-3611d18e4621",
                                "text": "„Jan kniete sich hin, schob das Stativ zusammen und verstaute es zusammen mit der Kamera in der schwarzen Tasche, die er halb offen ließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
