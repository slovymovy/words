                        "entry_id": "a12c60ff-9682-3980-9a5b-7249d4e8f096",
                        "glosses": [
                            "Instrument qui sert à déterminer des poids ou des forces, dont il existe de modèles différents"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "760af914-9b95-44b9-bb98-4f4771ec455b",
                                "sense_id": "e3f2a076-6312-31d0-8303-41077c45eaf0",
                                "text": "Le levier d’un peson. Le crochet d’un peson."
                            },
                            {
                                "example_id": "8e3df31c-f974-414a-91c3-f46700f97ec1",
                                "sense_id": "e3f2a076-6312-31d0-8303-41077c45eaf0",
                                "text": "Peson à ressort. Peson à contrepoids."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d7d5144-f717-3e3a-9e2b-46482de85f0f",
                        "entry_id": "a12c60ff-9682-3980-9a5b-7249d4e8f096",
                        "glosses": [
                            "Appareil indiquant le poids au crochet d’un appareil de forage."
                        ],
                        "tags": [
                            "Industrie pétrolière",
                            "Forage"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "618c7a26-6c85-3dab-8633-594a4702b6a9",
                        "entry_id": "a12c60ff-9682-3980-9a5b-7249d4e8f096",
                        "glosses": [
                            "Masse de plomb fixée à l’extrémité du fil de pêche ou du fuseau à filer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42139992-ee4c-4d8a-9f47-ade3ac4d7711",
                                "sense_id": "618c7a26-6c85-3dab-8633-594a4702b6a9",
                                "text": "Peson de pêche."
                            },
                            {
                                "example_id": "5d2c7b5e-bc57-422c-8ff0-abd532b5e242",
                                "sense_id": "618c7a26-6c85-3dab-8633-594a4702b6a9",
                                "text": "Vous avez eu tout à l’heure un bref éclair de mémoire, cher Ami, en citant, à propos d’autre chose, un accessoire dont je sais que vous ne vous servez pas, mais auquel je tiens personnellement : le peson."
                            }
                        ]
                    }
