{
    "word_family": [
        "indirection",
        "indirectly",
        "indirectness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a441bbe-19cf-3214-9586-96c8d11efb37",
                    "sense_definition": "Not involving the quickest, shortest, or most convenient path.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "path_route",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In an effort to beat the traffic jams, they opted to take an <w>indirect</w> route to their destination.",
                            "target_lang_translations": {
                                "ru": "Стремясь объехать пробки, они решили выбрать <w>окольный</w> путь до места назначения.",
                                "zh": "为了避开交通堵塞，他们选择走一条<w>迂回</w>的路线前往目的地。"
                            }
                        },
                        {
                            "text": "The river flows in an <w>indirect</w> path through the valley before reaching the sea.",
                            "target_lang_translations": {
                                "ru": "Река течет <w>непрямым</w> путем через долину, прежде чем впасть в море.",
                                "zh": "这条河沿着一条<w>曲折</w>的路线穿过山谷，最后流入大海。"
                            }
                        }
                    ],
                    "synonyms": [
                        "circuitous",
                        "roundabout",
                        "winding"
                    ],
                    "antonyms": [
                        "direct"
                    ],
                    "common_phrases": [
                        "indirect route",
                        "indirect path",
                        "indirect way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не самый короткий, быстрый или удобный путь.",
                        "zh": "不是走最快、最短或最方便的路线；绕行的，不直接的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непрямой",
                                "target_lang_sense_clarification": "о маршруте или пути"
                            },
                            {
                                "target_lang_word": "окольный",
                                "target_lang_sense_clarification": "обходной, более длинный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迂回",
                                "target_lang_sense_clarification": "路线、道路等不是最直接的"
                            },
                            {
                                "target_lang_word": "曲折",
                                "target_lang_sense_clarification": "路线弯绕、不直达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92514f87-6277-3fa7-8c96-6d42d7b5f945",
                    "sense_definition": "Not done or said in a straightforward way; implied rather than explicitly stated.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "While not mentioning any competitors by name, the CEO made some <w>indirect</w> statements about their ethics.",
                            "target_lang_translations": {
                                "ru": "Не называя конкурентов по имени, генеральный директор сделал несколько <w>косвенных</w> заявлений об их этике.",
                                "zh": "虽然没有点名竞争对手，首席执行官还是发表了一些<w>含蓄</w>的言论，暗指他们的商业道德。"
                            }
                        },
                        {
                            "text": "She asked him several <w>indirect</w> questions to find out if he was single without being too obvious.",
                            "target_lang_translations": {
                                "ru": "Она задала ему несколько <w>косвенных</w> вопросов, чтобы выяснить, холост ли он, не будучи слишком навязчивой.",
                                "zh": "为了不显得太明显，她问了他几个<w>旁敲侧击</w>的问题，想知道他是不是单身。"
                            }
                        }
                    ],
                    "antonyms": [
                        "direct"
                    ],
                    "common_phrases": [
                        "indirect question",
                        "indirect answer",
                        "indirect reference",
                        "indirect approach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выраженный не прямо, а намеками; подразумеваемый, а не высказанный явно.",
                        "zh": "不是直截了当地说或做，而是通过暗示、委婉表达出来的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "косвенный",
                                "target_lang_sense_clarification": "неявный, завуалированный"
                            },
                            {
                                "target_lang_word": "непрямой",
                                "target_lang_sense_clarification": "уклончивый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "间接",
                                "target_lang_sense_clarification": "表达方式不直接，不明说"
                            },
                            {
                                "target_lang_word": "含蓄",
                                "target_lang_sense_clarification": "说法委婉、不直白"
                            },
                            {
                                "target_lang_word": "旁敲侧击",
                                "target_lang_sense_clarification": "通过侧面试探或暗示"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e78a4c3b-2710-3d29-9a3b-d471477b0fbf",
                    "sense_definition": "Happening as a secondary result rather than an immediate cause.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cause_effect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>indirect</w> results of the new policy included a boost in local tourism.",
                            "target_lang_translations": {
                                "ru": "<w>Косвенные</w> результаты новой политики включали рост местного туризма.",
                                "zh": "这项新政策的<w>间接</w>效果之一是带动了当地旅游业。"
                            }
                        },
                        {
                            "text": "Pollution is often an <w>indirect</w> consequence of rapid industrial growth.",
                            "target_lang_translations": {
                                "ru": "Загрязнение часто является <w>косвенным</w> следствием быстрого промышленного роста.",
                                "zh": "污染往往是工业快速增长带来的<w>间接</w>后果。"
                            }
                        }
                    ],
                    "antonyms": [
                        "direct"
                    ],
                    "common_phrases": [
                        "indirect result",
                        "indirect effect",
                        "indirect consequence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий как вторичный результат, а не непосредственная причина.",
                        "zh": "作为次生结果发生的，而不是直接原因或直接后果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "косвенный",
                                "target_lang_sense_clarification": "о результатах или последствиях"
                            },
                            {
                                "target_lang_word": "побочный",
                                "target_lang_sense_clarification": "сопутствующий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "间接",
                                "target_lang_sense_clarification": "作为次要结果产生的"
                            },
                            {
                                "target_lang_word": "连带",
                                "target_lang_sense_clarification": "附带产生的结果或影响"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85b76790-bf5a-3fba-b0e8-3bd735b339e4",
                    "sense_definition": "Not straightforward, fair, or honest; corrupt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was accused of using <w>indirect</w> means to acquire the property from the widow.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в использовании <w>нечестных</w> средств для приобретения собственности у вдовы.",
                                "zh": "他被指控用<w>不正当</w>的手段从那位寡妇手中取得那份财产。"
                            }
                        },
                        {
                            "text": "The king feared that his enemies would use <w>indirect</w> courses to usurp the throne.",
                            "target_lang_translations": {
                                "ru": "Король боялся, что его враги используют <w>обманные</w> пути, чтобы захватить трон.",
                                "zh": "国王担心敌人会用<w>阴险</w>的手段篡夺王位。"
                            }
                        }
                    ],
                    "antonyms": [
                        "direct"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage related to dishonesty or corruption"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестный, несправедливый или использующий обманные методы.",
                        "zh": "不正直、不公正或带有欺骗性的；用不光明手段的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечестный",
                                "target_lang_sense_clarification": "обманный"
                            },
                            {
                                "target_lang_word": "обходной",
                                "target_lang_sense_clarification": "использующий уловки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不正当",
                                "target_lang_sense_clarification": "手段、做法不光明正大"
                            },
                            {
                                "target_lang_word": "阴险",
                                "target_lang_sense_clarification": "带有欺骗、算计意味，较文言或书面"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "89ec675f-e221-346d-88c3-8251d14ecc40",
                    "sense_definition": "A cost that is not directly accountable to a specific project or product, such as overheads.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business_cost",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant broke down the costs into labor, materials, and <w>indirects</w> like rent and utilities.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер разбил расходы на оплату труда, материалы и <w>накладные расходы</w>, такие как аренда и коммунальные услуги.",
                                "zh": "会计把成本分为人工、材料以及房租和水电费之类的<w>间接成本</w>。"
                            }
                        },
                        {
                            "text": "Managing <w>indirects</w> effectively is crucial for maintaining the company's profit margins.",
                            "target_lang_translations": {
                                "ru": "Эффективное управление <w>накладными расходами</w> имеет решающее значение для поддержания рентабельности компании.",
                                "zh": "有效管理<w>间接费用</w>对于维持公司的利润率至关重要。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "directs and indirects"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in the plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Затраты, которые нельзя прямо отнести к конкретному проекту или продукту (накладные расходы).",
                        "zh": "不能直接归属于某个具体项目或产品的成本，例如房租、水电等间接费用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накладные расходы",
                                "target_lang_sense_clarification": "бухгалтерский термин"
                            },
                            {
                                "target_lang_word": "косвенные издержки",
                                "target_lang_sense_clarification": "финансовый термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "间接成本",
                                "target_lang_sense_clarification": "不能直接归到某个项目或产品的成本"
                            },
                            {
                                "target_lang_word": "间接费用",
                                "target_lang_sense_clarification": "会计或财务中指各类间接开支"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b8868bf-eab9-3c10-ad6f-5160e9e388e8",
                    "sense_definition": "To access a value by using a reference or pointer rather than the value itself.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The function <w>indirects</w> through the pointer to retrieve the stored data.",
                            "target_lang_translations": {
                                "ru": "Функция <w>обращается косвенно</w> через указатель для получения сохраненных данных.",
                                "zh": "这个函数通过指针<w>间接访问</w>，以取回已存储的数据。"
                            }
                        },
                        {
                            "text": "Performance may decrease if the system <w>indirects</w> too many times to find the address.",
                            "target_lang_translations": {
                                "ru": "Производительность может снизиться, если система <w>использует косвенную адресацию</w> слишком много раз для поиска адреса.",
                                "zh": "如果系统为了找到地址而多次<w>间接寻址</w>，性能可能会下降。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical computing context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать доступ к значению, используя ссылку или указатель, а не само значение.",
                        "zh": "通过引用或指针而不是该值本身来访问一个值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "использовать косвенную адресацию",
                                "target_lang_sense_clarification": "в программировании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "间接访问",
                                "target_lang_sense_clarification": "编程中通过引用或指针访问值"
                            },
                            {
                                "target_lang_word": "间接寻址",
                                "target_lang_sense_clarification": "计算机术语，使用间接方式定位地址"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}