{
    "word_family": [
        "vernederen",
        "vernedering"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e41b7184-1ace-38de-a6b0-c433c9518a2c",
                    "sense_definition": "iets dat iemand een gevoel van schaamte of minderwaardigheid geeft",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vernedering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>vernederende</w> ervaring om voor de hele klas te worden uitgelachen.",
                            "target_lang_translations": {
                                "en": "It was a <w>humiliating</w> experience to be laughed at in front of the whole class."
                            }
                        },
                        {
                            "text": "De ploeg leed een <w>vernederende</w> nederlaag en verloor met tien doelpunten verschil.",
                            "target_lang_translations": {
                                "en": "The team suffered a <w>humiliating</w> defeat and lost by a ten-goal margin."
                            }
                        }
                    ],
                    "synonyms": [
                        "beschamend",
                        "genant",
                        "verlagend",
                        "smadelijk"
                    ],
                    "antonyms": [
                        "eervol"
                    ],
                    "common_phrases": [
                        "vernederende nederlaag",
                        "vernederende ervaring"
                    ],
                    "target_lang_definitions": {
                        "en": "something that gives someone a feeling of shame or inferiority"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "humiliating",
                                "target_lang_sense_clarification": "causing a loss of pride or self-respect"
                            },
                            {
                                "target_lang_word": "demeaning",
                                "target_lang_sense_clarification": "causing someone to lose their dignity"
                            },
                            {
                                "target_lang_word": "mortifying",
                                "target_lang_sense_clarification": "causing extreme embarrassment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64e96c38-f723-317c-91b8-6dbc5937b68b",
                    "sense_definition": "iets dat de eer of waardigheid van een persoon opzettelijk aantast",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vernedering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gevangenen moesten onder <w>vernederende</w> omstandigheden in de kou wachten.",
                            "target_lang_translations": {
                                "en": "The prisoners had to wait in the cold under <w>degrading</w> circumstances."
                            }
                        },
                        {
                            "text": "Hij vond het een <w>vernederende</w> behandeling dat hij zijn excuses moest aanbieden voor iets wat hij niet had gedaan.",
                            "target_lang_translations": {
                                "en": "He considered it <w>humiliating</w> treatment that he had to apologize for something he hadn't done."
                            }
                        }
                    ],
                    "synonyms": [
                        "beledigend",
                        "krenkend",
                        "onterend",
                        "kleinerend"
                    ],
                    "antonyms": [
                        "eervol"
                    ],
                    "common_phrases": [
                        "vernederende behandeling",
                        "vernederende omstandigheden"
                    ],
                    "target_lang_definitions": {
                        "en": "something that intentionally damages the honor or dignity of a person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "degrading",
                                "target_lang_sense_clarification": "causing a loss of self-respect or status"
                            },
                            {
                                "target_lang_word": "humiliating",
                                "target_lang_sense_clarification": "intended to shame someone"
                            },
                            {
                                "target_lang_word": "insulting",
                                "target_lang_sense_clarification": "disrespectful or scornful"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb39b99e-ba07-3309-8be4-0a353313aec9",
                    "sense_definition": "onvoltooid deelwoord van <w>vernederen</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zichzelf <w>vernederend</w> hoopte hij op een sprankje medelijden van zijn vijanden.",
                            "target_lang_translations": {
                                "en": "<w>Humiliating</w> himself, he hoped for a glimmer of pity from his enemies."
                            }
                        },
                        {
                            "text": "De koning sprak tot het volk, hen onbewust <w>vernederend</w> met zijn arrogante toon.",
                            "target_lang_translations": {
                                "en": "The king spoke to the people, unconsciously <w>demeaning</w> them with his arrogant tone."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "present participle of 'to humiliate'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "humiliating",
                                "target_lang_sense_clarification": "the act of shaming someone"
                            },
                            {
                                "target_lang_word": "demeaning",
                                "target_lang_sense_clarification": "the act of lowering someone's dignity"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}