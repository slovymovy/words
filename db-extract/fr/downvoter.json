                "senses": [
                    {
                        "sense_id": "a40058e5-2b27-32d2-b563-a9aaeda93b8e",
                        "entry_id": "85f12bc5-fbb3-3032-9c6a-89879adb89ed",
                        "glosses": [
                            "Désapprouver quelque chose, sur Internet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7531f83-3def-4225-bb0a-f23c7bec60a3",
                                "sense_id": "a40058e5-2b27-32d2-b563-a9aaeda93b8e",
                                "text": "Mito, ta seule réponse c’est de downvoter sans répondre"
                            },
                            {
                                "example_id": "d543a21f-9d99-49f2-8d25-4a01949de7cf",
                                "sense_id": "a40058e5-2b27-32d2-b563-a9aaeda93b8e",
                                "text": "Dès le début, nous avons donné à nos communautés locales le pouvoir de downvoter et de signaler le contenu abusif afin de préserver la qualité du fil principal."
                            },
                            {
                                "example_id": "c02e9a68-f512-4ebf-b388-e80c93f0e6d3",
                                "sense_id": "a40058e5-2b27-32d2-b563-a9aaeda93b8e",
                                "text": "Une flèche vers le haut pour \"upvoter\", une flèche vers le bas pour \"downvoter\"."
                            },
                            {
                                "example_id": "cc14326d-d4af-4039-95cc-94e44b4b6dae",
                                "sense_id": "a40058e5-2b27-32d2-b563-a9aaeda93b8e",
                                "text": "Il sera possible pour tout utilisateur authentifié d’upvoter (+1) ou de downvoter (-1) un lien ou un commentaire."
                            }
                        ]
                    }
                ],
