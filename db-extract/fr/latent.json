        "fr-extract.jsonl": [
            {
                "entry_id": "990357e4-7278-31d2-9899-fd0eb6873582",
                "word": "latent",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a1c4c56f-ade1-42b3-b6a8-74c73d5c3cae",
                        "entry_id": "990357e4-7278-31d2-9899-fd0eb6873582",
                        "tags": [
                            "plural",
