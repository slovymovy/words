                                "example_id": "25dc6f37-6e2d-4c6a-96ef-a0a8c52dd71e",
                                "sense_id": "1b98d0f5-7174-3cc9-bec2-a0c8f1a7395a",
                                "text": "Comment as-tu commencé à t’engager ? Pourquoi as-tu choisi E-Graine dans ton parcours de transitionneuse ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f081ccfd-88d9-3f22-8609-0da074340b41",
                        "entry_id": "69e57053-9307-33ea-a40f-adcae922dc72",
                        "glosses": [
                            "Femme qui effectue une transition quelconque."
