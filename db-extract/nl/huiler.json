                    {
                        "translation_id": "40bec08d-1708-4129-a52b-49f2b06f8a5b",
                        "source_entry_id": "9882f6ef-a535-3b93-b3e1-ee85e38ce70c",
                        "source_sense_id": "0f59b736-d9d4-3081-ba98-af1cedac6467",
                        "target_lang_word": "howler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
