                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec80e79d-6928-492f-a841-2931d93e9d46",
                                                "sense_id": "09e20b88-3cd0-386e-abfe-af5444542a86",
                                                "text": "De toon “fis” klinkt in de getempereerde stemming gelijk aan de tonen “eïsis” en “ges”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c94b2c82-5bde-3563-909e-0f7828aa6ba0",
                                        "entry_id": "74b73a14-d0d4-3d9a-b6a5-071146e8cf37",
                                        "glosses": [
                                            "de grondtoon (tonica) van de “fis-mineurtoonladder”, tevens een korte aanduiding van die toonladder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d48288fa-f4d0-48cf-ae06-793ffd895c88",
                                                "sense_id": "c94b2c82-5bde-3563-909e-0f7828aa6ba0",
                                                "text": "Op de notenbalk van een vioolsonate in fis, staan drie kruisen als voortekens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0461edc6-2c57-37ef-86b1-d4eda61b94fd",
                                        "entry_id": "74b73a14-d0d4-3d9a-b6a5-071146e8cf37",
                                        "glosses": [
                                            "de grondtoon van het “fis-mineurakkoord”, de kleine drieklank op de eerste trap (tonica-akkoord) van de kleinetertstoonladder op die toon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee3d5151-d82f-459e-8b87-a3f930710a93",
                                                "sense_id": "0461edc6-2c57-37ef-86b1-d4eda61b94fd",
                                                "text": "De drie tonen van het fis-mineurakkoord (symbool: F#m) in grondligging, zijn: fis - a - cis."
