                "senses": [
                    {
                        "sense_id": "2cd9df4a-15aa-35cb-a5a0-5e07541f75a2",
                        "entry_id": "852908a7-a45b-33fc-a646-20a796173493",
                        "glosses": [
                            "durch Bohren entstandener Hohlraum in einem Material"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "032429bb-18c1-421f-92df-8bbd35c0d3a0",
                                "sense_id": "2cd9df4a-15aa-35cb-a5a0-5e07541f75a2",
                                "text": "„Was wird erst passieren, wenn man bis in die Nähe einer Magmakammer vorstößt – quillt aus dem Bohrloch am Ende Magma statt Wasser?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a46dd476-e039-44d0-8549-1ca3856ae91b",
                        "source_entry_id": "852908a7-a45b-33fc-a646-20a796173493",
                        "source_sense_id": "2cd9df4a-15aa-35cb-a5a0-5e07541f75a2",
                        "source_sense_description": "durch Bohren entstandener Hohlraum in einem Material",
                        "target_lang_word": "borehole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "borehole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a3f3b02-95f4-30e4-84ac-f62e9fe82b3c",
                                        "entry_id": "898c48df-5097-312d-8717-895be61adcd8",
                                        "glosses": [
                                            "A hole bored into the ground to collect samples for analysis or to extract oil or water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5d2bb00-ae85-409d-8118-e99a3e4a8deb",
                                                "sense_id": "3a3f3b02-95f4-30e4-84ac-f62e9fe82b3c",
                                                "text": "Near-synonym: well"
                                            },
                                            {
                                                "example_id": "b9b963b4-f02c-46af-98d4-15a95ebc3b99",
                                                "sense_id": "3a3f3b02-95f4-30e4-84ac-f62e9fe82b3c",
                                                "text": "The state of the groundwater is monitored at various boreholes in the area."
                                            },
                                            {
                                                "example_id": "5e0ff919-1fa1-40e3-9793-addab1258de3",
                                                "sense_id": "3a3f3b02-95f4-30e4-84ac-f62e9fe82b3c",
                                                "text": "Extensive borehole information and tendered contract prices make these cost estimates much more plausible than earlier estimates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02e48b2-5015-36dd-8cb6-6d1cedb39a43",
                                        "entry_id": "898c48df-5097-312d-8717-895be61adcd8",
                                        "glosses": [
                                            "Any other hole that has been bored into something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a39d59a-2bb5-48a3-afc6-9ec0fec46d3d",
                                                "sense_id": "e02e48b2-5015-36dd-8cb6-6d1cedb39a43",
                                                "text": "There were little boreholes in the oak beam, indicating that insects had once taken some interest in it."
                                            }
                                        ]
                                    }
                                ]
                            },
