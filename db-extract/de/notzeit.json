                        "sense_id": "c55f2cac-6faf-3559-8cb6-c8e87f3a195d",
                        "entry_id": "391823f2-ecf0-37a3-9f81-aaa5537b2727",
                        "glosses": [
                            "Zeit, in der wesentliche Lebensbedürfnisse nicht hinreichend befriedigt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59f6f189-8adb-486e-b17a-8742d6de1473",
                                "sense_id": "c55f2cac-6faf-3559-8cb6-c8e87f3a195d",
                                "text": "„Besonders in wirtschaftlichen Notzeiten ist das nicht von der Hand zu weisen.“"
                            },
                            {
                                "example_id": "1a8a1738-42a9-42b5-8410-ed3503586ba0",
                                "sense_id": "c55f2cac-6faf-3559-8cb6-c8e87f3a195d",
                                "text": "„Früher wurde der Eichelkaffee in Notzeiten getrunken, wenn es keinen echten Kaffee gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
