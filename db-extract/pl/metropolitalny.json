                "translations": [
                    {
                        "translation_id": "172e84bd-a3f4-497f-a1b7-ac2211af33cd",
                        "source_entry_id": "d0826ed5-13ff-33e9-9ef2-b7a5906cfb68",
                        "source_sense_id": "d50e65bb-08c6-3e9f-9c2e-c6f494a7d134",
