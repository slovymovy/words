                "senses": [
                    {
                        "sense_id": "897b8287-4fba-33b5-8f0d-a356daec2598",
                        "entry_id": "6b2f31c3-e286-3459-8b27-75b265955b80",
                        "glosses": [
                            "Geschichte des Militärs und der Kriege"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fde31ac-dd17-47f8-bac2-41455a8a5353",
                                "sense_id": "897b8287-4fba-33b5-8f0d-a356daec2598",
                                "text": "Machiavelli ist ein bedeutender Autor der Militärgeschichte."
                            },
                            {
                                "example_id": "91b6e3bf-3b78-4133-8a1a-a760afd1e240",
                                "sense_id": "897b8287-4fba-33b5-8f0d-a356daec2598",
                                "text": "„Ihr folgen seit 1945 getrennte Militärgeschichten Westdeutschlands, Mitteldeutschlands und Österreichs; Ostdeutschland ist vernichtet worden.“"
                            },
                            {
                                "example_id": "f839a866-186c-4534-9e4f-b83f272698c7",
                                "sense_id": "897b8287-4fba-33b5-8f0d-a356daec2598",
                                "text": "„Bereits seit den neunziger Jahren wird die Geschichte der NATO nicht als Aneinanderreihung einzelner nationaler Militärgeschichten, sondern transnational geschrieben.“"
                            },
                            {
                                "example_id": "3a334b29-eb85-4b50-9bef-e90fd55c2396",
                                "sense_id": "897b8287-4fba-33b5-8f0d-a356daec2598",
                                "text": "„US-Präsident Barack Obama hat schon in seiner ersten Amtszeit Militärgeschichte geschrieben, indem er die wichtigste Neuerung der Kriegsführung des 21. Jahrhunderts nach dem Einsatz von Drohnen einführte: Cyberkrieg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
