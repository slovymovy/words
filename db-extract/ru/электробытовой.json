                                        "entry_id": "dfd9ae24-661b-3e14-8ef6-18214217db6e",
                                        "glosses": [
                                            "Relatif aux appareils électrodomestiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bac0f60-eabe-412a-87b2-5206b2ab94e4",
                                                "sense_id": "a0b8d7af-020d-327d-9bdd-7121a6617d30",
                                                "text": "Tout le matériel électro-domestique fabriqué sur contingent de fabrication … sera désormais vendu sans titre de répartition."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "électrodomestique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74c1a360-480c-3b3a-a961-2137dba43abd",
                                        "entry_id": "01e02e1b-8608-34a4-8199-8734be4ce6c5",
                                        "glosses": [
                                            "Ensemble des systèmes électriques posables, encastrables ou intégrables qui participent au confort de la maison (traitement du linge, de la vaisselle, production de froid ou de chaleur, appareils de cuisson)."
                                        ],
                                        "tags": [
                                            "Électrotechnique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06336709-9126-44fd-840f-dd5c162c43fb",
                                                "sense_id": "74c1a360-480c-3b3a-a961-2137dba43abd",
                                                "text": "Dans cette optique, l’ameublement, l’électrodomestique, la décoration et le design qui constituent les divers équipements de l’aménagement de la maison intègrent ce concept de mode."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
