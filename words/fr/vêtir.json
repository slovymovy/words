                    "frequency": "Middle",
                    "semantic_group_id": "habillement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, la mère aide son jeune enfant à se <w>vêtir</w> avant de partir pour l'école."
                        },
                        {
                            "text": "Le comédien était élégamment <w>vêtu</w> d'un costume sombre pour la première représentation de la pièce."
                        }
                    ],
                    "synonyms": [
                        "habiller"
                    ],
