                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa5a84d1-5b84-4642-a7c6-958198f4d8b2",
                                "sense_id": "bacfbd20-21a1-3818-a17e-c48fa1bc88cd",
                                "text": "Hij liep naar de boekhouding."
                            }
                        ]
                    }
