                                "target_senses": [
                                    {
                                        "sense_id": "ef14c4cd-3688-3308-8a7a-b523a41ff83d",
                                        "entry_id": "d34ad081-4f3a-3696-bd7e-99c155066d18",
                                        "glosses": [
                                            "Soldat, combattant du djihad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ea73af-33dc-4b0d-9725-60f3ae3f848e",
                                                "sense_id": "ef14c4cd-3688-3308-8a7a-b523a41ff83d",
                                                "text": "Émilie König correspond au modèle de la femme révoltée, féministe jihadiste, épousant un mujahid et faisant un enfant avec lui avant qu’il ne meure."
                                            },
                                            {
                                                "example_id": "d0764aaa-b734-4cde-87d4-7a7cf2ff197f",
                                                "sense_id": "ef14c4cd-3688-3308-8a7a-b523a41ff83d",
                                                "text": "Les uns se perçoivent comme des soldats, des mujahidin, les autres comme des gangsters, mais dans les deux cas ils se définissent comme des guerriers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57cf4067-f856-4a8f-af1a-b6b3902ed498",
                        "source_entry_id": "60454d6a-b34b-3807-9d71-2d85dacb219f",
                        "source_sense_id": "31cae447-9179-3822-a0ce-07be2e99895a",
                        "source_sense_description": "a Muslim engaging in jihad",
                        "target_lang_word": "Mudjahed",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mudjahed",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ef62465-fd42-386f-bcda-f4fe000a7481",
                                        "entry_id": "44af83a6-63a4-3bb7-8c04-16ef7bec9f08",
                                        "glosses": [
                                            "alternative Schreibweise von Mudschahed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb4c2750-5487-4694-ab9b-247064c25517",
                                                "sense_id": "1ef62465-fd42-386f-bcda-f4fe000a7481",
                                                "text": "„Viele islamistische Terroristen agieren inzwischen in ganz unterschiedlichen Krisengebieten. Ein Beispiel ist der vor einiger Zeit in Saudi-Arabien getötete Al Muqrin, der als Mudjahed die Terroristen in Algerien, Bosnien, Afghanistan und Tschetschenien unterstützt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "047f6cf9-3a28-4983-932c-3dd4b7fed5cd",
                        "source_entry_id": "60454d6a-b34b-3807-9d71-2d85dacb219f",
                        "source_sense_id": "31cae447-9179-3822-a0ce-07be2e99895a",
                        "source_sense_description": "a Muslim engaging in jihad",
                        "target_lang_word": "Mudschahed",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mudschahed",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce4cf623-4f7b-36e8-9d3c-bd10b18cfd1c",
                                        "entry_id": "e72dfe52-06e3-39c0-970e-8fee35eb2b4f",
                                        "glosses": [
                                            "ein sich zumeist als dschihadistischer Glaubenskämpfer begreifender, islamischer Freischärler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f58a9b1-129c-498f-a60f-56eed03df8ad",
                                                "sense_id": "ce4cf623-4f7b-36e8-9d3c-bd10b18cfd1c",
                                                "text": "„Der Dschihad und der Aufenthalt in Afghanistan sind wie ein Initiationsritus, der ihnen den Nimbus eines Mudschahed, eines heiligen Kriegers, verschafft.“"
                                            },
                                            {
                                                "example_id": "a335eb68-90b1-41a4-8378-9b6746a9bed1",
                                                "sense_id": "ce4cf623-4f7b-36e8-9d3c-bd10b18cfd1c",
                                                "text": "„In zwei „Nur für den Dienstgebrauch!“ vorgesehenen Dokumenten aus dem US-Heimatschutzministerium (DHS) und dem „National Counter Terrorism Center (NCTC)“ wird der Regierung empfohlen, gänzlich auf Begriffe wie Dschihad und Mudschaheddin zu verzichten.“"
                                            },
                                            {
                                                "example_id": "b0e3b065-12cd-4c7f-bbe1-efec42f6e5e5",
                                                "sense_id": "ce4cf623-4f7b-36e8-9d3c-bd10b18cfd1c",
                                                "text": "„Bereits wenige Minuten vor den Anschlägen gingen bei indischen Medien Bekenner-E-Mails der Indischen Mudschaheddin ein. In der am Samstagabend versandten Mail hieß es unter der Betreffzeile \"Nachricht des Todes\": \"Im Namen Allahs schlagen die Indischen Mudschaheddin ein weiteres Mal zurück.\"“"
                                            },
                                            {
                                                "example_id": "43d0316a-0c37-4d78-9c05-d254b659face",
                                                "sense_id": "ce4cf623-4f7b-36e8-9d3c-bd10b18cfd1c",
                                                "text": "„Vor 30 Jahren startete die sowjetische Invasion nach Afghanistan. Als Reaktion riefen die Mudschaheddin einen Glaubenskrieg gegen die Kommunisten aus.[…]Nach dem arabischen „Dschihad“ bezeichneten sich die Männer aus Massouds Lager fortan „Mudschaheddin“ und bekämpften die Kommunisten, wo immer sie konnten.[…]Als die Kommunisten Afghanistans durch den Widerstand der Mudschaheddin zunehmend in die Defensive gerieten, entschloss sich die Sowjetunion am 26. Dezember 1979 zur Invasion in das Nachbarland. Durch die militärische Überlegenheit dominierten die Russen bald die wichtigsten Punkte des Landes. Bis auf die unzugänglichen Gebirge, wo die Mudschaheddin auch noch weiter Widerstand leisteten und ihren Gegner nicht zur Ruhe kommen ließen.“"
                                            },
                                            {
                                                "example_id": "8995d1d8-2518-4005-ae09-9bd0eefb24f1",
                                                "sense_id": "ce4cf623-4f7b-36e8-9d3c-bd10b18cfd1c",
                                                "text": "„Als alleiniger Koordinator der ausländischen Hilfen für die afghanischen Mudschahedin nahm der ISI unter Leitung von Akhtar Abdur Rahman (1979–1987) und Hamid Gul (1987–1989) in dieser Periode eine Schlüsselstellung im Stellvertreterkrieg zwischen Ost und West auf Seiten der Amerikaner ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6828e684-eb44-4326-8ddb-26bed7a58ac9",
                        "source_entry_id": "60454d6a-b34b-3807-9d71-2d85dacb219f",
                        "source_sense_id": "31cae447-9179-3822-a0ce-07be2e99895a",
                        "source_sense_description": "a Muslim engaging in jihad",
                        "target_lang_word": "Mudschahid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mudschahid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96e71ec6-e478-3758-b7c4-c2c238511b8e",
                                        "entry_id": "be64ac39-0f99-3efe-b266-f00d8417722d",
                                        "glosses": [
                                            "ein sich zumeist als dschihadistischer Glaubenskämpfer begreifender, islamischer Freischärler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "755021f5-66d4-4429-80d2-d32a9e618d30",
                                                "sense_id": "96e71ec6-e478-3758-b7c4-c2c238511b8e",
                                                "text": "„Am schlimmsten ist es, dass der Mudschahid in der Gefangenschaft unter der Folter gezwungen wird, über seine Kameraden auszusagen, seine Bewegung eigenhändig zu zerstören und seine und die Geheimnisse seiner Kameraden dem Feind preiszugeben.“"
                                            },
                                            {
                                                "example_id": "b757b337-e5a8-4e3c-b042-9c2ba05e7aaa",
                                                "sense_id": "96e71ec6-e478-3758-b7c4-c2c238511b8e",
                                                "text": "„Die Kameralinse des Mudschahids dokumentiert die Implementation und praktische Umsetzung der Ideologie.“"
                                            },
                                            {
                                                "example_id": "c3330e39-26b8-4f52-ae71-8b09848c93b9",
                                                "sense_id": "96e71ec6-e478-3758-b7c4-c2c238511b8e",
                                                "text": "„Als die Russen in Afghanistan waren, regierte in Pakistan der islamische Präsident Zia, der Angst hatte, die Sowjetunion könnte gemeinsam mit Indien – Hindus wurden keinesfalls toleriert – Pakistan überrollen und begann, die Mudschahidin zu unterstützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
