            {
                "entry_id": "5d416ab4-82f3-3aa4-8d1f-7277aa654fe2",
                "word": "Gorgon",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "20684d09-58c2-36eb-94df-03c9666e3e45",
                        "entry_id": "5d416ab4-82f3-3aa4-8d1f-7277aa654fe2",
                        "glosses": [
                            "Synonym of Demogorgon (“a pagan god or demon”)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8c3513ab-978f-42da-b2ad-67de171291a1",
                                "sense_id": "20684d09-58c2-36eb-94df-03c9666e3e45",
                                "text": "Uillain I tel thee, were that Tamburlaine\nAs monſtrous as Gorgon, prince of Hel,\nThe Souldan would not ſtart a foot from him."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "d1be6819-f928-42f4-b0c4-af996b7a4b77",
                        "source_entry_id": "5d416ab4-82f3-3aa4-8d1f-7277aa654fe2",
                        "source_sense_ids": [
                            "20684d09-58c2-36eb-94df-03c9666e3e45"
                        ],
                        "linkage_type": "synonyms",
                        "word": "Demogorgon"
                    }
                ]
            },
            {
                "entry_id": "7ea44963-98b7-3c82-a868-1225dc0473bf",
                "word": "gorgon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e5665afc-9579-4370-9e6b-083a3e03ba57",
                        "entry_id": "7ea44963-98b7-3c82-a868-1225dc0473bf",
                        "tags": [
                            "plural"
                        ],
                        "form": "gorgons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8684f8d2-4b8c-3507-ae99-3d73bb057d26",
                        "entry_id": "7ea44963-98b7-3c82-a868-1225dc0473bf",
                        "glosses": [
                            "A vicious female monster from Greek mythology with sharp fangs and hair of living, venomous snakes. One of the three sisters: Medusa, Stheno and Euryale"
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b7bde9c6-cbce-31db-b08a-06ae976e3054",
                        "entry_id": "7ea44963-98b7-3c82-a868-1225dc0473bf",
                        "glosses": [
                            "An intimidating, ugly, or disgusting woman; anything hideous or horrid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0009738-978c-4087-8f39-df384ef645a6",
                                "sense_id": "b7bde9c6-cbce-31db-b08a-06ae976e3054",
                                "text": "I'll shrowd this Gorgon from all humane view."
                            },
                            {
                                "example_id": "4bfc769e-e1d5-4d3f-9377-ec26cac2e708",
                                "sense_id": "b7bde9c6-cbce-31db-b08a-06ae976e3054",
                                "text": "Swilling martinis and spewing venom, Phyllis is a particularly unappetizing gorgon, telling us at one point that an acquaintance of hers is aroused by the Heimlich maneuver."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ded952bc-a62f-475c-8290-1d175a24b059",
                        "source_entry_id": "7ea44963-98b7-3c82-a868-1225dc0473bf",
                        "source_sense_description": "monster in Greek mythology",
                        "target_lang_word": "gorgone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gorgone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad562a52-2f5c-3213-bcd2-74f29a8e67df",
                                        "entry_id": "4b684321-1d69-39c9-a241-e09d8f186deb",
                                        "glosses": [
                                            "Gorgone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ec521cb-d402-47f0-8284-4088c50d9580",
                                                "sense_id": "ad562a52-2f5c-3213-bcd2-74f29a8e67df",
                                                "text": "Gorgone trouvée gisante sur le sol, perte de connaissance et déshydratation."
                                            },
                                            {
                                                "example_id": "a0de99e4-2913-44f5-91da-96bd0f0d2783",
                                                "sense_id": "ad562a52-2f5c-3213-bcd2-74f29a8e67df",
                                                "text": "Et la décoration s’avère d’un raffinement inouï. Sur ses deux anses en volutes, la gorgone Méduse est représentée avec un visage effrayant, un corselet d’écailles et les jambes serpentiformes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "268dd565-1914-3271-8db2-a4a8e02f75b3",
                                        "entry_id": "4b684321-1d69-39c9-a241-e09d8f186deb",
                                        "glosses": [
                                            "Genre de polypiers communs en Méditerranée, ils ressemblent à des arbrisseaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "910294b2-2c0a-3288-b409-d9cec56142ac",
                                        "entry_id": "4b684321-1d69-39c9-a241-e09d8f186deb",
                                        "glosses": [
                                            "Espèce de papillon diurne de la famille des nymphalidés."
                                        ],
                                        "tags": [
                                            "Lépidoptérologie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ec70d22-472c-357b-a068-c7b8684f3ad8",
                                        "entry_id": "4b684321-1d69-39c9-a241-e09d8f186deb",
                                        "glosses": [
                                            "Femme méchante ou très laide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3042d4a5-6440-302d-82d2-b39ebc0d2909",
                                        "entry_id": "4b684321-1d69-39c9-a241-e09d8f186deb",
                                        "glosses": [
                                            "Tête décorative, vue de face, à la bouche ouverte, à chevelure de serpents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f84bd28-44b9-4d64-b4b7-647134cdd4a0",
                                                "sense_id": "3042d4a5-6440-302d-82d2-b39ebc0d2909",
                                                "text": "On eût dit que quelque autre église avait envoyé à l’assaut de Notre-Dame ses gorgones, ses dogues, ses drées, ses démons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
