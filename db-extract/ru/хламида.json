                ],
                "senses": [
                    {
                        "sense_id": "369eb98a-5bb3-3604-8a9c-6cb598ff73d6",
                        "entry_id": "c5d9cfbb-f88a-375c-973a-d0bc406987e9",
                        "glosses": [
                            "истор. у древних греков — короткий прямоугольный отрезок плотной ткани, скрепляемый на плече, одежда путешественника и воина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e238202-24eb-43b7-b8ff-11854c478e4f",
                                "sense_id": "369eb98a-5bb3-3604-8a9c-6cb598ff73d6",
                                "text": "На противоположных концах эстрады появились две фигуры на высоких котурнах, в длинных белых хламидах и греческих масках."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8fd9d65-ad57-3b2b-9dc8-85a9d1a811cb",
                        "entry_id": "c5d9cfbb-f88a-375c-973a-d0bc406987e9",
                        "glosses": [
                            "перен., разг. широкая и длинная, несуразно выглядящая одежда"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6933142b-b401-4da8-9af9-9f9434a9de22",
                        "source_entry_id": "c5d9cfbb-f88a-375c-973a-d0bc406987e9",
                        "target_lang_word": "chlamys",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chlamys",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e21f6309-5ad6-36c4-a6d3-82dad5a6554f",
                                        "entry_id": "dd897938-c64a-344b-a2eb-11011851c59b",
                                        "glosses": [
                                            "A short poncho-like cloak caught up on the shoulder, worn by hunters, soldiers, and horsemen in Ancient Greece."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c332c396-68f3-4320-9e6b-11ed8d32a140",
                                                "sense_id": "e21f6309-5ad6-36c4-a6d3-82dad5a6554f",
                                                "text": "He unfolded the chlamys, stretched it out with both hands before me, and then cast it over my shoulders."
                                            },
                                            {
                                                "example_id": "db534b61-61fd-4f0a-8e75-ecdcf2d7d4c1",
                                                "sense_id": "e21f6309-5ad6-36c4-a6d3-82dad5a6554f",
                                                "text": "The horse was not in the least like a Greek horse (nor even a Trojan), and F.M. the Duke of Wellington was not represented with the ensis or short sword in his grasp, the chlamys flying from his shoulder, or the paludamentum, as more suitable for the cool of the English climate (totidem divisos orbe &c.), the kothornos on his leg, the galea slung at the crupper? no reins, and his naked nether-man, not (as in these precious models) seated on the bare back of the bull-necked, square-jawed, dray-limbed steed."
                                            },
                                            {
                                                "example_id": "eca11b02-de33-41a5-99ab-1caaf9739d88",
                                                "sense_id": "e21f6309-5ad6-36c4-a6d3-82dad5a6554f",
                                                "text": "A male god stands in three-quarter view to right, wearing a chlamys fastened at his right shoulder with a round clasp."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
