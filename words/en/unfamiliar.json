        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ae95280d-c9d6-3cdf-baa6-503cd74a3c37",
                    "sense_definition": "Not known or recognized; strange or foreign.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt nervous walking down the <w>unfamiliar</w> streets alone at night.",
                            "target_lang_translations": {
                                "ru": "Она нервничала, идя ночью в одиночестве по <w>незнакомым</w> улицам.",
                                "de": "Sie fühlte sich nervös, als sie nachts allein durch die <w>unbekannten</w> Straßen ging."
                            }
                        },
                        {
                            "text": "The computer system was completely <w>unfamiliar</w> to the new employee.",
                            "target_lang_translations": {
                                "ru": "Компьютерная система была совершенно <w>незнакома</w> новому сотруднику.",
                                "de": "Das Computersystem war dem neuen Mitarbeiter völlig <w>unvertraut</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "strange",
                        "unknown",
                        "foreign"
                    ],
                    "antonyms": [
                        "familiar",
                        "known"
                    ],
                    "common_phrases": [
                        "unfamiliar surroundings",
                        "unfamiliar territory",
                        "unfamiliar with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неизвестный, непривычный или чужой; такой, с которым ранее не встречались.",
                        "de": "Nicht bekannt oder nicht vertraut; fremd oder ungewohnt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незнакомый",
                                "target_lang_sense_clarification": "о людях, местах или вещах"
                            },
                            {
                                "target_lang_word": "непривычный",
                                "target_lang_sense_clarification": "необычный, чуждый опыту"
                            },
                            {
                                "target_lang_word": "чужой",
                                "target_lang_sense_clarification": "чуждый, посторонний"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "unbekannt",
                                "target_lang_sense_clarification": "nicht gewusst oder nicht erkannt"
                            },
                            {
                                "target_lang_word": "unvertraut",
                                "target_lang_sense_clarification": "nicht eingewöhnt oder fremd wirkend"
                            },
                            {
                                "target_lang_word": "fremd",
                                "target_lang_sense_clarification": "nicht zugehörig oder fremdartig"
                            },
                            {
                                "target_lang_word": "ungewohnt",
                                "target_lang_sense_clarification": "außerhalb der eigenen Erfahrung oder Gewohnheit"
