                "senses": [
                    {
                        "sense_id": "dd48914e-196c-38ff-874b-cb2e89443e05",
                        "entry_id": "a4d462fa-e915-3f16-b103-2f18446a9a57",
                        "glosses": [
                            "aus Holz hergestellter Rahmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ea9780-df16-45ad-9f24-44709d0a5ab0",
                                "sense_id": "dd48914e-196c-38ff-874b-cb2e89443e05",
                                "text": "Der Holzrahmen benötigt dringend einen neuen Anstrich."
                            },
                            {
                                "example_id": "e8ae6993-8cfe-4eb8-ab78-167935507a13",
                                "sense_id": "dd48914e-196c-38ff-874b-cb2e89443e05",
                                "text": "„Nach einigem hörbaren Geräume und einem lauten Knall kam Elkin Mathews wieder heraus, zwei kleine Bilder in schmalen, schwarz lackierten Holzrahmen in der Hand.“"
                            },
                            {
                                "example_id": "72b91681-b1de-4e2c-a6df-537c05800815",
                                "sense_id": "dd48914e-196c-38ff-874b-cb2e89443e05",
                                "text": "„Auf seine Weise steckt es genauso fest wie Káris Bronco, setzte er weiter backend hinzu und zeigt mit dem Bratenwender auf ein Schwarz-Weiß-Foto in hübschem, aber ausgebleichtem Holzrahmen, das die beiden Ziehbrüder Kári und Skúli zeigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
