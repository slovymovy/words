                        "glosses": [
                            "Rendre intentionnel, attribuer un caractère intentionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76893793-9bcc-4761-8406-ff6c9e4eb051",
                                "sense_id": "3071014f-75c2-34c0-b31d-d336b8cf588c",
                                "text": "Une issue, croit-il, qui peut permettre d'intentionnaliser la totalité des données mondaines conscientes, ainsi que le monde lui-même."
                            },
                            {
                                "example_id": "26d3b551-3359-41f5-ad88-c9055bd2f62f",
                                "sense_id": "3071014f-75c2-34c0-b31d-d336b8cf588c",
                                "text": "La genèse de la phénoménologie transcendantale enregistre, alors, les efforts faits pour intentionnaliser l'expérience."
                            }
                        ]
                    }
