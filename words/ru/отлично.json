                        "выглядеть отлично",
                        "знать отлично"
                    ],
                    "target_lang_definitions": {
                        "en": "Very well, excellently; in the best possible way.",
                        "zh": "非常好，极好；以最好的方式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excellently",
                                "target_lang_sense_clarification": "in an excellent manner"
                            },
                            {
                                "target_lang_word": "very well",
                                "target_lang_sense_clarification": "high quality or health"
                            },
                            {
                                "target_lang_word": "great",
                                "target_lang_sense_clarification": "informal, very good"
                            },
                            {
                                "target_lang_word": "perfectly",
                                "target_lang_sense_clarification": "flawlessly"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "很好",
                                "target_lang_sense_clarification": "表示程度高或状态好"
                            },
                            {
