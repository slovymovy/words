                        "sense_id": "f5e9b578-83e4-3dd6-b1b3-7a56ae7d69df",
                        "entry_id": "072990d6-1a65-3c70-8fcc-aa3c96c9a878",
                        "glosses": [
                            "Gdańsk (especially in reference to the times when it was part of a German-speaking state such as Prussia or Germany)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49a63d4a-b8c7-4d82-acc0-63884f9c05a0",
                                "sense_id": "f5e9b578-83e4-3dd6-b1b3-7a56ae7d69df",
                                "text": "Early on that Friday morning (September 1) it was announced by the Nazi Government of the Free City of Danzig that the territory desired incorporation in the German Reich, and almost immediately afterwards the German Chancellor accepted such inclusion forthwith."
                            }
                        ]
