                        "entry_id": "feb25f0b-fc2c-3589-8e96-88013b5dfb38",
                        "glosses": [
                            "Betrieb, in dem Kleidungsstücke nach den individuellen Maßen der Kunden angefertigt werden, diese Art der Herstellung individueller Kleidungsstücke"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "754faa57-63be-469e-a497-1b8617f6029a",
                                "sense_id": "fe8440b5-bccc-3285-8d32-085683b2d849",
                                "text": "„Dietl, Inhaber von Deutschlands - mit inzwischen 30 Schneidern - größter Maßschneiderei, hat sein Geschäft auf vier Etagen über der Münchener Residenzstraße und verkörpert sichtbar den Aufschwung der Zunft.“"
                            },
                            {
                                "example_id": "5c0a874b-dfff-4e4b-a5e7-400ea6e90a2b",
                                "sense_id": "fe8440b5-bccc-3285-8d32-085683b2d849",
                                "text": "„Die Maßschneiderei ist einmalig und bei der Umsetzung von Kundenwünschen gibt es quasi keine Grenzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
