                "senses": [
                    {
                        "sense_id": "9a7be2b3-a230-3bac-b782-4f5407b8c17d",
                        "entry_id": "83cdd81a-7c48-352f-9477-dedb199143a0",
                        "glosses": [
                            "das Kontaktieren per Telefon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d7c2f33-5ff5-4eb2-9f32-dd4b40897203",
                                "sense_id": "9a7be2b3-a230-3bac-b782-4f5407b8c17d",
                                "text": "„Er wurde von einem Telefonanruf unterbrochen: Es war Johnny Fontane, sprudelnd vor guter Laune.“"
                            },
                            {
                                "example_id": "bba7e8ea-b441-40c6-9e60-50b3bd255c8f",
                                "sense_id": "9a7be2b3-a230-3bac-b782-4f5407b8c17d",
                                "text": "„Als sie den Telefonanruf bekam, daß er vermißt sei, weinte sie und war unglücklich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2d78f1e-cd36-4a76-82a9-b1dcca4a7622",
                        "source_entry_id": "83cdd81a-7c48-352f-9477-dedb199143a0",
                        "source_sense_id": "9a7be2b3-a230-3bac-b782-4f5407b8c17d",
                        "source_sense_description": "das Kontaktieren per Telefon",
                        "target_lang_word": "phone call",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phone call",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffb0ffc6-c278-3566-af7e-b8927371c842",
                                        "entry_id": "da1bd11b-a12d-3295-a47f-c40ec79a6a9e",
                                        "glosses": [
                                            "Clipping of telephone call."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24ae6a8c-d626-4ee7-b1be-b87b122352e9",
                                                "sense_id": "ffb0ffc6-c278-3566-af7e-b8927371c842",
                                                "text": "A simple phone call would take care of it."
                                            },
                                            {
                                                "example_id": "8fecebfe-bc81-4622-be2e-80edd4c1facd",
                                                "sense_id": "ffb0ffc6-c278-3566-af7e-b8927371c842",
                                                "text": "In some situations, a phone call cuts through the clutter more efficiently than emails, IMs, or chat bots."
                                            },
                                            {
                                                "example_id": "ea903075-d11c-45b6-9b42-b15d33d656f2",
                                                "sense_id": "ffb0ffc6-c278-3566-af7e-b8927371c842",
                                                "text": "Then he put a trunk line phone call through to the nearest township and asked the Police to send someone out as soon as possible."
                                            },
                                            {
                                                "example_id": "d51bab1a-c11b-4213-9927-60e4ca8f2d54",
                                                "sense_id": "ffb0ffc6-c278-3566-af7e-b8927371c842",
                                                "text": "On November 20, they had a phone call and later a meeting with others lasting at least 1 1/2 hours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
