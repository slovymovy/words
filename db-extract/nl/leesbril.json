                    {
                        "translation_id": "f60d6088-ffef-4017-a79a-3cd5e56a9a86",
                        "source_entry_id": "106f1b06-2227-3669-8106-524e83a263c7",
                        "source_sense_id": "248b8e2c-b50d-3cfe-a0b2-e3185dc64b8e",
                        "source_sense_description": "een bril die op leesafstand een scherp beeld geeft",
                        "target_lang_word": "Lesebrille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lesebrille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfaebb57-da11-39a1-bc62-449c3c530828",
                                        "entry_id": "d9b3e5c9-537e-33d0-baf6-da40866ecbe1",
                                        "glosses": [
                                            "Brille, die das Schriftbild so vergrößert, dass es gelesen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c056c6c8-2c5e-4ab2-84f4-6cac0479e12a",
                                                "sense_id": "dfaebb57-da11-39a1-bc62-449c3c530828",
                                                "text": "„Zwischen Daumen und Zeigefinger baumelt eine Lesebrille.“"
                                            },
                                            {
                                                "example_id": "5c909458-9f23-414d-a2d0-e2c29afe49bd",
                                                "sense_id": "dfaebb57-da11-39a1-bc62-449c3c530828",
                                                "text": "„Seine Lesebrille fiel aus der Westentasche.“"
                                            },
                                            {
                                                "example_id": "42882dc1-d76a-4f03-b214-5f15f22ef03d",
                                                "sense_id": "dfaebb57-da11-39a1-bc62-449c3c530828",
                                                "text": "„Sie ließ ihre Lesebrille auf den bunt beblusten Busen sinken und beäugte das asiatische Trio, das sie noch nie zuvor in diesen Räumen gesehen hatte.“"
                                            },
                                            {
                                                "example_id": "5712ad08-2c9b-4cdd-9b06-4d93830b8548",
                                                "sense_id": "dfaebb57-da11-39a1-bc62-449c3c530828",
                                                "text": "„Um seinen kahlen Kopf zog sich ein weißer Haarkranz, die wassergrauen Augen blickten über eine randlose Lesebrille.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
