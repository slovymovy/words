                        "majorer"
                    ],
                    "antonyms": [
                        "baisser",
                        "déprécier"
                    ],
                    "common_phrases": [
                        "rehausser la valeur",
                        "rehausser les prix"
                    ]
                },
                {
                    "sense_id": "b125979c-f6d9-3165-8c9e-c98e08f4fe3a",
                    "sense_definition": "Donner plus de grandeur, d'importance ou d'intensité à un sentiment, une réputation ou une vertu.",
