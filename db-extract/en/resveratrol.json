                "entry_id": "b0994b9f-f295-3869-9183-f745f215d080",
                "word": "resveratrol",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "df05662c-8c21-4a89-a8c1-14a68970153c",
                        "entry_id": "b0994b9f-f295-3869-9183-f745f215d080",
                        "tags": [
                            "plural"
                        ],
