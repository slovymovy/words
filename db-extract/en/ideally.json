                    {
                        "sense_id": "3770e9d1-e67e-3214-aec8-b15f64e488fe",
                        "entry_id": "b3af9dd7-77ca-3d95-8b69-fa1e7e52f4f2",
                        "glosses": [
                            "In an ideal way; perfectly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bff029d-8831-44ac-97d9-ed554737a12b",
                                "sense_id": "3770e9d1-e67e-3214-aec8-b15f64e488fe",
                                "text": "The summit of Mauna Kea is considered the ideal place to mount an astronomical observatory, for above the clouds there is only the stars and the skies are ideally transparent."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffba20ca-5aef-3069-be84-94ac11c721fc",
                        "entry_id": "b3af9dd7-77ca-3d95-8b69-fa1e7e52f4f2",
                        "glosses": [
                            "Given ideal circumstances; preferably."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "915cf997-6a33-40a6-9974-2c0d463ccd24",
                                "sense_id": "ffba20ca-5aef-3069-be84-94ac11c721fc",
                                "text": "Ideally, we would have one textbook per student, but unfortunately some of you will have to share."
                            }
                        ]
                    }
                ],
