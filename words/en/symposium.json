    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf73875f-5792-3e38-bce1-f52a05f7fcce",
                    "sense_definition": "A formal meeting or conference where experts discuss a particular topic and often give presentations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "academic_meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university is hosting an international <w>symposium</w> on climate change next month.",
                            "target_lang_translations": {
                                "ru": "В следующем месяце университет проводит международный <w>симпозиум</w> по вопросам изменения климата."
                            }
                        },
                        {
                            "text": "She was invited to give a keynote speech at the annual medical <w>symposium</w>.",
                            "target_lang_translations": {
                                "ru": "Ее пригласили выступить с программной речью на ежегодном медицинском <w>симпозиуме</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "conference",
                        "convention",
                        "colloquium",
                        "seminar"
                    ],
                    "common_phrases": [
                        "annual symposium",
                        "international symposium",
                        "host a symposium",
                        "keynote speech"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное собрание или конференция, на которой эксперты обсуждают определенную тему и часто выступают с докладами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симпозиум",
                                "target_lang_sense_clarification": "научная конференция или совещание"
                            },
                            {
                                "target_lang_word": "конференция",
                                "target_lang_sense_clarification": "собрание для обсуждения вопросов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45222ae3-a670-3f05-843e-5aabf1c8bccf",
                    "sense_definition": "A collection of essays or papers on a specific subject written by different authors and published together.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journal published a <w>symposium</w> of articles regarding the recent economic crisis.",
                            "target_lang_translations": {
                                "ru": "Журнал опубликовал <w>симпозиум</w> статей, посвященных недавнему экономическому кризису."
                            }
                        },
                        {
                            "text": "This book is a <w>symposium</w> by writers who are mostly specialists in their respective fields.",
                            "target_lang_translations": {
                                "ru": "Эта книга представляет собой <w>сборник</w> работ писателей, большинство из которых являются специалистами в своих областях."
                            }
                        }
                    ],
                    "synonyms": [
                        "anthology",
                        "compendium",
                        "collection"
                    ],
                    "common_phrases": [
                        "published symposium",
                        "symposium of essays"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сборник эссе или статей на определенную тему, написанных разными авторами и опубликованных вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симпозиум",
                                "target_lang_sense_clarification": "сборник статей разных авторов"
                            },
                            {
                                "target_lang_word": "сборник",
                                "target_lang_sense_clarification": "коллекция трудов или статей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e558f47-ea4f-3e62-8f4a-c7b1b0017496",
                    "sense_definition": "A drinking party in Ancient Greece, often characterized by intellectual conversation and music.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plato's famous dialogue describes a <w>symposium</w> where guests discuss the nature of love.",
                            "target_lang_translations": {
                                "ru": "Знаменитый диалог Платона описывает <w>симпосий</w>, на котором гости обсуждают природу любви."
                            }
                        },
                        {
                            "text": "In Ancient Greece, the <w>symposium</w> was a key social institution for aristocratic men.",
                            "target_lang_translations": {
                                "ru": "В Древней Греции <w>симпосий</w> был важным социальным институтом для мужчин-аристократов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Ancient Greece",
                        "Platonic symposium"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ритуальное пиршество в Древней Греции, сопровождавшееся интеллектуальными беседами и музыкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симпосий",
                                "target_lang_sense_clarification": "античный пир"
                            },
                            {
                                "target_lang_word": "симпозиум",
                                "target_lang_sense_clarification": "исторический термин для греческого пира"
                            }
                        ]
                    }
                }
            ]
        }
    ]
