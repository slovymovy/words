                "senses": [
                    {
                        "sense_id": "32cb51a9-c6dc-3c5b-bf97-c425dfd0f447",
                        "entry_id": "8cbdac0b-80d7-3762-817e-7c957ab31fdf",
                        "glosses": [
                            "binnen einer bestimmten Zeit, innerhalb einer bestimmten Zeit, im Verlaufe einer bestimmten Zeit"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "genitive prepositional",
                            "with-dative"
                        ],
                        "examples": [
                            {
                                "example_id": "2f9dc5fc-97e9-45d0-b42a-2483ce198985",
                                "sense_id": "32cb51a9-c6dc-3c5b-bf97-c425dfd0f447",
                                "text": "„Der Internetkonzern Google will innert Wochenfrist prüfen, wie Verbesserungen an Street View umgesetzt werden können.“"
                            },
                            {
                                "example_id": "37f6b5bf-c3a2-4849-abbd-27ee3a498177",
                                "sense_id": "32cb51a9-c6dc-3c5b-bf97-c425dfd0f447",
                                "text": "„Zum zweiten Mal innert vier Monaten ist der amerikanische Botschafter in Italien von Ministerpräsident Berlusconi zitiert worden.“"
                            },
                            {
                                "example_id": "6880a0aa-8589-4a0f-b9b2-16486b3b2d00",
                                "sense_id": "32cb51a9-c6dc-3c5b-bf97-c425dfd0f447",
                                "text": "„Bei zwei Kollisionen mit zwei Zügen innert einer Stunde auf der Bahnlinie zwischen Ins und Biel sind am Donnerstagmorgen ein Radfahrer getötet und ein Autolenker schwer verletzt worden.“"
                            },
                            {
                                "example_id": "77ff9619-f769-48a0-86d8-8a69813a7eca",
                                "sense_id": "32cb51a9-c6dc-3c5b-bf97-c425dfd0f447",
                                "text": "„Wie das Statistische Amt des Kantons Zürich und Statistik Stadt Zürich am Mittwoch mitteilten, sank die Anzahl leerer Wohnungen in der Stadt Zürich innert einem Jahr um 11.“"
                            },
                            {
                                "example_id": "ec3f5da2-ad89-416e-931f-1b55369c974f",
                                "sense_id": "32cb51a9-c6dc-3c5b-bf97-c425dfd0f447",
                                "text": "„Die Pro-Kopf- Steuerkraft hat in Rüschlikon Rekordhöhen erreicht, was dazu führt, dass die Beiträge an den kantonalen Finanzausgleich sich innert einem Dutzend Jahre fast verfünffacht haben und 2007 26,5 Millionen Franken erreichen.“"
                            },
                            {
                                "example_id": "c07a5ee8-a0f9-47a0-8ddd-ca9f91e9ba4c",
                                "sense_id": "32cb51a9-c6dc-3c5b-bf97-c425dfd0f447",
                                "text": "„Die Republik Irland wurde innert eines Jahrzehnts zur zweitreichsten Nation im Pro-Kopf-Vergleich.“"
                            },
                            {
                                "example_id": "b642c355-1c68-40b8-88e0-c21e2c0cf535",
                                "sense_id": "32cb51a9-c6dc-3c5b-bf97-c425dfd0f447",
                                "text": "„Innert eines Jahres will der Ständerat über Alternativen zum Zulassungsstopp für Arztpraxen beraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
