{
    "word_family": [
        "olbrzym",
        "olbrzymi",
        "wyolbrzymienie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "024f7ea3-0ba8-35cd-8fde-9715aaca0a1f",
                    "sense_definition": "przedstawiać coś jako ważniejsze, większe lub poważniejsze niż jest w rzeczywistości",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przesada",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie ma sensu <w>wyolbrzymiać</w> tego drobnego problemu, bo szybko go rozwiążemy.",
                            "target_lang_translations": {
                                "ru": "Нет смысла <w>преувеличивать</w> эту мелкую проблему, потому что мы быстро её решим."
                            }
                        },
                        {
                            "text": "Media często <w>wyolbrzymiają</w> zagrożenia, aby przyciągnąć uwagę czytelników.",
                            "target_lang_translations": {
                                "ru": "СМИ часто <w>преувеличивают</w> угрозы, чтобы привлечь внимание читателей."
                            }
                        }
                    ],
                    "synonyms": [
                        "przesadzać",
                        "przerysowywać",
                        "przejaskrawiać"
                    ],
                    "common_phrases": [
                        "wyolbrzymiać problem",
                        "wyolbrzymiać zagrożenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "представлять что-либо более важным, значительным или серьезным, чем оно есть на самом деле"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преувеличивать",
                                "target_lang_sense_clarification": "наиболее распространенный вариант, означающий придавать чему-то чрезмерное значение"
                            },
                            {
                                "target_lang_word": "раздувать",
                                "target_lang_sense_clarification": "разговорный вариант, часто используется в контексте проблем или скандалов"
                            },
                            {
                                "target_lang_word": "гиперболизировать",
                                "target_lang_sense_clarification": "книжный термин, означающий использование преувеличения как приема"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80362eae-c35c-3e2e-8ad9-659f5b4c40b3",
                    "sense_definition": "stawać się znacznie większym",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wzrost",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W jego wyobraźni strach zaczął <w>wyolbrzymiać</w> się do niewyobrażalnych rozmiarów.",
                            "target_lang_translations": {
                                "ru": "В его воображении страх начал <w>разрастаться</w> до невообразимых размеров."
                            }
                        },
                        {
                            "text": "Z każdym dniem niepewność <w>wyolbrzymia</w> się w oczach czekających ludzi.",
                            "target_lang_translations": {
                                "ru": "С каждым днем неуверенность <w>разрастается</w> в глазах ожидающих людей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "становиться значительно больше, разрастаться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрастаться",
                                "target_lang_sense_clarification": "увеличиваться в размерах или масштабах"
                            },
                            {
                                "target_lang_word": "раздуваться",
                                "target_lang_sense_clarification": "становиться больше, часто о чувствах или абстрактных понятиях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}