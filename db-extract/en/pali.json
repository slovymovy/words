                                        "sense_id": "a86f5728-12e1-38df-b73e-b959d75f0609",
                                        "entry_id": "d83ca257-c11f-3810-bea6-2ccd9af9131d",
                                        "glosses": [
                                            "Relatif à la langue sacrée du bouddhisme theravāda."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f330914-94e8-4fce-aa93-1853b8d96265",
                                                "sense_id": "a86f5728-12e1-38df-b73e-b959d75f0609",
                                                "text": "La langue palie."
                                            },
                                            {
                                                "example_id": "bf7be05e-c922-4e38-85c5-3cd7e0d62c08",
                                                "sense_id": "a86f5728-12e1-38df-b73e-b959d75f0609",
                                                "text": "Un idiome pali."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pali",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e52e853-e0a2-3ece-b171-5dbaf7f7a15c",
                                        "entry_id": "1d630684-28c9-3164-b73b-bce957be5e7c",
                                        "glosses": [
                                            "Ancienne langue d’Asie du Sud, dans laquelle sont écrits les textes sacrés du bouddhisme theravāda; langue sacrée de l’île de Ceylan, apparentée au sanscrit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17d240ab-b491-4ce7-a213-4c53c189f87e",
                                                "sense_id": "4e52e853-e0a2-3ece-b171-5dbaf7f7a15c",
                                                "text": "Étudier le pali."
                                            },
                                            {
                                                "example_id": "f5c15fd7-8464-4234-89ee-8f862fc842c4",
                                                "sense_id": "4e52e853-e0a2-3ece-b171-5dbaf7f7a15c",
                                                "text": "Dans l’Inde, c’est le sanskrit, avec son admirable richesse, de formes grammaticales, ses huit cas, ses six modes, ses désinences nombreuses, sa phrase implexe et si puissamment nouée, qui, en s’altérant, produit le pali, le prakrit et le kawi, dialectes moins riches, plus simples et plus clairs."
                                            },
                                            {
                                                "example_id": "f98eb335-b81b-45df-ab60-372758b5c751",
                                                "sense_id": "4e52e853-e0a2-3ece-b171-5dbaf7f7a15c",
                                                "text": "En langue indo-européenne, le pali, la générosité, qui se dit dana, est la première des dix perfections."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "164364f1-1448-4cf5-b864-efc3e6c39ebf",
                        "source_entry_id": "b4017d86-37af-392b-9a86-af0cf34a8925",
                        "source_sense_id": "1474dfdd-b225-3a16-8b8f-a0df0759ce6c",
                        "source_sense_description": "a Middle Indo-Aryan language",
                        "target_lang_word": "Pali",
