                                        "glosses": [
                                            "Action de préférer une personne, une chose ou une situation à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "666a5c57-f04e-455c-aafd-265517f3e3f2",
                                                "sense_id": "1897a690-2778-3ebf-91c4-2eba4fe99221",
                                                "text": "La préférence, quel sujet !"
