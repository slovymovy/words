                "senses": [
                    {
                        "sense_id": "e0eda573-e997-3744-88c8-ba2ae1639c2d",
                        "entry_id": "26c2145a-b356-35b2-8004-a625451fa8cf",
                        "glosses": [
                            "Donner un caractère liquoreux à, transformer en liqueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "972c2c4f-59fe-4e33-a7da-9d8f1235e9c3",
                                "sense_id": "e0eda573-e997-3744-88c8-ba2ae1639c2d",
                                "text": "Mais François Guy confie aussi qu'il adorerait trouver un jour la façon de liquoriser le pissenlit…"
                            },
                            {
                                "example_id": "74216efc-6695-4eb9-a927-4a4f1bbc9a57",
                                "sense_id": "e0eda573-e997-3744-88c8-ba2ae1639c2d",
                                "text": "Et aussi une tendance à liquoriser et à sucrer sur du moelleux de musc blanc."
                            },
                            {
                                "example_id": "715cf962-d9d7-4dd5-92de-adfcc3f741a7",
                                "sense_id": "e0eda573-e997-3744-88c8-ba2ae1639c2d",
                                "text": "C’était du vin blanc italien, et depuis 4 ans il est devenu rosé et s’est liquorisé."
                            }
                        ]
                    }
