                                "target_lang_sense_clarification": "ряд событий или предметов"
                            },
                            {
                                "target_lang_word": "цепочка",
                                "target_lang_sense_clarification": "связанных событий, часто неприятных"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Reihe",
                                "target_lang_sense_clarification": "aufeinanderfolgende Ereignisse oder Dinge"
                            },
                            {
                                "target_lang_word": "Serie",
                                "target_lang_sense_clarification": "gleichartige Ereignisse oder Vorfälle"
                            },
                            {
                                "target_lang_word": "Kette",
                                "target_lang_sense_clarification": "verbundene, oft unerwünschte Ereignisse"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "serie",
                                "target_lang_sense_clarification": "de acontecimientos o cosas"
                            },
                            {
                                "target_lang_word": "sucesión",
                                "target_lang_sense_clarification": "orden de acontecimientos consecutivos"
                            },
                            {
                                "target_lang_word": "cadena",
                                "target_lang_sense_clarification": "acontecimientos encadenados, a menudo negativos"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "系列",
                                "target_lang_sense_clarification": "一连串相关的事件或事物"
                            },
                            {
                                "target_lang_word": "序列",
                                "target_lang_sense_clarification": "有先后顺序的排列"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdebd465-f3d8-36c6-b664-17f33d03c65e",
                    "sense_definition": "Transmission des biens et des droits d'une personne décédée, ou ensemble de ce patrimoine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "heritage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants ont dû faire appel à un notaire pour régler la <w>succession</w> de leurs parents.",
                            "target_lang_translations": {
                                "en": "The children had to call on a notary to settle their parents' <w>estate</w>.",
                                "ru": "Детям пришлось обратиться к нотариусу, чтобы урегулировать <w>наследство</w> родителей.",
                                "de": "Die Kinder mussten einen Notar einschalten, um den <w>Nachlass</w> ihrer Eltern abzuwickeln.",
                                "es": "Los hijos tuvieron que acudir a un notario para tramitar la <w>sucesión</w> de sus padres.",
                                "zh": "孩子们不得不请公证人来处理父母的<w>遗产</w>。"
                            }
                        },
                        {
                            "text": "Il a payé d'importants droits de <w>succession</w> après avoir hérité de la maison familiale.",
                            "target_lang_translations": {
                                "en": "He paid substantial <w>inheritance</w> tax after inheriting the family home.",
                                "ru": "Он заплатил крупный налог на <w>наследство</w> после того, как унаследовал семейный дом.",
                                "de": "Nachdem er das Familienhaus geerbt hatte, zahlte er hohe <w>Erbschaftsteuer</w>.",
                                "es": "Pagó un importante impuesto de <w>sucesiones</w> tras heredar la casa familiar.",
                                "zh": "他继承家中老宅后，为这份<w>遗产</w>缴纳了一大笔税款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "héritage",
                        "patrimoine"
                    ],
                    "common_phrases": [
                        "droits de succession",
                        "ouvrir une succession",
                        "régler une succession"
                    ],
                    "target_lang_definitions": {
                        "en": "The transfer of a deceased person's property and rights to their heirs, or the estate itself.",
                        "ru": "Передача имущества и прав умершего его наследникам или само это имущество.",
                        "de": "Übertragung des Vermögens und der Rechte einer verstorbenen Person oder das Vermögen selbst.",
                        "es": "Transmisión de los bienes y derechos de una persona fallecida a sus herederos, o conjunto de ese patrimonio.",
                        "zh": "死者的财产及权利转移给继承人的过程，或指这些遗留下来的财产本身。"
                    },
                    "translations": {
