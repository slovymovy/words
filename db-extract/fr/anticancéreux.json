                "senses": [
                    {
                        "sense_id": "dfd6181b-438d-39ee-bf1e-2de90a5cc24a",
                        "entry_id": "23f85e85-819e-3e71-b061-bfe2b6cb9bf0",
                        "glosses": [
                            "Qui lutte contre le cancer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "700fd6f6-2735-4916-b7d7-3212ce9c6565",
                                "sense_id": "dfd6181b-438d-39ee-bf1e-2de90a5cc24a",
                                "text": "Il est aussi connu pour ses actions anticancéreuse et cardio-protectrice."
                            },
                            {
                                "example_id": "e4d5755b-1274-407f-8cb1-dd21d7c06b1a",
                                "sense_id": "dfd6181b-438d-39ee-bf1e-2de90a5cc24a",
                                "text": "Homologué en 1997 en Europe, l’Anzemet (Anemet en Allemagne) est utilisé pour prévenir les nausées et vomissements lors de chimiothérapies anticancéreuses."
                            },
                            {
                                "example_id": "a59f4e1f-9474-48f5-9ee6-0107852b5f8a",
                                "sense_id": "dfd6181b-438d-39ee-bf1e-2de90a5cc24a",
                                "text": "Malheureusement, l’association des deux thérapies (gp100 et Ipilimumab) n’augmente pas l’efficacité anticancéreuse de l’Ipilimumab."
                            }
                        ]
                    }
                ],
