                        ],
                        "examples": [
                            {
                                "example_id": "54d31c92-6ba3-4d3c-b90c-b3eaa62db167",
                                "sense_id": "3fea6df3-0805-33b7-9292-ef13245d6ba6",
                                "text": "Любая, и даже обычная дистиллированная, вода содержит немало гидратированных форм окиси железа."
                            },
                            {
                                "example_id": "11e10373-c240-495f-98d1-269f02fb72fe",
                                "sense_id": "3fea6df3-0805-33b7-9292-ef13245d6ba6",
                                "text": "Хорошо известно, что вирионы гриппа гидратированы."
                            }
                        ]
                    }
