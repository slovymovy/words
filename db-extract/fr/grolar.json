                        "glosses": [
                            "Animal hybride issu du croisement d’un ours polaire et d’un grizzly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "644737ac-9859-4162-a999-6108a14f70f0",
                                "sense_id": "d0d485f7-2b5b-34b8-a44a-e33d71bd3f7d",
                                "text": "Le grolar est effondré contre les restes d’un chariot élévateur, géant à la fourrure marbrée qui ratisse l’air de ses immenses griffes tout en se vidant de son sang par le trou dans son flanc."
                            }
                        ]
                    }
                ],
