                    },
                    {
                        "translation_id": "2be8d47d-f912-4e4c-9924-224f733411e7",
                        "source_entry_id": "2b855d31-b84c-3660-83a7-19653ff5b969",
                        "source_sense_id": "3bd3b7f8-48f9-3ee5-bf77-740dec052187",
                        "target_lang_word": "jury",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jury",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "adc2cafa-6817-3589-9856-8e3146a5365c",
                                        "entry_id": "1b0a1e43-3eab-338b-abc2-32fc8d8504e7",
                                        "glosses": [
                                            "Tous les jurés désignés pour une session, ou seulement des douze jurés auxquels une affaire est soumise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b9ce6a0-b149-469e-8a5e-0064d7b4268a",
                                                "sense_id": "adc2cafa-6817-3589-9856-8e3146a5365c",
                                                "text": "Sous le code de brumaire an IV, cette institution s’appelait le jury d’accusation par opposition au jury de jugement."
                                            },
                                            {
                                                "example_id": "fd35075c-cba7-45d6-8c10-55f734144c82",
                                                "sense_id": "adc2cafa-6817-3589-9856-8e3146a5365c",
                                                "text": "M. le juge d’instruction Guillot demande, avec raison, que l’on enferme aussi étroitement ces candidats à la folie, ces demi-fous, demi-criminels, demi-responsables dont l’acquittement est arraché à la faiblesse et à la crédulité des jurys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10d37271-8357-307d-a2ab-a730864b55c3",
                                        "entry_id": "1b0a1e43-3eab-338b-abc2-32fc8d8504e7",
                                        "glosses": [
                                            "Réunion de citoyens n’appartenant pas à la magistrature et appelés par tirage au sort à participer à un jugement en cour d’assises."
                                        ],
                                        "tags": [
                                            "Jurisprudence criminelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cffdeea2-5ba8-4522-bddb-2bea7a443150",
                                                "sense_id": "10d37271-8357-307d-a2ab-a730864b55c3",
                                                "text": "Il approuve hautement le comité de vigilance de la Nouvelle-Orléans qui en 1890 pendit, « à la grande satisfaction de tous les honnêtes gens », des maffiosi acquittés par le jury."
                                            },
                                            {
                                                "example_id": "c705d48f-05f8-4a99-bff7-31134a5733a7",
                                                "sense_id": "10d37271-8357-307d-a2ab-a730864b55c3",
                                                "text": "La cité grecque, que nous avons imitée jusqu’à aujourd’hui sur ce point, institue des jurys, représentant le peuple tout entier, qui ont à charge de rendre la justice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbcbe9e5-c187-3cc2-bbbd-171de7908820",
                                        "entry_id": "1b0a1e43-3eab-338b-abc2-32fc8d8504e7",
                                        "glosses": [
                                            "Réunion d’arbitres désignés pour décider d’une question qui intéresse l’honneur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27ab4aae-1e41-4c0a-b47f-9351c89aa876",
                                                "sense_id": "bbcbe9e5-c187-3cc2-bbbd-171de7908820",
                                                "text": "jury d’honneur"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da0ef39e-2235-3d35-a351-22df73f53a65",
                                        "entry_id": "1b0a1e43-3eab-338b-abc2-32fc8d8504e7",
                                        "glosses": [
                                            "Commission chargée de prendre une décision, en particulier pour un concours ou un examen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45c4db02-5d44-440f-8389-d8cc682b5abf",
                                                "sense_id": "da0ef39e-2235-3d35-a351-22df73f53a65",
                                                "text": "Le jury d’une exposition. Le jury d’agrégation."
                                            },
                                            {
                                                "example_id": "ceabee48-a8a2-4eac-a030-7a1b9d0b2444",
                                                "sense_id": "da0ef39e-2235-3d35-a351-22df73f53a65",
                                                "text": "Le jury des concours du Conservatoire."
                                            },
                                            {
                                                "example_id": "823bdcd0-3b77-4f8c-a6d6-0750b9c0c9c8",
                                                "sense_id": "da0ef39e-2235-3d35-a351-22df73f53a65",
                                                "text": "jury d’expropriation, jury qui statue sur les indemnités à accorder en cas d’expropriation."
                                            },
                                            {
                                                "example_id": "f3ed5497-3c2e-4ea4-bd6c-54af11255d49",
                                                "sense_id": "da0ef39e-2235-3d35-a351-22df73f53a65",
                                                "text": "Quand ils ne peuvent s’entendre, l’affaire est portée devant un jury qui se prononce souverainement sur l’offre de la Ville et la demande du propriétaire ou du locataire exproprié."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
