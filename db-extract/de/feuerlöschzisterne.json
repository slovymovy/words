                "senses": [
                    {
                        "sense_id": "4f43705a-c9ce-3339-87e5-171fc9871f33",
                        "entry_id": "90cb60a5-fbd3-320f-b738-76edf7dd1151",
                        "glosses": [
                            "Zisterne, die Wasser zum Löschen eines Brandes enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "857f9e1a-7e12-46c5-9079-51c83932ea88",
                                "sense_id": "4f43705a-c9ce-3339-87e5-171fc9871f33",
                                "text": "„Eine Feuerlöschzisterne wurde 1975 errichtet.“"
                            },
                            {
                                "example_id": "1a46b04f-c431-4886-9497-5ecfcbcacaec",
                                "sense_id": "4f43705a-c9ce-3339-87e5-171fc9871f33",
                                "text": "„Behandelt werden auch die Fußgängerampel an der Becher-Kreuzung, eine Feuerlöschzisterne im Ortsteil Penting sowie die Umsatzsteuerpflicht der Stadt, der Eigenbetriebe sowie der Spitalstiftung Neunburg.“"
                            },
                            {
                                "example_id": "cbb16417-6290-4af3-a6e8-7e2f6700e403",
                                "sense_id": "4f43705a-c9ce-3339-87e5-171fc9871f33",
                                "text": "„Im Grimmaer Ortsteil Papsdorf wird für 60.000 Euro eine Feuerlöschzisterne errichtet.“"
                            },
                            {
                                "example_id": "4be8e58a-8073-4e3e-9b94-9c4544b24e8f",
                                "sense_id": "4f43705a-c9ce-3339-87e5-171fc9871f33",
                                "text": "„Die wegen der frostigen und schneereichen Witterung im November abgebrochenen Arbeiten an der Feuerlöschzisterne in Langenhain werden nun fortgeführt.“"
                            },
                            {
                                "example_id": "24372e48-d65c-42ef-bdb8-e67877465d3e",
                                "sense_id": "4f43705a-c9ce-3339-87e5-171fc9871f33",
                                "text": "„Eine bessere Trinkwasservernetzung in Prath würde auch das Löschwassersystem optimieren, denn zurzeit deckt die alte Feuerlöschzisterne nur die Hälfte des Bedarfs ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
