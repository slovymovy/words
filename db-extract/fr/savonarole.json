                "senses": [
                    {
                        "sense_id": "f4873211-8558-3b8a-8f7b-a2b393c5533e",
                        "entry_id": "448e6d91-3578-3b87-bbd0-cef6dba30405",
                        "glosses": [
                            "Personnage qui impose, par la conviction ou par la force, des pratiques doctrinaires."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "f7dda046-9914-452b-a9cc-5868c6de04a7",
                                "sense_id": "f4873211-8558-3b8a-8f7b-a2b393c5533e",
                                "text": "Florence tournait définitivement le dos aux imprécations des savonaroles au petit pied. Elle renouait avec les cérémonies, avec la magnificence, avec la vie."
                            },
                            {
                                "example_id": "5342e91f-359d-46e9-8ce0-20c5ee99eb4c",
                                "sense_id": "f4873211-8558-3b8a-8f7b-a2b393c5533e",
                                "text": "Entre chaises vides de cathédrales devenues musées et chaires à prêchi-prêcha des savonaroles du cours du dol’, pitié. Entre les uns qui en ont fini avec le ciel et les autres qui promettent l'enfer à ceux qui ne croient pas comme eux, il est où le pardon ?"
                            }
                        ]
                    }
