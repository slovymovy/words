                        "examples": [
                            {
                                "example_id": "34ad2263-3ada-4f94-a664-a39b36a5f76e",
                                "sense_id": "58824551-9e89-3ee9-89f1-285b26efe19f",
                                "text": "De baan van Venus bevindt zich op zo'n 108 miljoen km van de Zon, waarbij de planeet om de 584 dagen tussen de Aarde en de Zon doorloopt. Door de hoek van 3.39 graden tussen de Venusbaan en onze eigen baan, doet een overgang zich alleen voor wanneer de planeet zich tijdens haar samenstand met de Zon tegelijk in de buurt van de knopenlijn, de snijlijn van de twee baanvlakken, bevindt."
                            }
                        ]
                    },
                    {
                        "sense_id": "efda594c-c4e0-3d9c-881d-e12c57fc3751",
                        "entry_id": "f4cedc30-3536-3390-930e-8290419ba2fc",
                        "glosses": [
                            "iets dat behoort tot twee verschillende vak- of interesse gebieden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce24a855-635a-4748-9842-b5a9a91c5922",
                                "sense_id": "efda594c-c4e0-3d9c-881d-e12c57fc3751",
                                "text": "De mensen die je ontmoet op de snijlijnen van het debat rond je werk, brengen nieuwe ideeën op gang. Zo kan ik werken met nieuwe technologieën: wij maakten al interne scans toen die techniek nog in de kinderschoenen stond. Idem voor 3D-printing, dat wij als een van de eersten tentoon konden stellen."
                            }
                        ]
                    }
