                ],
                "senses": [
                    {
                        "sense_id": "bb9908cc-a5f0-329a-a374-fc78bb1f81ff",
                        "entry_id": "be3bdd11-4599-31f9-b669-5d6343421472",
                        "glosses": [
                            "niet aanvaardbaar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8682b52d-1b18-47d1-a3ca-fb94f35de95f",
                                "sense_id": "bb9908cc-a5f0-329a-a374-fc78bb1f81ff",
                                "text": "Mishandeling van iemand is een onacceptabele daad."
                            },
                            {
                                "example_id": "fb0d1af7-c652-4c2a-a07b-cc1cfa574cea",
                                "sense_id": "bb9908cc-a5f0-329a-a374-fc78bb1f81ff",
                                "text": "Begin vorig jaar kwam politiek commentator, activist en lobbyist, Sywert van Lienden in actie om het zorgpersoneel aan beschermingsmiddelen te helpen. Hij stelde miljoenen Chinese mondkapjes veilig voor de Nederlandse zorg. Belangeloos, naar eigen zeggen. Geheim bleef dat hij via een eigen bedrijf toch verdiende aan de pandemie, en dat het RIVM zijn mondkapjes kwalificeerde als ‘een onacceptabel gezondheidsrisico’."
                            }
                        ]
                    }
                ],
