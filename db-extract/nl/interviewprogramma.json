                        "examples": [
                            {
                                "example_id": "380b8961-84d3-432d-aa74-1cb2879425be",
                                "sense_id": "417f32d6-ed15-39c7-b5de-58a2488ea2e6",
                                "text": "De drie nieuwe getuigen in het proces over de treinkaping bij De Punt in 1977 waren zelf niet betrokken bij de bestorming van de trein en de bezette basisschool in Bovensmilde. Dat heeft een van de drie, oud-marinier Ingo Piepers, gezegd in het interviewprogramma 1 op 1 op NPO Radio 1."
                            },
                            {
                                "example_id": "34f8803a-883e-49e4-8a0d-4749bceaa2e5",
                                "sense_id": "417f32d6-ed15-39c7-b5de-58a2488ea2e6",
                                "text": "Twee prominente journalisten zijn in de Verenigde Staten beschuldigd van seksueel wangedrag. Het gaat om Witte Huis-verslaggever Glenn Thrush van The New York Times en Charlie Rose, die op de publieke omroep PBS een gerenommeerd interviewprogramma heeft en een ochtendshow presenteert bij CBS."
                            },
                            {
                                "example_id": "c6e4cd20-e73b-4355-a447-d1accbc7fc75",
                                "sense_id": "417f32d6-ed15-39c7-b5de-58a2488ea2e6",
                                "text": "Brandt Corstius werkte van 2002 tot 2005 als redacteur voor Barend & Van Dorp. Daarna woonde hij van 2005 tot 2010 in Moskou, waar hij werkte als correspondent voor Trouw, De Standaard en mensenrechtenmagazine Wordt Vervolgd. In 2010 en 2011 presenteerde hij het interviewprogramma Zomergasten."
                            }
                        ]
                    }
