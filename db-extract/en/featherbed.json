                "translations": [
                    {
                        "translation_id": "0922ea5d-98b9-4e5b-9a0d-a31217a1e2e6",
                        "source_entry_id": "0c1da32a-8ae6-3620-b29a-46ea99261824",
                        "source_sense_description": "to pamper, cosset or mollycoddle",
                        "target_lang_word": "verwöhnen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verwöhnen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b9925a4-d77f-317c-8050-176ffa691ebf",
                                        "entry_id": "93628ed7-65c0-33c0-b932-8c80e0d5d888",
                                        "glosses": [
                                            "jemandem Gutes tun, indem man ihm besondere Vorteile zukommen lässt und vor Unbehagen schützt, und dies, ohne eine besondere Gegenleistung zu erwarten/erhalten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8afe99b5-4e1b-4d0d-9a2a-e28279c44cb0",
                                                "sense_id": "3b9925a4-d77f-317c-8050-176ffa691ebf",
                                                "text": "Er verwöhnte sie mit allerlei Leckerbissen."
                                            },
                                            {
                                                "example_id": "33ecbf21-be75-40f7-9b85-133ff9309fe3",
                                                "sense_id": "3b9925a4-d77f-317c-8050-176ffa691ebf",
                                                "text": "„Er fängt sich nie mehr, verfällt zunehmend, verwöhnt sich nur mehr ab und zu mit einem Glas Rotwein oder Mozartkugeln.“"
                                            },
                                            {
                                                "example_id": "979e466c-528a-462e-ab30-729f4e604398",
                                                "sense_id": "3b9925a4-d77f-317c-8050-176ffa691ebf",
                                                "text": "„Wer nicht reisen kann und auch nicht ausgeht, verwöhnt sich halt zu Hause.“"
                                            },
                                            {
                                                "example_id": "44817c20-2240-4126-acb3-9e90ce9e2f8d",
                                                "sense_id": "3b9925a4-d77f-317c-8050-176ffa691ebf",
                                                "text": "„Denn vier Kilometer von seinem Haus in Sarasota entfernt verwöhnt ihn die Metzgerei Geier mit deutschen Spezialitäten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2b46885-fb4a-30bd-92b8-3b029686ad12",
                                        "entry_id": "93628ed7-65c0-33c0-b932-8c80e0d5d888",
                                        "glosses": [
                                            "jemanden so sehr vor allem Unbehaglichen abschirmen, dass dieser unselbstständig wird und Probleme hat, sich in der realen Welt zu behaupten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90c313c7-5b0e-4a40-81d7-22f636964a98",
                                                "sense_id": "b2b46885-fb4a-30bd-92b8-3b029686ad12",
                                                "text": "Diese verwöhnte Rotznase sollte mal was für ihr Taschengeld tun!"
                                            },
                                            {
                                                "example_id": "7151638d-29d5-4e66-9086-fa1a26c6f812",
                                                "sense_id": "b2b46885-fb4a-30bd-92b8-3b029686ad12",
                                                "text": "„Hab ich dir nicht immer gesagt, du verwöhnst ihn zu sehr?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
