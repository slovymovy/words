                    "frequency": "Low",
                    "semantic_group_id": "verwerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze antieke stoel had prachtig met de hand <w>bewerkte</w> poten.",
                            "target_lang_translations": {
                                "en": "This antique chair had beautiful hand-<w>carved</w> legs."
                            }
