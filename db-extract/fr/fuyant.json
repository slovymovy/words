                "senses": [
                    {
                        "sense_id": "9fd4f310-1151-3af4-9891-cb8ebac2dda3",
                        "entry_id": "2a281656-7023-3993-b733-f635a5a72997",
                        "glosses": [
                            "Qui va en arrière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc57c714-967b-4839-ad57-af6ef3f18897",
                                "sense_id": "9fd4f310-1151-3af4-9891-cb8ebac2dda3",
                                "text": "Front fuyant."
                            },
                            {
                                "example_id": "966463bc-f5a8-4ae1-8bac-ccbdb49dd2d2",
                                "sense_id": "9fd4f310-1151-3af4-9891-cb8ebac2dda3",
                                "text": "La bouche était indécise et molle, le menton fuyant, le nez camus; les yeux louchaient, ne louchaient pas tellement, louchaient un peu, si peu !"
                            }
                        ]
                    },
                    {
                        "sense_id": "30a5a3ed-71c8-3ed7-adcb-bb8f6b5a95a7",
                        "entry_id": "2a281656-7023-3993-b733-f635a5a72997",
                        "glosses": [
                            "Tout ce qui, comparé à un autre objet, paraît s’enfoncer dans le tableau."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "b07d5edd-0291-4b0f-9a49-7be8b36547fb",
                                "sense_id": "30a5a3ed-71c8-3ed7-adcb-bb8f6b5a95a7",
                                "text": "Les parties fuyantes d’un tableau."
                            }
                        ]
                    },
                    {
                        "sense_id": "96239828-2e76-3e21-9b4c-272034405a92",
                        "entry_id": "2a281656-7023-3993-b733-f635a5a72997",
                        "glosses": [
                            "Qualifie l'échelle qu’on trace pour trouver la diminution des objets, relativement à leur enfoncement."
                        ],
                        "tags": [
                            "Perspective"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ea7a2e13-96b9-39ce-a667-907e835c0ded",
                        "entry_id": "2a281656-7023-3993-b733-f635a5a72997",
                        "glosses": [
                            "Qui se dérobe aux déclarations franches."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "21d660d1-39c9-4e81-bd2e-e079323e0200",
                                "sense_id": "ea7a2e13-96b9-39ce-a667-907e835c0ded",
                                "text": "Caractère fuyant, Homme fuyant."
                            }
                        ]
                    },
                    {
                        "sense_id": "24f61f9e-b39e-35c7-8876-25ba7525ea1e",
                        "entry_id": "2a281656-7023-3993-b733-f635a5a72997",
                        "glosses": [
                            "Qualifie un regard très mobile mais jamais dirigé sur l’interlocuteur."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "17d19867-1496-45fb-8f6e-08c784264109",
                                "sense_id": "24f61f9e-b39e-35c7-8876-25ba7525ea1e",
                                "text": "Un regard ajusté est tout le contraire d’un regard fuyant (on regarde tout sauf l’interlocuteur), embarrassé, gêné, en biais."
                            },
                            {
                                "example_id": "90cf9e89-a972-46ed-b9e3-d6409f8d78c4",
                                "sense_id": "24f61f9e-b39e-35c7-8876-25ba7525ea1e",
                                "text": "Le premier jour de cours notre professoresse, une Siennoise blonde d'une trentaine d'années, douce et au regard fuyant, un peu trop pressée, peut-être un rien dépressive, commença par nous demander de nous présenter en disant notre prénom, d'où nous venions et ce que nous avions pris ce matin-là pour le petit déjeuner."
                            }
                        ]
                    }
