                ],
                "senses": [
                    {
                        "sense_id": "3c2aaad5-c3b2-33f7-915a-c840414c9301",
                        "entry_id": "69c7a6cf-75ac-3ad9-8f75-4846aafff430",
                        "glosses": [
                            "im Monat Januar wehender, kräftiger Sturm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3def9336-e42a-4c3c-80c2-7b4c8e4e1404",
                                "sense_id": "3c2aaad5-c3b2-33f7-915a-c840414c9301",
                                "text": "„Ein Julisturm zog herauf.“"
                            },
                            {
                                "example_id": "8376810f-b4fc-4530-90b3-51f1669d0c4c",
                                "sense_id": "3c2aaad5-c3b2-33f7-915a-c840414c9301",
                                "text": "„Die Sonne leuchtete hell vom Himmel, die Bäume und der Rasen glänzten, erfrischt vom Julisturm.“"
                            },
                            {
                                "example_id": "0f003a23-d06e-4980-8850-e3046f1cb469",
                                "sense_id": "3c2aaad5-c3b2-33f7-915a-c840414c9301",
                                "text": "„Gestern Nacht war einer der seltenen Julistürme über die Insel gefegt und hatte mich um vier Uhr morgens geweckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1bb24f56-6fbe-3b77-ba1c-c6d0e7260d9a",
                        "entry_id": "69c7a6cf-75ac-3ad9-8f75-4846aafff430",
                        "glosses": [
                            "Revolution in Frankreich im Jahr 1830; Julirevolution"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c94b176-bdfb-4313-9bf3-3e4f5c33a184",
                                "sense_id": "1bb24f56-6fbe-3b77-ba1c-c6d0e7260d9a",
                                "text": "„Ein junger Student antwortete begeistert auf den Ruf, der durch die Pariser Julistürme des Jahres 1830 ins Land tönte.“"
                            },
                            {
                                "example_id": "e7095ff6-904c-4546-9ce2-675b2a960a42",
                                "sense_id": "1bb24f56-6fbe-3b77-ba1c-c6d0e7260d9a",
                                "text": "„Die Zeit der Julistürme kam heran: neue politische Aufregungen wurden die Wurzeln zu neuen, erfreulichern literarischen Bestrebungen auf dem Felde der Poesie, wie auf dem der Kritik.“"
                            },
                            {
                                "example_id": "ae6bed26-6521-4737-861d-0880f9bf9c0d",
                                "sense_id": "1bb24f56-6fbe-3b77-ba1c-c6d0e7260d9a",
                                "text": "„Die Wirkungen der Februarrevolution von 1848 waren in materieller Hinsicht nachhaltiger und weitergreifender als die Julistürme des Jahres 1830.“"
                            },
                            {
                                "example_id": "edfc30aa-a194-4717-9d77-38a052313b2a",
                                "sense_id": "1bb24f56-6fbe-3b77-ba1c-c6d0e7260d9a",
                                "text": "„Da zerriß der Julisturm den ‚Löwenbund‘, der diesmal auf Kosten Frankreichs, wie 1807 auf Kosten Rußlands, geschlossen war, in Stücke, und machte aus dieser Entente cordiale den Staub seines Wegs.“"
                            },
                            {
                                "example_id": "219d6843-0614-408b-9045-f606e66a0b2a",
                                "sense_id": "1bb24f56-6fbe-3b77-ba1c-c6d0e7260d9a",
                                "text": "„Auch über den Kanton Basel zog fich dieser Julisturm, nachdem er bereits in den Kantonen Thurgau, Aargau, Zürich, St. Gallen, Luzern, Solothurn getobt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
