                        "glosses": [
                            "eine aus grobem Flechtwerk oder Gewebe aus Bast, Binsen, Schilf, Stroh, synthetischen Fasern oder Ähnlichem bestehende Unterlage oder dergleichen"
                        ],
                        "tags": [
