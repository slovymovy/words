                                    {
                                        "sense_id": "c26b83a8-047a-3f94-9cd6-f4c21fe6f474",
                                        "entry_id": "bc101584-a08a-3080-8004-df91d96a65a0",
                                        "glosses": [
                                            "größer, stärker als zu erwarten ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc998234-e473-420b-b24b-7092f2256dda",
                                                "sense_id": "c26b83a8-047a-3f94-9cd6-f4c21fe6f474",
                                                "text": "„Dem Staate Florida drang die Erschütterung bis in die innersten Eingeweide, und anschließend brauste eine Windhose von unerhörter Gewalt über das Land um Stones Hill.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "75c33921-ff09-3f0f-a823-a0836d2facc3",
                                        "entry_id": "bc101584-a08a-3080-8004-df91d96a65a0",
                                        "glosses": [
                                            "in hohem Maße anstößig, abstoßend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b87594c-4ec8-4089-9af0-dfd1f1f08bcf",
                                                "sense_id": "75c33921-ff09-3f0f-a823-a0836d2facc3",
                                                "text": "Seine Entgegnung geriet zu einer unerhörten Gemeinheit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
