                "senses": [
                    {
                        "sense_id": "92cff5b6-9b22-310e-89c7-48921ca1788a",
                        "entry_id": "557c9287-3462-3f24-9308-30edba4ecc3c",
                        "glosses": [
                            "Faire perdre à quelque chose (un pays…) son caractère oligarchique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249eccc4-9264-461b-abaa-66053a7944d9",
                                "sense_id": "92cff5b6-9b22-310e-89c7-48921ca1788a",
                                "text": "Il fut un temps où le président Volodymyr Zelenski avait tenté de « désoligarchiser le pays. »"
                            },
                            {
                                "example_id": "c0dad76e-99c3-47d3-8521-a9d30c675974",
                                "sense_id": "92cff5b6-9b22-310e-89c7-48921ca1788a",
                                "text": "Quand Zelensky tente de « désoligarchiser » l'Ukraine."
                            },
                            {
                                "example_id": "3fb0e16b-f3cc-4894-8cba-4d042ac50ac3",
                                "sense_id": "92cff5b6-9b22-310e-89c7-48921ca1788a",
                                "text": "La société russe est gangrenée par la corruption ; le mot d'ordre est : « désoligarchiser » et « désoffshoriser » le secteur économique et financier."
                            }
                        ]
                    }
