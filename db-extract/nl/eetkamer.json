                    {
                        "translation_id": "1228e6cf-920a-4f48-ab3d-ae119407c9fb",
                        "source_entry_id": "47e8db9f-f0e0-3780-b30d-5633fbd06ba6",
                        "source_sense_id": "a0a30df6-0d4d-360f-bedb-972ab7cc226a",
                        "source_sense_description": "een kamer waar maaltijden worden genuttigd",
                        "target_lang_word": "salle à manger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salle à manger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69644505-9be3-36a1-9621-9998a170038b",
                                        "entry_id": "753e1a10-e39f-3a48-9af6-98e545397f90",
                                        "glosses": [
                                            "Pièce dans laquelle on prend les repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b51b8727-0778-4a82-8348-c6f03e9e7fc6",
                                                "sense_id": "69644505-9be3-36a1-9621-9998a170038b",
                                                "text": "La cuisine est adossée à la salle à manger, et le salon est doublé d’un cabinet qui servait alors de chambre à coucher à monsieur et à madame Dumay."
                                            },
                                            {
                                                "example_id": "c51d4f38-31a3-40f5-9e75-3f1b676914d2",
                                                "sense_id": "69644505-9be3-36a1-9621-9998a170038b",
                                                "text": "Les convives se ruèrent alors dans la salle à manger."
                                            },
                                            {
                                                "example_id": "2c833564-0265-4e20-b9f4-6a34f54d220a",
                                                "sense_id": "69644505-9be3-36a1-9621-9998a170038b",
                                                "text": "La salle à manger, mal soignée par une seule servante, présentait l’aspect nauséabond des salles à manger d’hôtel de province : tout y était encrassé, mal entretenu."
                                            },
                                            {
                                                "example_id": "c653b4a0-95cd-4357-963f-f87f67acdec5",
                                                "sense_id": "69644505-9be3-36a1-9621-9998a170038b",
                                                "text": "Dans la salle à manger, marron et or, pleine de lumières, je me suis assis à la table d’hôte."
                                            },
                                            {
                                                "example_id": "2fa7b299-d5bc-4e16-a908-760715d58622",
                                                "sense_id": "69644505-9be3-36a1-9621-9998a170038b",
                                                "text": "A un appel de sonnette on plaçait les plats et tout ce qui était nécessaire sur un monte-charge qui s'élevait jusqu'à la salle à manger et redescendait aussitôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d71d84e0-3432-320e-a710-4532e7ad90e8",
                                        "entry_id": "753e1a10-e39f-3a48-9af6-98e545397f90",
                                        "glosses": [
                                            "Mobilier de cette pièce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deb40c4e-6386-4172-83fb-c59b8a0bdd5c",
                                                "sense_id": "d71d84e0-3432-320e-a710-4532e7ad90e8",
                                                "text": "Madame de Champcenais avait fait le voyage de Nancy, pour y commander une salle à manger (…)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
