                                        "entry_id": "6e164b0c-5816-3d6c-8d10-9bcef96bbeab",
                                        "glosses": [
                                            "A person who blusters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "febc8d0d-5839-49dc-bbd8-18920d134544",
                                                "sense_id": "76a4ae98-34c1-345b-a4cd-3a13020d8702",
                                                "text": "The Syrian force was pulled back quickly and with reportedly heavy losses, but it stayed around long enough to remind the world that the Syrians are still the biggest blusterers and brinkmen in the Middle East."
                                            },
                                            {
                                                "example_id": "1c5be243-d995-43ab-aa8d-6bc3341316e3",
                                                "sense_id": "76a4ae98-34c1-345b-a4cd-3a13020d8702",
                                                "text": "If entertaining TV blusterer John McLaughlin felt any contrition after ponying up a six-figure sum to settle a sexual-harassment suit in 1989, he is evidently over it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
