                "senses": [
                    {
                        "sense_id": "49fefdab-4250-3720-8211-e9cbf10515a5",
                        "entry_id": "952d6195-9303-3441-bc9c-cf7b15b7fb44",
                        "glosses": [
                            "seitlicher Rand eines Bettes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdd77700-b5d5-42b2-a727-1d384be553aa",
                                "sense_id": "49fefdab-4250-3720-8211-e9cbf10515a5",
                                "text": "„Als ich zurückkam, saß Papa auf der Bettkante und schaute mich seltsam an.“"
                            },
                            {
                                "example_id": "91fab9c9-8848-4db5-83bb-77f2d32f4a37",
                                "sense_id": "49fefdab-4250-3720-8211-e9cbf10515a5",
                                "text": "„Also nahm er die Zigaretten, setzte sich auf die Bettkante und zündete sich eine an.“"
                            },
                            {
                                "example_id": "a3f64857-d435-44b0-9ada-07bce7096ccb",
                                "sense_id": "49fefdab-4250-3720-8211-e9cbf10515a5",
                                "text": "„Sie setzte sich auf die Bettkante und öffnete ihm den Hosenstall.“"
                            },
                            {
                                "example_id": "bc2b218f-3873-48f2-98d7-52184759e29c",
                                "sense_id": "49fefdab-4250-3720-8211-e9cbf10515a5",
                                "text": "„Robert tauscht eher widerstrebend seinen Platz auf dem Stuhl gegen einen Platz auf der äußersten Bettkante ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
