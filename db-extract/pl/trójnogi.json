                        "source_sense_id": "efbcf5e0-e83a-374d-bb18-8427edc630d8",
                        "target_lang_word": "dreibeinig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreibeinig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4108d31-658a-3fcc-9c4e-66daeb49927a",
                                        "entry_id": "0d9455fb-5c41-3e76-8d6e-0006d00ad52d",
                                        "glosses": [
                                            "drei Beine besitzend"
                                        ],
                                        "tags": [
                                            "Fantasy",
                                            "Tieranatomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "561b3106-10b9-4c82-9175-2cd384e03423",
                                                "sense_id": "e4108d31-658a-3fcc-9c4e-66daeb49927a",
                                                "text": "„Dreibeinige Tiere nutzen instinktiv die Beinchen anders und richtig.“"
                                            },
                                            {
                                                "example_id": "6de77291-0dd1-4e8c-8470-971b556f0d2b",
                                                "sense_id": "e4108d31-658a-3fcc-9c4e-66daeb49927a",
                                                "text": "„Als dreibeiniges Wesen, mit bis auf den Boden reichenden Zotteln und einem tellergrossen, funkelnden Auge, hatte es manchen nächtlichen Wanderer erschreckt.“"
                                            },
                                            {
                                                "example_id": "6644596b-db1c-4170-ba38-a8f9c00ff967",
                                                "sense_id": "e4108d31-658a-3fcc-9c4e-66daeb49927a",
                                                "text": "„Neben Darth Vaders Inneneinrichtung gibt es in dieser Ausstellung ein dreibeiniges Wesen aus Metall und Straußenfedern und eine Serie von Zeichnungen, die das Alphabet durchdeklinieren und damit eine subjektive Agenda zum Ausdruck bringen.“"
                                            },
                                            {
                                                "example_id": "182777d5-370e-4235-9f4d-beea2090b57a",
                                                "sense_id": "e4108d31-658a-3fcc-9c4e-66daeb49927a",
                                                "text": "„Nicht jede Verletzung hinterlässt eine Behinderung, aber auch ein blindes oder ein dreibeiniges Tier, eine Katze nur mit Stummelschwanz oder ein Tier, wie FELIX (früher Fire), der ins Feuer geworfen wurde und heute trotz der verbliebenen kahlen Stellen an seinem Körper eine glückliche Katze geworden ist.“"
                                            },
                                            {
                                                "example_id": "645a016b-e629-4b4d-ad73-a3ea89b5e630",
                                                "sense_id": "e4108d31-658a-3fcc-9c4e-66daeb49927a",
                                                "text": "„Ein wildes, dreibeiniges Wesen, 4,5 Tonnen schwer, starrt unter der 31 Meter hohen Kuppel etwas irritiert vor sich hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "920103f0-d5e2-3e82-b46d-7d4243ad1863",
                                        "entry_id": "0d9455fb-5c41-3e76-8d6e-0006d00ad52d",
                                        "glosses": [
                                            "mit drei (Stuhl- oder Tisch-)Beinen ausgestattet, mit drei Beinen versehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d314a7f5-85d2-4835-82b9-540158d8bd89",
                                                "sense_id": "920103f0-d5e2-3e82-b46d-7d4243ad1863",
                                                "text": "Sie kaufte sich einen dreibeinigen Hocker."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
