                            {
                                "target_lang_word": "altar cloths",
                                "target_lang_sense_clarification": "linen coverings for an altar"
                            },
                            {
                                "target_lang_word": "shrouds",
                                "target_lang_sense_clarification": "long linen cloths used for covering"
                            }
                        ]
                    }
                }
            ]
        }
    ]
