{
    "word_family": [
        "remove",
        "removal",
        "remover",
        "removability"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "55f99012-59d6-3b43-8a8c-f377c6c8b05c",
                    "sense_definition": "Capable of being taken away or detached from something else.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "detachable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toy comes with a <w>removable</w> battery cover that is easy for adults to open.",
                            "target_lang_translations": {
                                "ru": "Игрушка поставляется со <w>съёмной</w> крышкой батарейного отсека, которую взрослым легко открыть."
                            }
                        },
                        {
                            "text": "For easier cleaning, the sofa has <w>removable</w> covers that can be washed in a machine.",
                            "target_lang_translations": {
                                "ru": "Для облегчения чистки у дивана есть <w>съёмные</w> чехлы, которые можно стирать в машине."
                            }
                        }
                    ],
                    "synonyms": [
                        "detachable",
                        "extractable"
                    ],
                    "antonyms": [
                        "fixed",
                        "permanent",
                        "irremovable"
                    ],
                    "common_phrases": [
                        "removable covers",
                        "removable parts",
                        "removable labels"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такой, который можно снять, отсоединить или убрать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "съёмный",
                                "target_lang_sense_clarification": "который можно снимать"
                            },
                            {
                                "target_lang_word": "отсоединяемый",
                                "target_lang_sense_clarification": "который можно отделить"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42158737-86cf-328c-9cc5-d8e09797d25a",
                    "sense_definition": "An object or component that is designed to be taken out or detached.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "detachable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician checked all the <w>removables</w> in the computer system to find the fault.",
                            "target_lang_translations": {
                                "ru": "Техник проверил все <w>съёмные детали</w> в компьютерной системе, чтобы найти неисправность."
                            }
                        },
                        {
                            "text": "We need to store all <w>removables</w> in a secure box before moving the heavy machinery.",
                            "target_lang_translations": {
                                "ru": "Нам нужно сложить все <w>съёмные элементы</w> в надежный ящик перед перемещением тяжелого оборудования."
                            }
                        }
                    ],
                    "synonyms": [
                        "attachment",
                        "component"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или деталь, предназначенная для снятия или отсоединения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "съёмная деталь",
                                "target_lang_sense_clarification": "компонент, который можно снять"
                            },
                            {
                                "target_lang_word": "съёмный элемент",
                                "target_lang_sense_clarification": "отсоединяемая часть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}