                    ]
                },
                {
                    "sense_id": "c8b29286-29e0-3eab-98f9-673adafc2028",
                    "sense_definition": "A supporter, advocate, or person who helps promote a cause or plan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "supporter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Throughout the debate, she proved to be a reliable <w>abettor</w> of the new political reform."
                        },
                        {
                            "text": "He found himself acting as an unwitting <w>abettor</w> of policies he personally despised."
