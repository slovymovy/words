                                        "sense_id": "c1f83acd-c30c-39bc-915a-103d75c0a6ba",
                                        "entry_id": "f87cc7aa-c102-30db-a42c-c23d34d0b176",
                                        "glosses": [
                                            "het laagste loon (per uur, week, maand etc.) dat een werkgever volgens de wet aan een werknemer zou mogen betalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88aad028-00be-4af4-ba35-75b3c3609703",
                                                "sense_id": "c1f83acd-c30c-39bc-915a-103d75c0a6ba",
                                                "text": "Duitsland is het tweeëntwintigste EU-land dat per 1 januari 2015 een nationaal minimumloon invoert."
                                            },
                                            {
                                                "example_id": "61f9caa1-3a19-4fa9-8885-12403abf2f67",
                                                "sense_id": "c1f83acd-c30c-39bc-915a-103d75c0a6ba",
                                                "text": "Door de energiecrisis en de inflatie staat vooral de koopkracht van mensen met een laag of middeninkomen onder druk. Voor de laagste inkomens presenteerde het kabinet dit voorjaar al een pakket van 6 miljard euro. Minima krijgen een energietoeslag van 800 euro, het minimumloon en de AOW worden verhoogd en de energiebelasting wordt verlaagd."
                                            },
                                            {
                                                "example_id": "353f2465-d4aa-45be-9a0a-da039eca75fb",
                                                "sense_id": "c1f83acd-c30c-39bc-915a-103d75c0a6ba",
                                                "text": "\"Dat de prijzen hoger liggen komt vooral door de salariskosten\", zegt Peter Vuijk, manager van een kringloopwinkel in Arnhem. \"De minimumlonen zijn de afgelopen jaren flink gestegen. Dat is gewoon heel zwaar voor kringloopwinkels.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
