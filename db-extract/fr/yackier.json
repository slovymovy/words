                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4eceffe-63cf-43a0-a18c-b80b76a49af1",
                                "sense_id": "2b6100ce-69b8-3a70-91b3-550c2a3a9058",
                                "text": "Ces trois hommes constituent l’équipe d’accompagnement pour quatre jours : Jagaa, le guide local, Gangaa, le yackier et Megii, le cuisinier."
                            },
                            {
                                "example_id": "3f6068bf-9691-460e-90b0-963be371d144",
                                "sense_id": "2b6100ce-69b8-3a70-91b3-550c2a3a9058",
                                "text": "Sous la tente des yackiers du Tibet, dans les cabanes de Sibérie ou dans l’hiver mongol, le poêle était l’axe des jours."
                            }
                        ]
                    }
