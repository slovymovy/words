                                "target_senses": [
                                    {
                                        "sense_id": "1f88d022-5dd9-3d11-85ce-45d2b2261c2b",
                                        "entry_id": "7121905f-4ff9-3dd5-b396-92b6aaf63e27",
                                        "glosses": [
                                            "anhaltender Streit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "356f5d57-bdff-4435-93e1-380a545d42e6",
                                                "sense_id": "1f88d022-5dd9-3d11-85ce-45d2b2261c2b",
                                                "text": "„Es gab mal wieder Ärger an jenem Tag, giftiges Gezänk unter Freundinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "457f25f0-6d54-4988-a86c-38c746b3baea",
                        "source_entry_id": "6104feab-8858-39e8-a645-d54acff3043d",
                        "source_sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                        "target_lang_word": "bickering",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
