                            {
                                "example_id": "2d9641e3-0f1b-448a-8c41-b303dda686f3",
                                "sense_id": "d1b9e67a-db72-3301-869b-790c6f917da9",
                                "text": "„Ha’aretz druckte die täglichen Flugpläne für den Flughafen Lod ab und berichtete häufig über das Kommen und Gehen prominenter Zeitgenossen.“"
                            },
                            {
                                "example_id": "e4c3655a-1edd-4b95-9070-327fb7009cae",
                                "sense_id": "d1b9e67a-db72-3301-869b-790c6f917da9",
                                "text": "„Mitglieder des Schwarzen September entführten eine Maschine der Sabena Airlines auf ihrem Flug nach Tel Aviv und hielten die Passagiere als Geiseln auf dem Flughafen von Lod fest.“"
                            }
                        ],
