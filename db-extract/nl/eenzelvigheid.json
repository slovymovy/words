                "forms": [],
                "senses": [
                    {
                        "sense_id": "34b7c65c-ee23-38cb-af91-16affd6be97a",
                        "entry_id": "d242d634-b9cc-3961-b9aa-1db65f2d7b70",
                        "glosses": [
                            "het gelijk aan elkaar zijn van verschillende zaken; identiteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a047556d-decb-466c-a9c1-0a3086cf7f6b",
                                "sense_id": "34b7c65c-ee23-38cb-af91-16affd6be97a",
                                "text": "'Uw illusie is uw onvervreemdbaar eigendom, daar kom ik niet aan,'zei Dorrius, 'maar omgekeerd staat uedele mij toch wel het onderscheid tussen schijn en zijn toe? 'In afgemeten taal wees hij op de eenzelvigheid van gesmolten sneeuw en helder water weshalve sneeuw, ongesmolten nog, precies evenveel witstof bevatten moest als het water, namelijk geen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a33b3ca-8b08-3a79-b657-f825479a29b9",
                        "entry_id": "d242d634-b9cc-3961-b9aa-1db65f2d7b70",
                        "glosses": [
                            "door een persoon zelf gezochte eenzaamheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a21453b-f2bc-43bb-a090-2de31ed80f88",
                                "sense_id": "0a33b3ca-8b08-3a79-b657-f825479a29b9",
                                "text": "Het was de basis voor zijn eenzelvigheid. Op de middelbare school werd Muskee geraakt door On the Road van Jack Kerouac en The Naked Lunch van William Burroughs. Discjockey Willis Conover van radiozender The Voice of America stak hem aan met jazz en blues. Vooral de dampende liedjes van John Lee Hooker maakten indruk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b141229-1542-4cee-9b31-c60d79c82814",
                        "source_entry_id": "d242d634-b9cc-3961-b9aa-1db65f2d7b70",
                        "source_sense_id": "34b7c65c-ee23-38cb-af91-16affd6be97a",
                        "source_sense_description": "het gelijk aan elkaar zijn van verschillende zaken",
                        "target_lang_word": "oneness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oneness",
