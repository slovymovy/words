                        "source_entry_id": "fa3d372f-c511-382d-a116-23ab7e107151",
                        "source_sense_id": "bb950b6e-f05c-3167-8016-b0598af5424a",
                        "source_sense_description": "the state of being arbitrary",
                        "target_lang_word": "Willkürlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Willkürlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc3e1219-e0c0-3f51-a883-e8d75df33190",
                                        "entry_id": "f7cf46c3-5709-315e-9bb9-2ccc7189078f",
                                        "glosses": [
                                            "deutscher Ausdruck für Arbitrarität; gemeint ist die Willkürlichkeit im Verhältnis zwischen den beiden Seiten eines sprachlichen Zeichens: man kann von der Form des Zeichens (signifiant) nicht auf seine Bedeutung (signifié) schließen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83165512-92f3-4ccb-bd28-803652902b3c",
                                                "sense_id": "fc3e1219-e0c0-3f51-a883-e8d75df33190",
                                                "text": "Zwischen der Form eines Zeichens und seiner Bedeutung herrscht oft Willkürlichkeit; die Form des Wortes \"Tisch\" z.B. sagt nichts über die Bedeutung des Wortes aus. Anders bei Wörtern wie \"Kuckuck\": hier lässt die Lautform des Wortes auf das gemeinte Tier schließen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d05f7912-284f-441f-8470-00d491b38f15",
                        "source_entry_id": "fa3d372f-c511-382d-a116-23ab7e107151",
                        "source_sense_id": "bb950b6e-f05c-3167-8016-b0598af5424a",
                        "source_sense_description": "the state of being arbitrary",
                        "target_lang_word": "Willkür",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Willkür",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb974259-42d8-35b0-a7a9-55e5e0f9b03f",
                                        "entry_id": "66580879-8b01-3ff8-b6ec-23da58e36eae",
                                        "glosses": [
                                            "Verhaltensweise nach ausschließlich eigenen Wünschen und Interessen ohne Rücksicht auf andere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c890e6-e0d8-41b6-9eac-2c110da6dfb6",
                                                "sense_id": "fb974259-42d8-35b0-a7a9-55e5e0f9b03f",
                                                "text": "Dieses Gerichtsurteil ist reine Willkür."
                                            },
                                            {
                                                "example_id": "75a28298-a864-488f-9265-406eac233b3c",
                                                "sense_id": "fb974259-42d8-35b0-a7a9-55e5e0f9b03f",
                                                "text": "„Staatliche Willkür riss vor 200 Jahren diese Einheit auseinander.“"
                                            },
                                            {
                                                "example_id": "51db3324-bb84-4eab-b828-d5766260bb0f",
                                                "sense_id": "fb974259-42d8-35b0-a7a9-55e5e0f9b03f",
                                                "text": "„Auch später war das 13. Jahrhundert von den Auseinandersetzungen zwischen dem Koblenzer Bürgertum und der erzbischöflichen Willkür geprägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "278e2968-61e0-308d-80ee-cbb97584dfed",
                                        "entry_id": "66580879-8b01-3ff8-b6ec-23da58e36eae",
                                        "glosses": [
                                            "Unbegründetheit einer Festlegung; Freiheit bei der Wahl"
                                        ],
                                        "tags": [
                                            "Naturwissenschaft",
                                            "auch allgemein bei Entscheidungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff67cff3-6f59-4797-9886-fcba7abbdf2f",
                                                "sense_id": "278e2968-61e0-308d-80ee-cbb97584dfed",
                                                "text": "Die Stromrichtung wurde aus Willkür festgelegt, denn die Bewegung der Ladungsträger war damals noch nicht bekannt."
                                            },
                                            {
                                                "example_id": "a1c9f1d2-98eb-46fd-8ecd-c86a1ee59c11",
                                                "sense_id": "278e2968-61e0-308d-80ee-cbb97584dfed",
                                                "text": "„Sie allein ist unendlich, wie sie allein frei ist und das als ihr erstes Gesetz anerkennt, daß die Willkür des Dichters kein Gesetz über sich leide.“"
                                            },
                                            {
                                                "example_id": "703ed490-5b4b-4960-b77b-fa83b82e6d88",
                                                "sense_id": "278e2968-61e0-308d-80ee-cbb97584dfed",
                                                "text": "„»Eine jede Handlung ist recht, die oder nach deren Maxime die Freiheit der Willkür eines jeden mit jedermanns Freiheit nach einem allgemeinen Gesetze zusammen bestehen kann«.“ (Kant)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "24798655-156a-35c8-8ad3-1e96e7f8b7ff",
                                        "entry_id": "66580879-8b01-3ff8-b6ec-23da58e36eae",
                                        "glosses": [
                                            "Fähigkeit, Bewegungen oder Körperfunktionen bewusst herbeizuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a878910e-ab03-4fcf-ab2a-87bfe0741888",
                                                "sense_id": "24798655-156a-35c8-8ad3-1e96e7f8b7ff",
                                                "text": "Yogis sollen durch Willkür ihre Körpertemperatur beeinflussen können."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87f7b181-db2d-4a87-848f-d54841c0bdee",
                        "source_entry_id": "fa3d372f-c511-382d-a116-23ab7e107151",
