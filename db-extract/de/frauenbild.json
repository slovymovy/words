                "senses": [
                    {
                        "sense_id": "2f75bc73-dff2-35d3-832b-bbbc6756b2f3",
                        "entry_id": "e4f491e5-ca3b-3dd4-a237-104c42a7f5c4",
                        "glosses": [
                            "Eindruck oder Meinung, die eine Person über Frauen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e45d8fe-5779-491d-93a7-c79925ade25f",
                                "sense_id": "2f75bc73-dff2-35d3-832b-bbbc6756b2f3",
                                "text": "„Im Grunde können wir sagen, daß Platon ein positives Frauenbild hatte — jedenfalls für seine Zeit.“"
                            },
                            {
                                "example_id": "54161807-1751-4581-9bc7-4a302d31a752",
                                "sense_id": "2f75bc73-dff2-35d3-832b-bbbc6756b2f3",
                                "text": "„In den amerikanischen Suburbs wurde schon 1945 ein neues Frauenbild geformt.“"
                            },
                            {
                                "example_id": "a83a4fc3-484d-45f2-94c1-2fe4b13b88e1",
                                "sense_id": "2f75bc73-dff2-35d3-832b-bbbc6756b2f3",
                                "text": "„Das war mein Frauenbild.“"
                            },
                            {
                                "example_id": "78840474-5187-410d-a398-ded0049c1cb2",
                                "sense_id": "2f75bc73-dff2-35d3-832b-bbbc6756b2f3",
                                "text": "„Einmal waren die Romantiker, wie man an Caroline Schlegel oder Bettina von Brentano sieht, die erste Generation deutscher Dichter, die ein emanzipiertes Frauenbild mit sich trug.“"
                            }
                        ],
