        "fr-extract.jsonl": [
            {
                "entry_id": "d0e9d3f6-3998-3041-aaa5-b1c933923ed7",
                "word": "сболтать",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6af69807-a3f6-3577-8063-b7b7d8630822",
                        "entry_id": "d0e9d3f6-3998-3041-aaa5-b1c933923ed7",
                        "glosses": [
                            "Gambiller, gigoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "365ba9d5-67e7-43c0-bbe6-6e02b959a9db",
                                "sense_id": "6af69807-a3f6-3577-8063-b7b7d8630822",
                                "text": "болтать ногами : gigoter."
                            },
                            {
                                "example_id": "a011e908-6515-4bae-aa94-4cc9f5ec539c",
                                "sense_id": "6af69807-a3f6-3577-8063-b7b7d8630822",
                                "text": "болтать руками : avoir les bras ballants."
                            },
                            {
                                "example_id": "031f9c91-2d2d-4a3b-81a7-e547e079f0f1",
                                "sense_id": "6af69807-a3f6-3577-8063-b7b7d8630822",
                                "text": "самолёт сильно болтает : l’avion tangue beaucoup."
                            }
                        ]
                    },
                    {
                        "sense_id": "46d38d4a-1cd8-3ad1-8a52-cee54b802ecf",
                        "entry_id": "d0e9d3f6-3998-3041-aaa5-b1c933923ed7",
                        "glosses": [
                            "Remuer, agiter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b655143b-404a-4372-a8a6-be7d1639d4b1",
                                "sense_id": "46d38d4a-1cd8-3ad1-8a52-cee54b802ecf",
                                "text": "Лита на мгновение даже перестала болтать ложкой похлёбку. : À l’instant même, Lita arrêta de remuer sa petite cuillère."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1e460c0-d69f-3f8b-a6d8-aef522b56814",
                        "entry_id": "d0e9d3f6-3998-3041-aaa5-b1c933923ed7",
                        "glosses": [
                            "Bavarder, babiller, jaser, jacasser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e83989d3-2d55-48c7-a2b0-a97fabe9c748",
                                "sense_id": "e1e460c0-d69f-3f8b-a6d8-aef522b56814",
                                "text": "болтать глупости : dire des bêtises."
                            },
                            {
                                "example_id": "00e5c5eb-ff63-4ce1-a60b-caeb6697c7d5",
                                "sense_id": "e1e460c0-d69f-3f8b-a6d8-aef522b56814",
                                "text": "болтать без умолку : caqueter."
                            },
                            {
                                "example_id": "70b39070-5bcb-4d4d-b043-3084d393f3fb",
                                "sense_id": "e1e460c0-d69f-3f8b-a6d8-aef522b56814",
                                "text": "болтать вздор : radoter"
                            },
                            {
                                "example_id": "560cbfdf-d0be-437e-ab59-f05a0b079388",
                                "sense_id": "e1e460c0-d69f-3f8b-a6d8-aef522b56814",
                                "text": "болтать языком : raconter des blablas."
                            },
                            {
                                "example_id": "e764a867-1782-469d-bb64-e58067814086",
                                "sense_id": "e1e460c0-d69f-3f8b-a6d8-aef522b56814",
                                "text": "что он там болтает? : qu’est-ce qu’il raconte ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "e184836d-1752-338f-a62b-3b8e152d34a7",
                        "entry_id": "d0e9d3f6-3998-3041-aaa5-b1c933923ed7",
                        "glosses": [
                            "Blaguer."
                        ],
