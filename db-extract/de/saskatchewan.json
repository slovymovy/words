                    {
                        "translation_id": "a7dd07b5-b430-46ae-8ef6-c2ec1a818591",
                        "source_entry_id": "a0324dd3-2ef9-3fe7-b4ab-c4495d71d4eb",
                        "source_sense_id": "40328b86-b2a5-3ed6-a42e-9218001eca8c",
