                        "glosses": [
                            "het uiteinde van een haar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb8e5702-6403-4e6d-ba2a-ad9dcdb47742",
                                "sense_id": "3ed87955-810e-359f-9640-a468433275c4",
                                "text": "Ik ging in een hoekje zitten, uit de tocht, en keek naar de druppels die van mijn haarpunten gleden, terwijl ik verlangde naar onze warme haard en het gebabbel van mijn zuster."
                            },
                            {
                                "example_id": "8693b8e4-a560-4724-a0eb-1118e9139ea4",
                                "sense_id": "3ed87955-810e-359f-9640-a468433275c4",
                                "text": "‘Wijzig de volgorde van de producten. Begin met een shampoo, die opent de schubben en reinigt het haar. Vervolg met een masker dat herstelt, voedt en verzorgt. Eindig met een conditioner die dient om de haarpunten af te sluiten. Je gaat het haar openen en reinigen, verzorgen en sluiten. Een shampoo zal je wortels verzorgen, een conditioner de lengtes.’"
                            }
                        ]
                    }
