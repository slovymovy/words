                        "cross_references": [
                            {
                                "target_word": "Tsaritsyne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e90be457-ca00-38ab-8f25-b326ec6447a3",
                                        "entry_id": "4f8040da-55c0-302d-90f5-b3f04825374e",
                                        "glosses": [
                                            "Nom ancien de la ville russe de Volgograd, de 1589 à 1925."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc8ce05-5120-4bab-b1e2-9e441287318c",
                                                "sense_id": "e90be457-ca00-38ab-8f25-b326ec6447a3",
                                                "text": "Staline arriva à Tsaritsyne. Une file ininterrompue de télégrammes courait entre Lénine et lui. Staline n’était pas venu à Tsaritsyne comme inspecteur de l’armée, mais pour diriger le service de l’approvisionnement alimentaire par le sud de la Russie. La situation de Tsaritsyne avait une importance capitale. Le soulèvement de la région du Don et la perte de Tsaritsyne, c’était aussi la perte — désastreuse — de tout le grenier à blé du Caucase du Nord."
                                            },
                                            {
                                                "example_id": "a2c4c899-1bf4-4aec-8446-ed05afe46385",
                                                "sense_id": "e90be457-ca00-38ab-8f25-b326ec6447a3",
                                                "text": "Un vieillard aux cheveux gris, le gardien de nuit, entonna une vieille chanson qu’aimaient chanter, avant la révolution, les gars de l’usine française, à Tsaritsyne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
