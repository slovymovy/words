{
    "word_family": [
        "verraad",
        "verraden",
        "verrader"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c58a3054-a1ae-341c-9363-4da19de04a4d",
                    "sense_definition": "Bedrieglijk en anders dan het lijkt, waardoor men makkelijk misleid wordt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het gladde ijs op de weg is erg <w>verraderlijk</w> voor automobilisten.",
                            "target_lang_translations": {
                                "en": "The slippery ice on the road is very <w>treacherous</w> for drivers."
                            }
                        },
                        {
                            "text": "Deze <w>verraderlijke</w> situatie zorgde voor veel onverwachte problemen.",
                            "target_lang_translations": {
                                "en": "This <w>tricky</w> situation caused many unexpected problems."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedrieglijk",
                        "misleidend"
                    ],
                    "antonyms": [
                        "betrouwbaar"
                    ],
                    "common_phrases": [
                        "verraderlijke situatie",
                        "verraderlijk ijs"
                    ],
                    "target_lang_definitions": {
                        "en": "Deceptive and different from what it seems, making it easy to be misled."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deceptive",
                                "target_lang_sense_clarification": "misleading or giving a false impression"
                            },
                            {
                                "target_lang_word": "tricky",
                                "target_lang_sense_clarification": "difficult to deal with because of hidden dangers or subtleties"
                            },
                            {
                                "target_lang_word": "treacherous",
                                "target_lang_sense_clarification": "deceitful and unexpectedly dangerous"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f60a6cd-3553-3750-ba2e-6d48efcd7170",
                    "sense_definition": "Niet te vertrouwen en daardoor gevaarlijk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sterke stroming in de zee maakt het zwemmen hier erg <w>verraderlijk</w>.",
                            "target_lang_translations": {
                                "en": "The strong current in the sea makes swimming here very <w>treacherous</w>."
                            }
                        },
                        {
                            "text": "Pas op voor de <w>verraderlijke</w> stroming bij de kust.",
                            "target_lang_translations": {
                                "en": "Watch out for the <w>treacherous</w> current near the coast."
                            }
                        }
                    ],
                    "synonyms": [
                        "gevaarlijk",
                        "onbetrouwbaar"
                    ],
                    "antonyms": [
                        "veilig"
                    ],
                    "common_phrases": [
                        "verraderlijke stroming"
                    ],
                    "target_lang_definitions": {
                        "en": "Not to be trusted and therefore dangerous."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "treacherous",
                                "target_lang_sense_clarification": "unreliable and presenting hidden dangers"
                            },
                            {
                                "target_lang_word": "perilous",
                                "target_lang_sense_clarification": "full of danger or risk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4065784-b6ef-3a94-b78e-8be8953fa420",
                    "sense_definition": "Kenmerkend voor iemand die verraad pleegt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gaf de geheimen door met een <w>verraderlijke</w> glimlach.",
                            "target_lang_translations": {
                                "en": "He passed on the secrets with a <w>treacherous</w> smile."
                            }
                        },
                        {
                            "text": "Haar <w>verraderlijke</w> gedrag kostte het bedrijf veel geld.",
                            "target_lang_translations": {
                                "en": "Her <w>traitorous</w> behavior cost the company a lot of money."
                            }
                        }
                    ],
                    "synonyms": [
                        "valshartig",
                        "perfide"
                    ],
                    "antonyms": [
                        "loyaal",
                        "trouw"
                    ],
                    "common_phrases": [
                        "verraderlijk gedrag",
                        "verraderlijke glimlach"
                    ],
                    "target_lang_definitions": {
                        "en": "Characteristic of someone who commits betrayal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "treacherous",
                                "target_lang_sense_clarification": "guilty of or involving betrayal or treason"
                            },
                            {
                                "target_lang_word": "traitorous",
                                "target_lang_sense_clarification": "behaving like a traitor"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}