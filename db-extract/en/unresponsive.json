                    {
                        "translation_id": "f51e4024-38a0-41a6-858e-dd98a8e4930c",
                        "source_entry_id": "1499b4d3-b6b3-381a-92ae-bfe54fb7b22b",
                        "source_sense_description": "indifferent or apathetic",
                        "target_lang_word": "gleichgültig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gleichgültig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c0ee582-eecf-36b9-a193-3bf64692e332",
                                        "entry_id": "03ee396b-c715-37d1-a539-3979502134bd",
                                        "glosses": [
                                            "ohne Interesse, Teilnahme an etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eb5f1ef-04dd-434a-a748-70f9413e72f8",
                                                "sense_id": "9c0ee582-eecf-36b9-a193-3bf64692e332",
                                                "text": "Er ist dem gegenüber völlig gleichgültig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56580597-c8ee-3b94-a79d-28ea1349c64f",
                                        "entry_id": "03ee396b-c715-37d1-a539-3979502134bd",
                                        "glosses": [
                                            "nicht wichtig; unbedeutend"
                                        ],
                                        "tags": [
                                            "nicht adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb896668-afa7-4438-a4f0-ddad09755c90",
                                                "sense_id": "56580597-c8ee-3b94-a79d-28ea1349c64f",
                                                "text": "„Es ist auf der Albrechtsstraße, jener Verkehrsader der Residenz, die den Albrechtsplatz und das Alte Schloß mit der Kaserne der Garde-Füsiliere verbindet, – um Mittag, wochentags, zu einer gleichgültigen Jahreszeit.“ (1909)"
                                            },
                                            {
                                                "example_id": "8591ecd9-e517-4ec3-a9f5-bf4d61398aff",
                                                "sense_id": "56580597-c8ee-3b94-a79d-28ea1349c64f",
                                                "text": "„Tue alles so, als sei es das Einzige auf der Welt, was zählt, gleichzeitig aber mit dem Wissen, dass es letztlich völlig gleichgültig ist.“"
                                            },
                                            {
                                                "example_id": "2f4a57c1-f3b5-4ada-8f58-16a4052701dc",
                                                "sense_id": "56580597-c8ee-3b94-a79d-28ea1349c64f",
                                                "text": "„Der Anhängerschaft scheint es gleichgültig, wer die Partei führt.“"
                                            },
                                            {
                                                "example_id": "73c5bccf-d296-4a29-8acd-dd01f0fd31c6",
                                                "sense_id": "56580597-c8ee-3b94-a79d-28ea1349c64f",
                                                "text": "Das ist mir gleichgültig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67d3114d-dacc-494d-a01f-0923e76307c0",
                        "source_entry_id": "1499b4d3-b6b3-381a-92ae-bfe54fb7b22b",
                        "source_sense_description": "indifferent or apathetic",
                        "target_lang_word": "apathisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apathisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "936a27b2-8406-3e13-b846-8ca390d44020",
                                        "entry_id": "335c08b9-199b-330a-abec-cabef5c06e26",
                                        "glosses": [
                                            "teilnahmslos, stumpf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a5f5a85-1d36-4aa8-80b0-a09df2fc706b",
                                                "sense_id": "936a27b2-8406-3e13-b846-8ca390d44020",
                                                "text": "Nachdem er die Nachricht erfahren hatte, hat er nur noch apathisch herumgesessen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "894f18ed-b2df-4620-a23b-92192b081893",
                        "source_entry_id": "1499b4d3-b6b3-381a-92ae-bfe54fb7b22b",
                        "source_sense_description": "indifferent or apathetic",
                        "target_lang_word": "teilnahmslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teilnahmslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c13a8f07-6d29-3bad-a1f7-7890a75e3c8e",
                                        "entry_id": "6045e78a-2aea-3546-be41-9c103419b9ff",
                                        "glosses": [
                                            "ohne innere Beteiligung, ohne Emotionen, ohne Mitgefühl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcd071f3-9c56-42fd-988c-44b3e927ef09",
                                                "sense_id": "c13a8f07-6d29-3bad-a1f7-7890a75e3c8e",
                                                "text": "Nach dem Unfall saß die Beifahrerin nur teilnahmslos in der Ecke."
                                            },
                                            {
                                                "example_id": "ce54f7e7-9fbd-4adb-8e6c-f6c83c96edee",
                                                "sense_id": "c13a8f07-6d29-3bad-a1f7-7890a75e3c8e",
                                                "text": "„Ich saß noch teilnahmsloser als sonst am Frühstückstisch.“"
                                            },
                                            {
                                                "example_id": "0b897982-f237-4bc0-a057-6fd134af391f",
                                                "sense_id": "c13a8f07-6d29-3bad-a1f7-7890a75e3c8e",
                                                "text": "„Dem Neuropsychologen James Danckert von der kanadischen University of Waterloo fiel auf, dass die Patienten, die unter einem Schädel-Hirn-Trauma litten, oft nur teilnahmslos herumsaßen.“"
                                            },
                                            {
                                                "example_id": "99461ebf-7793-4230-b3e5-97e525352a7f",
                                                "sense_id": "c13a8f07-6d29-3bad-a1f7-7890a75e3c8e",
                                                "text": "„Der junge Mann war wieder bei Bewusstsein, lag aber teilnahmslos, fast katatonisch auf dem Bett […].“"
                                            },
                                            {
                                                "example_id": "64c5a676-5bcc-452e-8767-fa366a7abac3",
                                                "sense_id": "c13a8f07-6d29-3bad-a1f7-7890a75e3c8e",
                                                "text": "„Medienberichten zufolge folgten [die Angeklagten] den Ausführungen der Staatsanwaltschaft teilnahmslos und ließen sich zunächst nicht ein.“"
                                            },
                                            {
                                                "example_id": "e21d32b2-5fae-4bac-a52b-aab68bae5b5a",
                                                "sense_id": "c13a8f07-6d29-3bad-a1f7-7890a75e3c8e",
                                                "text": "„Opioide machen die Menschen apathisch. Man stumpft psychisch ab, wird teilnahmslos.“"
                                            },
                                            {
                                                "example_id": "b1334179-5c91-4f28-a4b5-8daaf1111adf",
                                                "sense_id": "c13a8f07-6d29-3bad-a1f7-7890a75e3c8e",
                                                "text": "„[Von Hasenpest] betroffene Tiere magern ab, zeigen struppiges Fell, schwankenden Gang und werden teilnahmslos.“"
                                            },
                                            {
                                                "example_id": "3655730e-940e-4678-922d-02a83fd51f71",
                                                "sense_id": "c13a8f07-6d29-3bad-a1f7-7890a75e3c8e",
                                                "text": "Sie ging teilnahmslos am Bettler im Kaufhauseingang vorbei."
                                            },
                                            {
                                                "example_id": "12c8e705-9fb8-4e47-85b1-20c0750ac237",
                                                "sense_id": "c13a8f07-6d29-3bad-a1f7-7890a75e3c8e",
                                                "text": "„Im Anschluss [an eine Rede] verlässt [Bundesjustizminister Heiko] Maas die Bühne fast fluchtartig, er wird dabei bedrängt, die Leute treten nach seinem Auto. Die Polizei steht währenddessen fast teilnahmslos daneben.“"
                                            },
                                            {
                                                "example_id": "afacc423-9fb1-4285-9286-79ab48df16c3",
                                                "sense_id": "c13a8f07-6d29-3bad-a1f7-7890a75e3c8e",
                                                "text": "„Es wird auch gezeigt, wie die Mehrheit der Deutschen tatenlos, teilnahmslos oder aber als Profiteure die Ausbeutung der Juden und dann ihre Deportation hinnahm.“"
                                            },
                                            {
                                                "example_id": "10f278be-8edb-4764-90ea-d082191091a2",
                                                "sense_id": "c13a8f07-6d29-3bad-a1f7-7890a75e3c8e",
                                                "text": "„Reglos liegt an einem kalten Morgen ein kleiner Vogel auf dem Bürgersteig. Die Passanten laufen teilnahmslos vorbei, nur ein Kind nimmt sich des Vögelchens an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
