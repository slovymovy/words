                                "target_senses": [
                                    {
                                        "sense_id": "bda3f27e-47e8-32e0-8ab3-b1d2fdd05470",
                                        "entry_id": "f2ee9ae2-d7a2-3d72-9bd9-3206e7a41a8e",
                                        "glosses": [
                                            "künstlicher Aufsatz an Gebissen, um Fehlstellungen beziehungsweise die Ausrichtung der Zähne oder/und der Kiefer zu verbessern"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95e7d630-222c-4905-8dbb-b33506c9b177",
                                                "sense_id": "bda3f27e-47e8-32e0-8ab3-b1d2fdd05470",
                                                "text": "„Volker mußte eine Zahnspange tragen.“"
                                            },
                                            {
                                                "example_id": "3a82fd96-a36a-4447-8d53-2ed27c906737",
                                                "sense_id": "bda3f27e-47e8-32e0-8ab3-b1d2fdd05470",
                                                "text": "Das Kind hat eine Zahnspange nötig, sonst werden ihm die Zähne in Zukunft beim Essen Probleme bereiten."
                                            },
                                            {
                                                "example_id": "d303cacc-b7ce-42a2-97a3-106485f77fad",
                                                "sense_id": "bda3f27e-47e8-32e0-8ab3-b1d2fdd05470",
                                                "text": "Aus ästhetischen Gründen lassen sich Erwachsene eine Zahnspange einsetzten."
                                            },
                                            {
                                                "example_id": "786d28da-3138-41bb-9270-cda44aac95da",
                                                "sense_id": "bda3f27e-47e8-32e0-8ab3-b1d2fdd05470",
                                                "text": "„Auf dem Bild daneben trug das Kind eine Zahnspange.“"
                                            },
                                            {
                                                "example_id": "a0f88842-19f3-4a11-b1f5-9be5c3bb3713",
                                                "sense_id": "bda3f27e-47e8-32e0-8ab3-b1d2fdd05470",
                                                "text": "„Die schlimmsten Schmerzen, an die ich mich erinnern kann, hatte ich als ein Arzt ihn wieder gerade bog und mit einer Zahnspange fixierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
