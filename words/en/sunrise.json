{
    "word_family": [
        "sunset",
        "sunup",
        "sunlight",
        "sunny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9fba89fc-f02a-30b5-a7aa-f634b537e93b",
                    "sense_definition": "The time of day when the sun appears above the eastern horizon.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_of_day",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'll meet you at the docks at <w>sunrise</w>.",
                            "target_lang_translations": {
                                "ru": "Я встречу тебя в доках на <w>рассвете</w>.",
                                "zh": "我会在<w>日出</w>时在码头和你见面。"
                            }
                        },
                        {
                            "text": "Farmers often wake up before <w>sunrise</w> to start their work.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто просыпаются до <w>восхода</w>, чтобы начать работу.",
                                "zh": "农民们通常在<w>日出</w>前起床开始工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sunup",
                        "dawn",
                        "daybreak",
                        "first light",
                        "crack of dawn"
                    ],
                    "antonyms": [
                        "sunset",
                        "sundown"
                    ],
                    "common_phrases": [
                        "at sunrise",
                        "before sunrise",
                        "sunrise to sunset"
                    ],
                    "target_lang_definitions": {
                        "ru": "Время суток, когда солнце появляется над восточным горизонтом.",
                        "zh": "太阳出现在东方地平线上的时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восход",
                                "target_lang_sense_clarification": "появление солнца"
                            },
                            {
                                "target_lang_word": "рассвет",
                                "target_lang_sense_clarification": "время перед восходом"
                            },
                            {
                                "target_lang_word": "восход солнца",
                                "target_lang_sense_clarification": "время суток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "日出",
                                "target_lang_sense_clarification": "太阳升起的时间"
                            },
                            {
                                "target_lang_word": "黎明",
                                "target_lang_sense_clarification": "天刚亮的时候"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af268e28-ee20-32e8-8589-68b435336c69",
                    "sense_definition": "The colorful display in the sky when the sun rises.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_of_day",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Did you see the beautiful <w>sunrise</w> this morning?",
                            "target_lang_translations": {
                                "ru": "Ты видел красивый <w>рассвет</w> сегодня утром?",
                                "zh": "你今天早上看到美丽的<w>朝霞</w>了吗？"
                            }
                        },
                        {
                            "text": "We sat on the beach to watch the <w>sunrise</w> over the ocean.",
                            "target_lang_translations": {
                                "ru": "Мы сидели на пляже, чтобы наблюдать <w>восход</w> над океаном.",
                                "zh": "我们坐在海滩上观看海上的<w>日出</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "sunset"
                    ],
                    "common_phrases": [
                        "beautiful sunrise",
                        "watch the sunrise",
                        "golden sunrise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красочное зрелище на небе во время восхода солнца.",
                        "zh": "太阳升起时天空中出现的绚丽景象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заря",
                                "target_lang_sense_clarification": "свечение неба"
                            },
                            {
                                "target_lang_word": "рассвет",
                                "target_lang_sense_clarification": "картина неба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "朝霞",
                                "target_lang_sense_clarification": "日出时的云霞"
                            },
                            {
                                "target_lang_word": "晨曦",
                                "target_lang_sense_clarification": "清晨的阳光"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53607edc-cc31-3cf8-929a-1d95228e7c33",
                    "sense_definition": "A fresh beginning or a time of awakening.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was the <w>sunrise</w> of her spirit.",
                            "target_lang_translations": {
                                "ru": "Это был <w>рассвет</w> её духа.",
                                "zh": "那是她精神的<w>曙光</w>。"
                            }
                        },
                        {
                            "text": "The invention marked the <w>sunrise</w> of the digital age.",
                            "target_lang_translations": {
                                "ru": "Это изобретение ознаменовало <w>зарю</w> цифровой эры.",
                                "zh": "这项发明标志着数字时代的<w>开端</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dawn"
                    ],
                    "common_phrases": [
                        "sunrise of a new era"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новое начало или время пробуждения.",
                        "zh": "指新的开始或觉醒的时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заря",
                                "target_lang_sense_clarification": "зарождение чего-либо"
                            },
                            {
                                "target_lang_word": "рассвет",
                                "target_lang_sense_clarification": "начало расцвета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "曙光",
                                "target_lang_sense_clarification": "比喻新的希望或开始"
                            },
                            {
                                "target_lang_word": "开端",
                                "target_lang_sense_clarification": "事物发展的起点"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1cbff2a3-74dc-3345-b407-c6363b4e2790",
                    "sense_definition": "To introduce or phase in a new technology or system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>sunrise</w> the new software next month.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>внедрить</w> новое программное обеспечение в следующем месяце.",
                                "zh": "公司计划下个月<w>启用</w>新软件。"
                            }
                        },
                        {
                            "text": "They will <w>sunrise</w> the updated platform while maintaining the old one briefly.",
                            "target_lang_translations": {
                                "ru": "Они <w>запустят</w> обновленную платформу, ненадолго сохранив старую.",
                                "zh": "他们将<w>推出</w>更新后的平台，同时短暂保留旧平台。"
                            }
                        }
                    ],
                    "antonyms": [
                        "sunset"
                    ],
                    "common_phrases": [
                        "sunrise a project",
                        "sunrise new technology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внедрять или поэтапно вводить новую технологию или систему.",
                        "zh": "指引入或逐步推行一项新技术或系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внедрять",
                                "target_lang_sense_clarification": "вводить в действие"
                            },
                            {
                                "target_lang_word": "запускать",
                                "target_lang_sense_clarification": "начинать использование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "启用",
                                "target_lang_sense_clarification": "开始使用新系统"
                            },
                            {
                                "target_lang_word": "推出",
                                "target_lang_sense_clarification": "发布新产品或技术"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}