                                        "sense_id": "aff2cb80-4f8b-3bbe-a24e-c2494a83ed1d",
                                        "entry_id": "eb3bd0c3-e4cd-3783-b16b-539d817e5297",
                                        "glosses": [
                                            "tecnica di programmazione dei calcolatori che consiste nell'implementare una funzione che richiama se stessa con parametri modificati e che prevede una condizione di terminazione in cui la funzione restituisce un valore senza ulteriori ricorsioni"
                                        ],
