                "senses": [
                    {
                        "sense_id": "1478ba3b-d15a-3a49-ae19-3169cc7a58b4",
                        "entry_id": "fb3ab9fc-170f-3dac-88ab-9dd663574f28",
                        "glosses": [
                            "Kenntnis beziehungsweise Weisheit über Christus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "253953d7-07e2-4000-be11-acf34014e5b2",
                                "sense_id": "1478ba3b-d15a-3a49-ae19-3169cc7a58b4",
                                "text": "„Die von S. benutzten und durch Vorstellungen des Pantheismus, des Karmas und der Reinkarnation erheblich umgedeuteten christlichen Begriffe von Schöpfung, Sünde und Erlösung sowie seine Christosophie stehen in deutlichem Widerspruch und Gegensatz zu den Glaubensaussagen der christlichen Kirchen.“"
                            },
                            {
                                "example_id": "f28ac167-8b5b-4a58-a173-1a4be583cca2",
                                "sense_id": "1478ba3b-d15a-3a49-ae19-3169cc7a58b4",
                                "text": "„Was wir meinen, ist eine anders geartete Christosophie, eine förmliche ordentliche Wissenschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
