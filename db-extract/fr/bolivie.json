        "fr-extract.jsonl": [
            {
                "entry_id": "9ee0bdef-1901-3892-b8b8-f7cfd3e1b281",
                "word": "Bolivie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "96f3bceb-ed5c-3adc-84c5-4ce037900b29",
                        "entry_id": "9ee0bdef-1901-3892-b8b8-f7cfd3e1b281",
                        "glosses": [
                            "Pays d’Amérique du Sud, entouré par le Brésil, le Paraguay, l’Argentine, le Chili et le Pérou. Sa capitale est Sucre."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "1f1e41a8-65e4-4e53-b502-1d1e81441385",
                                "sense_id": "96f3bceb-ed5c-3adc-84c5-4ce037900b29",
                                "text": "L’espérance moyenne de vie est de trente ans en Bolivie ou au nord-est du Brésil. Cette situation va s’aggraver, car l’Amérique latine accuse le taux de croissance démographique le plus élevé du monde : 3 %."
                            },
                            {
                                "example_id": "7a7e5ba0-cdd4-4879-8a75-a84ef8d595b3",
                                "sense_id": "96f3bceb-ed5c-3adc-84c5-4ce037900b29",
                                "text": "Lorsque la bourgeoisie embryonnaire eut à affronter le Pérou et la Bolivie, en 1879, pour décider de la propriété des mines de nitrate (monopole naturel sur l’une des plus grandes richesses de l’époque), elle se heurta pourtant aux États-Unis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7df7b402-c7b0-42e9-b991-de47d52b2eec",
                        "source_entry_id": "9ee0bdef-1901-3892-b8b8-f7cfd3e1b281",
                        "source_sense_id": "96f3bceb-ed5c-3adc-84c5-4ce037900b29",
                        "target_lang_word": "Bolivien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bolivien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9cca003-2a31-395d-b047-9ae4b7487960",
                                        "entry_id": "95490b31-f118-3315-af5b-b03e66723096",
                                        "glosses": [
                                            "ein Binnenstaat in Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef20068-a5fd-4065-ae0d-57b22b0f1ebf",
                                                "sense_id": "b9cca003-2a31-395d-b047-9ae4b7487960",
                                                "text": "Der bekannteste See Boliviens dürfte der Titicaca-See sein."
                                            },
                                            {
                                                "example_id": "9e851893-c4c3-4cbc-9b7d-81d76837c909",
                                                "sense_id": "b9cca003-2a31-395d-b047-9ae4b7487960",
                                                "text": "Sucre ist die Hauptstadt von Bolivien."
                                            },
                                            {
                                                "example_id": "5502ef56-a081-49ee-9945-a816c200107a",
                                                "sense_id": "b9cca003-2a31-395d-b047-9ae4b7487960",
                                                "text": "„Ein zumindest symbolischer Meilenstein für die Bemühungen um den Erhalt der indigenen Kulturen war die Verfassungsänderung von 1995, mit der Bolivien nun auch offiziell als multikulturelle, pluriethnische Gesellschaft anerkannt wurde.“"
                                            },
                                            {
                                                "example_id": "df02f644-4578-42b5-8d41-329902658529",
                                                "sense_id": "b9cca003-2a31-395d-b047-9ae4b7487960",
                                                "text": "„Das Erzbistum Bamberg […] half dem Priester Dieter Scholz, gegen den zwei Jungen 1963 Missbrauchsvorwürfe erhoben hatten, in Bolivien als Missionar zu arbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
