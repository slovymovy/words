                ],
                "senses": [
                    {
                        "sense_id": "34f1e347-cc24-3251-ad55-e39de8bad36d",
                        "entry_id": "0a202c19-02c4-3296-9c33-1f7f888140d9",
                        "glosses": [
                            "Retrouver une connaissance que l’on avait oubliée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d6d03f4-845c-4355-8ea8-9628202674ef",
                                "sense_id": "34f1e347-cc24-3251-ad55-e39de8bad36d",
                                "text": "Ça fait tellement longtemps que je ne suis plus venu dans ce pays que j’ignore si je vais ressavoir parler cette langue."
                            },
                            {
                                "example_id": "1797b3f9-f457-4a9e-9724-0aea0722dda4",
                                "sense_id": "34f1e347-cc24-3251-ad55-e39de8bad36d",
                                "text": "William m’emmenait, à quelque temps de là, dans un château en Écosse... Je ne sais plus dans quel comté, et je n’ai jamais voulu le ressavoir."
                            }
                        ]
                    }
                ],
