                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "demobiliseren",
                                "target_lang_sense_clarification": "Het officieel laten afvloeien van militairen."
                            },
                            {
                                "target_lang_word": "uit militaire dienst ontslaan",
                                "target_lang_sense_clarification": "Iemand formeel uit de krijgsmacht laten gaan."
                            }
                        ]
                    }
                }
