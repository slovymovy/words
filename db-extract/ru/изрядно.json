                                            {
                                                "example_id": "9dc750bd-f1f4-40e6-9334-691dedfb974a",
                                                "sense_id": "6165a412-77d4-31e2-a9bf-0c46204170bf",
                                                "text": "Thanks a lot for listening to me."
