                ],
                "senses": [
                    {
                        "sense_id": "61ec3d66-e32b-39bb-8000-f0e53c936599",
                        "entry_id": "e753cef9-4eea-3ac1-9f76-de3176daf900",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "062b053a-42f1-4b54-bbb9-0bc07265a9f5",
                                "sense_id": "61ec3d66-e32b-39bb-8000-f0e53c936599",
                                "text": "Frau Illing ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a5455d1b-6362-4b5b-a78a-abd9ae5407be",
                                "sense_id": "61ec3d66-e32b-39bb-8000-f0e53c936599",
                                "text": "Herr Illing wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "59cbac14-6f96-43f9-87e6-b6b46ace02d0",
                                "sense_id": "61ec3d66-e32b-39bb-8000-f0e53c936599",
                                "text": "Die Illings fliegen heute nach Boston."
                            },
                            {
                                "example_id": "ec2ec91b-31fa-438e-8de8-5e673f2510e6",
                                "sense_id": "61ec3d66-e32b-39bb-8000-f0e53c936599",
                                "text": "Der Illing trägt nie die Pullover, die die Illing ihm strickt."
                            },
                            {
                                "example_id": "9792c2cd-1640-48b3-ac62-96cfa1f02b0e",
                                "sense_id": "61ec3d66-e32b-39bb-8000-f0e53c936599",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Illing kommt, geht der Herr Illing.“"
                            },
                            {
                                "example_id": "27b5c158-28f5-4d5b-a655-e2d924f283f4",
                                "sense_id": "61ec3d66-e32b-39bb-8000-f0e53c936599",
                                "text": "Illing kommt und geht."
                            },
                            {
                                "example_id": "06af58f3-70af-4943-9883-bdd3f9c916da",
                                "sense_id": "61ec3d66-e32b-39bb-8000-f0e53c936599",
                                "text": "Illings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
