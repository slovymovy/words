{
    "word_family": [
        "consultation",
        "consultant",
        "consultatif",
        "consultable",
        "téléconsultation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d097687c-1f19-3163-af49-8325d2411767",
                    "sense_definition": "Aller voir un médecin ou un professionnel de santé pour obtenir un diagnostic ou un traitement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si la fièvre persiste au-delà de deux jours, vous devez <w>consulter</w> un médecin."
                        },
                        {
                            "text": "Elle a décidé de <w>consulter</w> un spécialiste pour ses douleurs au dos."
                        }
                    ],
                    "common_phrases": [
                        "consulter un médecin",
                        "consulter un spécialiste"
                    ]
                },
                {
                    "sense_id": "393070b6-c058-32ee-bace-beb51436de21",
                    "sense_definition": "Regarder attentivement un document, un livre ou un site internet pour trouver une information.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous pouvez <w>consulter</w> les horaires des trains directement sur le site web."
                        },
                        {
                            "text": "L'étudiant a <w>consulté</w> plusieurs dictionnaires pour vérifier la définition exacte de ce terme."
                        }
                    ],
                    "synonyms": [
                        "feuilleter",
                        "parcourir"
                    ],
                    "common_phrases": [
                        "consulter un dossier",
                        "consulter un site",
                        "consulter les horaires"
                    ]
                },
                {
                    "sense_id": "90a7770c-1dd0-36a7-a95e-755cd3c30836",
                    "sense_definition": "Demander l'avis ou le conseil de quelqu'un avant de prendre une décision.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conseil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a pris cette décision sans <w>consulter</w> ses collègues."
                        },
                        {
                            "text": "Nous devons <w>consulter</w> un avocat avant de signer ce contrat important."
                        }
                    ],
                    "synonyms": [
                        "solliciter",
                        "interroger"
                    ],
                    "common_phrases": [
                        "consulter un avocat",
                        "consulter ses proches"
                    ]
                },
                {
                    "sense_id": "1d32887b-b8a2-31f2-9b62-ae6da0c8360d",
                    "sense_definition": "Prendre en considération ses sentiments, sa raison ou ses principes avant d'agir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reflexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de répondre à cette proposition délicate, il a préféré <w>consulter</w> sa conscience."
                        },
                        {
                            "text": "Dans les situations de crise, il est sage de <w>consulter</w> la raison plutôt que la colère."
                        }
                    ],
                    "common_phrases": [
                        "consulter sa conscience",
                        "consulter la raison"
                    ]
                },
                {
                    "sense_id": "49046d00-32a2-39bb-ac9e-2a91c13f3b5d",
                    "sense_definition": "Recevoir des personnes pour leur donner des soins ou des avis professionnels.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce cardiologue réputé ne <w>consulte</w> que sur rendez-vous le mardi après-midi."
                        },
                        {
                            "text": "Le médecin de famille <w>consultera</w> toute la journée à son cabinet médical."
                        }
                    ],
                    "common_phrases": [
                        "consulter sur rendez-vous"
                    ]
                }
            ]
        }
    ]
}