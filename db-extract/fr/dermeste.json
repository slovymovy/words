                "senses": [
                    {
                        "sense_id": "7a7b5eb7-000c-306d-8af1-cd5e22af3545",
                        "entry_id": "784ba469-6780-3d6d-bc9b-bee087c58f70",
                        "glosses": [
                            "Genre de coléoptères détritiphages de petite taille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b08098b6-40c5-457e-833f-3454ae6d6a92",
                                "sense_id": "7a7b5eb7-000c-306d-8af1-cd5e22af3545",
                                "text": "Les dermestes, coléoptères bien connus des entomologistes spécialisés en médecine légale, ont des mœurs aussi surprenantes que raffinées."
                            },
                            {
                                "example_id": "b274dd56-4e78-4f34-aa1d-8dbb290696b9",
                                "sense_id": "7a7b5eb7-000c-306d-8af1-cd5e22af3545",
                                "text": "Les dermestes sont très minutieux, consciencieux et n’oublient rien. Ainsi, une colonie peut dévorer toute une carcasse pour ne laisser que les os intacts."
                            },
                            {
                                "example_id": "bece8110-b080-4a6f-8538-fb371d86c067",
                                "sense_id": "7a7b5eb7-000c-306d-8af1-cd5e22af3545",
                                "text": "Les insectes de la famille des dermestes, ou dermestidés (Dermestidae), sont des coléoptères d’assez petite taille pour survivre dans une maison."
                            }
                        ]
                    }
                ],
