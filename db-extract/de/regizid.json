                                        "sense_id": "8ebd9350-79dc-3dee-8171-4902251552c5",
                                        "entry_id": "9580e487-8eb8-304e-aab7-9d0275d86154",
                                        "glosses": [
                                            "Assassinat ou tentative d’assassinat d’un roi."
