                                        "sense_id": "df73f3f6-fb3e-34db-9347-7163b9d12c32",
                                        "entry_id": "1c5ad633-6826-3237-b2f5-4dd90b3129cd",
                                        "glosses": [
                                            "Alternative spelling of Egyptology."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0773088b-c90e-49bb-b88f-c14055c21e4c",
                                                "sense_id": "df73f3f6-fb3e-34db-9347-7163b9d12c32",
                                                "text": "People who think they may have priceless Egyptian relics \"are coming out of the wood work\" as a result of the interest in egyptology which has accompanied the national tour of King Tut's treasures."
                                            },
                                            {
                                                "example_id": "0ed34938-f8ff-4917-95cf-40cdba6c4c8a",
                                                "sense_id": "df73f3f6-fb3e-34db-9347-7163b9d12c32",
                                                "text": "from the popular corpus of sixteenth-century emblematics, bestiaries, encyclopedias, egyptologies, and the like."
                                            },
                                            {
                                                "example_id": "01584e33-cde3-4c0b-af78-988b58087841",
                                                "sense_id": "df73f3f6-fb3e-34db-9347-7163b9d12c32",
                                                "text": "Richard A. Parker, professor emeritus of egyptology at Brown University and an author and researcher on the subject, died on Thursday in Providence"
                                            },
                                            {
                                                "example_id": "ad4670c4-5c81-4cc0-beef-5a90b0799781",
                                                "sense_id": "df73f3f6-fb3e-34db-9347-7163b9d12c32",
                                                "text": "Thomas Eric Peet Travelling Prize To encourage study of egyptology and prehistory of the Mediterranean lands and the Near East."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
