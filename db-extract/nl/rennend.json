                "forms": [],
                "senses": [
                    {
                        "sense_id": "0ebd04a2-a31a-32b4-b505-3097948504fb",
                        "entry_id": "99736f6e-040c-391c-814b-8d840e47545f",
                        "glosses": [
                            "snel voortbewegend, haastig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9bad473-46f8-4d49-a4cd-e6584dd2f768",
                                "sense_id": "0ebd04a2-a31a-32b4-b505-3097948504fb",
                                "text": "De 35-jarige Pool die in de zomer van 2015 in IJmuiden vrouwen belaagde en bekend werd als 'de rennende rukker', heeft van de rechtbank in Haarlem conform de eis twee maanden voorwaardelijke celstraf gekregen."
                            },
                            {
                                "example_id": "6d95e0e1-1b8d-4de1-aa24-f402d523486f",
                                "sense_id": "0ebd04a2-a31a-32b4-b505-3097948504fb",
                                "text": "Het winnende beeld toont de rennende 28-jarige José Víctor Salazar Balza met een masker op zijn gezicht. De foto is gemaakt op 3 mei 2017 tijdens confrontaties met de politie. De man vloog in brand toen een gastank van een motor explodeerde. Hij heeft het incident overleefd, maar liep eerste- en tweedegraads brandwonden op."
                            }
                        ]
                    }
                ],
