                    "frequency": "Middle",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants ne devraient pas répéter de telles <w>saletés</w> à table.",
                            "target_lang_translations": {
                                "en": "Children shouldn't repeat such <w>obscenities</w> at the table.",
                                "ru": "Детям не стоит повторять такие <w>непристойности</w> за столом.",
                                "de": "Kinder sollten solche <w>Ferkeleien</w> nicht bei Tisch wiederholen.",
                                "es": "Los niños no deberían repetir semejantes <w>porquerías</w> en la mesa.",
                                "zh": "孩子们吃饭时不应该重复这种<w>下流话</w>。"
                            }
                        },
                        {
                            "text": "Il passe son temps à dire des <w>saletés</w> pour faire rire ses camarades.",
                            "target_lang_translations": {
                                "en": "He spends all his time coming out with <w>obscenities</w> to make his mates laugh.",
                                "ru": "Он только и делает, что несёт <w>похабщину</w>, чтобы насмешить своих приятелей.",
                                "de": "Er erzählt ständig <w>Ferkeleien</w>, um seine Kumpel zum Lachen zu bringen.",
                                "es": "Se pasa el día diciendo <w>porquerías</w> para hacer reír a sus compañeros.",
                                "zh": "他整天说<w>脏话</w>，逗同学们笑。"
                            }
