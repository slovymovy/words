                ],
                "senses": [
                    {
                        "sense_id": "9269ecd9-0f2a-371c-9439-e36796b15ec5",
                        "entry_id": "6ce1ce6f-1c7b-3019-99a6-4e495374f9cf",
                        "glosses": [
                            "A bumblebee."
                        ],
                        "tags": [
                            "archaic",
                            "dated",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "5f6d35b4-38c8-4f18-9a0d-97d18b0c42b8",
                                "sense_id": "9269ecd9-0f2a-371c-9439-e36796b15ec5",
                                "text": "Those slopes of fresh turf, embroidered with every minute blossom of the moor — thyme, birdsfoot, eyebright, and dwarf purple thistle, buzzed and hummed over by busy, black-tailed, yellow-banded dumbledores."
                            },
                            {
                                "example_id": "aabaee17-917f-4e5e-9b5b-57b6b1b7e58f",
                                "sense_id": "9269ecd9-0f2a-371c-9439-e36796b15ec5",
                                "text": "A shaded lamp and a waving blind, / And the beat of a clock from a distant floor: / On this scene enter – winged, horned, and spined – / A longlegs, a moth, and a dumbledore —"
                            },
                            {
                                "example_id": "8e9a385c-5a6e-41e8-9bc5-f49f036c9a22",
                                "sense_id": "9269ecd9-0f2a-371c-9439-e36796b15ec5",
                                "text": "Now and then a dumbledore or ‘busy bee’ as they are called by some, propelled itself across our path, they being extremely large and heavy this year."
                            },
                            {
                                "example_id": "071015b0-2630-47bc-9376-15450b3b0f46",
                                "sense_id": "9269ecd9-0f2a-371c-9439-e36796b15ec5",
                                "text": "A dumbledore, lured from the plantation, lies on its back, leaping and churning upon Seth’s bright pages."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9bfa6ed-d364-339e-8712-5c764ac0b81e",
                        "entry_id": "6ce1ce6f-1c7b-3019-99a6-4e495374f9cf",
                        "glosses": [
                            "A beetle, typically a cockchafer or dung beetle."
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "59495553-cdbd-424e-85b0-b724a5b12cc6",
                                "sense_id": "b9bfa6ed-d364-339e-8712-5c764ac0b81e",
                                "text": "others may need to be informd that a blastnashun straddlebob is a dumbledore, that is to say, a polyonymous lamellicorn coleopter, cald also a dorbeetle, a dorbug, a maybeetle, a maybug, a cockchafer, a Melolontha vulgaris."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbc7b07a-04f4-3ad0-aa09-eb249bb3244f",
                        "entry_id": "6ce1ce6f-1c7b-3019-99a6-4e495374f9cf",
                        "glosses": [
                            "A dandelion."
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "b514d752-67ea-4cfe-a775-4282dd8b362f",
                                "sense_id": "dbc7b07a-04f4-3ad0-aa09-eb249bb3244f",
                                "text": "The Dandelion has a number of common names in Newfoundland. These include Dumbledore, Faceclock, and Piss-a-beds."
                            }
                        ]
                    },
                    {
                        "sense_id": "48e10dc7-90da-38ff-ae5e-38294602efb4",
                        "entry_id": "6ce1ce6f-1c7b-3019-99a6-4e495374f9cf",
                        "glosses": [
                            "A blundering person."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d9fa9ff2-68be-44a2-9b70-1f6e7af05964",
                                "sense_id": "48e10dc7-90da-38ff-ae5e-38294602efb4",
                                "text": "“Miserable dumbledores!” / “Right, William, and so they be—miserable dumbledores!” said the choir with unanimity."
                            }
                        ]
                    }
