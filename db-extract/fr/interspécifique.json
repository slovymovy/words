                                "target_senses": [
                                    {
                                        "sense_id": "1ce18e1d-6637-3d03-bdc4-79bb2f14042d",
                                        "entry_id": "f7c9e6ab-4745-37c6-a5b8-9b1658127699",
                                        "glosses": [
                                            "occurring among members of different species; interspecies"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ac75a59-2584-37d4-88fb-88d231885b4d",
                                        "entry_id": "f7c9e6ab-4745-37c6-a5b8-9b1658127699",
                                        "glosses": [
                                            "Existing or occurring between different species"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe52dc4b-8fb8-4b93-946b-e42422b5633e",
                                                "sense_id": "6ac75a59-2584-37d4-88fb-88d231885b4d",
                                                "text": "Interspecific crossing in the wild appears to be limited as well, at least partly due to geographic isolation. However, I. wallerana and I. usambarensis are known to have naturally hybridized in the wild (Grey-Wilson, 1980a; Grey-Wilson, 1980b). With the wonderful horticulture discovery of the New Guinea group of impatiens in the early 1970's, there was significant interest in attempting controlled interspecific pollinations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8d1ec1c-2823-4423-9630-114f544071e0",
                        "source_entry_id": "0e4c855a-efc5-3f96-9fef-af3c61f4ee61",
                        "source_sense_id": "f38cb415-6372-3e88-b3be-688636b97ea7",
                        "target_lang_word": "interspecies",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interspecies",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d810af2b-d99c-3356-85c9-ee50aa22d450",
                                        "entry_id": "289cca52-6c4c-35be-bdd4-1f91af4a5eac",
                                        "glosses": [
                                            "Occurring or arising between species; interspecific."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4f5a4c-caf3-4419-a492-2825b62cb17b",
                                                "sense_id": "d810af2b-d99c-3356-85c9-ee50aa22d450",
                                                "text": "In view of this biochemical diversity, the possibilities of interspecies hybridization in this genus are very interesting and worthy of attention."
                                            },
                                            {
                                                "example_id": "4775f307-792d-4e71-bb67-2d72b2e330ca",
                                                "sense_id": "d810af2b-d99c-3356-85c9-ee50aa22d450",
                                                "text": "“You're a publicist,” she said. “She's a celebrity. That's interspecies.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
