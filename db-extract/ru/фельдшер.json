                    {
                        "sense_id": "6e808351-19fe-34e1-872b-f1b48ae14f60",
                        "entry_id": "e7c48d2f-1ae5-3e08-a12c-f446d467279d",
                        "glosses": [
                            "doctor's / medical assistant, medical attendant, paramedic, male nurse"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "1ca42332-1952-45e8-88e1-ad1829905c65",
                                "sense_id": "6e808351-19fe-34e1-872b-f1b48ae14f60",
                                "text": "Когда фельдшер стал искать нового больного, ему указали на конец коридора; он стоял здесь, прильнувши лицом к стеклу стеклянной садовой двери, и пристально смотрел на цветник.",
                                "translation": "When the assistant physician began to search for the new patient, they pointed him out at the end of the corridor; he stood there, with his face against the pane in the glass door, his eye fixed on a flower bed.",
                                "english": "When the assistant physician began to search for the new patient, they pointed him out at the end of the corridor; he stood there, with his face against the pane in the glass door, his eye fixed on a flower bed."
                            }
                        ]
                    }
