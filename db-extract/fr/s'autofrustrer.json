                "senses": [
                    {
                        "sense_id": "dce8f150-1384-3884-b907-96430b5900aa",
                        "entry_id": "089234c7-7b12-30bc-a998-a6f5bd9e52a5",
                        "glosses": [
                            "Se frustrer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa3b6b1-2009-46ce-a21c-ec5d7c4cad7c",
                                "sense_id": "dce8f150-1384-3884-b907-96430b5900aa",
                                "text": "La personne n'a plus de frein, autrement dit, elle n'a plus la capacité de s'autofrustrer (ou de s'autocastrer)."
                            },
                            {
                                "example_id": "e63c725d-2866-4300-8c6a-fe2c56d74c65",
                                "sense_id": "dce8f150-1384-3884-b907-96430b5900aa",
                                "text": "Et enfin, suivre des règles c'est un peu con, autant faire comme on le sent plutôt que de s'autofrustrer."
                            },
                            {
                                "example_id": "b4eece9c-52a4-444d-86ac-9ee95c84e181",
                                "sense_id": "dce8f150-1384-3884-b907-96430b5900aa",
                                "text": "Jamais je n'ai pensé que j'aurais pu m'autofrustrer un jour..."
                            }
                        ]
                    }
