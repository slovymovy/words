                ],
                "senses": [
                    {
                        "sense_id": "5fc98f81-0d62-3051-96d9-0d22a6a46470",
                        "entry_id": "f3efbd21-c334-3fe1-83b3-16b5ba5e4c43",
                        "glosses": [
                            "lijdend aan een tijdelijke aanval van misselijkheid en onwel voelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8512a822-cd3e-4101-a88b-fee560e64055",
                                "sense_id": "5fc98f81-0d62-3051-96d9-0d22a6a46470",
                                "text": "Ik werd onpasselijk toen ik de rottende, dode met bloed besmeurde kat op straat zag liggen."
                            },
                            {
                                "example_id": "86e31c52-467e-4726-9fcf-fa2695ba5afa",
                                "sense_id": "5fc98f81-0d62-3051-96d9-0d22a6a46470",
                                "text": "Als ik met mijn pen per ongeluk in mijn vinger prik, ben ik twee dagen onpasselijk - niet bepaald het type om even in Syrië even te gaan droppen. Bovendien ben ik ook nog eens vegetariër. Als oorlogsfotograaf heb je niet de luxe om in de loopgraven te zeggen (met piepstem): “Sorry, ik eet alleen linzen”. Ik ben dat klaslokaal buiten gewandeld en ben nooit meer teruggekeerd. Op dat moment heb ik geleerd dat het oké is om op je bakkes te gaan.’"
                            },
                            {
                                "example_id": "17e7e51d-a142-46c0-9c0c-48d3e407427d",
                                "sense_id": "5fc98f81-0d62-3051-96d9-0d22a6a46470",
                                "text": "Ik werd lichtelijk onpasselijk van het artikel in Ten eerste in de krant van 24 mei met de kop 'Het schuimkanon staat klaar'. Over jongeren die steeds gekkere, grotere en buitenissiger vakanties wensen te vieren op eindexamenreis. Een weekendje Terschelling volstaat allang niet meer. Met name het woord 'bucketlistwaardig' schoot me in het verkeerde keelgat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3dfa746-ebb9-4a6b-a71e-3875f3c0554a",
                        "source_entry_id": "f3efbd21-c334-3fe1-83b3-16b5ba5e4c43",
                        "source_sense_id": "5fc98f81-0d62-3051-96d9-0d22a6a46470",
                        "source_sense_description": "lijdend aan een tijdelijke aanval van misselijkheid en onwel voelen",
                        "target_lang_word": "nauseous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nauseous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8402d7ad-bca9-350a-9070-afaa289032ac",
                                        "entry_id": "6d7fc83e-3254-3578-9cc7-5211d5f16d0e",
                                        "glosses": [
                                            "Causing nausea; sickening or disgusting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc5efe9-fce8-4aa7-a6c6-a6f935239906",
                                                "sense_id": "8402d7ad-bca9-350a-9070-afaa289032ac",
                                                "text": "[…] And flattery tipt with nauseous fleer,\nAnd guilty shame, and servile fear,\nEnvy, and cruelty, and pride,\nWill in your tainted heart preside."
                                            },
                                            {
                                                "example_id": "a3932a61-6dbf-43f7-a612-f7b1d8f0656d",
                                                "sense_id": "8402d7ad-bca9-350a-9070-afaa289032ac",
                                                "text": "[T]he Italians grossness of Conversation is still very offensive & nauseous, tho' long accustomed to it."
                                            },
                                            {
                                                "example_id": "bf6d1a4d-904f-40a7-abd7-d100e339fe55",
                                                "sense_id": "8402d7ad-bca9-350a-9070-afaa289032ac",
                                                "text": "And then what proper person can be partial / To all those nauseous epigrams of Martial?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "130d8615-33b0-345d-a555-a333e5290fb6",
                                        "entry_id": "6d7fc83e-3254-3578-9cc7-5211d5f16d0e",
                                        "glosses": [
                                            "Inclined to nausea; sickly, squeamish."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8562f16b-b6a8-3cdb-96bf-95a5207d7555",
                                        "entry_id": "6d7fc83e-3254-3578-9cc7-5211d5f16d0e",
                                        "glosses": [
                                            "Afflicted with nausea; sick."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "419ce3ac-e7f1-4bcb-bf16-70aa32262818",
                                                "sense_id": "8562f16b-b6a8-3cdb-96bf-95a5207d7555",
                                                "text": "After he had scarcely eaten enough, he felt nauseous; but nausea ceased as soon as he stopped eating entirely, …"
                                            },
                                            {
                                                "example_id": "8cd53523-775e-479e-aab5-8768e690b210",
                                                "sense_id": "8562f16b-b6a8-3cdb-96bf-95a5207d7555",
                                                "text": "[…] during stretching the patient felt nauseous …"
                                            },
                                            {
                                                "example_id": "bf559144-4d85-4040-8ad1-ed8f78266782",
                                                "sense_id": "8562f16b-b6a8-3cdb-96bf-95a5207d7555",
                                                "text": "Is it a myth that you shouldn't drink alcohol while taking antibiotics? I often do and haven't felt remotely nauseous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
