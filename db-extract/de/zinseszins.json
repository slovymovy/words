                    {
                        "sense_id": "98fc7f2a-625d-3d0a-91fa-61b7df34a19f",
                        "entry_id": "aa277c4f-e8a3-3596-9902-726aabfc3e8b",
                        "glosses": [
                            "Zins, der auf das Kapital zusammen mit den bisher gezahlten Zinsen gewährt wird"
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "6c99060c-6a17-45aa-b3ba-197f0757124c",
                                "sense_id": "98fc7f2a-625d-3d0a-91fa-61b7df34a19f",
                                "text": "„Denn dadurch, dass die Zinsen nach jeder Zinsperiode dem Sparkapital gutgeschrieben und fortan mitverzinst werden, erzielt der Zinseszins bei langfristiger Veranlagung eine große Wirkung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0b4f76b-f686-4c86-bcd2-538cc75f6897",
                        "source_entry_id": "aa277c4f-e8a3-3596-9902-726aabfc3e8b",
                        "source_sense_id": "98fc7f2a-625d-3d0a-91fa-61b7df34a19f",
                        "source_sense_description": "Zins, der auf das Kapital zusammen mit den bisher gezahlten Zinsen gewährt wird",
                        "target_lang_word": "compound interest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compound interest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3804b0dd-130f-3b84-b86c-e53d447f03b5",
                                        "entry_id": "06e1699e-9fdd-3821-9f4a-ef896d3b29cb",
                                        "glosses": [
                                            "Interest, as on a loan or a bank account, that is calculated on the total on the principal plus accumulated unpaid interest."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a49d5a7-64fe-4063-a885-ab8f153be207",
                                                "sense_id": "3804b0dd-130f-3b84-b86c-e53d447f03b5",
                                                "text": "[…] tens of thousands of other foot passengers have been slipping and sliding since the day broke (if this day ever broke), adding new deposits to the crust upon crust of mud, sticking at those points tenaciously to the pavement, and accumulating at compound interest."
                                            },
                                            {
                                                "example_id": "7a9e0ae6-ca6e-459d-bea5-5b68a3909d01",
                                                "sense_id": "3804b0dd-130f-3b84-b86c-e53d447f03b5",
                                                "text": "Arithmetic books published during the fifteenth and first half of the sixteenth centuries have little to say about interest although the practice of calculating compound interest was old at that time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
