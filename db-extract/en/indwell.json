                "senses": [
                    {
                        "sense_id": "86ca0f62-f4f3-353e-b8f7-ec642d3a9e6c",
                        "entry_id": "2219bafe-def0-3628-ac0e-d0bed4b98a2f",
                        "glosses": [
                            "To exist within, especially as a spirit or driving force."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "357e85cd-04d6-4bf0-9094-a01964edf888",
                                "sense_id": "86ca0f62-f4f3-353e-b8f7-ec642d3a9e6c",
                                "text": "The Holy Ghost became a dove, not as a symbol, but as a constantly indwelt form."
                            },
                            {
                                "example_id": "62d7e858-6fa8-4307-aa59-e720db3abc83",
                                "sense_id": "86ca0f62-f4f3-353e-b8f7-ec642d3a9e6c",
                                "text": "Diodore and Theodore were particularly galvanized to defend their point of view by their horror at Apollinaris's assertion that Christ was indwelled by the Logos, which replaced a human mind in him."
                            }
                        ]
                    }
                ],
