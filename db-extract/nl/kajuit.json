                            {
                                "example_id": "72457978-3933-4667-9017-4a0e3e7af76e",
                                "sense_id": "9defa975-3a17-327c-8d2c-b168b5558568",
                                "text": "De kajuit was voorzien van een kachel voor de koudere tijden."
                            }
