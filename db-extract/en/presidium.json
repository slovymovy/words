                                    {
                                        "sense_id": "846de6fd-8401-3e75-852d-a72604838810",
                                        "entry_id": "61083f97-b04f-3b55-a129-ca742d716988",
                                        "glosses": [
                                            "Comité exécutif de différentes organisations politiques en URSS."
                                        ],
                                        "tags": [
                                            "Communisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0073431-9fd7-48fc-9971-2252232c5761",
                                                "sense_id": "846de6fd-8401-3e75-852d-a72604838810",
                                                "text": "De 1952 à 1966, le Politburo du Parti communiste de l'Union soviétique était connu comme le Présidium du Comité central du Parti communiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0270fb4b-fb7f-3604-b4a0-b143b0c83c3f",
                                        "entry_id": "61083f97-b04f-3b55-a129-ca742d716988",
                                        "glosses": [
                                            "Groupe de personnes qui s'occupe de la gestion quotidienne des organismes étudiants en Allemagne, en Autriche, en Suisse, aux Pays-Bas, en Belgique, et en Pologne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8565b51c-d8f1-4248-95f3-f7c9ff215147",
                        "source_entry_id": "fea1dae2-689d-3058-b91a-c5b804622e2d",
                        "source_sense_description": "executive committee",
                        "target_lang_word": "Präsidium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Präsidium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f97dd2bf-0cd6-3d0b-9443-69f5ef7baefb",
                                        "entry_id": "127213c7-9f76-3d6d-984c-15a1e2b53af9",
                                        "glosses": [
                                            "Führungsgremium einer Organisation oder einer Verwaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea06980b-2ac0-4937-a3d8-a0baf26f8fa9",
                                                "sense_id": "f97dd2bf-0cd6-3d0b-9443-69f5ef7baefb",
                                                "text": "Neben dem Präsidium des DTB e. V. sind als weitere Gremien noch der Bundesausschuss und die Mitgliederversammlung genannt."
                                            },
                                            {
                                                "example_id": "20d95975-3f36-4c1c-a312-f884c1f0b6cd",
                                                "sense_id": "f97dd2bf-0cd6-3d0b-9443-69f5ef7baefb",
                                                "text": "Der frühere Landesminister wurde heute in das Präsidium seiner Partei gewählt."
                                            },
                                            {
                                                "example_id": "207a7885-04a8-4b20-aa5e-2228965683e0",
                                                "sense_id": "f97dd2bf-0cd6-3d0b-9443-69f5ef7baefb",
                                                "text": "„Bis zur letzten Minute feilte das Präsidium vor dem Parteitag an einem Leitantrag zu dem Thema.“"
                                            },
                                            {
                                                "example_id": "b1033851-940d-417f-950b-3083b97b2659",
                                                "sense_id": "f97dd2bf-0cd6-3d0b-9443-69f5ef7baefb",
                                                "text": "„Das Präsidium der Versammlung saß an einem längeren Quertisch, von dem aus der Archivar seine Vorlesung gehalten hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ea17743-8c6d-3f7d-b1c1-308b76c90e61",
                                        "entry_id": "127213c7-9f76-3d6d-984c-15a1e2b53af9",
                                        "glosses": [
                                            "Gebäude, in dem der (Polizei-)Präsident seinen Amtssitz hat"
                                        ],
                                        "tags": [
                                            "insbesondere bei Polizeibehörden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c288c1d3-fa9a-46ce-b95d-c450d3a56814",
                                                "sense_id": "6ea17743-8c6d-3f7d-b1c1-308b76c90e61",
                                                "text": "Die Beamten nahmen den Verdächtigen fest und brachten ihn ins Präsidium."
                                            },
                                            {
                                                "example_id": "93d55fda-3874-44a7-99c6-4c7c6ec82b88",
                                                "sense_id": "6ea17743-8c6d-3f7d-b1c1-308b76c90e61",
                                                "text": "„Nach seiner Heirat hatten sie sich aus den Augen verloren, liefen sich nur noch im Präsidium über den Weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
