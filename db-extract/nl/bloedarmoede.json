                                            "Frappé d’anémie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8eb3d4a-e056-3010-ac4c-9ac5e94b062d",
                                        "entry_id": "06cd1064-f0ed-3005-9218-db1a67285a63",
                                        "glosses": [
                                            "Pâli, comme frappé d’anémie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "934a2821-aeab-499b-aea7-df7bb738cef2",
                                                "sense_id": "a8eb3d4a-e056-3010-ac4c-9ac5e94b062d",
                                                "text": "Sur le premier feuillet, elle lit : Ceci est mon journal. Les papiers ont jauni. L’encre a pâli, comme anémiée par le temps."
                                            }
                                        ]
