        "fr-extract.jsonl": [
            {
                "entry_id": "b80c8838-9325-312a-9e11-1b526b97deb1",
                "word": "mythomane",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "06cbb9d2-0c66-4786-80dd-55026cfc5aa9",
                        "entry_id": "b80c8838-9325-312a-9e11-1b526b97deb1",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "mythomanes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c0c6fb1-100e-3424-a46c-ef95e2d295a9",
                        "entry_id": "b80c8838-9325-312a-9e11-1b526b97deb1",
                        "glosses": [
                            "Qui a la manie pathologique de l’invention mensongère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "612cea12-ec51-44b2-a0cc-1573280beb43",
                                "sense_id": "5c0c6fb1-100e-3424-a46c-ef95e2d295a9",
                                "text": "Des accidents cérébraux localisés dans le lobe préfrontal désinhibent des patients atteints, rendant violents, mythomanes et sans scrupule des hommes ou femmes jusque-là charmants et honnêtes."
                            },
                            {
                                "example_id": "78850105-8354-46f5-bc36-5fe2d002c723",
                                "sense_id": "5c0c6fb1-100e-3424-a46c-ef95e2d295a9",
                                "text": "Un peu mythomane, Isaac croit lui-même à ses fables."
                            }
                        ]
                    },
                    {
                        "sense_id": "789a4488-525f-35b8-a751-4303c15299f6",
                        "entry_id": "b80c8838-9325-312a-9e11-1b526b97deb1",
                        "glosses": [
                            "Qui ment, qui fabule."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4de4db98-5e8e-3b69-aff9-3c13c9d1f587",
                        "entry_id": "b80c8838-9325-312a-9e11-1b526b97deb1",
                        "glosses": [
                            "Qui est en rapport avec la mythomanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249f497a-3bc5-42a8-88ae-f8c9ab647108",
                                "sense_id": "4de4db98-5e8e-3b69-aff9-3c13c9d1f587",
                                "text": "Il est difficile de savoir s’il s’agit de faits réels ou de fantasmes mythomanes; en tout cas, Valentine s’est sentie mutilée."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "853cd7e1-0ae4-402b-b3cf-bab5423a6d8c",
                        "source_entry_id": "b80c8838-9325-312a-9e11-1b526b97deb1",
