                                    {
                                        "sense_id": "5a660d27-3cfd-3719-86a2-99553a402438",
                                        "entry_id": "ec8b1c2a-88f7-3782-9d43-4fd4b2b3f48b",
                                        "glosses": [
                                            "Gaststätte, in der vor allem Kaffee und Kuchen angeboten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "542ed332-94ce-4e7d-bb8c-0085c98ce4d3",
                                                "sense_id": "5a660d27-3cfd-3719-86a2-99553a402438",
                                                "text": "Ich saß in einem Café und las eine Zeitung."
                                            },
                                            {
                                                "example_id": "9b75a994-f435-4694-b2e0-a918b6fa0a8b",
                                                "sense_id": "5a660d27-3cfd-3719-86a2-99553a402438",
                                                "text": "„Am Ende seines Lebens, das er eine Tragödie in 55 Akten nannte, klagte der 55jährige Oscar Wilde aus seinem Pariser Exil, er schreibe nun schon in einem Cafè, wo es keine Tinte mehr gebe.“"
                                            },
                                            {
                                                "example_id": "1bc6bb56-ef69-47a2-8492-fee7754c15b3",
                                                "sense_id": "5a660d27-3cfd-3719-86a2-99553a402438",
                                                "text": "„Wir trafen uns wieder im Café Het Loosje bei der alten Waage.“"
                                            },
                                            {
                                                "example_id": "585b8fe8-a1c4-4728-8e06-9554c0370153",
                                                "sense_id": "5a660d27-3cfd-3719-86a2-99553a402438",
                                                "text": "„Noch war der Abend jung, so beschloss ich, mich in ein Café in der Innenstadt zu setzen und den Stand meiner Reise durchzugehen.“"
                                            },
                                            {
                                                "example_id": "c22232b5-2b00-4b75-91ad-e125ad502096",
                                                "sense_id": "5a660d27-3cfd-3719-86a2-99553a402438",
                                                "text": "„Auf der Suche nach einem Café kamen sie an einem Supermarkt vorbei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
