                "senses": [
                    {
                        "sense_id": "ec738ce9-7597-3339-9256-549284a08e13",
                        "entry_id": "e77a704e-220b-3932-8d06-4b774d777569",
                        "glosses": [
                            "Kernfamilie, die aus nur einem Elternteil und Kind(ern) besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b90165b-bf66-40fa-8578-ededfc83f288",
                                "sense_id": "ec738ce9-7597-3339-9256-549284a08e13",
                                "text": "„Niepel führt weiter aus, dass stigmatisierende bzw. anerkennende Reaktionen der Netzwerkmitglieder weitreichende Effekte auf das Selbstwertgefühl der Alleinerziehenden sowie auf ihre Bewertung der Lebensform Ein-Elter-Familie haben.“"
                            },
                            {
                                "example_id": "faa53b75-681a-463f-9066-acaaafa2aea2",
                                "sense_id": "ec738ce9-7597-3339-9256-549284a08e13",
                                "text": "„Hinterfragt werden soll weiterführend einerseits eine Gegenüberstellung von Ein-Elter-Familien zu Zwei-Eltern-Familien als vermeintliche Gegensätze.“"
                            },
                            {
                                "example_id": "c7abe04f-483f-40e3-a5f4-7ef7770ab9f6",
                                "sense_id": "ec738ce9-7597-3339-9256-549284a08e13",
                                "text": "„Mit ihr verknüpfen sich in Evolution und Geschichte unterschiedlichste Inhalte und Erscheinungsformen in Begriffen wie Sippe, Verwandtschaftsfamilie, Herkunftsfamilie, Kernfamilie, Normalfamilie, Haushaltsfamilie, Ein-Elter-Familie, Großfamilie, Gruppe, Mehr-Generationenfamilie, Kleinfamilie, Zwei-Kindfamilie, Drei-Generationenfamilie, Stammfamilie, Zadruga und noch viele mehr.“"
                            },
                            {
                                "example_id": "6ac9e041-b002-4fca-ae7a-1919419627a4",
                                "sense_id": "ec738ce9-7597-3339-9256-549284a08e13",
                                "text": "„Im Zeitverlauf zeigen sich eine Abnahme der Ehepaare mit ledigen Kindern und ein Anstieg der Ein-Elter-Familien, während zu den Lebensgemeinschaften keine Aussagen getroffen werden können, weil jene erst seit 2005 statistisch erfasst werden.“"
                            },
                            {
                                "example_id": "04b79729-5b52-476e-bca5-bdb9e9147a52",
                                "sense_id": "ec738ce9-7597-3339-9256-549284a08e13",
                                "text": "„Parallel dazu nehmen Ein-Elter-Familien und Stieffamilien zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
