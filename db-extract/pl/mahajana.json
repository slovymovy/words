                        "entry_id": "55bd0eaa-87ca-3c00-90ef-c5c3145ae936",
                        "glosses": [
                            "kierunek buddyzmu, wyodrębniony w pierwszym wieku p.n.e."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d45d20a7-229b-458c-8298-4fdfbd4b6f4e",
                                "sense_id": "d814e3c7-4155-30e3-9f93-d445351c61f6",
                                "text": "Poza Indiami swój wielki rozkwit przeżyła mahajana w Chinach i Japonii. Według tradycji chińskiej, buddyzm trafił do tego kraju w II wieku z Azji Centralnej, a w 355 roku zezwolono Chińczykom na wstępowanie do sangh"
                            },
                            {
                                "example_id": "0a41701c-c954-4596-8244-d7f91430c559",
                                "sense_id": "d814e3c7-4155-30e3-9f93-d445351c61f6",
                                "text": "W mahajanie rozwój poszedł dalej: te przelotne elementy istnienia (dharma) zredukowano do zera i uznano je za nierzeczywiste, konsekwentnie świat w mahajanie jest nierzeczywisty"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
