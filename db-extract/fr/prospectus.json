                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30eed094-d707-4eaa-b1d2-f2db4f9dbae7",
                                                "sense_id": "ecc4b483-0736-362f-a6a7-acdce6cbeb56",
