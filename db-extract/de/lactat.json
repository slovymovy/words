                    {
                        "translation_id": "dec0f334-b1cd-47b8-9001-f6b19e122377",
                        "source_entry_id": "ce428465-9528-35e8-aa46-4548ee7e3204",
                        "source_sense_id": "75e4bf05-e1f6-30e2-8963-aeb9beb3037b",
                        "source_sense_description": "Chemie: Salz, das das Anion der Milchsäure enthält",
                        "target_lang_word": "lactate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lactate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26926aec-c39d-399b-b29e-46cb97b425bb",
                                        "entry_id": "95eead45-fc33-3cb6-ad42-22dd16667b60",
                                        "glosses": [
                                            "Sel produit par la combinaison de l’acide lactique avec une base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4308697f-c7de-4178-9091-ab1eb732ced2",
                                                "sense_id": "26926aec-c39d-399b-b29e-46cb97b425bb",
                                                "text": "Le lactate est donc un déchet du métabolisme fermentaire, alors qu'il renferme un pouvoir réducteur résiduel important. Ce déchet est éliminé des cellules de manière à poursuivre les oxydations cellulaires."
                                            },
                                            {
                                                "example_id": "17c6273e-9301-44a4-9c44-a2814dda5636",
                                                "sense_id": "26926aec-c39d-399b-b29e-46cb97b425bb",
                                                "text": "Cette élévation du débit sanguin, en facilitant la sortie du lactate du muscle vers le compartiment sanguin, permet d'augmenter l'élimination du lactate par les autres tissus qui consomment le lactate."
                                            },
                                            {
                                                "example_id": "81966853-4e06-4aab-9259-6068c1db6cc5",
                                                "sense_id": "26926aec-c39d-399b-b29e-46cb97b425bb",
                                                "text": "Dans les premiers essais relatent La Beaume Pluvinel et Baldet, on a employé des plaques violettes de la maison Lumière, ou des plaques au lactate d'argent de Guilleminot. La durée de pose a été de 0 s,1 avec les plaques violettes et de 2 secondes avec les plaques au lactate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
