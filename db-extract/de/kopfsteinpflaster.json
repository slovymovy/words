                ],
                "senses": [
                    {
                        "sense_id": "43321d1f-1ccf-3d73-83fb-258e3926cbba",
                        "entry_id": "0ad42e42-48ad-3600-8350-73d93ddf155d",
                        "glosses": [
                            "Pflaster, das aus oben abgerundeten Naturstein-Pflastersteinen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e40f39d-813c-4bfb-aaad-9616e8d83b81",
                                "sense_id": "43321d1f-1ccf-3d73-83fb-258e3926cbba",
                                "text": "Else ist vorgestern nach dem Regenschauer böse auf unebenem Kopfsteinpflaster ausgerutscht."
                            },
                            {
                                "example_id": "f72a6a2a-6086-47d2-b305-a3b03ede3686",
                                "sense_id": "43321d1f-1ccf-3d73-83fb-258e3926cbba",
                                "text": "„Wir stolperten über das Kopfsteinpflaster des Marktplatzes.“"
                            },
                            {
                                "example_id": "5d843a6f-2057-4c58-8145-59cd080a24ad",
                                "sense_id": "43321d1f-1ccf-3d73-83fb-258e3926cbba",
                                "text": "„Sie bewunderten die mit roten Ziegeln gedeckten und von verspielten Wetterfahnen bekrönten steilen Satteldächer, staunten über das Kopfsteinpflaster und die Granitplatten auf den Wegen.“"
                            },
                            {
                                "example_id": "aad0ee9b-76ff-42bd-aa68-6d6133f5af40",
                                "sense_id": "43321d1f-1ccf-3d73-83fb-258e3926cbba",
                                "text": "„Die langen Alleen mit Kopfsteinpflaster sind wenig befahren.“"
                            },
                            {
                                "example_id": "2e83062c-4235-408b-8ebe-a5b88d824e56",
                                "sense_id": "43321d1f-1ccf-3d73-83fb-258e3926cbba",
                                "text": "„Was den Straßenlärm betraf, so klangen das Gerassel der Trambahnen und das Rattern der Kutschenräder auf dem Kopfsteinpflaster jetzt anders als früher.“"
                            },
                            {
                                "example_id": "534d480b-7782-4ef4-9803-1e445bdce0b6",
                                "sense_id": "43321d1f-1ccf-3d73-83fb-258e3926cbba",
                                "text": "„Ampeln behindern das zügige Vorankommen ebenso wie Tempo-30-Zonen, holpriges Kopfsteinpflaster und Baustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
