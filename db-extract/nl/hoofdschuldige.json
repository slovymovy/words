                        "sense_id": "410f6753-eedf-3f90-b0da-08ab51e0128a",
                        "entry_id": "eff0b076-9c61-348a-bc3a-1592bf255623",
                        "glosses": [
                            "iemand die de hoofdverantwoordelijke is voor iets dat verkeerd is gegaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7707130-8d31-468d-94e1-f78f7c6ab2ab",
                                "sense_id": "410f6753-eedf-3f90-b0da-08ab51e0128a",
                                "text": "In Rusland vond in die periode, volgens hun beschrijving, ook een reactie plaats en de hoofdschuldige van die reactie was Alexander I , dezelfde Alexander I die volgens hun beschrijving de hoofdverantwoordelijke was van de liberale initiatieven onder zijn bewind en van de redding van Rusland."
                            },
                            {
                                "example_id": "84497d15-7112-4c6f-a661-549efa9ca37f",
                                "sense_id": "410f6753-eedf-3f90-b0da-08ab51e0128a",
                                "text": "Verstappen moest in Rusland al drie plekken inleveren naar aanleiding van zijn aanvaring met Lewis Hamilton op Monza twee weken geleden. Hij werd als hoofdschuldige gezien voor de crash waarbij beide coureurs uitvielen en ontving toen een gridstraf van drie plekken."
                            }
                        ]
                    }
