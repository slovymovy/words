                    {
                        "form_id": "0969df3e-52cb-4ac3-bd25-f1ad68c9a061",
                        "entry_id": "f4c8f604-b6ba-3824-be39-e72e0696a80e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kavaliersdelikte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "376dacde-7e2b-317b-8ac0-6a76c8002221",
                        "entry_id": "f4c8f604-b6ba-3824-be39-e72e0696a80e",
                        "glosses": [
                            "eine geringfügige Regelüberschreitung, die allgemein moralisch nicht beanstandet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a4fa766-989c-4cce-a679-e6388e69a825",
                                "sense_id": "376dacde-7e2b-317b-8ac0-6a76c8002221",
                                "text": "Den Rasen trotz Verbot zu betreten, werte ich als Kavaliersdelikt."
                            },
                            {
                                "example_id": "ecd31b26-94f5-4af9-8220-763647060be0",
                                "sense_id": "376dacde-7e2b-317b-8ac0-6a76c8002221",
                                "text": "Ladendiebstahl ist kein Kavaliersdelikt!"
                            },
                            {
                                "example_id": "82622550-a292-407b-93db-78da2010285a",
                                "sense_id": "376dacde-7e2b-317b-8ac0-6a76c8002221",
                                "text": "[…] diese Diebstähle [im Hotel, Handtücher, Weingläser, Haarföne, sind] keine Kavaliersdelikte."
                            },
                            {
                                "example_id": "1733e0f4-401e-4fce-8015-237732ee037e",
                                "sense_id": "376dacde-7e2b-317b-8ac0-6a76c8002221",
                                "text": "Kunstfälschung ist kein Kavaliersdelikt. Das ist ein wichtiges Signal des Prozesses, in dem gestern die Urteile verkündet wurden."
                            },
                            {
                                "example_id": "c4d72e37-6fa9-4f87-b54c-2e90292d15ad",
                                "sense_id": "376dacde-7e2b-317b-8ac0-6a76c8002221",
                                "text": "Der Automobilexperte Stefan Bratzel vom Center of Automotive Management warnt davor, die jüngsten Enthüllungen auf die leichte Schulter zu nehmen: „Ein mögliches Auto-Kartell ist alles andere als ein Kavaliersdelikt.“"
                            },
                            {
                                "example_id": "17fdb627-144b-4819-a6fe-c0f289f4f82c",
                                "sense_id": "376dacde-7e2b-317b-8ac0-6a76c8002221",
                                "text": "„Und es ist eben in München so, dass Zweckentfremdung kein Kavaliersdelikt ist. Insgesamt hat sich die Anzahl der wohnungslosen Personen von 2008 bis jetzt fast verdreifacht, auf 9000 Personen. Und jede Wohnung, die dauerhaft an Feriengäste vermietet wird, ist eine Wohnung auf dem Wohnungsmarkt weniger.“"
                            },
                            {
                                "example_id": "fc99aa1a-0e5b-4ea7-b4a2-4247be5ce246",
                                "sense_id": "376dacde-7e2b-317b-8ac0-6a76c8002221",
                                "text": "Fritz Kaltenegger, (Bundes-)Generalsekretär der ÖVP, erklärte, dass Eggers Wortwahl „absolut inakzeptabel“ und auf das Schärfste zurückzuweisen sei. Bundeskanzler Werner Faymann (SPÖ) meinte, dass die Aussage niemals als Kavaliersdelikt zu sehen sei."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88ac3a64-d3bf-42c7-a1a0-8f61d387b80d",
                        "source_entry_id": "f4c8f604-b6ba-3824-be39-e72e0696a80e",
                        "source_sense_id": "376dacde-7e2b-317b-8ac0-6a76c8002221",
                        "source_sense_description": "eine geringfügige Regelüberschreitung, die allgemein moralisch nicht beanstandet wird",
                        "target_lang_word": "peccadillo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peccadillo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63e6b373-bc6f-33eb-a6bb-b434b0f576c0",
                                        "entry_id": "3405c5e9-8f1f-3b8c-8e7f-1a037995b752",
                                        "glosses": [
                                            "A small flaw or sin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c569dd-0887-433c-a9f1-2986b607cc38",
                                                "sense_id": "63e6b373-bc6f-33eb-a6bb-b434b0f576c0",
                                                "text": "We tolerate Irene and Phil’s mild racist quirks and planet-destroying peccadilloes (“I could never own any car smaller than my Cutlass Supreme”) because their existence acts as a tranquilizer in an otherwise slightly-out-of-control world."
                                            },
                                            {
                                                "example_id": "00fb431a-82ca-41c4-9958-c4aad342dc45",
                                                "sense_id": "63e6b373-bc6f-33eb-a6bb-b434b0f576c0",
                                                "text": "The sex scandal issue isn’t really central, since Americans have a long record of voting for the candidates they think can deliver, regardless of private peccadilloes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee681ae0-5084-34b1-a7b7-a9480d9a233f",
                                        "entry_id": "3405c5e9-8f1f-3b8c-8e7f-1a037995b752",
                                        "glosses": [
                                            "A petty offense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9546eda6-604b-4d51-9db4-b4bde9024e3d",
                                                "sense_id": "ee681ae0-5084-34b1-a7b7-a9480d9a233f",
                                                "text": "When he comes to the prayer, he sometimes does me the honor of personally recommending me to the Lord, advising him that I am a worthy man and begging him to condone my occasional peccadillos."
                                            },
                                            {
                                                "example_id": "77b44cd6-536d-41aa-911e-a0caaf4c7af0",
                                                "sense_id": "ee681ae0-5084-34b1-a7b7-a9480d9a233f",
                                                "text": "No sexual peccadillo is left unremarked upon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f49ebe3c-c358-46c5-8239-b985f44b506e",
                        "source_entry_id": "f4c8f604-b6ba-3824-be39-e72e0696a80e",
