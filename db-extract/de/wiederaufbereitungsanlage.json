                "senses": [
                    {
                        "sense_id": "b4aba4a5-98d7-38c0-8269-116fedbc02de",
                        "entry_id": "1a97a6d5-4fbd-3c84-88ac-e39ec6c8fefc",
                        "glosses": [
                            "Anlage, in der meist abgebrannte Brennelemente wiederaufbereitet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60cfcfa0-e86b-493f-a415-bc1bbaa2a34c",
                                "sense_id": "b4aba4a5-98d7-38c0-8269-116fedbc02de",
                                "text": "„Mit den Castoren wird deutscher Atommüll aus der französischen Wiederaufbereitungsanlage La Hague nach Gorleben gebracht.“"
                            },
                            {
                                "example_id": "f70e04a1-5ec1-414f-b8f7-e8dc31d8e798",
                                "sense_id": "b4aba4a5-98d7-38c0-8269-116fedbc02de",
                                "text": "„Deshalb muss man bei der Eröffnung einer Imbissbude behördliche Auflagen erfüllen, als wolle man eine Wiederaufbereitungsanlage in Betrieb nehmen.“"
                            }
                        ],
