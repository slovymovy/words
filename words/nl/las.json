                    "sense_definition": "Enkelvoud verleden tijd van <w>lezen</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reading_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen ik klein was, <w>las</w> mijn moeder me elke avond voor.",
