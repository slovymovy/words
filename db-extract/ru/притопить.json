                        "examples": [
                            {
                                "example_id": "211ff058-66d5-412e-8253-005c232c5995",
                                "sense_id": "7613ea93-7af8-3764-9309-65f5cd33ce2a",
                                "text": "Остается одно — погрузиться поглубже, чтобы притопить предательскую вешку."
                            },
                            {
                                "example_id": "a9f99a1a-45fc-44cb-a593-1f55aa841260",
                                "sense_id": "7613ea93-7af8-3764-9309-65f5cd33ce2a",
                                "text": "— Канат в землю закопал, а в баркасах дырки сделал да камнем притопил в омутке."
                            }
                        ]
                    }
