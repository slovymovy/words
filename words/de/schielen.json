    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88c8b9e7-689c-3b5c-ad2b-c329a9b9f17f",
                    "sense_definition": "Wegen einer Fehlstellung der Augenmuskeln nicht mit beiden Augen gleichzeitig in dieselbe Richtung blicken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sehen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der kleine Junge <w>schielt</w> seit seiner Geburt leicht nach innen."
                        },
                        {
                            "text": "Wenn sie sehr müde wird, beginnt ihr linkes Auge merklich zu <w>schielen</w>."
                        }
                    ],
                    "common_phrases": [
                        "nach innen schielen"
                    ]
                },
                {
                    "sense_id": "93da2a71-80be-3e5e-8f4e-bf658ff63223",
                    "sense_definition": "Heimlich, unauffällig oder aus dem Augenwinkel zu jemandem oder auf etwas blicken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sehen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Während der schwierigen Prüfung <w>schielte</w> er heimlich auf das Blatt seines Nachbarn."
                        },
                        {
                            "text": "Sie saß im Zug und <w>schielte</w> neugierig zur Seite auf sein Telefon."
                        }
                    ],
                    "common_phrases": [
                        "auf das Blatt schielen",
                        "zur Seite schielen"
                    ]
                },
                {
                    "sense_id": "2932a034-8f5a-3f85-9c32-7f6146fa060d",
                    "sense_definition": "Begehrlich auf etwas blicken, etwas unbedingt haben wollen oder jemanden um etwas beneiden.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "begehren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Anleger <w>schielen</w> nur auf die Rendite und vergessen dabei das Risiko."
                        },
                        {
                            "text": "Schon seit Monaten <w>schielt</w> die Konkurrenz neidisch auf ihren großen Erfolg."
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "auf die Rendite schielen",
                        "auf den Erfolg schielen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cab575cf-2a56-3fcc-af0a-5bead5c3fbc7",
                    "sense_definition": "Das fehlerhafte Abweichen der Sehachsen der Augen; Substantivierung des Verbs <w>schielen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sehen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch eine frühzeitige Behandlung bei Kindern lässt sich das <w>Schielen</w> oft korrigieren."
                        },
                        {
                            "text": "Bei starker Übermüdung verstärkt sich das <w>Schielen</w> bei dem Patienten spürbar."
                        }
                    ],
                    "common_phrases": [
                        "das Schielen korrigieren"
                    ]
                }
            ]
        }
    ]
}