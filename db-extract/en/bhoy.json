        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f1ee36e3-ec0d-33e6-aebc-cde8e1ffba9f",
                "word": "bhoy",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "96d2c23c-5d79-3ecd-8698-7031d754cf8e",
                        "entry_id": "f1ee36e3-ec0d-33e6-aebc-cde8e1ffba9f",
                        "glosses": [
                            "Exclamation of surprise, pleasure or longing."
                        ],
                        "tags": [
                            "dated",
                            "humorous",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7df64e35-a3ff-4fb0-9408-4ce8fccf6c5f",
                                "sense_id": "96d2c23c-5d79-3ecd-8698-7031d754cf8e",
                                "text": "assumed that the clot howling in a McCormick tenor and interspersing his shrieks with \"Oh Bhoy! Oh Bhoy!\" was my best friend and co-editor"
                            },
                            {
                                "example_id": "801e32e4-213f-48f8-b2ee-996016f5c7d4",
                                "sense_id": "96d2c23c-5d79-3ecd-8698-7031d754cf8e",
                                "text": "Philadelphia in '53 had repercussions because they couldn't have anything resembling dancing or music. They had people parading around in costume in the meeting hall with the chairs still there. Hoo Bhoy!"
                            },
                            {
                                "example_id": "0c3796f2-6477-42b9-8c2c-5c76f47ac3f9",
                                "sense_id": "96d2c23c-5d79-3ecd-8698-7031d754cf8e",
                                "text": "Oh Bhoy! This \"I dream of 4E\" (Forry?) nearly unsocked myself with laughter. Reminds me somehow of Ian Banks' books that must be something like retold dreams, too."
                            }
                        ]
                    }
                ],
