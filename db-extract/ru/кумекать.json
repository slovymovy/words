                "senses": [
                    {
                        "sense_id": "933e3b66-a76f-3eb6-8d7a-c2fbd92cb41e",
                        "entry_id": "cfe6c2ca-8c94-3b18-8da3-cf2b98e3fa7c",
                        "glosses": [
                            "прост., рег. думать, соображать, раздумывать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f49d0ed-9eba-49b5-be8d-a92c9587bf04",
                                "sense_id": "933e3b66-a76f-3eb6-8d7a-c2fbd92cb41e",
                                "text": "Кумекали мы, кумекали, ничего не решили."
                            },
                            {
                                "example_id": "e34df467-402f-4f8d-922d-9f7b18c139e1",
                                "sense_id": "933e3b66-a76f-3eb6-8d7a-c2fbd92cb41e",
                                "text": "— Ли-те-ра-турная! — отчеканил Семка. // — Ну вот! Оно самое и есть!.. А я давеча кумекал, кумекал: какое слово, которого барин бояться велел? А оно вот: ре... ти... ле... А! прах ее возьми!"
                            }
                        ]
                    },
                    {
                        "sense_id": "c43b9b13-e7fa-35f3-8b14-8d5f2f972722",
                        "entry_id": "cfe6c2ca-8c94-3b18-8da3-cf2b98e3fa7c",
                        "glosses": [
