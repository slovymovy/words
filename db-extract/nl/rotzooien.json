                        ],
                        "examples": [
                            {
                                "example_id": "17ac9513-2f01-4584-8efd-0e8b20c39acb",
                                "sense_id": "890569d3-e04c-3882-8175-eade550563ed",
                                "text": "Sommige mensen komen hier alleen maar om te rotzooien."
                            },
                            {
                                "example_id": "62abb7c9-401a-400f-a06c-de831befbc90",
                                "sense_id": "890569d3-e04c-3882-8175-eade550563ed",
                                "text": "Boy ontkende vrijdag op de radio dat hij degene was die het ijsblokje had gegooid, maar gaf toe dat hij wel had lopen rotzooien."
                            }
                        ]
                    },
                    {
                        "sense_id": "53bc48be-2449-3e44-87ff-15046920d7b5",
                        "entry_id": "9808685d-e0c3-3fe4-aa71-257604b929f0",
                        "glosses": [
                            "ongepast beoefenen van het liefdesspel"
                        ],
                        "tags": [
                            "pejorative",
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "154a6892-9c9c-411f-b3f3-02dc1f49b2f2",
                                "sense_id": "53bc48be-2449-3e44-87ff-15046920d7b5",
                                "text": "Opnieuw zorgt een seksfilmpje van een politica in België voor commotie. Op de video is te zien hoe de Hoeilaartse bestuurster Els Uytterhoeven half ontkleed in het gemeentehuis staat te rotzooien met een man. Uytterhoeven is getrouwd en de man in het filmpje is niet haar echtgenote."
                            }
                        ]
                    }
