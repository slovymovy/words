                    "frequency": "Low",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette robe à rayures verticales te <w>grandit</w> beaucoup."
                        },
                        {
                            "text": "Reconnaître ses erreurs est un geste courageux qui <w>grandit</w> une personne."
