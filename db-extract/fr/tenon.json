        "fr-extract.jsonl": [
            {
                "entry_id": "67bedae4-dc82-317b-bce8-6d86290d892f",
                "word": "tenon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2e740531-a131-4f5f-99ff-383cd6f7254d",
                        "entry_id": "67bedae4-dc82-317b-bce8-6d86290d892f",
                        "tags": [
                            "plural"
                        ],
                        "form": "tenons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75f60bdc-1944-3bb4-b6f2-21ed8e7c9dff",
                        "entry_id": "67bedae4-dc82-317b-bce8-6d86290d892f",
                        "glosses": [
                            "Extrémité d’une pièce de bois ou de métal diminuée d’une partie de son épaisseur, qu’on fait entrer dans une mortaise, c’est-à-dire dans un trou de même forme et de même grandeur fait à une autre pièce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38a9863b-bd86-4634-8ab2-30d17df6543b",
                                "sense_id": "75f60bdc-1944-3bb4-b6f2-21ed8e7c9dff",
                                "text": "Lorsque le tenon joue dans la mortaise, l'assemblage se trouve promptement détruit par les efforts auxquels il est nécessairement soumis."
                            },
                            {
                                "example_id": "c1c7ba79-945d-4ed4-af42-04d56cea1c46",
                                "sense_id": "75f60bdc-1944-3bb4-b6f2-21ed8e7c9dff",
                                "text": "Quelques meubles délabrés garnissaient la crypte ; ici, un lit ou plutôt un grabat […] ; là, un escabeau aux pieds tors, une table fixée au mur par des tenons de fer."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd939b17-e29b-3479-9e74-30ab7e1a5bb6",
                        "entry_id": "67bedae4-dc82-317b-bce8-6d86290d892f",
                        "glosses": [
                            "Partie mâle, en général garnie de liège pour assurer l’étanchéité, d’un corps d’instrument de la famille des bois qui s’insère dans le corps voisin pour permettre l’assemblage de l’instrument."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cc25e2fa-455d-38f3-8728-a1df9ab6b5ca",
                        "entry_id": "67bedae4-dc82-317b-bce8-6d86290d892f",
                        "glosses": [
                            "Petite cheville de fer qui sert à assujettir le canon d’une arme sur son bois."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66b1cb85-2720-427b-8be9-a34ba0d81b0f",
                        "source_entry_id": "67bedae4-dc82-317b-bce8-6d86290d892f",
                        "target_lang_word": "tenon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26c3e28c-b601-34a2-b214-95e92e28ba7a",
                                        "entry_id": "b19d5971-026d-3138-bdf1-6e00379c9461",
                                        "glosses": [
                                            "A projecting member left by cutting away the wood around it, and made to insert into a mortise, and in this way secure together the parts of a frame."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dce659e-5256-4776-8490-7a5ce88ba3b4",
                                                "sense_id": "26c3e28c-b601-34a2-b214-95e92e28ba7a",
                                                "text": "A keyed mortise-and-tenon joint is constructed the same as a doweled mortise and tenon joint except that the tenon projects far enough through the mortise to admit the insertion of a tapering key which draws the mortised piece firmly against the shoulder of the tenon."
                                            },
                                            {
                                                "example_id": "97ab3ae7-f7ba-4ec2-8be1-2254292c49ee",
                                                "sense_id": "26c3e28c-b601-34a2-b214-95e92e28ba7a",
                                                "text": "One soon learned, however, that it was no easy thing to make wood do exactly as one required it. It looked quite easy in the masterly hands of the experienced pattern-maker, but the mysteries of dowelling and mortice and tenon were not uncovered in a week or two."
                                            },
                                            {
                                                "example_id": "17177ff1-b779-40e8-b371-ac22a4bc6bef",
                                                "sense_id": "26c3e28c-b601-34a2-b214-95e92e28ba7a",
                                                "text": "If there is much gauging for the same size mortise and tenon to be done, and if a mortise gauge is not handy, a simple improvised gauge for the purpose can easily be made with two pieces of wood and four or five steel sprigs…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tenon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5161d275-4740-327a-8970-4991f789196e",
                                        "entry_id": "87f164e7-4496-3b70-80ac-d6f9f0268854",
                                        "glosses": [
                                            "To make into a tenon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b61585e-5ae6-443c-be8e-3769b3eecbe6",
                                                "sense_id": "5161d275-4740-327a-8970-4991f789196e",
                                                "text": "First we'll tenon this part, then we'll make a mortise that will fit it on that part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "603dd832-0e94-3b64-b9a1-281159bf9268",
                                        "entry_id": "87f164e7-4496-3b70-80ac-d6f9f0268854",
                                        "glosses": [
                                            "To fit with tenons."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
