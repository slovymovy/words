                "senses": [
                    {
                        "sense_id": "90522222-91f3-3ef6-9a67-c27c3543b371",
                        "entry_id": "fced49d4-a5a7-3542-8a33-bd301035deaf",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2383b029-bcf9-4e3c-9f15-a09e29874880",
                                "sense_id": "90522222-91f3-3ef6-9a67-c27c3543b371",
                                "text": "Partzschs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "138b54ad-98f8-4c33-870c-f7a0b5f05a92",
                                "sense_id": "90522222-91f3-3ef6-9a67-c27c3543b371",
                                "text": "Frau Partzsch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8d370f85-499d-4e20-84af-77f53568c46e",
                                "sense_id": "90522222-91f3-3ef6-9a67-c27c3543b371",
                                "text": "Herr Partzsch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "50e76985-7d02-49d7-b273-b4bb937579cc",
                                "sense_id": "90522222-91f3-3ef6-9a67-c27c3543b371",
                                "text": "Die Partzschs fliegen heute nach Sofia."
                            },
                            {
                                "example_id": "6311486b-71d3-4b2c-b13e-4b2943187458",
                                "sense_id": "90522222-91f3-3ef6-9a67-c27c3543b371",
                                "text": "Der Partzsch trägt nie die Pullover, die die Partzsch ihm strickt."
                            },
                            {
                                "example_id": "93571b68-ae03-4dbd-be2e-fca8e480fe6f",
                                "sense_id": "90522222-91f3-3ef6-9a67-c27c3543b371",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Partzsch kommt, geht der Herr Partzsch.“"
                            },
                            {
                                "example_id": "d7d1fae6-924f-40bd-abc5-d4909483ea58",
                                "sense_id": "90522222-91f3-3ef6-9a67-c27c3543b371",
                                "text": "Partzsch kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
