                "senses": [
                    {
                        "sense_id": "9dedb1d5-02ec-31eb-aad2-d4941ba63d68",
                        "entry_id": "01691080-d78b-3826-b56b-21bdf8b5aa44",
                        "glosses": [
                            "Pfeife, die Hunde viel besser/auf größere Distanzen als Menschen hören können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ceabb3-c73b-440d-b5c5-b97c559559ff",
                                "sense_id": "9dedb1d5-02ec-31eb-aad2-d4941ba63d68",
                                "text": "„Ich überlege, ob ich mir eine dieser Hochfrequenzpfeifen kaufe, eine Hundepfeife, und damit jedes Stockwerk ablaufe, um rauszufinden, hinter welcher Tür die Töle nervt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f68a7ca5-10d5-4616-83d9-0ef4c0d9cf86",
                        "source_entry_id": "01691080-d78b-3826-b56b-21bdf8b5aa44",
                        "source_sense_id": "9dedb1d5-02ec-31eb-aad2-d4941ba63d68",
                        "source_sense_description": "Pfeife, die Hunde viel besser/auf größere Distanzen als Menschen hören können",
                        "target_lang_word": "dog whistle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dog whistle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e668335-8b0f-3604-bf0c-3b5137711006",
                                        "entry_id": "8a105323-1df4-3efa-98d7-5313dc143d59",
                                        "glosses": [
                                            "A high-pitched whistle, generally inaudible to humans, used to train dogs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "477319ec-444e-339a-b262-bf140f8f7acd",
                                        "entry_id": "8a105323-1df4-3efa-98d7-5313dc143d59",
                                        "glosses": [
                                            "That which is understood only by a narrow demographic."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4973f53f-5c97-4945-97aa-906059b4bc13",
                                                "sense_id": "477319ec-444e-339a-b262-bf140f8f7acd",
                                                "text": "2012, 22 March, Scott Tobias, AV Club Cabin Boyhttp://www.avclub.com/articles/cabin-boy,71269/\nBut like a lot of these cult comedies, Cabin Boy was a dog whistle few could hear, and critics and audiences dismissed it quickly and forcefully: It left theaters with grosses south of $4 million and earned Elliott a “Worst New Star” Razzie nomination, no doubt for the adenoidal voice common to all fancy lads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5133110-e7ea-3c01-864c-017424772644",
                                        "entry_id": "8a105323-1df4-3efa-98d7-5313dc143d59",
                                        "glosses": [
                                            "A political allusion or comment that only a certain audience is intended to note and recognize the significance of; particularly in relation to controversial or extreme viewpoints."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98936a10-d9b1-441d-b5fb-c6d6edd9f49b",
                                                "sense_id": "e5133110-e7ea-3c01-864c-017424772644",
                                                "text": "On the lips of Premier Mike Harris, the term ‘special interest’ has the tone of epithet. It’s an all-purpose dog-whistle that those fed up with feminists, minorities, the undeserving poor hear loud and clear."
                                            },
                                            {
                                                "example_id": "0572fbf0-5589-4c27-a3b8-1eaf1cbf6113",
                                                "sense_id": "e5133110-e7ea-3c01-864c-017424772644",
                                                "text": "Putting “globalist” in quotes suggests a jest or in-joke of sorts, so it’s at least possible this wasn’t intended as some kind of anti-Semitic dog whistle."
                                            },
                                            {
                                                "example_id": "4880d1c7-06b9-403a-a6b8-aa5d2b09a369",
                                                "sense_id": "e5133110-e7ea-3c01-864c-017424772644",
                                                "text": "But just as the usual dog-whistle article in The New York Times about the recently elected incoming government warning that \"the far-right government that will soon take power ... marks a qualitative and alarming break with all the other governments in Israel's 75-year history\" (only right-wing government are alarming) – and thus resonated with American administration officials."
                                            },
                                            {
                                                "example_id": "3cc466d4-79ca-405c-a0ad-cda8b64fac6c",
                                                "sense_id": "e5133110-e7ea-3c01-864c-017424772644",
                                                "text": "But it was in the waning days of the campaign that the sheriff’s use of images of billionaire George Soros, a donor to many liberal causes and a target of frequent attacks from the right, sparked a charge from Democratic officials and others that Hodgson was using a “dog whistle” of antisemitism, a claim the sheriff’s campaign angrily rejected."
                                            },
                                            {
                                                "example_id": "4f2cb216-e3d5-46b0-ad2c-eeee98c9182f",
                                                "sense_id": "e5133110-e7ea-3c01-864c-017424772644",
                                                "text": "“Many of them are coming from contexts where they associate socialism, or anything close to it, with what they left behind and why they left,” Bustamante explains. “I think Republicans have been very savvy – really ruthless – in exploiting that.” / Or as Regalado, a Republican, puts it: “It’s our dog whistle. And it works every time.”"
                                            },
                                            {
                                                "example_id": "7c0edd30-20df-4c08-9263-603cf424b0fd",
                                                "sense_id": "e5133110-e7ea-3c01-864c-017424772644",
                                                "text": "“You have to be living under a rock not to know what that statement [\"All lives matter\"] means. It’s a dog whistle,” Wright reportedly said."
                                            },
                                            {
                                                "example_id": "34c1d1fb-aa21-4362-abdd-86027516a767",
                                                "sense_id": "e5133110-e7ea-3c01-864c-017424772644",
                                                "text": "Whenever a well-placed public officer who should know comes out openly to say the naira is overvalued, overrated, should find its true value, etc., what he has done is to blow a dog whistle for speculators to take positions."
                                            },
                                            {
                                                "example_id": "9df5b3c9-655b-4ac7-ac2e-1faca013c81a",
                                                "sense_id": "e5133110-e7ea-3c01-864c-017424772644",
                                                "text": "[I]f you were in India right now and watching the news channels, especially the mainstream media, the way they are literally issuing a dog whistle against the Muslim minorities in India, against the lower caste, the way they're endorsing the government's line, the way they are parroting the line, the way they are making enemies of each one of us, it is nauseating."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
