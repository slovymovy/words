                                    {
                                        "sense_id": "963f184b-a4db-32bc-b406-7b223cb9521f",
                                        "entry_id": "b4d3dde5-2fc0-3d37-aedb-4a1455dd8668",
                                        "glosses": [
                                            "Someone who is forced to flee their home but who remains within their country's borders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52702ff4-3de8-44e2-8a76-45a7a8c9d8a7",
                                                "sense_id": "963f184b-a4db-32bc-b406-7b223cb9521f",
                                                "text": "By the end of 2022 the number of internally displaced people (IDPs) – those forced from their homes but remaining within their country of residence – reached 71 million, according to figures published by the Norwegian Refugee Council’s Internal Displacement Monitoring Centre (IDMC), up from 59.1 million in 2021."
                                            }
                                        ]
                                    }
                                ]
