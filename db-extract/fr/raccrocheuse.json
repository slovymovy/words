                ],
                "senses": [
                    {
                        "sense_id": "1dcee40f-f9a8-3cc3-bd1b-f20315975fe3",
                        "entry_id": "f6a6fc71-af0a-39db-9786-cf3b9dfbbd34",
                        "glosses": [
                            "Femme de mauvaise vie qui raccroche, qui racole, les passants."
                        ],
                        "tags": [
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "f76697ce-2165-419e-924c-f31e95857460",
                                "sense_id": "1dcee40f-f9a8-3cc3-bd1b-f20315975fe3",
                                "text": "Habituée à ces tergiversations, la raccrocheuse insiste eu murmurant une promesse obscène."
                            },
                            {
                                "example_id": "3730e66b-bf97-4b8a-8801-030978df1d72",
                                "sense_id": "1dcee40f-f9a8-3cc3-bd1b-f20315975fe3",
                                "text": "Je ne peux pas compter sur un nouvel amant, car tout le monde sait que je suis malade : je suis entre les mains des raccrocheuses qui rôdent la nuit par la rue St-Honoré."
                            },
                            {
                                "example_id": "85fb1cea-0ecb-4f4a-afcf-2910c58ed5e7",
                                "sense_id": "1dcee40f-f9a8-3cc3-bd1b-f20315975fe3",
                                "text": "Tête de Rat, au commissariat, connaissait l’existence de ces raccrocheuses venues de Paris et qui restaient pour lui un mystère. Comment pouvaient-elles être aussi bien habillées ? Et surtout, la plupart du temps, se montrer si gentilles ?"
                            }
                        ]
                    }
                ],
