                "senses": [
                    {
                        "sense_id": "7a7638d4-25a3-36a8-b30a-25c26c1881c3",
                        "entry_id": "5f4f84fa-5147-3c2e-a50c-1f1506a1a45c",
                        "glosses": [
                            "durch ethnische Merkmale gekennzeichnete Gruppe innerhalb eines Volkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ef850d8-9b2c-4320-ab5a-0700a8952674",
                                "sense_id": "7a7638d4-25a3-36a8-b30a-25c26c1881c3",
                                "text": "Muzafer gehört zu der Volksgruppe der Bosniaken und kommt aus Tuzla in Bosnien."
                            },
                            {
                                "example_id": "9793243b-cd1b-4e0a-9898-f12383a41059",
                                "sense_id": "7a7638d4-25a3-36a8-b30a-25c26c1881c3",
                                "text": "„Die größte Gemeinschaft bilden die Bantu, die sich in viele verschiedene Volksgruppen aufteilen, im Wesentlichen betreiben sie Landwirtschaft.“"
                            },
                            {
                                "example_id": "afa81d82-1f9f-4ca5-80aa-83dc3f808853",
                                "sense_id": "7a7638d4-25a3-36a8-b30a-25c26c1881c3",
                                "text": "„Sie sprachen Khoisan und gehörten zur Volksgruppe der !Kung, die sich selbst Ju/'hoansi nennen.“"
                            },
                            {
                                "example_id": "3e6d18c3-f2ea-40c0-a56b-8c18b2d63a76",
                                "sense_id": "7a7638d4-25a3-36a8-b30a-25c26c1881c3",
                                "text": "„Aber er schuf, und das anfangs noch keineswegs ferngesteuert aus Berlin, eine sudetendeutsche Volksbewegung, die 1935 bei freien Wahlen 66 Prozent der Volksgruppe hinter sich brachte.“"
                            },
                            {
                                "example_id": "4c30af72-e10d-468d-a95c-7692b43d29f4",
                                "sense_id": "7a7638d4-25a3-36a8-b30a-25c26c1881c3",
                                "text": "„Er gehörte zur Volksgruppe der Basaa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
