                                    {
                                        "sense_id": "68b41a8d-2ca3-34c3-8a95-154f4d3c0ccf",
                                        "entry_id": "cb7ba2bf-d770-35c9-802e-087a7511b057",
                                        "glosses": [
                                            "svařené víno"
                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43ef70b5-f6e5-43c0-adfa-a8dfa35b8b0c",
                                                "sense_id": "68b41a8d-2ca3-34c3-8a95-154f4d3c0ccf",
                                                "text": "Na vánoční svařáky a punče se Češi třesou pomalu víc než na vánoční dárky."
                                            }
                                        ]
