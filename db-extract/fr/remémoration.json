                ],
                "senses": [
                    {
                        "sense_id": "a4afcb1e-4b54-3bb9-9f17-ed094f3bea48",
                        "entry_id": "e46c4bfb-8d6e-3976-af14-5a0214d44cb7",
                        "glosses": [
                            "Action de (se) remémorer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "750bbeb3-6d8b-4acf-b1da-23fd5b481920",
                                "sense_id": "a4afcb1e-4b54-3bb9-9f17-ed094f3bea48",
                                "text": "La remémoration des rêves."
                            },
                            {
                                "example_id": "1ba1770e-b410-4e12-9415-fec6f06d9c63",
                                "sense_id": "a4afcb1e-4b54-3bb9-9f17-ed094f3bea48",
                                "text": "Combien de fois ai-je pensé, depuis, à ce soir de pluie, combien de remémorations, en plus de quarante ans, d’une événement qui resurgit aujourd’hui, sous cette pluie battante ?"
                            },
                            {
                                "example_id": "5d0f6520-3572-45c8-a59a-06b547e666f1",
                                "sense_id": "a4afcb1e-4b54-3bb9-9f17-ed094f3bea48",
                                "text": "Ce ne sera pas un travail de remémoration, tel qu’on l’entend généralement, visant à la mise en récit d’une vie, à une explication de soi."
                            },
                            {
                                "example_id": "3c171a8c-0808-498f-b9fc-3f8d9d4d8baf",
                                "sense_id": "a4afcb1e-4b54-3bb9-9f17-ed094f3bea48",
                                "text": "En matière d’odeur, Borowi semblait un expert, il atteignait dans la remémoration olfactive à un raffinement véritablement poétique."
                            },
                            {
                                "example_id": "8efbb14b-a121-4f95-9b1e-eaf992d2e8d2",
                                "sense_id": "a4afcb1e-4b54-3bb9-9f17-ed094f3bea48",
                                "text": "La mémoire et la remémoration sont deux choses importantes, nous allons vous donner toutes les bonnes astuces pour l’améliorer et en prendre soin."
                            }
                        ]
                    }
                ],
