                "senses": [
                    {
                        "sense_id": "0940efc4-9384-3495-a586-efcd20834d03",
                        "entry_id": "0edc5015-d471-3276-a9e3-7c2619342eeb",
                        "glosses": [
                            "die Form eines Hammers habend, wie ein Hammer geformt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6b6ccd8-8d2f-43a5-ae25-0d36759be0fc",
                                "sense_id": "0940efc4-9384-3495-a586-efcd20834d03",
                                "text": "„Die Spitze der Herde wirbelte bereits in einer gelben Staubwolke vorüber: langgliedrige Rinder mit schmalen Rippen und krummen, ungleichen Hörnern; kleine, dürre kohlschwarze Maultiere, die sich aneinanderdrängten und die hammerförmigen Köpfe warfen; dann wieder Rinder und schließlich, gefolgt von den übrigen Reitern, der erste Treiber, der außen heranritt und das Vieh zusammenhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
