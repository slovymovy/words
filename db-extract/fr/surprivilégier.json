                "senses": [
                    {
                        "sense_id": "7596f017-89a4-3244-a25d-ae6d4f48201c",
                        "entry_id": "1735d6c4-47e3-3516-88d2-3aeadc971e26",
                        "glosses": [
                            "Privilégier de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1363364d-56b5-422c-87c1-53f617e95e23",
                                "sense_id": "7596f017-89a4-3244-a25d-ae6d4f48201c",
                                "text": "Puisque vous lui reprochiez de surprivilégier l’histoire, elle soulevait aussi le problème des rapports entre la réflexion ethnologique et l’histoire."
                            },
                            {
                                "example_id": "c16f0c4b-5f5c-434c-9818-dfcf1d9f7b40",
                                "sense_id": "7596f017-89a4-3244-a25d-ae6d4f48201c",
                                "text": "L’offre de cette dernière, globalement plutôt compétitive, présente la particularité de ne surprivilégier ou, au contraire, de ne discriminer fortement aucun type de conducteurs."
                            }
                        ]
                    }
