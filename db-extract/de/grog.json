                                    },
                                    {
                                        "sense_id": "31b42140-4dd7-3547-bc33-3d4ee51faeaf",
                                        "entry_id": "73dbde02-e3c5-3167-83d7-c2609b54adf0",
                                        "glosses": [
                                            "To drink alcohol."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b5bd0c9-eac6-4bd4-9e7b-7056b0a4cc56",
                                                "sense_id": "31b42140-4dd7-3547-bc33-3d4ee51faeaf",
                                                "text": "[…] a practice of “equal surrender.” This evocative phrase comes from Basil Sansom's ethnography […] of grogging sessions among Aboriginal communities in Darwin. Sansom argues that this style of communal drinking […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c24c37c-00a1-45aa-9aa0-8d0e24b64ae2",
                        "source_entry_id": "2cec4138-e960-3f3b-a0aa-df2ab2d813d9",
                        "source_sense_id": "8351e63f-cfbb-3af6-b525-e110d060d31b",
                        "source_sense_description": "heißes Getränk aus Rum (auch Weinbrand oder Arrak) mit Wasser und Zucker",
                        "target_lang_word": "grog",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grog",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95291cb2-e94e-3161-993d-006743b1eab3",
                                        "entry_id": "ccf2f37a-bde4-387e-a5cc-5e6d4d101578",
                                        "glosses": [
                                            "Boisson chaude à base d’eau et de rhum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66383af3-2dda-4acc-90f1-4593c7373d3a",
                                                "sense_id": "95291cb2-e94e-3161-993d-006743b1eab3",
                                                "text": "Les grogs brûlants ne furent pas épargnés, et le brave sergent Long put en prendre sa part."
                                            },
                                            {
                                                "example_id": "903212f0-743a-4dac-b713-e3782f89da7c",
                                                "sense_id": "95291cb2-e94e-3161-993d-006743b1eab3",
                                                "text": "elle posa ... un plateau devant Clémence, qui se mit à préparer posément son grog, versant l’eau chaude sur le citron, qu’elle écrasait à coups de cuiller, sucrant, mettant le rhum en consultant le carafon, pour ne pas dépasser le petit verre réglementaire."
                                            },
                                            {
                                                "example_id": "2073cd2d-1273-4ad5-a503-3f30483d46b3",
                                                "sense_id": "95291cb2-e94e-3161-993d-006743b1eab3",
                                                "text": "– Ça ne te ferait rien de prendre un grog au mois de juin ? C’est une bonne boisson de vaincu, en toutes saisons."
                                            },
                                            {
                                                "example_id": "c32ad67a-c3b0-451f-b606-65c1d56da2eb",
                                                "sense_id": "95291cb2-e94e-3161-993d-006743b1eab3",
                                                "text": "Tout en parlant, mon compagnon s’était approché du comptoir, où je le rejoignis, et l’on nous servit nos grogs."
