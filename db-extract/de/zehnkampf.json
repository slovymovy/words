                ],
                "senses": [
                    {
                        "sense_id": "8408f562-a00f-3c7a-a0e1-87457bdb7a81",
                        "entry_id": "0e65ad81-3331-3308-ac4f-a4f0ab1af2c4",
                        "glosses": [
                            "ein Wettkampf im Sport, der aus zehn leichtathletischen Einzelwettbewerben an zwei Tagen besteht und aus denen eine Gesamtwertung gebildet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7c4bc77-3272-447c-a9cc-2145d976a2a6",
                                "sense_id": "8408f562-a00f-3c7a-a0e1-87457bdb7a81",
                                "text": "Der Zehnkapf besteht heute aus vier Lauf-, drei Sprung- und drei Wurfdisziplinen und erfordert eine große Vielseitigkeit und Ausdauer der Sportler."
                            },
                            {
                                "example_id": "7958d3c5-b517-4595-92a8-efc2cebf2157",
                                "sense_id": "8408f562-a00f-3c7a-a0e1-87457bdb7a81",
                                "text": "Es haben viele Sportlerinnen und Sportler am Olympischen Zehnkampf teilgenommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5e138764-d22e-36eb-a3ff-484f2b7f43ab",
                        "entry_id": "0e65ad81-3331-3308-ac4f-a4f0ab1af2c4",
                        "glosses": [
                            "antiker Zehnkampf, auch als Dekathlon bezeichnet"
                        ],
                        "tags": [
                            "Antike"
                        ],
                        "examples": [
                            {
                                "example_id": "be7b7849-c160-4588-9f04-975a533c0b60",
                                "sense_id": "5e138764-d22e-36eb-a3ff-484f2b7f43ab",
                                "text": "In der Antike wurde der Zehnkampf von den Griechen Dekathlon genannt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d45c25d7-3186-4a2b-813c-28a399ce1169",
                        "source_entry_id": "0e65ad81-3331-3308-ac4f-a4f0ab1af2c4",
                        "source_sense_id": "8408f562-a00f-3c7a-a0e1-87457bdb7a81",
                        "source_sense_description": "Leichtathletikwettkampf, der aus zehn Einzelbewerben an zwei Tagen besteht",
                        "target_lang_word": "decathlon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decathlon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f81d0c3c-3ac0-3b52-9c03-2250f54970c8",
                                        "entry_id": "d47f5a18-8189-3b39-8366-e66238671c4c",
                                        "glosses": [
                                            "An athletic contest consisting of ten events which includes sprinting, hurdling, jumping, and throwing over a span of two days."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "211fb1c1-489d-4795-9785-cdc205f6cc0a",
                                                "sense_id": "f81d0c3c-3ac0-3b52-9c03-2250f54970c8",
                                                "text": "He entered U.C.L.A. in 1954 and played for the renowned coach John Wooden’s basketball team there while training for decathlons."
                                            },
                                            {
                                                "example_id": "7258c679-1726-412a-9f21-8dd4ab3b4a39",
                                                "sense_id": "f81d0c3c-3ac0-3b52-9c03-2250f54970c8",
                                                "text": "For now, Gray and her peers are able to compete for Olympic berths only in the seven-event heptathlon, while the decathlon is restricted to men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8d98e33-737f-3adc-aef9-051ee65900bb",
                                        "entry_id": "d47f5a18-8189-3b39-8366-e66238671c4c",
                                        "glosses": [
                                            "A contest in science and math proving skill."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
