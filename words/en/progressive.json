{
    "word_family": [
        "progress",
        "progression",
        "progressively",
        "progressiveness",
        "progressivism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "91672148-7a95-3e8c-8021-b2a614687f20",
                    "sense_definition": "Favoring new policies, ideas, and methods to improve society.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate has very <w>progressive</w> views on education reform.",
                            "target_lang_translations": {
                                "ru": "У кандидата очень <w>прогрессивные</w> взгляды на реформу образования.",
                                "zh": "这位候选人在教育改革方面持有非常<w>进步的</w>观点。"
                            }
                        },
                        {
                            "text": "They adopted a <w>progressive</w> policy to help the homeless.",
                            "target_lang_translations": {
                                "ru": "Они приняли <w>прогрессивную</w> политику для помощи бездомным.",
                                "zh": "他们采取了一项<w>进步的</w>政策来帮助无家可归者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "liberal",
                        "advanced",
                        "forward-looking"
                    ],
                    "antonyms": [
                        "conservative",
                        "reactionary"
                    ],
                    "common_phrases": [
                        "progressive policy",
                        "progressive views",
                        "progressive movement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживающий новые идеи и методы для улучшения общества.",
                        "zh": "支持通过新政策、新思想和新方法来改善社会的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогрессивный",
                                "target_lang_sense_clarification": "о взглядах, политике"
                            },
                            {
                                "target_lang_word": "передовой",
                                "target_lang_sense_clarification": "об идеях, методах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进步的",
                                "target_lang_sense_clarification": "指思想、政策或观点"
                            },
                            {
                                "target_lang_word": "先进的",
                                "target_lang_sense_clarification": "指方法或理念"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2a71d37-87e8-33e4-a34c-ec939edc7027",
                    "sense_definition": "Happening or developing gradually over a period of time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_gradual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There has been a <w>progressive</w> decline in the quality of service over the years.",
                            "target_lang_translations": {
                                "ru": "С годами наблюдалось <w>постепенное</w> снижение качества обслуживания.",
                                "zh": "多年来，服务质量一直在<w>逐渐</w>下降。"
                            }
                        },
                        {
                            "text": "We noticed a <w>progressive</w> improvement in her grades this semester.",
                            "target_lang_translations": {
                                "ru": "Мы заметили <w>поступательное</w> улучшение её оценок в этом семестре.",
                                "zh": "我们注意到她这学期的成绩有了<w>逐步的</w>提高。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gradual",
                        "continuous",
                        "increasing"
                    ],
                    "common_phrases": [
                        "progressive decline",
                        "progressive loss",
                        "progressive improvement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или развивающийся постепенно в течение определенного времени.",
                        "zh": "在一段时间内逐渐发生或发展的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постепенный",
                                "target_lang_sense_clarification": "происходящий шаг за шагом"
                            },
                            {
                                "target_lang_word": "поступательный",
                                "target_lang_sense_clarification": "движущийся вперед, развивающийся"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逐渐的",
                                "target_lang_sense_clarification": "指过程或变化"
                            },
                            {
                                "target_lang_word": "逐步的",
                                "target_lang_sense_clarification": "指发展的步调"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a635428-079e-36af-8615-aa751a4b2fe8",
                    "sense_definition": "Of a disease or condition, becoming worse or more severe over time.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_gradual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alzheimer's is a <w>progressive</w> disease that affects memory and cognitive function.",
                            "target_lang_translations": {
                                "ru": "Болезнь Альцгеймера — это <w>прогрессирующее</w> заболевание, влияющее на память и когнитивные функции.",
                                "zh": "阿尔茨海默病是一种影响记忆力和认知功能的<w>进行性</w>疾病。"
                            }
                        },
                        {
                            "text": "The doctor diagnosed him with a <w>progressive</w> condition that requires constant monitoring.",
                            "target_lang_translations": {
                                "ru": "Врач диагностировал у него <w>прогрессирующее</w> заболевание, требующее постоянного наблюдения.",
                                "zh": "医生诊断他患有一种需要持续监测的<w>进行性</w>疾病。"
                            }
                        }
                    ],
                    "antonyms": [
                        "non-progressive"
                    ],
                    "common_phrases": [
                        "progressive disease",
                        "progressive condition",
                        "progressive disorder"
                    ],
                    "target_lang_definitions": {
                        "ru": "О болезни или состоянии: ухудшающийся или становящийся более тяжелым со временем.",
                        "zh": "指疾病或状况随时间推移而恶化或加重。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогрессирующий",
                                "target_lang_sense_clarification": "о заболевании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进行性的",
                                "target_lang_sense_clarification": "医学术语，指病情恶化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09c3f463-5f9b-35d3-9147-6ae14b93de97",
                    "sense_definition": "Relating to a tax system where the tax rate increases as the taxable amount increases.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>progressive</w> tax system ensures that higher earners contribute a larger share.",
                            "target_lang_translations": {
                                "ru": "<w>Прогрессивная</w> налоговая система гарантирует, что люди с высоким доходом вносят больший вклад.",
                                "zh": "<w>累进</w>税制确保了高收入者贡献更大的份额。"
                            }
                        },
                        {
                            "text": "Many economists argue for <w>progressive</w> taxation to help reduce income inequality.",
                            "target_lang_translations": {
                                "ru": "Многие экономисты выступают за <w>прогрессивное</w> налогообложение, чтобы помочь уменьшить неравенство доходов.",
                                "zh": "许多经济学家主张实行<w>累进</w>税制，以帮助减少收入不平等。"
                            }
                        }
                    ],
                    "antonyms": [
                        "regressive"
                    ],
                    "common_phrases": [
                        "progressive tax",
                        "progressive taxation",
                        "progressive income tax"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к налоговой системе, в которой ставка налога увеличивается по мере роста облагаемой суммы.",
                        "zh": "指税率随应纳税额增加而提高的税收制度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогрессивный",
                                "target_lang_sense_clarification": "о налогах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "累进的",
                                "target_lang_sense_clarification": "指税收制度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a572c555-671c-3763-b085-53c51f7a0e09",
                    "sense_definition": "A grammatical form used to express an action that is continuing at a specific time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the sentence 'I am eating', the verb is in the present <w>progressive</w>.",
                            "target_lang_translations": {
                                "ru": "В предложении «I am eating» глагол стоит в настоящем <w>длительном</w> времени.",
                                "zh": "在“I am eating”这句话中，动词使用的是现在<w>进行时</w>。"
                            }
                        },
                        {
                            "text": "Learners often confuse the simple past with the past <w>progressive</w>.",
                            "target_lang_translations": {
                                "ru": "Учащиеся часто путают простое прошедшее время с прошедшим <w>длительным</w>.",
                                "zh": "学习者经常混淆一般过去时和过去<w>进行时</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "continuous"
                    ],
                    "common_phrases": [
                        "present progressive",
                        "past progressive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грамматическая форма, используемая для выражения действия, которое продолжается в определенный момент времени.",
                        "zh": "一种用于表示在特定时间正在进行的动作的语法形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продолженное время",
                                "target_lang_sense_clarification": "грамматический термин"
                            },
                            {
                                "target_lang_word": "длительная форма",
                                "target_lang_sense_clarification": "грамматический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进行时",
                                "target_lang_sense_clarification": "语法术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f8d36df-8492-3302-8571-bec10af7e4c9",
                    "sense_definition": "A person who supports new ideas and social change; a liberal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>progressive</w>, she campaigned vigorously for equal rights.",
                            "target_lang_translations": {
                                "ru": "Как <w>сторонница прогресса</w>, она активно агитировала за равные права.",
                                "zh": "作为一名<w>进步人士</w>，她积极为平等权利奔走呼吁。"
                            }
                        },
                        {
                            "text": "Many <w>progressives</w> in the party are pushing for greener energy policies.",
                            "target_lang_translations": {
                                "ru": "Многие <w>прогрессисты</w> в партии настаивают на более экологичной энергетической политике.",
                                "zh": "党内的许多<w>进步人士</w>正在推动更环保的能源政策。"
                            }
                        }
                    ],
                    "synonyms": [
                        "liberal",
                        "reformer"
                    ],
                    "antonyms": [
                        "conservative"
                    ],
                    "common_phrases": [
                        "political progressive",
                        "self-described progressive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который поддерживает новые идеи и социальные перемены; либерал.",
                        "zh": "支持新思想和社会变革的人；自由派人士。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сторонник прогресса",
                                "target_lang_sense_clarification": "человек"
                            },
                            {
                                "target_lang_word": "прогрессивный деятель",
                                "target_lang_sense_clarification": "общественный деятель"
                            },
                            {
                                "target_lang_word": "прогрессист",
                                "target_lang_sense_clarification": "политический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进步人士",
                                "target_lang_sense_clarification": "指人"
                            },
                            {
                                "target_lang_word": "进步主义者",
                                "target_lang_sense_clarification": "政治立场"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}