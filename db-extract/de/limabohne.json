                    {
                        "translation_id": "8932a987-90b1-43d6-b5fc-eafbc742d568",
                        "source_entry_id": "7289a5bd-c7d9-3a38-9843-a2fd77c7b7a1",
                        "source_sense_id": "18a1e9c3-20d2-3660-be6e-540e9c3f93b4",
                        "source_sense_description": "aus Mittel- und Südamerika stammende Pflanzenart aus der Gattung Phaseolus",
                        "target_lang_word": "haricot de Lima",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haricot de Lima",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3dbd9d0e-0856-3605-93ba-626a944e76ef",
                                        "entry_id": "20a46bf6-3e3f-3a8f-a8fc-87fa928c67ad",
                                        "glosses": [
                                            "Nom usuel de Phaseolus lunatus et de ses cultivars, plante herbacée annuelle de la famille des Fabaceae (Fabacées), cultivée dans les pays chauds pour ses graines consommées comme légume à l'instar du haricot commun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56ba36bd-ab2e-4b9f-94c5-558e179e29cc",
                                                "sense_id": "3dbd9d0e-0856-3605-93ba-626a944e76ef",
                                                "text": "Originaire d’Amérique centrale et du Sud, le pois du Cap (haricot de Lima) s’est répandu en Afrique tropicale, en Asie du Sud-Est, en Amérique du Sud et dans les Caraïbes. Phaseolus lunatus est cultivé pour ses grains, essentiellement consommés frais, plus fondants que ceux du haricot commun (Phaseolus vulgaris). Sur les marchés traditionnels, une bonne partie de la production est vendue en gousses vertes. Les graines contiennent à maturité 19 à 25 % de protéines. Certaines variétés contiennent un taux important d’acide cyanhydrique qui impose des méthodes de cuisson particulières. — (Cirad/Gret/MAE, Mémento de l'Agronome, 1 692 pages, page 874, 2002, Paris, France, Cirad/Gret/Ministère des Affaires Étrangères)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cc3bfa0-684f-3f42-83bc-dae497b1173b",
                                        "entry_id": "20a46bf6-3e3f-3a8f-a8fc-87fa928c67ad",
                                        "glosses": [
                                            "Nom donné aux graines de cette plante qui sont comestibles après trempage et cuisson (selon les variétés)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "159001ee-f922-4d3c-bd27-73aed832039b",
                                                "sense_id": "1cc3bfa0-684f-3f42-83bc-dae497b1173b",
                                                "text": "Le haricot de Lima se transforme rapidement en bouillie, d'où l'importance d'éviter une cuisson prolongée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
