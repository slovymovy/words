                                            {
                                                "example_id": "7a8b2282-3bf3-4206-a7b8-e921279ed71b",
                                                "sense_id": "bd28fca2-fe9d-32c6-bef8-a4107fc65779",
                                                "text": "The European Space Agency on Wednesday named the first ever \"parastronaut\" in a major step towards allowing people with physical disabilities to work and live in space."
                                            },
                                            {
                                                "example_id": "cc005dca-07bb-4add-9e45-83ad76f9d26d",
                                                "sense_id": "bd28fca2-fe9d-32c6-bef8-a4107fc65779",
                                                "text": "The world's first 'parastronaut' has taken his first zero-gravity flight – potentially in preparation for going into orbit."
                                            },
                                            {
                                                "example_id": "fc6ab67c-ec8e-46de-84b9-60e6d6f681d1",
                                                "sense_id": "bd28fca2-fe9d-32c6-bef8-a4107fc65779",
                                                "text": "For the parastronaut vacancy, while they will remain a member of the reserve crew, ESA plans to work with commercial space operators to find a safe way to send them to the ISS where thy can perform 'meaningful and useful work'."
                                            }
