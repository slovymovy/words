                "forms": [
                    {
                        "form_id": "8cf48e61-bc55-4f30-b2d6-60ef9513a25c",
                        "entry_id": "0c6b9871-ed2a-3622-b68c-ef4aa38db6c1",
                        "tags": [
                            "plural"
                        ],
                        "form": "lignines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2c53080-f063-38d4-afce-d68252228b44",
                        "entry_id": "0c6b9871-ed2a-3622-b68c-ef4aa38db6c1",
                        "glosses": [
                            "Polymère phénolique complexe à structure tridimensionnel, imprégnant la paroi secondaire des cellules de certains tissus végétaux (notamment le bois) et contribuant à leur imperméabilité, rigidité, résistance mécanique et protection contre les agressions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "426b4cd2-a64f-4ae9-9b8e-a66defde11cc",
                                "sense_id": "b2c53080-f063-38d4-afce-d68252228b44",
                                "text": "[Le métabolisme phénolique] génère également les précurseurs de biopolymères, en particulier ceux de la lignine qui jouent un rôle fondamental dans la formation du système vasculaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7718794-a7b9-4a78-b315-7f58ff8af110",
                        "source_entry_id": "0c6b9871-ed2a-3622-b68c-ef4aa38db6c1",
                        "source_sense_id": "b2c53080-f063-38d4-afce-d68252228b44",
                        "target_lang_word": "Lignin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lignin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86e92962-fcc6-376e-957d-61f9660a6a17",
                                        "entry_id": "bea74877-5b9e-3a01-8718-937012249a49",
                                        "glosses": [
                                            "farbloses, feststoffartiges Biopolymer, das Bestandteil der Zellwand von Pflanzen ist und die Verholzung derer Zellen bewirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc203c8-a120-4b34-a03f-1c19e11d9e24",
                                                "sense_id": "86e92962-fcc6-376e-957d-61f9660a6a17",
                                                "text": "„So stammt Vanillearoma etwa aus Lignin, das in Zellwänden vorkommt, also in Hölzern.“"
                                            },
                                            {
                                                "example_id": "c9f11473-dedd-4156-b880-8a15bf2317b8",
                                                "sense_id": "86e92962-fcc6-376e-957d-61f9660a6a17",
                                                "text": "„Getestet werden auch Pflanzen die einen geringeren Ligninanteil haben. Lignin stört bei der Papierherstellung.“"
                                            },
                                            {
                                                "example_id": "b50d015d-5ebd-4cab-8229-ff58bff7fba7",
                                                "sense_id": "86e92962-fcc6-376e-957d-61f9660a6a17",
                                                "text": "„Ganz anders zeigte sich erst hundert Jahre nach der Erfindung des Holzschliffs, dass das darin enthaltene Lignin nicht altersbeständig ist, sondern im Laufe relativ kurzer Zeit brüchig bis zur Zerstörung des Papiers wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
