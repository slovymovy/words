                "senses": [
                    {
                        "sense_id": "7f674135-7553-3b50-a873-31424e1785fb",
                        "entry_id": "7f093270-70e9-3d83-86bd-f3765a21f386",
                        "glosses": [
                            "Prädikat für einen aus reifen und überreifen, ausgelesenen Trauben hergestellten Wein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e1849e9-3555-4679-bf1b-d4f73f68303e",
                                "sense_id": "7f674135-7553-3b50-a873-31424e1785fb",
                                "text": "Diese Beerenauslese ist mir zu süß."
                            },
                            {
                                "example_id": "b0726e48-a3b6-4dd1-8032-52d89de6011a",
                                "sense_id": "7f674135-7553-3b50-a873-31424e1785fb",
                                "text": "„Mit dem Prädikat Beerenauslese bezeichnet man natursüße Weine aus überreifen, edelfaulen Beeren, die traditionell einzeln mit der Schere aus den Trauben geschnitten werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7dae4780-203a-3f93-bf7b-dbfc2c85a088",
                        "entry_id": "7f093270-70e9-3d83-86bd-f3765a21f386",
                        "glosses": [
                            "die Auslese von voll- und überreifen Weinbeeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3aed290-af53-4d67-a0c9-4ff70d1deb2d",
                                "sense_id": "7dae4780-203a-3f93-bf7b-dbfc2c85a088",
                                "text": "Die Kaffeekirschenernte wird in den guten Lagen ähnlich durchgeführt wie eine Beerenauslese im Weinbau."
                            }
                        ],
