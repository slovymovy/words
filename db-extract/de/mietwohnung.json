                ],
                "senses": [
                    {
                        "sense_id": "f4d482a4-1bdc-3fd2-b158-9bdd5b5bcb8f",
                        "entry_id": "e0f4a373-2828-3460-94e6-66e6654382e0",
                        "glosses": [
                            "Wohnung, die jemand gegen Zahlung eines vereinbarten Betrages (Miete) für eine bestimmte Zeit nutzen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a64a350-0c69-4434-9268-15a7cf9c40d3",
                                "sense_id": "f4d482a4-1bdc-3fd2-b158-9bdd5b5bcb8f",
                                "text": "In den letzten Jahren wurden sehr viele Mietwohnungen an neue Eigner verkauft."
                            },
                            {
                                "example_id": "986f73dd-6215-4eb8-8444-34965cf3744a",
                                "sense_id": "f4d482a4-1bdc-3fd2-b158-9bdd5b5bcb8f",
                                "text": "„Was nach Zaubertrank klingt, bedeutet, dass ein Investor sich verpflichten muss, bei einem größeren Projekt ein Drittel Sozialwohnungen, ein Drittel frei finanzierte Mietwohnungen und ein Drittel Eigentumswohnungen zu schaffen.“"
                            },
                            {
                                "example_id": "6495fb3a-cdfa-4a08-8207-7c34f02049ba",
                                "sense_id": "f4d482a4-1bdc-3fd2-b158-9bdd5b5bcb8f",
                                "text": "„Ich suche in der Wochenendzeitung nach einer Mietwohnung.“"
                            },
                            {
                                "example_id": "579de504-c581-437e-9826-b4a0f0c9c9b9",
                                "sense_id": "f4d482a4-1bdc-3fd2-b158-9bdd5b5bcb8f",
                                "text": "„Von der Mietwohnung, in die die Familie für rund drei Monate zieht, sieht man auf die herrliche Parklandschaft des Genfer Sees.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
