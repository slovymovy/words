                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "02b13838-dc61-47aa-9f08-4dd0821fcb89",
                                "sense_id": "96727d1a-6c2a-3520-91b2-88d714837994",
                                "text": "– Et mon cœur ? Elle m'a souri et s'est penchée au-dessus de la table. — Il n'est pas déglingué, ton cœur ? elle a répondu avec une petite moue qui doute.",
                                "translation": "‘What about my heart?’ She smiled at me and leant over the table. ‘Isn't your heart worn out?’ she replied, with a little doubtful pout.",
                                "english": "‘What about my heart?’ She smiled at me and leant over the table. ‘Isn't your heart worn out?’ she replied, with a little doubtful pout."
                            },
                            {
                                "example_id": "be2a0abb-334f-430e-bda0-d7a940122d5a",
                                "sense_id": "96727d1a-6c2a-3520-91b2-88d714837994",
                                "text": "Elle fait quand même une drôle de moue…\nSans doute la moue paternelle !",
                                "translation": "Asterix and the Chieftain's Daughter",
                                "english": "Asterix and the Chieftain's Daughter"
                            }
                        ]
                    }
                ],
