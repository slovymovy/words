                ],
                "senses": [
                    {
                        "sense_id": "cd4e98c0-64c4-35fb-9d63-4db0a2a28d44",
                        "entry_id": "cd00377e-729e-3a71-9944-b84119b58656",
                        "glosses": [
                            "Heil der Seele; Zustand, dass die Seele nicht durch Sünden belastet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd05a4ab-724e-4cee-904d-0ee3fa4de9e6",
                                "sense_id": "cd4e98c0-64c4-35fb-9d63-4db0a2a28d44",
                                "text": "„Was die Erfahrung des Bergsteigens zu einer Metapher des Lebens überhaupt werden lässt und sogar noch zum Sinnbild für die Suche nach dem ewigen Seelenheil, ist die Verbindung der kulturell positiv besetzten Vorstellung der Höhe mit der Abforderung einer körperlichen Leistung.“"
                            },
                            {
                                "example_id": "3d5abbac-3988-4da5-885a-2ae868f3737a",
                                "sense_id": "cd4e98c0-64c4-35fb-9d63-4db0a2a28d44",
                                "text": "„Doch mehr als für das Seelenheil der Afrikaner interessierten sich die meisten Europäer für irdische Reichtümer.“"
                            },
                            {
                                "example_id": "751fea3d-9a8d-4393-bbb9-6c7a8734792c",
                                "sense_id": "cd4e98c0-64c4-35fb-9d63-4db0a2a28d44",
                                "text": "„Den Priestern, die nach Afrika entsendet werden, ist nicht nur das Seelenheil der weißen Bevölkerung anvertraut, sondern auch die Bekehrung der Einheimischen.“"
                            },
                            {
                                "example_id": "be10132a-4cd0-4123-a345-1daed9b9250b",
                                "sense_id": "cd4e98c0-64c4-35fb-9d63-4db0a2a28d44",
                                "text": "„Ich hörte auch, daß sie sogar um die Kerzen feilschte, die für ihr Seelenheil brennen sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
