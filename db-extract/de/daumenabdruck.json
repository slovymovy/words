                "senses": [
                    {
                        "sense_id": "6c145af3-3ddd-37ba-aa3c-aa91ca2f65eb",
                        "entry_id": "05cf8ab5-0f7c-3568-a1c2-8d279e7dd425",
                        "glosses": [
                            "Abdruck der Innenseite eines Daumens, der das als charakteristisch angesehene Muster des Hautreliefs erkennen lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fab7ea6-00d1-499e-bb19-5a462dabf521",
                                "sense_id": "6c145af3-3ddd-37ba-aa3c-aa91ca2f65eb",
                                "text": "„Vierzehn Jahre ist das Buch bei mir geblieben. Es bekam langsam Daumenabdrücke von allerlei Damen: auch von Frau Knautschke, meiner damaligen, nunmehr in Gott eingegangenen Wirtin, die es sich während meiner Abwesenheit genau ansah.“"
                            },
                            {
                                "example_id": "6de7f0f7-30de-4405-ae54-f3647449f6c2",
                                "sense_id": "6c145af3-3ddd-37ba-aa3c-aa91ca2f65eb",
                                "text": "„Sie ergriff mich dann am Handgelenk, führte mich zu dem Tisch, auf dem die Maschinerie stand, um die Daumenabdrücke der Transitäre festzuhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
