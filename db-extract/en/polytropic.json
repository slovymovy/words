                                            "von Organismen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b49d0b6b-a65e-4e82-9aed-9a63a84935ac",
                                                "sense_id": "bf739071-cf08-3fb8-b04d-8236fea12828",
                                                "text": "Die polytropen Arten haben einen Wettbewerbsvorteil bei der Eroberung neuer Lebensräume."
                                            },
                                            {
                                                "example_id": "efb65c86-dfef-4989-836a-e866143261b9",
                                                "sense_id": "bf739071-cf08-3fb8-b04d-8236fea12828",
                                                "text": "LOEW (1884:256) unterschied oligotrope und polytrope Bienenarten, je nachdem, ob sie einen \"Blumentyp\" oder mehrere Blumentypen bevorzugten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4cd1a07-a873-3d29-8ff0-c070bd221bda",
                                        "entry_id": "ffaa288f-225e-3b45-916d-25a162acd542",
                                        "glosses": [
                                            "Eigenschaft einer allgemeinen (realen) thermodynamischen Zustandsänderung idealer Gase, bei dem alle Zustandsgrößen (Druck, Volumen, Temperatur) variabel sind und an die Messwerte angepasst werden"
                                        ],
                                        "tags": [
                                            "Thermodynamik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2743b611-01de-4e27-8966-c1e837caa179",
                                                "sense_id": "c4cd1a07-a873-3d29-8ff0-c070bd221bda",
                                                "text": "Isotherme, isentrope, isobare und isochore Zustandsänderungen sind Sonderfälle der polytropen Zustandsänderung."
                                            },
                                            {
                                                "example_id": "d41ed270-cb80-4cf0-b90b-e486facc1e19",
                                                "sense_id": "c4cd1a07-a873-3d29-8ff0-c070bd221bda",
                                                "text": "Eine Zustandsänderung heißt polytrop, wenn sie weder isotherm noch adiabatisch verläuft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
