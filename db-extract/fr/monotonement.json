        "fr-extract.jsonl": [
            {
                "entry_id": "726165ec-0949-33b1-abfd-f948f1c4885c",
                "word": "monotonement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dbfa6042-202e-3f29-80ac-e08dda93fb60",
                        "entry_id": "726165ec-0949-33b1-abfd-f948f1c4885c",
                        "glosses": [
                            "D’une manière monotone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ba20f0-197f-4be3-a8f0-dc625346677e",
                                "sense_id": "dbfa6042-202e-3f29-80ac-e08dda93fb60",
                                "text": "Des choses aussi monotonement édifiantes."
                            },
                            {
                                "example_id": "c0b8ad40-f4db-4ac3-9e29-983baded89d4",
                                "sense_id": "dbfa6042-202e-3f29-80ac-e08dda93fb60",
                                "text": "La neige tombe, monotone, monotonement, par les cieux."
                            },
                            {
                                "example_id": "8156514c-d7b4-4313-9b47-96352c733a54",
                                "sense_id": "dbfa6042-202e-3f29-80ac-e08dda93fb60",
                                "text": "Le manteau de mer de Marino battait monotonement contre la cloison."
                            },
                            {
                                "example_id": "ce433a34-baa3-4e4f-9781-1f4173ca5027",
                                "sense_id": "dbfa6042-202e-3f29-80ac-e08dda93fb60",
                                "text": "Moi, je n’essayai pas de prier, non par révolte, mais parce qu’un malheur comme celui-là donne le sentiment d’une absence – non certes d’une inexistence, mais c’est impossible que quelqu’un soit là, et pourtant il est là : tel est le mystère de la foi, indestructible dans ceux qui en ont reçu la grâce et jusqu’à résister même au meurtre d’une petite fille, et à ce meurtre-là, dont la seule idée me donnait l’envie de hurler monotonement comme une bête torturée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c29d9525-2fab-447d-88ff-e42f1776abfd",
                        "source_entry_id": "726165ec-0949-33b1-abfd-f948f1c4885c",
                        "source_sense_id": "dbfa6042-202e-3f29-80ac-e08dda93fb60",
                        "target_lang_word": "monotonously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monotonously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e017b99-b3f5-3479-bafe-9049adf11e30",
                                        "entry_id": "93473672-fd2d-3988-9f2f-0589649f62d3",
                                        "glosses": [
                                            "In a manner that is tedious, repetitious or lacking in variety."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1f45137-9592-450d-b62c-35478cc60e01",
                                                "sense_id": "6e017b99-b3f5-3479-bafe-9049adf11e30",
                                                "text": "She worked monotonously at the assembly line."
                                            },
                                            {
                                                "example_id": "838d38ae-fa3a-4f45-bdf4-bf98f5eee742",
                                                "sense_id": "6e017b99-b3f5-3479-bafe-9049adf11e30",
                                                "text": "Time passed as time ever does when passed monotonously, that is, with a degree of rapidity which only astonishes us when it is recalled to mind by some chance circumstance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db7f1f1b-2ab9-36a0-a08d-2f1a6b95c1e1",
                                        "entry_id": "93473672-fd2d-3988-9f2f-0589649f62d3",
                                        "glosses": [
                                            "In a droning manner, that does not change pitch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c48d997-24dd-496e-9b09-1d817ec27da2",
                                                "sense_id": "db7f1f1b-2ab9-36a0-a08d-2f1a6b95c1e1",
                                                "text": "The minister spoke monotonously and his congregation began to doze."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
