                "senses": [
                    {
                        "sense_id": "0611c2e0-09a9-3b1d-ba1a-894e2a4367a5",
                        "entry_id": "e85edea1-2a95-3c90-9bbb-8ba133b5cf4e",
                        "glosses": [
                            "Relatif à l’ordre des chevaliers Porte-Glaive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65d43e1f-0676-4d83-b9b3-672ffa4648f7",
                                "sense_id": "0611c2e0-09a9-3b1d-ba1a-894e2a4367a5",
                                "text": "La croisade des religieux chevaliers porte-glaives, qui dévastèrent si honnêtement et si saintement tous les bords de la mer Baltique, doit aller au moins à cent mille morts"
                            }
                        ]
                    },
                    {
                        "sense_id": "8f0f4bd7-3d3c-3f61-b422-86485df9ad3f",
                        "entry_id": "e85edea1-2a95-3c90-9bbb-8ba133b5cf4e",
                        "glosses": [
                            "Pour qualifier certaines espèces de poisson (utiophore porte-glaive, pistiopbore porte-glaive)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46893120-e125-4e6d-b371-dc214dd735c4",
                                "sense_id": "8f0f4bd7-3d3c-3f61-b422-86485df9ad3f",
                                "text": "Dans sa natation rapide, l’Istiophore porte-glaive s’avance sans crainte, se jette sur de très-gros poissons, ne recule pas devant l’homme, et se précipite contre les vaisseaux"
                            }
                        ]
                    }
                ],
