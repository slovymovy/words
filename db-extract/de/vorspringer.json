                        "glosses": [
                            "Person, die vor den Teilnehmern eines Wettbewerbs im Skispringen die Bedingungen der Schanze überprüft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e774900-25ec-45a5-a635-bedaecdf659b",
                                "sense_id": "2c8ae962-e820-3b71-aa8b-a2a27bd38dd0",
                                "text": "„Müller nimmt als Vorspringer nicht am eigentlichen Wettbewerb teil, Skispringen war für ihn zuletzt mehr Hobby als Beruf.“"
                            },
                            {
                                "example_id": "76860832-4b53-4ff5-bd3e-235ac53953fb",
                                "sense_id": "2c8ae962-e820-3b71-aa8b-a2a27bd38dd0",
                                "text": "„Der frühere Junioren-Weltmeister war als Vorspringer auf der Schanze.“"
                            }
                        ],
