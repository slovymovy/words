                    },
                    {
                        "sense_id": "ac4d833a-c46c-3398-ac28-e3a186609ab3",
                        "entry_id": "5b550908-07b1-328a-b94a-d905e612ee37",
                        "glosses": [
                            "A person who campaigns for a person running for political office or works, or supports, in an organised and active way towards a goal; an activist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01b4b956-6279-4cce-89d4-d444752dfae6",
                                "sense_id": "ac4d833a-c46c-3398-ac28-e3a186609ab3",
                                "text": "The US supreme court has ruled unanimously that natural human genes cannot be patented, a decision that scientists and civil rights campaigners said removed a major barrier to patient care and medical innovation."
                            },
                            {
                                "example_id": "22f8e8ab-f4d6-4a31-8f0a-14dbde199695",
                                "sense_id": "ac4d833a-c46c-3398-ac28-e3a186609ab3",
                                "text": "It is remembered unfondly by politicians, communities and campaigners as the document that heralded widespread reductions in the size of the railway."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fbd65ad-3bb6-36d5-9c8a-fa93443b7833",
                        "entry_id": "5b550908-07b1-328a-b94a-d905e612ee37",
                        "glosses": [
                            "Someone with experience in a certain field."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51e4073b-d6e7-4dbf-b36b-cdb205106f50",
                        "source_entry_id": "5b550908-07b1-328a-b94a-d905e612ee37",
                        "source_sense_description": "a person who works in an organised and active way towards, or supports, a goal",
                        "target_lang_word": "Aktivist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktivist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                        "entry_id": "c25445d5-867f-3cab-972a-ccc1095e258d",
                                        "glosses": [
                                            "engagierte, zielbewusst häufig gesellschaftlich oder politisch handelnde Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "475edef3-74e4-4b1e-9428-3e1f8a45cbe6",
                                                "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                                "text": "„Bei den Luftangriffen der US-geführten Koalition gegen die Dschihadistengruppe Islamischer Staat (IS) in Syrien sind nach Angaben von Aktivisten schon mehr als 550 Menschen getötet worden.“"
                                            },
                                            {
                                                "example_id": "cf055118-0ce3-4b80-9843-72ef9384ec6d",
                                                "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                                "text": "Die Aktivisten fertigten Wahlplakate an."
                                            },
                                            {
                                                "example_id": "fdb0527f-7173-429d-9326-35438be04b0a",
                                                "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                                "text": "„Schon seit Wochen berichten Aktivisten, wie sie von der Polizei eingeschüchtert werden, in Form von Hausdurchsuchungen oder Vorladungen.“"
                                            },
                                            {
                                                "example_id": "8784841a-42b0-48eb-ad5a-cfa183307f22",
                                                "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                                "text": "„In der Metropole Berlin gab es ähnliche Veranstaltungen, aber meist auf lokale Initiative von Aktivisten hin.“"
                                            },
                                            {
                                                "example_id": "19dd26b1-3c52-4837-b63c-b88824214acd",
                                                "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                                "text": "„Andere Aktivisten zünden im Bahnhof von Johannesburg eine Bombe, eine Frau stirbt.“"
                                            },
                                            {
                                                "example_id": "d70b73c2-432d-4bb6-8795-c3f9f9967cd7",
                                                "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                                "text": "„Die niederländische Polizei hat am Morgen ein Lager propalästinensischer Aktivisten an der Universität von Amsterdam gewaltsam aufgelöst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db58c053-6de3-339d-9389-cf17267e004a",
                                        "entry_id": "c25445d5-867f-3cab-972a-ccc1095e258d",
                                        "glosses": [
                                            "staatliche Auszeichnung, Kurzform für Aktivist der sozialistischen Arbeit, werktätige Person in der DDR, die Leistungen erbracht hat, die über die Normen und Vorgaben hinausgingen"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aec6096b-b248-4a04-955b-d8f7b664ae0a",
                                                "sense_id": "db58c053-6de3-339d-9389-cf17267e004a",
                                                "text": "In seinem Arbeitsleben war er bis 1989 dreimal Aktivist geworden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a33576ce-0e07-4a7f-8799-2e711d8d495d",
                        "source_entry_id": "5b550908-07b1-328a-b94a-d905e612ee37",
                        "source_sense_description": "a person who works in an organised and active way towards, or supports, a goal",
                        "target_lang_word": "Aktivistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktivistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76315823-a49b-31e8-8ea1-d8ec234f3b02",
                                        "entry_id": "e5bc373f-14a9-3f84-ba7a-88ba21ec7289",
                                        "glosses": [
                                            "oft politisch engagierte, zielbewusst handelnde weibliche Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3328904e-84d1-41de-a684-75f279aff56f",
                                                "sense_id": "76315823-a49b-31e8-8ea1-d8ec234f3b02",
                                                "text": "Die Aktivistinnen fertigten Wahlplakate an."
                                            },
                                            {
                                                "example_id": "ed3a4eb8-7abc-461b-be44-da49177cef5b",
                                                "sense_id": "76315823-a49b-31e8-8ea1-d8ec234f3b02",
                                                "text": "„In dieser Zeit trat Mugabes Frau Sally selbst als Aktivistin in Erscheinung, als sie im Dezember 1961 eine Gruppe von Frauen bei lautstarken Demonstrationen vor der britischen Botschaft und dem Amtssitz des Premierministers anführte, um gegen die Akzeptanz der neuen Verfassung durch Großbritannien zu protestieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0117df8d-57c4-331d-9c74-04a63d37bac0",
                                        "entry_id": "e5bc373f-14a9-3f84-ba7a-88ba21ec7289",
                                        "glosses": [
                                            "werktätige weibliche Person in der DDR, die Leistungen erbracht hat, die über die Normen und Vorgaben hinausgingen"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9a130b7-bc3c-4e34-acb8-d9a54edfff84",
                                                "sense_id": "0117df8d-57c4-331d-9c74-04a63d37bac0",
                                                "text": "Heutzutage ist sie Rentnerin, aber früher war sie Aktivist der sozialistischen Arbeit in der DDR."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
