                                    {
                                        "sense_id": "b18b01d7-39a3-3aa9-a2e3-d087ca0d4bb7",
                                        "entry_id": "506824c9-3d64-307c-ade2-aa977fdb2862",
                                        "glosses": [
                                            "een stukje weefsel uit een orgaan verwijderen voor onderzoek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe0bbef9-a870-45ae-ac2b-e1221c9d0b0b",
                                                "sense_id": "b18b01d7-39a3-3aa9-a2e3-d087ca0d4bb7",
                                                "text": "Een biopsie wordt te vaak direct gebruikt om vast te stellen of iemand prostaatkanker heeft. Doktoren kunnen beter eerst een mri-scan maken, om te kijken of daar afwijkingen op te zien zijn.\nDat stelt de ProstaatKankerStichting in De Telegraaf."
                                            }
                                        ]
                                    }
                                ]
                            }
