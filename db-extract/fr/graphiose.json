                "senses": [
                    {
                        "sense_id": "eb2a51fb-2535-3a2d-97b3-45dc1742f650",
                        "entry_id": "ee9280b7-8404-357a-a89b-7d0581346e26",
                        "glosses": [
                            "Maladie de l'orme causée par un champignon (Ophiostoma ulmi) transmis par un insecte, le scolyte de l’orme (Scolytus scolytus)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35663536-ebd6-4337-9b84-154900a669bb",
                                "sense_id": "eb2a51fb-2535-3a2d-97b3-45dc1742f650",
                                "text": "Dés le début du XX éme siècle, voire peut-être au XIX éme, ces arbres que l’on trouvait historiquement dans les haies bocagères et les villes a été touché par la graphiose."
                            },
                            {
                                "example_id": "c0b25d65-7846-431a-b3f7-8b7d62783c87",
                                "sense_id": "eb2a51fb-2535-3a2d-97b3-45dc1742f650",
                                "text": "La graphiose, un champignon très agressif, est un vrai problème pour les ormes. Sa présence empêche la bonne circulation de la sève."
                            },
                            {
                                "example_id": "1caefeb1-0c95-429e-843a-ca4f3dccb6c6",
                                "sense_id": "eb2a51fb-2535-3a2d-97b3-45dc1742f650",
                                "text": "Tout a pourtant été fait pour enrayer la progression de la graphiose, un champignon redoutable véhiculé par un insecte, le scolyte de l’orme, ainsi nommé car ne s’attaquant qu’à cette essence."
                            }
                        ]
                    }
