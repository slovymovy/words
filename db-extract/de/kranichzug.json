                "senses": [
                    {
                        "sense_id": "7c4fc122-dd61-36c2-ae5b-bdc921e26666",
                        "entry_id": "1dfb6817-4fd1-32cb-963a-ad0edc173307",
                        "glosses": [
                            "kollektive Bewegung von Kranichen über größere Distanzen aus klimatischen Gründen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6353fc2c-10ab-4d39-a039-d8df03184e4b",
                                "sense_id": "7c4fc122-dd61-36c2-ae5b-bdc921e26666",
                                "text": "„Was ists mit diesem Kranichzug?“"
                            },
                            {
                                "example_id": "78976b7b-941c-4f55-a9e6-1684e065c9dd",
                                "sense_id": "7c4fc122-dd61-36c2-ae5b-bdc921e26666",
                                "text": "„Er habe danach die anderen wieder eingeholt, und der Kranichzug sei ruhig Richtung Süden weitergeflogen.“"
                            },
                            {
                                "example_id": "f3744ef4-c6b5-48f0-b531-c13fdfa84976",
                                "sense_id": "7c4fc122-dd61-36c2-ae5b-bdc921e26666",
                                "text": "„Erst vor Kurzem hatte die Kreisgruppe des Landesbundes für Vogelschutz (LBV) zu einem Vortrag zum Kranichzug von Miriam Hansbauer eingeladen – ‚und schon ein paar Tage später ziehen die Vögel bereits über Fürstenfeldbruck‘, freut sich der LBV in einer Pressemitteilung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bb694858-d075-31be-a50e-ef50cf443edc",
                        "entry_id": "1dfb6817-4fd1-32cb-963a-ad0edc173307",
                        "glosses": [
                            "ein Werkzeug mit einem Haken, an dem der eiserne mit Lehm ausgeschlagene Deckel, welcher beim Treiben ^([8]) von Metallen über den Herd anstelle der Muffel gesetzt wird, hängt"
                        ],
