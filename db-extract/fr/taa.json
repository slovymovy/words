                        "glosses": [
                            "Nom de pharaon égyptien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4781d500-5da8-4c6d-b6a0-4d0402f3828b",
                                "sense_id": "d518398d-1f76-3980-bd35-99e91f590169",
                                "text": "Le pharaon Taa a conquis sa glorieuse réputation en luttant héroïquement contre les étrangers."
                            },
                            {
                                "example_id": "97eb47f4-00e1-4058-aa21-db3e8e3c3dbe",
                                "sense_id": "d518398d-1f76-3980-bd35-99e91f590169",
                                "text": "Séqénenrê Taa II aurait été tué lors d’une « cérémonie d’exécution » après avoir été fait prisonnier sur un champ de bataille."
                            },
                            {
                                "example_id": "4286c400-17f2-4883-842d-03bd9ba36e1c",
                                "sense_id": "d518398d-1f76-3980-bd35-99e91f590169",
                                "text": "Le Pharaon Taa II et son épouse Ah-Hotep vont initier la reconquête depuis la cité d’Amon."
                            }
                        ]
                    }
                ],
