                "senses": [
                    {
                        "sense_id": "85b178a4-6397-317c-8e95-1e5692eaacc0",
                        "entry_id": "a6b397ea-462f-3100-833f-92013b680e19",
                        "glosses": [
                            "Jour ou journée d'été."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe4f43ba-1c01-435a-b62e-e4441023446a",
                                "sense_id": "85b178a4-6397-317c-8e95-1e5692eaacc0",
                                "text": "An heißen Sommertagen sitzen die alten Männer des Dorfes im Schatten dieser Platane und schwatzen.",
                                "translation": "Pendant les chaudes journées d’été, les vieux hommes du village sont assis à l’ombre de ce platane et bavardent."
                            }
                        ]
                    },
                    {
                        "sense_id": "53c87dcf-9431-356a-a6ec-0a8258575e82",
                        "entry_id": "a6b397ea-462f-3100-833f-92013b680e19",
                        "glosses": [
                            "Jour où la température maximale journalière atteint ou dépasse 25 °C."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
