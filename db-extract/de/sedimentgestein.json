                                    {
                                        "sense_id": "31712e78-b197-313f-a3e8-5775d93f5501",
                                        "entry_id": "798a62fe-8678-3584-a94f-8aca259b841e",
                                        "glosses": [
                                            "gesteente dat ontstaan is uit verweringsmateriaal dat later weer ergens anders is neergeslagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "712ebd34-58ca-48ec-b8e9-611dbffbfa76",
                                                "sense_id": "31712e78-b197-313f-a3e8-5775d93f5501",
                                                "text": "Louise verdween tussen de rotsen en kwam na een poosje terug met een kei waarin door afzettingsgesteente een soort kruis was gekerfd."
                                            },
                                            {
                                                "example_id": "29dd84fc-dc03-476f-a78f-7a2c91c671bd",
                                                "sense_id": "31712e78-b197-313f-a3e8-5775d93f5501",
                                                "text": "Het organische materiaal werd gevonden in afzettingsgesteente van een meerbedding in de Gale-krater op Mars. Het zijn bouwstenen die wijzen op de mogelijkheid van leven op de rode planeet."
                                            }
                                        ]
                                    }
                                ]
