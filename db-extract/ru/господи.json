                                "target_senses": [
                                    {
                                        "sense_id": "16626ce4-3da5-362c-8feb-07a8c89c1b87",
                                        "entry_id": "efed8193-8e76-3f21-9ece-e34c4d242bfd",
                                        "glosses": [
                                            "A formal title of the lesser British nobility, used for a lord of the manor or Lord Proprietor."
                                        ],
                                        "tags": [],
