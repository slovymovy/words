                    {
                        "sense_id": "0a9489c5-5afa-3f93-9496-c7f02f23bab7",
                        "entry_id": "ff7ccb61-6cf3-395a-b8c2-56f6a99bdeca",
                        "glosses": [
                            "A person skilled at woodworking."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b801ff4e-4a60-4850-85f7-f1b62812987b",
                        "source_entry_id": "ff7ccb61-6cf3-395a-b8c2-56f6a99bdeca",
                        "source_sense_id": "0a9489c5-5afa-3f93-9496-c7f02f23bab7",
                        "source_sense_description": "a person skilled at woodworking",
                        "target_lang_word": "menuisier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menuisier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4367baf6-1e8f-3531-9e98-9b875a733567",
                                        "entry_id": "a1a61bd0-3866-3941-a218-26543b4b3d8b",
                                        "glosses": [
                                            "Artisan qui travaille le bois pour en faire des meubles ou des pièces utiles pour les bâtiments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddd4b7bd-db7d-4388-b5cd-874d20fd257d",
                                                "sense_id": "4367baf6-1e8f-3531-9e98-9b875a733567",
                                                "text": "À peine une salle était-elle cloisonnée que les menuisiers s’en emparaient pour y poser les boiseries et les vitrines, les tapissiers la tendaient d’étoffe, des ouvriers spéciaux la parquetaient de linoléum."
                                            },
                                            {
                                                "example_id": "2242adc5-0d39-4f12-a92a-d873d4936863",
                                                "sense_id": "4367baf6-1e8f-3531-9e98-9b875a733567",
                                                "text": "Je suis de la confrérie de Sainte-Anne, menuisier. Je porte dans les convois et dans les processions le bâton décoré du compas sur la lyre, sur lequel la grand-mère du bon Dieu apprend à lire à sa fille toute petiote, Marie pleine de grâce, pas plus haute qu’une botte."
                                            },
                                            {
                                                "example_id": "ec82f60c-a110-4e25-80cd-0a59a6d19ae3",
                                                "sense_id": "4367baf6-1e8f-3531-9e98-9b875a733567",
                                                "text": "Vous préviendrez au village qu’on sonne en première classe et vous vous occuperez du prêtre, du fossoyeur et du menuisier !"
                                            },
                                            {
                                                "example_id": "489b8c86-2b67-4ecd-aa80-e16c2c5007e8",
                                                "sense_id": "4367baf6-1e8f-3531-9e98-9b875a733567",
                                                "text": "Ces menuisiers, dit Cambronne Mâcheclair, jamais ils ne laissent ressuyer leur bois !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df7a60b3-6197-4b34-880e-be191a6f1532",
                        "source_entry_id": "ff7ccb61-6cf3-395a-b8c2-56f6a99bdeca",
                        "source_sense_id": "0a9489c5-5afa-3f93-9496-c7f02f23bab7",
                        "source_sense_description": "a person skilled at woodworking",
                        "target_lang_word": "Schreiner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreiner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                        "entry_id": "871720ec-3c34-3774-9f53-491de9aa71e4",
                                        "glosses": [
                                            "Handwerker, der aus Holz Möbel oder Fenster und Türen herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc169f6b-69d5-4deb-80fc-00793a1e1d3a",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "Den Schrank haben wir uns vom Schreiner machen lassen."
                                            },
                                            {
                                                "example_id": "fffd6693-6ee3-4d34-989b-f41dfef8477b",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "„Die beiden Schreiner lächelten und meinten, sie würden es doch hoffen.“"
                                            },
                                            {
                                                "example_id": "fb3eaf31-d610-4b05-bacf-1cc9cf429a60",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "„Später ging er zu einem Schreiner in die Lehre, allerdings brach er diese bald ab.“"
                                            },
                                            {
                                                "example_id": "40b34c4c-a3f7-4b22-856d-62c4d1339106",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "„Schreiner fertigten Holzroste für französische Betten.“"
                                            },
                                            {
                                                "example_id": "e472b7dc-db5b-4d7d-9591-697e4a9a7273",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "„Fried kam in die Lehrlingsgruppe der Schreiner, und ihn steckte man zu den Gärtnern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schreiner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7973c0c7-888b-3e6a-ad27-246674e13992",
                                        "entry_id": "b6d9e395-caa9-3ee3-a338-4e7875041769",
                                        "glosses": [
                                            "Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b596e2f4-e0bb-469e-a54c-3cebc10b9dce",
                        "source_entry_id": "ff7ccb61-6cf3-395a-b8c2-56f6a99bdeca",
                        "source_sense_id": "0a9489c5-5afa-3f93-9496-c7f02f23bab7",
                        "source_sense_description": "a person skilled at woodworking",
                        "target_lang_word": "Tischler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tischler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                        "entry_id": "4ba550b3-9709-3b52-b7b1-2406945f7826",
                                        "glosses": [
                                            "Handwerker, der aus Holz Möbel oder Fenster und Türen herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6de4f02-e209-4de7-8e0b-7789e64fe29d",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "Den Schrank haben wir uns vom Tischler machen lassen."
                                            },
                                            {
                                                "example_id": "8bd46a48-15e8-474d-9d2a-507b72973784",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "„Und der Tischler hebt seinen grauen Kopf und sieht den Wirt groß an.“"
                                            },
                                            {
                                                "example_id": "1d75b1d1-d670-40b7-a17e-e9da3db5b1b4",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "„Tatsächlich sei sie bis zum Tischler Lý Phong vorgedrungen, der in einem dritten Hinterhof nahe dem Mauerpark Möbel ausbesserte und von geradezu sprichwörtlich schlechter Laune war.“"
                                            },
                                            {
                                                "example_id": "4a61fbb2-1af4-47f8-956f-affe074d0229",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "„Sie bestellte sogleich bei einem Tischler einen vergitterten und abschließbaren Bücherschrank, der nach meiner Abreise ihre ganze Wonne sein mußte.“"
                                            },
                                            {
                                                "example_id": "4c8a2a6b-7c0d-43d8-93c8-38f8abf5489d",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "„Somit ist der Tischler Beste, der dort wohnt, ein Verräter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ff7247c-08bd-44b0-87a1-ef944f780508",
                        "source_entry_id": "ff7ccb61-6cf3-395a-b8c2-56f6a99bdeca",
                        "source_sense_id": "0a9489c5-5afa-3f93-9496-c7f02f23bab7",
                        "source_sense_description": "a person skilled at woodworking",
                        "target_lang_word": "пло́тник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пло́тник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6cce7751-3351-3850-95d6-6d77af7aa648",
                                        "entry_id": "34a90661-ac39-372a-93f5-7ac5c0d77e5f",
                                        "glosses": [
                                            "тот, кто занимается обработкой древесины, постройкой деревянных зданий, выделкой деревянных частей сооружений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "302cdbca-d457-4dd4-b0ba-d6a00f431209",
                                                "sense_id": "6cce7751-3351-3850-95d6-6d77af7aa648",
                                                "text": "— Да уж насчёт чего другого, а насчёт смётки это именно, что против русского другому не выйти. Возьмём, например, хоть простого плотника… Начинаются рассказы о плотниках, строящих самоучкой великолепные дворцы, перекидывающих по глазомеру диковинные мосты и проч."
                                            },
                                            {
                                                "example_id": "aed917b6-d838-4b8c-a43a-f9209849c6df",
                                                "sense_id": "6cce7751-3351-3850-95d6-6d77af7aa648",
                                                "text": "На лесах шумно возились плотники, — раздавался стук топоров, шипела и взвизгивала пила; кровельщики, ползая по крыше, отдирали листы железа и бросали их вниз, — железо, падая, изгибалось в воздухе и гремело, а ударяясь о землю, покрывало все звуки воющим грохотом."
                                            },
                                            {
                                                "example_id": "421bb917-ddab-4b6e-9365-65975ded7760",
                                                "sense_id": "6cce7751-3351-3850-95d6-6d77af7aa648",
                                                "text": "Починили лодки и спилили несколько крупных бамбуков, росших вблизи стана, что потребовало много времени, так как в распоряжении плотников была только одна небольшая ручная пила."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c14d6ed0-235d-4ed3-8cf6-1ab325ccc73a",
                        "source_entry_id": "ff7ccb61-6cf3-395a-b8c2-56f6a99bdeca",
                        "source_sense_id": "0a9489c5-5afa-3f93-9496-c7f02f23bab7",
                        "source_sense_description": "a person skilled at woodworking",
                        "target_lang_word": "столя́р",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "столя́р",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dc4e4789-b2f3-3783-96f2-0927aa18706f",
                                        "entry_id": "7ffc0217-55e8-3735-999b-e49baeb1bc62",
                                        "glosses": [
                                            "тот, кто занимается изготовлением и ремонтом предметов из дерева, например, деревянной мебели, окон, дверей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67ce66f8-c0e1-42ac-9872-292d46c253f1",
                                                "sense_id": "dc4e4789-b2f3-3783-96f2-0927aa18706f",
                                                "text": "У незнакомца обстановка бедная и некрасивая; кроме кресел, дивана, лампы и ковров, у него нет ничего, и комната кажется пустою; у столяра же вся квартира битком набита вещами; у него есть стол, верстак, куча стружек, рубанки, стамески, пилы, клетка с чижиком, лохань…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
