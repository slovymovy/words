                    },
                    {
                        "form_id": "c32479a0-6503-4d1b-a822-56230563e0fd",
                        "entry_id": "a42264d6-4947-38dc-b543-6e3685daba48",
                        "tags": [
                            "feminine"
                        ],
                        "form": "lieutenante-générale"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e42df820-9ae9-359a-bbc7-8776da6d5c0c",
                        "entry_id": "a42264d6-4947-38dc-b543-6e3685daba48",
                        "glosses": [
                            "Titre de dignitaire de l'Ancien Régime."
                        ],
                        "tags": [
                            "Histoire de France"
                        ],
                        "examples": [
                            {
                                "example_id": "4ec11ab3-9a68-4634-9d64-e43e9405a80f",
                                "sense_id": "e42df820-9ae9-359a-bbc7-8776da6d5c0c",
                                "text": "Elle y retrouva son mari, qui, délié de son serment de fidélité à l'empereur, avait reçu le plus flatteur accueil du comte d'Artois nommé lieutenant-général du royaume par son frère Louis XVIII."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6ede32e-db15-3f75-99ef-8a9de3b40a40",
                        "entry_id": "a42264d6-4947-38dc-b543-6e3685daba48",
                        "glosses": [
                            "Titre de général commandant un corps d’armée."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "32847e2b-a046-39fc-8d13-6ecd9a1f607b",
                        "entry_id": "a42264d6-4947-38dc-b543-6e3685daba48",
                        "glosses": [
                            "Grade d’officier au Canada et aux États-Unis."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "db5120a8-ed5d-4005-812f-1b82d6842d00",
                                "sense_id": "32847e2b-a046-39fc-8d13-6ecd9a1f607b",
                                "text": "Ancien commandant des forces américaines en Europe, le lieutenant-général à la retraite Ben Hodges estime « qu’un point de non-retour » a été franchi dans ce conflit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fec0400b-a750-4714-aac3-664c1ff2c29f",
                        "source_entry_id": "a42264d6-4947-38dc-b543-6e3685daba48",
                        "source_sense_description": "Dignitaire",
                        "target_lang_word": "наместник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "наместник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5e0540fe-0620-321c-9347-29e9cea7044a",
                                        "entry_id": "c55e96ed-424d-351c-93ee-a68377e309c6",
                                        "glosses": [
                                            "истор. на Руси IX—XIII вв. — правитель феодальной области, представляющий власть князя; посадник"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b9e478-484a-433c-a346-b6b26530a4e1",
                                                "sense_id": "5e0540fe-0620-321c-9347-29e9cea7044a",
                                                "text": "В 1010 году наместник великого князя киевского в Ростовской земле князь Ярослав ставит при впадении реки Которосли в Волгу деревянную крепостцу и первый в этих местах христианский храм."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68f69561-ec66-3987-8d5d-b6834e5a783e",
                                        "entry_id": "c55e96ed-424d-351c-93ee-a68377e309c6",
                                        "glosses": [
                                            "истор. в Российском государстве при Екатерине II — военный начальник губернии или нескольких губерний"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11b6d2bf-071b-4198-891c-68cfc60be221",
                                                "sense_id": "68f69561-ec66-3987-8d5d-b6834e5a783e",
                                                "text": "Не все державинские новшества пришлись тамбовскому обществу и его первейшим лицам по вкусу. Граф Гудович, наместник, будучи человеком военным, все балы с концертами считал баловством и зряшным прожиганием средств, воспитание тамбовских обывателей в духе просвещения ― глупостью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cf2e395-c0a2-3de2-9676-a48232036c4b",
                                        "entry_id": "c55e96ed-424d-351c-93ee-a68377e309c6",
                                        "glosses": [
                                            "истор. правитель окраинной области, обладавший правами верховной власти и управлявший от имени главы государства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f77ea38-3b64-4493-8cfe-b60e392670be",
                                                "sense_id": "0cf2e395-c0a2-3de2-9676-a48232036c4b",
                                                "text": "Правил этой провинцией римский наместник Сабанар; он впервые ввёл в колонии латынь вместо \"бытовавшего там греческого языка\"."
                                            },
                                            {
                                                "example_id": "0f7afe29-bd67-4296-9843-c42f01f1ba4a",
                                                "sense_id": "0cf2e395-c0a2-3de2-9676-a48232036c4b",
                                                "text": "Если при первых фараонах VI династии был лишь один «наместник Верхнего Египта», то при последних царях династии этих наместников уже несколько; очевидно, каждый правил небольшой провинцией, частью прежнего Верхнего Египта."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a38c31e-f264-3847-9fbf-bdf350f111d2",
                                        "entry_id": "c55e96ed-424d-351c-93ee-a68377e309c6",
                                        "glosses": [
                                            "церк. помощник настоятеля монастыря или доверенное лицо митрополита"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38c12577-6114-4070-8460-dc5d6b413a93",
                                                "sense_id": "7a38c31e-f264-3847-9fbf-bdf350f111d2",
                                                "text": "В качестве положительного примера такого сотрудничества Святейший Патриарх привел Соловецкий музей-заповедник: 19 ноября 2009 года приказом министра культуры РФ директором музея был назначен наместник Соловецкого ставропигиального монастыря архимандрит Порфирий (Шутов)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
