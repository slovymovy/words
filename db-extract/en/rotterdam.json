                                            {
                                                "example_id": "e92799a7-5428-45cd-a2e3-1043306279e8",
                                                "sense_id": "2584f341-44d4-383c-b002-ba0483603ce2",
                                                "text": "Het centrum van Rotterdam is in demografisch en stedenbouwkundig opzicht jong."
                                            },
                                            {
                                                "example_id": "b1855d4f-dae8-4197-8262-5fd462ceaa90",
                                                "sense_id": "2584f341-44d4-383c-b002-ba0483603ce2",
                                                "text": "De gemeenteraad van Rotterdam heeft in zijn vergadering van 17 september 2015 onder nummer 15bb7122 het bestemmingsplan ongewijzigd vastgesteld."
                                            },
                                            {
                                                "example_id": "3ddf03da-d3a8-418c-bb30-fae07dae6ba0",
                                                "sense_id": "2584f341-44d4-383c-b002-ba0483603ce2",
                                                "text": "Men trok de conclusie dat het Rotterdam moest zijn dat zo verzengend brandde als een fakkel."
                                            },
                                            {
                                                "example_id": "e337fcf1-988e-4850-912c-ca4710f59a8d",
                                                "sense_id": "2584f341-44d4-383c-b002-ba0483603ce2",
                                                "text": "Klapmuts memoreerde dat hij ook met een vrachtschip naar 'd'aendere kaent' was gebracht en in de Ahoy-hallen in Rotterdam was opgevangen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
