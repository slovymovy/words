                    {
                        "sense_id": "a2050969-6d24-3c6a-a23f-c6a9a601ca7c",
                        "entry_id": "4bd78a24-bfbf-33ca-a23c-3e3d6ef3c03b",
                        "glosses": [
                            "het vrij zijn, het zonder dwang kunnen doen wat men wil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c21d9455-5eec-483c-b9bb-8a5540f5ed66",
                                "sense_id": "a2050969-6d24-3c6a-a23f-c6a9a601ca7c",
                                "text": "Hé, Rostov! Welkom, welkom! riep hij met dezelfde stem als voorheen in het regiment; maar Rostov merkte tot zijn droefheid dat achter die gewone ongedwongenheid en monterheid een nieuw, onaangenaam, verborgen gevoel uit de gelaatsuitdrukking, de intonatie en de woorden van Denisov sprak."
                            },
                            {
                                "example_id": "1a6ab977-99ca-4c7a-b21e-e4f9eeac44fe",
                                "sense_id": "a2050969-6d24-3c6a-a23f-c6a9a601ca7c",
                                "text": "Dest, zoon van een Amerikaanse vader en een Nederlandse moeder, stapte in 2012 over van de jeugd van Almere City naar Ajax. Hij doorliep de jeugdelftallen van Ajax met dezelfde ongedwongenheid die hij nu ook tentoonspreidt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
