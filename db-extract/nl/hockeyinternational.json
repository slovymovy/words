                        "examples": [
                            {
                                "example_id": "7eae864c-0114-44bb-9a4f-d475e6795f2d",
                                "sense_id": "2caa1b36-4dfe-3ca6-8218-817da07ba6ed",
                                "text": "Caldas heeft 193-voudig hockeyinternational Baart niet nodig in Tokio: Hockeybondscoach Max Caldas heeft uit de vaste groep waarmee hij traint richting de EK en de Olympische Spelen, vier spelers laten vallen. De bekendste naam is die van Sander Baart, goed voor 193 interlands. \"Nu is het moment daar om gerichter te werken richting Tokio\", aldus Caldas die ook heeft gekozen voor Pirmin Blaak als eerste keeper."
                            },
                            {
                                "example_id": "8bd277be-5a83-4dc1-82e2-8d5bfc4825dd",
                                "sense_id": "2caa1b36-4dfe-3ca6-8218-817da07ba6ed",
                                "text": "Pierie, die werd geboren in Boston en zoon is van voormalig hockeyinternational Jean-Pierre Pierie, debuteerde in 2017 op 16-jarige leeftijd in het eerste elftal van sc Heerenveen. Daar speelde hij twee volledige seizoenen, om in 2019 naar Ajax te vertrekken."
                            },
                            {
                                "example_id": "5d08c21b-eb00-440d-abab-d6b6ecd706ec",
                                "sense_id": "2caa1b36-4dfe-3ca6-8218-817da07ba6ed",
                                "text": "Voormalig hockeyinternational Fleur van Dooren is op 35-jarige leeftijd overleden. Dat meldt Hockey Club Rotterdam, waar ze lange tijd speelde."
                            }
                        ]
                    }
