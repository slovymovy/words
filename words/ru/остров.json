                            },
                            {
                                "target_lang_word": "thicket",
                                "target_lang_sense_clarification": "dense growth of bushes or trees"
                            },
                            {
                                "target_lang_word": "grove",
                                "target_lang_sense_clarification": "small isolated group of trees"
                            }
                        ]
                    }
                }
            ]
        },
