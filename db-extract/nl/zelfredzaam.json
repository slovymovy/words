                ],
                "senses": [
                    {
                        "sense_id": "5d62dbb5-69c6-3612-b9cf-7c67efd9fb70",
                        "entry_id": "93e4c883-ca71-38d7-b1a1-c1ee5fb9c8f6",
                        "glosses": [
                            "van een persoon dat hij of zij in staat is zichzelf te verzorgen zonder hulp van buiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5d2a9e6-0a01-4aa2-9d5d-f94fdde0b40c",
                                "sense_id": "5d62dbb5-69c6-3612-b9cf-7c67efd9fb70",
                                "text": "Inwoners van het aardbevingsgebied in Groningen gaan dit najaar samen met hulpdiensten drie dagen lang een zware aardschok simuleren. De levensechte oefening moet onder meer duidelijk maken hoe zelfredzaam inwoners zijn. Dat meldt het Dagblad van het Noorden."
                            },
                            {
                                "example_id": "e9c16cb1-8e3e-4f9f-a98d-5268a71bb2a2",
                                "sense_id": "5d62dbb5-69c6-3612-b9cf-7c67efd9fb70",
                                "text": "Den Haag regelt snel woonruimte en financiële hulp voor mensen die dakloos zijn geraakt door geldproblemen, maar die wel zelfredzaam zijn en geen verslavings- of psychiatrische problemen hebben."
                            },
                            {
                                "example_id": "9889805e-776b-40bc-9ae7-00a8874b1be2",
                                "sense_id": "5d62dbb5-69c6-3612-b9cf-7c67efd9fb70",
                                "text": "De problemen gelden des te meer voor ‘mensen die door omstandigheden minder zelfredzaam zijn’. ,,Van hen kan niet altijd worden verwacht dat zij alle digitale kanalen van overheidsorganen in de gaten houden en de weg kunnen vinden in de digitale uitvoering van regels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17086bd3-360d-4f81-b38f-3cdc61a741b7",
                        "source_entry_id": "93e4c883-ca71-38d7-b1a1-c1ee5fb9c8f6",
                        "source_sense_id": "5d62dbb5-69c6-3612-b9cf-7c67efd9fb70",
                        "target_lang_word": "eigenständig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eigenständig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ea361b9-b414-3a05-99d7-a80c4fff4945",
                                        "entry_id": "f8133a31-7dff-30f2-9780-e63699f1299e",
                                        "glosses": [
                                            "„mit eigenem Stand“, in selbstständiger, unabhängiger Position"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df881d47-8a3a-4750-bf59-453a2b4528c1",
                                                "sense_id": "1ea361b9-b414-3a05-99d7-a80c4fff4945",
                                                "text": "Von einem eigenständigen Kosovo konnte man erst ab 2008 sprechen."
                                            },
                                            {
                                                "example_id": "b34d82b3-01ee-4623-9b9b-a7d681375a9e",
                                                "sense_id": "1ea361b9-b414-3a05-99d7-a80c4fff4945",
                                                "text": "„Von den der Wiener Gruppe nahestehenden Anfängen über experimentelle Spracharbeiten bis zu den auf beispiellose Weise Leben und Sprache verbindenden späteren Texten kann hier über mehr als fünf Jahrzehnte, von 1949 bis 2001, die Entwicklung einer der eigenständigsten literarischen Stimmen der deutschsprachigen Gegenwartsliteratur nachvollzogen werden.“"
                                            },
                                            {
                                                "example_id": "867e702b-8f96-4bb2-9629-ca7620771836",
                                                "sense_id": "1ea361b9-b414-3a05-99d7-a80c4fff4945",
                                                "text": "„Das war ein erster Schritt in Sachen eigenständigerer Strukturen und besserer Professionalisierung.“"
                                            },
                                            {
                                                "example_id": "5a193d5d-8ad6-4df3-a64e-052b02134436",
                                                "sense_id": "1ea361b9-b414-3a05-99d7-a80c4fff4945",
                                                "text": "„Mieczyslaw Weinberg (1919-1996) gilt als der eigenständigste und bedeutendste aller Schostakowitsch-Nachfolger.“"
                                            },
                                            {
                                                "example_id": "ca4d1f87-1ba4-448b-b27b-ac7fba50c44a",
                                                "sense_id": "1ea361b9-b414-3a05-99d7-a80c4fff4945",
                                                "text": "„Die DVU Brandenburg gilt als erfolgreichster und eigenständigster DVULandesverband, die Partei hat sogar Sitze in einigen Kommunalparlamenten.“"
                                            },
                                            {
                                                "example_id": "a98cc702-97ba-435d-90f2-957eaf7b64f9",
                                                "sense_id": "1ea361b9-b414-3a05-99d7-a80c4fff4945",
                                                "text": "„\"Der Führerschein ist oft der Flaschenhals auf dem Weg zu mehr Mobilität und damit zu einem eigenständigeren Leben\", ist Caritas-Direktor Mathias Mühlberger überzeugt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c53296d6-eac1-4c1b-8f97-c42ec76245b3",
                        "source_entry_id": "93e4c883-ca71-38d7-b1a1-c1ee5fb9c8f6",
                        "source_sense_id": "5d62dbb5-69c6-3612-b9cf-7c67efd9fb70",
