                        "glosses": [
                            "soort levensverzekering waarbij men een bepaalde hoeveelheid geld betaalt om later een periodieke uitkering te krijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d389ef6e-afef-4f55-a4ad-d7ef45c50de8",
                                "sense_id": "1bcd0467-584a-388d-8917-384e7668999e",
                                "text": "Koopsompolis: Levensverzekering waarvan de premie geheel of gedeeltelijk aftrekbaar is voor de inkomstenbelasting. Het bedrag van de lijfrente wordt na een vooraf afgesproken termijn uitbetaald (vaak als aanvulling op of vervanging van pensioen)."
                            },
                            {
                                "example_id": "599baf6e-320a-4935-be8f-9313252d17f3",
                                "sense_id": "1bcd0467-584a-388d-8917-384e7668999e",
                                "text": "De partijen hebben een akkoord bereikt over een regeling voor de gedupeerden. Zo waren klanten van de DSB Bank bij een koopsompolis vaak een groot deel van de premie kwijt aan kosten. Als die hoger zijn dan veertig procent, worden ze vergoed, met vier procent rente."
                            }
                        ]
