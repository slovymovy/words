                    "sense_id": "2bfec51f-fc11-318f-82f5-7f74d4a69dca",
                    "sense_definition": "Roerbakken in een komvormige metalen pan",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "koken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat smaakt er beter: <w>wokken</w> op gas, of op inductie?",
                            "target_lang_translations": {
                                "en": "What tastes better: <w>stir-frying</w> on gas, or on induction?"
                            }
                        },
                        {
                            "text": "Het lijkt zo gezond om lekker groenten te <w>wokken</w>, maar ook dat is dus gevaarlijk.",
                            "target_lang_translations": {
                                "en": "It seems so healthy to <w>stir-fry</w> vegetables, but that too can be dangerous."
                            }
                        }
                    ],
                    "common_phrases": [
                        "groenten wokken"
                    ],
                    "target_lang_definitions": {
                        "en": "To stir-fry food in a bowl-shaped metal pan."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to stir-fry",
                                "target_lang_sense_clarification": "cooking food quickly in a hot pan while stirring"
                            }
                        ]
                    }
                }
            ]
        },
        {
