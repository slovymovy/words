                "senses": [
                    {
                        "sense_id": "d32a106c-c5f5-3a21-997d-c54db7cd7401",
                        "entry_id": "95fc32ff-7cac-3e8b-a9f0-b62558511d4d",
                        "glosses": [
                            "Gitterpunkt in einem dreidimensionalen Gitter"
                        ],
                        "tags": [
                            "Computergrafik"
                        ],
                        "examples": [
                            {
                                "example_id": "bd80a13d-4798-422c-8492-edae4ddabe34",
                                "sense_id": "d32a106c-c5f5-3a21-997d-c54db7cd7401",
                                "text": "„Zusätzlich zu den Werten eines Pixel enthält das Voxel noch eine Z-Koordinate für die Tiefenlage im Raum und häufig auch einen Wert für die Durchsichtigkeit des Punktes, die Opazität (Opacity Value).“"
                            },
                            {
                                "example_id": "990e6032-b3cc-41d6-9045-ad39e4a6ceea",
                                "sense_id": "d32a106c-c5f5-3a21-997d-c54db7cd7401",
                                "text": "„Hardware-Erweiterungen, welche die schnelle 2D-Projektion eines semitransparenten Voxel-Würfels unterstützen, sind am Markt erhältlich.“"
                            },
                            {
                                "example_id": "89ae9865-8917-4372-a891-23a8e9987d94",
                                "sense_id": "d32a106c-c5f5-3a21-997d-c54db7cd7401",
                                "text": "„Für die Darstellung dieser Voxel gibt es spezialisierte Algorithmen.“"
                            },
                            {
                                "example_id": "de451f2d-31e1-42f5-ac60-5d44ef4c6615",
                                "sense_id": "d32a106c-c5f5-3a21-997d-c54db7cd7401",
                                "text": "„Bei der Untersuchung, wie leistungsfähig ihr System ist, nahm die Gruppe um Wetzstein über eine Milliarde Voxel (dreidimensionale Pixel) auf.“"
                            },
                            {
                                "example_id": "c2350ce2-1008-4c5c-9f34-e430dffd50e4",
                                "sense_id": "d32a106c-c5f5-3a21-997d-c54db7cd7401",
                                "text": "„Exakt angesteuert, wird jeder einzelne Tropfen zu einem Voxel, zu einem Bildpunkt in der 3-D-Darstellung, analog dem Pixel auf einem herkömmlichen Foto.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
