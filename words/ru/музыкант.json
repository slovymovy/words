                },
                {
                    "sense_id": "b0914bf5-bd17-3a5b-8aa6-89bda3eac7bf",
                    "sense_definition": "Животное (обычно птица или насекомое), издающее мелодичные звуки.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весной в лесу каждый пернатый <музыкант> старательно выводит свою трель.",
                            "target_lang_translations": {
                                "en": "In the spring, every feathered <w>musician</w> in the forest diligently sings its trill.",
                                "fr": "Au printemps dans la forêt, chaque <w>musicien</w> à plumes s'applique à moduler son trille."
                            }
                        },
                        {
                            "text": "В высокой траве стрекотал маленький зелёный <музыкант>, радуясь тёплому вечеру.",
                            "target_lang_translations": {
                                "en": "A little green <w>musician</w> chirped in the tall grass, rejoicing in the warm evening.",
                                "fr": "Dans les hautes herbes, un petit <w>musicien</w> vert stridulait, se réjouissant de la douce soirée."
                            }
                        }
                    ],
                    "common_phrases": [
