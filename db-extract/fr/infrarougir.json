                "senses": [
                    {
                        "sense_id": "a7184e9c-39e7-331f-b508-51e71a661551",
                        "entry_id": "cfe112a8-40b2-33b5-a325-08519b80431d",
                        "glosses": [
                            "Soumettre à un rayonnement infrarouge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "535d080a-e23e-4bcf-98a7-b9d174ea4137",
                                "sense_id": "a7184e9c-39e7-331f-b508-51e71a661551",
                                "text": "Un escalier menait à un couloir obscur, seulement infrarougi, percé de multiples portes."
                            },
                            {
                                "example_id": "809ca305-9287-4aca-924b-a49f8fedb06c",
                                "sense_id": "a7184e9c-39e7-331f-b508-51e71a661551",
                                "text": "En quelque 0,005 seconde, le cylindre de brouillard gagne le véhicule de direction, l’englobe, infrarougit puis implose en un éclair introverti qui fait WHASP."
                            },
                            {
                                "example_id": "74332732-f051-457d-8c58-b6cb11f8623d",
                                "sense_id": "a7184e9c-39e7-331f-b508-51e71a661551",
                                "text": "Sortez vos mouchoirs, planquez vos claviers sensibles, les molettes de vos périphériques risquent bien d'infrarougir !!!"
                            },
                            {
                                "example_id": "86bcef44-4cd7-478c-8cf5-f5755ab184cf",
                                "sense_id": "a7184e9c-39e7-331f-b508-51e71a661551",
                                "text": "Les deux ont bien validé les résultats précédents (c'est plus « fastoche » avec la caméra, mais le thermomètre n'a pas à (infra)rougir, il suffit de bien viser"
                            }
                        ]
                    }
