                                        "sense_id": "47da8542-fd0e-34ac-b563-c913654db3dd",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "In an absolute or unconditional manner; utterly, positively, wholly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f717f83-1c78-3e4f-983d-60d67b8bc133",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "Independently; viewed without relation to other things or factors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c81a4da-f091-4ce0-a15a-9077506450cf",
                                                "sense_id": "2f717f83-1c78-3e4f-983d-60d67b8bc133",
                                                "text": "Another characteristic of numbers, which does not concern their mutual relations so much as themselves absolutely, is their ability, according to the ideas of Nicomachus, to conform to geometrical arrangements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "As an intensive: extremely, very, indeed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ebdec5-29be-4c20-868f-3073a912b06b",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "But when it came to posing for publicity pictures they proved absolutely brilliant doing just what came naturally."
                                            },
                                            {
                                                "example_id": "c38bfa8f-c587-4bcb-acca-4ede84befecf",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "The strength of the mouse is absolutely spectacular for various kinds of issues, until you find out that the mouse has absolutely no extracellular matrix to speak of in his optic nerve head."
                                            },
                                            {
                                                "example_id": "a29e99e0-44ab-4143-98bb-d8995ba39d0f",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "The most absolutely terrifying creature lifted her head."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absolutely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                        "entry_id": "dafa4a83-cdd1-3e27-bd0c-eb0b7ac7b9bc",
                                        "glosses": [
                                            "Yes, certainly; expression indicating strong agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ac9752-fa44-4cd8-b952-dca657402b56",
                                                "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                                "text": "Is Bob a good teacher?\nAbsolutely!"
                                            },
                                            {
                                                "example_id": "cd181f96-9d79-4997-b6f4-98a9933b0ae2",
                                                "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                                "text": "Do you want a free cookie with that coffee?\nAbsolutely!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "557e8ea5-874c-498f-b6e6-505884362a44",
                        "source_entry_id": "61f2214e-1cc7-3559-b30a-862b649e06f6",
                        "source_sense_id": "3ea482da-aa1f-3534-9bca-ef9193d78a5b",
                        "target_lang_word": "actually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a29d532-2ee3-34e8-9de1-6ba276511a06",
                                        "entry_id": "f130419b-ed55-31b0-9cf4-dc72620d6f85",
                                        "glosses": [
                                            "In act or in fact; really; in truth; positively."
                                        ],
                                        "tags": [
                                            "modal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "079859c2-29f5-4ab9-b8c0-937b0185592b",
                                                "sense_id": "7a29d532-2ee3-34e8-9de1-6ba276511a06",
                                                "text": "His promises did not correspond with what he actually did."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0806d5e5-340e-32a9-a6b6-b4ed78021614",
                                        "entry_id": "f130419b-ed55-31b0-9cf4-dc72620d6f85",
                                        "glosses": [
                                            "Actively."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7579c15-0563-459f-8b14-a6f606fa8934",
                                                "sense_id": "0806d5e5-340e-32a9-a6b6-b4ed78021614",
                                                "text": "Neither actually […] nor passively."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc455ce9-8c5c-376a-aaa0-c2feb3a7e814",
                                        "entry_id": "f130419b-ed55-31b0-9cf4-dc72620d6f85",
                                        "glosses": [
                                            "Currently; at the time."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3bac1d8-98eb-4a01-8f58-5d8ec737c064",
                                                "sense_id": "fc455ce9-8c5c-376a-aaa0-c2feb3a7e814",
                                                "text": "At the time whereof we are writing, though the Great George was on the throne and ladies wore gigots and large combs like tortoise-shell shovels in their hair, instead of the simple sleeves and lovely wreaths which are actually in fashion, the manners of the very polite world were not, I take it, essentially different from those of the present day: and their amusements pretty similar."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "actually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f77cf2fb-8483-3d5b-a3fe-93fac5a942ea",
                                        "entry_id": "5f136a10-9d38-3750-922a-332e2d485480",
                                        "glosses": [
                                            "Indicating affirmation, agreement."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52c5fbbf-9e08-4c24-aef5-cb5689b3160e",
                                                "sense_id": "f77cf2fb-8483-3d5b-a3fe-93fac5a942ea",
                                                "text": "A: That was a pretty good movie."
                                            },
                                            {
                                                "example_id": "b3b3fee7-5508-4237-bbf8-e413a2b7f8c0",
                                                "sense_id": "f77cf2fb-8483-3d5b-a3fe-93fac5a942ea",
                                                "text": "B: Actually!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22d2fa05-081d-401f-8c12-5f37e75f290b",
                        "source_entry_id": "61f2214e-1cc7-3559-b30a-862b649e06f6",
                        "source_sense_id": "3ea482da-aa1f-3534-9bca-ef9193d78a5b",
                        "target_lang_word": "as a matter of fact",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "as a matter of fact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0651e4d-bf89-3783-8136-5aa32cf5272b",
                                        "entry_id": "eafc07fe-24a3-35df-ac7e-dfe8f142bd68",
                                        "glosses": [
                                            "Actually, in fact."
                                        ],
                                        "tags": [
                                            "adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b07ddf8a-4644-4d9f-88da-c303583f10bb",
                                                "sense_id": "a0651e4d-bf89-3783-8136-5aa32cf5272b",
                                                "text": "The house of Ruthven was a small but ultra-modern limestone affair, between Madison and Fifth; a pocket-edition of the larger mansions of their friends, but with less excuse for the overelaboration since the dimensions were only twenty by a hundred. As a matter of fact its narrow ornate façade presented not a single quiet space the eyes might rest on[…].\""
                                            },
                                            {
                                                "example_id": "32f35351-2e70-494d-bf87-e36afc81abab",
                                                "sense_id": "a0651e4d-bf89-3783-8136-5aa32cf5272b",
                                                "text": "Greedo: Going somewhere, Solo? / Han Solo: Yes, Greedo. As a matter of fact, I was just going to see your boss. Tell Jabba that I've got his money."
                                            },
                                            {
                                                "example_id": "c9b4ebc0-8365-4ded-99a2-7ec5763e57a4",
                                                "sense_id": "a0651e4d-bf89-3783-8136-5aa32cf5272b",
                                                "text": "R. Jeeves: An interesting theory, sir. Would you care to expatiate upon it?\nB.W. Wooster: As a matter of fact, no, Jeeves. The thought just occurred to me, as thoughts do.\nR. Jeeves: Very good, sir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7316b29-cdc9-444c-90ce-eb6a46e92f95",
                        "source_entry_id": "61f2214e-1cc7-3559-b30a-862b649e06f6",
                        "source_sense_id": "3ea482da-aa1f-3534-9bca-ef9193d78a5b",
                        "target_lang_word": "in fact",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in fact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1cb2683-bf83-301e-8ac0-883834c54e71",
                                        "entry_id": "5807e3c3-cd8e-3e6c-af30-1bc7f32c81dc",
                                        "glosses": [
                                            "Resulting from the actions of parties."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b22d11a-487d-38b9-bedb-a6935a49dca5",
                                        "entry_id": "5807e3c3-cd8e-3e6c-af30-1bc7f32c81dc",
                                        "glosses": [
                                            "Actually; in truth; de facto."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "551b7793-bbdf-4384-9624-7dbad635730a",
                                                "sense_id": "4b22d11a-487d-38b9-bedb-a6935a49dca5",
                                                "text": "People think he's rich, but in fact he's nearly penniless."
                                            },
                                            {
                                                "example_id": "7a406dc3-16fb-486b-ba2e-7ab88ff37c69",
                                                "sense_id": "4b22d11a-487d-38b9-bedb-a6935a49dca5",
                                                "text": "Now all this was very fine, but not at all in keeping with the Celebrity's character as I had come to conceive it. The idea that adulation ever cloyed on him was ludicrous in itself. In fact I thought the whole story fishy, and came very near to saying so."
                                            },
                                            {
                                                "example_id": "ddb6178d-cefc-47c6-924e-46e09712fab8",
                                                "sense_id": "4b22d11a-487d-38b9-bedb-a6935a49dca5",
                                                "text": "A great bargain also had been the excellent Axminster carpet which covered the floor; as, again, the arm-chair in which Bunting now sat forward, staring into the dull, small fire. In fact, that arm-chair had been an extravagance of Mrs. Bunting. She had wanted her husband to be comfortable after the day's work was done, and she had paid thirty-seven shillings for the chair."
                                            },
                                            {
                                                "example_id": "c9780516-948f-4b3b-ac71-21e7563e1709",
                                                "sense_id": "4b22d11a-487d-38b9-bedb-a6935a49dca5",
                                                "text": "Menggetimur (d. 1433),¹⁸ chief of the Odoli subtribe of the Chien-chou Jurchen, had in fact moved into Korea south of the Tumen River. Because he offered tribute to the Choson court and had encamped at Hoeryŏng (Chinese: Hui-ning), the Koreans regarded him as their vassal."
                                            },
                                            {
                                                "example_id": "4cc1a4b6-91af-4322-89e6-2be02eb9c937",
                                                "sense_id": "4b22d11a-487d-38b9-bedb-a6935a49dca5",
                                                "text": "We tend to think of the seafloor a few kilometres down as a flat plain. In fact, about two-thirds of this “abyssal” seabed is made up of gentle rolling hills a few hundred metres high, says Jennifer Durden at the University of Southampton, UK."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d507d01-6d26-3e5f-bd71-730cbd347b66",
                                        "entry_id": "5807e3c3-cd8e-3e6c-af30-1bc7f32c81dc",
                                        "glosses": [
                                            "Moreover."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ab41f01-5c68-49d7-b216-d692d580b896",
                                                "sense_id": "6d507d01-6d26-3e5f-bd71-730cbd347b66",
                                                "text": "I don't have the time or patience to deal with him. In fact, I barely even have time for being here at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b45bef4-6832-419b-8d66-bf69feb17a8e",
                        "source_entry_id": "61f2214e-1cc7-3559-b30a-862b649e06f6",
                        "source_sense_id": "3ea482da-aa1f-3534-9bca-ef9193d78a5b",
                        "target_lang_word": "indeed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indeed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                        "entry_id": "115c0151-a17f-3daf-aa49-0ceb97a011e2",
                                        "glosses": [
                                            "Truly; in fact; actually."
                                        ],
                                        "tags": [
                                            "modal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b51349c-b18f-475a-b9f6-3869f6380653",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "Indeed, he made several misplays."
                                            },
                                            {
                                                "example_id": "2f615a69-60c7-4444-9c49-40f8db0e4351",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "Yes, I do indeed look very similar to you."
                                            },
                                            {
                                                "example_id": "59531854-098f-48c6-a23d-233bf359ca6e",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out. Indeed, a nail filed sharp is not of much avail as an arrowhead; you must have it barbed, and that was a little beyond our skill."
                                            },
                                            {
                                                "example_id": "135cbdc5-caf4-4033-b5ec-f3805616fce5",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "I was about to say that I had known the Celebrity from the time that he wore kilts. But I see that I will have to amend that, because he was not a celebrity then, nor, indeed, did he achieve fame until some time after I left New York for the West."
                                            },
                                            {
                                                "example_id": "ec7a1929-81db-4b0c-a09a-3c91b8677120",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "She was like a Beardsley Salome, he had said. And indeed, she had the narrow eyes and the high cheekbone of that creature, and as nearly the sinuosity as is compatible with human symmetry. His wooing had been brief but incisive."
                                            },
                                            {
                                                "example_id": "fec50aa1-be54-4e1b-aa65-4fed9eff1eac",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "With fresh material, taxonomic conclusions are leavened by recognition that the material examined reflects the site it occupied; a herbarium packet gives one only a small fraction of the data desirable for sound conclusions. Herbarium material does not, indeed, allow one to extrapolate safely: what you see is what you get[…]"
                                            },
                                            {
                                                "example_id": "93310381-d101-475e-90b5-d7dbf3f89a16",
                                                "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across. Such pits are about the size of a bacterial cell. Closer examination showed that some of these pits did, indeed, contain bacteria,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f973fb4-f65f-31fa-b024-4cc7c524e485",
                                        "entry_id": "115c0151-a17f-3daf-aa49-0ceb97a011e2",
                                        "glosses": [
                                            "In fact."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d71e53b3-b22a-4583-a2a4-741466272d74",
                                                "sense_id": "4f973fb4-f65f-31fa-b024-4cc7c524e485",
                                                "text": "As a soccer player, he is terrible indeed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "indeed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "479f14bb-622a-392c-8a82-0c0639178f56",
                                        "entry_id": "a4749f99-36fc-3df5-89c8-73152bf90687",
                                        "glosses": [
                                            "Indicates emphatic agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51b6c4ed-7d19-4075-b6c6-ab200e6f3888",
                                                "sense_id": "479f14bb-622a-392c-8a82-0c0639178f56",
                                                "text": "\"I am a great runner.\" \"Indeed!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aed6a074-78e3-3562-8646-ff89bd407534",
                                        "entry_id": "a4749f99-36fc-3df5-89c8-73152bf90687",
                                        "glosses": [
                                            "With interrogative intonation (low–high), indicates serious doubt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "715940ee-9195-4321-856e-6e72ab97f13b",
                                                "sense_id": "aed6a074-78e3-3562-8646-ff89bd407534",
                                                "text": "\"I am a great runner.\" \"Indeed?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
