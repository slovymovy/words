                "senses": [
                    {
                        "sense_id": "28f39fc5-7c17-33d4-bda5-47927fcd2f83",
                        "entry_id": "a8d8eee3-03de-3486-8083-19f00e8929b9",
                        "glosses": [
                            "iemand die in of op iets woont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56f4290e-a8c5-4743-9242-a80566db800f",
                                "sense_id": "28f39fc5-7c17-33d4-bda5-47927fcd2f83",
                                "text": "Ik ben die snoeverij over Amsterdam-Zuid en de bewoners ervan zat."
                            },
                            {
                                "example_id": "98af2902-df06-48e4-8528-e93e07fe0b26",
                                "sense_id": "28f39fc5-7c17-33d4-bda5-47927fcd2f83",
                                "text": "Verderop raakte minstens één bewoner gewond van een woning die Zeeuwland verhuurt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75e862fa-64b3-4dcc-9223-eafc52d60c9d",
                        "source_entry_id": "a8d8eee3-03de-3486-8083-19f00e8929b9",
                        "source_sense_id": "28f39fc5-7c17-33d4-bda5-47927fcd2f83",
                        "source_sense_description": "iemand die in of op iets woont",
                        "target_lang_word": "Einwohner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einwohner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "032ee790-8fac-342a-be30-c4d585ff6a82",
                                        "entry_id": "ab21eff6-aaf9-3da1-9005-fdc943e33e33",
                                        "glosses": [
                                            "eine Person, die fest eine bestimmte, abgegrenzte Verwaltungseinheit bewohnt, ein zählbares Element von Bevölkerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53c12e44-2b15-4333-9d32-89942d8e558c",
                                                "sense_id": "032ee790-8fac-342a-be30-c4d585ff6a82",
                                                "text": "Die Stadt Soundso hat 50.000 Einwohner."
                                            },
                                            {
                                                "example_id": "8ff6e928-8b33-41f0-805d-beedcefaf3dd",
                                                "sense_id": "032ee790-8fac-342a-be30-c4d585ff6a82",
                                                "text": "Die Menge aller Einwohner einer Wohneinheit (Dorf, Stadt, Gemeinde, Kreis, Bezirk, Kanton, Bundesland, Land, Erdteil, Welt) nennt man Bevölkerung."
                                            },
                                            {
                                                "example_id": "ce0e18b9-ddd9-40cd-9537-7e3ccdbfc0ee",
                                                "sense_id": "032ee790-8fac-342a-be30-c4d585ff6a82",
                                                "text": "„Rund 250000 Einwohner und Flüchtlinge kauerten hinter den Mauern, in den Lagern lagen Schwerverwundete.“"
                                            },
                                            {
                                                "example_id": "e17606de-daa0-426f-ad01-1e529477b70d",
                                                "sense_id": "032ee790-8fac-342a-be30-c4d585ff6a82",
                                                "text": "„Das kleine Städtchen Ilulissat liegt 250 Kilometer nördlich des Polarkreises, hat fünftausend Einwohner und ebenso viele Schlittenhunde, einhundert angemeldete Autos, aber keine Ampel.“"
                                            },
                                            {
                                                "example_id": "0e0e18e0-65d4-4b85-8c67-9f5a8e7e781a",
                                                "sense_id": "032ee790-8fac-342a-be30-c4d585ff6a82",
                                                "text": "„Das Kurfürstentum Sachsen hatte in Seumes Geburtsjahr rund 1 635 000 Einwohner, 50000 weniger als vor dem Siebenjährigen Krieg.“"
                                            },
                                            {
                                                "example_id": "1d45e0c2-0aa9-4a25-8abf-1e8566e022ce",
                                                "sense_id": "032ee790-8fac-342a-be30-c4d585ff6a82",
                                                "text": "„Für Europa schätzt man um 1600 rund 100 Millionen Einwohner, für Amerika vor den Reisen des Columbus etwa 10 Millionen Einwohner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8903061-7c97-4d00-a921-3f108e179264",
                        "source_entry_id": "a8d8eee3-03de-3486-8083-19f00e8929b9",
                        "source_sense_id": "28f39fc5-7c17-33d4-bda5-47927fcd2f83",
                        "source_sense_description": "iemand die in of op iets woont",
                        "target_lang_word": "Bewohner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bewohner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee715dee-a95e-3298-a582-0a66d5c8903e",
                                        "entry_id": "25ef592e-900c-338a-9f1f-3051f025c59a",
                                        "glosses": [
                                            "jemand, der in einem Gebäude, einem Haus, einem Gebiet, einer Wohnung, auf einer Insel wohnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9259aea2-c301-46be-9251-8171f85fcc9d",
                                                "sense_id": "ee715dee-a95e-3298-a582-0a66d5c8903e",
                                                "text": "Der Bewohner kann wegen des Lärmes nicht schlafen."
                                            },
                                            {
                                                "example_id": "85290dfc-216b-4ad4-8db5-83b195ec1d24",
                                                "sense_id": "ee715dee-a95e-3298-a582-0a66d5c8903e",
                                                "text": "„Was archaisierend als »Stammesspott« bezeichnet wird, Frotzeleien und Sottisen zwischen den Bewohnern verschiedener deutscher Länder und Landschaften, ist ein wichtiger Bestandteil des Witzerepertoires.“"
                                            },
                                            {
                                                "example_id": "3d50fcc1-52fd-4a79-a8e7-a41b09c15711",
                                                "sense_id": "ee715dee-a95e-3298-a582-0a66d5c8903e",
                                                "text": "„Anfangs gründeten sie nur viele kleine Siedlungen, deren Bewohner Rinder züchteten und Gerste anbauten.“"
                                            },
                                            {
                                                "example_id": "4a4b2c83-aed7-47c8-8aee-d28f818f0ed7",
                                                "sense_id": "ee715dee-a95e-3298-a582-0a66d5c8903e",
                                                "text": "„Und daneben, in einem Futteral, ihr wichtigstes Instrument: eine Klappwaage aus Bronze, wie sie die Araber und viele Bewohner in Haithabu verwenden, kaum größer als eine Handfläche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "808f44d3-34d1-424a-aa48-a17304c1f3be",
                        "source_entry_id": "a8d8eee3-03de-3486-8083-19f00e8929b9",
                        "source_sense_id": "28f39fc5-7c17-33d4-bda5-47927fcd2f83",
                        "source_sense_description": "iemand die in of op iets woont",
                        "target_lang_word": "inhabitant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhabitant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                                        "entry_id": "efe7aef3-5c28-34c1-aafa-c9138b42a8c3",
                                        "glosses": [
                                            "Someone or thing who lives in a place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49cdd6e6-5ae0-461b-bd6f-291622f983b2",
                                                "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                                                "text": "I believed it in the same way one of you might believe there are inhabitants in the planet Mars. I knew once a Scotch sailmaker who was certain, dead sure, there were people in Mars."
                                            },
                                            {
                                                "example_id": "40efea68-9e75-47f0-8bdb-dd54294a74e3",
                                                "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                                                "text": "It was obvious to the inhabitants of the small coastal town of Bridport that in the midst of these squabbles their need for a railway was going to be overlooked, and they decided to take the matter into their own hands."
                                            },
                                            {
                                                "example_id": "aec6b4bb-8b01-4f91-8f55-a6f272ecb234",
                                                "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                                                "text": "About 98 per cent of Taiwan's inhabitants are Han Chinese, a diverse mix of ethnic and linguistic groups, including Hakka, Cantonese and Fujianese, who came from China's southern coast. Taiwan's other two per cent are from one of the nine indigenous tribes, which are scattered throughout the island but largely concentrated along the east coast and in the Central Mountain Range."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c6085fa-edd5-35db-9008-5b7c7d07af97",
                                        "entry_id": "efe7aef3-5c28-34c1-aafa-c9138b42a8c3",
                                        "glosses": [
                                            "A possible value for a type."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c070f3b0-f6cd-4e56-b2b0-a4774281d711",
                                                "sense_id": "1c6085fa-edd5-35db-9008-5b7c7d07af97",
                                                "text": "One way to observe this connection with mathematics is by mapping each type to its cardinality, a count of the inhabitants of that type."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inhabitant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "275a7689-faf7-3788-b72f-3e22b71c2026",
                                        "entry_id": "1faf802d-3de8-3826-8689-6fc852e298e3",
                                        "glosses": [
                                            "resident"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5348229a-51ab-4933-a7af-d0ef0ae3f535",
                        "source_entry_id": "a8d8eee3-03de-3486-8083-19f00e8929b9",
                        "source_sense_id": "28f39fc5-7c17-33d4-bda5-47927fcd2f83",
                        "source_sense_description": "iemand die in of op iets woont",
                        "target_lang_word": "habitant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habitant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f884947d-0acb-30ec-91ec-f2c857dc4c72",
                                        "entry_id": "02999687-076e-3323-9e33-7b388d4ae455",
                                        "glosses": [
                                            "Celui qui habite dans un lieu donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b47a1d6-5a10-42b8-b30a-a0ee5fcb4c38",
                                                "sense_id": "f884947d-0acb-30ec-91ec-f2c857dc4c72",
                                                "text": "En un village de trois cents habitants, où il y avait autrefois cinq cabarets, il y en a quinze maintenant, et tous font leurs affaires. Plus de règlement, plus de police."
                                            },
                                            {
                                                "example_id": "5e61a3f0-30e3-4cce-bf60-c45787c0c594",
                                                "sense_id": "f884947d-0acb-30ec-91ec-f2c857dc4c72",
                                                "text": "Le 5 mars 1911, eut lieu le recensement qui donna à Bourg-la-Reine le chiffre de 5 072 habitants."
                                            },
                                            {
                                                "example_id": "6cca11fc-8883-4c70-b95c-16351d0b67f3",
                                                "sense_id": "f884947d-0acb-30ec-91ec-f2c857dc4c72",
                                                "text": "Christophe Colomb, on le sait, lorsqu'il aborda en Amérique, crut avoir atteint les Indes par une nouvelle route maritime et nomma en conséquence « Indiens » les premiers habitants qu'il rencontra."
                                            },
                                            {
                                                "example_id": "be72fc76-0aff-4981-a59d-1acab389fccb",
                                                "sense_id": "f884947d-0acb-30ec-91ec-f2c857dc4c72",
                                                "text": "L'admirable Calvignac, en équilibre au bord de sa falaise, n'a plus que 386 habitants après en avoir compté, en 1789, 900 ; […]."
                                            },
                                            {
                                                "example_id": "6b16f9b3-b6da-427a-9689-986d696159de",
                                                "sense_id": "f884947d-0acb-30ec-91ec-f2c857dc4c72",
                                                "text": "Toutefois, les cités islamiques n'avaient jamais créé d'institutions autonomes, […]. Leurs habitants n'avaient aucun loyalisme civique ; ils n'étaient pas d'authentiques citoyens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69db5e7f-260a-33ae-9c7c-a2dc77ea775d",
                                        "entry_id": "02999687-076e-3323-9e33-7b388d4ae455",
                                        "glosses": [
                                            "Être ou chose se trouvant habituellement dans un lieu donné."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86dc3040-c145-449a-ab1b-069a75df1a9a",
                                                "sense_id": "69db5e7f-260a-33ae-9c7c-a2dc77ea775d",
                                                "text": "Le brasier faisait fuir les cerfs et tous les autres habitants de la forêt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a78d025-4a33-3599-986f-baa93607e9da",
                                        "entry_id": "02999687-076e-3323-9e33-7b388d4ae455",
                                        "glosses": [
                                            "Paysan, campagnard."
                                        ],
                                        "tags": [
                                            "Québec",
                                            "Antilles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8abed245-e4c5-4844-9857-52e9140d5a6e",
                                                "sense_id": "0a78d025-4a33-3599-986f-baa93607e9da",
                                                "text": "Il n’est pas de garçon d’habitant qui ne vole son père pour donner de l’avoine à son cheval afin qu’il soit gras et vif."
                                            },
                                            {
                                                "example_id": "68b85cb2-801c-4696-838f-c8e28203d039",
                                                "sense_id": "0a78d025-4a33-3599-986f-baa93607e9da",
                                                "text": "— Il n’y a pas d’homme dans le monde qui soit moins libre qu’un habitant… Quand vous parlez d’hommes qui ont bien réussi, qui sont bien gréés de tout ce qu’il faut sur une terre et qui ont plus de chance que les autres, vous dites : « Ah ! ils font une belle vie ; ils sont à l’aise ; ils ont de beaux animaux. »\n« Ça n’est pas ça qu’il faudrait dire. La vérité, c’est que ce sont leurs animaux qui les ont."
                                            },
                                            {
                                                "example_id": "a6d2585d-8e4d-41b8-bf57-9e75897ef4d7",
                                                "sense_id": "0a78d025-4a33-3599-986f-baa93607e9da",
                                                "text": "Les habitants ne servent plus à rien ; après avoir passé l’hiver sur l’assurance-chômage, ils sont contents de monter sur leurs anciens tracteurs pour labourer, à $2 l'heure, leurs anciennes glèbes et leurs anciens pâturages, bande d’abrutis."
                                            },
                                            {
                                                "example_id": "de717607-ac23-40b7-8511-d615b0672de3",
                                                "sense_id": "0a78d025-4a33-3599-986f-baa93607e9da",
                                                "text": "L'habitant du Canada répugnait à se faire appeler paysan [au XVIIIᵉ s.]; il n'en avait d'ailleurs que certaines caractéristiques. S'il ressemblait à son homologue français par la nature de son occupation principale, il en différait passablement par les conditions de vie, les traditions et les techniques."
                                            },
                                            {
                                                "example_id": "3ed14cd7-4c08-4ea6-99f7-39bc360198b4",
                                                "sense_id": "0a78d025-4a33-3599-986f-baa93607e9da",
                                                "text": "On comprend que le mot paysan n’ait pas traversé l’Atlantique. Nos ancêtres furent des habitants, des cultivateurs mais des paysans, point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ad05d1-3bbf-34fd-b300-f4523d6b474f",
                                        "entry_id": "02999687-076e-3323-9e33-7b388d4ae455",
                                        "glosses": [
                                            "Personne qui maîtrise mal les conventions sociales."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6552ef43-d266-4cea-bc07-09c31f7d0613",
                                                "sense_id": "00ad05d1-3bbf-34fd-b300-f4523d6b474f",
                                                "text": "S'habiller en habitant."
                                            },
                                            {
                                                "example_id": "f84df701-5242-464e-8ac0-d1b20c4d5f16",
                                                "sense_id": "00ad05d1-3bbf-34fd-b300-f4523d6b474f",
                                                "text": "Le nom d'habitant, par exemple, qui désignait l'occupant d'une terre, et qui vers 1950 prend le sens de « fruste, ignorant », illustre la perte de prestige de la ruralité et la volonté collective de modernisation de la société."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "habitant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf01eb83-31ab-3f93-b4f6-5d52116b38b2",
                                        "entry_id": "37cdbdb0-84b2-3600-afd3-9de4daf1cf7c",
                                        "glosses": [
                                            "Qui maîtrise mal les conventions sociales, qui trahit ses origines campagnardes ou mal dégrossies."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ab7a7b6-8f98-481c-a705-f5492ae86ca4",
                                                "sense_id": "bf01eb83-31ab-3f93-b4f6-5d52116b38b2",
                                                "text": "[…] dans son « vrai » français à l’accent très habitant, mais à la syntaxe parfaite et au vocabulaire surabondant […]."
                                            },
                                            {
                                                "example_id": "add07f41-1010-47df-8202-c92259d3f2c7",
                                                "sense_id": "bf01eb83-31ab-3f93-b4f6-5d52116b38b2",
                                                "text": "Tellement habitant, il couche en cuillère à soupe."
                                            }
