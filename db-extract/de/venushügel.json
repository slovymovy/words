                "senses": [
                    {
                        "sense_id": "dbc0cc59-03b2-320e-98db-ee57503981fe",
                        "entry_id": "c8964ed5-e61f-38e8-917a-8fb007dcb8f2",
                        "glosses": [
                            "leichte Erhebung über dem weiblichen Schambein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5531448-a58b-4b8a-81ac-c0f6640181b3",
                                "sense_id": "dbc0cc59-03b2-320e-98db-ee57503981fe",
                                "text": "Eine junge, knabenhaft wirkende Frau mit zarten Gliedmaßen, kleinen Brüsten und einem kaum angedeuteten Venushügel, bedeckt mit dunklem Haarflaum."
                            },
                            {
                                "example_id": "56f8e52d-0200-4d7f-aaef-fb8e19b5a744",
                                "sense_id": "dbc0cc59-03b2-320e-98db-ee57503981fe",
                                "text": "„Über ihnen muß ein Hals stehen, darüber ein Gesicht leuchten, und die obere Dreieinigkeit muß die untere signalisieren: Hüften, Arsch und Venushügel.“"
                            },
                            {
                                "example_id": "8aef9d9a-82df-43d8-83a8-d2b93035ffe4",
                                "sense_id": "dbc0cc59-03b2-320e-98db-ee57503981fe",
                                "text": "„Mit Daumen und Zeigefinger packe ich durch ihre Trikothosen den Venushügel und drücke zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e225bd57-223a-4f6d-b24b-b975f6ffe60a",
                        "source_entry_id": "c8964ed5-e61f-38e8-917a-8fb007dcb8f2",
                        "source_sense_id": "dbc0cc59-03b2-320e-98db-ee57503981fe",
