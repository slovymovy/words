                        "entry_id": "6f011f80-435a-33e5-9d80-4d81eea7e3de",
                        "glosses": [
                            "Action de tanner les peaux par macération dans un composé minéral ou organique pour les rendre imputrescibles."
                        ],
                        "tags": [
                            "Travail du cuir"
                        ],
                        "examples": [
                            {
                                "example_id": "e9bf3b56-5978-42ca-81a1-609027fad6d3",
                                "sense_id": "489ff3ad-2f3c-3da4-b9eb-033da4f8ffe3",
                                "text": "L’écorce de chêne, employée pour le tannage des cuirs, est un élément important de la richesse forestière du département."
                            },
                            {
                                "example_id": "cd82d415-08ab-412d-bbf9-8caefd3bc435",
                                "sense_id": "489ff3ad-2f3c-3da4-b9eb-033da4f8ffe3",
                                "text": "Monique Philip dispose d’un atout majeur: un tannage innovant, sans aucun produits chimiques."
                            }
                        ]
                    }
