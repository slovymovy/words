                "senses": [
                    {
                        "sense_id": "685c5afa-e26f-3bc3-bdfe-869e8af6a415",
                        "entry_id": "026098e2-0a55-3a6b-8aad-ff538636123a",
                        "glosses": [
                            "diminutive of о́блако (óblako): (small) cloud"
                        ],
                        "tags": [
                            "diminutive",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "62a3755d-8bc8-49e5-ba7b-b1b270a3cb3d",
                                "sense_id": "685c5afa-e26f-3bc3-bdfe-869e8af6a415",
                                "text": "Я увидел в самом деле на краю неба белое облачко, которое принял было сперва за отдалённый холмик. Ямщик изъяснил мне, что облачко предвещало буран.",
                                "translation": "I did indeed perceive on the horizon a small white cloud, which I at first took for a distant mound. The yemstchick explained to me that small cloud presaged a snow storm.",
                                "english": "I did indeed perceive on the horizon a small white cloud, which I at first took for a distant mound. The yemstchick explained to me that small cloud presaged a snow storm."
                            }
                        ]
                    }
                ],
