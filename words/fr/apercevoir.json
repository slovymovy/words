{
    "word_family": [
        "aperçu",
        "inaperçu"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "caefd9f1-9090-3492-b5b3-89dc9dc2acdb",
                    "sense_definition": "Voir quelqu'un ou quelque chose, souvent de loin ou pendant un court instant ; commencer à distinguer ce qui entre dans le champ de vision.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voir_percevoir_par_la_vue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Du haut de la colline, nous <w>apercevons</w> la mer au loin."
                        },
                        {
                            "text": "J'ai <w>aperçu</w> une silhouette dans le brouillard, mais je n'ai pas vu son visage."
                        },
                        {
                            "text": "Je monte sur le pont et j'<w>aperçois</w> les lumières d'un bateau qui s'éloigne."
                        }
                    ],
                    "synonyms": [
                        "entrevoir"
                    ],
                    "common_phrases": [
                        "apercevoir au loin",
                        "apercevoir de loin",
                        "apercevoir une silhouette"
                    ]
                },
                {
                    "sense_id": "b1db8235-fe2a-38cc-9ca1-2997674c7a28",
                    "sense_definition": "À la forme pronominale (s'apercevoir) : se rendre compte de quelque chose, le remarquer, souvent après coup.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remarquer_prendre_conscience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle s'<w>aperçoit</w> que l'aube se lève."
                        },
                        {
                            "text": "Je m'<w>aperçois</w> de mon erreur beaucoup trop tard."
                        },
                        {
                            "text": "Il s'est <w>aperçu</w> trop tard que son portefeuille avait disparu."
                        }
                    ]
                },
                {
                    "sense_id": "08843b86-f69b-3fb5-9c7c-4683ee1bd5bf",
                    "sense_definition": "Remarquer ou constater quelque chose, avec les yeux ou avec l'esprit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "remarquer_prendre_conscience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À chaque fenêtre, on <w>aperçoit</w> des géraniums cultivés dans des pots."
                        },
                        {
                            "text": "En <w>apercevant</w> le visage inquiet de son frère, il comprit qu'il avait peur."
                        },
                        {
                            "text": "Le professeur <w>aperçoit</w> tout de suite une erreur dans le calcul."
                        }
                    ],
                    "common_phrases": [
                        "apercevoir une erreur",
                        "apercevoir un changement"
                    ]
                }
            ]
        }
    ]
}