                "senses": [
                    {
                        "sense_id": "319c92ca-0db3-3beb-8081-fded80e89955",
                        "entry_id": "192408d6-18c4-3a3e-bbf1-f320f1f9a295",
                        "glosses": [
                            "Chienne qui aboie à la vue du sanglier, sans en approcher."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "73002627-1834-33db-9a7f-4a6c546178b1",
                        "entry_id": "192408d6-18c4-3a3e-bbf1-f320f1f9a295",
                        "glosses": [
                            "Celle qui fatigue par des criailleries importunes, par des injures ; celle qui semble aboyer (des ordres, des remontrances, etc.)."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4e34a310-20de-4840-bc53-f37c23b0e511",
                                "sense_id": "73002627-1834-33db-9a7f-4a6c546178b1",
                                "text": "Les reptiles tordus au front, les yeux ardents,\nL’aboyeuse Gorgô vole et grince des dents\nPar la plaine où le sang exhale ses buées."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b1e08ff-0caa-384c-9e4c-0b702a8bfb84",
                        "entry_id": "192408d6-18c4-3a3e-bbf1-f320f1f9a295",
                        "glosses": [
                            "Celui qui, à la porte des théâtres, hôtels, cafés, restaurants, etc., appelle les voitures ou attire les clients."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36c587e1-748a-4ed2-966d-1fe3664be9d2",
                                "sense_id": "0b1e08ff-0caa-384c-9e4c-0b702a8bfb84",
                                "text": "Il faut bien commencer, susurra la commère qui se nommait Mᵐᵉ Badin et qui, du moment qu’on buvait, négligeait son emploi d’aboyeuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "7906b90c-547d-37d5-be30-969ef51cc56a",
                        "entry_id": "192408d6-18c4-3a3e-bbf1-f320f1f9a295",
                        "glosses": [
                            "Cuisinière se tenant au passe d'un restaurant pendant le service, annonçant à voix haute les plats et vérifiant la bonne exécution des commandes."
                        ],
