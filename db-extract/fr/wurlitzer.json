                        "glosses": [
                            "Juke-box de la marque Wurlitzer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "989d8fb3-033d-4294-9f2f-60c41f47db3c",
                                "sense_id": "9ed6922a-452e-3cbb-9d6a-a2a598fd4e7e",
                                "text": "Les trois flippers étaient soigneusement alignés contre le mut du fond, et faisaient face au juke-box, une véritable merveille, un Wurlitzer avec des 45 tours."
                            },
                            {
                                "example_id": "96bf2496-8eb8-4f2d-ad86-5e36cb167563",
                                "sense_id": "9ed6922a-452e-3cbb-9d6a-a2a598fd4e7e",
                                "text": "Deux types en manches de chemise, pieds nus, les coudes posés sur le comptoir de bois, les yeux fermés, ronds comme des billes et tenant à peine sur leurs pattes, dodelinaient de la tête au rythme d’un air de danse assourdi qui sortait d’un Wurlitzer planté dans un coin du café désert."
                            },
                            {
                                "example_id": "aa70ee37-7b13-46cb-b9a2-10b47d92fc31",
                                "sense_id": "9ed6922a-452e-3cbb-9d6a-a2a598fd4e7e",
                                "text": "Mike se souvenait de lui, plus tard, quand il avait commencé à traîner dans les bars en faisant marcher les wurlitzer."
                            }
                        ]
                    }
                ],
