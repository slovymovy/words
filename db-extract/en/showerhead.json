                    {
                        "translation_id": "d2eae2ed-b434-411a-9a28-30de7bbf3270",
                        "source_entry_id": "231581ca-643a-30a8-bbde-faea9ea3ca25",
                        "source_sense_description": "perforated nozzle that showers water on a bather",
                        "target_lang_word": "alcachofa",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcachofa",
