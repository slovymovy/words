                "senses": [
                    {
                        "sense_id": "949fac30-1ca3-3c75-9682-f85b6f86d664",
                        "entry_id": "b437f981-1db4-3210-8024-5d5ccd9cc195",
                        "glosses": [
                            "Entbindung durch operative Öffnung der Gebärmutter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "982b089d-6be0-46ca-adbd-192ded523495",
                                "sense_id": "949fac30-1ca3-3c75-9682-f85b6f86d664",
                                "text": "Heute ist in vielen Krankenhäusern der Kaiserschnitt eine Routine-Operation."
                            },
                            {
                                "example_id": "c751dc7c-3c78-4923-bf85-508fe7c94fa9",
                                "sense_id": "949fac30-1ca3-3c75-9682-f85b6f86d664",
                                "text": "Ursprünglich war die Geburt erst für nächste oder übernächste Woche geplant gewesen. Weil es der Mutter aber am Freitag abrupt schlechter ging, entschloss sich das Ärzte-Team zum sofortigen Kaiserschnitt."
                            },
                            {
                                "example_id": "9010c7fb-faf2-4c87-a4a6-99ad962db55c",
                                "sense_id": "949fac30-1ca3-3c75-9682-f85b6f86d664",
                                "text": "„Der Kaiserschnitt war eine einfache Sache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
