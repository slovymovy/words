                    {
                        "translation_id": "512680ec-1697-47b3-b01e-66d85488f2a4",
                        "source_entry_id": "2d73de32-3681-397c-82f1-2571a42a0806",
                        "source_sense_description": "to paint again",
                        "target_lang_word": "repeindre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repeindre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85ec33f9-5ec7-3162-825f-86a242ebbb5c",
                                        "entry_id": "0d450ecb-4065-3de8-b452-f8b93ed51908",
                                        "glosses": [
                                            "Peindre à nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a3a64b5-4760-4227-a7be-5362bfbb3847",
                                                "sense_id": "85ec33f9-5ec7-3162-825f-86a242ebbb5c",
                                                "text": "Bin, je ne l’ai pas vu… mais quand tu sais que je vais repeindre le portemanteau, pourquoi laisse-tu ton veston??"
                                            },
                                            {
                                                "example_id": "bd6313c2-c85f-42d8-9e7c-9b1e72a91e72",
                                                "sense_id": "85ec33f9-5ec7-3162-825f-86a242ebbb5c",
                                                "text": "Nous nous allongeons côte à côte dans des chaises longues qui mériteraient d’être repeintes."
                                            },
                                            {
                                                "example_id": "f2e61f66-1bcf-4041-890d-9626c6b0c099",
                                                "sense_id": "85ec33f9-5ec7-3162-825f-86a242ebbb5c",
                                                "text": "En contrepartie, Jérôme avait promis de repeindre le petit salon et d’y réinstaller la double suspension de laiton aux globes d’opaline, très années 50, qui se trouvait encore là-haut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
