                    {
                        "sense_id": "ab8c233c-5974-3971-b1a3-a092aa98670f",
                        "entry_id": "ca614fb3-6b8b-3a2a-a6d6-8248ce39348f",
                        "glosses": [
                            "средство для уничтожения или маскировки неприятных запахов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8d28317-bfec-42e1-8f9b-5f8dc80f9e54",
                                "sense_id": "ab8c233c-5974-3971-b1a3-a092aa98670f",
                                "text": "Потом не спасали ни горячая вода, ни самые сильные дезодоранты — неделю, а то и две недели смрад преследовал, настигая в самые неподходящие моменты .."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e7312b5-19ef-44b4-a954-6ffa2e33164e",
                        "source_entry_id": "ca614fb3-6b8b-3a2a-a6d6-8248ce39348f",
                        "source_sense_id": "ab8c233c-5974-3971-b1a3-a092aa98670f",
                        "target_lang_word": "deodorant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
