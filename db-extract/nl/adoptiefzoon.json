                "senses": [
                    {
                        "sense_id": "0d15a72f-55ef-3320-ae03-34b49d8a98f0",
                        "entry_id": "53a77002-396f-3432-b86d-f4053e6ce00e",
                        "glosses": [
                            "mannelijk kind dat is aangenomen als eigen kind zonder dat er sprake is van een biologische band"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1a52820-7993-4517-abbc-7270ace5e6ac",
                                "sense_id": "0d15a72f-55ef-3320-ae03-34b49d8a98f0",
                                "text": "De onderzoekers vonden in het gebouw waar de Senaat vergaderde, de Curia Pompei, een cementen plaat van drie meter breed en twee meter hoog, die niet bij de structuur van het gebouw past. Volgens de onderzoekers plaatste Caesars adoptiefzoon en opvolger Augustus die om de plek van de moord te verzegelen."
                            },
                            {
                                "example_id": "b1e81d45-25ee-4296-92cf-9a196440f6c9",
                                "sense_id": "0d15a72f-55ef-3320-ae03-34b49d8a98f0",
                                "text": "Soms wordt kennis van islamitische verhalen verondersteld, zoals bij de beantwoording van de vraag of adoptie is geoorloofd. Als argument tegen adoptie wordt het verhaal over Mohammeds adoptiefzoon Zaid aangevoerd. Mohammed trouwde met Zaids vrouw, toen Zaid „de omgang met haar beëindigd had.” Zo staat het in de koran, waarnaar verwezen wordt, maar voor wie deze discussie niet kent is enige toelichting hard nodig."
                            }
                        ]
                    }
