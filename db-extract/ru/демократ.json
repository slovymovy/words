                    },
                    {
                        "translation_id": "10ef0863-d029-4dd2-bf85-864287d4c973",
                        "source_entry_id": "f3d635fa-6c49-3c82-bb68-f299ef624914",
                        "target_lang_word": "Demokrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Demokrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffdbe89b-2a3e-306b-93fd-634415022010",
                                        "entry_id": "a9d200f0-76ff-3dbb-993f-fe8b950c0bed",
                                        "glosses": [
                                            "Anhänger der Demokratie, Anhänger einer demokratischen Partei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a39242-01a0-428a-83bb-ae6110ed5e63",
                                                "sense_id": "ffdbe89b-2a3e-306b-93fd-634415022010",
                                                "text": "Der Kanzler habe sich immer als aufrechter Demokrat erwiesen, \"dem es ein besonderes Anliegen war, den Rechtsradikalismus und den Antisemitismus zu bekämpfen\"."
                                            },
                                            {
                                                "example_id": "ca0dd14e-016e-4089-8917-543a80b7464c",
                                                "sense_id": "ffdbe89b-2a3e-306b-93fd-634415022010",
                                                "text": "„Die schon unter Zeitgenossen verbreitete These, der Staat von Weimar sei eine „Demokratie ohne Demokraten“ gewesen, ist nur bedingt richtig, weist aber auf ein wesentliches Strukturproblem hin[.]“"
                                            },
                                            {
                                                "example_id": "329299fd-9a5c-4e26-b0aa-94e22c2921b6",
                                                "sense_id": "ffdbe89b-2a3e-306b-93fd-634415022010",
                                                "text": "„Denn wenn erst Demokraten Israels Nachbarstaaten regierten, dann sei es mit der arabisch-israelischen Sicherheitsallianz vorbei.“"
                                            },
                                            {
                                                "example_id": "f5ca133d-d6db-475d-85ef-b74fcae11f65",
                                                "sense_id": "ffdbe89b-2a3e-306b-93fd-634415022010",
                                                "text": "„Der Mann war Demokrat, solange die anderen Stadtratsmitglieder dachten wie er.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d214e415-6f61-3cd3-92bc-88b0d6efdb2a",
                                        "entry_id": "a9d200f0-76ff-3dbb-993f-fe8b950c0bed",
                                        "glosses": [
                                            "Mitglied oder Anhänger der US-amerikanischen Partei „Demokratische Partei“ (englisch Democratic Party, Democrats)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd3b4e9-b110-4868-baf5-b3a72e87563f",
                                                "sense_id": "d214e415-6f61-3cd3-92bc-88b0d6efdb2a",
                                                "text": "„Bloomberg wurde einst 2002 als Republikaner ins Rathaus gewählt, war am Ende seiner Amtszeit 2013 bereits länger parteilos und ist seit Oktober 2018 wieder eingetragener Demokrat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59c7e726-b2c2-4052-81c1-98f7ffb571ad",
                        "source_entry_id": "f3d635fa-6c49-3c82-bb68-f299ef624914",
