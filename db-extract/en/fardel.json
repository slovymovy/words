                        "entry_id": "03d9af9c-a06c-3333-8283-ef2966621630",
                        "glosses": [
                            "A fourth part: a quarter of anything."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b70f7d6f-2a63-4d83-9693-ee011002f153",
                                "sense_id": "5272d8d6-cac6-37b4-9f2e-723a0b6fe0fe",
                                "text": "I... bought a Farthel of Bread and a Mutckin of Ale."
                            }
                        ]
                    },
                    {
                        "sense_id": "67fac410-ac1d-3f6b-85a4-08565105a3f6",
                        "entry_id": "03d9af9c-a06c-3333-8283-ef2966621630",
                        "glosses": [
                            "An English unit of land area variously understood as the fourth part of an oxgang or of a yardland."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2426df9c-8aa3-4b81-9757-6322829199cc",
                                "sense_id": "67fac410-ac1d-3f6b-85a4-08565105a3f6",
                                "text": "You must note, that two Fardells of Land make a Nooke of Land, and two Nookes make halfe a Yard of Land."
                            },
                            {
                                "example_id": "01bc3dd8-b5f6-4030-b8d3-078fcb21d12e",
                                "sense_id": "67fac410-ac1d-3f6b-85a4-08565105a3f6",
                                "text": "Fardel of Land, the fourth part of a Yard-land."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
