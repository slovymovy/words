                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbd8cb5e-867d-4f08-b1d6-6c4527825f09",
                                "sense_id": "1b7e2d82-a026-314d-8a8d-d2b4ce160978",
                                "text": "„Nach dem Rundgang serviert uns seine Frau Tee und weist uns einen Ehrenplatz in der Hollywoodschaukel zu.“"
                            },
                            {
                                "example_id": "05bf9c69-4a09-4b1e-be4c-15a0607b91b7",
                                "sense_id": "1b7e2d82-a026-314d-8a8d-d2b4ce160978",
                                "text": "„Die Hollywoodschaukel hat sie vor zwanzig Jahren angeschafft und seither selten benutzt.“"
                            },
                            {
                                "example_id": "3541ec92-621b-4513-9b9b-77ee8da13dcd",
                                "sense_id": "1b7e2d82-a026-314d-8a8d-d2b4ce160978",
                                "text": "„Schwebende Cocoons und baumelnde Nester in allen Variationen sind ebenso im Trend wie diverse Wiedergänger der alten Hollywoodschaukel. Keine Frage also – die Gartenmöblierung ist in Bewegung.“"
                            }
                        ],
