    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "326c134c-32a4-3e84-ae75-b7e4fb908a8f",
                    "sense_definition": "A paved road in a city, town, or village, typically with houses and buildings on one or both sides.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "thoroughfare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Walk down the <w>street</w> until you see a hotel on the right.",
                            "target_lang_translations": {
                                "ru": "Идите вниз по <w>улице</w>, пока не увидите отель справа."
                            }
                        },
                        {
                            "text": "The man wearing a red coat is standing on the <w>street</w>.",
                            "target_lang_translations": {
                                "ru": "Мужчина в красном пальто стоит на <w>улице</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "street"
                    ],
                    "common_phrases": [
                        "main street",
                        "busy street",
                        "quiet street",
                        "cross the street"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мощеная дорога в городе, поселке или деревне, обычно с домами и зданиями по обеим сторонам."
                    },
