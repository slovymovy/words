                "forms": [],
                "senses": [
                    {
                        "sense_id": "7cf0ae52-de26-34f1-b543-5660e0801a04",
                        "entry_id": "e0af828e-2442-39f0-879d-1e4fdb71469b",
                        "glosses": [
                            "D’une manière éhontée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91725d8d-2169-46ca-b4b7-3b5e201402e0",
                                "sense_id": "7cf0ae52-de26-34f1-b543-5660e0801a04",
                                "text": "L'exemple extrême d'une attitude utopique prônant la passivité a été celle de l'Église du XIXᵉ siècle proposant à la classe ouvrière éhontément exploitée de prendre patience, les souffrances subies sur cette terre lui ouvrant pour après la mort les portes du Paradis."
                            },
                            {
                                "example_id": "67c86ab8-05ad-48b2-a5bf-b19430431c0b",
                                "sense_id": "7cf0ae52-de26-34f1-b543-5660e0801a04",
                                "text": "Elle qui l'avait activement encouragé, qui avait flirté éhontément avec lui au bureau au cours des jours suivants, même si elle l'avait repoussé après leur premier baiser."
                            },
                            {
                                "example_id": "257b8202-549e-4d3c-b39b-77b9ef729410",
                                "sense_id": "7cf0ae52-de26-34f1-b543-5660e0801a04",
                                "text": "Le gouverneur éhontément corrompu de Saxe, Martin Mutschmann, avait ignoré les appels des officiels de la ville à la construction d'abris solides, même s'il avait fait construire par les SS des bunkers de béton armé sous son bureau et dans le jardin de son domicile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc137b05-198a-4091-ae74-477cae7e58a7",
                        "source_entry_id": "e0af828e-2442-39f0-879d-1e4fdb71469b",
                        "source_sense_id": "7cf0ae52-de26-34f1-b543-5660e0801a04",
                        "target_lang_word": "shamelessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shamelessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83e2b801-bcd5-38d3-9a7f-5180f3ace6a0",
                                        "entry_id": "de9a2e77-1840-3068-a52f-4c25d6f5228b",
                                        "glosses": [
                                            "In a shameless manner; without shame; impudently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ea6ab8-e298-46d6-bfd6-843cbe85e780",
                                                "sense_id": "83e2b801-bcd5-38d3-9a7f-5180f3ace6a0",
                                                "text": "Bradly served him a handsome allowance, and Podson was at it, even in the process of its being served. He guzzled shamelessly, pushing food into an overstuffed mouth, his eye glazed to all intrusion on a gastric debauch."
                                            },
                                            {
                                                "example_id": "f35bbc6f-683e-4088-92cb-a9bc9dc89a22",
                                                "sense_id": "83e2b801-bcd5-38d3-9a7f-5180f3ace6a0",
                                                "text": "Yesterday, I shamelessly blegged people to vote for my son in a Parents magazine cutest kid contest."
                                            },
                                            {
                                                "example_id": "444befa3-2c11-4ac4-b13f-7021942cf034",
                                                "sense_id": "83e2b801-bcd5-38d3-9a7f-5180f3ace6a0",
                                                "text": "But I take the view that the statue is a cheap and cynical stunt by ministers with scant knowledge of history, whose only interest lies in greasing up to modern Indian politicians. With little or no dignity, they shamelessly prostrate themselves in the most craven way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
