{
    "word_family": [
        "heeled",
        "high-heeled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6458a2f9-ee8b-3fdf-aab2-6006f3fbc942",
                    "sense_definition": "Women's shoes that have high heels.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a short skirt and <w>heels</w> to the party.",
                            "target_lang_translations": {
                                "ru": "Она надела на вечеринку короткую юбку и <w>туфли на каблуках</w>."
                            }
                        },
                        {
                            "text": "I am taller than you when I do not wear <w>heels</w>.",
                            "target_lang_translations": {
                                "ru": "Я выше тебя, когда не ношу <w>каблуки</w>."
                            }
                        },
                        {
                            "text": "She decided to wear <w>high</w> <w>heels</w> despite the long walk ahead.",
                            "target_lang_translations": {
                                "ru": "Она решила надеть <w>высокие</w> <w>каблуки</w>, несмотря на предстоящую долгую прогулку."
                            }
                        }
                    ],
                    "synonyms": [
                        "pumps",
                        "stilettos",
                        "high heels"
                    ],
                    "antonyms": [
                        "flats"
                    ],
                    "common_phrases": [
                        "high heels",
                        "wear heels",
                        "pair of heels"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женская обувь на высоком каблуке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туфли на каблуках",
                                "target_lang_sense_clarification": "общий термин для обуви на каблуке"
                            },
                            {
                                "target_lang_word": "каблуки",
                                "target_lang_sense_clarification": "разговорное обозначение такой обуви"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "453503cb-b266-393a-b5c1-80a096be7ab4",
                    "sense_definition": "The plural form of <w>heel</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plural_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>heels</w> of my boots are starting to wear down.",
                            "target_lang_translations": {
                                "ru": "<w>Каблуки</w> моих ботинок начинают стачиваться."
                            }
                        },
                        {
                            "text": "He dug his <w>heels</w> into the ground to stop himself from sliding.",
                            "target_lang_translations": {
                                "ru": "Он упёрся <w>пятками</w> в землю, чтобы не соскользнуть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dig in heels",
                        "click your heels",
                        "heels of boots"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число слова «пятка» или «каблук»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятки",
                                "target_lang_sense_clarification": "части стопы"
                            },
                            {
                                "target_lang_word": "каблуки",
                                "target_lang_sense_clarification": "части обуви"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}