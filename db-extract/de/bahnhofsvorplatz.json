                ],
                "senses": [
                    {
                        "sense_id": "5232a993-4877-3aef-b080-ee46e86258f1",
                        "entry_id": "21c4c80c-304c-3746-bb31-12fa96fc362c",
                        "glosses": [
                            "größerer begehbarer Bereich vor einem Bahnhof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3eaf46f-cdd5-4138-9562-ccc3695257db",
                                "sense_id": "5232a993-4877-3aef-b080-ee46e86258f1",
                                "text": "Wir treffen uns am besten auf dem Bahnhofsvorplatz."
                            },
                            {
                                "example_id": "f5b2aede-6a4a-4e29-810c-d3177219dbbf",
                                "sense_id": "5232a993-4877-3aef-b080-ee46e86258f1",
                                "text": "„Wir gelangen über einen Baustellenpfad aus der Unterführung hinaus auf den Bahnhofsvorplatz.“"
                            },
                            {
                                "example_id": "d59775cf-2dbb-4f67-97d8-83d74613716f",
                                "sense_id": "5232a993-4877-3aef-b080-ee46e86258f1",
                                "text": "„Am frühen Nachmittag des 8. November 1918 erreichte ein Auto den Bahnhofsvorplatz von Hildesheim, in dem bewaffnete Mitglieder des in Hannover bereits gebildeten Arbeiter- und Soldatenrates saßen.“"
                            },
                            {
                                "example_id": "24ed4c0e-be93-45fe-9b89-2a7edab9834d",
                                "sense_id": "5232a993-4877-3aef-b080-ee46e86258f1",
                                "text": "„Mein Knie war geschwollen, und ich humpelte mühsam quer über den Bahnhofsvorplatz in die Poststraße hinein; zwei Minuten nur vom Bahnhof bis zu unserer Wohnung, sie kamen mir endlos vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
