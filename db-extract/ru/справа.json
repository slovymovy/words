                        "target_lang_word": "rechts",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rechts",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "644a0769-3691-32e5-902c-b57f19f1ad51",
                                        "entry_id": "7b8e1339-726b-323d-8da0-d30f2dec904d",
                                        "glosses": [
                                            "seitlich im Gegenteil zu links"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c77b2694-2c40-43c3-942d-c7af3756f672",
                                                "sense_id": "644a0769-3691-32e5-902c-b57f19f1ad51",
                                                "text": "In Mitteleuropa fahren Autos rechts."
                                            },
                                            {
                                                "example_id": "e0b3d729-ff74-4222-94da-43da2e180d20",
                                                "sense_id": "644a0769-3691-32e5-902c-b57f19f1ad51",
                                                "text": "Rechts sehen Sie gleich die Frauenkirche, wenn Sie aus dem Fenster schauen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b8e9f26-b58f-3264-8606-11895728bb25",
                                        "entry_id": "7b8e1339-726b-323d-8da0-d30f2dec904d",
                                        "glosses": [
                                            "zum politisch rechten Spektrum gehörend, welches insbesondere Kommunismus und Sozialismus ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a4746c2-038b-455b-854c-d590179220fe",
                                                "sense_id": "0b8e9f26-b58f-3264-8606-11895728bb25",
                                                "text": "Bürgerliche Parteien stehen politisch weiter rechts als die Sozialisten."
                                            },
                                            {
                                                "example_id": "29811f89-2937-42e2-abd0-bd5ad60af16f",
                                                "sense_id": "0b8e9f26-b58f-3264-8606-11895728bb25",
                                                "text": "In diesem Vorort wurde schon immer rechts gewählt."
                                            },
                                            {
                                                "example_id": "c2cf0b29-2db3-45a6-8677-8ad9c1268377",
                                                "sense_id": "0b8e9f26-b58f-3264-8606-11895728bb25",
                                                "text": "„Jeder Vierte im Landkreis Bautzen wählte eine Partei rechts von der CDU. […] Der Landkreis Bautzen löste die Sächsische Schweiz als rechteste Region Sachsens ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c366a32d-bbdc-440d-a82a-bd12d7d370f3",
                        "source_entry_id": "91a54b36-8d41-332c-b5d2-4e31216a68ab",
                        "source_sense_id": "d6a11492-cd7c-32d6-840f-a1402497637d",
                        "source_sense_description": "где?",
                        "target_lang_word": "à droite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à droite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "848eab84-4821-396c-8d55-0dfb38f5ee39",
                                        "entry_id": "75399f4d-7b29-3c46-8f7c-4cb8bfd7faf7",
                                        "glosses": [
                                            "Du côté droit ; à main droite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07591d9a-8649-48d0-80ba-9c05eec44f79",
                                                "sense_id": "848eab84-4821-396c-8d55-0dfb38f5ee39",
                                                "text": "Les cheminées et les toits de chaume, à droite et à gauche de la route, dépassaient à peine les montagnes de neige, […]."
                                            },
                                            {
                                                "example_id": "23938d84-8a9d-4766-b0ec-db047958dd7c",
                                                "sense_id": "848eab84-4821-396c-8d55-0dfb38f5ee39",
                                                "text": "Pendant de longues heures nous marchons en silence, ne regardant ni à droite ni à gauche, la tête baissée sous nos capuchons pour nous garantir de l'ondée cinglante."
                                            },
                                            {
                                                "example_id": "89f74c9d-15ea-4922-9d2b-bd4fb2c8f3b1",
                                                "sense_id": "848eab84-4821-396c-8d55-0dfb38f5ee39",
                                                "text": "La conduite est à droite, mais rien d’anglaise, simplement l’époque redoutait moins ce qui venait en sens inverse que de verser dans le fossé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a73b4b09-e121-38c4-9da4-d5f5d388a8a3",
                                        "entry_id": "75399f4d-7b29-3c46-8f7c-4cb8bfd7faf7",
                                        "glosses": [
                                            "Du courant politique de la droite."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6625991-0865-4718-b358-dc9a965ac052",
                                                "sense_id": "a73b4b09-e121-38c4-9da4-d5f5d388a8a3",
                                                "text": "Des idées bien à droite, peut-être, mais le couple réfute toute violence."
                                            },
                                            {
                                                "example_id": "ea21a6fd-8aea-426b-acb6-b0a62b7fc634",
                                                "sense_id": "a73b4b09-e121-38c4-9da4-d5f5d388a8a3",
                                                "text": "Chez nous, au Nord, les gens votent à droite. Au Sud, plus à gauche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "à droite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a594ef9-d262-3a99-a1ff-5dd11984e862",
                                        "entry_id": "c5f608e3-8576-388f-8c3e-2e199d818a35",
                                        "glosses": [
                                            "Tournant vers la droite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e87cb81-9d51-4577-8e6c-572d825632c9",
                                                "sense_id": "1a594ef9-d262-3a99-a1ff-5dd11984e862",
                                                "text": "La troupe fit un à droite."
                                            }
                                        ]
                                    }
                                ]
