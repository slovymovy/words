                        ],
                        "examples": [
                            {
                                "example_id": "1447b633-9830-4ef3-b1a5-5cee14937caa",
                                "sense_id": "e1a021c9-f328-3d8d-bdd6-97449d571a53",
                                "text": "Other possibilities include winding up with a straight, two pair with a low, or even a \"flushy-low,\" if you're lucky enough to make both a flush and a low hand."
                            },
                            {
                                "example_id": "f4ab5db3-0a99-43a9-9a04-b1035b964414",
                                "sense_id": "e1a021c9-f328-3d8d-bdd6-97449d571a53",
                                "text": "That happens one time out of nine, so it's unlikely, but not water-into-wine unlikely. If we don't include implied odds, for you to break even on the flushy flop at your 10-handed table, you need nine people playing with you."
                            }
                        ]
                    }
