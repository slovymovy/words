                "senses": [
                    {
                        "sense_id": "7ef716b2-d7cb-30dc-a655-61402fa59261",
                        "entry_id": "999e7f8d-eeae-3d0f-8bb2-29209490f70b",
                        "glosses": [
                            "A snare."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "475ae817-cacc-4ad1-b95c-5f388e1c5934",
                                "sense_id": "7ef716b2-d7cb-30dc-a655-61402fa59261",
                                "text": "With hairy Sprindges we the Birds betray"
                            },
                            {
                                "example_id": "e6257714-2963-4631-b725-9ce5c253f9b5",
                                "sense_id": "7ef716b2-d7cb-30dc-a655-61402fa59261",
                                "text": "Ay, springes to catch woodcocks"
                            },
                            {
                                "example_id": "f5603d22-d6b3-4c9f-bb76-5a4d40b54598",
                                "sense_id": "7ef716b2-d7cb-30dc-a655-61402fa59261",
                                "text": "Look how a mavis, or a pigeòn, / In any grove caught with a springe or net […]"
                            },
                            {
                                "example_id": "b7ca4c1c-6c34-451e-82d7-35efadd216db",
                                "sense_id": "7ef716b2-d7cb-30dc-a655-61402fa59261",
                                "text": "’twas my joy / With store of springes o’er my shoulder hung / To range the open heights where woodcocks run / Along the smooth green turf."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
