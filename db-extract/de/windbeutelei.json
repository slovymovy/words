                "senses": [
                    {
                        "sense_id": "9ef59504-0fd7-3f45-a7ee-db0ee9352423",
                        "entry_id": "73960044-fd47-3b66-ae8f-6e4cb5518f77",
                        "glosses": [
                            "verantwortungslose, leichtsinnige Handlung"
                        ],
                        "tags": [
                            "derogatory",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "7802b5ea-a935-41ce-84b3-78a065a9c7f6",
                                "sense_id": "9ef59504-0fd7-3f45-a7ee-db0ee9352423",
                                "text": "„Doch wir wollen, den Scherz bei Seite lassend, im Ernst sprechen und wollen nur constatiren, daß der – vermuthlich pseudonyme – Autor des vorliegenden theatralischen Machwerks, sowie dessen Verleger sich hier in der Ausdrucksweise eine Windbeutelei erlaubt haben, die öffentlich gerügt werden muß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "76d1cab2-e2af-3e25-b0a8-9ce6c8a71626",
                        "entry_id": "73960044-fd47-3b66-ae8f-6e4cb5518f77",
                        "glosses": [
                            "(unwahre) Aussage, die einen Sachverhalt zum eigenen Nutzen über Gebühr positiv hervorhebt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "257f62a7-b0fd-4397-8ac4-60ac8ff6b487",
                                "sense_id": "76d1cab2-e2af-3e25-b0a8-9ce6c8a71626",
                                "text": "„Es ist dieses freilich eine schriftstellerische Windbeutelei: aber warum soll ich weniger Wind wachen, als meine Kollegen, die manchmal viel schlechteres Zeug geliefert, und doch ihre Schriften mit posaunenden Vorreden begleitet haben?“"
                            },
                            {
                                "example_id": "ebf25320-f13e-4f60-b92e-00da4aa1958c",
                                "sense_id": "76d1cab2-e2af-3e25-b0a8-9ce6c8a71626",
                                "text": "„Ohne Namen zu nennen, erteilte er zugleich den jüngsten Vorschlägen aus den Reihen der CDU zur Stärkung der Sicherheit eine Abfuhr und sprach von «Windbeutelei».“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
