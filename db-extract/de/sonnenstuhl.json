                    {
                        "translation_id": "16e6450e-d95d-4808-a5fd-b3d88104e368",
                        "source_entry_id": "0a3f3208-88ab-376f-9de0-16ea856c9cd2",
                        "source_sense_id": "bdb15a6f-9ef9-3a6e-bf5b-39c775f0298e",
                        "source_sense_description": "zusammenklappbares Sitz- und Liegemöbel, bei dem die Sitzfläche aus einem gespanntem Stoff besteht",
                        "target_lang_word": "transat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9390005-aa78-3937-b97b-1e080bffbff9",
                                        "entry_id": "8f5bf42c-970a-38f9-8254-2c72e62899a5",
                                        "glosses": [
                                            "Fauteuil pliant à siège en toile, qu’on trouvait sur les ponts des paquebots transatlantiques."
                                        ],
                                        "tags": [],
                                        "note": "Il est d’usage de distinguer le transat et la chilienne",
                                        "examples": [
                                            {
                                                "example_id": "a1c791b6-81d3-4352-a3e6-e9715eb096cf",
                                                "sense_id": "f9390005-aa78-3937-b97b-1e080bffbff9",
                                                "text": "Bellune avait disposé des transats et une table en bordure de la terrasse que cernait une rampe blanche à l'aspect de bastingage."
                                            },
                                            {
                                                "example_id": "b28b8595-bbcc-462c-87af-2b069478d44d",
                                                "sense_id": "f9390005-aa78-3937-b97b-1e080bffbff9",
                                                "text": "Il y avait une piscine mais je n’avais pas emporté mon maillot de bain. Autour de la piscine, des gens s’ennuyaient sur des transats. Derrière, il y avait des tables et des chaises en bois blanc."
                                            },
                                            {
                                                "example_id": "7818b71e-ef5d-46ef-90f7-9508f03ba293",
                                                "sense_id": "f9390005-aa78-3937-b97b-1e080bffbff9",
                                                "text": "Que peut-on déjà visiter ? Un « salon » qui remplace l’ancienne cale à poisson du chalutier construit en 1959. Et un « sun deck », le pont passerelle, tout en haut, a été aménagé avec quelques transats pour permettre aux visiteurs de prendre le soleil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f965ecf-a67b-36e6-8d6c-623456673e13",
                                        "entry_id": "8f5bf42c-970a-38f9-8254-2c72e62899a5",
                                        "glosses": [
                                            "Navire transatlantique."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013c84ca-418d-40ee-b816-e4355d06a6aa",
                                                "sense_id": "9f965ecf-a67b-36e6-8d6c-623456673e13",
                                                "text": "Le quai des transats est plus avant dans le port…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a559475-ef54-3315-aa3d-441f683a0aee",
                                        "entry_id": "8f5bf42c-970a-38f9-8254-2c72e62899a5",
                                        "glosses": [
                                            "Siège conçu pour les bébés."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "transat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4fc4503-212b-330c-bfce-1e19585f414a",
                                        "entry_id": "6ecddefb-a700-3b40-ad49-1b0440e85c80",
                                        "glosses": [
                                            "Course à la voile transatlantique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edf1a375-4cd7-4580-89dd-95647f333105",
                                                "sense_id": "e4fc4503-212b-330c-bfce-1e19585f414a",
                                                "text": "Une transat en solitaire."
                                            },
                                            {
                                                "example_id": "a4033020-a16f-46ae-9832-f12a4943b7e3",
                                                "sense_id": "e4fc4503-212b-330c-bfce-1e19585f414a",
                                                "text": "La dernière fois que j’ai fait une course en Imoca, c’était en 2003, la Transat Jacques Vabre avec Nick Moloney."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e34ccc6-6fa9-4a96-8ada-36d3ef3053cd",
                        "source_entry_id": "0a3f3208-88ab-376f-9de0-16ea856c9cd2",
                        "source_sense_id": "bdb15a6f-9ef9-3a6e-bf5b-39c775f0298e",
                        "source_sense_description": "zusammenklappbares Sitz- und Liegemöbel, bei dem die Sitzfläche aus einem gespanntem Stoff besteht",
                        "target_lang_word": "chaise longue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaise longue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "424faf33-da37-35fc-9e24-21574889b3be",
                                        "entry_id": "8d0a26f8-f3ff-307a-b9e0-42e95fc40976",
                                        "glosses": [
                                            "Meuble entre siège et lit où l’on peut s'asseoir ou s'allonger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b55398ca-5615-4634-9928-609de50f1904",
                                                "sense_id": "424faf33-da37-35fc-9e24-21574889b3be",
                                                "text": "Les deux pièces n’en faisaient qu’une, ou du moins le boudoir n’était guère que le seuil de la chambre, une grande alcôve, garnie de chaises longues."
                                            },
                                            {
                                                "example_id": "c4b3c4dd-1dbe-461f-bafd-f290d4d69f9b",
                                                "sense_id": "424faf33-da37-35fc-9e24-21574889b3be",
                                                "text": "Nous nous allongeons côte à côte dans des chaises longues qui mériteraient d’être repeintes."
                                            },
                                            {
                                                "example_id": "42619b70-58ac-4ae7-8aa5-924a36746eff",
                                                "sense_id": "424faf33-da37-35fc-9e24-21574889b3be",
                                                "text": "Je me souviens d’avoir skié sans bonnet, que Bébé lisait une biographie de Truman Capote dans une chaise longue devant l’hôtel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
