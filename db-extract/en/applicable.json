                                                "example_id": "0794bffc-73d1-4cb8-9e64-abf090a3b58b",
                                                "sense_id": "3b4dc62a-ccf1-3a24-978b-7efa8b4e2c4d",
                                                "text": "Patrick erwähnt nur relevante Beiträge."
