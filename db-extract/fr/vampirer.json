                "senses": [
                    {
                        "sense_id": "3c64d5c6-9645-3e39-85cc-56f7fe542b9f",
                        "entry_id": "2ac4ecf3-caf1-3b21-b47a-d3dfcbee4f89",
                        "glosses": [
                            "Vampiriser."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4dac7938-d20b-41ab-b287-b6d19928a0fe",
                                "sense_id": "3c64d5c6-9645-3e39-85cc-56f7fe542b9f",
                                "text": "Paris ne fut jamais, sous le despotisme, qu’une obstruction du corps politique, également propre et destinée à le vampirer et à le corrompre."
                            },
                            {
                                "example_id": "bf222408-5330-4db8-8c8f-40bcf073d8ff",
                                "sense_id": "3c64d5c6-9645-3e39-85cc-56f7fe542b9f",
                                "text": "Les paroles du Bien de mère Nyingone sont perdues pour les Fangs par suite de l’habitude de vampirer et par ignorance de l’écriture : ils s’en sont servis dans leurs contes alors que les Blancs les avaient transcrites dans la Bible…"
                            },
                            {
                                "example_id": "52e38419-6d91-41e5-a229-4fa60b245bcb",
                                "sense_id": "3c64d5c6-9645-3e39-85cc-56f7fe542b9f",
                                "text": "Comme il faut du sang au moins une fois par jour pour vérifier le facteur INR, et d’autres fois pour d’autres fins, il n’est pas nécessaire, à chaque besoin, de planter une seringue dans la saignée du bras pour vous vampirer."
                            }
                        ]
                    }
