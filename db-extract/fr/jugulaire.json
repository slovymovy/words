                                    {
                                        "sense_id": "91ec1590-b4a3-38d3-a8f8-8a9472f6f8fe",
                                        "entry_id": "6dd97112-825d-3b72-aedf-30a4e8105593",
                                        "glosses": [
                                            "Any critical vulnerability."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "in-plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5fffe7e-ec03-4814-9b33-62dc35e7e039",
                                                "sense_id": "91ec1590-b4a3-38d3-a8f8-8a9472f6f8fe",
                                                "text": "It was vicious; he went for the jugular."
                                            },
                                            {
                                                "example_id": "ac0a1a45-41ec-44a8-bdbb-61982e00d5d1",
                                                "sense_id": "91ec1590-b4a3-38d3-a8f8-8a9472f6f8fe",
                                                "text": "One of Lionel's old Salthill friends with whom he exchanged perhaps a dozen words a year, and with whom he sometimes played squash, and tennis, both men killers on the court, seeking the jugular […]."
                                            }
                                        ]
                                    }
                                ]
