                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d4bc813-7841-4f10-a0e1-0d0e166442f2",
                                                "sense_id": "0ffda1d8-d943-31b3-8cfb-7ea4d159cb92",
                                                "text": "Gestern habe ich Nathan getroffen."
                                            },
                                            {
                                                "example_id": "d2e81e9a-1b2f-4544-a46c-e6c54dc061c2",
                                                "sense_id": "0ffda1d8-d943-31b3-8cfb-7ea4d159cb92",
                                                "text": "Nathan Mustermann ist ein schöner Junge."
                                            },
                                            {
                                                "example_id": "f54cc75f-00f0-4de2-ac6e-0e290b6a4bfa",
                                                "sense_id": "0ffda1d8-d943-31b3-8cfb-7ea4d159cb92",
                                                "text": "Nathan ist 20 Jahre alt."
                                            },
                                            {
                                                "example_id": "e4c3e544-b09b-4a72-bbf0-18f78871b0cc",
                                                "sense_id": "0ffda1d8-d943-31b3-8cfb-7ea4d159cb92",
                                                "text": "Grüß bitte Nathan Mustermann herzlich von mir."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "273c4bff-a916-3133-944f-fc432564d9d5",
