                                "example_id": "08e117dd-d060-4769-81da-8e43acbe9ac3",
                                "sense_id": "b80ad3f5-1bd5-3659-9913-9c226776a498",
                                "text": "When he came to, he begged me not to tell the hotel management, as his last two attempted smotherings had ended in failure and he was worried about losing his job."
                            }
                        ]
                    }
