                    {
                        "form_id": "730600fa-53d5-4fd5-bcf3-ad6e2c195304",
                        "entry_id": "f874c461-9686-32a4-8cbc-36e4910c1793",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Pflanzenschutzmittel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ba926aa-4327-3085-9378-aae15b9b2b83",
                        "entry_id": "f874c461-9686-32a4-8cbc-36e4910c1793",
                        "glosses": [
                            "biologisches oder chemisches Mittel zum Schutz von (Nutz-)Pflanzen vor Schädlingen und Krankheiten"
                        ],
                        "tags": [
                            "bes."
                        ],
                        "examples": [
                            {
                                "example_id": "7ac5fc2e-9ecd-49f0-85c0-cec2fad5314b",
                                "sense_id": "2ba926aa-4327-3085-9378-aae15b9b2b83",
                                "text": "„Pflanzenschutzmittel sind chemische oder biologische Produkte, die Pflanzen oder Pflanzenerzeugnisse vor einer Schädigung durch Tiere (zum Beispiel Insekten oder Nagetiere) oder Krankheiten wie Pilzbefall schützen sollen.“"
                            },
                            {
                                "example_id": "0c2ff003-0905-4b92-b079-174a0c39df96",
                                "sense_id": "2ba926aa-4327-3085-9378-aae15b9b2b83",
                                "text": "„Ein Landwirt muss seine Felder mehrmals im Jahr befahren – beim Pflügen, der Aussaat, beim Düngen, bei der Ausbringung von Pflanzenschutzmitteln und schließlich bei der Ernte.“"
                            },
                            {
                                "example_id": "c7f1d8be-d9a1-4b74-99dd-0fc3f8e49495",
                                "sense_id": "2ba926aa-4327-3085-9378-aae15b9b2b83",
                                "text": "„Pflanzenschutzmittel aus der Gruppe der Neonikotinoide können zwei Studien zufolge nicht nur Honigbienen, sondern auch Wildbienen und Schmetterlinge gefährden.“"
                            },
                            {
                                "example_id": "7916bd33-9bce-4665-b277-73b51c46004a",
                                "sense_id": "2ba926aa-4327-3085-9378-aae15b9b2b83",
                                "text": "„Er besprühe das Ackerland mit krebserregenden Pflanzenschutzmitteln, imprägniere die Saat bereits vorab mit Insektengift, und was dann noch an Bestäubern überlebe, werde von ihm mit Giften vollends niedergemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
