                        "glosses": [
                            "The characteristic of being blithe."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0616af9c-3aa7-4bc1-901c-25eb1599c009",
                                "sense_id": "11402e87-7156-3655-8b6d-43d18e2bc804",
                                "text": "A mood of blitheness rarely experienced even by young men was Dick’s on the following Monday morning. It was the week after the Easter holidays, and he was journeying along with Smart the mare and the light spring-cart, watching the damp slopes of the hill-sides as they streamed in the warmth of the sun, […]"
                            }
                        ]
