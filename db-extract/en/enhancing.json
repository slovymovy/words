                        "glosses": [
                            "Acting or tending to enhance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9513428-d699-45c7-8168-26866d781074",
                                "sense_id": "da8360f1-29f5-34a2-9988-cbbda58539bf",
                                "text": "A few sounds were consistently more enhancing, while most were consistently more detracting."
                            },
                            {
                                "example_id": "eb41acab-3534-4f63-a010-5faff4fd214d",
                                "sense_id": "da8360f1-29f5-34a2-9988-cbbda58539bf",
                                "text": "Similarly, successful attack operations in cyberspace with few tracks back to the host government can be very enhancing to one's internal reputation."
                            },
                            {
                                "example_id": "4094ba57-de57-4a60-b723-2606f4b9a17a",
                                "sense_id": "da8360f1-29f5-34a2-9988-cbbda58539bf",
                                "text": "It's obvious that this is more enhancing."
                            }
                        ]
                    }
                ],
