                        "sense_id": "65327a03-734b-3c1f-b5c0-ac1a53b326f6",
                        "entry_id": "4a8c4e14-1cf7-39ed-abee-7ff74fb5dce1",
                        "glosses": [
                            "Mélange d’herbes et d’épices, d’abord en usage au Moyen-Orient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "293ae975-ecb6-4f3d-a315-02a8e9e95410",
                                "sense_id": "65327a03-734b-3c1f-b5c0-ac1a53b326f6",
                                "text": "Le chef londonien [Yotam Ottolenghi] voue une passion au zaatar, cette \"poussière magique\" qui a le parfum de son enfance à Jérusalem, et l'associe à la betterave ou à la butternut rôtie."
                            },
                            {
                                "example_id": "0237225e-eaba-413b-b53c-7a9e9d3f8ece",
                                "sense_id": "65327a03-734b-3c1f-b5c0-ac1a53b326f6",
                                "text": "Top avec de la menthe et une pincée de zaatar."
                            },
                            {
                                "example_id": "218dcdcd-b8d3-4e45-a044-93ef4904553c",
                                "sense_id": "65327a03-734b-3c1f-b5c0-ac1a53b326f6",
                                "text": "Saler les œufs et mettre quelques pincées de zaatar."
                            }
                        ]
                    }
