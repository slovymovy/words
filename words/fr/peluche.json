            "pos": "noun",
            "senses": [
                {
                    "sense_id": "46a7117b-cb48-3d97-b13d-3e9813da3cef",
                    "sense_definition": "Jouet ou figurine en tissu doux et rembourré, représentant le plus souvent un animal.",
