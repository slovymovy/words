                    {
                        "translation_id": "1246793e-f0ac-46f0-865e-4e56eab35f72",
                        "source_entry_id": "e9280da1-33f1-34fd-9003-bc8fb438e7c0",
                        "source_sense_id": "5884499d-c401-3c88-83d8-0629cbdc29ed",
                        "source_sense_description": "vrijzwemmend, voornamelijk in zee levend ongewerveld dier met een geleiachtig lichaam in de vorm van een klok of paraplu",
                        "target_lang_word": "méduse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méduse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e32b0f79-5a14-3df8-8841-01d3fb373cda",
                                        "entry_id": "b81b404a-40d4-3205-8712-fa7d1aef0488",
                                        "glosses": [
                                            "Personne laide et repoussante."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff5a449e-1445-45e0-919c-b2f36f318081",
                                                "sense_id": "e32b0f79-5a14-3df8-8841-01d3fb373cda",
                                                "text": "Ses petits cheveux filasse, frisottants, hérissés autour du front, lui donnait un aspect farouche de méduse domestique tel qu’il fit reculer Théodore et Julot […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fde7fc07-8ae1-3a5a-b300-6b552917f93a",
                                        "entry_id": "b81b404a-40d4-3205-8712-fa7d1aef0488",
                                        "glosses": [
                                            "Zoophyte marin au corps gélatineux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1f6ff5b-4816-4344-b611-86979f52ca83",
                                                "sense_id": "fde7fc07-8ae1-3a5a-b300-6b552917f93a",
                                                "text": "Tant de choses se perdent en ce voyage de la tête à la main ! À voir dans les profondeurs du rêve, l’idée du livre ressemble à ces jolies méduses de la Méditerranée qui passent dans la mer comme des nuances flottantes ; posées sur le sable, ce n’est plus qu’un peu d’eau, quelques gouttes décolorées que le vent sèche tout de suite."
                                            },
                                            {
                                                "example_id": "bbd64ebd-6498-4491-989e-5c67f7b7372c",
                                                "sense_id": "fde7fc07-8ae1-3a5a-b300-6b552917f93a",
                                                "text": "Sous mes yeux, une méduse heurtait la vitre de l’aquarium, fronçait mollement sa collerette, s’effilochait dans les ténèbres."
                                            },
                                            {
                                                "example_id": "cba8c81b-40b2-4522-9f7c-b35dce8cdac1",
                                                "sense_id": "fde7fc07-8ae1-3a5a-b300-6b552917f93a",
                                                "text": "Le corps des méduses est phosphorescent pendant la nuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1304b0d-e466-3e73-8930-79da79480153",
                                        "entry_id": "b81b404a-40d4-3205-8712-fa7d1aef0488",
                                        "glosses": [
                                            "(Figuré)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26eed9f8-1d16-4680-98fc-61d2438b4db7",
                                                "sense_id": "a1304b0d-e466-3e73-8930-79da79480153",
                                                "text": "« Et avec ça des seins en méduse, très larges et manquant de saillie ». Car la femme, même affectueuse, juge durement la femme…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d70515a-3a96-33e6-b85a-79d6abd5e3a7",
                                        "entry_id": "b81b404a-40d4-3205-8712-fa7d1aef0488",
                                        "glosses": [
                                            "Individu d'une société créolisée, vivant sans racines, sans attaches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88fe645c-641b-4635-be96-7a19757a582a",
                                                "sense_id": "1d70515a-3a96-33e6-b85a-79d6abd5e3a7",
                                                "text": "Pour l'heure, en effet, la créolisation du monde génère une société de méduses, d'être apatrides flottant sans attaches ni famille dans un monde dépourvu de sens."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
