                    },
                    {
                        "translation_id": "73a228e9-b22b-4e2f-9d5a-bf79418a0820",
                        "source_entry_id": "c1c229fe-0a15-3bb1-9021-a72fae31211a",
                        "source_sense_description": "deleting syllables",
                        "target_lang_word": "Haplologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haplologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2076b84e-552b-3411-9a8d-5f84eda56468",
                                        "entry_id": "20143800-4110-398b-a6c2-cf7c21adf786",
                                        "glosses": [
                                            "Kürzung einer von zwei gleichen oder ähnlichen Silben in Folge; spezielle Form der Dissimilation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60041e3f-d86a-4c7b-a66e-688997ceb889",
                                                "sense_id": "2076b84e-552b-3411-9a8d-5f84eda56468",
                                                "text": "Ein oft zitiertes Beispiel für eine Haplologie im Deutschen ist die Kürzung von an sich korrektem „Zaubererin“ zu „Zauberin“."
                                            },
                                            {
                                                "example_id": "ab794c9e-6ac8-478b-9145-790aa9048403",
                                                "sense_id": "2076b84e-552b-3411-9a8d-5f84eda56468",
                                                "text": "Die Haplologie dient der Vermeidung von zwei gleich- oder ähnlich lautenden Silben in Folge."
                                            },
                                            {
                                                "example_id": "f68ff1d1-049f-4d23-a35a-2d5a57839341",
                                                "sense_id": "2076b84e-552b-3411-9a8d-5f84eda56468",
                                                "text": "„Bei der Haplologie oder Silbenschichtung werden zwei gleiche Lautfolgen zu einer einzigen vereinfacht.“"
                                            },
                                            {
                                                "example_id": "cc421c27-f72a-48c6-94b9-cadabd0cabcb",
                                                "sense_id": "2076b84e-552b-3411-9a8d-5f84eda56468",
                                                "text": "„Zwei in demselben Wort stehende ähnliche oder (vor allem im Konsonantismus) gleiche Silben bzw. Wortstücke können »Silbenschichtung« (Haplologie) erleiden, d. h. das eine der beiden gleichartigen Elemente wird ausgestoßen.“"
                                            },
                                            {
                                                "example_id": "008d1133-e0e5-43f7-9344-efe04bf2c3ac",
                                                "sense_id": "2076b84e-552b-3411-9a8d-5f84eda56468",
                                                "text": "„Dissimilation und Haplologie sind aber noch nicht die zwei einzigen Strategien der Gleichklangvermeidung, die systematisch verfügbar sind.“"
                                            },
                                            {
                                                "example_id": "ed3a2d91-6190-446e-af9d-3ab395ce6033",
                                                "sense_id": "2076b84e-552b-3411-9a8d-5f84eda56468",
                                                "text": "„Man nennt diese Erscheinung Silbenschichtung oder mit dem Fremdwort Haplologie, das schnurrigerweise selbst Gelegenheit für die bietet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d590736-f173-421c-a1b8-bd21927ae42a",
                        "source_entry_id": "c1c229fe-0a15-3bb1-9021-a72fae31211a",
                        "source_sense_description": "deleting syllables",
                        "target_lang_word": "Silbenschichtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Silbenschichtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7744e8e-c787-337c-8f7b-9e1d9704e538",
                                        "entry_id": "94859ca7-aca8-3ccf-bb77-3708ea50062b",
                                        "glosses": [
                                            "Kürzung einer von zwei gleichen oder ähnlichen Silben in Folge; spezielle Form der Dissimilation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc58b6fe-fceb-4b14-a047-4e4f1ce08c80",
                                                "sense_id": "f7744e8e-c787-337c-8f7b-9e1d9704e538",
                                                "text": "„Man nennt diese Erscheinung Silbenschichtung oder mit dem Fremdwort Haplologie, das schnurrigerweise selbst Gelegenheit für sie bildet.“"
                                            },
                                            {
                                                "example_id": "84fbdadc-303f-4889-aa6f-d24020975af6",
                                                "sense_id": "f7744e8e-c787-337c-8f7b-9e1d9704e538",
                                                "text": "„Bei der Haplologie oder Silbenschichtung werden zwei gleiche Lautfolgen zu einer einzigen vereinfacht.“"
                                            },
                                            {
                                                "example_id": "d50428f9-ab0f-4dbe-ae79-4b418208a990",
                                                "sense_id": "f7744e8e-c787-337c-8f7b-9e1d9704e538",
                                                "text": "„Haplologie (Silbenschichtung) nennt man die Erscheinung, daß zwei gleiche sich berührende Elemente bzw. Silben bei der Zusammensetzung nur einmal auftreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
