                        "sense_id": "39152650-1044-3a0f-acd4-81039ffd4661",
                        "entry_id": "7845d3df-9e49-3faa-8f92-6e94542b6e8d",
                        "glosses": [
                            "to run (across), to cross (at a run [running])"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab8699c1-72c7-49ab-aed0-004e8b1dd133",
                                "sense_id": "39152650-1044-3a0f-acd4-81039ffd4661",
                                "text": "перебежа́ть через доро́гу",
                                "translation": "to run across the road",
                                "english": "to run across the road"
                            },
                            {
                                "example_id": "d93d6337-d624-43eb-87a5-eb736e922150",
                                "sense_id": "39152650-1044-3a0f-acd4-81039ffd4661",
                                "text": "перебежа́ть у́лицу",
                                "translation": "to run across the street; cross the street (running)",
                                "english": "to run across the street; cross the street (running)"
                            },
                            {
                                "example_id": "7942cff1-8955-4a88-a26e-4ca391fe1659",
                                "sense_id": "39152650-1044-3a0f-acd4-81039ffd4661",
                                "text": "перебежа́ть на но́вое ме́сто",
                                "translation": "to run to a new place",
                                "english": "to run to a new place"
                            },
                            {
                                "example_id": "f296d6e5-3c9e-43b4-a529-ae539198c717",
                                "sense_id": "39152650-1044-3a0f-acd4-81039ffd4661",
                                "text": "перебежа́ть доро́гу кому́-либо",
                                "translation": "to steal a march on someone; snatch something from under someone's nose",
                                "english": "to steal a march on someone; snatch something from under someone's nose"
                            }
                        ]
                    },
