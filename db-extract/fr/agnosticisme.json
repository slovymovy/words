                "senses": [
                    {
                        "sense_id": "ec7df145-f331-37a3-9401-732b0879c14e",
                        "entry_id": "dc3e805b-0072-334d-9528-2586219d9b20",
                        "glosses": [
                            "Doctrine selon laquelle l’absolu ne peut être appréhendé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a54d865-66b4-4c1a-a05a-f08217934406",
                                "sense_id": "ec7df145-f331-37a3-9401-732b0879c14e",
                                "text": "Ses ouvrages […] contiennent nombre de pensées inspirées par ce vaillant optimisme matérialiste et orientées contre l’agnosticisme, le relativisme et d’autres variétés d’idéalisme."
                            },
                            {
                                "example_id": "802fe2c6-0220-4bf7-863f-d704a1219740",
                                "sense_id": "ec7df145-f331-37a3-9401-732b0879c14e",
                                "text": "Euripide a laissé entendre dans son théâtre qu’il ne faut pas croire aux mensonges de la fable et trahit parfois dans ses vers un agnosticisme complet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50bae945-a4f7-4905-9853-3b8919a532e6",
                        "source_entry_id": "dc3e805b-0072-334d-9528-2586219d9b20",
                        "source_sense_id": "ec7df145-f331-37a3-9401-732b0879c14e",
                        "target_lang_word": "Agnostizismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agnostizismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f47d65cd-2591-3e2e-84da-fd017d5381f9",
                                        "entry_id": "4a7a6122-c67c-3785-863f-f980b86a7214",
                                        "glosses": [
                                            "philosophische und theologische Weltanschauung, nach der die Existenz oder Nichtexistenz eines höheren Wesens entweder unbekannt oder grundsätzlich unerkennbar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef133ac-35c3-4481-b4f1-0d00bf36b7d7",
                                                "sense_id": "f47d65cd-2591-3e2e-84da-fd017d5381f9",
                                                "text": "Der Agnostizismus ordnet die im Theismus, also beispielsweise die in Judentum, Christentum, Islam oder Hinduismus angeführten Hinweise und Beweisversuche dafür, dass es ein göttliches Wesen gebe, als unzureichend ein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f207d7c7-1ad9-3b7a-9699-7b2225cecbf1",
                                        "entry_id": "4a7a6122-c67c-3785-863f-f980b86a7214",
                                        "glosses": [
                                            "allgemeiner die These von der Unerkennbarkeit metaphysischer oder erkenntnistheoretischer Aspekte"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
