                                        "sense_id": "b2dfbee5-b864-307b-a880-732f3ed7dc8c",
                                        "entry_id": "1e94679e-8401-3fad-895f-2727b13394ed",
                                        "glosses": [
                                            "Résultat de l'action de décliner ou cette action elle-même : variation, affaiblissement, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a2863aa-d1d3-4048-96c1-9d093c68f44b",
                                                "sense_id": "b2dfbee5-b864-307b-a880-732f3ed7dc8c",
                                                "text": "Des ersatz du repas classique, comme le snacking, se sont mêlés à cette déclinaison classique, susceptibles de modifier nos habitudes non seulement comportementales mais aussi métaboliques et de déplacer le curseur de notre faim."
                                            }
                                        ]
                                    }
                                ]
                            }
