                "senses": [
                    {
                        "sense_id": "abf2a62d-4e82-3760-bd1e-9811fd68c6ad",
                        "entry_id": "3f5ab6b4-d207-3313-b1d2-2be97effe130",
                        "glosses": [
                            "Sichtbarwerden eines Fehlers beim Anwender oder Tester"
                        ],
                        "tags": [
                            "Softwaretesten"
                        ],
                        "examples": [
                            {
                                "example_id": "22a8cdf4-87ff-4ffa-bc09-abb8ec534dbe",
                                "sense_id": "abf2a62d-4e82-3760-bd1e-9811fd68c6ad",
                                "text": "Eine Fehlermaskierung ist ein Zustand, wenn mindestens zwei Fehlerzustände sich gegenseitig nach außen hin derart kompensieren, dass keine Fehlerwirkung auftritt, bis einer der maskierten Fehler korrigiert ist."
                            },
                            {
                                "example_id": "ce988037-5a1c-4bbb-98f0-ab169a0d66c9",
                                "sense_id": "abf2a62d-4e82-3760-bd1e-9811fd68c6ad",
                                "text": "Das Auftreten eines oder mehrerer Fehlerzustände nennt man eine Fehlerwirkung."
                            },
                            {
                                "example_id": "f9772691-ebf6-45b1-82b3-36cd25ffc789",
                                "sense_id": "abf2a62d-4e82-3760-bd1e-9811fd68c6ad",
                                "text": "Auch den Unterschied zwischen realisiertem Ist-Wert und angestrebtem Soll-Wert kann man Fehlerwirkung nennen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
