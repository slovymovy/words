{
    "word_family": [
        "заправка",
        "заправочный",
        "заправщик",
        "заправлять",
        "правило",
        "править"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e2c08eb-1ac7-3c4d-a76b-7eb8a5528d97",
                    "sense_definition": "Вставить, подвернуть или уложить край чего-либо внутрь или в надлежащее место, придавая аккуратный вид",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tuck_in",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед выходом на работу он аккуратно <w>заправил</w> рубашку в брюки.",
                            "target_lang_translations": {
                                "pl": "Przed wyjściem do pracy starannie <w>włożył</w> koszulę w spodnie."
                            }
                        },
                        {
                            "text": "Каждое утро после сна нужно красиво <w>заправить</w> постель покрывалом.",
                            "target_lang_translations": {
                                "pl": "Każdego ranka po przebudzeniu należy ładnie <w>zasłać</w> łóżko narzutą."
                            }
                        }
                    ],
                    "synonyms": [
                        "подвернуть",
                        "подоткнуть"
                    ],
                    "antonyms": [
                        "выправить"
                    ],
                    "common_phrases": [
                        "заправить рубашку в брюки",
                        "заправить постель",
                        "заправить кровать"
                    ],
                    "target_lang_definitions": {
                        "pl": "Włożyć lub wsunąć coś (np. koszulę w spodnie) albo starannie pościelić łóżko"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "włożyć",
                                "target_lang_sense_clarification": "np. koszulę w spodnie"
                            },
                            {
                                "target_lang_word": "wetknąć",
                                "target_lang_sense_clarification": "wepchnąć za pas"
                            },
                            {
                                "target_lang_word": "zasłać",
                                "target_lang_sense_clarification": "o łóżku, pościeli"
                            },
                            {
                                "target_lang_word": "pościelić",
                                "target_lang_sense_clarification": "uporządkować pościel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a24ae8be-36cc-36bf-a397-edfb652e9628",
                    "sense_definition": "Добавить в пищу приправу, масло, соус или другие ингредиенты для улучшения вкуса",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама решила <w>заправить</w> свежий салат оливковым маслом и лимонным соком.",
                            "target_lang_translations": {
                                "pl": "Mama postanowiła <w>przyprawić</w> świeżą sałatkę oliwą z oliwek i sokiem z cytryny."
                            }
                        },
                        {
                            "text": "Перед самой подачей на стол горячий борщ обычно <w>заправляют</w> густой сметаной.",
                            "target_lang_translations": {
                                "pl": "Tuż przed podaniem na stół gorący barszcz zazwyczaj <w>zaprawia się</w> gęstą śmietaną."
                            }
                        }
                    ],
                    "synonyms": [
                        "сдобрить",
                        "приправить"
                    ],
                    "common_phrases": [
                        "заправить салат маслом",
                        "заправить суп сметаной"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dodać do potrawy przyprawy, sos, oliwę lub śmietanę w celu poprawy smaku"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przyprawić",
                                "target_lang_sense_clarification": "ogólnie dodać przypraw"
                            },
                            {
                                "target_lang_word": "doprawić",
                                "target_lang_sense_clarification": "do smaku"
                            },
                            {
                                "target_lang_word": "zaprawić",
                                "target_lang_sense_clarification": "np. zupę śmietaną, sałatkę sosem"
                            },
                            {
                                "target_lang_word": "polać",
                                "target_lang_sense_clarification": "np. sałatkę sosem vinaigrette"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1036571a-1cb3-31df-b3a8-891f5e39c96f",
                    "sense_definition": "Наполнить резервуар машины или механизма топливом, горючим или иной необходимой жидкостью",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "refuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед дальней поездкой водителю пришлось полностью <w>заправить</w> бак бензином.",
                            "target_lang_translations": {
                                "pl": "Przed daleką podróżą kierowca musiał <w>zatankować</w> bak benzyną do pełna."
                            }
                        },
                        {
                            "text": "Мы остановились около дороги, чтобы <w>заправить</w> автомобиль топливом.",
                            "target_lang_translations": {
                                "pl": "Zatrzymaliśmy się przy drodze, aby <w>zatankować</w> samochód."
                            }
                        }
                    ],
                    "synonyms": [
                        "наполнить"
                    ],
                    "common_phrases": [
                        "заправить автомобиль",
                        "заправить бак горючим"
                    ],
                    "target_lang_definitions": {
                        "pl": "Napełnić zbiornik pojazdu lub maszyny paliwem"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zatankować",
                                "target_lang_sense_clarification": "paliwo do baku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d606399c-b35d-3c3a-9315-2546007fe1aa",
                    "sense_definition": "Вставить расходный материал или деталь в устройство либо аппарат для обеспечения его работы",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "insert_feed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед началом работы мастер помог ученице правильно <w>заправить</w> нитку в швейную машину.",
                            "target_lang_translations": {
                                "pl": "Przed rozpoczęciem pracy mistrz pomógł uczennicy prawidłowo <w>nawlec</w> nić do maszyny do szycia."
                            }
                        },
                        {
                            "text": "Специалист аккуратно открыл крышку прибора, чтобы <w>заправить</w> новую бумагу в принтер.",
                            "target_lang_translations": {
                                "pl": "Specjalista ostrożnie otworzył pokrywę urządzenia, aby <w>założyć</w> nowy papier do drukarki."
                            }
                        }
                    ],
                    "synonyms": [
                        "вставить",
                        "вдеть"
                    ],
                    "common_phrases": [
                        "заправить нитку в иголку",
                        "заправить бумагу в принтер"
                    ],
                    "target_lang_definitions": {
                        "pl": "Umieścić materiał eksploatacyjny lub element (np. papier, nitkę) w urządzeniu"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nawlec",
                                "target_lang_sense_clarification": "o nitce do maszyny lub igły"
                            },
                            {
                                "target_lang_word": "założyć",
                                "target_lang_sense_clarification": "o papierze do drukarki, taśmie"
                            },
                            {
                                "target_lang_word": "załadować",
                                "target_lang_sense_clarification": "o wkładzie, papierze"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}