                        ],
                        "examples": [
                            {
                                "example_id": "fed61560-649c-499e-afa9-99afef95726d",
                                "sense_id": "1567d8aa-1ea8-3d35-ad8d-4a96125d3acc",
                                "text": "Sa réputation, son talent va decrescendo."
                            },
                            {
                                "example_id": "e021121e-5aac-48cb-ad56-f5c6d6056fcc",
                                "sense_id": "1567d8aa-1ea8-3d35-ad8d-4a96125d3acc",
                                "text": "Le décès datait de quarante jours. Poc-Anach, à ce coup, ouvrit les yeux tout grands et fit entendre un fort et interminable decrescendo de pneu ballon qui se dégonfle."
                            }
                        ]
                    }
                ],
