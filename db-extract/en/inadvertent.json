                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "77e2b309-66e0-42a7-b1b3-b4f0df633b24",
                                "sense_id": "e7111ad9-357c-3fb2-a8cd-66a8a76e64a7",
                                "text": "The Sharpers about Town very ingeniously understood themselves to be the undesigning Part of Mankind what Foxes are to Lambs, and therefore used the Word Biting to express any Exploit wherein they had over-reach'd any innocent and inadvertent Man of his Purse."
                            }
                        ]
                    }
                ],
