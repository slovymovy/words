                                        "entry_id": "038e9d43-bdf9-3903-b68f-d7292ec8da97",
                                        "glosses": [
                                            "Sexually aroused, with or without physical manifestation; experiencing a feeling of sexual desire."
                                        ],
                                        "tags": [
                                            "slang"
