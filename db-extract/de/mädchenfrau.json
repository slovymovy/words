                "senses": [
                    {
                        "sense_id": "4ba48dad-8be4-324c-b349-f1040043b07c",
                        "entry_id": "ecdda431-bf14-3836-9242-dc9072beee84",
                        "glosses": [
                            "eine mädchenhaft aussehende und sich gebende Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7570d625-20be-4676-bc3e-dd389ce73aa0",
                                "sense_id": "4ba48dad-8be4-324c-b349-f1040043b07c",
                                "text": "Petra ist die typische Mädchenfrau."
                            },
                            {
                                "example_id": "4db72aa6-318f-4eb8-aa77-9fbe385762c6",
                                "sense_id": "4ba48dad-8be4-324c-b349-f1040043b07c",
                                "text": "„An dieser Rolle einer Mädchenfrau, die einfach wie sie ist, geliebt werden und ihre eigenen moralischen Grenzen bestimmen will, sich gleichzeitig prostituiert und dabei stets aggressiv-leidend unentdeckt in ihrer Seele bleibt, kann man allzu leicht scheitern.“"
                            },
                            {
                                "example_id": "6cb071c3-9ede-4057-a499-bccfb8d457cc",
                                "sense_id": "4ba48dad-8be4-324c-b349-f1040043b07c",
                                "text": "„Selbst aus dem Jungbrunnen kommen Cranachs ohnehin schablonenhafte Mädchenfrauen etwas anämisch, verglichen mit der überquellenden, nahezu erdrückenden Opulenz der »Zwei Hexen« des Dürer-Schülers Hans Baldung, genannt Grien, von 1523.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
