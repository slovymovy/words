                            {
                                "example_id": "73d80971-9977-46da-a102-4cbbc831c0d2",
                                "sense_id": "4ab9721b-257c-3390-9c5c-b80d3a6b2e11",
                                "text": "„Er kaufte ihr eine Handvoll Heliumballons von einem Straßenverkäufer, eine einfache romantische Geste, die Maxwell - bei all seiner überragenden Intelligenz - nie in den Sinn gekommen wäre.“"
                            },
                            {
                                "example_id": "6a6e958d-9679-455b-be6a-554117372065",
                                "sense_id": "4ab9721b-257c-3390-9c5c-b80d3a6b2e11",
                                "text": "„Dann verkaufen Erwachsene für hundert Dollar Heliumballons an Kinder, die doch von nichts eine Ahnung haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
