                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd21778f-19cc-42bc-8705-32e3d98d1ec5",
                                                "sense_id": "dc785e74-6f03-36b6-b8f6-e672c6885bcb",
                                                "text": "Commettre un délit."
                                            },
