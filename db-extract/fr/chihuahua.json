            {
                "entry_id": "34a0c999-de61-363d-a90e-57042a75852a",
                "word": "chihuahua",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c88c2732-e64d-48cb-8ef2-55456edf21fd",
                        "entry_id": "34a0c999-de61-363d-a90e-57042a75852a",
                        "tags": [
                            "plural"
                        ],
                        "form": "chihuahuas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9898e81f-55d3-3ebc-ac0d-6b029576af71",
                        "entry_id": "34a0c999-de61-363d-a90e-57042a75852a",
                        "glosses": [
                            "Race de très petit chien de compagnie, originaire du Mexique, le chien le plus petit du monde, à poil court ou à poil long."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "3b3da0f8-28a7-47a2-96b0-04119df78da6",
                                "sense_id": "9898e81f-55d3-3ebc-ac0d-6b029576af71",
                                "text": "As-tu vu ça, kid ? Comme un p’tit chien ! T’arais dû voir ça, y’a vingt ans. Moé, j’étais Xavier Cugat, pis lui c’tait mon chihuahua."
                            },
                            {
                                "example_id": "b80b9970-aca1-47ba-bf69-a933cf25c838",
                                "sense_id": "9898e81f-55d3-3ebc-ac0d-6b029576af71",
                                "text": "À Coconut Grove, un type promène six chihuahuas en laisse et ramasse leur merde avec un gant en plastique."
                            },
                            {
                                "example_id": "8dbf32ec-c0c6-4360-8b28-e633eb0a258c",
                                "sense_id": "9898e81f-55d3-3ebc-ac0d-6b029576af71",
                                "text": "Selon son vétérinaire, Pearl le chihuahua mesure 9,4 cm de haut et 12,7 cm de long, loin d’atteindre par exemple les dimensions d’un billet de 1 $ US."
                            }
                        ]
                    },
                    {
                        "sense_id": "aeb651c2-3118-377a-bcc5-64ef33b1b20f",
                        "entry_id": "34a0c999-de61-363d-a90e-57042a75852a",
                        "glosses": [
                            "Personne qui crie et s'énerve pour un rien."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9ae0f2a8-cdbf-4658-b32b-11558009f202",
                                "sense_id": "aeb651c2-3118-377a-bcc5-64ef33b1b20f",
                                "text": "Je sais, je sais, peu importe ce que fait le gouvernemaman, il ne faut pas critiquer. Ça réveille les chihuahuas du lazy-boy.\nLa moindre pointe vaut à son auteur des insultes."
                            },
                            {
                                "example_id": "3c28005b-eb67-42a6-81c0-c2a6373e775d",
                                "sense_id": "aeb651c2-3118-377a-bcc5-64ef33b1b20f",
                                "text": "— Il est hors de question de rapporter ce nain avec nous !\n— Quoi ?!? Vous oubliez que c’est moi qui commande, ici !\n— Ouais, mais c’est moi qui conduis… Et ton chihuahua m’a mordue…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dbfab8c-b7f1-4a88-9d13-750c729fa33d",
                        "source_entry_id": "34a0c999-de61-363d-a90e-57042a75852a",
                        "target_lang_word": "Chihuahua",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chihuahua",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03126257-04e8-3710-80ec-97388a862f36",
                                        "entry_id": "9770522c-9aa3-38b9-88a5-a6f33a72dfd8",
                                        "glosses": [
                                            "weltweit kleinste anerkannte Hunderasse, ursprünglich aus Mexiko"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23e28bcc-1173-4996-a5b7-c70e31327f22",
                                                "sense_id": "03126257-04e8-3710-80ec-97388a862f36",
                                                "text": "In Europa ist der Chihuahua nicht sehr verbreitet."
                                            },
                                            {
                                                "example_id": "710e59ff-f9b6-4420-b1db-311b0e17f1e1",
                                                "sense_id": "03126257-04e8-3710-80ec-97388a862f36",
                                                "text": "„Der eine führt einen Dobermann Pinscher und der zweite einen Chihuahua.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Chihuahua",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f68a4918-7f62-3e64-be58-ed6532965c03",
                                        "entry_id": "45c8fa98-1671-3840-bf46-5cf900c90726",
                                        "glosses": [
                                            "Wüste im Grenzgebiet der USA und Mexikos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "910fd927-de86-4d2b-9c39-dc576ac38158",
                                                "sense_id": "f68a4918-7f62-3e64-be58-ed6532965c03",
                                                "text": "Die Gipswüste „White Sands“ ist der ungewöhnlichste Teil der Chihuahua."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Chihuahua",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8b1f4d0-5f48-3126-8ad9-a323e959a940",
                                        "entry_id": "a6523053-5e0e-359c-af3a-5cf70df9c768",
                                        "glosses": [
                                            "Stadt in Mexiko"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "195aca92-8c43-4c19-b345-16e0817c11bb",
                                                "sense_id": "a8b1f4d0-5f48-3126-8ad9-a323e959a940",
                                                "text": "Mit rund 800.000 Einwohnern steht Chihuahua an zwölfter Stelle der Städte Mexikos."
                                            },
                                            {
                                                "example_id": "a9dbb25d-6586-4296-8390-f808b10e24d1",
                                                "sense_id": "a8b1f4d0-5f48-3126-8ad9-a323e959a940",
                                                "text": "„Als Colonel Doniphan die Stadt Chihuahua eingenommen hat, gab es auf Feindesseite über tausend Gefallene; er selber hat bloß einen einzigen Mann verloren, und den durch Selbstmord.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea7ebb98-6cca-3eba-9253-78b4c7ce0ed9",
                                        "entry_id": "a6523053-5e0e-359c-af3a-5cf70df9c768",
                                        "glosses": [
                                            "mexikanischer Bundesstaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e35b484-5216-491d-a59c-d41bb5e9d11b",
                                                "sense_id": "ea7ebb98-6cca-3eba-9253-78b4c7ce0ed9",
                                                "text": "Die sogenannte Kupferschlucht liegt in Chihuahua und entstand durch einen ehemals starken Flusslauf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
