                        ]
                    },
                    {
                        "sense_id": "6fad8e0b-38e7-318b-b814-185ae30f4fd8",
                        "entry_id": "1fa797d1-e997-30d9-9f9a-c0003b9a1d1e",
                        "glosses": [
                            "By which."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "be2dedf3-31b9-48eb-8a00-230473aa2d9b",
                                "sense_id": "6fad8e0b-38e7-318b-b814-185ae30f4fd8",
                                "text": "Shylock:\nNay, take my life and all; pardon not that:\nYou take my house when you do take the prop\nThat doth sustain my house; you take my life\nWhen you do take the means whereby I live."
                            },
                            {
                                "example_id": "ff0901cb-e9f9-4c38-b2b9-74afb43f39f4",
                                "sense_id": "6fad8e0b-38e7-318b-b814-185ae30f4fd8",
                                "text": "M. Sawrey […] devised a mechanical method whereby theatrical scenes could be changed in a simple way."
                            },
                            {
                                "example_id": "735ded74-e5a7-438f-9a0a-c55f74ad417f",
                                "sense_id": "6fad8e0b-38e7-318b-b814-185ae30f4fd8",
                                "text": "Other heads saw devolution as a whole new way of life and adopted an approach whereby the power of devolution was used to enable the school to drive the curriculum."
                            }
                        ]
                    },
                    {
                        "sense_id": "a76de220-9e3f-39c9-97a0-4ae851eafc4e",
                        "entry_id": "1fa797d1-e997-30d9-9f9a-c0003b9a1d1e",
                        "glosses": [
                            "Where, wherein, in which."
                        ],
                        "tags": [
                            "nonstandard",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "889a65fc-b61a-4e6f-ab5c-15b0d096f438",
                                "sense_id": "a76de220-9e3f-39c9-97a0-4ae851eafc4e",
                                "text": "Because COBOL does not have a date type, some implementations rely instead on a system whereby all dates are coded to a reference point. The most commonly used is May 20, 1875, as this was the date of an international standards-setting conference held in Paris, known as the Convention du Mètre."
                            }
                        ]
                    }
                ],
                "translations": [
