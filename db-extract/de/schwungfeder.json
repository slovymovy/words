                    {
                        "sense_id": "775fe82e-b961-3f26-9fec-c6419ed09371",
                        "entry_id": "9449ca4b-cb06-3fa2-a228-6ee19f4e63a0",
                        "glosses": [
                            "an Hand und Unterarm sitzende, große und steife Feder, die die eigentliche Tragfläche des Vogelflügels bildet"
                        ],
                        "tags": [
                            "Vogelkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "cd7059f7-203a-4c93-a0fe-bad0de3602d9",
                                "sense_id": "775fe82e-b961-3f26-9fec-c6419ed09371",
                                "text": "„Das hat ein internationales Forscherteam festgestellt , als es die Fossilien mehrerer Urvögel und gefiederter Dinosaurier näher untersuchte. Demnach fehlten dem Archaeopteryx und dem gefiederten Dinosaurier Anchiornis die säuberlich gestaffelten Deck- und Schwungfedern ihrer heutigen Nachfahren. Stattdessen lagen bei ihnen die noch sehr dünnen Federn in mehreren, fast gleich langen Schichten übereinander, wie die Forscher im Wissenschaftsmagazin Current Biology berichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
