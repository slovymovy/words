                                "target_senses": [
                                    {
                                        "sense_id": "fadc45ea-ed07-3480-8e63-a869fef61929",
                                        "entry_id": "9eb0e6ed-f387-347c-82b1-7881f729af83",
                                        "glosses": [
                                            "eine Art Fernrohr, das einen Blick (zum Beispiel aus Unterseebooten) nach draußen ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18c54ace-9f06-44c1-92b4-dcaa63308555",
                                                "sense_id": "fadc45ea-ed07-3480-8e63-a869fef61929",
                                                "text": "Das U-Boot fuhr das Periskop aus."
                                            },
                                            {
                                                "example_id": "25a506df-14c7-4c40-96ee-4e6602c9274b",
                                                "sense_id": "fadc45ea-ed07-3480-8e63-a869fef61929",
                                                "text": "„Mein Lieblingsautomat war der mit dem Periskop - hier spielte man Seeschlacht.“"
                                            },
                                            {
                                                "example_id": "f02e3d18-305c-45fb-bb2c-92a6b81ac325",
                                                "sense_id": "fadc45ea-ed07-3480-8e63-a869fef61929",
                                                "text": "„Mittig wie ein Fels in der Brandung stand das Periskop.“"
                                            },
                                            {
                                                "example_id": "24c19ba9-ab8a-4918-a4e2-a0f48cb97221",
                                                "sense_id": "fadc45ea-ed07-3480-8e63-a869fef61929",
                                                "text": "„Aber als er seinen ersten Dampfer ins Periskop bekam, soll er vor lauter Aufregung geheult haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
