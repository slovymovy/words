                        "glosses": [
                            "Terrasse, véranda en Afrique australe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a26bd4-6be1-486c-a656-f0d7b5177b25",
                                "sense_id": "33b451c2-41ee-3ea5-b17f-23c0818f3515",
                                "text": "Assis sous ce stoep familier, égaré dans ses souvenirs stériles, Abraham Hugo toisa l’horizon. Le passé ne disparaissait jamais vraiment. Il était là, toujours présent au fond de lui. Et son avenir avait été écrit il y avait bien longtemps. Avant même le jour de sa naissance. Quand Pa Frans avait croisé le regard de la belle Lindiwe."
                            },
                            {
                                "example_id": "19547ec2-44bf-4dc4-bc61-fbe643a2b9ee",
                                "sense_id": "33b451c2-41ee-3ea5-b17f-23c0818f3515",
                                "text": "Horstley Street qui est une rue pavée, était autrefois bordée de petites maisons proprettes avec un stoep sur le devant d'où les habitants se saluaient."
                            },
                            {
                                "example_id": "ba5a632a-ea34-4b83-b92d-24009cff1bcb",
                                "sense_id": "33b451c2-41ee-3ea5-b17f-23c0818f3515",
                                "text": "Durant les trois années où il terrorisa le village, le capitaine Nunes se faisait raser par sa fille Frieda, sur le stoep."
                            }
                        ]
                    }
