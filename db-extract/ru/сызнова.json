        "ru-extract.jsonl": [
            {
                "entry_id": "cf656b12-c9b0-3fa7-8288-a3b027412d39",
                "word": "сызнова",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b0e365bc-da8f-3e0b-8ea9-96f29495a8bc",
                        "entry_id": "cf656b12-c9b0-3fa7-8288-a3b027412d39",
                        "glosses": [
                            "опять, снова, в очередной раз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4dc9644-21d2-4ed5-b380-62357ecb18f7",
                                "sense_id": "b0e365bc-da8f-3e0b-8ea9-96f29495a8bc",
                                "text": "И сейчас разденут раба божьего до нитки: ступай и начинай маяться сызнова."
                            },
                            {
                                "example_id": "26a0b7f9-0df3-4fb4-a285-f64fc8dbd789",
                                "sense_id": "b0e365bc-da8f-3e0b-8ea9-96f29495a8bc",
                                "text": "Вы старое-то бросьте, забудьте, как будто его вовсе не было, будто снилось оно только, а начинайте жить сызнова."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8845f67-fc8d-4c39-9f96-9e4976679273",
                        "source_entry_id": "cf656b12-c9b0-3fa7-8288-a3b027412d39",
                        "source_sense_id": "b0e365bc-da8f-3e0b-8ea9-96f29495a8bc",
                        "target_lang_word": "anew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3468401c-bfac-31c1-a3a1-168d64e76fe8",
                                        "entry_id": "26ed852a-55e5-3c0e-bea3-a9cf12dd54ca",
                                        "glosses": [
                                            "Again, once more; afresh, in a new way, newly."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "especially",
                                            "formal",
                                            "literary",
                                            "not-comparable",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efd1fcd-4043-4df4-b512-081b445b1f65",
                                                "sense_id": "3468401c-bfac-31c1-a3a1-168d64e76fe8",
                                                "text": "Each morning, opportunity—like the sun—dawns anew."
                                            },
                                            {
                                                "example_id": "946f5902-3aac-4c99-a702-43cfb471eea9",
                                                "sense_id": "3468401c-bfac-31c1-a3a1-168d64e76fe8",
                                                "text": "Then they set somewhat of food before me, whereof I ate my fill, and gave me somewhat of clothes wherewith I clad myself anew and covered my nakedness; after which they took me up into the ship, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47f2b972-f3c9-4cf7-b1ab-4f609f1b1a39",
                        "source_entry_id": "cf656b12-c9b0-3fa7-8288-a3b027412d39",
                        "source_sense_id": "b0e365bc-da8f-3e0b-8ea9-96f29495a8bc",
                        "target_lang_word": "erneut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erneut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e14e506c-f697-355d-9053-8980fdc9f422",
                                        "entry_id": "9550b0be-2a11-3cab-99ff-214717456b8d",
                                        "glosses": [
                                            "zum wiederholten Mal in Erscheinung tretend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b013e7e1-5e68-4aeb-b16c-cb7f0a79b2b4",
                                                "sense_id": "e14e506c-f697-355d-9053-8980fdc9f422",
                                                "text": "Als er erneut nach dem Weg fragte, schlug ihn der Taxifahrer mit der Faust ins Gesicht."
                                            },
                                            {
                                                "example_id": "9327e32e-7877-4a15-a3b7-937e24132c9f",
                                                "sense_id": "e14e506c-f697-355d-9053-8980fdc9f422",
                                                "text": "Der Klub versucht in einem erneuten Anlauf die Tabellenspitze zu erreichen."
                                            },
                                            {
                                                "example_id": "fe1e510a-ca7b-42c4-a34c-5f252fc9ab2d",
                                                "sense_id": "e14e506c-f697-355d-9053-8980fdc9f422",
                                                "text": "„Am nächsten Morgen hielt das Rettungsboot mit der Mutter erneut auf die Küste zu.“"
                                            },
                                            {
                                                "example_id": "51a70419-32a7-4e06-ae57-4760eb97c748",
                                                "sense_id": "e14e506c-f697-355d-9053-8980fdc9f422",
                                                "text": "„Doch dann zwingen Angriffe der Wikinger die Hüter der Gebeine erneut zur Flucht.“"
                                            },
                                            {
                                                "example_id": "b99987d7-4a81-47c1-8732-eb2d70e507e8",
                                                "sense_id": "e14e506c-f697-355d-9053-8980fdc9f422",
                                                "text": "Der deutsche Astronaut Alexander Gerst flog 2014 zum ersten Mal zur ISS […]. Von Juni bis Dezember 2018 forscht er erneut auf der ISS […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
