{
    "word_family": [
        "seism",
        "seismology",
        "seismologist",
        "seismograph",
        "seismogram"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "278395c7-7d6e-35eb-94ae-e4bbb7800965",
                    "sense_definition": "Relating to or caused by an earthquake or other vibration of the Earth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "earthquake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The region is known for frequent <w>seismic</w> activity.",
                            "target_lang_translations": {
                                "zh": "该地区以频繁的<w>地震</w>活动而闻名。"
                            }
                        },
                        {
                            "text": "Scientists monitor <w>seismic</w> waves to predict potential volcanic eruptions.",
                            "target_lang_translations": {
                                "zh": "科学家通过监测<w>地震</w>波来预测潜在的火山喷发。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tectonic"
                    ],
                    "common_phrases": [
                        "seismic activity",
                        "seismic waves"
                    ],
                    "target_lang_definitions": {
                        "zh": "与地震或地球其他震动有关的，或由其引起的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "地震的",
                                "target_lang_sense_clarification": "指与地震现象直接相关的。"
                            },
                            {
                                "target_lang_word": "震动的",
                                "target_lang_sense_clarification": "指由地壳震动引起的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0beeded1-29a6-3d86-8f0b-93d4e7b7548d",
                    "sense_definition": "Prone to or frequently experiencing earthquakes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "earthquake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Building codes are very strict in this <w>seismic</w> area.",
                            "target_lang_translations": {
                                "zh": "在这个<w>地震多发</w>区，建筑规范非常严格。"
                            }
                        },
                        {
                            "text": "Engineers designed the bridge to withstand the risks of a <w>seismic</w> zone.",
                            "target_lang_translations": {
                                "zh": "工程师们设计这座桥梁时考虑了<w>地震多发</w>地带的风险。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "seismic area",
                        "seismic zone"
                    ],
                    "target_lang_definitions": {
                        "zh": "易发生地震的或经常经历地震的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "地震多发的",
                                "target_lang_sense_clarification": "形容地理区域地震频繁。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f2bd91e-7fc1-31e7-88b9-e620181ed96c",
                    "sense_definition": "Having a very large, significant, or widespread impact.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company underwent a <w>seismic</w> shift in its business strategy.",
                            "target_lang_translations": {
                                "zh": "该公司的商业战略发生了<w>巨大</w>的转变。"
                            }
                        },
                        {
                            "text": "The election results represent a <w>seismic</w> change in the country's political landscape.",
                            "target_lang_translations": {
                                "zh": "选举结果代表了该国政治格局的<w>重大</w>变革。"
                            }
                        }
                    ],
                    "synonyms": [
                        "monumental",
                        "groundbreaking",
                        "transformative"
                    ],
                    "antonyms": [
                        "insignificant",
                        "minor"
                    ],
                    "common_phrases": [
                        "seismic shift",
                        "seismic change"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有巨大、显著或广泛影响的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "巨大的",
                                "target_lang_sense_clarification": "形容影响深远或变化剧烈。"
                            },
                            {
                                "target_lang_word": "重大的",
                                "target_lang_sense_clarification": "形容具有里程碑意义的改变。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}