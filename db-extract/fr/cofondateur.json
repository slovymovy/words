                        "sense_id": "238d535c-99f7-3c36-966f-204ddd281179",
                        "entry_id": "842add76-c7aa-3115-a90a-d7f302255e57",
                        "glosses": [
                            "Personne qui est a fondé quelque chose avec d’autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac40d73e-d3cd-462c-87df-b54cfd61c59c",
                                "sense_id": "238d535c-99f7-3c36-966f-204ddd281179",
                                "text": "P… forma, avec le concours de plusieurs cofondateurs, une société d'assurances à primes fixes contre l'incendie."
                            },
                            {
                                "example_id": "3a1ff5b2-fe2d-4936-b924-1830a26f7f73",
                                "sense_id": "238d535c-99f7-3c36-966f-204ddd281179",
                                "text": "Nous développons une “tokenisation” de licence de jeux vidéo, explique David Hanson, cofondateur et PDG d’Ultra.io."
                            },
                            {
                                "example_id": "21f57355-5662-470c-a4f0-e5241cad222c",
                                "sense_id": "238d535c-99f7-3c36-966f-204ddd281179",
                                "text": "Mattel, provenant de la contraction du nom de ses deux cofondateurs (Harold « Matt » Matson et Elliot Handler), a vu le jour en 1945 et concevait à l’origine des accessoires pour poupées."
                            }
                        ]
                    }
                ],
                "translations": [
