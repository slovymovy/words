                "senses": [
                    {
                        "sense_id": "c46c3fc6-268a-3356-ac2f-a7ffa7540172",
                        "entry_id": "c020e496-9fa1-38d3-b914-a90d59a8ed99",
                        "glosses": [
                            "Ne plus faire le clown."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b010c61e-ecca-46bf-880b-46ee5509f32f",
                                "sense_id": "c46c3fc6-268a-3356-ac2f-a7ffa7540172",
                                "text": "À force de donner des coups, on y prend goût. On finit par tout culbuter. On déclowne plus."
                            },
                            {
                                "example_id": "c90e911f-be6a-4c3c-b458-9149e67e45a0",
                                "sense_id": "c46c3fc6-268a-3356-ac2f-a7ffa7540172",
                                "text": "Je sens que je fonds et que je me déclowne à vue d’œil."
                            },
                            {
                                "example_id": "be4333cd-004c-4116-af89-080780f386eb",
                                "sense_id": "c46c3fc6-268a-3356-ac2f-a7ffa7540172",
                                "text": "Sauter, rouler, chuter, chanter, clowner ou déclowner, la piste ne manque pas de verbe…"
                            }
                        ]
                    }
                ],
