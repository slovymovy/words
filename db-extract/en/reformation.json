                                    {
                                        "sense_id": "56d514a3-a6ee-3ca3-98e9-051a0a2f5152",
                                        "entry_id": "1c841a02-39a8-3a9c-9d7f-77ff6bf4365b",
                                        "glosses": [
                                            "De beweging tot herstel van de oorspronkelijke zuiverheid in de leer en de gebruiken van de Roomsche Kerk, in het begin van de 16de eeuw door LUTHER begonnen en de oorsprong van het protestantisme. (Vroeger en nog veelal: Reformatie genoemd)"
                                        ],
