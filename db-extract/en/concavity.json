                "translations": [
                    {
                        "translation_id": "d495303b-abaa-4fe3-b22b-0a2260c4b4d3",
                        "source_entry_id": "d3ddd2ca-4b33-3429-9721-fe0c8a437396",
                        "source_sense_description": "the state of being concave",
                        "target_lang_word": "konkávnost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "96b26091-25cf-4f3e-9ce1-19a125623ddb",
                        "source_entry_id": "d3ddd2ca-4b33-3429-9721-fe0c8a437396",
                        "source_sense_description": "the state of being concave",
                        "target_lang_word": "concavité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concavité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70a1fe09-6e99-3b1a-8a38-0e7c2d5ee1a0",
                                        "entry_id": "b68c25f8-5bb0-3305-aac6-5ed96a44623a",
                                        "glosses": [
                                            "Côté concave, partie sphérique creuse d’un corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "982f2307-c258-4c3c-8fb3-3ee19268a679",
                                                "sense_id": "70a1fe09-6e99-3b1a-8a38-0e7c2d5ee1a0",
                                                "text": "Voilà donc mon raisonnement pour prouver que la concavité lunaire est lisse et non rugueuse."
                                            },
                                            {
                                                "example_id": "0f167981-7717-42d7-9287-5d083fc7aefb",
                                                "sense_id": "70a1fe09-6e99-3b1a-8a38-0e7c2d5ee1a0",
                                                "text": "Et même le vieux soleil de notre ciel semblait distordu, maintenant qu’ils le voyaient dans la polarisation des miasmes émanant de cette perversion trempée de mer, et tout devenait menace et attente guettant sourdement dans ces angles fuyants des rocs sculptés où le regard découvrait maintenant des concavités à ce qu’il avait d’abord cru convexe."
                                            },
                                            {
                                                "example_id": "a507ee94-52ad-47a7-aa78-3eb6941d816d",
                                                "sense_id": "70a1fe09-6e99-3b1a-8a38-0e7c2d5ee1a0",
                                                "text": "La concavité d’un globe."
                                            },
                                            {
                                                "example_id": "0276149e-d0e1-416f-9f29-b9bf5c3b05ff",
                                                "sense_id": "70a1fe09-6e99-3b1a-8a38-0e7c2d5ee1a0",
                                                "text": "Concavité profonde."
                                            },
                                            {
                                                "example_id": "6da0d09d-d18c-445a-bf9c-6281909eb219",
                                                "sense_id": "70a1fe09-6e99-3b1a-8a38-0e7c2d5ee1a0",
                                                "text": "Les concavités du cerveau, du crâne."
                                            },
                                            {
                                                "example_id": "0cb01133-61c8-45cc-b88f-d59f20ed00fa",
                                                "sense_id": "70a1fe09-6e99-3b1a-8a38-0e7c2d5ee1a0",
                                                "text": "Les concavités d’une montagne, d’un rocher."
                                            },
                                            {
                                                "example_id": "57a22d2a-8506-4924-bb8f-fe6b12ec6c61",
                                                "sense_id": "70a1fe09-6e99-3b1a-8a38-0e7c2d5ee1a0",
                                                "text": "Les concavités de la terre."
                                            },
                                            {
                                                "example_id": "5b9cd4c3-0780-4fb2-b75f-5a190fb125a3",
                                                "sense_id": "70a1fe09-6e99-3b1a-8a38-0e7c2d5ee1a0",
                                                "text": "La concavité d’une ligne courbe, i.e. son côté concave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8814db5f-753d-42ba-b84b-33c0f83fe4dc",
                        "source_entry_id": "d3ddd2ca-4b33-3429-9721-fe0c8a437396",
                        "source_sense_description": "the state of being concave",
                        "target_lang_word": "Konkavität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konkavität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4b403c-7285-364d-a49b-6c8af10b389c",
                                        "entry_id": "4ed2c12e-6ffe-32f6-b4a8-c6ede562d0b1",
                                        "glosses": [
                                            "Eigenschaft, nach innen gewölbt (konkav) zu sein"
                                        ],
                                        "tags": [
                                            "Optik",
                                            "und über eine Funktion in Mathematik, Wirtschaftswissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4110cbeb-9148-4bc4-a731-2b1cf0bc2e73",
                                                "sense_id": "bc4b403c-7285-364d-a49b-6c8af10b389c",
                                                "text": "„Die ganze Iris ist also der Konkavität der hinteren Linsenoberfläche entsprechend nach hinten stark ausgebuchtet.“"
                                            },
                                            {
                                                "example_id": "257ee934-ea97-4f37-8526-771985502e56",
                                                "sense_id": "bc4b403c-7285-364d-a49b-6c8af10b389c",
                                                "text": "„Die Schaufelform bedeutet palatinal eine Konkavität. In einer vollständigen Zahnreihe lässt sich die Hartsubstanz im Bereich dieser Konkavität mit zylindrischen oder konischen Instrumenten nicht gleichmäßig abtragen.“"
                                            },
                                            {
                                                "example_id": "dcd0600b-9beb-4bf8-b866-e680dc219b0a",
                                                "sense_id": "bc4b403c-7285-364d-a49b-6c8af10b389c",
                                                "text": "„Der Entscheidungsträger präferiert aufgrund der Konkavität der Nutzenfunktion den sicheren Erwartungswert vor dem risikobehafteten.“"
                                            },
                                            {
                                                "example_id": "90a65760-5142-4f77-ad50-5555ebb7f32d",
                                                "sense_id": "bc4b403c-7285-364d-a49b-6c8af10b389c",
                                                "text": "„Wenn die Tangenten den Graphen jeweils nur in einem einzigen Punkt berühren, dann spricht man von strikter Konvexität oder strikter Konkavität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
