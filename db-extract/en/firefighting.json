                                        "glosses": [
                                            "Gesamtheit aller Maßnahmen, die nötig sind, um ein ausgebrochenes Feuer zu löschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5132e2e-df3c-406f-a8b9-c3bbfec938d3",
                                                "sense_id": "057ee3ef-bd92-3745-a426-a99e561d8198",
                                                "text": "Die Feuerwehrleute üben die Brandbekämpfung an einer Hausruine."
                                            },
                                            {
                                                "example_id": "dc71d4e4-223a-4392-afb3-4cb03c869356",
                                                "sense_id": "057ee3ef-bd92-3745-a426-a99e561d8198",
                                                "text": "„Die feuerpolizeiliche Aufsicht dient der Überwachung der Einhaltung dieses Gesetzes sowie allgemein der Feststellung von Zuständen, die eine Brandgefahr herbeiführen oder vergrößern oder die Brandbekämpfung oder die Durchführung von Rettungsarbeiten erschweren oder verhindern können.“"
                                            }
