        "nl-extract.jsonl": [
            {
                "entry_id": "ad827255-fe0f-3bda-9e60-55a83a0850d7",
                "word": "wassend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7b1c124e-d127-37be-a32b-71e26149e518",
                        "entry_id": "ad827255-fe0f-3bda-9e60-55a83a0850d7",
                        "glosses": [
                            "van het water(peil) dat het hoger wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26375fb1-46a1-4439-8cf2-ab84a40568a4",
                                "sense_id": "7b1c124e-d127-37be-a32b-71e26149e518",
                                "text": "Een brug tussen Cagliari en Capoterra is ingestort door het wassende water."
                            },
                            {
                                "example_id": "284a392c-a215-486a-a42e-c3aec126ece0",
                                "sense_id": "7b1c124e-d127-37be-a32b-71e26149e518",
                                "text": "Het wassende water in de Waal. Een fietser op de Veerdam kiest toch eieren voor zijn geld."
                            },
                            {
                                "example_id": "68aece73-dfee-4d86-9fbc-d6c3e32b0c12",
                                "sense_id": "7b1c124e-d127-37be-a32b-71e26149e518",
                                "text": "Van Gestel werkte daarnaast ook als dramaturg bij de NCRV en bewerkte onder andere Het Wassende Water van Herman de Man voor televisie. Hij ontving in 2006 voor zijn gehele oeuvre de driejaarlijkse Theo Thijssen-prijs."
                            },
                            {
                                "example_id": "74c49f01-7d63-44e2-ab69-d7fcd49ffd3c",
                                "sense_id": "7b1c124e-d127-37be-a32b-71e26149e518",
                                "text": "De stad Susangerd (50.000 inwoners), langs de grens met Irak, wordt bedreigd door het wassende water, meldt de BBC. Vanochtend zou de stad door de Iraanse autoriteiten worden geëvacueerd, samen met nog vijf dorpen in de buurt. Irak heeft de grens in de buurt vanochtend gesloten uit 'veiligheidsoverwegingen’."
                            }
                        ]
                    },
