                        "entry_id": "64d5dbb8-8a67-3115-97cc-f4eea00d8580",
                        "glosses": [
                            "Mammifère ruminant présentant un nombre pair de doigts et portant généralement des bois, au moins en ce qui concerne le mâle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceee43ad-a530-4ce6-9d24-257627a0eed2",
                                "sense_id": "a74fad64-8c75-399f-9130-7b298695da95",
                                "text": "Le plus grand cervidé (l’élan ou l’orignal) a la taille d’un grand cheval, le plus petit (le pudu ou poudou) a celle d’un lièvre."
                            },
                            {
                                "example_id": "09f0bb38-8296-486d-af2e-b23158e06325",
                                "sense_id": "a74fad64-8c75-399f-9130-7b298695da95",
                                "text": "Acil portait un cervidé qu’ils venaient de tuer."
                            }
                        ]
                    }
