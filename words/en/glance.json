{
    "word_family": [
        "glancingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cb080e33-5f69-3800-983a-20fbb2c631ec",
                    "sense_definition": "To look briefly or quickly at someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sense_look",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>glanced</w> at her watch to see if she was late.",
                            "target_lang_translations": {
                                "ru": "Она <w>взглянула</w> на часы, чтобы узнать, не опаздывает ли она.",
                                "zh": "她<w>瞥</w>了一眼手表，看看自己是否迟到了。"
                            }
                        },
                        {
                            "text": "He <w>glanced</w> around the room hoping to find his friends.",
                            "target_lang_translations": {
                                "ru": "Он <w>оглядел</w> комнату в надежде найти своих друзей.",
                                "zh": "他<w>扫视</w>了房间，希望能找到他的朋友们。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peek"
                    ],
                    "antonyms": [
                        "stare",
                        "gaze"
                    ],
                    "common_phrases": [
                        "glance at",
                        "glance around",
                        "glance over",
                        "glance up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро или мельком посмотреть на кого-то или что-то.",
                        "zh": "快速或匆忙地看某人或某物一眼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взглянуть",
                                "target_lang_sense_clarification": "быстро посмотреть"
                            },
                            {
                                "target_lang_word": "глянуть",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "бросить взгляд",
                                "target_lang_sense_clarification": "фразеологизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瞥",
                                "target_lang_sense_clarification": "快速地看"
                            },
                            {
                                "target_lang_word": "扫视",
                                "target_lang_sense_clarification": "快速环视"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a268b9d-9c95-3e98-91ce-d53cfd95651e",
                    "sense_definition": "To strike a surface at an angle and fly off in a different direction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sense_ricochet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stone <w>glanced</w> off the windshield without breaking it.",
                            "target_lang_translations": {
                                "ru": "Камень <w>отскочил</w> от лобового стекла, не разбив его.",
                                "zh": "石头<w>擦过</w>挡风玻璃，没有将其击碎。"
                            }
                        },
                        {
                            "text": "The ball <w>glanced</w> off the post and went out of play.",
                            "target_lang_translations": {
                                "ru": "Мяч <w>срикошетил</w> от штанге и вышел из игры.",
                                "zh": "球<w>擦过</w>门柱后弹出了界。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "glance off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удариться о поверхность под углом и отлететь в другом направлении.",
                        "zh": "以一定角度撞击表面后向不同方向弹开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срикошетить",
                                "target_lang_sense_clarification": "отскочить"
                            },
                            {
                                "target_lang_word": "отскочить",
                                "target_lang_sense_clarification": "отлететь после удара"
                            },
                            {
                                "target_lang_word": "задеть вскользь",
                                "target_lang_sense_clarification": "пройти по касательной"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦过",
                                "target_lang_sense_clarification": "接触后滑开"
                            },
                            {
                                "target_lang_word": "弹开",
                                "target_lang_sense_clarification": "撞击后反弹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b76a2d2-7bba-3e5a-bc20-db0fc10c0854",
                    "sense_definition": "To reflect light briefly; to sparkle or gleam.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sense_flash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning sun <w>glanced</w> on the calm water of the lake.",
                            "target_lang_translations": {
                                "ru": "Утреннее солнце <w>сверкнуло</w> на спокойной воде озера.",
                                "zh": "晨光在平静的湖面上<w>闪烁</w>。"
                            }
                        },
                        {
                            "text": "Her diamond ring <w>glanced</w> in the bright light.",
                            "target_lang_translations": {
                                "ru": "Её кольцо с бриллиантом <w>блеснуло</w> на ярком свету.",
                                "zh": "她的钻戒在强光下<w>闪烁</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кратковременно отражать свет; сверкать или блестеть.",
                        "zh": "短暂地反射光线；闪烁或发光。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверкнуть",
                                "target_lang_sense_clarification": "о свете"
                            },
                            {
                                "target_lang_word": "блеснуть",
                                "target_lang_sense_clarification": "отразить свет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪烁",
                                "target_lang_sense_clarification": "光线闪动"
                            },
                            {
                                "target_lang_word": "反光",
                                "target_lang_sense_clarification": "反射光线"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2854b7da-0e90-3c36-a5c8-7a2a6601231c",
                    "sense_definition": "A brief or cursory look.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sense_look",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a quick <w>glance</w> at the map to check the route.",
                            "target_lang_translations": {
                                "ru": "Она бросила быстрый <w>взгляд</w> на карту, чтобы проверить маршрут.",
                                "zh": "她对地图<w>一瞥</w>，以确认路线。"
                            }
                        },
                        {
                            "text": "At first <w>glance</w> the problem seemed very simple to solve.",
                            "target_lang_translations": {
                                "ru": "На первый <w>взгляд</w> проблема казалась очень простой для решения.",
                                "zh": "<w>乍看</w>之下，这个问题似乎很容易解决。"
                            }
                        }
                    ],
                    "synonyms": [
                        "glimpse",
                        "peek",
                        "look"
                    ],
                    "antonyms": [
                        "stare",
                        "gaze"
                    ],
                    "common_phrases": [
                        "at a glance",
                        "cast a glance",
                        "steal a glance",
                        "first glance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый или беглый взгляд.",
                        "zh": "快速或粗略的一看。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взгляд",
                                "target_lang_sense_clarification": "взор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一瞥",
                                "target_lang_sense_clarification": "快速的看"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6732f77-cd81-3971-9ae4-257927f26db3",
                    "sense_definition": "An act of striking something at an angle and bouncing off.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sense_ricochet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball hit the goalkeeper with a <w>glance</w> and rolled away.",
                            "target_lang_translations": {
                                "ru": "Мяч задел вратаря <w>рикошетом</w> и откатился в сторону.",
                                "zh": "球<w>擦碰</w>到守门员后滚开了。"
                            }
                        },
                        {
                            "text": "It was a lucky <w>glance</w> that saved the window from breaking.",
                            "target_lang_translations": {
                                "ru": "Именно удачный <w>рикошет</w> спас окно от разбития.",
                                "zh": "多亏了那次幸运的<w>擦碰</w>，窗户才没被打破。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удар о предмет под углом и отскок.",
                        "zh": "以一定角度撞击某物并弹开的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рикошет",
                                "target_lang_sense_clarification": "отскок"
                            },
                            {
                                "target_lang_word": "скользящий удар",
                                "target_lang_sense_clarification": "удар вскользь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦碰",
                                "target_lang_sense_clarification": "轻微的碰撞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99cf00f4-5821-3b9b-a6b6-0bafd0199ad2",
                    "sense_definition": "A quick flash or sparkle of light.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sense_flash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We saw the sudden <w>glance</w> of sunlight on the metal roof.",
                            "target_lang_translations": {
                                "ru": "Мы увидели внезапный <w>отблеск</w> солнечного света на металлической крыше.",
                                "zh": "我们看到金属屋顶上突然出现的阳光<w>反光</w>。"
                            }
                        },
                        {
                            "text": "The <w>glance</w> of the lightning illuminated the dark forest.",
                            "target_lang_translations": {
                                "ru": "<w>Вспышка</w> молнии осветила темный лес.",
                                "zh": "一道<w>闪光</w>照亮了黑暗的森林。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрая вспышка или блеск света.",
                        "zh": "快速的闪光或光亮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отблеск",
                                "target_lang_sense_clarification": "отражение света"
                            },
                            {
                                "target_lang_word": "вспышка",
                                "target_lang_sense_clarification": "яркий свет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪光",
                                "target_lang_sense_clarification": "短暂的光亮"
                            },
                            {
                                "target_lang_word": "反光",
                                "target_lang_sense_clarification": "反射的光"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}