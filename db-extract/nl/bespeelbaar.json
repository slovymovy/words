                                    },
                                    {
                                        "sense_id": "5b46cb4b-cad4-3779-a6d0-76e4d6eef103",
                                        "entry_id": "dec4a857-21a5-3a7a-9c93-32951aca4cbf",
                                        "glosses": [
                                            "sich bespielen lassend; die Anforderung, dass man darauf spielen kann, erfüllend"
                                        ],
                                        "tags": [
                                            "Sportplatz und Ähnliches"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e3c770a-f277-44b0-ba2e-1b8a40e03199",
                                                "sense_id": "5b46cb4b-cad4-3779-a6d0-76e4d6eef103",
                                                "text": "Der Regen machte den Rasen auf dem Fußballplatz nicht bespielbar."
                                            },
                                            {
                                                "example_id": "2aa0f6b6-956e-4394-8092-b21b90704480",
                                                "sense_id": "5b46cb4b-cad4-3779-a6d0-76e4d6eef103",
                                                "text": "„Ein bespielbares Stadion war in Chicago und Umgebung nicht zu finden, aber Halas hatte die rettende Idee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "876e3b81-0366-4a9f-be4a-99eb02f41927",
                        "source_entry_id": "08283ad8-8f28-308b-b0e1-90d225d756dd",
                        "source_sense_id": "0ac70c8e-1bd5-3b71-baf6-aba588a2fc78",
