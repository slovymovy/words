                                            {
                                                "example_id": "e4451950-9563-4ae1-99a9-1843a8e3e813",
                                                "sense_id": "3253582a-8bc0-3408-abc7-a09b894ec6c4",
                                                "text": "Speicherung telefonischer Daten"
                                            },
                                            {
                                                "example_id": "45c84dd0-65a4-4f95-89eb-104b1fdcb92f",
                                                "sense_id": "3253582a-8bc0-3408-abc7-a09b894ec6c4",
                                                "text": "„Die Mutter einer Schizophrenen benachrichtigte den behandelnden Psychiater telefonisch, dass der Zustand ihrer Tochter sich wieder verschlechterte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff82c6e8-0181-3d66-9ef4-a72ff91160d0",
                                        "entry_id": "a970f396-424c-3b23-8161-4ee43f4f86ab",
                                        "glosses": [
                                            "mit Hilfe des Telefons, über das Telefon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89d16fb3-016d-48fb-8d5c-8a70991b484b",
                                                "sense_id": "ff82c6e8-0181-3d66-9ef4-a72ff91160d0",
                                                "text": "Du kannst mich telefonisch erreichen."
