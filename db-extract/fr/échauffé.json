                        "glosses": [
                            "Qualifie quelque chose qui a subi un échauffement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c9d3bb-1c2c-4ffc-afc4-b0f3185ecb64",
                                "sense_id": "db0d8d63-48e8-39c3-a82a-5ac3097c0683",
                                "text": "Et pourtant, ces pauvres soldats, à peine couverts de lambeaux d’uniforme, le ventre creux, n’ayant à boire que l’eau échauffée de leur gourde, secoués comme des rats dans une souricière, ne firent que rire à gorge déployée et chanter tout le long de la route."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2cf0206-4e39-350d-b834-29b162878d70",
                        "entry_id": "a84e1aae-2dd4-387a-9002-50fa790c7212",
                        "glosses": [
                            "Qualifie un bois qui a subi l’échauffement."
                        ],
                        "tags": [
                            "Exploitation forestière"
                        ],
                        "examples": [
                            {
                                "example_id": "e8436493-3a2f-408c-b97e-dd282fe6b45e",
                                "sense_id": "c2cf0206-4e39-350d-b834-29b162878d70",
                                "text": "Le bois échauffé est utilisé pour ses qualités décoratives. La cause de l'échauffement doit alors être neutralisée."
                            }
                        ]
                    }
                ],
