                        "source_sense_description": "Mathematik: zweiter Faktor in einer Multiplikation; Zahl, die mit einer anderen multipliziert wird",
                        "target_lang_word": "multiplicand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multiplicand",
