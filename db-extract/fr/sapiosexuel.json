                                        "glosses": [
                                            "Que siente atracción o excitación sexual por la inteligencia de otros."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29196894-6dbc-49ed-8971-a04b444699b6",
                                                "sense_id": "2088f4f6-e06c-3ffc-a83a-58ff4b5b6d3b",
                                                "text": "De la era del metrosexual a la del sapiosexual"
