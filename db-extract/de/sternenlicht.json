                "senses": [
                    {
                        "sense_id": "4bb99434-c075-30a3-851e-90662d9dc6dc",
                        "entry_id": "86d51df2-1655-31af-b92a-46b781b84db4",
                        "glosses": [
                            "natürliches Licht von den Sternen in der Nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48a513b-6eef-483f-b12e-d4e3e21f45f7",
                                "sense_id": "4bb99434-c075-30a3-851e-90662d9dc6dc",
                                "text": "„Er ritt ohne anzuhalten fünfzig Meilen, bei Tageslicht, Mondlicht, Sternenlicht oder in pechschwarzer Nacht, wie es gerade kam.“"
                            },
                            {
                                "example_id": "acbcec84-f003-43bb-9323-b893f821581c",
                                "sense_id": "4bb99434-c075-30a3-851e-90662d9dc6dc",
                                "text": "„Seine größte Sehnsucht ist es, sie darauf zu hissen, triumphierend, sie in das Sonnenlicht zu ziehen, in das Strenenlicht, wo sie die Welt sehen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82d178ea-79e8-4eee-8955-fa3803ad1bc0",
                        "source_entry_id": "86d51df2-1655-31af-b92a-46b781b84db4",
                        "source_sense_id": "4bb99434-c075-30a3-851e-90662d9dc6dc",
