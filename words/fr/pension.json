    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44db6647-79b0-3454-a8af-b1b7f819385a",
                    "sense_definition": "Prestation d'un établissement hôtelier comprenant le logement et tout ou partie des repas quotidiens.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hebergement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour nos vacances à la montagne, nous avons réservé un séjour en <w>pension</w> complète."
                        },
                        {
                            "text": "Les touristes préfèrent souvent la demi-<w>pension</w> afin de déjeuner librement en ville."
                        }
                    ],
                    "common_phrases": [
                        "pension complète",
                        "demi-pension"
                    ]
                },
                {
                    "sense_id": "0e117bbf-2485-39bf-9267-ec67ffd29d30",
                    "sense_definition": "Somme d'argent versée périodiquement au titre de la retraite, d'une invalidité ou d'une obligation légale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après quarante années de travail, il touche enfin sa <w>pension</w> de retraite."
                        },
                        {
                            "text": "Le juge a fixé le montant de la <w>pension</w> alimentaire pour l'entretien des enfants."
                        }
                    ],
                    "synonyms": [
                        "allocation",
                        "rente"
                    ],
                    "common_phrases": [
                        "pension de retraite",
                        "pension alimentaire",
                        "toucher une pension"
                    ]
                },
                {
                    "sense_id": "dd373853-3bb6-33e1-af21-d7d060a87756",
                    "sense_definition": "Établissement modeste ou maison particulière où l'on est logé et nourri contre paiement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hebergement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durant ses études, elle a loué une chambre dans une charmante <w>pension</w> de famille."
                        },
                        {
                            "text": "Cette petite <w>pension</w> accueille chaleureusement les voyageurs de passage tout l'été."
                        }
                    ],
                    "synonyms": [
                        "auberge",
                        "pensionnat"
                    ],
                    "common_phrases": [
                        "pension de famille"
                    ]
                },
                {
                    "sense_id": "fb11dcef-1583-3997-880a-6fe0888f8a6e",
                    "sense_definition": "Établissement scolaire où les élèves reçoivent l'enseignement tout en y étant logés et nourris.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hebergement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses parents ont décidé de le mettre en <w>pension</w> pour améliorer ses résultats scolaires."
                        },
                        {
                            "text": "Elle gardait de très bons souvenirs de ses années passées dans cette ancienne <w>pension</w>."
                        }
                    ],
                    "synonyms": [
                        "internat",
                        "pensionnat"
                    ],
                    "antonyms": [
                        "externat"
                    ],
                    "common_phrases": [
                        "être en pension",
                        "mettre en pension"
                    ]
                },
                {
                    "sense_id": "00f8cf8f-9c4a-3364-b5c0-6d118a68750f",
                    "sense_definition": "Somme d'argent payée pour assurer le gîte et la nourriture d'une personne ou d'un animal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il règle fidèlement le premier jour du mois le prix de la <w>pension</w> pour son cheval."
                        },
                        {
                            "text": "Les frais de scolarité comprennent les cours ainsi que la <w>pension</w> trimestrielle."
                        }
                    ],
                    "synonyms": [
                        "frais"
                    ],
                    "common_phrases": [
                        "prix de la pension"
                    ]
                }
            ]
        }
    ]
