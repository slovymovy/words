                "senses": [
                    {
                        "sense_id": "9d4573c9-1516-3a26-a68d-b931d286b156",
                        "entry_id": "390033e7-9ecf-3ddb-9044-aabe3bf06980",
                        "glosses": [
                            "Karte mit Chip oder Magnetstreifen, auf dem vorausbezahlte Geldeinheiten gespeichert sind, die entsprechend den beanspruchten Leistungen automatisch verringert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3a0b0e9-6968-4607-a7cf-d532ebaa82ef",
                                "sense_id": "9d4573c9-1516-3a26-a68d-b931d286b156",
                                "text": "Im Streit über die Erdinger Wertkarte zum ausschließlich bargeldlosen Einkaufen für Asylbewerber hat das Sozialgericht München dem Landratsamt Erding teilweise den Rücken gestärkt."
                            },
                            {
                                "example_id": "ec29587a-29d3-431e-a37d-004867488519",
                                "sense_id": "9d4573c9-1516-3a26-a68d-b931d286b156",
                                "text": "Orts- und Ferngespräche führt man am preisgünstigsten von Telefonzellen aus. Dazu braucht man eine Wertkarte (carta telefonica bzw. scheda), die man für 5 oder 10 Euro in Postämtern, Hotels, Bars, Tabakläden und Zeitungskiosken sowie an Automaten erhält."
                            },
                            {
                                "example_id": "bc3dabd0-dddb-472c-a815-18b134124ac5",
                                "sense_id": "9d4573c9-1516-3a26-a68d-b931d286b156",
                                "text": "Zur Verwendung müssen die auf der Wertkarte angegebene Nummer und der Code der Karte gewählt werden."
                            },
                            {
                                "example_id": "0b8dc196-ff04-4a19-bece-77c583be94a2",
                                "sense_id": "9d4573c9-1516-3a26-a68d-b931d286b156",
                                "text": "Also statt einer Kreditkarte bekommt man eine Wertkarte, und damit geht man zum Friseur. Da werden zehn Minuten abgebucht…"
                            },
                            {
                                "example_id": "dade9e38-5b70-4a5c-9a2a-02876d9d4528",
                                "sense_id": "9d4573c9-1516-3a26-a68d-b931d286b156",
                                "text": "Mittlerweile ist T-Money, das nicht nur in Untergrundbahnen, Bussen und Taxis verwendet werden kann, sondern auch an Zahlstellen für kostenpflichtige Strassentunnels, bereits weit mehr als nur eine Wertkarte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
