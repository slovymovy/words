        "fr-extract.jsonl": [
            {
                "entry_id": "e2da05d4-88eb-319f-812b-837c0e95d638",
                "word": "poussoir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e75e107b-2920-4840-9a1b-5501f782eda0",
                        "entry_id": "e2da05d4-88eb-319f-812b-837c0e95d638",
                        "tags": [
                            "plural"
                        ],
                        "form": "poussoirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fee3e332-7977-3e7c-9aee-730e1b7b0710",
                        "entry_id": "e2da05d4-88eb-319f-812b-837c0e95d638",
                        "glosses": [
                            "Pièce destinée à transmettre une poussée, en particulier pour commander l’ouverture ou la fermeture d’une soupape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "852dbe80-399d-4ee2-87e4-5364012b884c",
                                "sense_id": "fee3e332-7977-3e7c-9aee-730e1b7b0710",
                                "text": "Une dérivation du circuit de lubrification du moteur alimente sous pression et de façon continue l'intérieur du poussoir. Au repos, lorsque le poussoir repose sur le dos de la came, l'huile sous pression ouvre le clapet et remplit la chambre."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfaf3ac1-e0ca-340b-a50a-515278581fd1",
                        "entry_id": "e2da05d4-88eb-319f-812b-837c0e95d638",
                        "glosses": [
                            "Bouton sur lequel on appuie pour enclencher ou interrompre un fonctionnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01b4108f-7a6d-46a0-bb1e-b745224df9ff",
                                "sense_id": "bfaf3ac1-e0ca-340b-a50a-515278581fd1",
                                "text": "Dorgères écrasa son pouce sur le poussoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f2f9ed4-5964-3554-bc25-f5fcf9146302",
                        "entry_id": "e2da05d4-88eb-319f-812b-837c0e95d638",
                        "glosses": [
                            "Cylindre terminé par un bouton qu’on pousse pour activer une fonction d’une montre."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "9209bb08-0a77-4ff9-9316-d3a8e89cdf6c",
                                "sense_id": "6f2f9ed4-5964-3554-bc25-f5fcf9146302",
                                "text": "On distingue différentes sortes de poussoirs : les poussoirs cylindriques, les poussoirs de forme (souvent avec cache-poussoir), les poussoirs blocables et les poussoirs avec tête monobloc."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd3f22b5-8b8b-3d1c-af51-39f7fd6c45b8",
                        "entry_id": "e2da05d4-88eb-319f-812b-837c0e95d638",
                        "glosses": [
                            "Tout instrument servant à pousser hors de l’œsophage ou d’ailleurs les corps étrangers."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ce76c7f4-9149-3c77-903d-a0328b01f1c0",
                        "entry_id": "e2da05d4-88eb-319f-812b-837c0e95d638",
                        "glosses": [
                            "Appareil servant à embosser la chair dans un boyau."
                        ],
                        "tags": [
                            "Charcuterie"
                        ],
                        "examples": [
                            {
                                "example_id": "c9dc7f34-bf2f-42d9-8109-1f5456562754",
                                "sense_id": "ce76c7f4-9149-3c77-903d-a0328b01f1c0",
                                "text": "Les poussoirs ou embossoirs à saucisses \"poussent\" la chair à saucisse dans les boyaux en enlevant l'air et sont plus pratiques et plus rapides que l'embossage avec un hachoir à viande."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8352501-08e4-3471-b158-bcd31a4177c7",
                        "entry_id": "e2da05d4-88eb-319f-812b-837c0e95d638",
                        "glosses": [
                            "Outil emmanché destiné à repousser la neige sur le sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "374a4dd6-2543-4eae-9638-ec4dc1d61c55",
                                "sense_id": "b8352501-08e4-3471-b158-bcd31a4177c7",
                                "text": "Longtemps fabriqués en contreplaqué, les poussoirs ou pelles à neige sont aujourd'hui proposés en métal et en plastique."
                            },
                            {
                                "example_id": "952cd526-04e3-47f8-bf2b-e3d0b0033bbc",
                                "sense_id": "b8352501-08e4-3471-b158-bcd31a4177c7",
                                "text": "La neige arrive ! Munissez vous d'un poussoir de qualité pour nettoyer votre allée de garage !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
