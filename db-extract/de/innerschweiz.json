                "senses": [
                    {
                        "sense_id": "12a9faea-f979-3ee6-b34d-3c40a2a36f82",
                        "entry_id": "6c0cf124-57cb-3564-a8d2-54fed362bd11",
                        "glosses": [
                            "zentrales Gebiet der Schweiz, das die Kantone Luzern, Uri, Schwyz, Obwalden, Nidwalden und Zug umfasst und nördlich des Alpenkammes liegt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "08cc41e4-a6b7-4283-8ef4-2eb11e9d4201",
                                "sense_id": "12a9faea-f979-3ee6-b34d-3c40a2a36f82",
                                "text": "„Aus der Innerschweiz melden sich überdurchschnittlich viele Frauen, die eine Eheberatung brauchen.“"
                            },
                            {
                                "example_id": "a2de67b5-9649-4c55-852f-ccaf8002365e",
                                "sense_id": "12a9faea-f979-3ee6-b34d-3c40a2a36f82",
                                "text": "„Während die einen aus Angst vor Attentaten ihre Reisen ins Ausland annullieren, fühlen sich die Touristen in der Innerschweiz sicher und wohl.“"
                            },
                            {
                                "example_id": "2da9bd19-9388-4d99-bbc3-9089adba9c27",
                                "sense_id": "12a9faea-f979-3ee6-b34d-3c40a2a36f82",
                                "text": "„Mit Ausnahme der Innerschweiz zeigt der Trend überall sinkende Grippezahlen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
