                    "sense_id": "6f779136-63d7-3f58-a1d8-0777b53c804f",
                    "sense_definition": "Светская жизнь в противоположность церковной или монашеской жизни.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "society_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Монах вспоминал свою прошлую жизнь в <w>миру</w> без сожаления.",
                            "target_lang_translations": {
                                "en": "The monk recalled his past life in the <w>world</w> without regret.",
                                "zh": "僧侣毫无遗憾地回忆起他过去在<w>世俗</w>的生活。"
                            }
