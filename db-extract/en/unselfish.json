                    {
                        "translation_id": "587318f3-3359-4336-ac07-d7ad104620ac",
                        "source_entry_id": "71146e2e-f367-3f08-a260-9555e6f7ebbc",
                        "source_sense_id": "7a957c02-b264-372f-8502-aee0b9f181b1",
