                ],
                "senses": [
                    {
                        "sense_id": "8a76aa8a-9d25-3823-867a-f98b969d4d11",
                        "entry_id": "874350ee-eac7-3dc6-94ec-9382e2f38338",
                        "glosses": [
                            "Gegenstand, der in einem Grab gefunden wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db557ce8-1edb-475f-ab2b-a5287ae6f692",
                                "sense_id": "8a76aa8a-9d25-3823-867a-f98b969d4d11",
                                "text": "„Daß die keltischen Männer ihre Haare und ihren Bart pflegten, belegen Grabfunde wie Rasiermesser, Scheren, Kämme, Pinzetten und Toilettenbestecke.“"
                            },
                            {
                                "example_id": "fb7e8061-e118-48f9-b293-1379cabe09b0",
                                "sense_id": "8a76aa8a-9d25-3823-867a-f98b969d4d11",
                                "text": "„Mehr oder weniger genaue Zeitbestimmungen von Runendenkmälern sind durch die immer mehr verfeinerten Methoden der Archäologie möglich geworden, vor allem bei Grabfunden mit archäologisch datierbaren Beigaben.“"
                            },
                            {
                                "example_id": "9f1b00fe-2d34-46db-b8b6-a17c037b6177",
                                "sense_id": "8a76aa8a-9d25-3823-867a-f98b969d4d11",
                                "text": "„Im Gegensatz zu den zufälligen Überresten einer Siedlung stellen Grabfunde eine bewusste Auswahl dar, sie sind eine Botschaft an die Hinterbliebenen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6998797b-05c6-39b4-a4f2-82402c6f2972",
                        "entry_id": "874350ee-eac7-3dc6-94ec-9382e2f38338",
                        "glosses": [
                            "Entdeckung eines Grabes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aab8baac-7427-4ef1-8d5c-329f542c8509",
                                "sense_id": "6998797b-05c6-39b4-a4f2-82402c6f2972",
                                "text": "„Der römerzeitliche Grabfund im Oberhof der Gemeinde Weißenbach am Lech gilt als wichtiger archäologischer Befund in Tirol.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
