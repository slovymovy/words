                                "example_id": "2312004d-4df3-40bd-9f0c-fe68a34d8e48",
                                "sense_id": "fa9fc092-0d70-3fe6-8daa-ecb0c8c623f0",
                                "text": "FRANTZ FANON réveille toi pour pathologiciser le cas SASSOU, car il devient fou."
                            }
                        ]
