                "senses": [
                    {
                        "sense_id": "d0675505-05d4-3310-9b84-025fd85997aa",
                        "entry_id": "74d676d5-0d97-3a86-993c-65b538d3721e",
                        "glosses": [
                            "französische Bezeichnung für Stadtstreicher"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e9f7099-8b90-47f7-b7f3-46edf5c39f33",
                                "sense_id": "d0675505-05d4-3310-9b84-025fd85997aa",
                                "text": "„Ein paar Clochards bereiteten ihr Abendessen an der Quaimauer vor.“"
                            },
                            {
                                "example_id": "d39e0c4b-c184-4131-a3db-6900d7a0d68e",
                                "sense_id": "d0675505-05d4-3310-9b84-025fd85997aa",
                                "text": "„Auf dem Baugrundstück zwischen der Maternité und dem arabischen Café lagen die beiden Clochards, die auch bei Tage immer dort lagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4744d9a9-d296-4413-901e-39942b1ac4b6",
                        "source_entry_id": "74d676d5-0d97-3a86-993c-65b538d3721e",
                        "source_sense_id": "d0675505-05d4-3310-9b84-025fd85997aa",
                        "source_sense_description": "Stadtstreicher",
                        "target_lang_word": "clochard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clochard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9823adbe-d699-39c3-a26d-adde66f50ff7",
                                        "entry_id": "ff54f2ad-6fd0-302a-a4b2-56d7e00594bf",
                                        "glosses": [
                                            "A beggar or tramp, especially in France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60a15ac7-9898-435c-9bf3-b73fb8f11486",
                                                "sense_id": "9823adbe-d699-39c3-a26d-adde66f50ff7",
                                                "text": "He nearly fell over the Pont Neuf, enjoyed the conversation and esteem of several hairy clochards, and was finally knocked down by a taxi in the Place Vendôme […]"
                                            },
                                            {
                                                "example_id": "17730c4f-f443-4ba7-baf2-ea4e53e3841e",
                                                "sense_id": "9823adbe-d699-39c3-a26d-adde66f50ff7",
                                                "text": "‘Those clochards in Cannes, mostly old soixante-huitards. They see a tribute to modern industrial genius and can't resist giving it a swift kick.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8491069b-658e-4a34-ac74-48f3889ad2bb",
                        "source_entry_id": "74d676d5-0d97-3a86-993c-65b538d3721e",
                        "source_sense_id": "d0675505-05d4-3310-9b84-025fd85997aa",
                        "source_sense_description": "Stadtstreicher",
                        "target_lang_word": "clochard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clochard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a6b78fc-0b99-30fc-adca-f088a7b6b497",
                                        "entry_id": "7e704af6-7f9c-3966-84f9-f0f5c282a7b8",
                                        "glosses": [
                                            "Personne sans domicile fixe qui mène une vie de mendicité, qui refuse les contraintes sociales ou est contrainte à la misère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52f8ec4e-bd94-4d9f-8877-60dbcc3fac32",
                                                "sense_id": "1a6b78fc-0b99-30fc-adca-f088a7b6b497",
                                                "text": "Qu’est-ce qu’elle faisait de mal, la pauvre bougresse, pour qu'on la... Vingt dieux ! ça doit venir d'un des clochards qu’elle fréquentait. Ou d’un des hommes-sandwiches… Pourtant, y avait pas de raison qu’ils la tuent."
                                            },
                                            {
                                                "example_id": "0140bd20-97b2-4f14-bf28-13c6a47a64e9",
                                                "sense_id": "1a6b78fc-0b99-30fc-adca-f088a7b6b497",
                                                "text": "Il avait cependant assisté […] à une rafle sur les quais de tous les mendigots et clochards qu’une brigade de flics avait cernés."
                                            },
                                            {
                                                "example_id": "452506c6-33c2-4168-bfa1-8abdb0343f70",
                                                "sense_id": "1a6b78fc-0b99-30fc-adca-f088a7b6b497",
                                                "text": "Vendeur - J’ai horreur des clochards, ils sont répugnants et ils ont le cerveau tellement ramolli qu’ils ne respectent plus rien.\nRichard - En tous cas vous lui avez sucré son envie de toucher les cailloux...\nLapinot - Et à moi mon envie de vous acheter quoi que ce soit… Vous correspondez trop bien à votre propre description du clochard."
                                            },
                                            {
                                                "example_id": "f0cbef92-5c08-4bdc-92fe-0134ea554c79",
                                                "sense_id": "1a6b78fc-0b99-30fc-adca-f088a7b6b497",
                                                "text": "L’hiver 1953-1954 fut particulièrement rude. Des clochards moururent de froid, ainsi qu’un enfant dans une famille mal logée."
                                            },
                                            {
                                                "example_id": "0878526e-73ee-4a2e-9862-5bee224ed8e1",
                                                "sense_id": "1a6b78fc-0b99-30fc-adca-f088a7b6b497",
                                                "text": "De même, en marge de la société, le clochard n’en est pas moins touché d’une certaine façon par la grâce. Peut-être d’ailleurs quittera-t-il le purgatoire terrestre pour le paradis, le jour du grand départ. C'est en tout cas ce que veut croire Bruant non sans une pointe d’ironie lorsqu’il achève son premier recueil par la mort du grelotteux : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "599d95bb-6fc6-31cf-a0e9-5c06581c7c0c",
                                        "entry_id": "7e704af6-7f9c-3966-84f9-f0f5c282a7b8",
                                        "glosses": [
                                            "Toute personne à l’allure débraillée, peu soignée."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce732312-5215-3777-b586-98776576f4f9",
                                        "entry_id": "7e704af6-7f9c-3966-84f9-f0f5c282a7b8",
                                        "glosses": [
                                            "Tocard, pauvre type."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f131b721-8b72-43b8-82db-f36ee9c868f0",
                                                "sense_id": "ce732312-5215-3777-b586-98776576f4f9",
                                                "text": "« Espèce de clochard ! Me touche pas et touche pas à mon Audi ! C’est une voiture à 30 000 euros »"
                                            },
                                            {
                                                "example_id": "ecc675df-826a-4f17-b8e8-e7de3e994b7f",
                                                "sense_id": "ce732312-5215-3777-b586-98776576f4f9",
                                                "text": "« Ce clochard, il ne me fait jamais la passe », soufflait le champion du monde de 22 ans, en colère après l'attitude jugée égoïste de Neymar dans une vidéo dévoilée par Canal +. — (« «Ce clochard, il ne me la passe pas»: tension et explication entre Mbappé et Neymar », le 27 juillet 2021, sur le site du journal Le Figaro (www.lefigaro.fr))"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2e45073-d3ab-4585-b981-2fe83d88d8eb",
                        "source_entry_id": "74d676d5-0d97-3a86-993c-65b538d3721e",
