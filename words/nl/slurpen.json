    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "591e973c-5611-368e-bb14-01d344e44998",
                    "sense_definition": "hoorbaar vloeistof tot zich nemen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aan de kindertafel werd er <w>geslurpt</w> en gesmakt dat het een lieve lust was.",
                            "target_lang_translations": {
                                "en": "At the children's table, there was <w>slurping</w> and smacking of lips to their heart's content."
                            }
                        },
                        {
                            "text": "Het is onbeleefd om luidruchtig soep te <w>slurpen</w> tijdens het diner.",
                            "target_lang_translations": {
                                "en": "It is impolite to <w>slurp</w> soup noisily during dinner."
                            }
                        }
                    ],
                    "common_phrases": [
                        "soep slurpen",
                        "luidruchtig slurpen"
                    ],
                    "target_lang_definitions": {
                        "en": "To consume liquid audibly, making a sucking sound."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slurp",
                                "target_lang_sense_clarification": "to drink or eat noisily"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1ed2e2d-1e45-32e9-af55-4e26e13faaeb",
                    "sense_definition": "meervoud van <w>slurp</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De olifanten gebruikten hun <w>slurpen</w> om water te drinken uit de rivier.",
                            "target_lang_translations": {
                                "en": "The elephants used their <w>trunks</w> to drink water from the river."
                            }
                        },
                        {
                            "text": "Met hun lange <w>slurpen</w> kunnen deze dieren gemakkelijk bij de hoogste takken.",
                            "target_lang_translations": {
                                "en": "With their long <w>trunks</w>, these animals can easily reach the highest branches."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'slurp' (trunk), referring to the long, flexible noses of elephants."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trunks",
                                "target_lang_sense_clarification": "plural of elephant's trunk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
