                "senses": [
                    {
                        "sense_id": "76a9f504-d97a-3cf6-9e10-7b011a61241c",
                        "entry_id": "765b1c64-62da-30ed-91f1-53f087173b27",
                        "glosses": [
                            "zeitlich begrenzter Arbeitseinsatz, bei welchem der Arbeiter freiwillig auf eine Entlohnung verzichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c321a60-b11b-4d96-ba38-bd28380e0665",
                                "sense_id": "76a9f504-d97a-3cf6-9e10-7b011a61241c",
                                "text": "Große Veranstaltungen, wie die des Besuches des Karmapa oder des Dalai Lama können nur durch großzügige Unterstützung vieler Helfer im Rahmen eines Volontariats stattfinden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "23a99fd9-a632-3e39-a04c-9a989de5b806",
                        "entry_id": "765b1c64-62da-30ed-91f1-53f087173b27",
                        "glosses": [
                            "Tätigkeitsbezeichnung für eine Ausbildung in speziellen Berufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94524906-3919-4f9c-a1b8-40e18f16f7c0",
                                "sense_id": "23a99fd9-a632-3e39-a04c-9a989de5b806",
                                "text": "Nächste Woche tritt sie ihr Volontariat beim Verlag an."
                            },
                            {
                                "example_id": "b3b736bb-d0d3-4d23-a473-f802e3c5a074",
                                "sense_id": "23a99fd9-a632-3e39-a04c-9a989de5b806",
                                "text": "„Das Volontariat ist vom Ausbildungszweck bestimmt; charakteristisch ist die Ungebundenheit des Volontärs gegenüber dem Unternehmer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
