                "senses": [
                    {
                        "sense_id": "f001dea5-5e18-3be4-9bed-3cf0d47b8987",
                        "entry_id": "f30d936d-0e5b-3d10-873b-bdf485ea6fbd",
                        "glosses": [
                            "übertriebener Glaubenseifer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d785e49-e1b1-46ee-918e-09bcfc4a8c34",
                                "sense_id": "f001dea5-5e18-3be4-9bed-3cf0d47b8987",
                                "text": "Mein Nachbar ist der Bigotterie verfallen."
                            },
                            {
                                "example_id": "ba62bfd3-a02e-4365-9179-88e69dc7b32b",
                                "sense_id": "f001dea5-5e18-3be4-9bed-3cf0d47b8987",
                                "text": "„Die Prüderie, die Gezwungenheit, die Bigotterie und die geistige Unsauberkeit, die seit der viktorianischen Ära herrschen, waren erst nötig, um die Reinheit der Freundschaften zu trüben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3cdd92bd-00af-3213-80b4-ac2a2c346c7a",
                        "entry_id": "f30d936d-0e5b-3d10-873b-bdf485ea6fbd",
                        "glosses": [
                            "scheinheilige Handlungsweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbe58cc3-9059-4796-bf9c-6bd33b411787",
                                "sense_id": "3cdd92bd-00af-3213-80b4-ac2a2c346c7a",
                                "text": "„Wir sollten darüber reden, wie Deutschland und die USA mit den saudischen Wahabiten umgehen, denen wir Waffen liefern, das sei eine Unverschämtheit und Bigotterie, wetterte er und gab gleich noch dem FC Bayern München eins mit: Der ‚Mia san mia‘-Club hatte dort im Rahmen seiner Vorbereitung ein Freundschaftsspiel absolviert und erst danach seine Ignoranz bemerkt.“"
                            },
                            {
                                "example_id": "77c65d2e-b0bd-4e99-91a7-190c215d6a62",
                                "sense_id": "3cdd92bd-00af-3213-80b4-ac2a2c346c7a",
                                "text": "„Papageienwitze sind geradezu prädestiniert, die Bigotterie und Doppelmoral drastisch dazustellen.“"
                            },
                            {
                                "example_id": "60794779-1dee-4fac-b520-6500998df3b3",
                                "sense_id": "3cdd92bd-00af-3213-80b4-ac2a2c346c7a",
                                "text": "„Wie Meyer Ellenstein, der erste und einzige jüdische Bürgermeister von Newark, dessen erste von zwei Amtszeiten im Jahr von Philips Geburt begann, war der Junge ein entschiedener Gegner weißer Bigotterie gegenüber Schwarzen.“"
                            },
                            {
                                "example_id": "9fcb2b5e-489b-4f80-9266-c0c3bf83fb2a",
                                "sense_id": "3cdd92bd-00af-3213-80b4-ac2a2c346c7a",
                                "text": "„Diese kaltblütige Bigotterie verschlug Adam die Rede.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
