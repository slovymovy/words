{
    "word_family": [
        "waas",
        "wazigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7b06d286-bed0-3a21-983d-d9be27795995",
                    "sense_definition": "Niet scherp of helder te zien, alsof er een sluier of waas voor hangt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visuele_onscherpte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Is het mogelijk deze <w>wazige</w> foto wat scherper te maken?",
                            "target_lang_translations": {
                                "en": "Is it possible to make this <w>blurry</w> photo a bit sharper?"
                            }
                        },
                        {
                            "text": "Zonder mijn bril heb ik een erg <w>wazig</w> zicht op het bord.",
                            "target_lang_translations": {
                                "en": "Without my glasses, I have a very <w>blurry</w> view of the board."
                            }
                        }
                    ],
                    "synonyms": [
                        "onscherp",
                        "troebel",
                        "mistig"
                    ],
                    "antonyms": [
                        "scherp",
                        "helder"
                    ],
                    "common_phrases": [
                        "een wazig beeld",
                        "een wazige foto"
                    ],
                    "target_lang_definitions": {
                        "en": "Not sharp or clear to see, as if covered by a veil or haze."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blurry",
                                "target_lang_sense_clarification": "of an image or vision"
                            },
                            {
                                "target_lang_word": "hazy",
                                "target_lang_sense_clarification": "obscured by haze or mist"
                            },
                            {
                                "target_lang_word": "fuzzy",
                                "target_lang_sense_clarification": "indistinct or out of focus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15d2e016-75a3-386d-8ac7-837000cf4c1d",
                    "sense_definition": "Onduidelijk, vaag of verward van karakter of verstand.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mentale_onduidelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gaf een nogal <w>wazig</w> antwoord op mijn duidelijke vraag.",
                            "target_lang_translations": {
                                "en": "He gave a rather <w>vague</w> answer to my clear question."
                            }
                        },
                        {
                            "text": "Na een lange dag werken had zij een <w>wazig</w> gevoel in haar hoofd.",
                            "target_lang_translations": {
                                "en": "After a long day of work, she had a <w>fuzzy</w> feeling in her head."
                            }
                        }
                    ],
                    "synonyms": [
                        "vaag",
                        "onduidelijk",
                        "verward"
                    ],
                    "antonyms": [
                        "duidelijk",
                        "helder"
                    ],
                    "common_phrases": [
                        "een wazig verhaal",
                        "een wazig antwoord"
                    ],
                    "target_lang_definitions": {
                        "en": "Unclear, vague, or confused in character or mind."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vague",
                                "target_lang_sense_clarification": "not clearly expressed or defined"
                            },
                            {
                                "target_lang_word": "fuzzy",
                                "target_lang_sense_clarification": "confused or lacking clarity in thought"
                            },
                            {
                                "target_lang_word": "hazy",
                                "target_lang_sense_clarification": "vague or indistinct in memory or understanding"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}