                        "entry_id": "0d94493b-56c8-3ab1-ada2-126dbf99eeee",
                        "glosses": [
                            "female equivalent of игу́мен (igúmen): Mother Superior, abbess"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "b4be3b4c-502b-45be-9fcc-5cb756a5cbd0",
                                "sense_id": "07c2832a-39b7-36e7-8891-480fa8c3d865",
                                "text": "Игу́менья повела́ кня́зя че́рез сад к одино́кой ке́лье, гу́сто обса́женной шипо́вником и жи́молостью.",
                                "translation": "Aleksey Konstantinovich Tolstoy",
                                "english": "Aleksey Konstantinovich Tolstoy"
                            }
                        ]
                    }
                ],
