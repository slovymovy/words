                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52217b0a-59d4-4c47-8e3a-0cda30355c79",
                                                "sense_id": "ba66da7a-b52f-3683-aa8b-eff5825a164c",
                                                "text": "De ouders keken met vertwijfeling naar hun doodzieke kind."
                                            }
