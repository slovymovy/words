                "senses": [
                    {
                        "sense_id": "05289453-065b-31ad-b2fa-df20104d6e69",
                        "entry_id": "d42c6111-acdc-36a1-9cf1-089e35814254",
                        "glosses": [
                            "получить отрицательные последствия в результате бездействия, неправильных действий, неправильного образа жизни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4678182f-b9c5-41d4-94a0-4f0cd0cce8a6",
                                "sense_id": "05289453-065b-31ad-b2fa-df20104d6e69",
                                "text": "Ой, до чего дожили, до чего докатились!"
                            },
                            {
                                "example_id": "ab0c8859-ca79-4a92-9509-df84716ccc86",
                                "sense_id": "05289453-065b-31ad-b2fa-df20104d6e69",
                                "text": "Став на наклонную плоскость организационного оппортунизма, они уже докатились и до оппортунизма тактического."
                            },
                            {
                                "example_id": "16ebf636-e865-41a8-9e07-add1f707cd5f",
                                "sense_id": "05289453-065b-31ad-b2fa-df20104d6e69",
                                "text": "Днём возили с полей зелёнку, овёс, косили отаву по речке, ночью один из нас дежурил возле конных дворов с заряженной винтовкой, потому как слухи, пока только слухи, о действиях бендеровцев в здешних местах докатились и до Ольвии."
                            }
                        ]
                    }
