                                    {
                                        "sense_id": "48734a32-e5b9-3173-855e-5d126b28c3d7",
                                        "entry_id": "3a885929-78f1-3a92-a1b4-5d0e85d4f3cd",
                                        "glosses": [
                                            "Very bad or intense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "436c33e4-a98d-4155-94de-97a5a510fc4d",
                                                "sense_id": "48734a32-e5b9-3173-855e-5d126b28c3d7",
                                                "text": "Parkinsonism, at its severest, presents itself as an akinetic amimia (as opposed to certain cortical disorders which are amimic akinesias)."
                                            },
                                            {
                                                "example_id": "db05f565-ce99-4755-8ce9-8bb890a848c8",
                                                "sense_id": "48734a32-e5b9-3173-855e-5d126b28c3d7",
                                                "text": "In the severer cases of hookworm the patient sometimes has an appetite for soil, paper, hair, clay, chalk, starch, and other unpalatables."
                                            },
                                            {
                                                "example_id": "7eff943c-2324-4938-a01f-c6b08963c2d0",
                                                "sense_id": "48734a32-e5b9-3173-855e-5d126b28c3d7",
                                                "text": "Phoenix and Lubbock are both caught in severe drought, and it is going to get much worse. We may see many such [dust] storms in the decades ahead, along with species extinctions, radical disturbance of ecosystems, and intensified social conflict over land and water. Welcome to the Anthropocene, the epoch when humans have become a major geological and climatic force."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2627c07-730b-3c36-95d2-a7b6fd322cc8",
                                        "entry_id": "3a885929-78f1-3a92-a1b4-5d0e85d4f3cd",
                                        "glosses": [
                                            "Strict or harsh."
                                        ],
