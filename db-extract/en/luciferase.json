                "senses": [
                    {
                        "sense_id": "83afaf2d-93d9-3557-b9b2-9d36565a0819",
                        "entry_id": "586add99-ee6a-3274-8613-8aea8753a4f9",
                        "glosses": [
                            "Any one of a group of enzymes that produce bioluminescence by oxidizing luciferin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec120b5-299e-4ab9-9679-40235b610aeb",
                                "sense_id": "83afaf2d-93d9-3557-b9b2-9d36565a0819",
                                "text": "Aptly enough, glowworms light up their underworld with a pair of chemicals that have a satanic etymology—luciferins and luciferases, after the Latin for “light bringer.”"
                            },
                            {
                                "example_id": "44d698a7-8d87-442d-8fe6-900316a60a6f",
                                "sense_id": "83afaf2d-93d9-3557-b9b2-9d36565a0819",
                                "text": "The novel coronavirus vaccine manufactured by Moderna does not contain luciferin, an organic compound involved in bioluminescence, or the enzyme luciferase, contrary to claims on social media."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "379793af-9660-4ecf-a989-2b8cb84ad019",
                        "source_entry_id": "586add99-ee6a-3274-8613-8aea8753a4f9",
                        "source_sense_id": "83afaf2d-93d9-3557-b9b2-9d36565a0819",
                        "source_sense_description": "biochemistry: any one of a group of enzymes that produce bioluminescence by oxidizing luciferin",
                        "target_lang_word": "luciférase",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luciférase",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e4e5f6f-654a-35b0-abe8-5fd6f37ba3b8",
                                        "entry_id": "fdf4a13d-87fe-328b-9d9b-ca6e35fb2592",
                                        "glosses": [
                                            "Enzyme contrôlant l'oxydation de la luciférine en oxyluciférine provoquant l'émission d'un photon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d992d42-619d-4d85-92c3-f9d2866a35e1",
                                                "sense_id": "7e4e5f6f-654a-35b0-abe8-5fd6f37ba3b8",
                                                "text": "Le plus souvent, la lumière est émise lorsqu'une molécule, la luciférine, est oxydée par une enzyme, la luciférase."
                                            },
                                            {
                                                "example_id": "59b95720-a0b1-4212-b073-7f2690235543",
                                                "sense_id": "7e4e5f6f-654a-35b0-abe8-5fd6f37ba3b8",
                                                "text": "La luciférase la plus connue est celle de Photinus pyralis (la luciole), dont la réaction nécessite la présence d'ATP, hydrolysé en AMP, et de magnésium."
                                            },
                                            {
                                                "example_id": "c6083e6d-4dfd-4e47-b2a4-4a1c96282dfb",
                                                "sense_id": "7e4e5f6f-654a-35b0-abe8-5fd6f37ba3b8",
                                                "text": "« Nous allons insérer des gènes de luciférase et de luciférine, une enzyme et une molécule utilisées par les lucioles, dans une arabette des dames ( Arabidopsis thaliana ), une plante régulièrement utilisée dans les laboratoires de recherche», raconte Kyle Taylor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
