                        "sense_id": "0cc8706f-608e-38c5-a1c2-7982c34843bc",
                        "entry_id": "b4799b91-30ab-3abe-8f98-5beab5bff7fd",
                        "glosses": [
                            "To perform this dance."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "00e5f2c3-7537-421a-987c-bb1e76db233d",
                                "sense_id": "0cc8706f-608e-38c5-a1c2-7982c34843bc",
                                "text": "Joan Baez's frugging on several occasions gave the festival the added flair of an Arthur Murray Dance Party."
                            },
                            {
                                "example_id": "85b7b6d1-f310-41d1-acee-450851248b79",
                                "sense_id": "0cc8706f-608e-38c5-a1c2-7982c34843bc",
                                "text": "\"Do you like frugging?\" \"I'm not sure I...\" \"Oh, come on.\" Betty danced."
                            },
                            {
                                "example_id": "b315dfa3-2260-46d4-b6e1-5c4dd7614ae5",
                                "sense_id": "0cc8706f-608e-38c5-a1c2-7982c34843bc",
                                "text": "A snake charmer merely hypnotizes the creature with his movements. So I began to move the flute, just as Gopal had done. Now I had the cobra frugging."
                            }
                        ]
                    }
