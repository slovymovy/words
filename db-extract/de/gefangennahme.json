                            {
                                "target_word": "capture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83e7ba81-1c8a-372f-90ba-a71d4685db93",
                                        "entry_id": "a09a5683-4dff-327e-a1c4-3cd019326413",
                                        "glosses": [
                                            "To take control of; to seize by force or stratagem."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fffd066b-755c-4845-b081-54b5080c3c01",
                                                "sense_id": "83e7ba81-1c8a-372f-90ba-a71d4685db93",
                                                "text": "to capture an enemy, a vessel, or a criminal"
                                            },
                                            {
                                                "example_id": "abe0a43b-8da8-42a9-a557-d89c2cefda8d",
                                                "sense_id": "83e7ba81-1c8a-372f-90ba-a71d4685db93",
                                                "text": "Arrests and prosecutions intensified after Isis captured Mosul in June, but the groundwork had been laid by an earlier amendment to Jordan’s anti-terrorism law. It is estimated that 2,000 Jordanians have fought and 250 of them have died in Syria – making them the third largest Arab contingent in Isis after Saudi Arabians and Tunisians."
                                            },
                                            {
                                                "example_id": "e5f107a7-1cde-48d1-8c31-857c14390dda",
                                                "sense_id": "83e7ba81-1c8a-372f-90ba-a71d4685db93",
                                                "text": "[…]I said it was because Tillerson hadn't filled the subordinate ranks with appointees who would advance the Administration's policies and that he had, in effect, been captured by the careerists."
                                            },
                                            {
                                                "example_id": "c436fe48-366c-4262-ba00-be0cb45b4b80",
                                                "sense_id": "83e7ba81-1c8a-372f-90ba-a71d4685db93",
                                                "text": "Being so inflexible, the railway was easy prey to road competition, and the arrival of unregulated lorry transport from farm fields to town centres quickly captured all locally generated business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a5db352-4e08-3011-b5f9-40af8ef0ce95",
                                        "entry_id": "a09a5683-4dff-327e-a1c4-3cd019326413",
                                        "glosses": [
                                            "To take hold of."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "446a2c12-2609-43d3-ada6-f920a710aacf",
                                                "sense_id": "2a5db352-4e08-3011-b5f9-40af8ef0ce95",
                                                "text": "The paintings in the gallery really captured my imagination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce21c2b6-6f16-33a7-9b7e-1b379e52db1e",
                                        "entry_id": "a09a5683-4dff-327e-a1c4-3cd019326413",
                                        "glosses": [
                                            "To store (as in sounds or image) for later revisitation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea910205-3595-4cc8-90c2-76f331e25bb9",
                                                "sense_id": "ce21c2b6-6f16-33a7-9b7e-1b379e52db1e",
                                                "text": "She captured the sounds of a subway station on tape."
                                            },
                                            {
                                                "example_id": "e9e212eb-6a13-4bf2-b14b-56c381efc3bb",
                                                "sense_id": "ce21c2b6-6f16-33a7-9b7e-1b379e52db1e",
                                                "text": "She captured the details of the fresco in a series of photographs."
                                            },
                                            {
                                                "example_id": "158d020d-e761-49c9-a4e7-e84cd03dd811",
                                                "sense_id": "ce21c2b6-6f16-33a7-9b7e-1b379e52db1e",
                                                "text": "Ultimately, whether you want to shoot digital or film, the object is to give the client what they want and to capture the image you want, the way you want it to look."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9597c0b4-663f-3a36-a096-ff947a02af2b",
                                        "entry_id": "a09a5683-4dff-327e-a1c4-3cd019326413",
                                        "glosses": [
                                            "To reproduce convincingly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fb572e9-1971-4463-acb5-059ee326d474",
                                                "sense_id": "9597c0b4-663f-3a36-a096-ff947a02af2b",
                                                "text": "His film adaptation captured the spirit of the original work."
                                            },
                                            {
                                                "example_id": "93ea9001-dc53-4695-a589-ebe20921fac4",
                                                "sense_id": "9597c0b4-663f-3a36-a096-ff947a02af2b",
                                                "text": "In her latest masterpiece, she captured the essence of Venice."
                                            },
                                            {
                                                "example_id": "0e39ba58-91c4-40c9-8284-2d159d1e3d29",
                                                "sense_id": "9597c0b4-663f-3a36-a096-ff947a02af2b",
                                                "text": "Winterhalter was gifted at capturing the luxurious fabrics and hairstyles of female royalty and he was commissioned to paint portraits of the continental Empresses Eugénie of France and Elizabeth of Austria."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "478bc89e-e599-3cd9-b804-72b9f102b2ad",
                                        "entry_id": "a09a5683-4dff-327e-a1c4-3cd019326413",
                                        "glosses": [
                                            "To remove or take control of an opponent’s piece in a game (e.g., chess, go, checkers)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e23d94b-6d19-4b91-92f2-f6744c051ef5",
                                                "sense_id": "478bc89e-e599-3cd9-b804-72b9f102b2ad",
                                                "text": "My pawn was captured."
                                            },
                                            {
                                                "example_id": "61e7ebb8-a804-4b23-a8a7-ed49d297516a",
                                                "sense_id": "478bc89e-e599-3cd9-b804-72b9f102b2ad",
                                                "text": "He captured his opponent’s queen on the 15th move."
                                            },
                                            {
                                                "example_id": "0bb66650-800b-439e-b87c-58c892958277",
                                                "sense_id": "478bc89e-e599-3cd9-b804-72b9f102b2ad",
                                                "text": "How deeply ingrained capturing is in the mind of a chess master can be seen from this story."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e079b5d4-72f8-44b9-88a9-e3e016cda420",
                        "source_entry_id": "3fe1cc61-2538-3927-9f21-b7876ecf4e5c",
