                                        "entry_id": "b3dd1ca7-9c21-3f61-b0fc-845f9795667b",
                                        "glosses": [
                                            "A person who brings a ship bad luck."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14ef242d-ee1a-4cd1-8443-fbb1e5c385d1",
                                                "sense_id": "257ae3bf-0621-3dae-b7b3-a0c68312ae42",
                                                "text": "Superstitious sailors regarded a clergyman as an unlucky shipmate, a Jonah whose presence would never be welcome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5c5ce54-a877-3aa1-b2f0-54aa845e1b52",
                                        "entry_id": "b3dd1ca7-9c21-3f61-b0fc-845f9795667b",
                                        "glosses": [
                                            "Any person or object which is deemed to cause bad luck; a jinx."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc71594c-7a4a-4c5a-999d-b4b4d0e95f27",
                                                "sense_id": "e5c5ce54-a877-3aa1-b2f0-54aa845e1b52",
                                                "text": "‘My first agent, and he's dead. It's incredible. I feel like a complete Jonah.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
