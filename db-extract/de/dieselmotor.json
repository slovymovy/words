                    },
                    {
                        "translation_id": "fdae0898-2794-4e1c-a5a3-f5474928fa10",
                        "source_entry_id": "3271fb7f-d502-3dc0-8441-c0f5361a4447",
                        "source_sense_id": "3562099c-1e66-3757-9d2e-1b1d02b7978b",
                        "source_sense_description": "Verbrennungsmotor, der nach dem von Rudolf Diesel erdachten Prinzip arbeitet",
                        "target_lang_word": "moteur Diesel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moteur Diesel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f67da537-4e23-3426-a056-a1937a64ba31",
                                        "entry_id": "0eab121a-36c4-35a3-8aa0-e23e1c321873",
                                        "glosses": [
                                            "Moteur à combustion interne dans lequel la combustion est déclenchée par auto-inflammation, grâce à un taux de compression élevé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2abe9845-627f-4e2f-b406-7881b926362c",
                                                "sense_id": "f67da537-4e23-3426-a056-a1937a64ba31",
                                                "text": "Dans tous les moteurs thermiques à combustion interne réalisés jusqu’ici, la température d’inflammation est obtenue après l’allumage, par la combustion même et pendant son action, tandis que dans le moteur Diesel, la température d’inflammation est obtenue avant la combustion et indépendamment d’elle, par conséquent avant l’allumage, uniquement par une compression mécanique d’air pur."
                                            },
                                            {
                                                "example_id": "f48d0100-ebe4-4cef-8755-7bdb44e3393d",
                                                "sense_id": "f67da537-4e23-3426-a056-a1937a64ba31",
                                                "text": "Le moteur Diesel, sur lequel nous avons déjà attiré l’attention de nos lecteurs, est un moteur dont le principe est des plus originaux, et qui doit être construit prochainement en France."
                                            },
                                            {
                                                "example_id": "e6f50264-d306-4ee9-b806-ace5168728a2",
                                                "sense_id": "f67da537-4e23-3426-a056-a1937a64ba31",
                                                "text": "Le CLM monté par Labourier pour ses modèles LD , est un moteur Diesel deux temps , de conception particulière très simple avec pompe d’injection rudimentaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
