                                "target_senses": [
                                    {
                                        "sense_id": "429bbd05-3d23-3ebc-9a46-8a3248dc6298",
                                        "entry_id": "0cc2b005-6608-3150-a621-b8c9402feae9",
                                        "glosses": [
                                            "Someone gifted or learned to a great extent or in multiple disciplines; a great scholar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72df4ed9-075d-4ada-8d3e-78c8dc75237d",
                                                "sense_id": "429bbd05-3d23-3ebc-9a46-8a3248dc6298",
                                                "text": "A hired diplomat in Edirne and to the Porte in Constantinople, a military commander in the Austro-Turkish wars, a polyhistor and a learned man."
                                            },
                                            {
                                                "example_id": "dd45f781-6ba0-4745-94fa-c7b2d9b52c2d",
                                                "sense_id": "429bbd05-3d23-3ebc-9a46-8a3248dc6298",
                                                "text": "[Carlfriedrich] Claus is an artist, though he does not like to call himself one, and a scholar. As such, he personifies the polyhistor, a species rarely found today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "761b9c5f-bffa-4e06-8477-17c79d5df285",
