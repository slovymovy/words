                {
                    "sense_id": "719b3b14-4b25-3d01-b2b5-946152d004d1",
                    "sense_definition": "Décompresser ou récupérer des données ou des fichiers à partir d'un dossier compressé ou d'une archive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous devez d'abord <w>extraire</w> les fichiers du dossier compressé avant de les ouvrir.",
                            "target_lang_translations": {
                                "en": "You must first <w>unzip</w> the files from the compressed folder before opening them.",
                                "ru": "Сначала нужно <w>распаковать</w> файлы из сжатой папки и только потом открыть их.",
                                "de": "Sie müssen die Dateien zuerst aus dem komprimierten Ordner <w>entpacken</w>, bevor Sie sie öffnen.",
                                "es": "Primero debe <w>descomprimir</w> los archivos de la carpeta comprimida antes de abrirlos.",
                                "zh": "您得先把压缩文件夹里的文件<w>解压</w>出来，然后再打开它们。"
                            }
                        },
                        {
                            "text": "Il a fait un simple clic droit pour <w>extraire</w> le contenu de l'archive téléchargée.",
                            "target_lang_translations": {
                                "en": "He simply right-clicked to <w>extract</w> the contents of the downloaded archive.",
                                "ru": "Он просто щёлкнул правой кнопкой мыши, чтобы <w>извлечь</w> содержимое загруженного архива.",
                                "de": "Er klickte einfach mit der rechten Maustaste, um den Inhalt des heruntergeladenen Archivs zu <w>entpacken</w>.",
                                "es": "Simplemente hizo clic con el botón derecho para <w>extraer</w> el contenido del archivo descargado.",
                                "zh": "他只是点了一下鼠标右键，就把下载的压缩包里的内容<w>解压</w>出来了。"
                            }
                        }
                    ],
