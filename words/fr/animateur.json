    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4120f52d-99c1-31f5-8128-247d5ea1b56a",
                    "sense_definition": "Personne chargée de présenter et de coordonner une émission de radio ou de télévision.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>animateur</w> pose des questions intéressantes aux invités sur le plateau de télévision."
                        },
                        {
                            "text": "Cet <w>animateur</w> de radio présente le journal du matin depuis plus de dix ans."
                        }
                    ],
                    "synonyms": [
                        "présentateur"
                    ],
                    "common_phrases": [
                        "animateur de télévision",
                        "animateur radio"
                    ]
                },
                {
                    "sense_id": "f0099db6-aa97-389c-9d8d-66b11a497f11",
                    "sense_definition": "Personne chargée d'encadrer et de divertir un groupe, en particulier des enfants dans un centre de loisirs ou de vacances.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque été, il travaille comme <w>animateur</w> dans une colonie de vacances au bord de la mer."
                        },
                        {
                            "text": "L'<w>animateur</w> propose des jeux créatifs pour occuper les enfants pendant l'après-midi."
                        }
                    ],
                    "synonyms": [
                        "moniteur"
                    ],
                    "common_phrases": [
                        "animateur de centre aéré",
                        "animateur socioculturel"
                    ]
                },
                {
                    "sense_id": "5f0411c3-ece4-30c1-8c26-6ccfea71f81f",
                    "sense_definition": "Professionnel qui réalise les dessins ou conçoit les mouvements dans un film d'animation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>animateur</w> a passé des mois à peaufiner les mouvements du personnage principal."
                        },
                        {
                            "text": "Ce studio de cinéma emploie une trentaine d'<w>animateurs</w> pour donner vie à ses personnages."
                        }
                    ],
                    "synonyms": [
                        "dessinateur"
                    ],
                    "common_phrases": [
                        "animateur 3D"
                    ]
                },
                {
                    "sense_id": "693a3f3a-615e-3682-abad-28c27e48f998",
                    "sense_definition": "Personne qui impulse une dynamique, stimule l'activité et dirige les discussions au sein d'un groupe ou d'un projet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est révélé être un véritable <w>animateur</w> lors des négociations entre les différents partenaires."
                        },
                        {
                            "text": "L'<w>animateur</w> de la réunion veille à donner la parole à tous les participants."
                        }
                    ],
                    "synonyms": [
                        "meneur",
                        "facilitateur"
                    ],
                    "common_phrases": [
                        "animateur de réunion",
                        "rôle d'animateur"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "335a7721-48f5-3c1f-b426-1174fe29c6ee",
                    "sense_definition": "Qui donne de l'énergie, de la vie ou du mouvement à quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son discours portait un souffle <w>animateur</w> qui a redonné courage à toute l'équipe."
                        },
                        {
                            "text": "Le projet a bénéficié de l'esprit <w>animateur</w> de ses membres fondateurs pour réussir rapidement."
                        }
                    ],
                    "synonyms": [
                        "vivifiant",
                        "stimulant"
                    ],
                    "common_phrases": [
                        "souffle animateur",
                        "principe animateur"
                    ]
                }
            ]
        }
    ]
}