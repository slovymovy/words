                "senses": [
                    {
                        "sense_id": "3efd45fc-1915-3365-a354-b1b0ddd08927",
                        "entry_id": "cd7b9559-b416-3edd-9f2c-290484020197",
                        "glosses": [
                            "Cesser d’être en rage."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cb1a4830-58ed-4ed3-a455-dc96e589a7d0",
                                "sense_id": "3efd45fc-1915-3365-a354-b1b0ddd08927",
                                "text": "Oscar de Bennetot ne dérageait pas, à tel point que, dans son instinct de hobereau mal dégrossi, il proposait simplement de jeter « tout cela » par-dessus bord, c’est-à-dire par l’un des orifices."
                            },
                            {
                                "example_id": "2e8aa6b7-5953-447c-b7e9-044fc7e6a046",
                                "sense_id": "3efd45fc-1915-3365-a354-b1b0ddd08927",
                                "text": "— Tu peux te vanter, jeta Mme d’Arjols à son mari, d’avoir eu une fameuse idée avec ton voyage !\n— Mon voyage !… je crois qu’il ne te déplaisait pas tant que ça… non, tu ne dérages pas depuis le départ, parce que tous tes flirts t’ont lâchée — tu en as fait une tête, au train !… personne !"
                            },
                            {
                                "example_id": "b0e4d0c4-5d7e-4c48-842a-ed51ab49a27c",
                                "sense_id": "3efd45fc-1915-3365-a354-b1b0ddd08927",
                                "text": "Je ne dérage pas. Marcel ici !"
                            }
                        ]
                    }
                ],
