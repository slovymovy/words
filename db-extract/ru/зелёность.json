                                "example_id": "9c1eabad-246f-4465-9d19-50c87f7176b1",
                                "sense_id": "33591c53-733a-329a-a4e8-8cf2cf4d1fc1",
                                "text": "Я зрел себя в пространной долине, потерявшей от солнечного зноя всю приятность и пестроту зелёности"
                            },
                            {
                                "example_id": "519c2e06-f731-492e-b01c-9dc94ae8f363",
                                "sense_id": "33591c53-733a-329a-a4e8-8cf2cf4d1fc1",
                                "text": "Дача отличается зелёностью и уединённостью"
                            }
                        ]
                    }
