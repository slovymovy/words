                        "glosses": [
                            "Qui peut être inventorié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dca76e4-0dcb-44ca-97df-6e4a96bc784a",
                                "sense_id": "3731060a-14c2-3b26-9907-a52fb3e9763a",
                                "text": "On ne possède que ce qui est inventoriable, comptable."
                            },
                            {
                                "example_id": "6cc9dd1c-53ca-4948-b3fa-5740874808df",
                                "sense_id": "3731060a-14c2-3b26-9907-a52fb3e9763a",
                                "text": "Cet argent, nous l’avions, mais sur des fonds destinés à du matériel inventoriable. Or, comment déclarer inventoriable un inventaire ?"
                            },
                            {
                                "example_id": "b741da2a-a64b-4376-93e0-e6dd543a99ac",
                                "sense_id": "3731060a-14c2-3b26-9907-a52fb3e9763a",
                                "text": "On a quelques archives écrites qui parlent de glacier sur le massif, mais trop peu de photos. Un glacier inventoriable doit montrer de la stratification annuelle et doit faire au moins 2 hectares."
                            }
                        ]
                    }
                ],
