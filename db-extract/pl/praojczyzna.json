                        "sense_id": "78b08ff0-4137-3999-8363-e148973086a6",
                        "entry_id": "e5c294be-925f-38d1-879e-1a44badd42eb",
                        "glosses": [
                            "pierwotna siedziba ludów posługujących się językami danej rodziny językowej lub prajęzykiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b352952-d6d8-4154-8c49-a434ac67d8bc",
                                "sense_id": "78b08ff0-4137-3999-8363-e148973086a6",
                                "text": "Część uczonych za ich praojczyznę uznaje tereny dzisiejszego Bahrajnu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
