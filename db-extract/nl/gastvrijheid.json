                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d741231b-a40d-4ded-bab9-762c11ff7c0e",
                        "entry_id": "0c717d69-a657-3b11-8cc0-9f7bd21cbf63",
                        "tags": [
                            "plural"
                        ],
                        "form": "gastvrijheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16785293-3a4e-3982-9712-d6b516f231a6",
                        "entry_id": "0c717d69-a657-3b11-8cc0-9f7bd21cbf63",
                        "glosses": [
                            "hartelijkheid voor gasten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5b0e406-3e57-4a00-8dc0-9dd1f0c9b891",
                                "sense_id": "16785293-3a4e-3982-9712-d6b516f231a6",
                                "text": "Jaren later liep ik op mijn 42ste de 88 Tempels Trail, een pelgrimstocht van 1.300 kilometer door Japan. Daar ondervond ik voor het eerst hoe verslavend lopen kan zijn. De Japanse bergen, tempels en gastvrijheid waren indrukwekkend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a35768af-ef84-4c7e-8484-3318de067bae",
                        "source_entry_id": "0c717d69-a657-3b11-8cc0-9f7bd21cbf63",
                        "source_sense_id": "16785293-3a4e-3982-9712-d6b516f231a6",
                        "target_lang_word": "Gastfreiheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gastfreiheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f697cdad-8099-3091-b13f-5870284ddc1b",
                                        "entry_id": "47865975-5f09-3631-8480-15bf5ac790e4",
                                        "glosses": [
                                            "Bereitschaft, Gäste aufzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "449e2aa2-c7b2-4ada-90f8-39f92b187789",
                                                "sense_id": "f697cdad-8099-3091-b13f-5870284ddc1b",
                                                "text": "„Diese Gastfreiheit habe ich gewiß der Alten dort in der Ecke zu verdanken, und auf meine ausdrücklichen Mienen und Zeichen wird auch ihr etwas von dem Fleisch angeboten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2da0e751-553e-423f-ae2d-8ad6784ac8d8",
                        "source_entry_id": "0c717d69-a657-3b11-8cc0-9f7bd21cbf63",
                        "source_sense_id": "16785293-3a4e-3982-9712-d6b516f231a6",
                        "target_lang_word": "Gastfreundlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gastfreundlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78ed06f4-0109-348c-8516-65623ee9df93",
                                        "entry_id": "e4e4cb3f-faab-3fe7-8d20-55278f79d08a",
                                        "glosses": [
                                            "Eigenschaft, freundlich und aufmerksam zu Gästen zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d84235a9-f01d-4e09-8e63-75c6a2c34036",
                                                "sense_id": "78ed06f4-0109-348c-8516-65623ee9df93",
                                                "text": "„Es liegt eine warmherzige und nicht aufgesetzte Gastfreundlichkeit in der Luft dieses Hauses.“"
                                            },
                                            {
                                                "example_id": "c0b5f46b-d4ec-4a3e-866a-aa6a2ff5c86c",
                                                "sense_id": "78ed06f4-0109-348c-8516-65623ee9df93",
                                                "text": "„In der Stadt gibt es viele gute Restaurants, mit umfangreichen Weinkarten und vernünftigen Preisen, die Gastfreundlichkeit ist überzeugend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                        "entry_id": "e4e4cb3f-faab-3fe7-8d20-55278f79d08a",
                                        "glosses": [
                                            "kleine Aufmerksamkeit, Wohltat, die man einem Gast gewährt; kleines Geschenk für einen Gast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae56e13e-f276-4511-ad3b-39af83cd1fd2",
                                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                                "text": "„»In Usbekistan sind wir drei Tage von der Familie eines Lastwagenfahrers beherbergt worden, der uns zuvor durch sein Land begleitet hatte«, berichtet Thilo. »Wir wissen manchmal gar nicht, wie wir all diese Gastfreundlichkeiten zurückgeben sollen«, fügt Daniela hinzu.“"
                                            },
                                            {
                                                "example_id": "47b171c9-f353-4751-b04c-962dfbda4354",
                                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                                "text": "„Die obligaten Gastfreundlichkeiten: Baden, Essen, Ausruhen wurden uns gewährt, […].“"
                                            },
                                            {
                                                "example_id": "3de4ae6b-3b6e-43e2-b887-fddf4835dd17",
                                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                                "text": "„Wir verwöhnen unsere Gäste mit hofeigenen Produkten und Gastfreundlichkeiten.“"
                                            },
                                            {
                                                "example_id": "500a3a7e-f2e4-4fb9-ba00-dca5049d0ad2",
                                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                                "text": "„Galvez bezeigte mir viele vorzügliche Gastfreundlichkeiten und hat mir in vielen Dingen geholfen, […].“"
                                            },
                                            {
                                                "example_id": "7d683f4b-092e-425e-a327-c92a9ba50842",
                                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                                "text": "„Nun werden den Censoren Thee, ein Feuerbecken zum Rauchen und Süßigkeiten vorgesetzt. Aber sie weisen die Annahme solcher Gastfreundlichkeiten bis zur Beendigung ihres Geschäfts zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c6964cd-11ab-411b-8a94-d55aeb12509d",
                        "source_entry_id": "0c717d69-a657-3b11-8cc0-9f7bd21cbf63",
                        "source_sense_id": "16785293-3a4e-3982-9712-d6b516f231a6",
                        "target_lang_word": "hospitality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hospitality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                        "entry_id": "1842c77f-5d73-3142-acdc-d02f5fbe6eef",
                                        "glosses": [
                                            "The act or service of welcoming, receiving, hosting, or entertaining guests; an appropriate attitude of openness, respect, and generosity toward guests."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "199fb305-dccb-4a5a-abd2-988bd8fd5a1e",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "Please thank our hosts for their hospitality during the week that we stayed."
                                            },
                                            {
                                                "example_id": "60075b7c-1227-4f68-b1fa-491e92318fea",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "\"Quarrels!\" said Charles; \"do not use so disagreeable a word. I am thinking of nothing but the thanks I owe Lord Avonleigh for his hospitality\"—Lord Avonleigh bent to the very edge of the table—\"and the favours I am about to ask.\""
                                            },
                                            {
                                                "example_id": "02d94b7c-4fae-457d-90d5-8e622c6acfa3",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "In Ancient Times, as Story tells, / The Saints would often leave their Cells, / And ſtrole about, but hide their Quality, / To try good Peoples Hoſpitality."
                                            },
                                            {
                                                "example_id": "48ae4569-51bb-4d8e-a22d-bb9beb762db3",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "Mr Venus, reminded of the duties of hospitality, produced some rum."
                                            },
                                            {
                                                "example_id": "91c88941-3df6-4ac8-85f8-8e134cffdd46",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "We were over the border here, into Northern Ireland, and the post office had a very English atmosphere. It was pleasant, too, much as we enjoyed the hospitality of the Republic, to be buying stamps with the Queen's head on them, and to be posting our cards in a red pillar-box, instead of a green one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43bc7237-395f-3d82-a39a-1dd6627df7bf",
                                        "entry_id": "1842c77f-5d73-3142-acdc-d02f5fbe6eef",
                                        "glosses": [
                                            "The business of providing catering, lodging and entertainment service; the industry which includes the operation of hotels, restaurants, and similar enterprises."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "371af1a1-fab0-4f66-9d1f-7b221636cbaa",
                                                "sense_id": "43bc7237-395f-3d82-a39a-1dd6627df7bf",
                                                "text": "After graduating from college, she found a job in hospitality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36342425-22c3-37f5-8837-ef17c6e80314",
                                        "entry_id": "1842c77f-5d73-3142-acdc-d02f5fbe6eef",
                                        "glosses": [
                                            "The food, drink, and entertainment given to customers by a company or organization or provided to visitors by a private host."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90c701a4-95b3-4618-9589-c2ac12242870",
                        "source_entry_id": "0c717d69-a657-3b11-8cc0-9f7bd21cbf63",
                        "source_sense_id": "16785293-3a4e-3982-9712-d6b516f231a6",
                        "target_lang_word": "hospitalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hospitalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29c01103-1a22-3930-ad60-f1118a59ae74",
                                        "entry_id": "1de481b8-7a64-3bb7-80b8-a4efe78e93f8",
                                        "glosses": [
                                            "État de qui est hospitalier, générosité de cœur, sociabilité qui dispose à accueillir quelqu'un chez soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab2e1a0a-990a-463b-ad59-a1ec4b70e288",
                                                "sense_id": "29c01103-1a22-3930-ad60-f1118a59ae74",
                                                "text": "Un cœur plein de bienveillance et d'hospitalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b65c64a9-d212-3f6f-b00d-adc41912f7cd",
                                        "entry_id": "1de481b8-7a64-3bb7-80b8-a4efe78e93f8",
                                        "glosses": [
                                            "Charité, libéralité qu’on exerce en recevant en logeant gratuitement les étrangers, les passants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34af5e7f-d8ba-4a3b-b6b1-82781b410375",
                                                "sense_id": "b65c64a9-d212-3f6f-b00d-adc41912f7cd",
                                                "text": "Il se dirigea donc vers la première maison dont il vit les fenêtres briller dans l’ombre, se présenta comme un voyageur égaré, […], et l’hospitalité lui fut accordée avec toute la franchise et la discrétion allemandes."
                                            },
                                            {
                                                "example_id": "9d011b97-08de-4f84-b7ab-a99e4b55c0ef",
                                                "sense_id": "b65c64a9-d212-3f6f-b00d-adc41912f7cd",
                                                "text": "Il m’apprend que les troupes chérifiennes viennent de lui razzier un troupeau de plusieurs centaines de moutons. Cela ne l’empêche pas d’en sacrifier un à l’hospitalité et de le faire transformer en cous-cous et en tâjin excellents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e81e926-ca7b-3463-9084-6cd177193d9a",
                                        "entry_id": "1de481b8-7a64-3bb7-80b8-a4efe78e93f8",
                                        "glosses": [
                                            "Action de recevoir chez soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc858c3d-f86c-4553-897d-96b15a8531ec",
                                                "sense_id": "5e81e926-ca7b-3463-9084-6cd177193d9a",
                                                "text": "Voulant en ce moment éblouir le peuple par son hospitalité et sa magnificence, il avait ordonné de grands préparatifs afin de rendre ce festin aussi splendide que possible."
                                            },
                                            {
                                                "example_id": "75689f12-0019-4b0c-aede-47a954e93212",
                                                "sense_id": "5e81e926-ca7b-3463-9084-6cd177193d9a",
                                                "text": "Toutes les fois qu’un Indien peau-rouge n’a pas été froissé par l’injustice, l’accueil qu’il fait à son frère blanc est un exemple touchant de cette hospitalité qu’on ne rencontre que chez les peuples sauvages."
                                            },
                                            {
                                                "example_id": "0542fa2e-5375-400c-9a3a-3e28ac75118a",
                                                "sense_id": "5e81e926-ca7b-3463-9084-6cd177193d9a",
                                                "text": "La maîtresse de maison a, dans Homère, la moitié du gouvernement, tous les soins intérieurs, ceux même de l’hospitalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "572c4781-2d33-3632-acc8-f022d1dd4b12",
                                        "entry_id": "1de481b8-7a64-3bb7-80b8-a4efe78e93f8",
                                        "glosses": [
                                            "Obligation où étaient certaines abbayes de recevoir les voyageurs pendant quelques jours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0abe1abe-a482-45a7-b378-82f6b8572805",
                                                "sense_id": "572c4781-2d33-3632-acc8-f022d1dd4b12",
                                                "text": "Il y avait hospitalité dans telle abbaye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ce3aee1-e8eb-3493-8c81-ce26df7c166f",
                                        "entry_id": "1de481b8-7a64-3bb7-80b8-a4efe78e93f8",
                                        "glosses": [
                                            "Droit réciproque de loger les uns chez les autres ; droit qui s’exerçait non seulement de particulier à particulier et de famille à famille, mais encore de ville à ville."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac524d9f-3225-449d-b1b6-f887323fff08",
                                                "sense_id": "2ce3aee1-e8eb-3493-8c81-ce26df7c166f",
                                                "text": "Il y avait droit d’hospitalité entre Athènes et Lacédémone."
                                            },
                                            {
                                                "example_id": "50fa201f-53fd-4206-9b57-1b340323f817",
                                                "sense_id": "2ce3aee1-e8eb-3493-8c81-ce26df7c166f",
                                                "text": "Droit d’hospitalité."
                                            },
                                            {
                                                "example_id": "353b0581-ea32-426e-bd76-4b6e0f7daa5e",
                                                "sense_id": "2ce3aee1-e8eb-3493-8c81-ce26df7c166f",
                                                "text": "Il y avait hospitalité entre ces deux familles."
                                            },
                                            {
                                                "example_id": "fa6f5308-bb19-4a2a-9b5f-4260c3068e55",
                                                "sense_id": "2ce3aee1-e8eb-3493-8c81-ce26df7c166f",
                                                "text": "Violer les droits de l’hospitalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
