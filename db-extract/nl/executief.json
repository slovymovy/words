                                        "sense_id": "35985067-1220-388c-9a21-5bb8a399af48",
                                        "entry_id": "bed36fff-05a6-3398-b8f0-2205feb5669f",
                                        "glosses": [
                                            "die Exekutive betreffend, zur ihr gehörend, ihre Rechte besitzend, sie ausübend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b226759-0940-4cc1-9074-0b20f558f5df",
                                                "sense_id": "35985067-1220-388c-9a21-5bb8a399af48",
                                                "text": "„Zunächst, in Abwesenheit ihres altgedienten Vorsitzenden, hatten die Unabhängigen es halsstarrig abgelehnt, Nichtsozialisten in die Regierung aufzunehmen, und sei es auch nur als Fachleute ohne exekutive Befugnisse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
