                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plch",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "5b3f8464-25d1-3c93-a38e-0765e93b7ee6",
                                        "entry_id": "fbb2f471-94af-31c0-ac9e-2dcf9e4bde14",
                                        "glosses": [
                                            "rod malých nočních hlodavců"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52a9fd37-fb7f-4a6d-8a78-17410a0a0fab",
                                                "sense_id": "5b3f8464-25d1-3c93-a38e-0765e93b7ee6",
                                                "text": "V ptačí budce se choulil plch."
                                            },
                                            {
                                                "example_id": "72867e3c-1046-4845-923b-31eb7dfc3162",
                                                "sense_id": "5b3f8464-25d1-3c93-a38e-0765e93b7ee6",
                                                "text": "Jak připomíná list Corriere della Sera, šéfové jednotlivých klanů činili ta nejdůležitější rozhodnutí právě nad talířem pečených plchů."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56eef27b-aea2-46b2-9927-6c2b7d3f6730",
                        "source_entry_id": "c0ca734d-9415-36ad-96e2-5bc7e07be7ef",
                        "source_sense_id": "97065765-b2b4-3563-9eb7-b02010e763bc",
                        "target_lang_word": "Bilch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bilch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d705eb05-ad44-3a66-b51a-bee37c9be14b",
                                        "entry_id": "655c788c-3358-3454-8cd5-410640de9ebc",
                                        "glosses": [
                                            "Vertreter einer Gruppe von scheuen, nachtaktiven, baumlebenden Nagetieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a51c4485-3897-4120-a596-95eaa50f7f27",
                                                "sense_id": "d705eb05-ad44-3a66-b51a-bee37c9be14b",
                                                "text": "Die Bilche stehen zwischen den Mäusen und Eichhörnchen und leben von Samen, Früch[t]en, Insekten und Vogelbrut."
                                            },
                                            {
                                                "example_id": "2db67b9b-7276-463b-a4d4-405dd6ad5d64",
                                                "sense_id": "d705eb05-ad44-3a66-b51a-bee37c9be14b",
                                                "text": "„Zwei Bilche, kleine Schlafmäuse, die beim Anblick meines dampfenden Körpers Schutz in der Weite der Heidelbeersträucher suchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
