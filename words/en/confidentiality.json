    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3e7aa60-3c02-3646-b602-45242aa7c126",
                    "sense_definition": "The state of keeping information private or secret, especially within a professional or legal context.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "privacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor emphasized that patient <w>confidentiality</w> is a fundamental part of medical ethics.",
                            "target_lang_translations": {
                                "ru": "Врач подчеркнул, что <w>конфиденциальность</w> данных пациента является фундаментальной частью медицинской этики."
                            }
                        },
                        {
                            "text": "All employees must sign a <w>confidentiality</w> agreement to protect the company's trade secrets.",
                            "target_lang_translations": {
                                "ru": "Все сотрудники должны подписать соглашение о <w>конфиденциальности</w> для защиты коммерческой тайны компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "privacy",
                        "secrecy"
                    ],
                    "antonyms": [
                        "publicity",
                        "transparency",
                        "disclosure"
                    ],
                    "common_phrases": [
                        "confidentiality agreement",
                        "breach of confidentiality",
                        "maintain confidentiality",
                        "patient confidentiality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние сохранения информации в тайне или секрете, особенно в профессиональном или юридическом контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфиденциальность",
                                "target_lang_sense_clarification": "сохранение тайны информации"
                            },
                            {
                                "target_lang_word": "секретность",
                                "target_lang_sense_clarification": "режим неразглашения данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d408f9d-038e-3ad9-8fa6-a9aee466363d",
                    "sense_definition": "A secret or a private matter shared in confidence with someone else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "secrets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two friends spent the evening sharing <w>confidentialities</w> about their personal lives.",
                            "target_lang_translations": {
                                "ru": "Двое друзей провели вечер, делясь <w>секретами</w> о своей личной жизни."
                            }
                        },
                        {
                            "text": "He was careful not to betray any <w>confidentiality</w> entrusted to him by his mentor.",
                            "target_lang_translations": {
                                "ru": "Он старался не выдать ни одной <w>тайны</w>, доверенной ему наставником."
                            }
                        }
                    ],
                    "synonyms": [
                        "secret",
                        "confidence"
                    ],
                    "common_phrases": [
                        "share confidentialities",
                        "exchange confidentialities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Секрет или личное дело, доверенное кому-либо по секрету."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "секрет",
                                "target_lang_sense_clarification": "тайная информация"
                            },
                            {
                                "target_lang_word": "откровенность",
                                "target_lang_sense_clarification": "доверительное признание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
