                                        "glosses": [
                                            "To creep; crawl; to move slowly, with difficulty, fearfully, or stealthily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a748a46-5846-468f-bef8-3de4d6f6131a",
                                                "sense_id": "279784ce-c27f-3e5f-bc64-763707e2182f",
                                                "text": "we will scrape and scrawl, and catch and pull to us all that we may get"
                                            },
                                            {
                                                "example_id": "aafd4654-f5e2-4e52-8f8c-f67b87fba112",
                                                "sense_id": "279784ce-c27f-3e5f-bc64-763707e2182f",
                                                "text": "When I saw him scrawlen on the plain, My heart aw flacker'd for't, I was sae fain."
                                            },
                                            {
                                                "example_id": "cd1f7aa4-e11d-4556-827f-bbab34939562",
                                                "sense_id": "279784ce-c27f-3e5f-bc64-763707e2182f",
                                                "text": "T'poor pig what had just scrawled through t'bottom o' t'cart,"
                                            },
                                            {
                                                "example_id": "9769f607-d249-4220-a928-0ee8d4c2968e",
                                                "sense_id": "279784ce-c27f-3e5f-bc64-763707e2182f",
                                                "text": "'Cut its throat,' I calls to him, but he didn't, just slashes its forepaw; but it dropt di-rekly, couldn't hardly scrawl out on the bank.'"
                                            }
