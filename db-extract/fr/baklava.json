                        "entry_id": "27b1e05f-3220-39ad-be4f-b2ed066c6895",
                        "glosses": [
                            "Petit gâteau oriental à pâte feuilletée, selon les recettes, on y trouve miel, noix, noisettes, amandes, pistaches, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a14141-b6cb-4157-a18b-40b703d84b6d",
                                "sense_id": "67b0715b-3afc-3ad8-ab75-353217fa8702",
                                "text": "Ébahie par ce rêve décidément incroyable, Tallie prit le baklava que son Elias imaginaire lui tendait et le croqua."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91eb8d76-ec31-4ba8-a125-c942cf407d7a",
                        "source_entry_id": "27b1e05f-3220-39ad-be4f-b2ed066c6895",
                        "source_sense_id": "67b0715b-3afc-3ad8-ab75-353217fa8702",
                        "target_lang_word": "Baklava",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baklava",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1869df99-f661-339a-997f-3d4695f60ec5",
                                        "entry_id": "cc893ec2-958c-3b68-a8d6-1bdf1f951cdb",
                                        "glosses": [
                                            "Blätterteigpastete, die in Honig- oder Zuckersirup eingelegt und mit gehackten Walnüssen, Mandeln oder Pistazien gefüllt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feac938b-afd9-4bcd-b43a-c54c8af3495b",
                                                "sense_id": "1869df99-f661-339a-997f-3d4695f60ec5",
                                                "text": "Viele Europäer können nicht viel Baklava essen, da sie fett ist und mit Zuckerwasser übergossen wird, das auf ein Maß Wasser ein Maß Zucker beinhaltet."
                                            },
                                            {
                                                "example_id": "79d3f561-d7df-4835-a792-90ab98912e3f",
                                                "sense_id": "1869df99-f661-339a-997f-3d4695f60ec5",
                                                "text": "„Zum Nachtisch gibt es eine Süßspeise, von der Honig tropft. »Ich habe so oft davon geträumt, eine Baklava zu essen. Diese Freude hört nicht auf.«“"
                                            },
                                            {
                                                "example_id": "8f7f7440-67b0-419d-85c1-7d47c7449300",
                                                "sense_id": "1869df99-f661-339a-997f-3d4695f60ec5",
                                                "text": "„Mara hat natürlich keine Ahnung, wer dieser Ohnesorg ist, und sie kann sich auch nicht mehr daran erinnern, ob Baklava nun der Ausdruck für den karierten Palästinenserschal ist oder für Blätterteiggebäck.“"
                                            },
                                            {
                                                "example_id": "6eb5cf71-8ff4-48da-ae32-41cbc2452e2a",
                                                "sense_id": "1869df99-f661-339a-997f-3d4695f60ec5",
                                                "text": "„Wir wurden mit Baklava und Wassermelonen gefüttert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "027700a6-0014-4717-8546-fd928b370e88",
                        "source_entry_id": "27b1e05f-3220-39ad-be4f-b2ed066c6895",
                        "source_sense_id": "67b0715b-3afc-3ad8-ab75-353217fa8702",
