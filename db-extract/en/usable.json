                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05ef400b-3e27-44c1-a829-2ac8745890de",
                        "source_entry_id": "b62f3ad8-5a7f-3582-a0ac-30f2d8f9566c",
                        "source_sense_description": "capable of being used",
                        "target_lang_word": "bruikbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bruikbaar",
