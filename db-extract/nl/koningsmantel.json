                    {
                        "translation_id": "e0ae8e61-54fa-47bb-961e-2d6a03a109b5",
                        "source_entry_id": "d91767b7-62c9-3c68-b5b4-3ec02a20cc51",
                        "source_sense_id": "bfbf810d-7c9b-36a7-9439-dd13fed7b648",
                        "source_sense_description": "een dagvlinder uit de Nymphalidae-familie",
                        "target_lang_word": "morio",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morio",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86c811e5-b86c-37db-85e1-3d53103f0954",
                                        "entry_id": "75ebef5a-28ab-36db-b104-4579051b4d61",
                                        "glosses": [
                                            "Grand papillon de jour de la famille des nymphalidés, dont le dos des ailes est de couleur violet foncé avec une bande marginale jaune devenue blanche après hibernation doublée d'une série complète de taches marginales bleues."
                                        ],
                                        "tags": [
                                            "Lépidoptérologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cbe72cb-d8b2-499d-ac41-1da039429519",
                                                "sense_id": "86c811e5-b86c-37db-85e1-3d53103f0954",
                                                "text": "La chenille du morio ou chenille épineuse de l’orme se nourrit sur des arbres : l'orme, le bouleau, le saule marsaut, parfois le peuplier."
                                            },
                                            {
                                                "example_id": "dbbc33ff-5942-4dd1-8ea0-8c9f32b619d1",
                                                "sense_id": "86c811e5-b86c-37db-85e1-3d53103f0954",
                                                "text": "Tous nos grands papillons des bois, les morios bruns, lisérés de jaune, les vulcains diaprés d’un rouge feu, les mars à la robe couleur d’iris."
                                            },
                                            {
                                                "example_id": "d3a45486-b7b1-4064-9421-b7ab84e3a752",
                                                "sense_id": "86c811e5-b86c-37db-85e1-3d53103f0954",
                                                "text": "Dans l’Europe centrale et dans l’Amérique du Nord vit la belle vanesse si connue des amateurs sous le nom de morio."
                                            },
                                            {
                                                "example_id": "c2a62a10-3c4f-4c4b-97a8-e07d719e90b2",
                                                "sense_id": "86c811e5-b86c-37db-85e1-3d53103f0954",
                                                "text": "Ç’avait été une erreur pour Nahum de raconter à un citadin enraciné la façon dont les morios, ces noirs papillons de la saxifrage, étaient devenus géants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
