                        "entry_id": "5e37be37-6f8d-382d-ad36-07f5595cae28",
                        "glosses": [
                            "A three-dimensional image of an object created by holography."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26de95fc-a361-4e2c-9c51-7adbdd226cb9",
                                "sense_id": "06ac63e6-1ae8-3b10-a548-0e618f6b4272",
                                "text": "He turned his head and stared out to sea, longing for the hologram logo of Fuji Electric, for the drone of a helicopter, anything at all."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8aa583e-5477-42a3-a176-d4826b6fd7ed",
