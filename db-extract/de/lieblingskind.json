                ],
                "senses": [
                    {
                        "sense_id": "c98afc4c-a2e0-3c59-bc70-760b0b8a665f",
                        "entry_id": "8f55a0e8-f821-3fd1-8254-78158fc78464",
                        "glosses": [
                            "das Kind, das von seinen Eltern oder von einem Elternteil unter den Geschwistern am meisten geliebt und deswegen bevorzugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "490e907c-0ec0-419b-a523-7d45c55fe659",
                                "sense_id": "c98afc4c-a2e0-3c59-bc70-760b0b8a665f",
                                "text": "Der plötzliche Tod seiner ältesten Tochter warf Gregor völlig aus der Bahn, denn sie war insgeheim sein Lieblingskind gewesen."
                            },
                            {
                                "example_id": "8d963c58-787b-4fe0-87a3-03631e12dda2",
                                "sense_id": "c98afc4c-a2e0-3c59-bc70-760b0b8a665f",
                                "text": "Siegbert bekommt den größten Teil des Erbes. Er war schließlich immer das Lieblingskind unserer Eltern."
                            },
                            {
                                "example_id": "6a03fdf3-5960-49f4-afa8-21ba2c023849",
                                "sense_id": "c98afc4c-a2e0-3c59-bc70-760b0b8a665f",
                                "text": "„Bisher war dieser Reaktortyp nicht gerade das Lieblingskind der Kernindustrie.“"
                            },
                            {
                                "example_id": "26ef93da-ed9e-4a3d-a58c-5574bdc70509",
                                "sense_id": "c98afc4c-a2e0-3c59-bc70-760b0b8a665f",
                                "text": "„Kroatien mausert sich zum Lieblingskind des Westens.“"
                            },
                            {
                                "example_id": "e9b335fe-55be-4608-93a5-b92d875e88c0",
                                "sense_id": "c98afc4c-a2e0-3c59-bc70-760b0b8a665f",
                                "text": "„Neidisch schielen die Realschulen auf das Lieblingskind von Grün-Rot: die neue Gemeinschaftsschule.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
