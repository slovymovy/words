                    {
                        "sense_id": "9a6889cb-e8e1-337f-8cc9-b5b8697e9b79",
                        "entry_id": "04f61a9c-b4b8-3e6a-87fc-be5c1a89e71c",
                        "glosses": [
                            "Féminin singulier de menteur."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e562d327-ad01-4e89-8220-10536f65e10d",
                                "sense_id": "9a6889cb-e8e1-337f-8cc9-b5b8697e9b79",
                                "text": "À lire absolument pour l’apologie des grands-parents maternels polytoxicos solidement rétablis et pour l’hymne d’amour à la mère indigne alcoolo, voleuse, menteuse, violente, abusive, droguée, irrécupérable."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
