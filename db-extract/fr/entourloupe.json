                    },
                    {
                        "form_id": "1d660b45-aa98-4bb5-8fb4-843328c54e5e",
                        "entry_id": "9bfdd6ce-ea5e-3591-883e-50f5804bb5ac",
                        "tags": [],
                        "form": "entourloupette"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d89ffef-7ebf-31ee-b0d6-e3985e53a018",
                        "entry_id": "9bfdd6ce-ea5e-3591-883e-50f5804bb5ac",
                        "glosses": [
                            "Duperie, tromperie, mensonge."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d7d03dbc-0ca7-452d-8f4e-20a89c4a3054",
                                "sense_id": "5d89ffef-7ebf-31ee-b0d6-e3985e53a018",
                                "text": "Qu’il ait eu besoin de gardes du corps prouve qu’il devait être encore en train de préparer une entourloupe à quelqu’un."
                            },
                            {
                                "example_id": "ea27de90-e6ac-4127-b737-c474e7c90221",
                                "sense_id": "5d89ffef-7ebf-31ee-b0d6-e3985e53a018",
                                "text": "Juppé, quant à lui, sent l’entourloupe. D’abord, il n’a jamais caché le profond mépris que lui inspire Baroin, et la simple idée de devoir former un « ticket » avec le maire de Troyes lui donne des haut-le-cœur."
                            },
                            {
                                "example_id": "b9c694ab-983e-42ae-a142-3fdfc651d5e2",
                                "sense_id": "5d89ffef-7ebf-31ee-b0d6-e3985e53a018",
                                "text": "Déjà, ceux qui se préparent à prendre le relais dans la gestion de la pandémie ont perdu de précieuses semaines à cause des obstacles qu’il a semés et, dans plusieurs ministères, les responsables démocrates de la transition s’attendent à des entourloupes."
                            },
                            {
                                "example_id": "8783b792-f2be-4cfc-900b-0e3d6a67b528",
                                "sense_id": "5d89ffef-7ebf-31ee-b0d6-e3985e53a018",
                                "text": "Par une entourloupe juridique Joseph Lory accusait Furcy de marronnage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e71f4449-e86f-4ebc-b00e-782a63b95b43",
                        "source_entry_id": "9bfdd6ce-ea5e-3591-883e-50f5804bb5ac",
                        "source_sense_id": "5d89ffef-7ebf-31ee-b0d6-e3985e53a018",
                        "target_lang_word": "Schabernack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schabernack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                        "entry_id": "1d9872bd-fe4e-3f6d-9260-aaad5f7fd43d",
                                        "glosses": [
                                            "Handlung, mit der jemandem ein Scherz, ein Streich gespielt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c3b735f-750e-44da-b55f-746b6a7b38b7",
                                                "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                                "text": "Lass bitte den Schabernack sein!"
                                            },
                                            {
                                                "example_id": "563594ce-635b-4a48-9a03-eb834c316ba3",
                                                "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                                "text": "Ich treibe für mein Leben gerne Schabernack!"
                                            },
                                            {
                                                "example_id": "bd2b0a65-301c-46a8-9a58-064640d85aa3",
                                                "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                                "text": "„Weil Konrad ein lustiger Bruder war und deshalb bei einem Teile der Jungmannschaft gut gelitten war, so taten sie seinem Schwager einen Schabernack nach dem anderen an.“"
                                            },
                                            {
                                                "example_id": "f7613cd3-90d8-473c-8359-43cafa769b4d",
                                                "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                                "text": "„Es war, als ob etwas in ihm, ein innerer Feind, seinen Schabernack mit ihm trieb und ihn in Verlegenheit bringen wollte.“"
                                            },
                                            {
                                                "example_id": "22db87dc-403f-47ed-bb1a-6563d4ac346a",
                                                "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                                "text": "„Helmina trieb mit den dreien sogleich ihren Schabernack.“"
                                            },
                                            {
                                                "example_id": "fd707c33-636d-4f7c-99f8-af8b4c70d15d",
                                                "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                                "text": "„Heute ist mir nach Schabernack zumute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "41b70659-5b36-3fc6-a061-c4d9e9c671ae",
                                        "entry_id": "1d9872bd-fe4e-3f6d-9260-aaad5f7fd43d",
