                "word": "palissandre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c0c43eef-9513-45d1-9cdc-f4ddbb77c825",
                        "entry_id": "f1ff0b77-4db5-3261-86d6-c3aadb3d5225",
                        "tags": [
