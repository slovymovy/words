                ],
                "senses": [
                    {
                        "sense_id": "480d0f42-325f-3eec-9eb3-649b4df1cf26",
                        "entry_id": "673e195d-4bb9-396f-a507-ca2accdc3237",
                        "glosses": [
                            "In a just or fair manner; rightfully."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fdcea92-28e7-4d8a-9445-49980099386e",
                                "sense_id": "480d0f42-325f-3eec-9eb3-649b4df1cf26",
                                "text": "His valor, wisdom, and justice made him justly popular, but caused him to be regarded with suspicion at Rome."
                            },
                            {
                                "example_id": "d45cc367-5b84-41d1-b2b9-bde6f369569d",
                                "sense_id": "480d0f42-325f-3eec-9eb3-649b4df1cf26",
                                "text": "Mention must be made of the Valdres Folk Museum, situated just outside the town—one of those fascinating open-air museums for which Scandinavia is justly famed, to which have been transplanted a number of ancient buildings, such as farmhouses and storehouses, full of appropriate furniture, costumes and other exhibits."
                            }
                        ]
                    },
                    {
                        "sense_id": "06386027-b66a-3935-9d60-13d0504ec42d",
                        "entry_id": "673e195d-4bb9-396f-a507-ca2accdc3237",
                        "glosses": [
                            "With a just or fair use of language; with good reason, properly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1997e5aa-b073-4876-ba67-06c95c2fa49e",
                                "sense_id": "06386027-b66a-3935-9d60-13d0504ec42d",
                                "text": "But the city on the River Clyde can justly claim to have turned the tide."
                            }
                        ]
                    },
                    {
                        "sense_id": "5982e073-52ca-39c0-9734-fdf0af3a8610",
                        "entry_id": "673e195d-4bb9-396f-a507-ca2accdc3237",
                        "glosses": [
                            "With great precision; accurately, exactly."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9b7e8398-00a3-4e11-8b0f-7464487149ad",
                                "sense_id": "5982e073-52ca-39c0-9734-fdf0af3a8610",
                                "text": "It is a pleasant imagination to conceive a spirit iustly ballanced betweene two equall desires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ea635b4-dd28-4e98-98e8-d9980f4f6fb9",
                        "source_entry_id": "673e195d-4bb9-396f-a507-ca2accdc3237",
