                "senses": [
                    {
                        "sense_id": "28cdeb61-4ea5-33f5-bf48-5d30802a833d",
                        "entry_id": "9954a526-87e6-3fa9-9677-b28021bfb963",
                        "glosses": [
                            "устар. длинный женский шарф из меха или перьев"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a6d386-9931-44d4-b45c-55450260041f",
                                "sense_id": "28cdeb61-4ea5-33f5-bf48-5d30802a833d",
                                "text": "Он счастлив, если ей накинет // Боа пушистый на плечо, // Или коснётся горячо // Её руки, или раздвинет // Пред нею пёстрый полк ливрей, // Или платок подымет ей."
                            },
                            {
                                "example_id": "9d34f459-6644-4ddf-8f89-8df9f0944400",
                                "sense_id": "28cdeb61-4ea5-33f5-bf48-5d30802a833d",
                                "text": "У самого подъезда он встретился с высокой, тощей брюнеткой, окутанной в длинное боа."
                            }
                        ]
                    }
                ],
