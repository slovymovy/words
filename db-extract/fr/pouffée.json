                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14c90419-9175-4c64-a89f-64a179fac133",
                                "sense_id": "742b58ae-e446-320b-b1e6-78e6bbb2a8f3",
                                "text": "Les deux complices ne purent retenir une pouffée de rire, mais la jeune femme se reprit vite."
                            },
                            {
                                "example_id": "11149fbd-dfdf-4041-87b4-d2abde091971",
                                "sense_id": "742b58ae-e446-320b-b1e6-78e6bbb2a8f3",
                                "text": "Et des pouffées de rire mêlées au ronflement fantastique des réchauds lancés à pleine puissance, au grésillement des poêlées d’aluminium, tandis que, brochant sur le tout, saugrenus, inexplicables, résonnent des trémolos plaintifs d’un harmonica qu’un grand gaillard du Tyrol accoté dans un angle promène rêveusement sur ses lèvres."
                            }
                        ]
                    }
