                },
                {
                    "sense_id": "b03240f7-1d40-32db-b587-223f01372c8b",
                    "sense_definition": "A new version of something created again.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen needs a complete <w>remake</w> to look modern.",
                            "target_lang_translations": {
                                "ru": "Кухне нужна полная <w>переделка</w>, чтобы выглядеть современно.",
                                "zh": "厨房需要彻底<w>改造</w>才能看起来现代化。",
                                "es": "La cocina necesita una <w>remodelación</w> completa para verse moderna."
                            }
                        },
                        {
                            "text": "This dish is a <w>remake</w> of a traditional family recipe.",
                            "target_lang_translations": {
                                "ru": "Это блюдо — <w>новая версия</w> традиционного семейного рецепта.",
