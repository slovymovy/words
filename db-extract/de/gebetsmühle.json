                ],
                "senses": [
                    {
                        "sense_id": "dd6e7625-28fa-3236-a07b-9b064ef0172f",
                        "entry_id": "03feb57e-ca4f-3075-9a78-2852b2cb3012",
                        "glosses": [
                            "„Behälter, in dem sich auf Papierstreifen geschriebene Gebete befinden und der in Drehung versetzt werden kann“"
                        ],
                        "tags": [
                            "tibetischer Lamaismus"
                        ],
                        "examples": [
                            {
                                "example_id": "40fe3555-7826-47d5-94a1-bc89bdff2750",
                                "sense_id": "dd6e7625-28fa-3236-a07b-9b064ef0172f",
                                "text": "„Mitten im Nirgendwo sitzt ein Ladakhi an einer Schotterstraße und dreht seine Gebetsmühle.“"
                            },
                            {
                                "example_id": "96575227-1707-4cbe-8404-12afa8593778",
                                "sense_id": "dd6e7625-28fa-3236-a07b-9b064ef0172f",
                                "text": "„Viele riesige Gebetsmühlen hängen entlang der Wände und die Gläubigen gehen mit einem Schlegel entlang und setzen sie damit in Bewegung, wobei jeweils eine Drehung ein Gebet bedeutet.“"
                            },
                            {
                                "example_id": "3e5f145f-40f0-4ca7-88eb-c2de41502942",
                                "sense_id": "dd6e7625-28fa-3236-a07b-9b064ef0172f",
                                "text": "„Um mich heil ins Tageslicht zu geleiten, brauchte es jetzt Bannsprüche und Beschwörungsformeln, Gebetsmühlen, Rosenkränze und Litaneien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
