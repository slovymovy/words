                "senses": [
                    {
                        "sense_id": "8fd32af5-65da-3c87-a67f-95f96b7db9e7",
                        "entry_id": "c9b12373-0fe1-39d7-83c8-5ac7d86a4dcb",
                        "glosses": [
                            "D'une manière temporaire ; pour un temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98cb197d-27cc-43fa-a280-91eb4bab3742",
                                "sense_id": "8fd32af5-65da-3c87-a67f-95f96b7db9e7",
                                "text": "Nous signalerons aux basses eaux un curieux mélange de l’association à Rorippa et des associations d’Hydrophytes temporairement exondées […]"
                            },
                            {
                                "example_id": "735ddfa4-df93-420f-81fc-ccbc29908617",
                                "sense_id": "8fd32af5-65da-3c87-a67f-95f96b7db9e7",
                                "text": "Samir habite un algeco de chantier, pas toujours le même, habite l’algeco du chantier où temporairement il travaille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c82c7a7-eecd-4200-b2dc-82da1e4c8266",
                        "source_entry_id": "c9b12373-0fe1-39d7-83c8-5ac7d86a4dcb",
                        "source_sense_id": "8fd32af5-65da-3c87-a67f-95f96b7db9e7",
                        "target_lang_word": "temporarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "temporarily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c7acf14-49fc-342b-9a3f-f6e12ba92e64",
                                        "entry_id": "26b2b551-f272-3c78-a934-31da97cb0a60",
                                        "glosses": [
                                            "For a limited period of time; not permanently."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cb854ae-a67c-4fe0-b79e-1eb4f951df05",
                                                "sense_id": "6c7acf14-49fc-342b-9a3f-f6e12ba92e64",
                                                "text": "Necromancers were thought to have the power of restoring activity to the dead, either temporarily or permanently[.]"
                                            },
                                            {
                                                "example_id": "66f40e53-d220-4099-a5fa-3c7bd0d99b5e",
                                                "sense_id": "6c7acf14-49fc-342b-9a3f-f6e12ba92e64",
                                                "text": "The committee also decided that the remains of President Chiang will be entombed temporarily by Tzu Lake, at Tahsi township of Taoyuan County in northern Taiwan, and will be buried on the mainland after it is recovered."
                                            },
                                            {
                                                "example_id": "963d40df-bdec-4414-b8fa-d867e0f87966",
                                                "sense_id": "6c7acf14-49fc-342b-9a3f-f6e12ba92e64",
                                                "text": "The New York Post also temporarily took down and then revised and republished an article about the Fox reporter’s exchange with White House Press Secretary Jen Psaki on Monday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2c65266-1a91-4a8f-ad2b-e148c1a5563c",
                        "source_entry_id": "c9b12373-0fe1-39d7-83c8-5ac7d86a4dcb",
                        "source_sense_id": "8fd32af5-65da-3c87-a67f-95f96b7db9e7",
