                        "examples": [
                            {
                                "example_id": "8fccd9ec-790e-4c61-8b3d-f6a33148de59",
                                "sense_id": "d4014bf1-ec69-34db-ab22-8f84ef7ca842",
                                "text": "Als ik zelf in een conflictsituatie verzeild dreig te raken met iemand die belangrijk voor me is, dan benoem ik het probleem en probeer het uit te praten."
                            },
                            {
                                "example_id": "2469c4c5-f252-46ef-be81-0f43fb470af1",
                                "sense_id": "d4014bf1-ec69-34db-ab22-8f84ef7ca842",
                                "text": "In conflictsituaties neemt ons reptielenbrein het automatisch over – het oudste en kleinste deel van onze hersenen, vlak boven de hersenstam. Dit deel van de hersenen is puur op overleven gericht. Bij dreigend gevaar heeft het reptielenbrein drie basale reacties: vluchten, vechten of verstarren."
                            },
                            {
                                "example_id": "06b5c3c4-7b54-4f37-b31a-e173556949ae",
                                "sense_id": "d4014bf1-ec69-34db-ab22-8f84ef7ca842",
                                "text": "De organisatie was al actief voordat in dat land de burgeroorlog uitbrak en zorgt voor extra chaos in de huidige conflictsituatie."
                            },
                            {
                                "example_id": "533efa5c-8bca-4820-8c5c-4aa623718c29",
                                "sense_id": "d4014bf1-ec69-34db-ab22-8f84ef7ca842",
                                "text": "Het zal vast komen doordat ikzelf gemengde genen heb, maar het idee van een gemeenschap die bestaat uit mensen met een verschillende achtergrond, is voor mij niet synoniem met een conflictsituatie."
                            }
                        ]
                    }
