                                "example_id": "828dab11-ad04-4857-8277-c603c1825068",
                                "sense_id": "b1e22462-9388-34a9-8965-fcab9121679c",
                                "text": "Ze passeerden monniken die luidkeels de getijden baden en dermate dikke kapelaans dat zij hun opperkleed hadden laten vermaken tot een vest."
                            },
                            {
                                "example_id": "7105d7ee-6306-45bf-9328-4a21f4110ec1",
                                "sense_id": "b1e22462-9388-34a9-8965-fcab9121679c",
                                "text": "Over zijn witte opperkleed lag een spookachtige glans."
                            },
