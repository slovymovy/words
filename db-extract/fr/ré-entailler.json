                "senses": [
                    {
                        "sense_id": "d1fe707a-0ea6-3c27-8587-470f4663d0fd",
                        "entry_id": "6079d5a6-be84-37d4-a83a-ae3c88f8f8a9",
                        "glosses": [
                            "Variante de réentailler."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "64e01851-55fa-4f59-a31e-76536296baac",
                                "sense_id": "d1fe707a-0ea6-3c27-8587-470f4663d0fd",
                                "text": "La troncature du versant l’a suspendu à la cascade de la Tourille, d’où il rejoint le Moulin de Celles par la ligne de plus grande pente, sans être encore parvenu à ré-entailler le versant."
                            },
                            {
                                "example_id": "5cada273-3c16-4463-b85b-7e210523a4c6",
                                "sense_id": "d1fe707a-0ea6-3c27-8587-470f4663d0fd",
                                "text": "Ce relèvement, outre le recul du rivage, a déterminé la mise en place de plusieurs terrasses et le changement de cours de plusieurs rivières qui doivent ré-entailler leurs propres alluvions dans la partie fluviale ou deltaïque de leur trajet post-glaciaire (Welsted, 1960)."
                            }
                        ]
                    }
