                {
                    "sense_id": "19e6dfe7-94ba-3e45-b953-275bbfaf1567",
                    "sense_definition": "Een aanwijzing of bewijs dat iets bestaat, gaat gebeuren of aanwezig is.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vreemde geluid kan een <w>teken</w> zijn van een probleem met de motor.",
                            "target_lang_translations": {
                                "en": "The strange noise could be a <w>sign</w> of a problem with the engine.",
                                "ru": "Странный звук может быть <w>признаком</w> проблемы с двигателем.",
                                "pl": "Dziwny dźwięk może być <w>oznaką</w> problemów z silnikiem.",
                                "fr": "Ce bruit étrange peut être un <w>signe</w> de problème avec le moteur."
                            }
                        },
                        {
                            "text": "Er waren geen zichtbare <w>tekens</w> van schade aan de buitenkant van het gebouw.",
                            "target_lang_translations": {
                                "en": "There were no visible <w>signs</w> of damage on the outside of the building.",
                                "ru": "Снаружи здания не было видимых <w>признаков</w> повреждений.",
                                "pl": "Na zewnątrz budynku nie było widać żadnych <w>znaków</w> uszkodzeń.",
                                "fr": "Il n'y avait aucun <w>signe</w> visible de dommage à l'extérieur du bâtiment."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanwijzing",
                        "indicatie",
                        "symptoom"
                    ],
                    "common_phrases": [
                        "een goed teken",
                        "teken van leven",
                        "een teken van zwakte"
                    ],
                    "target_lang_definitions": {
                        "en": "An indication or proof that something exists, is going to happen, or is present.",
                        "ru": "Указание или доказательство того, что что-то существует, произойдет или присутствует.",
                        "pl": "Wskazówka lub dowód na to, że coś istnieje, wydarzy się lub jest obecne.",
                        "fr": "Indication ou preuve que quelque chose existe, va se produire ou est présent."
                    },
