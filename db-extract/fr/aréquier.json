                "senses": [
                    {
                        "sense_id": "5b424455-ccd8-3f97-a49b-8790c46fa38f",
                        "entry_id": "b50a393a-8fd7-3db0-8056-162734abb68e",
                        "glosses": [
                            "Nom usuel de Areca catechu, ou palmier à bétel, arbre de la famille des Arécacées (Arecaceae), originaire de Malaisie et répandu dans toute l’Asie du sud, donne un fruit nommé noix d’arec, qui sert à la préparation de la chique de bétel, ou paan, contenant des alcaloïdes psychoactifs comme l’arécaïne et l’arécoline"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb40be5b-e5d8-49ea-a3bb-3bddbe6b9d34",
                                "sense_id": "5b424455-ccd8-3f97-a49b-8790c46fa38f",
                                "text": "Un piano-buffet, précédé d’un tabouret tournant en peluche verte, coupait un des angles d’où jaillissait une sorte d’aréquier nain composé de fibres et de feuilles stérilisées."
                            },
                            {
                                "example_id": "751f15e3-5f6a-4fb8-a240-78455a132f9d",
                                "sense_id": "5b424455-ccd8-3f97-a49b-8790c46fa38f",
                                "text": "L’aréquier rapporte trois fois plus que le riz, et sa culture, dépourvue de contrainte saisonnière, est plus facile."
                            }
                        ]
                    }
                ],
