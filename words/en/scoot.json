                                "tr": "Masaya yaklaşmak için sandalyesini hızlıca <w>kaydırdı</w>."
                            }
                        },
                        {
                            "text": "With a sudden <w>scoot</w>, she moved out of the way of the door.",
                            "target_lang_translations": {
                                "cs": "Jedním rychlým <w>šoupnutím</w> uhnula ode dveří.",
                                "tr": "Ani bir <w>kayışla</w> kapının önünden çekildi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychlý klouzavý nebo šouravý pohyb.",
                        "tr": "Hızlı bir kayma, yana çekilme veya sürtünerek yer değiştirme hareketi."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šoupnutí",
