                    {
                        "sense_id": "23bae4ef-6e3f-3534-819f-c69a90f59d8f",
                        "entry_id": "e2b31937-8716-3494-94a4-98f0ebf158a4",
                        "glosses": [
                            "behorende tot, zich voordoend bij pubers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c46a0ef-65e9-46c0-bc34-176ab917768f",
                                "sense_id": "23bae4ef-6e3f-3534-819f-c69a90f59d8f",
                                "text": "Die puberale wijzigingen hangen me ontzettend de keel uit."
