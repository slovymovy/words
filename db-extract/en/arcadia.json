                    {
                        "sense_id": "2c5b17fa-0c7a-384c-8b94-b67332fae11e",
                        "entry_id": "9ae32002-16e2-3a61-acdc-37caa78c597c",
                        "glosses": [
                            "Alternative letter-case form of Arcadia."
