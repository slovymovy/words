                "senses": [
                    {
                        "sense_id": "f6a897b5-1c16-3d3c-921d-39fb23454421",
                        "entry_id": "a7f5e22b-52a3-316e-b4d0-7fba14052c88",
                        "glosses": [
                            "rang in de hofhouding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46d53488-c05f-4717-ae57-237e76ea1334",
                                "sense_id": "f6a897b5-1c16-3d3c-921d-39fb23454421",
                                "text": "Als grootofficier des Konings was hij eerst opperschenker 22 Januari 1855; later, 1872, opperjagermeester."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e9b9ed3-e819-3ee0-aadc-e47f3ccb74aa",
                        "entry_id": "a7f5e22b-52a3-316e-b4d0-7fba14052c88",
                        "glosses": [
                            "opperste waardigheidsbekleder bij de Vrijmetselaars"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cdb5d26-4053-4164-967a-be56071466fc",
                                "sense_id": "2e9b9ed3-e819-3ee0-aadc-e47f3ccb74aa",
                                "text": "In 1804, het jaar waarin Napoleon zichzelf tot keizer kroonde, werd zijn oudere broer Jozef Bonaparte aangesteld als grootmeester van hetzelfde grootoosten, terwijl prominente hoogwaardigheidsbekleders zoals de alom geduchte minister van Politie, Joseph Fouché, eveneens tot grootofficier werden benoemd."
                            }
                        ]
                    },
                    {
                        "sense_id": "59e375a3-c40a-352e-a0b7-45c29c8cb883",
                        "entry_id": "a7f5e22b-52a3-316e-b4d0-7fba14052c88",
                        "glosses": [
                            "hoge rang binnen een ridderorde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a2f44f5-81ac-437b-a088-5ccb89981728",
                                "sense_id": "59e375a3-c40a-352e-a0b7-45c29c8cb883",
                                "text": "Het Erelegioen (Légion d'honneur) werd in 1802 ingesteld door Napoleon Bonaparte. De rang van commandeur staat in de middenmoot, na die van grootkruisdrager en grootofficier."
                            },
                            {
                                "example_id": "accaef7c-2518-4369-ac16-2ce665029afe",
                                "sense_id": "59e375a3-c40a-352e-a0b7-45c29c8cb883",
                                "text": "Hij ontvangt de zilveren medaille van de gemeente Amsterdam en wordt benoemd tot grootofficier in de Huisorde van Oranje, incarnatie van zijn langjarige relaties met de Koninklijke Familie."
                            }
                        ]
                    }
                ],
