                "senses": [
                    {
                        "sense_id": "8226ea2f-c0c8-30a7-972c-ba240c5c57a6",
                        "entry_id": "2320983c-a90f-3775-be6e-0e34646a6c28",
                        "glosses": [
                            "weibliche Person, die ein Fahrzeug der Marke Porsche fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "248db028-bd31-4a44-86f5-b01b8c7df2e2",
                                "sense_id": "8226ea2f-c0c8-30a7-972c-ba240c5c57a6",
                                "text": "„Innerhalb von einer Dreiviertelstunde ist eine Porschefahrerin zweimal in eine Radarfalle der Dortmunder Polizei getappt – und zwar an der selben Stelle.“"
                            },
                            {
                                "example_id": "5b069301-937c-44b3-9b5f-069e275eded8",
                                "sense_id": "8226ea2f-c0c8-30a7-972c-ba240c5c57a6",
                                "text": "„Raucherin ist sie und Porschefahrerin mit Rennlizenz.“"
                            },
                            {
                                "example_id": "aaff2ae2-1eeb-48ed-a459-51c73d07dc5d",
                                "sense_id": "8226ea2f-c0c8-30a7-972c-ba240c5c57a6",
                                "text": "„Eine Porschefahrerin hat eine Politesse beim Ausparken angefahren und sie dabei leicht verletzt. Gegen sie wurde nun Anzeige erstattet.“"
                            },
                            {
                                "example_id": "822d8504-ba33-40fc-98f8-8eba38933147",
                                "sense_id": "8226ea2f-c0c8-30a7-972c-ba240c5c57a6",
                                "text": "„Leichte Verletzungen hat eine 41-jährige Porschefahrerin aus Lohmar bei einem Unfall am Samstagnachmittag in Hennef erlitten.“"
                            },
                            {
                                "example_id": "f55c441c-69d1-4a3f-970c-79a6387a3104",
                                "sense_id": "8226ea2f-c0c8-30a7-972c-ba240c5c57a6",
                                "text": "„Nach einem unverschuldeten Unfall muss sich eine Porschefahrerin nicht mit einem BMW oder Mercedes als Mietwagen begnügen, nur weil diese Oberklasse-Marken günstiger sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
