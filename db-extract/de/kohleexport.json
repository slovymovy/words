                            {
                                "example_id": "39dbdcba-8c97-4211-9a96-6226f2e4e7ae",
                                "sense_id": "6a3cd277-3cd3-3e63-b4e1-15dac30feb31",
                                "text": "„Schon im Februar ließ die Regierung elf der 13 Grenzübergänge nach China schließen, obwohl 80 Prozent der mongolischen Exporte in Form von Kohle, Kupfer und Seltenen Erden zum südlichen Nachbarn gehen – vor allem der Kohleexport gilt als Rückgrat der Wirtschaft in dem Steppenland.“"
                            },
                            {
                                "example_id": "3546c4c0-3f06-43a4-9c21-cc38ae1c32d9",
                                "sense_id": "6a3cd277-3cd3-3e63-b4e1-15dac30feb31",
                                "text": "„Australien will seinen Kohleexport steigern und bringt dafür die geschützten Korallenriffe in Gefahr.“"
                            }
                        ],
