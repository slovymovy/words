                ],
                "senses": [
                    {
                        "sense_id": "3b2ae6bf-59d2-3875-bf2b-a15b3d481ad5",
                        "entry_id": "dec52f92-0a36-381f-ba19-b49f03a5b393",
                        "glosses": [
