                                    {
                                        "sense_id": "25fc8d62-cec0-38c2-9910-932bc3b89b91",
                                        "entry_id": "3ab84a80-0798-31df-834d-64cb3678d405",
                                        "glosses": [
                                            "Habitant de l’ancien royaume du Siam, la Thaïlande moderne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26748efe-f2f1-4668-9c8c-63c622b6d639",
                                                "sense_id": "25fc8d62-cec0-38c2-9910-932bc3b89b91",
                                                "text": "L’Amour et l’Hymenée y réuniroient des amans de toutes les nations, des Tartares et des Mexicaines, des Siamois et des Laponnes, des Russes et des Algonkines, des Persans et des Moresques, des Kamtschadales et des Géorgiennes."
                                            },
                                            {
                                                "example_id": "9ea032a4-521d-4d84-a71f-775c00a8b7da",
                                                "sense_id": "25fc8d62-cec0-38c2-9910-932bc3b89b91",
                                                "text": "Jadis puissant, le royaume du Cambodge s’affaiblit à tel point qu’au XVIIIᵉ siècle, ses voisins, les Siamois et les Vietnamiens, entrepennent de le dépecer."
                                            }
                                        ]
                                    }
