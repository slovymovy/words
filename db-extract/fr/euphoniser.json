                "senses": [
                    {
                        "sense_id": "e1126d3c-fd86-3297-aafe-15967477dba9",
                        "entry_id": "411c2b7c-f974-37f2-a3c8-2ecb35ea893f",
                        "glosses": [
                            "Modifier dans un souci d’euphonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d977f307-173c-4b55-af55-feae29dd761a",
                                "sense_id": "e1126d3c-fd86-3297-aafe-15967477dba9",
                                "text": "Remarquez que le deuxième ut peut être changé en quemadmodum, pour ôter l'équivoque, varier et euphoniser."
                            },
                            {
                                "example_id": "ed0bb8e5-cb89-4f26-aaec-95254b5658ef",
                                "sense_id": "e1126d3c-fd86-3297-aafe-15967477dba9",
                                "text": "Euphoniser une chaine hi-fi consiste à gérer de manière agréable et harmonieuse la source musicale, le système audio, la pièce d'écoute et l'environnement tant au niveau acoustique qu'électromagnétique."
                            },
                            {
                                "example_id": "be4e01c5-c0e8-4332-8654-95aaebe7f5a1",
                                "sense_id": "e1126d3c-fd86-3297-aafe-15967477dba9",
                                "text": "D'autre part, A.A a été amené à \"euphoniser\" tout le matériel sur lequel il effectue ces opérations."
                            }
                        ]
                    }
