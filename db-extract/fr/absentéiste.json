                                "target_senses": [
                                    {
                                        "sense_id": "3b0fb510-8fe8-3db3-bcfa-14124e049bf1",
                                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                                        "glosses": [
                                            "A person who is absent from his or her employment, school, post, duty, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ddff82-19f7-4b90-86d3-a077932238ab",
                                                "sense_id": "3b0fb510-8fe8-3db3-bcfa-14124e049bf1",
                                                "text": "At roll-call there were three absentees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d69f53b-f861-334c-8b17-e6036df9004f",
                                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                                        "glosses": [
                                            "A person who is absent from his or her employment, school, post, duty, etc.",
                                            "Designating a person absent in a particular capacity, sometimes implying that they are difficult to contact, unresponsive, avoiding their responsibilities, etc."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebbfcb85-4eff-4c46-af6e-d6ecf4b93dd5",
                                                "sense_id": "3d69f53b-f861-334c-8b17-e6036df9004f",
                                                "text": "absentee father; absentee landlord; absentee freeholder"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5165f93-b21f-36e4-ba0a-06597a7af6c5",
                                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                                        "glosses": [
                                            "A person who is absent from his or her employment, school, post, duty, etc.",
                                            "A person who is absent from their residence and usual environment, and has not been seen or heard from for some period of time, so that it is unknown whether they are still alive, for the purpose of civil law dealing with the management of property etc. in such cases."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64d5e421-920f-3502-b986-b3c641a343e8",
                                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                                        "glosses": [
                                            "Something that is not present where it might be expected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1c06a25-54b5-43a4-b637-f69f2383775c",
                                                "sense_id": "64d5e421-920f-3502-b986-b3c641a343e8",
                                                "text": "The manufacturer's promised new model was a notable absentee at the car show."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b82a427-e587-31cc-901b-1de70b7aceff",
                                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                                        "glosses": [
                                            "Designating something whose owner, person responsible, etc. is absent."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5edeb435-9d6b-49de-b217-555957c67540",
                                                "sense_id": "7b82a427-e587-31cc-901b-1de70b7aceff",
                                                "text": "absentee ballot, absentee property"
                                            },
                                            {
                                                "example_id": "87839d46-f410-4d70-9c0c-35c2042721ad",
                                                "sense_id": "7b82a427-e587-31cc-901b-1de70b7aceff",
                                                "text": "In Wyoming, a GOP state senator forwarded an FGA draft bill to Secretary of State Chuck Gray that would prohibit sending out unsolicited absentee ballot request forms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06ecb6d1-3330-3466-b5b9-89c76faddb39",
                                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                                        "glosses": [
                                            "A landholder who lives in another district or country than the one in which his estate is situated."
                                        ],
                                        "tags": [
                                            "British",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b2df2f-82fd-4494-b313-62b412b70492",
                                                "sense_id": "06ecb6d1-3330-3466-b5b9-89c76faddb39",
                                                "text": "My trustees are going to lend Earl Blessington sixty thousand pounds (at six per cent.) on a Dublin mortgage. Only think of my becoming an Irish absentee!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "144adf51-02e0-3c90-87a5-55896fe5665b",
                                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                                        "glosses": [
                                            "A voter who is not present at the time of voting; absentee voter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d44d20f-3f03-4211-a343-f4cd25f81f0b",
                                                "sense_id": "144adf51-02e0-3c90-87a5-55896fe5665b",
                                                "text": "In recent primaries, for example, nearly 4% of absentees were rejected in Philadelphia; 8% in Kentucky; and 20% in parts of New York City."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
