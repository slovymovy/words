                        "examples": [
                            {
                                "example_id": "da003232-0678-4386-ab43-642f2c49c749",
                                "sense_id": "463a663a-f8e1-3aaf-90f8-4c67df29b140",
                                "text": "Dat werk werd echt met een slakkengang voltooid."
                            },
                            {
                                "example_id": "21636ab1-e137-478b-a3f3-c200384e158e",
                                "sense_id": "463a663a-f8e1-3aaf-90f8-4c67df29b140",
                                "text": "Uren en uren trok ik door het uitgestorven landschap toen ik plotseling een hele tijd moest wachten om een spoorlijn over te steken waar juist een lange goederentrein met een slakkengang langskwam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79d090c9-97e5-4025-a199-83dd5b2d8ae4",
                        "source_entry_id": "d2d8ea1d-d2d5-380b-b3b3-999a4b48866b",
                        "source_sense_id": "463a663a-f8e1-3aaf-90f8-4c67df29b140",
                        "source_sense_description": "met een ~: erg langzaam",
                        "target_lang_word": "snail's pace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snail's pace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b42c453f-c4d8-306e-ae2c-9cdb997ffbf0",
                                        "entry_id": "add3f410-15e3-3f6c-95f6-7f159f682a88",
                                        "glosses": [
                                            "A frustratingly slow rate of speed."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30820d83-df0f-403c-a2b0-d0ad47b3f25d",
                                                "sense_id": "b42c453f-c4d8-306e-ae2c-9cdb997ffbf0",
                                                "text": "My grandmother drives her car at a snail's pace."
                                            },
                                            {
                                                "example_id": "e417aec6-148f-46a5-acdc-9bcea802707a",
                                                "sense_id": "b42c453f-c4d8-306e-ae2c-9cdb997ffbf0",
                                                "text": "He describes the operation thus: \"The heavy ram employed to impart the finishing strokes, hoisted up with double purchase and snail's pace to the summit of the Piling Engine, and then falling down like a thunderbolt on the head of the devoted timber, driving it perhaps a single half inch in to the stratum below, is well calculated to put to the test the virtue of patience, while it illustrates the old adage of—slow and sure.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
