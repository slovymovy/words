                ],
                "senses": [
                    {
                        "sense_id": "268fe1e8-e9e6-3963-b03f-e079dd5afcd2",
                        "entry_id": "2408ec43-3bb7-3a43-b2cb-91178c43a511",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec02d0d2-4143-4410-9626-4634aeaf64df",
                                "sense_id": "268fe1e8-e9e6-3963-b03f-e079dd5afcd2",
                                "text": "Frau Helmle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "529f4d0d-6313-4f5a-9c47-07165f9f3cd4",
                                "sense_id": "268fe1e8-e9e6-3963-b03f-e079dd5afcd2",
                                "text": "Herr Helmle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "81a73339-136d-4b1e-b4ca-a186733d9247",
                                "sense_id": "268fe1e8-e9e6-3963-b03f-e079dd5afcd2",
                                "text": "Die Helmles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "ff304ce6-5263-4770-af61-e1b768bd3699",
                                "sense_id": "268fe1e8-e9e6-3963-b03f-e079dd5afcd2",
                                "text": "Der Helmle trägt nie die Pullover, die die Helmle ihm strickt."
                            },
                            {
                                "example_id": "56dc0a06-a728-4b4c-833d-8b8269ddd2f2",
                                "sense_id": "268fe1e8-e9e6-3963-b03f-e079dd5afcd2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Helmle kommt, geht der Herr Helmle.“"
                            },
                            {
                                "example_id": "d54784a3-a45f-4127-80b3-020f7a56b698",
                                "sense_id": "268fe1e8-e9e6-3963-b03f-e079dd5afcd2",
                                "text": "Helmle kommt und geht."
                            },
                            {
                                "example_id": "a8ea1826-d86c-4f07-8b0a-ba1ef6169559",
                                "sense_id": "268fe1e8-e9e6-3963-b03f-e079dd5afcd2",
                                "text": "Helmles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
