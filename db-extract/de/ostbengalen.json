                    {
                        "sense_id": "36fdcc17-896a-363e-b842-164da56124ad",
                        "entry_id": "7f6a4601-da4c-33f2-a0f3-bb1c88c6849c",
                        "glosses": [
                            "im Kern der östliche, mehrheitlich muslimische Teil Bengalens; ab 1955 Ostpakistan, seit 1971 Bangladesch"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1b13aba6-c383-40ad-9eb6-f96fab0b151a",
                                "sense_id": "36fdcc17-896a-363e-b842-164da56124ad",
                                "text": "„Im Punjab und in Ostbengalen brechen erbitterte Kämpfe zwischen Hindus, Moslems und Sikhs aus, denen 1947/48 etwa 10 Mio. Inder zum Opfer fallen.“"
                            },
                            {
                                "example_id": "42b2b97d-02fe-41bf-8a2d-457051f3d63a",
                                "sense_id": "36fdcc17-896a-363e-b842-164da56124ad",
                                "text": "„Zudem verbot er die in der NWFP an der Regierung beteiligte National Awami Party, weil diese die Awami-League in Ostbengalen unterstützt hatte und ihre Anhänger zudem in Belutschistan gegen Regierungstruppen kämpften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
