                        ],
                        "form": "das Implantat"
                    },
                    {
                        "form_id": "046a9575-20c8-44f6-ba01-8a5d56ac2f2a",
                        "entry_id": "9079eeac-f61c-319d-8f25-95bec95e5ab9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Implantate"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                        "entry_id": "9079eeac-f61c-319d-8f25-95bec95e5ab9",
                        "glosses": [
                            "in den Körper operativ eingepflanztes künstliches Gerät, das dort permanent oder zumindest für einen längeren Zeitraum verbleibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63c3e2fe-0281-4a0b-9eca-849d94cb9457",
                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                "text": "Die Chirurgen setzen dem Patienten in einer dreistündigen Operation ein Implantat in den Knochen."
                            },
                            {
                                "example_id": "6b3af04a-ff14-4af9-bbbc-8f98962d19b5",
                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                "text": "Statt Sport zu treiben, ließ sich Klaus Implantate in die Waden einsetzen."
                            },
                            {
                                "example_id": "8d0cad82-25e7-425f-8b0b-c328e04ac4c0",
                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                "text": "„Aus der Altersschwerhörigkeit führt kein Weg heraus, da können nur noch Hörgeräte oder Implantate helfen.“"
                            },
                            {
                                "example_id": "63c1f1d5-3d28-4d4c-999b-b280de0ec835",
                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                "text": "„Die Patientinnen sollen am besten mit ihrem Arzt sprechen und per Ultraschall oder Kernspintomografie erfassen lassen, ob ihr Implantat möglicherweise beschädigt ist.“"
                            },
                            {
                                "example_id": "f0eb3977-13c8-451b-abd5-a6c2328af0b8",
                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                "text": "„Den mümmelnden Greis gibt es nicht mehr. Er trägt Implantate.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "44435e4b-8bba-35a5-bed1-3b48f8db7993",
                        "entry_id": "9079eeac-f61c-319d-8f25-95bec95e5ab9",
                        "glosses": [
                            "Platzierung von Zähnen in nicht besetzte Zahnkammern (Alveolen)"
                        ],
                        "tags": [
                            "Zahnmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "cf400c65-94d3-4514-a499-fd920b98e797",
                                "sense_id": "44435e4b-8bba-35a5-bed1-3b48f8db7993",
                                "text": "„Die gute Nachricht: Wer Wert auf ein Implantat legt, um Zahnverlust zu verbergen und so auch Kau- und Sprechproblemen vorzubeugen, kann einem bereits begonnenen Abbau der Alveolen entgegenwirken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76950635-816b-410f-a109-3af27b5bc17b",
                        "source_entry_id": "9079eeac-f61c-319d-8f25-95bec95e5ab9",
                        "source_sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
