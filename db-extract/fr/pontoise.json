                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67c86ec1-acaa-4fec-af83-943a5af897b1",
                                "sense_id": "8cb99096-da54-3ac4-976f-428502f676f7",
                                "text": "Une sépulture mégalithique a aussi été explorée au lieu dit le cimetière des Anglais, commune de Vauréal, près Pontoise, Seine-et-Oise, par M. A. de Caix de Saint-Aymour."
                            },
                            {
                                "example_id": "270922be-d957-427b-97ef-d5f0f4b62317",
                                "sense_id": "8cb99096-da54-3ac4-976f-428502f676f7",
                                "text": "À Pontoise, la voiture de la maire, Stéphanie Von Euw (Libres!), a été visée par une fusée d’artifice."
                            }
                        ]
                    },
