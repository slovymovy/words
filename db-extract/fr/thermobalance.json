                "senses": [
                    {
                        "sense_id": "2b6ce102-b6e9-395b-beae-41e35933e7d8",
                        "entry_id": "2e1f779d-a8be-35fd-8d4e-8636c8c5d96e",
                        "glosses": [
                            "Balance permettant de contrôler la température de l’échantillon et ainsi de réaliser des expériences de thermogravimétrie."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "40c69d10-7226-4a8b-ab29-50907e720f12",
                                "sense_id": "2b6ce102-b6e9-395b-beae-41e35933e7d8",
                                "text": "L’analyse thermogravimétrique est une technique d’analyse thermique basée sur la mesure de variation de masse d’un échantillon de matériau pendant que celui-ci est soumis à une température donnée ou à un programme de variation de température. L’instrument qui permet ces mesures est appelé une thermobalance ou un analyseur thermogravimétrique."
                            }
                        ]
                    }
                ],
