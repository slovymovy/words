                                                "sense_id": "4c83085a-791c-3867-ae50-795c62d90087",
                                                "text": "La réponse doit être conforme à la demande."
                                            },
                                            {
                                                "example_id": "027809d8-a067-40d0-ab48-381529aa7ce7",
                                                "sense_id": "4c83085a-791c-3867-ae50-795c62d90087",
                                                "text": "Votre demande est indiscrète."
                                            },
                                            {
                                                "example_id": "7c716a2d-5598-4d84-a05c-00f87037dd36",
                                                "sense_id": "4c83085a-791c-3867-ae50-795c62d90087",
                                                "text": "Catéchisme par demandes et par réponses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "900c441c-7408-3f10-9ac9-d18e22be4b7f",
                                        "entry_id": "8ef28b7f-f862-3ecb-8338-86b9694e7e5c",
