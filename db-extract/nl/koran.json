                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koran",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7519ae68-0a35-3088-ba08-cf1ec86faaa7",
                                        "entry_id": "6b80755c-e26d-3b61-9ddf-694c8ca20624",
                                        "glosses": [
                                            "das heilige Buch des Islam"
                                        ],
                                        "tags": [
                                            "Islam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3952e62-5ca0-4d71-abda-c6867dfb08f6",
                                                "sense_id": "7519ae68-0a35-3088-ba08-cf1ec86faaa7",
                                                "text": "„Der Koran ist ein sprechendes Universum und das Universum ein schweigender Koran.“ - muslimisches Sprichwort"
                                            },
                                            {
                                                "example_id": "96a5e966-d9d9-4231-9566-3b81b210ed4d",
                                                "sense_id": "7519ae68-0a35-3088-ba08-cf1ec86faaa7",
                                                "text": "„Die Eroberer verkünden eine neue Religion, den Islam, und verbreiten mit dem Koran eine neue Gesellschaftsordnung.“"
                                            },
                                            {
                                                "example_id": "7c08e801-48d6-4e49-a5fe-98464ba25bca",
                                                "sense_id": "7519ae68-0a35-3088-ba08-cf1ec86faaa7",
                                                "text": "„Im Islam gilt der Koran als sprachliches Wunder, es ist schließlich die Botschaft von Allah höchstpersönlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be392ffe-0291-4621-9beb-91318f8acb10",
                        "source_entry_id": "db345052-4c1f-3657-a0cc-78bdfeef35c1",
                        "source_sense_id": "0a155e26-736e-3c19-bb19-d2ae96665817",
                        "source_sense_description": "(de tekst van) het heilig boek van de islam",
                        "target_lang_word": "Qur'an",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Qur'an",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7cebc18b-f6fe-3f0a-b7cb-7e0160f9bd96",
                                        "entry_id": "7658451a-2146-348c-88d0-1b479d93dbb2",
                                        "glosses": [
                                            "The Islamic holy book, considered by Muslims to be the word of God as revealed to Muhammad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71231ab7-a40f-4f94-bb76-c4db48669ad6",
                                                "sense_id": "7cebc18b-f6fe-3f0a-b7cb-7e0160f9bd96",
                                                "text": "In the summer of 2002, responding to the 9/11 atrocity, the University of North Carolina at Chapel Hill made a selection of verses from the Qur'an a mandatory text for new students."
                                            },
                                            {
                                                "example_id": "5b8a0ba4-30e8-4f67-9714-1cf93e9f1ea7",
                                                "sense_id": "7cebc18b-f6fe-3f0a-b7cb-7e0160f9bd96",
                                                "text": "Classical Arabic – the language of the Qur’an – will make you understood everywhere, but colloquial Arabic may be more useful, because once the locals start conversing with each other, you’ll lose the plot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Qur'an",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c03978d9-a8b7-39a4-b1fa-ef03ba5e6efa",
                                        "entry_id": "e5f01f0a-22e9-33cd-ae2b-e17c9358bacb",
                                        "glosses": [
                                            "A specific version, edition, translation, or copy of one of the above-mentioned book."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51827f96-ee1c-427d-8275-411268d9106c",
                        "source_entry_id": "db345052-4c1f-3657-a0cc-78bdfeef35c1",
                        "source_sense_id": "0a155e26-736e-3c19-bb19-d2ae96665817",
                        "source_sense_description": "(de tekst van) het heilig boek van de islam",
                        "target_lang_word": "Coran",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Coran",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a311488b-0b85-3c56-9f9f-1161f72d1fc9",
                                        "entry_id": "636dfbaf-0f71-39a5-a260-4b3f6691a7e7",
                                        "glosses": [
                                            "Livre sacré de l’Islam regroupant les paroles divines qui, selon les musulmans, ont été communiquées au Prophète Mohammed par l’archange Gabriel durant vingt-trois années."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb86c6f4-5e9a-4eac-848d-3baf2794c654",
                                                "sense_id": "a311488b-0b85-3c56-9f9f-1161f72d1fc9",
                                                "text": "Elle savait — sans toutefois se rendre compte de ce que cela signifiait — qu’il y a un Dieu, seul, unique, éternel, qui a tout créé et qui est Rab-el-Alémine — Souverain des Univers —, que Mohammed est son Prophète et que le Coran est l’expression écrite de la religion."
                                            },
                                            {
                                                "example_id": "c43bcef8-10c3-457a-9f34-ba8cb22369e6",
                                                "sense_id": "a311488b-0b85-3c56-9f9f-1161f72d1fc9",
                                                "text": "En examinant les notions politiques essentielles de l’Écriture islamique, le Coran, […], mon collègue Michael Cook suggère qu'il est possible de se faire une idée générale de leur signification."
                                            },
                                            {
                                                "example_id": "cd5ee0b0-7f33-486d-ae72-08d586f795ac",
                                                "sense_id": "a311488b-0b85-3c56-9f9f-1161f72d1fc9",
                                                "text": "En effet, en écoutant le Coran, fût-ce d’une oreille distraite, on est immédiatement frappé par la fréquence avec laquelle il mentionne - et souvent en des termes identiques - notamment l’Eau, le Feu et la Terre."
                                            },
                                            {
                                                "example_id": "e9659d2f-efde-42a6-a141-3eb84d44c51b",
                                                "sense_id": "a311488b-0b85-3c56-9f9f-1161f72d1fc9",
                                                "text": "Honni par le Talmud et le Coran, diabolisé par les chrétiens comme symbole de luxure et de gourmandise, le cochon est tout aussi triquard dans la société laïque, obligatoire, gonadoclaste et de surcroît xyloglotte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23327ea7-983e-306b-8bd9-dd298ba2b17d",
                                        "entry_id": "636dfbaf-0f71-39a5-a260-4b3f6691a7e7",
                                        "glosses": [
                                            "Recueil de dogmes et de doctrines."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb7e29bd-ba45-4d90-9dec-39e2eeaeb439",
                                                "sense_id": "23327ea7-983e-306b-8bd9-dd298ba2b17d",
                                                "text": "C’est ici qu’intervient le « Sturm-Lokal », la brasserie qui sert d’annexe à chaque « Sturm-Kaserne ». On s’y réunit le soir pour commenter le Coran brun en buvant des chopes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Coran",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7771ac36-0006-3878-8bd4-ebf20e2811e5",
                                        "entry_id": "df1bda49-4a10-340e-8cc5-d78fd7553aa1",
                                        "glosses": [
                                            "Rivière française de Charente-Maritime, affluent droit de la Charente."
                                        ],
                                        "tags": [
                                            "Toponymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dc2e31e-35aa-4761-a08f-b9562eabb499",
                                                "sense_id": "7771ac36-0006-3878-8bd4-ebf20e2811e5",
                                                "text": "À Saint-Césaire, entre Saintes et Cognac, Les Ânes de la rêverie proposent des randonnées à pied avec un âne, au cœur de la vallée du Coran, du nom du cours d’eau qui la parcourt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
