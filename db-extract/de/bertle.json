                "senses": [
                    {
                        "sense_id": "5e5406f8-1055-320d-8ba4-0cf22cd3e85f",
                        "entry_id": "d5c9805f-31ca-331e-ad93-320536c26d38",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8dd55af-bb49-46a7-a59c-0671210ec87c",
                                "sense_id": "5e5406f8-1055-320d-8ba4-0cf22cd3e85f",
                                "text": "Frau Bertle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b6fcb125-9382-433a-a8e3-81ec0b6bc37a",
                                "sense_id": "5e5406f8-1055-320d-8ba4-0cf22cd3e85f",
                                "text": "Herr Bertle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "495587e1-c73a-4397-aed5-450b3517d12a",
                                "sense_id": "5e5406f8-1055-320d-8ba4-0cf22cd3e85f",
                                "text": "Die Bertles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "cab05a85-e45e-423b-8bd8-07e09e8c3b27",
                                "sense_id": "5e5406f8-1055-320d-8ba4-0cf22cd3e85f",
                                "text": "Der Bertle trägt nie die Schals, die die Bertle ihm strickt."
                            },
                            {
                                "example_id": "bf0f28c4-9a2f-4716-a935-eec031dc6879",
                                "sense_id": "5e5406f8-1055-320d-8ba4-0cf22cd3e85f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bertle kommt, geht der Herr Bertle.“"
                            },
                            {
                                "example_id": "53b13bfe-b590-438f-9f51-26a9c1c53a6e",
                                "sense_id": "5e5406f8-1055-320d-8ba4-0cf22cd3e85f",
                                "text": "Bertle kommt und geht."
                            },
                            {
                                "example_id": "1d133d80-8dfc-40f8-892c-bb4263a14da0",
                                "sense_id": "5e5406f8-1055-320d-8ba4-0cf22cd3e85f",
                                "text": "Bertles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
