                                        "entry_id": "0a0389cf-688d-3f19-a152-8a1cc51d77b0",
                                        "glosses": [
                                            "To push someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d1121a9-d451-40a7-90d5-270cb7166ff0",
                                                "sense_id": "80586d2f-cca4-3ebd-96c9-7f6a93d9d194",
                                                "text": "The home side were professionally going about their business and were denied a spot-kick when Dunne clumsily barged Nani off the ball."
                                            }
                                        ]
                                    }
                                ]
                            }
