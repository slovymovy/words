                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be9c143e-6f5a-3541-b93c-6040653dd8fb",
                                        "entry_id": "234f68da-c810-385a-950f-4acbf4977285",
                                        "glosses": [
                                            "A cryptic crossword puzzle."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d99eaad0-b0b9-49a2-9edd-95029909cdda",
                                                "sense_id": "be9c143e-6f5a-3541-b93c-6040653dd8fb",
                                                "text": "He settled down to the cryptic in the Independent. He loved his crossword. It kept him mentally active, just as gossip did his wife."
                                            },
                                            {
                                                "example_id": "4a9c91df-827e-467c-b475-228ea77a2406",
                                                "sense_id": "be9c143e-6f5a-3541-b93c-6040653dd8fb",
                                                "text": "This writer has been solving cryptics for 40 years and can usually crack Araucaria, though it might take a couple of days."
                                            }
