                        ]
                    },
                    {
                        "translation_id": "aee8b154-7759-49f9-be9b-8ca103351c30",
                        "source_entry_id": "831baf25-58e1-3052-8950-86d2fff38660",
                        "source_sense_id": "fe863ccd-9c54-3841-92fd-498a50ab6ec1",
                        "source_sense_description": "derb: Gesicht",
                        "target_lang_word": "visage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2ec8741-9a50-3d98-8728-531b717a4dbd",
                                        "entry_id": "473a9904-7d75-342e-a922-e38ef9750c55",
                                        "glosses": [
                                            "Face humaine ; partie antérieure de la tête, qui comprend le front, les yeux, le nez, les joues, la bouche, le menton et les oreilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12cf4db5-b04a-4fed-91b2-0606a359544a",
                                                "sense_id": "d2ec8741-9a50-3d98-8728-531b717a4dbd",
                                                "text": "Il serait délicat d’insister sur l’apparence regrettable qu’ont prise certains visages féminin qui ont été trop longtemps exposés aux attaques des fards ; ceux-ci ont pu à un certain moment donner un éclat particulier au visage, mais ils l’ont souvent irrémédiablement flétri."
                                            },
                                            {
                                                "example_id": "81ec0ce8-bb10-4327-b949-73a5c29df892",
                                                "sense_id": "d2ec8741-9a50-3d98-8728-531b717a4dbd",
                                                "text": "J’aperçois, dans le décor que la pénombre commence à envahir, le modelé de mon front, l’ovale de mon visage et, sous ma paupière clignante, mon regard par lequel j’entre en moi comme dans un tombeau."
                                            },
                                            {
                                                "example_id": "48bf44c2-fa08-4d13-8909-02f052390166",
                                                "sense_id": "d2ec8741-9a50-3d98-8728-531b717a4dbd",
                                                "text": "Marcelle voyait devant soi ce visage incompréhensible comme une phrase dont on aurait mélangé tous les mots dans un chapeau."
                                            },
                                            {
                                                "example_id": "56fb9a91-829d-4886-925b-6a509d4f3401",
                                                "sense_id": "d2ec8741-9a50-3d98-8728-531b717a4dbd",
                                                "text": "Le grand air de l’Océan mordait notre visage avec une violence telle que nous avons dû, à plusieurs reprises, étaler sur les joues et le nez de la vaseline, dont nous nous étions munis."
                                            },
                                            {
                                                "example_id": "d4f09c24-572b-4a27-b7f3-eb41c36798fa",
                                                "sense_id": "d2ec8741-9a50-3d98-8728-531b717a4dbd",
                                                "text": "Une expression matoise parcourut le visage de l’homme aux lunettes noires sans qu’il me fût possible d’en deviner la cause."
                                            },
                                            {
                                                "example_id": "7e74b5d8-0582-40e2-9073-b1089ea2f023",
                                                "sense_id": "d2ec8741-9a50-3d98-8728-531b717a4dbd",
                                                "text": "Coupé par un immense béret, son petit visage bien rasé, triangulaire et anguleux comme celui d’un fennec, souriait."
                                            },
                                            {
                                                "example_id": "35ddc5e9-0f43-4ab7-b143-78eb941a88f3",
                                                "sense_id": "d2ec8741-9a50-3d98-8728-531b717a4dbd",
                                                "text": "Plusieurs dizaines de greffes du visage et des mains ont déjà été réalisées séparément, mais les deux précédents connus de transplantation simultanée se sont soldés par des échecs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "295b134b-ace8-3784-8dee-1879795ebdf9",
                                        "entry_id": "473a9904-7d75-342e-a922-e38ef9750c55",
                                        "glosses": [
                                            "Son air ; son expression."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87fa3214-eb73-40a4-ba27-9f2f67bcb2ba",
                                                "sense_id": "295b134b-ace8-3784-8dee-1879795ebdf9",
                                                "text": "Il me semble n’y avoir vu encore que des visages effarouchés ou rébarbatifs. Peut-être aussi les Parisiens ont-ils peur de l’orage."
                                            },
                                            {
                                                "example_id": "7a5b6aca-f19d-470e-9364-5b8335fc0c5e",
                                                "sense_id": "295b134b-ace8-3784-8dee-1879795ebdf9",
                                                "text": "Son visage portait les marques de la plus profonde perplexité et, visiblement, il se demandait si Tacherot ne se moquait pas un peu de lui."
                                            },
                                            {
                                                "example_id": "c00023c2-9e9d-4730-89a8-e7843fa4d115",
                                                "sense_id": "295b134b-ace8-3784-8dee-1879795ebdf9",
                                                "text": "Par un mystérieux tour de force, il avait réussi à se raser et à lisser ses cheveux dorés. Son visage était tout à fait séraphique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c43a999-c14f-335b-8788-15a1fe92a54b",
                                        "entry_id": "473a9904-7d75-342e-a922-e38ef9750c55",
                                        "glosses": [
                                            "Aspect d’une chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ceda37f-32d7-44a3-be95-a36512bd7e75",
                                                "sense_id": "6c43a999-c14f-335b-8788-15a1fe92a54b",
                                                "text": "Je percevais au tremblement de leur voix, au miel de leurs paroles, cette terrible servitude qui les liait à ce qu’on nomme l’amour, d’un mot trop doux parce qu’on ne veut pas lui donner son véritable visage de bestialité et d’animalité."
                                            },
                                            {
                                                "example_id": "7618aa35-e1ea-4adb-94f8-0424fe999237",
                                                "sense_id": "6c43a999-c14f-335b-8788-15a1fe92a54b",
                                                "text": "La guerre prend un double visage : elle est en même temps une guerre de position et une guerre de mouvement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc82f6f6-ed16-3c6a-9d8e-572a769c9972",
                                        "entry_id": "473a9904-7d75-342e-a922-e38ef9750c55",
                                        "glosses": [
                                            "La personne même, en tant qu’on la connaît par le visage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "436da9e8-ca0a-4c48-b9e4-94f27591b622",
                                                "sense_id": "fc82f6f6-ed16-3c6a-9d8e-572a769c9972",
                                                "text": "Henri, d’une investigation prompte, examinait les tablées. Pas un visage connu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a4b95e5-814b-3bcd-bf2a-e4c69f9e41df",
                                        "entry_id": "473a9904-7d75-342e-a922-e38ef9750c55",
                                        "glosses": [
                                            "Ensemble des traits moraux caractéristiques d’une personne, d’une nation, etc."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb80953b-17d7-4575-95f8-a6b3c785dd0b",
                                                "sense_id": "6a4b95e5-814b-3bcd-bf2a-e4c69f9e41df",
                                                "text": "Cet historien n’a pas représenté tel pays sous son vrai visage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
