                    },
                    {
                        "translation_id": "c7d17576-7831-4f2c-a78c-3ec66faab95e",
                        "source_entry_id": "9cea5cc3-76fc-3e2c-9d2c-8c48e029a5bd",
                        "source_sense_id": "eb7c9464-2945-3fb1-986c-5f33366d10c3",
                        "source_sense_description": "de tweede maand van het jaar",
                        "target_lang_word": "Februar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Februar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3009acbe-8c1e-35d6-9d3c-7a7630f005ff",
                                        "entry_id": "20f1f5f0-cc3d-33cf-b032-dce6a4657c37",
                                        "glosses": [
                                            "zweiter, 28-tägiger (in Schaltjahren 29-tägiger) und somit kürzester Monat im Kalenderjahr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "132adfb9-396c-447e-a10c-160ecba43e36",
                                                "sense_id": "3009acbe-8c1e-35d6-9d3c-7a7630f005ff",
                                                "text": "Der Februar folgt auf den Januar."
                                            },
                                            {
                                                "example_id": "316ea0a0-ab97-4bf7-87ad-f6ed687b0751",
                                                "sense_id": "3009acbe-8c1e-35d6-9d3c-7a7630f005ff",
                                                "text": "„Es ist ein später, milder Februar.“"
                                            },
                                            {
                                                "example_id": "23df9e77-0ea8-4ce2-889b-8f44ca3ffd17",
                                                "sense_id": "3009acbe-8c1e-35d6-9d3c-7a7630f005ff",
                                                "text": "„Als ich als einziger eine sinnlose Magenresektion überstand, ließ er mich gesundpflegen und schickte mich in den ersten Tagen des Februars nach Buchenwald zurück, das ich jedoch nach endlosen Transporten nie erreichen sollte; denn da kam in der Nähe der Stadt Eisleben jener schöne Maientag mit dem blühenden Flieder, unter den ich mich verkroch.“"
                                            },
                                            {
                                                "example_id": "d3deafd5-3867-41f2-aa16-3f271efc01be",
                                                "sense_id": "3009acbe-8c1e-35d6-9d3c-7a7630f005ff",
                                                "text": "„Mitte Februar schickte er ihr eine Ansichtenkarte.“"
                                            },
                                            {
                                                "example_id": "3136bb3d-d091-41a1-b89b-d81d13efc826",
                                                "sense_id": "3009acbe-8c1e-35d6-9d3c-7a7630f005ff",
                                                "text": "„Der Geburtstagsmonat meiner Mutter, der Februar, ist keine geeignete Zeit fürs Radfahrenlernen.“"
                                            },
                                            {
                                                "example_id": "8b5bae35-cbb7-44c1-8dcc-fb0339e17265",
                                                "sense_id": "3009acbe-8c1e-35d6-9d3c-7a7630f005ff",
                                                "text": "„So ging ich Ende Februar in die Bahnhofstraße.“"
                                            },
                                            {
                                                "example_id": "61c0e1dd-482d-4008-a9fa-b5646e21fb2c",
                                                "sense_id": "3009acbe-8c1e-35d6-9d3c-7a7630f005ff",
                                                "text": "„Aber wenn er ehrlich gewesen wäre, hätte er zugeben müssen, daß es keine große Bedeutung hatte, daß sie ihre Sommersachen noch im Schrank hängen hatte – es war Februar.“"
                                            },
                                            {
                                                "example_id": "0d3597ea-5e79-4320-aa85-04313366b424",
                                                "sense_id": "3009acbe-8c1e-35d6-9d3c-7a7630f005ff",
                                                "text": "„Denn da vorn im Eis ist ein Loch, kein kreisrundes, wie der Röckenwagner es sich jedes Jahr hackt, um, oft erst im Februar, nach Silvesterkarpfen oder Barschen zu fischen.“"
                                            },
                                            {
                                                "example_id": "5a07b3c3-27d5-4ed7-a64a-742e1a2456a5",
                                                "sense_id": "3009acbe-8c1e-35d6-9d3c-7a7630f005ff",
                                                "text": "„Pistorius erschoss Reeva Steenkamp am 14. Februar 2013[.] […] Nach dem 7. Februar hätten sich die [sic!] Pistorius und Steenkamp nur liebevolle Nachrichten geschrieben, so der Anwalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fb254df-1d58-486f-af09-3bd953f57e67",
                        "source_entry_id": "9cea5cc3-76fc-3e2c-9d2c-8c48e029a5bd",
                        "source_sense_id": "eb7c9464-2945-3fb1-986c-5f33366d10c3",
                        "source_sense_description": "de tweede maand van het jaar",
                        "target_lang_word": "February",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "February",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0be9738b-1e08-3504-851e-96cbf6b33c97",
                                        "entry_id": "a84dad8d-f726-3576-b4d7-12fce7eb3ea2",
                                        "glosses": [
                                            "The short month following January and preceding March in the Roman, Julian, and Gregorian calendars, used in all three calendars for intercalation or addition of leap days."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146f46e4-b839-4677-b21b-71852a4bda1c",
                                                "sense_id": "0be9738b-1e08-3504-851e-96cbf6b33c97",
                                                "text": "Holonyms: calendar year; year"
                                            },
                                            {
                                                "example_id": "94213284-25a2-4db8-825d-9f81fcb609d5",
                                                "sense_id": "0be9738b-1e08-3504-851e-96cbf6b33c97",
                                                "text": "Susan was born on February 29."
                                            },
                                            {
                                                "example_id": "7c9b2fed-ef85-47c2-b2f8-262a12b71c9b",
                                                "sense_id": "0be9738b-1e08-3504-851e-96cbf6b33c97",
                                                "text": "...The second he [sc. :Template:w:Numa Pompilius] dedicated to the god Februus, who is believed to control rites of purification: the community had to be purified in that month, when he determined that the Good Gods be paid the offerings due them... Numa soon added one day to January, paying honor to the mystery of the odd number that nature revealed even before Pythagoras: as a result, both the year as a whole and the individual months (save February) had an odd number of days. (If all twelve months had either an odd or even number of days, their total would be an even number...)"
                                            },
                                            {
                                                "example_id": "5913a429-3c76-4651-b5af-46ee144c4b93",
                                                "sense_id": "0be9738b-1e08-3504-851e-96cbf6b33c97",
                                                "text": "February was set aside for the intercalation because it was the last month of the year... They departed from the Greeks in one respect, however: whereas the latter intercalated when the final month was over, the Romans intercalated after the twenty-third day of February, at the conclusion of the Terminalia. They then added on the last five days of February after the intercalary period, acting on the religious scruple of ancient custom, I think, so that March would follow on February no matter what."
                                            },
                                            {
                                                "example_id": "1a96182a-f425-4a4b-8e06-d2f2606c5db8",
                                                "sense_id": "0be9738b-1e08-3504-851e-96cbf6b33c97",
                                                "text": "Julius Caesar, then, added ten days to the old practice, so that the 365 days in which the sun circles the zodiac would make a year; and to account for the one-quarter day, he ordained that the priests who attended to the months and days would insert one day every fourth year, in the same month and place where the ancients used to intercalate a month, that is, before the last five days of February, and he decreed that it be called the 'twice sixth'... he added no days to February, so that the religious observances offered to the gods of the dead would not be changed..."
                                            },
                                            {
                                                "example_id": "6a54a648-1397-487d-9c32-03412f13d80c",
                                                "sense_id": "0be9738b-1e08-3504-851e-96cbf6b33c97",
                                                "text": "“Eating meat means prosperity in the coming year,” the roastery wrote on Weibo on February 5, days before the Lunar New Year began."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0c3d2cd-7180-3619-a468-b62c87e8d51f",
                                        "entry_id": "a84dad8d-f726-3576-b4d7-12fce7eb3ea2",
                                        "glosses": [
                                            "A female given name transferred from the month name [in turn from English]."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84d90665-c4d7-4a7f-ad4b-521acb6673e7",
                                                "sense_id": "f0c3d2cd-7180-3619-a468-b62c87e8d51f",
                                                "text": "“Cheryl, the man in this photo is a Mr. Dennis Lowe. He worked for a computer software company and he was married. He was impersonating a police officer, a real one by the name of Alexander Colton. He was doing this because he's obsessed with a woman named February—” Nowakowski stopped talking because Cheryl Sheckle's body jerked violently and she let out a muted cry. […] “It isn't a nickname, Cheryl. It's a real person, her name is February Owens and he's been obsessed with her since they went to high school together.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b78ea0e-97d2-41d3-a874-18de3b698f4c",
                        "source_entry_id": "9cea5cc3-76fc-3e2c-9d2c-8c48e029a5bd",
                        "source_sense_id": "eb7c9464-2945-3fb1-986c-5f33366d10c3",
