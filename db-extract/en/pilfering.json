                        "target_lang_word": "Diebstahl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diebstahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "853722d5-4281-3a11-b39f-b5fe4be6559e",
                                        "entry_id": "dac034cd-f8ce-3b18-9fcf-db67ca822d32",
                                        "glosses": [
                                            "heimliche Entwendung fremden Eigentums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20a98857-0cf9-4b5b-8be7-85438c09ba4a",
                                                "sense_id": "853722d5-4281-3a11-b39f-b5fe4be6559e",
                                                "text": "Mein Laptop ist gegen Diebstahl versichert."
                                            },
                                            {
                                                "example_id": "88dcfbe3-e034-4051-acb2-8f759add36ae",
                                                "sense_id": "853722d5-4281-3a11-b39f-b5fe4be6559e",
                                                "text": "„Der Reihe nach bekannten sie sich zu Diebstählen oder tätlichen Angriffen mit und ohne Waffengewalt.“"
                                            },
                                            {
                                                "example_id": "c80f8e75-70fc-4bd4-bfab-f106ef0ac10f",
                                                "sense_id": "853722d5-4281-3a11-b39f-b5fe4be6559e",
                                                "text": "„Die Dubois wurde wegen Diebstahls verhaftet und ins Gefängnis von Nantes gebracht, und zwar in die Abteilung für gewöhnliche Kriminelle, die von den politischen Gefangenen strikt getrennt war.“"
                                            },
                                            {
                                                "example_id": "b6ee5516-7118-421d-81bc-4d03ec52ec73",
                                                "sense_id": "853722d5-4281-3a11-b39f-b5fe4be6559e",
                                                "text": "„Auch Diebstahl aus Hunger verstößt gegen das 7. Gebot, hatte er gelernt.“"
                                            },
                                            {
                                                "example_id": "e5c2fd49-8092-4fb6-9dfe-024e9c43e6ab",
                                                "sense_id": "853722d5-4281-3a11-b39f-b5fe4be6559e",
                                                "text": "„Das hätte mich meine Ehre gekostet, wenn es nicht meinem Scharfsinn gelungen wäre, ihn eines Diebstahls zu überführen, für den man andernfalls mich verantwortlich gemacht hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a45cffa7-90b3-3aa4-a245-67be6dac7a33",
                                        "entry_id": "dac034cd-f8ce-3b18-9fcf-db67ca822d32",
                                        "glosses": [
                                            "Wegnahme einer fremden beweglichen Sache in Zueignungsabsicht"
                                        ],
                                        "tags": [
                                            "deutsches und österreichisches Strafrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0c0a61d-76cd-473b-ac67-5800f4040ad1",
                                                "sense_id": "a45cffa7-90b3-3aa4-a245-67be6dac7a33",
                                                "text": "Herr Müller wurde wegen Diebstahls zu einer Geldstrafe verurteilt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c632823f-9cf3-49e3-b49f-43f311837a0c",
                        "source_entry_id": "156c7311-1e3d-3305-802e-e94dd9251e8b",
                        "source_sense_id": "7f099876-6526-3833-a076-748b0e80116e",
                        "source_sense_description": "petty theft",
                        "target_lang_word": "Raub",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raub",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f9dd3e1-2eca-3d55-a5bb-3ec9f840724a",
                                        "entry_id": "c6ea043d-8eca-39e7-8acf-1d766cf708c9",
                                        "glosses": [
                                            "das gewaltsame Wegnehmen; das Rauben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfae291c-50a4-440f-9c59-cde523acfc49",
                                                "sense_id": "2f9dd3e1-2eca-3d55-a5bb-3ec9f840724a",
                                                "text": "Das Museum meldete heute den Raub eines wertvolles Gemäldes."
                                            },
                                            {
                                                "example_id": "56a69c2a-1759-44c8-af90-4e00afc1cba2",
                                                "sense_id": "2f9dd3e1-2eca-3d55-a5bb-3ec9f840724a",
                                                "text": "Für den Raub des Maibaumes bestehen Regeln, und diese müssen genau beachtet werden."
                                            },
                                            {
                                                "example_id": "dd202ae0-360a-4bfd-b82f-f21e507e314a",
                                                "sense_id": "2f9dd3e1-2eca-3d55-a5bb-3ec9f840724a",
                                                "text": "„Unter den Rassen der westlichen Honigbiene wurde die italienische Biene mit einer besonders starken Neigung zum Raub identifiziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab034e20-5480-307b-bee2-f03ca9505ecb",
                                        "entry_id": "c6ea043d-8eca-39e7-8acf-1d766cf708c9",
                                        "glosses": [
                                            "die Wegnahme einer fremden beweglichen Sache durch Gewalt gegen eine Person oder unter Androhung einer gegenwärtigen Gefahr für Leib und Leben mit der Absicht, die Sache sich oder einem Dritten rechtswidrig zuzueignen (§ 249 StGB in Deutschland)"
                                        ],
                                        "tags": [
                                            "Strafrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b442227d-e6ef-4ac5-aef7-c4d04c6fc47c",
                                                "sense_id": "ab034e20-5480-307b-bee2-f03ca9505ecb",
                                                "text": "Das Gericht verurteilte den Mann wegen Raubes."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                        "entry_id": "c6ea043d-8eca-39e7-8acf-1d766cf708c9",
                                        "glosses": [
                                            "das geraubte Gut, die Beute"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "713978d2-5795-4f16-bbad-9cb1f4a83920",
                                                "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                                "text": "Dieses Vogels Raub sind Mäuse und Frösche."
                                            },
                                            {
                                                "example_id": "1e378eac-3290-4ed1-8f4a-18ee7db4bc00",
                                                "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                                "text": "Das gesamte Anwesen wurde ein Raub der Flammen."
                                            },
                                            {
                                                "example_id": "ded66ba4-8001-452c-b767-c24898d2adcc",
                                                "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                                "text": "Der neu angelegte, feinsandige Badestrand wurde ein Raub der Wellen."
                                            },
                                            {
                                                "example_id": "089cbca0-af2b-4a97-aa4f-d8140a20e81f",
                                                "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                                "text": "Der Täter versteckte den Raub im Keller."
                                            },
                                            {
                                                "example_id": "3a37889a-b867-4f90-8dfb-b5111fda2ce2",
                                                "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                                "text": "Die Jungs teilten den Raub unter sich auf, und jeder bekam den gleichen Anteil."
                                            },
                                            {
                                                "example_id": "c9e59de5-0797-4b8a-9a6f-3ba8bb2d578d",
                                                "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                                "text": "„Er, der in göttlicher Gestalt war, hielt es nicht für einen Raub, Gott gleich zu sein, sondern entäußerte sich selbst und nahm Knechtsgestalt an, ward den Menschen gleich und der Erscheinung nach als Mensch erkannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
