                                "target_senses": [
                                    {
                                        "sense_id": "b103ed09-f0ff-3d28-93b5-8ccc33e04ef4",
                                        "entry_id": "7c854da1-c655-31ec-84fd-473b69ff0e66",
                                        "glosses": [
                                            "The legal dissolution of a marriage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82c391fa-5c62-4cef-9e88-2f20c988966a",
                                                "sense_id": "b103ed09-f0ff-3d28-93b5-8ccc33e04ef4",
                                                "text": "Richard obtained a divorce from his wife some years ago, but hasn't returned to the dating scene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a88b4778-237a-3bab-812e-24d4411b5ab2",
                                        "entry_id": "7c854da1-c655-31ec-84fd-473b69ff0e66",
                                        "glosses": [
                                            "A separation of connected things."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aadd615-4bb5-4b2d-8a6d-02c7a3a1dc75",
                                                "sense_id": "a88b4778-237a-3bab-812e-24d4411b5ab2",
                                                "text": "The Civil War split between Virginia and West Virginia was a divorce based along cultural and economic as well as geographic lines."
                                            },
                                            {
                                                "example_id": "3e93aa84-c3ec-438f-ac3d-472cafdb6710",
                                                "sense_id": "a88b4778-237a-3bab-812e-24d4411b5ab2",
                                                "text": "The great trick of online retail has been to get us to do more shopping while thinking less about it – thinking less, in particular, about how our purchases reach our homes. This divorce of a product from its voyage to us is perhaps the thing that Amazon has sold us most successfully"
                                            },
                                            {
                                                "example_id": "1b7de339-1929-4948-b9a2-832263ebc818",
                                                "sense_id": "a88b4778-237a-3bab-812e-24d4411b5ab2",
                                                "text": "To make divorce of their incorporate league"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb6996e-6b13-3fad-b22d-68e1b87dee50",
                                        "entry_id": "7c854da1-c655-31ec-84fd-473b69ff0e66",
                                        "glosses": [
                                            "The separation of a bonded pair of animals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "366d0540-3d1e-3b1b-b73f-9992e41b25c7",
                                        "entry_id": "7c854da1-c655-31ec-84fd-473b69ff0e66",
                                        "glosses": [
                                            "That which separates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caa198a1-e9bc-47ad-b674-a96c01f29f55",
                                                "sense_id": "366d0540-3d1e-3b1b-b73f-9992e41b25c7",
                                                "text": "Go with me like good angels to my end; / And as the long divorce of steel falls on me, / Make of your prayers one sweet sacrifice, / And lift my soul to heaven. Lead on, o' God's name."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "divorce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c27db16-f8a4-3a15-bc4e-5f32577e5012",
                                        "entry_id": "54be1ec8-5dc8-37cb-a10e-6acb529e8a8b",
                                        "glosses": [
                                            "To legally dissolve a marriage between two people."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0fe8866-e237-40d3-9e73-aa04308d5809",
                                                "sense_id": "9c27db16-f8a4-3a15-bc4e-5f32577e5012",
                                                "text": "A ship captain can marry couples, but cannot divorce them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ab0b95d-eeb9-35c7-8bc1-f1858a6a527d",
                                        "entry_id": "54be1ec8-5dc8-37cb-a10e-6acb529e8a8b",
                                        "glosses": [
                                            "To end one's own marriage to (a person) in this way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "509d629b-ed91-43e8-b2b7-d845fa84154c",
                                                "sense_id": "7ab0b95d-eeb9-35c7-8bc1-f1858a6a527d",
                                                "text": "Lucy divorced Steve when she discovered that he had been unfaithful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "336a5638-d2a8-3f62-9321-1eb45f218086",
                                        "entry_id": "54be1ec8-5dc8-37cb-a10e-6acb529e8a8b",
                                        "glosses": [
                                            "To obtain a legal divorce."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34862b5f-05d3-4e5f-b04d-7997f74c429a",
                                                "sense_id": "336a5638-d2a8-3f62-9321-1eb45f218086",
                                                "text": "Edna and Simon divorced last year; he got the house, and she retained the business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1590e62-3f88-3663-9e60-a2213fd9b14d",
                                        "entry_id": "54be1ec8-5dc8-37cb-a10e-6acb529e8a8b",
                                        "glosses": [
                                            "To separate something that was connected."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee84200e-89e3-485f-805e-768d5caf4ad5",
                                                "sense_id": "b1590e62-3f88-3663-9e60-a2213fd9b14d",
                                                "text": "The radical group voted to divorce itself from the main faction and start an independent movement."
                                            },
                                            {
                                                "example_id": "749402af-e4f2-47ff-93e5-e16dbe08a6b0",
                                                "sense_id": "b1590e62-3f88-3663-9e60-a2213fd9b14d",
                                                "text": "He is knight dubb'd with vnhatche'd Rapier, and on carpet conſideration, but he is a diuell in priuate brall, soules and bodies hath he diuorc'd three, and his incenſement at this moment is ſo implacable, that ſatisfaction can be none, but by pangs of death and ſepulcher: Hob, nob, is his word: giu't or take't."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e148938f-e534-44b0-9379-a575f1e51d3c",
                        "source_entry_id": "388efeb1-81f4-3154-9d9e-acaed7484101",
                        "source_sense_id": "f35732d1-6da7-3d27-8ba3-979f32efc9b1",
                        "source_sense_description": "formele verbreking van een huwelijksband",
                        "target_lang_word": "divorce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divorce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f42c07f8-3e11-32fc-a591-23c0e592bd5d",
                                        "entry_id": "a5691830-291c-3915-a69c-8305dac7ffad",
                                        "glosses": [
                                            "Dissolution judiciaire du mariage."
                                        ],
                                        "tags": [
                                            "Famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "472b077d-0223-4c0f-8561-7e5cfaa4ac28",
                                                "sense_id": "f42c07f8-3e11-32fc-a591-23c0e592bd5d",
                                                "text": "Si je l'eusse deviné, je n'aurais pas manqué de m'élever avec toute la force de mon ministère sacré contre cette odieuse pratique, laquelle a pour but d'établir un cas de divorce en simulant que le mariage n'a eu lieu que par suite de violence matérielle exercée contre une des parties contractantes."
                                            },
                                            {
                                                "example_id": "cd7ce264-efe1-4e3b-b384-51de9291beb9",
                                                "sense_id": "f42c07f8-3e11-32fc-a591-23c0e592bd5d",
                                                "text": "Nous connaissons déjà les noces d’argent, d’or et de diamant : de l’autre coté de l’Atlantique, où, par suite de la facilité du divorce, les longs mariages sont plus rares, la mode, à présent, est de célébrer, dès après dix ans de vie conjugale, ses noces d’étain."
                                            },
                                            {
                                                "example_id": "4ac2e352-bc95-4e44-b3f1-43cf84d6b390",
                                                "sense_id": "f42c07f8-3e11-32fc-a591-23c0e592bd5d",
                                                "text": "Mon vieil ami Élisée Reclus qui a eu le rare courage de conformer sa conduite à ses principes, et qui avait présidé à l’union libre de ses filles, était un adversaire du divorce dans lequel il voyait le moyen le plus sûr de consolider le mariage."
                                            },
                                            {
                                                "example_id": "9b07ac88-8a01-4e80-bdae-b110de31bd6f",
                                                "sense_id": "f42c07f8-3e11-32fc-a591-23c0e592bd5d",
                                                "text": "Dans les divorces de jeunes, la présence des enfants, dont il faut partager la garde, et qu’on aime plus ou moins malgré tout, amoindrit souvent la violence de l’affrontement ; mais dans les divorces de vieux, où seuls demeurent les intérêts financiers et patrimoniaux, la sauvagerie du combat ne connaît plus aucune limite."
                                            },
                                            {
                                                "example_id": "13382424-2b15-4c3f-8a10-7ce6c6824de3",
                                                "sense_id": "f42c07f8-3e11-32fc-a591-23c0e592bd5d",
                                                "text": "Il aduient aulcunnesfoys quād deux gens mariez ne peuuēt durer enſemble, de leur volunté & accord ſe ſeparent, & treuuent parties auec leſquelles ilz eſperent viure plus doulcement, & ſe mariēt, mais non pas ſans l'authorité du parlement, qui n'admet poinct le diuorce ſe la cauſe ne luy eſt diligemmēt congneue par le recit des maris & des femmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85b7aafe-1297-32d2-b9a8-33f2f12b7aa1",
                                        "entry_id": "a5691830-291c-3915-a69c-8305dac7ffad",
                                        "glosses": [
                                            "Séparation de deux choses qui peuvent être liées."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98489161-8362-4863-95ed-186ef7bbba93",
                                                "sense_id": "85b7aafe-1297-32d2-b9a8-33f2f12b7aa1",
                                                "text": "[…] il est évident que la seule voie restée libre aux deux pouvoirs en conflit, c’est la voie ouverte aux époux mal assortis, le divorce et, de préférence, le divorce par consentement mutuel."
                                            },
                                            {
                                                "example_id": "08da9b06-9fe5-4487-8e01-947c02358a0b",
                                                "sense_id": "85b7aafe-1297-32d2-b9a8-33f2f12b7aa1",
                                                "text": "Le divorce entre la production et les producteurs va créer une économie abstraite, entièrement inconnue au Moyen Age, et qui favorisera le développement de la plus affreuse pauvreté."
                                            },
                                            {
                                                "example_id": "5861d32e-e29d-4959-a380-3e598bfd3b3d",
                                                "sense_id": "85b7aafe-1297-32d2-b9a8-33f2f12b7aa1",
                                                "text": "À titre de comparaison, cette statistique est aujourd'hui inversée en France: de nos jours, environ 70% des procédures de divorce sont initiées par des femmes."
                                            }
                                        ]
                                    }
                                ]
                            },
