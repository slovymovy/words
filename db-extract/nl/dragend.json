        "nl-extract.jsonl": [
            {
                "entry_id": "8250d007-7a90-3c17-81c7-e2dc6c42c59f",
                "word": "dragend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e58c094a-ea90-3851-850a-1df25b470211",
                        "entry_id": "8250d007-7a90-3c17-81c7-e2dc6c42c59f",
                        "glosses": [
                            "van iets of iemand dat hij een belangrijke steun is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b2c88eb-5a1c-4881-9113-32998248be06",
                                "sense_id": "e58c094a-ea90-3851-850a-1df25b470211",
                                "text": "Nijhuis voelde geen vertrouwen meer nadat hij al voor het duel tegen Amersfoort was gepasseerd ten faveure van oud-doelman Robert Beskers. Door de switch van Beskers van veldspeler tot doelman verloor de toch alle smalle selectie van BZC weer een dragende speler. Aan interim-coach Klaas Zwaan de club van de ondergang te redden."
                            },
                            {
                                "example_id": "daaf3f49-6c85-4c81-b1ee-ee776fe7e388",
                                "sense_id": "e58c094a-ea90-3851-850a-1df25b470211",
                                "text": ",,We stonden vandaag echt als één ploeg en dan is het vervelend dat je 1-1 speelt door zo’n goal uit een spelhervatting”, vertelde Görtler, basisklant nu Advocaat met tal van afwezigen kampt. De Duitser moest de plek innemen van één van de dragende krachten op het middenveld, Riechedly Bazoer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7283db15-2537-42a9-92cc-92947a2ed5bd",
                        "source_entry_id": "8250d007-7a90-3c17-81c7-e2dc6c42c59f",
                        "source_sense_id": "e58c094a-ea90-3851-850a-1df25b470211",
                        "source_sense_description": "van iets of iemand dat hij een belangrijke steun is",
