                        "glosses": [
                            "A narrow road passing between two houses or a row of houses, or an alley leading to a single house."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3ef5b2cd-cac1-443c-9959-f108bd68fe04",
                                "sense_id": "c8902c1a-71e9-323f-9357-88f79b23bda5",
                                "text": "\"Here we are,\" said the artist of coffins, the last master of mortal ceremonies; \"we are now near home, keep close to me through this passage, or you may miss me in the dark—we turn, mind you, to the left, along the river:\" and darting down the “angiport,” he led the way to his retired abode."
                            },
                            {
                                "example_id": "ab548454-4872-4c49-8f98-33c735e7ef6f",
                                "sense_id": "c8902c1a-71e9-323f-9357-88f79b23bda5",
                                "text": "The unsavoury mass of slums packed away in the lower levels, with their coking labyrinth of lanes, 'angiports', and culs-de-sac, continued, with no general attempt to modify or purify, until the great Neronian conflagation swept an area at last for reconstruction."
                            }
                        ]
