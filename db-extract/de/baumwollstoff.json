                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "953f206a-c514-33c9-9fc8-6b87cedc3f0f",
                                        "entry_id": "e059d740-570c-3487-8239-8ebaa77e7639",
                                        "glosses": [
                                            "A large military scarf, usually camouflage coloured and used for concealment when not used as a scarf."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1fa6231-7ff5-303b-9daf-d562ba90ed58",
                                        "entry_id": "e059d740-570c-3487-8239-8ebaa77e7639",
                                        "glosses": [
                                            "A woven, nonwoven or knitted fabric composed of continuous strands of material used for reinforcing or strengthening membranes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1057ad31-be88-34a7-b543-49171b63927a",
                                        "entry_id": "e059d740-570c-3487-8239-8ebaa77e7639",
                                        "glosses": [
                                            "A theater drop that appears opaque when a scene in front is lighted and transparent or translucent when a scene in back is lighted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf6758cb-6e37-4836-9759-590e83388b5c",
                                                "sense_id": "1057ad31-be88-34a7-b543-49171b63927a",
                                                "text": "Mummified mannequins dangling above the set, illuminated from within, were a heavy-handed touch, but the designer George Tsypin’s translucent scrims and painted drops beautifully conveyed the passage of sun-blasted days and bone-chilling nights on the edge of civilization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04775eea-8714-3328-af16-c5f942313ae4",
                                        "entry_id": "e059d740-570c-3487-8239-8ebaa77e7639",
                                        "glosses": [
                                            "A sheet of gauze etc. used to reduce the intensity of light."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cd7835f-55e0-308d-b318-f096878c6614",
                                        "entry_id": "e059d740-570c-3487-8239-8ebaa77e7639",
                                        "glosses": [
                                            "Thin canvas glued on the inside of panels to prevent shrinking, checking, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scrim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
