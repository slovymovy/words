                        "examples": [
                            {
                                "example_id": "4d305ac5-6a53-4805-976b-a50839f77335",
                                "sense_id": "590701f8-e350-372d-baa6-07c5bceca4b1",
                                "text": "zapychacz żołądku",
                                "translation": "stomach filler",
                                "english": "stomach filler"
                            },
                            {
                                "example_id": "560096b0-22e1-4063-a374-9e3f22b01f17",
                                "sense_id": "590701f8-e350-372d-baa6-07c5bceca4b1",
                                "text": "zapychacz czasu",
                                "translation": "time filler",
                                "english": "time filler"
                            },
                            {
                                "example_id": "3d7c1f6b-b2b8-441d-8bd8-8f4f228f5180",
                                "sense_id": "590701f8-e350-372d-baa6-07c5bceca4b1",
                                "text": "A to tylko marne zapychacze czasu, miałkie i bezsensowne wyładowania mózgu w starciu z 23-godzinną pustką.",
                                "translation": "And these are just measly time fillers, shallow and senseless brain discharges in the face of 23-hour emptiness.",
