                    {
                        "sense_id": "dd0da14f-2fca-399d-9856-7328179c9d1b",
                        "entry_id": "d1eec084-d69f-3bd8-98ec-b759142028f9",
                        "glosses": [
                            "griffin (mythical beast having the body of a lion and the wings and head of an eagle)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0abe44d7-1fe0-477e-892b-bfb7b22e42a7",
                                "sense_id": "dd0da14f-2fca-399d-9856-7328179c9d1b",
                                "text": "— Оста́вьте меня́! Ра́зве я винова́т, что Вене́ра — прекра́снейшая из боги́нь? Пари́с челове́к со вку́сом, и я его́ непреме́нно сде́лаю со́вестным судьё́ю в Пеки́не, как ско́ро въе́ду в своё́ Кита́йское госуда́рство на крыла́том грифо́не!",
                                "translation": "Aleksey Konstantinovich Tolstoy",
                                "english": "Aleksey Konstantinovich Tolstoy"
                            }
                        ]
                    }
                ],
