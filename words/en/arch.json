{
    "word_family": [
        "archer",
        "archery",
        "archway",
        "arched",
        "overarch"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee8d8351-2389-3f94-8d2b-eef18de7bfb2",
                    "sense_definition": "A curved structure that spans an opening and supports weight, such as in a bridge, doorway, or wall; also, any shape resembling this curve.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat passed slowly under the stone <w>arch</w> of the old bridge.",
                            "target_lang_translations": {
                                "ru": "Лодка медленно проплыла под каменной <w>аркой</w> старого моста.",
                                "zh": "小船缓慢地穿过了古桥的石<w>拱</w>。"
                            }
                        },
                        {
                            "text": "They decorated the garden entrance with a beautiful wooden <w>arch</w> covered in flowers.",
                            "target_lang_translations": {
                                "ru": "Они украсили вход в сад красивой деревянной <w>аркой</w>, увитой цветами.",
                                "zh": "他们用一个开满鲜花的漂亮木制<w>拱门</w>装饰了花园入口。"
                            }
                        }
                    ],
                    "synonyms": [
                        "curve",
                        "arc"
                    ],
                    "common_phrases": [
                        "stone arch",
                        "natural arch",
                        "triumphal arch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изогнутая конструкция, перекрывающая проём и поддерживающая вес, например, в мосту, дверном проёме или стене; также любая форма, напоминающая этот изгиб.",
                        "zh": "一种跨越开口并支撑重量的弯曲结构，例如在桥梁、门洞或墙壁中；也指任何类似这种曲线的形状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "а́рка",
                                "target_lang_sense_clarification": "архитектурный элемент"
                            },
                            {
                                "target_lang_word": "свод",
                                "target_lang_sense_clarification": "дугообразное перекрытие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拱",
                                "target_lang_sense_clarification": "建筑结构"
                            },
                            {
                                "target_lang_word": "拱门",
                                "target_lang_sense_clarification": "门洞处的拱形结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59caa25c-ba50-3e22-9c4e-295d6e80fc70",
                    "sense_definition": "The curved part on the bottom of the foot between the heel and the toes.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wearing shoes without proper support can cause pain in the <w>arch</w> of your foot.",
                            "target_lang_translations": {
                                "ru": "Ношение обуви без надлежащей поддержки может вызвать боль в <w>своде</w> стопы.",
                                "zh": "穿没有适当支撑的鞋子可能会导致你的<w>足弓</w>疼痛。"
                            }
                        },
                        {
                            "text": "He has a high <w>arch</w>, which makes finding comfortable boots difficult.",
                            "target_lang_translations": {
                                "ru": "У него высокий <w>подъём</w>, из-за чего ему трудно подобрать удобные ботинки.",
                                "zh": "他的<w>足弓</w>很高，这使得他很难找到舒适的靴子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "high arch",
                        "fallen arches"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изогнутая часть нижней поверхности стопы между пяткой и пальцами.",
                        "zh": "脚底在脚后跟和脚趾之间的弯曲部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свод",
                                "target_lang_sense_clarification": "часть стопы"
                            },
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "разговорное, о высоте стопы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "足弓",
                                "target_lang_sense_clarification": "脚底的弯曲部位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10ddb145-f1ff-3af3-af28-ab796bb45324",
                    "sense_definition": "To form a curved shape, often referring to the back or eyebrows.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat <w>arched</w> its back and hissed when it saw the dog.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>выгнула</w> спину и зашипела, увидев собаку.",
                                "zh": "猫看到狗时<w>拱起</w>了背并发出嘶嘶声。"
                            }
                        },
                        {
                            "text": "She <w>arched</w> her eyebrows in surprise when she heard the unexpected news.",
                            "target_lang_translations": {
                                "ru": "Она удивлённо <w>изогнула</w> брови, услышав неожиданную новость.",
                                "zh": "听到这个意外的消息时，她惊讶地<w>扬起</w>了眉毛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "arch one's back",
                        "arch one's eyebrows"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать изогнутую форму; часто относится к спине или бровям.",
                        "zh": "形成弯曲的形状，通常指背部或眉毛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгиба́ть",
                                "target_lang_sense_clarification": "спину"
                            },
                            {
                                "target_lang_word": "изгиба́ть",
                                "target_lang_sense_clarification": "брови, линию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拱起",
                                "target_lang_sense_clarification": "使背部弯曲"
                            },
                            {
                                "target_lang_word": "扬起",
                                "target_lang_sense_clarification": "指眉毛弯曲"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5243952b-a5e0-3f26-8e96-4c530d8adf90",
                    "sense_definition": "Principal or most important; typically used to describe a significant enemy or rival.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The superhero finally defeated his <w>arch</w> enemy in the final battle.",
                            "target_lang_translations": {
                                "ru": "Супергерой наконец победил своего <w>заклятого</w> врага в последней битве.",
                                "zh": "超级英雄终于在最后一战中击败了他的<w>死对头</w>。"
                            }
                        },
                        {
                            "text": "In the story, the two knights were <w>arch</w> rivals fighting for the same kingdom.",
                            "target_lang_translations": {
                                "ru": "В этой истории два рыцаря были <w>главными</w> соперниками, сражавшимися за одно королевство.",
                                "zh": "在故事中，这两位骑士是争夺同一个王国的<w>主要</w>竞争对手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "arch enemy",
                        "arch rival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Главный или наиболее важный; обычно используется для описания значительного врага или соперника.",
                        "zh": "主要的或最重要的；通常用于描述重大的敌人或竞争对手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закля́тый",
                                "target_lang_sense_clarification": "о враге"
                            },
                            {
                                "target_lang_word": "гла́вный",
                                "target_lang_sense_clarification": "о сопернике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "死对头",
                                "target_lang_sense_clarification": "指最大的敌人"
                            },
                            {
                                "target_lang_word": "主要",
                                "target_lang_sense_clarification": "指竞争对手"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d70604f5-0c58-3806-bfec-71ad9e0407cb",
                    "sense_definition": "Showing amusement or secret knowledge in a playful, clever, or slightly mischievous way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave him an <w>arch</w> look that suggested she knew exactly what he was hiding.",
                            "target_lang_translations": {
                                "ru": "Она бросила на него <w>лукавый</w> взгляд, намекающий на то, что она точно знает, что он скрывает.",
                                "zh": "她给了他一个<w>狡黠的</w>眼神，暗示她完全知道他在隐瞒什么。"
                            }
                        },
                        {
                            "text": "His <w>arch</w> comments during the meeting made everyone laugh despite the serious topic.",
                            "target_lang_translations": {
                                "ru": "Его <w>игривые</w> замечания во время собрания рассмешили всех, несмотря на серьёзность темы.",
                                "zh": "尽管会议主题严肃，但他那些<w>俏皮的</w>评论还是让大家都笑了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "arch smile",
                        "arch look"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий веселье или тайное знание в игривой, умной или слегка озорной манере.",
                        "zh": "以一种俏皮、聪明或略带淘气的方式表现出愉悦或秘密的知识。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лука́вый",
                                "target_lang_sense_clarification": "хитрый, озорной"
                            },
                            {
                                "target_lang_word": "игри́вый",
                                "target_lang_sense_clarification": "шутливый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狡黠的",
                                "target_lang_sense_clarification": "带有调皮或心知肚明的意味"
                            },
                            {
                                "target_lang_word": "俏皮的",
                                "target_lang_sense_clarification": "指言语或神态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "08e1f412-5a80-376f-9cfb-3e3217594805",
                    "sense_definition": "A short form of the male given name Archibald or Archie.",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "5",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My cousin <w>Arch</w> is coming to stay with us for the summer.",
                            "target_lang_translations": {
                                "ru": "Мой кузен <w>Арч</w> приедет погостить к нам на лето.",
                                "zh": "我的表弟<w>阿奇</w>夏天要来和我们住在一起。"
                            }
                        },
                        {
                            "text": "Please tell <w>Arch</w> that I will call him later.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, передай <w>Арчу</w>, что я позвоню ему позже.",
                                "zh": "请告诉<w>阿奇</w>我稍后会给他打电话。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращённая форма мужского имени Арчибальд или Арчи.",
                        "zh": "男性名字 Archibald 或 Archie 的缩写形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Арч",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿奇",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}