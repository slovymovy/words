                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ab76914-e40f-3263-86e9-ae4b60e32b19",
                        "entry_id": "17908e77-5e4d-3266-87ba-afc2a859cd42",
                        "glosses": [
                            "Action de ratifier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4966976d-1e49-4927-89d3-c12b95b14330",
                                "sense_id": "2ab76914-e40f-3263-86e9-ae4b60e32b19",
                                "text": "L’échange des ratifications a eu lieu."
                            },
                            {
                                "example_id": "9b2d5a7d-5bce-42ff-a1a9-9d1aa103cfba",
                                "sense_id": "2ab76914-e40f-3263-86e9-ae4b60e32b19",
                                "text": "Ratification sous seing privé."
                            },
                            {
                                "example_id": "aa3c18e8-dca8-4d79-9cbb-b38372a6ad6f",
                                "sense_id": "2ab76914-e40f-3263-86e9-ae4b60e32b19",
                                "text": "Ratification par acte public."
                            },
                            {
                                "example_id": "81d3dded-f40d-409f-9cd0-545338fd8e6a",
                                "sense_id": "2ab76914-e40f-3263-86e9-ae4b60e32b19",
                                "text": "Ratification par écrit, verbale."
                            },
                            {
                                "example_id": "63bdb2e8-67a4-4e19-8f01-da0d217d7983",
                                "sense_id": "2ab76914-e40f-3263-86e9-ae4b60e32b19",
                                "text": "Le mineur signa au contrat et promit de donner sa ratification quand il serait majeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe61e4b0-1253-3289-af3e-33190820ae00",
                        "entry_id": "17908e77-5e4d-3266-87ba-afc2a859cd42",
                        "glosses": [
                            "Approbation dans les formes requises, généralement par le vote d’une assemblée, d’un texte élaboré ou signé par une autre autorité."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "65fe9d0c-680b-4492-a4f2-c15cfff0cc3a",
                                "sense_id": "fe61e4b0-1253-3289-af3e-33190820ae00",
                                "text": "Le traité entre en vigueur le 4 novembre 2016, trente jours après sa ratification par au moins 55 parties représentant 55 % des émissions."
                            },
                            {
                                "example_id": "cdfc0fc4-2b25-4dad-b26c-865076183c23",
                                "sense_id": "fe61e4b0-1253-3289-af3e-33190820ae00",
                                "text": "Il est possible d’inclure dans un projet de loi de ratification des dispositions modifiant, le cas échéant pour corriger des erreurs, ou complétant celles introduites par l’ordonnance à ratifier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c035f00-6396-4b1d-8995-3aff22a9db7b",
                        "source_entry_id": "17908e77-5e4d-3266-87ba-afc2a859cd42",
