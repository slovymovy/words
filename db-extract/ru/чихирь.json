                "senses": [
                    {
                        "sense_id": "7374bd40-9b75-35b1-a491-5fe535714e55",
                        "entry_id": "f19871dd-8d6f-35fb-ad9d-25a07255cd1b",
                        "glosses": [
                            "кавказское красное неперебродившее вино домашнего приготовления"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2264dee8-8bd8-48bd-873a-aa8c14ea69fb",
                                "sense_id": "7374bd40-9b75-35b1-a491-5fe535714e55",
                                "text": "Тогда хозяин благосклонный // С приветом, ласково, встает // И гостю в чаше благовонной // Чихирь отрадный подает."
                            },
                            {
                                "example_id": "b2edd520-397e-409e-b414-0c67119c53ef",
                                "sense_id": "7374bd40-9b75-35b1-a491-5fe535714e55",
                                "text": "― Экой разбойник! ― сказал второй казак, ― как напьётся чихиря, так и пошёл крошить всё, что ни попало."
                            },
                            {
                                "example_id": "ebbf82d0-dd65-45aa-acea-f3ec24cd0564",
                                "sense_id": "7374bd40-9b75-35b1-a491-5fe535714e55",
                                "text": "Да что, отец мой, чихирю-то вели подне́сть."
                            }
                        ]
                    }
                ],
