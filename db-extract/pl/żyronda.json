                    }
                ],
                "translations": [
                    {
                        "translation_id": "889d96a2-0ad2-460c-8801-2d4c4547fc5d",
                        "source_entry_id": "e5a80443-0eb9-353f-bae2-e1805a93ac40",
                        "source_sense_id": "959be3a7-5db6-39b8-8903-1a03f043b9fe",
                        "target_lang_word": "Gironde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gironde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c91e0749-d58d-33e8-b357-8273a831b640",
                                        "entry_id": "e5fcc2fb-48a9-3008-868d-d190874eb9cd",
                                        "glosses": [
                                            "Estuaire commun de la Garonne et de la Dordogne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ecdcbe3-2834-4069-9142-2f690cb43406",
                                                "sense_id": "c91e0749-d58d-33e8-b357-8273a831b640",
                                                "text": "— Vous savez, monsieur le préfet, que la question de la Gironde est double ; l’une porte sur le cours du fleuve de Bordeaux à la mer, et s’occupe des dangers que présentent à la navigation des grands navires les bancs de sable et les dépôts de vase ; l’autre porte sur l’embouchure même du fleuve."
                                            },
                                            {
                                                "example_id": "f289c7a9-5b97-4688-b6c9-7876ba522774",
                                                "sense_id": "c91e0749-d58d-33e8-b357-8273a831b640",
                                                "text": "Enfin, je puis m'échapper, filer contre la vague, remonter la Gironde et, seul entre flots et nuages, me laisser dériver doucement, couché sur le dos, somnolent au bord du rêve."
                                            },
                                            {
                                                "example_id": "c6619e4c-312f-4415-a7fc-4fb20014999a",
                                                "sense_id": "c91e0749-d58d-33e8-b357-8273a831b640",
                                                "text": "Situé à proximité de l’estuaire de la Gironde, dans le cœur du village de Saint-Dizant-du-Gua, le château de Beaulon est un ancien lieu de résidence des évêques de Bordeaux au XVIIᵉ siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0f5a22c-af57-39b9-abe3-4b9d8f91120f",
                                        "entry_id": "e5fcc2fb-48a9-3008-868d-d190874eb9cd",
                                        "glosses": [
                                            "Département français de la région Nouvelle-Aquitaine. Ce département porte le numéro 33."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ef9502-bb22-4f79-a75f-ed94361675d4",
                                                "sense_id": "d0f5a22c-af57-39b9-abe3-4b9d8f91120f",
                                                "text": "Quant au vieux bonhomme à cheveux blancs qu’il aperçut devant lui, il y fit à peine attention : un indigène de la Gironde de passage à Paris sans doute, une espèce."
                                            },
                                            {
                                                "example_id": "fa1ba839-c4fa-4eaa-9971-26ece6004d0a",
                                                "sense_id": "d0f5a22c-af57-39b9-abe3-4b9d8f91120f",
                                                "text": "[…], il était inutile de nous adresser au ministère où nous aurions, sans doute, les plus grandes difficultés à nous faire expliquer comment, pour la Gironde, on avait trouvé cette somme de 4.950 francs par kilomètre de routes nationales à départementaliser."
                                            },
                                            {
                                                "example_id": "e3fef868-b654-42cd-8d70-fcc6b5bb798d",
                                                "sense_id": "d0f5a22c-af57-39b9-abe3-4b9d8f91120f",
                                                "text": "Si le siège de l’entreprise se situe à Saint-Sulpice-et-Cameyrac, en Gironde, son atelier de transformation, lui, est basé à Saint-Genis-de-Saintonge, en Charente-Maritime à quelques dizaines de kilomètres de Royan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2263194-9062-301d-8e68-9677e82ac561",
                                        "entry_id": "e5fcc2fb-48a9-3008-868d-d190874eb9cd",
                                        "glosses": [
                                            "Ancien nom de la commune française Gironde-sur-Dropt."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a88cc5b4-0ef4-32c7-8e41-c4c0b6a8d736",
                                        "entry_id": "e5fcc2fb-48a9-3008-868d-d190874eb9cd",
                                        "glosses": [
                                            "Nom d’un parti politique de la Révolution française."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf16e5c3-d031-47d9-8b03-e18272daabd8",
                        "source_entry_id": "e5a80443-0eb9-353f-bae2-e1805a93ac40",
                        "source_sense_id": "959be3a7-5db6-39b8-8903-1a03f043b9fe",
                        "target_lang_word": "Gironde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4ebe89ba-aa9e-4bf4-9e1a-2b387a46bfdf",
                        "source_entry_id": "e5a80443-0eb9-353f-bae2-e1805a93ac40",
                        "source_sense_id": "959be3a7-5db6-39b8-8903-1a03f043b9fe",
                        "target_lang_word": "Жиронда",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Жиронда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4d152f80-e129-3689-a90c-24202e677f9c",
                                        "entry_id": "6c154205-3580-323f-a3ce-93353bcb4ade",
                                        "glosses": [
                                            "геогр. река во Франции (фактически — эстуарий слившихся рек Гаронна и Дордонь)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfbd4840-1566-4a6c-90dd-ebdede8fe48c",
                                                "sense_id": "4d152f80-e129-3689-a90c-24202e677f9c",
                                                "text": "Когда пришло для них время поступать в университет, они пошли вместе в Страсбург пешком из деревни, лежащей в долине Жиронды."
                                            },
                                            {
                                                "example_id": "05b6e345-9dcb-410f-b137-dd34eb1f5845",
                                                "sense_id": "4d152f80-e129-3689-a90c-24202e677f9c",
                                                "text": "Ройан лежит у устья Жиронды, которая от Бордо до Ройана образует уже морской залив шириной в десяток верст."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d42e342-2160-337f-941b-bb97c8d23d20",
                                        "entry_id": "6c154205-3580-323f-a3ce-93353bcb4ade",
                                        "glosses": [
                                            "департамент во Франции, названный по имени реки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2828923-61c7-4efa-855a-1229efc52d5d",
                                                "sense_id": "1d42e342-2160-337f-941b-bb97c8d23d20",
                                                "text": "Он был парикмахером в Камбе и, кроме того, делал сабо, те деревянные башмаки, которыми стучат в Жиронде восемь месяцев в году, до жаркаго мая, когда заменяют их туфлями."
                                            },
                                            {
                                                "example_id": "4bbd9f4d-8e53-41ad-8c80-f81b0a79dcd5",
                                                "sense_id": "1d42e342-2160-337f-941b-bb97c8d23d20",
                                                "text": "Он сравнивал плавные переходы винных сосудов Жиронды с изгибами, которые демонстрировали девочки-официантки, уворачиваясь от его чаевых."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a80bfbf-c008-35ef-9c4f-756658974414",
                                        "entry_id": "6c154205-3580-323f-a3ce-93353bcb4ade",
                                        "glosses": [
                                            "истор., полит. : политическая партия в Национальном Конвенте"
                                        ],
                                        "tags": [
                                            "во Франции, во время Великой Французской революции"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ec02e61-0fb7-45c4-864a-953c7125f556",
                                                "sense_id": "1a80bfbf-c008-35ef-9c4f-756658974414",
                                                "text": "И как бы потом всё ни поворачивалось, как бы историки потом всё это ни интерпретировали ― Конвент, Жиронда, друг народа Марат, Дантон, Робеспьер ― всё начиналось с легкости и пустоты в желудке."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
