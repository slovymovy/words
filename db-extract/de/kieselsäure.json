                                            },
                                            {
                                                "example_id": "e366f5a8-245a-4047-be98-4a11993e326c",
                                                "sense_id": "d4f57f76-2723-34a6-8330-bf720ce77122",
                                                "text": "orthosilicic acid H₄SiO₄"
                                            },
                                            {
                                                "example_id": "20acc648-4dd4-4e7c-9a31-0aab29e84a1e",
                                                "sense_id": "d4f57f76-2723-34a6-8330-bf720ce77122",
                                                "text": "disilicic acid H₂Si₂O₅"
                                            },
                                            {
                                                "example_id": "1de1c4bb-0d1d-4221-8166-c21ef41d9bbd",
                                                "sense_id": "d4f57f76-2723-34a6-8330-bf720ce77122",
                                                "text": "pyrosilicic acid H₆Si₂O₇"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9694b8a2-7467-4640-8228-76c0283fa10f",
                        "source_entry_id": "a84e5ba4-f184-37a3-961c-998f27f3d0c5",
                        "source_sense_id": "d9ad9a10-9da2-3617-8571-446cd7993165",
                        "source_sense_description": "Sauerstoffsäure des Siliciums",
                        "target_lang_word": "acide silicique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acide silicique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b957ed53-1362-302c-90e3-f349c1ac4356",
                                        "entry_id": "71be959d-d51f-3083-a260-f39b0ef45bb7",
                                        "glosses": [
                                            "Famille de composés du silicium hydratés de formule générale [SiOₓ(OH)₄₋₂ₓ]ₙ."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5daca047-6142-4ad3-895f-90a978667416",
                                                "sense_id": "b957ed53-1362-302c-90e3-f349c1ac4356",
                                                "text": "Les acides siliciques sont des acides faibles."
                                            },
                                            {
                                                "example_id": "0d839f09-03cf-47fd-8f13-d4e62a1654e2",
                                                "sense_id": "b957ed53-1362-302c-90e3-f349c1ac4356",
                                                "text": "On ne considère plus les silicates comme des sels d’acides siliciques, mais comme des assemblages de tétraèdres quasi réguliers (Si, Al)O₄, dont les centres sont occupés par des ions silicium ou aluminium, et les sommets par des ions oxygène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5896f96-d44d-3563-8c0a-5428ff313035",
                                        "entry_id": "71be959d-d51f-3083-a260-f39b0ef45bb7",
                                        "glosses": [
                                            "Acide orthosilicique."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b726869f-6870-4504-8cd5-e1874513301b",
                                                "sense_id": "d5896f96-d44d-3563-8c0a-5428ff313035",
                                                "text": "Puis [les bactéries] attaquent la protéine de protection de l’enveloppe de silice, libérant ainsi cette dernière sous forme d’acide silicique."
                                            },
                                            {
                                                "example_id": "89487aa1-4721-48c0-a785-5947fb9fc6a7",
                                                "sense_id": "d5896f96-d44d-3563-8c0a-5428ff313035",
                                                "text": "La silice des eaux naturelles, à l’origine des roches siliceuses, provient principalement des continents, soit directement de l’hydrolyse des silicates qui libère de l’acide silicique (H₄SiO₄) dans les solutions de lessivage, soit indirectement par dissolution des organismes ayant fixé cet élément chimique."
                                            },
                                            {
                                                "example_id": "2e6c8a50-347b-4406-94c7-2c1b4acc3fcd",
                                                "sense_id": "d5896f96-d44d-3563-8c0a-5428ff313035",
                                                "text": "La silice dissoute est sous forme de solution d’acide silicique H₄SiO₄, qui se forme selon la réaction : SiO₂+ 2H₂O ⇔ H₄SiO₄. La solubilité de la silice dépend notamment du pH."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
