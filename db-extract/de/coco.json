                ],
                "senses": [
                    {
                        "sense_id": "f2676289-bf7b-3876-872a-5d62106d57c7",
                        "entry_id": "e98b52c5-4292-3b03-adaa-0c683366b11b",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60cd88ad-d52d-4391-bd3e-64ae727db6a3",
                                "sense_id": "f2676289-bf7b-3876-872a-5d62106d57c7",
                                "text": "Frau Coco ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3a919491-20a6-4fae-b7e3-c20258e0d23d",
                                "sense_id": "f2676289-bf7b-3876-872a-5d62106d57c7",
                                "text": "Herr Coco wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9d091e6b-3adc-44ed-808f-9a0e684152e5",
                                "sense_id": "f2676289-bf7b-3876-872a-5d62106d57c7",
                                "text": "Die Cocos kommen heute aus dem Rhein-Main-Gebiet."
                            },
                            {
                                "example_id": "95655cd5-de30-40b8-a24b-3bd01655aec6",
                                "sense_id": "f2676289-bf7b-3876-872a-5d62106d57c7",
                                "text": "Der Coco trägt nie die Schals, die die Coco ihm strickt."
                            },
                            {
                                "example_id": "7bbfccc9-5cd1-4b57-97ea-cdc845aab4ba",
                                "sense_id": "f2676289-bf7b-3876-872a-5d62106d57c7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Coco kommt, geht der Herr Coco.“"
                            },
                            {
                                "example_id": "692a5d7f-8f8e-4371-86e9-9b51d6456b10",
                                "sense_id": "f2676289-bf7b-3876-872a-5d62106d57c7",
                                "text": "Coco kommt und geht."
                            },
                            {
                                "example_id": "e2ff418a-acc0-4a17-9841-7f1032a4dbac",
                                "sense_id": "f2676289-bf7b-3876-872a-5d62106d57c7",
                                "text": "Cocos kamen, sahen und siegten."
                            },
                            {
                                "example_id": "e7a5fc57-80b2-4e40-876f-b6ccfb9b9dc6",
                                "sense_id": "f2676289-bf7b-3876-872a-5d62106d57c7",
                                "text": "An verregneten Herbsttagen ist Familie Cocos liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "4f156893-ec60-4b4f-b096-61711316fa14",
                                "sense_id": "f2676289-bf7b-3876-872a-5d62106d57c7",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Coco das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
