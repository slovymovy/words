                ],
                "senses": [
                    {
                        "sense_id": "fa4c9ff2-b791-313a-9f14-18373b157ee0",
                        "entry_id": "61ce982d-6d56-3752-beae-384de9a08105",
                        "glosses": [
                            "der Zeitraum, der vergeht, bis der Mond durch die Rotation der Erde und die Mondbewegung um die Erde wieder am selben Punkt über der Erde steht (ca. 24 Stunden und 50 Minuten)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c961c58c-fac2-4672-bfbd-f70dbfb79850",
                                "sense_id": "fa4c9ff2-b791-313a-9f14-18373b157ee0",
                                "text": "Da die Zeit zwischen zwei Meridiandurchgängen des Mondes (der Mondtag) 24 Stunden 50 Minuten, also das Doppelte obiger Hauptperiode ist, …"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "94dee02a-774a-3454-8d4a-965fb1eca625",
                        "entry_id": "61ce982d-6d56-3752-beae-384de9a08105",
                        "glosses": [
                            "Dauer eines \\\"Tages\\\" auf dem Mond (29 Erdtage, 12 Stunden, 44 Minuten und 2,8 Sekunden)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37d0337c-c14e-4c9d-bd31-26e8cb8fc577",
                                "sense_id": "94dee02a-774a-3454-8d4a-965fb1eca625",
                                "text": "„Wie lange dauert ein Mondtag?“"
                            },
                            {
                                "example_id": "a16e138c-7123-40f2-8525-846d2708d0c9",
                                "sense_id": "94dee02a-774a-3454-8d4a-965fb1eca625",
                                "text": "Da nun Philolaos die Umlaufzeit des Mondes nach dem synodischen Monat auf 29 1/2 Tage ansetzte, wie wir sogleich sehen werden; so war sein Mondtag, die Nacht miteingerechnet, 29 1/2 mal oder rund 30 mal größer als der Erdtag."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "12b7a7fa-cb20-35eb-b1e6-04eac043a9a5",
                        "entry_id": "61ce982d-6d56-3752-beae-384de9a08105",
                        "glosses": [
                            "Dauer des Tages (im Gegensatz zur Nacht) auf dem Mond (14 Erdtage, 18 Stunden, 22 Minuten und 1,4 Sekunden)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f40d130e-8da9-46d5-89cc-8966a713266d",
                                "sense_id": "12b7a7fa-cb20-35eb-b1e6-04eac043a9a5",
                                "text": "Am Mondtag beträgt die Temperatur auf der Oberfläche des Mondes etwa 130 °C."
                            },
                            {
                                "example_id": "7918bacb-fec8-49fa-8930-4ead07d602d4",
                                "sense_id": "12b7a7fa-cb20-35eb-b1e6-04eac043a9a5",
                                "text": "Ein kleines Problem ist dabei, dass ein Mondtag genau 14 Erdtage, 18 Stunden, 22 Minuten und 2 Sekunden dauert, alles in Erdzeit gemessen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
