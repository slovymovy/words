                "senses": [
                    {
                        "sense_id": "da4fd434-88e3-35eb-8ec8-f59c65a9308a",
                        "entry_id": "6400a73b-410c-375b-87cb-36f5b52e98ab",
                        "glosses": [
                            "Qu’on ne peut ou qu’on ne doit pas accepter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb816b3d-3733-4581-979c-8bc2b2653db1",
                                "sense_id": "da4fd434-88e3-35eb-8ec8-f59c65a9308a",
                                "text": "Par exemple, de la folle-avoine sera plus inacceptable dans une production de céréales destinée à la panification, que une céréale destinée à l'alimentation du bétail."
                            },
                            {
                                "example_id": "7d2ec4b4-bc45-4756-8f7c-fb4a9e1187d9",
                                "sense_id": "da4fd434-88e3-35eb-8ec8-f59c65a9308a",
                                "text": "Les politiques visant à « désethniser », ou à éliminer d’une autre façon des groupes ou certains éléments de leur culture, sont inacceptables sauf dans le cas de coutumes incompatibles avec les lois et usages des nations civilisées et avec les droits civiques et humains généralement admis, et dans le cas de coutumes spécifiées comme répréhensibles dans les accords internationaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e04de011-f382-4907-b5da-13fd212f336e",
                        "source_entry_id": "6400a73b-410c-375b-87cb-36f5b52e98ab",
                        "source_sense_id": "da4fd434-88e3-35eb-8ec8-f59c65a9308a",
                        "target_lang_word": "unannehmbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unannehmbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1da76d8f-79ab-314d-97c6-9a94fefcff8c",
                                        "entry_id": "199f0587-5910-397e-b136-788dc3039393",
                                        "glosses": [
                                            "nicht annehmbar/akzeptierbar seiend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db20dcb-eade-4561-b494-bed74139324b",
                                                "sense_id": "1da76d8f-79ab-314d-97c6-9a94fefcff8c",
                                                "text": "Dein Vorschlag ist für mich unannehmbar."
                                            },
                                            {
                                                "example_id": "df6ac9e7-08c3-4f4e-9c2f-71fec46df480",
                                                "sense_id": "1da76d8f-79ab-314d-97c6-9a94fefcff8c",
                                                "text": "Es kommen unannehmbare Forderungen auf uns zu."
                                            },
                                            {
                                                "example_id": "54600f43-7409-43a4-9189-5774d9778426",
                                                "sense_id": "1da76d8f-79ab-314d-97c6-9a94fefcff8c",
                                                "text": "„Tatsächlich war die Demarche von vornherein so formuliert, dass sie unannehmbar sein sollte.“"
                                            }
