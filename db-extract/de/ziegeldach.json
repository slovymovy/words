                "senses": [
                    {
                        "sense_id": "85af9325-9378-3109-9609-95586f604cda",
                        "entry_id": "475d6428-664d-30f2-bee3-6f492e4e4970",
                        "glosses": [
                            "mit Dachziegeln gedecktes Dach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "900aef13-d805-49bb-b76d-357ebae3bff4",
                                "sense_id": "85af9325-9378-3109-9609-95586f604cda",
                                "text": "„Die Feuerwehrleute öffneten das Ziegeldach vom Korb der Drehleiter aus, mit einem Reißhaken an einer langen Stange und löschten.“"
                            },
                            {
                                "example_id": "b0f0438a-b0fb-4e2a-aec2-2bdb3c61406e",
                                "sense_id": "85af9325-9378-3109-9609-95586f604cda",
                                "text": "„Alles in allem soll die Installation der Tesla-Dächer damit sogar günstiger werden als die eines regulären Ziegeldaches, wie Tesla-Vertreter auf einer Pressekonferenz mitteilten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
