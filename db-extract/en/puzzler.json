                "senses": [
                    {
                        "sense_id": "b12e3ff1-61f7-33c7-a74c-05fa48b249a7",
                        "entry_id": "41e3acfd-301b-3495-8791-d9c015b4436b",
                        "glosses": [
                            "A puzzling situation or problem; an enigma."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb33f2bb-e873-4cac-b7ff-a99b9e62b6e9",
                                "sense_id": "b12e3ff1-61f7-33c7-a74c-05fa48b249a7",
                                "text": "And reason cannot answer that question, because it exists outside of reason. It’s a puzzler, right? A real head-scratcher? Which brings us back to me."
                            }
                        ]
                    },
                    {
                        "sense_id": "81c775f9-0b9b-3a1a-ada1-7c4dd9f790a7",
                        "entry_id": "41e3acfd-301b-3495-8791-d9c015b4436b",
                        "glosses": [
                            "A video game in which the player is presented with (usually abstract) puzzles to solve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03c66d5c-64a8-4f08-93f6-864848df4b99",
                                "sense_id": "81c775f9-0b9b-3a1a-ada1-7c4dd9f790a7",
                                "text": "With the exception of certain handheld titles […], puzzlers (such as the countless Tetris iterations), and download-only games […], two-dimensional gaming has largely become a lost art, alienating many of us who grew up in a 2D virtual world."
                            }
                        ]
                    },
                    {
                        "sense_id": "36e60100-8f8a-322b-b99b-cfb7a5d1152c",
                        "entry_id": "41e3acfd-301b-3495-8791-d9c015b4436b",
                        "glosses": [
                            "A person who solves puzzles as a hobby."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfeb71a0-4814-4cbc-8df1-8eba3733c6e2",
                                "sense_id": "36e60100-8f8a-322b-b99b-cfb7a5d1152c",
                                "text": "[…] he commits what to a hardened puzzler seems an unforgivable sin when he uses a picture of a two-masted ship followed by HTER for the word BRIGHTER."
                            },
                            {
                                "example_id": "6af683c3-d5c4-4dc0-b710-0e68e3df1325",
                                "sense_id": "36e60100-8f8a-322b-b99b-cfb7a5d1152c",
                                "text": "Mentally stimulating leisure activities, such as doing crossword puzzles, seem to help keep the brain sharp. […] The puzzlers delayed the onset of accelerated memory loss (a sign of dementia) by an average of 2.54 years."
                            }
                        ]
                    }
                ],
