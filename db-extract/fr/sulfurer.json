                ],
                "senses": [
                    {
                        "sense_id": "07443f51-626e-3b78-9193-24b3b72c8760",
                        "entry_id": "3c3c3ec3-aaa4-3f5b-a9fb-ccf4e6b170d3",
                        "glosses": [
                            "Faire entrer du soufre en combinaison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e149d640-f8cf-4afa-b7b7-d8ea1f7e1d7d",
                                "sense_id": "07443f51-626e-3b78-9193-24b3b72c8760",
                                "text": "Afin d’éviter que la dissolution de sulfure… ne vienne sulfurer les métaux déposés"
                            }
                        ]
                    },
                    {
                        "sense_id": "24f27ecc-fc03-38ed-b965-3afcf1989bc0",
                        "entry_id": "3c3c3ec3-aaa4-3f5b-a9fb-ccf4e6b170d3",
                        "glosses": [
                            "Traiter avec du sulfure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dab7fb22-61d9-4ae5-8fec-69e84cc54d74",
                                "sense_id": "24f27ecc-fc03-38ed-b965-3afcf1989bc0",
                                "text": "Un autre au nord, attaqué toujours en même temps que moi, mais ayant commencé seulement à sulfurer cette année, récoltait 6 à 7000 hectolitres ; il a eu, contre toute prévision, 3,500 hectolitres."
                            },
                            {
                                "example_id": "22d6d141-ec6a-401b-84ab-f371b48caf1c",
                                "sense_id": "24f27ecc-fc03-38ed-b965-3afcf1989bc0",
                                "text": "M. le marquis de Dampierre objecte que malheureusement les Othellos sont trop sujets au phylloxera. Il a été obligé de sulfurer les siens."
                            }
                        ]
                    }
                ],
