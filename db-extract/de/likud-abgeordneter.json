                "senses": [
                    {
                        "sense_id": "727af088-e3e6-37ce-ab1a-6456b15b0b6d",
                        "entry_id": "bda13b66-927e-3a4a-bf6c-1654805ecbdc",
                        "glosses": [
                            "Abgeordneter, der Mitglied des Likud ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6acacefa-d136-4d51-b2e5-0800074a7d17",
                                "sense_id": "727af088-e3e6-37ce-ab1a-6456b15b0b6d",
                                "text": "„Es waren nicht nur die führenden Mitglieder der rechtsextremistischen ‹Nationalen Union› - Michael Ben Ari, Uri Ariel, Arye Eldad -, sondern auch die nationalreligiösen Likud-Abgeordneten Zeev Elkin und Tzipi Hotovely, die im März und im Juni 2011 das Thema auf die Tagesordnung des Innenausschusses der Knesset setzten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
