                "senses": [
                    {
                        "sense_id": "fbd0309d-db65-3071-9871-d98e7f3ade17",
                        "entry_id": "7a35550c-9ab7-34b0-afd5-9ec3f232acf7",
                        "glosses": [
                            "Strecke, die von der Post bedient wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b9b5d2-d1f4-4cbc-82d0-f56c77e33cba",
                                "sense_id": "fbd0309d-db65-3071-9871-d98e7f3ade17",
                                "text": "„Mit Edikt vom 14. April 1649 wird ein Postkurs eingerichtet, der von Kleve über Berlin, Danzig, die Frische Nehrung, Pillau, die Kurische Nehrung bis nach Memel führt, die sogenannte Reit- oder Dragonerpost.“"
                            },
                            {
                                "example_id": "f6f576af-5c50-482e-afdb-41c41126790d",
                                "sense_id": "fbd0309d-db65-3071-9871-d98e7f3ade17",
                                "text": "„Postkurse mit Personenbeförderung in Pferdekutschen gab es in Deutschland etwa ab den 1640er Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
