        "nl-extract.jsonl": [
            {
                "entry_id": "4a2acbce-ae5b-3cd0-965c-513d8ae22adc",
                "word": "blubberen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b15adb23-5b5e-334d-8f60-d8d0c27abbd8",
                        "entry_id": "4a2acbce-ae5b-3cd0-965c-513d8ae22adc",
                        "glosses": [
                            "een onregelmatig, vaag pruttelend geluid voortbrengen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "c13752f7-f7cc-4c59-98b2-d43914e4ee03",
                                "sense_id": "b15adb23-5b5e-334d-8f60-d8d0c27abbd8",
                                "text": "Bij LA Priest kan een gitaar klinken als vervormd hanengekraai, en kan een keyboard ergerlijk blubberen."
                            },
                            {
                                "example_id": "641cd44d-6e35-410d-b715-8df374335cfe",
                                "sense_id": "b15adb23-5b5e-334d-8f60-d8d0c27abbd8",
                                "text": "Boven het blubberen van het moeras uit klonk het geluid van een trommel en uit de nevels kwamen een paar figuren te voorschijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "b22c9d91-096a-3a39-aac8-9a1477253482",
                        "entry_id": "4a2acbce-ae5b-3cd0-965c-513d8ae22adc",
                        "glosses": [
                            "zich als weke substantie onregelmatig verplaatsen"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "a9b28ebc-28c6-4db2-81d9-f2b943c1b0bb",
                                "sense_id": "b22c9d91-096a-3a39-aac8-9a1477253482",
                                "text": "En daarom springt de Mariken van de film midden op de tafel, tilt haar rokken omhoog en voert een eierdans uit, die de bedoelde geiligheid oplevert in een bad van blubberend struif als exponent van ongeremd middeleeuws leven."
                            },
                            {
                                "example_id": "beb9f789-61ec-4a77-917c-b494fde18a16",
                                "sense_id": "b22c9d91-096a-3a39-aac8-9a1477253482",
                                "text": "De man die praat heeft een rood en opgeblazen gezicht. Bij elke klank die uit zijn dikke keel komt blubberen zijn lippen naar voren."
                            }
                        ]
                    },
                    {
                        "sense_id": "085d2a43-e7eb-301b-88fe-3dd8de55cbbf",
                        "entry_id": "4a2acbce-ae5b-3cd0-965c-513d8ae22adc",
                        "glosses": [
                            "zich moeizaam door modder of een vergelijkbare substantie bewegen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "115aa8e3-609b-4f61-a15d-837c15a40fe1",
                                "sense_id": "085d2a43-e7eb-301b-88fe-3dd8de55cbbf",
                                "text": "Veel laadpalen kom je niet tegen als je gaat stofhappen in de woestijn van Utah, blubberen door de Schotse hooglanden of bergbeklimmen in de Alpen."
                            }
                        ]
                    },
                    {
                        "sense_id": "74c70736-99e5-378f-a4db-b19bad3fc60f",
                        "entry_id": "4a2acbce-ae5b-3cd0-965c-513d8ae22adc",
                        "glosses": [
                            "onhandig of niet erg doelgericht bezig zijn"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "22c6c397-a6e7-4232-97d3-70be9ea6c088",
                                "sense_id": "74c70736-99e5-378f-a4db-b19bad3fc60f",
                                "text": "Hohoho! roepen de andere gedachten meteen. Wat denk je me daar! Zo gaat dat niet! Ze zijn vast dom, maar met een mengeling van onderwijs, beschaving, respect – de gedachten blubberen nog een poosje braaf verder."
                            }
                        ]
                    }
                ],
