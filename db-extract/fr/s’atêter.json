                                        "sense_id": "78ce2b75-9030-387c-97b4-7779b8029fee",
                                        "entry_id": "3f4f1537-2d2f-3d54-b060-a5dd83265dec",
                                        "glosses": [
                                            "An active episode of a chronic or recurrent disease."
                                        ],
                                        "tags": [],
