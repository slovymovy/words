    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "04ba36ab-8d74-38e5-9f68-3d7fe50bb630",
                "word": "bothy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "211c3251-c8ae-40a2-88a7-acb6af6d5b8e",
                        "entry_id": "04ba36ab-8d74-38e5-9f68-3d7fe50bb630",
                        "tags": [
                            "plural"
                        ],
                        "form": "bothies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3cc10da-1d2a-366e-a54a-3d58f0fa54e8",
                        "entry_id": "04ba36ab-8d74-38e5-9f68-3d7fe50bb630",
                        "glosses": [
                            "A small cottage, especially one for communal use in remote areas by labourers or farmhands, or as a mountain shelter."
                        ],
                        "tags": [
                            "Ireland",
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "db3820f0-6a23-47bc-be56-fd6195eed7fb",
                                "sense_id": "a3cc10da-1d2a-366e-a54a-3d58f0fa54e8",
                                "text": "But civilization had changed that completely. Not one criminal in a thousand now fled to the Highlands or to Wales for refuge. A man demanded the means of food and shelter in his retreat nowadays, and a deserted bothy or a cave on the hillside was out of date."
                            },
                            {
                                "example_id": "5740057e-3e72-46db-ba74-1c8bf79ec4ce",
                                "sense_id": "a3cc10da-1d2a-366e-a54a-3d58f0fa54e8",
                                "text": "Often Neil sat in their bothy on winter nights and told Calum about seas he had never seen."
                            },
                            {
                                "example_id": "ec3d61b8-60c4-401c-a5ac-2affa7439cf7",
                                "sense_id": "a3cc10da-1d2a-366e-a54a-3d58f0fa54e8",
                                "text": "Then, in the evening of the second day after I had climbed from the pupil of the right eye, I came upon a shepherd's bothy, a sort of beehive of stone, and found in it a cooking pot and a quantity of ground corn."
                            },
                            {
                                "example_id": "606f4553-cf7e-4939-b734-5abe62699e78",
                                "sense_id": "a3cc10da-1d2a-366e-a54a-3d58f0fa54e8",
                                "text": "The Bog Creeper came out her wee bothy so I stood on the toilet seat and Lanna whipped her skirt down to her boots and sat."
                            },
                            {
                                "example_id": "ab412e3f-4bca-4a6a-8aac-af2b06ea81d0",
                                "sense_id": "a3cc10da-1d2a-366e-a54a-3d58f0fa54e8",
                                "text": "It was easy then to meet with a man\nshifting himself to a safer distance\nto bed in the bothies[.]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6dbe1cf-67be-4b2a-8a06-543006172535",
                        "source_entry_id": "04ba36ab-8d74-38e5-9f68-3d7fe50bb630",
