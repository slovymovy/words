                ],
                "senses": [
                    {
                        "sense_id": "6388a545-bba8-33d5-af4a-0e7ec4989b03",
                        "entry_id": "be13f286-852f-3db9-989c-fc19b94459aa",
                        "glosses": [
                            "Endroit d’un tableau sur lequel un restaurateur applique une nouvelle composition en ajoutant de nouveaux éléments ou de nouvelles couleurs, à la différence de la retouche dans laquelle le restaurateur ou le peintre original ne corrige que quelques détails."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79b3e6ce-a04b-4fc9-bb66-0a1a1b317b93",
                                "sense_id": "6388a545-bba8-33d5-af4a-0e7ec4989b03",
                                "text": "On distingue le repeint de pudeur du repeint de style et du repeint technique."
                            },
                            {
                                "example_id": "74b128ed-627b-470e-b830-5fe24a9a826e",
                                "sense_id": "6388a545-bba8-33d5-af4a-0e7ec4989b03",
                                "text": "Le prix des soixante tableaux qui composaient cette divine collection, chefs-d’œuvre purs, sans un repeint, authentiques, ne pouvait être connu qu’à la chaleur des enchères."
                            },
                            {
                                "example_id": "1e213fee-f552-4b61-9154-8f1679cd6474",
                                "sense_id": "6388a545-bba8-33d5-af4a-0e7ec4989b03",
                                "text": "Les vieux portraits sans grande valeur artistique, produits de peintres anonymes, sont tous authentiques, sans repeints et sans blasons ajoutés."
                            }
                        ]
                    }
                ],
