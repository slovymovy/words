                                "target_senses": [
                                    {
                                        "sense_id": "56d9140e-26b6-3c42-b28e-50f7d8e9856d",
                                        "entry_id": "17a0b9f9-fd2f-369a-85f4-fac5b520fc1f",
                                        "glosses": [
                                            "The principles of aristocrats."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a6694b2-5322-49ca-885b-49043ef19ce0",
                                                "sense_id": "56d9140e-26b6-3c42-b28e-50f7d8e9856d",
                                                "text": "His whole family, you know, are accused of being aristocrats, though their only aristocratism consists in wishing to defend a constitution which all France has sworn to maintain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cebc779f-b3f0-3605-82a6-78ee08ee5f7c",
