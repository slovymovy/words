                        "glosses": [
                            "auf eine Organisation bezogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6117973d-00fe-45e8-af59-7c8c7433fb35",
                                "sense_id": "78464506-aa9c-3943-9d79-7d94863a152c",
                                "text": "„Die Idee der organisationalen Bildung ist neu und impliziert, dass das organisationale Lernen selbst gelernt werden muss.“"
                            },
                            {
                                "example_id": "9009edde-ca49-4b01-8ba2-114ddc402e9f",
                                "sense_id": "78464506-aa9c-3943-9d79-7d94863a152c",
                                "text": "„Es gilt mittlerweile als gesichert, dass Unternehmen die organisationale Sozialisation neuer Mitarbeiter mit spezifischen Maßnahmen beeinflussen können (Hsiung & Hsieh, 2003)“."
                            }
