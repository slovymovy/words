                                            {
                                                "example_id": "5a3d04e4-f820-4c07-81ef-9dc35db36e8a",
                                                "sense_id": "4224461e-1eca-31db-a7d5-2dc508be9f3e",
                                                "text": "Dès la fin du Xᵉ siècle, arrive à Tolède un sabéen originaire de Bagdad, Al-Harrani, qui crée aussitôt une école de médecine."
                                            }
                                        ]
                                    }
                                ]
                            },
