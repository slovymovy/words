                                        "entry_id": "5016303a-9e2d-3c36-9bf0-92b853b24ad9",
                                        "glosses": [
                                            "ein Korb zum Fischfang aus Korbgeflecht, Netzgeflecht, Drahtgeflecht oder Kunststoff"
                                        ],
                                        "tags": [],
