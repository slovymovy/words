                    {
                        "translation_id": "935a0d0a-0219-49ad-958f-f4c6ff110c08",
                        "source_entry_id": "98e82ee8-e431-38e6-8c83-d4e40fad36a7",
                        "source_sense_id": "42e33e9f-ea1c-3ca4-b4e5-19e595a7d17e",
                        "source_sense_description": "gleicher Rang, gleiche Verhandlungsposition",
                        "target_lang_word": "égal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "égal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15897011-9321-3649-b79c-af5f71c6c92b",
                                        "entry_id": "1170d249-9892-36c0-8167-0970534a4573",
                                        "glosses": [
                                            "Qui est semblable, soit en nature, soit en quantité, soit en qualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e640e7f6-e2bc-4d3e-9002-374a6f5947d4",
                                                "sense_id": "15897011-9321-3649-b79c-af5f71c6c92b",
                                                "text": "Deux lignes égales. — Deux poids égaux."
                                            },
                                            {
                                                "example_id": "1a71dd38-2f28-432e-af79-2f283825400d",
                                                "sense_id": "15897011-9321-3649-b79c-af5f71c6c92b",
                                                "text": "Les deux chevaliers s'étant donc accordés avec un égal plaisir à se reconnaître frères d'armes, ils se séparèrent pour ce moment, après mille protestations d’amitié."
                                            },
                                            {
                                                "example_id": "53446acc-79fe-4fd6-842f-dbc1729a9cb8",
                                                "sense_id": "15897011-9321-3649-b79c-af5f71c6c92b",
                                                "text": "Comme Orwell dirait : « Tous les citoyens sont égaux, mais certains sont plus égaux que d’autres. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69c72ed7-c035-3832-8050-8104acd299ac",
                                        "entry_id": "1170d249-9892-36c0-8167-0970534a4573",
                                        "glosses": [
                                            "Qui est semblable, soit en nature, soit en quantité, soit en qualité.",
                                            "En parlant des personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c270f2a-dfb4-4c62-9801-958e9370161e",
                                                "sense_id": "69c72ed7-c035-3832-8050-8104acd299ac",
                                                "text": "La Perse n’a point de caste. Tous sont égaux chez elle au point de vue religieux."
                                            },
                                            {
                                                "example_id": "ee30d9ad-5ab8-4af2-9fdf-f3126dad1fe6",
                                                "sense_id": "69c72ed7-c035-3832-8050-8104acd299ac",
                                                "text": "Fallait-il vivre inégaux et dissemblables, comme l’église le donnait à penser ? Ou bien égaux et semblables, égaux parce que semblables, comme l’enseignait l’école ? Ou encore égaux et dissemblables, égaux pour faire valoir nos dissemblances, comme le professait la maison ? Un écheveau de perplexités que je ne suis toujours pas sûre de débrouiller aujourd’hui."
                                            },
                                            {
                                                "example_id": "a28f6ec6-2b25-499c-bac9-1cd98580bc6b",
                                                "sense_id": "69c72ed7-c035-3832-8050-8104acd299ac",
                                                "text": "Tous les hommes naissent libres et égaux du point de vue de leur dignité et de leurs droits."
                                            },
                                            {
                                                "example_id": "6f81e8de-211c-4a54-8716-61053adeeee5",
                                                "sense_id": "69c72ed7-c035-3832-8050-8104acd299ac",
                                                "text": "Cela est bon entre égaux."
                                            },
                                            {
                                                "example_id": "2b910479-445c-4423-8c94-47d12624c691",
                                                "sense_id": "69c72ed7-c035-3832-8050-8104acd299ac",
                                                "text": "Traiter d’égal à égal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92f97dff-a565-3e9b-8d2c-6e021f0eb7ee",
                                        "entry_id": "1170d249-9892-36c0-8167-0970534a4573",
                                        "glosses": [
                                            "Absolument identique, exactement le même. — Note d’usage : L’adjectif “égal” peut être suivi de la préposition “à” et d’une certaine façon de désigner cet objet égal, le même objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2506aad-b724-451d-b76e-ea45286cd181",
                                                "sense_id": "92f97dff-a565-3e9b-8d2c-6e021f0eb7ee",
                                                "text": "Deux fois cinq est (égal à) dix, deux fois trois et demi est égal à sept."
                                            },
                                            {
                                                "example_id": "d7082f03-24e5-479f-963c-257f14383717",
                                                "sense_id": "92f97dff-a565-3e9b-8d2c-6e021f0eb7ee",
                                                "text": "En géométrie, deux points égaux sont confondus en un seul et même point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6c7e299-7b39-3d4d-8798-f65df202e967",
                                        "entry_id": "1170d249-9892-36c0-8167-0970534a4573",
                                        "glosses": [
                                            "Toujours le même, invariant, constant, uniforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f84ff0-ce25-4b3f-93e2-da0c7bf919ce",
                                                "sense_id": "f6c7e299-7b39-3d4d-8798-f65df202e967",
                                                "text": "Un mouvement toujours égal."
                                            },
                                            {
                                                "example_id": "769c9542-b787-48f3-bff6-b52a7e90b17e",
                                                "sense_id": "f6c7e299-7b39-3d4d-8798-f65df202e967",
                                                "text": "Son pouls est très égal."
                                            },
                                            {
                                                "example_id": "57530dea-a932-4066-b0a8-5788c61b67e4",
                                                "sense_id": "f6c7e299-7b39-3d4d-8798-f65df202e967",
                                                "text": "Il a toujours marché d’un pas égal."
                                            },
                                            {
                                                "example_id": "3a84e003-a237-46e0-93a4-88b8b03a6f41",
                                                "sense_id": "f6c7e299-7b39-3d4d-8798-f65df202e967",
                                                "text": "Pendant des semaines, Camille se montrait d’un caractère égal, attentif à prévenir les désirs de Graux et à lui éviter la moindre contrariété."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a865445e-4e31-3255-8705-ae0a1ab1226d",
                                        "entry_id": "1170d249-9892-36c0-8167-0970534a4573",
                                        "glosses": [
                                            "ou Qui n’est pas raboteux, qui est de niveau."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "literary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "203f928f-27e9-453e-a752-d6ea0ac8d854",
                                                "sense_id": "a865445e-4e31-3255-8705-ae0a1ab1226d",
                                                "text": "Une aire bien égale."
                                            },
                                            {
                                                "example_id": "9bf3662f-181e-41ef-800e-7679d5e45ad9",
                                                "sense_id": "a865445e-4e31-3255-8705-ae0a1ab1226d",
                                                "text": "Un chemin bien égal."
                                            },
                                            {
                                                "example_id": "cd61e2e7-d909-4b47-9b43-9abde385fbc8",
                                                "sense_id": "a865445e-4e31-3255-8705-ae0a1ab1226d",
                                                "text": "Une allée bien égale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77bc4383-8cb9-3708-932d-ff82e48d9d08",
                                        "entry_id": "1170d249-9892-36c0-8167-0970534a4573",
                                        "glosses": [
                                            "(Le sujet est le plus souvent un indéfini ou impersonnel) Indifférent, sans importance."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d61cd99-40ef-496e-a0e1-21baba682f61",
                                                "sense_id": "77bc4383-8cb9-3708-932d-ff82e48d9d08",
                                                "text": "Tout lui est égal."
                                            },
                                            {
                                                "example_id": "9e23beff-88ed-4571-b705-88b7ca3baf3f",
                                                "sense_id": "77bc4383-8cb9-3708-932d-ff82e48d9d08",
                                                "text": "Qu’on l’approuve, qu’on le blâme, tout lui est égal."
                                            },
                                            {
                                                "example_id": "48cf6415-bfce-4450-b43d-428b3cfd8908",
                                                "sense_id": "77bc4383-8cb9-3708-932d-ff82e48d9d08",
                                                "text": "Cela m’est égal. Des deux choses en question, des deux partis proposés, on n’aime pas plus l’un que l’autre."
                                            },
                                            {
                                                "example_id": "5ab49054-ced4-4bec-bb15-78b71a4979cc",
                                                "sense_id": "77bc4383-8cb9-3708-932d-ff82e48d9d08",
                                                "text": "Qu’il reste ou qu’il s’en aille, cela m’est égal, m’est parfaitement égal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "égal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2da8c3b0-a858-3c97-a9fc-a5a60007a51d",
                                        "entry_id": "891684f1-2279-3216-8e4c-d17bb0272910",
                                        "glosses": [
                                            "Celui qui est de même rang, de même nature, de même qualité qu’un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f08d7d16-a003-4a63-b6c8-ebf980fe6fbf",
                                                "sense_id": "2da8c3b0-a858-3c97-a9fc-a5a60007a51d",
                                                "text": "Le trisaïeul de son trisaïeul était l’égal, le compagnon, le pair du roi ; à ce titre il est lui-même d’une classe privilégiée, celle des gentilshommes ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b43e0dbc-3b08-4dd0-9158-4e83f3a2f1e5",
                        "source_entry_id": "98e82ee8-e431-38e6-8c83-d4e40fad36a7",
                        "source_sense_id": "42e33e9f-ea1c-3ca4-b4e5-19e595a7d17e",
                        "source_sense_description": "gleicher Rang, gleiche Verhandlungsposition",
                        "target_lang_word": "niveau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niveau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c350960-6cca-3ffb-8139-276e7550b251",
                                        "entry_id": "1d51a707-6273-33e8-b332-671da24413ca",
                                        "glosses": [
                                            "Outil servant à vérifier l’horizontalité d’une surface, d’un sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b650ed1-8810-437f-ba9e-7f2e18c9157c",
                                                "sense_id": "2c350960-6cca-3ffb-8139-276e7550b251",
                                                "text": "Les outils de tracé et de contrôle sont l’équerre, la règle, la fausse équerre dite sauterelle, le biveau, le panneau ou gabarit, le compas, le fil à plomb et le niveau. Ces outils se retrouvent dessinés ou gravés sur de nombreux documents ou monumets de l'Antiquité à nos jours."
                                            },
                                            {
                                                "example_id": "224ef9d7-bc29-4182-8eb3-7edcb52666d0",
                                                "sense_id": "2c350960-6cca-3ffb-8139-276e7550b251",
                                                "text": "L’abbé Picard, avec le niveau à lunette qu’il avait inventé et dont la longue-vue horizontale à fort grossissement permettait des repères à grande distance, prouva que Riquet se trompait de trente-quatre mètres (un rien!)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "988db90a-0c4c-37e1-8934-ce9c2361124f",
                                        "entry_id": "1d51a707-6273-33e8-b332-671da24413ca",
                                        "glosses": [
                                            "Degré d’élévation par rapport à un plan horizontal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953f3eae-6b11-475b-a87d-24b424dacbb6",
                                                "sense_id": "988db90a-0c4c-37e1-8934-ce9c2361124f",
                                                "text": "…mais l'eau, à l'intérieur, avait déjà atteint le niveau du plancher, et il me fallut plusieurs heures de travail aux pompes pour l'épuiser."
                                            },
                                            {
                                                "example_id": "72338040-6530-473d-9aa5-8b3efd3c9ab7",
                                                "sense_id": "988db90a-0c4c-37e1-8934-ce9c2361124f",
                                                "text": "Le niveau du fleuve a monté."
                                            },
                                            {
                                                "example_id": "cb7cef4e-0089-44b0-a8bd-58ae69339502",
                                                "sense_id": "988db90a-0c4c-37e1-8934-ce9c2361124f",
                                                "text": "Altitude au-dessus du niveau de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4bbe49c-6c2a-305c-8593-c7b0e6d71fa7",
                                        "entry_id": "1d51a707-6273-33e8-b332-671da24413ca",
                                        "glosses": [
                                            "Degré de remplissage d'un réservoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "518d59c1-29b5-4d01-9605-2fdaa2f7bf47",
                                                "sense_id": "e4bbe49c-6c2a-305c-8593-c7b0e6d71fa7",
                                                "text": "[…] nous avons toujours quelque chose à faire […]. Les niveaux d'essence, le compte-tours, le thermomètre intérieur, le compteur de vitesse et le spiro-bloc d'huile à inspecter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a20c7025-4783-3381-a159-374a742da68a",
                                        "entry_id": "1d51a707-6273-33e8-b332-671da24413ca",
                                        "glosses": [
                                            "Degré d'évolution."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d0666b0-52ef-4f48-94d8-36ac3f9789a7",
                                                "sense_id": "a20c7025-4783-3381-a159-374a742da68a",
                                                "text": "[…]; elle estime, comme G. de Molinari, que le progrès moral du prolétariat est aussi nécessaire que le progrès matériel de l'outillage, pour porter l'industrie moderne au niveau toujours plus élevé que la science technologique permet d'atteindre; […]."
                                            },
                                            {
                                                "example_id": "ce169337-ccf9-4312-bfe3-3d918fc7e9ba",
                                                "sense_id": "a20c7025-4783-3381-a159-374a742da68a",
                                                "text": "Des palpations rectales régulières ont été effectuées pour estimer le niveau de développement des organes génitaux des velles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3ecaf6b-fde2-3042-a997-420fa5a4b681",
                                        "entry_id": "1d51a707-6273-33e8-b332-671da24413ca",
                                        "glosses": [
                                            "Degré de compétence ou de capacité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3549378d-16b6-4e95-be35-a8964af3f477",
                                                "sense_id": "f3ecaf6b-fde2-3042-a997-420fa5a4b681",
                                                "text": "L’éducation moyenne atteignait un niveau extraordinaire, et, à l’aube du XXᵉ siècle, on trouvait relativement peu de gens, dans l’Europe occidentale, qui ne sussent lire et écrire."
                                            },
                                            {
                                                "example_id": "f5bf3f52-9734-466e-a454-4476900d8179",
                                                "sense_id": "f3ecaf6b-fde2-3042-a997-420fa5a4b681",
                                                "text": "On étudiera également les possibilités d’épelation du malade pour des mots en rapport avec son niveau scolaire."
                                            },
                                            {
                                                "example_id": "a456f72e-306e-46c9-8096-52fd71839fde",
                                                "sense_id": "f3ecaf6b-fde2-3042-a997-420fa5a4b681",
                                                "text": "Une variante particulière du gène DCP, qui code pour l’enzyme de conversion de l’angiotensine, peut faire la différence entre quelqu’un qui peinerait à l’effort physique et un athlète de haut niveau dans des sports d’endurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "745acd36-a889-3d8c-850f-ff3a9f56cd8c",
                                        "entry_id": "1d51a707-6273-33e8-b332-671da24413ca",
                                        "glosses": [
                                            "Étage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90441eed-12a9-4f68-8f25-65bddd6f741b",
                                                "sense_id": "745acd36-a889-3d8c-850f-ff3a9f56cd8c",
                                                "text": "Howard jette un coup d'œil aux profondeurs insondables des niveaux inférieurs par-dessus la rambarde et aperçoit un méli-mélo de robes cerise, de corps au bronzage artificiel et de chaussures de strip-teaseuse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0130d0c8-8c1e-3304-9962-611e0b529b00",
                                        "entry_id": "1d51a707-6273-33e8-b332-671da24413ca",
                                        "glosses": [
                                            "Étape d’un jeu vidéo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b684cbdc-9166-403a-8f81-59524c3838c4",
                                                "sense_id": "0130d0c8-8c1e-3304-9962-611e0b529b00",
                                                "text": "Le troisième niveau du jeu est très complexe."
                                            },
                                            {
                                                "example_id": "48349907-7111-4fa6-bb20-f152175611d8",
                                                "sense_id": "0130d0c8-8c1e-3304-9962-611e0b529b00",
                                                "text": "Dans les jeux vidéo tirés de film, c’est toujours la même chose. Les développeurs choisissent une scène du film qui ne dure pas très longtemps, et après, ils en font un niveau entier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7929d33c-9a4c-3475-8f53-3f495ae7d936",
                                        "entry_id": "1d51a707-6273-33e8-b332-671da24413ca",
                                        "glosses": [
                                            "Niveau d’énergie."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "niveau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "180acbed-8f2d-38c3-9e2c-38cd60bf91db",
                                        "entry_id": "2d33ab11-3476-33ac-9875-8dac4a8b5095",
                                        "glosses": [
                                            "En ce qui concerne ; quant à."
                                        ],
