                            },
                            {
                                "target_lang_word": "завивка",
                                "target_lang_sense_clarification": "процесс или результат"
                            },
                            {
                                "target_lang_word": "химия",
                                "target_lang_sense_clarification": "разговорное название процедуры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0f3d2bb-0ce5-37b7-8c7c-016b3c74f7cf",
                    "sense_definition": "In card games, a card whose effects persist on the table beyond the turn it is played.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to manage your <w>permanents</w> carefully to maintain control of the board.",
                            "target_lang_translations": {
                                "ru": "Вам нужно осторожно распоряжаться своими <w>перманентами</w>, чтобы сохранять контроль над игровым полем."
                            }
                        },
                        {
                            "text": "The opponent played a powerful <w>permanent</w> that prevented me from attacking.",
                            "target_lang_translations": {
                                "ru": "Оппонент разыграл мощный <w>перманент</w>, который помешал мне атаковать."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В карточных играх: карта, эффект которой сохраняется на столе после завершения хода, в котором она была разыграна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перманент",
                                "target_lang_sense_clarification": "игровой термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1817159-3d96-3768-bbf4-b30b0c463b5e",
                    "sense_definition": "A function of a square matrix similar to the determinant but without using signs for permutations.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Calculating the <w>permanent</w> of a large matrix is computationally much harder than finding its determinant.",
                            "target_lang_translations": {
                                "ru": "Вычисление <w>перманента</w> большой матрицы вычислительно намного сложнее, чем нахождение её определителя."
                            }
                        },
                        {
                            "text": "The <w>permanent</w> is used in combinatorics to count perfect matchings in bipartite graphs.",
                            "target_lang_translations": {
                                "ru": "<w>Перманент</w> используется в комбинаторике для подсчета совершенных паросочетаний в двудольных графах."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Функция квадратной матрицы, аналогичная определителю, но без учета знаков перестановок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перманент",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df24c4c2-af77-370d-8386-c394e03e8687",
                    "sense_definition": "To treat hair with chemicals to produce long-lasting curls or waves.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hair_treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stylist spent two hours <w>permanenting</w> her hair for the wedding.",
                            "target_lang_translations": {
                                "ru": "Стилист потратил два часа, <w>завивая</w> её волосы для свадьбы."
                            }
                        },
                        {
                            "text": "She regretted <w>permanenting</w> her hair because the curls were too tight.",
                            "target_lang_translations": {
                                "ru": "Она пожалела, что <w>сделала перманент</w>, потому что кудри получились слишком тугими."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "the verb 'perm' is much more common"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрабатывать волосы химическими веществами для создания долговременных локонов или волн."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать перманент",
                                "target_lang_sense_clarification": "проводить процедуру"
                            },
                            {
                                "target_lang_word": "завивать",
                                "target_lang_sense_clarification": "делать химическую завивку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
