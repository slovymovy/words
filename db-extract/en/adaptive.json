                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adaptatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7ad3983-1b18-3f32-aa6d-ef00c65d3982",
                                        "entry_id": "be521cce-a416-33b9-a69a-e97421806886",
                                        "glosses": [
                                            "Qui s’adapte facilement, capable d’évoluer, de s’adapter ou de se modifier en conséquence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27ef401f-4b5c-4dfd-9643-d7a2e877a7dc",
                                                "sense_id": "a7ad3983-1b18-3f32-aa6d-ef00c65d3982",
                                                "text": "Un comportement adaptatif aux changements de l’environnement."
                                            },
                                            {
                                                "example_id": "143b46d4-5fca-4e27-80cf-f914086a5d6b",
                                                "sense_id": "a7ad3983-1b18-3f32-aa6d-ef00c65d3982",
                                                "text": "Pour être adaptatif, il faut posséder les qualités suivantes : créativité, intelligence, vigueur, résilience, endurance, réactivité, souplesse et agilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b4117fe-14f0-37a3-aecc-636a6c87cc0c",
                                        "entry_id": "be521cce-a416-33b9-a69a-e97421806886",
                                        "glosses": [
                                            "Qui produit ou facilite une adaptation. Se dit d’un caractère morphologique, anatomique ou physiologique permettant à un organisme de s’adapter à des conditions de vie déterminées. Se dit de tout ce qui contribue à l’adaptation d’un organisme dans un milieu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8b10205-c460-4e74-9b46-42e0b02d81d5",
                                                "sense_id": "7b4117fe-14f0-37a3-aecc-636a6c87cc0c",
                                                "text": "(Apostille attachée à la traduction de Kurt Heininger, Aging is a deprivation syndrome driven by a germ-soma conflict, Ageing Research Reviews, 1(3), 481-536, juin 2002) Faute d’adjectif en français pour désigner ce qui est relatif à une adaptation, j’utiliserai le mot « adaptif » à partir de l’anglais « adaptive », car l’adjectif « adaptatif » signifie qui produit ou qui facilite une adaptation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a08855d3-b656-3e02-928a-2e843a1c15f8",
                                        "entry_id": "be521cce-a416-33b9-a69a-e97421806886",
                                        "glosses": [
                                            "Qualifie un système dont les sorties sont fonctions de l’historique des entrées."
                                        ],
                                        "tags": [
                                            "Gestion",
                                            "Intelligence artificielle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b84795cb-fc63-4cc2-839e-e6f922a6b4c1",
                                                "sense_id": "a08855d3-b656-3e02-928a-2e843a1c15f8",
                                                "text": "Les suspensions adaptatives réagissent aux signaux des transducteurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
