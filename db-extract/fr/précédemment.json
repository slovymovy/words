                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9828f9a6-b713-3a07-9521-10a512a6923a",
                                        "entry_id": "d5392ef4-c871-3333-b664-fd35862b5c55",
                                        "glosses": [
                                            "некоторое время назад, в прошлом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18da120f-fef3-4111-a5f8-fd8e1b943ebf",
                                                "sense_id": "9828f9a6-b713-3a07-9521-10a512a6923a",
                                                "text": "Он служил прежде в одном из кавалерийских полков и был один из числа значительных и видных офицеров."
                                            },
                                            {
                                                "example_id": "1cbfcc92-2c08-4c8f-bbe6-b93c7df058df",
                                                "sense_id": "9828f9a6-b713-3a07-9521-10a512a6923a",
                                                "text": "И прежде, и после я был в жестоких битвах, провождал ночи стоя, приклонясь к седлу лошади и рука на поводьях…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c3d22f5-7feb-3e44-a17c-69d2fcff4b2d",
                                        "entry_id": "d5392ef4-c871-3333-b664-fd35862b5c55",
                                        "glosses": [
                                            "сперва, сначала"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc2aec4a-c1b6-4f59-b80c-59361df8bf02",
                                                "sense_id": "5c3d22f5-7feb-3e44-a17c-69d2fcff4b2d",
                                                "text": "Сообразив, куда прежде, куда после ехать, чтобы не возвращаться, Нехлюдов прежде всего направился в сенат."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "прежде",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "435614c5-7557-3b2a-b364-940a4908117c",
                                        "entry_id": "696408b3-67e0-3ebb-a315-b0c486ad915e",
                                        "glosses": [
                                            "(указывает последовательность во времени) перед, до"
                                        ],
