                                "target_lang_word": "人类",
                                "target_lang_sense_clarification": "指人或人类个体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1784d8d-5560-36fc-b1c7-ec02dc2b2d32",
                    "sense_definition": "Highest occupied molecular orbital.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The energy gap between the <w>HOMO</w> and LUMO dictates the molecule's chemical reactivity.",
                            "target_lang_translations": {
                                "zh": "<w>最高占据分子轨道</w>与最低未占分子轨道之间的能隙决定了该分子的化学反应活性。"
                            }
                        },
                        {
                            "text": "Calculations showed electron density concentrated primarily within the <w>HOMO</w> of the compound.",
                            "target_lang_translations": {
                                "zh": "计算表明电子密度主要集中在该化合物的<w>最高占据分子轨道</w>中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "HOMO LUMO gap"
                    ],
                    "target_lang_definitions": {
                        "zh": "最高占据分子轨道（Highest Occupied Molecular Orbital的缩写）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "最高占据分子轨道",
                                "target_lang_sense_clarification": "量子化学术语"
                            },
                            {
                                "target_lang_word": "HOMO",
                                "target_lang_sense_clarification": "专业领域通用英文缩写"
                            }
                        ]
                    }
                }
