                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dedaac31-70cb-497e-9fba-5282206181e0",
                                "sense_id": "7805e010-3f12-3ad6-9d23-50f870a337f9",
                                "text": "Bref, inutile de torticuler du fion pour chier droit .."
                            },
                            {
                                "example_id": "13ec19f6-828e-4a61-bae6-238f55a49a34",
                                "sense_id": "7805e010-3f12-3ad6-9d23-50f870a337f9",
                                "text": "Ces folksingers osaient les chansons de cette poésie rebelle qui se bat sans mégoter ni barguigner, ni torticuler pour faire le top du hit dans le show avec des artifices discutables."
                            },
                            {
                                "example_id": "f98bfb01-3ba5-4d3a-98c6-cc65451b9959",
                                "sense_id": "7805e010-3f12-3ad6-9d23-50f870a337f9",
                                "text": "Et l’haleine des cerises fait s’envoler les brins d’herbe\nqui se torticulent, tangiversent d’un bloc\net ouvrent leurs paupières\nIls entament alors une synesphonie pastorale:"
                            }
                        ]
