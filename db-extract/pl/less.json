                                        "entry_id": "c4c479dd-9650-3617-bfac-e83e0842ef30",
                                        "glosses": [
                                            "Any sediment, dominated by silt, of eolian (wind-blown) origin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d29cdbe6-c31b-44dc-93d5-ca7a63206cbd",
                                                "sense_id": "f8aa100c-910e-35f4-a78c-284793e1fcf1",
                                                "text": "The Yellow River got its name from the massive amount of fertile loess (yellow earth) which it has deposited in the wheat-growing North China Plain."
                                            },
                                            {
                                                "example_id": "ba3f4c38-ea07-4eb1-ad76-e05edf652a8d",
                                                "sense_id": "f8aa100c-910e-35f4-a78c-284793e1fcf1",
                                                "text": "They blast their sand westwards across the steppe, coating the foothills of the Brooks Range in an icing-sugar dust of the loose, windblown sand-silt mixture known as loess."
                                            }
                                        ]
                                    }
                                ]
                            }
