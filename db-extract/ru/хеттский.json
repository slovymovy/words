                        "translation_id": "75f7559d-9004-480d-8cbf-9f4e14c94074",
                        "source_entry_id": "1e5c783c-c4ee-31f9-8e0c-93f413644165",
                        "source_sense_id": "b3477faa-3f34-3c12-9191-bdfad4ea868b",
                        "target_lang_word": "hethitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hethitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d990dd2d-3295-36f6-b548-82d2dfee6409",
                                        "entry_id": "8801c539-d42b-39b9-8412-8f82121edf23",
                                        "glosses": [
                                            "die Hethiter oder ihre Kultur betreffend, zu den Hethitern gehörend, von ihnen stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90c57cb7-4909-4b5a-9248-54ba9eb31311",
                                                "sense_id": "d990dd2d-3295-36f6-b548-82d2dfee6409",
                                                "text": "„Der hethitische Großkönig übrigens überwand sein Misstrauen und schickte den Prinzen Zananza nach Ägypten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68aab881-ff52-35be-aa75-465fe0b48ae1",
                                        "entry_id": "8801c539-d42b-39b9-8412-8f82121edf23",
                                        "glosses": [
                                            "die Sprache der Hethiter (Hethitisch) betreffend, in ihr geschrieben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b55f27-3bef-47be-bf7c-e7525932c372",
                                                "sense_id": "68aab881-ff52-35be-aa75-465fe0b48ae1",
                                                "text": "„Nur in geringer Anzahl wurden hethitische Schriftstücke in anderen Siedlungen des Reiches gefunden.“"
                                            },
                                            {
                                                "example_id": "c9431caf-b57a-4d74-a540-d5b7a4d0293b",
                                                "sense_id": "68aab881-ff52-35be-aa75-465fe0b48ae1",
                                                "text": "„Vor allem die Existenz einer großen Anzahl von hethitischen Wörtern, die ihrem Ursprung nach nicht zum indoeuropäischen Sprachstamm gehören können, führte zu einer Verunsicherung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
