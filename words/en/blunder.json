{
    "word_family": [
        "blunderingly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4940c27a-fd03-3265-996b-a3edf461d439",
                    "sense_definition": "A clumsy or embarrassing mistake.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mistake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician made a major <w>blunder</w> during his speech that cost him many votes.",
                            "target_lang_translations": {
                                "ru": "Политик допустил серьезный <w>промах</w> во время своего выступления, что стоило ему многих голосов.",
                                "zh": "那位政客在演讲中犯了一个重大<w>失误</w>，导致他失去了许多选票。"
                            }
                        },
                        {
                            "text": "It was a silly <w>blunder</w> to leave the front door unlocked while we were away.",
                            "target_lang_translations": {
                                "ru": "Было глупым <w>ляпом</w> оставить входную дверь незапертой, пока нас не было.",
                                "zh": "我们出门时没锁前门，真是个愚蠢的<w>大错</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blooper",
                        "goof",
                        "howler",
                        "error"
                    ],
                    "common_phrases": [
                        "major blunder",
                        "silly blunder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неловкая или досадная ошибка.",
                        "zh": "一种笨拙或令人尴尬的错误。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ляп",
                                "target_lang_sense_clarification": "разговорное обозначение нелепой ошибки"
                            },
                            {
                                "target_lang_word": "промах",
                                "target_lang_sense_clarification": "ошибка, допущенная по неосторожности"
                            },
                            {
                                "target_lang_word": "ляпсус",
                                "target_lang_sense_clarification": "грубая, часто нелепая ошибка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大错",
                                "target_lang_sense_clarification": "严重的错误"
                            },
                            {
                                "target_lang_word": "失误",
                                "target_lang_sense_clarification": "因疏忽导致的错误"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ffcd892-6501-315b-8980-e26d25e4f706",
                    "sense_definition": "A very bad move in a game, usually caused by a tactical oversight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mistake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chess player lost the game after a critical <w>blunder</w> in the middle of the match.",
                            "target_lang_translations": {
                                "ru": "Шахматист проиграл партию после критического <w>зевка</w> в середине матча.",
                                "zh": "那位棋手在比赛中局犯下致命<w>漏着</w>后输掉了比赛。"
                            }
                        },
                        {
                            "text": "One tactical <w>blunder</w> was enough to turn the tide of the entire game.",
                            "target_lang_translations": {
                                "ru": "Одного тактического <w>просчета</w> было достаточно, чтобы изменить ход всей игры.",
                                "zh": "一个战术上的<w>严重失误</w>就足以扭转整场比赛的局势。"
                            }
                        }
                    ],
                    "synonyms": [
                        "error"
                    ],
                    "common_phrases": [
                        "tactical blunder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серьезная ошибка в игре, обычно вызванная тактическим недосмотром.",
                        "zh": "游戏中的严重失误，通常由战术疏忽引起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зевок",
                                "target_lang_sense_clarification": "в шахматах и спорте: грубая ошибка из-за потери бдительности"
                            },
                            {
                                "target_lang_word": "грубая ошибка",
                                "target_lang_sense_clarification": "общее обозначение серьезного просчета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漏着",
                                "target_lang_sense_clarification": "棋类中因疏忽而下的坏棋"
                            },
                            {
                                "target_lang_word": "严重失误",
                                "target_lang_sense_clarification": "比赛中致命的错误"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d0eab39d-e293-37a0-9eb5-5697836186a7",
                    "sense_definition": "To make a big mistake, especially when it is careless or stupid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mistake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant <w>blundered</w> when calculating the final tax figures for the company.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер <w>облажался</w> при расчете итоговых налоговых показателей компании.",
                                "zh": "会计在计算公司最终税额时<w>搞砸</w>了。"
                            }
                        },
                        {
                            "text": "He <w>blundered</w> by sending the confidential email to the wrong department.",
                            "target_lang_translations": {
                                "ru": "Он <w>совершил промах</w>, отправив конфиденциальное письмо не в тот отдел.",
                                "zh": "他把机密邮件发错了部门，真是<w>犯错</w>了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершить серьезную ошибку, особенно по неосторожности или глупости.",
                        "zh": "犯下大错，尤指因粗心或愚蠢所致。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облажаться",
                                "target_lang_sense_clarification": "жаргонное: совершить глупую ошибку, потерпеть неудачу"
                            },
                            {
                                "target_lang_word": "лопухнуться",
                                "target_lang_sense_clarification": "разговорное: проявить нерасчетливость, совершить промах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "犯错",
                                "target_lang_sense_clarification": "做出错误的决定或行为"
                            },
                            {
                                "target_lang_word": "搞砸",
                                "target_lang_sense_clarification": "因失误导致事情失败"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d92df84-1c02-3b52-bc57-19183b51a3b1",
                    "sense_definition": "To move in an unsteady or clumsy way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired hiker continued to <w>blunder</w> through the dark forest without a flashlight.",
                            "target_lang_translations": {
                                "ru": "Уставший турист продолжал <w>брести ощупью</w> через темный лес без фонарика.",
                                "zh": "疲惫的徒步旅行者没有手电筒，只能在黑暗的森林中<w>跌跌撞撞</w>地前行。"
                            }
                        },
                        {
                            "text": "He <w>blundered</w> into the room, tripping over the rug in the process.",
                            "target_lang_translations": {
                                "ru": "Он неуклюже <w>ворвался</w> в комнату, споткнувшись при этом о ковер.",
                                "zh": "他<w>跌跌撞撞</w>地走进房间，过程中还被地毯绊了一下。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться неуверенно или неуклюже.",
                        "zh": "以不稳或笨拙的方式移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брести ощупью",
                                "target_lang_sense_clarification": "передвигаться в темноте или неуверенно"
                            },
                            {
                                "target_lang_word": "спотыкаться",
                                "target_lang_sense_clarification": "двигаться неуклюже, задевая предметы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跌跌撞撞",
                                "target_lang_sense_clarification": "形容走路不稳"
                            },
                            {
                                "target_lang_word": "摸索",
                                "target_lang_sense_clarification": "在黑暗中或不熟悉的地方缓慢移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92c4890e-cbfa-304d-bcab-ec388f55cf91",
                    "sense_definition": "To enter a place or become involved in a difficult situation by mistake.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We accidentally <w>blundered</w> into a private meeting while looking for the restroom.",
                            "target_lang_translations": {
                                "ru": "Мы случайно <w>попали</w> на закрытое совещание, когда искали туалет.",
                                "zh": "我们找洗手间时无意中<w>误入</w>了一场私人会议。"
                            }
                        },
                        {
                            "text": "They <w>blundered</w> into a dangerous situation without realizing the risks involved.",
                            "target_lang_translations": {
                                "ru": "Они <w>влипли</w> в опасную ситуацию, не осознавая связанных с этим рисков.",
                                "zh": "他们没意识到其中的风险，就<w>陷入</w>了危险的境地。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blunder into"
                    ],
                    "target_lang_definitions": {
                        "ru": "По ошибке попасть в какое-либо место или оказаться в сложной ситуации.",
                        "zh": "因错误而进入某地或陷入困境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайно попасть",
                                "target_lang_sense_clarification": "оказаться где-то непреднамеренно"
                            },
                            {
                                "target_lang_word": "влипнуть",
                                "target_lang_sense_clarification": "разговорное: оказаться в неприятной или сложной ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "误入",
                                "target_lang_sense_clarification": "无意中进入某处"
                            },
                            {
                                "target_lang_word": "陷入",
                                "target_lang_sense_clarification": "无意中卷入某种境地"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}