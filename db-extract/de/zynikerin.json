                    {
                        "form_id": "75ca52dd-7972-4d1a-b5df-ae8a01ad1e2a",
                        "entry_id": "6e03a813-6694-346c-8b3f-3287673ebc30",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Zynikerin"
                    },
                    {
                        "form_id": "c410cff4-fe56-4a14-ab80-f12e1c73b66b",
                        "entry_id": "6e03a813-6694-346c-8b3f-3287673ebc30",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zynikerinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4dcdbccd-3855-3213-817a-eca2770aefa1",
                        "entry_id": "6e03a813-6694-346c-8b3f-3287673ebc30",
                        "glosses": [
                            "weibliche Person, die durch beißenden Spott die Gefühle anderer verletzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e19eaf86-854e-4d68-a21e-dbded1dd1dde",
                                "sense_id": "4dcdbccd-3855-3213-817a-eca2770aefa1",
                                "text": "Da begab ich mich, ohne es zu bemerken, auf den Weg zur Zynikerin und zur Schülerverachterin, Selbstverachterin, Menschenverachterin."
                            },
                            {
                                "example_id": "ecaf4c2c-39ee-48e2-8fa4-d1eff8e4f39a",
                                "sense_id": "4dcdbccd-3855-3213-817a-eca2770aefa1",
                                "text": "Mit Pamfilowas Rücktritt verliert Russland eine untypische und umso bedeutendere Vertreterin seiner Elite. Denn sie ist keine Zynikerin der Macht."
                            },
                            {
                                "example_id": "dcc1b48f-db97-4662-b42d-83b70ee5693a",
                                "sense_id": "4dcdbccd-3855-3213-817a-eca2770aefa1",
                                "text": "Das Erscheinungsbild einer Zynikerin, ihre gedämpfte, nur gespielt nonchalante Art, konnte ich mir so schnell aneignen wie die anderen ja auch."
                            },
                            {
                                "example_id": "22e861ae-744a-43d5-b56f-d2c84038d37d",
                                "sense_id": "4dcdbccd-3855-3213-817a-eca2770aefa1",
                                "text": "Ich bin keine Zynikerin, aber ich halte mich für realistischer als viele der Menschen, die jetzt entsetzt über Donald Trump sind oder Angst vor einem neuen Faschismus haben."
                            },
                            {
                                "example_id": "6075841c-4f6a-4efe-a23b-6264469423b5",
                                "sense_id": "4dcdbccd-3855-3213-817a-eca2770aefa1",
                                "text": "„Ja, aber da finde ich es toll! Vielleicht ist das die Zynikerin in mir, aber wenn man in romantischen Dingen zu naiv ist, wird man aufs Kreuz gelegt. …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0dd999a-2298-4396-af2d-19b59616a181",
                        "source_entry_id": "6e03a813-6694-346c-8b3f-3287673ebc30",
                        "source_sense_id": "4dcdbccd-3855-3213-817a-eca2770aefa1",
                        "source_sense_description": "weibliche Person, die durch beißenden Spott die Gefühle anderer verletzt",
                        "target_lang_word": "cynic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cynic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8436f2fa-9e2e-33be-a250-e45c771aecf6",
                                        "entry_id": "db410a88-2f81-3aab-a980-4c148adf5ae7",
                                        "glosses": [
                                            "A person whose outlook is scornfully negative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdd617ac-19c3-4048-b6ab-97046f2151a8",
                                                "sense_id": "8436f2fa-9e2e-33be-a250-e45c771aecf6",
                                                "text": "Well, that's one in the eye for the nay-sayers, the doubters, the cynics and assorted tosspots what make up the media and that."
                                            },
                                            {
                                                "example_id": "35e96f49-73cd-4c29-a4b2-a96443916cf9",
                                                "sense_id": "8436f2fa-9e2e-33be-a250-e45c771aecf6",
                                                "text": "\"Accept your limitations,\" I'd warn her. \"A lot of these kids are damaged beyond repair.\" And you know what her response was? That I was cynical. Which hit a nerve, I had to admit. I wasn't a cynic; I was a banged-up realist. You live to middle age, you begin to reckon with life's limits, you know? You lace up your sneakers and run it out."
                                            },
                                            {
                                                "example_id": "e99d991c-6e84-47e0-bb13-1334128f98ff",
                                                "sense_id": "8436f2fa-9e2e-33be-a250-e45c771aecf6",
                                                "text": "The cynic surfaced, reminding him that she'd been accused of trying to spring the baby trap on Brad Comfort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10ff83bd-3613-35e7-9b3d-53ae832f25f4",
                                        "entry_id": "db410a88-2f81-3aab-a980-4c148adf5ae7",
                                        "glosses": [
                                            "A person who believes that all people are motivated by selfishness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cynic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77314372-7a58-30f1-970e-c22ef0ed409e",
                                        "entry_id": "3619f86b-5ea0-355b-87fd-882ef7df1305",
                                        "glosses": [
                                            "cynical (in all senses)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ef84b03-6fdc-3bbe-8ffb-5480f86d69ba",
                                        "entry_id": "3619f86b-5ea0-355b-87fd-882ef7df1305",
                                        "glosses": [
                                            "Relating to the Dog Star."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0c2dbe7-5159-487c-ad71-6126e7d88968",
                                                "sense_id": "6ef84b03-6fdc-3bbe-8ffb-5480f86d69ba",
                                                "text": "the cynic, or Sothic, year; cynic cycle"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3afa973-4552-463c-9165-e6d7580c6f0b",
                        "source_entry_id": "6e03a813-6694-346c-8b3f-3287673ebc30",
                        "source_sense_id": "4dcdbccd-3855-3213-817a-eca2770aefa1",
                        "source_sense_description": "weibliche Person, die durch beißenden Spott die Gefühle anderer verletzt",
                        "target_lang_word": "cynique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cynique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e2c4b1c-8db0-31ed-bd87-85bcc7cbcff1",
                                        "entry_id": "ecd5a11a-daac-3e99-a41c-51580aeff970",
                                        "glosses": [
                                            "Qui a rapport au chien."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f60686e0-29ca-4578-91d3-daabb74cafff",
                                                "sense_id": "2e2c4b1c-8db0-31ed-bd87-85bcc7cbcff1",
                                                "text": "Spasmes cyniques, contraction des muscles des angles des lèvres qui donne un rictus canin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0812c08b-8d50-3e3f-bfb6-a7bed27ab3c3",
                                        "entry_id": "ecd5a11a-daac-3e99-a41c-51580aeff970",
                                        "glosses": [
                                            "Relatif aux cyniques, à leur philosophie matérialiste et anticonformiste."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da7db19c-cd01-493c-b540-33b37e6145b7",
                                                "sense_id": "0812c08b-8d50-3e3f-bfb6-a7bed27ab3c3",
                                                "text": "Le philosophe cynique est porteur d'une intraitable volonté de dire non, de débusquer le conformisme à travers les habitudes."
                                            },
                                            {
                                                "example_id": "8f1e2a09-18b5-411b-8b59-318f6e32b41d",
                                                "sense_id": "0812c08b-8d50-3e3f-bfb6-a7bed27ab3c3",
                                                "text": "Il sert à désigner le philosophe qui, tel Diogène, fait profession d'être comme un chien, c'est-à-dire en parfaite adéquation avec sa nature, et dans le plus complet mépris de tous les conditionnements sociaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6a06dae-6c9f-3fbb-acbd-81d10b7548e1",
                                        "entry_id": "ecd5a11a-daac-3e99-a41c-51580aeff970",
                                        "glosses": [
                                            "Qui affecte une impudence effrontée, notamment en raison d'un refus de l'hypocrisie ou d'un désabusement."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30325f98-d5b8-4121-82fd-1d7db3dc8b59",
                                                "sense_id": "c6a06dae-6c9f-3fbb-acbd-81d10b7548e1",
                                                "text": "Au contraire, la fille de bordel n'a vraiment ni le goût ni la science du vocabulaire cynique. La liberté des mots la tente aussi peu que celle de la vie."
                                            },
                                            {
                                                "example_id": "de23ab03-2059-4a78-8dc5-9707acf13b6a",
                                                "sense_id": "c6a06dae-6c9f-3fbb-acbd-81d10b7548e1",
                                                "text": "Je n'ai rien vu de plus engoncé dans les préjugés niais, dans l'égoïsme cynique et dans le matérialisme inconscient que ces trois bourgeois de province."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af50adcd-010f-38d6-8516-6c16875f2673",
                                        "entry_id": "ecd5a11a-daac-3e99-a41c-51580aeff970",
                                        "glosses": [
                                            "Qui est désabusé, désillusionné ou qui accuse un désintérêt blasé à l'égard de quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15ffe4ef-d3f7-49f6-b27c-f74c5459e2ed",
                                                "sense_id": "af50adcd-010f-38d6-8516-6c16875f2673",
                                                "text": "Une personne cynique, dit Oscar Wilde, c'est une personne qui connaît le prix de tout, mais la valeur de rien."
                                            },
                                            {
                                                "example_id": "754543cb-31d8-4e37-9ad6-8fffec7cff91",
                                                "sense_id": "af50adcd-010f-38d6-8516-6c16875f2673",
                                                "text": "On aurait ainsi sacrifié dix mille morts par an pour ne pas désespérer Billancourt, Renault, Peugeot, Citroën et le CAC 40 ! J'entends bien ces cyniques raisons."
                                            },
                                            {
                                                "example_id": "bed24ca8-edc7-48a7-afa7-df607bce6834",
                                                "sense_id": "af50adcd-010f-38d6-8516-6c16875f2673",
                                                "text": "… le regard cynique que la jeunesse porte sur la politique."
                                            },
                                            {
                                                "example_id": "5eadeb74-58a7-46fb-8a59-0c6cc7e4d2cf",
                                                "sense_id": "af50adcd-010f-38d6-8516-6c16875f2673",
                                                "text": "Une lueur cynique brillait dans son regard et Isabel eut un frisson involontaire quand il ajouta avec une douceur trompeuse :\n— Un tiens vaut mieux que deux tu l'auras, c'est ce qu'on dit dans votre langue, je crois. Donc, je répète : quel est votre prix ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cynique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61d839df-68f7-3e2f-8229-f7fc8633864f",
                                        "entry_id": "e0ea2a9c-3d74-3e98-8799-3c7c5a0f190f",
                                        "glosses": [
