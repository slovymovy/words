                        "form_id": "5e72c152-866a-4cb5-840b-0f837714e812",
                        "entry_id": "290675fd-ae79-3a50-ba63-1a32c988800f",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "опосты́левши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4fda3f98-1277-3175-b108-826bbb16155f",
                        "entry_id": "290675fd-ae79-3a50-ba63-1a32c988800f",
                        "glosses": [
                            "разг. стать, сделаться постылым; надоесть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b99aeb4d-4e9c-4f90-88ca-bc08394762ea",
                                "sense_id": "4fda3f98-1277-3175-b108-826bbb16155f",
                                "text": "— Эта жизнь опостылела мне, — продолжала Надя, — я не вынесу здесь и одного дня."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7109750-9185-4128-9b17-70200c1f4161",
                        "source_entry_id": "290675fd-ae79-3a50-ba63-1a32c988800f",
                        "source_sense_id": "4fda3f98-1277-3175-b108-826bbb16155f",
                        "target_lang_word": "bore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72d33c69-b80c-3d16-a232-00fb41e44871",
                                        "entry_id": "ddebfb29-8e3f-3ca1-b8c0-082e2291fb61",
                                        "glosses": [
                                            "To inspire boredom in somebody."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b5afc55-ff97-470d-a3d3-8d52cf70b395",
                                                "sense_id": "72d33c69-b80c-3d16-a232-00fb41e44871",
                                                "text": "to bore someone to death"
                                            },
                                            {
                                                "example_id": "0132eccc-c885-4890-b76d-16b7707303cb",
                                                "sense_id": "72d33c69-b80c-3d16-a232-00fb41e44871",
                                                "text": "Reading books really bores me; films are much more exciting."
                                            },
                                            {
                                                "example_id": "657fa5c5-f233-4bbd-a949-948cfd567c2d",
                                                "sense_id": "72d33c69-b80c-3d16-a232-00fb41e44871",
                                                "text": "He bores me with some trick."
                                            },
                                            {
                                                "example_id": "aa9802ba-8245-4595-8bbc-4572a8b2be21",
                                                "sense_id": "72d33c69-b80c-3d16-a232-00fb41e44871",
                                                "text": "[…] used to come and bore me at rare intervals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31c96f24-5626-3645-9995-0be388d301c2",
                                        "entry_id": "ddebfb29-8e3f-3ca1-b8c0-082e2291fb61",
                                        "glosses": [
                                            "To make a hole through something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36b7f6cc-caed-4a63-95c8-06719b389148",
                                                "sense_id": "31c96f24-5626-3645-9995-0be388d301c2",
                                                "text": "I'll believe as soon this whole earth may be bored."
                                            },
                                            {
                                                "example_id": "fc9cd4c5-5921-4e00-b9bf-feb585b7f3af",
                                                "sense_id": "31c96f24-5626-3645-9995-0be388d301c2",
                                                "text": "On June 8, 1872, the London & North Western Railway obtained powers to quadruple its main line, and a new tunnel was bored for the up and down slow lines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a6fc3b0-dc07-3d27-8308-6a483bfe892d",
                                        "entry_id": "ddebfb29-8e3f-3ca1-b8c0-082e2291fb61",
                                        "glosses": [
                                            "To make a hole with, or as if with, a boring instrument; to cut a circular hole by the rotary motion of a tool."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d09b0c0-5456-4983-9ebd-aadb357a69fc",
                                                "sense_id": "9a6fc3b0-dc07-3d27-8308-6a483bfe892d",
                                                "text": "to bore for water or oil"
                                            },
                                            {
                                                "example_id": "921ef8a3-d867-4a5d-b1d0-f90ec6c373f1",
                                                "sense_id": "9a6fc3b0-dc07-3d27-8308-6a483bfe892d",
                                                "text": "An insect bores into a tree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8d9c20d-afed-3794-9e9f-88fe4e833e70",
                                        "entry_id": "ddebfb29-8e3f-3ca1-b8c0-082e2291fb61",
                                        "glosses": [
                                            "To form or enlarge (something) by means of a boring instrument or apparatus."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56eba148-c129-494a-87dc-3d17cb80a4b8",
                                                "sense_id": "f8d9c20d-afed-3794-9e9f-88fe4e833e70",
                                                "text": "to bore a steam cylinder or a gun barrel; to bore a hole"
                                            },
                                            {
                                                "example_id": "721e603c-32d2-4488-882d-d1ff98d8fa1d",
                                                "sense_id": "f8d9c20d-afed-3794-9e9f-88fe4e833e70",
                                                "text": "short but very powerful jaws, by means whereof the insect can bore […] a cylindrical passage through the most solid wood"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4be8382a-9e25-3662-9bf7-fec049f9ca63",
                                        "entry_id": "ddebfb29-8e3f-3ca1-b8c0-082e2291fb61",
                                        "glosses": [
                                            "To make (a passage) by laborious effort, as in boring; to force a narrow and difficult passage through."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01771d67-a049-49d2-8561-1160df766cd7",
                                                "sense_id": "4be8382a-9e25-3662-9bf7-fec049f9ca63",
                                                "text": "to bore one’s way through a crowd"
                                            },
                                            {
                                                "example_id": "44f930a3-d1ff-4bde-9ba6-7d7e77dc71b4",
                                                "sense_id": "4be8382a-9e25-3662-9bf7-fec049f9ca63",
                                                "text": "What bustling crowds I bored."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5150575-72c0-35fc-968e-9ab00590b692",
                                        "entry_id": "ddebfb29-8e3f-3ca1-b8c0-082e2291fb61",
                                        "glosses": [
                                            "To be pierced or penetrated by an instrument that cuts as it turns."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b7f6b6-3c83-4f1c-b6b3-06cd97afe664",
                                                "sense_id": "c5150575-72c0-35fc-968e-9ab00590b692",
                                                "text": "This timber does not bore well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05d878c3-3ebb-33c8-a134-56dd1f960270",
                                        "entry_id": "ddebfb29-8e3f-3ca1-b8c0-082e2291fb61",
                                        "glosses": [
                                            "To glare (as if to drill a hole with the eyes)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1eb7f81-54cb-42eb-91b2-37d3484836cf",
                                                "sense_id": "05d878c3-3ebb-33c8-a134-56dd1f960270",
                                                "text": "Their eyes bore into my back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "404006ea-7cac-3056-beba-d6a7d388be38",
                                        "entry_id": "ddebfb29-8e3f-3ca1-b8c0-082e2291fb61",
                                        "glosses": [
                                            "To push or drive (a boxer into the ropes, a boat out of its course, etc.)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e57cdc-2de6-41bb-86a1-bbf9fdeeb7ba",
                                                "sense_id": "404006ea-7cac-3056-beba-d6a7d388be38",
                                                "text": "The right hand of Curtis was open too much ; but he nevertheless had the best of the hitting in this round, till Inglis bored him down, out of the ropes."
                                            },
                                            {
                                                "example_id": "3b2e17d2-bf66-405a-93de-6a4e1b962627",
                                                "sense_id": "404006ea-7cac-3056-beba-d6a7d388be38",
                                                "text": "Hanlan, it seems, led at about a mile, when Beach's steamer bored him, and to avoid the danger of being swamped, he put on a violent spurt and drew well clear of Beach, getting some lengths lead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51e06350-3c03-304f-b4b6-497c3c65f17e",
                                        "entry_id": "ddebfb29-8e3f-3ca1-b8c0-082e2291fb61",
                                        "glosses": [
                                            "To push forward in a certain direction with laborious effort."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aafa92d1-1013-4566-aef0-431f1ea9ecb9",
                                                "sense_id": "51e06350-3c03-304f-b4b6-497c3c65f17e",
                                                "text": "They take their flight […] boring to the west."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "472ecb24-3fd0-3c59-b3b7-5682a9f25f6b",
                                        "entry_id": "ddebfb29-8e3f-3ca1-b8c0-082e2291fb61",
                                        "glosses": [
                                            "To fool; to trick."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
