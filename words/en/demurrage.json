{
    "word_family": [
        "demur",
        "demurrer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4abf7bf-c616-31c3-9fed-4ee171ac598a",
                    "sense_definition": "A fee or compensation paid for the detention of a freight ship or container beyond the agreed loading or unloading time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shipping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipping company had to pay heavy <w>demurrage</w> charges because the cargo was delayed at the port.",
                            "target_lang_translations": {
                                "zh": "由于货物在港口延误，航运公司不得不支付高额的<w>滞期费</w>。"
                            }
                        },
                        {
                            "text": "To avoid <w>demurrage</w>, they worked through the night to unload the container ship.",
                            "target_lang_translations": {
                                "zh": "为了避免产生<w>滞期费</w>，他们通宵作业以卸载集装箱船。"
                            }
                        }
                    ],
                    "antonyms": [
                        "despatch"
                    ],
                    "common_phrases": [
                        "demurrage charges",
                        "incur demurrage",
                        "pay demurrage"
                    ],
                    "target_lang_definitions": {
                        "zh": "（货船或集装箱等）超过约定的装卸时间而支付的滞期费或延期补偿费。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滞期费",
                                "target_lang_sense_clarification": "海运或集装箱超时装卸收取的费用"
                            },
                            {
                                "target_lang_word": "延期费",
                                "target_lang_sense_clarification": "因延误停滞而产生的费用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00df208d-165b-352f-8ec3-8f6b775d3c52",
                    "sense_definition": "The delay or detention of a ship, freight vehicle, or container during loading or unloading beyond the permitted time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shipping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Congestion at the harbor led to an unexpected <w>demurrage</w> of several oil tankers.",
                            "target_lang_translations": {
                                "zh": "港口拥堵导致数艘油轮意外出现<w>滞期</w>。"
                            }
                        },
                        {
                            "text": "The contract explicitly specifies how days of <w>demurrage</w> are calculated during adverse weather.",
                            "target_lang_translations": {
                                "zh": "合同明确规定了在恶劣天气下<w>滞期</w>天数的计算方式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "detention"
                    ],
                    "antonyms": [
                        "despatch"
                    ],
                    "common_phrases": [
                        "days of demurrage"
                    ],
                    "target_lang_definitions": {
                        "zh": "（船只、货车或集装箱在装卸过程中）超过允许时限的滞留或延误状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滞期",
                                "target_lang_sense_clarification": "装卸作业超出规定时间的状态"
                            },
                            {
                                "target_lang_word": "滞留",
                                "target_lang_sense_clarification": "运输工具受阻耽搁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d74a2d6-1785-32ca-add4-b42d0d3a4eac",
                    "sense_definition": "A recurring fee or cost associated with holding or storing currency over a period of time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monetary system was designed with a monthly <w>demurrage</w> to discourage hoarding.",
                            "target_lang_translations": {
                                "zh": "该货币体系设计了按月收取的<w>滞期费</w>，以遏制囤积行为。"
                            }
                        },
                        {
                            "text": "Economists argued that applying <w>demurrage</w> would boost the velocity of money during a recession.",
                            "target_lang_translations": {
                                "zh": "经济学家认为，在衰退时期征收<w>货币持有税</w>可以提高货币流通速度。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "demurrage fee"
                    ],
                    "target_lang_definitions": {
                        "zh": "持有或储存货币一定时期所需定期支付的持有费或储存成本。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滞期费",
                                "target_lang_sense_clarification": "货币经济学中持有货币定期收取的维持费"
                            },
                            {
                                "target_lang_word": "货币持有税",
                                "target_lang_sense_clarification": "抑制货币囤积的持有成本或税费"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98567048-af02-3ddb-bbc5-8007e97fb040",
                    "sense_definition": "A form of currency that requires holders to pay a regular maintenance fee, discouraging its use as a store of value.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Local communities experimented with a <w>demurrage</w> that lost a fraction of its value each month.",
                            "target_lang_translations": {
                                "zh": "当地社区尝试使用一种每月都会损失部分价值的<w>减值货币</w>。"
                            }
                        },
                        {
                            "text": "Supporters believed this <w>demurrage</w> would stimulate commerce faster than standard banknotes.",
                            "target_lang_translations": {
                                "zh": "支持者认为，这种<w>滞期费货币</w>比普通纸币能更快地刺激商业活动。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种需要持有者定期支付维护费用以防止被囤积的减值货币。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "减值货币",
                                "target_lang_sense_clarification": "随时间推移扣减价值或需交纳持有费的货币"
                            },
                            {
                                "target_lang_word": "滞期费货币",
                                "target_lang_sense_clarification": "带有滞期费机制的货币"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a4c36dd-1ecb-3253-845d-5625100ff77b",
                    "sense_definition": "A fee charged for exchanging paper currency into precious metal bullion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under the nineteenth-century bank rules, a small <w>demurrage</w> was deducted when purchasing gold bars.",
                            "target_lang_translations": {
                                "zh": "根据19世纪的银行规定，购买金条时会扣除少许<w>兑金手续费</w>。"
                            }
                        },
                        {
                            "text": "The central bank charged <w>demurrage</w> on bullion conversions to cover administrative expenses.",
                            "target_lang_translations": {
                                "zh": "央行在兑换贵金属时收取<w>兑换费</w>以弥补管理开支。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical banking term"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（旧时）将纸币兑换为贵金属金银块时所收取的手续费。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "兑金手续费",
                                "target_lang_sense_clarification": "纸币兑换贵金属金条时扣除的费用"
                            },
                            {
                                "target_lang_word": "兑换费",
                                "target_lang_sense_clarification": "纸币兑换金银条时的杂费"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}