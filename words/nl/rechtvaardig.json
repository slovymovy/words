            "senses": [
                {
                    "sense_id": "f318784e-26b8-30b6-9c9f-031e938dfe4c",
                    "sense_definition": "in overeenstemming met wat eerlijk en moreel juist is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eerlijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter nam een <w>rechtvaardig</w> besluit na het horen van alle getuigen.",
                            "target_lang_translations": {
                                "en": "The judge made a <w>just</w> decision after hearing all the witnesses.",
                                "ru": "Судья принял <w>справедливое</w> решение после того, как выслушал всех свидетелей."
                            }
                        },
                        {
                            "text": "Het is een <w>rechtvaardige</w> straf voor de daden die hij heeft gepleegd.",
                            "target_lang_translations": {
                                "en": "It is a <w>fair</w> punishment for the acts he committed.",
                                "ru": "Это <w>справедливое</w> наказание за поступки, которые он совершил."
                            }
                        }
                    ],
                    "synonyms": [
                        "gerecht",
                        "gerechtig"
                    ],
                    "antonyms": [
                        "onrechtvaardig",
                        "ongerecht",
                        "ongerechtig"
                    ],
                    "common_phrases": [
                        "rechtvaardig besluit",
                        "rechtvaardige straf",
                        "rechtvaardige oorlog"
                    ],
                    "target_lang_definitions": {
                        "en": "in accordance with what is fair and morally right",
                        "ru": "соответствующий принципам честности, морали и справедливости"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "morally right and equitable"
                            },
                            {
                                "target_lang_word": "fair",
                                "target_lang_sense_clarification": "equitable and unbiased"
                            },
                            {
                                "target_lang_word": "righteous",
                                "target_lang_sense_clarification": "morally virtuous or justified"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "справедливый",
                                "target_lang_sense_clarification": "основанный на справедливости и истине"
                            },
                            {
                                "target_lang_word": "праведный",
                                "target_lang_sense_clarification": "соответствующий религиозным или высоким моральным нормам"
                            }
                        ]
                    }
                }
