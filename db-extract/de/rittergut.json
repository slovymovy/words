                        "form": "das Rittergut"
                    },
                    {
                        "form_id": "b5a99647-3fed-4e74-903f-d027d22d73d8",
                        "entry_id": "f5311c5f-9c81-3659-b74a-a214b3086772",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rittergüter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99aa6198-dcd8-3e3b-ad56-db5f43fbc4c3",
                        "entry_id": "f5311c5f-9c81-3659-b74a-a214b3086772",
                        "glosses": [
                            "ehemaliges Landgut im deutschen Osten, dessen Besitzer ursprünglich zu Ritterdiensten verpflichtet war und dafür Steuerbegünstigung, Patrimonialgerichtsbarkeit, Patronatsrechte, Jagdrechte und andere Rechte besaß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06487c3e-0dd3-4e3f-beef-e1c2d4ca190f",
                                "sense_id": "99aa6198-dcd8-3e3b-ad56-db5f43fbc4c3",
                                "text": "„Diese Rittergüter wurden im 19. Jahrhundert aufgehoben, […] Neuerdings wurden die aus Rittergüten hervorgegangenen Landkomplexe durch die Bodenreform aufgegliedert.“"
                            },
                            {
                                "example_id": "948ae104-6069-40aa-9053-982a2efc0f33",
                                "sense_id": "99aa6198-dcd8-3e3b-ad56-db5f43fbc4c3",
                                "text": "„»Wolf unter Wölfen« spielt im Inflationsjahr 1923 an zwei Fallada bekannten Orten: der Großstadt Berlin und dem Rittergut Radach, dreißig Kilometer nordöstlich von Frankfurt an der Oder, wo Fallada von Anfang Mai bis Oktober 1923 Buchhalter war.“"
                            },
                            {
                                "example_id": "cf154676-10d6-4ab7-892e-848ab7037755",
                                "sense_id": "99aa6198-dcd8-3e3b-ad56-db5f43fbc4c3",
                                "text": "„Am Abend waren alle Plätze nach Caen schon ausverkauft; da er nicht wußte, was er anfangen sollte, ging er ins Théâtre des Arts, lächelte seinen Nachbarn zu und erzählte ihnen, er habe sich vom Geschäft zurückgezogen und vor kurzem ein Rittergut in der Umgebung gekauft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
