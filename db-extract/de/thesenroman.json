                "senses": [
                    {
                        "sense_id": "eb59980d-2d7e-3e9e-9314-3a9b267b8fbe",
                        "entry_id": "9558a453-208c-3880-af42-712840597072",
                        "glosses": [
                            "wissenschaftliche, gesellschaftliche oder religiöse Grundidee, die in der literarischen Form des Romans vorgestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc6ca077-2f6c-427c-8605-58070388759b",
                                "sense_id": "eb59980d-2d7e-3e9e-9314-3a9b267b8fbe",
                                "text": "„Der Thesenroman, der Handlung und Figuren allzu offensichtlich unters Joch einer Idee zwingt, ist … ein mässig geliebtes literarisches Genre.“"
                            },
                            {
                                "example_id": "940234af-46a9-4774-a903-1cb4acb27aab",
                                "sense_id": "eb59980d-2d7e-3e9e-9314-3a9b267b8fbe",
                                "text": "„So lehnt Camus den Thesenroman und das Tendenzstück ab: ‚Der Thesenroman, das beweisende Werk, das hassenswerteste von allen, läßt sich am häufigsten von einem zufriedenen Denken inspirieren.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
