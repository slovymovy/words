                    }
                ],
                "senses": [
                    {
                        "sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                        "entry_id": "1832ef57-6092-398c-843b-8213fdf76953",
                        "glosses": [
                            "ununterbrochener, wortreicher Redefluss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cdf87c3-2741-4686-a29b-ffd21e3e4061",
                                "sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                                "text": "„Beim Tee unterbrach Carpenter seinen Redeschwall, so daß ihm John endlich die Frage stellen konnte, die ihm die ganze Zeit auf der Zunge lag: wann er denn abzureisen gedenke.“"
                            },
                            {
                                "example_id": "9631fe73-6be3-40cc-9cb8-a2421cef8e03",
                                "sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                                "text": "„Er wachte mit einem Redeschwall auf, stürzte sich sofort in haarspalterische Debatten, immer über das Schicksal der Welt, ihre biochemische Natur, ihre astrophysikalische Beschaffenheit, ihre politisch-wirtschaftlichen Aspekte.“"
                            },
                            {
                                "example_id": "e38336d9-f0bc-4392-8adc-45b947230207",
                                "sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                                "text": "„Ihr Fremdenführer, dessen Redeschwall im Verkehrslärm unterging, fuchtelte wild mit den Armen und deutete auf das gegenüberliegende Gebäude.“"
                            },
                            {
                                "example_id": "f49ecc07-f4b0-4f5e-9034-39abe518365b",
                                "sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                                "text": "„Sein Redeschwall sprudelte nur so.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbfa0330-949c-4b2f-839c-dab9fd5521f1",
                        "source_entry_id": "1832ef57-6092-398c-843b-8213fdf76953",
                        "source_sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                        "source_sense_description": "ununterbrochener, wortreicher Redefluss",
                        "target_lang_word": "diatribe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diatribe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9fe9e59-6275-378b-a00f-f8fd3cfa710b",
                                        "entry_id": "7454d6c3-6b32-3111-af8b-ce48da5f0726",
                                        "glosses": [
                                            "An abusive, bitter verbal or written attack, criticism or denunciation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbb7c52a-2a11-412a-9ed8-6bb7eb4c1bcf",
                                                "sense_id": "f9fe9e59-6275-378b-a00f-f8fd3cfa710b",
                                                "text": "The senator was prone to diatribes which could go on for more than an hour."
                                            },
                                            {
                                                "example_id": "866221ba-ba12-4b94-8214-28f00bf94aef",
                                                "sense_id": "f9fe9e59-6275-378b-a00f-f8fd3cfa710b",
                                                "text": "“… No rogue e’er felt the halter draw, with a good opinion of the law, and perhaps my own detestation of the law arises from my having frequently broken it. If this long diatribe bores you, just say so, and I’ll cut it short.”"
                                            },
                                            {
                                                "example_id": "232d30f2-b663-483f-81cf-04f65856a22f",
                                                "sense_id": "f9fe9e59-6275-378b-a00f-f8fd3cfa710b",
                                                "text": "You know, it’s all this racial diatribe, and very strong language, screaming at the top of his lungs into the telephone."
                                            },
                                            {
                                                "example_id": "5fc4ba79-7601-48e3-a443-0ec94e026b03",
                                                "sense_id": "f9fe9e59-6275-378b-a00f-f8fd3cfa710b",
                                                "text": "Aunt Petunia wasn’t eating anything at all. Her arms were folded, her lips were pursed and she seemed to be chewing her tongue, as though biting back the furious diatribe she longed to throw at Harry."
                                            },
                                            {
                                                "example_id": "5ceaf4e8-f541-41c1-95ce-2a01d6e11c01",
                                                "sense_id": "f9fe9e59-6275-378b-a00f-f8fd3cfa710b",
                                                "text": "Lest this [be] read as a diatribe against DfT, I have some sympathy with it. That's because whenever there's a problem with the railway, the industry's solution is to ask DfT for billions of pounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80fd400f-5181-3c54-931f-0f4b3dc14050",
                                        "entry_id": "7454d6c3-6b32-3111-af8b-ce48da5f0726",
                                        "glosses": [
                                            "A prolonged discourse; a long-winded speech."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ade80234-17d3-4ea7-aba1-3143f9557bf6",
                        "source_entry_id": "1832ef57-6092-398c-843b-8213fdf76953",
                        "source_sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                        "source_sense_description": "ununterbrochener, wortreicher Redefluss",
                        "target_lang_word": "logorrhée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "logorrhée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9981c6c6-4af2-3a5e-861d-c256128d1d3c",
                                        "entry_id": "458b4f9c-810f-34f1-8be1-fbe04529210b",
                                        "glosses": [
                                            "Trouble du langage caractérisé par un besoin irrésistible et morbide de parler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c410902d-12a9-44a3-91a6-85c04d5d4798",
                                                "sense_id": "9981c6c6-4af2-3a5e-861d-c256128d1d3c",
                                                "text": "En étudiant la fonction du langage nous avons vu chez les psychasténiques des crises de bavardages et des tics de parole de même que des arrêts de la parole déterminés par des peurs ou par la timidité. Ces phénomènes n’étaient pas sans analogie avec les crises de logorrhée et le mutisme de l’autre névrose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cecf144-6f6e-3818-961c-f04d231db89f",
                                        "entry_id": "458b4f9c-810f-34f1-8be1-fbe04529210b",
                                        "glosses": [
                                            "Long discours creux. Flux de paroles inutiles et incohérentes. Blabla prétentieux pour présenter des banalités ou une analyse plus ou moins cohérente et fondée."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df390bfa-dd6e-4cb3-a430-1a66177ad752",
                                                "sense_id": "6cecf144-6f6e-3818-961c-f04d231db89f",
                                                "text": "Il y a des gens qui vous envahissent avec leur logorrhée : on a la pénible impression d’être prisonnière de leurs mots."
                                            },
                                            {
                                                "example_id": "aa8beebf-810a-43f1-9605-48f52d549019",
                                                "sense_id": "6cecf144-6f6e-3818-961c-f04d231db89f",
                                                "text": "C'était la meilleure solution : fermer sa gueule et tourner les talons en direction des vestiaires sans même attendre qu'il ait fini de se vider de toute cette logorrhée mauvaise qui lui sortait de la bouche et qui venait d'on ne savait où."
                                            },
                                            {
                                                "example_id": "7360965f-94eb-4870-be58-699981d8ca8a",
                                                "sense_id": "6cecf144-6f6e-3818-961c-f04d231db89f",
                                                "text": "On peut parler de la montagne qui accouche d’une souris ou d’une logorrhée à faire ronfler une carpe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "075aa6a1-a776-4f02-b279-d9b0a6700733",
                        "source_entry_id": "1832ef57-6092-398c-843b-8213fdf76953",
                        "source_sense_id": "4892caf1-41f5-3bfe-a255-8a3486229a38",
                        "source_sense_description": "ununterbrochener, wortreicher Redefluss",
                        "target_lang_word": "diarrhée verbale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diarrhée verbale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d56f9438-8c82-31d4-9c28-beb4b79353f4",
                                        "entry_id": "b6d7a858-9376-3fae-bf24-649c7d57c323",
                                        "glosses": [
                                            "Logorrhée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5defc82c-af64-4eab-864f-9bb3ed231e66",
                                                "sense_id": "d56f9438-8c82-31d4-9c28-beb4b79353f4",
                                                "text": "Celui-ci [Sékou Touré] confine les Guinéens, y compris ceux travaillant dans l’usine, dans un climat de terreur dans lequel il les a enfermés et endormis à travers la diarrhée verbale de ses discours fleuves de quatre à six heures, sans notes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
