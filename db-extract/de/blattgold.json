                    {
                        "form_id": "184adad9-9509-46de-aaeb-99db0c21e8a8",
                        "entry_id": "e1b6a1b4-3c51-3a28-b29d-c217565d9da5",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Blattgold"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85113f69-3681-386c-b692-93519f5d8166",
                        "entry_id": "e1b6a1b4-3c51-3a28-b29d-c217565d9da5",
                        "glosses": [
                            "eine sehr dünn ausgetriebene Goldfolie, die meist zur Vergoldung von Gegenständen benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a873934d-fb70-4ba1-a448-31c17c00c3df",
                                "sense_id": "85113f69-3681-386c-b692-93519f5d8166",
                                "text": "„Gold galt als Metall der Götter, besonders des strahlenden Sonnengottes. Die Spitze der Obelisken wurde mit Blattgold überzogen.“"
                            },
                            {
                                "example_id": "acb1f4c4-af91-4426-b683-215a124d1e5a",
                                "sense_id": "85113f69-3681-386c-b692-93519f5d8166",
                                "text": "„Vorne auf dem mit zartem Blattgold verzierten Einband prangte das breite Lächeln der Grinsekatze.“"
                            },
                            {
                                "example_id": "8771268c-9790-43cf-87e8-b1a09cae89fc",
                                "sense_id": "85113f69-3681-386c-b692-93519f5d8166",
                                "text": "„Eines der berühmtesten Artefakte ist ein künstliches, mit Blattgold überzogenenes Bäumchen von 70 Zentimeter Höhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ab8848c-32d2-4182-92e7-76ce733f96d7",
                        "source_entry_id": "e1b6a1b4-3c51-3a28-b29d-c217565d9da5",
                        "source_sense_id": "85113f69-3681-386c-b692-93519f5d8166",
                        "source_sense_description": "sehr dünn ausgetriebene Goldfolie",
                        "target_lang_word": "gold leaf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gold leaf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e20ee47-435c-38b8-994b-409a93cecdaf",
                                        "entry_id": "66fbb560-137b-3388-a943-89ca450ea88f",
                                        "glosses": [
                                            "Gold beaten into a thin sheet."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66259530-2e4a-4c65-b213-ac860e3a7f71",
                                                "sense_id": "5e20ee47-435c-38b8-994b-409a93cecdaf",
                                                "text": "But this Cobweb Lawn is too thin; a gold Leaf to cover the forgoing poison: For nothing is more plain, that he means, that the King is the Head Conspirator in all this slavery […]"
                                            },
                                            {
                                                "example_id": "c9f52c8a-c992-4cb1-8b16-09ca41d94b53",
                                                "sense_id": "5e20ee47-435c-38b8-994b-409a93cecdaf",
                                                "text": "The streets of Nankin are sometimes strewed with gold leaf; very different are those of London: in the midst of their pavements, a great lazy puddle moves muddily along […]"
                                            },
                                            {
                                                "example_id": "90ea5c71-1a9e-47c6-8e5a-309a690969d4",
                                                "sense_id": "5e20ee47-435c-38b8-994b-409a93cecdaf",
                                                "text": "I cannot take a better illustration of this than that of gold leaf, because it brings before us the reason of this apparent difference in the time of the fall."
                                            },
                                            {
                                                "example_id": "ac4e508b-9e2c-4299-83f8-73c4f9f07060",
                                                "sense_id": "5e20ee47-435c-38b8-994b-409a93cecdaf",
                                                "text": "After the gesso was quite smooth and even it was covered with thin layers of tempered bole, to form a colour ground under the gold leaf, and to provide a sleek, lustrous cushion for the under side of the gold to rest on while the burnisher was pressing on the top."
                                            },
                                            {
                                                "example_id": "990a6e49-a3f1-4f53-94a4-f8a94fd88f4e",
                                                "sense_id": "5e20ee47-435c-38b8-994b-409a93cecdaf",
                                                "text": "All passenger stock is lettered in shaded gold leaf transfers and has never been decorated with either a crest or monogram."
                                            },
                                            {
                                                "example_id": "78337c64-7154-4a00-9b91-814fd9072545",
                                                "sense_id": "5e20ee47-435c-38b8-994b-409a93cecdaf",
                                                "text": "Today, gold leaf can be machine-beaten to 0.1 micron and to 0.05 micron when beaten by a skilled craftsman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa4cffbb-a7e2-4ad1-8241-0f54b2c46c6e",
                        "source_entry_id": "e1b6a1b4-3c51-3a28-b29d-c217565d9da5",
