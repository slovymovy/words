                        "examples": [
                            {
                                "example_id": "ece92ad1-47f8-4a5f-b3e3-8fed560aeef2",
                                "sense_id": "23f4b21f-8e6a-3860-84cf-2320d8f42fa8",
                                "text": "De meteorologen van Weerplaza voorspellen een zondag met flink wat zon, maar ook een stevige zuidoostenwind. ,,Ideaal weer voor watersporters, maar zij moeten wel rekening houden met koud water en gevaar op onderkoeling”, aldus weerman Raymond Klaassen."
                            },
                            {
                                "example_id": "3fc9b6d6-e5e1-4909-b279-88a917ad6e71",
                                "sense_id": "23f4b21f-8e6a-3860-84cf-2320d8f42fa8",
                                "text": "Het uitgesproken zonnige weer gaat samen met aanvoer van zeer warme lucht, die naar Nederland stroomt met een zwakke zuidoostenwind."
                            }
                        ]
