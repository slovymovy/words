                },
                {
                    "sense_id": "e6418a78-902e-30df-ba3f-1116bf2da57d",
                    "sense_definition": "The principal points, substance, or central idea of a matter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "essence_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This report represents the <w>sum</w> of our knowledge on the subject.",
                            "target_lang_translations": {
                                "ru": "Этот отчет представляет собой <w>совокупность</w> наших знаний по данному вопросу.",
                                "zh": "这份报告代表了我们对该课题知识的<w>实质</w>。"
                            }
