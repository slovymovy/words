            {
                "entry_id": "f9c6653e-a063-34f7-9dce-a4c0ebede5c1",
                "word": "pressure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eac73cb1-6af2-3d2a-8efe-ca8292d63250",
                        "entry_id": "f9c6653e-a063-34f7-9dce-a4c0ebede5c1",
                        "glosses": [
                            "Variante ancienne de présure. Substance animale ou végétale contenant des enzymes et servant à faire coaguler et cailler le lait et à faire du petit lait."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3e7fab0e-6dc4-477f-acd9-5b653f59923c",
                                "sense_id": "eac73cb1-6af2-3d2a-8efe-ca8292d63250",
                                "text": "pressure de veau. Lait caillé dans l’estomac des jeunes veaux, qu’on emploie pour faire cailler le lait frais et encore pourvu de sa crème."
                            },
                            {
                                "example_id": "6d88edcd-8d8b-4e48-87c4-8d49af7322d3",
                                "sense_id": "eac73cb1-6af2-3d2a-8efe-ca8292d63250",
                                "text": "Le suede figuier fait prendre le lait, comme la pressure."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd4b3241-7746-3ced-8fad-f9dd3b418262",
                        "entry_id": "f9c6653e-a063-34f7-9dce-a4c0ebede5c1",
                        "glosses": [
                            "Liqueur, préparée avec la caillette des veaux et des jeunes animaux ruminants, à l’âge où ils sont encore nourris de lait."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "385cb0eb-becb-44ce-965a-0c828e50c334",
                                "sense_id": "bd4b3241-7746-3ced-8fad-f9dd3b418262",
                                "text": "Son quatrième estomac contient des grumeaux de lait caillé, qui, séchés à l’air, sont la pressure dont on se sert à la campagne pour faire cailler le lait. Plus cette pressure est ancienne, meilleure elle est, et il n’en faut qu’une petite quantité."
                            }
                        ]
                    }
                ],
