                        "glosses": [
                            "(in der Regel relativ kurzer) Text, in dem Unvollkommenheiten des Sprachgebrauchs kritisiert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a8eb483-d4f9-425b-a27e-418471d15f83",
                                "sense_id": "34c84901-9aac-35f4-ad7c-4160d1c430b3",
                                "text": "„Eike Christian Hirsch lehnt in einer seiner Sprachglossen diese Unterscheidung allerdings als »Schulmeisterei« ab (…).“"
                            },
                            {
                                "example_id": "4c65e9fc-539c-4846-ae4c-35bcea88b11f",
                                "sense_id": "34c84901-9aac-35f4-ad7c-4160d1c430b3",
                                "text": "„In den 111 Sprachglossen dieses Buches geht es nicht um irgendwelche Sprachschnitzer.“"
                            },
                            {
                                "example_id": "1cf595d8-660d-4511-b3b8-379d93e07acb",
                                "sense_id": "34c84901-9aac-35f4-ad7c-4160d1c430b3",
                                "text": "„Gemäß dem Wesen der Glosse als journalistischer Ausdrucksform sind die Sprachglossen in Zeitungen und Zeitschriften (…) eher der Sprachkritik zuzurechnen.“"
                            },
                            {
                                "example_id": "e639a506-8d67-49fa-bc90-abe0d64d9d05",
                                "sense_id": "34c84901-9aac-35f4-ad7c-4160d1c430b3",
                                "text": "„Speziell Sprachglossen sind nichts anderes als Glossen zum Thema Sprache.“"
                            }
                        ],
