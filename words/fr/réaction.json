            "senses": [
                {
                    "sense_id": "0b4a4c23-a63a-3731-bdc7-98a4caf46dcd",
                    "sense_definition": "Attitude, émotion ou comportement manifesté en réponse à un événement ou à un acte.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reponse_generale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa <w>réaction</w> a surpris tout le monde lors de cette réunion importante."
                        },
                        {
                            "text": "Il a eu une vive <w>réaction</w> en apprenant la nouvelle de son départ."
                        }
                    ],
                    "synonyms": [
                        "réponse",
                        "riposte"
                    ],
                    "common_phrases": [
                        "provoquer une réaction",
                        "temps de réaction",
                        "première réaction"
                    ]
                },
                {
                    "sense_id": "855b8b56-1afe-3917-844d-fb217dd7706b",
                    "sense_definition": "Transformation au cours de laquelle des substances chimiques interagissent et changent de nature.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mélange de ces deux liquides produit une <w>réaction</w> qui dégage de la chaleur."
                        },
                        {
                            "text": "Cette <w>réaction</w> chimique nécessite la présence d'un catalyseur efficace."
                        }
                    ],
                    "common_phrases": [
                        "réaction chimique",
                        "vitesse de réaction",
                        "réaction en chaîne"
                    ]
                },
                {
                    "sense_id": "b4e02447-2df0-3ad1-a1ca-12396600590f",
                    "sense_definition": "Réponse biologique ou physiologique de l'organisme face à un agent externe ou un stimulus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patient a développé une forte <w>réaction</w> cutanée après avoir pris ce médicament."
                        },
                        {
                            "text": "Son système immunitaire montre une <w>réaction</w> rapide contre l'infection."
                        }
                    ],
                    "common_phrases": [
                        "réaction allergique",
                        "réaction immunitaire",
                        "réaction inflammatoire"
                    ]
                },
                {
                    "sense_id": "9a8f0cf3-c9c9-3f44-ab67-82212be568f5",
                    "sense_definition": "Force exercée par un corps en réponse à l'action mécanique exercée sur lui par un autre corps.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En physique mécanique, à chaque action correspond toujours une <w>réaction</w> égale et opposée."
                        },
                        {
                            "text": "Le moteur propulse le véhicule selon le principe classique de l'action et de la <w>réaction</w>."
                        }
                    ],
                    "common_phrases": [
                        "principe de réaction",
                        "action et réaction"
                    ]
                },
                {
                    "sense_id": "4dcccb41-a512-3f99-bce8-126581d468e9",
                    "sense_definition": "Tendance politique conservatrice ou autoritaire s'opposant aux réformes et au progrès social.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la période de soulèvement populaire, une forte <w>réaction</w> s'est emparée du pouvoir."
                        },
                        {
                            "text": "Les partis de gauche dénoncent régulièrement la montée de la <w>réaction</w> dans le pays."
                        }
                    ],
                    "synonyms": [
                        "conservatisme"
                    ],
                    "antonyms": [
                        "progressisme"
                    ],
                    "common_phrases": [
                        "forces de réaction"
                    ]
                },
                {
                    "sense_id": "c23b405a-115f-3560-866c-495c39a1a27c",
                    "sense_definition": "Mouvement brusque d'un cheval et secousse correspondante transmise au cavalier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune étalon a des <w>réactions</w> très vives qui mettent le cavalier en difficulté."
                        },
                        {
                            "text": "Le dresseur doit apprendre à amortir chaque brusque <w>réaction</w> de sa monture."
