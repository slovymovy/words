                {
                    "sense_id": "857de2df-ec99-307f-945c-472f1974b53b",
                    "sense_definition": "A state of the United States located in the New England region, known for its jagged coastline and maritime history.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They planned a summer vacation to the coast of <w>Maine</w>.",
                            "target_lang_translations": {
                                "ru": "Они запланировали летний отпуск на побережье <w>Мэна</w>.",
                                "fr": "Ils ont prévu des vacances d'été sur la côte du <w>Maine</w>."
                            }
                        },
                        {
                            "text": "Lobster fishing is a vital part of the economy in <w>Maine</w>.",
                            "target_lang_translations": {
                                "ru": "Ловля омаров — важная часть экономики в <w>Мэне</w>.",
                                "fr": "La pêche au homard est un élément vital de l'économie du <w>Maine</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "state of Maine",
                        "Gulf of Maine",
                        "coast of Maine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Штат США, расположенный в регионе Новая Англия, известный своей изрезанной береговой линией и морской историей.",
                        "fr": "État des États-Unis situé dans la région de la Nouvelle-Angleterre, connu pour son littoral découpé et son histoire maritime."
                    },
                    "translations": {
                        "ru": [
