                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swipe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6804e125-cce6-3fea-ae93-e03bfd2e3154",
                                        "entry_id": "688a6358-2875-358a-8fef-7a51cda43347",
                                        "glosses": [
                                            "To grab or bat quickly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46002df3-98db-4294-859f-c94da740a35a",
                                                "sense_id": "6804e125-cce6-3fea-ae93-e03bfd2e3154",
                                                "text": "The cat swiped at the shoelace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31392ef1-2ce4-3b9b-8119-2e3b7927c5b2",
                                        "entry_id": "688a6358-2875-358a-8fef-7a51cda43347",
                                        "glosses": [
                                            "To strike with a strong blow in a sweeping motion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90863849-3585-3b4e-a914-8ed14befe7dd",
                                        "entry_id": "688a6358-2875-358a-8fef-7a51cda43347",
                                        "glosses": [
                                            "To scan or register by sliding (a swipecard etc.) through a reader."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40934915-6d52-4a0e-8f5f-919204cbedd8",
                                                "sense_id": "90863849-3585-3b4e-a914-8ed14befe7dd",
                                                "text": "He swiped his card at the door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9fba4c7-6731-3ce0-a00b-5487bc03e751",
                                        "entry_id": "688a6358-2875-358a-8fef-7a51cda43347",
                                        "glosses": [
                                            "To interact with a touch screen by drawing one's finger rapidly across it."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5847eb5-2203-4d7f-b09b-0f6be81e4d68",
                                                "sense_id": "b9fba4c7-6731-3ce0-a00b-5487bc03e751",
                                                "text": "Swipe left to hide the toolbar."
                                            },
                                            {
                                                "example_id": "e3ebb205-4427-442b-86b1-8b90dee183b3",
                                                "sense_id": "b9fba4c7-6731-3ce0-a00b-5487bc03e751",
                                                "text": "This is the iPhone lock screen with its default Earth wallpaper. To unlock your phone, swipe the slider from left to right."
                                            },
                                            {
                                                "example_id": "b95e984c-3172-456f-9f9e-918573da7036",
                                                "sense_id": "b9fba4c7-6731-3ce0-a00b-5487bc03e751",
                                                "text": "But really, she is just over it all: the swiping, the monotonous getting-to-know-you conversations and the self-doubt that creeps in when one of her matches fizzles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff87c69c-110b-3d4f-b980-c99532055632",
                                        "entry_id": "688a6358-2875-358a-8fef-7a51cda43347",
                                        "glosses": [
                                            "To swipe right on (someone) on a dating application."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b1ac376-07c5-451f-9c54-53e361bafcd9",
                                                "sense_id": "ff87c69c-110b-3d4f-b980-c99532055632",
                                                "text": "Zac Efron needs a date. […] But would the actor resort to apps to find a partner? Joking, he said, “Amazingly, when I signed up for Tinder, nobody swiped me! They thought it was fake … That never happened.”"
                                            },
                                            {
                                                "example_id": "44b25baf-b7f2-473f-90e1-24b8582385bb",
                                                "sense_id": "ff87c69c-110b-3d4f-b980-c99532055632",
                                                "text": "Yas (Vivian Oparah): That is your truth. And, by the way, your man swiped me on Tinder, like, a week ago. […]\nEric (Benjamin Sarpong-Broni): Mmm, no, I didn't. I didn't swipe you. […] Or anybody. […] I didn't swipe her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffbc1fdd-b528-3681-88bd-e8a69983434c",
                                        "entry_id": "688a6358-2875-358a-8fef-7a51cda43347",
                                        "glosses": [
                                            "To steal or snatch."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb37dcef-3717-4157-a7d4-020eb10f4092",
                                                "sense_id": "ffbc1fdd-b528-3681-88bd-e8a69983434c",
                                                "text": "Hey! Who swiped my lunch?"
                                            },
                                            {
                                                "example_id": "39ae5611-3cbe-4196-948b-ab7f12597a6c",
                                                "sense_id": "ffbc1fdd-b528-3681-88bd-e8a69983434c",
                                                "text": "“From Miss Hemmingway. Miss Hemmingway! But—but how did they come into her possession?”\n“How?” I said. “Because she jolly well stole them. Pinched them! Swiped them! […]”"
                                            },
                                            {
                                                "example_id": "4825c95c-7450-410f-8865-44894fbd037a",
                                                "sense_id": "ffbc1fdd-b528-3681-88bd-e8a69983434c",
                                                "text": "Maybe I could swipe some Tintex from the five-and-dime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c84b159-11da-39f7-9ae9-92a8d850cc2b",
                                        "entry_id": "688a6358-2875-358a-8fef-7a51cda43347",
                                        "glosses": [
                                            "To drink."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "swipe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74191bcd-d80a-354e-ba50-00e05c80788d",
                                        "entry_id": "47870d1c-16b2-3571-bd6e-f697c78b01bc",
                                        "glosses": [
                                            "A quick grab, bat, or other motion with the hand or paw; a sweep."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa751242-ceec-33ed-89f1-778b0300f7a2",
                                        "entry_id": "47870d1c-16b2-3571-bd6e-f697c78b01bc",
                                        "glosses": [
                                            "A strong blow given with a sweeping motion, as with a bat or club."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3931466b-ebd4-37d7-b97b-d1d399384e0a",
                                        "entry_id": "47870d1c-16b2-3571-bd6e-f697c78b01bc",
                                        "glosses": [
                                            "An act of interacting with a touch screen by drawing the finger rapidly across it."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "640ce1ed-e0a3-47dd-99ce-efb1b3337083",
                                                "sense_id": "3931466b-ebd4-37d7-b97b-d1d399384e0a",
                                                "text": "Some New Yorkers are moving beyond the swipe to venture into flirtatious panel discussions and speed dating sessions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d429f62c-4350-32b7-a9b2-6fcffc6c842f",
                                        "entry_id": "47870d1c-16b2-3571-bd6e-f697c78b01bc",
                                        "glosses": [
                                            "An act of passing a swipecard through a card reader."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88cc02ac-aa06-400c-99ec-fc4bb1b86859",
                                                "sense_id": "d429f62c-4350-32b7-a9b2-6fcffc6c842f",
                                                "text": "Owning a car in New York City is seen as a liability by many, especially when a quick Uber ride or the swipe of a MetroCard can easily get you where you need to go."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3466b307-c150-346e-9b3e-630fd4c8f4ec",
                                        "entry_id": "47870d1c-16b2-3571-bd6e-f697c78b01bc",
                                        "glosses": [
                                            "A rough guess; an estimate or swag."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe7fdcfc-1fd3-4361-8e0f-b7adb82c7937",
                                                "sense_id": "3466b307-c150-346e-9b3e-630fd4c8f4ec",
                                                "text": "Take a swipe at the answer, even if you're not sure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "207d8983-b804-34c4-8c19-dce9d5e9dbce",
                                        "entry_id": "47870d1c-16b2-3571-bd6e-f697c78b01bc",
                                        "glosses": [
                                            "An attack, insult or critical remark."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbc88585-3edf-4f56-996d-d0b2f3615ec6",
                                                "sense_id": "207d8983-b804-34c4-8c19-dce9d5e9dbce",
                                                "text": "The politician took a swipe at his opponents."
                                            },
                                            {
                                                "example_id": "212003ca-4d25-4cc7-a5dd-ed9d01b4c6fc",
                                                "sense_id": "207d8983-b804-34c4-8c19-dce9d5e9dbce",
                                                "text": "Biden‘s Twitter account then acknowledged the swipe, quote-tweeting Sanders shortly after the debate saying, “I’ve worked my whole life to overcome a stutter. And it’s my great honor to mentor kids who have experienced the same. It’s called empathy. Look it up.”"
                                            },
                                            {
                                                "example_id": "ec046fe3-d971-4cb8-9f8f-ed366c4d53f2",
                                                "sense_id": "207d8983-b804-34c4-8c19-dce9d5e9dbce",
                                                "text": "Harry took a swipe at the palace's response to a story published in 2020 suggesting the Sussexes were leaving the royal family because William had bullied them out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd60150-0200-3fcb-be05-611d062a3200",
                                        "entry_id": "47870d1c-16b2-3571-bd6e-f697c78b01bc",
                                        "glosses": [
                                            "Poor, weak beer or other inferior alcoholic beverage; rotgut."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc814a17-0d2c-4468-a553-2c052122fa3f",
                                                "sense_id": "2dd60150-0200-3fcb-be05-611d062a3200",
                                                "text": "Woozy with swipe was the only way I could stay down with patience for work."
                                            },
                                            {
                                                "example_id": "8e203474-042a-4351-9fc2-7d239e25c493",
                                                "sense_id": "2dd60150-0200-3fcb-be05-611d062a3200",
                                                "text": "JJ: Did a lot of people drink? KP: Down here, oh yeah, a lot of them made their own swipe, their own potato and pineapple swipe."
                                            },
                                            {
                                                "example_id": "b8a032ba-ba3f-4731-82b9-8d843ff2be69",
                                                "sense_id": "2dd60150-0200-3fcb-be05-611d062a3200",
                                                "text": "Sung Wha knows it's pineapple swipe they are drinking. Hoping that they might sell him some of the stuff, he approaches them with the dollar bill out. One worker, sucking on a fat, wet stub of a cigar, waves off the offer and shakes his head: no we aren't selling the swipe, the swipe is for us to drink and enjoy."
                                            },
                                            {
                                                "example_id": "f165261d-3341-4bf8-8f06-b7daa97b236c",
                                                "sense_id": "2dd60150-0200-3fcb-be05-611d062a3200",
                                                "text": "Only the nights—of sitting out in the moonlight drinking the horrible tasting swipe and talking, the thinking about women —remained unchanged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
