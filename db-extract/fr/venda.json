            {
                "entry_id": "029432b8-c2ca-3bd1-9509-d5adc033d5d4",
                "word": "Venda",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d0982497-49b7-3541-9c68-14368a8f08a3",
                        "entry_id": "029432b8-c2ca-3bd1-9509-d5adc033d5d4",
                        "glosses": [
                            "Ancien bantoustan de l’ancienne province du Transvaal d’Afrique du Sud, aujourd’hui dans le Limpopo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47f59bf0-ffd3-4c01-8aaf-47a30c258e60",
                                "sense_id": "d0982497-49b7-3541-9c68-14368a8f08a3",
                                "text": "Le Venda fut un État indépendant non reconnu de 1979 à 1994 dans le cadre du régime d’apartheid. Il regroupait principalement des Africains de l’ethnie venda."
                            }
                        ]
                    },
                    {
                        "sense_id": "928bf692-2e1d-3411-af0e-6c6dc64bdb6c",
                        "entry_id": "029432b8-c2ca-3bd1-9509-d5adc033d5d4",
                        "glosses": [
                            "Ethnie du Sud de l'Afrique, notamment dans la région de Venda."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48e24a93-8e66-464d-8229-ecc6cc3fa601",
                        "source_entry_id": "029432b8-c2ca-3bd1-9509-d5adc033d5d4",
                        "target_lang_word": "Venda",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Venda",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60f95db8-ddc3-37d7-bb6e-56cfd5c30687",
                                        "entry_id": "888b84c2-8332-32f5-8cd1-414be7cc630b",
                                        "glosses": [
                                            "Sprache, die vor allem in Südafrika und zum Teil in Simbabwe gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0cbbbb2-db3d-4603-8e80-3d362709cfa0",
                                                "sense_id": "60f95db8-ddc3-37d7-bb6e-56cfd5c30687",
                                                "text": "„Hinzu kämen die beiden »kleinen« Sprachen Tsonga und Venda, die keiner der beiden größeren Sprachgruppen angehören.“"
                                            },
                                            {
                                                "example_id": "de4bc88e-bcf3-401f-ac95-f1863e025cb0",
                                                "sense_id": "60f95db8-ddc3-37d7-bb6e-56cfd5c30687",
                                                "text": "„Neben Englisch und Afrikaans fanden Zulu, Xhosa, Swasi, Sotho, Pedi, Venda, Tswana, Tsonga und Ndebele Eingang in die Verfassung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6cf3152-79c0-470b-acab-960268d5693a",
                        "source_entry_id": "029432b8-c2ca-3bd1-9509-d5adc033d5d4",
                        "target_lang_word": "Venda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
