                "senses": [
                    {
                        "sense_id": "c8245997-9afd-35a3-9da8-f8b56c259b5a",
                        "entry_id": "8c518327-3402-3e17-afd7-dd4a1e1172e4",
                        "glosses": [
                            "toter Körper eines Menschen, welcher üblicherweise mehrere hundert Jahre versunken im Moor lag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07e92983-57a2-45f5-af5b-e0377ae6246d",
                                "sense_id": "c8245997-9afd-35a3-9da8-f8b56c259b5a",
                                "text": "Die erste wissenschaftliche Untersuchung an einer Moorleiche führte die irische Gräfin von Moira im Jahre 1781 durch, allerdings dauerte es noch einige Jahrzehnte, bis Moorleichen in der Wissenschaft stärkere Beachtung fanden."
                            },
                            {
                                "example_id": "c3f13411-92db-479e-970a-a278b0f1e92c",
                                "sense_id": "c8245997-9afd-35a3-9da8-f8b56c259b5a",
                                "text": "„Etliche der Moorleichen sind erst lange nach ihrem Ableben von monströsen Mammutpflügen zerstückelt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "661493dc-a929-4b5e-8a45-5638eb3380ee",
                        "source_entry_id": "8c518327-3402-3e17-afd7-dd4a1e1172e4",
                        "source_sense_id": "c8245997-9afd-35a3-9da8-f8b56c259b5a",
                        "source_sense_description": "toter Körper eines Menschen, welcher üblicherweise mehrere hundert Jahre versunken im Moor lag",
                        "target_lang_word": "bog body",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bog body",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c52523c6-31cd-390c-8009-2296bf70cc0c",
                                        "entry_id": "dac75e85-4dd7-33f8-8eac-e8af7ca6bfda",
                                        "glosses": [
                                            "A human cadaver that has been naturally mummified in a peat bog."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58cced3d-16bf-4972-bd67-66ee346860f8",
                                                "sense_id": "c52523c6-31cd-390c-8009-2296bf70cc0c",
                                                "text": "1996, D. Brothwell, European bog bodies: current state of research and preservation, Konrad Spindler, Harald Wilfing, Elisabeth Rastbichler-Zissernig, Dieter zur Nedden, Hans Nothdurfter (editors), The Man in the Ice, Volume 3: Human Mummies, Springer, page 161,\nRecords of bog body discoveries extend back to 1640, this date referring to a find in Shalkholz Fen in Schleswig Holstein (Glob, 1969)."
                                            },
                                            {
                                                "example_id": "046180ce-1a26-44f3-a4bb-a5b58c268c4c",
                                                "sense_id": "c52523c6-31cd-390c-8009-2296bf70cc0c",
                                                "text": "The presence of particles of Sphagnum in a sample of stomach contents of a bog body has been cited as evidence that the victim drank bog water with her/his last meal (Fisher, 1998)."
                                            },
                                            {
                                                "example_id": "17d09f19-d648-499f-b5e2-fa5ead16c5a6",
                                                "sense_id": "c52523c6-31cd-390c-8009-2296bf70cc0c",
                                                "text": "Recently excavated bog bodies have been intensively recorded, analyzed in great detail, and conserved for long-term preservation and museum display."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
