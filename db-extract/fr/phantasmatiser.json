                ],
                "senses": [
                    {
                        "sense_id": "cbf2d29e-9a19-3070-a06e-f11de628f825",
                        "entry_id": "ac15c289-ce5e-3561-9398-2143219e8241",
                        "glosses": [
                            "Autre orthographe, plus rare, de fantasmatiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "366d5ff7-ce3e-4cb8-8ba1-17c45f497675",
                                "sense_id": "cbf2d29e-9a19-3070-a06e-f11de628f825",
                                "text": "Nous trouvons cet élément aussi bien dans l’apathie sadique que dans l’idéal du froid masochiste : « théorisé » dans l’apathie, « phantasmatisé » dans l’idéal."
                            },
                            {
                                "example_id": "4f87ca6c-0c12-41d5-ba2c-162569ba54d4",
                                "sense_id": "cbf2d29e-9a19-3070-a06e-f11de628f825",
                                "text": "Nous nous bornerons donc à dresser des listes de termes inductifs, à proposer des têtes de chapitre ou de paragraphe, laissant au lecteur désireux d’aller plus loin la tâche apparemment facile de « phantasmatiser » autour de ce que nous lui proposons de la façon qui lui conviendra le mieux."
                            }
                        ]
                    }
                ],
