                    ]
                },
                {
                    "sense_id": "804f42a5-41ad-3aa8-a3dc-14c8297a9c21",
                    "sense_definition": "Art, Stoff oder Gegenstand, der beispielhaft für eine Gruppe mit gleichen Eigenschaften steht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repraesentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Wolf ist der bekannteste wilde <w>Vertreter</w> aus der Familie der Hundeartigen."
                        },
                        {
                            "text": "Methanol gilt in der organischen Chemie als einfachster <w>Vertreter</w> aus der Gruppe der Alkohole."
