                                        "sense_id": "2d15f77e-a39e-35ac-960f-42b9c88059e3",
                                        "entry_id": "d6150dc0-436b-39f3-9284-d84902a9eab0",
                                        "glosses": [
                                            "The property of being ruthless."
                                        ],
                                        "tags": [
                                            "uncountable",
