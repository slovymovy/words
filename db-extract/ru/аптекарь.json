                ],
                "senses": [
                    {
                        "sense_id": "4c404c4e-36e3-3c3b-a7f8-e4249551b65a",
                        "entry_id": "eebca3fb-9fba-3c7a-a2fd-90645f4e90f7",
                        "glosses": [
                            "работник аптеки; владелец аптеки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c093ad94-da92-43cb-8d2f-0fe3da192dd1",
                                "sense_id": "4c404c4e-36e3-3c3b-a7f8-e4249551b65a",
                                "text": "Монпельевские доктора ничего не пишут, а обыкновенно, осмотря больных, ходят сами в аптеку и словесно приказывают аптекарям, что приготовить."
                            },
                            {
                                "example_id": "9573275f-0b5c-48b3-9466-aad39f6bbce3",
                                "sense_id": "4c404c4e-36e3-3c3b-a7f8-e4249551b65a",
                                "text": "Мать нашего пастора советует ему употреблять вместо чаю красный бедринец, цветок очень обыкновенный, — я отыскала и латинское его название, — всякой аптекарь тебе укажет его."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5806b762-2a2d-4c02-ab04-4cb0c4b41eb6",
                        "source_entry_id": "eebca3fb-9fba-3c7a-a2fd-90645f4e90f7",
                        "source_sense_id": "4c404c4e-36e3-3c3b-a7f8-e4249551b65a",
                        "target_lang_word": "pharmacist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pharmacist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d049902-d62f-3c35-9bd2-b519de5301f1",
                                        "entry_id": "5bc79c19-c47c-3d17-a249-479a35ce81fb",
                                        "glosses": [
                                            "A health professional who controls, formulates, preserves, and dispenses medications and provides medical advice and counseling on how medicines should be used in order to achieve maximum benefit, and minimal side effects in order to avoid drug interactions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14be8282-495f-48c0-a376-eeacadccc211",
                                                "sense_id": "6d049902-d62f-3c35-9bd2-b519de5301f1",
                                                "text": "He has served as a prescriptionist to the leading pharmacists of the old country, and been employed in many of our American cities."
                                            },
                                            {
                                                "example_id": "15387852-6c96-4cef-90e0-3b8a55de5159",
                                                "sense_id": "6d049902-d62f-3c35-9bd2-b519de5301f1",
                                                "text": "By Admir, pharmacist by profession and hobby dronist by passion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78c77034-62b7-3d65-b61e-0c954fb3cdd2",
                                        "entry_id": "5bc79c19-c47c-3d17-a249-479a35ce81fb",
                                        "glosses": [
                                            "One who studies pharmacy."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
