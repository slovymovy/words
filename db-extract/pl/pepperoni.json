                                    {
                                        "sense_id": "177ebd53-b6ba-3ee2-9375-9472f55ca415",
                                        "entry_id": "0edeaa4b-827d-315c-a2c0-503dc598b8c3",
                                        "glosses": [
                                            "A spicy salami-style Italian-American sausage made from cured pork and beef seasoned with pepper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f681d9f0-9899-4ad2-9308-dd64ca675d65",
                                                "sense_id": "177ebd53-b6ba-3ee2-9375-9472f55ca415",
                                                "text": "He gave the dog a treat — a dried up skinny, turdy looking, pepperoni sausage."
                                            },
                                            {
                                                "example_id": "71dd41d6-24a7-4c3e-b165-d6d8c2ba14c3",
                                                "sense_id": "177ebd53-b6ba-3ee2-9375-9472f55ca415",
                                                "text": "She and her two best friends are choreographing a number for the talent show; she’s applied to California Institute of the Arts; and she flirts unabashedly with a cute pizza server. (The better to land a couple of extra pepperonis on her slice without an upcharge.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a5414cf-1383-3551-a042-e165ee5ab678",
                                        "entry_id": "0edeaa4b-827d-315c-a2c0-503dc598b8c3",
                                        "glosses": [
                                            "Pizza with only tomato sauce, cheese and pepperoni toppings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8db598d-2fc1-4af8-91bf-a97e15d271b1",
                                                "sense_id": "6a5414cf-1383-3551-a042-e165ee5ab678",
                                                "text": "Yo, Tony, gimme a slice of pepperoni and a coke."
                                            },
                                            {
                                                "example_id": "b0a67c00-ce23-4206-9912-d53217ffc75d",
                                                "sense_id": "6a5414cf-1383-3551-a042-e165ee5ab678",
                                                "text": "There's far more than just hot dogs to feast on too. The pizzas—gigantic, floppy, with a hyperreal waxy sheen—are mythic. They arrive exclusively in cheese, pepperoni, or supreme—the holy trinity—and will run you an eminently affordable $1.99 for a ridiculously huge wedge-shaped slice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
