                    {
                        "sense_id": "27645583-5a40-3f99-ac30-0bceddb8bbdb",
                        "entry_id": "0cf16f8d-cb93-3043-a899-c2fc47e47ec1",
                        "glosses": [
                            "jemand, der an einer Hochschule die Theologie studiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa627d4f-56a3-4658-b96d-b6265c5755d4",
                                "sense_id": "27645583-5a40-3f99-ac30-0bceddb8bbdb",
                                "text": "Bereits als junger Theologiestudent hat er sich in der Mission engagiert."
                            },
                            {
                                "example_id": "966d4c37-b7a2-44fc-9f08-7b7f4a7e403a",
                                "sense_id": "27645583-5a40-3f99-ac30-0bceddb8bbdb",
                                "text": "Die Zahl der Theologiestudenten ist in den letzten Jahren stark zurück gegangen."
                            },
                            {
                                "example_id": "4df0339e-1614-49d9-beb8-625ca7e33527",
                                "sense_id": "27645583-5a40-3f99-ac30-0bceddb8bbdb",
                                "text": "„Die meisten von Roths etwa zwanzig Hausgenossen waren evangelische Theologiestudenten, doch in der Fakultät für englische Literatur freundete er sich rasch mit zwei jüdischen Studenten an – Barry Targan und Herb Haber –, die wenig später ebenfalls ins Divinity House zogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
