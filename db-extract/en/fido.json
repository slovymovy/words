                "translations": [
                    {
                        "translation_id": "4abc0f49-5693-4f2c-846f-7f83def54f3e",
                        "source_entry_id": "b368a19c-d777-345d-9197-0a19ba7e2cd0",
                        "source_sense_id": "d2d5c196-885a-3c1d-a295-bd3b91f4c21d",
                        "source_sense_description": "incorrectly minted coin",
                        "target_lang_word": "Fehlprägung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fehlprägung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a24806d8-37b9-35e1-8cbc-39920da05f14",
                                        "entry_id": "e9a91c61-1d50-3cbd-9fc9-8bfb17ee607f",
                                        "glosses": [
                                            "Münze mit einem Herstellungsfehler"
                                        ],
                                        "tags": [
                                            "Numismatik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61a2d0ef-7567-45d1-aac6-5ebf901a9299",
                                                "sense_id": "a24806d8-37b9-35e1-8cbc-39920da05f14",
                                                "text": "Münzsammler sind an zahlreichen Arten von Fehlprägungen interessiert, beispielsweise Mehrfachprägungen oder Materialverwechslungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2fcff9f3-8177-3cd2-ad65-1c8a24e64bc1",
                                        "entry_id": "e9a91c61-1d50-3cbd-9fc9-8bfb17ee607f",
                                        "glosses": [
                                            "Erlebnis in der Kindheit, welches zu abweichenden Verhaltensmustern eines Menschen oder Tieres führt"
                                        ],
                                        "tags": [
                                            "Verhaltensbiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d14cf5a-f754-4136-87cc-e0725132f3ea",
                                                "sense_id": "2fcff9f3-8177-3cd2-ad65-1c8a24e64bc1",
                                                "text": "„Pseudoepileptische Anfälle, Bettnässen, lebenslange Allergien, das sind noch, so berichten Ärzte, die weniger schrecklichen Folgen des Vertrauensverlustes, der Mißhandlung und Fehlprägung, die sie als Kinder erleiden.“"
                                            },
                                            {
                                                "example_id": "96c6cee8-c9e0-4462-becc-72e9d8f4b9a7",
                                                "sense_id": "2fcff9f3-8177-3cd2-ad65-1c8a24e64bc1",
                                                "text": "„‚Alles läuft ohne Sichtkontakt zu Menschen, um Fehlprägungen der Jungvögel zu vermeiden‘, erklärt Margit Meergans.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
