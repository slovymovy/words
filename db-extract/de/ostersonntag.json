                                        "entry_id": "de7219ab-1e3f-3025-9c9e-1227912d4338",
                                        "glosses": [
                                            "Dimanche du temps de Pâques (entre Pâques et la Pentecôte)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1b03763-bf2e-43da-8bda-80381cc3a781",
                                                "sense_id": "cd245001-5412-315c-9305-bbd53d68c6c9",
                                                "text": "En ce troisième dimanche de Pâques, l'Église continue de nous faire lire les évangiles de la résurrection."
                                            },
                                            {
                                                "example_id": "9b781367-2ecd-4993-bd79-b20514951ce3",
                                                "sense_id": "cd245001-5412-315c-9305-bbd53d68c6c9",
                                                "text": "Aussi la liturgie ne parle-t-elle pas de dimanches après Pâques, mais des huit dimanches de Pâques (le huitième étant la fête de la Pentecôte)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
