                    "target_lang_definitions": {
                        "ru": "Река в Восточной Европе, протекающая через Беларусь, Польшу и Украину.",
                        "tr": "Belarus, Polonya ve Ukrayna'dan geçen Doğu Avrupa'daki bir nehir."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Буг",
                                "target_lang_sense_clarification": "река"
                            }
                        ],
                        "tr": [
