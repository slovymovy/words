            "pos": "verb",
            "senses": [
                {
                    "sense_id": "067a2b3f-80a9-39d1-93b4-385659a56cb5",
                    "sense_definition": "Changer de voix à la puberté en devenant plus grave, en parlant d'un adolescent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À quatorze ans, le jeune garçon commence à <w>muer</w> et hésite parfois à parler fort."
                        },
                        {
                            "text": "Sa voix <w>mue</w> rapidement depuis quelques mois, alternant entre des aigus et des graves."
                        }
                    ],
                    "common_phrases": [
                        "voix qui mue"
                    ]
                },
                {
                    "sense_id": "a9973c38-3702-3fbf-aec2-de96249adc41",
                    "sense_definition": "Renouveler naturellement sa peau, sa carapace, ses poils ou ses plumes, en parlant d'un animal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque printemps, ce serpent <w>mue</w> pour renouveler entièrement son ancienne peau."
                        },
                        {
                            "text": "Certains oiseaux <w>muent</w> à la fin de l'été afin de préparer leur plumage d'hiver."
                        }
                    ],
                    "common_phrases": [
                        "serpent qui mue"
                    ]
                },
                {
                    "sense_id": "5d77dae8-f4bf-3b14-aafb-87b205e87a11",
                    "sense_definition": "Se transformer profondément ou changer de nature pour devenir autre chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "changement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec le temps, leur simple amitié s'est <w>muée</w> en un amour sincère et durable."
                        },
                        {
                            "text": "Le débat calme du début s'est soudainement <w>mué</w> en une dispute animée entre les participants."
                        }
                    ],
                    "synonyms": [
                        "se métamorphoser",
                        "se transformer"
                    ],
                    "antonyms": [
                        "demeurer",
                        "rester"
                    ],
                    "common_phrases": [
                        "se muer en"
                    ]
                }
            ]
        }
    ]
