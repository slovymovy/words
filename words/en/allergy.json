{
    "word_family": [
        "allergic",
        "allergen",
        "allergenic",
        "allergist",
        "allergology"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84fb4abc-e5ed-39f4-ac96-20c875acdd0d",
                    "sense_definition": "A medical condition where the immune system reacts abnormally to a foreign substance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a severe <w>allergy</w> to peanuts and must carry an EpiPen at all times.",
                            "target_lang_translations": {
                                "ru": "У неё сильная <w>аллергия</w> на арахис, и она всегда должна иметь при себе шприц-тюбик с адреналином."
                            }
                        },
                        {
                            "text": "Many people suffer from a seasonal <w>allergy</w> when the pollen count is high in spring.",
                            "target_lang_translations": {
                                "ru": "Многие люди страдают от сезонной <w>аллергии</w>, когда весной концентрация пыльцы в воздухе высока."
                            }
                        }
                    ],
                    "synonyms": [
                        "intolerance"
                    ],
                    "common_phrases": [
                        "food allergy",
                        "seasonal allergy",
                        "severe allergy",
                        "pollen allergy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинское состояние, при котором иммунная система аномально реагирует на чужеродное вещество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аллергия",
                                "target_lang_sense_clarification": "медицинское состояние"
                            },
                            {
                                "target_lang_word": "непереносимость",
                                "target_lang_sense_clarification": "организма к веществам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf6aa908-c941-3865-9584-4b8def7d6085",
                    "sense_definition": "A specific type of immune system hypersensitivity mediated by immunoglobulin E.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was diagnosed with a type 1 hypersensitivity <w>allergy</w> after the skin prick test.",
                            "target_lang_translations": {
                                "ru": "После кожной пробы у пациента была диагностирована <w>аллергия</w> в виде гиперчувствительности первого типа."
                            }
                        },
                        {
                            "text": "Clinical research focuses on how this specific <w>allergy</w> triggers an immediate inflammatory response.",
                            "target_lang_translations": {
                                "ru": "Клинические исследования сосредоточены на том, как эта конкретная <w>аллергия</w> вызывает немедленную воспалительную реакцию."
                            }
                        }
                    ],
                    "synonyms": [
                        "type 1 hypersensitivity"
                    ],
                    "common_phrases": [
                        "type 1 allergy"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфический тип гиперчувствительности иммунной системы, опосредованный иммуноглобулином E."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аллергия",
                                "target_lang_sense_clarification": "медицинский термин"
                            },
                            {
                                "target_lang_word": "гиперчувствительность",
                                "target_lang_sense_clarification": "иммунной системы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70f810bc-02a2-3afd-a2e5-85c2f451cc37",
                    "sense_definition": "A strong dislike or aversion toward a person, thing, or activity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dislike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a literal <w>allergy</w> to hard work and avoids it whenever possible.",
                            "target_lang_translations": {
                                "ru": "У него буквально <w>аллергия</w> на тяжелую работу, и он избегает её при любой возможности."
                            }
                        },
                        {
                            "text": "My sister has developed an <w>allergy</w> to reality TV after watching too many episodes.",
                            "target_lang_translations": {
                                "ru": "У моей сестры развилась <w>аллергия</w> на реалити-шоу после просмотра слишком большого количества серий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "allergy to work",
                        "allergy to exercise"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used figuratively"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная неприязнь или отвращение к человеку, вещи или деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аллергия",
                                "target_lang_sense_clarification": "переносное значение, неприязнь"
                            },
                            {
                                "target_lang_word": "неприязнь",
                                "target_lang_sense_clarification": "сильное отвращение"
                            },
                            {
                                "target_lang_word": "антипатия",
                                "target_lang_sense_clarification": "к чему-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}