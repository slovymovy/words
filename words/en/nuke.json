                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law was a legislative <w>nuke</w> that wiped out years of progress.",
                            "target_lang_translations": {
                                "ru": "Новый закон стал законодательной <w>бомбой</w>, перечеркнувшей годы прогресса."
                            }
                        },
                        {
                            "text": "The scandal acted as a <w>nuke</w> to his political career.",
                            "target_lang_translations": {
                                "ru": "Скандал стал <w>крахом</w> для его политической карьеры."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что разрушает или сводит на нет, особенно в катастрофических масштабах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бомба",
                                "target_lang_sense_clarification": "метафора разрушительного события"
                            },
                            {
                                "target_lang_word": "крах",
                                "target_lang_sense_clarification": "полное разрушение чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17d0806d-cb39-39ab-bb38-d19421f3930e",
