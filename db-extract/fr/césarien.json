                                "sense_id": "9eaba551-fcef-3c10-bd37-e84f129bd46b",
                                "text": "Opération césarienne, ou césarienne, par ellipse."
                            },
                            {
                                "example_id": "f42979ed-918e-4a13-ac5a-61e07ac6652a",
                                "sense_id": "9eaba551-fcef-3c10-bd37-e84f129bd46b",
                                "text": "Opérer une section césarienne."
                            },
                            {
                                "example_id": "cc5522f5-bfbf-486e-9d8f-b8dc8aef411c",
                                "sense_id": "9eaba551-fcef-3c10-bd37-e84f129bd46b",
                                "text": "Un enfantement césarien."
                            }
                        ]
