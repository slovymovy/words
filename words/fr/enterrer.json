            "senses": [
                {
                    "sense_id": "1064a9b2-d6d1-3bd2-a5c1-f85ed4773539",
                    "sense_definition": "Mettre le corps d'un défunt en terre au cours d'obsèques.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "funerailles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille s'est réunie au cimetière pour <w>enterrer</w> le grand-père avec dignité."
                        },
                        {
                            "text": "Il a laissé des instructions très précises pour se faire <w>enterrer</w> près de l'océan."
                        }
                    ],
                    "synonyms": [
                        "ensevelir"
                    ],
                    "antonyms": [
                        "déterrer"
                    ],
                    "common_phrases": [
                        "enterrer un mort",
                        "se faire enterrer"
                    ]
                },
                {
                    "sense_id": "e9ab9704-10c1-30d7-acbc-ef5a7310d248",
                    "sense_definition": "Enfouir un objet ou une substance dans le sol pour le cacher ou le conserver.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enfouir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pirate a décidé d'<w>enterrer</w> son trésor sur une île déserte pour le protéger."
                        },
                        {
                            "text": "Le chien aime <w>enterrer</w> des os au fond du jardin pour les ronger plus tard."
                        }
                    ],
                    "antonyms": [
                        "déterrer"
                    ],
                    "common_phrases": [
                        "enterrer un trésor",
                        "enterrer des graines"
                    ]
                },
                {
                    "sense_id": "113a966c-79a7-3f07-8197-214cefc91ce0",
                    "sense_definition": "Abandonner définitivement un projet, une loi ou une idée, ou faire en sorte qu'ils n'aboutissent pas.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fig_abandon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs semaines de vives contestations, le gouvernement a préféré <w>enterrer</w> cette réforme controversée."
                        },
                        {
                            "text": "Les élus locaux ont rapidement décidé d'<w>enterrer</w> le dossier en raison de son coût excessif."
