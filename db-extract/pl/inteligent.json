                "senses": [
                    {
                        "sense_id": "585a44ed-2a2d-30e4-8e1b-984a115cd579",
                        "entry_id": "34e64c66-d6c1-3311-b361-cc9c06194b0b",
                        "glosses": [
                            "mężczyzna wykształcony, zawodowo zajmujący się pracą umysłową"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd539a49-3ace-46ac-8e98-1ee91ddbaad4",
                                "sense_id": "585a44ed-2a2d-30e4-8e1b-984a115cd579",
                                "text": "Co my zresztą dziwimy się różnym chłopom, kiedy teraz tysiące inteligentów, mądrych, wykształconych zajmuje bezsensowne, głupie stanowisko."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
