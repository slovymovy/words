                                                "sense_id": "e3d69a79-58c6-36c0-9cd1-319df299a1f3",
                                                "text": "Wir haben uns gern."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6c0952af-7595-3752-b659-b1a345b76d5e",
