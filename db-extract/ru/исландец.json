                        "source_sense_id": "33cf0a68-951d-3a1b-afed-3e2f798110dc",
                        "target_lang_word": "Icelander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Icelander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ac4db4c-30cf-3641-9cba-94b1bf0a7ab5",
                                        "entry_id": "881a4c28-6b63-3ad2-8eb4-9d5e9ab82aa5",
