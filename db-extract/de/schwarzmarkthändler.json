                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3125540-9d40-3a2f-9d55-bbba73033805",
                        "entry_id": "4eee7a75-876b-3b19-9cfc-570574753bbf",
                        "glosses": [
                            "Person, die auf dem Schwarzmarkt handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fc628e1-2cac-4b0d-9643-e6bc38d4fbfd",
                                "sense_id": "d3125540-9d40-3a2f-9d55-bbba73033805",
                                "text": "„Ich war etwas skeptisch gegenüber der Grenzstadt, die ja oft ein bisschen zwielichtig sind, voller Schwarzmarkthändler und aufdringlicher Geldwechsler, fand aber zu meiner Erleichterung eine ruhige, staubige Ortschaft vor.“"
                            },
                            {
                                "example_id": "395a35e4-6919-4e37-9b4c-8b5fea00a136",
                                "sense_id": "d3125540-9d40-3a2f-9d55-bbba73033805",
                                "text": "„Wenn die Ware über die Grenze gebracht war, wurde sie auf deutscher Seite an die Zwischenhändler verkauft, und von dort aus ging sie an die Schwarzmarkthändler in Köln und ins Ruhrgebiet.“"
                            },
                            {
                                "example_id": "646660f8-582a-467a-bab4-f30f5eb3fe05",
                                "sense_id": "d3125540-9d40-3a2f-9d55-bbba73033805",
                                "text": "„Er hatte das Gefühl, dass man ihn beobachtete, aber wie sollte er unter den Straßenverkäufern und Schwarzmarkthändlern die Abgesandten des Feindes erkennen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c4970d2-3576-4a7b-81c2-16505fffc7e3",
