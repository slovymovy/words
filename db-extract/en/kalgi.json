                ],
                "senses": [
                    {
                        "sense_id": "5bcdcfdc-2596-33c5-9ee1-10ccec331f9f",
                        "entry_id": "0309102c-02df-3f34-a448-160133e263aa",
                        "glosses": [
                            "A prisoner of war taken by the native Alaskan Alutiiq people and kept as a slave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e76e02f-b989-4d1c-a6c5-ae422da054b2",
                                "sense_id": "5bcdcfdc-2596-33c5-9ee1-10ccec331f9f",
                                "text": "Strong and brave warriors could have concubines from among their kalgi, that is, female war captives. Children, born of such captives were not accounted as kalgi."
                            },
                            {
                                "example_id": "c231c791-4818-4c54-a12a-82eb14a38edb",
                                "sense_id": "5bcdcfdc-2596-33c5-9ee1-10ccec331f9f",
                                "text": "When Shelikhov arrived on Kodiak many kalgi, in hope of a better fate, crossed over to the Russians."
                            },
                            {
                                "example_id": "6d5c0e06-c9ae-40e6-ad80-2eb24f01aa1d",
                                "sense_id": "5bcdcfdc-2596-33c5-9ee1-10ccec331f9f",
                                "text": "When Shelikhov arrived at Kodiak, hoping to receive better treatment, many kalgi turned to the Russians."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbda6102-e933-3b46-8041-1419c9df51e5",
                        "entry_id": "0309102c-02df-3f34-a448-160133e263aa",
                        "glosses": [
                            "One of a set of conjoined igloos that form an apartment-like arrangement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e70eec6c-7b74-412d-a246-daab079587f4",
                                "sense_id": "dbda6102-e933-3b46-8041-1419c9df51e5",
                                "text": "The kalgi had low roofs, just taller than a man, but they were very wide."
                            }
                        ]
                    }
                ],
