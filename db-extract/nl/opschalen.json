                "senses": [
                    {
                        "sense_id": "5961e788-4429-31ff-b583-c80bf17bdb6f",
                        "entry_id": "0f4c64d9-ba66-3deb-94df-0b30b441a6c0",
                        "glosses": [
                            "to scale up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0ba81d5-c11f-4c43-b243-c39afd64b371",
                                "sense_id": "5961e788-4429-31ff-b583-c80bf17bdb6f",
                                "text": "Ontdek hoe we uw chemische productie kunnen opschalen.",
                                "translation": "Discover how we can scale up your chemical production.",
                                "english": "Discover how we can scale up your chemical production."
                            }
                        ]
                    },
                    {
                        "sense_id": "c61d9019-c972-3858-8f99-f0eb172af572",
                        "entry_id": "0f4c64d9-ba66-3deb-94df-0b30b441a6c0",
                        "glosses": [
                            "to increase the mobilisation or deployment of emergency services during a crisis or catastrophy"
