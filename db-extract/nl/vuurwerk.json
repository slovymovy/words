                    },
                    {
                        "form_id": "b3fa855d-46d9-409b-9a7e-497823837bfb",
                        "entry_id": "31956be5-03ec-36d8-972a-5f70e9459d3b",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "vuurwerkje"
                    },
                    {
                        "form_id": "a97cd094-c6b4-4dc5-abc9-8148b7946198",
                        "entry_id": "31956be5-03ec-36d8-972a-5f70e9459d3b",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "vuurwerkjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2af9dcf-fd23-3eba-b8cb-a0a8e105f9de",
                        "entry_id": "31956be5-03ec-36d8-972a-5f70e9459d3b",
                        "glosses": [
                            "één of meerdere voorwerpen die gevuld zijn met ontploffende, brandbare en lichtgevende stofmengsels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90acca91-ccbc-4dba-aa49-ff92cd56fd33",
                                "sense_id": "c2af9dcf-fd23-3eba-b8cb-a0a8e105f9de",
                                "text": "Wij steken altijd vuurwerk af in onze straat."
                            },
                            {
                                "example_id": "641f3b63-cd3c-40db-a8ac-d10c5c8f3c7f",
                                "sense_id": "c2af9dcf-fd23-3eba-b8cb-a0a8e105f9de",
                                "text": "Des avons was de heele stadt verlicht en om 10 uren wiert een schoon vuurwerk op de Mart, voor het huijs van den heer prefect geplaest, afgeschoten, welke tot elf uren geduerde en onder het afschieten van eene menigte logtfuseijen veele konstige werken in het vuur vertoonde, veel schoonder als men nog een vuurwerk geduerende al den Franschen tijdt gesien heeft.⧖"
                            },
                            {
                                "example_id": "b91c00aa-1e29-4055-a183-cebfec8c34a2",
                                "sense_id": "c2af9dcf-fd23-3eba-b8cb-a0a8e105f9de",
                                "text": "En na de wedstrijd veranderde het centrum in een groot feest. Duizenden mensen verzamelden zich op De Brink in de binnenstad. \"We gaan Europa in\", klonk het massaal. Er werd ook vuurwerk afgestoken."
                            }
                        ]
                    },
                    {
                        "sense_id": "d36c6851-4c9f-3555-b533-690c56e27083",
                        "entry_id": "31956be5-03ec-36d8-972a-5f70e9459d3b",
                        "glosses": [
                            "een hoop onrust en gedoe"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "88a5200b-aa2e-4fba-83e2-d52e8548a23e",
                                "sense_id": "d36c6851-4c9f-3555-b533-690c56e27083",
                                "text": "Als de VVD echt besluit met Saelens in zee te gaan, kunnen we nog heel wat vuurwerk verwachten."
                            },
                            {
                                "example_id": "e5ff86bc-eee2-4f9c-ad48-5878a8502838",
                                "sense_id": "d36c6851-4c9f-3555-b533-690c56e27083",
                                "text": "Terwijl de steradvocaat een vuurwerk van verontwaardiging afstak tegen directeur Curtholmen voor de ongeëvenaarde brutaliteit om je eisen deels te baseren op laster en deels op morele regels die eerder thuishoorden in de negentiende eeuw dan in onze tijd, besefte Eric dat hij het helemaal eens was met bijna alles wat de tegenpartij beweerde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e24b070-6bcf-4cb4-bc4a-9768a55d2600",
                        "source_entry_id": "31956be5-03ec-36d8-972a-5f70e9459d3b",
                        "source_sense_id": "c2af9dcf-fd23-3eba-b8cb-a0a8e105f9de",
                        "source_sense_description": "voorwerpen die gevuld zijn met ontploffende, brandbare en lichtgevende stofmengsels",
                        "target_lang_word": "Feuerwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2217835-7836-3e0f-a65e-26c3076cfee3",
                                        "entry_id": "cc79e3bd-e69e-30d8-8744-994ed0ef82c1",
                                        "glosses": [
                                            "Vorführung mit Raketen und/oder Knallkörpern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dfb2083-610f-4b49-8d6e-509d1fdf918b",
                                                "sense_id": "d2217835-7836-3e0f-a65e-26c3076cfee3",
                                                "text": "Das war ein schönes Feuerwerk."
                                            },
                                            {
                                                "example_id": "bef9c24a-d0f5-4752-930e-5a63c795fad1",
                                                "sense_id": "d2217835-7836-3e0f-a65e-26c3076cfee3",
                                                "text": "„Am Morgen hast du dann in den Nachrichten gehört, dass das Feuerwerk zu Ehren des fünfzigjährigen Premierministers stattfand, nicht zu deinen.“"
                                            },
                                            {
                                                "example_id": "67721382-b50b-4722-ab32-85f519045fd1",
                                                "sense_id": "d2217835-7836-3e0f-a65e-26c3076cfee3",
                                                "text": "„Dorcus führte Lee Jay auf die Tribüne, wo er das Feuerwerk gut sehen konnte.“"
                                            },
                                            {
                                                "example_id": "2bad6a26-7111-45c2-893e-fdd03fcda95a",
                                                "sense_id": "d2217835-7836-3e0f-a65e-26c3076cfee3",
                                                "text": "„Ihr Bruder Petja hielt sich ebenfalls im Obergeschoss auf: er fabrizierte gerade mit seinem Diener und ehemaligen Kinderwärter ein Feuerwerk, das er in der Nacht abbrennen wollte.“"
                                            },
                                            {
                                                "example_id": "d1bedb24-e2f8-4191-a9ec-1bd203089dd7",
                                                "sense_id": "d2217835-7836-3e0f-a65e-26c3076cfee3",
                                                "text": "„Auf der Terrasse wurde ein Feuerwerk abgebrannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c519041-751e-4c48-b016-2d2198606401",
                        "source_entry_id": "31956be5-03ec-36d8-972a-5f70e9459d3b",
                        "source_sense_id": "c2af9dcf-fd23-3eba-b8cb-a0a8e105f9de",
                        "source_sense_description": "voorwerpen die gevuld zijn met ontploffende, brandbare en lichtgevende stofmengsels",
                        "target_lang_word": "firework",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firework",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f0b6660-3a01-3e88-b12a-4d76483c7101",
                                        "entry_id": "4e98ae1a-6beb-30fc-9a90-f02d61ab45d2",
                                        "glosses": [
                                            "A device using gunpowder and other chemicals which, when lit, emits a combination of coloured flames, sparks, whistles or bangs, and sometimes made to rocket high into the sky before exploding, used for entertainment or celebration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a5e3b6b-31b5-40b2-ae31-7bc33b6b42c2",
                                                "sense_id": "6f0b6660-3a01-3e88-b12a-4d76483c7101",
                                                "text": "Commercial firework displays are commonly launched from boats or other vessels"
                                            },
                                            {
                                                "example_id": "bcb2caaa-91cc-48d3-9333-130605451b65",
                                                "sense_id": "6f0b6660-3a01-3e88-b12a-4d76483c7101",
                                                "text": "Fireworks went off after Australia won the World Cup."
                                            },
                                            {
                                                "example_id": "74f1094e-422c-4727-ac47-73ee09a5f49a",
                                                "sense_id": "6f0b6660-3a01-3e88-b12a-4d76483c7101",
                                                "text": "Saltpetre being the principal ingredient in fireworks, and a volatile body, by reaſon of its aqueous and aërial parts, is eaſily rarified by fire; but not ſo ſoon when foul and groſs, as when purified from its crude and earthy parts, which greatly retard its velocity: therefore, when any quantity of Fireworks are to be made, it ſhould be examined; for if it is not well cleanſed, and of a good ſort, your works will not have their proper effect; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
