                "senses": [
                    {
                        "sense_id": "01f94782-7c33-3946-ab69-543f0e332f5f",
                        "entry_id": "2b279e7d-e861-30c6-8b15-137b1bf82a90",
                        "glosses": [
                            "In Ancient Greek mythology, a kind of spectre sent by Hecate to guard roads and devour travellers."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "a563a8c8-5840-4f97-bc3a-a46a37051c48",
                                "sense_id": "01f94782-7c33-3946-ab69-543f0e332f5f",
                                "text": "1858, \"Empūsa\", entry in William Smith, A Classical Dictionary of Biography, Mythology, and Geography, John Murray, page 240,\nThe Lamiae and Mormolyceia, who assumed the form of handsome women for the purpose of attracting young men, and then sucked their blood like vampyrs and ate their flesh, were reckoned among the Empusae."
                            },
                            {
                                "example_id": "505462d8-9f71-4fa0-a40f-308ce9bcefb4",
                                "sense_id": "01f94782-7c33-3946-ab69-543f0e332f5f",
                                "text": "The empusae of Greek mythology demonstrate physical animal traits of the donkey and the female dog in order to emphasize certain negative characteristics associated with these animals in mythology that can also be applied to human beings."
                            }
                        ]
                    }
                ],
