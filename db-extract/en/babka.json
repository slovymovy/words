                                            {
                                                "example_id": "08b3ae23-8c31-47b9-81ed-0d350dbed8e1",
                                                "sense_id": "b020ca17-1a40-3d0d-8762-36e0669b3d9c",
                                                "text": "Kwiatostany babki wytwarzają bardzo duże ilości pyłku."
