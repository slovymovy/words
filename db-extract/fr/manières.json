                                "target_senses": [
                                    {
                                        "sense_id": "57ca0999-0e78-357e-ae6c-c8202558edd8",
                                        "entry_id": "63ac2cbd-adb6-36fd-8334-9f08b88b5028",
                                        "glosses": [
                                            "Etiquette."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f55365f7-29b0-4ab9-9c20-8d3cbaa6d71c",
                                                "sense_id": "57ca0999-0e78-357e-ae6c-c8202558edd8",
                                                "text": "O, how thy worth with manners may I sing,\nWhen thou art all the better part of me?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "137127d6-30b9-3656-bd79-1b78dbbb3e46",
                                        "entry_id": "63ac2cbd-adb6-36fd-8334-9f08b88b5028",
                                        "glosses": [
                                            "Good manners."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "531dbdd9-40b1-44f7-8a1b-f6b3789cc466",
                                                "sense_id": "137127d6-30b9-3656-bd79-1b78dbbb3e46",
                                                "text": "When you come to this time of abatement, / To this passing from Summer to Fall, / It is manners to issue a statement / As to what you got out of it all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
