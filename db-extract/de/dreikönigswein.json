                "senses": [
                    {
                        "sense_id": "bb7ec659-8585-31f6-a306-57acee2ce264",
                        "entry_id": "5098bf0e-02ed-3c75-922a-e3adef7d5872",
                        "glosses": [
                            "Wein aus Trauben, die am 6. Januar gelesen wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec3054a-1418-4766-a7c9-0763a5297d4b",
                                "sense_id": "bb7ec659-8585-31f6-a306-57acee2ce264",
                                "text": "„Den familieneigenen Johannisberg Riesling fanden wir etwas zu süß, was Michael zu einer Lektion über drei Weine aus Deutschland veranlaßte, den St. Nikolauswein, den Christwein und den Dreikönigswein, die am 6. und 24. Dezember sowie am 6. Januar gelesen werden.“"
                            },
                            {
                                "example_id": "561719d6-f913-4d2f-b47a-cff7fbe6088d",
                                "sense_id": "bb7ec659-8585-31f6-a306-57acee2ce264",
                                "text": "„Sinngemäß ähnliche Weine sind Christwein, Dreikönigswein, Leopoldiwein, Martiniwein, Nikolowein und Weihnachtswein. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
