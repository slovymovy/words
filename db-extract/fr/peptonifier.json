                "senses": [
                    {
                        "sense_id": "1403efed-d116-3bb4-8ac8-634ba0e546bf",
                        "entry_id": "4ca32ddb-561b-3fd7-bde1-ea79fc31bbfe",
                        "glosses": [
                            "Transformer des protéines en peptone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fef30df2-71ab-4947-b35f-4851b9446cb4",
                                "sense_id": "1403efed-d116-3bb4-8ac8-634ba0e546bf",
                                "text": "Elle a la propriété de peptonifier les matières albuminoïdes en milieu acide ; on la rencontre en pharmacie sous plusieurs états."
                            },
                            {
                                "example_id": "832155ae-eb93-4296-b481-ebf16747167b",
                                "sense_id": "1403efed-d116-3bb4-8ac8-634ba0e546bf",
                                "text": "D’autres, produisant en même temps de la caséase (trypsine), peptonifient la caséine précipitée. D’autres enfin, ne produisant pas de présure, peptonifient directement la caséine sans la coaguler."
                            }
                        ]
                    }
