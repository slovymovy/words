                {
                    "sense_id": "04af41fd-3e1d-3798-959a-fb0d579fe801",
                    "sense_definition": "The national government or administrative authority of the Philippines.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "city_government",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Negotiations between the rebels and <w>Manila</w> have stalled recently.",
                            "target_lang_translations": {
                                "ru": "Переговоры между повстанцами и <w>Манилой</w> в последнее время зашли в тупик.",
                                "cs": "Jednání mezi rebely a <w>Manilou</w> se v poslední době zastavila."
                            }
                        },
                        {
                            "text": "Foreign investors are waiting to see how <w>Manila</w> responds to the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Иностранные инвесторы ждут, как <w>Манила</w> отреагирует на экономический кризис.",
                                "cs": "Zahraniční investoři čekají, jak <w>Manila</w> zareaguje na ekonomickou krizi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Национальное правительство или администрация Филиппин.",
                        "cs": "Národní vláda nebo administrativní orgán Filipín."
