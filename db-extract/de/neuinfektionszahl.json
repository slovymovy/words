                    {
                        "sense_id": "f1756fa4-588b-3f9f-af6b-09b5a49a8014",
                        "entry_id": "cee69b43-ca4a-374b-9ba0-5c103a7099c0",
                        "glosses": [
                            "Angabe (Zahl), die über die Verbreitung und das Ausmaß einer Infektionskrankheit informiert; Anzahl der Neuerkrankungen"
                        ],
                        "tags": [
                            "Infektiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6c2cc064-74ed-4aac-8605-777ecda974f5",
                                "sense_id": "f1756fa4-588b-3f9f-af6b-09b5a49a8014",
                                "text": "„Schweden hat im europäischen Coronavirus-Vergleich die Spitze bei den Neuinfektionszahlen übernommen.“"
                            },
                            {
                                "example_id": "cc93732d-8f98-464e-92b6-1f9e2b99b142",
                                "sense_id": "f1756fa4-588b-3f9f-af6b-09b5a49a8014",
                                "text": "„Indem die Neuinfektionen einer Woche zusammengezählt werden, werden die Schwankungen der täglichen Neuinfektionszahlen weitgehend ausgeglichen.“"
                            },
                            {
                                "example_id": "4331601f-453b-4841-b0c7-e8f35d8ac094",
                                "sense_id": "f1756fa4-588b-3f9f-af6b-09b5a49a8014",
                                "text": "„Dank der guten Präventionsarbeit durch die BZgA in enger Partnerschaft mit anderen Akteuren wie der Deutschen AIDS-Hilfe sind die Neuinfektionszahlen auf einem niedrigen Niveau.“"
                            }
                        ],
