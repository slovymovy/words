                "forms": [
                    {
                        "form_id": "d2538940-be8d-4a79-994e-5689eedc7179",
                        "entry_id": "4d4badd0-252f-3d5c-8110-5729673c9bf2",
                        "tags": [
                            "plural"
                        ],
                        "form": "Inkies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5f9058d-479a-3298-8e73-e0c205b3674d",
                        "entry_id": "4d4badd0-252f-3d5c-8110-5729673c9bf2",
                        "glosses": [
                            "The Inquisitor player character from the video game Dragon Age: Inquisition."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0ccc853f-1d4b-4283-bb8d-82107100ffce",
                                "sense_id": "c5f9058d-479a-3298-8e73-e0c205b3674d",
                                "text": "Do you like to play as an asshole Inky? What options, lines of dialogues, actions have you picked?"
                            },
                            {
                                "example_id": "4c54bf40-12f7-4d3d-9c32-666fa5111899",
                                "sense_id": "c5f9058d-479a-3298-8e73-e0c205b3674d",
                                "text": "Of my 9 Inkies, the ones I felt to be the strongest (character-wise) were my atheist Trevelyan Reaver, my devout Andrastian Trevelyan mage, and my rebellious and fiercely elfy Lavellan who romanced Solas."
                            },
                            {
                                "example_id": "d8472f8d-60de-4dc3-85bd-8a4174b2f5cd",
                                "sense_id": "c5f9058d-479a-3298-8e73-e0c205b3674d",
                                "text": "My Inky was a very faithful Andrastian, like his family, and he believed he was the Herald of Andraste…kind of."
                            }
                        ]
                    }
                ],
