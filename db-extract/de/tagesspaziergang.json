                "senses": [
                    {
                        "sense_id": "df5d8512-b3b0-3254-84d9-58bf99ac0ecc",
                        "entry_id": "1103509e-79cb-34e8-aace-7ef140f154b5",
                        "glosses": [
                            "geruhsames Gehen zur Erholung am Tage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "342d47d9-04f9-429a-a525-7525d71af828",
                                "sense_id": "df5d8512-b3b0-3254-84d9-58bf99ac0ecc",
                                "text": "„Im Winter braucht man indes einen Tagesspaziergang von 20 Minuten, um den Vitamin-D-Bedarf zumindest halbwegs zu decken.“"
                            },
                            {
                                "example_id": "f4ec12c9-6bee-498f-8b7c-9387cc628094",
                                "sense_id": "df5d8512-b3b0-3254-84d9-58bf99ac0ecc",
                                "text": "„Einen zehn Minuten langen Tagesspaziergang gab es auf dem kleinen Hof von etwa 50 Quadratmetern, der von drei Meter hohen Mauern umgeben war; auf beiden Seiten war je ein Wachturm.“"
                            },
                            {
                                "example_id": "09d20a3c-2385-45d6-b8fb-424ea9ed0a31",
                                "sense_id": "df5d8512-b3b0-3254-84d9-58bf99ac0ecc",
                                "text": "„Danach war er tagelang weggeblieben und dann, als sie von ihrem Tagesspaziergang in Spandau wieder da war, hatte er die meisten seiner Sachen in einen riesigen grauen Militärsack gepackt.“"
                            },
                            {
                                "example_id": "afecc32c-4abf-407b-9aea-56037a04f7da",
                                "sense_id": "df5d8512-b3b0-3254-84d9-58bf99ac0ecc",
                                "text": "„Die reine Gehzeit liegt bei zweieinhalb bis drei Stunden. Wer es langsam angehen lässt, macht daraus einen Tagesspaziergang.“"
                            },
                            {
                                "example_id": "ed179b43-83ce-4fd0-9443-5d0ef1022ab8",
                                "sense_id": "df5d8512-b3b0-3254-84d9-58bf99ac0ecc",
                                "text": "„Wenn er sich ihr in diesem Zustand aufzwang, würde sie nicht nur Tagesspaziergänge im Schnee entbehren, sondern auch ein Picknick im Frühling und Sommerausflüge nach Brighton Beach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
