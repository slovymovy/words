                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "иссле́дование",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d43d1b4c-8434-3ba0-933b-235126b9bc32",
                                        "entry_id": "062c6783-ab00-32ed-b5f7-4fce482abb16",
                                        "glosses": [
                                            "действие по значению гл. исследовать; систематичное рассмотрение, изучение, чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be2fd57b-bb35-403d-b25a-683ffb36d109",
                                                "sense_id": "d43d1b4c-8434-3ba0-933b-235126b9bc32",
                                                "text": "Основными методами исследования являются биохимические, серологические, цитогенетические."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5068f0a3-89d4-3ff8-afd2-81cb2f8b2189",
                                        "entry_id": "062c6783-ab00-32ed-b5f7-4fce482abb16",
                                        "glosses": [
                                            "результат такого действия, научный труд, документ с описанием изученного объекта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff538da2-9ac4-4a07-acc7-f20e773511e6",
                                                "sense_id": "5068f0a3-89d4-3ff8-afd2-81cb2f8b2189",
                                                "text": "По данным цитируемого исследования, площади, занятые под картофелем, составляют основную часть земельных участков как горожан в садовых и огороднических кооперативах (78 % площади), так и приусадебных участков сельчан (66 %)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
