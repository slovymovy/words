                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a597385b-e476-40af-a331-807d6d5b3bea",
                                                "sense_id": "a0edb16b-33a5-39a0-955d-457ae7a8963d",
                                                "text": "La coexistence pacifique fait partie, depuis quelque vingt-cinq ans, du langage courant des relations internationales."
                                            },
                                            {
                                                "example_id": "3b1204e2-577d-4f5f-81d1-77d768ffdda5",
                                                "sense_id": "a0edb16b-33a5-39a0-955d-457ae7a8963d",
                                                "text": "D’ailleurs, il a affirmé tout récemment que les déclarations de Biden concernant l’Amazonie constituaient «un signal clair de mépris envers la coexistence cordiale et fructueuse» entre les deux pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e41cd81c-24a2-49c6-b7a8-6bac3e28b442",
                        "source_entry_id": "83f3870a-8931-33d3-af73-abf5494911be",
                        "source_sense_id": "d73c34ba-e536-361f-9aa8-5f640a384441",
                        "source_sense_description": "two or more things existing together",
                        "target_lang_word": "Koexistenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koexistenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0668df8-b86f-3630-919e-dc502b4e3988",
                                        "entry_id": "695e9ade-f95d-3198-b241-c6bf2ccdc077",
                                        "glosses": [
                                            "das gleichzeitige Vorhandensein, das Existieren nebeneinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f9fb4f1-8410-49fd-9701-294585979b8c",
                                                "sense_id": "d0668df8-b86f-3630-919e-dc502b4e3988",
                                                "text": "„Im April hatte Grigorieva die Trennung des Paars bestätigt — damals schien eine friedliche Koexistenz offenbar noch möglich.“"
                                            },
                                            {
                                                "example_id": "f9d31f04-d0f8-4e47-aee5-75459544f629",
                                                "sense_id": "d0668df8-b86f-3630-919e-dc502b4e3988",
                                                "text": "„In 20 Jahren der Koexistenz hat es nur einen tödlichen Zwischenfall an der Grenze gegeben.“"
                                            },
                                            {
                                                "example_id": "be04df60-8e43-4427-a44e-4649c9b0c1a0",
                                                "sense_id": "d0668df8-b86f-3630-919e-dc502b4e3988",
                                                "text": "„Dieser Vertrag enthielt die fünf Prinzipien (Pancha Sila) der friedlichen Koexistenz, die Nehru danach als Doktrin seiner Außenpolitik immer wieder zitierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94a0d2b1-99df-4b48-a2e5-4c824d3f327f",
                        "source_entry_id": "83f3870a-8931-33d3-af73-abf5494911be",
                        "source_sense_id": "d73c34ba-e536-361f-9aa8-5f640a384441",
                        "source_sense_description": "two or more things existing together",
                        "target_lang_word": "Zusammenleben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammenleben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c6e2616-144a-384f-ac07-4e162d1710f3",
                                        "entry_id": "0530dcb0-8092-3c00-83e6-7d87150d3a8e",
                                        "glosses": [
                                            "Handlung/Vorgang, miteinander zu leben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13722d74-9ecc-4405-b8f6-ed184787fcac",
                                                "sense_id": "6c6e2616-144a-384f-ac07-4e162d1710f3",
                                                "text": "„Für unser Zusammenleben braucht es Regeln.“"
                                            },
                                            {
                                                "example_id": "8279513d-ce66-416c-a636-0b08ceb28157",
                                                "sense_id": "6c6e2616-144a-384f-ac07-4e162d1710f3",
                                                "text": "„In weiten Kreisen der Bevölkerung hat man sich an die Tatsache gewöhnt, dass Hundebesitzer ihren Lieblingen im Laufe eines längeren harmonischen Zusammenlebens stark zu ähneln beginnen.“"
                                            },
                                            {
                                                "example_id": "4e2a1337-cf95-4c0f-b7f5-010d5729be57",
                                                "sense_id": "6c6e2616-144a-384f-ac07-4e162d1710f3",
                                                "text": "„Das Haus hat der Albert nur im Vertrauen auf ein dauerndes Zusammenleben mit der Elfriede und den Kindern gebaut.“"
                                            },
                                            {
                                                "example_id": "c0a3efba-fb8d-4e4f-b5ea-46aed7b41681",
                                                "sense_id": "6c6e2616-144a-384f-ac07-4e162d1710f3",
                                                "text": "„Er landete vor dem großen, alten Wohnzimmerschrank, den Skúli im ersten Jahr seines Zusammenlebens mit Hafrún aus Treibholz geschreinert hatte, und fand darin Tagebücher seines Vaters.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e7a5c69-bcd1-488c-ae95-d61b251dac4f",
                        "source_entry_id": "83f3870a-8931-33d3-af73-abf5494911be",
                        "source_sense_id": "d73c34ba-e536-361f-9aa8-5f640a384441",
                        "source_sense_description": "two or more things existing together",
                        "target_lang_word": "συνύπαρξη",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "συνύπαρξη",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "fe624555-d03b-3399-83c5-a3c14dd14b2d",
                                        "entry_id": "050bb76f-756c-325a-b168-4917ac7f604b",
                                        "glosses": [
                                            "η ταυτόχρονη ύπαρξη"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f65f314-dae8-4f4f-a622-f922080b08f3",
                                                "sense_id": "fe624555-d03b-3399-83c5-a3c14dd14b2d",
                                                "text": "※ Ενα σχολείο με Ρομά, με μετανάστες, με ευάλωτους πληθυσμούς παραδίδει μαθήματα ένταξης, συμπερίληψης και δημοκρατίας.... Και το σχολείο που για άλλους ήταν αιτία να ζητήσουν μετάταξη, για εκείνον είναι ένα κήπος συνύπαρξης παιδιών και διαρκούς μαθήματος ανεκτικότητας, συμπερίληψης και διαπολιτισμού. («Μέλημά μου όσοι είναι στη σκιά, στα πίσω θρανία, στο περιθώριο», ΤΑ ΝΕΑ, 2024/03/04, https://www.tanea.gr/print/2024/03/04/interviews/melima-mou-osoi-einai-crsti-skia-sta-piso-thrania-sto-perithorio/)"
                                            },
                                            {
                                                "example_id": "43a1e4d8-ce23-46a9-ac41-edcbfc1e8a26",
                                                "sense_id": "fe624555-d03b-3399-83c5-a3c14dd14b2d",
                                                "text": "※ Έκτοτε, η θέση των Εβραίων στο πλαίσιο της Οθωμανικής Αυτοκρατορίας βελτιώθηκε σημαντικά, καθώς η θρησκεία των Οθωμανών, το Ισλάμ, ήταν υπέρ της συνύπαρξης των μωαμεθανών με τους μονοθεϊστικούς λαούς της Βίβλου (Χρονικά, τομος κγ', αρ. φυλλου 170, Νοέμβριος - Δεκέμβριος 2000, Όργανο του Κεντρικού Ισραηλιτικού Συμβουλίου της Ελλάδος, σελ. 6 https://www.kis.gr/scanned/T170.pdf)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99e3763e-469f-3322-bed0-a6f04aa3acf7",
                                        "entry_id": "050bb76f-756c-325a-b168-4917ac7f604b",
                                        "glosses": [
                                            "η συμβίωση"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f1f327-d0d7-41cd-ac08-941309644a9d",
                                                "sense_id": "99e3763e-469f-3322-bed0-a6f04aa3acf7",
                                                "text": "※ Επομένως η αρμονική βαλκανική συνύπαρξη θεωρούνταν κατά τον Χ. Τρικούπη αφενός, συνάρτηση της απεξάρτησης των λαών τους από τις ξενικές επεμβάσεις στα εσωτερικά τους και αφετέρου, αγωνιώδης πορεία για την όσο το δυνατό αποτελεσματικότερη προσέγγιση και ειλικρινέστερη κατανόηση με στόχο την ειρηνική επίλυση των διαφορών τους (Κωνσταντίνος Αποστόλου Βακαλόπουλος, Το νέο ελληνικό έθνος, 1204-2000, Ηρόδοτος, 2001, σελ. 37)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
