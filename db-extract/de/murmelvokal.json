                "senses": [
                    {
                        "sense_id": "33a1f992-19e6-3fe4-b98e-29f1eb8ad1cc",
                        "entry_id": "e188ce07-fbd1-34e1-90f7-f849eb4db772",
                        "glosses": [
                            "andere Bezeichnung für den Laut Schwa (= [ə])"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cd51cfb-3d3c-4423-8b02-046a27beffb0",
                                "sense_id": "33a1f992-19e6-3fe4-b98e-29f1eb8ad1cc",
                                "text": "Der letzte Laut in dem Wort \"Tante\" [tantə] ist ein Murmelvokal."
                            },
                            {
                                "example_id": "72a811c1-4bf1-46ee-82b1-981fed98ae95",
                                "sense_id": "33a1f992-19e6-3fe4-b98e-29f1eb8ad1cc",
                                "text": "„Der Abschwächungsvorgang führt zunächst zur Kürzung alter Längen und zur Aufgabe der vollen Vokalqualität zugunsten eines meist als e, seltener auch als i geschriebenen Murmelvokals.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a63c5289-bacf-4916-a084-09148f6e4f69",
                        "source_entry_id": "e188ce07-fbd1-34e1-90f7-f849eb4db772",
                        "source_sense_id": "33a1f992-19e6-3fe4-b98e-29f1eb8ad1cc",
                        "target_lang_word": "e muet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "e muet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9c2d2f5-c1ec-3bbc-8188-1161e6b89181",
                                        "entry_id": "6e7828bf-3dc9-39d1-b522-524da5cee4b0",
                                        "glosses": [
                                            "Voyelle moyenne centrale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd83c050-2c17-32b2-aa6c-55f676e3427b",
                                        "entry_id": "6e7828bf-3dc9-39d1-b522-524da5cee4b0",
                                        "glosses": [
                                            "Voyelle moyenne centrale qui peut être prononcée ou non, selon l’accent du locuteur, le registre de langue adopté ou le contexte."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "281ed5e2-8fa9-46fe-80f5-25d9f01f4ecd",
                                                "sense_id": "fd83c050-2c17-32b2-aa6c-55f676e3427b",
                                                "text": "Tas d’imaginations débiles que vous êtes, bande de feignasses à qui il faut tout mâcher, saletés de sociétaires de la Comédie-Française qui supprimez les « e » muets dans les alexandrins, si vous saviez, petits cons, ce qu’on peut se marrer avec des virgules et des passés simples (que vous appelez « imparfaits du subjonctif », en vous croyant malins !), si vous saviez !"
                                            },
                                            {
                                                "example_id": "506974cb-7391-49d5-877a-b1fc07b749a2",
                                                "sense_id": "fd83c050-2c17-32b2-aa6c-55f676e3427b",
                                                "text": "Régine Chimier, présidente du syndicat national des professeurs de français, a appelé à organiser des veillées-dictées pour attirer l’attention du grand public sur le sort de M. Luchini. « Fabrice est le seul à savoir faire entendre, et même plus, à faire résonner les « e » muets. S’il nous quitte, c’est la fin des haricots.[…]. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
