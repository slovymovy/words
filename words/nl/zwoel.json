                {
                    "sense_id": "4378b7e8-4b8d-30ec-8841-2dad20082674",
                    "sense_definition": "aangenaam of drukkend warm en vochtig, vaak gezegd van het weer of de lucht",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We zaten tot laat buiten op het terras tijdens een <w>zwoele</w> zomeravond.",
                            "target_lang_translations": {
                                "pl": "Siedzieliśmy do późna na zewnątrz na tarasie podczas <w>upalnego</w> letniego wieczoru."
                            }
                        },
                        {
                            "text": "Door de <w>zwoele</w> lucht begon het later die nacht hevig te onweren.",
                            "target_lang_translations": {
                                "pl": "Z powodu <w>parnego</w> powietrza później w nocy rozpętała się gwałtowna burza."
                            }
                        }
                    ],
                    "synonyms": [
                        "benauwd",
                        "drukkend"
                    ],
                    "antonyms": [
                        "fris",
                        "koel"
                    ],
                    "common_phrases": [
                        "zwoele zomernacht",
                        "zwoele zomeravond",
                        "zwoel weer"
                    ],
                    "target_lang_definitions": {
                        "pl": "przyjemnie lub duszno ciepły i wilgotny, często o pogodzie lub powietrzu"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "upalny",
                                "target_lang_sense_clarification": "o gorącym, letnim powietrzu lub nocy"
                            },
                            {
                                "target_lang_word": "parny",
                                "target_lang_sense_clarification": "o ciepłym i wilgotnym, duszniejszym powietrzu"
                            },
                            {
                                "target_lang_word": "duszny",
                                "target_lang_sense_clarification": "o ciężkim, wilgotnym powietrzu zwiastującym burzę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94d57aa2-9b84-3766-a70c-a049cf20d941",
                    "sense_definition": "een verleidelijke of erotische sfeer oproepend; sensueel",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sfeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zangeres bracht de romantische ballade met een warme en <w>zwoele</w> stem.",
                            "target_lang_translations": {
