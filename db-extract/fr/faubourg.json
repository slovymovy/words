        "fr-extract.jsonl": [
            {
                "entry_id": "bc7ff315-72ec-3fee-afb9-cb6b06d514dd",
                "word": "faubourg",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6017665d-e686-40ee-b2fe-66d0c2ae26ba",
                        "entry_id": "bc7ff315-72ec-3fee-afb9-cb6b06d514dd",
                        "tags": [
                            "plural"
                        ],
                        "form": "faubourgs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb54d8dd-edbd-365b-be19-70c639cf45cb",
                        "entry_id": "bc7ff315-72ec-3fee-afb9-cb6b06d514dd",
                        "glosses": [
                            "Partie d’une ville qui est au-delà de ses portes et de son enceinte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4399e9e-ab33-4a93-ac8a-aa16f9f3d048",
                                "sense_id": "eb54d8dd-edbd-365b-be19-70c639cf45cb",
                                "text": "Les défenseurs, après avoir perdu les faubourgs, manquant d’eau, furent obligés de capituler."
                            },
                            {
                                "example_id": "144c9616-967e-4b51-ad30-dc14c5cc77da",
                                "sense_id": "eb54d8dd-edbd-365b-be19-70c639cf45cb",
                                "text": "Mais nous sommes déjà dans les faubourgs. Les maisons s'espacent, se reculent, s'adossent à la rivière ou à la montagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "b97bec60-608f-3d7f-955a-7b4584b22040",
                        "entry_id": "bc7ff315-72ec-3fee-afb9-cb6b06d514dd",
                        "glosses": [
                            "Quartier d’une ville qui était anciennement un faubourg."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0576f974-9f75-4e73-a546-07e1f9c8cc69",
                                "sense_id": "b97bec60-608f-3d7f-955a-7b4584b22040",
                                "text": "Les gens du faubourg Saint-Antoine n’appellent jamais autrement ce quartier célèbre que le faubourg. C’est pour eux le faubourg par excellence, le souverain faubourg, et les fabricants eux-mêmes entendent par ce mot spécialement le faubourg Saint-Antoine."
                            },
                            {
                                "example_id": "352f2f70-bc1c-4fa9-b3f4-45668d307cfa",
                                "sense_id": "b97bec60-608f-3d7f-955a-7b4584b22040",
                                "text": "Or nous avions fini, tout en conversant, par arriver faubourg du Temple, où des filles, à l'entrée du passage, racolaient."
                            },
                            {
                                "example_id": "d4fbdc00-cae6-436e-9d95-edf16cc4d59e",
                                "sense_id": "b97bec60-608f-3d7f-955a-7b4584b22040",
                                "text": "Aux terrasses des brasseries, échelonnées du faubourg Montmartre, à la rue Drouot, de larges gouttes s'écrasaient sur le sol."
                            },
                            {
                                "example_id": "9789645b-f873-424e-90c9-f2b51a8d0ca3",
                                "sense_id": "b97bec60-608f-3d7f-955a-7b4584b22040",
                                "text": "D'un côté l'arôme familial d'un arabica feutré, de l'autre le remugle oppressant du graillon des faubourgs de Birmingham.\nD'un côté le bon goût français, de l'autre l’empiffrerie britannique."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6eb5c11-e9ed-3735-bfed-b5e109135243",
                        "entry_id": "bc7ff315-72ec-3fee-afb9-cb6b06d514dd",
                        "glosses": [
                            "Ensemble des habitants d'un de ces lieux."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a82d0a3e-849e-44f3-8b33-fb21d60925c4",
                                "sense_id": "b6eb5c11-e9ed-3735-bfed-b5e109135243",
                                "text": "On a entendu le tambour , au son duquel on a vu entrer une partie nombreuse du faubourg Montmartre , portant le buste de Désilles, entouré de drapeaux et de lauriers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab960598-f42b-47d4-809f-3deaef111ad3",
                        "source_entry_id": "bc7ff315-72ec-3fee-afb9-cb6b06d514dd",
                        "target_lang_word": "Vorort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d8d4240-0585-3bc6-b5c2-468d96b39e8d",
                                        "entry_id": "7be0d59c-5645-35dd-be13-92e1f9f99537",
                                        "glosses": [
                                            "eine Siedlung der Peripherie einer Stadt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b2f97e5-4203-4d14-93b0-19dd842a26fe",
                                                "sense_id": "0d8d4240-0585-3bc6-b5c2-468d96b39e8d",
                                                "text": "Die Pendler in den Vororten stöhnen über den hohen Spritpreis."
                                            },
                                            {
                                                "example_id": "e38db834-1cf2-4498-b8a0-994d16d95b06",
                                                "sense_id": "0d8d4240-0585-3bc6-b5c2-468d96b39e8d",
                                                "text": "„Auch in den entlegensten Vororten wurden diese Wechselstuben in den Weg gestellt.“"
                                            },
                                            {
                                                "example_id": "219f7bd8-df00-4b92-b06e-0fe28c02538e",
                                                "sense_id": "0d8d4240-0585-3bc6-b5c2-468d96b39e8d",
                                                "text": "„Er stapfte mit seinem Tornister durch die öden Vororte, durch die innere Stadt und kam auf den Hauptbahnhof.“"
                                            },
                                            {
                                                "example_id": "124be045-294d-4cf1-a324-01f33cb74b30",
                                                "sense_id": "0d8d4240-0585-3bc6-b5c2-468d96b39e8d",
                                                "text": "„In diesen Vororten ist eine Ahnung von der Lebensqualität erhalten geblieben, die das alte Dresden kennzeichnete.“"
                                            },
                                            {
                                                "example_id": "1974baae-383c-46d5-b2f0-419aaddae13b",
                                                "sense_id": "0d8d4240-0585-3bc6-b5c2-468d96b39e8d",
                                                "text": "„Janies Cleverness bestand darin, dass sie, als sie in den Vorort kam, erkannte, wozu die Vororte da waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "28a8314b-7a4f-328b-bb74-faa8b4293ac4",
                                        "entry_id": "7be0d59c-5645-35dd-be13-92e1f9f99537",
                                        "glosses": [
                                            "Ort, Stadt (in der ersten Hälfte des 19. Jahrhunderts Kanton) mit Vorrangstellung, etwa in der Hanse und in der Schweizerischen Eidgenossenschaft"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ea1e145-840f-41d7-bf9e-0d3295883092",
                                                "sense_id": "28a8314b-7a4f-328b-bb74-faa8b4293ac4",
                                                "text": "„Als Vorort wurde bis 1798 jener eidgenössische Ort bezeichnet, der zur eidgenössischen Tagsatzung einlud und bei den Verhandlungen den Vorsitz hielt. Bis ins ausgehende 15. Jahrhundert beriefen Zürich und Luzern am häufigsten Sitzungen ein. Dass sich schliesslich Zürich als Vorort der gesamten Eidgenossenschaft durchsetzte, hing von mindestens zwei Faktoren ab [und so weiter].“"
                                            },
                                            {
                                                "example_id": "703f24fb-a822-41f8-b1e8-c724499a1cec",
                                                "sense_id": "28a8314b-7a4f-328b-bb74-faa8b4293ac4",
                                                "text": "„Der Vorort der schweizerischen Eidgenossenschaft erklärt in Folge der zwischen der Königlich-bayerischen Staatsregierung und den nachgenannten Schweizer Kantonen Zürich, Bern, Luzern, Unterwalden, Freiburg, Solothurn, Basel, Schaffhausen, St. Gallen, Graubünden, Aargau, Thurgau, Tessin, Waadt, Wallis, Neuenburg und Genf, sowie Appenzell Ausser-Rhoden getroffenen Übereinkunft: [Es folgt die »Erklärung«].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b14319b6-c143-3ed4-9f80-1e63e262b8de",
                                        "entry_id": "7be0d59c-5645-35dd-be13-92e1f9f99537",
                                        "glosses": [
                                            "jährlich wechselndes Leitungsgremium in Korporationsverbänden"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e270b548-5d90-319a-bcc5-008169679ced",
                                        "entry_id": "7be0d59c-5645-35dd-be13-92e1f9f99537",
                                        "glosses": [
                                            "Bezeichnung für den Schweizerischen Handels- und Industrievereins (SHIV)"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34830455-ec18-4077-a4f3-f8b42808b733",
                                                "sense_id": "e270b548-5d90-319a-bcc5-008169679ced",
                                                "text": "„Der Schweizerische Handels- und Industrieverein (SHIV), genannt Vorort, seit 2000 mit der Gesellschaft zur Förderung der schweizerischen Wirtschaft zum Verband Economiesuisse zusammengeschlossen, ist der älteste der vier grossen Schweizer Wirtschaftsverbände (Schweizerischer Gewerbeverband, Schweizerischer Gewerkschaftsbund, Schweizerischer Bauernverband).“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76deded5-f4de-4cff-9255-8338a6fe4e26",
                        "source_entry_id": "bc7ff315-72ec-3fee-afb9-cb6b06d514dd",
                        "target_lang_word": "suburb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suburb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b5b6c53-49de-35fd-b893-9f61024fe050",
                                        "entry_id": "495782ce-392c-3734-8784-2a6606193cd5",
                                        "glosses": [
                                            "A residential area located on the outskirts of a city or large town that usually includes businesses that cater to its residents; such as schools, grocery stores, shopping centers, restaurants, convenience stores, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc9a7736-c49e-4fa4-8ed5-b97082263e81",
                                                "sense_id": "4b5b6c53-49de-35fd-b893-9f61024fe050",
                                                "text": "And the Lord spake vnto Moses in the plaines of Moab by Iordane, neere Iericho, saying,\nCommand the children of Israel, that they giue vnto the Leuites of the inheritance of their possession, cities to dwell in: and yee shall giue also vnto the Leuites suburbs for the cities round about them."
                                            },
                                            {
                                                "example_id": "105daf71-6096-4be6-ba79-ecc3207936e6",
                                                "sense_id": "4b5b6c53-49de-35fd-b893-9f61024fe050",
                                                "text": "These two circumstances, however, happening both unfortunately to intervene, our travellers deviated into a much less frequented track; and after riding full six miles, instead of arriving at the stately spires of Coventry, they found themselves still in a very dirty lane, where they saw no symptoms of approaching the suburbs of a large city."
                                            },
                                            {
                                                "example_id": "8e8cc0ef-a988-43f1-930d-91b559a5eb6c",
                                                "sense_id": "4b5b6c53-49de-35fd-b893-9f61024fe050",
                                                "text": "[London] could hardly have contained less than thirty or forty thousand souls within its walls; and the suburbs were very populous."
                                            },
                                            {
                                                "example_id": "6d8d2037-0d7c-4abb-af3a-0c676096a946",
                                                "sense_id": "4b5b6c53-49de-35fd-b893-9f61024fe050",
                                                "text": "Canton is by no means the only great city in the province. Fo-chan, a kind of suburb to it, about twelve miles distant, has been represented as almost as large."
                                            },
                                            {
                                                "example_id": "b2b88499-4647-4fe0-851a-ffa33271f93d",
                                                "sense_id": "4b5b6c53-49de-35fd-b893-9f61024fe050",
                                                "text": "At the mountain’s base is the leafy suburb of Kowloon Tong. It has never been a big tourist draw, but in the decade since territorial control returned to China, this quintessentially Hong Kong neighborhood has had many more visitors — and important changes."
                                            },
                                            {
                                                "example_id": "3f5b8006-7f5a-4325-a90e-6cc57fdfffc5",
                                                "sense_id": "4b5b6c53-49de-35fd-b893-9f61024fe050",
                                                "text": "I’m not surprised that Rudd seizes on my accent – his parents were British Jews from Edgware and Surbiton, and while Rudd was born in New Jersey in 1969 and raised in the US, he was often in Britain as a kid to visit relatives in London’s less glamorous suburbs and Basingstoke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "278c5c09-5fba-3587-babc-5c511d54c730",
                                        "entry_id": "495782ce-392c-3734-8784-2a6606193cd5",
                                        "glosses": [
                                            "The outer part; the environment."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02fd304b-84d2-44bb-a273-05a094387eff",
                                                "sense_id": "278c5c09-5fba-3587-babc-5c511d54c730",
                                                "text": "the suburbs […] of sorrow"
                                            },
                                            {
                                                "example_id": "b83432e5-b9b5-4c40-8617-0ec90260678d",
                                                "sense_id": "278c5c09-5fba-3587-babc-5c511d54c730",
                                                "text": "the suburb of their straw-built citadel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "166eadd2-ce86-3378-b524-7c6002e9adf3",
                                        "entry_id": "495782ce-392c-3734-8784-2a6606193cd5",
                                        "glosses": [
                                            "Any subdivision of a conurbation, not necessarily on the periphery."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Ireland",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
