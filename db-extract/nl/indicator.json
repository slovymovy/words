                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "44b6699f-694b-3690-b66f-0c64df756abb",
                        "entry_id": "3108bdb4-d44c-3f11-a2fe-6980dc1ac3bf",
                        "glosses": [
