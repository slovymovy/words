                    {
                        "translation_id": "077a3f16-ce0b-4d08-ae97-91d97c3eb106",
                        "source_entry_id": "2f3c3fd0-2a6c-3ad7-9a27-d27a3d341d1d",
                        "source_sense_id": "d304d648-4ef3-327e-998a-bcc5a5ec9441",
