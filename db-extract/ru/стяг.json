                "senses": [
                    {
                        "sense_id": "6e1394e2-daff-3467-9860-a69acd669c3c",
                        "entry_id": "22b90540-8bc4-3643-8f2e-2988f331ff99",
                        "glosses": [
                            "рег. очищенная мясная туша без головы и ног"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7bfbc8a-91f1-45a5-b1fd-4d6728a03860",
                                "sense_id": "6e1394e2-daff-3467-9860-a69acd669c3c",
                                "text": "Он был болен черною немочью и по обещанию ездил в Киев: его бог помиловал, и киевские чудотворцы помогли; и он оттуда привез этот канонник и благословил дедушку, а он его возом муки, двумя тушами свиными да стягом говяжьим."
                            },
                            {
                                "example_id": "c2176ce3-47db-4b16-8dbf-6b66091dc14a",
                                "sense_id": "6e1394e2-daff-3467-9860-a69acd669c3c",
                                "text": "Лавочник привез с ярманки целый стяг говядины да десять свиных туш…"
                            }
                        ]
                    }
                ],
