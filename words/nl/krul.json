                                "target_lang_sense_clarification": "a long, spiral-shaped lock of hair"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "123d7186-0bc3-35a0-bcb3-efa6fe53dfd3",
                    "sense_definition": "een spiraalsgewijs gekromde vorm of versiering",
