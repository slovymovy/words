        "fr-extract.jsonl": [
            {
                "entry_id": "654c07c6-e114-3099-b888-2568ae500eda",
                "word": "détracteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ae80e2ee-7616-4e0d-87ff-1ce2cc6f8b71",
                        "entry_id": "654c07c6-e114-3099-b888-2568ae500eda",
                        "tags": [
                            "plural"
                        ],
                        "form": "détracteurs"
                    },
                    {
                        "form_id": "8e56262d-d10d-4fbc-b6b1-1c6fbde1f481",
                        "entry_id": "654c07c6-e114-3099-b888-2568ae500eda",
                        "tags": [
                            "feminine"
                        ],
                        "form": "détractrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00322799-e262-3325-b785-d541ee7725f4",
                        "entry_id": "654c07c6-e114-3099-b888-2568ae500eda",
                        "glosses": [
                            "Celui qui prend plaisir à critiquer voire rabaisser quelqu’un ou quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3116045b-424d-4eef-bf4e-9a04bc487af8",
                                "sense_id": "00322799-e262-3325-b785-d541ee7725f4",
                                "text": "Nulle part, l'école de Clermont n’a autant de détracteurs qu’à Clermont même et l’acharnement de ceux-ci n’est pas petit."
                            },
                            {
                                "example_id": "e7b54ba6-6dad-45c3-b11f-ee6ced2ffb12",
                                "sense_id": "00322799-e262-3325-b785-d541ee7725f4",
                                "text": "Les détracteurs du nudisme - les moralistes ou hygiénistes conservateurs d’État ou d’Église - prétendent que la vue du nu, que la fréquentation entre nudistes des deux sexes exaltent le désir érotique."
                            },
                            {
                                "example_id": "789d573a-0eca-4154-a1f5-e5c938600de6",
                                "sense_id": "00322799-e262-3325-b785-d541ee7725f4",
                                "text": "Niant tout cela, les détracteurs tourneront en dérision les mérites de l’écrivain méconnu ; nulle voix ne répondra à la sienne ; il demeurera isolé au beau milieu du chemin."
                            },
                            {
                                "example_id": "e4231481-638e-4a39-a44e-beefa7e405d8",
                                "sense_id": "00322799-e262-3325-b785-d541ee7725f4",
                                "text": "Dès 1890 se développe l’offensive du béton et du béton armé dans les grandes soumissions. Mais la résistance à cet hybride, véritable mariage de la carpe et du lapin à en croire ses détracteurs, sera longue et opiniâtre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edb38230-147d-4708-a360-b44147ae7198",
                        "source_entry_id": "654c07c6-e114-3099-b888-2568ae500eda",
                        "source_sense_id": "00322799-e262-3325-b785-d541ee7725f4",
                        "target_lang_word": "Verleumder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8b399796-4eb3-48b2-b612-93970e71f55c",
                        "source_entry_id": "654c07c6-e114-3099-b888-2568ae500eda",
                        "source_sense_id": "00322799-e262-3325-b785-d541ee7725f4",
                        "target_lang_word": "Verächter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "94257db9-36ab-49bb-979c-93f3c1dfd730",
                        "source_entry_id": "654c07c6-e114-3099-b888-2568ae500eda",
                        "source_sense_id": "00322799-e262-3325-b785-d541ee7725f4",
                        "target_lang_word": "Kritiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kritiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5fd8242-86d5-3b16-86db-279501da3a80",
                                        "entry_id": "26d2b17b-6aa8-33e2-881d-241bd2a7c0e2",
                                        "glosses": [
                                            "jemand, der kritisiert; jemand, der etwas tadelt oder bemängelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfb5afe6-4f75-43fa-8f30-d0ab3a1fe56d",
                                                "sense_id": "c5fd8242-86d5-3b16-86db-279501da3a80",
                                                "text": "Ich traue mich nicht, einen Vorschlag zu unterbreiten. Es kommt sowieso ein Kritiker, der ihn wieder schlecht redet."
                                            },
                                            {
                                                "example_id": "4a9dc9cc-d72d-4144-af7c-1e5faa91b1ce",
                                                "sense_id": "c5fd8242-86d5-3b16-86db-279501da3a80",
                                                "text": "„Kritiker verweisen darauf, dass Medikamente gezielt und nicht unbewusst mit dem täglichen »Butterbrot« eingenommen werden sollten.“"
                                            },
                                            {
                                                "example_id": "d769dd42-4390-46dc-9ee0-768aeb430612",
                                                "sense_id": "c5fd8242-86d5-3b16-86db-279501da3a80",
                                                "text": "„Kritiker will Trump mundtot machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6e253c7e-c840-38cf-9917-6dca38801d8b",
                                        "entry_id": "26d2b17b-6aa8-33e2-881d-241bd2a7c0e2",
                                        "glosses": [
                                            "jemand, der beruflich (Kunst-)Werke kritisiert oder streng beurteilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c100f6c-2ff4-42c0-9c3d-e315bdbd4265",
                                                "sense_id": "6e253c7e-c840-38cf-9917-6dca38801d8b",
                                                "text": "Es war eine gelungene Inszenierung im Theater gestern Abend. Die Kritiker waren begeistert."
                                            },
                                            {
                                                "example_id": "d851ec4a-b608-4f52-81ea-888572a3a3d7",
                                                "sense_id": "6e253c7e-c840-38cf-9917-6dca38801d8b",
                                                "text": "„Aus der Besprechung ging klar hervor, dass dem guten Kritiker nicht im Geringsten aufgefallen war, dass das Verschwinden, auf das der Buchtitel hinweist, in Wirklichkeit nicht auf die Menschen anspielt, die im Roman verschwinden, sondern darauf, dass in ihm der sonst allgegenwärtige Buchstabe E nicht vorkommt.“"
                                            },
                                            {
                                                "example_id": "f9f6ef11-484d-42c7-a050-832bbf13b717",
                                                "sense_id": "6e253c7e-c840-38cf-9917-6dca38801d8b",
                                                "text": "„Der Berliner Kritiker gerät in Paris ins Schwärmen.“"
                                            },
                                            {
                                                "example_id": "03fe2afc-a0ef-4d9d-9722-e9f71f25f3cb",
                                                "sense_id": "6e253c7e-c840-38cf-9917-6dca38801d8b",
                                                "text": "„Also hatten Darwins Kritiker ihm die Ehre erwiesen, ihn zu einer derart umstrittenen Figur zu machen, dass ihn nun schlicht jeder kannte.“"
                                            },
                                            {
                                                "example_id": "e0ae1b6c-3e70-4a6f-9bc0-95f415aacd91",
                                                "sense_id": "6e253c7e-c840-38cf-9917-6dca38801d8b",
                                                "text": "„Die beiden lasen einander die tiefsinnigen Überlegungen der Kritiker vor und genossen das Ganze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48dc63f6-23d2-4fab-82ea-3abbc4c94c5d",
                        "source_entry_id": "654c07c6-e114-3099-b888-2568ae500eda",
                        "source_sense_id": "00322799-e262-3325-b785-d541ee7725f4",
