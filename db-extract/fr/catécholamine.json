                            {
                                "target_word": "CA",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "357703a8-a1d3-3481-8365-b835d97ca883",
                                        "entry_id": "277327eb-493a-3c37-b1cd-2f507ae08a5c",
                                        "glosses": [
                                            "Initialism of cellular automaton."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "029df5fa-4ce3-4907-b98b-cae140e99d63",
                                                "sense_id": "357703a8-a1d3-3481-8365-b835d97ca883",
                                                "text": "BTW: Of course the rules were parametrised, so any totalistic 2-dimensional 9-neighbourhood CA could be run."
                                            },
                                            {
                                                "example_id": "65558157-0864-4ee8-813c-876c98c6d037",
                                                "sense_id": "357703a8-a1d3-3481-8365-b835d97ca883",
                                                "text": "The new CA is a modification of Fredkin's earlier SALT architecture in which every cell is identified as either even or odd - as in sodium and chlorine in a salt crystal hence the name. The state of each cell is either up or down and the development rule simple takes account of states of odd and even neighbours. The up-date at each time step simply takes the form of a swap of the states of diagonally related cells. SALT CAs are reversible and capable of universal computation and are conjectured to be capable of universal construction in the sense of Von Neumann."
                                            },
                                            {
                                                "example_id": "75a2f741-6df4-4ed4-a7b6-974532a16570",
                                                "sense_id": "357703a8-a1d3-3481-8365-b835d97ca883",
                                                "text": "I assume we are speaking of a single rule CA (one rule for every cell)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd6bf023-728b-3225-8ddf-01becbf5b547",
                                        "entry_id": "277327eb-493a-3c37-b1cd-2f507ae08a5c",
                                        "glosses": [
                                            "Initialism of certificate authority."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a74f137e-e4e9-4aec-9c0b-6826591b3c72",
                                                "sense_id": "cd6bf023-728b-3225-8ddf-01becbf5b547",
                                                "text": "Well-designed CAs will create a trust hierarchy, which consists of a root with a number of subroots, to further enhance protection of the private key."
                                            }
                                        ]
                                    },
