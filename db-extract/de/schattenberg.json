                ],
                "senses": [
                    {
                        "sense_id": "b6f8607d-1ea3-30fb-82f6-ada530683a29",
                        "entry_id": "083f2e16-241b-3b01-80f2-a67f0e0e97aa",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b7e8acf-d060-4ea8-b302-81ea8da66cc5",
                                "sense_id": "b6f8607d-1ea3-30fb-82f6-ada530683a29",
                                "text": "Die Schattenbergs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "455d8f6e-d1e5-4f28-8616-166c5311590b",
                                "sense_id": "b6f8607d-1ea3-30fb-82f6-ada530683a29",
                                "text": "Der Schattenberg trägt nie die Schals, die die Schattenberg ihm strickt."
                            },
                            {
                                "example_id": "bc19d040-572e-4837-8584-f8e4a617094c",
                                "sense_id": "b6f8607d-1ea3-30fb-82f6-ada530683a29",
                                "text": "Frau Schattenberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a29c0d14-5968-46a8-929b-fe3322b14893",
                                "sense_id": "b6f8607d-1ea3-30fb-82f6-ada530683a29",
                                "text": "Herr Schattenberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d8668845-ce92-4e68-af6a-48e176f245c8",
                                "sense_id": "b6f8607d-1ea3-30fb-82f6-ada530683a29",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schattenberg kommt, geht der Herr Schattenberg.“"
                            },
                            {
                                "example_id": "21dccad1-25ae-4358-9b02-279442c25593",
                                "sense_id": "b6f8607d-1ea3-30fb-82f6-ada530683a29",
                                "text": "Schattenberg kommt und geht."
                            },
                            {
                                "example_id": "4e1eb435-66cc-481e-aeb8-280022e64b42",
                                "sense_id": "b6f8607d-1ea3-30fb-82f6-ada530683a29",
                                "text": "Schattenbergs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
