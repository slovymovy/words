    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4bb13f56-df2a-3df4-bd42-0496ffe36f96",
                "word": "unseen",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4ee09034-1339-3ba2-81f7-bfaac80f2bb9",
                        "entry_id": "4bb13f56-df2a-3df4-bd42-0496ffe36f96",
                        "glosses": [
                            "Not seen or discovered; invisible."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4be86e52-2839-44d9-97d2-e190d43b1061",
                                "sense_id": "4ee09034-1339-3ba2-81f7-bfaac80f2bb9",
                                "text": "You became to me the visible incarnation of that unseen ideal whose memory haunts us artists like an exquisite dream."
                            },
                            {
                                "example_id": "423b3f8b-aa76-49ed-af57-ca9b67280e8f",
                                "sense_id": "4ee09034-1339-3ba2-81f7-bfaac80f2bb9",
                                "text": "Were one asked to characterize the life of religion in the broadest and most general terms possible, one might say that it consists of the belief that there is an unseen order, and that our supreme good lies in harmoniously adjusting ourselves thereto."
                            },
                            {
                                "example_id": "05118f29-89ce-45b7-ad03-e6d18439bf48",
                                "sense_id": "4ee09034-1339-3ba2-81f7-bfaac80f2bb9",
                                "text": "When night had fallen, the she-demon stole forth toward the hall, which she entered unheard and unseen."
                            },
                            {
                                "example_id": "a9c90ef9-6c08-45e9-9942-57c3e0f92664",
                                "sense_id": "4ee09034-1339-3ba2-81f7-bfaac80f2bb9",
                                "text": "Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet. Perhaps we assume that our name, address and search preferences will be viewed by some unseen pair of corporate eyes, probably not human, and don't mind that much."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e11ad70-b1e7-3113-a78f-11fbd6b194ca",
                        "entry_id": "4bb13f56-df2a-3df4-bd42-0496ffe36f96",
                        "glosses": [
                            "Unskilled; inexperienced."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e7773f70-1f80-3f91-a944-f738f4f98557",
                        "entry_id": "4bb13f56-df2a-3df4-bd42-0496ffe36f96",
                        "glosses": [
                            "Not hitherto noticed; unobserved."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ab631166-59c5-4fd8-9670-64f5e77279c4",
                                "sense_id": "e7773f70-1f80-3f91-a944-f738f4f98557",
                                "text": "I to the world am like a drop of water\nThat in the ocean seeks another drop,\nWho, falling there to find his fellow forth,\nUnseen, inquisitive, confounds himself."
                            },
                            {
                                "example_id": "9854c6c2-7267-4e3e-a0db-6bf3ea73111a",
                                "sense_id": "e7773f70-1f80-3f91-a944-f738f4f98557",
                                "text": "The advent of COVID passports, so soon after increased check-in bureaucracy post-Brexit, brought major logistical ramifications to St Pancras International, of a kind unseen at any other major station in Britain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
