                "senses": [
                    {
                        "sense_id": "5a47c5b2-be63-37eb-a185-301316c082d3",
                        "entry_id": "2b000ec1-3a69-39ef-8b38-a1eba34704b2",
                        "glosses": [
                            "to lean one's elbows"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e5783c7-9423-4301-8f8b-69b972336585",
                                "sense_id": "5a47c5b2-be63-37eb-a185-301316c082d3",
                                "text": "Не облока́чивайся о подоко́нник!",
                                "translation": "Don’t lean on the window sill!",
                                "english": "Don’t lean on the window sill!"
                            },
                            {
                                "example_id": "90fa5b64-935f-41ab-8b2e-749780b28500",
                                "sense_id": "5a47c5b2-be63-37eb-a185-301316c082d3",
                                "text": "Сказа́вши э́то, Пе́тенька вдруг перестаёт кача́ться на сту́ле, обора́чивается к столу́ и облока́чивается на него́ обе́ими рука́ми.",
                                "translation": "After saying this, Petenka suddenly stops rocking on his chair, turns to the table, and puts his elbows on it.",
                                "english": "After saying this, Petenka suddenly stops rocking on his chair, turns to the table, and puts his elbows on it."
                            }
                        ]
                    }
                ],
