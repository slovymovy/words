        "ru-extract.jsonl": [
            {
                "entry_id": "edfa1d62-ba64-3e9e-bdc8-6f5960f48d2e",
                "word": "pograniczny",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d36bcd6b-19e0-360b-ba78-a0c0350842ac",
                        "entry_id": "edfa1d62-ba64-3e9e-bdc8-6f5960f48d2e",
                        "glosses": [
                            "пограничный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fba2531b-f3be-43c2-afc1-d3e3bb8d9e83",
                                "sense_id": "d36bcd6b-19e0-360b-ba78-a0c0350842ac",
                                "text": "W szerokim ujściu rzeki pogranicznej Bidassoa, zamkniętym między przylądkiem św. Anny, od skał najeżonym i śliskim, a hiszpańskim już Cap du Figuier - z wolna wlewały się fale na ławice niskich piachów, dążąc bez ustanku a niepostrzeżenie aż pod same mury Fuenterrabii. Stefan Żeromski. Popioły 1902",
                                "translation": "В широком устье пограничной реки Бидассоа, защищенном мысом святой Анны с зубчатыми и скользкими скалами, а с испанской стороны мысом дю Фигье, волны медленно набегали на низкие песчаные отмели, безустанно и неприметно подкатываясь под самые стены Фуентеррабии. Стефан Жеромский. Пепел Е. Н. Троповский, Е. М. Егорова 1967"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
