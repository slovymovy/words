                                        "examples": [
                                            {
                                                "example_id": "6a86e860-4571-4f9e-9d4d-be71c1a1aa2c",
                                                "sense_id": "1151b79d-c53b-383f-a2b8-1cba0830f007",
                                                "text": "Сей Сидящий видом был подобен камню яспису и сардису; и радуга вокруг престола, видом подобная смарагду."
                                            },
                                            {
                                                "example_id": "b9e5042c-1e1d-4220-b1e2-f613c505603b",
                                                "sense_id": "1151b79d-c53b-383f-a2b8-1cba0830f007",
                                                "text": "Итак, первый, происходящий от оного луч, сделан был из разноцветной яшмы, или ясписа, второй — из прозелёного аквамарина, третий — из зелено-жёлтого хризолита .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95c5bf16-cb5c-41f2-bba3-2ad0fed51453",
                        "source_entry_id": "4a82fc10-a221-3217-a470-3f2c55ef5997",
                        "target_lang_word": "jaspis",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jaspis",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "94c595ad-cad5-3f35-bbbe-a712b1c6f419",
                                        "entry_id": "76d72658-4ac4-3592-a7ce-6f56588c89d7",
                                        "glosses": [
                                            "minerál, odrůda chalcedonu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29382dc8-b862-4a32-9ad8-a4c0449f1898",
                                                "sense_id": "94c595ad-cad5-3f35-bbbe-a712b1c6f419",
                                                "text": "Nebo aj, u výsosti seděl na trůnu svém Pán zástupů, okolo něhož byl blesk od končin nebes až do končin jejich: a pod nohami jeho byl jako křišťál, smaragd a zafír, a trůn jeho jaspis, a vůkol něho duha krásná."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
