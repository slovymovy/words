                        "entry_id": "addffde9-b97b-35f9-b8e2-0457ee4685a5",
                        "glosses": [
                            "To bend or curve inwards; inflect."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "35048c0b-c360-4b86-a3e7-c38e09edd78b",
                                "sense_id": "a44aa155-3041-3b43-b76a-e93eade5db14",
                                "text": "In this case, the force is more generally applied over the skull causing the vault to inbend and fracture, while solid irregular struts such as the petrous bones will not fracture, [...]"
                            },
                            {
                                "example_id": "66fe5c35-03b9-409f-9ed9-97a3630d12ef",
                                "sense_id": "a44aa155-3041-3b43-b76a-e93eade5db14",
                                "text": "At impact the skull decelerates first and begins to inbend, creating a positive force meeting the positive force of the forward-moving brain at the site of impact."
                            }
                        ]
                    }
