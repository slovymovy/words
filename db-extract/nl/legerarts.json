                "senses": [
                    {
                        "sense_id": "1ce02a60-62bb-3536-918c-81eef6636981",
                        "entry_id": "48ae2e5c-63ab-3eb0-a4c3-6fee93a17bcb",
                        "glosses": [
                            "arts die medische zorg verleent aan militairen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a38eef0-b2d4-4e12-939e-48ae14bbcbee",
                                "sense_id": "1ce02a60-62bb-3536-918c-81eef6636981",
                                "text": "De liefde voor zijn vrouw Friedel, met wie hij in 1943 in kamp Westerbork is getrouwd, houdt Eddy op de been. In Auschwitz zit hij in Blok 9, zij in Blok 10 ernaast. Daar voert legerarts Josef Mengele zijn wrede medische experimenten uit op de Joodse vrouwen."
                            },
                            {
                                "example_id": "ec5e2291-f7ec-448e-9190-5fe97232471b",
                                "sense_id": "1ce02a60-62bb-3536-918c-81eef6636981",
                                "text": "Een jaar voordat A Bridge Too Far in de bioscoop verscheen, zond de NOS zijn eigen speelfilm uit over Operatie Market Garden, Arnhem: het verhaal van een ontsnapping. De coproductie met de BBC vertelt hoe de Schotse legerarts Graeme Warrack weet te ontsnappen, nadat hij in 1944 bij Arnhem krijgsgevangen was gemaakt."
                            }
                        ]
                    }
