                        ]
                    },
                    {
                        "translation_id": "4a977b9d-02a7-48f1-a4b2-575041a00522",
                        "source_entry_id": "7ef36e31-1fc4-3a05-83ec-2bc226cc9eec",
                        "source_sense_description": "black person",
                        "target_lang_word": "cafre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cafre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09041c4e-ed69-3b26-b334-21ff43702817",
                                        "entry_id": "9ee04baf-8fac-3792-8d19-e7d9f39bd255",
                                        "glosses": [
                                            "Relatif à la Cafrerie ou à quelqu'un habitant cette partie de l'Afrique australe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862b54ae-b5aa-4247-8bf9-f26b9b17e1c7",
                                                "sense_id": "09041c4e-ed69-3b26-b334-21ff43702817",
                                                "text": "Berger cafre, sorcier cafre, langue cafre."
                                            },
                                            {
                                                "example_id": "f627372f-c86f-45fd-a2cf-1f62f174e5ca",
                                                "sense_id": "09041c4e-ed69-3b26-b334-21ff43702817",
                                                "text": "Les Bushmen réussissent des chefs-d'œuvre en plastique, leurs voisins cafres y sont médiocres."
                                            },
                                            {
                                                "example_id": "72cb995d-5ae0-442f-bfab-839ca09ad1d2",
                                                "sense_id": "09041c4e-ed69-3b26-b334-21ff43702817",
                                                "text": "…Le peuple zoulou, comme presque tous les peuples cafres de la région – les Ndébélés, les Shangaan, les Xhosa – sont tous des Nguni, eux-mêmes issus de la vaste famille des Bantous. Donc, pour nous, les Blancs, tout ça c’est un peu la même engeance…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cafre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "51f8ab9a-b6ff-394c-adab-59efa7878c1f",
                                        "entry_id": "8528415d-54c4-3c3e-9699-215207e5c6a1",
                                        "glosses": [
                                            "Personne à la peau noire vivant dans les îles de l’océan Indien."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "820abbb8-054d-4790-b687-4ee6905df9d3",
                                                "sense_id": "51f8ab9a-b6ff-394c-adab-59efa7878c1f",
                                                "text": "On l’appelle aussi fête du 20 décembre 1848, en souvenir l’abolition de l’esclavage. L'île s'est en effet fortement peuplée par l'importation d’esclaves dans les plantations de café et de canne à sucre. La fête - presque une fête nationale ! - n’est pas uniquement réservée aux « cafres » (les Noirs, descendants d’anciens esclaves)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e8bbc1b-74c2-3ac9-8830-c6533eecdeeb",
                                        "entry_id": "8528415d-54c4-3c3e-9699-215207e5c6a1",
                                        "glosses": [
                                            "Africain originaire d’Afrique australe."
                                        ],
                                        "tags": [
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fafd1255-6044-4573-a96e-fc30c234cbee",
                                                "sense_id": "2e8bbc1b-74c2-3ac9-8830-c6533eecdeeb",
                                                "text": "Nous, dans le Connemara, nous ne faisons pas de différence entre les hommes. Sauf s'ils sont effrontés. Une fois, un boy cafre m'avait mal ciré les bottes et quand je lui ai dit, il m'a répondu. Ni une, ni deux, je lui mets aux pieds des souliers de gosse et il a dû se promener comme ça pendant trois jours dans le désert du Kalahari. Sacrément chaud comme endroit, d'ailleurs. Eh bien, monsieur, le troisième jour, les pieds du Cafre étaient moitié plus petits qu'avant. On aurait pu les exposer dans une foire."
                                            },
                                            {
                                                "example_id": "c5871658-3fb6-4e45-b8f8-7dddc5a5120b",
                                                "sense_id": "2e8bbc1b-74c2-3ac9-8830-c6533eecdeeb",
                                                "text": "Et subitement, un démon, surgit de nulle part, lui fit face. L’heure du Jugement Dernier. Le Diable en personne avec son regard fou de rage, des plumes tachées de sang hérissant sa tête, son poitrail puissant comme celui d’un taureau. Et sa peau claire. Étrangement claire pour un Cafre. L’ange exterminateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeba27b8-6070-365a-b10e-e263afd0262d",
                                        "entry_id": "8528415d-54c4-3c3e-9699-215207e5c6a1",
                                        "glosses": [
                                            "Synonyme de aigle de Verreaux, aigle africain au plumage noir."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab14cc7c-2af8-47df-bc65-a77ac7a22ef3",
