                        "examples": [
                            {
                                "example_id": "3caa005c-8c4d-43fb-a4c0-e9c8c9baf4b9",
                                "sense_id": "bea99e66-ad22-327d-8e84-8fe38f1c3c15",
                                "text": "Overigens zal het de Chinese overheid nooit kunnen lukken alle handel aan banden te leggen. De volgens the Wall Street Journal nakende maatregelen hebben alleen betrekking op Chinese online wisselmarkten."
                            },
                            {
                                "example_id": "40ded323-8494-480c-a550-56fcb437d680",
                                "sense_id": "bea99e66-ad22-327d-8e84-8fe38f1c3c15",
                                "text": "Anderhalf jaar nadat zijn bedrijf onder duistere omstandigheden ten onder ging is de Franse topman van Mt. Gox zaterdag in Japan gearresteerd. Mt. Gox was tot vorig jaar februari de grootste wisselmarkt voor bitcoins, de grootste virtuele munt."
                            }
                        ]
