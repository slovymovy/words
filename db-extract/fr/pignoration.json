                                        "entry_id": "e488351c-e9cb-36c0-9f51-08599e388562",
                                        "glosses": [
                                            "Acción o efecto de pignorar (entregar una posesión como prenda para obtener un crédito o préstamo y garantizar que se va a pagar la deuda); acto de dejar en prenda."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a34366e8-3ca7-477a-88f6-837855acafc0",
                                                "sense_id": "76e29a06-9dce-3ecc-8147-3b3cfd9f5236",
                                                "text": "Todas las cosas muebles, susceptibles de ser compradas y vendidas, pueden ser objeto de pignoración, todas pueden ser dejadas en prenda de un préstamo, de un aplazamiento de impuestos, del compromiso de ejecutar una obra, etc."
                                            },
                                            {
                                                "example_id": "ad68e0df-a8df-467a-9c88-0eb4bcd46e63",
                                                "sense_id": "76e29a06-9dce-3ecc-8147-3b3cfd9f5236",
                                                "text": "El proceso de pignoración comienza por un contrato de crédito en que se especifican los procedimientos y condiciones en que el acreedor otorgará fondos a la empresa."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
