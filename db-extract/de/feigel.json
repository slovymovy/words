                ],
                "senses": [
                    {
                        "sense_id": "6b100ec7-8ae1-31dc-b8c9-31a008a00947",
                        "entry_id": "9d08327c-5a47-3651-bbca-67d646615f5e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a75c23ef-9bc4-41bb-b7b6-36efd55890bd",
                                "sense_id": "6b100ec7-8ae1-31dc-b8c9-31a008a00947",
                                "text": "Feigels kamen, sahen und siegten."
                            },
                            {
                                "example_id": "6ac9b38c-a3b3-40e6-bdde-f6ed6dca6579",
                                "sense_id": "6b100ec7-8ae1-31dc-b8c9-31a008a00947",
                                "text": "Frau Feigel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c3eba9c5-9159-4648-889c-93f87619ce75",
                                "sense_id": "6b100ec7-8ae1-31dc-b8c9-31a008a00947",
                                "text": "Herr Feigel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "71374b84-04c5-43fe-b75e-5b2fe4afbfc7",
                                "sense_id": "6b100ec7-8ae1-31dc-b8c9-31a008a00947",
                                "text": "Die Feigels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "77a5fa48-4568-40e0-8e45-43d6e8ccf85b",
                                "sense_id": "6b100ec7-8ae1-31dc-b8c9-31a008a00947",
                                "text": "Der Feigel trägt nie die Schals, die die Feigel ihm strickt."
                            },
                            {
                                "example_id": "78c5906e-a026-4952-8ef3-b3807c01655b",
                                "sense_id": "6b100ec7-8ae1-31dc-b8c9-31a008a00947",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feigel kommt, geht der Herr Feigel.“"
                            },
                            {
                                "example_id": "0f03e303-d733-4c2d-98d1-5b86d11cd1ad",
                                "sense_id": "6b100ec7-8ae1-31dc-b8c9-31a008a00947",
                                "text": "Feigel kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
