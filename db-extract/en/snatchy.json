                        "glosses": [
                            "In snatches or glimpses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b64638-d1fb-45c8-b01f-28bb375f3f12",
                                "sense_id": "4c07c6a4-5e8d-355e-96e8-d11bfb9ef5c0",
                                "text": "We listen to a snatchy talk on one thing and then another, and abstruse questions that are like the Scotchman's definition of metaphysics."
                            },
                            {
                                "example_id": "3b439803-303d-4369-84bb-f0ac4084b2d1",
                                "sense_id": "4c07c6a4-5e8d-355e-96e8-d11bfb9ef5c0",
                                "text": "The long-desired vision came first to Peter in Galilee in the morning twilight, and something of the kind perhaps happened to others; but of all this we have only garbled and snatchy reports."
                            },
                            {
                                "example_id": "1f12c7ba-0260-4b75-88ab-adc2f1e5f6b1",
                                "sense_id": "4c07c6a4-5e8d-355e-96e8-d11bfb9ef5c0",
                                "text": "In positioning the branches, remember that the foliage should be arranged to give snatchy views of the two trunks all the way to the top."
                            }
                        ]
                    }
                ],
