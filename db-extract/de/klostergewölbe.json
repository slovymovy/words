                "senses": [
                    {
                        "sense_id": "88ab9209-d205-3058-8bbd-39b2f1d22d16",
                        "entry_id": "7047dfb7-b20a-3288-ae79-53fb3e3460a8",
                        "glosses": [
                            "eine der Kuppel ziemlich nahe kommende Gewölbeform. Über einer vier- oder mehreckigen Grundfläche setzt auf jeder Seite des Vielecks eine gekrümmte, nach oben schmaler werdende Fläche an. Diese Seitenflächen werden Wangen oder Walmen genannt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "790db77d-b5aa-4441-8a27-4bdedaa9276f",
                                "sense_id": "88ab9209-d205-3058-8bbd-39b2f1d22d16",
                                "text": "„Kuppeln lassen sich als Sonderform des Klostergewölbes mit vieleckigem, kreisförmigem oder ovalem Grundriss betrachten - sie haben ebenfalls nur einen Scheitelpunkt und den ganzen Umfang ihres Grundrisses als Widerlager.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
