                                "example_id": "0db727b7-34b3-46de-a120-fc7631971908",
                                "sense_id": "b136e012-1f96-3028-8d5a-7ce57971f291",
                                "text": "Będąc w Turcji, jechaliśmy przez tę twoją Likaonię, sucho tam i buro."
                            }
