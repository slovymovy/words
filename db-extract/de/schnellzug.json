                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "ca3d4674-035b-46e5-9408-e7cf197932e9",
                                "sense_id": "8405e4a0-4482-305e-96a3-6850e4c9a894",
                                "text": "Breitenwert hatte nur einen kleinen Bahnhof. Viele Züge hielten da nicht, und die großen Schnellzüge fuhren immer sehr hochmütig an dem Städtchen vorbei, und nur die Bummelzüge ruhten sich behaglich ein Weilchen aus, ehe sie weiterdampften."
                            },
                            {
                                "example_id": "5f3e1912-208e-45e9-b26d-e8bc9f69d695",
                                "sense_id": "8405e4a0-4482-305e-96a3-6850e4c9a894",
                                "text": "In nur 28 Minuten soll ein neuer Schnellzug künftig Tel Aviv und Jerusalem verbinden.",
                                "translation": "In only 28 minutes, a new express train is to connect Tel Aviv and Jerusalem in the future.",
                                "english": "In only 28 minutes, a new express train is to connect Tel Aviv and Jerusalem in the future."
                            }
                        ]
                    }
