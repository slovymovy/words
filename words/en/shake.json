{
    "word_family": [
        "shaker",
        "shaky",
        "shakily",
        "shakiness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92fc390a-5d3a-3d8d-8642-065750b51571",
                    "sense_definition": "To cause something to move rapidly in opposite directions alternatingly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wind <w>shook</w> the trees violently.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер яростно <w>тряс</w> деревья.",
                                "zh": "强风猛烈地<w>摇晃</w>着树木。"
                            }
                        },
                        {
                            "text": "Please <w>shake</w> the bottle well before opening it.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, хорошенько <w>встряхните</w> бутылку перед тем, как открыть её.",
                                "zh": "打开前请充分<w>摇晃</w>瓶子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jiggle",
                        "vibrate"
                    ],
                    "common_phrases": [
                        "shake a bottle",
                        "shake well"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять что-либо быстро двигаться в противоположных направлениях; трясти.",
                        "zh": "使某物快速地来回或上下移动；摇动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трясти",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "встряхивать",
                                "target_lang_sense_clarification": "резкое, однократное или короткое действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摇动",
                                "target_lang_sense_clarification": "使物体晃动"
                            },
                            {
                                "target_lang_word": "摇晃",
                                "target_lang_sense_clarification": "物体本身或被外力带动晃动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3da94998-dadb-313c-aab4-4e2f19292dc5",
                    "sense_definition": "To move one's body or a part of it from side to side, often uncontrollably due to cold, fear, or emotion.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She began to <w>shake</w> with cold while waiting for the bus.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>дрожать</w> от холода, ожидая автобус.",
                                "zh": "等公交车时，她冷得开始<w>发抖</w>。"
                            }
                        },
                        {
                            "text": "The poor dog <w>shook</w> with fear during the thunderstorm.",
                            "target_lang_translations": {
                                "ru": "Бедная собака <w>тряслась</w> от страха во время грозы.",
                                "zh": "雷雨中，那只可怜的狗吓得直<w>颤抖</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tremble",
                        "shiver",
                        "quake"
                    ],
                    "common_phrases": [
                        "shake with fear",
                        "shake with cold",
                        "shake like a leaf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дрожать всем телом или его частью, часто неконтролируемо от холода, страха или эмоций.",
                        "zh": "身体或身体某部分因寒冷、恐惧或情绪激动而不由自主地颤动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожать",
                                "target_lang_sense_clarification": "мелкая дрожь"
                            },
                            {
                                "target_lang_word": "трястись",
                                "target_lang_sense_clarification": "сильная дрожь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发抖",
                                "target_lang_sense_clarification": "因寒冷或恐惧而颤抖"
                            },
                            {
                                "target_lang_word": "颤抖",
                                "target_lang_sense_clarification": "身体不由自主地抖动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76db8d0e-868b-3412-9d39-bd36c593fbfa",
                    "sense_definition": "To move one's head from side to side, especially to indicate refusal, reluctance, or disapproval.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>shook</w> his head when I asked if he wanted dessert.",
                            "target_lang_translations": {
                                "ru": "Он <w>покачал</w> головой, когда я спросил, хочет ли он десерт.",
                                "zh": "当我问他要不要甜点时，他摇了<w>摇头</w>。"
                            }
                        },
                        {
                            "text": "The teacher <w>shook</w> her head at the student's excuse.",
                            "target_lang_translations": {
                                "ru": "Учительница <w>покачала</w> головой на оправдание ученика.",
                                "zh": "老师对学生的借口摇了<w>摇头</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shake one's head"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигать головой из стороны в сторону в знак отказа, несогласия или неодобрения.",
                        "zh": "左右摆动头部，表示拒绝、不情愿或不赞同。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качать",
                                "target_lang_sense_clarification": "головой (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "покачать",
                                "target_lang_sense_clarification": "головой (совершенный вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摇头",
                                "target_lang_sense_clarification": "表示否定或不同意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83d812cc-8a76-3001-a799-29dbc967e48c",
                    "sense_definition": "To clasp hands with someone as a greeting, farewell, or sign of agreement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>shake</w> hands after signing the contract.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>пожать</w> друг другу руки после подписания контракта.",
                                "zh": "合同签署后，他们决定<w>握手</w>。"
                            }
                        },
                        {
                            "text": "Let's <w>shake</w> on it to seal the deal.",
                            "target_lang_translations": {
                                "ru": "Давай <w>пожмём</w> руки, чтобы скрепить сделку.",
                                "zh": "我们<w>握手</w>成交吧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shake hands",
                        "shake on it"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сжимать руку другого человека в знак приветствия, прощания или согласия.",
                        "zh": "与人握手，作为问候、告别或达成协议的表示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пожимать",
                                "target_lang_sense_clarification": "руку"
                            },
                            {
                                "target_lang_word": "пожать",
                                "target_lang_sense_clarification": "руку (совершенный вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "握手",
                                "target_lang_sense_clarification": "社交礼仪或达成共识"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e32abe64-fe3d-3046-9861-1677c24ca304",
                    "sense_definition": "To disturb emotionally; to shock or upset someone greatly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The terrible news <w>shook</w> her deeply.",
                            "target_lang_translations": {
                                "ru": "Ужасные новости глубоко её <w>потрясли</w>.",
                                "zh": "那个可怕的消息让她深受<w>震惊</w>。"
                            }
                        },
                        {
                            "text": "He was visibly <w>shaken</w> by the accident he witnessed.",
                            "target_lang_translations": {
                                "ru": "Он был заметно <w>потрясён</w> аварией, свидетелем которой стал.",
                                "zh": "目睹那场事故后，他明显受到了<w>震动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "traumatize"
                    ],
                    "common_phrases": [
                        "badly shaken",
                        "shaken by news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно взволновать, шокировать или лишить душевного равновесия.",
                        "zh": "使人在情感上受到强烈冲击、震惊或不安。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясать",
                                "target_lang_sense_clarification": "шокировать"
                            },
                            {
                                "target_lang_word": "волновать",
                                "target_lang_sense_clarification": "тревожить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "震惊",
                                "target_lang_sense_clarification": "使人感到非常意外和不安"
                            },
                            {
                                "target_lang_word": "动摇",
                                "target_lang_sense_clarification": "使人的信念或情绪不稳定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcdcf252-cbb5-305e-be65-24b57649c619",
                    "sense_definition": "To remove something by agitating or making a jolting motion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took off her shoes to <w>shake</w> the sand out of them.",
                            "target_lang_translations": {
                                "ru": "Она сняла туфли, чтобы <w>вытряхнуть</w> из них песок.",
                                "zh": "她脱下鞋子，把里面的沙子<w>抖掉</w>。"
                            }
                        },
                        {
                            "text": "The dog tried to <w>shake</w> the water from its fur.",
                            "target_lang_translations": {
                                "ru": "Собака пыталась <w>стряхнуть</w> воду со своей шерсти.",
                                "zh": "那只狗试图把毛上的水<w>抖掉</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shake off dust",
                        "shake out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять что-либо, встряхивая или делая резкие движения.",
                        "zh": "通过摇晃或抖动动作将某物从表面或容器中去除。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стряхивать",
                                "target_lang_sense_clarification": "с поверхности"
                            },
                            {
                                "target_lang_word": "вытряхивать",
                                "target_lang_sense_clarification": "изнутри чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抖掉",
                                "target_lang_sense_clarification": "从表面去除"
                            },
                            {
                                "target_lang_word": "抖出",
                                "target_lang_sense_clarification": "从容器内去除"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b4d995e-214c-3476-be8b-9a0067ba4c04",
                    "sense_definition": "To lose, evade, or get rid of something bothersome or unwanted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot <w>shake</w> the feeling that I forgot something important.",
                            "target_lang_translations": {
                                "ru": "Я не могу <w>отделаться</w> от чувства, что забыл что-то важное.",
                                "zh": "我无法<w>摆脱</w>那种我忘了重要事情的感觉。"
                            }
                        },
                        {
                            "text": "The runner accelerated to <w>shake</w> off his competitor.",
                            "target_lang_translations": {
                                "ru": "Бегун ускорился, чтобы <w>оторваться</w> от соперника.",
                                "zh": "赛跑选手加速以<w>甩掉</w>他的竞争对手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shake a habit",
                        "shake a feeling",
                        "shake off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Избавляться от чего-либо неприятного, навязчивого или нежелательного.",
                        "zh": "摆脱或甩掉令人烦恼、不想要的事物或感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избавляться",
                                "target_lang_sense_clarification": "от чего-либо"
                            },
                            {
                                "target_lang_word": "отделываться",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摆脱",
                                "target_lang_sense_clarification": "甩掉不想要的事物"
                            },
                            {
                                "target_lang_word": "甩掉",
                                "target_lang_sense_clarification": "口语中摆脱某人或某事"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9bc4113b-58a3-3d44-995a-3c3819f1f875",
                    "sense_definition": "A sweet beverage made by blending milk, ice cream, and flavorings.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I ordered a burger and a chocolate <w>shake</w> for lunch.",
                            "target_lang_translations": {
                                "ru": "Я заказал на обед бургер и шоколадный <w>коктейль</w>.",
                                "zh": "我午餐点了一个汉堡和一杯巧克力<w>奶昔</w>。"
                            }
                        },
                        {
                            "text": "This strawberry <w>shake</w> is very thick and creamy.",
                            "target_lang_translations": {
                                "ru": "Этот клубничный <w>шейк</w> очень густой и сливочный.",
                                "zh": "这杯草莓<w>奶昔</w>非常浓郁顺滑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chocolate shake",
                        "vanilla shake"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for milkshake"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сладкий напиток из взбитого молока, мороженого и сиропа.",
                        "zh": "由牛奶、冰淇淋和调味品混合而成的甜饮料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коктейль",
                                "target_lang_sense_clarification": "молочный"
                            },
                            {
                                "target_lang_word": "шейк",
                                "target_lang_sense_clarification": "заимствование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奶昔",
                                "target_lang_sense_clarification": "标准译名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c793ced9-1875-3afc-a08b-9aad92c5c49a",
                    "sense_definition": "The act of shaking or a rapid back-and-forth motion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Give the juice a good <w>shake</w> before you pour it.",
                            "target_lang_translations": {
                                "ru": "Хорошенько <w>встряхните</w> сок, прежде чем наливать.",
                                "zh": "倒果汁前先用力<w>摇晃</w>一下。"
                            }
                        },
                        {
                            "text": "She dismissed the idea with a quick <w>shake</w> of her head.",
                            "target_lang_translations": {
                                "ru": "Она отвергла эту идею быстрым <w>покачиванием</w> головы.",
                                "zh": "她快速<w>摇头</w>否定了这个想法。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a shake",
                        "shake of the head"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие встряхивания или быстрое движение.",
                        "zh": "摇晃的动作或快速的来回运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встряхивание",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "покачивание",
                                "target_lang_sense_clarification": "головой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摇晃",
                                "target_lang_sense_clarification": "动作过程"
                            },
                            {
                                "target_lang_word": "摇头",
                                "target_lang_sense_clarification": "特指头部的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fb4d614-8d06-3cfa-b366-fcd3375e4dfe",
                    "sense_definition": "A physical tremor, twitch, or spasm, often caused by illness or withdrawal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had the <w>shakes</w> after drinking too much strong coffee.",
                            "target_lang_translations": {
                                "ru": "У него была <w>трясучка</w> после того, как он выпил слишком много крепкого кофе.",
                                "zh": "喝了太多浓咖啡后，他出现了<w>震颤</w>。"
                            }
                        },
                        {
                            "text": "The high fever gave him terrible <w>shakes</w> throughout the night.",
                            "target_lang_translations": {
                                "ru": "Из-за высокой температуры его била сильная <w>дрожь</w> всю ночь.",
                                "zh": "高烧让他整晚都在剧烈<w>颤抖</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shiver",
                        "tremble"
                    ],
                    "common_phrases": [
                        "get the shakes",
                        "have the shakes"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as 'the shakes'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая дрожь или тремор, часто вызванные болезнью или состоянием организма.",
                        "zh": "身体不由自主的颤抖或痉挛，常由疾病或戒断反应引起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожь",
                                "target_lang_sense_clarification": "симптом"
                            },
                            {
                                "target_lang_word": "трясучка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "颤抖",
                                "target_lang_sense_clarification": "生理性抖动"
                            },
                            {
                                "target_lang_word": "震颤",
                                "target_lang_sense_clarification": "医学或病理性的抖动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e681cab3-491e-3a90-92a1-f334e2b42926",
                    "sense_definition": "A very short moment or instant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will be ready to go in two <w>shakes</w>.",
                            "target_lang_translations": {
                                "ru": "Я буду готов идти через <w>секунду</w>.",
                                "zh": "我马上就好，只需<w>片刻</w>。"
                            }
                        },
                        {
                            "text": "Wait here, I'll be back in a couple of <w>shakes</w>.",
                            "target_lang_translations": {
                                "ru": "Жди здесь, я вернусь через пару <w>минут</w>.",
                                "zh": "在这儿等我，我<w>一会儿</w>就回来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in two shakes"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "idiomatic usage"
                        }
