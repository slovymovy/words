                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0435671a-1de3-4c1f-b8aa-6b0dffb5a36b",
                        "source_entry_id": "d428c824-7f1a-3daa-bb82-b3302dcd3b29",
                        "source_sense_id": "998771b3-594e-3825-a6c9-c7ec4dcc8d99",
                        "target_lang_word": "geopolitical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geopolitical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51d37de5-f04a-3086-a582-4ba5b8577534",
                                        "entry_id": "d03d5d96-aa26-3b0b-a82e-6134aabbe926",
                                        "glosses": [
                                            "Of or relating to geopolitics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c80aff63-4d6a-47ae-800e-a5874ecaca87",
                                                "sense_id": "51d37de5-f04a-3086-a582-4ba5b8577534",
                                                "text": "Weinersmith, who is best known for his webcomic Saturday Morning Breakfast Cereal, describes the polystate as a geopolitical entity in which multiple overlapping states exist — but each “state” consists of citizens who have agreed to the laws of a single non-geographic state; typical geographically-bound nations, or traditional “geostates”, would be replaced by “polystates”, which are collections of “anthrostates”."
                                            },
                                            {
                                                "example_id": "c0dbee64-96e1-4254-ab28-c4a59fdadb08",
                                                "sense_id": "51d37de5-f04a-3086-a582-4ba5b8577534",
                                                "text": "Call it boasting or benevolence, however, the response to the tragedy illustrates the era of “disaster diplomacy,” or the use of foreign aid for influence in a geopolitical competition."
                                            },
                                            {
                                                "example_id": "0950af67-ab6f-42f1-967c-b46e0b0bc2cc",
                                                "sense_id": "51d37de5-f04a-3086-a582-4ba5b8577534",
                                                "text": "In a blog post, the company [Google] said there was “a global competition taking place for A.I. leadership within an increasingly complex geopolitical landscape. We believe democracies should lead in A.I. development.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86ab0b31-d0a7-4a80-b626-e218d49d8906",
                        "source_entry_id": "d428c824-7f1a-3daa-bb82-b3302dcd3b29",
                        "source_sense_id": "998771b3-594e-3825-a6c9-c7ec4dcc8d99",
                        "target_lang_word": "géopolitique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géopolitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f174902d-fefc-39b0-8313-86147054234b",
                                        "entry_id": "6f324075-4c96-3405-b53f-820368ef95b9",
                                        "glosses": [
                                            "Relatif à la géopolitique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee18195c-3b6e-4154-a6cb-b68d6374a47c",
                                                "sense_id": "f174902d-fefc-39b0-8313-86147054234b",
                                                "text": "\"The New Digital Age\" est, avant tout, une tentative de la part de Google de se positionner comme le visionnaire géopolitique de l'Amérique – la seule entreprise capable de répondre à la question : \"Où doit aller l'Amérique ?\" Il n'est donc guère surprenant qu'un certain nombre des plus grands fauteurs de guerre soient convoqués pour apporter leur caution à cette défense du soft power occidental."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "géopolitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b75fed03-70b7-37e1-bc96-9c3c6fdab501",
                                        "entry_id": "ff9bbfb5-1db5-3aef-ae7b-f39904f8a226",
                                        "glosses": [
                                            "Science humaine qui étudie les implications politiques de la géographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a76ac409-8123-45ac-b11f-f3eeea7e1765",
                                                "sense_id": "b75fed03-70b7-37e1-bc96-9c3c6fdab501",
                                                "text": "[Sait-il] qu’un carton rouge de trop peut menacer la paix mondiale ? C’est ce que nous ont expliqué, pendant cette longue semaine de délire médiatique, les spécialistes de la géopolitique."
                                            },
                                            {
                                                "example_id": "e4dd7103-1c9f-4dc9-ac19-3a9919c652ae",
                                                "sense_id": "b75fed03-70b7-37e1-bc96-9c3c6fdab501",
                                                "text": "En géopolitique, il n’y a rien de simple. Il est soulageant toutefois de s’entendre sur les faits, sur qui sont les bons (pour citer Joe Biden, « ... les dirigeants de nos alliés proches, dont le Canada, [avec qui] reconstruire le muscle de nos alliances démocratiques atrophié au cours des dernières années... ») et qui sont les méchants, ceux qui tyrannisent, empoisonnent, emprisonnent pour se maintenir au pouvoir."
                                            },
                                            {
                                                "example_id": "bda75d2c-6a3b-4f93-95db-99b970a5e396",
                                                "sense_id": "b75fed03-70b7-37e1-bc96-9c3c6fdab501",
                                                "text": "Chaque jour, Harold Hyman, chroniqueur à BFMTV, explique les nœuds de la géopolitique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df7f2f0c-5053-43f1-b3bf-d3b880e68ba1",
                        "source_entry_id": "d428c824-7f1a-3daa-bb82-b3302dcd3b29",
                        "source_sense_id": "998771b3-594e-3825-a6c9-c7ec4dcc8d99",
                        "target_lang_word": "geopolítico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "035c1941-ec9c-4134-a649-90c7dff3b8f1",
                        "source_entry_id": "d428c824-7f1a-3daa-bb82-b3302dcd3b29",
                        "source_sense_id": "998771b3-594e-3825-a6c9-c7ec4dcc8d99",
                        "target_lang_word": "geopolitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geopolitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56666974-fcb2-3349-8fe8-7347c23e68e5",
                                        "entry_id": "8912bc26-d061-344d-949a-c438658e8283",
                                        "glosses": [
                                            "die Geopolitik betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "369bba99-01d7-43b5-a725-5156cbd3b39f",
                                                "sense_id": "56666974-fcb2-3349-8fe8-7347c23e68e5",
                                                "text": "Die Türkei würde eine wichtige geopolitische Rolle für die Europäische Union spielen, wenn sie in diese aufgenommen würde."
                                            },
                                            {
                                                "example_id": "e36ff3b9-26d1-4988-998f-01fbf93d9273",
                                                "sense_id": "56666974-fcb2-3349-8fe8-7347c23e68e5",
                                                "text": "„Von damals her stammen die Entfremdung und das Misstrauen, die den Subkontinent bis heute prägen und zu einer geopolitischen Gefahrenzone machen.“"
                                            },
                                            {
                                                "example_id": "94cfa7c3-db3b-4180-8ee5-2379b2439f77",
                                                "sense_id": "56666974-fcb2-3349-8fe8-7347c23e68e5",
                                                "text": "„Kabul erkennt bis heute den Grenzverlauf aus ethno- und geopolitischen Gründen nicht an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "635bdfe7-769b-45a1-9f12-38e354508de4",
                        "source_entry_id": "d428c824-7f1a-3daa-bb82-b3302dcd3b29",
                        "source_sense_id": "998771b3-594e-3825-a6c9-c7ec4dcc8d99",
                        "target_lang_word": "геополитический",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "геополитический",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "29dee5f4-5136-308d-b67f-4644c404245a",
                                        "entry_id": "d843ea26-af81-3a35-98bb-02bd9a284588",
                                        "glosses": [
                                            "книжн. связанный, соотносящийся по значению с существительным геополитика"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5edb329e-4ecf-456e-81c1-5d03c43e5874",
                                                "sense_id": "29dee5f4-5136-308d-b67f-4644c404245a",
                                                "text": "А между тем, в силу геополитических и экономических условий, как в период, предшествовавший мировой войне, так и ныне, единение Франции с Национальной Россией является проблемой жизненной, естественной и обоюдно-необходимой."
                                            },
                                            {
                                                "example_id": "41955ac3-d546-455a-9202-7c659b40fa86",
                                                "sense_id": "29dee5f4-5136-308d-b67f-4644c404245a",
                                                "text": "Это, как я убежден, возможно лишь в результате глубоких геополитических, социально-экономических и идеологических изменений в направлении сближения (конвергенции) капиталистической и социалистической систем и открытости общества, при достижении большего равновесия всех рас и народов не только юридически, но и в экономическом, культурном и социальном отношении."
                                            }
                                        ]
                                    }
                                ]
