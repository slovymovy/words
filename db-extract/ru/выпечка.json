                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "022e5e4d-4be0-4344-a238-7e611b79a2cc",
                        "source_entry_id": "862274fc-7af3-35e9-9948-449a9c09068b",
                        "source_sense_description": "выпеченные изделия из муки",
                        "target_lang_word": "pâtisserie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pâtisserie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ceccb59-3a79-32e7-b8a3-40275fb4ea69",
                                        "entry_id": "45dedba0-cb5a-3a15-a3ab-cc9f101a5eb0",
                                        "glosses": [
                                            "Préparation sucrée ou salée de pâte préparée et cuite au four."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af8d0759-d78b-4900-b340-328138b53784",
                                                "sense_id": "2ceccb59-3a79-32e7-b8a3-40275fb4ea69",
                                                "text": "Mais ça peut donner de belles choses, comme les pâtisseries de Jeffrey Cagnes à déguster en exclusivité dans le City garage de la marque espagnole de voitures Cupra, ouvert à la Madeleine, à Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b0c90d4-d113-37a1-be8e-1412f7fff5d3",
                                        "entry_id": "45dedba0-cb5a-3a15-a3ab-cc9f101a5eb0",
                                        "glosses": [
                                            "Art de faire la pâtisserie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a46d706-185d-42b8-b609-4c8aefe7bc98",
                                                "sense_id": "1b0c90d4-d113-37a1-be8e-1412f7fff5d3",
                                                "text": "Cette ville est réputée pour sa pâtisserie."
                                            },
                                            {
                                                "example_id": "5fbcfec3-ae82-4611-9198-4909767bdc4a",
                                                "sense_id": "1b0c90d4-d113-37a1-be8e-1412f7fff5d3",
                                                "text": "— La pâtisserie, merde alors, si c’est ça que tu appelles un métier !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3dbe3d3-516a-30f9-a5ac-6d1d068cd056",
                                        "entry_id": "45dedba0-cb5a-3a15-a3ab-cc9f101a5eb0",
                                        "glosses": [
                                            "Magasin où l’on vend des gâteaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "486f8a6c-6151-4787-b22c-692b14fb91b3",
                                                "sense_id": "f3dbe3d3-516a-30f9-a5ac-6d1d068cd056",
                                                "text": "Goûter dans une pâtisserie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dee78015-5643-3d82-b455-d4d500481af8",
                                        "entry_id": "45dedba0-cb5a-3a15-a3ab-cc9f101a5eb0",
                                        "glosses": [
                                            "Gâteaux et sucreries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02598c2-15e8-4536-b196-aafdf4a82012",
                                                "sense_id": "dee78015-5643-3d82-b455-d4d500481af8",
                                                "text": "On est vraiment de l’autre côté des Pyrénées. Un petit café noir. Café negro. Il y a tout un assortiment de biscuits collants, de pâtisseries compactes, d’étouffe-chrétiens emballés sous cellophane, conditionnés."
                                            }
                                        ]
                                    },
