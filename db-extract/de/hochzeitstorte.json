                        "entry_id": "feaf44b5-47ae-395d-bc53-fdcb0d552c8a",
                        "glosses": [
                            "Torte, die besonders aufwändig dekoriert ist und am Tag der Hochzeit gegessen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cccf6ba4-65ff-4150-b698-b4024290d2ce",
                                "sense_id": "a0d600ad-eeff-39ab-aa8b-1d8480004ee7",
                                "text": "Traditionell wird die Hochzeitstorte von Braut und Bräutigam gemeinsam angeschnitten."
                            },
                            {
                                "example_id": "3ddcf0c1-8da7-4b9b-b71c-02c2e62d85a1",
                                "sense_id": "a0d600ad-eeff-39ab-aa8b-1d8480004ee7",
                                "text": "„Die Kellner begannen, die Hochzeitstorte zu servieren, einer rempelte mich an und entschuldigte sich mit einem falschen Lächeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
