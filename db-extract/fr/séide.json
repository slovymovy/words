        "fr-extract.jsonl": [
            {
                "entry_id": "1da80759-39a6-35e7-9916-797a8812d15f",
                "word": "séide",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5d447f97-9652-48f5-baf0-5b6c1a4f5154",
                        "entry_id": "1da80759-39a6-35e7-9916-797a8812d15f",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "séides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8dd51d69-8611-3a54-8ae6-fec06e7cbe36",
                        "entry_id": "1da80759-39a6-35e7-9916-797a8812d15f",
                        "glosses": [
                            "Fanatique aveuglément dévoué à un chef, une cause ou un parti."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bbad977-b1e4-40d6-97d7-d97824ddb492",
                                "sense_id": "8dd51d69-8611-3a54-8ae6-fec06e7cbe36",
                                "text": "Soudry fils, qui, depuis deux ans, occupait le principal siège du ministère public, était un séide de Gaubertin."
                            },
                            {
                                "example_id": "f01eac21-78f2-455e-8305-4471e9d5793a",
                                "sense_id": "8dd51d69-8611-3a54-8ae6-fec06e7cbe36",
                                "text": "Il résulte de ceci qu’au bout d’un certain temps, le tyran de la chirurgie eut un Séide. Ces deux hommes, l’un au faîte des honneurs et de sa science, jouissant d’une immense fortune et d’une immense gloire ; l’autre, modeste Oméga, n’ayant ni fortune ni gloire, devinrent intimes."
                            },
                            {
                                "example_id": "2ae32ff1-e00e-4846-a9a2-9743970138dc",
                                "sense_id": "8dd51d69-8611-3a54-8ae6-fec06e7cbe36",
                                "text": "Les six séides du maréchal d’Ancre avaient, la veille, tiré au sort le cheval demeuré dans les écuries de l’hôtel."
                            },
                            {
                                "example_id": "ee649e72-8ff8-4d44-8012-9605fc114f53",
                                "sense_id": "8dd51d69-8611-3a54-8ae6-fec06e7cbe36",
                                "text": "La loi y est au mieux laissée au hasard, la plupart du temps appliquée par des magistrats autoproclamés et épaulés par des séides qu’ils recrutent eux-mêmes."
                            },
                            {
                                "example_id": "a8ef33f2-2cc9-430f-9d93-680e22087701",
                                "sense_id": "8dd51d69-8611-3a54-8ae6-fec06e7cbe36",
                                "text": "…tout tombé qu’il est pour ne se relever jamais, je l’espère, Napoléon a conservé ses séides"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48681345-eeef-499f-b490-fbf7dc4a53c6",
                        "source_entry_id": "1da80759-39a6-35e7-9916-797a8812d15f",
                        "source_sense_id": "8dd51d69-8611-3a54-8ae6-fec06e7cbe36",
                        "target_lang_word": "henchman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "henchman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd0ee67-008e-35e9-8040-dbc70b93be5c",
                                        "entry_id": "7f1ff268-d030-3aaa-a461-66ab14575320",
                                        "glosses": [
                                            "A loyal and trusted follower or subordinate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0951c881-7ff9-3d69-9e50-b91f4757df5d",
                                        "entry_id": "7f1ff268-d030-3aaa-a461-66ab14575320",
                                        "glosses": [
                                            "A person who supports a political figure chiefly out of selfish interests."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cc95526-34b6-4e2f-b03a-4ebaace6015e",
                                                "sense_id": "0951c881-7ff9-3d69-9e50-b91f4757df5d",
                                                "text": "The glib sophistries of the special pleader and the verdant gullibility of the public; the ridiculous, now happily fast disappearing partisan bias of the voter and the venal instincts of the political henchman; the lack of proper moral stamina in much of our public press, and the tardiness of practical public appreciation where journals are true to the people's interests the fear of the vengeance;"
                                            },
                                            {
                                                "example_id": "6a90c5a9-0eca-49dc-beb7-f4184d028a62",
                                                "sense_id": "0951c881-7ff9-3d69-9e50-b91f4757df5d",
                                                "text": "It is madness to commence war against the audacious despots under any leader like Lafayette, the traitor and venal henchman of despotism, against whom the cries of the patriots murdered on July 17 call to Heaven."
                                            },
                                            {
                                                "example_id": "30bf1be1-1603-4c12-b99a-73d40e437a61",
                                                "sense_id": "0951c881-7ff9-3d69-9e50-b91f4757df5d",
                                                "text": "the great task confronting humankind today in effecting government that is worth its powder and shot is not regularity of attendance at the polls so much as in the intelligent analysis of the true leader from the henchman seeking selfish profit from the filling of an office."
                                            },
                                            {
                                                "example_id": "138c291d-783d-4c91-a0b9-02e2b87d0de0",
                                                "sense_id": "0951c881-7ff9-3d69-9e50-b91f4757df5d",
                                                "text": "In appreciation for his service of railroading Frank, the power-brokering Watson sent his venal henchman Dorsey to the U.S. Congress for two terms ."
                                            },
                                            {
                                                "example_id": "fc5e18d8-1330-4c87-8e70-bcb8b2a54c18",
                                                "sense_id": "0951c881-7ff9-3d69-9e50-b91f4757df5d",
                                                "text": "The practice of doubling in this production further emphasizes the ascendancy of corporeal decay and violence in the tetralogy, for, in addition to Cade, Oliver Cotton also appears as the seductive cuckold-maker Suffolk and, in the final of the three installments of The Plantagenets, as Richard of Gloucester's venal and Machiavellian henchman, the Duke of Buckingham ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2e06f27-4d54-3e8b-ae64-fc09b3785d31",
                                        "entry_id": "7f1ff268-d030-3aaa-a461-66ab14575320",
                                        "glosses": [
                                            "An assistant member of a criminal gang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7114e8ed-146b-4590-b706-58ed3abc20b7",
                                                "sense_id": "a2e06f27-4d54-3e8b-ae64-fc09b3785d31",
                                                "text": "Most of the carpet joints were run by the mobsters and local henchmen associated with the Mayfield Road Gang, but Peter Schmidt's Playtorium and Glenn Rendezvous were also included."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35630306-1956-3271-9fc5-a26509198aa2",
                                        "entry_id": "7f1ff268-d030-3aaa-a461-66ab14575320",
                                        "glosses": [
                                            "A page to a prince or other person of high rank."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b5920ac-d386-4b02-bfba-e7b1d41d8d80",
                                                "sense_id": "35630306-1956-3271-9fc5-a26509198aa2",
                                                "text": "Henchmen had placed, as was their habit, each warrior's gear and trappings above his pile of skins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
