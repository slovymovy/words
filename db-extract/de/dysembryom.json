                "senses": [
                    {
                        "sense_id": "9681c2ac-8fc4-31f1-94ea-e6ed92168a32",
                        "entry_id": "c84bd3cc-0815-3016-910c-11dfd9f47d03",
                        "glosses": [
                            "benignes oder malignes Teratom, das embryonales Gewebe enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50045390-fc82-4ff2-a8c6-9256500619a0",
                                "sense_id": "9681c2ac-8fc4-31f1-94ea-e6ed92168a32",
                                "text": "„Die Genese des behaarlen Nasenrachenpolypen gilt als völlig unklar. Das wird durch die Synonyme ‚pharyngotympanales Dysembryom‘ [79], ‚Nasenrachenteratom‘ [90] und ‚benign congenital hamarton‘ [193] ausgedrückt.“"
                            },
                            {
                                "example_id": "1cb1c2e3-1ebb-4a35-b9d9-508c9fedae0e",
                                "sense_id": "9681c2ac-8fc4-31f1-94ea-e6ed92168a32",
                                "text": "„Heteroplastische Dysembryome sind z. B. sog. ‚Dermoidcysten‘ und Teratome bzw. teratoide Geschwülste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
