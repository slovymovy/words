                "senses": [
                    {
                        "sense_id": "bc9e1166-01c5-31d2-aee6-402b9566a43e",
                        "entry_id": "74f97fca-b5f7-3536-8fb8-ad1cce650dcb",
                        "glosses": [
                            "Décharger ce qui est sur une palette."
                        ],
                        "tags": [
                            "Logistique"
                        ],
                        "examples": [
                            {
                                "example_id": "5b2bec05-f59d-4b69-80f4-c85723b63e31",
                                "sense_id": "bc9e1166-01c5-31d2-aee6-402b9566a43e",
                                "text": "Le seul inconvénient du procédé est que chaque colis est pris deux fois (une fois pour dépalettiser et introduire dans le transcasier, l’autre fois pour préparer la commande) au lieu d’une."
                            },
                            {
                                "example_id": "82677df3-6474-4249-8264-fc29dd162699",
                                "sense_id": "bc9e1166-01c5-31d2-aee6-402b9566a43e",
                                "text": "Vu le progrès de la mécanisation et la nécessité de l’abaissement du prix de revient, certains constructeurs proposent aujourd’hui sur le marché des machines automatiques à palettiser et dépalettiser (figure 90)."
                            }
                        ]
                    }
