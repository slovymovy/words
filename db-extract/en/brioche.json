                    {
                        "sense_id": "4f47125c-dc85-3939-9d6a-ee7a7b1f6d3a",
                        "entry_id": "95930f10-1c1b-3ec4-bdd6-4c64532e4a09",
                        "glosses": [
                            "A type of light sweet pastry or bun of French origin."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "284508ee-9160-4685-81e8-f5859083ac06",
                                "sense_id": "4f47125c-dc85-3939-9d6a-ee7a7b1f6d3a",
                                "text": "French brioche dough is especially rich in butter and eggs. It's often retarded […] for 6–18 hours to stiffen it, then rolled out and briefly rested."
                            },
                            {
                                "example_id": "4be639c8-634d-4220-87f3-3a5c17ca1168",
                                "sense_id": "4f47125c-dc85-3939-9d6a-ee7a7b1f6d3a",
                                "text": "She sat him at the table in the saloon, then unobtrusively she made him tea and brought him slices of brioche spread with lock keeper’s honey."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c6bb5b2-0e58-3945-860f-48e088c29633",
                        "entry_id": "95930f10-1c1b-3ec4-bdd6-4c64532e4a09",
                        "glosses": [
                            "A knitted cushion for the feet."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
