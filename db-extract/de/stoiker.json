                    {
                        "translation_id": "1dabe7d3-4021-442b-82c6-bfb1cd260224",
                        "source_entry_id": "51d3f1e7-a6f2-392b-ba70-0a2fffbb538e",
                        "source_sense_id": "adf93451-6367-33d7-95e4-e36596e9d975",
                        "source_sense_description": "Philosophie: ein Vertreter des Stoizismus",
                        "target_lang_word": "스토아 철학자",
                        "target_lang_code": "ko",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "126a2030-9f37-42d4-b84f-afed3985772f",
                        "source_entry_id": "51d3f1e7-a6f2-392b-ba70-0a2fffbb538e",
                        "source_sense_id": "adf93451-6367-33d7-95e4-e36596e9d975",
                        "source_sense_description": "Philosophie: ein Vertreter des Stoizismus",
                        "target_lang_word": "stoïcijn",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoïcijn",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ab1a868-9c8e-38ca-9416-19b1fa39bb7b",
                                        "entry_id": "aa7e97d2-d00b-3f4a-9808-e2f072b47f48",
                                        "glosses": [
                                            "een onverstoorbaar en gelijkmoedig mens die leed onverstoorbaar draagt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6a11366-a8b2-4297-ba43-4a50ccf9abca",
                                                "sense_id": "8ab1a868-9c8e-38ca-9416-19b1fa39bb7b",
                                                "text": "De stoïcijn naast de bank riep: laaaaar en liet van opwinding zijn lege mok op het parket kapotvallen. Hij rende naar de televisie om de herhaling beter te zien: 'Zie je dat? Die vent neemt het leer in één keer op zijn slof!'"
                                            },
                                            {
                                                "example_id": "9f9101a1-3ef3-4408-9236-57dea5dd494d",
                                                "sense_id": "8ab1a868-9c8e-38ca-9416-19b1fa39bb7b",
                                                "text": "Onophoudelijk speelt hij rollen: die van de diplomaat, de aristocraat, de gentleman, de stoïcijn en zo verder. Hij is zich volkomen bewust van zijn onechtheid, want hij bestudeert zichzelf voortdurend, maar redeneert die weg: 'En wat ge u inbeeldt te zijn, dat zijt ge tenslotte.'"
                                            },
                                            {
                                                "example_id": "b127db7c-bf7c-4c33-bb05-3c4b0eb1e60c",
                                                "sense_id": "8ab1a868-9c8e-38ca-9416-19b1fa39bb7b",
                                                "text": "Hij zorgde ook dat hij angsthazen met angsthazen vergeleek, stoïcijnen met stoïcijnen en vrouwen met vrouwen."
                                            },
                                            {
                                                "example_id": "10f95076-8cc2-486d-bac5-bf8f6c385648",
                                                "sense_id": "8ab1a868-9c8e-38ca-9416-19b1fa39bb7b",
                                                "text": "Wie nu zijn nuchtere en soms gelaten beschouwingen over de menselijke emoties leest, herkent een man die van zichzelf verlangt dat hij de werkelijkheid onvervaard beziet, met alle besef van onmacht en verlies van dien, een zachte stoïcijn. Dus was hij tegen de mensen die hem na stonden zorgzaam, belangstellend, vaak heel grappig en haast altijd vol goede moed. Hij heeft de mensenwetenschap en de mensen veel nagelaten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
