                        "source_entry_id": "92684b63-b4e8-3131-bbd9-b6b697b6e791",
                        "source_sense_id": "9a4652b6-fdd9-31ed-be02-0c5af58be5c9",
                        "source_sense_description": "Of, from, or pertaining to Kenya or the Kenyan people",
                        "target_lang_word": "kényan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
