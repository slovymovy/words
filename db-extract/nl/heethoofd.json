                            {
                                "example_id": "880c8457-c299-431a-9286-d713ba380a8c",
                                "sense_id": "45fe55b7-b2cd-34f3-8212-255230faa1de",
                                "text": "De jongen die zij met uitgaan had leren kennen bleek een enorme heethoofd te zijn."
                            }
                        ]
