                "senses": [
                    {
                        "sense_id": "6db72f2f-b7eb-34a2-8bfa-ee3e3146df0b",
                        "entry_id": "f8f36977-3378-317a-80b4-c6bc55bcaeaf",
                        "glosses": [
                            "von der Lebensmittelindustrie verwendetes Produkt, das in Aussehen und Geschmack Käse ähnelt, aber nicht aus Milch gewonnen wird und auch nicht als Käse bezeichnet werden darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddc87b23-12d6-4625-a8d2-0fdf640f8f09",
                                "sense_id": "6db72f2f-b7eb-34a2-8bfa-ee3e3146df0b",
                                "text": "„Die Milcherzeuger haben in Deutschland einen neuen Konkurrenten: der Analogkäse – ein Gemisch aus Wasser, Palmöl, pflanzlichen Fetten, Weizenmehl, Geschmacksverstärkern und Kartoffelstärke.“"
                            },
                            {
                                "example_id": "b42c1d85-9001-4d35-8a1d-1846297f8a46",
                                "sense_id": "6db72f2f-b7eb-34a2-8bfa-ee3e3146df0b",
                                "text": "Wenn die „Käsestangen“ beim Bäcker plötzlich „Knusperstangen“ heißen, ist wohl der verwendete Analogkäse schuld."
                            },
                            {
                                "example_id": "44086bc9-1bfd-4149-8938-2bc0ce4c2505",
                                "sense_id": "6db72f2f-b7eb-34a2-8bfa-ee3e3146df0b",
                                "text": "„In Zeiten von Analogkäse und Klebeschinken traut man eben auch dem durchschnittlichen Leberkäse-Fabrikanten einiges zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
