    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ed0f507-2a81-30ad-b2a2-45c9f33036da",
                    "sense_definition": "A false or invented reason given to hide one's true intentions.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reporter called the company on the <w>pretext</w> of trying to resolve a consumer complaint."
                        },
                        {
                            "text": "She used a minor illness as a <w>pretext</w> to avoid attending the boring meeting."
                        }
                    ],
                    "synonyms": [
                        "excuse",
                        "pretense"
                    ],
                    "common_phrases": [
                        "on the pretext of"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe3f968a-cbdf-3203-92ba-e7b4a53d7575",
                    "sense_definition": "To use a false reason or excuse to gain something or justify an action.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy <w>pretexted</w> a need for directions to gain access to the secure building."
                        },
                        {
                            "text": "He was caught <w>pretexting</w> an emergency to leave work early every Friday."
                        }
                    ]
                }
            ]
        }
    ]
