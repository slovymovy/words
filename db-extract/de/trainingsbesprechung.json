                "senses": [
                    {
                        "sense_id": "b8158b16-85f0-3e80-970e-b92b31aec388",
                        "entry_id": "5723050d-6148-3bc7-a6f9-1f3d270ac5a7",
                        "glosses": [
                            "Sitzung oder Gespräch zwischen Trainer und Sportler(n) im Zusammenhang mit einem Training, meist zur Organisation oder Analyse des Trainingsablaufs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b43a335-6c33-4b4c-9b7d-7c617c8c7127",
                                "sense_id": "b8158b16-85f0-3e80-970e-b92b31aec388",
                                "text": "„Dazu treffen sich alle Ruderer um 15 Uhr im Bootshaus zur Trainingsbesprechung, um die Einteilung der Trainingsgruppen und die Trainingszeiten zu besprechen.“"
                            },
                            {
                                "example_id": "154d0b62-1427-4c29-b00d-1e16e1a824bd",
                                "sense_id": "b8158b16-85f0-3e80-970e-b92b31aec388",
                                "text": "„Regelmäßige Trainingsbesprechungen und ständiger Austausch mit Deinem Laufcoach sichern Deinen Erfolg.“"
                            },
                            {
                                "example_id": "06a5869c-15a0-4606-a997-5522694b4c1d",
                                "sense_id": "b8158b16-85f0-3e80-970e-b92b31aec388",
                                "text": "„Sowohl ein Personal-Coaching, ein cooles Training, eine unvergessliche Techniklektion, als auch eine Trainingsbesprechung soll Motivation, Leben, Spass, Improvisation und Erinnerungspotential beinhalten.“"
                            },
                            {
                                "example_id": "6c3c5ce5-9182-4339-9964-8b4434c1f39f",
                                "sense_id": "b8158b16-85f0-3e80-970e-b92b31aec388",
                                "text": "„Die Anschaffung eines modernen 175 Zoll-Fernsehgerätes ermöglicht sogar virtuelle Museumsbesuche, Musikkonzerte oder Trainingsbesprechungen nach den Tennistrainings der Kinder.“"
                            },
                            {
                                "example_id": "47a2df72-78ca-454f-a1f9-c1a751f81475",
                                "sense_id": "b8158b16-85f0-3e80-970e-b92b31aec388",
                                "text": "„Zentrale Voraussetzung ist, dass die AHA-Regeln auch weiter und ggf. auch während des Sporttreibens eingehalten werden, dass z. B. Trainingsbesprechungen mindestens auf Abstand oder mit Mund-Nasen-Maske abgehalten werden, dass es keine größeren Gruppenbildungen beim Warten gibt oder im Mannschaftssport mit Maske gespielt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
