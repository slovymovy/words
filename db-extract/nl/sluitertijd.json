                    {
                        "sense_id": "b6095998-f8f1-3248-8c1d-89dbe1e67aba",
                        "entry_id": "2feb78d4-8117-39e1-a31c-d3d198f9b3d4",
                        "glosses": [
                            "de tijd dat een foto belicht wordt"
