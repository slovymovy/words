                        "sense_id": "a033c1dd-a60e-3ab3-a7d1-0cf9ac7f7333",
                        "entry_id": "5d40d086-5b41-3365-9c1f-e5e7a6dc705c",
                        "glosses": [
                            "met een gelijke klank"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "10ea9fcc-2f01-3ee4-be0d-dcb3b9e37cfb",
                        "entry_id": "5d40d086-5b41-3365-9c1f-e5e7a6dc705c",
                        "glosses": [
                            "met een gelijke inhoud"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be013491-b5c0-4fdc-9ada-2c844b79e352",
                                "sense_id": "10ea9fcc-2f01-3ee4-be0d-dcb3b9e37cfb",
                                "text": "De briefjes die een lakei in rode livrei 's ochtends had rondgebracht waren allemaal gelijkluidend"
                            },
                            {
                                "example_id": "cf260378-97e8-4cc4-93ab-15a2c35eb291",
                                "sense_id": "10ea9fcc-2f01-3ee4-be0d-dcb3b9e37cfb",
                                "text": "Honderden kranten en weekbladen in Amerika hebben vandaag een gelijkluidend hoofdcommentaar geplaatst. Daarmee reageren ze op de aanvallen van president Trump op de media, die hij bijna dagelijks als brengers van \"nepnieuws\" bestempelt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f098a6b6-c33c-4f43-b532-b52eaef64059",
                        "source_entry_id": "5d40d086-5b41-3365-9c1f-e5e7a6dc705c",
                        "source_sense_id": "a033c1dd-a60e-3ab3-a7d1-0cf9ac7f7333",
                        "target_lang_word": "unisonous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unisonous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86ee8526-c387-35ae-97d1-8c98ea3b5583",
                                        "entry_id": "ea8605cb-6ce9-31e4-b4fd-9e5103fd21fc",
                                        "glosses": [
                                            "Being in unison; unisonant."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5a75bb2-0660-4794-a154-1b8b78d1b48f",
                                                "sense_id": "86ee8526-c387-35ae-97d1-8c98ea3b5583",
                                                "text": "Hitherto all the singing in the American churches had been unisonous, the melody only having been sung; but in 1720 a book of tunes in threo parts, \"Cantus,\" \"Medius\" and \"Basus,\" was published by Rev. Thomas Walter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5935ca1-f5ca-4e67-82f0-1f28fb2e8970",
                        "source_entry_id": "5d40d086-5b41-3365-9c1f-e5e7a6dc705c",
                        "source_sense_id": "a033c1dd-a60e-3ab3-a7d1-0cf9ac7f7333",
                        "target_lang_word": "concurrent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concurrent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7111c82b-0bc0-35b4-b5e4-a3d623fd5405",
                                        "entry_id": "9ebd9c36-778b-34f8-b61b-2a27599648b4",
                                        "glosses": [
                                            "Happening at the same time; simultaneous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f75e1cf-764c-4cdb-88ed-dbb7359bf117",
                                                "sense_id": "7111c82b-0bc0-35b4-b5e4-a3d623fd5405",
                                                "text": "concurrent echo"
                                            },
                                            {
                                                "example_id": "baab2156-8e3a-40d9-a9c4-53c796db1992",
                                                "sense_id": "7111c82b-0bc0-35b4-b5e4-a3d623fd5405",
                                                "text": "Such are the changes which science recognizes in the wire itself, as concurrent with the visual changes taking place in the eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7032cd92-cad1-3eac-bf0d-4f3bca090d9e",
                                        "entry_id": "9ebd9c36-778b-34f8-b61b-2a27599648b4",
                                        "glosses": [
                                            "Belonging to the same period; contemporary."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85fda3a4-caf4-3dc9-b4ee-6c9d22e4608b",
                                        "entry_id": "9ebd9c36-778b-34f8-b61b-2a27599648b4",
                                        "glosses": [
                                            "Acting in conjunction; agreeing in the same act or opinion; contributing to the same event or effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52467c60-3784-4048-ac00-7de5a0e73f81",
                                                "sense_id": "85fda3a4-caf4-3dc9-b4ee-6c9d22e4608b",
                                                "text": "I join with these laws the personal presence of the king's son, as a concurrent cause of this reformation."
                                            },
                                            {
                                                "example_id": "6589e06e-2930-41ea-b682-2f7af4bfe991",
                                                "sense_id": "85fda3a4-caf4-3dc9-b4ee-6c9d22e4608b",
                                                "text": "the concurrent testimony of antiquity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b23f8c34-8bff-3a43-ab38-f6900d637a6a",
                                        "entry_id": "9ebd9c36-778b-34f8-b61b-2a27599648b4",
                                        "glosses": [
                                            "Joint and equal in authority; taking cognizance of similar questions; operating on the same objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d167be39-505e-482b-a30d-5d5525e808af",
                                                "sense_id": "b23f8c34-8bff-3a43-ab38-f6900d637a6a",
                                                "text": "the concurrent jurisdiction of courts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1aa8788-d573-3c1a-af99-40a7455a93fa",
                                        "entry_id": "9ebd9c36-778b-34f8-b61b-2a27599648b4",
                                        "glosses": [
                                            "Meeting in one point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b70a625-c672-38ce-ac71-a05f85d477b3",
                                        "entry_id": "9ebd9c36-778b-34f8-b61b-2a27599648b4",
                                        "glosses": [
                                            "Running alongside one another on parallel courses; moving together in space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d85565b4-782f-3cfa-abe0-5a31b298f24c",
                                        "entry_id": "9ebd9c36-778b-34f8-b61b-2a27599648b4",
                                        "glosses": [
                                            "Designed to run independently, rather than sequentially, using various mechanisms, such as threads, event loops or time-slicing."
                                        ],
                                        "tags": [
                                            "of code"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19faa25d-7e43-421f-a21c-83e1f31b46fa",
                                                "sense_id": "d85565b4-782f-3cfa-abe0-5a31b298f24c",
                                                "text": "More precisely, a concurrent algorithm (or concurrent program) is the description of a set of sequential state machines that cooperate through a communication medium, e. g., a shared memory."
                                            },
                                            {
                                                "example_id": "1b6c234d-4589-47d2-8394-957c64a1adcb",
                                                "sense_id": "d85565b4-782f-3cfa-abe0-5a31b298f24c",
                                                "text": "Informally, a concurrent program is one that does more than one thing at a time. […] However, this simultaneity is sometimes an illusion."
                                            },
                                            {
                                                "example_id": "09464210-9d1a-4cad-aab4-1290a0f49bdf",
                                                "sense_id": "d85565b4-782f-3cfa-abe0-5a31b298f24c",
                                                "text": "Different concurrent designs enable different ways to parallelize."
                                            },
                                            {
                                                "example_id": "db0faebe-9efc-4a3d-b9e3-2b0c9da792a3",
                                                "sense_id": "d85565b4-782f-3cfa-abe0-5a31b298f24c",
                                                "text": "Many languages are dogmatic about the solutions they offer for handling concurrent problems. For example, Erlang has elegant functionality for message-passing concurrency but has only obscure ways to share state between threads."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "concurrent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e826021d-ed74-348b-ad98-dd91ff16d55f",
                                        "entry_id": "706850f2-ba90-3772-b8cc-9d2f93d8ecf6",
                                        "glosses": [
                                            "One who, or that which, concurs; a joint or contributory cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c615416-9374-4547-b5af-505ce0284cf6",
                                                "sense_id": "e826021d-ed74-348b-ad98-dd91ff16d55f",
                                                "text": "To all affairs of importance there are three necessary concurrents […] time, industry, and faculties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "155ee9e3-04d6-31a4-8cb4-cb2d3bf633c7",
                                        "entry_id": "706850f2-ba90-3772-b8cc-9d2f93d8ecf6",
                                        "glosses": [
                                            "One pursuing the same course, or seeking the same objects; hence, a rival; an opponent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8c85dba-b289-46e6-a1f8-b34a42a9b584",
                                                "sense_id": "155ee9e3-04d6-31a4-8cb4-cb2d3bf633c7",
                                                "text": "Menander […] had no concurrent in his time that came neere vnto him"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "887a65a5-552b-3146-b2d6-aab1c3ed7d78",
                                        "entry_id": "706850f2-ba90-3772-b8cc-9d2f93d8ecf6",
                                        "glosses": [
                                            "One of the supernumerary days of the year over fifty-two complete weeks; so called because they concur with the solar cycle, the course of which they follow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e63f2fb-0027-3019-a18f-0e57729d31ad",
                                        "entry_id": "706850f2-ba90-3772-b8cc-9d2f93d8ecf6",
                                        "glosses": [
                                            "One who accompanies a sheriff's officer as witness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
