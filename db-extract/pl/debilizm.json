                    }
                ],
                "translations": [
                    {
                        "translation_id": "c510b658-4759-4500-8783-836edf34ac03",
                        "source_entry_id": "eb74b46d-9280-33f8-92ff-240385363742",
                        "source_sense_id": "6474f972-0ade-3113-8953-d7869fa7b21c",
                        "target_lang_word": "debility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a2ce44e-3009-388e-9ec8-ef2069bfc4d1",
                                        "entry_id": "97007f8e-0c2d-39f1-bbf5-3b819d34af29",
                                        "glosses": [
                                            "A state of physical or mental weakness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7679dae9-ced0-4fcd-8e0a-7b1dcc45fe7d",
                                                "sense_id": "1a2ce44e-3009-388e-9ec8-ef2069bfc4d1",
                                                "text": "As I was in a state of extreme debility, I resolved to sail directly towards the town, as a place where I could most easily procure nourishment.\n[…]\nI was ready to sink from fatigue and hunger, but being surrounded by a crowd, I thought it politic to rouse all my strength, that no physical debility might be construed into apprehension or conscious guilt."
                                            },
                                            {
                                                "example_id": "37f851db-8bd9-483d-897a-cc8d1abf04cd",
                                                "sense_id": "1a2ce44e-3009-388e-9ec8-ef2069bfc4d1",
                                                "text": "I was struck besides with the shocking expression of his face, with his remarkable combination of great muscular activity and great apparent debility of constitution"
                                            },
                                            {
                                                "example_id": "ba17387b-12e9-451a-96ee-b4361c92957d",
                                                "sense_id": "1a2ce44e-3009-388e-9ec8-ef2069bfc4d1",
                                                "text": "At the mention of money Mrs Dibble was overcome with great debility, and wheezed, \"I don't feel up to talking about money, matters just now, dearie. I think I better have a bit of a doze.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7a0a776-db13-4c8b-9965-c433007e3bec",
                        "source_entry_id": "eb74b46d-9280-33f8-92ff-240385363742",
