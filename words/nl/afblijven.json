{
    "word_family": [
        "blijven",
        "wegblijven",
        "uitblijven",
        "achterblijven"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86efcb66-cd26-34c9-8590-4892f87c611c",
                    "sense_definition": "Niet aanraken of ergens van afblijven, vaak gebruikt als waarschuwing of regel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "niet-aanraken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet van die taart <w>afblijven</w> tot de gasten er zijn.",
                            "target_lang_translations": {
                                "en": "You must <w>leave</w> that cake <w>alone</w> until the guests arrive."
                            }
                        },
                        {
                            "text": "Hij kon niet van zijn telefoon <w>afblijven</w> tijdens de les.",
                            "target_lang_translations": {
                                "en": "He couldn't <w>keep off</w> his phone during the lesson."
                            }
                        }
                    ],
                    "synonyms": [
                        "afblijven van",
                        "met rust laten"
                    ],
                    "antonyms": [
                        "aanraken",
                        "aanzitten"
                    ],
                    "common_phrases": [
                        "van mijn spullen afblijven",
                        "overal van afblijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To not touch or to stay away from something, often used as a warning or rule."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keep off",
                                "target_lang_sense_clarification": "to stay away from or not touch something"
                            },
                            {
                                "target_lang_word": "leave alone",
                                "target_lang_sense_clarification": "to not touch or interfere with something"
                            },
                            {
                                "target_lang_word": "stay away from",
                                "target_lang_sense_clarification": "to avoid touching or going near"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "10cf8fe7-6821-302c-9775-936b8e387df3",
                    "sense_definition": "Uitroep om iemand te bevelen onmiddellijk te stoppen met het aanraken van iets of iemand.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "niet-aanraken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Afblijven</w>! Dat is niet van jou!",
                            "target_lang_translations": {
                                "en": "<w>Hands off</w>! That is not yours!"
                            }
                        },
                        {
                            "text": "Ik zei nog zo: <w>afblijven</w> van die hete pan!",
                            "target_lang_translations": {
                                "en": "I specifically said: <w>don't touch</w> that hot pan!"
                            }
                        }
                    ],
                    "synonyms": [
                        "handen thuis"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used as a direct command or exclamation."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Exclamation used to command someone to immediately stop touching something or someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hands off",
                                "target_lang_sense_clarification": "command to not touch something"
                            },
                            {
                                "target_lang_word": "don't touch",
                                "target_lang_sense_clarification": "direct order to not touch"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}