                                                "sense_id": "638f82ee-b36c-35a2-9e97-783ac721f8c0",
                                                "text": "Oorlogswinter speelt zich af in het gebied van zijn jeugd, de noordkant van de Veluwe. Terlouw groeide daar als zoon van een predikant op in een zwaar calvinistisch milieu. Hij schetste de bezetting als een tijd van lijden en onrecht, waarin goed en fout niet altijd helder te onderscheiden waren, maar waarin wel morele keuzes moesten worden gemaakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebd2d3a8-e86f-437c-94ac-ccc65242ab1b",
                        "source_entry_id": "ab6434c3-c61f-3eb5-902f-15c433bcbaaa",
                        "source_sense_id": "d6b77dd1-985f-38b5-ad13-e43afbe5aac9",
                        "target_lang_word": "kalwiński",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kalwiński",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "b120fa54-1d43-3c99-9867-e4a262eb6f88",
                                        "entry_id": "ef133fc1-ba18-3447-9abb-9a54a60a0f01",
                                        "glosses": [
                                            "związany z kalwinizmem lub kalwinami"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29869e6b-6f67-4f4a-ae58-d9ffa01afe7f",
                                                "sense_id": "b120fa54-1d43-3c99-9867-e4a262eb6f88",
                                                "text": "Od 1551 głównym propagatorem i organizatorem kościoła kalwińskiego w Niderlandach był Guy de Brès, który w 1562 r. opracował wyznanie wiary na wzór roszelskiego"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7e28afb-15a1-4899-b04d-126bf28b6057",
                        "source_entry_id": "ab6434c3-c61f-3eb5-902f-15c433bcbaaa",
                        "source_sense_id": "d6b77dd1-985f-38b5-ad13-e43afbe5aac9",
                        "target_lang_word": "kalwinistyczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kalwinistyczny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a7db63-1a8a-3566-a2cf-74d92a44700c",
                                        "entry_id": "50f2ea26-2a17-3e23-81df-0aa44241ff3d",
                                        "glosses": [
                                            "związany z kalwinizmem lub kalwinami"
                                        ],
