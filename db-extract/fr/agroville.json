                        "entry_id": "e8824274-c289-3bc9-a9a1-1d2d6d2ca66d",
                        "glosses": [
                            "Ville composée majoritairement d’agriculteurs."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
