                },
                {
                    "sense_id": "230f3cf4-330c-3bb4-9289-c6c0865bbbfd",
                    "sense_definition": "de hoeveelheid goederen die in een voertuig past",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze bestelden een hele <w>wagen</w> zand voor de nieuwe oprit.",
                            "target_lang_translations": {
                                "en": "They ordered a whole <w>truckload</w> of sand for the new driveway.",
                                "ru": "Они заказали целую <w>машину</w> песка для новой подъездной дорожки."
                            }
                        },
                        {
                            "text": "Er is een volledige <w>wagen</w> aan bakstenen geleverd op de bouwplaats.",
                            "target_lang_translations": {
                                "en": "A full <w>wagonload</w> of bricks has been delivered to the construction site.",
                                "ru": "На стройплощадку доставили целый <w>вагон</w> кирпичей."
                            }
                        }
                    ],
                    "synonyms": [
                        "wagenlading"
                    ],
                    "common_phrases": [
                        "een volle wagen"
                    ],
                    "target_lang_definitions": {
                        "en": "the amount of goods that fits into a vehicle",
                        "ru": "количество груза, которое помещается в транспортное средство"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wagonload",
                                "target_lang_sense_clarification": "the full capacity of a wagon or truck"
