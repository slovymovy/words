                    {
                        "form_id": "f974b8c6-d045-4536-819e-2e815beb40c2",
                        "entry_id": "0b73fcee-d9d8-32d9-aede-2d93b82bbc73",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Träumereien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dbb0bb88-bf6d-39de-8f48-004b6a08dd93",
                        "entry_id": "0b73fcee-d9d8-32d9-aede-2d93b82bbc73",
                        "glosses": [
                            "das Träumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a03be335-137d-4d7a-ae25-ddab10d44a01",
                                "sense_id": "dbb0bb88-bf6d-39de-8f48-004b6a08dd93",
                                "text": "Jetzt lass mal die Träumerei, an die Arbeit!"
                            },
                            {
                                "example_id": "3f367065-d210-45da-a28b-56a465cb7ad2",
                                "sense_id": "dbb0bb88-bf6d-39de-8f48-004b6a08dd93",
                                "text": "„In ihren Eheträumen hatte Prinzessin Marja sich auch ein glückliches Familienleben und Kinder ausgemalt, aber der hauptsächlichste, der am deutlichsten gezeichnete und zugleich geheimste Gegenstand ihrer Träumerei war doch die irdische Liebe gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cdc3f77b-7ab3-3aad-b5ff-48d43fc7c168",
                        "entry_id": "0b73fcee-d9d8-32d9-aede-2d93b82bbc73",
                        "glosses": [
                            "das, was jemand sich erträumt, ein Traumbild statt der Wirklichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "578c97ce-b3ec-4fea-b1a6-7f0445364044",
                                "sense_id": "cdc3f77b-7ab3-3aad-b5ff-48d43fc7c168",
                                "text": "Das sind doch nur Träumereien, die deiner Jungmädchenphantasie entspringen."
                            },
                            {
                                "example_id": "66963980-da3e-40b2-b5e4-198ca5b57956",
                                "sense_id": "cdc3f77b-7ab3-3aad-b5ff-48d43fc7c168",
                                "text": "„Ich hatte nur den einen Wunsch, daß sie gingen und mich meinen Träumereien überließen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d71c29a-495e-4186-938b-7eff8a6b9897",
                        "source_entry_id": "0b73fcee-d9d8-32d9-aede-2d93b82bbc73",
                        "source_sense_id": "dbb0bb88-bf6d-39de-8f48-004b6a08dd93",
                        "source_sense_description": "das Träumen",
                        "target_lang_word": "rêverie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rêverie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01e528be-e4a8-303e-9ebb-c2688e2d26d3",
                                        "entry_id": "bcd44cd2-3c05-3ee0-833d-20f1b741c5e8",
                                        "glosses": [
                                            "État de l’esprit occupé d’idées vagues qui l’intéressent, de pensées riantes ou tristes auxquelles il se laisse aller, où il se complaît."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16fcad53-c08b-4e64-8af5-2ed4d24692dd",
                                                "sense_id": "01e528be-e4a8-303e-9ebb-c2688e2d26d3",
                                                "text": "Le mérite d'une rêverie est tout entier dans son vague, n'est-elle pas une sorte de vapeur intellectuelle ?"
                                            },
                                            {
                                                "example_id": "cb1522f1-dc5f-4115-b3e0-b1e59dcfc077",
                                                "sense_id": "01e528be-e4a8-303e-9ebb-c2688e2d26d3",
                                                "text": "Parfois, au milieu de nous, il tombe tout à coup dans une sombre rêverie, frissonne, tremble, tourne la tête, va et vient dans le salon."
                                            },
                                            {
                                                "example_id": "5cd83f47-211a-440b-96ba-ce0ce0b79382",
                                                "sense_id": "01e528be-e4a8-303e-9ebb-c2688e2d26d3",
                                                "text": "Elle passait toutes ses journées, dans le silence menaçant de la plaine sans soucis, sans pensées, poursuivant des rêveries vagues, indéfinissables, intraduisibles en aucune langue humaine."
                                            },
                                            {
                                                "example_id": "ab4e2416-2d17-4142-a4a1-a4e75584b948",
                                                "sense_id": "01e528be-e4a8-303e-9ebb-c2688e2d26d3",
                                                "text": "Il sifflota entre ses dents et se plongea dans une vague rêverie."
                                            },
                                            {
                                                "example_id": "896c6064-1997-4738-ae6a-563f11c686fe",
                                                "sense_id": "01e528be-e4a8-303e-9ebb-c2688e2d26d3",
                                                "text": "Je ne sais quel onirologue a dit « que l’on ne rêvait pas de compagnie. » Ce savant, sans aucun doute, parlait des songes du sommeil. Mais quoi ! c’est en vain que les magisters prétendent marquer une distinction entre rêve et rêverie. Les mêmes mots, pour un Français, désignent indifféremment les délires du dormeur ou ceux de l’homme éveillé."
                                            },
                                            {
                                                "example_id": "8ceb2bc2-d366-4a5b-aa3b-3e9c3cec46a5",
                                                "sense_id": "01e528be-e4a8-303e-9ebb-c2688e2d26d3",
                                                "text": "Et, tournant à son tour les yeux vers la portière, il s'abîma dans une soudaine et muette rêverie. Le balancement de la voiture l'engourdissait."
                                            },
                                            {
                                                "example_id": "b4bc9d71-5e4a-49b2-b31e-f3ed71e56234",
                                                "sense_id": "01e528be-e4a8-303e-9ebb-c2688e2d26d3",
                                                "text": "Je suis trop lucide pour me laisser aller longement à la rêverie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa761367-f0a9-30e4-a8d3-f13cae6cec1f",
                                        "entry_id": "bcd44cd2-3c05-3ee0-833d-20f1b741c5e8",
                                        "glosses": [
                                            "Idée extravagante, chimère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aebffca6-8ac0-47a1-95fb-6c913273cc8e",
                                                "sense_id": "fa761367-f0a9-30e4-a8d3-f13cae6cec1f",
                                                "text": "Il veut débiter ses rêveries pour des vérités. Cet ouvrage est plein de rêveries. Ce que vous dites est une rêverie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
