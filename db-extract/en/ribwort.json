                                    {
                                        "sense_id": "caf95959-28db-3a48-a5f1-37c41d54fec9",
                                        "entry_id": "c15b25a0-3530-3fdb-b452-dba7714d4731",
                                        "glosses": [
                                            "Wegerich mit spitzen, lanzettförmigen Blättern mit fünf Nervenbahnen und bräunlich blühenden, kolbenartigen Ähren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa4c49e2-cf07-46e3-9735-42a9ddef840d",
                                                "sense_id": "caf95959-28db-3a48-a5f1-37c41d54fec9",
                                                "text": "Der Spitzwegerich blüht zwischen April und Oktober."
                                            },
                                            {
                                                "example_id": "9e01869f-35fb-4c5c-8d36-e5b2384347ce",
                                                "sense_id": "caf95959-28db-3a48-a5f1-37c41d54fec9",
                                                "text": "Der Spitzwegerich wächst unauffällig an Wegrändern und auf Wiesen."
                                            },
                                            {
                                                "example_id": "3b6485a5-1704-4120-a5bc-707d33f173e6",
                                                "sense_id": "caf95959-28db-3a48-a5f1-37c41d54fec9",
                                                "text": "Sind sonst Blüten gut sichtbar und leuchten in frischen Farben, der Spitzwegerich hingegen scheint im Verborgenen zu leben."
                                            },
                                            {
                                                "example_id": "b37b1834-60f7-467e-9221-70bc25f0331f",
                                                "sense_id": "caf95959-28db-3a48-a5f1-37c41d54fec9",
                                                "text": "Der Spitzwegerich hat, wie viele andere Heilpflanzen, ein breites Spektrum von Heilwirkungen. Seine Haupteinsatzgebiete sind jedoch die Atemwege und die Haut."
                                            },
                                            {
                                                "example_id": "b9af9473-88e5-46fb-9a1e-ff2fb63146f3",
                                                "sense_id": "caf95959-28db-3a48-a5f1-37c41d54fec9",
                                                "text": "Von der Antike bis zur Neuzeit schätzte man den Spitzwegerich zur Behandlung von Wunden, Insektenstichen, Tierbissen, Zahn- und Ohrenschmerzen sowie Geschwülsten vor allem in der Mundhöhle."
                                            }
                                        ],
