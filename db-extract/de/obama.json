                        "examples": [
                            {
                                "example_id": "cab7b005-8b5f-406b-a77f-6d1963c6869c",
                                "sense_id": "702b599c-18b5-3225-bfb0-192ff2254087",
                                "text": "Frau Obama ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d2588f24-b1e7-4542-9e77-1ed87ab9f87e",
                                "sense_id": "702b599c-18b5-3225-bfb0-192ff2254087",
                                "text": "Herr Obama wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0a45a447-09be-48be-ba1b-356419360434",
                                "sense_id": "702b599c-18b5-3225-bfb0-192ff2254087",
                                "text": "Die Obamas fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "4e94ba11-e553-486f-a838-cd7710a76386",
                                "sense_id": "702b599c-18b5-3225-bfb0-192ff2254087",
                                "text": "Der Obama trägt nie die Pullover, die die Obama ihm strickt."
                            },
                            {
                                "example_id": "b928bb85-f410-4efa-9ff1-bc2f96c3ce40",
                                "sense_id": "702b599c-18b5-3225-bfb0-192ff2254087",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Obama kommt, geht der Herr Obama.“"
                            },
                            {
                                "example_id": "592e710b-25aa-48fa-a319-5fb1603c12fd",
                                "sense_id": "702b599c-18b5-3225-bfb0-192ff2254087",
                                "text": "Obama kommt und geht."
                            },
                            {
                                "example_id": "00a13d97-5d92-4180-a8bf-9747528a60dc",
                                "sense_id": "702b599c-18b5-3225-bfb0-192ff2254087",
                                "text": "Obamas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
