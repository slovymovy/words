                    },
                    {
                        "translation_id": "70233f30-2cdc-4ea3-9ff6-de4b3786fd8a",
                        "source_entry_id": "34c9ec6b-4f5a-33ce-b240-8ae35bed7417",
                        "target_lang_word": "Fujianese",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fujianese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce398772-a2f4-3dec-8030-7e2071539cd1",
                                        "entry_id": "732c7a20-c12d-30f2-85ff-6138ab7811de",
                                        "glosses": [
                                            "Of or relating to the province of Fujian in China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e668b13-9820-47d4-8114-cea47b9adc77",
                                                "sense_id": "ce398772-a2f4-3dec-8030-7e2071539cd1",
                                                "text": "Because Fukienese has many spoken dialects, the province has a diversity of operatic styles. Fukienese Opera usually refers to the style prevalent in Fuchou and in the northern and eastern parts of the province.",
                                                "translation": "自由中國週報",
                                                "english": "自由中國週報"
                                            },
                                            {
                                                "example_id": "1cd15062-c2f7-4140-aad2-d23519590e79",
                                                "sense_id": "ce398772-a2f4-3dec-8030-7e2071539cd1",
                                                "text": "Taiwanese is a dialect from the Fu Jian province in China. The majority of Taiwanese people are descendants of Fujianese settlers who immigrated from China to Taiwan in the seventeenth and the eighteenth centuries."
                                            },
                                            {
                                                "example_id": "9a346585-776b-4460-9a8b-c1dc555835d7",
                                                "sense_id": "ce398772-a2f4-3dec-8030-7e2071539cd1",
                                                "text": "The crisp, mildly sweet water chestnut – \"bee-chee\" in Mandarin – is the biggest export from the Kuantien district in central Tainan County. The 130-year-old, white and red brick, southern Fujianese-style house is Kuantien’s biggest tourist magnet because it was the boyhood home of Chen Shui-bian."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Fujianese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04fd4a04-cc87-366d-9395-a133d6545142",
                                        "entry_id": "bb94b74d-1397-3bd0-a521-7736aa6c7059",
                                        "glosses": [
                                            "A person from Fujian."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e217c5f-6e18-4497-aa8c-9799bbc6ab30",
                                                "sense_id": "04fd4a04-cc87-366d-9395-a133d6545142",
                                                "text": "Tcheng, a Fujianese, was the first to enthusiastically introduce the poetic competition to a Western audience; he associated it with Western sports to help explain it as a form of entertainment and sociability."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "c97b05a7-74eb-37b7-be6e-88b9b71ca270",
                "word": "hokkien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ebdf6c7-d604-3d72-9fbf-e4d7bfdc8390",
                        "entry_id": "c97b05a7-74eb-37b7-be6e-88b9b71ca270",
                        "glosses": [
                            "Langue chinoise de la famille des langues min."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8562ce40-b9d6-486d-b534-2dfc32458b8c",
                                "sense_id": "5ebdf6c7-d604-3d72-9fbf-e4d7bfdc8390",
                                "text": "J’ai ouvert la bouche et je suis restée bloquée. Mon hokkien était épouvantable. C’était la langue que parlait Grand-Ma à l’origine, mais une partie s’était perdue dans l’océan entre la Chine et Singapour, et bien plus encore entre ce que Grand-Ma a transmis à ma mère et ce que ma mère m’a transmis."
                            },
                            {
                                "example_id": "dc7a91da-7369-4f3c-ada3-c08d909fec1a",
                                "sense_id": "5ebdf6c7-d604-3d72-9fbf-e4d7bfdc8390",
                                "text": "Si on a raté, en 2014, à la MC93, de Bobigny, les délices de ce « jardin aux poiriers » – « Liyuan » en hokkien, la langue parlée dans cette région qui fait face à Taïwan – on peut s’offrir une session de rattrapage au Théâtre du Soleil."
                            },
                            {
                                "example_id": "419e2c42-75ed-4abf-8aa8-5cc0d4cfb1b9",
                                "sense_id": "5ebdf6c7-d604-3d72-9fbf-e4d7bfdc8390",
                                "text": "Le groupe min se subdivise en min dong (en usage à Fuzhou), hokkien et teochiu."
                            },
                            {
                                "example_id": "67e73ad4-38a7-476e-b9b4-89d596f6117f",
                                "sense_id": "5ebdf6c7-d604-3d72-9fbf-e4d7bfdc8390",
                                "text": "Le hokkien taïwanais est l'une des langues nationales de Taïwan."
                            }
                        ]
                    }
                ],
