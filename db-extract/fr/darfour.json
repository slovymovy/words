                                    {
                                        "sense_id": "91584c54-356d-310a-9def-7892760bf74a",
                                        "entry_id": "222f8ba1-091a-3502-8cd7-df9e1b6140b0",
                                        "glosses": [
                                            "A region in western Sudan where the Fur live."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a2c5531-f568-4dd6-a34a-d3d9c59c4c8d",
                                                "sense_id": "91584c54-356d-310a-9def-7892760bf74a",
                                                "text": "Then, a targeted effort to resolve the Darfur conflict would be crucial, especially given that, of late, there are small signs of hope there."
                                            }
                                        ]
                                    },
