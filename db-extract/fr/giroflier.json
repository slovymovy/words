        "fr-extract.jsonl": [
            {
                "entry_id": "40fae62b-bd4a-3fea-aeb2-05f22e5e8ffc",
                "word": "giroflier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3e516989-262f-4fe2-aada-e914084de697",
                        "entry_id": "40fae62b-bd4a-3fea-aeb2-05f22e5e8ffc",
                        "tags": [
                            "plural"
                        ],
                        "form": "girofliers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4696631-7f43-3a6a-b2d2-6c74545dbe32",
                        "entry_id": "40fae62b-bd4a-3fea-aeb2-05f22e5e8ffc",
                        "glosses": [
                            "Arbre de la famille des Myrtacées, qui porte le clou de girofle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9f390e3-20b6-4aef-8c6b-77c637fc38d9",
                                "sense_id": "e4696631-7f43-3a6a-b2d2-6c74545dbe32",
                                "text": "La locomotive, dirigée par le bras d’un mécanicien anglais et chauffée de houille anglaise, lança sa fumée sur les plantations de cotonniers, de caféiers, de muscadiers, de girofliers, de poivriers rouges."
                            },
                            {
                                "example_id": "848c8c54-e46b-4297-922d-1ee72a950d12",
                                "sense_id": "e4696631-7f43-3a6a-b2d2-6c74545dbe32",
                                "text": "Le giroflier est un arbre de grandeur moyenne dont la tige, de 8 à 10 mètres, se divise en rameaux, l’ensemble forme une cime pyramidale."
                            },
                            {
                                "example_id": "a3a9e252-8a01-4861-a198-64dca238e21c",
                                "sense_id": "e4696631-7f43-3a6a-b2d2-6c74545dbe32",
                                "text": "Originaire de l’archipel des Moluques et de la partie sud des Philippines, cultivé traditionnellement en Tanzanie et à Madagascar, et surtout en Indonésie, le giroflier est un arbre élancé et touffu à feuilles persistantes, coriaces, opposées, entières et atténuées à la base."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84198204-1e78-4aa5-b9f2-6f9cabbec4ce",
                        "source_entry_id": "40fae62b-bd4a-3fea-aeb2-05f22e5e8ffc",
                        "source_sense_id": "e4696631-7f43-3a6a-b2d2-6c74545dbe32",
