                    "semantic_group_id": "proces_rozkladu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regularne malowanie płotu ma na celu zahamowanie jego <w>butwienia</w>.",
                            "target_lang_translations": {
                                "ru": "Регулярная покраска забора направлена на то, чтобы предотвратить его <w>гниение</w>."
                            }
                        },
                        {
                            "text": "Warunki panujące w starym magazynie sprzyjały ciągłemu <w>butwieniu</w> składowanych tam materiałów.",
                            "target_lang_translations": {
                                "ru": "Условия в старом складе способствовали постоянному <w>истлеванию</w> хранившихся там материалов."
                            }
