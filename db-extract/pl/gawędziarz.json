                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plauderer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eed820fb-b435-3f88-aff2-19c9753650d6",
                                        "entry_id": "e1701a2c-6c04-3e66-8988-96549578301a",
                                        "glosses": [
                                            "jemand, der sich ungezwungen, angenehm unterhalten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "113eb0ff-a4c4-4b1b-93ba-9ac3950e89dd",
                                                "sense_id": "eed820fb-b435-3f88-aff2-19c9753650d6",
                                                "text": "Tom ist ein netter Plauderer, der kann zu jedem Thema etwas dazu beitragen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4504537d-9a4b-3e08-b4e0-6193e19ab8e1",
                                        "entry_id": "e1701a2c-6c04-3e66-8988-96549578301a",
                                        "glosses": [
                                            "jemand, der häufig etwas ausplaudert, Geheimnisse verrät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "150404ee-0afe-4813-b3a3-a3266746fb5d",
                                                "sense_id": "4504537d-9a4b-3e08-b4e0-6193e19ab8e1",
                                                "text": "Ich frage mich, welcher Plauderer da wieder seinen Mund nicht halten konnte."
                                            },
                                            {
                                                "example_id": "5b3b4ff9-661d-4c8c-972e-2e73794db054",
                                                "sense_id": "4504537d-9a4b-3e08-b4e0-6193e19ab8e1",
                                                "text": "Es sind recht markige Worte, die Manager der Deutschen Telekom von ihren Vorgesetzten zu hören bekommen: „Wir werden die undichten Stellen schon ausfindig machen. Wenn nicht wir, wer sollte es dann schaffen?“ Oder: „Die kriegen wir schon, diese Plauderer. Wäre ja gelacht, wenn wir das nicht schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06e5eda9-1f78-4f75-8381-e9f76f2c40b5",
                        "source_entry_id": "27c8b9ae-a88d-370d-8bcb-43f153a83351",
                        "source_sense_id": "2114984a-c9e6-38fa-8831-001f6eb2c09f",
                        "target_lang_word": "Erzähler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzähler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "Person, die etwas erzählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4db6366-5138-4f6b-a03e-44c13855dd79",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            },
                                            {
                                                "example_id": "a6a80e7c-7b0e-4fbb-9ed0-d5267a658d74",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Kein Wort wird in Benin zu dieser Zeit niedergeschrieben, alles mündlich aufbewahrt, fortgetragen von Erzähler zu Erzähler, umgeformt über Generationen.“"
                                            },
                                            {
                                                "example_id": "8aa0abd4-9453-462f-a272-714be16b0692",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Und dann wandte er sich wieder dem Erzähler zu und lachte abermals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "Verfasser einer Erzählung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3993957c-5483-434c-8ee1-17f99e2d5496",
                                                "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                                "text": "„Der sprachgewandte Erzähler aus langobardischem Dienstadel wurde etwa 160 Jahre nach diesem Ereignis geboren - um 725, wahrscheinlich in Forum Iulii; jedenfalls wuchs er hier auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "abstrakte Instanz in einem epischen Werk, aus deren Sichtweise erzählt wird"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92a8a2b5-15e0-4011-b488-d06c25383b14",
                                                "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                                "text": "„Ich machte mich zum Erzähler und erzählte die Geschichte meiner Großmutter auch aus eigenem Recht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
