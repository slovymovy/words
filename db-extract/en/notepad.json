                                        "glosses": [
                                            "ein Block mit Papierblättern, der zum Aufschreiben von Notizen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4128d2b3-10e4-4556-837f-4295464cc892",
                                                "sense_id": "e983601c-e0b9-372f-be27-485794861732",
                                                "text": "„Die Journalisten holten ihre Schreibblöcke aus den Taschen und schulterten ihre Aufnahmegeräte.“"
                                            },
                                            {
                                                "example_id": "1fa574b3-38f4-46e2-85c6-29fc6f29e3df",
                                                "sense_id": "e983601c-e0b9-372f-be27-485794861732",
                                                "text": "„Punkt neun saßen sie alle um den ovalen Konferenztisch aus polierter Kiefer, jeder mit einem Schreibblock und der Konferenzakte vor sich.“"
                                            },
                                            {
                                                "example_id": "36b42e12-c0c1-48a0-95c5-05c67aa38796",
                                                "sense_id": "e983601c-e0b9-372f-be27-485794861732",
                                                "text": "„Die anderen waren alle schon da und hatten Schreibblöcke sowie Manuskripte vor sich liegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
