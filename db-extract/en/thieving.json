                        "glosses": [
                            "That thieves; that steals; inclined to steal"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "34829755-4d19-4c60-89bb-f9c964f65d40",
                                "sense_id": "4bf8a2ab-c799-3915-9557-2e279f238a7c",
                                "text": "From her point of view, sex itself, or sexual awareness, is the thief that stole away her innocence (which completes the picture of Thomas's totally thieving world)."
                            },
                            {
                                "example_id": "b622dfc5-8454-4e52-a2f7-76e7a4ac780b",
                                "sense_id": "4bf8a2ab-c799-3915-9557-2e279f238a7c",
                                "text": "The landlady was \"a desperately mean old specimen... who employed a very thieving set of servants,\""
                            }
                        ]
                    }
                ],
                "translations": [
