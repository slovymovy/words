                                        "entry_id": "d6616b15-7b6a-3b3b-a433-4f30c384197e",
                                        "glosses": [
                                            "viele Kurven (= Richtungswechsel) aufweisend"
                                        ],
                                        "tags": [
                                            "Verkehrswesen",
