                "senses": [
                    {
                        "sense_id": "18f6c686-9426-3691-9c88-56516b53055a",
                        "entry_id": "6629e214-1193-3978-b1a5-9b3988c1d8d7",
                        "glosses": [
                            "jemand, der sich gut mit Handschriften auskennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "669e877c-ba21-4135-8f87-a08bb0181a9e",
                                "sense_id": "18f6c686-9426-3691-9c88-56516b53055a",
                                "text": "„[…] Weiterhin habe ein Handschriftenexperte Bests Unterschrift auf seiner Heiratsurkunde eindeutig mit der auf den Nachrichten des Killers in Verbindung bringen können.“"
                            },
                            {
                                "example_id": "dbcdb432-e32d-485e-b479-6a53cdb6fa84",
                                "sense_id": "18f6c686-9426-3691-9c88-56516b53055a",
                                "text": "„[…] Ein Handschriftenexperte bestätigte außerdem, dass die Briefe, die Beweise für sein selbst erklärtes Prophetentum, tatsächlich aus der Feder des 65-Jährigen stammen.“"
                            },
                            {
                                "example_id": "6b39638b-5c5c-4e6c-b5b4-f851aa1d4f10",
                                "sense_id": "18f6c686-9426-3691-9c88-56516b53055a",
                                "text": "„[…] Dass die akribische Arbeit der Handschriftenexperten aber entscheidend zur Aufklärung von Verbrechen beitragen kann, zeigt ein außergewöhnlicher Fall aus dem Saarland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
