                    }
                ],
                "senses": [
                    {
                        "sense_id": "9fbabe19-4a2c-33d8-8ed1-30a3798afce7",
                        "entry_id": "1bcc663e-0d46-3daa-a5fb-e032b772e401",
                        "glosses": [
                            "небольшая оконная или дверная задвижка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f89f541-9a75-46d6-92c9-17f93d78c6d2",
                                "sense_id": "9fbabe19-4a2c-33d8-8ed1-30a3798afce7",
                                "text": "С заводов вывозилось всё, что можно снять, в конторах отвинчивали дверные ручки и оконные шпингалеты, снимали унитазы."
                            },
                            {
                                "example_id": "1ffefece-3d3c-43d9-b3e6-a95f480b2dec",
                                "sense_id": "9fbabe19-4a2c-33d8-8ed1-30a3798afce7",
                                "text": "Пусть проследят, чтобы в боксе окно на шпингалет закрыли."
                            }
                        ]
                    },
                    {
                        "sense_id": "205524c8-2ab1-3713-9934-9a7a86faf9e8",
                        "entry_id": "1bcc663e-0d46-3daa-a5fb-e032b772e401",
                        "glosses": [
                            "перен., разг. то же, что шкет; мальчишка; также человек невысокого роста"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "777662ef-9203-4b06-bb79-b3e868c61c32",
                                "sense_id": "205524c8-2ab1-3713-9934-9a7a86faf9e8",
                                "text": "Правильно, за такое время эти шпингалеты могли десять раз спрятаться где угодно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17d4f18d-bcc8-4d08-b371-a2ff07357cde",
                        "source_entry_id": "1bcc663e-0d46-3daa-a5fb-e032b772e401",
                        "source_sense_description": "задвижка",
                        "target_lang_word": "falleba",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falleba",
