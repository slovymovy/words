                    {
                        "translation_id": "e9d4f400-f1a8-4167-a3b5-80f960a3e8c4",
                        "source_entry_id": "6291cd93-ae21-31b9-a264-db0e37adffd9",
                        "source_sense_id": "1a020501-fe3a-3d02-90cd-4e402ad08c8a",
                        "target_lang_word": "salutaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salutaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28f33a90-4211-32aa-91a5-142a0f87320d",
                                        "entry_id": "fde6174c-e262-3135-9001-70e0163fadb2",
                                        "glosses": [
                                            "Qui est utile, avantageux pour la conservation de la vie, de la santé, des biens, de l’honneur, pour le salut de l’âme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "000dd01e-0378-4021-85d2-b410b9d3d658",
                                                "sense_id": "28f33a90-4211-32aa-91a5-142a0f87320d",
                                                "text": "Lorsque cette discussion médicale fut terminée, le paysan saxon demanda humblement qu’on lui restituât le remède qui lui avait été si salutaire."
                                            },
                                            {
                                                "example_id": "603e539b-a146-4356-a2d3-fc93f46b7969",
                                                "sense_id": "28f33a90-4211-32aa-91a5-142a0f87320d",
                                                "text": "…toutefois comme il ne voulait pas abandonner dans les eaux de la tribulation le jeune paroissien de son confrère, il lui donna quelques salutaires encouragements."
                                            },
                                            {
                                                "example_id": "17e54065-16de-4d0a-9add-513db2f6a06e",
                                                "sense_id": "28f33a90-4211-32aa-91a5-142a0f87320d",
                                                "text": "Jadis le sorcier, le magicien, le jeteur de sort faisaient grand usage du crapaud. On recourait à ses pouvoirs maléfiques ou salutaires."
                                            },
                                            {
                                                "example_id": "95ac786e-dcf5-42ee-abc9-5445729da229",
                                                "sense_id": "28f33a90-4211-32aa-91a5-142a0f87320d",
                                                "text": "…il y a eu, sur ces rives du Tarn, une petite patrie autonome, très florissante, très fière, à laquelle, convenons-en, l'autorité centralisatrice venue du Nord n'a point été salutaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
