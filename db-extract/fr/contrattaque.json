                "senses": [
                    {
                        "sense_id": "07ccd105-caba-3b36-8cf1-01c857be69f5",
                        "entry_id": "464e850e-6fa0-3158-928b-b2d30f65a9b6",
                        "glosses": [
                            "Controffensive opérée sur un champ de bataille par des troupes attaquées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f090a786-5655-4a30-8149-71bb817cbe4f",
                                "sense_id": "07ccd105-caba-3b36-8cf1-01c857be69f5",
                                "text": "De violentes contrattaques ont enrayé la progression des troupes onusiennes."
                            }
                        ]
                    },
                    {
                        "sense_id": "b60c612d-bb11-3447-929a-bcc9d817aa17",
                        "entry_id": "464e850e-6fa0-3158-928b-b2d30f65a9b6",
                        "glosses": [
                            "Réplique, riposte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97cbbdb8-352f-44a2-abca-8982a5995f85",
                                "sense_id": "b60c612d-bb11-3447-929a-bcc9d817aa17",
                                "text": "Notre équipe dominait largement quand, sur une contrattaque adverse, elle encaissa un essai, c’est ça le rugby !"
                            },
                            {
                                "example_id": "1cd76f7d-7d63-4a28-96e4-78e62621deb3",
                                "sense_id": "b60c612d-bb11-3447-929a-bcc9d817aa17",
                                "text": "Mathilde prépare une contrattaque, une pétition va circuler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "597d17a0-4e93-418d-9130-1b6af4e94648",
                        "source_entry_id": "464e850e-6fa0-3158-928b-b2d30f65a9b6",
                        "target_lang_word": "Gegenangriff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenangriff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "482014b4-46de-3d5a-b2a8-5e85b7c24fe6",
                                        "entry_id": "8fbda84d-c127-34fa-9947-424a168f912f",
                                        "glosses": [
                                            "ein Angriff, der direkt auf einen vom Gegner ausgeführten Angriff folgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca188853-5c3d-459a-ab07-ba67bf55a5e4",
                                                "sense_id": "482014b4-46de-3d5a-b2a8-5e85b7c24fe6",
                                                "text": "Nach dem lang erwarteten Tor, folgte direkt im Gegenangriff das Ausgleichstor."
                                            },
                                            {
                                                "example_id": "925bf5d7-4748-4509-a547-5d80599c7ab1",
                                                "sense_id": "482014b4-46de-3d5a-b2a8-5e85b7c24fe6",
                                                "text": "„Am 16. Dezember trat die Wehrmacht in den Ardennen zum Gegenangriff an.“"
                                            },
                                            {
                                                "example_id": "6bf902c0-8c75-4ab8-90f5-34af1a7d2aa6",
                                                "sense_id": "482014b4-46de-3d5a-b2a8-5e85b7c24fe6",
                                                "text": "„Als die Russen einen Gegenangriff unternahmen, rannten sie zurück zur Kolotscha, verfolgt von russischen Reitern.“"
                                            },
                                            {
                                                "example_id": "d1954f82-1722-43cd-85ed-4f7549c48302",
                                                "sense_id": "482014b4-46de-3d5a-b2a8-5e85b7c24fe6",
                                                "text": "„Ich versuchte einen Gegenangriff auf Munau, in der Hoffnung, die Gefangenen und das Kriegsmaterial zurückzuerobern, doch wurden wir dadurch nur noch mehr geschwächt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
