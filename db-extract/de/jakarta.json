                    }
                ],
                "senses": [
                    {
                        "sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
                        "entry_id": "bd01b7f8-15aa-3f35-92ce-d96701676f27",
                        "glosses": [
                            "ehemalige Hauptstadt der Republik Indonesien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a9915a2-a970-4d8f-aeed-7efdce5108f1",
                                "sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
                                "text": "„Offiziell hat Jakarta nicht den Status einer Stadt, sondern einer Provinz mit dem besonderen Status der Hauptstadt von Indonesien.“"
                            },
                            {
                                "example_id": "ee194e04-52ab-48bb-b7d3-5cc56ca6ce25",
                                "sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
                                "text": "„Der geologische Aufbau der Insel Java, auf der Jakarta liegt, ist hauptsächlich durch das vulkanische Material bestimmt“."
                            },
                            {
                                "example_id": "b02905b9-f5c4-4f1a-b291-b08cc26b16f8",
                                "sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
                                "text": "„Aus Batavia, erbaut nach dem Vorbild Amsterdams und von Kanälen durchzogen, wurde die heutige indonesische Hauptstadt Jakarta.“"
                            },
                            {
                                "example_id": "4c58ad10-6df8-4a4b-8b69-0edad68abcb8",
                                "sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
                                "text": "„In Jakarta verfolgte ich emotionale Debatten über die Opfer der Massaker von 1965.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc055d90-8787-478f-aea5-093f4e653d18",
                        "source_entry_id": "bd01b7f8-15aa-3f35-92ce-d96701676f27",
                        "source_sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
                        "source_sense_description": "Hauptstadt der Republik Indonesien",
                        "target_lang_word": "Jakarta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jakarta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b458bdea-47c8-3970-8ea2-07836c6b2df0",
                                        "entry_id": "5112c521-e1d2-3f18-bdf6-28ac05490a02",
                                        "glosses": [
                                            "A province and capital city of Indonesia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bed8cdd-cbe8-488d-9fa7-896a696dc417",
                                                "sense_id": "b458bdea-47c8-3970-8ea2-07836c6b2df0",
                                                "text": "And in fact, forgetting the past was easy to do in Indonesia. Jakarta was still a sleepy backwater in those days, with few buildings over four or five stories high, cycle rickshaws outnumbering cars, the city center and wealthier sections of town—with their colonial elegance and lush, well-tended lawns—quickly giving way to clots of small villages with unpaved roads and open sewers, dusty markets, and shanties of mud and brick and plywood and corrugated iron that tumbled down gentle banks to murky rivers where families bathed and washed laundry like pilgrims in the Ganges."
                                            },
                                            {
                                                "example_id": "ce7c3b6f-1293-4b03-bca0-2d3dc52f2c66",
                                                "sense_id": "b458bdea-47c8-3970-8ea2-07836c6b2df0",
                                                "text": "Authorities in the capital of Jakarta adopted a similar idea earlier this month. A man there was required to sit in a coffin in public after being caught not wearing a mask."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60c07d7d-55e6-3200-9978-e2354836862a",
                                        "entry_id": "5112c521-e1d2-3f18-bdf6-28ac05490a02",
                                        "glosses": [
                                            "The Indonesian government."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1069aaf6-592d-46a6-a5bb-ee106a31739e",
                                                "sense_id": "60c07d7d-55e6-3200-9978-e2354836862a",
                                                "text": "In an effort to make sure the referendum would not take place or that the Timorese would at least approve the outcome desired by Jakarta, the Indonesians launched yet another campaign of terror and killings, the violence dramatically increasing in the months before the UN agreement and culminating in the weeks after the vote on August 30."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3f1e6d8-70a0-457c-9315-9ca9da903fb3",
                        "source_entry_id": "bd01b7f8-15aa-3f35-92ce-d96701676f27",
                        "source_sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
                        "source_sense_description": "Hauptstadt der Republik Indonesien",
                        "target_lang_word": "Jakarta",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jakarta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b03e07b4-9863-333a-89ed-b429e2ff2646",
                                        "entry_id": "ed2fabc6-cca5-3caa-8e54-d7eb99abb676",
                                        "glosses": [
                                            "Capitale de l’Indonésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e4c792f-a71e-47a3-9d89-5d43485fd8fd",
                                                "sense_id": "b03e07b4-9863-333a-89ed-b429e2ff2646",
                                                "text": "Son truc : les bébêtes effrayantes, qu’il a notamment croisées à Bekasi, Jakarta, Batam ou encore sur l’île de Java occidentale."
                                            },
                                            {
                                                "example_id": "a8599862-27ba-48a9-8c85-da0b1c3a9f95",
                                                "sense_id": "b03e07b4-9863-333a-89ed-b429e2ff2646",
                                                "text": "Après des années à se former dans différents établissements, elle s’envole pour Jakarta, où elle devient la première femme cheffe d’Indonésie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d4d0cea-acb4-4924-9926-ddfb54eeb177",
                        "source_entry_id": "bd01b7f8-15aa-3f35-92ce-d96701676f27",
                        "source_sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
