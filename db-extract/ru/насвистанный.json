        "ru-extract.jsonl": [
            {
                "entry_id": "3895d3a5-4883-361f-b225-922ad6de27af",
                "word": "насвистанный",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3efe74dc-0132-3aa7-8ee1-115a458cc6d3",
                        "entry_id": "3895d3a5-4883-361f-b225-922ad6de27af",
                        "glosses": [
                            "страд. прич. прош. вр. от насвистать; кем-то зачитанный; вдохновлённый"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "aa1e715d-a5ec-4247-a534-6f638fca2af6",
                                "sense_id": "3efe74dc-0132-3aa7-8ee1-115a458cc6d3",
                                "text": "Предательство Фадеевым Платонова, фадеевская разгромная статья, написанная буквально по мотивам, насвистанным Сталиным."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca199767-e226-3fcc-96af-17eb128c6664",
                        "entry_id": "3895d3a5-4883-361f-b225-922ad6de27af",
                        "glosses": [
                            "умеющий повторять чужие звуки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a02d1ce-0bf2-46c2-b49f-0ffd645ad1e8",
                                "sense_id": "ca199767-e226-3fcc-96af-17eb128c6664",
                                "text": "Снегирь был малый шустрый и с отроческих лет насвистанный."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fc51b7e-5b25-3b93-aaa2-24da50b6c5ad",
                        "entry_id": "3895d3a5-4883-361f-b225-922ad6de27af",
                        "glosses": [
                            "перен. заучивший отдельные теории, твёрдо повторяющий чужие слова (обычно подразумевается человек, не имеющий собственного мнения)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fe7e6b0-cc41-4c21-adf2-873b6c4ad073",
                                "sense_id": "1fc51b7e-5b25-3b93-aaa2-24da50b6c5ad",
                                "text": "Могу засвидетельствовать, что оба моих следователя, Бузников и Лазарь Коган, были достаточно насвистаны в области своей специальности и довольно грамотно разбирались — с большевистской точки зрения — в разных течениях эсерства."
                            }
                        ]
                    }
                ],
