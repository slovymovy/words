                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6f531416-fa1c-4aa5-bf85-0791e5f83579",
                                "sense_id": "cfac98d2-fc57-3b9c-bffa-cbf85187058e",
                                "text": "Surely there was here, in his pious, ever-labouring, subtle mind, a precious truth, or prefigurement of truth ; and yet a fatal delusion withal."
                            }
                        ]
                    }
                ],
                "translations": [
