    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a155a378-ba59-31a5-a4ae-21b03919b71a",
                    "sense_definition": "Suspendre ou fixer quelque chose à un mur, à un crochet ou à un portemanteau.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fixer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux <w>accrocher</w> ton manteau à l'entrée s'il te plaît ?"
                        },
                        {
                            "text": "Nous avons <w>accroché</w> un joli tableau au mur du salon."
                        }
                    ],
                    "synonyms": [
                        "suspendre",
                        "pendre"
                    ],
                    "antonyms": [
                        "décrocher"
                    ],
                    "common_phrases": [
                        "accrocher un tableau",
                        "accrocher son manteau",
                        "accrocher au mur"
                    ]
                },
                {
                    "sense_id": "68bea2b7-2b72-3fe4-ad66-a8ffa5ab2acc",
                    "sense_definition": "Se tenir fermement à un appui pour ne pas tomber, ou faire preuve de persévérance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les études sont difficiles mais il faut s'<w>accrocher</w> pour réussir."
                        },
                        {
                            "text": "L'enfant s'<w>accroche</w> à la main de sa mère pour traverser."
                        }
                    ],
                    "synonyms": [
                        "s'agripper",
                        "persévérer"
                    ],
                    "antonyms": [
                        "abandonner"
                    ],
                    "common_phrases": [
                        "s'accrocher aux branches",
                        "s'accrocher à la rampe"
                    ]
                },
                {
                    "sense_id": "b9a1e71f-6d5e-35ba-84b0-9a960d9757fb",
                    "sense_definition": "Retenir ou déchirer accidentellement un vêtement ou un objet contre une aspérité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accroc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais attention aux ronces en marchant car tu risques d'<w>accrocher</w> ton pantalon."
                        },
                        {
                            "text": "J'ai <w>accroché</w> ma chemise à un clou qui dépassait de la porte."
                        }
                    ],
                    "synonyms": [
                        "déchirer"
                    ],
                    "common_phrases": [
                        "accrocher sa veste"
                    ]
                },
                {
                    "sense_id": "9ec1b3fe-d4d1-33e2-b99d-0be1bb4cb918",
                    "sense_definition": "Heurter ou frotter légèrement un autre véhicule ou un obstacle lors d'une manœuvre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "collision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En sortant du garage, le conducteur a <w>accroché</w> le mur avec son aile droite."
                        },
                        {
                            "text": "Deux voitures se sont <w>accrochées</w> au carrefour sans faire de blessés."
                        }
                    ],
                    "synonyms": [
                        "érafler",
                        "heurter"
                    ],
                    "common_phrases": [
                        "accrocher une voiture",
                        "accrocher le rétroviseur"
                    ]
                },
                {
                    "sense_id": "81beaade-ca91-381d-9bf6-90df09e0883d",
                    "sense_definition": "Susciter l'intérêt ou l'enthousiasme de quelqu'un, plaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai regardé les premiers épisodes mais je n'ai pas vraiment <w>accroché</w>."
                        },
                        {
                            "text": "Ce roman captivant <w>accroche</w> le lecteur dès le premier chapitre."
                        }
                    ],
                    "synonyms": [
                        "séduire",
                        "plaire"
                    ],
                    "common_phrases": [
                        "accrocher à une série",
                        "accrocher à un livre"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "d563f14b-f611-37e4-ba70-f00eacf77496",
                    "sense_definition": "Réussir à obtenir quelque chose d'important ou de disputé après des démarches.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "obtenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe espère bien <w>accrocher</w> une victoire lors de ce match décisif."
                        },
                        {
                            "text": "Après de nombreux entretiens, le jeune diplômé a enfin <w>accroché</w> un emploi stable."
                        }
                    ],
                    "synonyms": [
                        "décrocher",
                        "obtenir"
                    ],
                    "antonyms": [
                        "perdre",
                        "rater"
                    ],
                    "common_phrases": [
                        "accrocher une victoire",
                        "accrocher un contrat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "9e7991b1-6679-3b1d-8eee-3a1d76e5ea39",
                    "sense_definition": "Aborder ou interpeller quelqu'un au passage, souvent de façon inattendue ou insistante.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "interpeller",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un journaliste a essayé de m'<w>accrocher</w> à la sortie de la conférence."
                        },
                        {
                            "text": "Elle a profité de la pause pour <w>accrocher</w> le directeur et lui parler du projet."
                        }
                    ],
                    "synonyms": [
                        "aborder",
                        "interpeller"
                    ],
                    "common_phrases": [
                        "accrocher un passant"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "439d0238-2ef1-3330-9bd2-bb6a90c85522",
                    "sense_definition": "Coller ou brûler légèrement au fond d'un récipient pendant la cuisson.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cuisson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Remue souvent la sauce pour éviter qu'elle n'<w>accroche</w> au fond du plat."
                        },
                        {
                            "text": "Le riz a un peu <w>accroché</w> parce que le feu était trop fort."
                        }
                    ],
                    "synonyms": [
                        "attacher",
                        "brûler"
                    ],
                    "common_phrases": [
