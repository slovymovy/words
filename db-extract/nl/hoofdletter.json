                    },
                    {
                        "form_id": "aa7e283a-16b1-453b-b5ec-e2004e1a9ae5",
                        "entry_id": "ee6cab27-8391-300e-b10f-49f73fb2029e",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "hoofdlettertjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9e36668-d9b8-3057-ad55-56d60dfbdd61",
                        "entry_id": "ee6cab27-8391-300e-b10f-49f73fb2029e",
                        "glosses": [
                            "hogere, bredere en soms afwijkende vorm van een letter die wordt gebruikt om het begin van eigennamen en volzinnen te markeren en vaak ook om de afzonderlijke letter aan te duiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b65d48d-5ca7-41ac-bbd7-82b27e94ced9",
                                "sense_id": "c9e36668-d9b8-3057-ad55-56d60dfbdd61",
                                "text": "In het Nederlands wordt het eerste woord van een zin met een hoofdletter geschreven. In het Duits begint een zelfstandig naamwoord met een hoofdletter."
                            },
                            {
                                "example_id": "f18542a4-de2d-44ca-8e7f-4dbe2922d819",
                                "sense_id": "c9e36668-d9b8-3057-ad55-56d60dfbdd61",
                                "text": "Ik draaide me om en liep naar de beroemde Southern Terminus-palen die het beginpunt vormen van de Pacific Crest Trail. In hoofdletters was de lengte van de trail erin gegraveerd: ‘MEXICO TO CANADA 2.627 MILES’, oftewel 4.286 kilometer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52c5d64d-494c-425f-9692-05b92c8d14fe",
                        "source_entry_id": "ee6cab27-8391-300e-b10f-49f73fb2029e",
                        "source_sense_id": "c9e36668-d9b8-3057-ad55-56d60dfbdd61",
                        "source_sense_description": "een letter die een groter formaat en meestal ook een andere vorm heeft dan een kleine letter",
                        "target_lang_word": "Großbuchstabe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großbuchstabe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e75ba1d-8ee2-398c-8e8a-c2e1000ebe72",
                                        "entry_id": "565aedae-e5c2-3a42-b98f-94840c807aee",
                                        "glosses": [
                                            "Buchstabe, der verglichen mit dem entsprechenden Kleinbuchstaben in der Regel größer und in anderer Form geschrieben wird und gewöhnlich als erster Buchstabe eines Satzes, eines Namens und im Deutschen als erster Buchstabe von Substantiven verwendet wird"
                                        ],
                                        "tags": [
                                            "Schriftlinguistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec443da7-6e35-446e-8e69-97f724ddb170",
                                                "sense_id": "9e75ba1d-8ee2-398c-8e8a-c2e1000ebe72",
                                                "text": "„Das Problem ist nicht nur die Variation der Häufigkeiten von Buchstaben in unterschiedlichen Textgattungen, sondern auch die unterschiedliche Verwendungshäufigkeit bei einzelnen Autoren, falls diese beispielsweise bestimmte Familiennamen sehr häufig verwenden und daher das festgestellte Verhältnis von Groß- und Kleinbuchstaben von den berechneten Häufigkeiten abweicht.“"
                                            },
                                            {
                                                "example_id": "58a68f7c-3cf0-424e-b67b-832951237e40",
                                                "sense_id": "9e75ba1d-8ee2-398c-8e8a-c2e1000ebe72",
                                                "text": "„Man erfindet daher außerordentlich komplizierte Großbuchstaben und variiert ihre Formen.“"
                                            },
                                            {
                                                "example_id": "3b27fd50-ef34-45d2-a76f-1e95aa659ab7",
                                                "sense_id": "9e75ba1d-8ee2-398c-8e8a-c2e1000ebe72",
                                                "text": "„Der griechische Text ist dabei in Großbuchstaben, der palmyrenische in Kleinbuchstaben wiedergegeben.“"
                                            },
                                            {
                                                "example_id": "6d05c59d-e12f-45e5-a914-9e6d36d9a201",
                                                "sense_id": "9e75ba1d-8ee2-398c-8e8a-c2e1000ebe72",
                                                "text": "„Darüber wird eine provisorische Holzhütte errichtet, an der mit goldenen Großbuchstaben der Name Lenin prangt.“"
                                            },
                                            {
                                                "example_id": "5e4f5187-b60e-4134-aa6d-b37b198f95f9",
                                                "sense_id": "9e75ba1d-8ee2-398c-8e8a-c2e1000ebe72",
                                                "text": "„Kleinbuchstaben werden vor Großbuchstaben eingeordnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ef14d03-ab4f-4da0-bfaf-303c9cf277d6",
                        "source_entry_id": "ee6cab27-8391-300e-b10f-49f73fb2029e",
                        "source_sense_id": "c9e36668-d9b8-3057-ad55-56d60dfbdd61",
                        "source_sense_description": "een letter die een groter formaat en meestal ook een andere vorm heeft dan een kleine letter",
                        "target_lang_word": "Majuskel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Majuskel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40176dea-c922-3d7c-bd33-f24265c0aac7",
                                        "entry_id": "43923ac4-8750-365a-872a-825ded31e6e8",
                                        "glosses": [
                                            "großgeschriebener Buchstabe"
                                        ],
                                        "tags": [
                                            "Schriftlinguistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28476a9a-62c5-4996-9c46-25b7de635e3d",
                                                "sense_id": "40176dea-c922-3d7c-bd33-f24265c0aac7",
                                                "text": "„Sie sind von athenischen Priestern in Majuskel- und Minuskelschrift eingekratzt.“"
                                            },
                                            {
                                                "example_id": "807c15c9-3967-45c5-b8bc-d1be1acde077",
                                                "sense_id": "40176dea-c922-3d7c-bd33-f24265c0aac7",
                                                "text": "„Von einem fernen Gestirn aus gelesen, würde vielleicht die Majuskel-Schrift unsres Erden-Daseins zu dem Schluss verführen, die Erde sei der eigentlich asketische Stern, ein Winkel missvergnügter, hochmüthiger und widriger Geschöpfe, die einen tiefen Verdruss an sich, an der Erde, an allem Leben gar nicht loswürden und sich selber so viel Wehe thäten als möglich, aus Vergnügen am Wehethun.“"
                                            },
                                            {
                                                "example_id": "b482e3f5-2109-482a-bee9-ba3e3b900162",
                                                "sense_id": "40176dea-c922-3d7c-bd33-f24265c0aac7",
                                                "text": "„Der Unterschied zwischen Majuskeln und Minuskeln hat in der gesprochenen Sprache keine Entsprechung (obwohl er teilweise durchaus grammatische Unterschiede reflektiert), und durch jegliche Segmentierung in der schriftlichen Form wird die gesprochene Sprache mit in ihr zwar enthaltenen, oberflächlich aber nicht manifesten Distinktionen überzogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
