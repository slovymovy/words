                "senses": [
                    {
                        "sense_id": "cbf45fdf-ff37-387e-82ef-c88363876d9e",
                        "entry_id": "4e4e6289-79f4-362e-aa12-ac5b9fe6072f",
                        "glosses": [
                            "ein Wort oder anderes sprachliches Element aus dem Russischen, das zur politischen Sprache der Sowjetunion gehört und in eine andere Sprache entlehnt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dc3c856-5a03-4847-a822-b66874197b63",
                                "sense_id": "cbf45fdf-ff37-387e-82ef-c88363876d9e",
                                "text": "„Was das entlehnte Wortgut des 20. Jahrhunderts angeht, so enthält die Datenbasis einige Sowjetismen, die im politischen Wortschatz eine Rolle spielten bzw. spielen (…).“"
                            },
                            {
                                "example_id": "510fabb9-6326-48d9-b2d4-ef4f8b6420ca",
                                "sense_id": "cbf45fdf-ff37-387e-82ef-c88363876d9e",
                                "text": "Huterer kennt Sowjetismen im DDR-Deutsch: „Daß die wenigen echt slavischen DDR-Sowjetismen wie der Natschalnik, der Propusk und der Subbotnik akut vom Aussterben bedroht sind, ist ebenfalls kein Grund, in Schwermut zu verfallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
