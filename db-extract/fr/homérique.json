                    {
                        "translation_id": "3ee5b56c-69c2-45e0-865b-12a0e796e8d3",
                        "source_entry_id": "41fc903c-0c8b-3b32-a95d-14cd9ff86021",
                        "target_lang_word": "гомерический",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гомерический",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "810bef38-08d9-353f-9212-ce1462bc6370",
                                        "entry_id": "9d275764-c679-34b5-a6c7-fa1c2b150140",
                                        "glosses": [
                                            "редк. относящийся к Гомеру, связанный с ним"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40590aaf-0ce0-4ea9-ab0e-b2c1325f108a",
                                                "sense_id": "810bef38-08d9-353f-9212-ce1462bc6370",
                                                "text": "Мы с ним переживали ещё гомерический период знаменитого странствователя Одиссея, который оценивал достоинство живописных ландшафтов дикой, невозделанной местности только с практической точки зрения, как на прибыльные угодья, которые хорошо было бы засеять пшеницею, засадить виноградными лозами и населить стадами овец."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4824a58-a18a-38e9-8935-e74c76968427",
                                        "entry_id": "9d275764-c679-34b5-a6c7-fa1c2b150140",
                                        "glosses": [
                                            "перен., книжн. неудержимый, громкий, раскатистый (о смехе, подобном смеху богов из поэм Гомера «Илиада» и «Одиссея»)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9787c1d-97a6-4fe5-9b1b-b1ffef6a624f",
                                                "sense_id": "f4824a58-a18a-38e9-8935-e74c76968427",
                                                "text": "Можно легко представить себе, какой гомерический хохот в зрительном зале возбуждали эти слова."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4c7518b-c965-30b0-8ecc-a292e41c966c",
                                        "entry_id": "9d275764-c679-34b5-a6c7-fa1c2b150140",
                                        "glosses": [
                                            "перен., книжн. необычайно сильный, обильный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd99088-0d6e-4118-96f9-dc0d167f5e07",
                                                "sense_id": "a4c7518b-c965-30b0-8ecc-a292e41c966c",
                                                "text": "Под гомерический стон великолепный Ираклий Андроников изображал Маршака."
                                            },
                                            {
                                                "example_id": "0b3cc10f-99af-4364-9c5f-18df53a92d59",
                                                "sense_id": "a4c7518b-c965-30b0-8ecc-a292e41c966c",
                                                "text": "Обед гомерический, ужин такой же."
                                            }
                                        ]
                                    }
                                ]
                            }
