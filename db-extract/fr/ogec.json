                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a581dce3-ab99-461c-9f05-b08540fdcfa8",
                                "sense_id": "453282ed-5c24-3d2d-a822-015877991e31",
                                "text": "Les Ogec (Organismes de gestion de l'enseignement catholique) constituent les supports juridiques, économiques et financiers des établissements catholiques d’enseignement. Responsable de la gestion économique, financière et sociale de l’établissement, l’Ogec exerce cette fonction en tenant compte du projet d'établissement, du Statut de l’Enseignement catholique, et de l'autorité de tutelle."
                            }
