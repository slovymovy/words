                "senses": [
                    {
                        "sense_id": "7fc6964e-35c5-3b05-9eaf-11989e4a3951",
                        "entry_id": "92c4ffc0-934a-3e40-a0e1-d4297376c8bc",
                        "glosses": [
                            "die Beseitigung eines Zustandes, der Geruch verursacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d85c69bc-6c34-4fd2-9fd4-32ed3d4e8fb8",
                                "sense_id": "7fc6964e-35c5-3b05-9eaf-11989e4a3951",
                                "text": "„Durch diese Effekte wird wahrscheinlich auch die effektive und rasche Geruchstilgung übelriechender Wunden mediiert, wie in einer englischen Studie von Dunford 2004 beobachtet wurde.“"
                            },
                            {
                                "example_id": "6364f0e7-bec4-4e4b-a8be-fcc1c6bdfbed",
                                "sense_id": "7fc6964e-35c5-3b05-9eaf-11989e4a3951",
                                "text": "„Laut Hersteller ist diese Art der Geruchstilgung doppelt so effektiv wie ein Aktivkohlefilter.“"
                            },
                            {
                                "example_id": "bd157fe9-85f3-44b9-a692-31641d86a344",
                                "sense_id": "7fc6964e-35c5-3b05-9eaf-11989e4a3951",
                                "text": "„Durch das hohe osmotische Potenzial der Wundauflage wird die Sekretbildung anfangs begünstigt, wodurch Bakterien, Endotoxine, Beläge und nekrotisches Gewebe aus der Wunde gespült werden und eine rasche Geruchstilgung eintritt.“"
                            },
                            {
                                "example_id": "473bade4-3fa4-48c3-84c7-5642f27fbc3e",
                                "sense_id": "7fc6964e-35c5-3b05-9eaf-11989e4a3951",
                                "text": "„Dieser regenerierbare Filter sorgt für eine revolutionär bessere Geruchstilgung beim Kochen mit einer Umlufthaube.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
