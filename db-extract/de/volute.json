                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3444468-18ae-3279-8cdc-59674cba4d95",
                                        "entry_id": "dc12bed6-3621-3421-bdfc-85ceed5c0cde",
                                        "glosses": [
                                            "Ornement du chapiteau de la colonne ionique et de la colonne composite, fait en forme de spirale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4fe6550-ab86-41af-bcee-2d629f428318",
                                                "sense_id": "c3444468-18ae-3279-8cdc-59674cba4d95",
                                                "text": "L’acanthe de Corinthe, la volute d’Ionie fleurissaient et se contournaient au chapiteau des colonnes."
                                            },
                                            {
                                                "example_id": "081f24ad-3e49-4414-bcc1-923e60498bd7",
                                                "sense_id": "c3444468-18ae-3279-8cdc-59674cba4d95",
                                                "text": "De chaque côté s’élevaient des maisons de brique rouge surmontées de pignons à volutes, dont les fenêtres et les portes se détachaient, encadrées de blanc, avec une propreté toute hollandaise."
                                            },
                                            {
                                                "example_id": "eb932197-7f77-4dc8-a322-91cf4fbd7b62",
                                                "sense_id": "c3444468-18ae-3279-8cdc-59674cba4d95",
                                                "text": "À première vue, on attribuerait au gothique flamboyant cette maîtresse œuvre où l’on découvre bientôt les volutes, les ornements, toutes les riches imaginations de la Renaissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ffc481e-c734-3f85-9fa6-dc708de2a609",
                                        "entry_id": "dc12bed6-3621-3421-bdfc-85ceed5c0cde",
                                        "glosses": [
                                            "Ornement en forme de spirale, à l’extrémité du manche d’un violon, viole, violoncelle ou contrebasse."
                                        ],
                                        "tags": [
                                            "Lutherie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e7967ce-639b-3057-8685-73fc36db94ac",
                                        "entry_id": "dc12bed6-3621-3421-bdfc-85ceed5c0cde",
                                        "glosses": [
                                            "Nom donné à des coquilles univalves tournées en cône pyramidal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a87b7d4d-21b8-3351-8ced-9d5f8745b4ff",
                                        "entry_id": "dc12bed6-3621-3421-bdfc-85ceed5c0cde",
                                        "glosses": [
                                            "Spirale, tourbillon, d’un fluide, fumée, brume, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a107a5a-1bcd-4fce-b001-9d35f5a05fe5",
                                                "sense_id": "a87b7d4d-21b8-3351-8ced-9d5f8745b4ff",
                                                "text": "Lorsque Jasper Hobson arriva sur les bords du lagon, il ne put en distinguer la surface, qui était encore cachée par de grosses volutes de brumes."
                                            },
                                            {
                                                "example_id": "7242cc3c-ad6b-4edf-b14f-54abbed10f82",
                                                "sense_id": "a87b7d4d-21b8-3351-8ced-9d5f8745b4ff",
                                                "text": "[…]; les volutes de brume qui coiffaient les volcans furent alors éclairées en rouge, donnant à l’ensemble de l’île l’aspect d’une formidable éruption générale."
                                            },
                                            {
                                                "example_id": "eca48ade-2de1-4e8b-a25c-bdf3749f578a",
                                                "sense_id": "a87b7d4d-21b8-3351-8ced-9d5f8745b4ff",
                                                "text": "Marandier alluma une cigarette et suivit d’un regard rêveur les volutes bleues qui serpentinaient vers le plafond."
                                            }
                                        ]
                                    }
                                ]
                            },
