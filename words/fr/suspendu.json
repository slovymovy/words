                    "sense_id": "0be8f9ba-73c7-3c5f-9795-b05da5893d8e",
                    "sense_definition": "Participe passé masculin singulier de <w>suspendre</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
