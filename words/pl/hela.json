                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pojemniki",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rolnik załadował pełną <w>helę</w> świeżo wykopanych ziemniaków.",
                            "target_lang_translations": {
                                "ru": "Фермер загрузил полный <w>ящик</w> свежевыкопанного картофеля."
                            }
                        },
                        {
                            "text": "Stara <w>hela</w> stała zapomniana w rogu stodoły.",
                            "target_lang_translations": {
                                "ru": "Старый <w>ящик</w> стоял забытый в углу сарая."
                            }
                        }
                    ],
                    "synonyms": [
                        "paka"
                    ],
                    "traits": [
