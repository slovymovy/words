            {
                "entry_id": "5fa651d5-dd98-3c44-9332-a9795ddf5a0a",
                "word": "Ishmael",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2524a43b-1f6d-3770-ae5c-fd6209fc38c9",
                        "entry_id": "5fa651d5-dd98-3c44-9332-a9795ddf5a0a",
                        "glosses": [
                            "The eldest son of Abraham and his wife's handmaiden Hagar who were cast out after the birth of Isaac; traditionally the ancestor of the Arabs via the Ishmaelites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f6963d6-35f0-4391-a0c3-5595c86ed5de",
                                "sense_id": "2524a43b-1f6d-3770-ae5c-fd6209fc38c9",
                                "text": "And Hagar bare Abram a ſonne: and Abram called his ſonnes name, which Hagar bare, Iſhmael."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ed0dd4a-81ca-37b0-9d72-2f384a6ae4d4",
                        "entry_id": "5fa651d5-dd98-3c44-9332-a9795ddf5a0a",
                        "glosses": [
                            "A male given name from Hebrew."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d53b1c1b-2461-493f-867b-69e4a0842c7f",
                                "sense_id": "9ed0dd4a-81ca-37b0-9d72-2f384a6ae4d4",
                                "text": "Call me Ishmael."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "218bf52d-b352-4a4c-9ab9-32662a2c774d",
