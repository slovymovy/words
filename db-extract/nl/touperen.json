                                        "sense_id": "0699236c-c390-3e03-a51e-ae67dfbef81e",
                                        "entry_id": "58a268d5-74cc-3b62-a8a2-106ae52387ca",
                                        "glosses": [
                                            "To hold hair and comb it towards the head, thus giving it a bushier look."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb84c4b-899f-4d25-88c2-8476815968b2",
                                                "sense_id": "0699236c-c390-3e03-a51e-ae67dfbef81e",
                                                "text": "Her dark-blonde hair, worn long at Oxford, had been cut and backcombed, Diana-style, and quivered when she shook her head."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "backcomb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bad1536f-37e6-358e-adba-886002b2dbf1",
                                        "entry_id": "1ad25eff-cb9e-3312-8726-7465d87ac7c4",
                                        "glosses": [
                                            "The hairstyle produced by backcombing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "620d305d-9bd1-4b0a-95ce-b53c8f34f790",
                                                "sense_id": "bad1536f-37e6-358e-adba-886002b2dbf1",
                                                "text": "You and your fit friends anyway / I'd take them all out any day / They all got backcombs anyway"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cdbae19-36ee-38cd-a037-faedb8d1c44f",
                                        "entry_id": "1ad25eff-cb9e-3312-8726-7465d87ac7c4",
                                        "glosses": [
                                            "A decorative comb worn as an ornament and to secure a hairstyle."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb7e7ede-942b-4bbb-8f13-195c13aac104",
                                                "sense_id": "4cdbae19-36ee-38cd-a037-faedb8d1c44f",
                                                "text": "There was a part of a bottle of liquor on the table—the furniture of the hall was disarranged—a pair of slippers, two small combs, and a backcomb were lying near an easy chair."
                                            },
                                            {
                                                "example_id": "8a9ffe15-b9d0-4f80-b4b4-bf8f1f02ec92",
                                                "sense_id": "4cdbae19-36ee-38cd-a037-faedb8d1c44f",
                                                "text": "A backcomb comprising a pair of oppositely disposed members of sheet material each provided with teeth along one margin, a pivot pin securing the members at one end in overlapping relation."
                                            },
                                            {
                                                "example_id": "e014ff84-e676-4aae-9100-d7f6b1e42e51",
                                                "sense_id": "4cdbae19-36ee-38cd-a037-faedb8d1c44f",
                                                "text": "Her father had produced a pink crêpe de Chine blouse and a backcomb massed with brilliants—both of which she refused to wear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
