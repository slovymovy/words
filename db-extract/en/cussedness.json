                        "sense_id": "1408eaf9-18ff-32c3-b380-338074e82c0b",
                        "entry_id": "b5bcdc35-2376-30f1-90e8-b2029e4bb0ce",
                        "glosses": [
                            "The state or quality of being cussed."
                        ],
                        "tags": [
                            "dated",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d00e22dc-59de-48b5-961d-13aaa47f3cc8",
                                "sense_id": "1408eaf9-18ff-32c3-b380-338074e82c0b",
                                "text": "Well, if ever a man was born bad in his temper, 'twas Captain Bligh. . . . They made an Admiral of him in the end, but they never cured his cussedness."
                            },
                            {
                                "example_id": "523d7dda-d637-4da8-8fbf-c79ae6da5eba",
                                "sense_id": "1408eaf9-18ff-32c3-b380-338074e82c0b",
                                "text": "Full of vinegar and all-round cussedness, but without malice. Just as soon kill you as not, but in a playful sort of way, you understand, without meaning to at all."
                            },
                            {
                                "example_id": "cb8eb024-14c3-4c08-bce8-7fafd00e3dd7",
                                "sense_id": "1408eaf9-18ff-32c3-b380-338074e82c0b",
                                "text": "He made camp there that night, pitching his little tent in the trail for pure cussedness, and defying aloud a traveling world to make him move until he got good and ready."
                            }
                        ]
                    }
                ],
