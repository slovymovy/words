                        "tags": [
                            "plural"
                        ],
                        "form": "bobbers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33da18c2-1d79-3a9d-a06c-7a6c4a547098",
                        "entry_id": "b181e1de-c7bc-3795-ae15-f7ead5319265",
                        "glosses": [
                            "One who takes part in apple bobbing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88ba9262-f8b5-490f-bf16-705d6f0b6df2",
                                "sense_id": "33da18c2-1d79-3a9d-a06c-7a6c4a547098",
                                "text": "Put apples in a kitchen sink, a bathtub or a large shallow bucket filled with water. Each player must grab an apple with his or her teeth, using no hands. The fun of bobbing is for the bobbers to get wet! So don't forget the towels."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0644317-cb94-33d0-9b1d-213f12122f97",
                        "entry_id": "b181e1de-c7bc-3795-ae15-f7ead5319265",
                        "glosses": [
                            "A buoyant device (frequently made of cork or hollow plastic) attached to a line so as to suspend the end of the line with the hook (and bait or lure) above the bottom."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "28d5ae32-57c9-30f3-928d-4dd85ebc14ba",
                        "entry_id": "b181e1de-c7bc-3795-ae15-f7ead5319265",
                        "glosses": [
                            "A style of custom motorcycle with stripped-down bodywork and a shortened (or \\\"bobbed\\\") rear fender."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c2a5c201-6ab2-38a1-976c-64b281ecf7e5",
                        "entry_id": "b181e1de-c7bc-3795-ae15-f7ead5319265",
                        "glosses": [
                            "A person who rides a bobsleigh; a bobsleigher."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "096953d7-df8e-3a5a-8522-6b28da63ded9",
                        "entry_id": "b181e1de-c7bc-3795-ae15-f7ead5319265",
                        "glosses": [
                            "One who has a bob hairstyle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93215b14-e28b-474b-8e39-a1c750e43885",
                                "sense_id": "096953d7-df8e-3a5a-8522-6b28da63ded9",
                                "text": "Not to be outdone, another group of students formed the Bobber's Union and wore a much different hairstyle."
                            },
                            {
                                "example_id": "c5443f61-1096-4e67-832f-de264edafe76",
                                "sense_id": "096953d7-df8e-3a5a-8522-6b28da63ded9",
                                "text": "Newspaper articles from the time describe employers who refused to hire women with bobbed hair […] In Japan, a speaker at a national hairdressers' convention declared, “All bobbers are not dissolute women, but all dissolute women are bobbers.”"
                            }
                        ]
                    }
                ],
