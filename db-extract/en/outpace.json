                        "glosses": [
                            "To go faster than; to exceed the pace of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2b5bf1e2-227b-4c2d-8709-1674a88a3e1d",
                                "sense_id": "6ba5f093-bb51-3291-bae8-2a40bd77ba3b",
                                "text": "The youngster outpaced his grandfather and ran on ahead."
                            },
                            {
                                "example_id": "f791d2fe-443a-48bc-8701-71cd3b844d4c",
                                "sense_id": "6ba5f093-bb51-3291-bae8-2a40bd77ba3b",
                                "text": "Walters outpaced Raio Piiroja from a long ball forward and curled a powerful shot over the crossbar from a tight angle in the 33rd minute."
                            }
                        ]
                    }
