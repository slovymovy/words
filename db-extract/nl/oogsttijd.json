                                "sense_id": "7dd9c64a-7cc3-35fe-ad27-e9519d9f177b",
                                "text": "De oogsttijd voor graan is meestal in de late zomer.",
                                "translation": "The harvest time for grain is usually in the late summer.",
                                "english": "The harvest time for grain is usually in the late summer."
                            },
                            {
                                "example_id": "cc48a794-2f82-43ab-bf16-8a864f0219d5",
                                "sense_id": "7dd9c64a-7cc3-35fe-ad27-e9519d9f177b",
                                "text": "De boeren bereiden zich voor op de oogsttijd.",
                                "translation": "The farmers are preparing for the harvest time.",
                                "english": "The farmers are preparing for the harvest time."
                            },
                            {
                                "example_id": "3d1ff3a0-482d-4766-b134-e4728f53fd00",
                                "sense_id": "7dd9c64a-7cc3-35fe-ad27-e9519d9f177b",
                                "text": "Elk gewas heeft zijn eigen oogsttijd.",
                                "translation": "Every crop has its own harvest time.",
                                "english": "Every crop has its own harvest time."
                            }
                        ]
