                "translations": [
                    {
                        "translation_id": "f7e5c820-0487-439f-bece-25b7a5be1fce",
                        "source_entry_id": "eb2c8d25-1714-3ad8-aeb6-e85238fb1b1b",
                        "source_sense_id": "71d85cec-5e54-30b3-9d84-7e94bd9d1812",
