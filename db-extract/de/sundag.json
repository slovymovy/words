                "senses": [
                    {
                        "sense_id": "30a32199-8078-3de1-8ced-39d62285c6a6",
                        "entry_id": "101d1204-fd2d-33e8-8312-78cd13379082",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81cba638-e6be-4330-8702-be5d0c51a881",
                                "sense_id": "30a32199-8078-3de1-8ced-39d62285c6a6",
                                "text": "Frau Sundag ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "36ab5e67-0513-4c6d-937e-69495769c7d4",
                                "sense_id": "30a32199-8078-3de1-8ced-39d62285c6a6",
                                "text": "Herr Sundag wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dc1e20b8-060a-46aa-aa23-bfd0059b724e",
                                "sense_id": "30a32199-8078-3de1-8ced-39d62285c6a6",
                                "text": "Die Sundags fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "47192c16-d8ed-4c80-8ee3-9505b50168b5",
                                "sense_id": "30a32199-8078-3de1-8ced-39d62285c6a6",
                                "text": "Der Sundag trägt nie die Schals, die die Sundag ihm strickt."
                            },
                            {
                                "example_id": "fb1f403a-32a3-45ab-85fd-bd9f6583aa97",
                                "sense_id": "30a32199-8078-3de1-8ced-39d62285c6a6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sundag kommt, geht der Herr Sonndag.“"
                            },
                            {
                                "example_id": "38f73d8c-2c89-43e3-ac17-eb77832aae39",
                                "sense_id": "30a32199-8078-3de1-8ced-39d62285c6a6",
                                "text": "Sundag kommt und geht."
                            },
                            {
                                "example_id": "d75366d0-5333-4810-830e-02cb4d47281d",
                                "sense_id": "30a32199-8078-3de1-8ced-39d62285c6a6",
                                "text": "Sundags kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
