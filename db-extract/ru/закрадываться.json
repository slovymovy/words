                            {
                                "example_id": "48a0c3a2-dc56-4667-85e3-07ec3b12b160",
                                "sense_id": "e5d3630d-2d7a-3f5d-b6e8-523e304e5d8f",
                                "text": "Он начал закрадываться на женскую половину…"
                            }
                        ]
                    },
                    {
                        "sense_id": "3c100173-e009-3f39-b436-048c0b7991f7",
                        "entry_id": "d8209cac-55e5-35f2-97a4-14d600948d36",
                        "glosses": [
                            "перен. о чувствах, мыслях и т. п. — незаметно появляться, возникать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "580931c6-b636-4a9c-847b-c732103d915a",
                                "sense_id": "3c100173-e009-3f39-b436-048c0b7991f7",
                                "text": "Закрадывается подозрение, что по ночам, когда вы спите, они не спят."
                            },
                            {
                                "example_id": "8c5c1aef-da4a-41e1-bf03-c72d31aca67d",
                                "sense_id": "3c100173-e009-3f39-b436-048c0b7991f7",
                                "text": "Что-ты мысли странные закрадываются…"
                            }
                        ]
                    }
                ],
