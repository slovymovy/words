                    {
                        "translation_id": "608db43a-84b3-446a-be18-05e3e6c529c5",
                        "source_entry_id": "60d3afba-416d-39fd-a8e9-10995c1fcc5d",
                        "source_sense_id": "e4077f47-9764-38f4-8bf5-9eae80dfc366",
                        "source_sense_description": "(Police)",
                        "target_lang_word": "Gegenüberstellung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenüberstellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a1d3a48-f8bf-3083-9bbf-9630484392a9",
                                        "entry_id": "c3aba822-7612-3a5a-a8b4-2f84d17e11b6",
                                        "glosses": [
                                            "polizeiliche Maßnahme, die dazu dient, Straftäter zu identifizieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd033d18-6605-466e-b45f-b63caefe8bd9",
                                                "sense_id": "6a1d3a48-f8bf-3083-9bbf-9630484392a9",
                                                "text": "Es kam zu einer Gegenüberstellung vor Gericht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f2d0ddb-a19e-3a14-b112-597390821b1b",
                                        "entry_id": "c3aba822-7612-3a5a-a8b4-2f84d17e11b6",
                                        "glosses": [
                                            "Vergleich zwischen zwei Dingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a20a2001-85d5-4529-b475-1e6c838e2da4",
                                                "sense_id": "5f2d0ddb-a19e-3a14-b112-597390821b1b",
                                                "text": "Bei der Gegenüberstellung der Gewinne und Verluste zeigte sich, dass noch mehr in die Werbung gesteckt werden musste."
                                            },
                                            {
                                                "example_id": "1f983ea3-5906-4bbf-a2e3-77a2e35c26b9",
                                                "sense_id": "5f2d0ddb-a19e-3a14-b112-597390821b1b",
                                                "text": "„So löst die Gegenüberstellung von Dichtung und Wahrheit, von Subjektivität und Objektivität, in diesem Fall nicht nur einige literaturwissenschaftliche Rätsel.“"
                                            },
                                            {
                                                "example_id": "ec9f24f1-fcd5-4bd4-995a-6dd43db857d8",
                                                "sense_id": "5f2d0ddb-a19e-3a14-b112-597390821b1b",
                                                "text": "„Zugegeben, diese krasse Gegenüberstellung war übertrieben; gleichwohl macht sie das Unverhältnis zwischen Sprachkritik und Sprachwissenschaft deutlich.“"
                                            },
                                            {
                                                "example_id": "c150b2c4-ad92-4d69-a3cd-98a09366fbbf",
                                                "sense_id": "5f2d0ddb-a19e-3a14-b112-597390821b1b",
                                                "text": "„Durch die Gegenüberstellung aber und durch den jeweiligen Kontext wird auf der tieferen Sinnebene eine andere, ebenfalls vorhandene Bedeutung eines dieser Wörter aktualisiert.“"
                                            },
                                            {
                                                "example_id": "3409f155-f19c-47d1-8c70-2adccb0d14e4",
                                                "sense_id": "5f2d0ddb-a19e-3a14-b112-597390821b1b",
                                                "text": "„Die den Roman treibende Kraft ist, wie oben gesagt, die Gegenüberstellung Agathon – Hippias.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52ded2d2-da3f-4bcb-a602-6eec8f5170d6",
                        "source_entry_id": "60d3afba-416d-39fd-a8e9-10995c1fcc5d",
                        "source_sense_id": "e4077f47-9764-38f4-8bf5-9eae80dfc366",
