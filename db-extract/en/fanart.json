                                        "entry_id": "3b3899d7-2d5e-36ee-a369-e51db560241d",
                                        "glosses": [
                                            "Toute œuvre d’art (peinture, dessin, croquis,…) réalisée par un artiste et qui met en scène un personnage, un lieu ou une scène de l’univers qu’un autre artiste a créé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1965b070-d22e-42f9-83b6-fcd718bd9aa2",
                                                "sense_id": "da93181e-0cf8-3e91-b95e-e5dd940caa98",
                                                "text": "Elle adore faire des fanarts. Elle dessine souvent des super-héros, surtout Black Widow."
                                            },
                                            {
                                                "example_id": "a4252297-0397-453f-ab8e-326ed39d2fb7",
                                                "sense_id": "da93181e-0cf8-3e91-b95e-e5dd940caa98",
                                                "text": "On trouve beaucoup de fanarts de l’univers d’Harry Potter sur internet. Les fans adorent mettre leur propres vision des personnages en image."
                                            }
                                        ]
                                    }
                                ]
                            }
