                        "glosses": [
                            "A gesture that is made in error."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e27024de-d520-42c8-acc6-a73712f87d64",
                                "sense_id": "d0d6c0e5-5e9b-3484-8397-785a5ce62ce9",
                                "text": "From Faisal's perspective, a more dramatic “misgesture” on the part of the Americans was needed before the oil weapon would be employed."
                            },
                            {
                                "example_id": "3336b9d9-14eb-4bdb-9037-d5833dfd8bbc",
                                "sense_id": "d0d6c0e5-5e9b-3484-8397-785a5ce62ce9",
                                "text": "He understood that if she was as bad as the instructors and professors on the committee claimed, then there were a hundred misturns, missteps and misgestures she would have made that she did not."
                            }
                        ]
                    }
