                        "sense_id": "9cfa2bd9-0500-3765-99e4-c697fb35ac2f",
                        "entry_id": "a004c3d3-dedf-3153-874a-2d70f212c48d",
                        "glosses": [
                            "Genre de plantes de la famille des Astéracées ou une plante voisine de ce genre, plante annuelle à tige dressée, aux feuilles alternes, sessiles, épaisses, charnues, très divisées, en lanières aux fleurs, jaunes au centre, blanches à la circonférence, très odorantes, groupées en capitules solitaires au sommet des rameaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a55ffb54-8976-4109-8888-34679f82ce90",
                                "sense_id": "9cfa2bd9-0500-3765-99e4-c697fb35ac2f",
                                "text": "Ils allaient ainsi sur l’herbe rase d’un chemin stérile, où surgissaient de loin en loin épervières et matricaires."
                            },
                            {
                                "example_id": "2926e801-5ec0-48fd-810e-5862583990b9",
                                "sense_id": "9cfa2bd9-0500-3765-99e4-c697fb35ac2f",
                                "text": "Son huis a des lèvres comparables au chrysanthème matricaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "233cebf1-4c7c-3b44-b110-09b17fa9aa3e",
                        "entry_id": "a004c3d3-dedf-3153-874a-2d70f212c48d",
                        "glosses": [
                            "Grande camomille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c67e1a9-e109-4b58-8762-9a8c4fc8afd4",
                                "sense_id": "233cebf1-4c7c-3b44-b110-09b17fa9aa3e",
                                "text": "Utilisations dans d’autres îles de l’Océan Indien : Réunion : La Matricaire ( Tanacetum parthenium ) est utilisée contre les palpitations cardiaques ou, plus simplement, est dite bonne pour le cœur qu’elle tonifie ."
                            }
                        ]
                    }
