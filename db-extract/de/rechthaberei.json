                                                "sense_id": "a41251da-b067-3dc8-9117-f7766d196d5b",
                                                "text": "Il n’a aucune prétention."
                                            },
                                            {
                                                "example_id": "a7f8cf27-a3e4-4f1f-9f09-ee6065322ddc",
                                                "sense_id": "a41251da-b067-3dc8-9117-f7766d196d5b",
                                                "text": "Elle est remplie de prétentions."
