                "senses": [
                    {
                        "sense_id": "7ba1a8f8-ae29-3a95-9765-30e4858f8cac",
                        "entry_id": "53e5e5c1-45b3-3925-a2fb-0bbc7b08eada",
                        "glosses": [
                            "Variante, parfois rencontrée, de réinscrire (inscrire à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9201c7a0-345a-4682-b1a5-c1e0eeaeea58",
                                "sense_id": "7ba1a8f8-ae29-3a95-9765-30e4858f8cac",
                                "text": "Le travail est alors de re-inscrire le client vers une démarche plus pragmatique, avec les contraintes économiques associées."
                            },
                            {
                                "example_id": "c9b6ab13-20ba-42ad-a49e-c5565ff69994",
                                "sense_id": "7ba1a8f8-ae29-3a95-9765-30e4858f8cac",
                                "text": "Galère pour se re-inscrire mais Jak is back"
                            },
                            {
                                "example_id": "2c8ed3ba-f3d8-44cc-add7-fd09aba2d243",
                                "sense_id": "7ba1a8f8-ae29-3a95-9765-30e4858f8cac",
                                "text": "J'avais pourtant promis de ne jamais plus me re-inscrire, puisqu'ils ne voulaient pas de moi…"
                            },
                            {
                                "example_id": "d899b39c-595f-4804-bb0a-3ea1573e8ad0",
                                "sense_id": "7ba1a8f8-ae29-3a95-9765-30e4858f8cac",
                                "text": "Tu peux tenter de le re-inscrire."
                            }
                        ]
                    }
