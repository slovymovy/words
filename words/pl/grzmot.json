                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Usłyszeliśmy głęboki <w>grzmot</w> silnika ciężarówki.",
                            "target_lang_translations": {
                                "en": "We heard the deep <w>roar</w> of the truck's engine.",
                                "ru": "Мы услышали низкий <w>грохот</w> двигателя грузовика.",
                                "nl": "We hoorden het diepe <w>gedonder</w> van de vrachtwagenmotor.",
                                "de": "Wir hörten das tiefe <w>Dröhnen</w> des Lkw-Motors.",
                                "fr": "Nous avons entendu le profond <w>grondement</w> du moteur du camion.",
                                "it": "Abbiamo sentito il profondo <w>rombo</w> del motore del camion.",
                                "cs": "Uslyšeli jsme hluboké <w>dunění</w> motoru nákladního auta.",
                                "tr": "Kamyon motorunun derin <w>gümbürtüsünü</w> duyduk.",
                                "es": "Oímos el profundo <w>rugido</w> del motor del camión.",
                                "zh": "我们听到了卡车引擎低沉的<w>轰鸣</w>。"
                            }
                        },
                        {
                            "text": "Ziemia zadrżała od <w>grzmotu</w> przejeżdżającego pociągu.",
                            "target_lang_translations": {
                                "en": "The ground trembled from the <w>rumble</w> of the passing train.",
                                "ru": "Земля задрожала от <w>грохота</w> проезжающего поезда.",
                                "nl": "De aarde trilde door het <w>gedreun</w> van de voorbijrijdende trein.",
                                "de": "Die Erde bebte unter dem <w>Donnern</w> des vorbeifahrenden Zuges.",
                                "fr": "Le sol trembla sous le <w>fracas</w> du train qui passait.",
                                "it": "La terra ha tremato per il <w>boato</w> del treno che passava.",
                                "cs": "Země se zachvěla <w>rachotem</w> projíždějícího vlaku.",
                                "tr": "Yer, geçen trenin <w>gümbürtüsüyle</w> sarsıldı.",
                                "es": "La tierra tembló por el <w>estruendo</w> del tren que pasaba.",
                                "zh": "大地下因驶过的火车的<w>隆隆声</w>而颤抖。"
                            }
