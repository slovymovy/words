                                "target_senses": [
                                    {
                                        "sense_id": "92e9c117-5f78-3427-a721-c00ef1e45c11",
                                        "entry_id": "63fce9fc-bdc3-3751-96c2-542adf7fd20e",
                                        "glosses": [
                                            "Vexing, humiliating; eliciting indignation or bitterness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b6503fd-37e6-4ebf-a469-e393adba71c8",
                                                "sense_id": "92e9c117-5f78-3427-a721-c00ef1e45c11",
                                                "text": "Uruguay were quick to the ball, strong in the tackle and seemed intent on showing they were a better team than had been apparent in their defeat to Costa Rica. Yet the most galling part for England is that they helped them on their way."
                                            }
                                        ]
                                    }
