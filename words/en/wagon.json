                            {
                                "target_lang_word": "потаскуха",
                                "target_lang_sense_clarification": "презрительное обозначение распутной женщины"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f71627b-5772-3a4a-a6ee-0b08efc5c617",
                    "sense_definition": "To transport goods or people using a wagon.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners had to <w>wagon</w> the ore down the steep mountain path to the processing plant.",
                            "target_lang_translations": {
                                "ru": "Шахтерам приходилось <w>перевозить</w> руду на телегах вниз по крутой горной тропе к перерабатывающему заводу."
                            }
                        },
                        {
                            "text": "During the harvest, they would <w>wagon</w> produce to the local market every Saturday morning.",
                            "target_lang_translations": {
                                "ru": "Во время сбора урожая они каждое субботнее утро <w>развозили</w> продукты на рынок."
                            }
                        }
