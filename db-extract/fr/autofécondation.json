        "fr-extract.jsonl": [
            {
                "entry_id": "692d638e-e419-33c3-95d4-f7f411252b9a",
                "word": "autofécondation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3225b6e9-dda3-4406-aecc-eb542e3d2e20",
                        "entry_id": "692d638e-e419-33c3-95d4-f7f411252b9a",
                        "tags": [
                            "plural"
                        ],
                        "form": "autofécondations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "24b66602-aca5-32aa-93ae-949cd9fb3c17",
                        "entry_id": "692d638e-e419-33c3-95d4-f7f411252b9a",
                        "glosses": [
                            "Fait pour un organisme de féconder son ou ses gamètes femelles par ses propres gamètes mâles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "732401c5-2b8a-4a62-8d39-ef1bcb9a6ad7",
                                "sense_id": "24b66602-aca5-32aa-93ae-949cd9fb3c17",
                                "text": "En conséquence, toute différence dans la fécondité de leurs fleurs après croisement et après autofécondation eut pour cause la nature du pollen employé ; c’est-à-dire qu’il fut pris sur un plant distinct ou sur la même fleur."
                            },
                            {
                                "example_id": "69b51c40-df36-4b51-b47b-90a545016cb1",
                                "sense_id": "24b66602-aca5-32aa-93ae-949cd9fb3c17",
                                "text": "A l’opposé des mécanismes favorisant l’allofécondation, il est fréquent d’observer des fleurs qui ne s’ouvrent pas (cléistogamie). Dans ce cas, ces fleurs ne peuvent ni recevoir, ni exporter du pollen : il y a alors autofécondation obligatoire."
                            },
                            {
                                "example_id": "3f697dc3-f68d-4f87-af6b-dcf402d9e186",
                                "sense_id": "24b66602-aca5-32aa-93ae-949cd9fb3c17",
                                "text": "L’autofécondation consiste en la fécondation d’un ovule par du pollen issu de la même plante."
                            }
                        ]
                    }
                ],
