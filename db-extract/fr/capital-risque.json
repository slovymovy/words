                    },
                    {
                        "form_id": "7820099a-3f63-42fc-b4b2-27387d351b69",
                        "entry_id": "49097eaf-d390-33c7-a2ba-60fa5991053b",
                        "tags": [
                            "singular"
                        ],
                        "form": "capital-risques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4a60421-a5e6-3383-8aad-e25ef71b03ee",
                        "entry_id": "49097eaf-d390-33c7-a2ba-60fa5991053b",
                        "glosses": [
                            "Investissement à risques assorti de gains potentiels élevés, consistant en prises de participations dans des entreprises œuvrant en principe dans les techniques de pointe, les idées nouvelles et sur les marchés risqués, et réalisé notamment par des sociétés spécialisées, dites « sociétés de capital-risque »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af5381e1-808d-4407-9d04-b0ad5045b158",
                                "sense_id": "c4a60421-a5e6-3383-8aad-e25ef71b03ee",
                                "text": "Quand on cherche un peu, on se rend compte qu’Incept a été financée par Union Square Ventures, un pourvoyeur de capital-risque ayant apporté des fonds à des initiatives « alternatives » comme DuckDuckGo, mais possédant aussi des parts dans Foursquare, KickStarter ou même Twitter."
                            },
                            {
                                "example_id": "2f55d12e-b130-4268-b167-16e35a037883",
                                "sense_id": "c4a60421-a5e6-3383-8aad-e25ef71b03ee",
                                "text": "Les co-investisseurs peuvent être d’autres investisseurs (pas forcément des migrants) ou des mécanismes publics ou privés d’accompagnement (pécule type PDLM, capital-risque de l’économie solidaire, prêts bancaires, etc.)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87e52a21-a2ed-4d71-9843-8d4755d30eab",
                        "source_entry_id": "49097eaf-d390-33c7-a2ba-60fa5991053b",
                        "source_sense_id": "c4a60421-a5e6-3383-8aad-e25ef71b03ee",
                        "target_lang_word": "Risikokapital",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Risikokapital",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0772d1e-4057-3266-946a-ca8c6d04f0f5",
                                        "entry_id": "309d016a-4a20-3275-8049-0c2d67fd3573",
                                        "glosses": [
                                            "Kapital, das in vielversprechende, aber noch nicht etablierte Unternehmen fließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bf05ffe-447e-4437-b981-30c01adf2c67",
                                                "sense_id": "e0772d1e-4057-3266-946a-ca8c6d04f0f5",
                                                "text": "„Aber obwohl weder spanisches noch portugiesisches Risikokapital im Spiel war, begann mit Vascos Expedition die portugiesische Vorherrschaft über den Gewürzhandel zwischen Europa und Indien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "733a8215-1a4a-4827-8687-f5827baf3436",
                        "source_entry_id": "49097eaf-d390-33c7-a2ba-60fa5991053b",
                        "source_sense_id": "c4a60421-a5e6-3383-8aad-e25ef71b03ee",
                        "target_lang_word": "venture capital",
                        "target_lang_code": "en",
