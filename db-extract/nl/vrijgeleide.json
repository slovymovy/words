                            {
                                "target_word": "safe-conduct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4dfd62b-564a-374d-890a-ba767d9df517",
                                        "entry_id": "f4b8178b-10d0-3fd7-9594-b6760ba97f3f",
                                        "glosses": [
                                            "To guarantee safe passage by granting such a document."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51cda0d0-6be5-48fe-8621-59a42189d892",
                                                "sense_id": "e4dfd62b-564a-374d-890a-ba767d9df517",
                                                "text": "Who […] Haue paſt the armie of the mightie Turke:\nBearing his priuie ſignet and his hand,\nTo ſafe conduct vs thorow Affrica: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a47f339-af61-4c3a-9e00-be441e680508",
                        "source_entry_id": "4c525122-0b5a-3c49-9f0f-400db86666f7",
                        "source_sense_id": "88e6bb57-aa7b-3d48-8a58-d3d3094bb2ee",
                        "source_sense_description": "de vrije hand krijen",
                        "target_lang_word": "free hand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "free hand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f974332-1af3-3829-904b-dd142b20a54d",
                                        "entry_id": "21474ca4-0e9a-3e81-ba6e-993ea545d82b",
                                        "glosses": [
                                            "Synonym of free rein."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e59b904b-2249-4da4-8e12-4b28e49e4093",
                                                "sense_id": "1f974332-1af3-3829-904b-dd142b20a54d",
                                                "text": "\"Since I've been here, I've been given a fairly free hand by the GCR board to get on with things, properly understand the organisation from a different perspective, and develop a new business plan for the future,\" he tells RAIL."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "456b4d01-f79f-3eef-a5b9-172b70880720",
                                        "entry_id": "21474ca4-0e9a-3e81-ba6e-993ea545d82b",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see free, hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51f83b11-cfb6-43ac-9245-e8ed9b0cdf14",
                                                "sense_id": "456b4d01-f79f-3eef-a5b9-172b70880720",
                                                "text": "Wreck divers as well as night divers and cave divers have found that having a light or lights mounted on their head allows the divers to have free hands while being able to see."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ef6e456-77f8-40ab-a93b-44afd09aaa35",
                        "source_entry_id": "4c525122-0b5a-3c49-9f0f-400db86666f7",
                        "source_sense_id": "88e6bb57-aa7b-3d48-8a58-d3d3094bb2ee",
                        "source_sense_description": "de vrije hand krijen",
                        "target_lang_word": "free rein",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "free rein",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2817db1-bafc-3b62-87f1-6d66bb619579",
                                        "entry_id": "3f704ef7-d513-319b-8111-c0b17b71c3dd",
                                        "glosses": [
                                            "A rein of a horse held loosely so that the animal can move more freely; also, the free condition that this gives to a horse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65fff76a-0ced-4115-b09a-3bf18d1ebed8",
                                                "sense_id": "a2817db1-bafc-3b62-87f1-6d66bb619579",
                                                "text": "I needed no whip, or spur, for I was as eager as my rider: he saw it, and giving me a free rein, and leaning a little forward, we dashed after them."
                                            },
                                            {
                                                "example_id": "827ef92c-667c-475c-bea9-37ae1a6a519a",
                                                "sense_id": "a2817db1-bafc-3b62-87f1-6d66bb619579",
                                                "text": "[I]n the rise during the leap, just previous to the spring, no efforts whatever must be made by the rider to support the horse, or to lift him, but instead, she should simply hold the reins so lightly that his mouth can just be felt, which is called \"giving a free rein.\""
                                            },
                                            {
                                                "example_id": "eddf7584-e56f-430f-8a26-5c82d4abb552",
                                                "sense_id": "a2817db1-bafc-3b62-87f1-6d66bb619579",
                                                "text": "So ceased the sea's uproar, when its grave Sire / Looked o'er th' expanse, and, riding on in light, / Flung free rein to his winged obedient car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29526b22-cc27-337e-b8ad-3b61f9695799",
                                        "entry_id": "3f704ef7-d513-319b-8111-c0b17b71c3dd",
                                        "glosses": [
                                            "The absence of constraints; freedom to act, decide, or speak."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26de0714-b9f6-4019-826e-7f54ea9ea1ec",
                                                "sense_id": "29526b22-cc27-337e-b8ad-3b61f9695799",
                                                "text": "to give [a] free rein to"
                                            },
                                            {
                                                "example_id": "7cf4a497-2998-48fe-b31f-604295f7b1cf",
                                                "sense_id": "29526b22-cc27-337e-b8ad-3b61f9695799",
                                                "text": "[H]e vvas pleas'd to lend / Free reines to mirth, and to ſuſpend thoſe cares / That claime ſuch intereſt in th' Imperiall brovv."
                                            },
                                            {
                                                "example_id": "08f1928f-b59d-46d0-9e8b-d31755380b85",
                                                "sense_id": "29526b22-cc27-337e-b8ad-3b61f9695799",
                                                "text": "[Geoffrey] Chaucer gave a free rein to his poetical mirth."
                                            },
                                            {
                                                "example_id": "cdd1c5c5-0c32-4788-97b0-d8d52a8951e1",
                                                "sense_id": "29526b22-cc27-337e-b8ad-3b61f9695799",
                                                "text": "If you have any influence, therefore, on members of Congress, on editors, on the creators of public opinion, on your neighbors, on the rank and file of your army, teach them that with Massachusetts bayonets, it is better to be insubordinate, and shoot a Colonel, than it is, unasked, unauthorized, and Heaven-damned, to turn themselves into hunters of slaves. (Loud and prolonged cheers.) Help the Government to dare to give free rein to the ardor of the people."
                                            },
                                            {
                                                "example_id": "4b4c1265-22f1-4788-adb5-bc5b7e5463ea",
                                                "sense_id": "29526b22-cc27-337e-b8ad-3b61f9695799",
                                                "text": "At the suggestion of the latter [Bardas], Michael [III] sought the assistance of Ignatius [of Constantinople] in an effort to force Theodora to enter a convent, in the hope of securing for himself an undivided authority and a free rein for his profligacy. The patriarch indignantly refused to be a party to such an outrage. Theodora, however, realizing the determination of her son to possess at any cost an undivided rule, voluntarily abdicated."
                                            },
                                            {
                                                "example_id": "00b11ba5-88e3-4230-8006-dddace0ecf91",
                                                "sense_id": "29526b22-cc27-337e-b8ad-3b61f9695799",
                                                "text": "Such hedging is necessitated by the lack of in-depth knowledge of the contents, which also gives free rein to the scripting of unsubstantiated factoids concerning the book."
                                            },
                                            {
                                                "example_id": "5f37fdb7-3ae2-4924-a7ae-bad85e3030da",
                                                "sense_id": "29526b22-cc27-337e-b8ad-3b61f9695799",
                                                "text": "If I give my imagination free rein on this sultry afternoon, I could almost believe this shoulder-high grassland – a shimmering sea of false oat, cock’s-foot and meadow foxtail – is African savanna."
                                            },
                                            {
                                                "example_id": "a4bfb674-8ff6-43e5-bb03-0e2266d27e6c",
                                                "sense_id": "29526b22-cc27-337e-b8ad-3b61f9695799",
                                                "text": "Free City is, by design, a generic multiplayer sandbox—it's supposed to look like any and every free-rein video game metropolis."
                                            },
                                            {
                                                "example_id": "0c69da42-86de-4538-9211-5cb118b7df3f",
                                                "sense_id": "29526b22-cc27-337e-b8ad-3b61f9695799",
                                                "text": "Trump suggested that he has given the tech billionaire free rein and appeared blase about the details."
                                            },
                                            {
                                                "example_id": "e5d0ba8b-8c65-4ef7-910e-15ad9f70c988",
                                                "sense_id": "29526b22-cc27-337e-b8ad-3b61f9695799",
                                                "text": "There is, in fact, growing recognition in the Department that giving free rein to the open access operators will extract revenue from Great British Railways."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
