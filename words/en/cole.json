                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient manuscript described how they burned <w>cole</w> for heat.",
                            "target_lang_translations": {
                                "ru": "В древней рукописи описывалось, как они сжигали <w>уголь</w> для тепла.",
                                "fr": "Le manuscrit ancien décrivait comment ils brûlaient du <w>charbon</w> pour se chauffer."
                            }
                        },
                        {
                            "text": "He tossed a piece of black <w>cole</w> into the dying fire.",
                            "target_lang_translations": {
                                "ru": "Он бросил кусок черного <w>угля</w> в затухающий огонь.",
                                "fr": "Il a jeté un morceau de <w>charbon</w> noir dans le feu mourant."
                            }
                        }
