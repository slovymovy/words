                    {
                        "sense_id": "00eeb926-9bfa-318b-a730-7d7b741e5821",
                        "entry_id": "4919e5d1-147c-3a47-8300-c9d97483e8c7",
                        "glosses": [
                            "Stadt an der Mündung des Neckars in den Rhein in der Kurpfalz: Mannheim, diese Form mit -a- überwiegend in wenigen südlichen Stadtteilen Mannheims sowie überwiegend in der Gegend südlich von Mannheim"
                        ],
                        "tags": [
                            "Endonym",
                            "Pfälzisch"
                        ],
                        "examples": [
                            {
                                "example_id": "af4849bd-5867-43c7-8d37-187d07e8fc25",
                                "sense_id": "00eeb926-9bfa-318b-a730-7d7b741e5821",
                                "text": "„Wer hätt’ gedacht, wie er mit Schees un Perd’ nach Mannem g’fahre is, […]“",
                                "translation": "Kommentar: Schees: kleine/leichte Kutsche"
                            },
                            {
                                "example_id": "f53def4d-9d96-48f0-ba85-cf40216e46f3",
                                "sense_id": "00eeb926-9bfa-318b-a730-7d7b741e5821",
                                "text": "„Im Norde vun Monnem sachd ma Monnem. Im Süde vun Mannem hingege sachd ma Mannem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
