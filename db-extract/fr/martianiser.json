                "senses": [
                    {
                        "sense_id": "b303b598-f3ea-3573-b897-bc1e7e080f75",
                        "entry_id": "57f61b4b-a49d-3705-9291-79b89f0704eb",
                        "glosses": [
                            "Donner un caractère martien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b741c5-a2ac-4291-8027-564be4410557",
                                "sense_id": "b303b598-f3ea-3573-b897-bc1e7e080f75",
                                "text": "S’il y a des mécanismes moléculaires surprenants qui résolvent des problèmes biochimiques importants (probablement le cas si vie martienne il y a), peut-on les reproduire et les utiliser sur Terre ? Pour quoi ? De manière purement chimique ou en modifiant des bactéries pour les martianiser ?"
                            },
                            {
                                "example_id": "5547e8e0-6bab-46d3-a986-cc8435dafd6f",
                                "sense_id": "b303b598-f3ea-3573-b897-bc1e7e080f75",
                                "text": "Et une puissance extraterrestre, des Martiens peut-être, tentait de modifier, de « martianiser » l'espèce humaine, en bombardant les chromosomes humains au moyen de rayons cosmiques ?"
                            },
                            {
                                "example_id": "24c0c9ed-92e3-4945-ba09-1fc51a7885d2",
                                "sense_id": "b303b598-f3ea-3573-b897-bc1e7e080f75",
                                "text": "Le tout nouveau clip de Julia Daninos pour une année 2014 extra-terrestre ! Soyez prêt à vous faire martianiser."
                            }
                        ]
                    }
