                ],
                "senses": [
                    {
                        "sense_id": "196efaa4-cbcf-3c8b-a565-6522cd738599",
                        "entry_id": "a3ffad9b-6fb2-38e8-8bf5-ece7e356af31",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f76c3bf-88a3-41d6-865f-60adc70a8f0c",
                                "sense_id": "196efaa4-cbcf-3c8b-a565-6522cd738599",
                                "text": "Herr Lacher wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4fa995e7-48e5-4887-9540-b86674cea8a4",
                                "sense_id": "196efaa4-cbcf-3c8b-a565-6522cd738599",
                                "text": "Die Lachers fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "ae95cf1b-2620-437a-9a5e-1d4e9f864cd1",
                                "sense_id": "196efaa4-cbcf-3c8b-a565-6522cd738599",
                                "text": "Der Lacher trägt nie die Pullover, die die Lacher ihm strickt."
                            },
                            {
                                "example_id": "9c10df0e-c2d5-45e3-bee1-f4092574fa48",
                                "sense_id": "196efaa4-cbcf-3c8b-a565-6522cd738599",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lacher kommt, geht der Herr Lacher.“"
                            },
                            {
                                "example_id": "319118ef-1906-4d94-8dbb-68eda9067223",
                                "sense_id": "196efaa4-cbcf-3c8b-a565-6522cd738599",
                                "text": "Lacher kommt und geht."
                            },
                            {
                                "example_id": "49291a74-e902-4bb3-b963-6e8801dbc2b5",
                                "sense_id": "196efaa4-cbcf-3c8b-a565-6522cd738599",
                                "text": "Lachers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "c394ad66-2b34-43fd-9d77-806f9bedd588",
                                "sense_id": "196efaa4-cbcf-3c8b-a565-6522cd738599",
                                "text": "Frau Lacher ist ein Genie im Verkauf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
