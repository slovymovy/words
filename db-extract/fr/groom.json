        "fr-extract.jsonl": [
            {
                "entry_id": "2bfcec0c-e33f-3ef8-9b0b-94b654889e56",
                "word": "groom",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6e84ba96-46aa-4fe0-94af-99cc80629f34",
                        "entry_id": "2bfcec0c-e33f-3ef8-9b0b-94b654889e56",
                        "tags": [
                            "plural"
                        ],
                        "form": "grooms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "701643c7-cdbf-3c45-b01b-4fa5a1a8bcde",
                        "entry_id": "2bfcec0c-e33f-3ef8-9b0b-94b654889e56",
                        "glosses": [
                            "Jeune laquais d’écurie, palefrenier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52fd516e-f916-497b-b923-33c029982835",
                                "sense_id": "701643c7-cdbf-3c45-b01b-4fa5a1a8bcde",
                                "text": "Il pourrait mieux faire que de pérorer aussi magistralement et aussi longuement sur la supériorité des palefreniers anglais, qu'il a grand soin d'appeler des grooms."
                            },
                            {
                                "example_id": "529d1762-aebb-471d-8ebf-71537f707c77",
                                "sense_id": "701643c7-cdbf-3c45-b01b-4fa5a1a8bcde",
                                "text": "— Je désirerais voir le cheval à vendre et l’essayer en présence du groom de M. le préfet."
                            },
                            {
                                "example_id": "597aee94-5472-4107-8663-6af779474a94",
                                "sense_id": "701643c7-cdbf-3c45-b01b-4fa5a1a8bcde",
                                "text": "Que ne suis-je un cheval ! cheval de course, j’entends ; au moins il a un groom pour le soigner et de la paille jusqu’au ventre."
                            },
                            {
                                "example_id": "4aa1da0b-4b04-41ea-a301-91f3f92a431a",
                                "sense_id": "701643c7-cdbf-3c45-b01b-4fa5a1a8bcde",
                                "text": "Ajoutez à cela les jeûnes, les marches forcées, les suées extraordinaires auquels sont obligés de se soumettre les malheureux grooms pour perdre leur graisse afin d’arriver à ne peser que 50 ou 60 kilogrammes."
                            },
                            {
                                "example_id": "11b37e5d-1cbb-4758-a814-8ec5677a0d15",
                                "sense_id": "701643c7-cdbf-3c45-b01b-4fa5a1a8bcde",
                                "text": "À vingt ans, dandy plutôt qu’étudiant, il avait rêvé pour son tilbury d’un groom beau comme un page de Pinturicchio ou comme un éphèbe de Praxitèle."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f7ae2b0-83b5-379d-b130-3b8dbb3efb77",
                        "entry_id": "2bfcec0c-e33f-3ef8-9b0b-94b654889e56",
                        "glosses": [
                            "Assistant du meneur chargé de maintenir l’équilibre de la voiture dans les épreuves de course d’attelage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c66b42f3-31d2-4806-8d67-92f6139352d8",
                                "sense_id": "3f7ae2b0-83b5-379d-b130-3b8dbb3efb77",
                                "text": "Outre les aides logistiques, encore plus indispensables que dans les autres disciplines équestres, le meneur embarque dans sa voiture deux grooms chargés de faire le contrepoids dans les courbes serrées."
                            },
                            {
                                "example_id": "f077a754-e392-41b5-bf1c-b47cd015cd22",
                                "sense_id": "3f7ae2b0-83b5-379d-b130-3b8dbb3efb77",
                                "text": "Laurence Gazel est la groom, la femme de confiance, de Kevin Staut, le numéro 1 français de saut d’obstacles."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff677220-0779-3306-98e6-3aa0c0d0e66b",
                        "entry_id": "2bfcec0c-e33f-3ef8-9b0b-94b654889e56",
                        "glosses": [
                            "Laquais en livrée."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "830e4959-549a-417e-bec6-f152c6908273",
                                "sense_id": "ff677220-0779-3306-98e6-3aa0c0d0e66b",
                                "text": "À dix heures moins un quart, un valet de chambre entra. C’était un petit groom de quinze ans, ne parlant qu’anglais et répondant au nom de John."
                            },
                            {
                                "example_id": "838b7ad5-3a8d-4a55-aac4-ed2beccdcc56",
                                "sense_id": "ff677220-0779-3306-98e6-3aa0c0d0e66b",
                                "text": "Un groom […] qui apporte les lettres sur un plateau et dit timidement : « Madame est servie. »"
                            },
                            {
                                "example_id": "c71eb57a-3027-4e8e-a61a-119268022de4",
                                "sense_id": "ff677220-0779-3306-98e6-3aa0c0d0e66b",
                                "text": "Swann prit plaisir à voir les héritiers des « tigres » de Balzac, les grooms, suivants ordinaires de la promenade, qui, chapeautés et bottés, restaient dehors devant l’hôtel sur le sol de l’avenue, ou devant les écuries, comme des jardiniers auraient été rangés à l’entrée de leurs parterres."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1627389-877c-38ff-891f-a26381a9e9f6",
                        "entry_id": "2bfcec0c-e33f-3ef8-9b0b-94b654889e56",
                        "glosses": [
                            "Commissionnaire, coursier en livrée, employé le plus souvent dans le service de grands établissements, tels que cercles, hôtels, restaurants, etc."
                        ],
                        "tags": [
                            "Hôtellerie"
                        ],
                        "examples": [
                            {
                                "example_id": "958b560c-2490-40a6-ab6d-f72d941c6f1e",
                                "sense_id": "b1627389-877c-38ff-891f-a26381a9e9f6",
                                "text": "Son cœur reçut comme une application d’eau froide […], quand il aperçut dans une magnifique salle-à-manger un valet vêtu comme un banquier et à qui le groom l’avait adressé."
                            },
                            {
                                "example_id": "30dba56e-68bf-4e63-b430-314870af54f5",
                                "sense_id": "b1627389-877c-38ff-891f-a26381a9e9f6",
                                "text": "Bert effleura successivement un bon nombre de métiers : il fut groom dans un magasin de nouveautés et chez un médecin, garçon de pharmacie."
                            },
                            {
                                "example_id": "66d0d96d-11b3-419c-9fda-3008daf4e213",
                                "sense_id": "b1627389-877c-38ff-891f-a26381a9e9f6",
                                "text": "Une des questions qui sont particulièrement importantes dans le tourbillon de la vie d’hôtel est celle des chiens […]. Une armée de grooms doit être mobilisée plusieurs fois par jour pour la promenade hygiénique des clients à quatre pattes."
                            }
                        ]
                    },
                    {
                        "sense_id": "de36cfdc-9574-375f-a658-f2b33ccc6abe",
                        "entry_id": "2bfcec0c-e33f-3ef8-9b0b-94b654889e56",
                        "glosses": [
                            "Système mécanique qui referme une porte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c348bc-7c04-4d82-a7d4-b6c1c287519b",
                                "sense_id": "de36cfdc-9574-375f-a658-f2b33ccc6abe",
                                "text": "Il laissa le groom automatique refermer la porte derrière lui."
                            },
                            {
                                "example_id": "b8c74940-0c36-47a2-95ea-b9f19f46a853",
                                "sense_id": "de36cfdc-9574-375f-a658-f2b33ccc6abe",
                                "text": "Un vieux groom hydraulique referma la porte derrière moi. La maison, doucement, m’avalait."
                            }
                        ]
                    }
                ],
