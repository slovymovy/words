    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3cc44ac6-2782-3474-9f17-d52efa6beb59",
                    "sense_definition": "A casual short-sleeved shirt, usually made of cotton; short for <w>tee-shirt</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a simple white <w>tee</w> and jeans to the party.",
                            "target_lang_translations": {
                                "ru": "Она надела простую белую <w>футболку</w> и джинсы на вечеринку.",
                                "pl": "Na przyjęcie założyła prostą białą <w>koszulkę</w> i dżinsy."
                            }
                        },
                        {
                            "text": "I bought a souvenir <w>tee</w> from the concert.",
                            "target_lang_translations": {
                                "ru": "Я купил сувенирную <w>футболку</w> на концерте.",
                                "pl": "Kupiłem na koncercie pamiątkową <w>koszulkę</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "white tee",
                        "graphic tee",
                        "cotton tee"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortened form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повседневная рубашка с короткими рукавами, обычно из хлопка; сокращение от t-shirt.",
                        "pl": "Codzienna koszulka z krótkim rękawem, zazwyczaj wykonana z bawełny; skrót od t-shirt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "футболка",
                                "target_lang_sense_clarification": "одежда"
                            },
                            {
                                "target_lang_word": "майка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "koszulka",
                                "target_lang_sense_clarification": "ogólne określenie"
                            },
                            {
                                "target_lang_word": "t-shirt",
                                "target_lang_sense_clarification": "powszechnie używane zapożyczenie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acf6ea7b-159b-3819-8622-3bee5d8cec0e",
                    "sense_definition": "A small peg, usually made of wood or plastic, on which a golf ball is placed before being struck.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "golf_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pushed the wooden <w>tee</w> into the ground.",
                            "target_lang_translations": {
                                "ru": "Он воткнул деревянный <w>колышек</w> в землю.",
                                "pl": "Wbił drewniany <w>tee</w> w ziemię."
                            }
                        },
                        {
                            "text": "The ball fell off the <w>tee</w> before he could hit it.",
                            "target_lang_translations": {
                                "ru": "Мяч упал с <w>подставки</w> до того, как он успел ударить.",
                                "pl": "Piłka spadła z <w>podstawki</w>, zanim zdążył ją uderzyć."
                            }
                        }
                    ],
                    "common_phrases": [
                        "golf tee",
                        "place on a tee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький колышек (обычно деревянный или пластиковый), на который ставится мяч для гольфа перед ударом.",
                        "pl": "Mały kołeczek (zazwyczaj drewniany lub plastikowy), na którym umieszcza się piłeczkę golfową przed uderzeniem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колышек",
                                "target_lang_sense_clarification": "для гольфа"
                            },
                            {
                                "target_lang_word": "подставка",
                                "target_lang_sense_clarification": "для мяча"
                            },
                            {
                                "target_lang_word": "ти",
                                "target_lang_sense_clarification": "термин гольфа"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "tee",
                                "target_lang_sense_clarification": "termin golfowy"
                            },
                            {
                                "target_lang_word": "podstawka",
                                "target_lang_sense_clarification": "pod piłkę golfową"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f6075db-465e-31ae-bd17-ce778e03c118",
                    "sense_definition": "The designated flat area at the start of a golf hole from where the first shot is taken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "golf_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The players are waiting on the first <w>tee</w>.",
                            "target_lang_translations": {
                                "ru": "Игроки ждут на первой <w>площадке ти</w>.",
                                "pl": "Gracze czekają na pierwszym <w>polu startowym</w>."
                            }
                        },
                        {
                            "text": "From the <w>tee</w>, you can see the flag clearly.",
                            "target_lang_translations": {
                                "ru": "С <w>площадки ти</w> ясно виден флажок.",
                                "pl": "Z <w>pola startowego</w> wyraźnie widać flagę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the tee",
                        "tee box"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специально отведенная ровная площадка в начале лунки для гольфа, откуда производится первый удар.",
                        "pl": "Wyznaczony płaski obszar na początku dołka golfowego, z którego wykonuje się pierwsze uderzenie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "площадка ти",
                                "target_lang_sense_clarification": "зона старта"
                            },
                            {
                                "target_lang_word": "стартовая площадка",
                                "target_lang_sense_clarification": "в гольфе"
                            },
                            {
                                "target_lang_word": "ти",
                                "target_lang_sense_clarification": "профессиональный термин"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pole startowe",
                                "target_lang_sense_clarification": "w golfie"
                            },
                            {
                                "target_lang_word": "tee",
                                "target_lang_sense_clarification": "miejsce startu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bf39e22-3890-30ee-a30c-c89ef1b2b715",
                    "sense_definition": "An object, such as a pipe fitting or beam, that is shaped like the letter T.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plumber used a <w>tee</w> to connect the three pipes.",
                            "target_lang_translations": {
                                "ru": "Сантехник использовал <w>тройник</w>, чтобы соединить три трубы.",
                                "pl": "Hydraulik użył <w>trójnika</w>, aby połączyć trzy rury."
                            }
                        },
                        {
                            "text": "We need a structural <w>tee</w> to support this joint.",
                            "target_lang_translations": {
                                "ru": "Нам нужен конструкционный <w>тавр</w> для поддержки этого соединения.",
                                "pl": "Potrzebujemy konstrukcyjnego <w>teownika</w>, aby wzmocnić to połączenie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "copper tee",
                        "pipe tee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет, например, фитинг трубы или балка, имеющий форму буквы Т.",
                        "pl": "Przedmiot, na przykład złączka rurowa lub belka, mający kształt litery T."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тройник",
                                "target_lang_sense_clarification": "соединитель труб"
                            },
                            {
                                "target_lang_word": "тавр",
                                "target_lang_sense_clarification": "балка Т-образного сечения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "trójnik",
                                "target_lang_sense_clarification": "złączka hydrauliczna"
                            },
                            {
                                "target_lang_word": "teownik",
                                "target_lang_sense_clarification": "profil stalowy w kształcie litery T"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81c50e7b-f4ce-3fcc-9d6e-552cea4f42b7",
                    "sense_definition": "The name of the Latin-script letter T.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure to cross your <w>tees</w> and dot your i's.",
                            "target_lang_translations": {
                                "ru": "Не забудь перечеркнуть свои <w>ти</w> и поставить точки над i.",
                                "pl": "Upewnij się, że postawiłeś kropki nad i oraz poprawnie napisałeś <w>te</w>."
                            }
                        },
                        {
                            "text": "The word starts with a <w>tee</w>.",
                            "target_lang_translations": {
                                "ru": "Слово начинается с <w>ти</w>.",
                                "pl": "To słowo zaczyna się na <w>te</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cross the tees"
                    ],
                    "target_lang_definitions": {
                        "ru": "Название буквы T латинского алфавита.",
                        "pl": "Nazwa litery T w alfabecie łacińskim."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ти",
                                "target_lang_sense_clarification": "название английской буквы"
                            },
                            {
                                "target_lang_word": "тэ",
                                "target_lang_sense_clarification": "название русской буквы"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "te",
                                "target_lang_sense_clarification": "nazwa litery"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae177f03-8b5a-3792-9762-d2505b3b4df9",
                    "sense_definition": "To place a golf ball on a peg in preparation for hitting it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "golf_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bent down to <w>tee</w> his ball for the drive.",
                            "target_lang_translations": {
                                "ru": "Он наклонился, чтобы <w>установить на подставку</w> свой мяч для первого удара.",
                                "pl": "Schylił się, aby <w>umieścić piłkę na tee</w> przed uderzeniem."
                            }
                        },
                        {
                            "text": "After you <w>tee</w> the ball, check your stance.",
                            "target_lang_translations": {
                                "ru": "После того как вы <w>установите на подставку</w> мяч, проверьте свою стойку.",
                                "pl": "Gdy już <w>umieścisz piłkę na tee</w>, sprawdź swoją postawę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tee off",
                        "tee up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать мяч для гольфа на колышек для подготовки к удару.",
                        "pl": "Umieszczać piłeczkę golfową na kołeczku w celu przygotowania do uderzenia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устанавливать на подставку",
                                "target_lang_sense_clarification": "мяч для гольфа"
                            },
                            {
                                "target_lang_word": "ставить на ти",
                                "target_lang_sense_clarification": "гольф"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "umieszczać na tee",
                                "target_lang_sense_clarification": "w golfie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa40e747-1716-383f-8926-9fb147d50d3b",
                    "sense_definition": "To redirect output to multiple destinations, such as a file and a screen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>tee</w> the logs to save them while watching the process.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>дублировать</w> логи, чтобы сохранить их, наблюдая за процессом.",
                                "pl": "Możesz <w>kopiować strumień</w> logów, aby zapisać je podczas obserwacji procesu."
                            }
                        },
                        {
                            "text": "The script uses a command to <w>tee</w> the output.",
                            "target_lang_translations": {
                                "ru": "Скрипт использует команду, чтобы <w>разветвить</w> вывод.",
                                "pl": "Skrypt używa polecenia, aby <w>rozdzielić wyjście</w> danych."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перенаправлять вывод данных в несколько мест назначения, например, в файл и на экран одновременно.",
                        "pl": "Przekierowywać strumień danych do kilku miejsc jednocześnie, na przykład do pliku i na ekran."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дублировать",
                                "target_lang_sense_clarification": "вывод данных"
                            },
                            {
                                "target_lang_word": "разветвлять",
                                "target_lang_sense_clarification": "поток данных"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kopiować strumień",
                                "target_lang_sense_clarification": "w informatyce"
                            },
                            {
                                "target_lang_word": "rozdzielać wyjście",
                                "target_lang_sense_clarification": "w informatyce"
                            }
                        ]
                    }
                }
            ]
        },
