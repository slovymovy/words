                "senses": [
                    {
                        "sense_id": "f35fd374-7057-3749-882f-d242ce81d9b4",
                        "entry_id": "bbf7c38c-fc58-35e3-82a5-cb32e2d3c534",
                        "glosses": [
                            "aus Mais zubereiteter Brei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0dbe4b3-6ddc-4284-9458-aae71a36a0f5",
                                "sense_id": "f35fd374-7057-3749-882f-d242ce81d9b4",
                                "text": "„Andrews aß langsam; die Bohnen waren lauwarm und schmeckten selbst mit Salz eigentlich nach nichts; der Maisbrei war zerkocht und nur halb aufgewärmt.“"
                            },
                            {
                                "example_id": "94ee5341-fb3a-4f63-aa7c-7b041134fd22",
                                "sense_id": "f35fd374-7057-3749-882f-d242ce81d9b4",
                                "text": "„Sie brachte mir eine Schale voll Maisbrei – er war warm und widerlich süß, aber er machte satt.“"
                            },
                            {
                                "example_id": "a0d3a4f8-b367-412a-8bd5-a1893a6e1d9d",
                                "sense_id": "f35fd374-7057-3749-882f-d242ce81d9b4",
                                "text": "„Links saß ein junger pakistanischer Soldat am Tisch, auf dem er seinen Helm abgelegt hatte, und aß in aller Seelenruhe einen Teller Maisbrei.“"
                            },
                            {
                                "example_id": "65d1cb66-dfd9-4037-bcda-4d73546adc8d",
                                "sense_id": "f35fd374-7057-3749-882f-d242ce81d9b4",
                                "text": "„Oma Minnie stellte mir Maisbrei politisch zweifelhafter Herkunft hin - angemacht mit Butter, die offensichtlich jede Menge konjugierte Linolsäure enthielt -, und ich erzählte eine schräge Story über Tina Brown, bis irgendein Telefonverkäufer oder Meinungsumfrager den Apparat nebenan klingeln ließ.“"
                            },
                            {
                                "example_id": "127d19d1-9769-4c8b-a02e-2d4d0aaeef58",
                                "sense_id": "f35fd374-7057-3749-882f-d242ce81d9b4",
                                "text": "„Wir hatten noch nichts gegessen, futterten Maisbrei und Kutteln mit Kohl und sahen uns dabei die Videoaufzeichnungen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
