                                "target_senses": [
                                    {
                                        "sense_id": "518378dc-9c63-38b1-a72c-1bd18a2b9347",
                                        "entry_id": "9b338d02-ae53-36fb-8801-2d22a40251a3",
                                        "glosses": [
                                            "Alternative form of swingeing."
                                        ],
                                        "tags": [
