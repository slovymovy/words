                    {
                        "sense_id": "fbd0726e-4408-3718-9b11-1dd1af52e1a9",
                        "entry_id": "051b6b3e-50fc-32b6-8b53-6f50f6a5b987",
                        "glosses": [
                            "Anteil der Babys im Alter unter einem Jahr, die sterben"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "aca34799-dbcc-4662-baae-7142150f885a",
                                "sense_id": "fbd0726e-4408-3718-9b11-1dd1af52e1a9",
                                "text": "In Slums […] ist die Säuglingssterblichkeit besonders hoch."
                            },
                            {
                                "example_id": "593390b5-f5ea-42d8-88f3-99de8fe4c68e",
                                "sense_id": "fbd0726e-4408-3718-9b11-1dd1af52e1a9",
                                "text": "[…] Die Säuglingssterblichkeit von schwarzen Babys ist in den USA doppelt so hoch wie die von weißen Babys."
                            },
                            {
                                "example_id": "3dc53de5-fae8-4d27-89dc-237e2bd083e8",
                                "sense_id": "fbd0726e-4408-3718-9b11-1dd1af52e1a9",
                                "text": "In den vergangenen 20 Jahren konnte die Säuglingssterblichkeit [in Ruanda] auf ein Sechstel reduziert werden."
                            },
                            {
                                "example_id": "e959fa09-9ffe-4523-93b1-ba7645bb899a",
                                "sense_id": "fbd0726e-4408-3718-9b11-1dd1af52e1a9",
                                "text": "In mehreren europäischen Ländern trat nach Tschernobyl eine erhöhte Säuglingssterblichkeit in einer Größenordnung von 5.000 Säuglingen auf."
                            },
                            {
                                "example_id": "10d28d8d-d0d8-4169-9733-b48400d7ffcb",
                                "sense_id": "fbd0726e-4408-3718-9b11-1dd1af52e1a9",
                                "text": "Allein in Indien erkranken jedes Jahr über eine Million Menschen an diesem Fieber [Dengue], das auch die Säuglingssterblichkeit in die Höhe treibt."
                            }
                        ],
                        "sense_index_json": "\"1\""
