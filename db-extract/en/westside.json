                        "entry_id": "69a6d1ca-247c-31fd-8e3e-5ceb872f4231",
                        "glosses": [
                            "The western side of a building, street, area etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e7f7cdd-8bce-4e34-b029-94f0e2ed7895",
                                "sense_id": "c22ba4a4-8a63-3a24-b164-1df2a03263fd",
                                "text": "This EIS describes and analyzes the environmental impacts of implementing an updated 10-year timber management plan for the 244,059 acres of public land in the Columbia and Alsea-Rickreall Sustained Yield Units on the westside of the Salem District, Oregon."
                            },
                            {
                                "example_id": "7104b4c5-17c8-4ea3-a05f-f9c8b4e4e992",
                                "sense_id": "c22ba4a4-8a63-3a24-b164-1df2a03263fd",
                                "text": "At Olynthos, all habitation-blocks are oriented east-west so that the houses share partition walls on the east- and westsides."
                            },
                            {
                                "example_id": "89b0fade-edb5-4f5a-86ce-b47dd79833d1",
                                "sense_id": "c22ba4a4-8a63-3a24-b164-1df2a03263fd",
                                "text": "We also joined with another Senior CYO group from the westside, and that just made us even bigger."
                            }
                        ]
                    }
                ],
