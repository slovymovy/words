                "senses": [
                    {
                        "sense_id": "bd0a6797-e004-332a-afb7-3f3112064a51",
                        "entry_id": "a25ec48a-d386-3e6c-aee2-61e748519bc4",
                        "glosses": [
                            "устар. не имеющий таланта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd0f10ba-e21b-43dc-8141-8cd420f88785",
                                "sense_id": "bd0a6797-e004-332a-afb7-3f3112064a51",
                                "text": "Если бы г. Бутков был устарелый, да притом ещё бесталантный писатель, то мы не сочли бы нужным распространяться о новом его произведении."
                            }
                        ]
                    }
