                ],
                "senses": [
                    {
                        "sense_id": "b9707d93-ada3-3efb-8522-7a87eff6bbc6",
                        "entry_id": "120987e2-c7e8-36a0-886e-912ce63c437d",
                        "glosses": [
                            "te emotionele of plechtige manier van spreken of schrijven; vol bombast"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "3d09f258-5664-4c40-858d-5abedb2abd05",
                                "sense_id": "b9707d93-ada3-3efb-8522-7a87eff6bbc6",
                                "text": "'We gaan Nederland veranderen' was een uitspraak die opviel: ik kreeg er veel positieve reacties op, maar ook het verwijt veel te hoogdravend te zijn. Een politicus die denkt Nederland te kunnen veranderen - is dat niet een beetje te veel van het goede? Nee, dat is het niet; het is precies wat ik ambieer."
                            },
                            {
                                "example_id": "f360ea97-6657-41c8-bd94-c9e7b1e0da42",
                                "sense_id": "b9707d93-ada3-3efb-8522-7a87eff6bbc6",
                                "text": "Ik ben het helemaal met u eens, antwoordde Nikolaj met een hoogrode kleur, terwijl hij zijn bord ronddraaide en zijn glazen met een vastbesloten en onverschrokken gezicht verplaatste, alsof hij zich op dat moment in groot gevaar bevond, ik ben ervan overtuigd dat wij Russen moeten sterven of overwinnen, zei hij, en zodra hij die woorden had uitgesproken voelde hij, evenals de anderen, dat ze te hartstochtelijk en te hoogdravend waren voor de gelegenheid, en daarom niet op hun plaats."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38aa5990-8344-4cfa-be9c-0084aff4612f",
                        "source_entry_id": "120987e2-c7e8-36a0-886e-912ce63c437d",
                        "source_sense_id": "b9707d93-ada3-3efb-8522-7a87eff6bbc6",
                        "source_sense_description": "te emotionele of plechtige manier van spreken of schrijven; vol bombast",
                        "target_lang_word": "hochtrabend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hochtrabend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64da9fd4-9e4b-335f-a729-1406a6b7ba61",
                                        "entry_id": "970f00c1-0c39-336f-a20e-d5cdb92b6145",
                                        "glosses": [
                                            "übertrieben vornehm und dabei ohne Inhalt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbd1f4ff-e848-489e-ba7d-be6b34c77868",
                                                "sense_id": "64da9fd4-9e4b-335f-a729-1406a6b7ba61",
                                                "text": "Dieses hochtrabende Gerede hätte er sich sparen können."
                                            },
                                            {
                                                "example_id": "3b48daf7-c3f2-4eb2-b624-ac14321b0003",
                                                "sense_id": "64da9fd4-9e4b-335f-a729-1406a6b7ba61",
                                                "text": "„Unter solchen Umständen können auch die hochtrabendsten Redensarten von Höhe und Tiefe der Kunst, von den großen Aufgaben der Gegenwart und den strengsten Anforderungen an ihre Leistungen kein sonderliches Vertrauen erwecken.“"
                                            },
                                            {
                                                "example_id": "edfdfec4-a862-4529-8d1a-493a3c41d7cf",
                                                "sense_id": "64da9fd4-9e4b-335f-a729-1406a6b7ba61",
                                                "text": "„Die Affichen sind mit hochtrabenden Namen unterfertigt, »Hochschule für geheime Wissenschaften«, »Gelehrte Gesellschaft für okkultes Wissen« und so weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e46379b-73fe-495e-830c-c4e6ef7ed252",
                        "source_entry_id": "120987e2-c7e8-36a0-886e-912ce63c437d",
                        "source_sense_id": "b9707d93-ada3-3efb-8522-7a87eff6bbc6",
                        "source_sense_description": "te emotionele of plechtige manier van spreken of schrijven; vol bombast",
                        "target_lang_word": "pompous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pompous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5def3dd-5e7d-3d22-9220-525fa7f71389",
                                        "entry_id": "3e27a959-1ff3-36d6-be3d-38b207caa7f1",
                                        "glosses": [
                                            "Affectedly grand, solemn or self-important."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bd0f48e-cd65-43e5-9342-231f9447cd4e",
                                                "sense_id": "f5def3dd-5e7d-3d22-9220-525fa7f71389",
                                                "text": "But man is a Noble Animal, splendid in ashes, and pompous in the grave, solemnizing Nativities and Deaths with equal lustre, nor omitting Ceremonies of bravery, in the infamy of his nature."
                                            },
                                            {
                                                "example_id": "c39de055-fc32-41e9-8cd7-fa4d30074837",
                                                "sense_id": "f5def3dd-5e7d-3d22-9220-525fa7f71389",
                                                "text": "Not that the parting speech caused Amelia to philosophise, or that it armed her in any way with a calmness, the result of argument; but it was intolerably dull, pompous, and tedious; and having the fear of her schoolmistress greatly before her eyes, Miss Samuel did not venture, in her presence, to give way to any ebullitions of private grief."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
