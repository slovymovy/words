                                                "example_id": "2cc7d2e6-d1f7-4640-807c-6c7552406f29",
                                                "sense_id": "76ac550b-daa1-3cba-a681-46fd0933332b",
                                                "text": "We know your thoughts of us, that laymen are lag souls, and rubbish of remaining clay."
                                            }
                                        ]
