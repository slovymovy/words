                        "entry_id": "64a83a8d-ce68-3616-baba-0dd504ee561e",
                        "glosses": [
                            "auf sinnkritische Weise analytisch aufgliedernd und das mit dem Bestreben, Ausgegrenztes sichtbar zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1c91ba6-dd06-4ccb-a030-f4897eea920e",
                                "sense_id": "a7518548-f285-3cec-beca-9c8567fa0294",
                                "text": "„Denn in diesem dekonstruktiven Denken liegt die Chance verborgen, Erstarrung dauerhaft zu vermeiden.“"
                            },
                            {
                                "example_id": "4a54c438-5bc1-4fe2-bf6a-ecb66a536f00",
                                "sense_id": "a7518548-f285-3cec-beca-9c8567fa0294",
                                "text": "„Wir haben das dekonstruktive Vorgehen Derridas bereits in seiner Anwendung auf die Texte Husserls verfolgt.“"
                            }
