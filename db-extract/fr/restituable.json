                            {
                                "example_id": "55a06fdf-b494-465b-b68a-0ef4776100ac",
                                "sense_id": "12bfeac6-3e12-3bdc-afd3-2df1d8a5cfc9",
                                "text": "Dans le contrat de 1650, la future a reçu « pour frais nuptiaux non restituables, une couverte de layne, deux linceuls bons et suffisants, […]. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "a0542695-1759-39bf-95ec-637240290efa",
                        "entry_id": "0194fd1c-f271-3799-8608-4b619c1b15ac",
                        "glosses": [
                            "Qui peut être rétabli, remis en son premier état."
