                ],
                "senses": [
                    {
                        "sense_id": "42a041ba-e8e3-3cad-940d-abcacf2ee8a0",
                        "entry_id": "ef86ad66-096b-3b52-b236-65757f7f1892",
                        "glosses": [
                            "iemand die mensen (en dan nog vooral vrouwen) weet te bekoren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afba1b54-a75c-48b1-a772-a10846342abc",
                                "sense_id": "42a041ba-e8e3-3cad-940d-abcacf2ee8a0",
                                "text": "James Bond is een echter charmeur."
                            },
                            {
                                "example_id": "84f72053-01d9-444b-93d6-807c8df9dcd8",
                                "sense_id": "42a041ba-e8e3-3cad-940d-abcacf2ee8a0",
                                "text": "Wij waren een cocktail van uitersten (in willekeurige volgorde): rustig, uitgesproken en luidruchtig. Drugs, alcohol en water. Wild, voorzichtig en nieuwsgierig. Levend in het verleden in het heden en in de toekomst. De entertainer, de charmeur en de verleider. Kinderachtig, zorgzaam en met een luisterend oor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2f362ee-0a88-42f6-9b98-6fa206d3eedd",
                        "source_entry_id": "ef86ad66-096b-3b52-b236-65757f7f1892",
                        "source_sense_id": "42a041ba-e8e3-3cad-940d-abcacf2ee8a0",
                        "source_sense_description": "iemand die vrouwen weet te bekoren",
                        "target_lang_word": "Charmeur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Charmeur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d4bc2ed-9592-3e15-ab27-2ca3a2ad5a2c",
                                        "entry_id": "5d98b1fa-a515-3724-a940-2846cacbb851",
                                        "glosses": [
                                            "Mann, der durch gute soziale und kommunikative Fähigkeiten anderen Menschen geschickt Komplimente macht und dabei Sympathie für seine eigene Person oder eine Sache erzeugt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40d0de0a-0071-4af1-9013-c519316373e1",
                                                "sense_id": "6d4bc2ed-9592-3e15-ab27-2ca3a2ad5a2c",
                                                "text": "Er war ein rechter Charmeur; viele der anwesenden jungen Damen waren seinem Charme erlegen."
                                            },
                                            {
                                                "example_id": "8ad117a3-e383-4c20-b8bc-27ab562ad4c0",
                                                "sense_id": "6d4bc2ed-9592-3e15-ab27-2ca3a2ad5a2c",
                                                "text": "„Das wiederum missverstand der pummelige Charmeur und nahm es als meine Zustimmung, dass die Schwester ein Prachtexemplar ihrer Zunft war.“"
                                            },
                                            {
                                                "example_id": "79dbd83c-e396-45e3-9eb7-457b5264663e",
                                                "sense_id": "6d4bc2ed-9592-3e15-ab27-2ca3a2ad5a2c",
                                                "text": "„Black lachte und war plötzlich wieder der etwas gefährliche und nicht ganz vertrauenerweckende Charmeur von früher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a947c94-b627-40b6-b859-20a057a8c63a",
                        "source_entry_id": "ef86ad66-096b-3b52-b236-65757f7f1892",
                        "source_sense_id": "42a041ba-e8e3-3cad-940d-abcacf2ee8a0",
                        "source_sense_description": "iemand die vrouwen weet te bekoren",
                        "target_lang_word": "charmer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charmer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81a49e84-8ae4-3986-a433-8cf2fd193e8c",
                                        "entry_id": "150c6dfd-c6d3-3da0-9f4d-1ea19768a6f7",
                                        "glosses": [
                                            "A charming person; one who charms or seduces; a smoothie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d4734fd-6ff4-491a-abcb-b52e1b14e6a6",
                                                "sense_id": "81a49e84-8ae4-3986-a433-8cf2fd193e8c",
                                                "text": "And \"Juno\" is the kind of movie all indie comedies wish they could be: light and lovable, perhaps a bit too pleased with the cleverness of its dialogue, but a small charmer nonetheless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ddb0008-4060-3a7b-84da-d780ec02d2a8",
                                        "entry_id": "150c6dfd-c6d3-3da0-9f4d-1ea19768a6f7",
                                        "glosses": [
                                            "An enchanter or magician."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94e8947a-68be-3a74-9e53-fec9141316bb",
                                        "entry_id": "150c6dfd-c6d3-3da0-9f4d-1ea19768a6f7",
                                        "glosses": [
                                            "A rude or unpleasant person."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cc297ca-5c09-48ab-9911-bb44d9109df9",
                                                "sense_id": "94e8947a-68be-3a74-9e53-fec9141316bb",
                                                "text": "What a charmer, Karl Lagerfeld"
                                            }
                                        ]
                                    }
                                ]
                            }
