        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b3ccfa2-5933-3b88-a7ec-fd6105871876",
                    "sense_definition": "A board game for two players, each beginning with sixteen pieces moving according to fixed rules across a board with the objective to checkmate the opposing king.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather taught me how to play <w>chess</w> when I was a child.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка научил меня играть в <w>шахматы</w>, когда я был ребёнком.",
                                "zh": "我小时候，爷爷教我下<w>国际象棋</w>。"
                            }
                        },
                        {
                            "text": "She is practicing for the upcoming <w>chess</w> tournament.",
                            "target_lang_translations": {
                                "ru": "Она готовится к предстоящему турниру по <w>шахматам</w>.",
                                "zh": "她正在为即将到来的<w>国际象棋</w>锦标赛做准备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "international chess",
                        "Western chess"
                    ],
                    "common_phrases": [
                        "play chess",
                        "game of chess",
                        "chess piece",
                        "chess board",
                        "chess master"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настольная логическая игра для двух игроков, использующая специальные фигуры на доске из 64 клеток",
                        "zh": "一种双人对弈的棋类游戏，双方各执十六枚棋子，在棋盘上按照固定规则移动，目标是将对方的王将死。"
                    },
                    "translations": {
                        "ru": [
                            {
