                                        "sense_id": "e4fff24d-aefe-305b-8ab0-0dd552c1845e",
                                        "entry_id": "1d2161e6-e838-3c3c-9f17-a59672c570d6",
                                        "glosses": [
                                            "As a concrete noun.",
                                            "A fee charged to cover the costs of packaging."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36ff4277-8960-3327-a813-21fb27cdc72e",
                                        "entry_id": "1d2161e6-e838-3c3c-9f17-a59672c570d6",
                                        "glosses": [
