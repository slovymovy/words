                                                "sense_id": "75976849-8ef8-3c6a-9f09-6d000384e48a",
                                                "text": "His conduct was not befitting an officer of his station."
                                            },
                                            {
                                                "example_id": "7827e765-33e7-4a21-9cca-ba559aab7da3",
                                                "sense_id": "75976849-8ef8-3c6a-9f09-6d000384e48a",
                                                "text": "Clarke's side roared back with courage and belief befitting a team who had held their nerve in two shootouts to get here."
                                            }
