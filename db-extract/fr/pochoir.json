                "senses": [
                    {
                        "sense_id": "1b6f55d3-82a2-3879-8f5f-bb5b2564c2e3",
                        "entry_id": "3d51fb9c-d394-359a-a484-f4752aaf16f4",
                        "glosses": [
                            "Feuille découpée de façon que la découpure forme un dessin que l’on reproduit sur la surface d’un objet, en passant sur cette feuille une brosse chargée de couleur."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "d2b5cefe-48d6-4d26-9489-241f4b28833f",
                                "sense_id": "1b6f55d3-82a2-3879-8f5f-bb5b2564c2e3",
                                "text": "Un régiment d'ouvriers et pas mal de jeunes apprentis colorent les images au pochoir. Armés d'un formidable pinceau, de forme spéciale, ils trempent d'un mouvement rythmé dans un pot de couleur pour le passer sur le patron, […]."
                            },
                            {
                                "example_id": "80f7648d-11f8-4034-b7bb-5a43babcf0af",
                                "sense_id": "1b6f55d3-82a2-3879-8f5f-bb5b2564c2e3",
                                "text": "Je sais aujourd’hui que c’étaient des albums d’images d’Épinal coloriées au pochoir, ils dataient au moins de Napoléon III, on les regardait en mangeant notre quatre-heures qu’on avait apporté dans notre petit panier à rabattants, moi c’était toujours un petit pain au lait avec une barre de chocolat à la crème, toujours."
                            }
                        ]
                    },
                    {
                        "sense_id": "b705269b-f48e-3382-84a8-dd4501d51429",
                        "entry_id": "3d51fb9c-d394-359a-a484-f4752aaf16f4",
                        "glosses": [
                            "Œuvre réalisée avec cette technique."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "749bf72b-ffc8-41dd-906f-972086c061ea",
                        "source_entry_id": "3d51fb9c-d394-359a-a484-f4752aaf16f4",
                        "target_lang_word": "Schablone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schablone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f76aedc-d96b-3d12-97f3-a1142ff27b0f",
                                        "entry_id": "4837b445-7f6d-33c4-a3d5-f6ce076ab7f1",
                                        "glosses": [
                                            "(aus festem Material bestehende) Formvorlage, die man verwendet, um bei Reproduktionen ein immer gleiches Ergebnis zu erzielen oder um zu überprüfen, ob ein vorliegendes Ergebnis der Vorgabe entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58b25ad4-5e1f-41af-a777-7a2e68d5bd82",
                                                "sense_id": "3f76aedc-d96b-3d12-97f3-a1142ff27b0f",
                                                "text": "Vor der Einführung der Computer gestützten Vektorgrafik wurde viel mit Schablonen gezeichnet."
                                            },
                                            {
                                                "example_id": "32c3081f-fd3e-40d8-be58-811f51249b6e",
                                                "sense_id": "3f76aedc-d96b-3d12-97f3-a1142ff27b0f",
                                                "text": "Man legt die Schablone auf den Bogen mit den angekreuzten Antworten und sieht sofort, welche Fragen richtig beantwortet wurden."
                                            },
                                            {
                                                "example_id": "03bbb2d0-af3c-47b3-9efc-dd2f6c2e16b2",
                                                "sense_id": "3f76aedc-d96b-3d12-97f3-a1142ff27b0f",
                                                "text": "Um beim Sprayen der Garagenwand immer die gleiche Herzform zu erhalten, basteln wir uns erst einmal eine Schablone aus Pappe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d3b9f12-5421-4445-8fee-bcc0c4e35821",
