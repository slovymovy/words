                                        ],
                                        "examples": [
                                            {
                                                "example_id": "643735c3-658e-4237-b2be-adc37374f581",
                                                "sense_id": "282f162e-3781-3385-ba1d-06a157c14722",
                                                "text": "Wat is belangrijk voor een kweker van papegaaien."
                                            },
                                            {
                                                "example_id": "4fb17451-948c-4641-bdbb-cf116f1d1757",
                                                "sense_id": "282f162e-3781-3385-ba1d-06a157c14722",
                                                "text": "De deelnemers krijgen de gladiolen traditiegetrouw van het publiek aangeboden op de laatste dag van het wandelevenement. Met hun armen vol bloemen lopen ze de stad in over de Sint Annastraat, die dan voor even Via Gladiola heet. Dit jaar dus niet. \"Dat is toch wel even balen, om het zo maar te zeggen\", zegt kweker Theo Theunissen tegen Omroep Gelderland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abe6ede4-d7cc-3f95-a855-28ab9d210423",
                                        "entry_id": "bf0281b9-0959-3607-a669-e7d6e7b5bf51",
                                        "glosses": [
                                            "een toestel dat het kweken van iets vergemakkelijkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a8c7b5-3f8e-486e-8e2c-65f9f7ae0974",
                                                "sense_id": "abe6ede4-d7cc-3f95-a855-28ab9d210423",
                                                "text": "Deze kweker is ideaal om thuis zelf grote hoeveelheden tarwegras te kweken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
