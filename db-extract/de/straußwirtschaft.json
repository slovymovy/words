                "senses": [
                    {
                        "sense_id": "29e70809-d37b-3596-9baa-03a282f4663e",
                        "entry_id": "98f7ce94-eed3-3633-994c-f97a582edf87",
                        "glosses": [
                            "saisonal geöffnete Wirtschaft für den Weinausschank von Winzern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d1349c-54b9-427e-8d1f-a1f6f9f47c05",
                                "sense_id": "29e70809-d37b-3596-9baa-03a282f4663e",
                                "text": "„Die Erlaubnispflichtigkeit von Straußwirtschaften richtet sich nach Landesrecht.“"
                            },
                            {
                                "example_id": "dae5e7f0-1aa9-4ecf-86dd-adbc608149c7",
                                "sense_id": "29e70809-d37b-3596-9baa-03a282f4663e",
                                "text": "„Die Winzerbetriebe an der Mittelmosel bieten darüber hinaus Winzersekt, Wein- und Obstbrände und Liköre an. Sie vermarkten ihre Produkte weitgehend, wie in allen Weinbaugebieten, selbst und präsentieren sie in Wein- oder Probierstuben, Straußwirtschaften und während der warmen Jahreszeit auf diversen Hoffesten.“"
                            },
                            {
                                "example_id": "132db25c-a1e0-4a88-9f01-632a0fb439c9",
                                "sense_id": "29e70809-d37b-3596-9baa-03a282f4663e",
                                "text": "„Überall gibt es die Höfe der Winzer und Straußwirtschaften, die zur Einkehr einladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
