                "senses": [
                    {
                        "sense_id": "30ac1e96-fddd-3ad9-802e-fa09c1e388b2",
                        "entry_id": "7f4d8e76-e234-39af-a80e-2cce0cad8bef",
                        "glosses": [
                            "Fabricant ou marchand de dinanderie, les objets en cuivre ou laiton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4622d671-1e8d-4f2b-9e2c-eb32577d722a",
                                "sense_id": "30ac1e96-fddd-3ad9-802e-fa09c1e388b2",
                                "text": "Tandis qu’une partie de la dinanderie s’accroche à une conception de la profession vacillante, l’autre s’engage donc dans une tentative de réforme du métier. Les dinandiers empruntant la voie de la rénovation entreprennent de fabriquer des articles pour la consommation de thé copiés des modèles fabriqués en Europe."
                            },
                            {
                                "example_id": "4c1ccb16-ad87-4250-a57a-c9f7751ab318",
                                "sense_id": "30ac1e96-fddd-3ad9-802e-fa09c1e388b2",
                                "text": "Il n’existe aucune formation initiale qui permette de préparer à un emploi en dinanderie, et les dinandiers actuels sont tous issus de formations parallèles en chaudronnerie, en orfèvrerie ou en écoles d’arts appliqués proposant des sections métal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "235acf29-ca2f-4b35-a91a-8366eb09d36e",
                        "source_entry_id": "7f4d8e76-e234-39af-a80e-2cce0cad8bef",
                        "source_sense_id": "30ac1e96-fddd-3ad9-802e-fa09c1e388b2",
                        "target_lang_word": "Kupferschmied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kupferschmied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcc521ce-c71d-3878-8337-12dcb71a18ad",
                                        "entry_id": "929f0717-a7ea-3e16-9682-b3fd1b2fdf1d",
                                        "glosses": [
                                            "Handwerker, welcher Kupfer bearbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "827fbd03-c5b4-436a-a964-b8e70e38a710",
                                                "sense_id": "bcc521ce-c71d-3878-8337-12dcb71a18ad",
                                                "text": "Der Kupferschmied fertigt große kupferne Kessel."
                                            },
                                            {
                                                "example_id": "80e5096b-0e2b-4c23-84c4-4b45b4e51ed3",
                                                "sense_id": "bcc521ce-c71d-3878-8337-12dcb71a18ad",
                                                "text": "„Als Glaser nach dem Zweiten Weltkrieg Dinandier wurde, war der Beruf fast ausgestorben. Ein Beruf, der drei Handwerke vereinigt: Kupferschmied, Gürtler, Silberschmied.“"
                                            },
                                            {
                                                "example_id": "6da785a2-f1dd-43e9-840f-3d008d445b04",
                                                "sense_id": "bcc521ce-c71d-3878-8337-12dcb71a18ad",
                                                "text": "„So entstand in Sistan eine erste autochthone islamische Reichsgründung in dieser Region, das Reich der Saffariden, das der Sohn eines Kupferschmieds, Yaʿqub Laithus Saffar, 867 errichtete und das bis Anfang des 10. Jahrhunderts Bestand hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
