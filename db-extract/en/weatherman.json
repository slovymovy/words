                "entry_id": "6f22183a-d4b5-39d1-a596-ae4c1f9fb3b8",
                "word": "weatherman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cc7f03ae-b6aa-4f2f-86ed-131bd3941c55",
                        "entry_id": "6f22183a-d4b5-39d1-a596-ae4c1f9fb3b8",
