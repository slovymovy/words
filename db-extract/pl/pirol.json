                                        "glosses": [
                                            "Any of a class of aromatic heterocyclic compounds containing a ring of four carbon atoms and a nitrogen atom; especially the simplest one, C₄H₅N."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeebaaa5-79e4-44c9-83ef-60127eefa0e1",
                                                "sense_id": "96ba3d5e-1ae9-3a11-90e1-7d96aa8cf6f7",
                                                "text": "The way the red crystals absorbed light suggested that the molecule might contain a porphyrin-like structure, a flat ring made up of four smaller rings called pyrroles […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
