                "translations": [
                    {
                        "translation_id": "ebf6bd0b-5783-4d41-bb63-2a609b202b18",
                        "source_entry_id": "d77a75c5-f1d8-32bd-ac90-3d0f08c71873",
                        "source_sense_id": "aff30bb1-3bc5-30be-8ff0-7803a967a920",
                        "target_lang_word": "astronomy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astronomy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c0151bc-2eaa-37bc-b95b-923f55bd6af2",
                                        "entry_id": "2fab23ac-bf87-3c6b-8471-9ddd798bdbcb",
                                        "glosses": [
                                            "The study of the physical universe beyond the Earth's atmosphere, including the process of mapping locations and properties of the matter and radiation in the universe."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e760d8d-4582-419c-97ab-60c643429b8e",
                                                "sense_id": "9c0151bc-2eaa-37bc-b95b-923f55bd6af2",
                                                "text": "The fact is, dark energy is the biggest mystery in science. It has driven a huge amount of research in the past decade, and was a key driver in last year’s “New Worlds, New Horizons” report from the National Academies of Science, which prioritized future astronomy and astrophysics projects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "866a23c6-af35-314f-9309-4a5181735f25",
                                        "entry_id": "2fab23ac-bf87-3c6b-8471-9ddd798bdbcb",
                                        "glosses": [
                                            "Astrology."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9094d32e-df0c-4621-b4da-04d5a5e2c423",
                                                "sense_id": "866a23c6-af35-314f-9309-4a5181735f25",
                                                "text": "Not from the stars do I my judgment pluck;\nAnd yet methinks I have astronomy […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f53d486-ad59-4d35-be86-ea7ad896f8dd",
                        "source_entry_id": "d77a75c5-f1d8-32bd-ac90-3d0f08c71873",
                        "source_sense_id": "aff30bb1-3bc5-30be-8ff0-7803a967a920",
                        "target_lang_word": "astronomie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astronomie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1916e3cb-9483-322f-934f-40d7a6ad4a01",
                                        "entry_id": "fdb65752-a071-37b6-a448-3e80a1e64901",
                                        "glosses": [
                                            "Science ayant pour objet l'observation et l’étude des corps célestes dans leur position, leur mouvement et leur constitution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea4771a8-e8e8-4163-afe7-30c8e4167851",
                                                "sense_id": "1916e3cb-9483-322f-934f-40d7a6ad4a01",
                                                "text": "Parce que l’astronomie parvenait à calculer les tables de la lune, on a cru que le but de toute science était de prévoir avec exactitude l’avenir ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a72a86e-87f7-4f4f-b992-a37d4cedb0f0",
                        "source_entry_id": "d77a75c5-f1d8-32bd-ac90-3d0f08c71873",
                        "source_sense_id": "aff30bb1-3bc5-30be-8ff0-7803a967a920",
                        "target_lang_word": "astronomía",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astronomía",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d0b7cb56-ebd5-39ee-82cc-e70c345d9bbb",
                                        "entry_id": "93846845-6f1a-345d-affb-b9400620606c",
                                        "glosses": [
                                            "Ciencia que estudia el universo físico más allá de la atmósfera terrestre, y particularmente los procesos, ubicación y propiedades de las estrellas y planetas, así como la materia y la energía en el universo."
                                        ],
                                        "tags": [
                                            "disciplinas"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85f3a83c-6dfc-4bb7-8de1-d30b8dc7c48b",
                        "source_entry_id": "d77a75c5-f1d8-32bd-ac90-3d0f08c71873",
                        "source_sense_id": "aff30bb1-3bc5-30be-8ff0-7803a967a920",
                        "target_lang_word": "Astronomie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Astronomie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                        "entry_id": "8e7c5364-a331-33b3-b3d8-f07fe89473ff",
                                        "glosses": [
                                            "Sternkunde, Himmelskunde als exakte Naturwissenschaft"
                                        ],
                                        "tags": [
                                            "Naturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea5706cb-c14c-49c7-bed2-0a758ce1d593",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "Mit der Astronomie sehr eng verbunden ist die Physik."
                                            },
                                            {
                                                "example_id": "3b440b53-ebc0-45f9-8efc-c2abbcce4dba",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "„Mystische Anschauung der Astrologie und exakte Wissenschaft der Astronomie lassen sich zwar formell trennen, sie bilden jedoch in der Geistesgeschichte der Menschheit seit jeher eine eigentümliche Verquickung, die auch heutzutage noch zu den seltsamsten Ergebnissen führt.“"
                                            },
                                            {
                                                "example_id": "2ae5f1fe-7610-4dec-9208-1a7e49e34ca3",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "„Monsieur sagte recht verständig, die Astrologie sei als Wissenschaft auf jeden Fall sehr anrüchig, wenn nicht falsch; er habe sich einige Zeit damit beschäftigt, habe es aber schließlich aufgegeben und sich mit den unbezweifelbaren Wahrheiten begnügt, die die Astronomie ihn lehre.“"
                                            },
                                            {
                                                "example_id": "7cd86d60-cfd0-4d67-ba2e-f24aa8a3a35b",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "„Im frühen 16. Jahrhundert gehörten Mineralogie, Alchemie, Astrologie und Astronomie zusammen.“"
                                            },
                                            {
                                                "example_id": "94f005d8-8c67-4362-b073-f38c078ce81b",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "„Autor und Autorinnen, zwei Frauen und ein Mann, alle mit Professuren in Astronomie ausgestattet, behaupten mit unangenehm überzeugenden Argumenten, dass die Menschheit von Beginn an in falschen Vorstellungen von der Welt befangen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b1ffe98a-20d8-39cb-b412-e21d4ed1f771",
                                        "entry_id": "8e7c5364-a331-33b3-b3d8-f07fe89473ff",
                                        "glosses": [
                                            "ein Unterrichtsfach"
                                        ],
                                        "tags": [
                                            "Schulwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81df49a4-9e35-4604-8a0f-1cdec2f9fe4b",
                                                "sense_id": "b1ffe98a-20d8-39cb-b412-e21d4ed1f771",
                                                "text": "Leider wird nur an sehr wenigen Schulen Astronomie unterrichtet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de2d817a-08c5-4722-9b87-6b7b75eb4bbd",
                        "source_entry_id": "d77a75c5-f1d8-32bd-ac90-3d0f08c71873",
                        "source_sense_id": "aff30bb1-3bc5-30be-8ff0-7803a967a920",
                        "target_lang_word": "астрономия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "астрономия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9e56a3f3-eb0b-3563-a8f1-25968b24cb09",
                                        "entry_id": "6db4e5cb-ede4-39a3-916d-2a7a0e0c47d7",
                                        "glosses": [
                                            "наука о расположении, строении, свойствах, происхождении и развитии небесных тел и их систем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76223014-8fe5-46cd-9891-9c2633855945",
                                                "sense_id": "9e56a3f3-eb0b-3563-a8f1-25968b24cb09",
                                                "text": "Некоторые из них водили за руки сынка или дочку, по временам останавливались и, указывая возлюбленным детищам на небо, преподавали им уроки астрономии, ограничивавшиеся по большей части тем, что этот, дескать, душенька, шар, который вон-вон там далеко на ниточке у бога висит, называется солнцем, и что есть на земле люди, не то мартинисты, не то коммунисты (преглупейший, душенька, народ, и за счастье, умница, почитай, что мы не в той стороне, а в нашей любезной матушке-России родились), которые солнцу молебны служат и обедни поют…"
                                            },
                                            {
                                                "example_id": "87ee1fc5-ee91-44d3-b9a3-815a646202ab",
                                                "sense_id": "9e56a3f3-eb0b-3563-a8f1-25968b24cb09",
                                                "text": "Найман и Бродский шли по Ленинграду. Дело было ночью. - Интересно, где Южный Крест? - спросил вдруг Бродский. (Как известно, Южный Крест находится в соответствующем полушарии.) Найман сказал: - Иосиф! Откройте словарь Брокгауза и Ефрона. Найдите там букву \"А\". Поищите слово \"Астрономия\". Бродский ответил: - Вы тоже откройте словарь на букву \"А\". И поищите там слово \"Астроумие\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd39384f-06b7-43f5-8028-5244a0875c85",
                        "source_entry_id": "d77a75c5-f1d8-32bd-ac90-3d0f08c71873",
                        "source_sense_id": "aff30bb1-3bc5-30be-8ff0-7803a967a920",
