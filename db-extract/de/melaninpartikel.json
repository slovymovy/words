                "senses": [
                    {
                        "sense_id": "e7c003e9-9b6e-3f50-bbd9-57ceb37a3236",
                        "entry_id": "de75e45b-0707-3df8-b02b-62f367b7a0b7",
                        "glosses": [
                            "einzelne Pigmente Melanin"
                        ],
                        "tags": [
                            "im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "276c44b2-94b9-46e5-a836-5c53bd8018e4",
                                "sense_id": "e7c003e9-9b6e-3f50-bbd9-57ceb37a3236",
                                "text": "„Zusätzlich finden sich in den Papillenspitzen freie Melaninpartikel und dentritische (verästelte) Zellen, die Melanin (Hautfarbstoff) enthalten.“"
                            },
                            {
                                "example_id": "82d647a9-d797-428c-be2c-94dc53dd827d",
                                "sense_id": "e7c003e9-9b6e-3f50-bbd9-57ceb37a3236",
                                "text": "„Hier werden bereits vorgefertigte Melaninpartikel etwas weiter an die Oberfläche geschoben und noch nicht braune Melaninvorstufen chemisch sichtbar gemacht.“"
                            },
                            {
                                "example_id": "04a8fb8f-4914-442e-ba72-961276a67f73",
                                "sense_id": "e7c003e9-9b6e-3f50-bbd9-57ceb37a3236",
                                "text": "„Die Lage der Melaninpartikel in der Haut spiegelt sich im Farbton der Herde wieder […].“"
                            },
                            {
                                "example_id": "913f541f-950f-4bca-a83e-a91ead6413a9",
                                "sense_id": "e7c003e9-9b6e-3f50-bbd9-57ceb37a3236",
                                "text": "„Im Bezug auf das Hautgewebe gilt dies insbesondere für Keratinreste, kleine Zellorganellen, Proteine sowie zum Teil für Melaninpartikel.“"
                            },
                            {
                                "example_id": "4e235183-98d3-4fd2-a6e1-1663607445e7",
                                "sense_id": "e7c003e9-9b6e-3f50-bbd9-57ceb37a3236",
                                "text": "„Je mehr Melaninpartikel vorhanden sind, umso dunkler ist die Haut und um so geringer die Gefahr von Sonnenbrand und allen möglichen Hautkrebsformen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
