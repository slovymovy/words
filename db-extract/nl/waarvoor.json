                            {
                                "example_id": "587038d7-fc4e-43d8-bd1d-895a926fc4f1",
                                "sense_id": "034000bd-4bfc-317c-b9ee-e9e9fabd9f95",
                                "text": "Waarvoor bedankte ze jou?",
                                "translation": "What did she thank you for?",
                                "english": "What did she thank you for?"
                            },
                            {
                                "example_id": "637c7a33-bc2a-4353-a519-db7e7f6adaf7",
                                "sense_id": "034000bd-4bfc-317c-b9ee-e9e9fabd9f95",
                                "text": "Ik weet niet waarvoor hij heeft gekozen.",
                                "translation": "I don't know what he has chosen (opted for).",
                                "english": "I don't know what he has chosen (opted for)."
                            },
                            {
                                "example_id": "20793b08-238f-4ac9-b08d-181f1d7eb035",
                                "sense_id": "034000bd-4bfc-317c-b9ee-e9e9fabd9f95",
                                "text": "Kun je me vertellen waarvoor dit dient?",
                                "translation": "Can you tell me what this is used for?",
                                "english": "Can you tell me what this is used for?"
                            },
                            {
                                "example_id": "477c5fd3-c49d-410e-aec4-fa8d4fe7fa93",
                                "sense_id": "034000bd-4bfc-317c-b9ee-e9e9fabd9f95",
                                "text": "Waarvoor gebruik je deze sleutel?",
                                "translation": "What do you use this key for?",
                                "english": "What do you use this key for?"
                            },
                            {
                                "example_id": "05f9e576-5aad-481b-9753-e1ad42f4d1e8",
                                "sense_id": "034000bd-4bfc-317c-b9ee-e9e9fabd9f95",
                                "text": "Waarvoor ben je aan het sparen?",
                                "translation": "What are you saving up for?",
                                "english": "What are you saving up for?"
                            },
                            {
                                "example_id": "bd5eb217-7e51-4b54-86ff-48461934c3ae",
                                "sense_id": "034000bd-4bfc-317c-b9ee-e9e9fabd9f95",
                                "text": "Ik weet niet waarvoor hij zich verontschuldigde.",
                                "translation": "I don't know what he apologized for.",
                                "english": "I don't know what he apologized for."
                            }
                        ]
                    }
