                "senses": [
                    {
                        "sense_id": "95cd41be-c66c-371b-a044-2bf4a778b6e9",
                        "entry_id": "00b8dd40-54c3-3521-a7d6-a51088dd06d7",
                        "glosses": [
                            "plaats waar mensen begraven worden na hun overlijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82e08fa8-057b-49f1-84e3-b6de52635e2e",
                                "sense_id": "95cd41be-c66c-371b-a044-2bf4a778b6e9",
                                "text": "Dieper de dodenakker in was een lichtplek, waar verschillende stormlampen rond een berg verse aarde hingen."
                            },
                            {
                                "example_id": "c19f6ca2-ae2e-402f-96fc-ad653cc41643",
                                "sense_id": "95cd41be-c66c-371b-a044-2bf4a778b6e9",
                                "text": "Het zijn bijna allemaal Duitsers die op deze dodenakker liggen, omgekomen op Nederlandse bodem of vlak over de grens. Na de bevrijding zijn ze in Ysselsteyn herbegraven."
                            }
                        ]
                    }
                ],
