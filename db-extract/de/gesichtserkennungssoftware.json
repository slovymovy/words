                "senses": [
                    {
                        "sense_id": "b918c7b6-0875-3e22-a92c-45594d3c63bf",
                        "entry_id": "04290651-72e0-3f2f-888a-972707718619",
                        "glosses": [
                            "Software zur Gesichtserkennung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "623e98d2-48c1-4d2f-af47-4c3ee002a6bf",
                                "sense_id": "b918c7b6-0875-3e22-a92c-45594d3c63bf",
                                "text": "„Wenn die Fremde etwas über Gesichtserkennungssoftware wusste, so war sie zu müde, um sich darum zu scheren.“"
                            },
                            {
                                "example_id": "a4cf01fa-2394-4e10-878b-ffb96f9f87da",
                                "sense_id": "b918c7b6-0875-3e22-a92c-45594d3c63bf",
                                "text": "„Mack hatte es an eine Gesichtserkennungssoftware weitergeleitet, die eine Viertelmillion Dollar kostete und auf einem Hochleistungsrechner lief.“"
                            },
                            {
                                "example_id": "89ec4a22-e935-4207-a083-59f8e01e9bdd",
                                "sense_id": "b918c7b6-0875-3e22-a92c-45594d3c63bf",
                                "text": "„›Hören Sie zu, wir haben brandneue Gesichtserkennungssoftware auf unseren Servern, die jede Kamera im Umkreis von 100 Klicks in und um Tallinn auswertet.‹“"
                            },
                            {
                                "example_id": "d86a60bb-f73a-4410-8dea-687ec0aa3f4e",
                                "sense_id": "b918c7b6-0875-3e22-a92c-45594d3c63bf",
                                "text": "„Ford trug eine Perücke, doch die Gesichtserkennungssoftware ließ keinen Zweifel zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
