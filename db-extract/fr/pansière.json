                                    }
                                ]
                            },
                            {
                                "target_word": "placard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93740b10-6a4b-324c-b224-fde28fa545f8",
                                        "entry_id": "cb4377d8-3d7b-3031-8115-b89c2048e997",
                                        "glosses": [
                                            "To affix a placard to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15e84482-ddfe-48db-9efd-eaf20a44e290",
                                                "sense_id": "93740b10-6a4b-324c-b224-fde28fa545f8",
                                                "text": "The inner walls of the church were placarded with large mural tablets of copper, bearing engraved inscriptions celebrating the merits of old Heilbronn worthies of two or three centuries ago, […]"
                                            },
                                            {
                                                "example_id": "cf247d22-112c-4fd2-850b-7a23bec2feb1",
                                                "sense_id": "93740b10-6a4b-324c-b224-fde28fa545f8",
                                                "text": "The mail coaches were placarded PEACE WITH FRANCE in large capitals, and the drivers all wore a sprig of laurel, as an emblem of peace, in their hats."
                                            },
                                            {
                                                "example_id": "6924a239-5d95-4d3a-b0e8-f4d17cb643f2",
                                                "sense_id": "93740b10-6a4b-324c-b224-fde28fa545f8",
                                                "text": "In the afternoon Sue and the other people bustling about Kennetbridge fair could hear singing inside the placarded hoarding farther down the street."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8888a3c-fdca-3e99-9c5e-76c1ec6d6e91",
                                        "entry_id": "cb4377d8-3d7b-3031-8115-b89c2048e997",
                                        "glosses": [
                                            "To announce with placards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5c248fc-7641-4bde-91a2-97e728ab83b1",
                                                "sense_id": "e8888a3c-fdca-3e99-9c5e-76c1ec6d6e91",
                                                "text": "to placard a sale"
                                            },
                                            {
                                                "example_id": "93d5c8e3-1f70-4091-84d1-94e897c4e144",
                                                "sense_id": "e8888a3c-fdca-3e99-9c5e-76c1ec6d6e91",
                                                "text": "These men, who have already caused you so much harm, whom you yourselves dispersed on the 31st of October, are placarding their intention to protect you against the Prussians, who have only made an appearance within our walls, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
