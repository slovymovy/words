                "senses": [
                    {
                        "sense_id": "ec90f9ca-ddab-3b21-b870-648dfbc0db16",
                        "entry_id": "68a54fd4-b30e-301a-a46b-c5c26add8b86",
                        "glosses": [
                            "längliche, grüne (oder gelbe), noch nicht ausgereifte Frucht der Gartenbohne"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "2dbba996-3271-40b8-bfb5-f1b74b65a936",
                                "sense_id": "ec90f9ca-ddab-3b21-b870-648dfbc0db16",
                                "text": "„Die Entenbrust mit dickem Kartoffel-Apfel-Püree, Trauben, Walnüssen und Fisolen in Honig war laut Karte und Kellner angeblich auf dem Grill, ist aber kalt und zu 99 Prozent roh.“"
                            },
                            {
                                "example_id": "471f9424-fec4-4292-bf40-7053bed692a3",
                                "sense_id": "ec90f9ca-ddab-3b21-b870-648dfbc0db16",
                                "text": "„Die meisten Normalsterblichen essen in so genannten Gemeinschaftsküchen. […] Alle sind sie gleich billig – […], in allen riecht es unerträglich nach Kraut und schlechtem Fett, in allen isst man ohne Tischtuch mit verbogenem Blechbesteck und in allen auch jeden Tag dasselbe: Suppe: Schmutzwasser mit gekochten Graupen, Fisolen oder Kraut respektive Kraut oder Fisolen, an einem Fleischtag kommt dazu ein Stück ranzige Salami und Semmel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
