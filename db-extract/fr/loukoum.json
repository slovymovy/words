                                        "sense_id": "863bb1e1-1b45-30a3-aab9-72cd1e78dc9d",
                                        "entry_id": "7ff6db4c-b58e-3ae4-afba-6fc8f6db9f1c",
                                        "glosses": [
                                            "παραδοσιακό γλύκισμα της τούρκικης κουζίνας που σερβίρεται σε μικρά κομμάτια κυβικού σχήματος"
                                        ],
