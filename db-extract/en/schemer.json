                    },
                    {
                        "translation_id": "7b190b0e-1d45-4d5c-ac71-cc56fe73e838",
                        "source_entry_id": "a8d62822-9c1b-39a3-b135-e2979e1aaceb",
                        "source_sense_id": "db3b0865-f3b9-3562-a875-b59ab62c7aa2",
                        "source_sense_description": "one who plots secret, devious plans",
                        "target_lang_word": "machinateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machinateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca8d67d1-765e-3902-b8a8-a65cfc22b4e7",
                                        "entry_id": "5a796a38-b643-39dc-a9cf-6f00495e5761",
                                        "glosses": [
                                            "Personne qui fait quelque machination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09537824-6621-473a-ad11-e28abe180651",
                                                "sense_id": "ca8d67d1-765e-3902-b8a8-a65cfc22b4e7",
                                                "text": "Elle fut la machinatrice du complot."
                                            },
                                            {
                                                "example_id": "2c7c2a24-90bb-4fa5-ba98-192df1815f8e",
                                                "sense_id": "ca8d67d1-765e-3902-b8a8-a65cfc22b4e7",
                                                "text": "L’intrus est un semeur de pistes, un machinateur de conséquences suffisamment sagace, y compris pour anticiper ces réflexions qui sont miennes."
                                            },
                                            {
                                                "example_id": "64976d4e-08e9-4c8c-ab2c-69cc53e4c64c",
                                                "sense_id": "ca8d67d1-765e-3902-b8a8-a65cfc22b4e7",
                                                "text": "Il est bien dur de laisser ainsi aux machinateurs une partie du salaire sur lequel ils ont compté ; mais la patrie commande ce sacrifice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1dec1d7-072e-4ffb-b4e4-f6d753838232",
                        "source_entry_id": "a8d62822-9c1b-39a3-b135-e2979e1aaceb",
                        "source_sense_id": "db3b0865-f3b9-3562-a875-b59ab62c7aa2",
                        "source_sense_description": "one who plots secret, devious plans",
                        "target_lang_word": "intrigant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrigant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2c5be0d-7b8a-3f69-9433-3b09195320b3",
                                        "entry_id": "60739416-db53-38df-b37b-25eef8bc8184",
                                        "glosses": [
                                            "Qui se mêle de beaucoup d’intrigues généralement à son profit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e96702c-890d-4f56-9bc8-d5edcdc1edce",
                                                "sense_id": "d2c5be0d-7b8a-3f69-9433-3b09195320b3",
                                                "text": "C’est un homme fort intrigant."
                                            },
                                            {
                                                "example_id": "2c6b52cb-5da4-42f9-9d0d-d9e08326bd1b",
                                                "sense_id": "d2c5be0d-7b8a-3f69-9433-3b09195320b3",
                                                "text": "Nous devons d'abord nous débarrasser de l'intrigante Marie de Médicis."
                                            },
                                            {
                                                "example_id": "1ed7aa07-7b3c-40bb-8dc4-6c4a8e892d68",
                                                "sense_id": "d2c5be0d-7b8a-3f69-9433-3b09195320b3",
                                                "text": "Je sus qu’elle me traitait d’intrigante et m’accusait de la jalouser au point d’avoir abîmé à coups de dents la reliure des livres qu’elle m’avait prêtés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86dd8189-e923-37f7-9438-207dd9dc6d05",
                                        "entry_id": "60739416-db53-38df-b37b-25eef8bc8184",
                                        "glosses": [
                                            "Qui suscite la curiosité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78a6ff19-dd4d-481e-b68c-1e8b4edb42b9",
                                                "sense_id": "86dd8189-e923-37f7-9438-207dd9dc6d05",
                                                "text": "[…] il avait abordé le côté psychologique du mysticisme allemand au moyen âge, en s'efforçant de résoudre au moyen des ressources de la psychologie physiologique moderne, l'un des problèmes les plus intrigants de cette histoire."
                                            },
                                            {
                                                "example_id": "b243db4f-9460-4448-9461-05e8a18dafb1",
                                                "sense_id": "86dd8189-e923-37f7-9438-207dd9dc6d05",
                                                "text": "Plus récemment, une étude intrigante en tomographie par émission de positrons (PET) a rapporté une diminution de la liaison au récepteur 5-HT1A dans le raphé et dans l’hippocampeamygdale de patients déprimés, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intrigant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08b1f24a-f12e-3269-87ae-6d84414024c3",
                                        "entry_id": "ef0ec541-ad3e-34ff-ad69-1e49e571ae6c",
                                        "glosses": [
                                            "Personne qui fait des intrigues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67c5ecbc-a8be-447e-a71e-46ec8be2cff5",
                                                "sense_id": "08b1f24a-f12e-3269-87ae-6d84414024c3",
                                                "text": "[…] ; j’ai vu des intrigants hypocrites imputer leurs propres crimes aux défenseurs de la liberté qu’ils nommaient agitateurs ou anarchistes ; […]"
                                            },
                                            {
                                                "example_id": "826bc4ce-a6d3-41d0-bd49-44ca54636d71",
                                                "sense_id": "08b1f24a-f12e-3269-87ae-6d84414024c3",
                                                "text": "Maintenant qu’est passée la période loquace où la facilité de langage et les attitudes impressionnantes étaient une condition nécessaire pour atteindre à la prééminence politique, le contrôle tombe de plus en plus entièrement dans les mains d’une classe d’avocassiers et d’intrigants, à l’esprit souple et tenace."
                                            },
                                            {
                                                "example_id": "09bc9fdf-8669-40d8-88c6-e5c05f28ffef",
                                                "sense_id": "08b1f24a-f12e-3269-87ae-6d84414024c3",
                                                "text": "Ajoutez à cela les influences politiques et électorales, qui peuplent les chaires et les laboratoires de nullités alliées aux ministres et femmes de ministres et demandez-vous comment un jeune homme de valeur, mais sans appui, ni argent ni bassesse, pourrait traverser ces rangs pressés de fonctionnaires et d’intrigants ?…"
                                            },
                                            {
                                                "example_id": "62c454ca-16ed-429f-8923-adb59fc524c7",
                                                "sense_id": "08b1f24a-f12e-3269-87ae-6d84414024c3",
                                                "text": "Sinon il est foutre bien évident que cent mille intrigants viendront se payer notre poire et ils prendront en main, nos intérêts, d'une sale façon comme de juste... et nous serons encore obligés de les subir !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
