                    {
                        "translation_id": "358e26b4-faa5-4fce-97f1-bd9dcbfc068d",
                        "source_entry_id": "256cfd81-e37a-3cfd-b569-387c55f2b4b8",
                        "source_sense_id": "ae5f310f-9b12-3a42-82ce-9d1c72e8381a",
                        "target_lang_word": "brachiosaure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brachiosaure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53809d06-115f-3ee1-b169-91a2de624eab",
                                        "entry_id": "cdd95f90-1f3a-356e-9f38-764b6ff47b68",
                                        "glosses": [
                                            "Dinosaure sauropode herbivore de la famille des brachiosauridés qui pouvait peser de trente à cinquante tonnes et qui possédait un très long cou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a7e1a87-0678-49d2-aed4-d38462126288",
                                                "sense_id": "53809d06-115f-3ee1-b169-91a2de624eab",
                                                "text": "Mais, du fait de son séjour prolongé dans la grotte sous-marine, la peau du brachiosaure s'est recouverte d'une épaisse couche de calcaire, dure comme le roc."
                                            },
                                            {
                                                "example_id": "7e6c5c8f-3058-4f31-bfe8-e95acd4ff71b",
                                                "sense_id": "53809d06-115f-3ee1-b169-91a2de624eab",
                                                "text": "Dès le hall d’entrée, on se trouve confronté à un squelette de brachiosaure – le plus grand squelette de dinosaure jamais reconstitué avec des os authentiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53c21593-9f3f-4b68-bf3d-7d3d7d6cf2f0",
                        "source_entry_id": "256cfd81-e37a-3cfd-b569-387c55f2b4b8",
                        "source_sense_id": "ae5f310f-9b12-3a42-82ce-9d1c72e8381a",
