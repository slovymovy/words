                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d3dfb9a-3685-3a65-bfb9-071c6cc8446f",
                        "entry_id": "a15abd38-ecbb-35f1-870c-06ac03e6c98d",
                        "glosses": [
                            "Homme exerçant le métier de sage-femme."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "03f69ffd-1656-4ff2-96ae-9e8200ea97cc",
                                "sense_id": "6d3dfb9a-3685-3a65-bfb9-071c6cc8446f",
                                "text": "De nombreuses minutes plus tard, sortit de la salle, trempé de sueur, le maïeuticien, ou l’accoucheur ou encore le sage homme."
                            },
                            {
                                "example_id": "53d5e50d-6332-4da5-a3d5-5b7cc7621b71",
                                "sense_id": "6d3dfb9a-3685-3a65-bfb9-071c6cc8446f",
                                "text": "[…] le recentrage de l’activité des obstétriciens sur la grossesse pathologique et des maïeuticiens sur la grossesse physiologique, les examens prénatal et postnatal et la contraception […]"
                            },
                            {
                                "example_id": "465c3b9c-26d2-4698-a62b-9a63660d32d7",
                                "sense_id": "6d3dfb9a-3685-3a65-bfb9-071c6cc8446f",
                                "text": "Éliane Viennot rappelle: « En 1982, toutes les professions s’ouvrent aux deux sexes. La société s’est émue du fait que le métier de sage-femme allait être ouvert aux hommes. Le médecin Robert Debré s’est exclamé: “Les pauvres hommes vont être appelés sages-femmes !” L’Académie a proposé maïeuticien pour les hommes, mais pas maïeuticienne pour les femmes, qui, elles, devaient continuer d’être appelées sages-femmes. Ils ont créé un problème là où il n’y en avait pas. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "baaab305-7bbe-430b-b6e1-9f8da6723d0a",
                        "source_entry_id": "a15abd38-ecbb-35f1-870c-06ac03e6c98d",
                        "source_sense_id": "6d3dfb9a-3685-3a65-bfb9-071c6cc8446f",
                        "target_lang_word": "Entbindungspfleger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entbindungspfleger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d566a20-80e0-3a5b-8368-4c2a8a8cea6b",
                                        "entry_id": "289ffb16-9531-303f-8f00-8aca0d935378",
                                        "glosses": [
                                            "der an einer speziellen Lehranstalt ausgebildete und staatlich geprüfte Mann, der während der Schwangerschaft, bei der Geburt, während des Wochenbetts und der Stillzeit die werdende beziehungsweise frischgebackene Mutter berät, betreut und ihr Hilfe leistet"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06b5bc4e-b864-4e54-8955-e2172d0e6a74",
                                                "sense_id": "6d566a20-80e0-3a5b-8368-4c2a8a8cea6b",
                                                "text": "„Männer sind in diesem Beruf - allen Emanzipationsbewegungen zum Trotz - krasse Außenseiter, bundesweit gibt es gerade einmal drei männliche Entbindungspfleger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10b0103f-6eb2-4028-8fca-e7ef28d52c01",
                        "source_entry_id": "a15abd38-ecbb-35f1-870c-06ac03e6c98d",
                        "source_sense_id": "6d3dfb9a-3685-3a65-bfb9-071c6cc8446f",
                        "target_lang_word": "midwife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "midwife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbe68813-3ede-3dd5-adf2-45518dc14547",
                                        "entry_id": "c419f3f3-7b11-367b-a204-0b5fde3f7883",
                                        "glosses": [
                                            "A person, usually a woman, who is trained to assist women in childbirth, but who is not a physician."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863d336e-7b59-4004-b05b-d1fcf7f606de",
                                                "sense_id": "dbe68813-3ede-3dd5-adf2-45518dc14547",
                                                "text": "A hundred years ago, a midwife would bring the baby into the world - going to a hospital to deliver a baby was either impossible or unheard of."
                                            },
                                            {
                                                "example_id": "bfacc520-1e96-4cf6-bfc7-eb5d265f2eb1",
                                                "sense_id": "dbe68813-3ede-3dd5-adf2-45518dc14547",
                                                "text": "The senior midwife confirmed that […] occasionally a multigravid woman could feel little more than slight abdominal discomfort."
                                            },
                                            {
                                                "example_id": "9b234ca0-39d2-405c-84de-89a96fc3c85c",
                                                "sense_id": "dbe68813-3ede-3dd5-adf2-45518dc14547",
                                                "text": "Despite Richard's efforts to midwive his own narrative of legitimacy, the source of this legendary one cannot be controlled because it has moved from the mouths of nurses, midwives and gossips into the public domain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d729c07-deae-3520-9c80-9d07cdfe4681",
                                        "entry_id": "c419f3f3-7b11-367b-a204-0b5fde3f7883",
                                        "glosses": [
                                            "Someone who assists in bringing about some result or project."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "midwife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "503c3eb5-446b-3a35-8edd-f2f16bb9e891",
                                        "entry_id": "855386f0-2d44-3f64-ae0a-e1de9d0eb2cf",
                                        "glosses": [
                                            "To act as a midwife."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42300492-1348-3c30-9c33-7d44394f191b",
                                        "entry_id": "855386f0-2d44-3f64-ae0a-e1de9d0eb2cf",
                                        "glosses": [
                                            "To facilitate the emergence of."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8a78ca7-fa96-48d9-8dd9-c4ef254ca93b",
                                                "sense_id": "42300492-1348-3c30-9c33-7d44394f191b",
                                                "text": "But the bigger objective was to help Iraqis midwife a democratic model that could inspire reform across the Arab-Muslim world and give the youth there a chance at a better future."
                                            },
                                            {
                                                "example_id": "85c3ad25-4bba-4bff-8a6d-e994de6756d0",
                                                "sense_id": "42300492-1348-3c30-9c33-7d44394f191b",
                                                "text": "In the mid-1960s, Reichism was midwifed into reexistence by such stalwarts as William Schutz, Bernard Gunther, Charlotte Selver, Alexander Lowen, Ida Rolf, and many other exponents of human knead needs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
