                                    {
                                        "sense_id": "18d401ab-70dc-3054-8acf-5070ae7f4536",
                                        "entry_id": "c60b0935-4050-37d2-9a8d-e2cf25c85e1e",
                                        "glosses": [
                                            "Installation située sur une autoroute ou une route à péage permettant aux usagers de s'acquitter d'un droit de passage."
                                        ],
                                        "tags": [
                                            "Transport terrestre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa5f8b51-4e0f-4178-868d-517a2c0824f7",
                                                "sense_id": "18d401ab-70dc-3054-8acf-5070ae7f4536",
                                                "text": "Une soixantaine de personnes œuvrent quotidiennement au bon fonctionnement et au franchissement du pont rétais construit en 1986. À commencer par la gare de péage qui sera entièrement automatisée d'ici deux ans."
                                            }
                                        ]
                                    }
