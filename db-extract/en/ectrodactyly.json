                                        "entry_id": "08365823-a41f-329a-b131-98ffb86fca80",
                                        "glosses": [
                                            "Maladie génétique rare caractérisée par l’absence d’un ou de plusieurs doigts."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ea69ff5-4370-4c52-b7d8-1cc64aae9779",
                                                "sense_id": "a3b8a9aa-6daf-3553-89a9-5f8b9faf079a",
                                                "text": "Enfin, chez un troisième individu, on observe une ectrodactylie antérieure bilatérale (trois doigts)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
