                        ],
                        "examples": [
                            {
                                "example_id": "c45688a0-33db-4163-a21a-0404a5cad893",
                                "sense_id": "95604736-d750-36a5-8113-b7c142863ac7",
                                "text": "La poupée rétro-branchouille est devenue la première artiste dans l’histoire du Billboard Top 40 (les charts américains) à obtenir cinq titres nᵒ 1 d’affilée, à savoir California Gurls, Teenage Dream, Firework, E.T. et Last Friday Night (TGIF), tous issu de son dernier album “Teenage Dream”."
                            },
                            {
                                "example_id": "66d5a8d6-9b25-467a-8359-d81a28339d97",
                                "sense_id": "95604736-d750-36a5-8113-b7c142863ac7",
                                "text": "D’une esthétique foncièrement eighties, tournés et montés en VHS, effets vidéo vintage, musique originale composée dans les mêmes conditions, ces courts métrages radicaux ne sont pourtant pas rétro-branchouille."
                            },
                            {
                                "example_id": "176f0a33-b4e9-42d8-942d-8b854fa7016e",
                                "sense_id": "95604736-d750-36a5-8113-b7c142863ac7",
                                "text": "Gretchen a un gros nez, et c'est là tout le charme de ce personnage, contrairement à Aurélien qui arbore la plastique du bellâtre vaguement rétro-branchouille un peu à l'ouest."
                            }
                        ]
                    }
