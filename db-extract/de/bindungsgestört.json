                ],
                "senses": [
                    {
                        "sense_id": "4559ba5b-6c37-349e-8ca6-586c7f317176",
                        "entry_id": "d841a433-1686-33fe-a53e-37bbc217110c",
                        "glosses": [
                            "Schwierigkeiten beim Eingehen von Bindungen habend; unfähig, sich mit jemandem zu binden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d303812-d484-4c41-a120-2bb5023c6058",
                                "sense_id": "4559ba5b-6c37-349e-8ca6-586c7f317176",
                                "text": "„Er ist nämlich bindungsgestört, also beziehungsunfähig.“"
                            },
                            {
                                "example_id": "3c9bfa89-4a24-4e89-a9d0-31cba59a4428",
                                "sense_id": "4559ba5b-6c37-349e-8ca6-586c7f317176",
                                "text": "„Wie viele Menschen tatsächlich bindungsgestört sind, lässt sich mit Studien schwer belegen.“"
                            },
                            {
                                "example_id": "862a2172-20b0-49da-a0ff-38e91c6abafc",
                                "sense_id": "4559ba5b-6c37-349e-8ca6-586c7f317176",
                                "text": "„‚Wir brauchen zuerst eine Bindungsoffensive, auf die dann die Bildungsoffensive folgen könnte, denn bindungsgestörte Kinder lernen selbst bei bestem Bildungsangebot schlecht oder gar nicht‘, sagt der Kinder- und Jugendpsychiater Karl-Heinz Brisch.“"
                            },
                            {
                                "example_id": "2455737a-016a-4955-b9d8-49f62c5fb697",
                                "sense_id": "4559ba5b-6c37-349e-8ca6-586c7f317176",
                                "text": "„Sowohl narzisstische als auch bindungsgestörte Menschen verfügen über wenig Selbstwert (auch wenn das auf den ersten Blick völlig anders aussieht!) und sie haben kaum Zugang zu ihren Gefühlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
