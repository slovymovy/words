                ],
                "senses": [
                    {
                        "sense_id": "728d8066-487a-3bd1-af6f-71c42b126e78",
                        "entry_id": "b6c6b8d2-caa7-3468-a61e-5ed8a4f17237",
                        "glosses": [
                            "vermeintliche Überreste eines Frühmenschen, die vor 1912 in einer Kiesgrube bei dem Dorf Piltdown in der Nähe von Uckfield in Südostengland gefunden und 1953 als wissenschaftliche Fälschung entlarvt wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9c97246-2ae3-4b48-b254-503b503fd284",
                                "sense_id": "728d8066-487a-3bd1-af6f-71c42b126e78",
                                "text": "„Ich bemerkte also wie gesagt ihre groteske Gestalt und sonderbare Größe, doch entschied ich, es müsse sich um die fantastischen Götter eines primitiven Stammes von Fischern oder Seefahrern handeln; eines Stammes, dessen letzter Abkömmling lange vor dem ersten Ahnen des Piltdown-Menschen oder Neandertalers von der Erde verschwunden war.“"
                            },
                            {
                                "example_id": "0c145d39-fbd9-4112-a31a-611644d11216",
                                "sense_id": "728d8066-487a-3bd1-af6f-71c42b126e78",
                                "text": "„Diese Kreaturen hatten auf der Entwicklungsstufe größtenteils noch unter dem Piltdown-Menschen gestanden, waren aber auf jeden Fall menschlich.“"
                            },
                            {
                                "example_id": "3939aab9-9718-40b4-b159-61d2fcaca08c",
                                "sense_id": "728d8066-487a-3bd1-af6f-71c42b126e78",
                                "text": "„Da war der Neandertaler mit seinem kleineren Schädelvolumen, der Predmost-Mensch und der Grimaldi-Mensch und in einer tieferen Schicht der Heidelberg-Mensch und der Eoanthropus oder Piltdown-Mensch in einer Vielzahl von Typen, von denen einige bisher vollkommen unbekannt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
