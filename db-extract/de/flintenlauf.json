                                        "examples": [
                                            {
                                                "example_id": "56f84791-d438-41b2-8ae9-d9d5faf5673f",
                                                "sense_id": "05347f53-9011-3f5e-8d92-d6ee7966b6f3",
                                                "text": "The gun barrel, whether forged, rolled, or drawn, is known technically as a tube."
                                            },
                                            {
                                                "example_id": "55c44381-96bf-4c21-b69a-44dc06a1a346",
                                                "sense_id": "05347f53-9011-3f5e-8d92-d6ee7966b6f3",
                                                "text": "The current condemnation criteria for cracking in gun barrels is stated in the applicable technical manual regarding serviceability of Naval gun barrels as being the existence of any crack equal or greater than 3 inches for monobloc barrels."
                                            },
                                            {
                                                "example_id": "5e353035-7b3a-49e2-ade1-937660b0a95f",
                                                "sense_id": "05347f53-9011-3f5e-8d92-d6ee7966b6f3",
                                                "text": "As a result MAVAG machine tools normally engaged in manufacturing 40mm gun barrels were employed to bore out and rifle 40mm 51-calibre anti-tank gun barrels to be mounted on copies of the German carriage."
                                            }
                                        ]
