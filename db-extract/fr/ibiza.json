        "fr-extract.jsonl": [
            {
                "entry_id": "4150f733-5cb9-3a12-86e0-6b29d2f8ea6b",
                "word": "Ibiza",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b7b0b3df-0011-3acc-a000-52b4b95736c0",
                        "entry_id": "4150f733-5cb9-3a12-86e0-6b29d2f8ea6b",
                        "glosses": [
                            "Île de l’archipel des Baléares, en mer Méditerranée."
                        ],
                        "tags": [
                            "Îles"
                        ],
                        "examples": [
                            {
                                "example_id": "e2831686-0b00-4299-a78d-2637c935ecf9",
                                "sense_id": "b7b0b3df-0011-3acc-a000-52b4b95736c0",
                                "text": "Selon toutes probabilités, ces navires, fabriqués à Marseille, Ampurias, Ibiza ou Carthagène, sont de faible tonnage. L’époque connaît des navires de tonnage conséquent, mais leurs naufrages se concentrent surtout autour des grands nœuds de navigation."
                            },
                            {
                                "example_id": "ca9b9ed9-050d-467d-be8e-ada9dcf8fb7d",
                                "sense_id": "b7b0b3df-0011-3acc-a000-52b4b95736c0",
                                "text": "Mélissa, métisse d'Ibiza,\nVit toujours dévêtue.\nDites jamais que je vous ai dit ça\nOu Mélissa me tue."
                            }
                        ]
                    },
                    {
                        "sense_id": "6180447a-e2cb-3b3d-8c68-7afe3b676c51",
                        "entry_id": "4150f733-5cb9-3a12-86e0-6b29d2f8ea6b",
                        "glosses": [
                            "Commune d’Espagne, située sur l’île d’Ibiza."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85b82a57-df18-40a4-9a52-34ee1cc6f554",
                        "source_entry_id": "4150f733-5cb9-3a12-86e0-6b29d2f8ea6b",
                        "target_lang_word": "Ibiza",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
