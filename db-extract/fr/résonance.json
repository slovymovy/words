                "senses": [
                    {
                        "sense_id": "bb306df2-d4bf-328d-8a6b-1166456647a9",
                        "entry_id": "8ed230a4-72c1-350d-bfaf-f4cc268739be",
                        "glosses": [
                            "resonance"
                        ],
