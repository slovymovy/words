                ],
                "senses": [
                    {
                        "sense_id": "9e1c27de-420a-343b-b133-3d0c0482e048",
                        "entry_id": "f1f89898-1d6f-36a2-9a54-ba2c0a2d1bce",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b5b5351-0c6c-4cb4-99f1-a4a4eb758c98",
                                "sense_id": "9e1c27de-420a-343b-b133-3d0c0482e048",
                                "text": "Frau Knäble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1f35e4e4-ce12-4035-9643-feae9f335e1f",
                                "sense_id": "9e1c27de-420a-343b-b133-3d0c0482e048",
                                "text": "Herr Knäble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cb0235c7-c19e-43d0-812e-1d4fcc19a40a",
                                "sense_id": "9e1c27de-420a-343b-b133-3d0c0482e048",
                                "text": "Die Knäbles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "1e6205f9-9858-411e-9e4b-9129a3e73fb3",
                                "sense_id": "9e1c27de-420a-343b-b133-3d0c0482e048",
                                "text": "Der Knäble trägt nie die Pullover, die die Knäble ihm strickt."
                            },
                            {
                                "example_id": "d4dcfa5e-3a71-487f-9aa2-f8f05a0852b8",
                                "sense_id": "9e1c27de-420a-343b-b133-3d0c0482e048",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knäble kommt, geht der Herr Knäble.“"
                            },
                            {
                                "example_id": "c6ab7e6d-e9ba-483b-8da8-a011dc6ef959",
                                "sense_id": "9e1c27de-420a-343b-b133-3d0c0482e048",
                                "text": "Knäble kommt und geht."
                            },
                            {
                                "example_id": "173592be-a13f-4769-a17b-d2bf5f562145",
                                "sense_id": "9e1c27de-420a-343b-b133-3d0c0482e048",
                                "text": "Knäbles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
