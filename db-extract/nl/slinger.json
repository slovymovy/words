                                    },
                                    {
                                        "sense_id": "c1871386-dc4b-36fa-9a9c-429abf5d9567",
                                        "entry_id": "45746db8-9d81-3769-856a-ad66b8cc28e5",
                                        "glosses": [
                                            "A metal gutter placed round a mineshaft on the inside, to catch water running down inside the shaft and run it into a drainpipe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22dbf642-e9ba-3eeb-8eca-a4598d5a300f",
                                        "entry_id": "45746db8-9d81-3769-856a-ad66b8cc28e5",
                                        "glosses": [
                                            "The crown of a monarch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feb111dd-1094-484b-bef9-a73e5864f372",
                                                "sense_id": "22dbf642-e9ba-3eeb-8eca-a4598d5a300f",
                                                "text": "[She] ioyfully receyued and welcommed mee, as the onely type and garland of her noble ſtirpe and linage, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e07225d-0385-30f7-8efb-fe01c602ce06",
                                        "entry_id": "45746db8-9d81-3769-856a-ad66b8cc28e5",
                                        "glosses": [
                                            "A book of extracts in prose or poetry; an anthology."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594b96a1-6684-4d16-a582-4cd35f83e30b",
                                                "sense_id": "5e07225d-0385-30f7-8efb-fe01c602ce06",
                                                "text": "They [ballads] began to be collected into little miscellanies under the name of garlands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8c155ba-56b8-3aea-8c2f-788a4a9fb56c",
                                        "entry_id": "45746db8-9d81-3769-856a-ad66b8cc28e5",
                                        "glosses": [
                                            "The top; the thing most prized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b5baa61-482d-4ae4-8cef-289d048c3cf8",
                                                "sense_id": "a8c155ba-56b8-3aea-8c2f-788a4a9fb56c",
                                                "text": "And call him noble that was now your hate, / Him vile that was your garland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fec2bcd3-55e3-39f8-8aca-8a2ead0c2eaa",
