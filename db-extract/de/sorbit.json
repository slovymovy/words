                    },
                    {
                        "form_id": "d07e7987-e9ca-45e6-992b-c5cabee5015d",
                        "entry_id": "28ccbb86-3252-3dcc-89c7-36165fb28558",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Sorbit"
                    },
                    {
                        "form_id": "19fa8396-0bfd-41b5-a2bb-0b818899560a",
                        "entry_id": "28ccbb86-3252-3dcc-89c7-36165fb28558",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Sorbit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "39c4258d-2d0c-3258-bacd-8e410d6eef43",
                        "entry_id": "28ccbb86-3252-3dcc-89c7-36165fb28558",
                        "glosses": [
                            "ein sechswertiger, süß schmeckender Alkohol; ein pflanzlicher Wirkstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08084982-a3e0-4441-8395-67f9f12cd77e",
                                "sense_id": "39c4258d-2d0c-3258-bacd-8e410d6eef43",
                                "text": "Sorbit ist auf natürliche Weise vor allem in Kernobst enthalten: Äpfel, Birnen, Aprikosen, Pflaumen und Pfirsiche enthalten allesamt größere Mengen an Sorbit."
                            },
                            {
                                "example_id": "0b2b536a-22fe-4a4c-9641-42c519ae21e3",
                                "sense_id": "39c4258d-2d0c-3258-bacd-8e410d6eef43",
                                "text": "Das Positive an Sorbit: Es ist süß, hat aber deutlich weniger Kalorien als Haushaltszucker."
                            },
                            {
                                "example_id": "8a544a9a-f156-4ab0-a24b-5995169ed93f",
                                "sense_id": "39c4258d-2d0c-3258-bacd-8e410d6eef43",
                                "text": "Kein Insulin bedeutet keine zusätzlichen Fettpolster, darum ist Sorbit in der Lebensmittelindustrie sehr beliebt."
                            },
                            {
                                "example_id": "16690c63-e8ba-4a68-a6fa-f36b1f605f54",
                                "sense_id": "39c4258d-2d0c-3258-bacd-8e410d6eef43",
                                "text": "Sorbit wird vom menschlichen Körper auch selbst produziert."
                            },
                            {
                                "example_id": "47f9e86f-08d6-43a7-965c-9b7644fedbcb",
                                "sense_id": "39c4258d-2d0c-3258-bacd-8e410d6eef43",
                                "text": "Allerdings wird Sorbit nicht von jedermann gut vertragen – immer mehr Menschen leiden an einer Sorbitintoleranz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "843aa94b-e873-316d-97b2-dfadbe3bb0a9",
                        "entry_id": "28ccbb86-3252-3dcc-89c7-36165fb28558",
                        "glosses": [
                            "Bestandteil von Stahl"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "8d244d8a-3510-49de-9d02-4b038657d954",
                                "sense_id": "843aa94b-e873-316d-97b2-dfadbe3bb0a9",
                                "text": "Sorbit ist ein Zwischenstufengefüge des Stahls."
                            },
                            {
                                "example_id": "2753a89e-2f12-4a30-8f83-87487789c765",
                                "sense_id": "843aa94b-e873-316d-97b2-dfadbe3bb0a9",
                                "text": "Manchmal wird auch der bei der entsprechenden Abkühlgeschwindigkeit direkt entstehende feinste Perlit als Sorbit bezeichnet."
                            },
                            {
                                "example_id": "4815421d-ef0f-4ae0-a72e-e40668f961e3",
                                "sense_id": "843aa94b-e873-316d-97b2-dfadbe3bb0a9",
                                "text": "Der Martensit ist in diesem Bereich wesentlich feiner, in der äußeren Übergangszone wieder vorwiegend Sorbit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
