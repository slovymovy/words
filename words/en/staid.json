{
    "word_family": [
        "staidly",
        "staidness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dbd662e4-4bea-3972-94c5-350e02ce021f",
                    "sense_definition": "Serious, sedate, and respectable, often considered boring or old-fashioned.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company has a <w>staid</w> reputation and rarely takes risks with new products.",
                            "target_lang_translations": {
                                "ru": "У этой компании <w>консервативная</w> репутация, и она редко рискует с новыми продуктами.",
                                "nl": "Het bedrijf heeft een <w>deftige</w> reputatie en neemt zelden risico's met nieuwe producten."
                            }
                        },
                        {
                            "text": "She found the <w>staid</w> atmosphere of the club rather boring compared to the city nightlife.",
                            "target_lang_translations": {
                                "ru": "Ей казалась <w>степенная</w> атмосфера клуба довольно скучной по сравнению с ночной жизнью города.",
                                "nl": "Ze vond de <w>bezadigde</w> sfeer van de club nogal saai vergeleken met het nachtleven in de stad."
                            }
                        }
                    ],
                    "synonyms": [
                        "sedate",
                        "serious",
                        "sober",
                        "dignified",
                        "steady",
                        "composed"
                    ],
                    "antonyms": [
                        "wild",
                        "volatile",
                        "unpredictable",
                        "fanciful"
                    ],
                    "common_phrases": [
                        "staid reputation",
                        "staid atmosphere",
                        "staid life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серьёзный, степенный и почтенный, часто считающийся скучным или старомодным.",
                        "nl": "Serieus, bedaard en respectabel, vaak als saai of ouderwets beschouwd."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "степенный",
                                "target_lang_sense_clarification": "о человеке или поведении: рассудительный, важный, исполненный достоинства"
                            },
                            {
                                "target_lang_word": "серьёзный",
                                "target_lang_sense_clarification": "не легкомысленный, строгий"
                            },
                            {
                                "target_lang_word": "уравновешенный",
                                "target_lang_sense_clarification": "спокойный, обладающий ровным характером"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "deftig",
                                "target_lang_sense_clarification": "formeel en waardig, soms wat stijf"
                            },
                            {
                                "target_lang_word": "bezadigd",
                                "target_lang_sense_clarification": "rustig, kalm en serieus, vaak gebruikt voor oudere mensen"
                            },
                            {
                                "target_lang_word": "conservatief",
                                "target_lang_sense_clarification": "traditioneel en niet geneigd tot verandering"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67b14a93-8031-3d5d-8621-a4e9930e7c3d",
                    "sense_definition": "Always fixed in the same location; stationary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>staid</w> mountains loomed over the valley, unchanged for centuries.",
                            "target_lang_translations": {
                                "ru": "<w>Неподвижные</w> горы нависали над долиной, оставаясь неизменными на протяжении веков.",
                                "nl": "De <w>onbeweeglijke</w> bergen torenden boven de vallei uit, al eeuwenlang onveranderd."
                            }
                        },
                        {
                            "text": "Nothing could move the <w>staid</w> foundation of the ancient castle.",
                            "target_lang_translations": {
                                "ru": "Ничто не могло сдвинуть <w>незыблемый</w> фундамент древнего замка.",
                                "nl": "Niets kon het <w>onwrikbare</w> fundament van het oude kasteel verplaatsen."
                            }
                        }
                    ],
                    "synonyms": [
                        "steady"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in older literature or poetry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Всегда зафиксированный в одном и том же месте; неподвижный.",
                        "nl": "Altijd op dezelfde plek vaststaand; onbeweeglijk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неподвижный",
                                "target_lang_sense_clarification": "не двигающийся, застывший на месте"
                            },
                            {
                                "target_lang_word": "незыблемый",
                                "target_lang_sense_clarification": "устойчивый, твердый, который нельзя поколебать"
                            },
                            {
                                "target_lang_word": "стационарный",
                                "target_lang_sense_clarification": "постоянный, непередвижной"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "onbeweeglijk",
                                "target_lang_sense_clarification": "niet in staat om te bewegen"
                            },
                            {
                                "target_lang_word": "stationair",
                                "target_lang_sense_clarification": "niet verplaatsbaar, vaststaand"
                            },
                            {
                                "target_lang_word": "onwrikbaar",
                                "target_lang_sense_clarification": "vast en niet te verplaatsen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79dcde04-4a90-3522-947a-b43adb87e284",
                    "sense_definition": "Obsolete spelling of <w>stayed</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>staid</w> in the house while the others went out to the market.",
                            "target_lang_translations": {
                                "ru": "Он <w>остался</w> в доме, пока остальные ходили на рынок.",
                                "nl": "Hij <w>bleef</w> in het huis terwijl de anderen naar de markt gingen."
                            }
                        },
                        {
                            "text": "They <w>staid</w> longer than expected because of the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Они <w>оставались</w> там дольше, чем ожидалось, из-за сильного дождя.",
                                "nl": "Ze <w>bleven</w> langer dan verwacht vanwege de zware regenval."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "standard spelling is now 'stayed'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова <w>stayed</w> (прош. вр. от stay — оставаться).",
                        "nl": "Verouderde spelling van 'stayed' (verleden tijd van 'stay' - blijven)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставался",
                                "target_lang_sense_clarification": "прошедшее время глагола 'оставаться'"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "bleef",
                                "target_lang_sense_clarification": "verleden tijd van het werkwoord 'blijven'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}