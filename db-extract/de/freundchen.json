                "senses": [
                    {
                        "sense_id": "a16406eb-821e-3821-8ef1-c4477ea6089d",
                        "entry_id": "4554ef88-0f11-3f75-a2d4-104028f163a2",
                        "glosses": [
                            "Anrede an eine männliche Person"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "eb9c2564-6660-4c5c-b448-99db63e9b353",
                                "sense_id": "a16406eb-821e-3821-8ef1-c4477ea6089d",
                                "text": "„Und was geht Sie das an, woher ich bin, Freundchen?“"
                            },
                            {
                                "example_id": "e961f1d4-a165-476d-ac7a-683d3558f6aa",
                                "sense_id": "a16406eb-821e-3821-8ef1-c4477ea6089d",
                                "text": "„Etwas Riesiges und Hartes wühlt sich tiefer in mich hinein, und die furchtbare Polizistenstimme sagt: ›Ja, immer locker bleiben, Freundchen.‹“"
                            },
                            {
                                "example_id": "21dd05d1-e61c-4b86-81e5-21dafabd4702",
                                "sense_id": "a16406eb-821e-3821-8ef1-c4477ea6089d",
                                "text": "„Aber was Sie jetzt hier sagen, kann da noch einiges retten, Freundchen.“"
                            },
                            {
                                "example_id": "d7c400f1-5fa6-462b-b7bb-e91efaa2d0e6",
                                "sense_id": "a16406eb-821e-3821-8ef1-c4477ea6089d",
                                "text": "„Wir machen aber nicht mit Ihnen herum, Freundchen.“"
                            },
                            {
                                "example_id": "c0163ebd-0d66-4293-84e4-7d3f5502914b",
                                "sense_id": "a16406eb-821e-3821-8ef1-c4477ea6089d",
                                "text": "„›Die CIA? Glauben Sie, ich habe mich von der CIA freigekauft? Ich hab mir verdammt noch mal den Weg freigeschossen, Freundchen!‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
