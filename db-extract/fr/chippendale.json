                "senses": [
                    {
                        "sense_id": "55b4eed8-44fc-3a67-8b5d-12cf71a5ac3e",
                        "entry_id": "9a295692-3553-3c0b-a708-5d1f516b1949",
                        "glosses": [
                            "Danseur et strip-teaseur d’une troupe cabarétière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3e8647b-e0d4-4474-aeaf-5423d749212c",
                                "sense_id": "55b4eed8-44fc-3a67-8b5d-12cf71a5ac3e",
                                "text": "Il est important de rappeler que la Pride, la vraie, ce n’est pas la « Gay Pride » avec des chars, de la musique et des chippendales ; mais bien un rassemblement engagé revendicatif qui milite contre les oppressions, pour les droits et les libertés de tous·tes."
                            },
                            {
                                "example_id": "3515db78-e7e4-461c-93da-00dc34e4ba78",
                                "sense_id": "55b4eed8-44fc-3a67-8b5d-12cf71a5ac3e",
                                "text": "Channing Tatum, l’acteur bodybuildé à l’affiche du remake de « 21 Jump Street », remporte la palme du beau gosse de l’année. L’ancien chippendale de 32 ans devance une sélection d’acteurs américains plus ou moins célèbres."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f903578-6475-3018-a815-2c94f64e34cd",
                        "entry_id": "9a295692-3553-3c0b-a708-5d1f516b1949",
                        "glosses": [
                            "Personne au physique avantageux ; généralement avec un sous-entendu relatif au QI peu élevé de ladite personne, par opposition."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "867d5885-1428-4e1e-aa66-a7b6b424f840",
                                "sense_id": "6f903578-6475-3018-a815-2c94f64e34cd",
                                "text": "« Il faut être à l’écoute, se conduire en gentleman, avoir de la conversation. Le but : devenir irremplaçable », détaille Nicolas, qui ne ressemble ni à un chippendale, ni à James Bond."
                            }
                        ]
                    }
