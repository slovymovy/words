                    "sense_definition": "Déplacer le siège d'une autorité, d'une institution, d'un gouvernement ou d'une administration dans un autre lieu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'empereur a décidé de <w>transférer</w> le siège de son gouvernement dans une nouvelle capitale.",
                            "target_lang_translations": {
                                "en": "The emperor decided to <w>move</w> the seat of his government to a new capital.",
                                "ru": "Император решил <w>перенести</w> резиденцию своего правительства в новую столицу.",
                                "de": "Der Kaiser beschloss, den Sitz seiner Regierung in eine neue Hauptstadt zu <w>verlegen</w>.",
                                "es": "El emperador decidió <w>trasladar</w> la sede de su gobierno a una nueva capital.",
                                "zh": "皇帝决定把政府所在地<w>迁移</w>到一座新的都城。"
                            }
                        },
                        {
                            "text": "Le ministère a choisi de <w>transférer</w> le tribunal régional dans un bâtiment plus vaste.",
                            "target_lang_translations": {
                                "en": "The ministry chose to <w>relocate</w> the regional court to a larger building.",
                                "ru": "Министерство решило <w>перевести</w> региональный суд в более просторное здание.",
                                "de": "Das Ministerium hat sich dafür entschieden, das Regionalgericht in ein größeres Gebäude zu <w>verlagern</w>.",
                                "es": "El ministerio optó por <w>reubicar</w> el tribunal regional en un edificio más amplio.",
                                "zh": "该部门决定把地区法院<w>迁址</w>到一栋更宽敞的大楼。"
                            }
