                    "common_phrases": [
                        "take a tumble"
                    ],
                    "target_lang_definitions": {
                        "zh": "跌倒，尤其是翻滚着摔倒。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摔了一跤",
                                "target_lang_sense_clarification": "普通说法，指一次摔倒"
                            },
                            {
                                "target_lang_word": "翻滚",
                                "target_lang_sense_clarification": "强调一路滚下去的跌落"
                            }
                        ]
