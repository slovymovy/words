                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc44b19e-c0b7-4e98-83ad-084a70a8159d",
                                "sense_id": "be6f0fdd-4f13-34b8-ba9d-f41e0c16f544",
                                "text": "Настал и третий день, и при восшествии на небе нашем светила великого вняла я громким воплям на бреге отдаленном."
                            },
                            {
                                "example_id": "57d60ecd-7ab9-4b68-b0e6-16d71bc367a4",
                                "sense_id": "be6f0fdd-4f13-34b8-ba9d-f41e0c16f544",
                                "text": "В час восшествия на крест наступает скорбь великая."
                            }
                        ]
                    },
                    {
                        "sense_id": "9267027a-6dd6-3475-8975-809d54e1fa16",
                        "entry_id": "a8d33302-ba61-3d09-aad4-5c99e72d932f",
                        "glosses": [
                            "устар., офиц. вступление на престол, начало царствования"
                        ],
                        "tags": [
                            "только в выражении: восшествие на престол:"
                        ],
                        "examples": [
                            {
                                "example_id": "e63ff2ab-5fbb-405f-96e4-181d17a499de",
                                "sense_id": "9267027a-6dd6-3475-8975-809d54e1fa16",
                                "text": "При восшествии на престол от рождения своего имел 42 года."
                            }
                        ]
                    }
                ],
