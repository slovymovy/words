{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c43f50a-74dd-3f96-ad54-7e4da10edab9",
                    "sense_definition": "A natural talent, knack, or aptitude for doing something well.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "talent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a natural <w>flair</w> for languages and learned Spanish in just six months.",
                            "target_lang_translations": {
                                "ru": "У неё природная <w>способность</w> к языкам, и она выучила испанский всего за шесть месяцев."
                            }
                        },
                        {
                            "text": "The young chef showed an extraordinary <w>flair</w> for combining unexpected ingredients.",
                            "target_lang_translations": {
                                "ru": "Молодой шеф-повар проявил необычайный <w>талант</w> в сочетании неожиданных ингредиентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "gift",
                        "knack",
                        "talent"
                    ],
                    "common_phrases": [
                        "flair for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прирождённый талант, способность или чутьё к успешному выполнению чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "способность",
                                "target_lang_sense_clarification": "природная одарённость, склонность к какому-либо занятию"
                            },
                            {
                                "target_lang_word": "чутьё",
                                "target_lang_sense_clarification": "интуитивная способность или природный дар"
                            },
                            {
                                "target_lang_word": "талант",
                                "target_lang_sense_clarification": "выдающаяся врождённая способность"
                            },
                            {
                                "target_lang_word": "склонность",
                                "target_lang_sense_clarification": "предрасположенность к чему-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45f11bd5-996e-3d34-932f-b3e10d6dc96a",
                    "sense_definition": "A stylish, elegant, or distinctive manner or quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He always dresses with great <w>flair</w> whenever he attends evening events.",
                            "target_lang_translations": {
                                "ru": "Он всегда одевается с большим <w>шиком</w>, когда посещает вечерние мероприятия."
                            }
                        },
                        {
                            "text": "The newly opened restaurant decorated the dining room with artistic <w>flair</w>.",
                            "target_lang_translations": {
                                "ru": "Недавно открывшийся ресторан оформил зал с художественным <w>вкусом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "elan",
                        "elegance",
                        "grace",
                        "panache",
                        "style"
                    ],
                    "common_phrases": [
                        "with flair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стильная, элегантная или самобытная манера; шик, изящество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шик",
                                "target_lang_sense_clarification": "изящество, элегантность и блеск в манере или стиле"
                            },
                            {
                                "target_lang_word": "стиль",
                                "target_lang_sense_clarification": "индивидуальный элегантный вкус или манера"
                            },
                            {
                                "target_lang_word": "своеобразие",
                                "target_lang_sense_clarification": "неповторимость, отличительная особенность"
                            },
                            {
                                "target_lang_word": "изюминка",
                                "target_lang_sense_clarification": "особая привлекательная черта или шарм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79be947b-b49c-3cc6-a292-fe7196d5bd3e",
                    "sense_definition": "A smell or odor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>flair</w> of burning leaves drifted across the garden in the evening breeze.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>запах</w> горящих листьев разнёсся по саду вместе с вечерним ветерком."
                            }
                        },
                        {
                            "text": "The old cellar was filled with the musty <w>flair</w> of damp stone and barrels.",
                            "target_lang_translations": {
                                "ru": "Старый погреб был наполнен затхлым <w>запахом</w> сырого камня и бочек."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage referring to scent"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запах или аромат (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запах",
                                "target_lang_sense_clarification": "ощущение аромата или запаха (устар.)"
                            },
                            {
                                "target_lang_word": "аромат",
                                "target_lang_sense_clarification": "приятный запах (устар.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3ced555-cbc5-3b61-9daa-8850fe44d7b1",
                    "sense_definition": "The sense of smell; olfaction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hunting hounds possess a remarkably keen <w>flair</w> that allows them to track quarry for miles.",
                            "target_lang_translations": {
                                "ru": "Охотничьи гончие обладают удивительно острым <w>чутьём</w>, позволяющим им выслеживать добычу на протяжении многих миль."
                            }
                        },
                        {
                            "text": "The predator relied entirely on its acute <w>flair</w> to locate food in total darkness.",
                            "target_lang_translations": {
                                "ru": "Хищник полностью полагался на свой острый <w>нюх</w>, чтобы находить пищу в полной темноте."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage referring to olfactory sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обоняние, нюх (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нюх",
                                "target_lang_sense_clarification": "обоняние, способность воспринимать запахи (устар.)"
                            },
                            {
                                "target_lang_word": "чутьё",
                                "target_lang_sense_clarification": "обоняние у животных (устар.)"
                            },
                            {
                                "target_lang_word": "обоняние",
                                "target_lang_sense_clarification": "чувство восприятия запахов (устар.)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a415893-0345-31ee-99c9-e3c73d9fea01",
                    "sense_definition": "To add flair, spread out, or spread apart decorative material.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Carefully pull the tying thread tight to <w>flair</w> the deer hair on the hook.",
                            "target_lang_translations": {
                                "ru": "Осторожно затяните монтажную нить, чтобы <w>распушить</w> олений волос на крючке."
                            }
                        },
                        {
                            "text": "The fly tier began <w>flairing</w> the fine fibers to create a full wing shape.",
                            "target_lang_translations": {
                                "ru": "Вязальщик мушек принялся <w>расправлять</w> тонкие волокна, чтобы создать форму пышного крыла."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распушать или расправлять декоративный материал (например, при вязании рыболовных мушек)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распушать",
                                "target_lang_sense_clarification": "расправлять ворсинки или перья веером"
                            },
                            {
                                "target_lang_word": "расправлять",
                                "target_lang_sense_clarification": "раскрывать веером волокна материала"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}