                                        "glosses": [
                                            "Opposition to communism."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1356689e-4edc-49e7-9d21-56092d26f17a",
                                                "sense_id": "f08d436e-070c-36c8-a2b6-ff4750eec41b",
                                                "text": "In the main, anticommunism in postwar America meant opposition to the kind of dictatorial state socialism that existed in Russia and that many Americans saw as a negation of everything America stood for. In the 1946 campaign, for example, when I talked about the \"communist-dominated PAC,\" my remarks were generally understood in this context of dictatorial socialism versus free enterprise."
                                            }
                                        ]
                                    }
