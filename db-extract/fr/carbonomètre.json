                "senses": [
                    {
                        "sense_id": "c080b651-2b90-388c-af35-c818546d02e1",
                        "entry_id": "8df83701-c0c0-321e-9a65-1344c550f751",
                        "glosses": [
                            "Appareil mesurant la quantité d’acide carbonique et, par suite, de carbone, rejetée par les poumons dans l’acte de la respiration."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b249047b-b71e-409d-ac48-ceae4375150b",
                                "sense_id": "c080b651-2b90-388c-af35-c818546d02e1",
                                "text": "Le carbonomètre clinique se compose d’un flacon A, analogue à celui de la figure f, et d’un long tube gradué qui s'adapte au flacon à l’aide d'un bouchon qui le termine."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7acbd80-5278-3757-a7a7-8b2876977af0",
                        "entry_id": "8df83701-c0c0-321e-9a65-1344c550f751",
                        "glosses": [
                            "Spectromètre de masse permettant la datation par le carbone 14."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1de6a734-4be6-4906-817f-f1742e57f9d7",
                                "sense_id": "b7acbd80-5278-3757-a7a7-8b2876977af0",
                                "text": "On pourrait croire que la datation au carbone 14 est un chronomètre et non pas un carbonomètre. Quand on mesure du carbone, la moindre des choses c’est de donner les chiffres bruts. Pourquoi cela n’a-t-il pas été fait ?"
                            }
                        ]
                    }
                ],
