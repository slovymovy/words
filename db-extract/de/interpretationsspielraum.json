                "senses": [
                    {
                        "sense_id": "79301150-e60d-3557-9fb4-54cf8f1b7763",
                        "entry_id": "713039e9-c2c6-3e2f-9c23-b455b5bd78cb",
                        "glosses": [
                            "Möglichkeit, etwas auf verschiedene Weise zu verstehen oder auszulegen (interpretieren); Umfang der jeweiligen Interpretationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d2f8070-efed-416b-bf6d-59778bfa4098",
                                "sense_id": "79301150-e60d-3557-9fb4-54cf8f1b7763",
                                "text": "„Der Name stammt aus dem Nahuatl und bietet hinsichtlich seiner Bedeutung Interpretationsspielräume.“"
                            },
                            {
                                "example_id": "c1197a65-e5c1-467c-b384-403e21d3e618",
                                "sense_id": "79301150-e60d-3557-9fb4-54cf8f1b7763",
                                "text": "„Regelungslücken und Interpretationsspielräume des Völkerrechts erfordern insbesondere durch die veränderte Bedrohungssituation eine Klärung der Legitimität militärischer Gewalt.“"
                            },
                            {
                                "example_id": "a86ce65e-6527-4f1f-ae14-6c7ad9cbef85",
                                "sense_id": "79301150-e60d-3557-9fb4-54cf8f1b7763",
                                "text": "„Die Aussagen von Bruno und Schmadtke lassen viel Interpretationsspielraum.“"
                            },
                            {
                                "example_id": "869ff6c8-1eb4-4112-8b2e-96f65f11b287",
                                "sense_id": "79301150-e60d-3557-9fb4-54cf8f1b7763",
                                "text": "„Die neu veröffentlichten Standards präzisieren die Erwartungen an die Umsetzung und verringern den Interpretationsspielraum, den die DORA selbst offen lässt.“"
                            },
                            {
                                "example_id": "913b2559-5c68-461d-88e2-b90a2b5399d3",
                                "sense_id": "79301150-e60d-3557-9fb4-54cf8f1b7763",
                                "text": "„Die Ziele müssen eindeutig, lösungsneutral, inhaltlich und zeitlich operabel und frei von Interpretationsspielräumen sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
