                "senses": [
                    {
                        "sense_id": "d408223e-371f-351b-82cf-abd71429c89d",
                        "entry_id": "df7111b3-7a7d-31b5-92cc-52b658335959",
                        "glosses": [
                            "Donner un caractère pluriannuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0930286b-89e9-4aab-a4b5-b93f34ed9edf",
                                "sense_id": "d408223e-371f-351b-82cf-abd71429c89d",
                                "text": "Pluriannualiser les dépenses"
                            },
                            {
                                "example_id": "eae58446-de5b-42cf-91de-38f5d20436f3",
                                "sense_id": "d408223e-371f-351b-82cf-abd71429c89d",
                                "text": "Dans la limite de la possibilité juridique de pluriannualiser les financements, celle-ci pourrait être proposée pour ce type de projet, sous condition de l’adoption par l’opérateur d’une démarche de projet et d’exigences en matière d’identification des besoins, de quantification des objectifs et de suivi-évaluation."
                            },
                            {
                                "example_id": "ed7d6895-078a-494d-8395-7a99be03cb10",
                                "sense_id": "d408223e-371f-351b-82cf-abd71429c89d",
                                "text": "6. pluriannualiser l’ensemble des outils d’analyse et d’évaluation budgétaire afin d’assurer une cohérence entre la lecture, l’analyse et la projection d’un côté et la « logique CPOM » pluriannuelle de l’autre, dans l’objectif de responsabiliser la gestion budgétaire."
                            }
                        ]
                    }
