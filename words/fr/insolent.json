    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "103454c4-7d5c-3f53-9fa6-1fece1a33cff",
                    "sense_definition": "Qui manque ouvertement de respect avec effronterie ou audace envers une autorité ou les convenances.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a puni cet élève <w>insolent</w> qui refusait d'écouter les consignes."
                        },
                        {
                            "text": "Il lui a répondu sur un ton <w>insolent</w> qui a choqué toute la classe."
                        }
                    ],
                    "synonyms": [
                        "effronté",
                        "impertinent",
                        "irrespectueux"
                    ],
                    "antonyms": [
                        "respectueux",
                        "poli",
                        "déférent"
                    ],
                    "common_phrases": [
