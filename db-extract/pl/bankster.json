                "senses": [
                    {
                        "sense_id": "ea1f3bd3-132f-3b9e-91db-1bcff4bf027b",
                        "entry_id": "cb8dcc3f-17a9-3da0-995c-0f74f1fddf82",
                        "glosses": [
                            "bankier-gangster, bankier postrzegany jako kryminalista, bezwzględnie wyłudzający pieniądze od obywateli, cynicznie bogacący się kosztem klientów w opresji"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "4805a2eb-871f-4c49-b276-a402386211de",
                                "sense_id": "ea1f3bd3-132f-3b9e-91db-1bcff4bf027b",
                                "text": "Są sprawy, w których nie ma dzielenia włosa na czworo i hamletyzowania. Tak jest w sprawie Grecji – ofiary banksterów, neoliberalnej polityki cięć (…) i egoizmu bogatych krajów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63938fd9-a558-42d1-a7d9-99f10526d084",
                        "source_entry_id": "cb8dcc3f-17a9-3da0-995c-0f74f1fddf82",
                        "source_sense_id": "ea1f3bd3-132f-3b9e-91db-1bcff4bf027b",
                        "target_lang_word": "bankster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bankster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b2d7db-8e89-33b1-8ef7-cb30c382db80",
                                        "entry_id": "b44b6f3c-f689-3edb-9ae2-e7e1104ec79e",
                                        "glosses": [
                                            "A banker who is seen as criminally irresponsible, or as extorting bailout money from the taxpayers."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3457676e-a663-409b-8e2c-c9d94f0f0ce4",
                                                "sense_id": "f9b2d7db-8e89-33b1-8ef7-cb30c382db80",
                                                "text": "Hearing Sir Fred the Shred and the rest of them utter some hedged half-apologies has not made the public feel any warmer to the banksters."
                                            },
                                            {
                                                "example_id": "be049aee-8f4e-4308-9b56-c18243b9384d",
                                                "sense_id": "f9b2d7db-8e89-33b1-8ef7-cb30c382db80",
                                                "text": "Stop supporting bums abroad. Stop all foreign aid, which is aid to banksters and their bonds and their export industries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96303b25-e5aa-45b5-bc61-b9b68998dff8",
                        "source_entry_id": "cb8dcc3f-17a9-3da0-995c-0f74f1fddf82",
                        "source_sense_id": "ea1f3bd3-132f-3b9e-91db-1bcff4bf027b",
                        "target_lang_word": "bankster",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bankster",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88967944-8a57-3ea8-ab31-e8817d2763a7",
                                        "entry_id": "49e95227-0e98-3715-ae72-72d7744ba37b",
                                        "glosses": [
                                            "Banquier profiteur et malhonnête."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2f36214-54a9-454b-9764-77766cb1ea50",
                                                "sense_id": "88967944-8a57-3ea8-ab31-e8817d2763a7",
                                                "text": "Malgré les réticences du Congrès, l’Administration américaine ne regarde pas à la dépense à l’heure de venir à la rescousse des banksters (banquiers gangsters)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "682654db-ed72-4cca-b9b8-96a317559578",
                        "source_entry_id": "cb8dcc3f-17a9-3da0-995c-0f74f1fddf82",
                        "source_sense_id": "ea1f3bd3-132f-3b9e-91db-1bcff4bf027b",
                        "target_lang_word": "Bankster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bankster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c60929ea-e43e-3f0e-aecd-22ef88e59fc3",
                                        "entry_id": "3c1b0a7e-2cc6-3343-b2f5-4b347103671b",
                                        "glosses": [
                                            "korrupter Banker"
                                        ],
                                        "tags": [
                                            "casual",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3bf3fe7-a234-4643-990f-faec0b6dd8a0",
                                                "sense_id": "c60929ea-e43e-3f0e-aecd-22ef88e59fc3",
                                                "text": "„Die Kaltschnäuzigkeit der „Bankster“, ihre atemberaubend vulgäre Sprache und ihre dummdreisten Erpressungsversuche gegenüber handzahmen Aufsichtsbehörden - jeder kann all das nun mit eigenen Ohren hören, und viele sehen ihre schlimmsten Befürchtungen über die Auswüchse im Finanzgeschäft bestätigt.“"
                                            },
                                            {
                                                "example_id": "1ce1f738-ccc1-4945-9f1d-73a8d2ffa474",
                                                "sense_id": "c60929ea-e43e-3f0e-aecd-22ef88e59fc3",
                                                "text": "„Einer zwitschert in die Runde, es laufe ihm eiskalt den Rücken herunter, wenn ein „Whistleblower in die Klapse“ gehe, während die „Bankster ungeschoren“ davonkämen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
