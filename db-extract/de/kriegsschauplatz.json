                        ],
                        "form": "den Kriegsschauplatz"
                    },
                    {
                        "form_id": "c6ca2e03-d3cf-4e0d-af8e-214e174aa59a",
                        "entry_id": "41560209-bbd2-3986-b1dd-080915bae7cd",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kriegsschauplätze"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62e68b9d-8284-389a-b09d-f35ccc92efda",
                        "entry_id": "41560209-bbd2-3986-b1dd-080915bae7cd",
                        "glosses": [
                            "Ort, an dem militärische Kampfhandlungen stattfinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4ebbbfb-c677-41ff-b64c-9b2ce301c59d",
                                "sense_id": "62e68b9d-8284-389a-b09d-f35ccc92efda",
                                "text": "„Mit dem Kriegseintritt des Königreichs Italien an der der Seite der Achsenmächten im Juni 1940 wurde auch Nordafrika zum Kriegsschauplatz.“"
                            },
                            {
                                "example_id": "57742ed5-89c6-4798-b990-2946339ee493",
                                "sense_id": "62e68b9d-8284-389a-b09d-f35ccc92efda",
                                "text": "„In einem Staatswesen, das keine Trennung zwischen militärischer und ziviler Gewalt kannte, in dem Politiker Heerführer und Heerführer Politiker waren, stellte der der Oberbefehl auf bedeutenden Kriegsschauplätzen von jeher ein Politikum dar.“"
                            },
                            {
                                "example_id": "83c3c2f1-4970-409b-9b54-700902ff38d9",
                                "sense_id": "62e68b9d-8284-389a-b09d-f35ccc92efda",
                                "text": "„Ein wichtiger Kriegsschauplatz war Apulien.“"
                            },
                            {
                                "example_id": "13130032-f16c-4e68-8d45-e269764d9845",
                                "sense_id": "62e68b9d-8284-389a-b09d-f35ccc92efda",
                                "text": "„Der Meinungsaustausch der beiden Staatsmänner galt vor allem dem fernöstlichen Kriegsschauplatz.“"
                            },
                            {
                                "example_id": "b12fa228-6ee3-4526-afc3-f3c6e7df35c0",
                                "sense_id": "62e68b9d-8284-389a-b09d-f35ccc92efda",
                                "text": "„In den wenigen Jahren von 1757 bis 1764 bestimmten vier Schlachten, die in keiner Verbindung zueinander standen und auf weit voneinander entfernten Kriegsschauplätzen stattfanden, den weiteren Verlauf der indischen Geschichte.“"
                            },
                            {
                                "example_id": "21254626-8763-4ee1-963b-b96cb59e710f",
                                "sense_id": "62e68b9d-8284-389a-b09d-f35ccc92efda",
                                "text": "„Der Highway da ist ein regelrechter Kriegsschauplatz, wenn du die Wahrheit wissen willst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76752c8d-a5d1-46b6-97c5-b76f2eabb9d5",
                        "source_entry_id": "41560209-bbd2-3986-b1dd-080915bae7cd",
                        "source_sense_id": "62e68b9d-8284-389a-b09d-f35ccc92efda",
                        "source_sense_description": "Ort, an dem militärische Kampfhandlungen stattfinden",
                        "target_lang_word": "theater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8e85125-8f9d-3d2c-b7fe-2863b840b042",
                                        "entry_id": "445e7264-0689-3bf7-ad01-93d05f83f54d",
                                        "glosses": [
                                            "A place or building, consisting of a stage and seating, in which an audience gathers to watch plays, musical performances, public ceremonies, and so on."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f485215b-0964-3fbb-9c41-9c7e2a706d73",
                                        "entry_id": "445e7264-0689-3bf7-ad01-93d05f83f54d",
                                        "glosses": [
                                            "A region where a particular action takes place; a specific field of action, usually with reference to war."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe7c9226-f965-4975-902c-54fed1839cc9",
                                                "sense_id": "f485215b-0964-3fbb-9c41-9c7e2a706d73",
                                                "text": "His grandfather was in the Pacific theater during the war."
                                            },
                                            {
                                                "example_id": "88918b8a-3a7b-4d0c-8c96-e59228350013",
                                                "sense_id": "f485215b-0964-3fbb-9c41-9c7e2a706d73",
                                                "text": "Percy had been too big for the town since he got back from the war. He served in the Pacific theater, behind the lines keeping up the supply chain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b39128e-0597-3c4b-b364-d50d4b576299",
                                        "entry_id": "445e7264-0689-3bf7-ad01-93d05f83f54d",
                                        "glosses": [
                                            "A lecture theatre."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "761452da-e084-339b-a864-3ca58dace7e9",
                                        "entry_id": "445e7264-0689-3bf7-ad01-93d05f83f54d",
                                        "glosses": [
                                            "An operating theatre or locale for human experimentation."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f57ced9-c957-4db1-8ac8-869e33122251",
                                                "sense_id": "761452da-e084-339b-a864-3ca58dace7e9",
                                                "text": "This man is about to die, get him into theater at once!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e5291eb-5e9d-38a4-9d08-3c2055726935",
                                        "entry_id": "445e7264-0689-3bf7-ad01-93d05f83f54d",
                                        "glosses": [
                                            "A cinema."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea55fa84-6296-48ad-837f-920aa868e432",
                                                "sense_id": "0e5291eb-5e9d-38a4-9d08-3c2055726935",
                                                "text": "We sat in the back row of the theater and threw popcorn at the screen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "414f3a49-108d-3e8e-a2e5-dfa5fe582e35",
                                        "entry_id": "445e7264-0689-3bf7-ad01-93d05f83f54d",
                                        "glosses": [
                                            "Drama or performance as a profession or art form."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d7390dc-2412-4755-a20e-26b27dd883ab",
                                                "sense_id": "414f3a49-108d-3e8e-a2e5-dfa5fe582e35",
                                                "text": "I worked in theater for twenty-five years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cec7bba-6a84-36df-9bd7-61c89e6b5987",
                                        "entry_id": "445e7264-0689-3bf7-ad01-93d05f83f54d",
                                        "glosses": [
                                            "Any place rising by steps like the seats of a theater."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03fef510-55be-3074-ad61-437e79d492a0",
                                        "entry_id": "445e7264-0689-3bf7-ad01-93d05f83f54d",
                                        "glosses": [
                                            "A conspicuous but unproductive display of action."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "derogatory",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56c2cf9b-e387-418a-875c-a3910bac8060",
                                                "sense_id": "03fef510-55be-3074-ad61-437e79d492a0",
                                                "text": "The Senate confirmation hearings were just theater."
                                            },
                                            {
                                                "example_id": "f4448c8e-1821-4293-9efc-a937f28c59c3",
                                                "sense_id": "03fef510-55be-3074-ad61-437e79d492a0",
                                                "text": "security theater; hygiene theater"
                                            },
                                            {
                                                "example_id": "eb83d7ae-c881-4c34-b9c1-ce51f3ca1380",
                                                "sense_id": "03fef510-55be-3074-ad61-437e79d492a0",
                                                "text": "ACTA proponents rely on claims of a growing piracy and counterfeiting threat. In the absence of credible evidence of the threat or that the measures in ACTA will reduce the threat, ACTA is no more than enforcement theater."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
