                "senses": [
                    {
                        "sense_id": "69c7e641-acf3-3137-86d8-5df53155ebe8",
                        "entry_id": "e3b1fb22-a5ea-3d9c-b132-dd8966a46dd2",
                        "glosses": [
                            "Ort (Stelle) der Anlagerung, zum Beispiel eines Botenstoffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37ffa1a0-a202-4a62-9095-cbf2407540d4",
                                "sense_id": "69c7e641-acf3-3137-86d8-5df53155ebe8",
                                "text": "„In dieser neuen Struktur ist die Bindestelle für das Ribosom in einer helikalen Struktur eingeschlossen und für die Anlagerung des Ribosoms blockiert (Abb. 2b, rechts). Die Translation wird dadurch verhindert.“"
                            },
                            {
                                "example_id": "9a2a1349-1e52-4e1e-9dfa-14f08ae161d3",
                                "sense_id": "69c7e641-acf3-3137-86d8-5df53155ebe8",
                                "text": "„Wie oben schon kurz erwähnt, basiert der kompetitive Assay auf Konkurrenz, und zwar auf Konkurrenz zweier Antigenpopulationen um die gleichen freien Bindestellen einer Antikörperpopulation in einem definierten Lösungsvolumen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
