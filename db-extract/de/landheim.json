                        "sense_id": "9653a90e-c554-3897-9bd8-e4bbe76026e2",
                        "entry_id": "34e49f05-5e92-34e6-bed6-586c5726019a",
                        "glosses": [
                            "Einrichtung zum Wohnen (und Lernen) auf dem Land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ca930ef-7077-4b5f-bc71-2a9d0af48dbe",
                                "sense_id": "9653a90e-c554-3897-9bd8-e4bbe76026e2",
