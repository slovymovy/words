                    {
                        "translation_id": "0ada74f1-6335-4e06-91a7-7bef05714aa3",
                        "source_entry_id": "df2681ea-40ed-3d57-b3f3-fd59b656eb8a",
                        "source_sense_id": "b387d08a-44bb-313f-8bd4-61392b12b276",
