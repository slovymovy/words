                "senses": [
                    {
                        "sense_id": "a6223e81-4e85-343c-9a23-6c072793a807",
                        "entry_id": "76b816e6-066f-36c2-bc39-9f1d158da548",
                        "glosses": [
                            "presentjes die traditioneel met Kerstmis gegeven worden"
                        ],
                        "tags": [
                            "kerst"
                        ],
                        "examples": [
                            {
                                "example_id": "934b2140-6600-4b68-8f72-4d8d473f6190",
                                "sense_id": "a6223e81-4e85-343c-9a23-6c072793a807",
                                "text": "Wij geven elkaar met Sinterklaas én met Kerstmis cadeautjes, de kerstcadeaus zijn echter niet voorzien van een gedicht."
                            },
                            {
                                "example_id": "88bebe1f-91e4-4a8d-80c5-35fadb71fc5c",
                                "sense_id": "a6223e81-4e85-343c-9a23-6c072793a807",
                                "text": "Zielepoot John (Mark Wahlberg) krijgt een pratende teddybeer als kerstcadeau. Deze Ted wordt een nationale sensatie, maar blijft John altijd trouw. Zo’n twintig jaar later zit de pluizige smeerkees de hele dag met John op de bank om onder het genot van ‘bong and brewski’ (waterpijp en bier) slechte televisie te kijken."
                            },
                            {
                                "example_id": "da8cb9c1-085d-4f5e-b1e7-3f451321fd32",
                                "sense_id": "a6223e81-4e85-343c-9a23-6c072793a807",
                                "text": "Volgens de traditie zouden ze er nu een uur blijven zitten, noten kraken, dadels, vijgen en marsepeinen varkentjes eten en misschien wat conserveren over de geslaagde kerstcadeaus, de heerlijke schapenworst uit Osteroy en meer van dat soort onschuldige onderwerpen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7282d4a4-15c8-4eda-9dc6-3d17d045d3b6",
                        "source_entry_id": "76b816e6-066f-36c2-bc39-9f1d158da548",
                        "source_sense_id": "a6223e81-4e85-343c-9a23-6c072793a807",
                        "target_lang_word": "Weihnachtsgeschenk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weihnachtsgeschenk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c840c82-6f60-3101-b954-23b7de5b2c3d",
                                        "entry_id": "910bca74-b24b-3445-92aa-665d5fdb7625",
                                        "glosses": [
                                            "Geschenk, das traditionell zu Weihnachten zur Weihnachtsbescherung gemacht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abee2a0a-bcc3-4b55-9529-26b6d54448e9",
                                                "sense_id": "7c840c82-6f60-3101-b954-23b7de5b2c3d",
                                                "text": "Ich muss noch Weihnachtsgeschenke einkaufen."
                                            },
                                            {
                                                "example_id": "590c000f-2be1-4707-bfdf-3592ac25030f",
                                                "sense_id": "7c840c82-6f60-3101-b954-23b7de5b2c3d",
                                                "text": "Hast du schon alle Weihnachtsgeschenke besorgt?"
                                            },
                                            {
                                                "example_id": "e00ca4de-be68-48fc-a02d-1cc8a06a2724",
                                                "sense_id": "7c840c82-6f60-3101-b954-23b7de5b2c3d",
                                                "text": "„Auf dem Nachttisch verstaubte Weihnachtsgeschenke, ein von Kindern ausgeschnittener und aufgeklebter Bahnhof mit rennenden Menschen, die ganz still standen, ein Pflaumenmann und: „Flieger über Rostock“, ein Bild, das Robert gemalt hatte.“"
                                            },
                                            {
                                                "example_id": "df9c7d06-472b-4475-adc6-8ea2b681f861",
                                                "sense_id": "7c840c82-6f60-3101-b954-23b7de5b2c3d",
                                                "text": "„In den frühen Jahren des Vereins kommt es auch noch zur Übergabe von Hilfspaketen und Weihnachtsgeschenken aus unterschiedlichen Quellen.“"
                                            },
                                            {
                                                "example_id": "f41ad7ac-36a3-4896-a181-c6c6ce27a4f4",
                                                "sense_id": "7c840c82-6f60-3101-b954-23b7de5b2c3d",
                                                "text": "„Nun kauft er Weihnachtsgeschenke, freut sich über eine Buchhandlung in seiner Nachbarschaft und lädt uns zur Silversterparty ein.“"
                                            },
                                            {
                                                "example_id": "f1816b2d-b7b9-468c-b1f5-27c30512002f",
                                                "sense_id": "7c840c82-6f60-3101-b954-23b7de5b2c3d",
                                                "text": "„Wenn man außerdem noch am Neujahrsmorgen die Weihnachtsgeschenke zum Umtausch bereitlegt und pflichtgemäß dem Winterschlussverkauf entgegenfiebert, kann die Gefahr weihnachtlicher Besinnung als überwunden angesehen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9641772e-5c5a-4aee-94b8-c97532bee882",
                        "source_entry_id": "76b816e6-066f-36c2-bc39-9f1d158da548",
