                    {
                        "translation_id": "1a39bf8d-c080-41f7-8019-abba81eda777",
                        "source_entry_id": "46d64973-ea5b-37d8-9f85-9353018ceb31",
                        "source_sense_id": "2b043fb3-b373-3dd3-8050-2d956a6aa815",
                        "target_lang_word": "ascetismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
