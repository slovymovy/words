{
    "word_family": [
        "revolutionary",
        "revolutionize",
        "revolve",
        "revolver",
        "counter-revolution",
        "revolutionist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2752e254-efe2-33c1-8078-3c8c87567315",
                    "sense_definition": "The popular removal and replacement of a government, especially by sudden violent action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "political_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens started a <w>revolution</w> to overthrow the dictator.",
                            "target_lang_translations": {
                                "ru": "Граждане начали <w>революцию</w>, чтобы свергнуть диктатора.",
                                "zh": "公民们发动了一场<w>革命</w>以推翻独裁者。"
                            }
                        },
                        {
                            "text": "After the <w>revolution</w>, the country established a new republic.",
                            "target_lang_translations": {
                                "ru": "После <w>революции</w> страна провозгласила новую республику.",
                                "zh": "<w>革命</w>后，该国建立了一个新的共和国。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "French Revolution",
                        "start a revolution",
                        "political revolution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смена правительства и политического режима, обычно осуществляемая насильственным путем при участии широких масс.",
                        "zh": "指通过暴力手段推翻并取代现有政府的政治运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "револю́ция",
                                "target_lang_sense_clarification": "политическая"
                            },
                            {
                                "target_lang_word": "переворо́т",
                                "target_lang_sense_clarification": "смена власти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "革命",
                                "target_lang_sense_clarification": "政治变革"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1c5f7cb-c7bb-307d-b680-e40145f8749a",
                    "sense_definition": "A sudden, vast change in a situation, a discipline, or the way of thinking and behaving.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invention of the internet caused a <w>revolution</w> in communication.",
                            "target_lang_translations": {
                                "ru": "Изобретение интернета произвело <w>революцию</w> в общении.",
                                "zh": "互联网的发明引发了一场通讯领域的<w>革命</w>。"
                            }
                        },
                        {
                            "text": "We are witnessing a digital <w>revolution</w> that is changing how we work.",
                            "target_lang_translations": {
                                "ru": "Мы являемся свидетелями цифровой <w>революции</w>, которая меняет то, как мы работаем.",
                                "zh": "我们正在见证一场正在改变我们工作方式的数字<w>革命</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "evolution"
                    ],
                    "common_phrases": [
                        "industrial revolution",
                        "technological revolution",
                        "cultural revolution",
                        "digital revolution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное, масштабное изменение в какой-либо ситуации, дисциплине или образе мышления.",
                        "zh": "指在某个领域、学科或思维方式上发生的巨大且突然的变革。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "револю́ция",
                                "target_lang_sense_clarification": "коренное преобразование"
                            },
                            {
                                "target_lang_word": "переворо́т",
                                "target_lang_sense_clarification": "резкое изменение в развитии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "革命",
                                "target_lang_sense_clarification": "根本性变革"
                            },
                            {
                                "target_lang_word": "变革",
                                "target_lang_sense_clarification": "重大改变"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8b26332-4668-34f0-b4d9-498bcace6f19",
                    "sense_definition": "The movement of a celestial body along an orbit around another body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It takes 365 days for the Earth to complete one <w>revolution</w> around the sun.",
                            "target_lang_translations": {
                                "ru": "Земле требуется 365 дней, чтобы совершить один <w>оборот</w> вокруг Солнца.",
                                "zh": "地球绕太阳<w>公转</w>一周需要365天。"
                            }
                        },
                        {
                            "text": "The moon makes a full <w>revolution</w> around our planet every month.",
                            "target_lang_translations": {
                                "ru": "Луна совершает полный <w>оборот</w> вокруг нашей планеты каждый месяц.",
                                "zh": "月球每月绕地球<w>公转</w>一周。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "revolution around the sun",
                        "orbital revolution"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение небесного тела по орбите вокруг другого тела.",
                        "zh": "指天体沿轨道绕另一个天体运行的运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оборо́т",
                                "target_lang_sense_clarification": "полный круг по орбите"
                            },
                            {
                                "target_lang_word": "враще́ние",
                                "target_lang_sense_clarification": "процесс движения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公转",
                                "target_lang_sense_clarification": "天体轨道运动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f59f068-c00d-355a-883b-fbccfb03c1b3",
                    "sense_definition": "One complete circular turn of an object around an axis.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine was running at three thousand <w>revolutions</w> per minute.",
                            "target_lang_translations": {
                                "ru": "Двигатель работал на скорости три тысячи <w>оборотов</w> в минуту.",
                                "zh": "发动机以每分钟三千<w>转</w>的速度运转。"
                            }
                        },
                        {
                            "text": "The wheel made one full <w>revolution</w> before coming to a stop.",
                            "target_lang_translations": {
                                "ru": "Колесо сделало один полный <w>оборот</w>, прежде чем остановиться.",
                                "zh": "轮子在停下之前完整地<w>转</w>了一圈。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rev"
                    ],
                    "common_phrases": [
                        "revolutions per minute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один полный поворот объекта вокруг своей оси.",
                        "zh": "指物体绕轴心完成的一次完整圆周运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оборо́т",
                                "target_lang_sense_clarification": "вокруг оси"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转",
                                "target_lang_sense_clarification": "旋转次数"
                            },
                            {
                                "target_lang_word": "圈",
                                "target_lang_sense_clarification": "旋转一周"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "da1a2150-49bb-3ca2-92c1-fb14aa17ab01",
                    "sense_definition": "The American Revolution (1775–1783).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "Many soldiers fought bravely during the <w>Revolution</w> to gain independence.",
                            "target_lang_translations": {
                                "ru": "Многие солдаты храбро сражались во время <w>Революции</w>, чтобы обрести независимость.",
                                "zh": "许多士兵在<w>美国革命</w>期间英勇作战以争取独立。"
                            }
                        },
                        {
                            "text": "Two centuries after the <w>Revolution</w>, the country celebrated its history.",
                            "target_lang_translations": {
                                "ru": "Два столетия спустя после <w>Революции</w> страна отпраздновала свою историю.",
                                "zh": "在<w>美国革命</w>两个世纪后，这个国家庆祝了它的历史。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Американская революция (Война за независимость США, 1775–1783).",
                        "zh": "指美国独立战争（1775–1783）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Револю́ция",
                                "target_lang_sense_clarification": "историческое событие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美国革命",
                                "target_lang_sense_clarification": "历史事件"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}