                    },
                    {
                        "translation_id": "fb128e00-4a60-4c4f-9af4-fe13abe4287e",
                        "source_entry_id": "15ad261f-319d-38da-8b5b-2df646c2acc8",
                        "source_sense_id": "32f93749-2ed3-3cad-9f9d-7a8aedaa2d97",
                        "target_lang_word": "Pikett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pikett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d0cc827-09c9-371b-b6eb-444b92ee21c4",
                                        "entry_id": "90f65000-dfa1-3a93-b549-2d84102c64c4",
                                        "glosses": [
                                            "französisches Kartenspiel für zwei Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c26e60-fa07-4a25-9085-f4826a6bc7fd",
                                                "sense_id": "9d0cc827-09c9-371b-b6eb-444b92ee21c4",
                                                "text": "„Er bestand darauf, daß ich mit ihm speiste, und schlug mir dann eine Partie Pikett vor; bis zum Abend verlor ich drei oder vier Dukaten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f187e2d-9ed1-387c-a1a8-0098092cdc47",
                                        "entry_id": "90f65000-dfa1-3a93-b549-2d84102c64c4",
                                        "glosses": [
                                            "einsatzbereite Mannschaft bei Feuerwehr, Militär oder Polizei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab013f35-6bc3-4793-a7e5-bac34ed560c2",
                                                "sense_id": "3f187e2d-9ed1-387c-a1a8-0098092cdc47",
                                                "text": "„Nahe an diesem verriet das Glänzen der Musketen ein starkes Pikett, das wahrscheinlich bestimmt war, die Boote zu bewachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
