    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ad903d7e-d153-3904-9a93-0f130337c345",
                    "sense_definition": "In voorwaartse richting.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "direction_side",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij liep naar <w>voren</w> toen zijn naam genoemd werd.",
                            "target_lang_translations": {
                                "en": "He walked <w>forward</w> when his name was called.",
                                "ru": "Он вышел <w>вперёд</w>, когда назвали его имя.",
                                "fr": "Il s'est avancé <w>vers l'avant</w> lorsque son nom a été appelé."
                            }
                        },
                        {
                            "text": "Wil je alsjeblieft een stap naar <w>voren</w> doen?",
                            "target_lang_translations": {
                                "en": "Could you please take a step <w>forward</w>?",
                                "ru": "Не могли бы вы сделать шаг <w>вперёд</w>?",
                                "fr": "Pourriez-vous faire un pas <w>en avant</w>, s'il vous plaît ?"
                            }
                        }
                    ],
                    "antonyms": [
                        "achteren"
                    ],
                    "common_phrases": [
                        "naar voren",
                        "naar voren komen",
                        "naar voren brengen"
                    ],
                    "target_lang_definitions": {
                        "en": "In a forward direction.",
                        "ru": "В направлении вперёд.",
                        "fr": "Vers l'avant ; dans une direction qui avance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forward",
                                "target_lang_sense_clarification": "direction of movement"
                            },
                            {
                                "target_lang_word": "to the front",
                                "target_lang_sense_clarification": "movement towards the front part"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вперёд",
                                "target_lang_sense_clarification": "направление движения"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "vers l'avant",
                                "target_lang_sense_clarification": "direction du mouvement"
                            },
                            {
                                "target_lang_word": "en avant",
                                "target_lang_sense_clarification": "mouvement vers l'avant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58b7fa65-12b9-3a41-b92b-cf517963d1b0",
                    "sense_definition": "Aan of van de voorzijde.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction_side",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto is van <w>voren</w> zwaar beschadigd na het ongeluk.",
                            "target_lang_translations": {
                                "en": "The car is heavily damaged at the <w>front</w> after the accident.",
                                "ru": "Машина сильно повреждена <w>спереди</w> после аварии.",
                                "fr": "La voiture est lourdement endommagée <w>à l'avant</w> après l'accident."
                            }
                        },
                        {
                            "text": "We moeten weer helemaal van <w>voren</w> af aan beginnen.",
                            "target_lang_translations": {
                                "en": "We have to start all over from the <w>beginning</w>.",
                                "ru": "Нам придётся начать всё <w>сначала</w>.",
                                "fr": "Nous devons tout recommencer depuis <w>le début</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "achteren"
                    ],
                    "common_phrases": [
                        "van voren",
                        "van voren af aan"
                    ],
                    "target_lang_definitions": {
                        "en": "At or from the front side.",
                        "ru": "С передней стороны или у передней части.",
                        "fr": "À ou depuis la partie avant ; au commencement (au figuré)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "from the front",
                                "target_lang_sense_clarification": "origin or perspective"
                            },
                            {
                                "target_lang_word": "at the front",
                                "target_lang_sense_clarification": "location"
                            },
                            {
                                "target_lang_word": "from the beginning",
                                "target_lang_sense_clarification": "idiomatic: starting over"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спереди",
                                "target_lang_sense_clarification": "местоположение или сторона"
                            },
                            {
                                "target_lang_word": "сначала",
                                "target_lang_sense_clarification": "идиоматическое: с самого начала"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "de devant",
                                "target_lang_sense_clarification": "depuis la façade ou l'avant"
                            },
                            {
                                "target_lang_word": "à l'avant",
                                "target_lang_sense_clarification": "emplacement sur la partie antérieure"
                            },
                            {
                                "target_lang_word": "du début",
                                "target_lang_sense_clarification": "idiomatique : recommencer depuis le début"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85dc1c4e-014c-3389-a169-b0602b4eacac",
                    "sense_definition": "Een zoetwatervis uit de karperfamilie, vaak met rode vinnen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij ving tijdens het vissen alleen maar een paar kleine <w>vorentjes</w>.",
                            "target_lang_translations": {
                                "en": "While fishing, he only caught a few small <w>roaches</w>.",
                                "ru": "Во время рыбалки он поймал лишь несколько маленьких <w>плотвичек</w>.",
                                "fr": "En pêchant, il n'a attrapé que quelques petits <w>gardons</w>."
                            }
                        },
                        {
                            "text": "In deze heldere beek zwemmen veel <w>vorens</w>.",
                            "target_lang_translations": {
                                "en": "Many <w>roaches</w> swim in this clear brook.",
                                "ru": "В этом чистом ручье плавает много <w>плотвы</w>.",
                                "fr": "De nombreux <w>gardons</w> nagent dans ce ruisseau limpide."
                            }
                        }
                    ],
                    "synonyms": [
                        "voorn"
                    ],
                    "target_lang_definitions": {
                        "en": "A freshwater fish of the carp family, often with red fins.",
                        "ru": "Пресноводная рыба семейства карповых, часто с красными плавниками.",
                        "fr": "Poisson d'eau douce de la famille des cyprinidés, souvent doté de nageoires rouges (gardon)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "roach",
                                "target_lang_sense_clarification": "fish species"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "плотва",
                                "target_lang_sense_clarification": "вид рыбы"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "gardon",
                                "target_lang_sense_clarification": "espèce de poisson"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35dd21ee-f42f-3c16-8967-e18e642f6468",
                    "sense_definition": "Meervoud van <w>vore</w>: een smalle geul in de aarde, meestal gemaakt door een ploeg.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer trok diepe <w>voren</w> in de vruchtbare akker.",
                            "target_lang_translations": {
                                "en": "The farmer plowed deep <w>furrows</w> in the fertile field.",
                                "ru": "Фермер проложил глубокие <w>борозды</w> на плодородном поле.",
                                "fr": "Le fermier a tracé de profonds <w>sillons</w> dans le champ fertile."
                            }
                        },
                        {
                            "text": "Na de regenbui bleef het water in de <w>voren</w> staan.",
                            "target_lang_translations": {
                                "en": "After the rain shower, the water remained standing in the <w>furrows</w>.",
                                "ru": "После ливня вода стояла в <w>бороздах</w>.",
                                "fr": "Après l'averse, l'eau a stagné dans les <w>sillons</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'vore': a narrow trench in the earth, usually made by a plow.",
                        "ru": "Множественное число от 'vore': узкие канавки в земле, обычно сделанные плугом.",
                        "fr": "Pluriel de « vore » : tranchée étroite creusée dans la terre, généralement par une charrue."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "furrows",
                                "target_lang_sense_clarification": "agriculture"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "борозды",
                                "target_lang_sense_clarification": "сельское хозяйство"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sillons",
                                "target_lang_sense_clarification": "agriculture, tranchées creusées par la charrue"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}