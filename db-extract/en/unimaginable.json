                                "target_senses": [
                                    {
                                        "sense_id": "be53d418-89a3-3792-b350-38b419d8e964",
                                        "entry_id": "670be017-d9b1-325d-adaf-ab91b61d9d8a",
                                        "glosses": [
                                            "waarvan men zich vooraf geen voorstelling kon maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c61288e-d672-4112-914d-c8e7289793a2",
                                                "sense_id": "be53d418-89a3-3792-b350-38b419d8e964",
                                                "text": "Spanje is het meest in het oog springende voorbeeld, waar extra bezuinigen de recordwerkloosheid van 24 procent tot nog onvoorstelbaarder hoogte zullen [sic!] opstuwen"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab6b1ade-4e9a-4cf1-827f-5a4b341d0274",
                        "source_entry_id": "4f7e6b68-2c65-300c-b359-70dece715092",
                        "source_sense_id": "5920f36d-55d2-3cf9-9a68-d08493d04ec6",
                        "source_sense_description": "unable to be imagined",
                        "target_lang_word": "inimaginable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inimaginable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ec25056-7ac7-376e-b85f-564a2320049d",
                                        "entry_id": "01ad30ba-0e40-35e0-b1fd-8a14e3e44aa7",
                                        "glosses": [
                                            "Que l’on ne peut imaginer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12016a3d-b03c-4446-ae5c-fff13b36e6db",
                                                "sense_id": "3ec25056-7ac7-376e-b85f-564a2320049d",
                                                "text": "Ce qu'échangeaient les deux amies de sentiments élevés, exquis et mystérieux, est inimaginable."
                                            },
                                            {
                                                "example_id": "d725656a-bb6a-47b7-9fc8-f2ca37973bcf",
                                                "sense_id": "3ec25056-7ac7-376e-b85f-564a2320049d",
                                                "text": "L’effondrement, bien qu’il se produisît de toutes parts, demeurait inimaginable, incroyable."
                                            },
                                            {
                                                "example_id": "3fae6471-e612-463f-b281-cad2a4772c7e",
                                                "sense_id": "3ec25056-7ac7-376e-b85f-564a2320049d",
                                                "text": "Contrairement à beaucoup d’érudits en chambre, notre confrère profitait de ses inspections communales pour mener ses enquêtes sociologiques ou folkloriques sur le terrain, souvent dans des conditions d’inconfort inimaginables."
                                            },
                                            {
                                                "example_id": "4c603340-2a8b-4128-a116-c94679e619b0",
                                                "sense_id": "3ec25056-7ac7-376e-b85f-564a2320049d",
                                                "text": "Mais qu'à l'époque tu étais maladivement pudibond. Inconcevable l'idée de comparaître tout nu sous les yeux du conseil de révision. Inimaginable, pour toi, l'idée de te faire examiner. Reluquer. Palper. Insupportable."
                                            },
                                            {
                                                "example_id": "d97c2ec5-a397-4114-8f2b-16691fcdf204",
                                                "sense_id": "3ec25056-7ac7-376e-b85f-564a2320049d",
                                                "text": "Le budget est colossal pour un film de cul : 10 millions d’Euros ! Un truc inimaginable. On s'est mis à cinq maisons de prod’ pour arriver à boucler les crédits, quelques télés nous ont suivi aussi, par je ne sais quel miracle..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inimaginable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66e510c5-7ba8-334d-ae27-97ec7160625b",
                                        "entry_id": "b296692b-a3a3-3783-9e4d-ddc12fe2f265",
                                        "glosses": [
                                            "Ce que l’on ne peut, ou que l'on ne saurait, imaginer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2c4cba7-f0e5-4ed1-9805-9e0b31e1c62f",
                                                "sense_id": "66e510c5-7ba8-334d-ae27-97ec7160625b",
                                                "text": "L'évêque constitutionnel de Rhône-et-Loire : Lamourette, ayant conjuré ses collègues de s'unir « pour rendre l'ordre à l'Empire et la sécurité à la nation », l’inimaginable s'était produit : Feuillants et Jacobins, la Montagne et la Plaine, avaient oublié leur mutuel soupçon, leurs accusations réciproques, en se jurant de ne plus songer qu'au salut public."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01bf59e0-86ba-4870-adbc-1c5716a23ea3",
                        "source_entry_id": "4f7e6b68-2c65-300c-b359-70dece715092",
                        "source_sense_id": "5920f36d-55d2-3cf9-9a68-d08493d04ec6",
                        "source_sense_description": "unable to be imagined",
                        "target_lang_word": "unvorstellbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unvorstellbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "583f0f7b-8ca6-3767-a00a-484922b1cd1f",
                                        "entry_id": "ab9dac45-2bfc-3c8b-b491-cf3c10914154",
                                        "glosses": [
                                            "dem Verstand oder der Fantasie nicht zugänglich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eb7ab8b-3c91-4246-abb8-df43d1b55f5a",
                                                "sense_id": "583f0f7b-8ca6-3767-a00a-484922b1cd1f",
                                                "text": "\"Wir erleben in Deutschland einen Angriff in unvorstellbarem Ausmaß\", sagte BKA-Präsident Jörg Ziercke auf einer gemeinsamen Pressekonferenz mit der Finanzaufsicht BaFin."
                                            },
                                            {
                                                "example_id": "8905e0ed-a3ce-4637-bffc-2ed6a74dc15e",
                                                "sense_id": "583f0f7b-8ca6-3767-a00a-484922b1cd1f",
                                                "text": "Er ist die treibende Kraft hinter der Initiative, welche die Antwort sei \"auf alle Verbrechen, die einem Menschen das Leben und dessen Würde durch unvorstellbare und grausame Handlungen entreißen\"."
                                            },
                                            {
                                                "example_id": "a0f2b251-1719-4f87-a31f-7093501aff0f",
                                                "sense_id": "583f0f7b-8ca6-3767-a00a-484922b1cd1f",
                                                "text": "„Das hat unvorstellbare Schmerzen, Qualen und Leiden bedeutet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e2368e12-7125-3b11-9861-e459ab2302d4",
                                        "entry_id": "ab9dac45-2bfc-3c8b-b491-cf3c10914154",
                                        "glosses": [
                                            "außerordentlich, überaus"
                                        ],
                                        "tags": [
                                            "adverbiell und in Verbindung mit Adjektiven"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9415aebe-f4fb-4479-aec6-a64e4517491c",
                                                "sense_id": "e2368e12-7125-3b11-9861-e459ab2302d4",
                                                "text": "Die erwartete Datenmenge von jährlich 767 Exabyte ist unvorstellbar groß."
                                            },
                                            {
                                                "example_id": "7a42b6c6-c726-480b-91e2-e99a0903cf6d",
                                                "sense_id": "e2368e12-7125-3b11-9861-e459ab2302d4",
                                                "text": "\"Die Summen, die im Rahmen des Euro-Schutzschirms finanziert werden müssen, sind unvorstellbar hoch. …\""
                                            },
                                            {
                                                "example_id": "333d35a5-989d-4bd5-83a4-44fb8a26fcbb",
                                                "sense_id": "e2368e12-7125-3b11-9861-e459ab2302d4",
                                                "text": "In einer von seinem Management noch in der Nacht verbreiteten Mitteilung relativierte er seine Kritik an der Arbeit von Queiroz: „Man soll keine Geister heraufbeschwören, wo keine sind. Ich fühle mich am Boden zerstört, total verzweifelt, frustriert und unvorstellbar traurig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
