    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5ad1fc7b-ce5b-3a00-9677-291035eb1192",
                    "sense_definition": "Van oorsprong in een bepaald gebied voorkomend, niet van elders ingevoerd.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oorsprong",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De eik is een <w>inheemse</w> boomsoort die al eeuwenlang in onze bossen groeit.",
                            "target_lang_translations": {
                                "en": "The oak is a <w>native</w> tree species that has been growing in our forests for centuries."
                            }
                        },
                        {
                            "text": "Het is belangrijk om <w>inheemse</w> planten te beschermen tegen invasieve soorten.",
                            "target_lang_translations": {
                                "en": "It is important to protect <w>indigenous</w> plants against invasive species."
                            }
                        }
                    ],
                    "synonyms": [
                        "inlands",
                        "endemisch"
                    ],
                    "antonyms": [
                        "uitheems",
                        "vreemd",
                        "invasief"
                    ],
                    "common_phrases": [
                        "inheemse planten",
                        "inheemse diersoorten",
                        "inheemse bevolking"
                    ],
                    "target_lang_definitions": {
                        "en": "Originating in a particular area or region; not introduced from elsewhere."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "native",
                                "target_lang_sense_clarification": "of plants, animals, or species"
                            },
                            {
                                "target_lang_word": "indigenous",
                                "target_lang_sense_clarification": "originating in a specific region"
                            },
                            {
                                "target_lang_word": "endemic",
                                "target_lang_sense_clarification": "found only in a specific area"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad0c576-fd7a-3d0a-831a-438d2ac259c3",
                    "sense_definition": "Behorend tot de oorspronkelijke bewoners van een land of gebied.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oorsprong",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>inheemse</w> bevolking van Amerika heeft een rijke en diverse cultuur.",
                            "target_lang_translations": {
                                "en": "The <w>indigenous</w> population of America has a rich and diverse culture."
                            }
                        },
                        {
                            "text": "Er werd een nieuw decreet getekend om de <w>inheemse</w> naties meer zeggenschap te geven.",
                            "target_lang_translations": {
                                "en": "A new decree was signed to give the <w>native</w> nations more of a say."
                            }
                        }
                    ],
                    "synonyms": [
                        "inlands"
                    ],
                    "antonyms": [
                        "uitheems",
                        "vreemd"
                    ],
                    "common_phrases": [
                        "inheemse stammen",
                        "inheemse talen",
                        "inheemse rechten"
                    ],
                    "target_lang_definitions": {
                        "en": "Belonging to the original inhabitants of a country or region."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "indigenous",
                                "target_lang_sense_clarification": "relating to original inhabitants"
                            },
                            {
                                "target_lang_word": "native",
                                "target_lang_sense_clarification": "relating to people born in a place"
                            },
                            {
                                "target_lang_word": "aboriginal",
                                "target_lang_sense_clarification": "relating to the earliest known inhabitants"
                            }
                        ]
                    }
                }
            ]
        }
    ]
