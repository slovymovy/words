                    {
                        "translation_id": "940e52d6-de9a-4094-bba4-18d2a24f5c60",
                        "source_entry_id": "ae1ea136-f29c-360b-bf6c-7b81728e6d5f",
                        "source_sense_id": "870db933-1051-3461-9a0c-69019269c446",
                        "source_sense_description": "historisch: Mitglied des Templerordens",
                        "target_lang_word": "templier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "templier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40bc971f-b541-3947-9361-3f41e957aed7",
                                        "entry_id": "e100e446-78c8-3d13-9a21-edb4fcf0cd9a",
                                        "glosses": [
                                            "Relatif à l'ordre du Temple et à ses membres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c2a3d9f-6900-48e0-90cc-bc599eea7b21",
                                                "sense_id": "40bc971f-b541-3947-9361-3f41e957aed7",
                                                "text": "Démenti formel aux théories de Viollet-le-Duc sur l’octogonalité des églises templières, la chapelle de Saint-Aubin est un grand édifice rectangulaire en pierre du pays de vingt-cinq mètres de long sur neuf de large."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07b46f1f-2a52-34db-a23c-7dc8a92f6587",
                                        "entry_id": "e100e446-78c8-3d13-9a21-edb4fcf0cd9a",
                                        "glosses": [
                                            "Relatif au Temple, commune du Loir-et-Cher."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "364f8309-3881-309f-974f-ad6dfd821a70",
                                        "entry_id": "e100e446-78c8-3d13-9a21-edb4fcf0cd9a",
                                        "glosses": [
                                            "Relatif au Temple-de-Bretagne, commune de la Loire-Atlantique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d4225f3-dd03-3a77-9331-5c524a74ef76",
                                        "entry_id": "e100e446-78c8-3d13-9a21-edb4fcf0cd9a",
                                        "glosses": [
                                            "Relatif à Temple-Laguyon, commune de la Dordogne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "templier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "610ec1ac-7624-3b75-8e8c-07757a2a7102",
                                        "entry_id": "814759e5-1512-3a58-a2c2-8447b7aa6dc3",
                                        "glosses": [
                                            "Chevalier d’un ordre religieux militaire, institué au commencement du XIIᵉ siècle, pour défendre le royaume de Jérusalem contre les musulmans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "270ebeee-8a4b-4f4e-b4ac-455578dc8ee2",
                                                "sense_id": "610ec1ac-7624-3b75-8e8c-07757a2a7102",
                                                "text": "Remplissez les cornes les plus vastes ; les templiers et les abbés aiment le bon vin et la bonne mesure."
                                            },
                                            {
                                                "example_id": "c8396dc0-2271-4909-936b-52924ebdc967",
                                                "sense_id": "610ec1ac-7624-3b75-8e8c-07757a2a7102",
                                                "text": "On ignore comment et à quelle époque fut fondée la maison de Dormelles, ancienne commanderie du Temple. Tout ce qu’on sait, c’est que les Templiers étaient établis à Dormelles, au commencement du XIIIᵉ siècle, comme on le voit dans des lettres d’amortissement accordées en 1220, par Odeline de Limeni, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e80ef8b-1ba2-352d-814a-9d2f7837f984",
                                        "entry_id": "814759e5-1512-3a58-a2c2-8447b7aa6dc3",
                                        "glosses": [
                                            "Meuble représentant un chevalier de l’ordre des Templier dans les armoiries. Il est généralement représenté à pied, armé et équipé. Sur ses vêtements ou son équipement (parfois sur une bannière) sont représentées les armoiries de l’ordre (d’argent à une croix de gueules — plusieurs croix différentes ont été utilisées au cours de l’histoire de l’ordre). À rapprocher de champion, chevalier et chevalier du Temple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c7392e0-b122-4c20-8fe8-90b3b4191840",
                                                "sense_id": "2e80ef8b-1ba2-352d-814a-9d2f7837f984",
                                                "text": "D’azur au templier vêtu et coiffé de mailles d’argent, croisé et ceinturé de gueules, accosté de deux rameaux de buis d’or, au chef d’argent chargé de trois croisettes ancrées de gueules, qui est de la commune de Bussière-Poitevine de Haute-Vienne → voir illustration « armoiries avec un templier »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
