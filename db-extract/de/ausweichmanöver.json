                    {
                        "sense_id": "373bb476-113d-3d39-8f13-89ec8aaa6d01",
                        "entry_id": "5b7d4580-4877-3832-913f-74694148a987",
                        "glosses": [
                            "Strategie, um sich dem Einfluss des Verfolgers zu entziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b9d098-fdc2-4628-b86c-4b68a43a3078",
                                "sense_id": "373bb476-113d-3d39-8f13-89ec8aaa6d01",
                                "text": "Im militärischen Bereich wird die Logik der nächsten Generation von Marschflugkörpern in der Lage sein, passive Ausweichmanöver bei geringer Reduktion der eigenen Trefferqualität auszuführen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "35c94e35-ef6e-305f-a75c-204f23208dfc",
