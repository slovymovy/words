                "senses": [
                    {
                        "sense_id": "187f3362-1ea0-331a-a670-73a4e45e87a1",
                        "entry_id": "9859e42b-c8b8-3712-a689-7af1b06dfccc",
                        "glosses": [
                            "Ufer eines Meeres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8078616e-3975-4af5-bba1-4f3bbfbc9979",
                                "sense_id": "187f3362-1ea0-331a-a670-73a4e45e87a1",
                                "text": "„Heute hingegen fühlten sich laut Umfrage sieben von zehn Männern schon allein bei dem Gedanken unwohl, Frauenherzen am Meeresufer zu erobern.“"
                            },
                            {
                                "example_id": "54e364b1-01c6-4240-9f5e-eea476307037",
                                "sense_id": "187f3362-1ea0-331a-a670-73a4e45e87a1",
                                "text": "„Er glich mehr einer von den Wogen ans Meeresufer geworfenen Leiche als einem Lebenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
