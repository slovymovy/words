                    "frequency": "Middle",
                    "semantic_group_id": "hacken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die hungrigen Vögel <w>picken</w> im Winter nach den Körnern im Futterhaus."
                        },
                        {
                            "text": "Ein Huhn lief neugierig heran und <w>pickte</w> vorsichtig an meinen Schuhen."
                        }
                    ],
                    "common_phrases": [
                        "Körner picken"
                    ]
                },
