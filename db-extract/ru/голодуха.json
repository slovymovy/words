                        "examples": [
                            {
                                "example_id": "1c5be6ec-04ac-4072-a6db-cc26bae7b351",
                                "sense_id": "be92289e-5e1b-3fb6-b84f-8b19de0b96fe",
                                "text": "Не понимает того, старая, что от голодухи обессилела Наташка."
                            },
                            {
                                "example_id": "8c836d9d-8f8b-4df3-a930-565594579700",
                                "sense_id": "be92289e-5e1b-3fb6-b84f-8b19de0b96fe",
                                "text": "― Чтобы вечером за пайком явился. Помрёшь ещё с голодухи."
                            }
                        ]
                    }
