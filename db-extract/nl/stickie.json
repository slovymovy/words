                                        "entry_id": "58971b3b-fc98-3d03-8d7e-4ac68aa418ed",
                                        "glosses": [
                                            "To separate the joints; of; to divide at the joint or joints; to disjoint; to cut up into joints, as meat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ed99f49-aafd-46c7-8b5a-5898f1a8f8b3",
                                                "sense_id": "b44056db-439d-340a-a6c5-b179b545749c",
                                                "text": "Another time alſo being minded to entertain king Priamus friendly, when he came unto his pavilion: / He then beſtir'd himſelfe, and caught up ſoone, / A good white ſheepe, whoſe throat he cut anon. / but about cutting it up, quartering, jointing, ſeething, and roſting, he ſpent a great part of the night: […]"
                                            },
                                            {
                                                "example_id": "ea44d655-2a98-4d6f-bbd0-faa4774fd589",
                                                "sense_id": "b44056db-439d-340a-a6c5-b179b545749c",
                                                "text": "He joints the neck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42bc5a9c-40fc-36e1-bd07-318c9fd8158f",
                                        "entry_id": "58971b3b-fc98-3d03-8d7e-4ac68aa418ed",
                                        "glosses": [
                                            "To fit as if by joints; to coalesce as joints do."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dbc2178-c50c-41d9-b4fc-ae960d2026b9",
                                                "sense_id": "42bc5a9c-40fc-36e1-bd07-318c9fd8158f",
                                                "text": "the stones joint, neatly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
