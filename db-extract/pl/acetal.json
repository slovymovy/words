                        "glosses": [
                            "związek organiczny otrzymywany w wyniku działania alkoholu na aldehyd lub keton, wykorzystywany w przemyśle farmaceutycznym i perfumeryjnym oraz w syntezie organicznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
