                                "target_lang_sense_clarification": "to take place, often used in more formal contexts"
                            },
                            {
                                "target_lang_word": "take place",
                                "target_lang_sense_clarification": "to happen as a planned or unplanned event"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "случаться",
                                "target_lang_sense_clarification": "происходить о событии"
                            },
                            {
