                ],
                "senses": [
                    {
                        "sense_id": "a2900e26-85fb-3924-8941-cbe0741d74d9",
                        "entry_id": "7d4dc151-6b02-3a5b-b193-13b10c72e3e7",
                        "glosses": [
                            "met een stevige rand of laag op een zachtere ondergrond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f3ffa62-33f5-47ab-9344-9a942b546bb8",
                                "sense_id": "a2900e26-85fb-3924-8941-cbe0741d74d9",
                                "text": "Dit gerecht verdient het om als aparte gang te worden geserveerd, bijvoorbeeld als voorgerecht. Maar wie 100 - 150 gram in reepjes gesneden rookspek mee bakt met de lente-uitjes, en er goed korstig brood bij eet, kan er ook zijn maal mee doen."
                            },
                            {
                                "example_id": "27324480-b706-4ec9-bd1d-264e20a386fc",
                                "sense_id": "a2900e26-85fb-3924-8941-cbe0741d74d9",
                                "text": "Maar we hadden het over brood en brooddeeg. Nu hoef je helemaal geen brood te willen bakken om zinvol een brooddeeg te maken. Het lekkere aan brood is de korst. Een broodtaart heeft een korstige bodem, hij is lekker, hij oogt goed en hij is prettig om te maken."
                            },
                            {
                                "example_id": "9386ea51-c667-46e2-a073-9cfa07b012b8",
                                "sense_id": "a2900e26-85fb-3924-8941-cbe0741d74d9",
                                "text": "„Gewoon met H2O”, zegt Dick van den Brul van de brandweer. Leidingwater dus. Tachtig wagens van zes verschillende Veiligheidsregio’s waren zondag in wisseldienst aan het werk, bijgestaan door helikopters. Het bluswerk werd bemoeilijkt door de drassige en korstige ondergrond: twee wagens kwamen vast te zitten en liepen schade op."
                            }
                        ]
                    },
                    {
                        "sense_id": "4815c5e7-0aa5-3d90-b644-22114bf2a86a",
                        "entry_id": "7d4dc151-6b02-3a5b-b193-13b10c72e3e7",
                        "glosses": [
                            "van een huid met schilfers en korsten"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "815c8907-aaa7-4f33-b405-c555aac3c761",
                        "source_entry_id": "7d4dc151-6b02-3a5b-b193-13b10c72e3e7",
                        "source_sense_id": "4815c5e7-0aa5-3d90-b644-22114bf2a86a",
                        "source_sense_description": "van een huid met schilfers en korsten",
                        "target_lang_word": "scabby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scabby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e862e014-4188-31d4-a254-3a0d8dc8b519",
                                        "entry_id": "9c20444e-ed5b-3e49-b329-25449c14609e",
                                        "glosses": [
                                            "Affected with scabs; full of scabs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c687e8ff-c32b-4b79-b24f-9fec1dbcbfa2",
                                                "sense_id": "e862e014-4188-31d4-a254-3a0d8dc8b519",
                                                "text": "Her wrizled skin, as rough as maple rind,\nSo scabby was, that would have loath'd all womankind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c3bcdb0-7562-31b2-9b4b-725bccc3d8f5",
                                        "entry_id": "9c20444e-ed5b-3e49-b329-25449c14609e",
                                        "glosses": [
                                            "Diseased with the scab (mange): mangy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d646372c-c496-3105-8554-7521d6fb25c5",
                                        "entry_id": "9c20444e-ed5b-3e49-b329-25449c14609e",
                                        "glosses": [
                                            "Having a blotched, uneven appearance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20eaa06f-e7ca-3427-9953-76757813cd2e",
                                        "entry_id": "9c20444e-ed5b-3e49-b329-25449c14609e",
                                        "glosses": [
                                            "Injured by the attachment of barnacles to the carapace of a shell."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a0d276e-34ab-36e6-b88f-634f61459d3b",
                                        "entry_id": "9c20444e-ed5b-3e49-b329-25449c14609e",
                                        "glosses": [
                                            "Working against union policies, working to bust unions; in particular, being a scab (worker who crosses a union picket line)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d57727d-43f0-41ef-a274-6365e3660dd2",
                                                "sense_id": "1a0d276e-34ab-36e6-b88f-634f61459d3b",
                                                "text": "The police, the governor, and the \"scabby\" Hearst Examiner \"received a tremendous razzing,\" according to the Waterfront Worker, while all along the line of march \"the workers on the sidelines cheered[…]\""
                                            },
                                            {
                                                "example_id": "18afe15a-610d-4778-b7d0-ac272237f87e",
                                                "sense_id": "1a0d276e-34ab-36e6-b88f-634f61459d3b",
                                                "text": "[They're a] scabby right-to-work company and they don't care how much the sharp edges on that dust screw up a guy's lungs."
                                            },
                                            {
                                                "example_id": "0cffd8e6-e152-4909-b21b-27b88e7fc5de",
                                                "sense_id": "1a0d276e-34ab-36e6-b88f-634f61459d3b",
                                                "text": "Hoochie's dad said, “All eight drivers are former 'scabby' employees who couldn't get hired by any reputable union trucking companies.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a90eb8-5072-3434-b90d-cb6f3a757ae4",
                                        "entry_id": "9c20444e-ed5b-3e49-b329-25449c14609e",
                                        "glosses": [
                                            "Stingy; scrounging."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba3270ce-ca53-41d7-b86e-f7ebfc9c4bbf",
                                                "sense_id": "66a90eb8-5072-3434-b90d-cb6f3a757ae4",
                                                "text": "The chipper was a bit scabby on the vinegar today."
                                            },
                                            {
                                                "example_id": "ca27037e-9f43-4850-9ee3-2b5cd0ec9e3e",
                                                "sense_id": "66a90eb8-5072-3434-b90d-cb6f3a757ae4",
                                                "text": "I lent you a fiver last week and you still haven’t paid me back, you scabby bastard!"
                                            },
                                            {
                                                "example_id": "430d1b25-6fd9-4b85-8027-edee85e60a11",
                                                "sense_id": "66a90eb8-5072-3434-b90d-cb6f3a757ae4",
                                                "text": "You never bring you’re own pen but always ask to borrow mine, you scabby git!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
