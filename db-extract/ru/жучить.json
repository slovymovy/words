                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef5ca912-a483-4ed0-8f37-7b8849e825b8",
                                "sense_id": "7e7a6874-b622-3bcb-81fb-29862acaf560",
                                "text": "Это они ― отсталые, невежды, олухи, тёпы, он их жучил как хотел, уличал в серости, эпатировал, подначивал, и они бегали за ним."
                            },
                            {
                                "example_id": "25ca5180-91d8-4ec7-9067-71d4c25b8b59",
                                "sense_id": "7e7a6874-b622-3bcb-81fb-29862acaf560",
                                "text": "Бить нас надо, кнутом жучить, чтобы помнили…"
                            }
                        ]
                    }
