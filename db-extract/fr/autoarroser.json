                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5871cf73-a219-4bdc-8145-736b75f1fd3e",
                                "sense_id": "878972ab-860a-35eb-90ea-997cca4cb731",
                                "text": "Le sac à dinde est aussi une façon intéressante de cuire le volatile tout en lui permettant de demeurer très tendre parce qu'il s'autoarrose constamment."
                            },
                            {
                                "example_id": "6f1da2e6-0bb2-41a2-bd2d-b3bd1f8464ab",
                                "sense_id": "878972ab-860a-35eb-90ea-997cca4cb731",
                                "text": "Surtout pendant la séance de nettoyage du vélo, moi complétement frigorifié, me battant avec le tuyau d'arrosage, obligé de m'autoarroser pour enlever un max de boue (surtout au niveau des groles)...que du bonheur!!!"
                            }
                        ]
                    }
