        "fr-extract.jsonl": [
            {
                "entry_id": "a2f6e6a4-68c1-3599-9b44-9e8bc44942a4",
                "word": "profitable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8aa60d84-fc76-489e-928f-e0c8ddba7c1c",
                        "entry_id": "a2f6e6a4-68c1-3599-9b44-9e8bc44942a4",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "profitables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f1578ef-67fb-37fe-9f73-9fb6be927820",
                        "entry_id": "a2f6e6a4-68c1-3599-9b44-9e8bc44942a4",
                        "glosses": [
                            "Qui est utile, avantageux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "672cd618-11f0-411d-bd7a-9e1fb00bb490",
                                "sense_id": "4f1578ef-67fb-37fe-9f73-9fb6be927820",
                                "text": "À ce tronc si court sont attachés des membres d’une longueur gigantesque : l’enjambée faite est ainsi profitable à une marche fort rapide."
                            },
                            {
                                "example_id": "6f4c94b2-736f-4de0-be77-280c6e4e2ab0",
                                "sense_id": "4f1578ef-67fb-37fe-9f73-9fb6be927820",
                                "text": "La délivrance des lettres de marque et le droit de course avec commission, c'est-à-dire après avoir reçu du roi l'autorisation d'armer des navires et de courir sus aux étrangers dont on avait à se plaindre, devinrent bientôt très profitables aux armateurs malouins et à leurs confrères des autres ports."
                            },
                            {
                                "example_id": "92db636d-4f1b-4a35-a769-baea81202007",
                                "sense_id": "4f1578ef-67fb-37fe-9f73-9fb6be927820",
                                "text": "Cette conquête fut plus glorieuse que profitable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28b31da6-6384-4e8c-9daf-80fdc458b73d",
                        "source_entry_id": "a2f6e6a4-68c1-3599-9b44-9e8bc44942a4",
                        "source_sense_id": "4f1578ef-67fb-37fe-9f73-9fb6be927820",
                        "target_lang_word": "beneficial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beneficial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a95e3114-613e-3ddb-9994-6b26eba9af71",
                                        "entry_id": "49779225-b90d-3d79-8f5b-58616bd6c9b9",
                                        "glosses": [
                                            "Helpful or good to something or someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5acda19-c0b3-4461-9bf4-32ac9b4035bd",
                                                "sense_id": "a95e3114-613e-3ddb-9994-6b26eba9af71",
                                                "text": "Recycling and reusing garbage can be beneficial to the environment."
                                            },
                                            {
                                                "example_id": "cf6afeab-94f7-4697-a89f-8ad91c9dc593",
                                                "sense_id": "a95e3114-613e-3ddb-9994-6b26eba9af71",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42c680f4-e224-3065-9078-80da19574745",
                                        "entry_id": "49779225-b90d-3d79-8f5b-58616bd6c9b9",
                                        "glosses": [
                                            "Relating to a benefice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "beneficial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "137ca413-aa99-3d9b-af01-807919936dc6",
                                        "entry_id": "6aec0113-92e8-3cf3-b591-8c6ac51fa681",
                                        "glosses": [
                                            "Something that provides a benefit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7d52dc3-0f2a-43bf-9007-8989c9e314c7",
                                                "sense_id": "137ca413-aa99-3d9b-af01-807919936dc6",
                                                "text": "Daytime temperatures may be too hot for just-released beneficials, and birds and other predators are out in full force during the day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61cb0dde-4aaa-4454-8f53-e68425de3eb7",
                        "source_entry_id": "a2f6e6a4-68c1-3599-9b44-9e8bc44942a4",
                        "source_sense_id": "4f1578ef-67fb-37fe-9f73-9fb6be927820",
                        "target_lang_word": "profitable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "profitable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f1ec1ce-30e3-37d2-8d91-16b94a81669f",
                                        "entry_id": "4e2be29c-1027-3b47-81ac-34a341358f34",
                                        "glosses": [
                                            "Producing a profit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c296cfd6-c726-4278-8c44-8e28e6cc1095",
                                                "sense_id": "0f1ec1ce-30e3-37d2-8d91-16b94a81669f",
                                                "text": "Profitable operation is being made possible by the widespread introduction of capacious diesel railcars, which for their comfort and speed are very popular with the travelling public."
                                            },
                                            {
                                                "example_id": "39a555c3-7b9f-4231-8173-f416eef715c1",
                                                "sense_id": "0f1ec1ce-30e3-37d2-8d91-16b94a81669f",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about \"creating compelling content\", or offering services that let you \"stay up to date with what your friends are doing\"[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            },
                                            {
                                                "example_id": "f48f89cf-a200-4811-a281-e8ea5783dac0",
                                                "sense_id": "0f1ec1ce-30e3-37d2-8d91-16b94a81669f",
                                                "text": "California state Sen. Hannah-Beth Jackson told The Wall Street Journal last month when the legislation passed that “one-fourth of California’s publicly traded companies still do not have a single woman on their board, despite numerous independent studies that show companies with women on their board are more profitable and productive.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "279017a9-34bc-3efc-bd06-f35422884653",
                                        "entry_id": "4e2be29c-1027-3b47-81ac-34a341358f34",
                                        "glosses": [
                                            "Beneficial, serviceable, of use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19255186-3288-40cd-907e-900055195f58",
                                                "sense_id": "279017a9-34bc-3efc-bd06-f35422884653",
                                                "text": "I wylbe ferme and ſtabyll\nAnd to yow ſeruyceabyll\nAnd also prophytabyll\nYf ye be agreabyll\nMy propyr Beſſe\nTo turne a gayne to me"
                                            },
                                            {
                                                "example_id": "744e90a3-4a26-4365-8d53-828c071b4947",
                                                "sense_id": "279017a9-34bc-3efc-bd06-f35422884653",
                                                "text": "Great Men, taken up in any way, are profitable company."
                                            },
                                            {
                                                "example_id": "7a8f2d0d-5ad8-4bb8-bdb0-97d33f4a1aa7",
                                                "sense_id": "279017a9-34bc-3efc-bd06-f35422884653",
                                                "text": "It is a profitable thing, if one is wise, to seem foolish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bb248fa-c74e-4497-8641-4abc223729b8",
                        "source_entry_id": "a2f6e6a4-68c1-3599-9b44-9e8bc44942a4",
