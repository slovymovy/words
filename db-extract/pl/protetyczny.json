                        "glosses": [
                            "związany z protetyką lub robieniem protez"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249b4b19-c58f-4bf0-bdcd-8f3ec945bc85",
                                "sense_id": "4f25f33c-a622-3ec7-a2b8-436f9670f33b",
                                "text": "Niezastosowanie takiego leczenia często prowadzi do utraty zęba, a wtedy koszty leczenia protetycznego są nieporównanie wyższe"
                            }
