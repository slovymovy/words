                    }
                ],
                "senses": [
                    {
                        "sense_id": "38bcf8ff-354c-30ca-ac06-cbf37dd76fd8",
                        "entry_id": "6afd0c81-949e-3466-ad43-d52d38228fcb",
                        "glosses": [
                            "мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbcff354-221a-4027-8e33-f08bc3aee2a7",
                                "sense_id": "38bcf8ff-354c-30ca-ac06-cbf37dd76fd8",
                                "text": "Фламандец по происхождению, Адриан Вансон с 1584 жил и работал в Эдинбурге, где занимал пост придворного живописца."
                            },
                            {
                                "example_id": "0988a333-bd79-4f85-a6f1-58349040a4f6",
                                "sense_id": "38bcf8ff-354c-30ca-ac06-cbf37dd76fd8",
                                "text": "Если Адриан запретил господину убивать своих рабов без суда, то Антонин приравнял убийство раба к убийству свободного человека и постановил, что рабов, укрывшихся в храме от жестокостей господина, не следует выдавать на расправу их домашнему тирану."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58a26cb0-c0d9-49aa-9430-9d77a285bd19",
                        "source_entry_id": "6afd0c81-949e-3466-ad43-d52d38228fcb",
                        "source_sense_id": "38bcf8ff-354c-30ca-ac06-cbf37dd76fd8",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Adrian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adrian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cafbaf1a-2562-32d4-a509-4d14fbeb97df",
                                        "entry_id": "7f7d765f-71c2-3c4f-8ba6-7f98d535ea76",
                                        "glosses": [
                                            "A male given name from Latin or Etruscan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45e90d81-f387-4796-890c-82a85312f157",
                                                "sense_id": "cafbaf1a-2562-32d4-a509-4d14fbeb97df",
                                                "text": "Which, of he, or Adrian, for a good wager, / Firſt begins to crow ?"
                                            },
                                            {
                                                "example_id": "63e57cff-b4f3-40bf-a6c2-9d9cede15ccb",
                                                "sense_id": "cafbaf1a-2562-32d4-a509-4d14fbeb97df",
                                                "text": "\"My only worth will be in always remembering to do the thing that pleases you; and yet, although I don't really like Adie, it has a more home-like, more whisperable sound than Adrian. Adrian is a grand, heroic sort of a name, yet what a beautiful name it is."
                                            },
                                            {
                                                "example_id": "aa04ab57-29d5-4e7f-ac48-1c391ed1d7a4",
                                                "sense_id": "cafbaf1a-2562-32d4-a509-4d14fbeb97df",
                                                "text": "His baptismal register spoke of him pessimistically as John Henry, but he had left that behind with the other maladies of infancy, and his friends knew him under the front-name of Adrian."
                                            },
                                            {
                                                "example_id": "1f53c569-4b48-43cf-9cd6-efa2f7b523ff",
                                                "sense_id": "cafbaf1a-2562-32d4-a509-4d14fbeb97df",
                                                "text": "I'm afraid neither of us was looking where we were going. We Adrians are notoriously abstracted, are we not?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff50c5da-7ba8-3c94-8537-651abe40ccf2",
                                        "entry_id": "7f7d765f-71c2-3c4f-8ba6-7f98d535ea76",
                                        "glosses": [
                                            "A female given name from Latin (compare Adriana, Adrianna, Adrienne)."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66263874-fd38-3656-8f9b-437d20e49185",
