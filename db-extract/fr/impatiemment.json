        "fr-extract.jsonl": [
            {
                "entry_id": "fff9c002-1cd8-3033-b601-861a57890a7a",
                "word": "impatiemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6937f2ff-4541-3a15-990d-c670001064c5",
                        "entry_id": "fff9c002-1cd8-3033-b601-861a57890a7a",
                        "glosses": [
                            "Avec impatience."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "941cf915-18a6-47af-82b0-aef7b982d042",
                                "sense_id": "6937f2ff-4541-3a15-990d-c670001064c5",
                                "text": "Dédaigner ceux qui lui viennent faire leur cour [à un grand], ou attendre impatiemment qu’ils se retirent."
                            },
                            {
                                "example_id": "a207da29-f499-4e24-a9e7-950998ace5df",
                                "sense_id": "6937f2ff-4541-3a15-990d-c670001064c5",
                                "text": "En général les habitants des parties septentrionales [de l’Écosse], plutôt subjugués qu’unis [à l’Angleterre], supportaient impatiemment cette réunion."
                            },
                            {
                                "example_id": "23028c69-dc65-411a-94fb-a411175c80d1",
                                "sense_id": "6937f2ff-4541-3a15-990d-c670001064c5",
                                "text": "Le précepteur Albert attendait impatiemment dans une chambre voisine le retour de Bois-Guilbert."
                            }
                        ]
                    },
                    {
                        "sense_id": "28f32569-1c6f-34e1-9905-8df4d9ed31f3",
                        "entry_id": "fff9c002-1cd8-3033-b601-861a57890a7a",
                        "glosses": [
                            "Avec chagrin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa8b5a01-4c38-4a31-b7ef-cabc0fd06f7d",
                                "sense_id": "28f32569-1c6f-34e1-9905-8df4d9ed31f3",
                                "text": "Néron porta impatiemment la mort de Narcisse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4c84293-4aba-459e-a02e-03920b297ceb",
                        "source_entry_id": "fff9c002-1cd8-3033-b601-861a57890a7a",
                        "target_lang_word": "ungeduldig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungeduldig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56ccfafa-c022-3e0f-80fd-2b1eb2521433",
                                        "entry_id": "e764c21f-c57b-3705-a247-3e21947b7ee7",
                                        "glosses": [
                                            "keine Geduld habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb6acb0-8648-4c5c-a3ae-09273fb27bcc",
                                                "sense_id": "56ccfafa-c022-3e0f-80fd-2b1eb2521433",
                                                "text": "Er wartete schon über eine halbe Stunde und langsam wurde er ungeduldig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3d0112a-29f7-41fc-ae1d-dacc01ed9515",
                        "source_entry_id": "fff9c002-1cd8-3033-b601-861a57890a7a",
                        "target_lang_word": "impatiently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impatiently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f437e36-f5b6-3dde-ae34-7fd3ff9c21b0",
                                        "entry_id": "1793b715-fd78-305d-8395-7eecf9307edd",
                                        "glosses": [
                                            "In an impatient manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb1c54a5-40c3-4f05-9135-4bd1d4c8f09d",
                                                "sense_id": "8f437e36-f5b6-3dde-ae34-7fd3ff9c21b0",
                                                "text": "Stella was waiting impatiently for the delivery to come."
                                            },
                                            {
                                                "example_id": "1ab8fc41-5a1a-4a28-88cb-30fa2dd21f33",
                                                "sense_id": "8f437e36-f5b6-3dde-ae34-7fd3ff9c21b0",
                                                "text": "He watched his corn impatiently for two days, and, as it did not come up, he thought he would plant it again with beans. He ought to have waited longer."
                                            },
                                            {
                                                "example_id": "ffca710e-4e2d-4821-89fe-01ab95047414",
                                                "sense_id": "8f437e36-f5b6-3dde-ae34-7fd3ff9c21b0",
                                                "text": "The keys are awaiting\nThy magical touch,\nAnd the strings are impatiently mute."
                                            },
                                            {
                                                "example_id": "14e33cab-fd18-4dae-8d14-92485d7239ac",
                                                "sense_id": "8f437e36-f5b6-3dde-ae34-7fd3ff9c21b0",
                                                "text": "When the work was almost completed, the Pope impatiently asked when it would be finished. Michelangelo answered, \"When I shall be able\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f07cd75-cb7f-4812-a530-7e74b4fcdda9",
                        "source_entry_id": "fff9c002-1cd8-3033-b601-861a57890a7a",
                        "target_lang_word": "longingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "longingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7132b384-8226-3a24-a4e1-c903452f007b",
                                        "entry_id": "211bb0cf-f75d-31b6-9c4c-abb9d2fb31fb",
                                        "glosses": [
                                            "In a longing manner, with desire, yearningly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4449d2c-19af-472d-9654-b2481eaaa376",
                                                "sense_id": "7132b384-8226-3a24-a4e1-c903452f007b",
                                                "text": "As she stepped nearer and peered longingly out, she saw something else: she saw, only a little way below the window, the wide, flat tin roof of Miss Polly's sun parlor built over the porte-cochère. The sight filled her with longing. If only, now, she were out there!"
                                            },
                                            {
                                                "example_id": "9231a7e1-c006-4073-b78f-6d3bd7e948d2",
                                                "sense_id": "7132b384-8226-3a24-a4e1-c903452f007b",
                                                "text": "So Sebastian fetched in a closed basket, set it down before her, and went out again quickly. 'you had better finish your lessions before opening it,' remarked Miss Rottenmeier firmly, though Clara looked longingly at it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8d296db-cee2-4270-a48b-58e65e6ca2c6",
                        "source_entry_id": "fff9c002-1cd8-3033-b601-861a57890a7a",
                        "target_lang_word": "yearningly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yearningly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1af8021-9b5b-38a0-aa9a-3a97c4acc140",
                                        "entry_id": "c78575e0-7ea2-3aa9-902e-5ab62707f8ff",
                                        "glosses": [
                                            "With yearning; with desire; longingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5385272f-0d6f-4aa8-9a56-0fa569edb067",
                                                "sense_id": "a1af8021-9b5b-38a0-aa9a-3a97c4acc140",
                                                "text": "He was silent a few moments, not looking at her; while her eyes were turned toward him yearningly, in alarm at this sudden change."
                                            },
                                            {
                                                "example_id": "335fac6a-9de5-4636-866c-6f5449702eee",
                                                "sense_id": "a1af8021-9b5b-38a0-aa9a-3a97c4acc140",
                                                "text": "Yet what was it she had in mind, what did she wish to make of him beyond what she had already made, a patient, punctilious host, mindful that she had originally arrived much as a stranger, arrived not at all deliberately or yearningly invited?—so that one positively had her possible susceptibilities the MORE on one’s conscience."
                                            },
                                            {
                                                "example_id": "ff11bc49-42e2-4cba-9786-1fc9cc166556",
                                                "sense_id": "a1af8021-9b5b-38a0-aa9a-3a97c4acc140",
                                                "text": "The old maple stump shot sickly pink switches from her roots, new switches every year. They crept yearningly toward the little square of window."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "912fc788-210d-4900-a5d5-9b98d2bf346a",
                        "source_entry_id": "fff9c002-1cd8-3033-b601-861a57890a7a",
