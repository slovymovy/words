                "senses": [
                    {
                        "sense_id": "23fa586e-3b96-38c6-9805-08f0f3ebe427",
                        "entry_id": "0f81666e-4ed4-34ce-9fd7-f267e75abd09",
                        "glosses": [
                            "Sammelbezeichnung für die Dialekte des Niederdeutschen, die in den Niederlanden, Westfalen, Niedersachsen und Schleswig-Holstein gesprochen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58405007-a605-44c6-94c9-7c401bc06b1c",
                                "sense_id": "23fa586e-3b96-38c6-9805-08f0f3ebe427",
                                "text": "„Als Unterschied zu den westniederdeutschen Mundarten wird für gewöhnlich die Bildung des Plurals der Verben im Präsens herangezogen. Dieser soll für alle drei Personen gleich sein (Einheitsplural) und im Westniederdeutschen auf -(e)t, im Ostniederdeutschen jedoch auf -e(n) ausgehen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
