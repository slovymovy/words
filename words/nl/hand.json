                    "sense_id": "2d328893-29cf-30aa-9253-4eb77d52c2d2",
                    "sense_definition": "Het lichaamsdeel aan het einde van de arm, voorbij de pols, waarmee men dingen kan vastpakken.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft in haar <w>hand</w> een groot boek.",
                            "target_lang_translations": {
                                "ru": "У неё в <w>руке</w> большая книга.",
                                "en": "She has a big book in her <w>hand</w>.",
                                "pl": "Ona trzyma w <w>ręku</w> dużą książkę.",
                                "de": "Sie hat ein großes Buch in ihrer <w>Hand</w>.",
                                "fr": "Elle a un grand livre dans la <w>main</w>.",
                                "it": "Lei ha un grande libro nella sua <w>mano</w>.",
                                "cs": "Má v <w>ruce</w> velkou knihu.",
                                "tr": "Onun <w>elinde</w> büyük bir kitap var.",
                                "es": "Ella tiene un libro grande en la <w>mano</w>."
                            }
                        },
                        {
                            "text": "Was je <w>handen</w> goed met water en zeep.",
                            "target_lang_translations": {
                                "ru": "Хорошо вымой <w>руки</w> водой с мылом.",
                                "en": "Wash your <w>hands</w> thoroughly with soap and water.",
                                "pl": "Umyj dobrze <w>ręce</w> wodą i mydłem.",
                                "de": "Wasch deine <w>Hände</w> gründlich mit Wasser und Seife.",
                                "fr": "Lave-toi bien les <w>mains</w> avec de l'eau et du savon.",
                                "it": "Lavati bene le <w>mani</w> con acqua e sapone.",
                                "cs": "Umyj si dobře <w>ruce</w> mýdlem a vodou.",
                                "tr": "<w>Ellerini</w> su ve sabunla iyice yıka.",
                                "es": "Lávate bien las <w>manos</w> con agua y jabón."
                            }
                        },
                        {
                            "text": "Hij stak zijn <w>hand</w> op om de leraar een vraag te stellen.",
                            "target_lang_translations": {
                                "ru": "Он поднял <w>руку</w>, чтобы задать учителю вопрос.",
                                "en": "He raised his <w>hand</w> to ask the teacher a question.",
                                "pl": "Podniósł <w>rękę</w>, aby zadać nauczycielowi pytanie.",
                                "de": "Er hob seine <w>Hand</w>, um dem Lehrer eine Frage zu stellen.",
                                "fr": "Il a levé la <w>main</w> pour poser une question au professeur.",
                                "it": "Ha alzato la <w>mano</w> per fare una domanda all'insegnante.",
                                "cs": "Zvedl <w>ruku</w>, aby položil učiteli otázku.",
                                "tr": "Öğretmene bir soru sormak için <w>elini</w> kaldırdı.",
                                "es": "Levantó la <w>mano</w> para hacerle una pregunta al profesor."
                            }
                        }
