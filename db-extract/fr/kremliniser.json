                        "glosses": [
                            "Donner un caractère lié au Kremlin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35854814-cb16-4370-9f08-35733e9604d8",
                                "sense_id": "81604472-f012-3119-b3ce-17eb06a8e319",
                                "text": "M. MacMillan reviendra-t-il de Moscou sagement (ou plutôt follement !) endoctriné, russifié, kremlinisé ?"
                            },
                            {
                                "example_id": "9baaedc3-e967-4b22-85c7-43018fe3db60",
                                "sense_id": "81604472-f012-3119-b3ce-17eb06a8e319",
                                "text": "Maurice Thorez, va Kremliniser le reste, vil culbuto que l'on magnétise, pour l'employer à sa guise."
                            },
                            {
                                "example_id": "8373bcad-0677-4779-ba77-3ebf8934ad52",
                                "sense_id": "81604472-f012-3119-b3ce-17eb06a8e319",
                                "text": "Préférons une Europe kremlinisée, kgbisée, gazpromisée?"
                            }
                        ]
                    }
