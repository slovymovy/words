                                                "sense_id": "8b9c66ec-4b50-36f3-b35a-68bebac1c21c",
                                                "text": "Mam na imię Antoni i jestem księdzem z Częstochowy."
                                            },
                                            {
                                                "example_id": "102f79c7-8109-40e7-a4ae-00aa449d1756",
                                                "sense_id": "8b9c66ec-4b50-36f3-b35a-68bebac1c21c",
                                                "text": "12 i 17 stycznia oraz 5 lipca przypadają imieniny Antoniego."
                                            },
                                            {
                                                "example_id": "d1b3b358-2e30-4fac-9a75-fab321ec066f",
                                                "sense_id": "8b9c66ec-4b50-36f3-b35a-68bebac1c21c",
                                                "text": "Panie Antoni, proszę nas jutro odwiedzić."
                                            },
                                            {
                                                "example_id": "dc50127e-9cf5-4648-94c5-68234c4ef5b9",
                                                "sense_id": "8b9c66ec-4b50-36f3-b35a-68bebac1c21c",
                                                "text": "… Ojciec Święty Benedykt XVI wyznaczył Jego Ekscelencję Antoniego Dziemiankę Administratorem Apostolskim … Archidiecezji Mińsko-Mohylewskiej."
                                            },
                                            {
                                                "example_id": "8217c789-4c0e-40ef-b9c8-1076b20cfd1f",
                                                "sense_id": "8b9c66ec-4b50-36f3-b35a-68bebac1c21c",
                                                "text": "Jest to więc wystawa dwupokoleniowa — uczniów Antoniego Kenara i uczniów uczniów."
                                            }
