                        "sense_id": "e57be2ac-1f65-38a2-a611-5d40410b7265",
                        "entry_id": "db36fa82-675a-33ee-aaf3-b18419e1b496",
                        "glosses": [
                            "Qui peut être enlevé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45f20fa1-55c3-4dfe-af79-35054f43680f",
                                "sense_id": "e57be2ac-1f65-38a2-a611-5d40410b7265",
                                "text": "Avec une patience et une industrie incroyables, on recouvrit la peinture d’un enduit solide, mais enlevable à volonté ; …"
                            },
                            {
                                "example_id": "b711bfa2-0401-4a53-8a78-88e66bb35d93",
                                "sense_id": "e57be2ac-1f65-38a2-a611-5d40410b7265",
                                "text": "Il serait à désirer qu’on pût trouver un vernis qui, sans attirer l’humidité, fût un peu élastique, point sujet à s’écailler ni insalubre, mais facilement enlevable à l’eau bouillante ou autrement ; …"
                            },
                            {
                                "example_id": "03223c1a-2615-4fec-bbb7-dcbe1179b484",
                                "sense_id": "e57be2ac-1f65-38a2-a611-5d40410b7265",
                                "text": "S’il s’agit d’un organe non enlevable (l’intestin par exemple), il sera traité suivant ses lésions propres."
                            },
                            {
                                "example_id": "b950eaa9-a6b3-47a5-a4a2-47b31574cb6a",
                                "sense_id": "e57be2ac-1f65-38a2-a611-5d40410b7265",
                                "text": "Problème : le filtre est facilement enlevable… par n’importe qui. En d’autres termes, une personne mal intentionnée peut récupérer votre vidéo et obtenir la version « non censurée » en quelques clics seulement."
                            }
                        ]
                    }
