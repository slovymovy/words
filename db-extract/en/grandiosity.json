                "senses": [
                    {
                        "sense_id": "40b6b6d9-9c0b-35f0-bb0c-ca0e2d35e60e",
                        "entry_id": "cdcdb86d-0004-38e2-ac18-a1dbcdf575d7",
                        "glosses": [
                            "The state of being grandiose (pompous or pretentious)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "505ccbf4-fc11-4a85-8c50-b6d57ec94af6",
                                "sense_id": "40b6b6d9-9c0b-35f0-bb0c-ca0e2d35e60e",
                                "text": "[…] the narcissistic leader does not use his narcissistic charisma only as a means for political success; he needs success and applause for the sake of his own mental equilibrium. The idea of his greatness and infallibility is essentially based on his narcissistic grandiosity, not on his real achievements as a human being."
                            },
                            {
                                "example_id": "b369188a-43dd-409e-ab0d-ee32909ea440",
                                "sense_id": "40b6b6d9-9c0b-35f0-bb0c-ca0e2d35e60e",
                                "text": "U2 have never been a band noted for their love of shy understatement, but even by their standards, their arrival in Las Vegas represents a hitherto-unimagined degree of grandiosity."
                            }
                        ]
                    }
                ],
                "translations": [
