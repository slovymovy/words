                        ]
                    },
                    {
                        "translation_id": "af54f22b-3f9c-447b-86b4-30b99a0fdfcb",
                        "source_entry_id": "9a72abb4-0ee4-39df-9e22-3ce4c938ea1e",
                        "source_sense_id": "8a6e6da0-712a-3e86-b4a8-f6fdb0c428d6",
                        "target_lang_word": "trirème",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trirème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0471950c-69c2-3a20-9578-9fbd85e5e745",
                                        "entry_id": "279b24c4-dd18-3413-bf60-7157a33e74d8",
                                        "glosses": [
                                            "Galère à trois rangs de rames."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7491c0d-30b9-4b21-b795-ee0fbde50cb5",
                                                "sense_id": "0471950c-69c2-3a20-9578-9fbd85e5e745",
                                                "text": "Un charpentier de Corinthe, Aminoclès, imagina d'installer trois rangs de rameurs en les étageant les uns au-dessus des autres. Cette idée, qui donna naissance aux trirèmes, ne fut pas stérile: on construisit des galères qui avaient quatre, cinq, six, sept, huit et même dix étages de rameurs. Alexandre en porta le nombre jusqu'à douze en inventant les dodécadères."
                                            },
                                            {
                                                "example_id": "96a3cefe-ea41-47f2-8369-7f47d218ad2b",
                                                "sense_id": "0471950c-69c2-3a20-9578-9fbd85e5e745",
                                                "text": "Parmi elles, j’en retiendrai d’abord une, récemment mise en exergue, pour son « exemplarité » : la reconstruction expérimentale d’une trirème antique sous les auspices de Napoléon III, Empereur des Français."
                                            },
                                            {
                                                "example_id": "3c90ae1b-24cc-44e6-8a85-a8c7e9fbb812",
                                                "sense_id": "0471950c-69c2-3a20-9578-9fbd85e5e745",
                                                "text": "N’appartenant pas à l’école réaliste, seul au milieu de quelques amis, Flaubert perçoit ainsi son œuvre comme une chaloupe au milieu des textes étrangers, autant de trirèmes gigantesques, pour reprendre son image de navigateur développée dans une comparaison pleine de modestie entre Salammbô et Les Misérables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
