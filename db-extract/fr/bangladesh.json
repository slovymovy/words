        "fr-extract.jsonl": [
            {
                "entry_id": "5eb336a5-f9a5-311a-98e3-4f93d157a94e",
                "word": "Bangladesh",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e8221a00-d850-31b0-a3a8-7b8521b1d05e",
                        "entry_id": "5eb336a5-f9a5-311a-98e3-4f93d157a94e",
                        "glosses": [
                            "Pays d’Asie du sud, situé au nord du golfe du Bengale, quasiment enclavé dans l’Inde avec une petite frontière commune avec le Myanmar, auparavant (1947–1971) connu sous la désignation de « Pakistan oriental ». Sa capitale est Dacca."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "08e5da3a-a441-4d4a-8a0f-d20e2a1aae5c",
                                "sense_id": "e8221a00-d850-31b0-a3a8-7b8521b1d05e",
                                "text": "Le succès du Bangladesh, qui, en 2023, est devenu le premier pays du monde à avoir éliminé la leishmaniose viscérale en tant que problème de santé publique, est un encouragement pour tous les pays où la maladie est endémique."
                            },
                            {
                                "example_id": "6b95ae26-ddc4-426a-a9a6-f4123aa8f2cf",
                                "sense_id": "e8221a00-d850-31b0-a3a8-7b8521b1d05e",
                                "text": "Ces champs colorés se situent près de la ville de Panchagarh, au Bangladesh."
                            },
                            {
                                "example_id": "fa546128-fe05-45a5-8ae0-966bc74c8918",
                                "sense_id": "e8221a00-d850-31b0-a3a8-7b8521b1d05e",
                                "text": "Les 27 autres pour cent vivent dans des pays, tels que l’Algérie, le Bangladesh, l’Iran et le Nigéria, où les taux de mortalité ont légèrement baissé, mais où les taux de mortalité demeurent élevés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edb1b8ab-b23e-4e01-b6cf-136a36154a23",
                        "source_entry_id": "5eb336a5-f9a5-311a-98e3-4f93d157a94e",
                        "source_sense_id": "e8221a00-d850-31b0-a3a8-7b8521b1d05e",
                        "source_sense_description": "Pays d’Asie",
                        "target_lang_word": "Bangladesch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bangladesch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                        "entry_id": "530d0881-e052-3b54-8537-774b1bcbbddf",
                                        "glosses": [
                                            "ein Land auf dem indischen Subkontinent (Vorderindien), am Golf von Bengalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e819b25-e2da-4abc-be09-b5fbf7d872db",
                                                "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                                "text": "Warst Du jemals in Bangladesch?"
                                            },
                                            {
                                                "example_id": "b5f951bf-0a8a-4f9c-bc0c-3e3d40eaf83c",
                                                "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                                "text": "Der größte Teil Bangladeschs wird von großen Flüssen durchzogen und ist deshalb oft von Überschwemmungen bedroht."
                                            },
                                            {
                                                "example_id": "c87f6473-a611-445a-b639-3e7d136ead91",
                                                "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                                "text": "„Denn wenn beispielsweise im Ostseeraum ein Masterplan nicht aufgehe, dann spreche wenig dafür, dass er in Bangladesch sinnvoll ist.“"
                                            },
                                            {
                                                "example_id": "7e4eafb1-690c-419e-82eb-6100d415bf4c",
                                                "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                                "text": "„Schließlich gelang dem Rikschafahrer nach mehreren Tagen Fußmarsch die Flucht aus seinem Dorf im Westen seines Heimatlands Myanmar und über die Grenze ins benachbarte Bangladesch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
