                                        "entry_id": "740e56ea-71c2-3c74-a301-420c044c2c37",
                                        "glosses": [
                                            "Mathematik, Geometrie: dreidimensionales Polyeder, das von sechs Flächen begrenzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b5a36a-b84a-451b-b76e-7c62981a7365",
                                                "sense_id": "ce0916ab-a016-395e-8d4f-fdc17a3e2c9c",
                                                "text": "Man kann die geometrische Form des Hexaeders in der Struktur von Kristallen wiederfinden."
                                            }
