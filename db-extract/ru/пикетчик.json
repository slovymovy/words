                    {
                        "sense_id": "438c50ed-3133-3a5c-8993-45ee8184bd7b",
                        "entry_id": "3d07f8d9-7f58-3a72-b104-30b3c7102a55",
                        "glosses": [
                            "demonstrant, účastník protestní demonstrace"
