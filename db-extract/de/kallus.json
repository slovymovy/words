                "senses": [
                    {
                        "sense_id": "1b3c3e6a-e534-3585-9bad-0682ff369bc0",
                        "entry_id": "17ad3cda-48bf-34f5-b4eb-efa1b66e673a",
                        "glosses": [
                            "überschießendes Knochengewebe bei der sekundären Knochenbruchheilung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f8f1604-64bf-468f-a95b-6c8e70539c43",
                                "sense_id": "1b3c3e6a-e534-3585-9bad-0682ff369bc0",
                                "text": "„Heilt ein Knochenbruch primär aus (Primäre Knochenheilung), bildet sich kein Kallus.“"
                            },
                            {
                                "example_id": "53bbcd99-3e20-4103-8de7-4493b73c26aa",
                                "sense_id": "1b3c3e6a-e534-3585-9bad-0682ff369bc0",
                                "text": "„Nach der Heilung des Knochenbruchs bleibt an der Bruchstelle eine sogenannte Knochennarbe, auch Kallus genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1a52301a-2a64-3b1b-be71-59d45587945c",
                        "entry_id": "17ad3cda-48bf-34f5-b4eb-efa1b66e673a",
                        "glosses": [
                            "Narbengewebe an Schnittwunden von Pflanzen (dieses Gewebe kann besonders gut Wurzeln ausbilden)"
                        ],
                        "tags": [
                            "Pl. 2"
                        ],
                        "examples": [
                            {
                                "example_id": "3da3de7d-e057-4fd8-b7c1-409dace6924f",
                                "sense_id": "1a52301a-2a64-3b1b-be71-59d45587945c",
                                "text": "„Da die Zellen eines Kallus durch Mitose entstanden sind, unterscheiden sie sich genetisch nicht voneinander.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5fa4d9b6-8198-35bb-a1d9-3954be9b9fab",
                        "entry_id": "17ad3cda-48bf-34f5-b4eb-efa1b66e673a",
                        "glosses": [
                            "undifferenziertes Pflanzengewebe, das sich unter Laborbedingungen aus Zellen oder Gewebestücken entwickelt"
                        ],
                        "tags": [
                            "Pl. 2"
                        ],
                        "examples": [
                            {
                                "example_id": "bf8a50ab-9570-4b2e-b912-70d624a9b1d2",
                                "sense_id": "5fa4d9b6-8198-35bb-a1d9-3954be9b9fab",
                                "text": "In der Pflanzenphysiologie wird häufig mit Kalli anstatt mit kompletten Pflanzen gearbeitet. Aus einem Kallus kann sich wieder eine vollständige Pflanze entwickeln."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
