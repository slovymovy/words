                    {
                        "translation_id": "5a00e046-938a-4b9d-9aa2-5bb24cebc818",
                        "source_entry_id": "f000f496-32be-3947-a9e6-2ed5f443aaa7",
                        "source_sense_id": "4c3b9a2c-548c-38ea-973c-5ea217b40e35",
                        "source_sense_description": "nur Plural: das sechste Jahrzehnt eines Jahrhunderts oder eines Lebens",
                        "target_lang_word": "années 50",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "années 50",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eeebba12-b419-3aef-a5a9-403c51c6ba88",
                                        "entry_id": "cfaab940-d754-3370-ac88-77ba998dd2d8",
                                        "glosses": [
                                            "Décennie couvrant les années 1950 à 1959."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "394ae73c-c502-4717-83f4-2ea0a224c009",
                                                "sense_id": "eeebba12-b419-3aef-a5a9-403c51c6ba88",
                                                "text": "« On reconstruisait la ville et il y avait partout des bruits de marteau. Ça ne nous dérangeait pas. J’aime toujours le choc d’un marteau sur le bois. Ça me rappelle les années 50, on rebâtissait. Nous sentions une espérance. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf345abe-c02d-4bca-945e-913f7f1fec73",
                        "source_entry_id": "f000f496-32be-3947-a9e6-2ed5f443aaa7",
                        "source_sense_id": "697f25f8-6a82-329c-b45a-22e598978a2f",
                        "target_lang_word": "quinquagénaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quinquagénaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "599b102f-e149-3262-80fc-34d47b91f931",
                                        "entry_id": "51c0844e-2897-3670-adf4-435b70219243",
                                        "glosses": [
                                            "Dont l’âge se situe entre cinquante et cinquante-neuf ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0b0dc45-7985-4a87-9f53-b5c58f658844",
                                                "sense_id": "599b102f-e149-3262-80fc-34d47b91f931",
                                                "text": "Les jambes quinquagénaires du très élégant Sieur Lapie transpiraient à vouloir suivre mon allure, et le pauvre diable était si essoufflé qu’il ne pouvait articuler un mot."
                                            },
                                            {
                                                "example_id": "29facc49-85df-4e70-91b9-8bd9f3b31aad",
                                                "sense_id": "599b102f-e149-3262-80fc-34d47b91f931",
                                                "text": "En fin de semaine, il officiait comme disc-jockey à « L’Enfer du Bagne », une discothèque hard sur la route d’Orange, où en plus de ses talents de manipulateur de saphirs, il devait prêter main-forte au service pendant l’heure du coup de feu, entre un tube de Jeanne Mas et le dernier Whapie-Doo-Whapie d’un rocker quinquagénaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quinquagénaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbafb807-a304-378e-9080-bc891fc1b415",
                                        "entry_id": "1f78a8bf-1ffc-327f-9fcd-b168dbf9bdd9",
                                        "glosses": [
                                            "Personne dont l’âge se situe entre 50 et 59 ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e803605b-54bf-44c1-8199-44f40d6de91d",
                                                "sense_id": "fbafb807-a304-378e-9080-bc891fc1b415",
                                                "text": "Cette étrangère n’avait qu’à paraître pour apprivoiser les plus récalcitrants et le quinquagénaire Bernage subit comme les autres l’ascendant de sa beauté."
                                            },
                                            {
                                                "example_id": "f5e5d695-b3ac-47cd-9dfc-2cfe92e00117",
                                                "sense_id": "fbafb807-a304-378e-9080-bc891fc1b415",
                                                "text": "Un quinquagénaire, quand il rentre en lui-même, ne rencontre sans doute que des masses solides, des chemins droits, des éclairages crus, au lieu des brouillards flottants de la vingtième année."
                                            },
                                            {
                                                "example_id": "4ca2fb1a-eaeb-41e2-a002-ed44a181291d",
                                                "sense_id": "fbafb807-a304-378e-9080-bc891fc1b415",
                                                "text": "Le quinquagénaire, qui songeait à la retraite, a connu une fin atroce le 9 juin 2020."
                                            },
                                            {
                                                "example_id": "153d5941-3397-40f0-a0d1-c735e3afab97",
                                                "sense_id": "fbafb807-a304-378e-9080-bc891fc1b415",
                                                "text": "Ces mots viennent d’Asie, quinquagénaire victime de violences conjugales pendant vingt-cinq ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6164545-6aec-3b23-a39b-5448c3119fa1",
                                        "entry_id": "1f78a8bf-1ffc-327f-9fcd-b168dbf9bdd9",
                                        "glosses": [
                                            "Dans l’armée de l’Empire byzantin, chef de cinquante hommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da9ee31-b616-48f4-a9f3-97d5f6aae72f",
                                                "sense_id": "f6164545-6aec-3b23-a39b-5448c3119fa1",
                                                "text": "Cependant ceux qui avaient reçu les ordres de l’empereur, les centurions, les quinquagénaires, les préposés aux marches militaires, se mirent en devoir d’accomplir leur mission."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
