                "senses": [
                    {
                        "sense_id": "c081adae-06df-363b-a6e7-5dc66b9812e9",
                        "entry_id": "57f5bf4a-04ba-3b24-979a-6e3dff99c15f",
                        "glosses": [
                            "kobieta zajmująca się zawodowo dziećmi, opiekująca się nimi"
                        ],
                        "tags": [],
