                        "cross_references": [
                            {
                                "target_word": "ведро",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ccc6468b-51d1-371b-b25b-22f5f5b35afe",
                                        "entry_id": "3288e481-0dc9-3962-b777-a0278f2633ca",
                                        "glosses": [
                                            "сосуд конической или цилиндрической формы с дугообразной ручкой для ношения и хранения жидкостей или сыпучих веществ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce14938-d2f0-4980-8fbd-a460a7b29836",
                                                "sense_id": "ccc6468b-51d1-371b-b25b-22f5f5b35afe",
                                                "text": "Перед ним стояла баба с вёдрами и коромыслом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b728881f-45e7-39c7-b319-1ffb1c0b2070",
                                        "entry_id": "3288e481-0dc9-3962-b777-a0278f2633ca",
                                        "glosses": [
                                            "количество чего-либо, вмещающееся в ведро [1]"
                                        ],
                                        "tags": [
                                            "с вин. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe66c4e7-7943-4300-846a-447462d9b401",
                                                "sense_id": "b728881f-45e7-39c7-b319-1ffb1c0b2070",
                                                "text": "В некоторых местах поливали ведрами навоза поля, мы бежали, что стало сил, от этой пахучей идиллии."
                                            },
                                            {
                                                "example_id": "f19f628f-d8e4-4fef-aa65-6e35d51e38d2",
                                                "sense_id": "b728881f-45e7-39c7-b319-1ffb1c0b2070",
                                                "text": "Он достал мне ведро масла, мы с Колькой привезли аккумуляторы, в общем, все чего-нибудь делали."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "966169f7-da12-3e81-970e-d22849a98e89",
                                        "entry_id": "3288e481-0dc9-3962-b777-a0278f2633ca",
                                        "glosses": [
                                            "истор. русская мера объёма жидкостей, применявшаяся до введения метрической системы мер, равная 1/40 бочки (около 12 литров)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd129f66-6ec5-474b-9f3d-b19c55ed67a9",
                                                "sense_id": "966169f7-da12-3e81-970e-d22849a98e89",
                                                "text": "Когда я пойду спать, купите ведро водки солдатам, и они будут спать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8652f6b-d635-3149-81aa-b3f8d761704b",
                                        "entry_id": "3288e481-0dc9-3962-b777-a0278f2633ca",
                                        "glosses": [
                                            "разг. то же, что мусорное ведро"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ab5a8a0-8b14-43dd-bb81-6d9fdd99ac18",
                                                "sense_id": "a8652f6b-d635-3149-81aa-b3f8d761704b",
                                                "text": "Не выносил ведро, даже если мусор сыпался наружу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2df963da-47c4-3309-bf2a-547622ec7f6c",
