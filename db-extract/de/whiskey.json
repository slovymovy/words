                        ],
                        "form": "die Whiskeys"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c977331-f014-355b-b26b-301ec7a0b0d7",
                        "entry_id": "b4569cdb-5127-3e36-8067-2fd9c1b92f6f",
                        "glosses": [
                            "Whisky, der in Irland oder Amerika aus Roggen oder Mais hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0705add-a629-41f7-b691-b89f394a0126",
                                "sense_id": "6c977331-f014-355b-b26b-301ec7a0b0d7",
                                "text": "„Er stand auf, ließ Hugo und mich im Arbeitszimmer zurück und ging ins Wohnzimmer, wo er sich einen Whiskey aus der Hausbar einschenken würde, einen großen.“"
                            },
                            {
                                "example_id": "304950a4-e9c6-498e-b9c8-771c28d1261f",
                                "sense_id": "6c977331-f014-355b-b26b-301ec7a0b0d7",
                                "text": "„Grenfeld orderte mit einer seit Jahren eingeübten Handbewegung zwei Whiskeys und hoffte auf die einsetzende Redseligkeit seines Kollegen.“"
                            },
                            {
                                "example_id": "c50f3c00-76e4-4f0c-8a17-9b72f2d47625",
                                "sense_id": "6c977331-f014-355b-b26b-301ec7a0b0d7",
                                "text": "„Ich war nie die Schlankeste, aber bei dieser ewigen Nudelkost habe ich angesetzt. Allerdings gab es da noch mehr, wenn ich ehrlich bin, kistenweise Schokolade, Kekse und andere Süßigkeiten, und ja, auch Alkohol, sogar harter Stoff, Whiskey, Gin, Wodka“"
                            },
                            {
                                "example_id": "afd9e1fd-84a3-40ed-ad08-9ea42ccd0a22",
                                "sense_id": "6c977331-f014-355b-b26b-301ec7a0b0d7",
                                "text": "„Sie zwinkerte mir zu und verschwand nach oben, und ich kaute auf meinem Bleistift herum und stellte mir Amalia als junge Frau vor mit feuerrotem Haar und kehligem Lachen, die mit wildfremden Männern in französischen Bars Whiskey trank und wusste, wie man Verletzungen verband und Freundschaften knüpfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
