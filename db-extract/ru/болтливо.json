                                            "häufig abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c056bd2-1665-4ff4-baa8-bb661a00b38e",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "Die Leute beim Kongress waren so geschwätzig, dass ich keine Lust hatte, selbst etwas zu sagen."
                                            },
                                            {
                                                "example_id": "e971ef64-633a-429a-b669-a93e23a48260",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "Ich kann deine ganzen geschwätzigen Verwandten nicht mehr länger ertragen."
                                            },
                                            {
                                                "example_id": "a6052674-afa1-4a59-bfef-8d8f1e5f2b6e",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "Die geschwätzige Amanda unterhielt wieder die ganze Kaffeetafel."
                                            },
                                            {
                                                "example_id": "6ce900b1-6dd1-43dd-919a-eb4c9b0cefce",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "Sieh bloß zu, dass du dem geschwätzigen Nachbarn nicht begegnest. Der quatscht dir eine Frikadelle ans Ohr."
                                            },
                                            {
                                                "example_id": "6ab3b6fe-caf3-4ec5-9266-26ae040f46bc",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "„In der selbstlosen und opferfreudigen Liebe eines Tieres ist etwas, das jedem tief zu Herzen gehen muß, der je Gelegenheit hatte, die armselige ›Freundschaft‹ und geschwätzige Treue des ›erhabenen‹ Menschen zu erproben.“"
                                            }
                                        ],
