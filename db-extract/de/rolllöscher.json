                "senses": [
                    {
                        "sense_id": "a02ba461-2631-3fee-b9c5-fc2a3a1aba1a",
                        "entry_id": "bbb9ea82-d0b5-3223-989c-a82a7bc044dd",
                        "glosses": [
                            "Gegenstand, der über eine mit Löschpapier versehene Rolle verfügt, um Tinte zum Beispiel beim Unterschreiben schnell aufzusaugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ec46823-d457-4b4d-a0a1-2f4f13fed999",
                                "sense_id": "a02ba461-2631-3fee-b9c5-fc2a3a1aba1a",
                                "text": "„Demonstrativ langsam stellte Lauritz den Scheck aus, streckte dann die Hand nach dem Rolllöscher auf dem Schreibtisch aus und trocknete die Tinte.“"
                            },
                            {
                                "example_id": "db2ca556-5836-4cda-97c1-f534112b05fd",
                                "sense_id": "a02ba461-2631-3fee-b9c5-fc2a3a1aba1a",
                                "text": "„Er legte den Federkiel nieder, blies über das Blatt und ging dann mit dem Rolllöscher über die noch feuchte Tinte.“"
                            },
                            {
                                "example_id": "11682386-3700-4fd0-b15c-893571537c1a",
                                "sense_id": "a02ba461-2631-3fee-b9c5-fc2a3a1aba1a",
                                "text": "„Nachdem sie es mit engelsgleicher Geduld ausgefüllt hatte, fuhr er gründlich mit dem Rolllöscher über die feuchte Tinte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
