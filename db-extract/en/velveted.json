        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "947a508c-8aad-393f-9691-422b5f442ca6",
                "word": "velveted",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "91068632-c945-30a4-be92-ccec45b0c82c",
                        "entry_id": "947a508c-8aad-393f-9691-422b5f442ca6",
                        "glosses": [
                            "Covered with velvet; wearing velvet clothing."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "326823c3-5ad0-4023-afe5-37d314b7beeb",
                                "sense_id": "91068632-c945-30a4-be92-ccec45b0c82c",
                                "text": "1653, François Rabelais, Pantagruel (1532), translated by Thomas Urquhart, in The Works of Rabelais, London: Chatto & Windus, 1873, Chapter 14, p. 33, https://archive.org/details/worksofrabelais00raberich\n\" […] of hats, note that some are shorn, and others shaggy, some velveted, others covered with taffities, and others with satin […] \""
                            },
                            {
                                "example_id": "00d182eb-8129-42e2-8a31-72f1e70f6d41",
                                "sense_id": "91068632-c945-30a4-be92-ccec45b0c82c",
                                "text": "[…] this yellow-starched and velveted old hag […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "291d6221-e24f-3801-8f52-10ba8ad149cf",
                        "entry_id": "947a508c-8aad-393f-9691-422b5f442ca6",
                        "glosses": [
                            "Having a velvet-like surface; covered with a velvet-like material."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f4be30bc-dd6b-48bb-9bf6-da57a258beb2",
                                "sense_id": "291d6221-e24f-3801-8f52-10ba8ad149cf",
                                "text": "Down there the \"furriner\" would have seen only the rough course of the creek between moss-velveted and shaded bowlders of titanic proportions."
                            },
                            {
                                "example_id": "a82b5021-3742-49d0-81c9-a65867c40ee9",
                                "sense_id": "291d6221-e24f-3801-8f52-10ba8ad149cf",
                                "text": "1965, Gustave Flaubert, Madame Bovary (1856), translated by Eleanor Marx Aveling and Paul de Man, New York: Norton, 2005, p. 289,\nThe tips of the trees were velveted with a pale brown dust, dotted irregularly here and there as though there had been a snowfall […]"
                            },
                            {
                                "example_id": "c3aaeabb-f07a-4dfc-8e02-0f932fcf6989",
                                "sense_id": "291d6221-e24f-3801-8f52-10ba8ad149cf",
                                "text": "Round and round the hilltop he led them, now hopelessly out of their reach, now letting them almost catch his tail, now diving between them, now tossing them in the air with his huge and beautifully velveted paws and catching them again, and now stopping unexpectedly so that all three of them rolled over together in a happy laughing heap of fur and arms and legs."
                            }
                        ]
                    }
