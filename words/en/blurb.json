{
    "word_family": [
        "blurbist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23e34656-5ada-3524-881f-3c29c3f1a802",
                    "sense_definition": "A short description of a book, film, or other work, written and used for promotional purposes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "promotional_description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I read the <w>blurb</w> on the back cover of the novel to see if it sounded interesting.",
                            "target_lang_translations": {
                                "ru": "Я прочитал <w>аннотацию</w> на задней обложке романа, чтобы понять, кажется ли он интересным."
                            }
                        },
                        {
                            "text": "The publisher asked several famous authors to write a short <w>blurb</w> for the upcoming book.",
                            "target_lang_translations": {
                                "ru": "Издатель попросил нескольких известных авторов написать короткий <w>рекламный отзыв</w> для готовящейся к выходу книги."
                            }
                        }
                    ],
                    "synonyms": [
                        "endorsement",
                        "promo",
                        "write-up"
                    ],
                    "common_phrases": [
                        "back cover blurb",
                        "write a blurb",
                        "promotional blurb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое описание книги, фильма или другого произведения, написанное и используемое в рекламных целях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аннотация",
                                "target_lang_sense_clarification": "краткое описание книги или фильма"
                            },
                            {
                                "target_lang_word": "рекламный текст",
                                "target_lang_sense_clarification": "краткое промо-описание"
                            },
                            {
                                "target_lang_word": "бёрб",
                                "target_lang_sense_clarification": "профессиональный термин в издательском деле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5854c2f0-abde-3e9f-add5-413d0bba8bb4",
                    "sense_definition": "To supply a book, film, or other work with a promotional description.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "promote_with_blurb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several prominent critics agreed to <w>blurb</w> the debut novel before its official release.",
                            "target_lang_translations": {
                                "ru": "Несколько известных критиков согласились <w>написать рекламные отзывы</w> на дебютный роман перед его официальным выходом."
                            }
                        },
                        {
                            "text": "The publisher wanted to <w>blurb</w> the book with quotes from famous writers.",
                            "target_lang_translations": {
                                "ru": "Издатель хотел <w>снабдить</w> книгу <w>аннотацией</w> с цитатами известных писателей."
                            }
                        }
                    ],
                    "synonyms": [
                        "promote",
                        "endorse"
                    ],
                    "common_phrases": [
                        "blurb the book"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать книгу, фильм или другое произведение кратким рекламным описанием (аннотацией)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снабжать аннотацией",
                                "target_lang_sense_clarification": "писать рекламный отзыв для книги"
                            },
                            {
                                "target_lang_word": "рекламировать",
                                "target_lang_sense_clarification": "продвигать с помощью краткого отзыва"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1c17a30-37bf-3997-b846-0901fb5a8c94",
                    "sense_definition": "To write or quote a short promotional description.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "promote_with_blurb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>blurb</w> a positive line from a popular blog in their opening advertisement.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>поместить в качестве рекламной цитаты</w> положительную строчку из популярного блога в своей первой рекламе."
                            }
                        },
                        {
                            "text": "The marketing team will <w>blurb</w> the best reviews on the movie poster.",
                            "target_lang_translations": {
                                "ru": "Маркетинговая команда <w>разместит краткие отзывы</w> из лучших рецензий на постере фильма."
                            }
                        }
                    ],
                    "synonyms": [
                        "quote",
                        "excerpt"
                    ],
                    "common_phrases": [
                        "blurb a quote"
                    ],
                    "target_lang_definitions": {
                        "ru": "Писать или цитировать краткое рекламное описание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цитировать в аннотации",
                                "target_lang_sense_clarification": "помещать цитату в рекламных целях"
                            },
                            {
                                "target_lang_word": "использовать в качестве отзыва",
                                "target_lang_sense_clarification": "размещать краткую рекомендацию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}