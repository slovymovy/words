                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c86b8a38-e6de-4b42-ac40-004a202bc75f",
                                "sense_id": "87472571-a5f4-385c-8042-c5280d86e60c",
                                "text": "„Noch zu meiner Gymnasialzeit gab es eine Unzahl ebenfalls alphabetisch geordneter pubertärer Ferkeleien nach diesem großen Vorbild.“"
                            },
                            {
                                "example_id": "8a282ffb-2581-41b4-a554-f04d95b7d6a0",
                                "sense_id": "87472571-a5f4-385c-8042-c5280d86e60c",
                                "text": "„Erst in der Gymnasialzeit wird Canetti im Naturkundeunterricht theoretisch zu den Tieren hingeführt und schockartig mit einer besonderen Wirklichkeit der Tiere konfrontiert.“"
                            },
                            {
                                "example_id": "e0009c35-02d8-40d3-b0b7-1e375cebc244",
                                "sense_id": "87472571-a5f4-385c-8042-c5280d86e60c",
                                "text": "„Am Ende der Gymnasialzeit stand der körperliche Zusammenbruch und die völlige Abwendung vom Christentum.“"
                            }
                        ],
