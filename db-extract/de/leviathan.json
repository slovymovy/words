                ],
                "senses": [
                    {
                        "sense_id": "f09e9a22-d264-36ce-9759-0a7218c6b122",
                        "entry_id": "f7624565-1de2-3b17-8ef3-7df7115f8d25",
                        "glosses": [
                            "Seeungeheuer der jüdisch-christlichen Mythologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8018a99-a547-4c39-8cc6-8678d2894d94",
                                "sense_id": "f09e9a22-d264-36ce-9759-0a7218c6b122",
                                "text": "„Die jüdische Mythologie schildert den apokalyptischen Kampf zwischen Leviathan und Behemot, welche am Ende der Tage von den Gerechten in einem Festmahl verzehrt werden.“"
                            },
                            {
                                "example_id": "978e5e05-3e5d-483f-8142-8cb9b3357137",
                                "sense_id": "f09e9a22-d264-36ce-9759-0a7218c6b122",
                                "text": "„Der Titel lehnt sich an das biblisch-mythologische Seeungeheuer Leviathan an, vor dessen Allmacht jeglicher menschliche Widerstand zuschanden werden muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fbee6746-15c4-31d7-b580-54f701244770",
                        "entry_id": "f7624565-1de2-3b17-8ef3-7df7115f8d25",
                        "glosses": [
                            "Titel einer staatstheoretischen Schrift von Thomas Hobbes (Erstausgabe 1651)"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c82385ab-12a3-4b16-97b8-7fc09c0090e9",
                                "sense_id": "fbee6746-15c4-31d7-b580-54f701244770",
                                "text": "„Hobbes Leviathan gab seinen Namen auch einer Zeitschrift für Sozialwissenschaft, vgl. Leviathan, Zeitschrift für Sozialwissenschaft.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "94d09aaf-4c0f-3929-bf05-fefc0da5eada",
                        "entry_id": "f7624565-1de2-3b17-8ef3-7df7115f8d25",
                        "glosses": [
                            "Titel einer staatstheoretischen Schrift von Thomas Hobbes (Erstausgabe 1651)",
                            "Sinnbild des absolutistischen Staates"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "63652916-fc44-4d71-8f49-5e6d5f6506cc",
                                "sense_id": "94d09aaf-4c0f-3929-bf05-fefc0da5eada",
                                "text": "„Angesichts der rückhaltlosen Übertragung und Konzentration jeglicher Herrschaftsgewalt auf eine friedenssichernde Instanz im Staate, den Leviathan, dessen Autorität im Inneren nicht relativiert oder hinterfragt werden darf, ist die Vorstellung einer Reglementierung dieser Autorität in seinen auswärtigen Beziehungen grundsätzlich problematisch“"
                            }
                        ],
                        "sense_index_json": "\"2a\""
                    },
                    {
                        "sense_id": "c4915e1a-74f0-35a3-8830-6f299332cf0e",
                        "entry_id": "f7624565-1de2-3b17-8ef3-7df7115f8d25",
                        "glosses": [
                            "nicht mehr verwendeter Name für die Gattung Mammut"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "55cfd3e2-3253-457d-b10a-463e9040b3fe",
                                "sense_id": "c4915e1a-74f0-35a3-8830-6f299332cf0e",
                                "text": "„Da der Gattungsname Leviathan bereits 1841 eingeführt worden war (heute als Synonym für die Gattung Mammut Blumenbach, 1799 betrachtet), wurde der Gattungsname von den Beschreibern wenig später in die hebräische Form Livyatan geändert.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
