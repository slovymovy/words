                    },
                    {
                        "translation_id": "55d61183-7138-4846-af19-d9fc72dae7e5",
                        "source_entry_id": "e7abce9b-d023-3e95-8a8f-0ee665a4b160",
                        "source_sense_description": "not violable; not to be infringed",
                        "target_lang_word": "inviolable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inviolable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d693f08-d594-3652-9cff-70fa718664b4",
                                        "entry_id": "3c68412e-f17d-383b-8939-fcb170b89245",
                                        "glosses": [
                                            "Que l’on ne peut profaner ou pénétrer (en parlant d’un lieu, d’un monument, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "842286f1-9bef-41e3-906b-c7c54f0a4253",
                                                "sense_id": "0d693f08-d594-3652-9cff-70fa718664b4",
                                                "text": "Peut-être s’est-il jeté dans le lac, dont les eaux sont le plus discret et inviolable des tombeaux."
                                            },
                                            {
                                                "example_id": "5f2c128d-a918-4c26-a62f-dfd9616cf533",
                                                "sense_id": "0d693f08-d594-3652-9cff-70fa718664b4",
                                                "text": "Elle ressemblait à un coffret à cigares mais, en fait, c’était une boîte antihacking. Une sorte de cage de Faraday qui assurait une confidentialité presque inviolable des conversations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70814f2a-8e1f-353c-a503-43f9231f3993",
                                        "entry_id": "3c68412e-f17d-383b-8939-fcb170b89245",
                                        "glosses": [
                                            "Qu’on ne doit jamais violer, auquel on ne doit jamais attenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c079c9a9-6058-4c1a-b979-fba2bbed7444",
                                                "sense_id": "70814f2a-8e1f-353c-a503-43f9231f3993",
                                                "text": "[…], elle lui assurerait une existence tranquille, à la condition de garder un secret inviolable sur le service réclamé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2a1ba3e-458d-3a78-b884-e349c9dc5b06",
                                        "entry_id": "3c68412e-f17d-383b-8939-fcb170b89245",
                                        "glosses": [
                                            "Qu’il est impossible de violer (au sens sexuel)."
                                        ],
                                        "tags": [
                                            "Très rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ebb4419-772a-4f86-a6e3-0a1c137390e8",
                                                "sense_id": "d2a1ba3e-458d-3a78-b884-e349c9dc5b06",
                                                "text": "Je vois alors, et quoi qu’on ose tenter, que la majesté royale est décidément… inviolable !!!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
