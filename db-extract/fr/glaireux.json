                                            {
                                                "example_id": "58ee9d67-d83b-4981-bf80-f65d8a239a17",
                                                "sense_id": "76a6e220-ee60-3760-a1a6-7683a577f7a2",
                                                "text": "Diese Hafergrütze ist ja ganz eklig schleimig geworden. Die mag ich nicht essen."
                                            },
                                            {
                                                "example_id": "1fe81e76-f6e0-4344-8cdf-3b48a1117de8",
                                                "sense_id": "76a6e220-ee60-3760-a1a6-7683a577f7a2",
                                                "text": "„Wir erinnern auch daran, dass Kolonien auf dünn besiedelten Platten schleimiger sind als auf dichten Platten, junge Kolonien schleimiger als ältere, Bohnenagarkulturen schleimiger als Fleischagarkulturen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "daef5447-a198-3a43-8142-210dc18e4228",
                                        "entry_id": "1acf8873-0906-33e6-8ec0-5a100b02ed5a",
                                        "glosses": [
                                            "falsch, nur übertrieben freundlich tuend"
                                        ],
