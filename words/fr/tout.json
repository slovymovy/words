{
    "word_family": [
        "surtout",
        "toutefois"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "cebf3d17-14cb-3d06-91ed-a43771f4193f",
                    "sense_definition": "Toutes les choses, l'ensemble des éléments inanimés ou abstraits.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pron_choses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'inquiète pas pour les préparatifs, <w>tout</w> est prêt pour la fête."
                        },
                        {
                            "text": "Elle a <w>tout</w> compris dès la première explication du professeur."
                        }
                    ],
                    "antonyms": [
                        "rien"
                    ],
                    "common_phrases": [
                        "merci pour tout",
                        "tout va bien",
                        "tout ou rien"
                    ]
                },
                {
                    "sense_id": "6f4bc902-c1d0-303f-afde-9c4a5cd1f0e1",
                    "sense_definition": "Toutes les personnes d'un groupe ou l'ensemble des individus.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pron_personnes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants sont arrivés à l'école et <w>tous</w> avaient leur cartable."
                        },
                        {
                            "text": "Mes collègues sont formidables et <w>tous</w> m'ont félicité chaleureusement."
                        }
                    ],
                    "synonyms": [
                        "chacun"
                    ],
                    "antonyms": [
                        "aucun",
                        "personne"
                    ],
                    "common_phrases": [
                        "bonjour à tous",
                        "un pour tous"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "97515e42-93ac-3ba4-bb72-6c9d24e23c06",
                    "sense_definition": "Entièrement, complètement, au plus haut point.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "degre_complet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette maison de campagne est <w>tout</w> près de la forêt."
                        },
                        {
                            "text": "Elle était <w>toute</w> contente de recevoir cette lettre inattendue."
                        }
                    ],
                    "synonyms": [
                        "complètement",
                        "entièrement",
                        "totalement"
                    ],
                    "antonyms": [
                        "partiellement"
                    ],
                    "common_phrases": [
                        "tout à fait",
                        "tout près",
                        "tout seul",
                        "tout droit"
                    ]
                },
                {
                    "sense_id": "14d1f015-b685-342b-aa8c-ca02da94f966",
                    "sense_definition": "Renforce la simultanéité lorsqu'il est placé devant un gérondif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "simultaneite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il écoute de la musique classique <w>tout</w> en révisant ses leçons."
                        },
                        {
                            "text": "Elle préparait le dîner <w>tout</w> en discutant tranquillement avec ses invités."
                        }
                    ],
                    "common_phrases": [
                        "tout en sachant",
                        "tout en écoutant"
                    ]
                },
                {
                    "sense_id": "05f96a14-db12-33bd-adb2-459a5a093824",
                    "sense_definition": "Suivi d'un adjectif et de la conjonction que, marque une concession ou une opposition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tout</w> adroit qu'il soit, cet artisan n'a pas réussi à réparer l'horloge."
                        },
                        {
                            "text": "<w>Toute</w> riche qu'elle était, cette femme menait une vie très simple."
                        }
                    ],
                    "common_phrases": [
                        "tout jeune qu'il est",
                        "tout savant qu'il soit"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "667bcffe-5a51-3437-852c-d827c27f8593",
