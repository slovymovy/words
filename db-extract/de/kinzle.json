                ],
                "senses": [
                    {
                        "sense_id": "fdd3b5f9-6db4-37d9-b935-7686115dd057",
                        "entry_id": "ffec3d79-43f7-3205-ad45-6c81d1b922b3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b6e9c1-8b20-4613-a320-4f6033d1b70d",
                                "sense_id": "fdd3b5f9-6db4-37d9-b935-7686115dd057",
                                "text": "Frau Kinzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "16741989-fd94-441f-99e2-aa07ce93f43d",
                                "sense_id": "fdd3b5f9-6db4-37d9-b935-7686115dd057",
                                "text": "Herr Kinzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "47685cb8-ad5f-4de6-8efe-3431d48271a0",
                                "sense_id": "fdd3b5f9-6db4-37d9-b935-7686115dd057",
                                "text": "Die Kinzles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "42bd8e4d-7cf2-4974-a996-7555f0c737db",
                                "sense_id": "fdd3b5f9-6db4-37d9-b935-7686115dd057",
                                "text": "Der Kinzle trägt nie die Schals, die die Kinzle ihm strickt."
                            },
                            {
                                "example_id": "a01bba6f-7f8f-4819-8bd1-95688f3c872b",
                                "sense_id": "fdd3b5f9-6db4-37d9-b935-7686115dd057",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kinzle kommt, geht der Herr Kinzle.“"
                            },
                            {
                                "example_id": "cd1c4789-7cb8-4325-b029-3c9cdd54bea4",
                                "sense_id": "fdd3b5f9-6db4-37d9-b935-7686115dd057",
                                "text": "Kinzle kommt und geht."
                            },
                            {
                                "example_id": "4ab2ee6f-1e68-4a25-ad77-5a080c900147",
                                "sense_id": "fdd3b5f9-6db4-37d9-b935-7686115dd057",
                                "text": "Kinzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
