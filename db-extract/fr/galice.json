                        "entry_id": "60ae0efd-1780-3cdd-98e9-c0c0ff4f1177",
                        "glosses": [
                            "Région située au coin nord-ouest de l’Espagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "824b7f05-bee3-4c29-a7f4-c83590a162fa",
                                "sense_id": "b9a91c34-16f9-3622-8f67-74f83aba6af5",
                                "text": "Selon les équipes du CSIC, l’équivalent espagnol du CNRS, ils évoluent actuellement sur près de 17 000 kilomètres carrés, sur les monts situés entre la Galice et Santander."
                            },
                            {
                                "example_id": "67c6c34e-005d-4663-a693-ad10c0423986",
                                "sense_id": "b9a91c34-16f9-3622-8f67-74f83aba6af5",
                                "text": "Dans l’unique voiture du train qui parcourt le nord de l’Espagne, de Gijon, dans les Asturies, à Ferrol, en Galice, nous sommes une dizaine à voyager."
                            }
                        ]
                    }
