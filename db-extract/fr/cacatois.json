                                "example_id": "41131100-e43a-46e9-a08c-8f7be3df5a62",
                                "sense_id": "f1aa1077-4cce-3e60-9a96-12477ae42739",
                                "text": "J’aimerais mieux chevaucher pendant deux heures sur le grand cacatois, pendant un coup de vent de nord-ouest ! v"
                            }
                        ]
                    },
                    {
                        "sense_id": "76c4efe2-d82b-32da-8912-c45a1546d1fe",
