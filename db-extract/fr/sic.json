                                        "sense_id": "e1ba1e49-05ef-3072-99d1-b3175442f18f",
                                        "entry_id": "ed9f0cfe-4cc8-3a66-9a2a-5575a62ce8b6",
                                        "glosses": [
                                            "междометие выражает состояние размышления"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
