                                    {
                                        "sense_id": "13966d11-9572-35cf-801b-53de150260b4",
                                        "entry_id": "6a49dc46-7ae7-3328-ad3d-3fc819076763",
                                        "glosses": [
                                            "A musical composition that expresses a specific mood or non-musical idea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3060b544-3ffb-4743-ac99-98ca9e6fa928",
                                                "sense_id": "13966d11-9572-35cf-801b-53de150260b4",
                                                "text": "That does not mean that all character pieces of this period present moods expressly, only that the musical term 'character' is not always telling for character pieces, to put it crudely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bacf841-f868-3b0a-be55-146eca7da74f",
                                        "entry_id": "6a49dc46-7ae7-3328-ad3d-3fc819076763",
                                        "glosses": [
                                            "A work of art (painting, sculpture, writing, film, etc.) that has as its subject matter the description or depiction of an individual person or character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f2585e5-6f05-43c0-b3bb-47566082a642",
                                                "sense_id": "4bacf841-f868-3b0a-be55-146eca7da74f",
                                                "text": "In spite of it being a character piece, I really loved how the rocks and dirt were brought to life."
                                            },
                                            {
                                                "example_id": "d5e76384-3685-4076-894f-944b30343913",
                                                "sense_id": "4bacf841-f868-3b0a-be55-146eca7da74f",
                                                "text": "Wilde was impressed by Beerbohm's critical, yet laudatory character piece on him in the Anglo-American Times of March 25, 1893, entitled 'OW by [Max Beerbohm masquerading as] an American'."
                                            },
                                            {
                                                "example_id": "47faf596-88e7-40e9-9ef2-892c6f9c4141",
                                                "sense_id": "4bacf841-f868-3b0a-be55-146eca7da74f",
                                                "text": "The \"Leah Dawson 'Slow Down'\" video is a magical character piece."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
