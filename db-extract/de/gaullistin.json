                "senses": [
                    {
                        "sense_id": "83667cae-ea2e-3aa1-835d-2840c4503451",
                        "entry_id": "e40f3908-7f36-3bda-99f4-e23f41cc5e66",
                        "glosses": [
                            "Anhängerin des Gaullismus (politische Bewegung, die die Ideen von General Charles de Gaulle vertritt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c99576f0-b95d-4ffc-8cc5-0c485936387b",
                                "sense_id": "83667cae-ea2e-3aa1-835d-2840c4503451",
                                "text": "„Die Auslandsabteilung der Präfektur wurde von einer Madame Esmiol geleitet, von der die französischen Widerständler wußten, daß sie als Gaullistin die Besatzer haßte.“"
                            },
                            {
                                "example_id": "bf5bb6fa-2ef1-438f-9441-33a721be4ed1",
                                "sense_id": "83667cae-ea2e-3aa1-835d-2840c4503451",
                                "text": "„In der Zelle über ihr sitzt eine Mittelschullehrerin, eine Gaullistin, in der Zelle unter ihr eine Rechtsanwältin und in der anderen Nachbarzelle eine Studentin.“"
                            },
                            {
                                "example_id": "6b47353b-2830-42ee-b9e7-f72ec989e78e",
                                "sense_id": "83667cae-ea2e-3aa1-835d-2840c4503451",
                                "text": "„Michèle Alliot-Marie , 60, französische Verteidigungsministerin, lässt sich von pöbelnden Parteifreunden nicht einfach den Mund verbieten. Die MAM genannte Gaullistin, die mit militärischem Auftreten besticht und gern Präsidentin Frankreichs werden möchte, musste auf einem Parteikongress Pfiffe und Buhrufe über sich ergehen lassen.“"
                            },
                            {
                                "example_id": "a2f13d55-f066-44aa-9cb0-849284431757",
                                "sense_id": "83667cae-ea2e-3aa1-835d-2840c4503451",
                                "text": "„Eine weitere orthodoxe Gaullistin aus der Chirac-Zeit, Michèle Alliot-Marie, wechselt vom Justiz- ins Außenministerium,“ […]."
                            },
                            {
                                "example_id": "8dfac801-7d22-4cc5-9734-54f17b63acac",
                                "sense_id": "83667cae-ea2e-3aa1-835d-2840c4503451",
                                "text": "[Schlagzeile:] „Korrupte Gaullistin kommt ungestraft davon“"
                            },
                            {
                                "example_id": "5e3d7c09-ef07-45f0-90ce-f73f8dd644a4",
                                "sense_id": "83667cae-ea2e-3aa1-835d-2840c4503451",
                                "text": "„Am liebsten trüge sie gleich zwei Rosetten der Ehrenlegion, wie sie auch, glühende Gaullistin, »in jedem Knopfloch ein Lothringer-Kreuz« getragen hat, als US-General Dwight D. Eisenhower dem Exil-General Giraud mehr Vertrauen schenkte als dem Exil-General de Gaulle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
