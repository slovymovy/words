                                        ],
                                        "examples": [
                                            {
                                                "example_id": "466f98cd-d7d7-4591-bc92-99e806a4ac32",
                                                "sense_id": "8d19fd20-9297-3bea-bd9f-c86843863483",
                                                "text": "Epidural anesthesia is commonly used for pain relief during childbirth."
