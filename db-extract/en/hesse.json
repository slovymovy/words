                                        "glosses": [
                                            "Commune française, située dans le département de la Moselle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0bbb6b4-20a3-4c05-9aba-df9ce0c4003b",
                                                "sense_id": "795f61a5-be04-30c2-be21-98191b5d7786",
                                                "text": "L’abbaye bénédictine de Hesse fut fondée au début du Xᵉ siècle par Hugues IV de Nordgau, comte d’Eguisheim, et comte de Dabo."
                                            }
                                        ]
                                    }
                                ]
