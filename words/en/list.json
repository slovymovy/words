                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tilt_lean",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat began to <w>list</w> dangerously as the waves grew higher.",
