                ],
                "senses": [
                    {
                        "sense_id": "bbc37cd3-6092-3a93-9dc7-3ce233c16e24",
                        "entry_id": "71340cc7-78d8-3087-89be-4daa1208e847",
                        "glosses": [
                            "Manger avidement."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7e0d7b28-a954-4a7b-a42d-2791e39dea56",
                                "sense_id": "bbc37cd3-6092-3a93-9dc7-3ce233c16e24",
                                "text": "Oh ! le bon appétit ! Voyez comme il briffe !"
                            },
                            {
                                "example_id": "c028878b-907d-4f68-a832-c13440af1285",
                                "sense_id": "bbc37cd3-6092-3a93-9dc7-3ce233c16e24",
                                "text": "Pendant ce temps-là moi je vis à Aubervilliers\nC’est un petit coin perdu au bout de la misère\nOù l’on n’a pas tellement de questions à se poser\nPour briffer, faut bosser mon petit père."
                            },
                            {
                                "example_id": "2d915050-5368-4a18-b710-efc11cea8896",
                                "sense_id": "bbc37cd3-6092-3a93-9dc7-3ce233c16e24",
                                "text": "Si tu veux venir avec nous à la tortore, proposa Carrier, y aura à briffer pour tout le monde."
                            }
                        ]
                    }
