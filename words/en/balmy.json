{
    "word_family": [
        "balm",
        "balminess"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6abb13c1-1043-3df5-905e-3666997b99fc",
                    "sense_definition": "Characterized by pleasantly mild, warm, and gentle weather.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pleasant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took a relaxing evening walk under the <w>balmy</w> summer skies.",
                            "target_lang_translations": {
                                "pl": "Odbyliśmy relaksujący wieczorny spacer pod <w>balsamicznym</w> letnim niebem."
                            }
                        },
                        {
                            "text": "A gentle, <w>balmy</w> breeze drifted through the open bedroom window.",
                            "target_lang_translations": {
                                "pl": "Delikatny, <w>ciepły</w> powiew wpadł przez otwarte okno sypialni."
                            }
                        }
                    ],
                    "antonyms": [
                        "inclement",
                        "harsh"
                    ],
                    "common_phrases": [
                        "balmy evening",
                        "balmy breeze",
                        "balmy weather"
                    ],
                    "target_lang_definitions": {
                        "pl": "O pogodzie lub powietrzu: przyjemnie ciepły, łagodny i kojący."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "balsamiczny",
                                "target_lang_sense_clarification": "o powietrzu, pogodzie"
                            },
                            {
                                "target_lang_word": "łagodny",
                                "target_lang_sense_clarification": "o klimacie, wietrze"
                            },
                            {
                                "target_lang_word": "ciepły",
                                "target_lang_sense_clarification": "o przyjemnej temperaturze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04ef040c-4b82-37b5-b389-bce287a4476c",
                    "sense_definition": "Foolish, eccentric, or slightly crazy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone thought he had gone entirely <w>balmy</w> when he quit his job to hunt ghosts.",
                            "target_lang_translations": {
                                "pl": "Wszyscy myśleli, że kompletnie <w>zgłupiał</w>, kiedy rzucił pracę, by polować na duchy."
                            }
                        },
                        {
                            "text": "It sounds like a completely <w>balmy</w> idea, but it might actually work.",
                            "target_lang_translations": {
                                "pl": "To brzmi jak zupełnie <w>zwariowany</w> pomysł, ale może faktycznie zadziałać."
                            }
                        }
                    ],
                    "synonyms": [
                        "barmy"
                    ],
                    "antonyms": [
                        "sane"
                    ],
                    "common_phrases": [
                        "drive someone balmy",
                        "go balmy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal or colloquial expression"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Niedorzeczny, zwariowany lub niespełna rozumu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zwariowany",
                                "target_lang_sense_clarification": "o pomyśle, zachowaniu"
                            },
                            {
                                "target_lang_word": "stuknięty",
                                "target_lang_sense_clarification": "potocznie o osobie"
                            },
                            {
                                "target_lang_word": "szalony",
                                "target_lang_sense_clarification": "niepoczytalny, ekscentryczny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cae311b-4991-3730-b7c1-e3abbf11459b",
                    "sense_definition": "Having a soothing, fragrant, or healing quality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pleasant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with the <w>balmy</w> scent of blooming jasmine.",
                            "target_lang_translations": {
                                "pl": "Ogród wypełniał <w>kojący</w> zapach kwitnącego jaśminu."
                            }
                        },
                        {
                            "text": "She applied a <w>balmy</w> lotion to ease her sunburned skin.",
                            "target_lang_translations": {
                                "pl": "Nałożyła <w>łagodzący</w> balsam, aby przynieść ulgę poparzonej słońcem skórze."
                            }
                        }
                    ],
                    "common_phrases": [
                        "balmy air",
                        "balmy scent"
                    ],
                    "target_lang_definitions": {
                        "pl": "Przynoszący ukojenie, mający właściwości gojące lub wydzielający przyjemną, aromatyczną woń."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kojący",
                                "target_lang_sense_clarification": "przynoszący ulgę"
                            },
                            {
                                "target_lang_word": "balsamiczny",
                                "target_lang_sense_clarification": "aromatyczny, uzdrawiający"
                            },
                            {
                                "target_lang_word": "łagodzący",
                                "target_lang_sense_clarification": "o maści, kosmetyku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54d21d75-018a-3198-a338-e0cbefb55d25",
                    "sense_definition": "Producing or yielding aromatic balm or resin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They harvested fragrant resin from the <w>balmy</w> shrubs growing on the hillside.",
                            "target_lang_translations": {
                                "pl": "Zbierali pachnącą żywicę z <w>balsamicznych</w> krzewów rosnących na zboczu wzgórza."
                            }
                        },
                        {
                            "text": "The travelers rested in a grove of <w>balmy</w> trees rich with aromatic gum.",
                            "target_lang_translations": {
                                "pl": "Podróżnicy odpoczywali w zagajniku <w>balsamicznych</w> drzew obfitujących w aromatyczną gumę."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare botanical sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wydzielający lub wytwarzający wonny balsam bądź żywicę."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "balsamiczny",
                                "target_lang_sense_clarification": "o roślinie wydzielającej balsam"
                            },
                            {
                                "target_lang_word": "żywiczny",
                                "target_lang_sense_clarification": "zawierający żywicę lub balsam"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}