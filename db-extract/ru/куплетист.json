                        "examples": [
                            {
                                "example_id": "fd65495a-1e51-470c-ae75-4f34dccdca37",
                                "sense_id": "00118f41-2c1f-3858-a899-561db0686d7e",
                                "text": "Перед сеансом показывали дивертисмент: выступали фокусники, жонглеры, похожая на рыбу певица в чешуйчатом платье спела два романса, две девушки в матросских штанах сплясали матлот, а под конец выступил куплетист, который исполнял под аккомпанемент маленького аккордеона «частушки на злобу дня»."
                            }
                        ]
                    }
