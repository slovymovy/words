                                "example_id": "924ecc6f-f597-4bfe-8757-41a304e42c70",
                                "sense_id": "96f29162-f102-378f-a3c7-66449edde73a",
                                "text": "Well, if he, Karl, owned a pair of pants like that it would be no trick at all to captivate the most demurring siren."
                            }
                        ]
