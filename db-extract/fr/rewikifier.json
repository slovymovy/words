                        "sense_id": "d572bdad-3d2a-3918-8fa6-343ea256792c",
                        "entry_id": "617a208d-183e-345d-bfd5-0f72e08701c3",
                        "glosses": [
                            "Wikifier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b90b04f9-5986-4dee-9f90-e4c4f955002e",
                                "sense_id": "d572bdad-3d2a-3918-8fa6-343ea256792c",
                                "text": "Si cela te gêne, n'hésite pas à tout rewikifier."
                            },
                            {
                                "example_id": "8f743b75-de03-428d-9ecb-b14c06370513",
                                "sense_id": "d572bdad-3d2a-3918-8fa6-343ea256792c",
                                "text": "Il y a donc un risque de rewikifier un mot déjà wikifié, et c'est très difficile à voir dans l'historique. — (ya modifié en y a)"
                            },
                            {
                                "example_id": "30bb8b99-6db4-4923-ab31-0bb488191342",
                                "sense_id": "d572bdad-3d2a-3918-8fa6-343ea256792c",
                                "text": "Plat + entièrement à rewikifier + pas vraiment retravaillable."
                            }
                        ]
                    }
