                        "sense_id": "fe974ff1-aafc-3e50-851b-4897526a4c9d",
                        "entry_id": "7e951da7-fc3a-3ce6-8035-cb64960786e9",
                        "glosses": [
                            "Qualifie l’action linguistique qui consiste à parler d’un tiers absent (ou écarté volontairement) de l'acte linguistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e4d41e8-72d1-447c-8576-9c9785372359",
                                "sense_id": "fe974ff1-aafc-3e50-851b-4897526a4c9d",
                                "text": "Bien que la forme soit délocutive, elle ne fait pas toujours l’objet d’un emploi délocutoire. Sur les 87 items, 29 relèvent d’un emploi allocutoire correspondant à la troisième personne de politesse."
                            },
                            {
                                "example_id": "732d6caa-97da-4fb6-b82a-2ca191fc142d",
                                "sense_id": "fe974ff1-aafc-3e50-851b-4897526a4c9d",
                                "text": "Sur le plan délocutoire, le locutif et l’allocutif représentent en effet la transposabilité dans le monde extérieur (chosalité) dont jouissent les deux éléments du monde subjectif, locuteur et allocutaire."
                            },
                            {
                                "example_id": "0f71a114-9aca-4f34-a70b-4ff22dacaa48",
                                "sense_id": "fe974ff1-aafc-3e50-851b-4897526a4c9d",
                                "text": "L’explication pourrait être en effet que le verbe peut s’insérer dans au moins trois types d’actes de parole différents, que nous appellerons des actes expressifs, des actes allocutoires et des actes délocutoires."
                            }
                        ]
                    }
