                "senses": [
                    {
                        "sense_id": "a00ab48e-6e99-3719-ac01-882bfc70cd3d",
                        "entry_id": "fa5625ef-d021-389e-8c32-f4747c5d4437",
                        "glosses": [
                            "etwas oder jemand, der jünger und/oder weniger einflussreich als sein Partner ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5b88945-d36b-489b-a657-4d7357d9d9ce",
                                "sense_id": "a00ab48e-6e99-3719-ac01-882bfc70cd3d",
                                "text": "„Im Saarland schien ihr Schicksal als Juniorpartner der CDU besiegelt; in Düsseldorf und Kiel mussten die Ministerpräsidenten Hannelore Kraft und Torsten Albig um ihre Mehrheiten fürchten.“"
                            },
                            {
                                "example_id": "665acd24-89da-4b23-8839-080661d00897",
                                "sense_id": "a00ab48e-6e99-3719-ac01-882bfc70cd3d",
                                "text": "„Erst von 1928 an übernahmen rechtsstehende Figuren die Führung der DNVP, de schließlich zum Juniorpartner der Nationalsozialisten werden sollte.“"
                            },
                            {
                                "example_id": "c97ebb4c-7078-40ee-bccb-46258d065fc5",
                                "sense_id": "a00ab48e-6e99-3719-ac01-882bfc70cd3d",
                                "text": "„Tatsächlich gelang es Mugabe, innerhalb einiger Monate Nkomo als seinen Juniorpartner erscheinen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
