                },
                {
                    "sense_id": "8637641d-f82b-36f5-b4eb-6d25e5d46d91",
                    "sense_definition": "Attention ou intérêt favorable accordé aux propos ou aux idées de quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses propositions novatrices ont enfin trouvé une véritable <w>audience</w> auprès des membres du comité."
                        },
                        {
                            "text": "Le philosophe regrettait que ses avertissements ne rencontrent aucune <w>audience</w> au sein de la société."
