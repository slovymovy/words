                                "target_senses": [
                                    {
                                        "sense_id": "e0601ed6-bdc5-3bc2-8076-7026a4fd257e",
                                        "entry_id": "c6793832-b710-3e84-90a4-97ad4e53ed88",
                                        "glosses": [
                                            "een positief gevoel oproepend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1205e15e-81f0-4c70-9d23-4d6624ed8c36",
                                                "sense_id": "e0601ed6-bdc5-3bc2-8076-7026a4fd257e",
                                                "text": "Het is een aangename gewaarwording als je merkt dat je werk een goed effect heeft gehad."
                                            },
                                            {
                                                "example_id": "66f769b9-e180-4923-b37c-cf376066e4ee",
                                                "sense_id": "e0601ed6-bdc5-3bc2-8076-7026a4fd257e",
                                                "text": "`Aangenaam kennis te maken, Abdul.' Ik zei mijn naam. 'Laten we naar binnen gaan. Dan kan het beginnen."
                                            },
                                            {
                                                "example_id": "f7d6f12d-a898-41a9-a26b-a58cd1d98486",
                                                "sense_id": "e0601ed6-bdc5-3bc2-8076-7026a4fd257e",
                                                "text": "Overal kleefden herinneringen aan. Bijna altijd waren het aangename."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5eeffd6c-1676-44ee-8581-a605851ef5cf",
                        "source_entry_id": "18a8fa17-1b71-3820-b9d4-02fdf6e9f48a",
                        "source_sense_description": "tending to invite favour; attractive",
                        "target_lang_word": "avenant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avenant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3dec5863-2996-3134-9034-de71685e8296",
                                        "entry_id": "b740085a-597b-31be-940e-908c2d7b77c2",
                                        "glosses": [
                                            "Qui plaît par sa manière d’être, pour une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30de2cc2-4232-44b9-bc0f-c0fdb9e82de0",
                                                "sense_id": "3dec5863-2996-3134-9034-de71685e8296",
                                                "text": "L'hôtesse était aimable et sa fille fort avenante, – ayant de beaux cheveux châtains, une figure régulière et douce, et ce parler si charmant des pays de brouillard, qui donne aux plus jeunes filles des intonations de contralto, par moments !"
                                            },
                                            {
                                                "example_id": "0fa5b48b-72ad-4e4b-9ce1-ef96e929f258",
                                                "sense_id": "3dec5863-2996-3134-9034-de71685e8296",
                                                "text": "[…] la directrice du casino, souriante, vient nous saluer. Elle est grosse et fort avenante, et elle porte sur la tête, très en arrière, une coiffe en forme de court hennin."
                                            },
                                            {
                                                "example_id": "d3ea4d25-b5a9-472f-bb73-fa3fb7d722f1",
                                                "sense_id": "3dec5863-2996-3134-9034-de71685e8296",
                                                "text": "Une des brus vint s’installer près de lui, une petite femme de boutique, parée dès le matin, et qui avait bien cet air avenant, faussement doux, cette amabilité obséquieuse des gens habitués au commerce."
                                            },
                                            {
                                                "example_id": "93c5f2a2-3997-4cc7-ba52-1543d1868f07",
                                                "sense_id": "3dec5863-2996-3134-9034-de71685e8296",
                                                "text": "La respiration tend à nous rendre plus avenants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a75bed8c-0c72-3e63-8c28-2adcc4743f39",
                                        "entry_id": "b740085a-597b-31be-940e-908c2d7b77c2",
                                        "glosses": [
                                            "Qui plaît par son aspect, pour une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f635f891-5d28-4ef8-b956-94c592b48d13",
                                                "sense_id": "a75bed8c-0c72-3e63-8c28-2adcc4743f39",
                                                "text": "En débarquant, ils apercevront sur le bord de la mer, tout à gauche, une maison avenante dont la porte est toujours ouverte."
                                            },
                                            {
                                                "example_id": "41c930a3-167b-4057-9855-837024b25e58",
                                                "sense_id": "a75bed8c-0c72-3e63-8c28-2adcc4743f39",
                                                "text": "Pour une politique avenante parce qu’essentielle et anticipatrice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "avenant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36bbd247-2210-3783-b6d3-d120528d9af4",
                                        "entry_id": "c91abe9b-9116-35ab-a318-eb1d0283f27e",
                                        "glosses": [
                                            "Document contractuel modifiant ou complétant un contrat déjà existant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "900e521e-0254-4d5b-bab2-0f0999a76f31",
                                                "sense_id": "36bbd247-2210-3783-b6d3-d120528d9af4",
                                                "text": "Toute addition ou modification au contrat d’assurance primitif doit être constatée par un avenant signé des parties."
                                            },
                                            {
                                                "example_id": "1549ef58-d249-4aa5-bbc5-117bdfdf1fb5",
                                                "sense_id": "36bbd247-2210-3783-b6d3-d120528d9af4",
                                                "text": "Cela crée d’ailleurs une autre difficulté puisque la réglementation encadrant les avenants et limitant leur importance, sauf sujétions techniques imprévues, est bien applicable au marché de maîtrise d’œuvre."
                                            },
                                            {
                                                "example_id": "9fb4b3aa-3242-4a4c-8e6b-162c0bd983d1",
                                                "sense_id": "36bbd247-2210-3783-b6d3-d120528d9af4",
                                                "text": "Le présent avenant a pour objet de préciser les prix moyens estimés applicables […]"
                                            }
                                        ]
                                    }
                                ]
                            },
