{
    "word_family": [
        "загадка",
        "загадочный",
        "загадочно",
        "загадочность",
        "загадать",
        "угадывать",
        "разгадывать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b68acbc4-1b2b-3c9c-91c1-89b79c84eb41",
                    "sense_definition": "Задумывать, мысленно намечать что-либо (число, слово, желание), предлагая угадать или надеясь на исполнение.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "thought",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В новогоднюю ночь принято <w>загадывать</w> заветное желание под бой курантов.",
                            "target_lang_translations": {
                                "en": "On New Year's Eve, it is customary to <w>make</w> a cherished wish to the chiming of the clock."
                            }
                        },
                        {
                            "text": "Ведущий попросил участников молча <w>загадывать</w> любое число от одного до десяти.",
                            "target_lang_translations": {
                                "en": "The host asked the participants to silently <w>think of</w> any number from one to ten."
                            }
                        }
                    ],
                    "synonyms": [
                        "задумывать"
                    ],
                    "common_phrases": [
                        "загадывать желание",
                        "загадывать число"
                    ],
                    "target_lang_definitions": {
                        "en": "To make (a wish) or mentally choose/think of (a number, word) for someone else to guess or hoping it comes true."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "make a wish",
                                "target_lang_sense_clarification": "when used with 'желание'"
                            },
                            {
                                "target_lang_word": "think of",
                                "target_lang_sense_clarification": "a number, word, or card in games"
                            },
                            {
                                "target_lang_word": "pick",
                                "target_lang_sense_clarification": "mentally select a number or item"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a74cbfe2-246f-3c17-8816-9d712095f685",
                    "sense_definition": "Предлагать кому-либо загадку, сложную задачу или вопрос для разгадывания.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "puzzle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бабушка очень любит <w>загадывать</w> внукам народные загадки долгими зимними вечерами.",
                            "target_lang_translations": {
                                "en": "Grandmother loves to <w>ask</w> her grandchildren folk riddles on long winter evenings."
                            }
                        },
                        {
                            "text": "Учитель начал <w>загадывать</w> классу интересную математическую задачу.",
                            "target_lang_translations": {
                                "en": "The teacher began to <w>pose</w> an interesting math problem to the class."
                            }
                        }
                    ],
                    "antonyms": [
                        "отгадывать",
                        "разгадывать"
                    ],
                    "common_phrases": [
                        "загадывать загадки"
                    ],
                    "target_lang_definitions": {
                        "en": "To pose or set a riddle, puzzle, or question for someone to solve."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ask riddles",
                                "target_lang_sense_clarification": "pose a riddle to someone"
                            },
                            {
                                "target_lang_word": "pose",
                                "target_lang_sense_clarification": "a puzzle or riddle"
                            },
                            {
                                "target_lang_word": "set",
                                "target_lang_sense_clarification": "a problem or riddle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfb79f76-9a61-3686-b035-ba7b590760e9",
                    "sense_definition": "Строить планы, предположения о будущем; заранее рассчитывать на что-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сейчас трудно <w>загадывать</w> на будущее, так как обстоятельства постоянно меняются.",
                            "target_lang_translations": {
                                "en": "It is difficult to <w>plan ahead</w> right now, as circumstances are constantly changing."
                            }
                        },
                        {
                            "text": "Не будем <w>загадывать</w>, получится ли поехать в отпуск следующим летом.",
                            "target_lang_translations": {
                                "en": "Let's not <w>try to predict</w> whether we will manage to go on vacation next summer."
                            }
                        }
                    ],
                    "synonyms": [
                        "планировать"
                    ],
                    "common_phrases": [
                        "загадывать на будущее",
                        "не будем загадывать"
                    ],
                    "target_lang_definitions": {
                        "en": "To make assumptions or definite plans about the future; to anticipate or speculate ahead."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plan ahead",
                                "target_lang_sense_clarification": "make assumptions about the future"
                            },
                            {
                                "target_lang_word": "count on",
                                "target_lang_sense_clarification": "rely on future outcomes"
                            },
                            {
                                "target_lang_word": "speculate about the future",
                                "target_lang_sense_clarification": "guess what will happen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}