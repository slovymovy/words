                                "sense_id": "4b5eb102-8e44-318e-a542-76b45337879f",
                                "text": "He was in a critical state of depersonalization."
                            }
                        ]
                    },
                    {
                        "sense_id": "26cd06e3-d722-3ccc-b9bc-548770e4fc0e",
                        "entry_id": "2b43ab58-2588-3646-b95d-38a76382ab3d",
                        "glosses": [
                            "The loss of one's sense of personal identity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6c9d33ac-cc2c-482e-8895-9a4f83caa92d",
                                "sense_id": "26cd06e3-d722-3ccc-b9bc-548770e4fc0e",
                                "text": "Musil is committed to the dissolution of the ego and to the defictionalization and depersonalization of character as Woolf expresses it in “The Narrow Bridge of Art.”"
                            },
                            {
                                "example_id": "24826b76-b584-4774-8b32-bfa4cfc403ea",
                                "sense_id": "26cd06e3-d722-3ccc-b9bc-548770e4fc0e",
                                "text": "His depersonalization causes a great deal of stress as he searches for an authentic personal identity."
                            },
                            {
                                "example_id": "7f2c6dd5-6bbb-4042-a208-4f0cddb25798",
                                "sense_id": "26cd06e3-d722-3ccc-b9bc-548770e4fc0e",
                                "text": "Many people experience some form of temporary depersonalisation in their lives, typically at moments of extreme fatigue or high stress, such as during a car crash, where both the established defence options of fight or flight are removed. A number of recreational drugs also precipitate similar episodes."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4b8028f-c96b-34e2-adba-df532290f6a1",
                        "entry_id": "2b43ab58-2588-3646-b95d-38a76382ab3d",
                        "glosses": [
                            "A feeling of being unreal, detached or unable to feel emotion."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1c0ed83b-91d2-4559-8629-7b5d74b59768",
                                "sense_id": "b4b8028f-c96b-34e2-adba-df532290f6a1",
                                "text": "His severe depersonalization causes an aloof demeanor."
                            }
                        ]
                    }
