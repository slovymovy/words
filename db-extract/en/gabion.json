                        "form_id": "0c4b3214-381d-4770-a863-7f8f7de62f7c",
                        "entry_id": "59e10d36-4f9c-37b4-9699-6a7fc4fa7371",
                        "tags": [
                            "plural"
                        ],
                        "form": "gabions"
