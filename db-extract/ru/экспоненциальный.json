                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exponentiell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11b90572-57b7-33ac-af25-95513c4519ac",
                                        "entry_id": "1898be13-1518-3f6d-b036-997417d001f6",
                                        "glosses": [
                                            "sich als Wert pro Zeiteinheit durch Multiplikation (2, 4, 8, 16…) (nicht durch Addition 2, 4, 6, 8…) erhöhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfdb2599-04e9-49dc-8046-5db86a18297a",
                                                "sense_id": "11b90572-57b7-33ac-af25-95513c4519ac",
                                                "text": "„Arnd Leike hatte an der Uni München in einem Seminar ein Schulbuchexperiment wiederholt und zeigen können, dass Bierschaum exponentiell in sich zusammenfällt.“"
                                            },
                                            {
                                                "example_id": "4b376b31-ef73-4fd9-aaca-382a718656af",
                                                "sense_id": "11b90572-57b7-33ac-af25-95513c4519ac",
                                                "text": "Wenn du nicht mal die Zinsen für deinen Kredit bezahlen kannst, wachsen deine Schulden exponentiell."
                                            },
                                            {
                                                "example_id": "aa4ad18f-a5bc-4380-bd04-420942c7ae8c",
                                                "sense_id": "11b90572-57b7-33ac-af25-95513c4519ac",
                                                "text": "„Ein beliebtes Illustrationsbeispiel ist das Falten eines normalen Papierblatts. Nach einigen Knickvorgängen steigt die Dicke des Stapels exponentiell. Nach sieben Runden ist er 128-mal so dick wie das Ausgangsblatt. Mehr ist aus technischen Gründen nicht möglich. Würde der Vorgang fortgesetzt, ergäbe sich theoretisch nach 40-maligem Falten schon ein 100.000 Kilometer hoher Stapel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
