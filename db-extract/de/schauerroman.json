                ],
                "senses": [
                    {
                        "sense_id": "f5235964-6ea9-3653-8776-6cbd6f79c259",
                        "entry_id": "e40ab4f0-0a84-3981-89eb-3a1699f27987",
                        "glosses": [
                            "ein Roman, der durch die Schilderung gruseliger, phantastischer, geisterhafter Begebenheiten menschliche Gefühle bewegen und steigern möchte"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "6df62774-e706-45b1-8fe8-bba0efc4ccf9",
                                "sense_id": "f5235964-6ea9-3653-8776-6cbd6f79c259",
                                "text": "Die Romantik wendet sich dem Schauerroman wie auch dem Schauermärchen und der Schauertragödie zu."
                            },
                            {
                                "example_id": "25ddcb1b-4a86-4e2c-a325-b53671731590",
                                "sense_id": "f5235964-6ea9-3653-8776-6cbd6f79c259",
                                "text": "„Was hier erzählt werden soll, ist alles andere als ein Schauerroman.“"
                            },
                            {
                                "example_id": "de251a7f-b03d-44e4-abcd-d60578eacab1",
                                "sense_id": "f5235964-6ea9-3653-8776-6cbd6f79c259",
                                "text": "„Im Fortgang aber spinnt sich seine Beschreibung der Steppenvölker in einen immer fantastischeren und schließlich sich ganz in mythologischen und dämonologischen Albträumen verlierenden Schauerroman hinein weiter.“"
                            },
                            {
                                "example_id": "d69ac410-9d8c-4dfb-b943-d2255ec7c6cf",
                                "sense_id": "f5235964-6ea9-3653-8776-6cbd6f79c259",
                                "text": "„An dieser Einstellung lag es, dass die Parapsychologie nicht die Anerkennung fand, die sie verdient hatte, und sie war auch der Grund dafür, dass die Beschäftigung mit den Unterirdischen eher etwas mit Schauerromanen als mit Wissenschaft zu tun hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
