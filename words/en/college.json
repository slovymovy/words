{
    "word_family": [
        "collegiate",
        "collegial",
        "collegiality",
        "intercollegiate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22e3b01e-6cf9-3828-aa81-06eb32280ad1",
                    "sense_definition": "An institution of higher education where students study for a degree after finishing high school.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "academic_institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is currently a student in <w>college</w> and hopes to become a doctor.",
                            "target_lang_translations": {
                                "ru": "В настоящее время она учится в <w>колледже</w> и надеется стать врачом."
                            }
                        },
                        {
                            "text": "Many young people decide to <w>go</w> to <w>college</w> right after they graduate from high school.",
                            "target_lang_translations": {
                                "ru": "Многие молодые люди решают <w>поступать</w> в <w>вуз</w> сразу после окончания школы."
                            }
                        }
                    ],
                    "synonyms": [
                        "school"
                    ],
                    "common_phrases": [
                        "go to college",
                        "college student",
                        "college degree",
                        "finish college"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высшее учебное заведение, где студенты обучаются для получения степени после окончания средней школы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колледж",
                                "target_lang_sense_clarification": "учебное заведение в англоязычных странах"
                            },
                            {
                                "target_lang_word": "вуз",
                                "target_lang_sense_clarification": "высшее учебное заведение"
                            },
                            {
                                "target_lang_word": "институт",
                                "target_lang_sense_clarification": "высшее учебное заведение"
                            },
                            {
                                "target_lang_word": "университет",
                                "target_lang_sense_clarification": "крупное высшее учебное заведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d91d1bc-1301-351a-90a0-682ff72a87e1",
                    "sense_definition": "A specialized division or department within a larger university.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "academic_institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>College</w> of Engineering is located on the north side of the campus.",
                            "target_lang_translations": {
                                "ru": "Инженерный <w>факультет</w> расположен в северной части кампуса."
                            }
                        },
                        {
                            "text": "He was recently appointed as the dean of the <w>college</w> of arts and sciences.",
                            "target_lang_translations": {
                                "ru": "Недавно он был назначен деканом <w>колледжа</w> искусств и наук."
                            }
                        }
                    ],
                    "synonyms": [
                        "department",
                        "faculty",
                        "school"
                    ],
                    "common_phrases": [
                        "college of engineering",
                        "college of medicine",
                        "college of law"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специализированное подразделение или департамент внутри крупного университета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "факультет",
                                "target_lang_sense_clarification": "подразделение университета"
                            },
                            {
                                "target_lang_word": "институт",
                                "target_lang_sense_clarification": "структурное подразделение вуза"
                            },
                            {
                                "target_lang_word": "отделение",
                                "target_lang_sense_clarification": "структурная единица организации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e88a490-7952-30bc-b245-65c7ecb0b35d",
                    "sense_definition": "A postsecondary institution that offers vocational training or associate's degrees rather than full four-year degrees.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "academic_institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to attend a community <w>college</w> to learn automotive repair.",
                            "target_lang_translations": {
                                "ru": "Он решил пойти в местный <w>колледж</w>, чтобы выучиться на автомеханика."
                            }
                        },
                        {
                            "text": "A vocational <w>college</w> can provide the specific skills needed for a technical career.",
                            "target_lang_translations": {
                                "ru": "Профессиональное <w>училище</w> может дать конкретные навыки, необходимые для технической карьеры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "community college",
                        "vocational college",
                        "technical college"
                    ],
                    "target_lang_definitions": {
                        "ru": "Учебное заведение послешкольного образования, предлагающее профессиональную подготовку или начальные степени, а не полные четырехлетние программы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колледж",
                                "target_lang_sense_clarification": "среднее профессиональное учебное заведение"
                            },
                            {
                                "target_lang_word": "техникум",
                                "target_lang_sense_clarification": "среднее специальное учебное заведение"
                            },
                            {
                                "target_lang_word": "училище",
                                "target_lang_sense_clarification": "профессиональное учебное заведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bc48190-509f-306e-8e91-b8a44e49d681",
                    "sense_definition": "A name used for some high schools or secondary schools, particularly private ones.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "academic_institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eton <w>College</w> is one of the most famous secondary schools in the world.",
                            "target_lang_translations": {
                                "ru": "Итонский <w>колледж</w> — одна из самых известных средних школ в мире."
                            }
                        },
                        {
                            "text": "The local sixth form <w>college</w> prepares students for their university entrance exams.",
                            "target_lang_translations": {
                                "ru": "Местный <w>колледж</w> двенадцатых классов готовит студентов к вступительным экзаменам в университет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sixth form college"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in UK, Australia, and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название, используемое для некоторых средних школ, особенно частных (преимущественно в Великобритании)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колледж",
                                "target_lang_sense_clarification": "название частной средней школы"
                            },
                            {
                                "target_lang_word": "коллеж",
                                "target_lang_sense_clarification": "среднее учебное заведение во Франции и Бельгии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17493192-b866-3556-b109-4337c72de18a",
                    "sense_definition": "An organized group of people who share a common profession, purpose, or set of goals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>College</w> of Cardinals met in secret to elect the new pope.",
                            "target_lang_translations": {
                                "ru": "<w>Коллегия</w> кардиналов собралась тайно, чтобы избрать нового папу."
                            }
                        },
                        {
                            "text": "She was invited to join the Royal <w>College</w> of Surgeons after years of practice.",
                            "target_lang_translations": {
                                "ru": "После многих лет практики ее пригласили вступить в Королевскую <w>коллегию</w> хирургов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "college of cardinals",
                        "electoral college",
                        "college of surgeons"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организованная группа людей, объединенных общей профессией, целью или задачами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коллегия",
                                "target_lang_sense_clarification": "объединение лиц одной профессии"
                            },
                            {
                                "target_lang_word": "корпорация",
                                "target_lang_sense_clarification": "профессиональное объединение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bac17ca0-e07d-3cf8-ace9-f12ba8fed896",
                    "sense_definition": "A census-designated place located in Alaska, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small community of <w>College</w> is situated near the city of Fairbanks.",
                            "target_lang_translations": {
                                "ru": "Небольшое поселение <w>Колледж</w> расположено недалеко от города Фэрбанкс."
                            }
                        },
                        {
                            "text": "According to the census data, <w>College</w> has a population of several thousand residents.",
                            "target_lang_translations": {
                                "ru": "Согласно данным переписи, население <w>Колледжа</w> составляет несколько тысяч жителей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Статистически обособленная местность, расположенная на Аляске, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Колледж",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}