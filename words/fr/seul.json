                    "frequency": "High",
                    "semantic_group_id": "isolement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il habite <w>seul</w> dans un petit appartement au centre-ville."
                        },
                        {
                            "text": "L'enfant a réussi à faire ses devoirs tout <w>seul</w> hier soir."
                        }
                    ],
                    "antonyms": [
                        "accompagné"
                    ],
                    "common_phrases": [
