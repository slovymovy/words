            "senses": [
                {
                    "sense_id": "e154cc62-b690-3ac0-8d1a-54d4cf93bc35",
                    "sense_definition": "Een bericht of nieuwtje dat rondgaat maar waarvan niet zeker is of het waar is.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rumor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er gaat een hardnekkig <w>gerucht</w> dat de directeur ontslag neemt.",
                            "target_lang_translations": {
                                "en": "There is a persistent <w>rumor</w> that the director is resigning.",
                                "ru": "Ходит упорный <w>слух</w>, что директор увольняется.",
                                "fr": "Il court une <w>rumeur</w> tenace selon laquelle le directeur démissionne."
                            }
                        },
                        {
                            "text": "Je moet niet elk <w>gerucht</w> geloven dat je op sociale media leest.",
                            "target_lang_translations": {
                                "en": "You shouldn't believe every <w>rumor</w> you read on social media.",
                                "ru": "Не стоит верить каждому <w>слуху</w>, который ты читаешь в социальных сетях.",
                                "fr": "Tu ne dois pas croire chaque <w>rumeur</w> que tu lis sur les réseaux sociaux."
                            }
                        }
                    ],
                    "synonyms": [
                        "roddel",
                        "praatje"
                    ],
                    "antonyms": [
                        "feit",
                        "waarheid"
                    ],
                    "common_phrases": [
                        "het gerucht gaat",
                        "geruchten verspreiden",
                        "hardnekkig gerucht"
                    ],
                    "target_lang_definitions": {
                        "en": "A report or piece of news that is circulating but has not yet been confirmed.",
                        "ru": "Сообщение или новость, которые передаются от одного к другому, но достоверность которых не подтверждена.",
                        "fr": "Un message ou une nouvelle qui circule, mais dont la véracité n'est pas confirmée."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rumor",
                                "target_lang_sense_clarification": "unverified information"
