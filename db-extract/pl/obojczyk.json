                    {
                        "translation_id": "571fb29d-a43a-42cc-9892-1a33d99858b5",
                        "source_entry_id": "45f1af22-aa3a-3d87-98d9-ed9738fc763b",
                        "source_sense_id": "1a1de617-db64-3175-83bd-1c4eb79ccdfe",
                        "target_lang_word": "clavicule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
