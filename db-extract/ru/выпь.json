                                    },
                                    {
                                        "sense_id": "9fbc086a-0f74-3694-a271-bae46966f0a6",
                                        "entry_id": "67b3dbae-2af6-3e48-a540-9c9474caf3de",
                                        "glosses": [
                                            "The saline substance added to soy milk to coagulate it as a primary step in the production of tofu."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd160980-6e5c-4e2a-b481-58857571b0fe",
                                                "sense_id": "9fbc086a-0f74-3694-a271-bae46966f0a6",
                                                "text": "Now we add the bittern."
                                            }
                                        ]
                                    },
