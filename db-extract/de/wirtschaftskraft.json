                "senses": [
                    {
                        "sense_id": "de2bec1d-df1a-3702-923f-24002fb0e5b6",
                        "entry_id": "948f6c20-b890-3c30-ade0-7654d0c16e12",
                        "glosses": [
                            "Leistungsfähigkeit der Wirtschaft eines Landes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89fe985f-5b35-4bc6-8940-34fa8691aec9",
                                "sense_id": "de2bec1d-df1a-3702-923f-24002fb0e5b6",
                                "text": "„Es gibt ganz konkrete historische Gründe dafür, dass Ostdeutschland bis heute erst gute zwei Drittel der westdeutschen Wirtschaftskraft erreicht.“"
                            },
                            {
                                "example_id": "e319bef3-cabe-4c96-9858-eff244e8428c",
                                "sense_id": "de2bec1d-df1a-3702-923f-24002fb0e5b6",
                                "text": "„Die Wirtschaftskraft der DDR wurde alljährlich in Leipzig auf der Frühjahrs- und Herbstmesse demonstriert.“"
                            },
                            {
                                "example_id": "03a4fdd9-39dc-4777-945a-7d07b533e62c",
                                "sense_id": "de2bec1d-df1a-3702-923f-24002fb0e5b6",
                                "text": "„Mit den geraubten Arbeitssklaven und Nutztieren bauten die Comanchen ein Handelsimperium auf, das in seiner Blüte eine verblüffende Wirtschaftskraft erlangte.“"
                            },
                            {
                                "example_id": "467a3e72-37ee-462a-8964-b2c2d4a2ac8e",
                                "sense_id": "de2bec1d-df1a-3702-923f-24002fb0e5b6",
                                "text": "„Länder wie Italien, Spanien und Griechenland messen ihre Wirtschaftskraft mittlerweile daran, wie weit sie von der deutschen Kreditwürdigkeit entfernt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
