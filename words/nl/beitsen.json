                    "sense_id": "1b4c2aa2-6dea-32e9-aab4-e2613960c3ab",
                    "sense_definition": "Hout of een ander materiaal behandelen met een vloeistof (beits) om het te beschermen of te kleuren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten de houten tuintafel eerst goed schuren voordat we hem gaan <w>beitsen</w>.",
                            "target_lang_translations": {
                                "en": "We need to sand the wooden garden table thoroughly before we start to <w>stain</w> it."
                            }
                        },
                        {
                            "text": "Als je het hout wilt beschermen tegen de regen, kun je het beste het <w>hout beitsen</w>.",
                            "target_lang_translations": {
                                "en": "If you want to protect the wood from the rain, it is best to <w>stain the wood</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hout beitsen",
                        "een schutting beitsen"
                    ],
                    "target_lang_definitions": {
                        "en": "To treat wood or another material with a liquid (stain) to protect or color it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to stain",
                                "target_lang_sense_clarification": "wood or other materials"
                            },
                            {
                                "target_lang_word": "to varnish",
                                "target_lang_sense_clarification": "protecting wood with a clear or tinted coat"
                            }
                        ]
                    }
                }
            ]
        },
