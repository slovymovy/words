                ],
                "senses": [
                    {
                        "sense_id": "0b870b8f-e22b-38d7-a2f5-518fef3035d1",
                        "entry_id": "eb184f12-5f67-3932-9702-8186f8c7f0c0",
                        "glosses": [
                            "Führung/Leitung eines Betriebs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4b09b91-d352-4bf6-b3fd-8eb959545e3f",
                                "sense_id": "0b870b8f-e22b-38d7-a2f5-518fef3035d1",
                                "text": "Wenn die Bewirtschaftung eines Betriebes nicht erfolgreich ist, kommt es möglicherweise zur Insolvenz."
                            },
                            {
                                "example_id": "4469f451-482e-4517-99b8-9c9e1282eb40",
                                "sense_id": "0b870b8f-e22b-38d7-a2f5-518fef3035d1",
                                "text": "„Denn für die Bewirtschaftung der Plantagen im fernen Amerika brauchen die Weißen immer neue Arbeiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b2c46b26-d2c5-3c31-8c60-9d32f5350e63",
                        "entry_id": "eb184f12-5f67-3932-9702-8186f8c7f0c0",
                        "glosses": [
                            "Kontrolle/Regelung der Verteilung von Gütern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "420fd755-1b09-4181-8938-8c07fae7c2dc",
                                "sense_id": "b2c46b26-d2c5-3c31-8c60-9d32f5350e63",
                                "text": "„Die zunehmende staatliche Bewirtschaftung der Mangelware Lebensmittel hatte die Krise bisher lediglich stetig verschärft.“"
                            },
                            {
                                "example_id": "dbc70ded-f7b2-4ee5-a9be-580d3be68bbc",
                                "sense_id": "b2c46b26-d2c5-3c31-8c60-9d32f5350e63",
                                "text": "„Nach damaligen Schätzungen vollzog sich die Hälfte des gewerblichen Umsatzes durch Tausch- und Schwarzhandel außerhalb der Bewirtschaftung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48c65a99-8a99-4880-980a-694de59b9154",
                        "source_entry_id": "eb184f12-5f67-3932-9702-8186f8c7f0c0",
                        "source_sense_id": "0b870b8f-e22b-38d7-a2f5-518fef3035d1",
                        "source_sense_description": "Führung/Leitung eines Betriebs",
                        "target_lang_word": "management",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "management",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a601af8-87dc-3153-9f7e-60df191b9ea3",
                                        "entry_id": "5d5f40ce-1005-335d-9ccb-73de82b744ba",
                                        "glosses": [
                                            "Ensemble des techniques de gestion, d’organisation et d’administration d’une entité organisationnelle."
                                        ],
                                        "tags": [
                                            "Sciences de gestion",
                                            "Gestion des organisations",
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0adac05-1e3d-49a5-8128-cdfcc06c01c5",
                                                "sense_id": "7a601af8-87dc-3153-9f7e-60df191b9ea3",
                                                "text": "Le management d’entreprise."
                                            },
                                            {
                                                "example_id": "6b8ea5c1-5e14-451a-8268-6ad0d19b1316",
                                                "sense_id": "7a601af8-87dc-3153-9f7e-60df191b9ea3",
                                                "text": "Le management est une notion globalisante et floue. Elle peut désigner les fonctions de direction, être synonyme d'organisation du travail, de mobilisation et de gestion de la « ressource humaine », ou plus largement encore englober de façon syncrétique la quasi-totalité des activités de l’entreprise qui ne se rapportent pas directement à la technique : gestion quotidienne des aléas de tous ordres survenant dans un service ou un atelier, encadrement et mobilisation d’une équipe, relations avec d’autres secteurs de l’entreprise, organisation et gestion de son temps, voire gestion budgétaire…"
                                            },
                                            {
                                                "example_id": "a62d815c-c82c-42c2-bde6-c56ea421a48b",
                                                "sense_id": "7a601af8-87dc-3153-9f7e-60df191b9ea3",
                                                "text": "Les managers font le sale boulot: ils règlent les problèmes difficiles et les connexions complexes. Voilà pourquoi la pratique du management est si floue et pourquoi des mots comme expérience, intuition, jugement et sagesse sont si souvent nécessaire pour la décrire. Rassemblez une bonne quantité d'artisanat, ajoutez la juste touche d'art, saupoudrez le tout de science et vous obtiendrez un résultat qui est avant tout une pratique. Et souvenez-vous : aucune méthode de management n'est supérieure à toutes les autres. Tout dépend de la situation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a3091cc-1ecb-3575-8080-dedf365b39e2",
                                        "entry_id": "5d5f40ce-1005-335d-9ccb-73de82b744ba",
                                        "glosses": [
                                            "Action de diriger, coordonner et animer une équipe ou un groupe de travail, afin d’atteindre des objectifs communs."
                                        ],
                                        "tags": [
                                            "Gestion des organisations",
                                            "Sociologie du travail",
                                            "Psychologie du travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "987e193f-e882-4a83-bd6d-163c59c3d61c",
                                                "sense_id": "5a3091cc-1ecb-3575-8080-dedf365b39e2",
                                                "text": "Manager d’un McDo, il assure le management d’une équipe d’une douzaine d’« équipiers »."
                                            },
                                            {
                                                "example_id": "0bc96f08-0587-4d6f-89bf-720da01a6c90",
                                                "sense_id": "5a3091cc-1ecb-3575-8080-dedf365b39e2",
                                                "text": "Le management est un métier qui consiste à conduire, dans un contexte donné, un groupe de personnes ayant à atteindre en commun des objectifs fixés."
                                            },
                                            {
                                                "example_id": "5828ab9c-d1d7-4376-9efa-f407fd20e00e",
                                                "sense_id": "5a3091cc-1ecb-3575-8080-dedf365b39e2",
                                                "text": "Force est de constater que la manipulation délibérée de la menace, du chantage, du harcèlement sont désormais érigés en méthode de management pour pousser à l’erreur et permettre le licenciement pour faute ou déstabiliser et pousser à la démission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "283451cd-de3c-38ed-b920-4c0d942d5dbd",
                                        "entry_id": "5d5f40ce-1005-335d-9ccb-73de82b744ba",
                                        "glosses": [
                                            "L’ensemble des dirigeants d’une organisation."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bf4d69b-8f09-4959-aa88-d14f00a49837",
                        "source_entry_id": "eb184f12-5f67-3932-9702-8186f8c7f0c0",
                        "source_sense_id": "0b870b8f-e22b-38d7-a2f5-518fef3035d1",
                        "source_sense_description": "Führung/Leitung eines Betriebs",
                        "target_lang_word": "gestion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gestion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a2012ee-13bd-3022-abcb-566f060ac8da",
                                        "entry_id": "1bd71baf-97d9-3090-a27f-316dc7e2e55d",
                                        "glosses": [
                                            "Action et effet de gérer, d’administrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8277db0-a8e7-4ac2-ac92-0b9f2a103be0",
                                                "sense_id": "8a2012ee-13bd-3022-abcb-566f060ac8da",
                                                "text": "Si ce n'était que cela, comme au bon vieux temps, mais la gestion d'une entreprise viticole nécessite une paperasserie courtelinesque et kafkaïenne à la fois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "410783af-e21c-48d5-9008-c46341908658",
                        "source_entry_id": "eb184f12-5f67-3932-9702-8186f8c7f0c0",
                        "source_sense_id": "0b870b8f-e22b-38d7-a2f5-518fef3035d1",
                        "source_sense_description": "Führung/Leitung eines Betriebs",
                        "target_lang_word": "διαχείριση",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
