                                            {
                                                "example_id": "e9bfccc4-fb26-4d7c-aa2b-9f32887944b7",
                                                "sense_id": "1a3eedbf-e057-3c00-a2c7-c779da68f8fc",
                                                "text": "Marcel Müller wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "926785a2-3b23-4a47-b3bd-8441f901908a",
                                                "sense_id": "1a3eedbf-e057-3c00-a2c7-c779da68f8fc",
                                                "text": "Kennen sie den Vornamen Marcel?"
                                            },
                                            {
                                                "example_id": "35430a84-4cc3-47ef-97f4-6ae75b0d41af",
                                                "sense_id": "1a3eedbf-e057-3c00-a2c7-c779da68f8fc",
                                                "text": "„Marcel fand für sich selbst einen Großonkel mit einer Pfirsichfarm am Meer.“"
