                        "examples": [
                            {
                                "example_id": "fc58b522-7600-40a6-9348-3a0d310cf533",
                                "sense_id": "2658dc57-5b27-3413-91fe-ea59ad67fa58",
                                "text": "En effet ils furent rois toute une matinée où les tentures carminées se relevèrent sur les maisons, et toute l’après-midi, où ils s’avancèrent du côté des jardins de palmes."
                            },
                            {
                                "example_id": "e8f3413f-f761-47c5-8a91-35501817653e",
                                "sense_id": "2658dc57-5b27-3413-91fe-ea59ad67fa58",
                                "text": "Ô vous qui buvez « sur le zinc », avez-vous jamais songé à toute la science qu'a dû déployer celui qui a fabriqué le verre dans lequel vous buvez le vin carminé ou la douce liqueur ?"
                            }
                        ]
                    }
