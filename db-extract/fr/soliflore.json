                        "form_id": "392c9e0a-2da9-4448-9b74-3ed19ce68c33",
                        "entry_id": "58de3db2-f2db-3b7a-8754-a87c33394efd",
                        "tags": [
                            "plural"
                        ],
                        "form": "soliflores"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a62a8111-69f1-3a70-a4de-1ad0a7dd515e",
                        "entry_id": "58de3db2-f2db-3b7a-8754-a87c33394efd",
                        "glosses": [
                            "Vase à col étroit destiné à accueillir une seule fleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aa5c278-7a20-4217-98c0-a9c6ae1cbac1",
                                "sense_id": "a62a8111-69f1-3a70-a4de-1ad0a7dd515e",
                                "text": "Entre les portes, se succèdent des meubles vitrés pleins eux aussi d’objets rangés par catégories : coquetiers, salières – certaines sont une poule couveuse en verre peint – huiliers, cadres pour photos, soliflores, rince-doigts, dans un désordre concerté et cohérent."
                            },
                            {
                                "example_id": "7a5555a5-391b-48e5-9ccf-dc5076fa1a01",
                                "sense_id": "a62a8111-69f1-3a70-a4de-1ad0a7dd515e",
                                "text": "Devant la fenêtre, entre la télé et le fauteuil, à côté duquel est posé son sac de voyage à elle, marron clair en simili-cuir, souple, avec une fermeture Éclair sur le dessus, se trouve un petit guéridon avec un pied en fer forgé, et une tablette en verre fumé, sur laquelle se trouve un soliflore vide et un cendrier publicitaire."
                            },
                            {
                                "example_id": "90fb304a-5457-4c23-a39e-ecc5cf434e42",
                                "sense_id": "a62a8111-69f1-3a70-a4de-1ad0a7dd515e",
                                "text": "Et c'était vrai, dans la chambre de Yaya, je n'ai jamais vu le petit soliflore sur sa table de nuit manquer d'un œillet ou d'une rose. Aucun des bouquets que j'ai pu lui apporter ne pouvait supplanter ce qu'apportait leur présence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ecac07a-c0ee-4c49-91aa-e281d7f05458",
                        "source_entry_id": "58de3db2-f2db-3b7a-8754-a87c33394efd",
                        "source_sense_id": "a62a8111-69f1-3a70-a4de-1ad0a7dd515e",
                        "source_sense_description": "Vase pour une seule fleur",
                        "target_lang_word": "soliflor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soliflor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9523754f-f0c8-3f8f-8d45-2d27e361ebed",
                                        "entry_id": "704a8daf-69e4-3cc6-9e7d-f9361b6bf050",
                                        "glosses": [
                                            "A vase designed to hold a single flower"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc92401-9db6-4fc0-89fa-b079a139887a",
                                                "sense_id": "9523754f-f0c8-3f8f-8d45-2d27e361ebed",
                                                "text": "A black telephone, a notepad, a tortoiseshell propelling pencil, a minute conical paperweight with a base less than an inch in diameter but whose small size does not prevent it from weighing three \"troy ounces\", that is to say 93 grammes, and a Gallé soliflor containing a purple moonflower, a variety of everlasting flower also called Star of the Nile, combine to clutter the table's narrow top."
                                            },
                                            {
                                                "example_id": "47c25f83-fef9-47bd-a8fb-b2cc9439479d",
                                                "sense_id": "9523754f-f0c8-3f8f-8d45-2d27e361ebed",
                                                "text": "Examples include the soliflor that turns into a candleholder (1981); the \"Bellman \" drinking glasses she designed to pay explicit tribute to anonymous objects (1982); and the small oil bottle that draws attention to its spherical stopper, which is only bevelled so it doesn't roll away."
                                            },
                                            {
                                                "example_id": "8577c776-5960-41c7-a123-a54039f61993",
                                                "sense_id": "9523754f-f0c8-3f8f-8d45-2d27e361ebed",
                                                "text": "Six Etablissements Gallé soliflor vases 1904-1936. This type of soliflor was made many times."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
