        "nl-extract.jsonl": [
            {
                "entry_id": "fcefa2c7-2bce-3b30-ab55-d159f3c8a018",
                "word": "golvend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1b3818a1-11f5-3de9-a60b-273236a8192e",
                        "entry_id": "fcefa2c7-2bce-3b30-ab55-d159f3c8a018",
                        "glosses": [
                            "de vorm van een golf hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478ab3cb-13c2-4529-99e8-214a567d9f8a",
                                "sense_id": "1b3818a1-11f5-3de9-a60b-273236a8192e",
                                "text": "„Bij de entree gaan zwemmers verschillende richtingen op; recreanten, kinderen voor de zwemles, minder-validen, de bezoekers van het sportbad en die van de horeca”, vertelt Melisie. Het ontwerp van de ‘golvende’ entree komt van Borgerink Architecten uit Almelo."
                            },
                            {
                                "example_id": "2bb968bb-bd2e-4cc1-810a-4311ee040b18",
                                "sense_id": "1b3818a1-11f5-3de9-a60b-273236a8192e",
                                "text": "Er waren geen uitgestrekte zandvlaktes met golvende duinen zoals in de Afrikaanse Sahara."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bd57649-b2b0-3e7a-95dd-ce15e4441f20",
                        "entry_id": "fcefa2c7-2bce-3b30-ab55-d159f3c8a018",
                        "glosses": [
                            "van haar dat het tussen stijl en krullend in zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cef39410-644c-4ac0-91e3-896ef5ac4ad4",
                                "sense_id": "0bd57649-b2b0-3e7a-95dd-ce15e4441f20",
                                "text": "Albert mocht hem niet. Misschien omdat hij knap was. Een lange, slanke, elegante vent met een bos golvend donkerbruin haar, een rechte neus en prachtig getekende smalle lippen. En donkerblauwe ogen."
                            },
                            {
                                "example_id": "bb218a98-ef72-4e3a-a688-2ff8f0d58f04",
                                "sense_id": "0bd57649-b2b0-3e7a-95dd-ce15e4441f20",
                                "text": "De Britse heeft nog een huidtransplantatie en andere operaties aangeboden gekregen om haar haar terug te krijgen, maar ze weet niet of ze die ingrepen al aankan. ,,Ik kan niet elke week naar het ziekenhuis, ik moet voor mijn dochtertje zorgen. Ik zal in elk geval nooit meer lang golvend haar krijgen.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "f15b8a95-f8d9-3357-9974-79df3207e990",
                        "entry_id": "fcefa2c7-2bce-3b30-ab55-d159f3c8a018",
                        "glosses": [
                            "van een terrein dat er hoogte verschillen zijn"
                        ],
