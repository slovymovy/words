                        "glosses": [
                            "eine Pflanzenart (Crassula ovata) aus der Gattung Dickblatt, deren Heimat das südliche Afrika ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8433b3f5-e1ea-4fc4-8ca5-b2f5f4a569b1",
                                "sense_id": "f1887436-e2fe-3024-9685-119ba3acd442",
                                "text": "Der Geldbaum zählt zu meinen Lieblingspflanzen."
                            },
                            {
                                "example_id": "5f183b47-7c7c-4264-9019-f8a267e5e18f",
                                "sense_id": "f1887436-e2fe-3024-9685-119ba3acd442",
                                "text": "Der Geldbaum besitzt als Sukkulente die Fähigkeit, Wasser in den Blättern zu speichern."
                            }
                        ],
                        "sense_index_json": "\"1\""
