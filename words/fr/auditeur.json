    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50b1c07b-75b5-3e79-9377-7577aa850383",
                    "sense_definition": "Personne qui écoute un discours, une émission de radio, un concert ou un exposé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ecoute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, cette station réunit plus d'un million d'<w>auditeurs</w> fidèles."
                        },
                        {
                            "text": "Le conférencier a capté l'attention de chaque <w>auditeur</w> présent dans la salle."
                        }
                    ],
                    "antonyms": [
                        "locuteur",
                        "orateur"
                    ],
                    "common_phrases": [
                        "auditeur de radio",
                        "fidèle auditeur"
                    ]
                },
                {
                    "sense_id": "1489cc60-97b5-39b9-8655-68f254124198",
                    "sense_definition": "Professionnel chargé de contrôler la comptabilité, la gestion ou le fonctionnement d'une entreprise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>auditeur</w> a examiné attentivement les comptes annuels de l'entreprise avant de rendre son rapport."
                        },
                        {
                            "text": "La direction a engagé un <w>auditeur</w> externe pour vérifier la conformité des procédures de sécurité."
                        }
                    ],
                    "synonyms": [
                        "contrôleur"
                    ],
                    "common_phrases": [
                        "auditeur financier",
                        "auditeur interne",
                        "auditeur externe"
                    ]
                },
                {
                    "sense_id": "9a5ca56f-3cb6-3eda-8be1-d69f5222b4ca",
                    "sense_definition": "Personne autorisée à assister aux cours d'un établissement d'enseignement supérieur sans être inscrite comme étudiante régulière.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "etudes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est inscrit comme <w>auditeur</w> libre pour suivre le cours d'histoire de l'art à l'université."
                        },
                        {
                            "text": "Cette prestigieuse école accueille chaque année plusieurs dizaines d'<w>auditeurs</w> passionnés."
                        }
                    ],
                    "common_phrases": [
                        "auditeur libre"
                    ]
                },
                {
                    "sense_id": "84be5e04-d467-3679-8f1c-64e3e574e7e5",
                    "sense_definition": "Titre porté par certains magistrats débutants ou hauts fonctionnaires, notamment au Conseil d'État ou à la Cour des comptes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa formation à l'école de la magistrature, il a débuté sa carrière comme <w>auditeur</w> de justice."
                        },
                        {
                            "text": "Elle a été nommée <w>auditeur</w> au Conseil d'État dès sa sortie de l'école nationale d'administration."
                        }
                    ],
                    "common_phrases": [
                        "auditeur de justice",
                        "auditeur au Conseil d'État"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bdd6a486-cb7c-3d94-b7cc-05cbf88fe815",
                    "sense_definition": "Qui a pour fonction d'écouter, en parlant autrefois de magistrats.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "justice_historique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce magistrat occupait autrefois la fonction de conseiller <w>auditeur</w> auprès de la chambre des comptes."
                        },
                        {
                            "text": "Les juges <w>auditeurs</w> n'avaient pas voix délibérative lors des procès devant cette juridiction."
                        }
                    ],
                    "common_phrases": [
                        "juge auditeur",
                        "conseiller auditeur"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme juridique d'Ancien Régime"
                        }
                    ]
                }
            ]
        }
