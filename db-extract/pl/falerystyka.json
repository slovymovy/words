                ],
                "senses": [
                    {
                        "sense_id": "ac10d578-5564-3a63-a477-d455cf51260c",
                        "entry_id": "c7912bec-25bb-3447-a130-bcd27ed6b6e0",
                        "glosses": [
                            "dziedzina historii badająca ordery i odznaczenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1841338d-f246-4ddf-98f3-726edbe6508d",
                                "sense_id": "ac10d578-5564-3a63-a477-d455cf51260c",
                                "text": "Odznaczenia to nie tylko dowód uznania dla zasług, to także obiekt studiów naukowych i… kolekcjonerstwa! W dzisiejszych czasach są namacalnym dowodem przeszłości. Nie powinien więc dziwić fakt, że falerystyka (odznaczenia), obok numizmatyki (monety) czy sfragistyki (pieczęcie) i heraldyki (herby), jest jedną z nauk pomocniczych historii"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "eb929c85-f0ca-3f33-b24c-da593e1a4ef6",
                        "entry_id": "c7912bec-25bb-3447-a130-bcd27ed6b6e0",
                        "glosses": [
                            "kolekcjonowanie orderów i odznaczeń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeddded4-b5de-487c-b1ab-0c73e894f823",
                                "sense_id": "eb929c85-f0ca-3f33-b24c-da593e1a4ef6",
                                "text": "Jeśli chodzi o falerystykę, rynek jest bardzo dobry, ale niestety zalewany falsyfikatami, głównie z zagranicy"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a142eeb9-3a69-4c7f-9c59-f35c22c55cfa",
                        "source_entry_id": "c7912bec-25bb-3447-a130-bcd27ed6b6e0",
                        "source_sense_id": "ac10d578-5564-3a63-a477-d455cf51260c",
                        "target_lang_word": "phaleristics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phaleristics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22af178d-ca5b-3db3-bf5f-c1600159089e",
                                        "entry_id": "00e2c6f6-17ab-33b1-91fb-6f2ebd7cbeed",
                                        "glosses": [
                                            "The study of orders, fraternity, and award items."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac4f256-b142-4849-820a-fcdd4e44b062",
                                                "sense_id": "22af178d-ca5b-3db3-bf5f-c1600159089e",
                                                "text": "For a longer and less well-focused systematising definition of the themes of phaleristics, see Attila Pandula, 'Orden und Auszeichnungen — Besondere Spiegelbilder der Geschichte', in Das Erste und Zweite Gunzenhäuser Phaleristik-Symposium (Offenach am Main, 1997), 16-21)."
                                            },
                                            {
                                                "example_id": "16e91905-55d5-4f04-a08d-8a82a1a77a9f",
                                                "sense_id": "22af178d-ca5b-3db3-bf5f-c1600159089e",
                                                "text": "The study of orders has evolved into a discipline of its own, called phaleristics (coined after the Roman order, phalera)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1f6314d-4cd6-4109-a6d8-bf1f285ce3c4",
                        "source_entry_id": "c7912bec-25bb-3447-a130-bcd27ed6b6e0",
                        "source_sense_id": "ac10d578-5564-3a63-a477-d455cf51260c",
                        "target_lang_word": "falerística",
                        "target_lang_code": "es",
