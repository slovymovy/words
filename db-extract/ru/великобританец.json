                "translations": [
                    {
                        "translation_id": "8980b3c7-bee3-4888-8ddb-70507940dab3",
                        "source_entry_id": "448d13e0-cb9d-35ca-8080-ed7047749dd0",
                        "source_sense_id": "59c28ad3-8d35-3ccf-a4a1-445a1936f618",
                        "target_lang_word": "Briton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Briton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7cc460d-5b14-3608-9d83-82a82d2e923a",
                                        "entry_id": "1f568842-68a6-3f54-a5a3-27a4b9f595d1",
                                        "glosses": [
                                            "An inhabitant of Great Britain, particularly (historical) a Celt from the area of Roman Britain or (obsolete) a Welshman; a British person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8064c1c7-400b-4114-b907-556349c5a411",
                                                "sense_id": "c7cc460d-5b14-3608-9d83-82a82d2e923a",
                                                "text": "The ancient Britons were particularly fond of Anglesey, which the Romans knew as Mona."
                                            },
                                            {
                                                "example_id": "aa0725a7-abaf-4eb1-be8e-a377e73ec87f",
                                                "sense_id": "c7cc460d-5b14-3608-9d83-82a82d2e923a",
                                                "text": "At last the Saxons had killed nearly all the Britons, and the few who remained took refuge in the mountains, in that part of the country which we now call Wales, and in Cornwall."
                                            },
                                            {
                                                "example_id": "c394c89e-7df2-4cfe-a863-32ae44ad2a63",
                                                "sense_id": "c7cc460d-5b14-3608-9d83-82a82d2e923a",
                                                "text": "He writhed for twenty minutes under the flowery and eulogistic periods of the president, and rose himself in the state of confused indignation which the Briton feels when he is publicly approved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                        "entry_id": "1f568842-68a6-3f54-a5a3-27a4b9f595d1",
                                        "glosses": [
                                            "A citizen of the United Kingdom or (historical, obsolete) its overseas empire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d74248-6fbf-443e-8ed9-9e6067e4dbd0",
                                                "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                                "text": "Rule, Britannia! Britannia rules the waves:\nBritons never, never, never will be slaves."
                                            },
                                            {
                                                "example_id": "758ba366-43a6-486e-b881-3aa15b31b183",
                                                "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                                "text": "...when these hateful termes of Scottes and Englishemen, shalbe abolisshed, and blotted oute for euer, and we shal al agre in the onely title and name of Britons..."
                                            },
                                            {
                                                "example_id": "f6de3890-18bb-497d-a047-1a28187ec306",
                                                "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                                "text": "I glory in the name of Briton."
                                            },
                                            {
                                                "example_id": "25eae12a-600c-45e4-9d68-ee54362ecd9d",
                                                "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                                "text": "Many of the rank and file had no better conception of the proud and sensitive Maori than was implied in the degrading 'nigger' theory, invariably applied by the unthinking Briton to all coloured races."
                                            },
                                            {
                                                "example_id": "5f0316eb-66db-4639-ba18-fc28487df9e2",
                                                "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                                "text": "The victims included 3 Canadians, 2 Irishmen, and 1 Briton."
                                            },
                                            {
                                                "example_id": "eeedfac7-0223-4160-84c9-c14efb9e3619",
                                                "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                                "text": "The hiker was a Briton from New Zealand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30e0a9e4-5af7-4cd3-8b18-f1c6766604eb",
                        "source_entry_id": "448d13e0-cb9d-35ca-8080-ed7047749dd0",
                        "source_sense_id": "59c28ad3-8d35-3ccf-a4a1-445a1936f618",
                        "target_lang_word": "Brite",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brite",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1489b4ee-e65c-390f-a401-96d9ee6ba908",
                                        "entry_id": "1f87c168-b0c8-35d6-8986-7077c8586a11",
                                        "glosses": [
                                            "Staatsbürger von Großbritannien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af82a3e8-6b54-44c5-be23-7379bc2ec4dc",
                                                "sense_id": "1489b4ee-e65c-390f-a401-96d9ee6ba908",
                                                "text": "„Die Briten flogen massive Luftangriffe, vor allem an Ruhr und Rhein…“"
                                            },
                                            {
                                                "example_id": "9914f55d-3307-49d4-a19e-07d6d741aa72",
                                                "sense_id": "1489b4ee-e65c-390f-a401-96d9ee6ba908",
                                                "text": "„In den Kriegen der Briten gegen die Niederlande, dann immer wieder gegen Frankreich, ging es natürlich auch um Nordamerika, aber vorrangig stets um die Karibik.“"
                                            },
                                            {
                                                "example_id": "773b258c-bb2a-46cc-8014-19d31b53f96f",
                                                "sense_id": "1489b4ee-e65c-390f-a401-96d9ee6ba908",
                                                "text": "„Die Strategie der Kolonialherren geht auf; im Oktober 1956 nehmen die Briten den wichtigsten Anführer der Rebellen fest.“"
                                            },
                                            {
                                                "example_id": "64b17afb-03f8-4325-ad38-db61d66f1cf2",
                                                "sense_id": "1489b4ee-e65c-390f-a401-96d9ee6ba908",
                                                "text": "„Während all dem steht der Brite da und raucht seine Pfeife.“"
                                            },
                                            {
                                                "example_id": "ea6237d1-c781-403c-99c7-53d156874c2b",
                                                "sense_id": "1489b4ee-e65c-390f-a401-96d9ee6ba908",
                                                "text": "„Er mochte diesen Film, weil er zeigte, wie eine Handvoll Briten einen ganzen Kontinent in Schach hielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
