                        "sense_id": "ddfe64da-bc63-3871-9e16-280e5b8a5f5a",
                        "entry_id": "ec81f8eb-60c2-3076-b0c8-916e20baf61c",
                        "glosses": [
                            "een plan waarin een beschrijving en het doel van de behandeling staan samen met de algemene gegevens van een patiënt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e8a1ce-fd6a-4e53-aa98-402b42064771",
                                "sense_id": "ddfe64da-bc63-3871-9e16-280e5b8a5f5a",
                                "text": "De gemeente gaat sinds 2015 over de jeugdzorg en ambtenaren vragen voor het controleren van de rekeningen informatie over het ziektebeeld van jonge patiënten. Sommige gemeenten weigeren te betalen als exacte gegevens of het behandelingsplan bij de declaratie ontbreekt."
                            },
                            {
                                "example_id": "ed89b005-9a37-49b5-ab12-23819ba15308",
                                "sense_id": "ddfe64da-bc63-3871-9e16-280e5b8a5f5a",
                                "text": "Boom zal dinsdag in Nederland verder worden onderzocht. Op grond van de bevindingen zal een behandelingsplan worden opgesteld."
                            }
                        ]
                    }
