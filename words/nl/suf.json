        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0be19522-ff6e-34aa-9eab-eb761784892a",
                    "sense_definition": "Moeite ervarend om oplettend te zijn; slaperig en niet goed alert.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Suf (slaperig en niet alert)",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de lange reis voelde hij zich erg <w>suf</w> en ging hij vroeg naar bed.",
                            "target_lang_translations": {
                                "en": "After the long journey he felt very <w>drowsy</w> and went to bed early.",
                                "ru": "После долгой поездки он чувствовал себя очень <w>сонным</w> и рано лег спать."
                            }
                        },
                        {
                            "text": "Na het eten kreeg ze een <w>suf</w> gevoel en wilde ze even liggen.",
                            "target_lang_translations": {
                                "en": "After eating she got a <w>sleepy</w> feeling and wanted to lie down for a bit.",
                                "ru": "После еды она почувствовала <w>вялость</w> и захотела немного полежать."
                            }
                        },
                        {
                            "text": "Na de lange reis was hij blij zijn <w>suffe</w> hersenen wat rust te kunnen gunnen.",
                            "target_lang_translations": {
                                "en": "After the long journey he was happy to be able to give his <w>groggy</w> brain some rest.",
                                "ru": "После долгой поездки он был рад дать своим <w>одуревшим</w> мозгам немного отдохнуть."
                            }
                        }
                    ],
                    "synonyms": [
                        "lodderig",
                        "slaperig",
                        "duf"
                    ],
                    "common_phrases": [
                        "suf van de reis",
                        "een suf gevoel",
                        "suf in het hoofd"
                    ],
                    "target_lang_definitions": {
                        "en": "Experiencing difficulty staying attentive; sleepy and not fully alert.",
                        "ru": "Испытывающий трудности с концентрацией внимания; сонный и не полностью бодрый."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drowsy",
                                "target_lang_sense_clarification": "feeling sleepy and lethargic"
                            },
                            {
                                "target_lang_word": "groggy",
                                "target_lang_sense_clarification": "dazed or unsteady, especially from lack of sleep"
                            },
                            {
                                "target_lang_word": "sleepy",
                                "target_lang_sense_clarification": "needing or ready for sleep"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сонный",
                                "target_lang_sense_clarification": "находящийся в состоянии сонливости"
                            },
                            {
                                "target_lang_word": "вялый",
                                "target_lang_sense_clarification": "лишенный энергии, заторможенный"
                            },
                            {
                                "target_lang_word": "одуревший",
                                "target_lang_sense_clarification": "потерявший ясность мышления от усталости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58380227-4b79-3c51-a425-51d1b18dab40",
                    "sense_definition": "Dom of flauw; weinig slim of weinig leuk.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Suf (dom of flauw)",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat is een <w>suf</w> idee; laten we iets beters bedenken.",
                            "target_lang_translations": {
                                "en": "That is a <w>dull</w> idea; let's think of something better.",
                                "ru": "Это <w>глупая</w> идея; давай придумаем что-нибудь получше."
                            }
                        },
                        {
                            "text": "Hij maakte een <w>suf</w> grapje dat niemand echt leuk vond.",
                            "target_lang_translations": {
                                "en": "He made a <w>lame</w> joke that nobody really liked.",
                                "ru": "Он отпустил <w>скучную</w> шутку, которая никому особо не понравилась."
                            }
                        }
                    ],
                    "synonyms": [
                        "saai",
                        "stom"
