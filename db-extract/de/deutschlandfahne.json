                    {
                        "sense_id": "0a39b0b3-9be2-3db2-b642-f8d2f300dfe9",
                        "entry_id": "61b6b8b5-7343-3011-8d1a-28aa75d6cc3b",
                        "glosses": [
                            "Fahne mit horizontalen Streifen in den Farben Schwarz, Rot und Gold"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c15210d-87ac-44c7-a15d-d63a167c5935",
                                "sense_id": "0a39b0b3-9be2-3db2-b642-f8d2f300dfe9",
                                "text": "Während der Fußballweltmeisterschaft 2006 in Deutschland konnte man viele Deutschlandfahnen sehen."
                            },
                            {
                                "example_id": "0299b5f5-50ec-47d6-a418-2f5907124695",
                                "sense_id": "0a39b0b3-9be2-3db2-b642-f8d2f300dfe9",
                                "text": "„Im ersten Stock hängt eine Deutschlandfahne, die an einer Seite eingerissen ist und von Wind und Wetter verbeult aussieht.“"
                            },
                            {
                                "example_id": "c01f2a0d-5af3-4ed2-9e02-8b52b3f88c24",
                                "sense_id": "0a39b0b3-9be2-3db2-b642-f8d2f300dfe9",
                                "text": "„Doch außer bei der Fußball-Weltmeisterschaft hat das Schwenken einer Deutschlandfahne noch immer einen bitteren Beigeschmack.“"
                            }
                        ],
