                                    },
                                    {
                                        "sense_id": "bb3acde4-e7b0-382d-94db-11dbbc6cb31d",
                                        "entry_id": "ced5dbb2-8a7d-3be4-a265-1e28f8d509ae",
                                        "glosses": [
                                            "Higher in rank, power, or position."
                                        ],
