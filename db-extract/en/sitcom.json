                                        "glosses": [
                                            "Comédie de situation, série télévisée à dominante humoristique."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "254fad3b-d381-4b20-b42d-93a138e792ee",
                                                "sense_id": "a0bbc69e-640a-3b54-8fc3-d31fdface67f",
                                                "text": "Seuls les rires en cascade et la nature des dialogues nous signifient qu’il s’agit d’un sitcom."
                                            }
                                        ]
