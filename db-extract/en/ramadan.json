                                "target_senses": [
                                    {
                                        "sense_id": "5d39602f-25e5-33fd-ab68-697a773b71e9",
                                        "entry_id": "27eeb8f3-d52f-3d43-9d76-e746e8567ed8",
                                        "glosses": [
                                            "de negende maand van het islamitische jaar, waarin men vast (d.w.z. zich onthoudt van voedsel, drinken, roken en seksueel genot) van zonsopgang tot zonsondergang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de92b605-b30b-4c45-90f1-9b5a59c4b012",
                                                "sense_id": "5d39602f-25e5-33fd-ab68-697a773b71e9",
                                                "text": "Terwijl een flink deel van de stadsbevolking zich aan de beperkingen van de ramadan hield, zat hij een heerlijk broodje bal te eten (met mosterd)!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94e414e0-4e3d-4464-8bd6-e996a452fa4b",
                        "source_entry_id": "b0f4e673-133a-31ee-b1b8-baf4761d7bdc",
                        "source_sense_description": "holy ninth month of Islamic lunar calendar",
                        "target_lang_word": "ramadan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ramadan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "487336bf-dcea-384b-af78-fa421bb3fe4b",
                                        "entry_id": "899d2882-d423-3da2-89fe-8968ec2c7464",
                                        "glosses": [
                                            "Neuvième mois du calendrier musulman, que les fidèles consacrent à un jeûne de l’aube à la tombée de la nuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6180d5-b03b-45bd-ab3d-c65c1f0b9ade",
                                                "sense_id": "487336bf-dcea-384b-af78-fa421bb3fe4b",
                                                "text": "Depuis le 24 janvier nous sommes en ramadan, neuvième mois de l’année lunaire mahométane, pendant lequel tout bon musulman s’abstient de manger, de boire, de fumer, bref, de toute jouissance charnelle, depuis l’aube jusqu’au coucher du soleil."
                                            },
                                            {
                                                "example_id": "74600017-a031-4047-8324-6f40d44baad6",
                                                "sense_id": "487336bf-dcea-384b-af78-fa421bb3fe4b",
                                                "text": "— J’ai plaisir aussi à vous conter cette autre savoureuse aventure de notre excellent Pierre : son atterrissage forcé dans une localité du Béloutchistan en un jour de ramadan où tout étranger surpris dehors était immédiatement massacré."
                                            },
                                            {
                                                "example_id": "af0f3504-130f-4b41-9f69-4da64375e820",
                                                "sense_id": "487336bf-dcea-384b-af78-fa421bb3fe4b",
                                                "text": "La société familiale fondée par Jean-Paul Blanchère et copilotée par Johan, son neveu, essaie de s’ouvrir à de nouveaux marchés : « On travaille un peu avec les pays du Golfe pendant le ramadan, il y a aussi le Nouvel an chinois »."
                                            },
                                            {
                                                "example_id": "66282728-9bec-40a1-996a-c871be81db7a",
                                                "sense_id": "487336bf-dcea-384b-af78-fa421bb3fe4b",
                                                "text": "Dans le rayon installé pour le ramadan, un petit garçon extasié tient un paquet de dattes fourrées de pâte d’amande rose et verte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2851ddd3-b78c-3a74-9c58-34c891f02835",
                                        "entry_id": "899d2882-d423-3da2-89fe-8968ec2c7464",
                                        "glosses": [
                                            "Jeûne musulman lui-même, quatrième pilier de l’Islam."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b7f18bd-9e1c-43f3-9dc4-cb58030e452a",
                                                "sense_id": "2851ddd3-b78c-3a74-9c58-34c891f02835",
                                                "text": "Comme il fait le ramadan, il ne viendra pas manger avec nous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ffb98a3-1dfd-47fb-aa8f-281a2c0f9259",
                        "source_entry_id": "b0f4e673-133a-31ee-b1b8-baf4761d7bdc",
                        "source_sense_description": "holy ninth month of Islamic lunar calendar",
                        "target_lang_word": "Ramadan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ramadan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50e2722f-0e31-3a30-a39b-0d65b343b854",
                                        "entry_id": "19e786d8-784f-3bf1-b453-65535340f5a8",
                                        "glosses": [
                                            "der neunte Monat des islamischen Mondkalenders und heiliger Fastenmonat, während dem jeder gläubige Muslim (mit Ausnahmen wie unter anderem Kranke, Reisende, Schwangere und vorpubertäre Kinder) verpflichtet ist, sich von Sonnenaufgang bis Sonnenuntergang des Essens, Trinkens und des Beischlafs zu enthalten"
                                        ],
                                        "tags": [
                                            "islamische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c5ee80c-c89d-4773-b598-683cecc26f2a",
                                                "sense_id": "50e2722f-0e31-3a30-a39b-0d65b343b854",
                                                "text": "Im Ramadan fasten die Muslime."
                                            },
                                            {
                                                "example_id": "805e24b9-4b58-42a2-8042-463ac0ca7050",
                                                "sense_id": "50e2722f-0e31-3a30-a39b-0d65b343b854",
                                                "text": "„«Insha'Allah» werden wir in einem der nächsten Ramadane wieder dabei sein und musikalische «Nights in Tunisia» oder anderswo verbringen können.“"
                                            },
                                            {
                                                "example_id": "b8792035-73ca-4a76-9272-48c79956d42d",
                                                "sense_id": "50e2722f-0e31-3a30-a39b-0d65b343b854",
                                                "text": "„Eben noch war die Zeit des Ramadan (der heilige Monat, während dem die MuslimInnen [sic] fasten), und es war Weihnachtszeit (die heilige Woche, während der die ChristInnen [sic] konsumieren). Der Ramadan fällt nicht oft in den Winter. Denn der islamische Kalender ist lunar, der Stand des Mondes bestimmt Anfang und Ende eines jeden Monats. Der einzige winterliche Ramadan, an den ich mich erinnere, war der Ramadan vor einem Jahr. In einer einzigen Woche fielen jüdische, islamische und christliche Feiertage zusammen. Pessach, Weihnachten und Aid al-Fitr, die Tage nach Ende des Ramadan.“"
                                            },
                                            {
                                                "example_id": "7b7720df-48b9-418a-86b4-2a0d5508e4fe",
                                                "sense_id": "50e2722f-0e31-3a30-a39b-0d65b343b854",
                                                "text": "„‚In Grenada begrüße ich jetzt unseren Kollegen Taysir Aluni‘, sagt Dschaddu, ‚frohen Ramadan, Taysir!‘“"
                                            },
                                            {
                                                "example_id": "02ddcc66-24cf-4f9d-9bc5-72a06e782e18",
                                                "sense_id": "50e2722f-0e31-3a30-a39b-0d65b343b854",
                                                "text": "„Dazu gehört die Solidarität mit den Armen, die während des Ramadans von den Reicheren jeden Abend zum Essen eingeladen werden.“"
                                            },
                                            {
                                                "example_id": "71e10204-921b-41a2-8ac4-e000d412c3a4",
                                                "sense_id": "50e2722f-0e31-3a30-a39b-0d65b343b854",
                                                "text": "„Denn alljährlich im Ramadan, wenn eine Welle neuer TV-Serien über die Wohnzimmer der arabischen Welt hereinbricht, treten die neusten Folgen von »Tash ma Tash« Diskussionen um Religion, Ehre und Meinungsfreiheit los.“"
                                            },
                                            {
                                                "example_id": "1e8d0afc-e5a3-4d96-b7fc-c9b7117308a3",
                                                "sense_id": "50e2722f-0e31-3a30-a39b-0d65b343b854",
                                                "text": "„Besonders hart wird es für Raucher, denn auch diesem Laster soll der gläubige Muslim während des Ramadans abschwören.“"
                                            },
                                            {
                                                "example_id": "97dbec95-a695-48a4-8654-6defd5c71775",
                                                "sense_id": "50e2722f-0e31-3a30-a39b-0d65b343b854",
                                                "text": "„Ein paar Ramadane im Sommer (heuer bis 20. August) wird es jedoch noch geben.“"
                                            },
                                            {
                                                "example_id": "986eb15e-f39d-4b53-befc-7888eed22692",
                                                "sense_id": "50e2722f-0e31-3a30-a39b-0d65b343b854",
                                                "text": "„Weil allerdings der islamische Mondkalender von Monaten mit 29 oder 30 Tagen Dauer ausgeht, «wandert» der Ramadan, wie auch die übrigen Monate dieses Kalenders, wegen der Inkongruenz mit dem Jahreslauf der Sonne so quasi durch die Jahreszeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
