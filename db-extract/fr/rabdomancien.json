                            {
                                "example_id": "d37b3183-e21d-4b86-b60f-d556f0af4c55",
                                "sense_id": "f3ea9f64-0485-3af2-a68e-f55d1f91dbc0",
                                "text": "Quoi quʼil en soit, un nouveau rabdomancien, M. Benoît Padey de Belley, fut appelé, et il conseilla de forer, dans une des caves de lʼétablissement, un deuxième puits de 15 à 16 mètres de profondeur."
                            },
                            {
                                "example_id": "34a56384-c4a8-4988-8c62-93379df1bcdf",
                                "sense_id": "f3ea9f64-0485-3af2-a68e-f55d1f91dbc0",
                                "text": "En effet, la rabdomancienne ne se ménagea pas; presque partout, le bâton de cendrier, prétendu révélateur, avait une rotation vertigineuse."
                            }
                        ]
                    }
