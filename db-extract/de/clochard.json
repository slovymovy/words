                    {
                        "translation_id": "c07cef15-4008-464a-b636-9f2dc20c70ba",
                        "source_entry_id": "74d676d5-0d97-3a86-993c-65b538d3721e",
                        "source_sense_id": "d0675505-05d4-3310-9b84-025fd85997aa",
                        "source_sense_description": "Stadtstreicher",
                        "target_lang_word": "clochard",
                        "target_lang_code": "nl",
