                        "entry_id": "d147b5b5-601d-3480-bd25-9b3dfeaa6904",
                        "glosses": [
                            "A county of Dahingganling prefecture, Heilongjiang, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e29b5ba-2be9-435b-8592-cc8d734919a9",
                                "sense_id": "83e41706-b345-3b12-9e22-ffe5956a8d11",
                                "text": "In the Wupalao Island area in Huma County of Heilungkiang Province, China, between June 1 and July 31, Soviet troops almost daily opened fire from the Soviet bank with light and heavy machineguns on the island and the Chinese bank, firing a total of 1,743 bursts and 1,067 single shots."
                            },
                            {
                                "example_id": "f80cb1e8-6ad8-4c59-857c-60a274b20420",
                                "sense_id": "83e41706-b345-3b12-9e22-ffe5956a8d11",
                                "text": "Workers in China’s northernmost province of Heilongjiang are using explosives to clear a river of ice jams in an effort to prevent flooding. Ice jams are river blockages caused by melting ice that can cause floods or raised water levels. Authorities in Huma county arranged for the ice detonation in a river on the border with Russia, as temperature rises have caused the river to thaw at a faster rate."
                            }
                        ]
                    }
