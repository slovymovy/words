                                        "glosses": [
                                            "(～湖) 位於中國青海的湖"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "905f6aad-ac20-4ca2-b7c2-987b9ad6358f",
                                                "sense_id": "f9812281-786e-3485-8661-b5f543df0bdf",
                                                "text": "君不見青海頭，古來白骨無人收。",
                                                "translation": "你沒看見青海湖的湖畔邊上，自古以來戰死士兵的白骨沒人埋葬。"
                                            },
                                            {
                                                "example_id": "214aba91-fbd4-469e-8884-e9440fe9cca9",
                                                "sense_id": "f9812281-786e-3485-8661-b5f543df0bdf",
                                                "text": "君不见青海头，古来白骨无人收。",
                                                "translation": "你沒看見青海湖的湖畔邊上，自古以來戰死士兵的白骨沒人埋葬。"
                                            }
