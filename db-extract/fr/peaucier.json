                        "glosses": [
                            "Relatif à un muscle ou à un ensemble de muscles dont une extrémité au moins s’arrête à la peau et qui la plisse lorsqu’il se contracte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87320ee4-a661-4997-b7fc-8fb25acf93a5",
                                "sense_id": "5ce12fd2-583f-3767-b079-5114751f4646",
                                "text": "Arrivé là, il fit effectuer à ses gros sourcils grisonnants un double mouvement de reptation peaucière, le sourcil gauche vers le sourcil droit"
                            },
                            {
                                "example_id": "3303155e-cf8f-445a-b35f-54b82f31661d",
                                "sense_id": "5ce12fd2-583f-3767-b079-5114751f4646",
                                "text": "Le nerf facial assure la contraction de l’orbiculaire des lèvres et des buccinateurs ; c’est le nerf moteur de la musculature peaucière faciale."
                            }
                        ]
                    }
