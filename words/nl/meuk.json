                                "target_lang_sense_clarification": "rubbish or worthless stuff"
                            },
                            {
                                "target_lang_word": "stuff",
                                "target_lang_sense_clarification": "low-quality belongings or items"
                            },
                            {
                                "target_lang_word": "crap",
                                "target_lang_sense_clarification": "informal term for cheap or worthless things"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
