                        "form_id": "e230ceb5-1a43-418c-95d8-6c85f8ca5033",
                        "entry_id": "b1503b93-8814-3d97-ac89-aa2dc89ef814",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Schwachkopf"
                    },
                    {
                        "form_id": "0d6c03c7-73e1-4a9d-9f40-7eef4f85f117",
                        "entry_id": "b1503b93-8814-3d97-ac89-aa2dc89ef814",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schwachköpfe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                        "entry_id": "b1503b93-8814-3d97-ac89-aa2dc89ef814",
                        "glosses": [
                            "Person, die man für geistig minderbemittelt hält; jemand, der nichts begreift"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "dc823dd6-7694-4ea9-9efd-7d93cecd2262",
                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                "text": "Man hat noch selten einen Schwachkopf wie dich erlebt."
                            },
                            {
                                "example_id": "b517b2fe-0057-4f58-ab91-e5b86c73b5f6",
                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                "text": "Er versteht gar nichts, er ist ein richtiger Schwachkopf."
                            },
                            {
                                "example_id": "3b3353a4-e562-4971-b30a-5ca645b408d9",
                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                "text": "„Dass ein Schwachkopf weniger fähig sein mag, die Schönheit einer Symphonie oder eines subtilen Gedankengangs zu genießen, glaubt man ohne Weiteres, im Hinblick auf beispielsweise eine Fellatio hingegen überrascht es; die Erfahrung bestätigt es dennoch.“"
                            },
                            {
                                "example_id": "3b862ffc-9ccb-48b4-8d7a-434c4d216b44",
                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                "text": "„Ich war sehr besorgt, denn wenn der Geistliche kein Schwachkopf war, konnte ihm nicht verborgen bleiben, daß die Verblichene an Gift gestorben war.“"
                            },
                            {
                                "example_id": "3019a9d8-ba2e-4d3c-b9a4-2e5b02b62372",
                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                "text": "„Sie schienen nicht zu merken, was für ein Schwachkopf ich geworden war.“"
                            },
                            {
                                "example_id": "1d4d6de9-fddd-4a8c-abbd-e3c7dec50def",
                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                "text": "„Einmal, vor etwa achtzehn Monaten, habe ich über einhundert Stiche gebraucht, bis dieser Schwachkopf damals endlich tot war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35450210-2241-477b-af04-8b52de48d79a",
                        "source_entry_id": "b1503b93-8814-3d97-ac89-aa2dc89ef814",
                        "source_sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                        "source_sense_description": "abwertend, Schimpfwort: Person, die man für geistig minderbemittelt hält; jemand, der nichts begreift",
                        "target_lang_word": "débile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "269a5cb9-95f6-3a04-88fd-6564050a24d6",
                                        "entry_id": "bb2e9dd6-5f86-3f99-bb28-a9b562888f92",
                                        "glosses": [
                                            "Faible, qui manque de forces, de vigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24c118d5-d49a-465d-8357-70186d278864",
                                                "sense_id": "269a5cb9-95f6-3a04-88fd-6564050a24d6",
                                                "text": "On a les jambes débiles après de longues maladies. Un estomac débile doit observer un grand régime."
                                            },
                                            {
                                                "example_id": "c0a0e652-90ab-4868-bd3d-d9ba917cfd16",
                                                "sense_id": "269a5cb9-95f6-3a04-88fd-6564050a24d6",
                                                "text": "Toute débile que j'étais, dit-elle, ou, pour dire la vérité, demi-morte, je montai à cheval pour aller avec mon mari rejoindre l'armée […]."
                                            },
                                            {
                                                "example_id": "6f6b4cf1-a395-4e6e-b0f0-d00d62fd1b46",
                                                "sense_id": "269a5cb9-95f6-3a04-88fd-6564050a24d6",
                                                "text": "[…] il me semble aussi que c'est lui qui nous quitte et que je prends congé d'un mourant... Mais il y a des mois et des mois, me dit-on, qu'il semble ainsi près de mourir et que seule la ferveur entretient dans ce corps débile cette flamme près de s'éteindre."
                                            },
                                            {
                                                "example_id": "3ca282cc-1c60-47f0-a6e0-750c74d4dbd0",
                                                "sense_id": "269a5cb9-95f6-3a04-88fd-6564050a24d6",
                                                "text": "L'État est un être énorme, terrible, débile. Cyclope d'une puissance et d'une maladresse insignes, enfant monstrueux de la Force et du Droit, qui l'ont engendré de leurs contradictions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bea401c-7942-3cb6-b29b-9c907287f3f8",
                                        "entry_id": "bb2e9dd6-5f86-3f99-bb28-a9b562888f92",
                                        "glosses": [
                                            "Qui est atteint dans sa raison."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82a3a171-ea96-426a-a681-be3f1851b0d7",
                                                "sense_id": "3bea401c-7942-3cb6-b29b-9c907287f3f8",
                                                "text": "Rien d'autre, dans la communauté virtuelle, que le désolant spectacle des bogosses autoproclamés qui filaient des rancards débiles à des filles qui ne l'étaient pas moins, à grand renfort de Ase soiiiiiiiir, jte kiff ou de G troooooop hâte d'y eeeeetre. Non, je ne les enviais pas."
                                            },
                                            {
                                                "example_id": "2fcad3bc-b06f-4310-8681-53ed229dfda2",
                                                "sense_id": "3bea401c-7942-3cb6-b29b-9c907287f3f8",
                                                "text": "Le clown débile s’accroche et il y a longtemps qu’il n’amuse plus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "débile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0633eb5a-65c3-358c-852d-92835f9b0950",
                                        "entry_id": "9d45ea19-b116-3047-be12-80087da49653",
                                        "glosses": [
                                            "Personne atteinte d’arriération, de débilité mentale."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7301b35a-5f9e-4de9-99ff-20debfda4766",
                                                "sense_id": "0633eb5a-65c3-358c-852d-92835f9b0950",
                                                "text": "Que des lois nouvelles leur donnent le moyen de mieux protéger les familles naufragées dont le père est devenu un énergumène, un débile mental !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf7b8ae2-9180-3934-83af-77ec6421bbe2",
                                        "entry_id": "9d45ea19-b116-3047-be12-80087da49653",
                                        "glosses": [
                                            "Personne méprisable qui manque d’intelligence."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3bee793-923a-4d4f-8ca8-f2a0509bac61",
                                                "sense_id": "bf7b8ae2-9180-3934-83af-77ec6421bbe2",
                                                "text": "T’es un gros débile ! : tu es bête"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
