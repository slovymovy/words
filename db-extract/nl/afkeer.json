        "nl-extract.jsonl": [
            {
                "entry_id": "be8c2547-0a42-3287-af99-8fc38dd42b67",
                "word": "afkeer",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a58cf1d4-35a8-3a10-8491-7eb72da9b53a",
                        "entry_id": "be8c2547-0a42-3287-af99-8fc38dd42b67",
                        "glosses": [
                            "een sterke behoefte om zich tegen iets te keren omdat je het vervelend of verkeerd vindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f79a2d1-ee3e-499a-bb42-7f7442f20e31",
                                "sense_id": "a58cf1d4-35a8-3a10-8491-7eb72da9b53a",
                                "text": "Sommige mensen hebben een afkeer van het drinken van alcohol."
                            },
                            {
                                "example_id": "06f2bcde-fc57-433b-b425-ce3f2eeac226",
                                "sense_id": "a58cf1d4-35a8-3a10-8491-7eb72da9b53a",
                                "text": "Hij keek met afkeer naar de vechtende mannen."
                            },
                            {
                                "example_id": "9c81cdd1-e8c5-4048-9ef2-a4caf192ecd1",
                                "sense_id": "a58cf1d4-35a8-3a10-8491-7eb72da9b53a",
                                "text": "Maar in '84 was het adres aan de Looiersgracht nog een toevluchtsoord voor Hannah, en als het haar uitkwam maakte ze dankbaar gebruik van de uitnodiging, haar via haar befaamde pleegvader gegund, al was het om in de prachtige woning rond te hangen en de bijzondere verzamelingen van Van Lohuijzen met onverhulde jaloezie te bewonderen, terwijl ze voor zichzelf een dergelijk leven fantaseerde, al zat diep verborgen in dat gretig verlangen, in feite in de kern ervan, een afkeer die haar schrik aanjoeg."
                            },
                            {
                                "example_id": "e9a87bc4-260b-4cfb-8341-29d49dc7ce30",
                                "sense_id": "a58cf1d4-35a8-3a10-8491-7eb72da9b53a",
                                "text": "Volgens het onderzoek ondervinden tussen de 600.000 en 800.000 Nederlanders ernstige hinder van verkeerslawaai. Ze zijn boos en hebben gevoelens van afkeer, onbehagen en onvoldaanheid. Nog eens 300.000 mensen hebben slaapproblemen door verkeerslawaai."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3479e86-d785-442b-9b24-36bde317f78e",
                        "source_entry_id": "be8c2547-0a42-3287-af99-8fc38dd42b67",
                        "source_sense_id": "a58cf1d4-35a8-3a10-8491-7eb72da9b53a",
                        "source_sense_description": "een sterke behoefte om zich tegen iets te keren",
                        "target_lang_word": "Abneigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abneigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                        "entry_id": "6bc95e84-9464-31ba-b609-95a693d2ee47",
                                        "glosses": [
                                            "leichter Widerwille gegen etwas oder eine Person, oft ohne das genau begründen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "007e3645-b387-4017-8f48-a553e18fcbc3",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Die Abneigung der Polen gegen ihre Neureichen steht der der Westeuropäer in nichts nach.“"
                                            },
                                            {
                                                "example_id": "9e908d4a-da7f-44fc-92d3-6dc694654ec1",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "Ich hatte sofort eine Abneigung gegen den neuen Mitschüler, obwohl er mir angeboten hatte, mir bei den Hausaufgaben zu helfen."
                                            },
                                            {
                                                "example_id": "1e632a8c-d46a-4e41-93fd-f561aec769d6",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Daher waren Christenfeinde in der frühen Kaiserzeit weniger von Hass gegen die neue Lehre erfüllt; ihre Abneigung entsprang vielmehr ihrer affirmativen Haltung zum Imperium.“"
                                            },
                                            {
                                                "example_id": "ae6664e8-23bf-4e40-9bf1-6dfe833af7af",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Die Abneigung gegen alles Nützliche verdichtete sich von Tag zu Tag.“"
                                            },
                                            {
                                                "example_id": "2222c42d-22a3-4082-80dc-1e21e8fa2f1e",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Vom ersten Augenblick des Kennenlernens an faßte er gegen diesen glatten Hübschling Abneigung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
