                "senses": [
                    {
                        "sense_id": "b79c6133-2176-301f-b5aa-1cbcbef6c24a",
                        "entry_id": "436e8ed2-0896-398a-8d26-d398b688f291",
                        "glosses": [
                            "Ensemble des substances provenant du latex du pavot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fad4380d-5d25-4a74-bbcf-d16da442919c",
                                "sense_id": "b79c6133-2176-301f-b5aa-1cbcbef6c24a",
                                "text": "Il refusa les opiacées (sic) qu’on voulait lui faire prendre pour soulager ses souffrances : « C’est une âme sereine et libre de tout nuage que je veux rendre à Dieu », dit-il."
                            },
                            {
                                "example_id": "2988f325-8133-4a14-aaf8-5cdc9843512d",
                                "sense_id": "b79c6133-2176-301f-b5aa-1cbcbef6c24a",
                                "text": "Cause du décès : intoxication par opiacés. — (Mikal Hem, Et si je devenais dictateur, traduit du norvégien par Jean-Baptiste Coursaud, Gaïa, 2017, page 204)"
                            },
                            {
                                "example_id": "12d58a56-cade-4b8f-8892-623898600a5b",
                                "sense_id": "b79c6133-2176-301f-b5aa-1cbcbef6c24a",
                                "text": "Puis, en 1999, une femme avec qui le Dr Roy avait eu une liaison extra-conjugale est morte dans un accident de voiture alors qu’elle était surmédicamentée à l’hydrocodone, un opiacé que le médecin lui avait prescrit en cachette, sans ouvrir de dossier médical."
                            }
                        ]
                    }
