                                    {
                                        "sense_id": "faaee324-cb37-3e80-8fe9-67bea0b7c32f",
                                        "entry_id": "1a2be2d7-956c-3815-bdb9-9e557a1f0911",
                                        "glosses": [
                                            "kleines Haus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db3e3cde-ce78-4eb1-9654-c053fec0224d",
                                                "sense_id": "faaee324-cb37-3e80-8fe9-67bea0b7c32f",
                                                "text": "„Gegenüber am Häuschen von Radio Web - bis auf weiteres laden wir einen Akku gratis - steht ein blasses Fräulein mit einer Kappe tief ins Gesicht und scheint intensiv nachzudenken.“"
                                            },
                                            {
                                                "example_id": "0f5265fc-f734-4de1-b2fd-f33704687e43",
                                                "sense_id": "faaee324-cb37-3e80-8fe9-67bea0b7c32f",
                                                "text": "„Mein Führer brachte mich zu einem reizenden Häuschen an einer Seite des Hauptgebäudes.“"
                                            },
                                            {
                                                "example_id": "e32622a2-c55e-46df-8978-958e3a81f9bb",
                                                "sense_id": "faaee324-cb37-3e80-8fe9-67bea0b7c32f",
                                                "text": "„Das Häuschen, das mitten auf dem Olivenacker stand, war wohl eine Art Geräteschuppen.“"
                                            },
                                            {
                                                "example_id": "3fa7d870-1dc7-43ba-8b5b-b666f2bebbd7",
                                                "sense_id": "faaee324-cb37-3e80-8fe9-67bea0b7c32f",
                                                "text": "„Tobias wohnte zur Miete in einem kleinen Häuschen neben einem Kindergarten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b8f1fd7f-c770-3cef-8238-6490b46a1f0d",
                                        "entry_id": "1a2be2d7-956c-3815-bdb9-9e557a1f0911",
                                        "glosses": [
                                            "nicht im Haus gelegene, spartanische Räumlichkeit zur Verrichtung der Notdurft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd100099-bc8a-48a9-9192-f5094d7c6cdf",
                                                "sense_id": "b8f1fd7f-c770-3cef-8238-6490b46a1f0d",
                                                "text": "Es ist besser, du gehst aufs Häuschen."
                                            }
