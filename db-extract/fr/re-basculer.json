                        "examples": [
                            {
                                "example_id": "6cea2bad-9f8c-4970-87f8-bf18f9b3f839",
                                "sense_id": "980e8fa1-ca52-394c-b2be-86e866615a80",
                                "text": "Quoi, monsieur Quilès, ces Français qui votèrent pour Mitterrand (et accessoirement pour vous) - avant de re-basculer dans l’opposition - ne seraient-ils sensibles qu’à la démagogie et au mensonge ?"
                            },
                            {
                                "example_id": "cfb7a58a-5b6e-46a0-9da7-8ecfc9e34da6",
                                "sense_id": "980e8fa1-ca52-394c-b2be-86e866615a80",
                                "text": "Qu’il vienne à lui manquer, elle va re-basculer dans cet autre côté nocturne dont elle est issue ;"
                            }
                        ]
                    }
