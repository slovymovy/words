                "senses": [
                    {
                        "sense_id": "cfa930ff-c314-36fb-932d-b3fef0ed6bc3",
                        "entry_id": "aac63ed5-6e66-3cf7-9205-b6c369aa5752",
                        "glosses": [
                            "Logik, die sich mit vorschreibenden oder präskriptiven Äußerungen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8f26230-2f87-46bf-98a7-4459caa203a0",
                                "sense_id": "cfa930ff-c314-36fb-932d-b3fef0ed6bc3",
                                "text": "„Seit den Dreißiger-Jahren beschäftigt sich die deontische Logik mit dem Gegenstand der Direktiv-Handlung. Die Arbeiten aus dem Bereich der Imperativlogik untersuchen den Imperativ als gedankliche Operation; im Mittelpunkt steht dabei der wahrheitswertfunktionale Aspekt.“"
                            },
                            {
                                "example_id": "127b574a-d612-4f53-af95-167182493896",
                                "sense_id": "cfa930ff-c314-36fb-932d-b3fef0ed6bc3",
                                "text": "„Gibt hier Menger eine Antwort? Eine Optativ- oder Imperativlogik auf einer Modallogik (logic ofthe doubtful) aufzubauen und einige Ergebnisse der Ökonomie zu berücksichtigen. Für seine Imperativlogik, die eine Befehlslogik ist, interpretiert Menger „p ist befohlen“ als „wenn nicht p, so wird etwas Unangenehmes geschehen“ (z.B. Strafe).“"
                            },
                            {
                                "example_id": "d5ef7148-1a1b-4825-ad8a-f96b398652e8",
                                "sense_id": "cfa930ff-c314-36fb-932d-b3fef0ed6bc3",
                                "text": "„Hier heißt es unter anderem: »Es ist wichtig zu erkennen, daß die modale Imperativlogik von der Logik einfacher Imperative so verschieden ist wie die modale Indikativlogik von der Logik einfacher Indikative.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
