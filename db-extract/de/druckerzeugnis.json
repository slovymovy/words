                ],
                "senses": [
                    {
                        "sense_id": "d4d8f489-d2de-30ee-a699-9d994c7d8a88",
                        "entry_id": "b32f5212-14c8-353d-a2cc-0a86ca4401e3",
                        "glosses": [
                            "in größerer Auflage hergestelltes, auf Papier oder ähnlichem Material (Plastikfolie, bei Euro-Geldscheinen Baumwolle) gedrucktes Produkt (Zeitungen, Zeitschriften, Bücher, Broschüren, Prospekte, Banknoten und Ähnliches)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b38238e0-e06a-4e03-a241-f87fd5738bf7",
                                "sense_id": "d4d8f489-d2de-30ee-a699-9d994c7d8a88",
                                "text": "Druckerzeugnisse unterliegen – zur Förderung der Presse- und Meinungsfreiheit – dem ermäßigten Mehrwertsteuersatz; dies kommt auch der Werbung zugute."
                            },
                            {
                                "example_id": "97e167ff-d7f1-4704-90aa-b92771528613",
                                "sense_id": "d4d8f489-d2de-30ee-a699-9d994c7d8a88",
                                "text": "„Ja, es erweist sich, daß gerade die Reformatoren, die Weltumstürzler, die geborenen Führernaturen, gerade jene, die erst mal alle zeitgenössischen Druckerzeugnisse zensieren, verbieten, verbrennen lassen, von Lektüre durch und durch vergiftet sind, daß sie sich an vulgärstem Fusel eines Drako, Jean Bodin, Hobbes usw. ihren Fanatismus angelesen haben und im Katzenjammer ihre mörderischen Beglückungstaten verüben.“"
                            },
                            {
                                "example_id": "7ef3751c-72ce-4312-abaa-67c5f60921a3",
                                "sense_id": "d4d8f489-d2de-30ee-a699-9d994c7d8a88",
                                "text": "„Alle zwei Jahre findet die Mainzer Minipressen-Messe statt, zu der einige hundert Kleinverlage, Handpressen und Künstlerbuch-Verlage aus aller Welt ihre neuesten Druckerzeugnisse vorstellen.“"
                            },
                            {
                                "example_id": "b8e44c41-35bc-4c64-a49f-7875da541c57",
                                "sense_id": "d4d8f489-d2de-30ee-a699-9d994c7d8a88",
                                "text": "„Die Anfang Mai 1485 fertiggestellte Bibelausgabe gehört zu den ersten bedeutenden Druckerzeugnissen aus Grüningers noch junger Werkstatt.“"
                            },
                            {
                                "example_id": "558e8592-57b6-4303-bae5-0fa4b9ca8395",
                                "sense_id": "d4d8f489-d2de-30ee-a699-9d994c7d8a88",
                                "text": "„Damit vergrößerte sich der Absatzmarkt für Druckerzeugnisse in jiddischer Sprache beträchtlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
