                                "target_senses": [
                                    {
                                        "sense_id": "eae48868-59aa-3ddd-ac40-9c7eec20c3dd",
                                        "entry_id": "ca23dd62-ced9-35c5-92ac-c1a8f4d44eef",
                                        "glosses": [
                                            "vorrangiger, wichtigster Gedanke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9297d11-ea50-42ae-841b-d7bd685b3277",
                                                "sense_id": "eae48868-59aa-3ddd-ac40-9c7eec20c3dd",
                                                "text": "„All dies erfasste ich wohl mit einem Blick, doch mein Hauptgedanke war, mein Leben zu retten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8dbf5e2-4ecc-4dc9-8142-d6e01177cf03",
