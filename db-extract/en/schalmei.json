                        "glosses": [
                            "A shawm or chalumeau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b35f4c2-9cd8-4d2d-88af-a6156e89de43",
                                "sense_id": "6800d410-500a-321d-825e-8e722e867079",
                                "text": "Viols, bassoons, schalmeis (ancestors of the clarinet), horns, trumpets, kettle-drums, and other instruments afterward used in the orchestra were known in the thirteenth, fourteenth, and fifteenth centuries, but there were no organizations of them."
                            },
                            {
                                "example_id": "80bdd2d4-441a-4893-90e8-c364ba633e5a",
                                "sense_id": "6800d410-500a-321d-825e-8e722e867079",
                                "text": "In 1689 it was ordered in Chemnitz that schalmeis were to be played only by town musicians."
                            },
                            {
                                "example_id": "4f12e1cc-e1cb-4187-89a5-872a4596e740",
                                "sense_id": "6800d410-500a-321d-825e-8e722e867079",
                                "text": "This instrument, also called the pommer, is a forerunner of the oboe. it has a narrow, conical bore and a double reed that is held between the lips of the player, as in older schalmeis that had no wind-cap."
                            }
                        ]
                    }
