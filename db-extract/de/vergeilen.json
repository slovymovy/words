                "senses": [
                    {
                        "sense_id": "0520b3cf-2a58-3e64-bc97-607e1bd72ed5",
                        "entry_id": "a974a634-2b00-32fb-9fd4-02b3deb03fe4",
                        "glosses": [
                            "(als Pflanze) wegen zu wenig Licht verkümmern (und zunächst lange, schwache, helle Triebe bilden)"
                        ],
                        "tags": [
                            "auxiliary verb"
                        ],
                        "examples": [
                            {
                                "example_id": "ac45254d-6c97-4e7b-8293-a8877d07ab5a",
                                "sense_id": "0520b3cf-2a58-3e64-bc97-607e1bd72ed5",
                                "text": "„Beginnen die Jungpflanzen zu vergeilen, so ist dies ein sicheres Zeichen dafür, daß die Temperatur zu hoch und die Belichtung zu gering ist.“"
                            },
                            {
                                "example_id": "74743594-374c-45aa-af04-d3c00f50bba3",
                                "sense_id": "0520b3cf-2a58-3e64-bc97-607e1bd72ed5",
                                "text": "„Noch heute sagen gewisse Gärtner von Geranien, die während der Überwinterung lange, hellgrüne Triebe bekommen haben, daß sie geil oder vergeilt seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
