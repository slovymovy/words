                    {
                        "sense_id": "efd072f3-4737-3e46-bc0a-8054359906d8",
                        "entry_id": "19f170c6-6769-370e-8c2d-e41ac6728de6",
                        "glosses": [
                            "imię żeńskie, poufała forma imienia Magdalena"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b95a2a89-b3c5-4625-a9ec-5c1aa06b9d8e",
                                "sense_id": "efd072f3-4737-3e46-bc0a-8054359906d8",
                                "text": "Ojcem chrzestnym Magdalenki jest mój brat."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "81fd204e-0e45-3e58-9dba-7825cd3a18ea",
                        "entry_id": "19f170c6-6769-370e-8c2d-e41ac6728de6",
                        "glosses": [
                            "toponim, nazwa szeregu wsi lub ich części w Polsce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33351bc0-0119-4c5f-abb0-29e251237fc9",
                                "sense_id": "81fd204e-0e45-3e58-9dba-7825cd3a18ea",
                                "text": "W latach 70. XX wieku Magdalenka była prestiżowym miejscem, w którym swe dacze budowali przedstawiciele najwyższych władz PRL"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5105f08f-619a-39ad-b35d-910297573f52",
                        "entry_id": "19f170c6-6769-370e-8c2d-e41ac6728de6",
                        "glosses": [
                            "wieś na Litwie, w rejonie solecznickim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e85244b0-4a1f-460d-9147-ca0c3829fbba",
                                "sense_id": "5105f08f-619a-39ad-b35d-910297573f52",
                                "text": "Przed II wojną światową Magdalenka leżała w województwie wileńskim Rzeczypospolitej."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
