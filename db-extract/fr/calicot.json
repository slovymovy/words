                                                "sense_id": "1bdca442-f95b-3ee4-ab3d-582020bc2b19",
                                                "text": "The calico cat had distinctive red and dark markings."
                                            },
                                            {
                                                "example_id": "383d968b-d597-4140-831d-8f3f680dca77",
                                                "sense_id": "1bdca442-f95b-3ee4-ab3d-582020bc2b19",
                                                "text": "The calico-patterned tablecloths were supposed to make the restaurant look rustic; instead, they made it look run down."
                                            },
                                            {
                                                "example_id": "c000dff1-01d0-45c4-b57e-737a6d1f3445",
                                                "sense_id": "1bdca442-f95b-3ee4-ab3d-582020bc2b19",
                                                "text": "Sara, oh Sara / Scorpio Sphinx in a calico dress"
                                            }
                                        ]
                                    },
