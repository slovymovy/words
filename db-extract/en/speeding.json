                    {
                        "sense_id": "2af326c7-2ae4-3512-b288-aaa4012f7b65",
                        "entry_id": "e43fb63c-3d10-3e2b-922d-c92b32837b9c",
                        "glosses": [
                            "Driving faster than the legal speed limit."
                        ],
