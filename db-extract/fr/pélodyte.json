                        "sense_id": "9721e168-efba-33b0-8252-af77725eea9b",
                        "entry_id": "94e39b7c-88bf-347b-b917-e757e53930b7",
                        "glosses": [
                            "Batracien anoure creusant des galeries dans le sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1017c4d-099d-4783-9279-45c4400837c0",
                                "sense_id": "9721e168-efba-33b0-8252-af77725eea9b",
                                "text": "Enfin le pélodyte ponctué a les yeux très saillants et le ventre blanc, il peut changer rapidement de couleur allant du brun au vert."
                            },
                            {
                                "example_id": "e9524b0d-3798-4436-ac34-da6670eae7ff",
                                "sense_id": "9721e168-efba-33b0-8252-af77725eea9b",
                                "text": "Le pélodyte ponctué, petite grenouille grêle, gris clair piquetée de noir."
                            },
                            {
                                "example_id": "e0da2caa-6408-44dc-883f-11a11f49dfab",
                                "sense_id": "9721e168-efba-33b0-8252-af77725eea9b",
                                "text": "Le genre pélodyte est caractérisé par les doigts non dilatés en disques adhésifs."
                            }
                        ]
                    }
                ],
