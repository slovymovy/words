                "entry_id": "5e4054da-5ec0-3feb-af90-da96d283500d",
                "word": "aanlappen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2f9ece49-28fb-301a-9a24-2188cf2f0a70",
                        "entry_id": "5e4054da-5ec0-3feb-af90-da96d283500d",
                        "glosses": [
                            "zaken met elkaar verbinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e24935b-dc5f-4500-b4a8-9443300195bf",
                                "sense_id": "2f9ece49-28fb-301a-9a24-2188cf2f0a70",
                                "text": "Draden aanlappen, weefbreuk herstellen, steeds sneller versnellen,\nherstel de draad, de draad mag niet breken, machine mag niet stilstaan,\nanders geen loon, anders ontslag, voor jou tien anderen, dus werk en lach\nen werk en werk en werk."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc3317f3-4bd6-39a3-90d3-4165a4221975",
                        "entry_id": "5e4054da-5ec0-3feb-af90-da96d283500d",
                        "glosses": [
                            "verkopen van aandelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dc65639-6cea-4784-aa77-721c96554a30",
                                "sense_id": "fc3317f3-4bd6-39a3-90d3-4165a4221975",
                                "text": "“Op deze noodkoers ga je toch geen stukken aanlappen?”, zeiden we."
                            }
                        ]
                    }
                ],
