                                                "example_id": "e14136f5-06c3-4c24-8745-744a4d4c1395",
                                                "sense_id": "51d82e80-058d-3a7d-80bd-df8af154d0a5",
                                                "text": "to rove in quest of game, of a lost child, of property, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "034dc27c-726c-3771-a9fc-283c3957dd0f",
                                        "entry_id": "f4b826bf-105a-374c-a85e-68f97d35e629",
                                        "glosses": [
                                            "A request; a desire; a solicitation."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05010086-1300-4cbf-ba05-1ef9ae59e632",
                                                "sense_id": "034dc27c-726c-3771-a9fc-283c3957dd0f",
                                                "text": "Gad not abroad at every quest and call / Of an untrained hope or passion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fee721b-341c-3d82-ba4b-daf25c6b1723",
                                        "entry_id": "f4b826bf-105a-374c-a85e-68f97d35e629",
                                        "glosses": [
                                            "A group of people conducting a search or inquiry."
                                        ],
