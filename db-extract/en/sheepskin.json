                    {
                        "sense_id": "b8e9dd47-5e6c-36ee-865f-d87297e3dfad",
                        "entry_id": "3cbe8e5a-a408-36b9-9007-4e9ec4cc20a7",
                        "glosses": [
                            "The skin of a sheep, especially an adult sheep, and especially when used to make parchment or in bookbinding."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c4c30606-d71e-43cc-b267-ceb86bbb0b10",
                                "sense_id": "b8e9dd47-5e6c-36ee-865f-d87297e3dfad",
                                "text": "Near-synonym: lambskin"
                            },
                            {
                                "example_id": "3ce8d122-be8e-4154-9f32-0ea43c692120",
                                "sense_id": "b8e9dd47-5e6c-36ee-865f-d87297e3dfad",
                                "text": "I confess to having felt a prejudice against sleeping in a bag, more especially a sheepskin bag, which would probably have a muttony odor; but it was pronounced to be the warmest and least cumbersome form of bedding we could have […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "fa901b88-bd33-3e9e-866a-62a6c0780707",
                        "entry_id": "3cbe8e5a-a408-36b9-9007-4e9ec4cc20a7",
                        "glosses": [
                            "The skin of a sheep, especially an adult sheep, and especially when used to make parchment or in bookbinding.",
                            "The tanned skin of a sheep with the fleece left on, especially when used for clothing, rugs, etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a10b1115-191d-3eee-8e1d-0568832878c4",
                        "entry_id": "3cbe8e5a-a408-36b9-9007-4e9ec4cc20a7",
                        "glosses": [
                            "A diploma, especially the one representing a university or college degree."
                        ],
                        "tags": [
                            "US",
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "818f84fb-612d-41e6-bc02-e1cc98e4a9a0",
                                "sense_id": "a10b1115-191d-3eee-8e1d-0568832878c4",
                                "text": "[…] he took his sheepskin with a bow and a gesture that extinguished several of his companions;"
                            }
                        ]
