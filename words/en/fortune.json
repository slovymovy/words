                            {
                                "target_lang_word": "sich ereignen",
                                "target_lang_sense_clarification": "passieren"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碰巧",
                                "target_lang_sense_clarification": "偶然发生"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "suceder",
                                "target_lang_sense_clarification": "ocurrir por azar"
                            },
                            {
                                "target_lang_word": "dar la casualidad",
                                "target_lang_sense_clarification": "expresión para indicar que algo ocurre por azar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bb57d5b7-1e3f-3ef0-af34-bcb847707549",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Fortune</w> was known in the town for his generous charitable donations.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Форчун</w> был известен в городе своими щедрыми благотворительными пожертвованиями.",
                                "de": "Herr <w>Fortune</w> war in der Stadt für seine großzügigen Spenden bekannt.",
                                "zh": "<w>福琼</w>先生因其慷慨的慈善捐赠而在镇上很有名。",
                                "es": "El Sr. <w>Fortune</w> era conocido en el pueblo por sus generosas donaciones benéficas."
                            }
                        },
                        {
                            "text": "We invited the <w>Fortune</w> family to the gathering next weekend.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили семью <w>Форчун</w> на встречу в следующие выходные.",
                                "de": "Wir haben die Familie <w>Fortune</w> zum Treffen am nächsten Wochenende eingeladen.",
                                "zh": "我们邀请了<w>福琼</w>一家参加下周末的聚会。",
                                "es": "Invitamos a la familia <w>Fortune</w> a la reunión del próximo fin de semana."
                            }
                        }
                    ],
                    "target_lang_definitions": {
