{
    "word_family": [
        "shuffle",
        "shuffler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3ef5c434-805e-3cdd-bea1-8e9aadc0b3a3",
                    "sense_definition": "Moving with a dragging or scraping step",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man walked with a <w>shuffling</w> gait across the room.",
                            "target_lang_translations": {
                                "cs": "Starý muž přešel místnost <w>šouravým</w> krokem."
                            }
                        },
                        {
                            "text": "He heard the <w>shuffling</w> footsteps of someone approaching the door.",
                            "target_lang_translations": {
                                "cs": "Slyšel <w>šouravé</w> kroky někoho, kdo se blížil ke dveřím."
                            }
                        }
                    ],
                    "synonyms": [
                        "dragging"
                    ],
                    "common_phrases": [
                        "shuffling gait",
                        "shuffling walk"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohybující se šouravým nebo třoucím krokem"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šouravý",
                                "target_lang_sense_clarification": "popisující chůzi nebo krok"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72dc7b95-6990-3481-a3ea-2841df1f760a",
                    "sense_definition": "Trying to avoid giving a direct answer or being honest",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician gave a <w>shuffling</w> response to the difficult question.",
                            "target_lang_translations": {
                                "cs": "Politik dal na obtížnou otázku <w>vyhýbavou</w> odpověď."
                            }
                        },
                        {
                            "text": "I am tired of your <w>shuffling</w> excuses for being late.",
                            "target_lang_translations": {
                                "cs": "Už mě unavují tvé <w>vyhýbavé</w> výmluvy na pozdní příchod."
                            }
                        }
                    ],
                    "synonyms": [
                        "evasive",
                        "equivocal"
                    ],
                    "antonyms": [
                        "direct",
                        "honest"
                    ],
                    "target_lang_definitions": {
                        "cs": "Snaha vyhnout se přímé odpovědi nebo upřímnosti"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vyhýbavý",
                                "target_lang_sense_clarification": "v kontextu chování nebo odpovědí"
                            },
                            {
                                "target_lang_word": "kličkující",
                                "target_lang_sense_clarification": "přeneseně, neupřímný"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "070b3122-4b42-3831-bdc6-0a74c7d12791",
                    "sense_definition": "The act or motion of moving with dragging steps",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>shuffling</w> of feet in the hallway signaled the end of the meeting.",
                            "target_lang_translations": {
                                "cs": "<w>Šourání</w> nohou na chodbě signalizovalo konec schůzky."
                            }
                        },
                        {
                            "text": "I could hear the slow <w>shuffling</w> of the crowd as they moved toward the exit.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem pomalé <w>šourání</w> davu, jak se přesouval k východu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt nebo pohyb spočívající v chůzi šouravými kroky"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šourání",
                                "target_lang_sense_clarification": "pohyb nohou po zemi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab048d0b-3098-3a86-846a-7735b7e7cd23",
                    "sense_definition": "The noise created by someone or something moving about",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>shuffling</w> behind the curtain made me nervous.",
                            "target_lang_translations": {
                                "cs": "<w>Šustění</w> za závěsem mě znervózňovalo."
                            }
                        },
                        {
                            "text": "He was distracted by the constant <w>shuffling</w> of papers on the desk.",
                            "target_lang_translations": {
                                "cs": "Rozptylovalo ho neustálé <w>šustění</w> papírů na stole."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hluk vytvořený někým nebo něčím, co se pohybuje"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šustění",
                                "target_lang_sense_clarification": "zvuk při pohybu papírů nebo věcí"
                            },
                            {
                                "target_lang_word": "šourání",
                                "target_lang_sense_clarification": "zvuk při pohybu nohou po podlaze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf7b3f1c-e617-386f-b421-278ff82ccf26",
                    "sense_definition": "The use of dishonest or tricky methods to achieve a goal",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was caught in a series of financial <w>shufflings</w> to hide their debt.",
                            "target_lang_translations": {
                                "cs": "Společnost byla přistižena při sérii finančních <w>machinací</w>, kterými chtěla skrýt svůj dluh."
                            }
                        },
                        {
                            "text": "After all the political <w>shufflings</w>, the truth finally came to light.",
                            "target_lang_translations": {
                                "cs": "Po všech těch politických <w>machinacích</w> konečně vyšla pravda najevo."
                            }
                        }
                    ],
                    "synonyms": [
                        "trickery",
                        "deceit"
                    ],
                    "target_lang_definitions": {
                        "cs": "Použití nečestných nebo lstivých metod k dosažení cíle"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "machinace",
                                "target_lang_sense_clarification": "nečestné jednání"
                            },
                            {
                                "target_lang_word": "kličkování",
                                "target_lang_sense_clarification": "přeneseně, nečestné jednání"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a717a20b-f9e0-3638-acde-a6de51dbf1e9",
                    "sense_definition": "Present participle and gerund of <w>shuffle</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>shuffling</w> the cards before dealing them to the players.",
                            "target_lang_translations": {
                                "cs": "Před rozdáním hráčům právě <w>míchá</w> karty."
                            }
                        },
                        {
                            "text": "Stop <w>shuffling</w> your feet and stand still.",
                            "target_lang_translations": {
                                "cs": "Přestaň <w>šoupat</w> nohama a stůj v klidu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shuffling cards",
                        "shuffling feet"
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa shuffle"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "míchající",
                                "target_lang_sense_clarification": "v kontextu karet"
                            },
                            {
                                "target_lang_word": "šoupající",
                                "target_lang_sense_clarification": "v kontextu pohybu nohou"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}