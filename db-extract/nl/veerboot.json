                                    {
                                        "sense_id": "b19334e6-e7a1-3854-9678-3c0e7e71f818",
                                        "entry_id": "d02f1528-2912-364a-83b1-284c9285b597",
                                        "glosses": [
                                            "Schiff, das genutzt wird, um Personen, Tiere und/oder Gegenstände von einem Ufer zum anderen/ von einer Küste zur anderen zu transportieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f152c1f-9493-47bd-beda-971ab7c062a5",
                                                "sense_id": "b19334e6-e7a1-3854-9678-3c0e7e71f818",
                                                "text": "Auf der Ostsee verkehren große Fährschiffe."
                                            },
                                            {
                                                "example_id": "8c31483e-3cbc-40bc-97bf-f684b5d66ca7",
                                                "sense_id": "b19334e6-e7a1-3854-9678-3c0e7e71f818",
                                                "text": "„Auf dem Fährschiff löste sich der alte Grams von Roman und lehnte sich am Bug gegen die Reling.“"
                                            }
                                        ],
