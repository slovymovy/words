                    },
                    {
                        "translation_id": "59e90421-8311-4087-be58-2183bf548f07",
                        "source_entry_id": "19d424ce-f445-3533-a7b8-3f71ea823fc3",
                        "source_sense_id": "50df2397-f55a-3014-b6e1-1710339c2ff5",
                        "target_lang_word": "ceremoniously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceremoniously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48307133-ac91-3319-a299-ca8f0942c74a",
                                        "entry_id": "fea8ea0d-6712-3884-b370-72453dcf9790",
                                        "glosses": [
                                            "In a ceremonious manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c16d9f4-c152-45a5-818e-68441b0b349d",
                                                "sense_id": "48307133-ac91-3319-a299-ca8f0942c74a",
                                                "text": "After a simply marvelous, entertaining two and a half hour meal, they reclaimed their shoes and ceremoniously bid their sayonaras to the Japanese girls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d1ec353-159e-44bc-941d-898cb3e2eff5",
                        "source_entry_id": "19d424ce-f445-3533-a7b8-3f71ea823fc3",
                        "source_sense_id": "50df2397-f55a-3014-b6e1-1710339c2ff5",
                        "target_lang_word": "festively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "festively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a31a28e-b789-34b5-97e2-0cfd6e31761d",
                                        "entry_id": "dd17dfcf-6aa8-3479-9fd4-0a8c0ddee0ad",
                                        "glosses": [
                                            "In a festive manner"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00377eea-ddfb-457a-ad8c-7cebb73e4b53",
                        "source_entry_id": "19d424ce-f445-3533-a7b8-3f71ea823fc3",
                        "source_sense_id": "50df2397-f55a-3014-b6e1-1710339c2ff5",
                        "target_lang_word": "grandly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grandly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84035f88-0c7b-315f-87c9-ff6115b8de6e",
                                        "entry_id": "e04e5094-19c2-3b8b-b24f-8ef5e44ca306",
                                        "glosses": [
                                            "In a grand manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee1301e5-caf5-4855-bbca-57a2be4dc7bc",
                                                "sense_id": "84035f88-0c7b-315f-87c9-ff6115b8de6e",
                                                "text": "This slight way of treating both his book and his ancestors nettled little Puddock – who never himself took a liberty, and expected similar treatment – but he knew Sturk, the nature of the beast, and he only bowed grandly […]"
                                            },
                                            {
                                                "example_id": "4c3545a6-2c26-4e90-a846-79964d536fe9",
                                                "sense_id": "84035f88-0c7b-315f-87c9-ff6115b8de6e",
                                                "text": "“Take the Concorde. Spend a lot of money. Get yourself there in the most expensive way possible, take pictures over ten times if you need to. Do it all grandly!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4dedd75-91fa-3dd0-9a4c-122011097d39",
                                        "entry_id": "e04e5094-19c2-3b8b-b24f-8ef5e44ca306",
                                        "glosses": [
                                            "To the greatest extent."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24617f84-45de-45d5-ad07-97c04389eb25",
                                                "sense_id": "e4dedd75-91fa-3dd0-9a4c-122011097d39",
                                                "text": "But whether or not Sumner was the most typical man of his native commonwealth, he certainly does take a representative place on the bede-roll of her great sons. And on a wider field he does especially and grandly represent the Puritan spirit and the Pilgrim idea, and so the peculiar ethical and political idea of our whole nation."
                                            },
                                            {
                                                "example_id": "02aedff8-533f-4444-8d82-3c6b8197a957",
                                                "sense_id": "e4dedd75-91fa-3dd0-9a4c-122011097d39",
                                                "text": "The world had appreciated what he had done, and had put much to his credit, and he was prepared to draw upon this grandly."
                                            },
                                            {
                                                "example_id": "a0809b4b-482d-4538-86c1-4fd9a1df38ef",
                                                "sense_id": "e4dedd75-91fa-3dd0-9a4c-122011097d39",
                                                "text": "Thus happily unfolding his plans, his work enlarged grandly. He was living in high hopes of spending uninterruptedly the greater part of his life in China."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "955b7fbc-8f76-482f-bb5c-50dff478dfe0",
                        "source_entry_id": "19d424ce-f445-3533-a7b8-3f71ea823fc3",
                        "source_sense_id": "50df2397-f55a-3014-b6e1-1710339c2ff5",
                        "target_lang_word": "portentously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portentously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a97a23e-0fdd-3a09-a6de-4cfe42a40e2b",
                                        "entry_id": "51d638c7-1b5d-3755-bb6f-71dbe4745064",
                                        "glosses": [
                                            "In an ominous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d21daee-4f97-49ae-b50b-377876d1634b",
                                                "sense_id": "7a97a23e-0fdd-3a09-a6de-4cfe42a40e2b",
                                                "text": "The cold light of the moon touched every face with unnatural paleness; and the silence was unbroken and portentously profound."
                                            },
                                            {
                                                "example_id": "000d501a-8c46-4c2a-9355-9e251f8b04ac",
                                                "sense_id": "7a97a23e-0fdd-3a09-a6de-4cfe42a40e2b",
                                                "text": "At that moment a long, scraggy individual in a checked suit poked his head into the bar, looked around portentously, whistled mysteriously to my informant, and jerked his thumb and head in the direction of the door."
                                            },
                                            {
                                                "example_id": "0ae078f7-226b-45b7-a8ed-325b9697beaf",
                                                "sense_id": "7a97a23e-0fdd-3a09-a6de-4cfe42a40e2b",
                                                "text": "Shirky ends the story of the lost Sidekick by asking, portentously, “What happens next?”—no doubt imagining future waves of digital protesters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9640e58-ff78-35a5-ab24-971a4831744b",
                                        "entry_id": "51d638c7-1b5d-3755-bb6f-71dbe4745064",
                                        "glosses": [
                                            "In a pompous manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6914bd2a-9baf-4d23-b08b-9e644f9749c8",
                        "source_entry_id": "19d424ce-f445-3533-a7b8-3f71ea823fc3",
                        "source_sense_id": "50df2397-f55a-3014-b6e1-1710339c2ff5",
                        "target_lang_word": "solennellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solennellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                                        "entry_id": "8df7f39c-d15e-33ff-be24-63199ae4da6b",
                                        "glosses": [
                                            "D’une manière solennelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eb1820d-ddbd-4303-b715-f1b0f4cb1e05",
                                                "sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                                                "text": "Le lendemain, Leurs Majestés font prier Dieu solennellement pour tous les rois et reines qui sont là [à l’Escurial], […]"
                                            },
                                            {
                                                "example_id": "cc1fe02d-c64a-48aa-a55d-3b0250bbff20",
                                                "sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                                                "text": "Richelieu, ayant fait déclarer solennellement la guerre à toute la maison d’Autriche, […]"
                                            },
                                            {
                                                "example_id": "782d57b7-006b-4ce8-9079-5731cd045d63",
                                                "sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                                                "text": "Des circonstances dont il [le P. Bouhier] ne fut pas le maître, ne lui permirent pas d’exécuter la promesse qu’il avait donnée solennellement, […]"
                                            },
                                            {
                                                "example_id": "52454c78-edb7-4280-a819-3e5dc04a23e6",
                                                "sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                                                "text": "Amen ! répondirent les précepteurs placés autour du grand maître, et le mot fut répété solennellement par toute l’assistance."
                                            },
                                            {
                                                "example_id": "71bc2d8d-a0fb-497d-9b15-03072e1e0981",
                                                "sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                                                "text": "La difficulté, la longueur des voyages d’autrefois donnaient quelque chose de solennellement triste aux séparations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0acfe604-e5c6-48dc-a6fe-cad90fa5a8fd",
                        "source_entry_id": "19d424ce-f445-3533-a7b8-3f71ea823fc3",
