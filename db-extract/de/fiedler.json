                "senses": [
                    {
                        "sense_id": "78b38943-a345-3e41-bf93-e66c965ac001",
                        "entry_id": "c159d724-6b2f-3b9d-a6e8-cfad1e9de10d",
                        "glosses": [
                            "Person, die eine Fiedel spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa6736bf-f70e-4751-b18a-e30fce19c32f",
                                "sense_id": "78b38943-a345-3e41-bf93-e66c965ac001",
                                "text": "Manchmal steigt der Fiedler auf ein Dach, um besser gehört und gesehen zu werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79343cfb-6f1a-4ea5-bb52-c50c50beb492",
                        "source_entry_id": "c159d724-6b2f-3b9d-a6e8-cfad1e9de10d",
                        "source_sense_id": "78b38943-a345-3e41-bf93-e66c965ac001",
                        "source_sense_description": "Person, die eine Fiedel spielt",
                        "target_lang_word": "fiddler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiddler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6f3f46a-d7a8-3bfe-8bb1-a736262bb7a9",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "One who plays the fiddle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "088e3799-82e4-315a-8c26-843eeb342b4c",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "One who fiddles; a cheat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3b6849e-7b62-4099-8f26-e4619a8eca54",
                                                "sense_id": "088e3799-82e4-315a-8c26-843eeb342b4c",
                                                "text": "We were the self-controlled, cautious, nifty merchants, decorous fiddlers of accounts, hoarders of wealth, excellent bribers, family and community creatures governed by manners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f20ba12-99e9-3afd-bcfe-7bec0fce3899",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "One who fiddles or tweaks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f61b1b-f94c-4d06-96c9-dcb45ff5c6ff",
                                                "sense_id": "7f20ba12-99e9-3afd-bcfe-7bec0fce3899",
                                                "text": "The community of radio amateurs—trespassing fiddlers on the cutting edge of technological possibilities—prefigured the geek community that was to inhabit Silicon Valley 50 years later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a97453-d8db-336f-b34e-c168cd038dc6",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "A burrowing crab of the genus Gelasimus, of many species. The male has one claw very much enlarged, and often holds it in a position similar to that in which a musician holds a fiddle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30529351-33fb-3a4b-8854-82ba111ea5ba",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "The common European sandpiper (Actitis hypoleucos); so called because it habitually wags its tail up and down resembling the back and forth movement of a fiddler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a2437c0-6f3a-3e54-89c7-75e82ff5011a",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "A large species of cicada, Macrotristria angularis, of eastern Australia; cherry nose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f15b00a-aa16-333d-83d1-73c84b908306",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "A coin of little value: a sixpence or a farthing."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14cc7210-e78b-328f-b9eb-735e89668cc5",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "The capstan-house on a steamer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5921ef5-7642-48d3-b970-bb4e57f1d057",
                                                "sense_id": "14cc7210-e78b-328f-b9eb-735e89668cc5",
                                                "text": "Whereupon you shake hands with him […] and make room for him by your side in the \"Fiddler,\" when the pleasant time of night is come, and the stewardess is tucking up the ladies, and putting oranges and other goodies under their pillows, and the menfolk assemble in the capstan house to smoke their last cigar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f69d62c5-2ce2-46aa-842a-ff1ed8d11e2d",
                        "source_entry_id": "c159d724-6b2f-3b9d-a6e8-cfad1e9de10d",
                        "source_sense_id": "78b38943-a345-3e41-bf93-e66c965ac001",
                        "source_sense_description": "Person, die eine Fiedel spielt",
                        "target_lang_word": "ménétrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ménétrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e47af73a-f438-3729-9f81-21de62b179f3",
                                        "entry_id": "317d0892-62ad-30d1-acd4-2cdeae4fa9cc",
                                        "glosses": [
                                            "Violoniste de village qui escorte notamment les noces et fait danser les invités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d0e0f0e-d333-4fd0-a6ae-d8e9292cd8cd",
                                                "sense_id": "e47af73a-f438-3729-9f81-21de62b179f3",
                                                "text": "[…] ; il s’arrêta, pour passer la nuit, à une petite hôtellerie écartée de la route ordinaire, et, là, il obtint d’un ménétrier vagabond des nouvelles sur le résultat du tournoi."
                                            },
                                            {
                                                "example_id": "2fb1245c-f1a8-49bf-b715-5fbcd06bb906",
                                                "sense_id": "e47af73a-f438-3729-9f81-21de62b179f3",
                                                "text": "Cambrinus fut bientôt en état de faire danser les jeunes filles sur le pré. Il était dix fois plus habile que les autres ménétriers ; mais, hélas ! nul n’est prophète en son pays."
                                            },
                                            {
                                                "example_id": "fae02106-0959-4178-b22e-9c429edd82b9",
                                                "sense_id": "e47af73a-f438-3729-9f81-21de62b179f3",
                                                "text": "Les autres gens de la noce causaient de leurs affaires ou se faisaient des niches dans le dos, s’excitant d’avance à la gaieté ; et, en y prêtant l’oreille, on entendait toujours le crin-crin du ménétrier qui continuait à jouer dans la campagne."
                                            },
                                            {
                                                "example_id": "d2578f9e-0ab4-4a73-984a-36c33dbdd404",
                                                "sense_id": "e47af73a-f438-3729-9f81-21de62b179f3",
                                                "text": "Les sources … offrent un témoignage de la place occupée par le chant dans les armées des XIVᵉ et XVᵉ siècles. En effet, les montres d'armes et la comptabilité mentionnent la présence de ménétriers dans les compagnies de gens de guerre."
                                            },
                                            {
                                                "example_id": "3ef77ed9-ee9f-4958-a412-42527192becb",
                                                "sense_id": "e47af73a-f438-3729-9f81-21de62b179f3",
                                                "text": "Pour lui donner plus de solennité, il s’était adjoint les services d’un ménétrier employé jusqu’ici, comme tout le monde, à charrier des pierres mais qui avait le don de jouer à merveille de la saquebute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de34cede-0aab-3037-ada5-42e486df7b91",
                                        "entry_id": "317d0892-62ad-30d1-acd4-2cdeae4fa9cc",
                                        "glosses": [
                                            "Poète qui récite des vers en s’accompagnant d’un instrument de musique."
                                        ],
                                        "tags": [
                                            "Middle-Ages"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
