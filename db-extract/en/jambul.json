                                "target_senses": [
                                    {
                                        "sense_id": "fd7cb1d1-a8d9-3283-b62e-f1be5ead1373",
                                        "entry_id": "4853db8b-4e4d-3f31-8f7a-6daac0710517",
                                        "glosses": [
                                            "Arbre tropical de taille moyenne, à feuilles persistantes, originaire du sud de l’Asie, cultivé dans les tropiques pour sa valeur ornementale, son bois et son fruit comestible, parfois appelé prune de Java."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c00c89a-00c3-45e0-aaac-9588a0f531bb",
                                                "sense_id": "fd7cb1d1-a8d9-3283-b62e-f1be5ead1373",
                                                "text": "Le jamblon donne des petits fruits globuleux ou oblongs, de couleur rouge noirâtre, à saveur astringente ou douce sucrée, suivant l’état de maturité."
                                            },
                                            {
                                                "example_id": "bdebba91-8b95-45eb-b80a-72fcbca34e60",
                                                "sense_id": "fd7cb1d1-a8d9-3283-b62e-f1be5ead1373",
                                                "text": "Sur le trottoir, devant l’école primaire, tous les après-midi, un groupe de six à huit femmes installait un stand de petites tables bancales. […]. Elles vendaient, assaisonnés de piment, des jamblons, petits fruits dont la peau foncée et luisante, quand on la croque, fait une langue toute pourpre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
