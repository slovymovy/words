                    "frequency": "Low",
                    "semantic_group_id": "legal_document",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The software is distributed under the terms of the <w>CPL</w>.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение распространяется на условиях <w>общей публичной лицензии</w>."
                            }
