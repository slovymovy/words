    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f2b07cfc-668b-34c0-b5c2-2cc2033be443",
                "word": "gaffle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "657a2d32-71e8-4cd5-8265-78dd7efa5224",
                        "entry_id": "f2b07cfc-668b-34c0-b5c2-2cc2033be443",
                        "tags": [
                            "plural"
                        ],
                        "form": "gaffles"
