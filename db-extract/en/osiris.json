                                        "sense_id": "191160d1-54eb-377b-bd7d-367e62f9e8dd",
                                        "entry_id": "6b45ff91-a5d0-3bdf-9131-7c62db0fa449",
                                        "glosses": [
                                            "ägyptischer Gott des Jenseits, der Wiedergeburt und des Nils"
                                        ],
                                        "tags": [
                                            "antike ägyptische Mythologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1340e34e-a92b-4052-b180-3298d12aa366",
                                                "sense_id": "191160d1-54eb-377b-bd7d-367e62f9e8dd",
                                                "text": "Im Glauben der alten Ägypter mussten sich die Toten vor Osiris verantworten, bevor sie ins Jenseits eintreten durften."
                                            },
                                            {
                                                "example_id": "923ebd94-31bc-4067-9903-6d71d95d0349",
                                                "sense_id": "191160d1-54eb-377b-bd7d-367e62f9e8dd",
                                                "text": "„Ich bin nicht der, der ich zu sein scheine, Carlota sah in mir die Reinkarnation des Anubis, des Gottes der Einbalsamierung, des Einbalsamierers von Osiris, doch ich weiß, daß ich in Wahrheit Osiris bin, der über den Tod triumphiert, da er sich zum Herrscher über die Hölle macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
