            "senses": [
                {
                    "sense_id": "b5e5f0fb-bde2-3bd7-a652-427626ed7bf6",
                    "sense_definition": "A large number of people or things gathered together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_crowd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>horde</w> of fans waited outside the stadium to see their favorite band.",
                            "target_lang_translations": {
                                "fr": "Une <w>horde</w> de fans attendait devant le stade pour voir leur groupe préféré.",
                                "zh": "<w>一大群</w>歌迷在体育场外等待，想见一眼他们最喜欢的乐队。"
                            }
                        },
                        {
                            "text": "The store was overwhelmed by a <w>horde</w> of shoppers during the holiday sale.",
                            "target_lang_translations": {
                                "fr": "Le magasin a été submergé par une <w>horde</w> d'acheteurs pendant les soldes de fin d'année.",
                                "zh": "节假日促销期间，商场被<w>一大群</w>购物者挤得水泄不通。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crowd",
                        "swarm",
                        "multitude",
                        "throng"
                    ],
                    "common_phrases": [
                        "horde of people"
                    ],
                    "target_lang_definitions": {
                        "fr": "Un grand nombre de personnes ou de choses rassemblées.",
                        "zh": "聚集在一起的大群人或物；一大群人"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "horde",
