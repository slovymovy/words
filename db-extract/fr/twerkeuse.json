                        "entry_id": "d79b5c31-2120-39f1-92de-9de1ccc42536",
                        "glosses": [
                            "Danseuse spécialisée dans le twerk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2e1b478-e0de-4a44-8b02-12c0ca637165",
                                "sense_id": "742e78fd-1b69-3919-8c86-16f8dfd4e0a0",
                                "text": "Il faut dire qu’en France ou outre-Atlantique, les lives donnant la part belle aux twerkeuses ont été nombreux durant cette période de confinement."
                            },
                            {
                                "example_id": "199c7b29-5d7b-4e88-9584-8e2ad314520a",
                                "sense_id": "742e78fd-1b69-3919-8c86-16f8dfd4e0a0",
                                "text": "Finalement, ça peut avoir du bon de s’ennuyer. Roxane semble avoir découvert un nouveau talent de twerkeuse dans les derniers jours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7dd02a5-c0c9-4476-9c92-b9187a3ff4d1",
                        "source_entry_id": "d79b5c31-2120-39f1-92de-9de1ccc42536",
                        "source_sense_id": "742e78fd-1b69-3919-8c86-16f8dfd4e0a0",
