                        "glosses": [
                            "Nom donné dans la cuisine japonaise à une algue noire nommée Sargassum fusiforme."
                        ],
                        "tags": [
                            "Gastronomie"
                        ],
                        "examples": [
                            {
                                "example_id": "18f7abbd-e42f-476a-87d7-615a32637642",
                                "sense_id": "a3c1163c-db36-3822-9b17-027848643b60",
                                "text": "Lady Baba a approché son visage tout près du mien. À une telle vitesse qu’instinctivement, j’ai détourné la tête. Ses cils couverts de mascara ressemblaient à des algues hijiki."
                            },
                            {
                                "example_id": "996193dd-8f5f-4547-980e-1da81a63fc71",
                                "sense_id": "a3c1163c-db36-3822-9b17-027848643b60",
                                "text": "Égouttez l’hijiki puis mélangez-le avec le dashi, le sucre, la sauce soja, le saké et le mirin dans une petite casserole, et faites mijoter jusqu’à ce que le liquide soit évaporé."
                            }
                        ]
                    }
