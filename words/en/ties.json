                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He keeps his collection of silk <w>ties</w> organized by color.",
                            "target_lang_translations": {
                                "ru": "Он хранит свою коллекцию шелковых <w>галстуков</w>, рассортированную по цветам.",
                                "tr": "İpek <w>kravat</w> koleksiyonunu renklere göre düzenlenmiş şekilde tutar.",
                                "zh": "他按颜色整理他收藏的丝绸<w>领带</w>。"
                            }
                        },
                        {
                            "text": "The two countries have maintained strong diplomatic <w>ties</w> for decades.",
                            "target_lang_translations": {
                                "ru": "Две страны поддерживали крепкие дипломатические <w>связи</w> на протяжении десятилетий.",
                                "tr": "İki ülke onlarca yıldır güçlü diplomatik <w>bağlar</w> sürdürmektedir.",
                                "zh": "两国几十年来一直保持着紧密的外交<w>联系</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "family ties",
                        "close ties",
                        "wear ties"
