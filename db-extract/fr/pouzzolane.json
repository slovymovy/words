                "senses": [
                    {
                        "sense_id": "270a9aba-7dcb-32c2-9683-ec89b6ad4d26",
                        "entry_id": "65df45b3-482e-369c-905f-043b4b93a87d",
                        "glosses": [
                            "Scories volcaniques, basaltiques, rougeâtres ou noires, qu’on mêle avec de la chaux aérienne pour en faire un mortier qui se durcit dans l’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b4debef-291a-4c7a-9b64-d5c088310b7f",
                                "sense_id": "270a9aba-7dcb-32c2-9683-ec89b6ad4d26",
                                "text": "La pouzzolane tire son nom de la ville de Pouzzoles aux environs de Naples."
                            },
                            {
                                "example_id": "fccc8164-680b-4a4e-b4e5-8c8e9d8c42bc",
                                "sense_id": "270a9aba-7dcb-32c2-9683-ec89b6ad4d26",
                                "text": "Parfois une vipère glissait entre les pierres de ces routes poudreuses, que je regardais aller, grise sur la pouzzolane rouge, avec sa tête plate et la souplesse de son corps tacheté."
                            }
                        ]
                    }
                ],
