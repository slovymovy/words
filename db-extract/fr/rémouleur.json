                "senses": [
                    {
                        "sense_id": "31942af8-2f85-3408-ace0-a9b1afa2e138",
                        "entry_id": "76467a2b-ff2c-3331-a61a-79e56f125731",
                        "glosses": [
                            "Celui qui aiguise les couteaux, les ciseaux, etc., au moyen d’une meule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4811023-047f-460d-ad42-64d7c75ac70f",
                                "sense_id": "31942af8-2f85-3408-ace0-a9b1afa2e138",
                                "text": "La statue, sculptée également dans le marbre, représente un rémouleur occupé à aiguiser un couperet sur une pierre."
                            },
                            {
                                "example_id": "e7f087f9-fb52-48dd-80f7-1ecfa1018834",
                                "sense_id": "31942af8-2f85-3408-ace0-a9b1afa2e138",
                                "text": "Parmi les membres figuraient un rémouleur à brouette, un portier et un dégraisseur, nommé Bistac. C’est au rémouleur que nous eûmes affaire. Il siégeait sans façon, les manches retroussées ; il se montra bonhomme."
                            },
                            {
                                "example_id": "43d4b169-5588-4410-9ef3-4b06f930376f",
                                "sense_id": "31942af8-2f85-3408-ace0-a9b1afa2e138",
                                "text": "Par ailleurs, les hommes de Vidock ont découvert chez les suspects une curieuse meule de rémouleur, creuse à l’intérieur, pouvant servir au transport clandestin de pièces d’or."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3c77567-81ff-3937-8023-11987e76123a",
                        "entry_id": "76467a2b-ff2c-3331-a61a-79e56f125731",
                        "glosses": [
                            "Dans une verrerie, une cristallerie, ouvrier qui taille le verre et le cristal avec une meule."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a284849-35ea-4df9-b059-f03dd8a4e981",
                        "source_entry_id": "76467a2b-ff2c-3331-a61a-79e56f125731",
                        "target_lang_word": "Scherenschleifer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scherenschleifer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a56d0a94-059f-3c20-ad98-eda807daa665",
                                        "entry_id": "97dc6e93-da8d-3d06-8172-c52b2bef00f6",
                                        "glosses": [
                                            "Person, die beruflich mit geeignetem Gerät Scheren und andere Gerätschaften durch Schleifen schärft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75b28a1d-1fc6-44aa-8821-f720b20704ed",
                                                "sense_id": "a56d0a94-059f-3c20-ad98-eda807daa665",
                                                "text": "„Noch niemals hatte Laura Leonore einen Scherenschleifer bei der Arbeit gesehen und war fasziniert.“"
                                            },
                                            {
                                                "example_id": "2e0b6d66-4b40-4954-9c7c-6842fa27f91b",
                                                "sense_id": "a56d0a94-059f-3c20-ad98-eda807daa665",
                                                "text": "„Der Scherenschleifer Rudies traf bei seinen Wanderungen eine Pferdeherde, die nahe Ragnit über den Fluss getrieben wurde.“"
                                            },
                                            {
                                                "example_id": "d5c173fe-f270-4a33-8da9-859bf667b74d",
                                                "sense_id": "a56d0a94-059f-3c20-ad98-eda807daa665",
                                                "text": "„Später am Morgen, als der Gemüsehändler von dem Ausrufen seiner Waren im Hof heiser geworden, der Bürstenbinder sichtlich betrunken, und der Scherenschleifer aus dem Geschlecht des Lumpengesindels mit seinem Schleifstein von Haustür zu Haustür zog, ging ein Mann durch Kopenhagens Straßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
