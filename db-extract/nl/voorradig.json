                                            {
                                                "example_id": "670764a1-2122-44a9-9d3b-ee344a998c3e",
                                                "sense_id": "cfeff6ef-1ba2-3ae0-bde6-9bf237caa990",
                                                "text": "Die kanariengelben Frotteeunterhosen haben wir nicht vorrätig, aber wir können sie bestellen."
                                            },
                                            {
                                                "example_id": "b286fca4-01df-4a5d-a6a3-18d347e3839b",
                                                "sense_id": "cfeff6ef-1ba2-3ae0-bde6-9bf237caa990",
                                                "text": "In Bayern, dem Bundesland mit der höchsten Zahl an bestätigten Fällen von Schweinegrippe, haben etliche Praxen nicht genug Serum vorrätig."
                                            },
                                            {
                                                "example_id": "f0451acb-40aa-428d-9050-7a0779a489f1",
                                                "sense_id": "cfeff6ef-1ba2-3ae0-bde6-9bf237caa990",
                                                "text": "Ein Urteil des Bundesgerichtshofs verdeutlicht, wie wichtig es ist, eindeutig darauf hinzuweisen, wenn ein Nachlass nur auf bestimmte oder vorrätige Artikel gewährt wird."
                                            }
