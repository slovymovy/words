        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9ce7a67-07c6-39d1-b113-4c83c4fbad27",
                    "sense_definition": "To make secret, often dishonest plans.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain <w>schemed</w> to take control of the entire kingdom.",
                            "target_lang_translations": {
                                "ru": "Злодей <w>замышлял</w> захватить контроль над всем королевством.",
                                "zh": "那个反派一直在<w>密谋</w>夺取整个王国的控制权。"
                            }
                        },
                        {
                            "text": "They were <w>scheming</w> against their boss to get him fired.",
                            "target_lang_translations": {
                                "ru": "Они <w>интриговали</w> против своего начальника, чтобы его уволили.",
                                "zh": "他们一直在老板背后<w>算计</w>他，想让他被解雇。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plot",
                        "intrigue",
                        "hatch"
                    ],
                    "common_phrases": [
                        "scheme against",
                        "scheme to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Строить тайные, часто нечестные планы.",
                        "zh": "暗中策划，通常指策划不诚实或有害的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замышлять",
                                "target_lang_sense_clarification": "задумывать недоброе"
                            },
                            {
                                "target_lang_word": "интриговать",
                                "target_lang_sense_clarification": "вести интриги"
                            },
                            {
                                "target_lang_word": "строить козни",
                                "target_lang_sense_clarification": "готовить неприятности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "密谋",
                                "target_lang_sense_clarification": "暗中策划不正当的事"
                            },
                            {
                                "target_lang_word": "图谋",
                                "target_lang_sense_clarification": "谋划达到某种目的，常含不良意味"
                            },
                            {
                                "target_lang_word": "算计",
                                "target_lang_sense_clarification": "在背后动心思害人或对付人"
                            }
                        ]
                    }
                }
