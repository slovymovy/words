                "senses": [
                    {
                        "sense_id": "322c3f4f-dc88-30b4-b10c-f077922f31af",
                        "entry_id": "af5f62b8-5507-35ff-a5bb-15c868a90630",
                        "glosses": [
                            "hersteldijk die achter een wiel om aangelegd is"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "747708eb-09d4-492d-b949-6b281646b5c8",
                                "sense_id": "322c3f4f-dc88-30b4-b10c-f077922f31af",
                                "text": "⧖ In dezelve figuere setten wij tgat te wesenne wijt 25 roeden, tlant binnen is leech landt dwelck ghij siet onder twaeter wesende, ende buijten is hooch landt soo ghij oock bij de voorseijde groesen sien meucht, soodattet niet prouffijtelijcken en waere binnen een vingerlingh geleijt, als wesende een leech stael."
                            }
                        ]
                    },
                    {
                        "sense_id": "138e3cd2-fff9-3c37-8351-0370e1e6e4db",
                        "entry_id": "af5f62b8-5507-35ff-a5bb-15c868a90630",
                        "glosses": [
                            "oog dat als versiering of kenteken om een van de vijf beweeglijke uitsteeksels van de hand is bevestigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81cae8cf-6c88-4756-b43c-b72002e88021",
                                "sense_id": "138e3cd2-fff9-3c37-8351-0370e1e6e4db",
                                "text": "Ze lijkt op de schaamteloze\nkoopman die een ijzeren ring\nverkoopt voor een gouden vingerling."
                            },
                            {
                                "example_id": "58db66e1-43eb-4f0d-928f-3eb9ca9c282d",
                                "sense_id": "138e3cd2-fff9-3c37-8351-0370e1e6e4db",
                                "text": "⧖ Breng hier den gouden ring,\nEn steeck aen deze hand, die beeft, den vingerling,\nDaer ick de bruid van 't Sticht, de Roomsche kerck meê trouwde."
                            }
                        ]
                    },
                    {
                        "sense_id": "449bf4b1-2150-3b63-97c6-21bbddcecc25",
                        "entry_id": "af5f62b8-5507-35ff-a5bb-15c868a90630",
                        "glosses": [
                            "beschermend omhulsel voor een van de vijf beweeglijke uitsteeksels van de hand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51cc8ddc-ba5d-4829-a348-9b08a70c2063",
                                "sense_id": "449bf4b1-2150-3b63-97c6-21bbddcecc25",
                                "text": "Inderdaad de beiaardier moet a.h.w. ‘vechten’ tegen dit reuzeninstrument, maar het beheersen van de technische moeilijkheden geeft hem ook veel voldoening. (…) Hij schildert met tonen, en vormt zijn palet naargelang de aanslag met gekroonde pinkvinger (beschermd door een lederen vingerling), met licht gesloten hand, met een fervente vuistaanslag, soms met opengespreide hand, schakering ook naar gelang de aanslag vanuit de polsbeweging, de voorarmbeweging, vanuit de schouder gebeurt."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2acfa94-dc64-3b9f-ad9d-79cb48b740c0",
                        "entry_id": "af5f62b8-5507-35ff-a5bb-15c868a90630",
                        "glosses": [
                            "bus voor de pen waarom het roer kan draaien\\nDoor verwarring ook wel gebruikt als benaming voor deze roerpen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c499f9de-c391-4764-9fa6-2cfcd9615b2b",
                                "sense_id": "a2acfa94-dc64-3b9f-ad9d-79cb48b740c0",
                                "text": "De vingerling van het roer werd geschraapt, de blokjes van de mast waren blank."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d1825bd-a1a9-3211-b7c2-927043742b19",
                        "entry_id": "af5f62b8-5507-35ff-a5bb-15c868a90630",
                        "glosses": [
                            "vinger tussen de duim en de middelvinger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b073417-a450-4022-8a77-5f774c86d672",
                                "sense_id": "4d1825bd-a1a9-3211-b7c2-927043742b19",
                                "text": "Alle voornoemde relikwieën worden op 4 juli 1283 gedeponeerd in de kapel van H. Margaretha (van wie men een vingerling bezat en die op 20 juli werd gevierd), in aanwezigheid van deken Johannes de Corbie, de kanunniken en de aartsdiaken van Vlaanderen Johannes de Fieffes."
                            }
                        ]
                    }
