                                        "sense_id": "6f0507d3-4212-318b-9e4f-297b747784c3",
                                        "entry_id": "9e365d93-7cdb-3a2b-80af-9732da4a3a20",
                                        "glosses": [
                                            "characterized by, produced by, or involving chemical processes in living organisms"
                                        ],
