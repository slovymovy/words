                                "target_senses": [
                                    {
                                        "sense_id": "0087558b-1dd1-3220-ac5d-049ece43c2a1",
                                        "entry_id": "6776d593-0fcc-378b-b0da-3c9150c23a42",
                                        "glosses": [
                                            "Unidad de medida de superficie, usada únicamente para el terreno, equivalente a 10.000 metros cuadrados."
                                        ],
