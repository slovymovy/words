                    },
                    {
                        "sense_id": "da8d90c4-ab9d-34f6-804d-5ac95e9e840e",
                        "entry_id": "82008327-b183-32be-b264-83ce76dcaa62",
                        "glosses": [
                            "kobieta, która potrafi tańczyć"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8741a010-d040-4fbe-a937-efdedf37ab64",
                                "sense_id": "da8d90c4-ab9d-34f6-804d-5ac95e9e840e",
                                "text": "Rózia, ich wychowanica, jako najlepsza we włości śpiewaczka i tanecznica, będzie tańcom przewodzić"
                            },
                            {
                                "example_id": "b6fe5a38-5692-476a-93a8-8a5316a06774",
                                "sense_id": "da8d90c4-ab9d-34f6-804d-5ac95e9e840e",
                                "text": "Jak mewy, białe morza tanecznice, / Na maszcie czasem zawisną znużone, / Tak okręt w porcie zarzucił kotwicę"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
