                        ],
                        "examples": [
                            {
                                "example_id": "997766e7-5487-4ac2-8c06-ea2275e1ea83",
                                "sense_id": "57c1c961-1965-3be6-8ef0-5da0ceec6991",
                                "text": "“What happened here, Hadley?” the chief asked. “We was robbed, damn it, we was robbed.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "264fd1f1-6cc0-3cda-9783-0fc3bad3468a",
                        "entry_id": "2b94dc81-3200-3110-b1f8-f458891012de",
                        "glosses": [
