                "senses": [
                    {
                        "sense_id": "e0c79503-96fc-3656-8da5-5ee743e81f99",
                        "entry_id": "d7b1d2b0-cac5-3f55-b9dd-f4c1c3fe00e8",
                        "glosses": [
                            "Treffen, bei dem Personen öffentlichen Interesses aktuelle Informationen an Journalisten weitergeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9540356-56ae-49c2-96a7-160245afd10d",
                                "sense_id": "e0c79503-96fc-3656-8da5-5ee743e81f99",
                                "text": "Nach mancher Pressekonferenz fragt man sich, wieso sie überhaupt abgehalten wurde."
                            },
                            {
                                "example_id": "20960ea9-900e-479d-8559-0c46a577e6b9",
                                "sense_id": "e0c79503-96fc-3656-8da5-5ee743e81f99",
                                "text": "„Merkel selbst äußerte sich erst am späten Nachmittag während einer gemeinsamen Pressekonferenz mit Nato-Generalsekretär Fogh Rasmussen zu den Vorfällen.“"
                            },
                            {
                                "example_id": "46784456-594b-4864-bd25-43dab600d013",
                                "sense_id": "e0c79503-96fc-3656-8da5-5ee743e81f99",
                                "text": "„Regelmäßig werden Statistiken erhoben und veröffentlicht, mit Pressekonferenz und sonstiger medialer Begleitung.“"
                            },
                            {
                                "example_id": "46c7e0b2-6c3b-4953-9765-8d414b120a09",
                                "sense_id": "e0c79503-96fc-3656-8da5-5ee743e81f99",
                                "text": "„So pries er seinen Wahlsieg vergangene Woche als den größten seit Ronald Reagan – was Quatsch war, wie ihm gleich in der Pressekonferenz aufgezeigt wurde.“"
                            },
                            {
                                "example_id": "3ee31af2-8667-469c-969b-e9683f40b994",
                                "sense_id": "e0c79503-96fc-3656-8da5-5ee743e81f99",
                                "text": "„Am Tag zuvor hatte ich ihn bei einer Pressekonferenz kennengelernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5926387-9f98-4ca7-b406-331fbc9c516e",
