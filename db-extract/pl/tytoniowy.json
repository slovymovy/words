                            "dotyczący tytoniu (rośliny)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e73e7b78-7055-3ac8-bcdd-ca4f343dcc69",
                        "entry_id": "a1c05376-dcfc-3a0b-82e8-d413acec8c4e",
                        "glosses": [
                            "dotyczący tytoniu (używki)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a6835a0-edc4-4e8d-924e-5b58205d98cc",
                                "sense_id": "e73e7b78-7055-3ac8-bcdd-ca4f343dcc69",
                                "text": "Sprzedaż wyrobów tytoniowych młodzieży poniżej osiemnastego roku życia jest w Hiszpanii zabroniona."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc955c18-0b04-42f2-b693-a9d87a6163bc",
                        "source_entry_id": "a1c05376-dcfc-3a0b-82e8-d413acec8c4e",
                        "source_sense_id": "8fa6465b-9e86-3486-9ae5-d1043e1ca912",
                        "target_lang_word": "tobacco",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tobacco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b24d41c7-bad8-300a-ae9f-566b698cddbe",
                                        "entry_id": "e9bfef5a-af88-3ceb-84bf-30e90aad28c8",
                                        "glosses": [
                                            "To indulge in tobacco; to smoke."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b83741e-82cf-37ad-88d2-f0bbcef1edac",
                                        "entry_id": "e9bfef5a-af88-3ceb-84bf-30e90aad28c8",
                                        "glosses": [
                                            "To treat with tobacco."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "436661bc-8339-47a6-966b-0121d8efb655",
                                                "sense_id": "2b83741e-82cf-37ad-88d2-f0bbcef1edac",
                                                "text": "The most satisfactory method of tobaccoing houses is that of stitching the leaves on to a piece of cloth like a strip of matting, which is then laid on the floor. Powdered tobacco should be introduced into rat holes, which can then be firmly closed up with bricks and mortar. Experiments carried out in the City of Hyderabad seem to have been very satisfactory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tobacco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd16905c-903f-31db-a1d8-dbb82bfef9fc",
                                        "entry_id": "77f6ba56-3fee-3b2e-aa4e-dffbfc0414de",
                                        "glosses": [
                                            "Any plant of the genus Nicotiana."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "882902ab-32be-3b25-93f3-5830cf13f57d",
                                        "entry_id": "77f6ba56-3fee-3b2e-aa4e-dffbfc0414de",
                                        "glosses": [
                                            "Leaves of Nicotiana tabacum and some other species cultivated and harvested to make cigarettes, cigars, snuff, for smoking in pipes or for chewing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a5bdfd7-ac7a-4c00-abbc-b65819e243a0",
                                                "sense_id": "882902ab-32be-3b25-93f3-5830cf13f57d",
                                                "text": "Tobacco-settlement bonds are a tribute both to the inventiveness of bankers and the childlike impatience of politicians."
                                            },
                                            {
                                                "example_id": "677aaf05-438e-401a-94fb-7406dd2c3120",
                                                "sense_id": "882902ab-32be-3b25-93f3-5830cf13f57d",
                                                "text": "Tobacco and the plant valerian are also considered to be anaphrodisiac in their effects, diminishing sexual inclination."
                                            },
                                            {
                                                "example_id": "af56534d-0106-4e48-93fb-a1567807d43d",
                                                "sense_id": "882902ab-32be-3b25-93f3-5830cf13f57d",
                                                "text": "City councilors in Newton have approved a generational ban on tobacco and e-cigarette sales in the city that will prohibit purchases by anyone born after March 1, 2004, joining a growing number of Massachusetts communities that have passed measures to curb tobacco use among young people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caad91f2-f303-3b24-8d8d-28b313076c4a",
                                        "entry_id": "77f6ba56-3fee-3b2e-aa4e-dffbfc0414de",
                                        "glosses": [
                                            "A variety of tobacco."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae6b461e-6951-4bab-9597-a414846f6ffd",
                                                "sense_id": "caad91f2-f303-3b24-8d8d-28b313076c4a",
                                                "text": "Tobaccos from the Connecticut Valley were used for wrapping cigars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d634104a-07e8-456e-9ece-e2d13a3d8814",
                        "source_entry_id": "a1c05376-dcfc-3a0b-82e8-d413acec8c4e",
                        "source_sense_id": "8fa6465b-9e86-3486-9ae5-d1043e1ca912",
                        "target_lang_word": "tabákový",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tabákový",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "accd9e87-1e4a-33f4-8893-11c87e227d7f",
                                        "entry_id": "477adadb-4fef-3d74-9e1b-62f3bbe8b470",
                                        "glosses": [
                                            "související s tabákem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eef6941-3a4e-43f0-b773-da4b9886d605",
                                                "sense_id": "accd9e87-1e4a-33f4-8893-11c87e227d7f",
                                                "text": "Tabákové firmy se pod tlakem úřadů a protikuřáckých kampaní dostaly do fáze, kdy chtějí lidem pomáhat, aby přestali kouřit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
