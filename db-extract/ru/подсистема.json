                    },
                    {
                        "translation_id": "2568048e-a1f4-4957-b814-60989f18f2f8",
                        "source_entry_id": "18ba3936-718d-3e68-9d87-6dabf4a66414",
                        "source_sense_id": "b48cd679-ddec-3330-973f-8c59d07e84d5",
                        "target_lang_word": "Teilsystem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teilsystem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "775f4e37-f37f-3a84-a29d-5c6e69a8a3c3",
                                        "entry_id": "b6bf20ae-2054-3406-be5f-7b7de5e2b6df",
                                        "glosses": [
                                            "abgegrenzte Einheit eines komplexen Gebildes (Systems)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5008d0e8-af5b-47c3-b19a-7bb3d35b720f",
                                                "sense_id": "775f4e37-f37f-3a84-a29d-5c6e69a8a3c3",
                                                "text": "„Durch den Betrieb des Teilsystems des Mauterhebers ist zu erwarten, dass sich im Laufe der Zeit Systemänderungen ergeben.“"
                                            },
                                            {
                                                "example_id": "332ef984-0149-4ad0-8500-33ff707af6eb",
                                                "sense_id": "775f4e37-f37f-3a84-a29d-5c6e69a8a3c3",
                                                "text": "„Für die Klassifikation von Recht als Teilsystem ist die Frage nach dem Bereich von Wirklichkeit, der durch das Recht erfaßt werden soll, entscheidend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b7c0c10-e323-4cf3-9d7c-b4a1424f3853",
                        "source_entry_id": "18ba3936-718d-3e68-9d87-6dabf4a66414",
                        "source_sense_id": "b48cd679-ddec-3330-973f-8c59d07e84d5",
                        "target_lang_word": "Subsystem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Subsystem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be1e68a3-8898-38bf-bcdf-13077cc46f3c",
                                        "entry_id": "599e5005-a68b-39e8-9112-fd5434e70fd3",
                                        "glosses": [
                                            "Teilsystem, das integraler Bestandteil eines komplexen Systems ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78918987-f6aa-4c82-bf76-3a680b5e79e9",
                                                "sense_id": "be1e68a3-8898-38bf-bcdf-13077cc46f3c",
                                                "text": "„Mitunter gliedert man aber das Gesamtsystem auch in vier, fünf oder sechs Subsysteme.“"
                                            },
                                            {
                                                "example_id": "f87f0251-b435-46c0-a7fc-a11eab7f45bb",
                                                "sense_id": "be1e68a3-8898-38bf-bcdf-13077cc46f3c",
                                                "text": "„Darüber hinaus scheint es für die Analyse historischer Sprachzustände generell nicht angemessen zu sein, vorgängig von relativ geschlossenen Systemen und Subsystemen auszugehen.“"
                                            },
                                            {
                                                "example_id": "9e545ccc-5564-4f3f-afdc-d540e688b367",
                                                "sense_id": "be1e68a3-8898-38bf-bcdf-13077cc46f3c",
                                                "text": "„Wenn Sprache nun als strukturiertes Diasystem behandelt wird, müssen sich dessen Subsysteme an die Invarianten der Kommunikation binden lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
