                        "target_lang_word": "terre ferme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terre ferme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e30db815-04da-384c-a40d-708808eafe7c",
                                        "entry_id": "3d08540b-e1d1-353c-b091-fd6269bf107c",
                                        "glosses": [
                                            "Le continent et tout ce qui tient au continent, sans être environné d’eau, à la différence des îles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "802cdc13-bec0-4199-addc-fe48bdccdca3",
                                                "sense_id": "e30db815-04da-384c-a40d-708808eafe7c",
                                                "text": "Si vous vous retrouvez pris dans la baïne, ne tentez pas de rejoindre la terre ferme en nageant à contre-courant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de00cebf-5654-3c6b-b53d-7231ee3b41a9",
                                        "entry_id": "3d08540b-e1d1-353c-b091-fd6269bf107c",
                                        "glosses": [
                                            "Sol stable, par opposition au pont d’un navire, d’un avion, vaisseau spatial, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8272bbb1-1e18-4dc6-bf68-faf57e12326c",
                                                "sense_id": "de00cebf-5654-3c6b-b53d-7231ee3b41a9",
                                                "text": "Un peu de houle agitait le Firecrest sur son ancre, et mes visiteurs furent heureux de regagner la terre ferme."
                                            },
                                            {
                                                "example_id": "3d220bce-9c5a-4c7e-b13b-9b26a51c9813",
                                                "sense_id": "de00cebf-5654-3c6b-b53d-7231ee3b41a9",
                                                "text": "Les vaisseaux s’abordaient par la proue ; on abaissait de part et d’autre des ponts-levis, et on se battait comme en terre ferme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dae140e2-6c79-3620-b25f-5b9955c41334",
                                        "entry_id": "3d08540b-e1d1-353c-b091-fd6269bf107c",
                                        "glosses": [
                                            "Partie des États de Venise qui était située sur le continent, par opposition à Venise et aux îles."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36710964-26d5-4404-8606-c3c1eefeff7b",
                                                "sense_id": "dae140e2-6c79-3620-b25f-5b9955c41334",
                                                "text": "Les nobles de terre ferme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
