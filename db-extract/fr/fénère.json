                        "glosses": [
                            "Variante régionale de fenière, fenil, lieu (grange par exemple, ou grenier) où on entrepose le foin dans une ferme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12941f55-10df-4d26-b084-36b2ed25f8eb",
                                "sense_id": "6a338440-fe01-3c5f-91f5-d4db9562a4cc",
                                "text": "Le feu prit à une fénière. Personne au début pour l'éteindre. Les hommes étaient tous aux champs. Le vent soufflait, un vent à emporter les toits."
                            },
                            {
                                "example_id": "ab579970-6adc-4480-87e1-f5ddeadb19b3",
                                "sense_id": "6a338440-fe01-3c5f-91f5-d4db9562a4cc",
                                "text": "Le crêt Fénère, sommet de la commune d'Orelle surplombant les granges dites fénères du village de Combe-Noire."
                            }
                        ]
                    }
