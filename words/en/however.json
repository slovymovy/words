{
    "word_family": [
        "how",
        "howsoever"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "47a0b8ef-8fe7-3946-bcf4-306f526ae437",
                    "sense_definition": "Used to introduce a statement that contrasts with or contradicts something that has been said previously.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "contrast_connector",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He promised to come to the party. <w>However</w>, he never showed up.",
                            "target_lang_translations": {
                                "ru": "Он обещал прийти на вечеринку. <w>Однако</w> он так и не появился.",
                                "tr": "Partiye geleceğine söz verdi. <w>Ancak</w> hiç gelmedi.",
                                "zh": "他答应来参加聚会，<w>然而</w>他最终没露面。"
                            }
                        },
                        {
                            "text": "The weather was cold and windy; <w>However</w>, we still enjoyed our walk.",
                            "target_lang_translations": {
                                "ru": "Погода была холодной и ветреной; <w>тем не менее</w>, мы всё равно насладились прогулкой.",
                                "tr": "Hava soğuk ve rüzgarlıydı; <w>bununla birlikte</w> yine de yürüyüşümüzden keyif aldık.",
                                "zh": "天气又冷又刮风，<w>不过</w>我们还是享受了这次散步。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nevertheless",
                        "nonetheless",
                        "yet",
                        "still",
                        "even so",
                        "that said",
                        "but"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения утверждения, которое противопоставляется или противоречит сказанному ранее.",
                        "tr": "Daha önce söylenmiş bir şeyle çelişen veya zıtlık oluşturan bir ifadeyi başlatmak için kullanılır.",
                        "zh": "用于引出与前文所述内容形成对比或矛盾的陈述。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "однако",
                                "target_lang_sense_clarification": "противопоставление"
                            },
                            {
                                "target_lang_word": "тем не менее",
                                "target_lang_sense_clarification": "несмотря на это"
                            },
                            {
                                "target_lang_word": "всё же",
                                "target_lang_sense_clarification": "уступка"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ancak",
                                "target_lang_sense_clarification": "karşıtlık belirtir"
                            },
                            {
                                "target_lang_word": "bununla birlikte",
                                "target_lang_sense_clarification": "duruma rağmen"
                            },
                            {
                                "target_lang_word": "fakat",
                                "target_lang_sense_clarification": "ama anlamında"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "然而",
                                "target_lang_sense_clarification": "表示转折"
                            },
                            {
                                "target_lang_word": "但是",
                                "target_lang_sense_clarification": "表示对比"
                            },
                            {
                                "target_lang_word": "不过",
                                "target_lang_sense_clarification": "表示转折"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02244371-47c7-387b-8e80-1cb1764f5593",
                    "sense_definition": "To whatever amount, degree, or extent; no matter how.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degree_modifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>However</w> hard I try, I cannot seem to solve this puzzle.",
                            "target_lang_translations": {
                                "ru": "<w>Как бы</w> я <w>ни</w> старался, я не могу решить эту головоломку.",
                                "tr": "<w>Ne kadar</w> çabalarsam çabalayayım, bu bulmacayı çözemiyorum.",
                                "zh": "<w>无论怎么</w>努力，我似乎都解不开这个谜题。"
                            }
                        },
                        {
                            "text": "You must finish the project on time, <w>However</w> long it takes.",
                            "target_lang_translations": {
                                "ru": "Ты должен закончить проект вовремя, <w>сколько бы</w> времени это <w>ни</w> заняло.",
                                "tr": "<w>Ne kadar</w> uzun sürerse sürsün projeyi zamanında bitirmelisin.",
                                "zh": "你必须按时完成项目，<w>不管</w>需要多长时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "no matter how",
                        "regardless of how"
                    ],
                    "common_phrases": [
                        "however much",
                        "however hard",
                        "however long",
                        "however many"
                    ],
                    "target_lang_definitions": {
                        "ru": "В какой бы степени ни; как бы ни.",
                        "tr": "Hangi miktarda, derecede veya ölçüde olursa olsun; ne kadar olursa olsun.",
                        "zh": "无论程度、数量或范围如何；不管怎样。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "как бы ни",
                                "target_lang_sense_clarification": "независимо от степени усилия"
                            },
                            {
                                "target_lang_word": "сколько бы ни",
                                "target_lang_sense_clarification": "независимо от количества или времени"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ne kadar ... olsa da",
                                "target_lang_sense_clarification": "derece veya çabaya bakılmaksızın"
                            },
                            {
                                "target_lang_word": "her ne kadar",
                                "target_lang_sense_clarification": "ölçü veya miktar belirterek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无论怎么",
                                "target_lang_sense_clarification": "表示程度不受限制"
                            },
                            {
                                "target_lang_word": "不管多",
                                "target_lang_sense_clarification": "表示程度或数量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fd22065-49be-39a8-842e-bcd2e1c0cc52",
                    "sense_definition": "Used as an emphatic form of 'how' in questions to express surprise, confusion, or wonder.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emphatic_interrogative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>However</w> did you manage to carry all those heavy boxes by yourself?",
                            "target_lang_translations": {
                                "ru": "<w>Как же</w> тебе удалось донести все эти тяжелые коробки в одиночку?",
                                "tr": "Bütün o ağır kutuları tek başına taşımayı <w>nasıl oldu da</w> başardın?",
                                "zh": "你<w>到底是怎么</w>一个人搬动所有这些重箱子的？"
                            }
                        },
                        {
                            "text": "I have looked everywhere for my keys; <w>however</w> did I lose them?",
                            "target_lang_translations": {
                                "ru": "Я искал ключи везде; <w>как же</w> я их потерял?",
                                "tr": "Her yerde anahtarlarımı aradım; onları <w>nasıl</w> kaybettim acaba?",
                                "zh": "我到处都找遍了钥匙，我<w>究竟是怎么</w>把它们弄丢的？"
                            }
                        }
                    ],
                    "synonyms": [
                        "how on earth"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "emphatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как усилительная форма слова «как» в вопросах для выражения удивления или недоумения.",
                        "tr": "Sorularda şaşkınlık, kafa karışıklığı veya merak ifade etmek için 'nasıl' kelimesinin vurgulu bir formu olarak kullanılır.",
                        "zh": "用于疑问句中作为“如何”的强调形式，以表达惊讶、困惑或惊奇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "как же",
                                "target_lang_sense_clarification": "усиление вопроса"
                            },
                            {
                                "target_lang_word": "каким образом",
                                "target_lang_sense_clarification": "выражение сильного удивления"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "nasıl oldu da",
                                "target_lang_sense_clarification": "şaşkınlık bildiren vurgulu soru"
                            },
                            {
                                "target_lang_word": "nasıl",
                                "target_lang_sense_clarification": "vurgulu soru biçimi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "到底怎么",
                                "target_lang_sense_clarification": "加强疑问语气"
                            },
                            {
                                "target_lang_word": "究竟怎么",
                                "target_lang_sense_clarification": "表示困惑或惊奇"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "5bdaf2dd-6400-3513-ba19-90e4baa70a2f",
                    "sense_definition": "In whatever way or manner that; regardless of how.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner_conjunction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can decorate your room <w>however</w> you like.",
                            "target_lang_translations": {
                                "ru": "Ты можешь украсить свою комнату <w>как</w> тебе <w>угодно</w>.",
                                "tr": "Odanı <w>nasıl</w> istersen öyle dekore edebilirsin.",
                                "zh": "你可以<w>随心所欲地</w>装饰你的房间。"
                            }
                        },
                        {
                            "text": "<w>However</w> we decide to travel, we need to leave early in the morning.",
                            "target_lang_translations": {
                                "ru": "<w>Как бы</w> мы ни решили ехать, нам нужно выехать рано утром.",
                                "tr": "<w>Nasıl</w> seyahat etmeye karar verirsek verelim, sabah erkenden yola çıkmamız gerekiyor.",
                                "zh": "<w>无论我们决定怎么</w>旅行，都得在清晨出发。"
                            }
                        }
                    ],
                    "synonyms": [
                        "in whatever way",
                        "howsoever",
                        "any way",
                        "regardless of how"
                    ],
                    "common_phrases": [
                        "however you want",
                        "however you like"
                    ],
                    "target_lang_definitions": {
                        "ru": "Каким угодно образом; как угодно.",
                        "tr": "Her ne şekilde veya biçimde olursa olsun; nasıl olursa olsun.",
                        "zh": "以任何方式或方法；无论如何。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "как",
                                "target_lang_sense_clarification": "любым способом"
                            },
                            {
                                "target_lang_word": "как угодно",
                                "target_lang_sense_clarification": "по своему усмотрению"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "nasıl ... -se",
                                "target_lang_sense_clarification": "herhangi bir şekilde"
                            },
                            {
                                "target_lang_word": "nasıl istersen",
                                "target_lang_sense_clarification": "tercihe bağlı olarak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "怎么",
                                "target_lang_sense_clarification": "表示方式不限"
                            },
                            {
                                "target_lang_word": "无论怎么",
                                "target_lang_sense_clarification": "表示方式不受限制"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}