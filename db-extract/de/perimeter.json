                "senses": [
                    {
                        "sense_id": "e422129c-8353-3848-8a5b-4829b72bad1c",
                        "entry_id": "cb2935d1-6ea0-380f-9cbb-9835584968c3",
                        "glosses": [
                            "Umfang einer ebenen geometrischen Figur"
                        ],
                        "tags": [
                            "geometry",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "52c5fa4b-e737-49ad-b579-84258662b87a",
                                "sense_id": "e422129c-8353-3848-8a5b-4829b72bad1c",
                                "text": "„Die Summe aller Seiten eines beliebigen nEcks heißt der Umfang oder Perimeter der Figur.“"
                            },
                            {
                                "example_id": "043af005-62b3-4dfd-84f0-b53d0c0787fb",
                                "sense_id": "e422129c-8353-3848-8a5b-4829b72bad1c",
                                "text": "„[…] oder man messe vom Mittelpuncte aus eine hinreichende Anzahl von Radien nach allen Richtungen, so liegen die Endpuncte dieser Radien im Perimeter des Kreises.“"
                            },
                            {
                                "example_id": "19a82a64-be4f-46a3-a6dc-bcc53eb8b721",
                                "sense_id": "e422129c-8353-3848-8a5b-4829b72bad1c",
                                "text": "„Der Durchmesser des Kreises wurde ja offenbar deshalb vervierfacht, um den Kreisumfang mit dem Perimeter eines Quadrates, dessen Seiten gleich sind dem Durchmesser, zu vergleichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
