                        "glosses": [
                            "In an agonizing manner; in a way that causes agony."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "654b797b-d3a9-42f6-a252-24e3df6eca3d",
                                "sense_id": "1afc09d4-f6a4-314c-83e3-1b6af938e8dc",
                                "text": "The hour I waited for the pain medication to take effect dragged on agonizingly."
                            },
                            {
                                "example_id": "4975eb94-92b7-4125-8178-c7ffac1b8d81",
                                "sense_id": "1afc09d4-f6a4-314c-83e3-1b6af938e8dc",
                                "text": "Friday afternoons always seem to be agonizingly prolonged."
                            },
                            {
                                "example_id": "35a53928-e1c9-4e45-bff9-5e90d786b203",
                                "sense_id": "1afc09d4-f6a4-314c-83e3-1b6af938e8dc",
                                "text": "Leisurely the long hours ticked into nothingness, yet there was no sound from him. Would he go in the night, as he did before from Stein's, without a word? Ursula's heart quickened agonizingly, though she lay still, tingling with the thought."
                            }
                        ]
                    }
