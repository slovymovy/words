                "senses": [
                    {
                        "sense_id": "d9c28bed-e0d9-3f53-92e6-c8ef2f4f5852",
                        "entry_id": "f0592850-7f82-32b9-9a30-f0306d3b473a",
                        "glosses": [
                            "Piquer (un taureau), lors d’une corrida."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2957c77-898d-4c70-9269-0a73b26d41bc",
                                "sense_id": "d9c28bed-e0d9-3f53-92e6-c8ef2f4f5852",
                                "text": "Tomas Bastos pinche avant de tuer d’une entière basse et en avant et coupe la seule oreille de la matinée."
                            },
                            {
                                "example_id": "588cf47e-aba8-4411-b1d8-f7b18ad90064",
                                "sense_id": "d9c28bed-e0d9-3f53-92e6-c8ef2f4f5852",
                                "text": "Laborieusement, ils pinchent et repinchent, mais toujours « en haut », jusqu’à ce que cette maudite épée entre toute entière."
                            },
                            {
                                "example_id": "051b09ae-7314-4a58-9354-891ab45a886f",
                                "sense_id": "d9c28bed-e0d9-3f53-92e6-c8ef2f4f5852",
                                "text": "J’ai pinché au moment de tuer."
                            }
                        ]
                    }
