{
    "word_family": [
        "retrait",
        "retraite",
        "retraité",
        "tirer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f0f567c-809d-3950-b728-a091109b5adf",
                    "sense_definition": "Prendre de l'argent liquide à un distributeur ou à un guichet de banque.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai <w>retiré</w> cinquante euros au distributeur avant de faire les courses."
                        },
                        {
                            "text": "N'oublie pas de <w>retirer</w> de l'argent liquide pour payer le taxi ce soir."
                        }
                    ],
                    "antonyms": [
                        "déposer"
                    ],
                    "common_phrases": [
                        "retirer de l'argent"
                    ]
                },
                {
                    "sense_id": "a1b4edb5-9d18-3556-9c50-e34c065fe83b",
                    "sense_definition": "Enlever un vêtement ou un accessoire que l'on porte sur soi.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>retire</w> toujours ses chaussures avant d'entrer dans la maison."
                        },
                        {
                            "text": "Vous devriez <w>retirer</w> votre veste chaude car la pièce est très chauffée."
                        }
                    ],
                    "synonyms": [
                        "enlever",
                        "ôter"
                    ],
                    "antonyms": [
                        "mettre"
                    ],
                    "common_phrases": [
                        "retirer ses chaussures",
                        "retirer son manteau"
                    ]
                },
                {
                    "sense_id": "7b1c81c0-639a-3559-b372-39190af15d6e",
                    "sense_definition": "Sortir ou détacher une chose ou une personne du lieu où elle se trouvait.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "enlever_lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>retirer</w> la casserole du feu dès que l'eau commence à bouillir."
                        },
                        {
                            "text": "Elle a <w>retiré</w> la clé de la serrure avant de fermer doucement la porte."
                        }
                    ],
                    "synonyms": [
                        "enlever",
                        "ôter"
                    ],
                    "antonyms": [
                        "déposer",
                        "mettre"
                    ],
                    "common_phrases": [
                        "retirer la clé",
                        "retirer du feu"
                    ]
                },
                {
                    "sense_id": "32188b70-1060-3fc8-b4b8-90a8515e42b7",
                    "sense_definition": "Ramener vers soi ou écarter vivement une partie de son corps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a vite <w>retiré</w> sa main pour ne pas toucher le plat brûlant."
                        },
                        {
                            "text": "Elle <w>retire</w> son bras par réflexe dès qu'elle aperçoit le chien agité."
                        }
                    ],
                    "antonyms": [
                        "rapprocher"
                    ],
                    "common_phrases": [
                        "retirer sa main",
                        "retirer son bras"
                    ]
                },
                {
                    "sense_id": "10ec885b-e52f-3314-9527-e90b4562b9ca",
                    "sense_definition": "Annuler ce que l'on a dit ou priver quelqu'un d'un droit ou d'une marque de confiance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annuler_droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue discussion, le plaignant a accepté de <w>retirer</w> sa plainte."
                        },
                        {
                            "text": "Le directeur lui a <w>retiré</w> sa confiance après la découverte de cette faute grave."
                        }
                    ],
                    "synonyms": [
                        "annuler",
                        "priver",
                        "supprimer"
                    ],
                    "common_phrases": [
                        "retirer sa plainte",
                        "retirer ses paroles"
                    ]
                },
                {
                    "sense_id": "64d6bdb5-7502-3b71-8137-311638f989a1",
                    "sense_definition": "Cesser une activité professionnelle ou quitter la vie publique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quitter_activite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chef d'entreprise a décidé de se <w>retirer</w> des affaires à soixante ans."
                        },
                        {
                            "text": "L'homme politique a choisi de se <w>retirer</w> de la vie publique après sa défaite."
                        }
                    ],
                    "common_phrases": [
                        "se retirer des affaires",
                        "se retirer de la vie politique"
                    ]
                },
                {
                    "sense_id": "9f612bf5-2fc4-3e2a-8aa6-5fb81957684a",
                    "sense_definition": "S'éloigner d'un endroit ou d'une assemblée pour aller dans un lieu calme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quitter_lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fatigué par cette longue réunion, l'invité se <w>retire</w> discrètement dans sa chambre."
                        },
                        {
                            "text": "Après le dîner, le vieil homme aime se <w>retirer</w> dans sa bibliothèque pour lire."
                        }
                    ],
                    "synonyms": [
                        "s'éloigner"
                    ],
                    "antonyms": [
                        "se rapprocher"
                    ],
                    "common_phrases": [
                        "se retirer dans sa chambre"
                    ]
                },
                {
                    "sense_id": "252bf3f9-8c7c-34ad-8ddd-7a083b4ff9a1",
                    "sense_definition": "En parlant de l'eau ou de la mer, refluer et baisser de niveau.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "eaux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À marée basse, la mer se <w>retire</w> très loin sur cette immense plage de sable."
                        },
                        {
                            "text": "Les habitants ont constaté que l'eau du fleuve commençait enfin à se <w>retirer</w>."
                        }
                    ],
                    "common_phrases": [
                        "la mer se retire"
                    ]
                },
                {
                    "sense_id": "325d37f7-c8bf-3ea8-82b5-e7891efa99dc",
                    "sense_definition": "Imprimer à nouveau un texte, un livre ou une publication.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "imprimerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éditeur a prévu de <w>retirer</w> ce roman à cinq mille exemplaires le mois prochain."
                        },
                        {
                            "text": "Devant un succès inattendu, la maison d'édition a fait <w>retirer</w> l'ouvrage en urgence."
                        }
                    ]
                }
            ]
        }
    ]
}