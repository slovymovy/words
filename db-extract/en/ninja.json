    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "075f80a3-0b90-35d3-8b05-bacde651db5a",
                "word": "ninja",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ceacfdd2-3b97-35ed-87fd-cf71ba96769e",
                        "entry_id": "075f80a3-0b90-35d3-8b05-bacde651db5a",
                        "glosses": [
                            "Of or related to ninjas in their various senses."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3c1b8c66-65f6-496e-aa02-32ebdca9bbb8",
                                "sense_id": "ceacfdd2-3b97-35ed-87fd-cf71ba96769e",
                                "text": "The July 1966 issue had a cartoon concerning a Ninja dojo."
                            },
                            {
                                "example_id": "8ec40b63-8f03-4d33-9565-a803dee9bd39",
                                "sense_id": "ceacfdd2-3b97-35ed-87fd-cf71ba96769e",
                                "text": "One of the most controversial characters in Japan's current ninja boom is a stout but surprisingly agile man in his mid-forties named Norihiro Iga-Hakuyusai."
                            },
                            {
                                "example_id": "1d2bb4ad-d7eb-4c52-bee1-0b9c95757459",
                                "sense_id": "ceacfdd2-3b97-35ed-87fd-cf71ba96769e",
                                "text": "[…]Federal agents in body armor and black ninja uniforms[…]"
                            },
                            {
                                "example_id": "95db1d95-1856-45f2-b7d7-4c3beaa1455e",
                                "sense_id": "ceacfdd2-3b97-35ed-87fd-cf71ba96769e",
                                "text": "As they broke camp, the teenage son practised his Ninja moves with a tentpole."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
