                "senses": [
                    {
                        "sense_id": "fdc65057-f893-3802-8b27-871f4f2c558a",
                        "entry_id": "315e7a5d-1de3-38ad-99a8-5971eaa80e8e",
                        "glosses": [
                            "Bereich in der Ozonschicht, in dem das Ozon abgebaut ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d41bea3-e778-47ba-9f8e-0526fea82c26",
                                "sense_id": "fdc65057-f893-3802-8b27-871f4f2c558a",
                                "text": "Das Ozonloch wird immer größer."
                            },
                            {
                                "example_id": "265d9819-0d66-4de4-8c03-2a6d6e4a8caa",
                                "sense_id": "fdc65057-f893-3802-8b27-871f4f2c558a",
                                "text": "„Der Anblick der blauen Atmosphäre wurde nicht, wie wenige Jahre zuvor, vor allem in seiner Schönheit bestaunt, sondern – vor dem Hintergrund des entdeckten Ozonlochs und der sich abzeichnenden Klimaerwärmung – als ein Zeichen der Fragilität genommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffb05a38-10d3-4463-839a-b43ab93d8446",
                        "source_entry_id": "315e7a5d-1de3-38ad-99a8-5971eaa80e8e",
                        "source_sense_id": "fdc65057-f893-3802-8b27-871f4f2c558a",
                        "source_sense_description": "Bereich in der Ozonschicht, in dem das Ozon abgebaut ist",
                        "target_lang_word": "hole in the ozone layer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8f2b7719-f20d-44c2-9962-dfb1756c0d25",
                        "source_entry_id": "315e7a5d-1de3-38ad-99a8-5971eaa80e8e",
                        "source_sense_id": "fdc65057-f893-3802-8b27-871f4f2c558a",
                        "source_sense_description": "Bereich in der Ozonschicht, in dem das Ozon abgebaut ist",
                        "target_lang_word": "ozone hole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ozone hole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b3551ec-aef9-3f19-afe4-ea1122579fab",
                                        "entry_id": "759cc175-c20d-38d0-b3f6-6d042070e336",
                                        "glosses": [
                                            "A region of the stratosphere over Antarctica (and a smaller one over the Arctic) that is depleted of ozone in the local spring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f632f5f2-c079-4808-89c7-033fc89b27d2",
                                                "sense_id": "3b3551ec-aef9-3f19-afe4-ea1122579fab",
                                                "text": "Callis says that the ozone hole now developing over the Antarctic is as deep as last year's hole, but seems to cover a smaller area."
                                            },
                                            {
                                                "example_id": "1e809d15-949c-4dee-9fbc-62d3c34de301",
                                                "sense_id": "3b3551ec-aef9-3f19-afe4-ea1122579fab",
                                                "text": "When [Richard] Stolarski double-checked, he found that the depleted region covered all of Antarctica—and the “ozone hole” was born. It wasn't an instrument error. It was a real phenomenon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be20714a-8bf9-4f2e-afcb-19bb79bc90c0",
                        "source_entry_id": "315e7a5d-1de3-38ad-99a8-5971eaa80e8e",
