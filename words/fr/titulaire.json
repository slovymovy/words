    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab5f1b95-c846-3552-9b5f-7c9fb038c8a6",
                    "sense_definition": "Personne au nom de laquelle est établi un document officiel, un compte ou un contrat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "possession_legale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seul le <w>titulaire</w> du compte en banque a le droit de signer ce document."
                        },
                        {
                            "text": "Elle doit montrer sa pièce d'identité pour prouver qu'elle est bien la <w>titulaire</w> de la carte."
                        }
                    ],
                    "synonyms": [
                        "détenteur",
                        "possesseur"
                    ],
                    "common_phrases": [
                        "titulaire du compte",
                        "titulaire de la carte"
                    ]
                },
                {
                    "sense_id": "b89d64e8-b425-3b6c-8c43-8f645aa8e299",
                    "sense_definition": "Personne investie de manière permanente d'un emploi, d'une fonction ou d'une charge officielle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "statut_professionnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après deux années comme stagiaire, elle est enfin reconnue comme <w>titulaire</w> de son poste."
                        },
                        {
                            "text": "En l'absence du <w>titulaire</w>, un remplaçant a pris en charge les cours pour la semaine."
                        }
                    ],
                    "antonyms": [
                        "remplaçant",
                        "suppléant",
                        "intérimaire"
                    ],
                    "common_phrases": [
                        "titulaire du poste",
                        "nommer un titulaire"
                    ]
                },
                {
                    "sense_id": "c6798527-7dd0-3a3c-afdc-c8b49a9dce25",
                    "sense_definition": "Personne qui a droit à un privilège, une distinction ou un honneur particulier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les <w>titulaires</w> de cette distinction prestigieuse sont conviés à la cérémonie officielle."
                        },
                        {
                            "text": "Le chercheur est le fier <w>titulaire</w> de nombreuses récompenses scientifiques internationales."
                        }
                    ],
                    "synonyms": [
                        "bénéficiaire"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5c2ac004-e2ae-3417-ace6-252945af7bc9",
                    "sense_definition": "Dans le sport, qui fait partie de l'équipe de départ au coup d'envoi d'une rencontre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entraîneur a choisi d'aligner son gardien <w>titulaire</w> pour la finale du tournoi."
                        },
                        {
                            "text": "Blessé lors du dernier match, ce jeune joueur ne sera pas <w>titulaire</w> ce soir."
                        }
                    ],
                    "antonyms": [
                        "remplaçant"
                    ],
                    "common_phrases": [
                        "joueur titulaire",
                        "gardien titulaire"
                    ]
                },
                {
                    "sense_id": "35adcfcf-9c5a-35f4-968a-06ff6ac50dee",
                    "sense_definition": "Qui est formellement pourvu d'un titre, d'un grade ou d'un poste permanent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "statut_professionnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a obtenu son concours et exerce maintenant comme professeure <w>titulaire</w> au collège."
                        },
                        {
                            "text": "Ce poste requiert l'accord formel d'un membre <w>titulaire</w> du comité scientifique."
                        }
                    ],
                    "synonyms": [
                        "permanent"
                    ],
                    "antonyms": [
                        "auxiliaire",
                        "contractuel",
                        "stagiaire"
                    ],
                    "common_phrases": [
                        "professeur titulaire",
                        "membre titulaire"
                    ]
                },
                {
                    "sense_id": "fb471aec-b571-37c8-990d-6387ab09616c",
                    "sense_definition": "Qui possède le titre et les honneurs d'une dignité sans en exercer les fonctions effectives.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce prélat a été nommé évêque <w>titulaire</w> d'un diocèse historique aujourd'hui disparu."
                        },
                        {
                            "text": "Il n'exerce aucun pouvoir réel dans la région mais demeure souverain <w>titulaire</w> de ce territoire."
                        }
                    ],
                    "synonyms": [
                        "honorifique",
                        "honoraire"
                    ],
                    "antonyms": [
                        "résidentiel"
                    ],
                    "common_phrases": [
                        "évêque titulaire"
                    ]
                }
            ]
        }
    ]
