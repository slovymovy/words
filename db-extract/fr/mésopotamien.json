                "senses": [
                    {
                        "sense_id": "6df50bde-2e05-3d3f-af0a-36cbb136c157",
                        "entry_id": "a633e28a-c9aa-399f-ab26-cc2c0e8dece2",
                        "glosses": [
                            "Relatif à la Mésopotamie, ou à une contrée située entre deux fleuves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51e64ab3-9b66-4ca0-83da-cbd02cea0aa5",
                                "sense_id": "6df50bde-2e05-3d3f-af0a-36cbb136c157",
                                "text": "Région mésopotamienne."
                            },
                            {
                                "example_id": "34c4093b-ba5c-44d3-b75a-777585ad7eee",
                                "sense_id": "6df50bde-2e05-3d3f-af0a-36cbb136c157",
                                "text": "Les journées passaient, l’air de la palmeraie devint brûlant et le soleil de l’été mésopotamien n’y était pour rien."
                            },
                            {
                                "example_id": "7c6de85e-e9a7-4497-b179-8140de431ecf",
                                "sense_id": "6df50bde-2e05-3d3f-af0a-36cbb136c157",
                                "text": "Comme ces structures étaient construites en briques d’ argile, la plupart des ziggourats mésopotamiennes furent découverte dans un piètre état de conservation."
                            }
                        ]
                    }
                ],
