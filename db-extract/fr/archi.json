        "fr-extract.jsonl": [
            {
                "entry_id": "72a2ebe2-e1e5-3ca0-aade-19eb5d0ce675",
                "word": "archi",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9b17ba3f-5048-37be-941d-4f762c2aea4c",
                        "entry_id": "72a2ebe2-e1e5-3ca0-aade-19eb5d0ce675",
                        "glosses": [
                            "Forme quasi superlative de l’adverbe très."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6502820a-8156-4be3-8067-073dbf8ea893",
                                "sense_id": "9b17ba3f-5048-37be-941d-4f762c2aea4c",
                                "text": "Hier, le premier ministre, de mauvaise humeur, a réactivé l’affaire, citant même au texte les propos limites de Derraji sur les ondes d’une radio réputée pour être archi sceptique face aux mesures sanitaires."
                            },
                            {
                                "example_id": "bd4a4868-87e4-4097-80f7-98ca493282ba",
                                "sense_id": "9b17ba3f-5048-37be-941d-4f762c2aea4c",
                                "text": "L’État d’Israël, il est vrai, est unitaire. Son système de santé, à l’opposé du nôtre, est à la fine pointe des dernières technologies et archi bien organisé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92c80e0a-264f-4347-b877-d3530ad72e1b",
                        "source_entry_id": "72a2ebe2-e1e5-3ca0-aade-19eb5d0ce675",
                        "source_sense_id": "9b17ba3f-5048-37be-941d-4f762c2aea4c",
                        "target_lang_word": "super",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "super",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "386d7608-91c8-3edf-8c02-a555e9d88d82",
                                        "entry_id": "22ba2ca0-191e-35e2-ad01-041ae3c14e05",
                                        "glosses": [
                                            "Of excellent quality, superfine."
