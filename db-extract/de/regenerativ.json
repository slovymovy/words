                    {
                        "form_id": "e9d3324b-99d5-4a1b-b3dd-ff8337a2ca23",
                        "entry_id": "94554711-baa3-37c3-8bce-83ac12f2488b",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind regenerativ"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12d55394-359c-3aad-bd29-9f39093b3c22",
                        "entry_id": "94554711-baa3-37c3-8bce-83ac12f2488b",
                        "glosses": [
                            "auf Regeneration beruhend; sich erneuernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a377eb8-66aa-46df-b783-f3d9a9d52606",
                                "sense_id": "12d55394-359c-3aad-bd29-9f39093b3c22",
                                "text": "Regenerativ betriebene Anlagen [spielen] noch eine untergeordnete Rolle."
                            },
                            {
                                "example_id": "0ac43cf0-f4ea-44cb-9693-3e1aa56a9dee",
                                "sense_id": "12d55394-359c-3aad-bd29-9f39093b3c22",
                                "text": "Vorbilder sind da zurzeit vor allem Projekte in den Niederlanden, bei denen die Windenergieerträge großer Offshore-Windparks noch auf dem Meer zu Wasserstoff umgewandelt werden. Ziel ist auch dort letztlich, das vorhandene Erdgasnetz für den Weitertransport der Energie aus regenerativen Quellen zu nutzen."
                            },
                            {
                                "example_id": "ba4601e9-518c-40f0-ba4c-5b57ed0e7ac0",
                                "sense_id": "12d55394-359c-3aad-bd29-9f39093b3c22",
                                "text": "Erdgas und Wasserstoff aus Klärschlamm - diese Idee erwies sich am Ende als Sackgasse, weil sich regenerative Energieträger wie Windkraft und Photovoltaik zwischenzeitlich rasant entwickelten und andere Wege zur Wasserstoffgewinnung attraktiver machten."
                            },
                            {
                                "example_id": "23ffef35-0509-444c-b1fd-fd8f66346c5b",
                                "sense_id": "12d55394-359c-3aad-bd29-9f39093b3c22",
                                "text": "Wie bei batteriebetriebenen Elektroautos entstehen [bei Brennstoffzellenautos] lokal keine Emissionen. Aus dem Auspuff kommt lediglich Wasserdampf. Wird der Wasserstoff zudem mit regenerativen Energien erzeugt, ist die Antriebstechnik frei von klimaschädlichem Kohlendioxid."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8c78dfb6-4772-306e-912d-a44770fd4dcc",
                        "entry_id": "94554711-baa3-37c3-8bce-83ac12f2488b",
                        "glosses": [
                            "nachwachsend, beispielsweise Zellen, Gewebe, Organe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40a4a379-dc15-4474-89de-80205400b5f7",
                                "sense_id": "8c78dfb6-4772-306e-912d-a44770fd4dcc",
                                "text": "Ein Ziel der regenerativen Medizin ist es, die Selbstheilungskräfte des Körpers wieder zu aktivieren."
                            },
                            {
                                "example_id": "f13c7c23-9110-4c05-a02d-53af7b205b39",
                                "sense_id": "8c78dfb6-4772-306e-912d-a44770fd4dcc",
                                "text": "Nichts, so schien es, konnte jedoch das Dogma erschüttern, daß irgendwo im Verlaufe der Evolution die höheren Primaten ihre regenerative Fähigkeit verloren hatten, um ihre neuronale Festverdrahtung zu schützen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "692b84c0-170b-4d67-a9dd-6cd83bcd9032",
                        "source_entry_id": "94554711-baa3-37c3-8bce-83ac12f2488b",
                        "source_sense_id": "12d55394-359c-3aad-bd29-9f39093b3c22",
                        "source_sense_description": "sich erneuernd",
                        "target_lang_word": "renewable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renewable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1eacc800-c715-3df7-9c33-1704925d2e9c",
                                        "entry_id": "d5370029-5bcd-3c5b-b915-25df28b8dd43",
                                        "glosses": [
                                            "Able to be renewed; capable of renewal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1f4db24-4acf-48d1-af0b-b02a81521d43",
                                                "sense_id": "1eacc800-c715-3df7-9c33-1704925d2e9c",
                                                "text": "Under the pilot project, the private sector will supply, install, operate and maintain e-vehicle charging stations; monitor and verify the energy efficiency, performance and savings in using renewable energy; and optimize the use of clean energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                        "entry_id": "d5370029-5bcd-3c5b-b915-25df28b8dd43",
                                        "glosses": [
                                            "Sustainable; able to be regrown or renewed; having an ongoing or continuous source of supply."
                                        ],
                                        "tags": [
                                            "of a resource"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43984897-1f40-4ab2-baee-af56881d956a",
                                                "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                                "text": "renewable sources of energy"
                                            },
                                            {
                                                "example_id": "b76420fd-ebf5-4151-bf74-d9d3e4f8e0bb",
                                                "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                                "text": "Solar and wind power are renewable, but coal is not."
                                            },
                                            {
                                                "example_id": "666de4f8-c13a-4982-9722-07dfdd20ba65",
                                                "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                                "text": "renewable resource"
                                            },
                                            {
                                                "example_id": "78d500ef-6109-441e-9e33-e0a81aa7fd27",
                                                "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                                "text": "renewable energy"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "renewable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1351d5af-6651-3bdd-8059-c1da77270483",
                                        "entry_id": "0fd3c107-2cb2-3f68-8c32-2a84e9dbbb6c",
                                        "glosses": [
                                            "A thing that is renewable",
                                            "A renewable resource or source of energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d95de28b-b768-4fea-b2a4-41c49035a5c8",
                                                "sense_id": "1351d5af-6651-3bdd-8059-c1da77270483",
                                                "text": "Klein diagnoses impressively what hasn’t worked. No more claptrap about fracked gas as a bridge to renewables. Enough already of the international summit meetings that produce sirocco-quality hot air, and nonbinding agreements that bind us all to more emissions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3721b816-82ef-3e42-bb41-e5aeee1dda0e",
                                        "entry_id": "0fd3c107-2cb2-3f68-8c32-2a84e9dbbb6c",
                                        "glosses": [
                                            "A thing that is renewable",
                                            "A renewable fuse; a fuse which can be opened in order to replace the element."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbf5c417-866e-4baf-a6f3-8ab13bcd1f67",
                                                "sense_id": "3721b816-82ef-3e42-bb41-e5aeee1dda0e",
                                                "text": "You'll find the link can be removed from a \"Union\" Renewable and replaced before most fuses can be taken apart."
                                            },
                                            {
                                                "example_id": "63d2bf21-b684-4d45-b5af-f450937ab251",
                                                "sense_id": "3721b816-82ef-3e42-bb41-e5aeee1dda0e",
                                                "text": "It is a pretty safe bet that he can show you where you are using fuses of the wrong type (renewables for non-renewables and vice versa ) -or where fuses that ought to be good for twenty or more renewals are ready for the scrap"
                                            },
                                            {
                                                "example_id": "e64f9ee2-f881-42bd-8604-5cd32331c321",
                                                "sense_id": "3721b816-82ef-3e42-bb41-e5aeee1dda0e",
                                                "text": "Here is a newly designed All-Purpose Superfuse. Use it wherever you need One-Times, Renewables or Dual Element fuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
