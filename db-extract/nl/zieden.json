                    {
                        "sense_id": "288ef6bd-d2a5-3b63-a394-c5f69847c6af",
                        "entry_id": "f01418c8-a1bb-30f9-8bd9-47d3b0884934",
                        "glosses": [
                            "~ van [een (meestal negatieve) emotie]; hevig beroerd worden"
                        ],
                        "tags": [
                            "figuratively",
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "666c31b4-509e-4fc6-9627-b3cd5e1b9102",
                                "sense_id": "288ef6bd-d2a5-3b63-a394-c5f69847c6af",
                                "text": "Toen Agamemnon hem zijn beloofde krijgsbuit Bryseis onthield, ziedde Achilles van woede en trok zich terug in zijn tent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38ab62cd-9b76-45ea-a15c-d410362d0212",
                        "source_entry_id": "f01418c8-a1bb-30f9-8bd9-47d3b0884934",
                        "source_sense_id": "15a17e30-532a-3b30-91b9-efd3638ae9a4",
                        "source_sense_description": "koken",
                        "target_lang_word": "kochen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kochen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d87a4409-01e3-343a-a549-8153f262379a",
                                        "entry_id": "4552fb4e-d541-3624-9f9f-64c3bec19b56",
                                        "glosses": [
                                            "Lebensmittel unter Einwirkung von Hitze zu einer Mahlzeit zubereiten"
                                        ],
                                        "tags": [
                                            "Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e0dd3e-0eb3-46fb-b7a1-2f8e9370f745",
                                                "sense_id": "d87a4409-01e3-343a-a549-8153f262379a",
                                                "text": "Wir kochen uns eine Gemüsesuppe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b706eb20-aea7-3c73-adcf-141c39888e33",
                                        "entry_id": "4552fb4e-d541-3624-9f9f-64c3bec19b56",
                                        "glosses": [
                                            "Speisen (auch kalte) zubereiten"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9e0e06b-a127-4be7-a9a1-c9b0b0d56364",
                                                "sense_id": "b706eb20-aea7-3c73-adcf-141c39888e33",
                                                "text": "Susi kocht heute für uns."
                                            },
                                            {
                                                "example_id": "53709551-cd4b-41cf-ae25-9d0be6f15cff",
                                                "sense_id": "b706eb20-aea7-3c73-adcf-141c39888e33",
                                                "text": "Meine Oma konnte besser kochen als meine Mutter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f4a2b480-b273-3dba-afb6-ed50ca4b2345",
                                        "entry_id": "4552fb4e-d541-3624-9f9f-64c3bec19b56",
                                        "glosses": [
                                            "auf über 100 °C erhitzen, sieden"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e10d3ba5-d8b8-403a-836a-e6b559ab8c23",
                                                "sense_id": "f4a2b480-b273-3dba-afb6-ed50ca4b2345",
                                                "text": "Das Wasser für den Kaffee kocht bereits."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0db4617e-adba-3265-97ae-77e067120b8a",
                                        "entry_id": "4552fb4e-d541-3624-9f9f-64c3bec19b56",
                                        "glosses": [
                                            "Kleidungsstücke bei hohen Temperaturen (meist 95 °C) waschen"
                                        ],
                                        "tags": [
                                            "Textilreinigung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49a3d21b-96ad-4dc4-8308-3e42a7010af3",
                                                "sense_id": "0db4617e-adba-3265-97ae-77e067120b8a",
                                                "text": "Diese stark verschmutzte Wäsche musst du wohl kochen, um sie wieder einigermaßen sauber zu kriegen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a3653331-e1e0-3e94-8df6-e2eff26765c5",
                                        "entry_id": "4552fb4e-d541-3624-9f9f-64c3bec19b56",
                                        "glosses": [
                                            "sich in einem aufgebrachten Gemütszustand befinden"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c33fdae-6f5c-46d5-8c10-2fd6cead69ad",
                                                "sense_id": "a3653331-e1e0-3e94-8df6-e2eff26765c5",
                                                "text": "Sie kochte, als sie ihren Freund mit einer anderen ertappte."
                                            },
                                            {
                                                "example_id": "23365c0f-98f7-4c0a-b502-2600251f303a",
