                                "target_senses": [
                                    {
                                        "sense_id": "b6adde56-7d1d-3389-93bc-45ace716e53b",
                                        "entry_id": "f8e3e5f1-eeb6-3394-ae01-3fd345645862",
                                        "glosses": [
                                            "Qui a des pointes en forme de dents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c21211c-3158-45ae-8750-c9f30eed4d15",
                                                "sense_id": "b6adde56-7d1d-3389-93bc-45ace716e53b",
                                                "text": "Roue dentée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b8d285d-761e-3fca-a1ef-99082b1e9e2b",
                                        "entry_id": "f8e3e5f1-eeb6-3394-ae01-3fd345645862",
                                        "glosses": [
                                            "Dont le bord est découpé en pointes serrées les unes contre les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8875d17-ec0f-449c-8609-2918be3c636d",
                                                "sense_id": "6b8d285d-761e-3fca-a1ef-99082b1e9e2b",
                                                "text": "Sibbaldie, […]. Ce genre , qui est figuré pl. 221 des Illustrations de Lamarck, renferme des herbes à feuilles ternées, à folioles simples, dentées et découpées; à fleurs axillaires et terminales, quelquefois décagynes."
                                            },
                                            {
                                                "example_id": "2aca0908-e348-4e75-9b37-b01ea55cc5ee",
                                                "sense_id": "6b8d285d-761e-3fca-a1ef-99082b1e9e2b",
                                                "text": "[…], et dans ce cas, elles offrent tellement toutes les particularités propres aux feuilles, qu'on peut dire qu'elles ne sont que de petites feuilles accessoires, tantôt pétiolées, plus souvent sessiles, tantôt entières, tantôt dentées ou lobées, à nervures pennées ou palmées, etc.; mais on n'en trouve aucune qui soit ni composée, ni peltinerve, ni pédalinerve."
                                            },
                                            {
                                                "example_id": "4e90bd53-9ee7-4ac1-9c15-02f80792aa2b",
                                                "sense_id": "6b8d285d-761e-3fca-a1ef-99082b1e9e2b",
                                                "text": "Feuille dentée en scie, Feuille dont les dents sont dirigées, inclinées vers le sommet."
                                            },
                                            {
                                                "example_id": "86a2729c-0836-4568-afb4-84be1d6bd681",
                                                "sense_id": "6b8d285d-761e-3fca-a1ef-99082b1e9e2b",
                                                "text": "Les feuilles du pêcher, de l’amandier sont dentées en scie."
                                            }
                                        ]
                                    }
                                ]
                            },
