                    {
                        "sense_id": "a0c096e6-189a-34d0-b677-686368b5cfb7",
                        "entry_id": "90f0f4f1-05c8-3a6a-a483-f14a20ccb382",
                        "glosses": [
                            "Titre, l’état, la fonction d’une grand-mère."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5e3d3a3c-9fcb-4075-9be9-dfda26e8df5c",
                                "sense_id": "a0c096e6-189a-34d0-b677-686368b5cfb7",
                                "text": "Aimez-moi toujours, mon cher Comte : je vous quitte d’honorer ma grand’maternité ; mais il faut m’aimer, […]"
                            },
                            {
                                "example_id": "6aad70a7-04ae-445b-9dfd-bcb89cf7224e",
                                "sense_id": "a0c096e6-189a-34d0-b677-686368b5cfb7",
                                "text": "Pour moi je changeai de chemise et d’habit ; et, sans vanité, je me fis d’une beauté qui effaça entièrement mes belles-filles : l’honneur de la grand’maternité fut soutenu à merveilles."
                            },
                            {
                                "example_id": "cacbc7f4-666c-42ec-9d9e-7ac49b657369",
                                "sense_id": "a0c096e6-189a-34d0-b677-686368b5cfb7",
                                "text": "Ces évolutions nous contraindront, […], à nous interroger sur la nature, l’essence du lien de parentalité, de filiation, de paternité et de maternité, de grand-paternité et de grand-maternité."
                            }
                        ]
                    }
