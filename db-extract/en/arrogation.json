    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e0e7c95e-ed8d-30d0-ae54-73e4eb9d26b2",
                "word": "arrogation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "735a4c3a-364f-43b0-8acc-2387cc963aae",
                        "entry_id": "e0e7c95e-ed8d-30d0-ae54-73e4eb9d26b2",
                        "tags": [
                            "plural"
                        ],
                        "form": "arrogations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ec3d0683-2124-352a-b51e-9ca1a527b9d6",
                        "entry_id": "e0e7c95e-ed8d-30d0-ae54-73e4eb9d26b2",
                        "glosses": [
                            "The unjust assumption of rights or privilege."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "426745b5-0aa4-4bb1-a2bb-eb28c3879703",
                                "sense_id": "ec3d0683-2124-352a-b51e-9ca1a527b9d6",
                                "text": "The President's arrogation of this new Act oversteps his bounds and causes our rights to suffer."
                            },
                            {
                                "example_id": "17333ffa-7ff3-4285-81fb-ae9f8c926e56",
                                "sense_id": "ec3d0683-2124-352a-b51e-9ca1a527b9d6",
                                "text": "It condescended and/or pandered to so many for so long that even its old suburbanite subscribers must have begrudged it deep down, and those New Yorkers who know it love to hate it outright – for the arrogation of its New York as the New York, among other crimes: who are those people in the cartoons anyway?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e869ccc-e2d4-4401-a246-97848410c0cc",
                        "source_entry_id": "e0e7c95e-ed8d-30d0-ae54-73e4eb9d26b2",
                        "source_sense_id": "ec3d0683-2124-352a-b51e-9ca1a527b9d6",
                        "source_sense_description": "the unjust assumption of rights or privilege",
                        "target_lang_word": "Anmaßung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anmaßung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "669de83f-ce97-36f3-b45c-8b59c8279726",
                                        "entry_id": "85237c80-ca10-3fc5-8316-bb3fbf017522",
                                        "glosses": [
                                            "Angabe, Vorgabe von etwas, das man eigentlich nicht kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f92df0b9-d253-42da-b039-dc828179a511",
                                                "sense_id": "669de83f-ce97-36f3-b45c-8b59c8279726",
                                                "text": "Es war eine Anmaßung von ihm zu behaupten, er könne das in wenigen Tagen erledigen."
                                            },
                                            {
                                                "example_id": "ff402446-b6ed-43f6-98a0-578dbcac5e2b",
                                                "sense_id": "669de83f-ce97-36f3-b45c-8b59c8279726",
                                                "text": "„Ich hatte es sozusagen gelernt, wie man Ignoranz mit Anmaßung aufzäumt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0556919-7eef-36d6-a053-eceae0919bab",
                                        "entry_id": "85237c80-ca10-3fc5-8316-bb3fbf017522",
                                        "glosses": [
                                            "unberechtigte Inanspruchnahme von etwas, das einem nicht zusteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04492c9d-334c-452b-8e30-5ab0cbf5ea7e",
                                                "sense_id": "e0556919-7eef-36d6-a053-eceae0919bab",
                                                "text": "Seine Anmaßung, Arzt zu sein, obwohl er sein Studium abgebrochen hatte, brachte ihn ins Gefängnis."
                                            },
                                            {
                                                "example_id": "9538da31-4052-41f2-a049-0b94990e2f71",
                                                "sense_id": "e0556919-7eef-36d6-a053-eceae0919bab",
                                                "text": "„Mehrmals hielt man sie wegen ihres Aufzuges für Hausierer, und wenn sie geantwortet hatten, sie seien »Ingenieure«, überkam sie die Angst, die Anmaßung eines solchen Titels könnte ihnen Unannehmlichkeiten zuziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "83c588ea-1702-367a-a4e6-c81101895ed9",
                                        "entry_id": "85237c80-ca10-3fc5-8316-bb3fbf017522",
                                        "glosses": [
                                            "Überheblichkeit, Arroganz, Frechheit, Unverschämtheit"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
