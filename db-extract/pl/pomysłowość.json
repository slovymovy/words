                                "target_senses": [
                                    {
                                        "sense_id": "f63f210c-fc80-3c6b-8316-c8c7e4fe2b62",
                                        "entry_id": "815a905a-4428-3f08-afb0-6ca99a723df3",
                                        "glosses": [
                                            "The quality of being ingenious."
