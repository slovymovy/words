                "senses": [
                    {
                        "sense_id": "85951856-f904-3899-a7ef-1edc8a825ae8",
                        "entry_id": "52a56cc3-fed0-330f-925c-f27bd64c921b",
                        "glosses": [
                            "очаровать, покорить своим обаянием"
                        ],
                        "tags": [
                            "кого-что"
                        ],
                        "examples": [
                            {
                                "example_id": "a3e7351e-df04-4ea5-b9dc-ddb3d86c22a7",
                                "sense_id": "85951856-f904-3899-a7ef-1edc8a825ae8",
                                "text": "Но Севастьян-изограф, как человек рассудительный, обаял его мягкою речью…"
                            },
                            {
                                "example_id": "64b00151-a542-4605-98de-bc31aa4954a9",
                                "sense_id": "85951856-f904-3899-a7ef-1edc8a825ae8",
                                "text": "В жизни, бывает, надо покорять и обаять не одних женщин, а, к сожалению, и начальство, которого у нас много."
                            }
                        ]
                    }
