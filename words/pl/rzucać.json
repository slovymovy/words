    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e10d654-a87f-31df-a924-cb4ddb02d989",
                    "sense_definition": "Wykonywać ruch ręką, aby przedmiot poleciał w powietrze.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie <w>rzucaj</w> we mnie zabawkami.",
                            "target_lang_translations": {
                                "ru": "Не <w>бросай</w> в меня игрушками."
                            }
                        },
                        {
                            "text": "Dzieci lubią <w>rzucać</w> kamienie do wody.",
                            "target_lang_translations": {
                                "ru": "Дети любят <w>бросать</w> камни в воду."
                            }
                        }
                    ],
                    "synonyms": [
                        "ciskać",
                        "miotać"
                    ],
                    "common_phrases": [
                        "rzucać piłką"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать движение рукой, чтобы предмет полетел по воздуху."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "основное значение: придавать предмету скорость, заставляя его лететь"
                            },
                            {
                                "target_lang_word": "кидать",
                                "target_lang_sense_clarification": "синоним слова бросать, часто используется в разговорной речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9fb5087-c95c-3e33-bc8c-f983b40a09cc",
                    "sense_definition": "Przestać coś robić, zrezygnować z nałogu lub nawyku.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rezygnacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Od przyszłego miesiąca <w>rzucam</w> palenie.",
                            "target_lang_translations": {
                                "ru": "Со следующего месяца я <w>бросаю</w> курить."
                            }
                        },
                        {
                            "text": "<w>Rzucałem</w> palenie już kilka razy, ale zawsze wracałem do nałogu.",
                            "target_lang_translations": {
                                "ru": "Я уже несколько раз <w>бросал</w> курить, но всегда возвращался к этой привычке."
                            }
                        }
                    ],
                    "synonyms": [
                        "porzucać"
                    ],
                    "common_phrases": [
                        "rzucać palenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать что-либо делать, отказаться от вредной привычки или занятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "прекращать заниматься чем-либо, оставлять привычку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddfa7a6b-a9a7-3edd-a06c-b57de2f6dad1",
                    "sense_definition": "Zakończyć związek z drugą osobą.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rezygnacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ona ciągle <w>rzuca</w> chłopaków po kilku tygodniach.",
                            "target_lang_translations": {
                                "ru": "Она постоянно <w>бросает</w> парней через несколько недель."
                            }
                        },
                        {
                            "text": "Nie chcę <w>rzucać</w> chłopaka, którego kocham.",
                            "target_lang_translations": {
                                "ru": "Я не хочу <w>бросать</w> парня, которого люблю."
                            }
                        }
                    ],
                    "synonyms": [
                        "zerwać",
                        "dać kosza"
                    ],
                    "common_phrases": [
                        "rzucać kogoś"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закончить романтические отношения с другим человеком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "покидать, оставлять партнера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5107011f-bee6-3c97-b811-f8e2939cdae6",
                    "sense_definition": "Zrezygnować z nauki lub pracy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rezygnacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielu studentów <w>rzuca</w> studia już po pierwszym roku.",
                            "target_lang_translations": {
                                "ru": "Многие студенты <w>бросают</w> учёбу уже после первого курса."
                            }
                        },
                        {
                            "text": "Nie warto <w>rzucać</w> pracy bez planu na przyszłość.",
                            "target_lang_translations": {
                                "ru": "Не стоит <w>бросать</w> работу без плана на будущее."
                            }
                        }
                    ],
                    "synonyms": [
                        "porzucać"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отказаться от учебы или работы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "прекращать учебу или работу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4313f43-1ced-3650-b230-2a591ff2918f",
                    "sense_definition": "Wydalać zawartość żołądka przez usta.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "zdrowie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po zjedzeniu nieświeżej ryby całą noc <w>rzucał</w> pawia.",
                            "target_lang_translations": {
                                "ru": "Съев несвежую рыбу, он всю ночь <w>блевал</w>."
                            }
                        },
                        {
                            "text": "Po imprezie połowa gości <w>rzucała</w> pawia w łazience.",
                            "target_lang_translations": {
                                "ru": "После вечеринки половину гостей <w>рвало</w> в ванной."
                            }
                        }
                    ],
                    "synonyms": [
                        "wymiotować"
                    ],
                    "target_lang_definitions": {
                        "ru": "Извергать содержимое желудка через рот."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рвать",
                                "target_lang_sense_clarification": "разговорный эквивалент слова 'тошнить' или 'вызывать рвоту'"
                            },
                            {
                                "target_lang_word": "вырвать",
                                "target_lang_sense_clarification": "совершенный вид, означающий однократный акт рвоты"
                            },
                            {
                                "target_lang_word": "блевать",
                                "target_lang_sense_clarification": "грубое, разговорное"
                            }
                        ]
                    },
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "potoczne: rzucać pawia"
                        }
                    ]
                }
            ]
        }
    ]
