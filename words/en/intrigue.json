{
    "word_family": [
        "intriguer",
        "intriguing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eeb61f8f-03a7-3bff-b199-99cb63217e60",
                    "sense_definition": "To arouse the curiosity or interest of someone.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mysterious message <w>intrigued</w> the detective.",
                            "target_lang_translations": {
                                "de": "Die geheimnisvolle Nachricht <w>faszinierte</w> den Detektiv."
                            }
                        },
                        {
                            "text": "The strange behavior of the neighbors <w>intrigues</w> everyone on the street.",
                            "target_lang_translations": {
                                "de": "Das seltsame Verhalten der Nachbarn <w>interessiert</w> jeden in der Straße."
                            }
                        }
                    ],
                    "synonyms": [
                        "fascinate",
                        "interest",
                        "captivate"
                    ],
                    "antonyms": [
                        "bore"
                    ],
                    "common_phrases": [
                        "highly intrigued"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Neugier oder das Interesse von jemandem wecken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "faszinieren",
                                "target_lang_sense_clarification": "eine fesselnde Wirkung auf jemanden haben"
                            },
                            {
                                "target_lang_word": "interessieren",
                                "target_lang_sense_clarification": "das Interesse von jemandem erregen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99cdc0ec-cf5f-3fe0-b664-c2ad7c9b82f6",
                    "sense_definition": "To secretly plan or scheme, often with the intent to harm or deceive.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "conspiracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The advisors began to <w>intrigue</w> against the king to seize power.",
                            "target_lang_translations": {
                                "de": "Die Berater begannen, gegen den König zu <w>intrigieren</w>, um die Macht zu ergreifen."
                            }
                        },
                        {
                            "text": "They spent the night <w>intriguing</w> to undermine their rivals.",
                            "target_lang_translations": {
                                "de": "Sie verbrachten die Nacht damit, <w>Ränke zu schmieden</w>, um ihre Rivalen zu untergraben."
                            }
                        }
                    ],
                    "synonyms": [
                        "conspire",
                        "plot",
                        "scheme"
                    ],
                    "target_lang_definitions": {
                        "de": "Heimlich planen oder Ränke schmieden, oft mit der Absicht, anderen zu schaden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "intrigieren",
                                "target_lang_sense_clarification": "Ränke schmieden, um anderen zu schaden"
                            },
                            {
                                "target_lang_word": "konspirieren",
                                "target_lang_sense_clarification": "sich heimlich gegen jemanden verschwören"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5768d75-c14f-3f27-8cc6-6d609ac6293f",
                    "sense_definition": "To engage in a secret or illicit romantic affair.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "affair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal revealed that the two had been <w>intriguing</w> for months.",
                            "target_lang_translations": {
                                "de": "Der Skandal enthüllte, dass die beiden seit Monaten eine <w>Affäre hatten</w>."
                            }
                        },
                        {
                            "text": "He was known to <w>intrigue</w> with various socialites behind his wife's back.",
                            "target_lang_translations": {
                                "de": "Es war bekannt, dass er hinter dem Rücken seiner Frau <w>Affären</w> mit verschiedenen Damen der Gesellschaft hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "philander"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine geheime oder unerlaubte romantische Affäre führen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "eine Affäre haben",
                                "target_lang_sense_clarification": "eine heimliche Liebesbeziehung führen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0677dc4e-5f0e-3d86-a57b-39ea6ce74097",
                    "sense_definition": "To make a situation complex or difficult to understand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "complicate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new regulations only serve to <w>intrigue</w> the legal process further.",
                            "target_lang_translations": {
                                "de": "Die neuen Vorschriften dienen nur dazu, den rechtlichen Prozess weiter zu <w>verkomplizieren</w>."
                            }
                        },
                        {
                            "text": "His constant lies <w>intrigued</w> the simple matter into a confusing mess.",
                            "target_lang_translations": {
                                "de": "Seine ständigen Lügen <w>verkomplizierten</w> die einfache Angelegenheit zu einem verwirrenden Durcheinander."
                            }
                        }
                    ],
                    "synonyms": [
                        "complicate",
                        "perplex"
                    ],
                    "antonyms": [
                        "simplify"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Situation komplex oder schwer verständlich machen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verkomplizieren",
                                "target_lang_sense_clarification": "etwas schwieriger oder komplexer machen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "513d773f-7a4b-326a-8af5-522fb04d01f5",
                    "sense_definition": "A secret plan or scheme, often involving deception or conspiracy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conspiracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The palace was filled with political <w>intrigues</w> and power struggles.",
                            "target_lang_translations": {
                                "de": "Der Palast war erfüllt von politischen <w>Intrigen</w> und Machtkämpfen."
                            }
                        },
                        {
                            "text": "She was tired of the constant <w>intrigue</w> surrounding the office promotion.",
                            "target_lang_translations": {
                                "de": "Sie war die ständigen <w>Ränkespiele</w> rund um die Beförderung im Büro leid."
                            }
                        }
                    ],
                    "synonyms": [
                        "conspiracy",
                        "plot",
                        "scheme"
                    ],
                    "common_phrases": [
                        "political intrigue"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein geheimer Plan oder Ränkespiel, oft mit Täuschung oder Verschwörung verbunden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Intrige",
                                "target_lang_sense_clarification": "bösartiger Plan, um andere zu benachteiligen"
                            },
                            {
                                "target_lang_word": "Ränkespiel",
                                "target_lang_sense_clarification": "ein komplexes Geflecht aus geheimen Machenschaften"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "394fe71d-5a19-3420-9138-ac083e0bec4a",
                    "sense_definition": "A secret or illicit romantic relationship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "affair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tabloid published details about his secret <w>intrigue</w> with the actress.",
                            "target_lang_translations": {
                                "de": "Die Boulevardzeitung veröffentlichte Details über seine geheime <w>Affäre</w> mit der Schauspielerin."
                            }
                        },
                        {
                            "text": "Their short-lived <w>intrigue</w> caused a major scandal in the small town.",
                            "target_lang_translations": {
                                "de": "Ihre kurzlebige <w>Liebschaft</w> verursachte einen großen Skandal in der Kleinstadt."
                            }
                        }
                    ],
                    "synonyms": [
                        "affair",
                        "liaison"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine geheime oder unerlaubte romantische Beziehung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Affäre",
                                "target_lang_sense_clarification": "eine heimliche Liebesbeziehung"
                            },
                            {
                                "target_lang_word": "Liebschaft",
                                "target_lang_sense_clarification": "eine oft kurzzeitige oder heimliche romantische Verbindung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91459726-4891-38c0-a378-b5300d08bd9e",
                    "sense_definition": "The complex plot or series of events in a story or play.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "plot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel features a complex <w>intrigue</w> that keeps the reader guessing.",
                            "target_lang_translations": {
                                "de": "Der Roman bietet eine komplexe <w>Handlung</w>, die den Leser im Ungewissen lässt."
                            }
                        },
                        {
                            "text": "The play's <w>intrigue</w> revolves around a hidden inheritance.",
                            "target_lang_translations": {
                                "de": "Die <w>Handlung</w> des Stücks dreht sich um ein verstecktes Erbe."
                            }
                        }
                    ],
                    "synonyms": [
                        "plot",
                        "storyline"
                    ],
                    "target_lang_definitions": {
                        "de": "Die komplexe Handlung oder Abfolge von Ereignissen in einer Geschichte oder einem Theaterstück."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Handlung",
                                "target_lang_sense_clarification": "der inhaltliche Ablauf eines Werkes"
                            },
                            {
                                "target_lang_word": "Handlungsgeflecht",
                                "target_lang_sense_clarification": "eine komplexe, verwobene Geschichte"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}