                                        "entry_id": "1d03d156-e580-39c1-8c99-df77639bc05b",
                                        "glosses": [
                                            "A potter's shop or workshop, where pottery is made."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "250a583e-320e-46c3-b0d6-4dc3d2f8606f",
                                                "sense_id": "ad8a199a-f089-376d-831d-7ea69199e67a",
                                                "text": "I visited the old potteries and saw the pots being made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f68596a9-a8b8-3772-9951-bf54dde9fbac",
