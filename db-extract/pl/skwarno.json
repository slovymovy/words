                                                "example_id": "09086d10-f4e8-4620-9444-6fedad305ad6",
                                                "sense_id": "85e73c3a-caca-3463-9df2-0d615baffe37",
                                                "text": "Ein tropisches Jahr (Sonnenjahr) dauert 365,242 Tage."
                                            },
                                            {
                                                "example_id": "ae17935a-4bb5-4aaa-a969-ae4bbaa2f5a3",
                                                "sense_id": "85e73c3a-caca-3463-9df2-0d615baffe37",
                                                "text": "„Etwa 20 Minuten kürzer als das Sternjahr, umfaßt dieser Zeitraum (tropisches oder Sonnenjahr) 365 Tage, 5 Stunden, 48 Minuten und 45,975 Sekunden.“"
                                            }
                                        ],
