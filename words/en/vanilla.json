    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e48106c2-9c75-3408-b0e4-b95bd7f22a24",
                    "sense_definition": "The distinctive fragrant flavor or scent characteristic of vanilla extract.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "flavor_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love the sweet smell of <w>vanilla</w> in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Я обожаю сладкий запах <w>ванили</w> на кухне.",
                                "zh": "我喜欢厨房里那股甜甜的<w>香草</w>味。"
                            }
                        },
                        {
                            "text": "You can really taste the <w>vanilla</w> in this custard.",
                            "target_lang_translations": {
                                "ru": "В этом заварном креме действительно чувствуется <w>ваниль</w>.",
                                "zh": "在这份卡仕达酱里真的能尝出<w>香草</w>味。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный ароматный вкус или запах ванили.",
                        "zh": "香草特有的芳香味道或气味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ваниль",
                                "target_lang_sense_clarification": "пряность, вкус или запах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "香草",
                                "target_lang_sense_clarification": "香料、味道或气味"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7461da52-094f-37ea-9ada-ea53e6e04943",
                    "sense_definition": "A liquid extract obtained from vanilla beans, used in cooking and baking.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "flavor_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe calls for a teaspoon of pure <w>vanilla</w>.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется чайная ложка чистой <w>ванили</w>.",
                                "zh": "食谱里需要一茶匙纯<w>香草精</w>。"
                            }
                        },
                        {
                            "text": "She added a drop of <w>vanilla</w> to the batter for extra flavor.",
                            "target_lang_translations": {
                                "ru": "Она добавила каплю <w>ванили</w> в тесто для аромата.",
                                "zh": "她在面糊里加了一滴<w>香草精</w>来增加风味。"
                            }
