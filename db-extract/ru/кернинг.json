                "senses": [
                    {
                        "sense_id": "cd0fddee-92ef-3c01-8164-00d7370b9630",
                        "entry_id": "a044651c-41d3-38e4-8896-924c099e5aa6",
                        "glosses": [
                            "полигр. изменение интервала между буквами в зависимости от их формы для улучшения внешнего вида и удобочитаемости текста"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3df3111e-7d45-40ed-8c77-dfcdcbaeacb7",
                                "sense_id": "cd0fddee-92ef-3c01-8164-00d7370b9630",
                                "text": "Обычно кернинг выполняется программой верстки или наборной системой автоматически."
                            },
                            {
                                "example_id": "9e2e6de1-8201-4a63-ac90-940f0d8191cb",
                                "sense_id": "cd0fddee-92ef-3c01-8164-00d7370b9630",
                                "text": "Подобно этому кнопки со стрелками «влево» и «вправо» позволяют изменять кернинг, если курсор располагается между двумя символами."
                            }
                        ]
                    }
