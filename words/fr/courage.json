        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f73036f8-1f06-3230-94a8-2b5fe9550e91",
                    "sense_definition": "Exclamation employée pour inciter à la persévérance, consoler ou stimuler quelqu'un face à une difficulté.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne baissez pas les bras maintenant, <w>courage</w>, vous y êtes presque !",
                            "target_lang_translations": {
                                "en": "Don't give up now, <w>hang in there</w>, you're almost there!",
                                "ru": "Не опускайте руки сейчас, <w>держитесь</w>, вы почти у цели!",
                                "nl": "Geef het nu niet op, <w>hou vol</w>, je bent er bijna!",
                                "de": "Geben Sie jetzt nicht auf, <w>Kopf hoch</w>, Sie sind fast am Ziel!",
                                "pl": "Nie poddawajcie się teraz, <w>trzymajcie się</w>, jesteście już prawie na miejscu!",
                                "it": "Non mollate adesso, <w>tenete duro</w>, ci siete quasi!",
                                "cs": "Nevzdávejte to teď, <w>hlavu vzhůru</w>, jste skoro u cíle!",
                                "tr": "Şimdi pes etmeyin, <w>dayanın</w>, neredeyse hedefe ulaştınız!",
                                "es": "¡No se rindan ahora, <w>ánimo</w>, ya casi llegan!",
                                "zh": "现在千万别放弃，<w>加油</w>，你们就快到了！"
                            }
                        },
                        {
                            "text": "Allons, <w>courage</w>, cet examen difficile sera bientôt terminé pour vous.",
                            "target_lang_translations": {
                                "en": "Come on, <w>chin up</w>, this tough exam will be over soon for you.",
                                "ru": "Ну же, <w>крепитесь</w>, этот трудный экзамен скоро для вас закончится.",
                                "nl": "Kom, <w>kop op</w>, dit moeilijke examen is voor jou gauw voorbij.",
                                "de": "Na, <w>nur Mut</w>, diese schwere Prüfung ist für Sie bald vorbei.",
                                "pl": "No, <w>głowa do góry</w>, ten trudny egzamin wkrótce się dla was skończy.",
                                "it": "Dai, <w>coraggio</w>, questo esame difficile finirà presto per voi.",
                                "cs": "No tak, <w>kuráž</w>, ta těžká zkouška pro vás brzy skončí.",
                                "tr": "Hadi, <w>başınızı dik tutun</w>, bu zor sınav sizin için yakında bitecek.",
                                "es": "Vamos, <w>ánimo</w>, pronto se acabará este examen tan difícil para ustedes.",
                                "zh": "来，<w>挺住</w>，这场艰难的考试很快就要结束了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bon courage"
                    ],
                    "target_lang_definitions": {
                        "en": "An exclamation used to encourage someone to persevere, or to comfort or spur them on through a difficulty.",
                        "ru": "Восклицание, которым подбадривают человека, призывая его стойко держаться в трудной ситуации.",
                        "nl": "Uitroep om iemand aan te moedigen door te zetten, te troosten of op te beuren bij moeilijkheden.",
                        "de": "Ausruf, mit dem man jemanden zum Durchhalten ermutigt oder ihm in einer Schwierigkeit Trost spendet.",
                        "pl": "Wykrzyknienie wypowiadane, by zachęcić kogoś do wytrwania albo pocieszyć go w trudnej chwili.",
                        "it": "Esclamazione usata per esortare qualcuno a non arrendersi o per consolarlo e sostenerlo di fronte a una difficoltà.",
                        "cs": "Citoslovce, kterým se někoho povzbuzuje k vytrvání nebo se ho utěšuje v těžké chvíli.",
