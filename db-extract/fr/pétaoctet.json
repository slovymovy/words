                    {
                        "sense_id": "4b197fde-f62d-3148-9f35-f86a7b941ced",
                        "entry_id": "17ee3f52-e784-3a4f-b100-4b3eaa115a54",
                        "glosses": [
                            "Unité de mesure de quantité d’information numérique, valant 10¹⁵ octets, et dont le symbole est Po."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8464db0-26f2-4686-836f-c5c964285a2e",
                                "sense_id": "4b197fde-f62d-3148-9f35-f86a7b941ced",
                                "text": "Un pétabyte (ou pétaoctet) correspond au contenu d’environ un milliard de livres."
                            },
                            {
                                "example_id": "121843fc-b1c1-428c-bc69-03cd5e0be381",
                                "sense_id": "4b197fde-f62d-3148-9f35-f86a7b941ced",
                                "text": "[…] le texte de l’ensemble des ouvrages imprimés de la Bibliothèque nationale de France tient sur 14 millions de millions d’octets, c’est-à-dire sur 14 téraoctets, en abrégé 14 To. Or, aujourd’hui on stocke et on traite des pétaoctets qui correspondent à des milliers de téraoctets, c’est-à-dire à des centaines de Bibliothèques nationales de France."
                            }
                        ]
                    }
