                "senses": [
                    {
                        "sense_id": "6fa36229-07ae-3bc6-a72f-b4095a973917",
                        "entry_id": "acc63c39-1482-3d05-b660-7cc59b505555",
                        "glosses": [
                            "een tocht waarbij geklommen wordt or moet worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46b394c2-b844-4ccf-9b99-356ed4acaa74",
                                "sense_id": "6fa36229-07ae-3bc6-a72f-b4095a973917",
                                "text": "Hoe bereken je hoe steil een klim is?"
                            },
                            {
                                "example_id": "96835f46-9b03-4ed0-a2ad-b88c41eb1629",
                                "sense_id": "6fa36229-07ae-3bc6-a72f-b4095a973917",
                                "text": "Na een pittige klim volgt een hoogvlakte vol akkers en boerderijen."
                            },
                            {
                                "example_id": "d735520f-b83f-4734-b830-df4777be0c5e",
                                "sense_id": "6fa36229-07ae-3bc6-a72f-b4095a973917",
                                "text": "Na wat virtuele kusjes verbreken we de verbinding en hervat ik mijn klim Hijgend bereik ik spoor 3a."
                            },
                            {
                                "example_id": "2ead6763-e50c-46e3-9f24-788f2870c910",
                                "sense_id": "6fa36229-07ae-3bc6-a72f-b4095a973917",
                                "text": "Toen het vlakke plateau overging in een lange steile klim, volgden we ontelbare haarspeldbochten de rotswand op."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
