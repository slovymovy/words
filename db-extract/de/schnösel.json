                    {
                        "sense_id": "cc61b7f4-fdd1-3b67-9ed9-2676af7da971",
                        "entry_id": "2440881c-7591-376a-90dd-b7de25b8de3d",
                        "glosses": [
                            "a young man who is brash and presumptuous"
                        ],
                        "tags": [
