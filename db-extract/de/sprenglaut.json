                "senses": [
                    {
                        "sense_id": "fd979d78-b709-308e-ac07-8100187b39e0",
                        "entry_id": "36f03772-0b8b-3e84-86f6-3964ecc243db",
                        "glosses": [
                            "deutsche Bezeichnung für Explosiv, Verschlusslaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8709abf1-fe24-4326-ac94-46552ae5d5e5",
                                "sense_id": "fd979d78-b709-308e-ac07-8100187b39e0",
                                "text": "In dem Wort „Direktor“ kommen drei Sprenglaute vor: [d], [k] und [t]."
                            },
                            {
                                "example_id": "0f69058f-1ef4-4d08-a44c-59d0c40e8830",
                                "sense_id": "fd979d78-b709-308e-ac07-8100187b39e0",
                                "text": "In der Linguistik werden die Sprenglaute in der Regel mit „Explosiv“ oder „Verschlusslaut“ bezeichnet."
                            },
                            {
                                "example_id": "01d1eba5-4bf3-4a8d-8b58-a4f1e2758b09",
                                "sense_id": "fd979d78-b709-308e-ac07-8100187b39e0",
                                "text": "„Ein Plosiv wird durch zwei Phasen gebildet: Einen Verschluss und dessen Lösung mit einem Plosivgeräusch (daher auch Verschlusslaut oder Sprenglaut).“"
                            },
                            {
                                "example_id": "3a5f003e-cf49-42b3-95e0-830fcd81041b",
                                "sense_id": "fd979d78-b709-308e-ac07-8100187b39e0",
                                "text": "„Die Korrelationsanalyse kann beispielsweise eine Formant-Analyse, eine Sprenglaut-Analyse oder Zischlaut-Analyse miteinschließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
