                        "glosses": [
                            "Membre d’une communauté de pêcheurs et agriculteurs concentrés dans la presqu’île du Cap-Vert à Dakar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dc70b6d-68f6-465f-923e-6c1ea45995ad",
                                "sense_id": "8cf494d5-7b16-3dc3-8bc6-fc546bc37c33",
                                "text": "Yoff, village traditionnel, fief des Lébou, peuple de pêcheurs autochtones de Dakar, il est 11 heures.' — (Amadou Ndiaye, « Plus belle la vie… au Sénégal », Le Monde.fr, 5 juillet 2016)"
                            },
                            {
                                "example_id": "799237d1-cbf8-441a-864b-2caa8684b917",
                                "sense_id": "8cf494d5-7b16-3dc3-8bc6-fc546bc37c33",
                                "text": "Les Lébous, membres de l’ethnie autochtone, le croient bienfaisant, au contraire de ses enfants, malfaisants."
                            }
                        ]
