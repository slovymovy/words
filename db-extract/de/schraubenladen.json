                        "glosses": [
                            "Geschäft, das Schrauben (und womöglich verwandte Dinge) führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15ca4d2c-abf5-489e-8e90-ecf52cc3e45d",
                                "sense_id": "9efd0e02-07b9-37eb-80cd-88a62334ce7b",
                                "text": "„Im Schraubenladen konnte man die Schrauben noch einzeln kaufen und gleich wieder umtauschen, wenn sie nicht passten.“"
                            }
