                                                "sense_id": "b6c2526b-9f60-3649-b951-bb09361bdf5d",
                                                "text": "Císařovna Marie Terezie rozhodla o povinné imatrikulaci všech hospodářských úředníků."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7133e719-2541-3083-aecd-22e917305395",
                                        "entry_id": "77420fab-fd84-3f72-a1df-f277e95da5e5",
                                        "glosses": [
                                            "slavnostní akt složení akademického slibu studentů vysokých škol"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64efa5c1-428d-47a2-8459-4e06deaf1c0f",
                                                "sense_id": "7133e719-2541-3083-aecd-22e917305395",
                                                "text": "V pátek se koná slavnostní imatrikulace studentů prvního ročníku."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27c67e87-e037-3f5a-b5c6-d86d9ea867de",
                                        "entry_id": "77420fab-fd84-3f72-a1df-f277e95da5e5",
