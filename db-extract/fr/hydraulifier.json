                "senses": [
                    {
                        "sense_id": "6e87a9e7-2f85-362e-bbd1-95ce495b597f",
                        "entry_id": "e9563af9-2687-3f6d-87ec-6d1b5096873f",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e53e0c9e-c4cc-4f44-be50-b58075ecd618",
                                "sense_id": "6e87a9e7-2f85-362e-bbd1-95ce495b597f",
                                "text": "Berthaut Ducreux, a proposé l’emploi des silicéo-calcaires tels que le calcaire de Senonches comme pouzzolane assez énergique. La silice gélatineuse de ces calcaires les rend, en effet, propres à silicater et à hydraulifier la chaux grasse."
                            }
                        ]
                    },
                    {
                        "sense_id": "673b7efe-cfc3-3224-b78a-c74b1c7dcfd4",
                        "entry_id": "e9563af9-2687-3f6d-87ec-6d1b5096873f",
                        "glosses": [
                            "Rendre hydraulique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92e81bd-811c-4364-aa5d-4a1d9c536020",
                                "sense_id": "673b7efe-cfc3-3224-b78a-c74b1c7dcfd4",
                                "text": "Jeu de chapes pour hydraulifier un niveleur: chapes pour le cylindre de plateau; chapes pour le cylindre de lèvre; chape support pour groupe hydraulique."
                            },
                            {
                                "example_id": "7ea00e63-cb2f-450f-b4a0-97c2d006bce1",
                                "sense_id": "673b7efe-cfc3-3224-b78a-c74b1c7dcfd4",
                                "text": "En hydraulifiant vos anciens niveleurs mécaniques encore en bon état, vous augmentez la sécurité de votre personnel et l’efficacité de son travail."
                            }
                        ]
                    }
                ],
