                "senses": [
                    {
                        "sense_id": "79dc5420-0f66-3fac-a0fe-c60e99bf8747",
                        "entry_id": "50618df0-f65e-3543-a7ab-08c9179b7fe3",
                        "glosses": [
                            "Haltung zu politischen Fragestellungen, wie sie die aktuelle Regierung oder auch die herrschende Klasse vertritt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "b1ae34c2-63ac-4cbb-b06a-1e82ef4b2516",
                                "sense_id": "79dc5420-0f66-3fac-a0fe-c60e99bf8747",
                                "text": "„Viele Menschen würden Nachrichten als Fake News wahrnehmen, weil diese Nachrichten nicht den eigenen Erwartungen entsprächen oder als \"Systemmeinung\" und als \"Produkt der Lügenpresse\" abgestempelt werden würden.“"
                            },
                            {
                                "example_id": "4e7eef47-4611-4da3-a8e1-7e9493c609d8",
                                "sense_id": "79dc5420-0f66-3fac-a0fe-c60e99bf8747",
                                "text": "„Talkshows werden grundsätzlich so zusammengesetzt, dass ein oder zwei Kandidaten der „Gegenmeinung“ auf drei, vier Vertreter der „Systemmeinung“ treffen. “"
                            },
                            {
                                "example_id": "8a25adcd-bd0e-4e8e-8904-c87d497f5c10",
                                "sense_id": "79dc5420-0f66-3fac-a0fe-c60e99bf8747",
                                "text": "„Die nächsten Eskalationsstufen sind mit Sicherheit längst in Planung, wie z.B. die Verfolgung und Bestrafung bzw. Verhaftung aller Bürger mit von der Systemmeinung abweichender Meinung, die Christenverfolgung und vieles mehr.“"
                            },
                            {
                                "example_id": "4ee7e50b-a094-4b3d-b45c-72bdfdb2987a",
                                "sense_id": "79dc5420-0f66-3fac-a0fe-c60e99bf8747",
                                "text": "„Zweifeln Sie die Systemmeinung an und gehen nicht konform?“"
                            },
                            {
                                "example_id": "df8618ae-3b8f-4d33-a662-b82375349d6a",
                                "sense_id": "79dc5420-0f66-3fac-a0fe-c60e99bf8747",
                                "text": "„Auch müssten alle zigtausenden Artikel, Kommentare und Fernsehbeiträge von ChefredakteurInnen [sic] auf eine Systemmeinung getrimmt werden“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
