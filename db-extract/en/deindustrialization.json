    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9e77b125-51e6-3957-af05-f3a64d21f565",
                "word": "deindustrialization",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "242851d9-7d94-4d4e-88dc-d8bd5e069b50",
