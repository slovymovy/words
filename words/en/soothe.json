{
    "word_family": [
        "soother",
        "soothingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5fe6f023-18cd-3748-845c-37f33e4eb5cc",
                    "sense_definition": "To make someone feel calmer and less anxious or upset.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother sang a soft lullaby to <w>soothe</w> her crying baby.",
                            "target_lang_translations": {
                                "cs": "Matka zpívala jemnou ukolébavku, aby <w>uklidnila</w> své plačící dítě."
                            }
                        },
                        {
                            "text": "A warm bath can <w>soothe</w> your nerves after a long day.",
                            "target_lang_translations": {
                                "cs": "Teplá koupel může po dlouhém dni <w>zklidnit</w> vaše nervy."
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "pacify",
                        "lull"
                    ],
                    "common_phrases": [
                        "soothe nerves",
                        "soothe baby"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, že se někdo cítí klidnější a méně úzkostný nebo rozrušený."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "uklidnit",
                                "target_lang_sense_clarification": "uvést někoho do stavu klidu"
                            },
                            {
                                "target_lang_word": "konejšit",
                                "target_lang_sense_clarification": "přivádět ke klidu někoho, kdo pláče nebo je rozrušený"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f7dac1c-09ee-3bae-b1e7-ce6629f4d393",
                    "sense_definition": "To reduce or remove physical pain or discomfort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This cream will <w>soothe</w> the itching caused by the insect bite.",
                            "target_lang_translations": {
                                "cs": "Tento krém <w>uleví</w> od svědění způsobeného bodnutím hmyzem."
                            }
                        },
                        {
                            "text": "Drinking herbal tea helps to <w>soothe</w> a sore throat.",
                            "target_lang_translations": {
                                "cs": "Pití bylinkového čaje pomáhá <w>zklidnit</w> bolest v krku."
                            }
                        }
                    ],
                    "synonyms": [
                        "assuage",
                        "relieve",
                        "comfort"
                    ],
                    "common_phrases": [
                        "soothe pain",
                        "soothe troubles"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zmírnit nebo odstranit fyzickou bolest či nepohodlí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ulevit",
                                "target_lang_sense_clarification": "zmenšit fyzické či duševní obtíže"
                            },
                            {
                                "target_lang_word": "zklidnit",
                                "target_lang_sense_clarification": "zmírnit podráždění nebo bolest"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}