                "senses": [
                    {
                        "sense_id": "bdf26a2d-4332-3289-b463-c9c44acaa4cb",
                        "entry_id": "c30adb80-d50d-3726-90d0-7434ffd0cfce",
                        "glosses": [
                            "mit abgeschlossener Lehre (Handwerksausbildung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b675aaf-e5e5-409e-92b0-56bfd141e6e7",
                                "sense_id": "bdf26a2d-4332-3289-b463-c9c44acaa4cb",
                                "text": "„Als ich siebzehn war, war ich ausgelernt, als mein Vater siebzehn war, war er ausgelernt, auch mein Großvater war mit siebzehn ausgelernt gewesen, auch mein Sohn.“"
                            },
                            {
                                "example_id": "55b772a2-0809-4a0c-852a-ef6eea275d56",
                                "sense_id": "bdf26a2d-4332-3289-b463-c9c44acaa4cb",
                                "text": "„Daran teilnehmen durften hier nicht nur Lehrlinge, sondern auch ausgelernte Köche – einzige Bedingung: Sie dürfen nicht älter als 26 sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
