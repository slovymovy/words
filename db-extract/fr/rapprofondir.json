                ],
                "senses": [
                    {
                        "sense_id": "03a44283-a3be-3009-8ee4-59f6ca0cc1b4",
                        "entry_id": "dde44e9c-c5c1-3cbd-8b31-4605fea2fc9f",
                        "glosses": [
                            "Approfondir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31ee7670-38c5-4c59-9ff9-e94340d42187",
                                "sense_id": "03a44283-a3be-3009-8ee4-59f6ca0cc1b4",
                                "text": "Avant de semer, on rapprofondit la raie par un trait de charrue, et on y sème les pommes de terre à seize ou dix-huit pouces de distance l'une de l'autre."
                            },
                            {
                                "example_id": "cae22e59-2cca-4f21-a97e-3f6efd5af959",
                                "sense_id": "03a44283-a3be-3009-8ee4-59f6ca0cc1b4",
                                "text": "Je le répète, je ne rapprofondis pas ; mais je dis que ce n'est pas le moment, et que ce n'était pas le moment pour un ministère nouveau, de faire appel à des dévouements civils quand les dévouements militaires avaient montré si récemment de quelles grandes choses ils étaient capables."
                            }
                        ]
                    }
                ],
