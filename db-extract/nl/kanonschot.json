                            {
                                "example_id": "c81dfe4a-6488-40f8-9902-30ba535b5e98",
                                "sense_id": "dd2c1446-6e80-3657-83df-f12a7d34cc9d",
                                "text": "Oorlogszuchtige muziek? In ieder geval muziek, opgedragen aan vechtersbazen. Crescendo Neede, Amicitia Rietmolen en leden van Concordia Noordijk bezorgden enkele honderden zaterdagavond onder zomers omstandigheden de 'Slag om Neede'. Met als klapstuk - letterlijk - een kanonschot in Tsjaikovski's 'Ouverture 1812'."
                            },
                            {
                                "example_id": "cd4f44d9-7c07-4a21-a722-71bec3d1d443",
                                "sense_id": "dd2c1446-6e80-3657-83df-f12a7d34cc9d",
                                "text": "Volgens plaatselijke media worden er dit jaar in Windsor op 21 april geen 21 kanonschoten afgeschoten te ere van de jarige vorstin, omdat het Pasen is. Dat eerbetoon is naar maandag verplaatst."
                            }
                        ]
                    }
