                                        "sense_id": "ef36922f-c5f5-3a8f-8999-ec335433156b",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
                                        "glosses": [
                                            "The leaves of the mustard plant, used as a salad."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
