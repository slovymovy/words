                    },
                    {
                        "translation_id": "edfec32b-f95a-41d8-950e-9fab934a7256",
                        "source_entry_id": "a887dec4-504b-3a17-8299-5e2fbc87a118",
                        "source_sense_id": "21fe49c8-0c26-3574-973b-119055043c51",
                        "target_lang_word": "colossus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colossus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "075f8d94-289a-3be7-be7a-7b35d325ce91",
                                        "entry_id": "35d9a6f4-bf94-3e6a-a4d0-da71056f06b5",
                                        "glosses": [
                                            "A statue of gigantic size. The name was especially applied to certain famous statues in antiquity, as the Colossus of Nero in Rome and the Colossus of Rhodes, one of the Seven Wonders of the Ancient World."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0112890-415a-3b45-9135-d7e6cb822753",
                                        "entry_id": "35d9a6f4-bf94-3e6a-a4d0-da71056f06b5",
                                        "glosses": [
                                            "Any creature or thing of gigantic size."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1642d7d-40fe-48bb-b2d3-befd19ad129a",
                                                "sense_id": "c0112890-415a-3b45-9135-d7e6cb822753",
                                                "text": "[\"]The Empire has always been a realm of colossal resources. […] Why, they don't even understand their own colossi any longer. The machines work from generation to generation automatically, and the caretakers are a hereditary caste who would be helpless if a single D-tube in all that vast structure burnt out.[\"]"
                                            },
                                            {
                                                "example_id": "6e22a1b9-e13f-434c-b84d-e8de156b99ae",
                                                "sense_id": "c0112890-415a-3b45-9135-d7e6cb822753",
                                                "text": "What I love about the colossi is that they actually feel colossal : they move ponderously around, sending out tremours with each step; their ancient husks richly detailed with dirt and plant life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcbafcd7-e912-3ac3-9d3e-f37c27b20d94",
                                        "entry_id": "35d9a6f4-bf94-3e6a-a4d0-da71056f06b5",
                                        "glosses": [
                                            "Somebody or something very greatly admired and respected."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d11fb087-e0c3-4dd3-93e5-6d511722fa03",
                                                "sense_id": "bcbafcd7-e912-3ac3-9d3e-f37c27b20d94",
                                                "text": "The truth is that [Isaac] Newton was very much a product of his time. The colossus of science was not the first king of reason, [John Maynard] Keynes wrote after reading Newton’s unpublished manuscripts. Instead “he was the last of the magicians”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98e128d2-f4dd-41e8-9bce-ccb6b734adaf",
                        "source_entry_id": "a887dec4-504b-3a17-8299-5e2fbc87a118",
                        "source_sense_id": "21fe49c8-0c26-3574-973b-119055043c51",
                        "target_lang_word": "colosse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colosse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "614233b8-35af-3f94-921e-cb3a1bc9454c",
                                        "entry_id": "204283e1-4a5f-38c5-b674-a43a7bd293df",
                                        "glosses": [
                                            "Statue d’une grandeur extraordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27ddad92-efb9-415b-b189-f92974aab15a",
                                                "sense_id": "614233b8-35af-3f94-921e-cb3a1bc9454c",
                                                "text": "L'opinion de mon père serait la seule qui permettrait de rendre compte d'une manière toute naturelle de l’adoption de la tète du colosse chryséléphantin."
                                            },
                                            {
                                                "example_id": "698c3c40-5c44-497b-acc9-58e4097be50b",
                                                "sense_id": "614233b8-35af-3f94-921e-cb3a1bc9454c",
                                                "text": "Le colosse de Rhodes."
                                            },
                                            {
                                                "example_id": "4ae6b320-eb47-4116-b2e6-12eee5531e8c",
                                                "sense_id": "614233b8-35af-3f94-921e-cb3a1bc9454c",
                                                "text": "Ces deux tours, selon la tradition du pays, ont remplacé les deux rochers qui servaient de base au colosse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4297eee1-96fb-324e-b2f0-2ea1941c76de",
                                        "entry_id": "204283e1-4a5f-38c5-b674-a43a7bd293df",
                                        "glosses": [
                                            "Homme, animal de fort grande stature."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dff01bc2-e5d4-485a-92c4-da604f40616b",
                                                "sense_id": "4297eee1-96fb-324e-b2f0-2ea1941c76de",
                                                "text": "Parmi ces colosses de l’air et ces hauts personnages, il se sentait écrasé par la certitude de son insignifiance ; la vie était trop vaste pour lui, elle le dépassait de partout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7cf9e3a-ffbd-3420-acc1-69083c545032",
                                        "entry_id": "204283e1-4a5f-38c5-b674-a43a7bd293df",
                                        "glosses": [
                                            "Empire, souverain très puissant."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "984d843a-da3d-453c-9bcb-9457d159decd",
                                                "sense_id": "c7cf9e3a-ffbd-3420-acc1-69083c545032",
                                                "text": "Plusieurs causes préparaient la chute de ce colosse. Le colosse est tombé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
