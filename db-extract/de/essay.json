                        "form": "die Essays"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46a11d41-1b82-3a28-8206-ec4099ade101",
                        "entry_id": "23078886-dd73-3e5d-b1b8-1df728dc8e87",
                        "glosses": [
                            "geistreiche, allgemein verständliche, gewöhnlich kurze Abhandlung, die das Thema oft aus dem Blickwinkel des Autors darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b56bcccd-5fd0-4b1e-a4b9-eb6c1c8f0a42",
                                "sense_id": "46a11d41-1b82-3a28-8206-ec4099ade101",
                                "text": "Viele Essays zeichnen sich aus durch eine gewisse Leichtigkeit, stilistische Ausgefeiltheit, Verständlichkeit und einen nicht zu unterschätzenden Witz."
                            },
                            {
                                "example_id": "978c0afb-4f71-4b7c-92c1-8c256370a910",
                                "sense_id": "46a11d41-1b82-3a28-8206-ec4099ade101",
                                "text": "Essays behandeln meist ein gesellschaftliches oder kulturelles Phänomen, sind aber nicht fiktional."
                            },
                            {
                                "example_id": "1c2d3592-1855-44fb-b2cd-f18758d74fe9",
                                "sense_id": "46a11d41-1b82-3a28-8206-ec4099ade101",
                                "text": "„In einem Punkt war Woolf in ihrem Essay ihrer Zeit noch weiter voraus, als der Feminismus es sich hat erträumen können.“"
                            },
                            {
                                "example_id": "727efbe8-df82-4f7f-8a7e-23fba84e6e20",
                                "sense_id": "46a11d41-1b82-3a28-8206-ec4099ade101",
                                "text": "„Canetti bekennt später, er möge solche Auftragsarbeiten nicht und er sei etwas bekümmert, dass dieser kleine Essay wieder ans Tageslicht gekommen sei.“"
                            },
                            {
                                "example_id": "31937727-45a0-4548-ade2-3f73b25487dd",
                                "sense_id": "46a11d41-1b82-3a28-8206-ec4099ade101",
                                "text": "„Der Politik erteilt Jünger im Unterschied zu seinen früheren Essays eine recht eindeutige Absage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca2a9da1-0305-45cb-9b05-ecd407cc0cd5",
                        "source_entry_id": "23078886-dd73-3e5d-b1b8-1df728dc8e87",
                        "source_sense_id": "46a11d41-1b82-3a28-8206-ec4099ade101",
                        "target_lang_word": "essay",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bd9b8cd-a871-3f47-b98b-2b591d1ddc72",
                                        "entry_id": "e87a60cd-8fea-3f7d-864a-73af315c57e5",
                                        "glosses": [
                                            "A written composition of moderate length, exploring a particular issue or subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "951f5406-823c-403c-8d41-9ff1f3e6b85d",
                                                "sense_id": "5bd9b8cd-a871-3f47-b98b-2b591d1ddc72",
                                                "text": "In his first book since the 2008 essay collection Natural Acts: A Sidelong View of Science and Nature, David Quammen looks at the natural world from yet another angle: the search for the next human pandemic, what epidemiologists call “the next big one.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d05dcdd5-27f2-32d5-b8dc-c175cf8e0762",
                                        "entry_id": "e87a60cd-8fea-3f7d-864a-73af315c57e5",
                                        "glosses": [
                                            "A test, experiment; an assay."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe011b6c-c9b5-3c60-beb9-37cbecad23ce",
                                        "entry_id": "e87a60cd-8fea-3f7d-864a-73af315c57e5",
                                        "glosses": [
                                            "An attempt."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170063ac-5fbb-4243-aa65-945c9ad9d4a4",
                                                "sense_id": "fe011b6c-c9b5-3c60-beb9-37cbecad23ce",
                                                "text": "My first essay at getting employment was fruitless; but after no small number of mortifying rebuffs from various parties to whom I applied for assistance, I was at last rewarded by a comparative success."
                                            },
                                            {
                                                "example_id": "2202ebe0-49a2-4752-b175-121ad2b817d6",
                                                "sense_id": "fe011b6c-c9b5-3c60-beb9-37cbecad23ce",
                                                "text": "This was Lee's first essay in the kind of offensive-defensive strategy that was to become his hallmark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8993071c-d925-3a45-af65-8addf409f367",
                                        "entry_id": "e87a60cd-8fea-3f7d-864a-73af315c57e5",
                                        "glosses": [
                                            "A proposed design for a postage stamp or a banknote."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "essay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a257c6e-a37e-34c8-aad1-2566b8d16149",
                                        "entry_id": "80459308-695a-396a-8795-8de557b3359b",
                                        "glosses": [
                                            "To attempt or try."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12c2ea68-cd18-491e-a69f-7768f3b8e6b2",
                                                "sense_id": "2a257c6e-a37e-34c8-aad1-2566b8d16149",
                                                "text": "Shall we essay a walk on the promenade?"
                                            },
                                            {
                                                "example_id": "10d70805-db02-424a-9cf1-aeac72b18a86",
                                                "sense_id": "2a257c6e-a37e-34c8-aad1-2566b8d16149",
                                                "text": "He retraced his steps to the front gate, which he essayed to open."
                                            },
                                            {
                                                "example_id": "68254b6a-b495-4d11-aa62-1094b3bf2e8f",
                                                "sense_id": "2a257c6e-a37e-34c8-aad1-2566b8d16149",
                                                "text": "The train took the slow to branch spur at the north end at a not much slower speed, then essayed the short sharply curved climb with a terrific roar, smoke rising straight from the chimney to a height of some 60 ft., the long train twisting and curling behind."
                                            },
                                            {
                                                "example_id": "197c64f7-e2aa-4ea2-9f25-25e9d53e93f0",
                                                "sense_id": "2a257c6e-a37e-34c8-aad1-2566b8d16149",
                                                "text": "There was the counter, there was the bulletin board, above her the dull sound of music being played over headphones. Something jaunty. She liked the beat. Then the sound of a chair being pushed back, and someone humming as they walked away from her, and she darted up to plunge the bayonet into their kidneys from behind. A followup stroke through the back of the neck, and the second soldier was down. She didn't even stop to see if it was a man or a woman, young or old. There were further hurdles to essay before she reached her destination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "378f6121-4a98-3ed5-91e1-6414e534b6c3",
                                        "entry_id": "80459308-695a-396a-8795-8de557b3359b",
                                        "glosses": [
                                            "To move forth, as into battle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3437424f-2c96-4476-b698-408127d32109",
                        "source_entry_id": "23078886-dd73-3e5d-b1b8-1df728dc8e87",
                        "source_sense_id": "46a11d41-1b82-3a28-8206-ec4099ade101",
                        "target_lang_word": "essai",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essai",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f243bf0c-76e0-304e-ac48-74f2e95a3c02",
                                        "entry_id": "95da80f6-ab97-30c4-ae84-efa60e9690a8",
                                        "glosses": [
                                            "Test, examen, épreuve de solidité, de pérennité, d’adéquation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4bd2a72-cf97-41ca-952a-c3d5c12ecc4a",
                                                "sense_id": "f243bf0c-76e0-304e-ac48-74f2e95a3c02",
                                                "text": "Les obus sont chargés avec une poudre spéciale appelée lydite, dont les essais ont donné des résultats terrifiants."
                                            },
                                            {
                                                "example_id": "9b373400-923d-4a52-b377-c99a24a65554",
                                                "sense_id": "f243bf0c-76e0-304e-ac48-74f2e95a3c02",
                                                "text": "La durée de l’essai de 90 minutes, […], a été choisie parce qu'elle correspond au temps mis par le bol alimentaire pour parcourir le tube digestif de l'insecte."
                                            },
                                            {
                                                "example_id": "c895f6c8-4011-45cf-8937-9c919e9a0b7e",
                                                "sense_id": "f243bf0c-76e0-304e-ac48-74f2e95a3c02",
                                                "text": "Embaucher quelqu’un à l’essai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "052fc83f-f2cb-30f0-b92e-3f0cae7bf5a0",
                                        "entry_id": "95da80f6-ab97-30c4-ae84-efa60e9690a8",
                                        "glosses": [
                                            "Opération par laquelle on s’assure de la pureté d’un métal ou de la nature de celui qui est contenu dans une mine."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d33bcb8f-69e9-48cf-9dcb-682432d6f52d",
                                                "sense_id": "052fc83f-f2cb-30f0-b92e-3f0cae7bf5a0",
                                                "text": "Faire l’essai d’une mine."
                                            },
                                            {
                                                "example_id": "43524ea7-dc9d-46ae-8303-922df578a5b6",
                                                "sense_id": "052fc83f-f2cb-30f0-b92e-3f0cae7bf5a0",
                                                "text": "Laboratoire d’essais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8ab3858-eca9-3041-bca8-4dfbe2fc14db",
                                        "entry_id": "95da80f6-ab97-30c4-ae84-efa60e9690a8",
                                        "glosses": [
                                            "Tentative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d096983-219c-4334-8d02-1ab5ccbbffe9",
                                                "sense_id": "a8ab3858-eca9-3041-bca8-4dfbe2fc14db",
                                                "text": "Il en est à son troisième essai pour obtenir ce poste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f306da9e-32f1-35f9-874d-805428f96e4f",
                                        "entry_id": "95da80f6-ab97-30c4-ae84-efa60e9690a8",
                                        "glosses": [
                                            "Premières productions de l’esprit ou de l’art qui se font sur quelque sujet, sur quelque matière, pour voir si l’on y réussira."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f84abc4-c450-4b1c-8b58-b742fb52ede3",
                                                "sense_id": "f306da9e-32f1-35f9-874d-805428f96e4f",
                                                "text": "Il a voulu montrer par cet essai de quoi il était capable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2029a3b2-4ffb-3fc6-a365-40e35da10ac8",
                                        "entry_id": "95da80f6-ab97-30c4-ae84-efa60e9690a8",
                                        "glosses": [
                                            "Ouvrage littéraire explorant un domaine donné selon le point de vue de l’auteur. Il est intitulé ainsi, soit par modestie, soit parce que l’auteur ne se propose pas d’approfondir la matière de son traité."
                                        ],
                                        "tags": [],
                                        "note": "Contrairement à l’étude, l’essai peut être polémique ou partisan",
                                        "examples": [
                                            {
                                                "example_id": "50c718df-92d4-4925-ada8-3953e8857bc6",
                                                "sense_id": "2029a3b2-4ffb-3fc6-a365-40e35da10ac8",
                                                "text": "En littérature, le pamphlet a cédé la place à l’essai. L’essayiste sème sa pensée dans les sillons qu’a creusés la mode. Le pamphlétaire laboure à côté. C’est mal vu."
                                            },
                                            {
                                                "example_id": "7c22fc1c-72ec-4ddd-8892-2b445e07ed28",
                                                "sense_id": "2029a3b2-4ffb-3fc6-a365-40e35da10ac8",
                                                "text": "Le présent mémoire constitue donc le premier essai phytosociologique entrepris sur la flore d'une de nos plus intéressantes vallées sous-vosgiennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "026da18f-28a5-360f-8e45-f753c222364e",
                                        "entry_id": "95da80f6-ab97-30c4-ae84-efa60e9690a8",
                                        "glosses": [
                                            "Points marqués (cinq points) par une équipe de rugby lorsqu’un de ses joueurs plaque le ballon au sol dans l’enbut adverse et permettant d'essayer une transformation (deux points supplémentaires)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9610cf24-72fa-41af-bbd0-41d140ebea3b",
                                                "sense_id": "026da18f-28a5-360f-8e45-f753c222364e",
                                                "text": "Dépassé en fin de partie à Gloucester la semaine dernière (photo), l’UBB aura fort à faire face à une équipe sud-africaine qui, pendant ce temps-là, plantait cinq essais aux Harlequins."
                                            },
                                            {
                                                "example_id": "7421912c-193f-44df-ab39-53351091c6e5",
                                                "sense_id": "026da18f-28a5-360f-8e45-f753c222364e",
                                                "text": "Il s’agit en effet de porter le ballon derrière la ligne du camp ennemi et de lui faire toucher terre. C’est ce qu’on appelle marquer un essai."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "essai",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a49525e-1f64-3ea6-a8a8-443c8d8f57bd",
                                        "entry_id": "51dfdbab-128b-30f4-804e-3421de54abbb",
                                        "glosses": [
                                            "Première personne du singulier du passé simple de esser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
