                "senses": [
                    {
                        "sense_id": "647ba2b1-7bed-328c-9e2b-a9f74a004324",
                        "entry_id": "f1a87b0f-d0c6-3c84-ab47-6f8a9e968ebe",
                        "glosses": [
                            "Pfütze aus Blut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dca5931-186a-43c1-9a98-f97c38288692",
                                "sense_id": "647ba2b1-7bed-328c-9e2b-a9f74a004324",
                                "text": "„Ein paar Zombies mit spitz zulaufenden Armen stürzen sich von hinten auf den Soldaten und schleudern ihn in die Blutpfütze.“"
                            },
                            {
                                "example_id": "4224cd5c-308b-40db-92ca-0f4ff21a34e5",
                                "sense_id": "647ba2b1-7bed-328c-9e2b-a9f74a004324",
                                "text": "„Er hätte einen Finger in die Blutpfütze getaucht, hier gefühlt und dort an der Leiche herumgedrückt.“"
                            },
                            {
                                "example_id": "c846b0a8-9cbd-43f8-83c6-ecc51b812bf8",
                                "sense_id": "647ba2b1-7bed-328c-9e2b-a9f74a004324",
                                "text": "„Von seinem Kopf weg verlief eine Blutpfütze bis zum Abflussgitter am Bürgersteig.“"
                            },
                            {
                                "example_id": "caf55d73-b414-4ee5-90ac-2bcdd748f816",
                                "sense_id": "647ba2b1-7bed-328c-9e2b-a9f74a004324",
                                "text": "„Er verfügte sogar über ein riesiges Fenster, das als Dach diente, aber viele der Scheiben in dem aufwendigen metallenen Gitterwerk waren zerbrochen, sodass sich nach dem Regen verinzelte Blutpfützen auf dem Boden gebildet hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
