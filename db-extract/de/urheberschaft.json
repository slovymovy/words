                "senses": [
                    {
                        "sense_id": "4dc02173-1c28-3afa-9fb5-bb816feef79f",
                        "entry_id": "7293480e-7d37-30e6-b5a8-af187efa33e5",
                        "glosses": [
                            "Eigenschaft, der Urheber (Begründer, Verursacher) von etwas zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c73a6c0-3611-4a1a-9a35-86cab87722a2",
                                "sense_id": "4dc02173-1c28-3afa-9fb5-bb816feef79f",
                                "text": "„Tatsächlich, schrieb er, habe er nach dem Erhalt von Lyells Brief sogar die Absicht gehabt, Wallace zu kontaktieren und jeden Anspruch auf Urheberschaft hinzugeben.“"
                            },
                            {
                                "example_id": "1e78e77d-86dd-4963-b45b-a9a92d0f8e08",
                                "sense_id": "4dc02173-1c28-3afa-9fb5-bb816feef79f",
                                "text": "„Wie immer man zu dieser Darstellung stehen mag, sie zeigt jedenfalls ein ganz anderes Verständnis von literarischer Urheberschaft, als es das unsre ist (auf dem, nota bene, unsere Rechtsprechung beruht).“"
                            },
                            {
                                "example_id": "ce29052a-c69d-407d-8fc4-db598af9dcfa",
                                "sense_id": "4dc02173-1c28-3afa-9fb5-bb816feef79f",
                                "text": "„Der Brief fehlt in Thomas-Mann-Briefausgaben, seine Tochter Erika bekundete, ihn nicht zu kennen, er ist auch nur als Abschrift erhalten, die Urheberschaft nicht gesichert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
