{
    "word_family": [
        "somebody",
        "something",
        "somewhere",
        "sometime",
        "somehow"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "2785111d-5f4e-3c3c-87cd-35260c0ff86a",
                    "sense_definition": "One or some person of unspecified or indefinite identity.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can <w>someone</w> please help me carry these heavy bags?",
                            "target_lang_translations": {
                                "ru": "Может <w>кто-нибудь</w> помочь мне донести эти тяжёлые сумки?",
                                "zh": "能请<w>有人</w>帮我提一下这些重包吗？"
                            }
                        },
                        {
                            "text": "I think <w>someone</w> else left their umbrella in the hallway.",
                            "target_lang_translations": {
                                "ru": "Я думаю, <w>кто-то</w> другой оставил свой зонт в коридоре.",
                                "zh": "我想是<w>别人</w>把伞落在走廊里了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "somebody"
                    ],
                    "antonyms": [
                        "no one",
                        "nobody"
                    ],
                    "common_phrases": [
                        "someone else",
                        "someone special",
                        "meet someone",
                        "ask someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неизвестный или неопределённый человек; некто.",
                        "zh": "指代身份不明或不确定的某个人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кто-то",
                                "target_lang_sense_clarification": "конкретный, но неизвестный или неназванный человек"
                            },
                            {
                                "target_lang_word": "кто-нибудь",
                                "target_lang_sense_clarification": "любой человек, неважно кто (часто в вопросах и просьбах)"
                            },
                            {
                                "target_lang_word": "некто",
                                "target_lang_sense_clarification": "некий человек (более книжное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有人",
                                "target_lang_sense_clarification": "指代不确定的某个人"
                            },
                            {
                                "target_lang_word": "某人",
                                "target_lang_sense_clarification": "指代身份不明的某个人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2451035b-d7cd-36fb-b9bd-b40552e45722",
                    "sense_definition": "A partially specified but unnamed person, often referring to a romantic partner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is still looking for that special <w>someone</w> to share her life with.",
                            "target_lang_translations": {
                                "ru": "Она всё ещё ищет <w>кого-то</w> особенного, с кем можно разделить жизнь.",
                                "zh": "她仍在寻找那个能与她共度余生的<w>意中人</w>。"
                            }
                        },
                        {
                            "text": "Do you have a <w>someone</w> you want to bring to the wedding?",
                            "target_lang_translations": {
                                "ru": "У тебя есть <w>кто-то</w>, кого ты хочешь привести на свадьбу?",
                                "zh": "你有没有想带去参加婚礼的<w>伴侣</w>？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "special someone",
                        "that someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особенный человек, часто подразумевается романтический партнёр.",
                        "zh": "指代特定的某个人，通常指浪漫关系中的伴侣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кто-то",
                                "target_lang_sense_clarification": "в значении «близкий человек», «пара»"
                            },
                            {
                                "target_lang_word": "человек",
                                "target_lang_sense_clarification": "вторая половинка, партнёр"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意中人",
                                "target_lang_sense_clarification": "指心仪的对象或伴侣"
                            },
                            {
                                "target_lang_word": "另一半",
                                "target_lang_sense_clarification": "指浪漫关系中的伴侣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b52bed2c-a73d-3304-93d1-b4fb50171052",
                    "sense_definition": "An important or successful person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of hard work, he finally felt like he had become <w>someone</w>.",
                            "target_lang_translations": {
                                "ru": "После долгих лет упорного труда он наконец почувствовал, что стал <w>кем-то</w>.",
                                "zh": "经过多年的努力，他终于觉得自己成为了一个<w>大人物</w>。"
                            }
                        },
                        {
                            "text": "She wants to be <w>someone</w> in the music industry, not just another face in the crowd.",
                            "target_lang_translations": {
                                "ru": "Она хочет быть <w>кем-то</w> в музыкальной индустрии, а не просто ещё одним лицом в толпе.",
                                "zh": "她想在音乐界成为一个<w>有头有脸的人</w>，而不是人群中平庸的一员。"
                            }
                        }
                    ],
                    "synonyms": [
                        "somebody"
                    ],
                    "antonyms": [
                        "nobody"
                    ],
                    "common_phrases": [
                        "be someone",
                        "become someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Важная, значительная или успешная личность.",
                        "zh": "指重要、成功或有影响力的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кто-то",
                                "target_lang_sense_clarification": "значимая фигура, «человек с большой буквы»"
                            },
                            {
                                "target_lang_word": "личность",
                                "target_lang_sense_clarification": "выдающийся человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大人物",
                                "target_lang_sense_clarification": "指有地位或成就的人"
                            },
                            {
                                "target_lang_word": "有头有脸的人",
                                "target_lang_sense_clarification": "指有社会地位或名望的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}