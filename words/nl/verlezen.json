            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d1bde260-5acb-3199-9789-3cb0706cf95e",
                    "sense_definition": "zich <w>lezen</w> op een onjuiste manier, een fout maken tijdens het lezen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lezen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft zich <w>verlezen</w> in de instructies en daardoor de verkeerde afslag genomen.",
                            "target_lang_translations": {
                                "en": "He <w>misread</w> the instructions and took the wrong turn as a result."
                            }
                        },
                        {
                            "text": "Ik moet de zin opnieuw bekijken omdat ik me een paar keer <w>verlezen</w> heb in de tekst.",
                            "target_lang_translations": {
                                "en": "I need to look at the sentence again because I <w>misread</w> the text a few times."
                            }
                        }
                    ],
                    "synonyms": [
                        "mistlezen"
                    ],
                    "common_phrases": [
                        "zich verlezen in"
                    ],
                    "target_lang_definitions": {
                        "en": "To misread something or make a mistake while reading."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to misread",
                                "target_lang_sense_clarification": "to read incorrectly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c8df559-5498-352f-8045-bbf380e18922",
                    "sense_definition": "het scheiden van goede van slechte zaken, vaak met de hand uitzoeken of selecteren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sorteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer moest de rotte appels <w>verlezen</w> voordat hij de rest naar de markt bracht.",
                            "target_lang_translations": {
                                "en": "The farmer had to <w>sort</w> the rotten apples before taking the rest to the market."
                            }
                        },
                        {
                            "text": "Tijdens de oogst is het belangrijk om de bonen zorgvuldig te <w>verlezen</w> op kwaliteit.",
                            "target_lang_translations": {
                                "en": "During the harvest, it is important to carefully <w>pick over</w> the beans for quality."
                            }
                        }
                    ],
                    "synonyms": [
                        "sorteren",
                        "uitzoeken",
                        "schiften"
                    ],
                    "target_lang_definitions": {
                        "en": "To sort or pick out items by hand, separating the good from the bad."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sort",
                                "target_lang_sense_clarification": "to separate items by quality"
                            },
                            {
                                "target_lang_word": "to pick over",
                                "target_lang_sense_clarification": "to examine and select"
                            },
                            {
                                "target_lang_word": "to cull",
                                "target_lang_sense_clarification": "to remove inferior items"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8276b2cc-6dab-38ad-853e-7ff21b2ea816",
                    "sense_definition": "tijd doorbrengen of verspillen door te lezen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tijdsbesteding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft de hele middag <w>verlezen</w> aan die dikke roman.",
                            "target_lang_translations": {
                                "en": "She <w>spent the whole afternoon reading</w> that thick novel."
                            }
                        },
                        {
                            "text": "Hij kan uren <w>verlezen</w> zonder dat hij merkt hoe laat het is geworden.",
                            "target_lang_translations": {
                                "en": "He can <w>lose himself in reading</w> for hours without noticing what time it has become."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To spend or pass time reading, often implying a loss of track of time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to spend time reading",
                                "target_lang_sense_clarification": "to pass time with a book"
                            },
                            {
                                "target_lang_word": "to lose oneself in reading",
                                "target_lang_sense_clarification": "to be absorbed in a book"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "867ef2c5-9003-3132-b259-f883c3740545",
                    "sense_definition": "voltooid deelwoord van <w>verlezen</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De geoogste vruchten zijn al door de arbeiders <w>verlezen</w>.",
                            "target_lang_translations": {
                                "en": "The harvested fruits have already been <w>sorted</w> by the workers."
                            }
                        },
                        {
                            "text": "Ik heb me helaas <w>verlezen</w> in de vertrektijd van de trein.",
                            "target_lang_translations": {
                                "en": "Unfortunately, I <w>misread</w> the departure time of the train."
                            }
