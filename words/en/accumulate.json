{
    "word_family": [
        "accumulation",
        "accumulative",
        "accumulator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "498b7c41-2052-3a89-ad50-ee26be1d7593",
                    "sense_definition": "To gradually grow or increase in quantity or number over time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you do not pay your credit card bill, interest will <w>accumulate</w> quickly.",
                            "target_lang_translations": {
                                "ru": "Если вы не оплатите счет по кредитной карте, проценты быстро <w>накопятся</w>.",
                                "tr": "Kredi kartı borcunuzu ödemezseniz, faiz hızla <w>birikecektir</w>."
                            }
                        },
                        {
                            "text": "Dust tends to <w>accumulate</w> under the bed if you do not vacuum regularly.",
                            "target_lang_translations": {
                                "ru": "Пыль имеет свойство <w>накапливаться</w> под кроватью, если регулярно не пылесосить.",
                                "tr": "Düzenli olarak süpürmezseniz yatağın altında toz <w>birikme</w> eğilimindedir."
                            }
                        }
                    ],
                    "synonyms": [
                        "accrue",
                        "add up",
                        "mount up"
                    ],
                    "antonyms": [
                        "decline",
                        "lose"
                    ],
                    "common_phrases": [
                        "debts accumulate",
                        "interest accumulates",
                        "dust accumulates"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно расти или увеличиваться в количестве или числе с течением времени.",
                        "tr": "Zamanla miktar veya sayıca kademeli olarak artmak veya büyümek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накапливаться",
                                "target_lang_sense_clarification": "о долгах, пыли, процентах"
                            },
                            {
                                "target_lang_word": "копиться",
                                "target_lang_sense_clarification": "постепенно собираться"
                            },
                            {
                                "target_lang_word": "набегать",
                                "target_lang_sense_clarification": "о процентах или сумме"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "birikmek",
                                "target_lang_sense_clarification": "borçlar, toz, faiz için"
                            },
                            {
                                "target_lang_word": "çoğalmak",
                                "target_lang_sense_clarification": "zamanla artmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f55f0cd0-41d4-32f6-861a-e31c2e405dd0",
                    "sense_definition": "To collect or gather a large amount of something, often over a long period.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "collect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He worked hard for many years to <w>accumulate</w> wealth for his retirement.",
                            "target_lang_translations": {
                                "ru": "Он много работал в течение многих лет, чтобы <w>накопить</w> состояние для выхода на пенсию.",
                                "tr": "Emekliliği için servet <w>biriktirmek</w> amacıyla uzun yıllar çok çalıştı."
                            }
                        },
                        {
                            "text": "The scientist managed to <w>accumulate</w> evidence that supported her new theory.",
                            "target_lang_translations": {
                                "ru": "Ученому удалось <w>собрать</w> доказательства, подтверждающие ее новую теорию.",
                                "tr": "Bilim insanı, yeni teorisini destekleyen kanıtlar <w>toplamayı</w> başardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "amass",
                        "collect",
                        "gather",
                        "hoard",
                        "pile up"
                    ],
                    "common_phrases": [
                        "accumulate wealth",
                        "accumulate evidence",
                        "accumulate points"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать или накапливать большое количество чего-либо, часто в течение длительного периода.",
                        "tr": "Genellikle uzun bir süre boyunca büyük miktarda bir şeyi toplamak veya biriktirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накапливать",
                                "target_lang_sense_clarification": "собирать впрок"
                            },
                            {
                                "target_lang_word": "копить",
                                "target_lang_sense_clarification": "деньги или опыт"
                            },
                            {
                                "target_lang_word": "аккумулировать",
                                "target_lang_sense_clarification": "книжн., собирать и сосредотачивать"
                            },
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "информацию или доказательства"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "biriktirmek",
                                "target_lang_sense_clarification": "servet, para veya birikim yapmak"
                            },
                            {
                                "target_lang_word": "toplamak",
                                "target_lang_sense_clarification": "kanıt, bilgi veya veri bir araya getirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01e77cf1-6986-3d02-b00d-70fd7d6e4354",
                    "sense_definition": "To take a higher academic degree at the same time as a lower one, or shortly after.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university statutes allow certain candidates to <w>accumulate</w> their Bachelor and Master of Divinity.",
                            "target_lang_translations": {
                                "ru": "Устав университета позволяет определенным кандидатам <w>совмещать</w> получение степеней бакалавра и магистра богословия.",
                                "tr": "Üniversite tüzüğü, belirli adayların İlahiyat Lisans ve Yüksek Lisans derecelerini <w>birlikte almalarına</w> izin vermektedir."
                            }
                        },
                        {
                            "text": "He was permitted to <w>accumulate</w> his degrees due to his exceptional research work.",
                            "target_lang_translations": {
                                "ru": "Ему разрешили <w>получить одновременно</w> ученые степени благодаря его исключительной исследовательской работе.",
                                "tr": "Olağanüstü araştırma çalışmaları nedeniyle derecelerini <w>aynı anda tamamlamasına</w> izin verildi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "accumulate degrees"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "academic context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать более высокую ученую степень одновременно с более низкой или вскоре после нее.",
                        "tr": "Daha düşük bir akademik derece ile aynı zamanda veya hemen ardından daha yüksek bir derece almak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совмещать",
                                "target_lang_sense_clarification": "получение степеней"
                            },
                            {
                                "target_lang_word": "получать одновременно",
                                "target_lang_sense_clarification": "об ученых степенях"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "birlikte almak",
                                "target_lang_sense_clarification": "akademik dereceler için"
                            },
                            {
                                "target_lang_word": "aynı anda tamamlamak",
                                "target_lang_sense_clarification": "akademik dereceler için"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "639573dd-24e3-37f5-b57b-bc7a9410cf7c",
                    "sense_definition": "Being in a state of having been collected or <w>accumulated</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>accumulate</w> snow on the roof posed a danger to the structure.",
                            "target_lang_translations": {
                                "ru": "<w>Накопившийся</w> на крыше снег представлял опасность для строения.",
                                "tr": "Çatıdaki <w>birikmiş</w> kar, binanın yapısı için tehlike oluşturuyordu."
                            }
                        },
                        {
                            "text": "He examined the <w>accumulate</w> treasures found in the ancient tomb.",
                            "target_lang_translations": {
                                "ru": "Он осмотрел <w>собранные</w> сокровища, найденные в древней гробнице.",
                                "tr": "Antik mezarda bulunan <w>toplanmış</w> hazineleri inceledi."
                            }
                        }
                    ],
                    "synonyms": [
                        "aggregate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии собранного или накопленного.",
                        "tr": "Toplanmış veya birikmiş durumda olmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накопленный",
                                "target_lang_sense_clarification": "собранный в одном месте"
                            },
                            {
                                "target_lang_word": "совокупный",
                                "target_lang_sense_clarification": "общий объем"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "birikmiş",
                                "target_lang_sense_clarification": "bir yerde toplanmış olan"
                            },
                            {
                                "target_lang_word": "toplanmış",
                                "target_lang_sense_clarification": "bir araya getirilmiş"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}