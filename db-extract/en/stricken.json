                                "target_senses": [
                                    {
                                        "sense_id": "a4312e89-b1ce-3939-bd1b-c18f1e02e662",
                                        "entry_id": "d72a514e-1dd8-3001-a5b7-b89a6c765bb2",
                                        "glosses": [
                                            "unangenehm überrascht, (emotional) leidtragend, bestürzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cd72f8c-cb8b-4750-9bca-e61e069b06b4",
                                                "sense_id": "a4312e89-b1ce-3939-bd1b-c18f1e02e662",
                                                "text": "Bundespräsident Horst Köhler sprach dem argentinischen Präsidenten im Namen des deutschen Volkes „Beileid und Mitgefühl“ aus, Papst Johannes Paul II zeigte sich „sehr betroffen“."
                                            },
                                            {
                                                "example_id": "b8bf4891-04af-4447-9a59-76fcbca60e4c",
                                                "sense_id": "a4312e89-b1ce-3939-bd1b-c18f1e02e662",
                                                "text": "„[Reich-Ranicki] beendete die Sendung jeweils mit dem Brecht-Zitat: ‚Und so sehen wir betroffen / Den Vorhang zu und alle Fragen offen.‘, eine Abwandlung von ‚Wir stehen selbst enttäuscht und sehn betroffen / Den Vorhang zu und alle Fragen offen.‘ (aus Der gute Mensch von Sezuan).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6f27611-7427-392e-a511-78978deca2f1",
                                        "entry_id": "d72a514e-1dd8-3001-a5b7-b89a6c765bb2",
                                        "glosses": [
                                            "beteiligt, jemanden betreffend, sich auf jemanden beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eef463d-9cea-487e-a743-05f237b110c3",
                                                "sense_id": "e6f27611-7427-392e-a511-78978deca2f1",
                                                "text": "Doch nicht nur Lehrer können den betroffenen Kindern helfen, auch Eltern können einen Beitrag zum Abbau von Legasthenie leisten."
                                            },
                                            {
                                                "example_id": "ad2fb136-246a-451a-a963-ad21f78e2fee",
                                                "sense_id": "e6f27611-7427-392e-a511-78978deca2f1",
                                                "text": "„Es fehlen unabhängige Untersuchungsgremien, die nicht von den betroffenen Institutionen geleitet werden und bei denen der Verdacht der Befangenheit gar nicht erst aufkommt.“"
                                            },
                                            {
                                                "example_id": "15a897b4-4155-4db7-b7e0-b25cde0a147c",
                                                "sense_id": "e6f27611-7427-392e-a511-78978deca2f1",
                                                "text": "Südkorea war nach China lange Zeit eines der am schwersten von der Coronapandemie betroffenen Länder."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
