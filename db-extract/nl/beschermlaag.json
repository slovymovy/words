                        "entry_id": "133957e3-4669-368f-bf77-1d513fce78a6",
                        "glosses": [
                            "laag die is aangebracht om het onderliggende materiaal te beschermen tegen inwerking van buitenaf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "412bf424-15ff-4901-873b-4c655470605e",
                                "sense_id": "6e5ceac0-9d76-3ae8-9f1d-10bd9254517f",
                                "text": "President Janoekovitsj van Oekraïne gebruikte de herdenking om de internationale gemeenschap te vragen om meer geld. Want er moet een nieuwe beschermlaag komen over het reactorgebouw."
                            },
                            {
                                "example_id": "0df6dd81-08f2-45bf-9e61-b6b536cb2ab9",
                                "sense_id": "6e5ceac0-9d76-3ae8-9f1d-10bd9254517f",
                                "text": "GM betaalt de reparaties die nodig zijn. Als het paneel nog intact is, is een beschermlaag voldoende. Anders moet het paneel worden vervangen."
                            },
                            {
                                "example_id": "6a31630f-d45f-4e95-b6ba-34cf450f0e22",
                                "sense_id": "6e5ceac0-9d76-3ae8-9f1d-10bd9254517f",
                                "text": "Eén van de problemen waar de bedenkers tegenaan liepen was slijtage van de kabel. Vanwege allerlei chemicaliën in het riool werd de kwaliteit van de kabels aangetast en ging de snelheid van het internet omlaag. De kabels die nu het riool in gaan hebben daarom een extra dikke beschermlaag meegekregen."
                            }
                        ]
                    }
