{
    "word_family": [
        "verschillen",
        "verschillend",
        "verschilligheid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e46ff739-dbff-3968-ba68-fb0575ab051f",
                    "sense_definition": "een kenmerk of aspect waarin twee of meer zaken niet hetzelfde zijn",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "onderscheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is een groot <w>verschil</w> tussen de prijzen van deze twee winkels.",
                            "target_lang_translations": {
                                "en": "There is a big <w>difference</w> between the prices of these two stores."
                            }
                        },
                        {
                            "text": "Je kunt direct een <w>verschil</w> in de sfeer merken nu de vakantie is begonnen.",
                            "target_lang_translations": {
                                "en": "You can immediately notice a <w>difference</w> in the atmosphere now that the holidays have started."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderscheid",
                        "afwijking"
                    ],
                    "common_phrases": [
                        "groot verschil",
                        "verschil maken",
                        "verschil tussen"
                    ],
                    "target_lang_definitions": {
                        "en": "a characteristic or aspect in which two or more things are not the same"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "difference",
                                "target_lang_sense_clarification": "a quality or feature that is not the same"
                            },
                            {
                                "target_lang_word": "distinction",
                                "target_lang_sense_clarification": "a difference or contrast between similar things"
                            },
                            {
                                "target_lang_word": "variation",
                                "target_lang_sense_clarification": "a change or slight difference in condition, amount, or level"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7af68b9-71f2-3535-a884-21e65b1f8c35",
                    "sense_definition": "de uitkomst van een berekening waarbij je getallen van elkaar aftrekt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wiskunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>verschil</w> tussen tien en zeven is drie.",
                            "target_lang_translations": {
                                "en": "The <w>difference</w> between ten and seven is three."
                            }
                        },
                        {
                            "text": "Bereken het <w>verschil</w> tussen de twee bedragen op de factuur.",
                            "target_lang_translations": {
                                "en": "Calculate the <w>difference</w> between the two amounts on the invoice."
                            }
                        }
                    ],
                    "antonyms": [
                        "som"
                    ],
                    "common_phrases": [
                        "het verschil berekenen"
                    ],
                    "target_lang_definitions": {
                        "en": "the result of a calculation where you subtract numbers from each other"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "difference",
                                "target_lang_sense_clarification": "the result of a subtraction"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1863619-3d79-3db7-b048-11fef5430045",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>verschillen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>verschil</w> van mening met mijn collega over dit project.",
                            "target_lang_translations": {
                                "en": "I <w>differ</w> in opinion with my colleague about this project."
                            }
                        },
                        {
                            "text": "Hoewel we broers zijn, <w>verschil</w> ik enorm van hem qua karakter.",
                            "target_lang_translations": {
                                "en": "Although we are brothers, I <w>differ</w> greatly from him in terms of character."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verschil van mening"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'to differ'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "differ",
                                "target_lang_sense_clarification": "to be unlike or to disagree (1st person singular)"
                            },
                            {
                                "target_lang_word": "disagree",
                                "target_lang_sense_clarification": "to have a different opinion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b57ace61-c70d-3ccc-84b6-47cde1503d17",
                    "sense_definition": "de gebiedende wijs van <w>verschillen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Verschil</w> van de rest en durf je eigen weg te kiezen.",
                            "target_lang_translations": {
                                "en": "<w>Differ</w> from the rest and dare to choose your own path."
                            }
                        },
                        {
                            "text": "Wees uniek en <w>verschil</w> in je aanpak van dit probleem.",
                            "target_lang_translations": {
                                "en": "Be unique and <w>differ</w> in your approach to this problem."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the imperative mood of 'to differ'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "differ",
                                "target_lang_sense_clarification": "be different or disagree (command form)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
