                    {
                        "sense_id": "568a66b0-3160-389e-bfa0-f2435d1e7a6a",
                        "entry_id": "ee5f7568-5f43-34a2-88a0-bd0ae30c637b",
                        "glosses": [
                            "Very sturdy; as if built to resist the effects of a blast from a bomb."
