                "senses": [
                    {
                        "sense_id": "7ab8ac31-cb74-36e0-8fb6-2d2a012297a5",
                        "entry_id": "2859fe2a-a86b-3095-90fa-0acaa100667a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "262e4903-46ad-4923-8897-f54a17f02b86",
                                "sense_id": "7ab8ac31-cb74-36e0-8fb6-2d2a012297a5",
                                "text": "Frau Prieß ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ac4b3246-6051-4e38-8963-b0a4c696261f",
                                "sense_id": "7ab8ac31-cb74-36e0-8fb6-2d2a012297a5",
                                "text": "Herr Prieß wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d2428c4f-67aa-4aaa-8c6d-42da38d7fecc",
                                "sense_id": "7ab8ac31-cb74-36e0-8fb6-2d2a012297a5",
                                "text": "Die Prieß kommen heute aus Franken."
                            },
                            {
                                "example_id": "c9a94791-1bfe-44f5-a49d-9dda3ac052a3",
                                "sense_id": "7ab8ac31-cb74-36e0-8fb6-2d2a012297a5",
                                "text": "Der Prieß trägt nie die Schals, die die Prieß ihm strickt."
                            },
                            {
                                "example_id": "2a0d31c1-b922-420e-9563-b524de0ba01c",
                                "sense_id": "7ab8ac31-cb74-36e0-8fb6-2d2a012297a5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Prieß kommt, geht der Herr Prieß.“"
                            },
                            {
                                "example_id": "1f0355ef-3099-480c-87e0-b1833e556072",
                                "sense_id": "7ab8ac31-cb74-36e0-8fb6-2d2a012297a5",
                                "text": "Prieß kommt und geht."
                            },
                            {
                                "example_id": "4c05a04f-98e0-4cf5-afa4-8b839dc0f8ae",
                                "sense_id": "7ab8ac31-cb74-36e0-8fb6-2d2a012297a5",
                                "text": "Prießens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
