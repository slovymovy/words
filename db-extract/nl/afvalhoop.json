                    {
                        "sense_id": "9b5ece84-e3fa-380f-8fc6-e5466fe952df",
                        "entry_id": "913e832d-b513-332f-8e88-e0158506f266",
                        "glosses": [
                            "de resten van opeengehoopt keukenafval uit de oudheid die, stratigrafisch onderzocht, belangrijke archeologische gegevens kunnen opleveren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff918116-68e2-4e38-8ade-8f188e70e69f",
                                "sense_id": "9b5ece84-e3fa-380f-8fc6-e5466fe952df",
                                "text": "De oudste overblijfselen van bewoners en hun rituelen zijn uit de Midden-Steentijd [sic]: dolmens, grafkamers, steencirkels en afvalhopen."
                            },
                            {
                                "example_id": "ead90f17-ee8d-4337-8da6-b31d25cad435",
                                "sense_id": "9b5ece84-e3fa-380f-8fc6-e5466fe952df",
                                "text": "Als een afvalhoop uit de industriële revolutie straalde de structuur onmenselijke technologische grimmigheid en stalen barbaarsheid uit."
                            }
                        ]
                    }
                ],
