                    },
                    {
                        "translation_id": "768d5f6d-83af-4f0c-9e2e-a01808499634",
                        "source_entry_id": "e30d6a89-cc2e-305e-b32f-69d2b05e0f45",
                        "source_sense_id": "4d5a776c-7b9a-3453-972c-63eec21e9a2c",
                        "source_sense_description": "beeldspraak waarbij men een woord B zegt in plaats van het woord A terwijl er tussen A en B een verband is van gelijkenis",
                        "target_lang_word": "Metapher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Metapher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac48db38-1b39-3787-ae91-32bc300517ce",
                                        "entry_id": "89401ee9-ae8d-3e9f-8d0a-eead19a46123",
                                        "glosses": [
                                            "bildhafte Umschreibung, bildlicher Ausdruck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa6ee0ab-4dcc-4c17-b01a-7d83e87937e9",
                                                "sense_id": "ac48db38-1b39-3787-ae91-32bc300517ce",
                                                "text": "Es gibt aber auch tote Metaphern. Diese sind in den täglichen Sprachgebrauch schon mit eingeflossen: \"Tischbein\"."
                                            },
                                            {
                                                "example_id": "232c8ed5-25a5-4d95-a156-51f97a45b0d2",
                                                "sense_id": "ac48db38-1b39-3787-ae91-32bc300517ce",
                                                "text": "„Solche Bedeutungsveränderungen verlaufen nach ganz bestimmten Mustern. Eines ist die Bedeutungsübertragung oder Metapher.“"
                                            },
                                            {
                                                "example_id": "5f0bb986-2dbf-409d-af14-2bf16fd292f2",
                                                "sense_id": "ac48db38-1b39-3787-ae91-32bc300517ce",
                                                "text": "„Was die Erfahrung des Bergsteigens zu einer Metapher des Lebens überhaupt werden lässt und sogar noch zum Sinnbild für die Suche nach dem ewigen Seelenheil, ist die Verbindung der kulturell positiv besetzten Vorstellung der Höhe mit der Abforderung einer körperlichen Leistung.“"
                                            },
                                            {
                                                "example_id": "2764145f-1017-4a59-ba6f-fdcc34195720",
                                                "sense_id": "ac48db38-1b39-3787-ae91-32bc300517ce",
                                                "text": "„Diese Metapher riecht nach Verwesung und ist geräuschlos.“"
                                            },
                                            {
                                                "example_id": "227a1820-2f97-46b2-898b-6ea89c752fab",
                                                "sense_id": "ac48db38-1b39-3787-ae91-32bc300517ce",
                                                "text": "„Viele der beeindruckendsten Metaphern Schopenhauers (und, ehrlich gesagt, der gesamten Literaturgeschichte), sind der Welt des Theaters entliehen.“"
                                            },
                                            {
                                                "example_id": "eb140121-a9e8-48f6-9fc1-34266c432702",
                                                "sense_id": "ac48db38-1b39-3787-ae91-32bc300517ce",
                                                "text": "„Die neue Bedeutung des politischen Wendehalses stellt sprachlich gesehen eine Metapher dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "600575e0-f0b0-40b1-80ca-24a25fe6dc98",
                        "source_entry_id": "e30d6a89-cc2e-305e-b32f-69d2b05e0f45",
                        "source_sense_id": "4d5a776c-7b9a-3453-972c-63eec21e9a2c",
                        "source_sense_description": "beeldspraak waarbij men een woord B zegt in plaats van het woord A terwijl er tussen A en B een verband is van gelijkenis",
                        "target_lang_word": "metaphor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metaphor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64fcd399-4263-3a36-ad9c-b129e28f2b4a",
                                        "entry_id": "1df993cf-c6ee-3fc9-a8b7-d5e7f1a07249",
                                        "glosses": [
                                            "The use of a word, phrase, concept, or set of concepts to refer to something other than its literal meaning, invoking an implicit similarity between the thing described and what is denoted by the word, etc., that is used."
                                        ],
                                        "tags": [
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9f6398d-ce56-42f9-9471-b1a659ae4a22",
                                                "sense_id": "64fcd399-4263-3a36-ad9c-b129e28f2b4a",
                                                "text": "The next group of computational approaches to metaphor assume that metaphor is basically a hidden analogy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d195bb79-a63d-3cf8-acd1-10a4615fca3d",
                                        "entry_id": "1df993cf-c6ee-3fc9-a8b7-d5e7f1a07249",
                                        "glosses": [
                                            "A word or phrase used in such implied comparison."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1798bc2-ea65-4542-8e92-4dd138e5c570",
                                                "sense_id": "d195bb79-a63d-3cf8-acd1-10a4615fca3d",
                                                "text": "A Metaphor, in place of proper words,\nResemblance puts; and dress to speech affords."
                                            },
                                            {
                                                "example_id": "247fd099-3018-4629-840c-27215b9151f4",
                                                "sense_id": "d195bb79-a63d-3cf8-acd1-10a4615fca3d",
                                                "text": "A Metaphor may be changed into a Simile, and also into plain language, containing neither metaphor nor simile. Thus:\nMetaphor. — Idleness is the rust of the soul.\nSimile. — As rust is to iron, so is idleness to the soul, taking away its strength and power of resistance.\nPlain. — Idleness takes away from the soul its strength and power of resistance."
                                            },
                                            {
                                                "example_id": "c643fc66-01a1-4811-84f8-6043ef391c25",
                                                "sense_id": "d195bb79-a63d-3cf8-acd1-10a4615fca3d",
                                                "text": "1979, Daniel Breazeale (translator), Friedrich Nietzsche, On Truth and Lies in a Nonmoral Sense [1873, Über Wahrheit und Lüge im außermoralischen Sinn], in Philosophy and Truth, page 84, quoted in 1998, Ian Markham, Truth and the Reality of God: An Essay in Natural Theology, page 103,\nWhat then is truth? A movable host of metaphors, metonymies, and anthropomorphisms: in short, a sum of human relations which have been poetically and rhetorically intensified, transferred, and embellished, and which, after long usage, seems to a people to be fixed, canonical, and binding. Truths are illusions which we have forgotten are illusions; they are metaphors that have become worn out and have been drained of sensuous force, coins which have lost their embossing and are now considered as metal and no longer as coins."
                                            },
                                            {
                                                "example_id": "21f3665a-eae8-4ca4-8522-09ea9ac5b8af",
                                                "sense_id": "d195bb79-a63d-3cf8-acd1-10a4615fca3d",
                                                "text": "To torture the metaphor, though, they’re sitting at a table outside the Nazi bar; their friends are there, they’re having a good time, maybe they hear a slur emanate from the window from time to time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fbd01f9-652e-3755-b946-5bc5244e4cb3",
                                        "entry_id": "1df993cf-c6ee-3fc9-a8b7-d5e7f1a07249",
                                        "glosses": [
                                            "The use of an everyday object or concept to represent an underlying facet of the computer and thus aid users in performing tasks."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70a69107-d3fa-41dd-b83f-703f7b75a93a",
                                                "sense_id": "0fbd01f9-652e-3755-b946-5bc5244e4cb3",
                                                "text": "desktop metaphor; wastebasket metaphor"
                                            }
                                        ]
                                    }
                                ]
                            },
