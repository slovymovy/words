                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4c85ccd-4301-4601-b590-9de69dee5176",
                                "sense_id": "d04e42f3-1583-3f3f-9f7a-6b344b898d05",
                                "text": "Изумрудная пяденица села на цветок."
                            },
                            {
                                "example_id": "88c8b7a2-94a4-4200-ae66-39a647cc24d4",
                                "sense_id": "d04e42f3-1583-3f3f-9f7a-6b344b898d05",
                                "text": "Сюда принадлежат: шелкопряды (Bombyces), ночницы, или совки (Noctuae), пяденицы (Geometrae) и все мелкие чешуекрылые (Microlepidoptera)."
                            }
                        ]
                    }
