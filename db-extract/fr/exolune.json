                        "source_entry_id": "46040959-8470-38da-85f2-927355a6009b",
                        "source_sense_id": "63564172-b5f9-3955-943f-e9f017170c78",
                        "target_lang_word": "exomoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exomoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "054ee146-3d0f-3031-b146-1a536eb19f81",
                                        "entry_id": "cb89f6e6-7b4c-3b01-a10b-7e75acfeca41",
                                        "glosses": [
                                            "A moon that is outside the Solar System (our solar system)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46204d2c-206f-4e66-8804-e8cd144f0302",
                                                "sense_id": "054ee146-3d0f-3031-b146-1a536eb19f81",
                                                "text": "Of course we can't detect exomoons now (or for a long while), but could planets like 51 Peg b have any moons? Wouldn't the star strip them off? I don't suppose there can be a moon around a planet that orbits in more time than it takes that planet to orbit its star."
                                            },
                                            {
                                                "example_id": "19570ff5-4d93-489e-beda-59c08f904c93",
                                                "sense_id": "054ee146-3d0f-3031-b146-1a536eb19f81",
                                                "text": "Now we get exoplanets, dwarf planets, rogue planets, and (exo)moons. That's ok, but then comes the utter silliness: none of them are planets. Even those bigger than Jupiter aren't planets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
