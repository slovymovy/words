                    },
                    {
                        "translation_id": "b3b9f3a4-d4a6-40ed-b615-9302e944c22d",
                        "source_entry_id": "7e9bf69a-94da-3aeb-a193-28ca39145eaa",
                        "source_sense_id": "623a216a-d209-380c-bc1d-943501ccb290",
