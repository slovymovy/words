            "senses": [
                {
                    "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                    "sense_definition": "een informele term voor een man of kerel",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "personen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die nieuwe buurman lijkt me echt een aardige <w>vent</w>.",
                            "target_lang_translations": {
                                "en": "That new neighbor seems like a really nice <w>guy</w>.",
                                "ru": "Этот новый сосед кажется мне действительно приятным <w>малым</w>."
                            }
                        },
                        {
                            "text": "Hij is een <w>vent</w> van niks omdat hij nooit zijn afspraken nakomt.",
                            "target_lang_translations": {
                                "en": "He is a <w>fellow</w> of no account because he never keeps his appointments.",
                                "ru": "Он никчемный <w>человек</w>, потому что никогда не выполняет свои обещания."
                            }
                        }
                    ],
                    "synonyms": [
                        "bink",
                        "man",
                        "kerel"
                    ],
                    "antonyms": [
                        "doetje",
                        "slapjanus"
                    ],
                    "common_phrases": [
                        "vent van niks",
                        "toffe vent",
                        "aardige vent"
                    ],
