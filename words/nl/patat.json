                    "frequency": "Middle",
                    "semantic_group_id": "aardappel_knol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer haalt de rijpe <w>patatten</w> uit de grond.",
                            "target_lang_translations": {
                                "en": "The farmer is harvesting the ripe <w>potatoes</w> from the ground.",
                                "ru": "Фермер достает спелую <w>картошку</w> из земли."
                            }
                        },
                        {
                            "text": "Schil jij de <w>patatten</w> even voor het avondeten?",
                            "target_lang_translations": {
                                "en": "Could you peel the <w>potatoes</w> for dinner?",
                                "ru": "Почистишь <w>картошку</w> к ужину?"
                            }
