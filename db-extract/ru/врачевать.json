                "senses": [
                    {
                        "sense_id": "154bc606-11dc-3dfd-9596-f4ce9a950048",
                        "entry_id": "8c787669-58d9-3501-affb-9f288b88a546",
                        "glosses": [
                            "to heal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e980bab-5514-4feb-a129-8c069fc20048",
                                "sense_id": "154bc606-11dc-3dfd-9596-f4ce9a950048",
                                "text": "Боля́щий дух врачу́ет песнопе́нье.\nГармо́нии таи́нственная власть\nТяжёлое иску́пит заблужде́нье\nИ укроти́т бунту́ющую страсть.",
                                "translation": "Sacred song heals the sick spirit.\nThe mysterious power of harmony\nWill expiate a heavy delusion\nAnd tame a revolting desire.",
                                "english": "Sacred song heals the sick spirit.\nThe mysterious power of harmony\nWill expiate a heavy delusion\nAnd tame a revolting desire."
                            }
                        ]
                    }
                ],
