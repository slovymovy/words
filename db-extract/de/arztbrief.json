                        "form": "die Arztbriefe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43c527ee-a520-397f-87e9-5f76aa179e4b",
                        "entry_id": "87ee305e-7419-394b-b2c7-f9853012a573",
                        "glosses": [
                            "von einem Arzt erstelltes Dokument, das die erfolgte Behandlung eines Patienten darstellt und unter anderem dem Hausarzt weitergegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb2e295d-a116-4140-9b9b-c62038e15e6e",
                                "sense_id": "43c527ee-a520-397f-87e9-5f76aa179e4b",
                                "text": "„Lange Zeit diente der Arztbrief dem gezielten Informationsaustausch zwischen dem behandelnden Arzt und den weiterbehandelnden Ärzten.“"
                            },
                            {
                                "example_id": "28b49f8a-6ce0-4dcb-b24a-4c5c7cb4c119",
                                "sense_id": "43c527ee-a520-397f-87e9-5f76aa179e4b",
                                "text": "„Die Information erfolgt typischerweise in einem zum Zeitpunkt der Entlassung zu erstellenden Arztbrief an den nachbehandelnden Arzt.“"
                            },
                            {
                                "example_id": "63cd841c-42ba-4618-a3d2-36899bcb0d0a",
                                "sense_id": "43c527ee-a520-397f-87e9-5f76aa179e4b",
                                "text": "„Da es keine Richtlinien für die Aufklärung des Patienten in Deutschland gibt, ist in der Praxis häufig der Stand, dass die Patienten einen Arztbrief erhalten, der sie über die Befunde und Diagnosen informiert und aufklären soll.“"
                            },
                            {
                                "example_id": "426b6e3d-0f01-4b1a-9839-a53010476f72",
                                "sense_id": "43c527ee-a520-397f-87e9-5f76aa179e4b",
                                "text": "„Der Arztbrief dokumentiert im Klinikalltag fortlaufend die Ergebnisse – von der stationären Aufnahme bis zur Entlassung des Patienten.“"
                            },
                            {
                                "example_id": "a0656aff-1f93-4443-ae40-ed0a3827101e",
                                "sense_id": "43c527ee-a520-397f-87e9-5f76aa179e4b",
                                "text": "„Hierbei ist zu berücksichtigen, dass der Patient prinzipiell ein Einsichtsrecht in die ihn betreffende medizinische Dokumentation inklusive Arztbrief hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
