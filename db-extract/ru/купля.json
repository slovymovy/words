                                        "examples": [
                                            {
                                                "example_id": "99ac63c7-13f2-4f56-9b17-cf921cd16b19",
                                                "sense_id": "a7cd63ac-7c51-3331-a5aa-c6559b58227b",
                                                "text": "[…] Reckonings of all and every his Dealings, Doings, Buyings and Sellings and Employments, touching and concerning the Premises […]"
                                            },
                                            {
                                                "example_id": "3b428324-8ff2-4d33-9d29-e5dae47b9a13",
                                                "sense_id": "a7cd63ac-7c51-3331-a5aa-c6559b58227b",
                                                "text": "\"He's hanging back to make an excuse of going to town for the spring buying, and it won't do.\""
                                            },
                                            {
                                                "example_id": "bb255f79-781b-4bfa-bcd1-3544e33c9c34",
                                                "sense_id": "a7cd63ac-7c51-3331-a5aa-c6559b58227b",
                                                "text": "Paying for these buyings, and arranging for their cartage to the shop, she got away, feeling physically tired but mentally elated, and very anxious to hear what Peter would say about the quality of her period pieces, and what prospects they offered for restoration."
                                            }
                                        ]
                                    }
                                ]
