{
    "word_family": [
        "память",
        "памятный",
        "памятник",
        "напоминать",
        "запоминать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32c7cc27-d8c4-3471-974e-8fc409ed97c7",
                    "sense_definition": "Восстановить в памяти что-либо, вернуться мыслью к чему-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>вспомнил</w>, как звали этого человека.",
                            "target_lang_translations": {
                                "en": "I <w>remembered</w> what that person's name was."
                            }
                        },
                        {
                            "text": "Мне нужно <w>вспомнить</w> все детали вчерашнего разговора.",
                            "target_lang_translations": {
                                "en": "I need to <w>recall</w> all the details of yesterday's conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "припомнить"
                    ],
                    "antonyms": [
                        "забыть",
                        "запамятовать"
                    ],
                    "common_phrases": [
                        "вспомнить всё",
                        "вспомнить детство"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring something back into one's mind or memory; to recall information."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "remember",
                                "target_lang_sense_clarification": "To recall something from memory; the most common and general term."
                            },
                            {
                                "target_lang_word": "recall",
                                "target_lang_sense_clarification": "To bring a past event or fact back to one's mind; slightly more formal than 'remember'."
                            },
                            {
                                "target_lang_word": "recollect",
                                "target_lang_sense_clarification": "To make an effort to remember something, often involving a process of gathering thoughts."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8b0a7c0-d1f3-3a6b-b166-f1ec841987a5",
                    "sense_definition": "Упомянуть в речи или мыслях о ком-либо или о чем-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Вспомним</w> наших товарищей, ушедших из жизни.",
                            "target_lang_translations": {
                                "en": "Let us <w>remember</w> our comrades who have passed away."
                            }
                        },
                        {
                            "text": "На собрании часто <w>вспоминали</w> о прошлых успехах компании.",
                            "target_lang_translations": {
                                "en": "At the meeting, they often <w>mentioned</w> the company's past successes."
                            }
                        }
                    ],
                    "synonyms": [
                        "помянуть",
                        "упомянуть"
                    ],
                    "common_phrases": [
                        "вспомнить добрым словом"
                    ],
                    "target_lang_definitions": {
                        "en": "To mention or speak about someone or something in conversation or thought."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mention",
                                "target_lang_sense_clarification": "To refer to someone or something briefly in speech or writing."
                            },
                            {
                                "target_lang_word": "bring up",
                                "target_lang_sense_clarification": "To introduce a topic or person into a conversation."
                            },
                            {
                                "target_lang_word": "commemorate",
                                "target_lang_sense_clarification": "To honor the memory of someone or something, often through a ceremony or public mention."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}