                        "glosses": [
                            "Film qui représente aussi un concert pour les spectateurs (que la musique soit intégrée au film ou interprétée dans la salle par un orchestre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c389a0f4-f7c1-4878-a552-b811e757233b",
                                "sense_id": "dc25b325-1323-3871-b246-a6f8a13d48b6",
                                "text": "Les fans de Beyoncé se sont pressés au cinéma Gaumont des Champs-Élysées (8ᵉ), samedi, pour l’une des rares diffusions du film-concert de la chanteuse, Renaissance."
                            },
                            {
                                "example_id": "85f842f8-0c9a-43fd-a3e9-d1d1f8189349",
                                "sense_id": "dc25b325-1323-3871-b246-a6f8a13d48b6",
                                "text": "On assiste à une mode de « films-concerts », diffusions fastueuses de films muets orchestrés en direct."
                            },
                            {
                                "example_id": "4b77fb2a-3bf0-4f09-82ce-d2d135efb4f8",
                                "sense_id": "dc25b325-1323-3871-b246-a6f8a13d48b6",
                                "text": "Une revanche cruelle est prise aujourd'hui sur le cinéma muet par la musique, avec certaines formules de film-concert qui sont surtout des véhicules pour la musique techno ou d’avant-garde, et dans lesquelles celle-ci s’appuie sur le film, et parfois le parasite."
                            }
                        ]
