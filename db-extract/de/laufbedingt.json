                ],
                "senses": [
                    {
                        "sense_id": "e8077fb7-7b50-36d5-8dab-457de64c9c7e",
                        "entry_id": "54c1f961-b081-3b83-8a2e-2281a84e10a6",
                        "glosses": [
                            "im Zusammenhang mit dem Laufen stehend"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "19d003d8-cb0f-40de-be23-5d0e1d5e229a",
                                "sense_id": "e8077fb7-7b50-36d5-8dab-457de64c9c7e",
                                "text": "„Auf der anderen Seite, je höher der Trainingsumfang und die Trainingsintensität ist, desto größer ist die Wahrscheinlichkeit einer laufbedingten Verletzung oder Krankheit.“"
                            },
                            {
                                "example_id": "12f4053b-0a41-4404-9ce1-d749773b84b7",
                                "sense_id": "e8077fb7-7b50-36d5-8dab-457de64c9c7e",
                                "text": "„Ihr Laufen brachte zwar kurzfristige Vorteile wie schnellere Zeiten, führte aber zu mehr laufbedingten Verletzungen.“"
                            },
                            {
                                "example_id": "2e5cc1a0-0e6f-42f3-8416-5aa6159d4d40",
                                "sense_id": "e8077fb7-7b50-36d5-8dab-457de64c9c7e",
                                "text": "„Der Anteil laufbedingter Knieverletzungen bei übergewichtigen Läufern war 13 % geringer als bei normalgewichtigen Läufern.“"
                            },
                            {
                                "example_id": "39631437-63f5-462c-be07-d0f4df09bf53",
                                "sense_id": "e8077fb7-7b50-36d5-8dab-457de64c9c7e",
                                "text": "„Die Ätiologie von laufbedingten Verletzungen ist multifaktoriell und Risikofaktoren lassen sich in modifizierbar und nicht-modifizierbar unterteilen (13).“"
                            },
                            {
                                "example_id": "a23c6659-4d47-4254-a88f-ec8c086036b9",
                                "sense_id": "e8077fb7-7b50-36d5-8dab-457de64c9c7e",
                                "text": "„Frage: Lea, was ist das für ein Gefühl nach einer so langen laufbedingten Verletzungspause (ca. 3 Monate), wieder am Start eines Triathlon zu stehen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
