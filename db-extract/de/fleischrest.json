                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ccf0246-e2cf-4082-9f84-69ed46eacdbd",
                                "sense_id": "2c3c1962-fec4-3536-8ff6-18e9218ff7eb",
                                "text": "„Sie trug ein Halsband aus Rohleder und war an einen Pfosten gefesselt; neben ihr stand eine Tonschale mit schwärzlich verfärbten Fleischresten.“"
                            },
                            {
                                "example_id": "2a2a4aac-05b8-4956-91bf-0393a06fcdf5",
                                "sense_id": "2c3c1962-fec4-3536-8ff6-18e9218ff7eb",
                                "text": "„Es stinkt, ein Stapel Knochen mit Fleischresten dran und zwei Töpfe voll mit noch mehr Knochen.“"
                            },
                            {
                                "example_id": "0b1528ce-b4e3-4a46-a1fc-ee8acd8f2c96",
                                "sense_id": "2c3c1962-fec4-3536-8ff6-18e9218ff7eb",
                                "text": "„Die Knochen glänzten weiß, nur wenige Fleischreste hingen noch an ihnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
