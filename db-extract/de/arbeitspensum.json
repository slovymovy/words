                "senses": [
                    {
                        "sense_id": "ae762b9c-9a00-329f-bdce-4eb4f64fe277",
                        "entry_id": "a84fe3a5-3bfa-372c-acab-e802d589b9e6",
                        "glosses": [
                            "Gesamtmenge zu bewältigender Arbeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46599a25-c35f-44be-8ac5-ff8c46edc8bc",
                                "sense_id": "ae762b9c-9a00-329f-bdce-4eb4f64fe277",
                                "text": "„Tom und Fabiola hatten sich am Spätnachmittag in der Cafeteria des Instituts für eine kurze Pause verabredet, was trotz des enormen Arbeitspensums völlig legitim war.“"
                            },
                            {
                                "example_id": "a8e172a9-ff17-4062-9a89-2afba04ab9c8",
                                "sense_id": "ae762b9c-9a00-329f-bdce-4eb4f64fe277",
                                "text": "„Auf sein Verlangen hin darf ihn der beste Augenarzt von Paris behandeln: nicht zuletzt durch sein übermäßiges Arbeitspensum bei schlechtem Licht hat er sich eine recht lästige Hornhautentzündung zugezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
