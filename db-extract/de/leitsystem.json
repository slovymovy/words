                ],
                "senses": [
                    {
                        "sense_id": "d41460bd-96c1-3b49-ad61-a76a70ab2e82",
                        "entry_id": "7131e0f6-6f58-3b2a-b805-1eec2f0e47de",
                        "glosses": [
                            "Gesamtheit aller Übersichtstafeln, Wegweiser, Beschriftungen, die zu einem Ziel führen, zum Beispiel in einer Stadt, einem Gebäudekomplex, generell oder für einen klar begrenzten Zweck, wie etwa eine Veranstaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "624c86e5-2148-45da-b478-968f86588376",
                                "sense_id": "d41460bd-96c1-3b49-ad61-a76a70ab2e82",
                                "text": "Seit den Olympiaden in den 1960er und 1970er Jahren, insbesondere der unter Aufsicht Otl Aichers gestalteten 1972, wird der reichlichen Verwendung von Piktogrammen in Leitsystemen große Bedeutung zugemessen."
                            },
                            {
                                "example_id": "2e9e27f6-1ea7-4321-bd13-1c31b55eb8b7",
                                "sense_id": "d41460bd-96c1-3b49-ad61-a76a70ab2e82",
                                "text": "Einige Elemente wie die Otl-Aicher-„Strichmännchen“ zur Kenntlichmachung von Toiletten oder die grün-weißen „Notausgang“-Schilder sind aus kaum einem Leitsystem wegzudenken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e34fa83c-048b-31c6-bfd2-b76943f5e5c7",
                        "entry_id": "7131e0f6-6f58-3b2a-b805-1eec2f0e47de",
                        "glosses": [
                            "Zusammenspiel aus Hard- und Software, das die technische Möglichkeit bietet, einen Prozess zu steuern, zum Beispiel die Belegung von Parkhäusern in einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e562c610-e690-4ba1-b8e3-6701326018d8",
                                "sense_id": "e34fa83c-048b-31c6-bfd2-b76943f5e5c7",
                                "text": "Das AKW sorgt im Freistaat wegen seiner Kombination von amerikanischen Leitsystemen mit russischer Reaktortechnik für erhebliche Sicherheitsbedenken."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
