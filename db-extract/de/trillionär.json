                "senses": [
                    {
                        "sense_id": "c2cf1867-3712-30d9-84e6-794d48af65af",
                        "entry_id": "652053b3-119e-3a6e-a7db-a4df0b93b644",
                        "glosses": [
                            "Besitzer eines Vermögens im Wert von mindestens einer Trillion Währungseinheiten (Euro, Dollar, Pfund oder Ähnlichem)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e71803e-e9f1-4f02-a2be-879ce5a72f56",
                                "sense_id": "c2cf1867-3712-30d9-84e6-794d48af65af",
                                "text": "„«Es sind Milliardäre», sagte Norbridge leise. «Vielleicht sogar Trillionäre. […]»“"
                            },
                            {
                                "example_id": "fd809e82-2a86-46d1-aaad-1ee2b7f46d0d",
                                "sense_id": "c2cf1867-3712-30d9-84e6-794d48af65af",
                                "text": "„Ein anderer Inflationsgewinner war der Österreicher Sigmund Bosel, geb.1893, der es vom Kaufmannsgehilfen zum ‚Trillionär‘ brachte.“"
                            },
                            {
                                "example_id": "4993ad78-7dc0-4861-a500-c057fb226b5b",
                                "sense_id": "c2cf1867-3712-30d9-84e6-794d48af65af",
                                "text": "„Lando und der Trillionär blieben in der dünnen Luft der Halle allein zurück.“"
                            },
                            {
                                "example_id": "cd4d5c09-4d5b-4b92-838f-7140ab365094",
                                "sense_id": "c2cf1867-3712-30d9-84e6-794d48af65af",
                                "text": "„»Nun«, sagte Jemeljan, »dann gratuliere ich. Sie sind ja kein Millionär, sondern ein Trillionär!«“"
                            },
                            {
                                "example_id": "2b5e1eea-4776-4c2f-88fe-cc55f7ebef37",
                                "sense_id": "c2cf1867-3712-30d9-84e6-794d48af65af",
                                "text": "„Der Trillionär ließ sich von einem zerbrechlich wirkenden, älteren Mann in einer langen weißen Robe vorlesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
