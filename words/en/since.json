                                "ru": "Я работаю здесь <w>с</w> шести часов.",
                                "nl": "Ik werk hier <w>sinds</w> zes uur.",
                                "pl": "Pracuję tutaj <w>od</w> szóstej godziny.",
                                "de": "Ich arbeite hier <w>seit</w> sechs Uhr.",
                                "fr": "Je travaille ici <w>depuis</w> six heures.",
                                "it": "Lavoro qui <w>dalle</w> sei.",
                                "cs": "Pracuji zde <w>od</w> šesti hodin.",
                                "tr": "Saat altıdan <w>beri</w> burada çalışıyorum.",
                                "es": "He estado trabajando aquí <w>desde</w> las seis."
                            }
                        },
                        {
                            "text": "She has lived in this house <w>since</w> 2010.",
                            "target_lang_translations": {
                                "ru": "Она живет в этом доме <w>с</w> 2010 года.",
                                "nl": "Zij woont <w>sinds</w> 2010 in dit huis.",
                                "pl": "Ona mieszka w tym domu <w>od</w> 2010 roku.",
                                "de": "Sie wohnt <w>seit</w> 2010 in diesem Haus.",
                                "fr": "Elle vit dans cette maison <w>depuis</w> 2010.",
                                "it": "Vive in questa casa <w>dal</w> 2010.",
                                "cs": "V tomto domě žije <w>od</w> roku 2010.",
                                "tr": "2010'dan <w>beri</w> bu evde yaşıyor.",
                                "es": "Ella ha vivido en esta casa <w>desde</w> el 2010."
                            }
                        }
                    ],
                    "common_phrases": [
                        "since then",
                        "ever since",
                        "since when"
                    ],
                    "target_lang_definitions": {
