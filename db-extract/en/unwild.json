                "senses": [
                    {
                        "sense_id": "84c70300-64ed-37ec-afac-c2ca37980fbc",
                        "entry_id": "f9cee848-bc5b-346c-a593-976b82f7d8c7",
                        "glosses": [
                            "To make something not wild; to tame, civilize."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6803445f-e414-41d8-b0a1-2b9ded3b1af0",
                                "sense_id": "84c70300-64ed-37ec-afac-c2ca37980fbc",
                                "text": "\"We are unwilded almost from birth,\" says Marc Bekoff author of Rewilding Our Hearts and professor emeritus of ecology and evolutionary biology at the University of Colorado in Boulder. Bekoff says it's natural for humans to want to live more in sync with their natural surroundings."
                            },
                            {
                                "example_id": "12c1e9df-7405-4b2c-aaf1-f05e6a4777b2",
                                "sense_id": "84c70300-64ed-37ec-afac-c2ca37980fbc",
                                "text": "MacAskill is tall and sturdily built, with an untidy mop of dark-blond hair that had grown during the pandemic to messianic lengths. In an effort to unwild himself for reëntry, he had recently reduced it to a dimension better suited to polite society."
                            },
                            {
                                "example_id": "464f76b6-7b1e-4aad-a0e6-6964c77e490a",
                                "sense_id": "84c70300-64ed-37ec-afac-c2ca37980fbc",
                                "text": "The past week has been spent \"unwilding\" my garage. This was always Ian's territory and one of my sisters came to help as, left to my own devices, I could easily have been defeated by memories. Our goal? A tidy garage with room for the extremely radical concept of keeping a car in it."
                            }
                        ]
                    }
