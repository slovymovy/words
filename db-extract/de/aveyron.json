                        "cross_references": [
                            {
                                "target_word": "Aveyron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30c86cf4-fbe2-3a6b-98df-eab528ab148d",
                                        "entry_id": "52eebb2a-0ad0-3ced-b85e-b29e94510286",
                                        "glosses": [
                                            "Rivière se jetant dans le Tarn, en Occitanie."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ef8f093-9c39-46d8-90a5-0c6d15b7170a",
                                                "sense_id": "30c86cf4-fbe2-3a6b-98df-eab528ab148d",
                                                "text": "PÈNE ou PENNE, (Géog. mod.) petite ville de France, dans le Languedoc, près de l’Aveyron, avec un château ruiné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cad16cb7-8683-3a74-b835-38f0c1dbdfeb",
                                        "entry_id": "52eebb2a-0ad0-3ced-b85e-b29e94510286",
                                        "glosses": [
                                            "Département français d’Occitanie, limitrophe des départements du Tarn, de Tarn-et-Garonne, du Lot, de l’Hérault, du Gard, de la Lozère et du Cantal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54429595-fc8e-45e5-98cb-ab7507f3d067",
                                                "sense_id": "cad16cb7-8683-3a74-b835-38f0c1dbdfeb",
                                                "text": "Dans une petite ville de l’Aveyron ou des Pyrénées, le moindre incident eut été rendu décisif par le feu du climat."
                                            },
                                            {
                                                "example_id": "6c618ea1-95f7-4c04-92e3-2dde6bcbb1f7",
                                                "sense_id": "cad16cb7-8683-3a74-b835-38f0c1dbdfeb",
                                                "text": "M. Leuwen revint tout joyeux de son élection dans le département de l’Aveyron.\n— L’air est chaud, les perdrix excellentes, et les hommes plaisants."
                                            },
                                            {
                                                "example_id": "81e2d5d2-b178-4cfb-a820-929cbf09a0e8",
                                                "sense_id": "cad16cb7-8683-3a74-b835-38f0c1dbdfeb",
                                                "text": "La faune liasienne de l’Aveyron montre en général un faciès côtier. Mais déjà, dans le Gard, se manifestent les caractères de mer profonde, caractères qui se poursuivent dans les Bouches-du-Rhône et le Var."
                                            },
                                            {
                                                "example_id": "e510f65d-924d-49e3-b7a8-120f2cbc0a77",
                                                "sense_id": "cad16cb7-8683-3a74-b835-38f0c1dbdfeb",
                                                "text": "Si les vieux Ruthènes, ont été aussi réfractaires que nous le supposons à l’influence latine, d’où vient donc que nous rencontrons dans l'Aveyron tant d’importants travaux romains, à commencer par cet aqueduc qui, même aujourd’hui, donne encore à boire aux habitants du chef-lieu ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "908762ab-b0c2-3053-86cf-b96b0025f0b9",
                                        "entry_id": "52eebb2a-0ad0-3ced-b85e-b29e94510286",
                                        "glosses": [
                                            "Rivière française se jetant dans le Loing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c062da51-45ae-42f8-a8ee-198179b0285a",
                                                "sense_id": "908762ab-b0c2-3053-86cf-b96b0025f0b9",
                                                "text": "L'Aveyron (affluent du Loing), anciennement le Laveron ou le Lavezon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
