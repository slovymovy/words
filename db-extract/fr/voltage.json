                        "entry_id": "be8fe4f3-c986-3ab5-ba77-f4fa024385ef",
                        "glosses": [
                            "Tension électrique en volts nécessaires au fonctionnement d’un appareil électrique."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6a7c50a0-8a26-3679-96dd-0ee4f57cbeb7",
                        "entry_id": "be8fe4f3-c986-3ab5-ba77-f4fa024385ef",
                        "glosses": [
                            "Tension électrique ; différence de potentiel."
                        ],
                        "tags": [
                            "Anglicism",
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8f22b9d3-5d73-4dfc-956b-3d95a12d0445",
                                "sense_id": "6a7c50a0-8a26-3679-96dd-0ee4f57cbeb7",
                                "text": "Quand les morceaux touchent les contacts, la grille reçoit des voltages différents suivant leur résistivité. Si le voltage est suffisant, la valve actionne un relais qui ferme le circuit d'un mécanisme électrique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86159b94-e311-4078-8afc-674e901a619f",
                        "source_entry_id": "be8fe4f3-c986-3ab5-ba77-f4fa024385ef",
                        "target_lang_word": "voltage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voltage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5ae84a4-6f71-30cc-955f-d30431714018",
                                        "entry_id": "8290a4f7-6731-3e47-9a15-74f04bb871db",
                                        "glosses": [
                                            "The difference in electrostatic potential between two points in space, especially between live and neutral conductors or the earth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a81d006d-fb7e-400a-929c-23614add8c86",
                                                "sense_id": "d5ae84a4-6f71-30cc-955f-d30431714018",
                                                "text": "The voltage between the wires is too low to produce a spark."
                                            },
                                            {
                                                "example_id": "054a4ea8-f695-4d9a-8f80-b8e3a8ebb616",
                                                "sense_id": "d5ae84a4-6f71-30cc-955f-d30431714018",
                                                "text": "Be careful when opening high-voltage equipment."
                                            },
                                            {
                                                "example_id": "54f19858-3c69-4eb2-a6ba-e5ead3becc1d",
                                                "sense_id": "d5ae84a4-6f71-30cc-955f-d30431714018",
                                                "text": "The system voltage is 630 volts d.c. and the supply to the trains is by top-contact third rail with running rail return."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
