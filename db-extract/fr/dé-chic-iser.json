                "senses": [
                    {
                        "sense_id": "3d6f245f-72f0-3806-82bc-37da1a3f3c60",
                        "entry_id": "64afc60d-48fc-3b34-8d75-ad8db041fd43",
                        "glosses": [
                            "Faire perdre son caractère chic à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65ee986b-164f-41f8-9b01-9c6a4a1bd27e",
                                "sense_id": "3d6f245f-72f0-3806-82bc-37da1a3f3c60",
                                "text": "Rien de mieux que du naturel pour « dé-chic-iser » le noir et le blanc !"
                            },
                            {
                                "example_id": "5ea33a12-d018-4e8e-8ff2-6021ddf2c9d3",
                                "sense_id": "3d6f245f-72f0-3806-82bc-37da1a3f3c60",
                                "text": "Elles me permettent de dé-chic-iser (mot que je viens d'inventer qui signifique enlever du chic à une tenue) un look trop classique."
                            },
                            {
                                "example_id": "46cf4fc6-5856-4b94-84c3-36d998b62e6c",
                                "sense_id": "3d6f245f-72f0-3806-82bc-37da1a3f3c60",
                                "text": "Pour pouvoir sortir le mien en journée sans que ça fasse \"la-meuf-qui-va-en-boite\", je l'ai dé-chic-isé un maximum avec la technique du layering."
                            }
                        ]
                    }
