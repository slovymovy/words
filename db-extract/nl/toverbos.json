                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dabfa95-7f85-463b-a3f4-63dada305b80",
                                "sense_id": "22b9a9f7-fe2f-34c9-a909-6d4f4003e328",
                                "text": "Maandenlang repeteerden de leden van de woensdagavond toneelgroep van De Klup voor het stuk 'Het Bedreigde Toverbos', geschreven door Michiel Geurtse."
                            },
                            {
                                "example_id": "2fa22314-b6b5-4125-beb5-babe2de3378d",
                                "sense_id": "22b9a9f7-fe2f-34c9-a909-6d4f4003e328",
                                "text": "De nieuwe vestiging van de buitenschoolse kinderopvang in de Seringenlaan in Reet kreeg de naam Zonneland. Ook de buitenschoolse kinderopvang in Terhagen kreeg een naam: Toverbos."
                            },
                            {
                                "example_id": "6fdd12f9-f989-42b7-99df-b4c56e5b95fc",
                                "sense_id": "22b9a9f7-fe2f-34c9-a909-6d4f4003e328",
                                "text": "„Puur Herfst is een tafel in natuurlijke herfstkleuren met daarop serviezen die geïnspireerd zijn door dit seizoen. Ze gaan helemaal los met dit thema. Toverbos is een feeërieke tafel in moderne frisse groene kleuren”, aldus Rissik."
                            }
                        ]
                    }
