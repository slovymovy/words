                "senses": [
                    {
                        "sense_id": "2bfd2f04-64c7-36c3-be99-c1a101047ee6",
                        "entry_id": "ef83cbd7-53cb-308f-8ec3-9a88a3e11f0d",
                        "glosses": [
                            "Stadt in der südafrikanischen Provinz Westkap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26f9986a-c1b1-4cf5-a6e8-ea59a98f5762",
                                "sense_id": "2bfd2f04-64c7-36c3-be99-c1a101047ee6",
                                "text": "„Der südafrikanische Kommunikationswissenschaftler Johannes Degenaar Froneman rekonstruierte mit Hilfe der Protokolle des Studentenrats der Universität Stellenbosch sowie zeitgenössischer Publikationen Verwoerds politische Aktivitäten während seiner Studienzeit, aus denen sein kulturnationalistisches Bekenntnis zu einem exklusiven afrikaansen Nationalismus eindeutig hervorgeht.“"
                            },
                            {
                                "example_id": "74f2dcd2-eee7-48bb-b6f8-94ab71464fe8",
                                "sense_id": "2bfd2f04-64c7-36c3-be99-c1a101047ee6",
                                "text": "„Pearsons sagt, es gibt fünf oder sechs Läden allein in der Innenstadt, die sie verkaufen. Und ein oder zwei an der Waterfront, zwei in Stellenbosch, einen im Süden der Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
