                "senses": [
                    {
                        "sense_id": "83a5d133-648e-3ded-a321-201c543ceefa",
                        "entry_id": "6f203937-0a33-329c-818f-5e38bb65d9f8",
                        "glosses": [
                            "Papio, małpa z charakterystycznie odsłoniętymi pośladkami i o wydłużonym pysku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae353b46-88a8-4e9e-8d97-c28f0b824fd5",
                                "sense_id": "83a5d133-648e-3ded-a321-201c543ceefa",
                                "text": "Miejscami wąwóz stawał się tak ciasny, że tylko dwa konie mogły iść w pobok, miejscami rozszerzał się w małe, okrągłe doliny otoczone jakby wysokimi kamiennymi murami, na których siedziały wielkie pawiany igrając z sobą, szczekając i pokazując karawanie zęby"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79369382-e6b0-4f5a-8ec1-58e3b92b7aeb",
                        "source_entry_id": "6f203937-0a33-329c-818f-5e38bb65d9f8",
                        "source_sense_id": "83a5d133-648e-3ded-a321-201c543ceefa",
                        "target_lang_word": "baboon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baboon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94d71ce1-f32e-3896-b86b-98b321e38a36",
                                        "entry_id": "41d19c0b-7f64-3557-bf9a-1d39fb06c4de",
                                        "glosses": [
                                            "An Old World monkey of the genus Papio, having dog-like muzzles and large canine teeth, cheek pouches, a short tail, and naked callosities on the buttocks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fe9cc6-8c4e-4da0-a215-956d0b67a4fa",
                                                "sense_id": "94d71ce1-f32e-3896-b86b-98b321e38a36",
                                                "text": "Mix swallowed the comment he wanted to make, that the council hall stank like a congress of baboons. But he was in no position to insult his host, nor should he. The man was only expressing the attitude of his time."
                                            },
                                            {
                                                "example_id": "9a4aa934-81c7-4b8b-93d9-98418b922da1",
                                                "sense_id": "94d71ce1-f32e-3896-b86b-98b321e38a36",
                                                "text": "He draws eclectically on studies of baboons, descriptive anthropological accounts of hunter-gatherer societies and, in a few cases, the fossil record."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1959102-6fe3-3062-8975-7dbbbaebb073",
                                        "entry_id": "41d19c0b-7f64-3557-bf9a-1d39fb06c4de",
                                        "glosses": [
                                            "A foolish or boorish person."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "154a5b7d-8f5f-4925-8573-81a67dd66974",
                        "source_entry_id": "6f203937-0a33-329c-818f-5e38bb65d9f8",
