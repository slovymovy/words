                                    {
                                        "sense_id": "d9a7b765-3328-3471-9a2d-da619c329222",
                                        "entry_id": "23bf2d4e-fd34-3a57-8ad4-60fde67eef91",
                                        "glosses": [
                                            "unerwünschte oder verbotene Veränderung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdd301bf-5cac-4e28-9222-59dea7072e27",
                                                "sense_id": "d9a7b765-3328-3471-9a2d-da619c329222",
                                                "text": "Nach der Manipulation sah mein Text ganz anders aus."
                                            },
                                            {
                                                "example_id": "63974ae5-d785-4104-b187-f360546fccf8",
                                                "sense_id": "d9a7b765-3328-3471-9a2d-da619c329222",
                                                "text": "Noch am gleichen Abend wurde die Manipulation am Roulettekessel entdeckt."
                                            },
                                            {
                                                "example_id": "9116360c-5eb7-44f8-8881-133af21e9783",
                                                "sense_id": "d9a7b765-3328-3471-9a2d-da619c329222",
                                                "text": "„Schließlich waren die EU-Behörden frühzeitig vor möglichen Manipulationen nicht nur bei VW gewarnt worden.“"
                                            },
                                            {
                                                "example_id": "2142d4a7-c668-4613-8667-4b5b6b893959",
                                                "sense_id": "d9a7b765-3328-3471-9a2d-da619c329222",
                                                "text": "„Seine millionenschweren Manipulationen werteten die Staatsanwälte in ihrem Plädoyer jedenfalls nicht als organisierte Kriminalität, sondern als dreistes Bubenstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc30d03f-94c4-315d-8462-bd028d63910c",
                                        "entry_id": "23bf2d4e-fd34-3a57-8ad4-60fde67eef91",
                                        "glosses": [
                                            "Beeinflussung von Entscheidungen, ohne dass der Entscheidende sich dessen bewusst ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f962eb6-c14d-4bce-86a7-d96e594564d6",
                                                "sense_id": "bc30d03f-94c4-315d-8462-bd028d63910c",
                                                "text": "Wir müssen der Manipulation von Kindern durch die Werbung Einhalt gebieten."
                                            },
                                            {
                                                "example_id": "7f97a379-7acc-4ad0-9b6d-b56380201010",
                                                "sense_id": "bc30d03f-94c4-315d-8462-bd028d63910c",
                                                "text": "Er war ein Meister der Manipulation, wusste genau, welche Knöpfe er bei wem zu drücken hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23beff35-2fd7-4bc3-83ee-0480eaf12daf",
                        "source_entry_id": "07451729-ad16-3497-a8da-8e2436814d1f",
                        "target_lang_word": "manipulation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manipulation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fca9472-d36f-343d-bb4f-454402f9dafe",
                                        "entry_id": "b987f4f4-18be-393b-97a3-4a598ff5d4ac",
                                        "glosses": [
                                            "The practice of manipulating or the state of being manipulated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "323d483f-d2b5-486e-9223-dff652515592",
                                                "sense_id": "7fca9472-d36f-343d-bb4f-454402f9dafe",
                                                "text": "The dealer's manipulations could have removed cards from the deck."
                                            },
                                            {
                                                "example_id": "c366ede0-933d-4bae-aa1e-ea04aaf75cd5",
                                                "sense_id": "7fca9472-d36f-343d-bb4f-454402f9dafe",
                                                "text": "The rear portion of the tender top is flat and open so as to facilitate the manipulation of the water crane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d53e9a81-de1a-31e2-9d4e-ec11ff11c4af",
                                        "entry_id": "b987f4f4-18be-393b-97a3-4a598ff5d4ac",
                                        "glosses": [
                                            "The skillful use of the hands in, for example, chiropractic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efd48e37-6668-45db-81a8-2b35950ce470",
                                                "sense_id": "d53e9a81-de1a-31e2-9d4e-ec11ff11c4af",
                                                "text": "After a few minutes of manipulation each week, she obtained days of relief from her neck pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc8af5ca-ab1d-31b0-b65d-72c7d94a29f4",
                                        "entry_id": "b987f4f4-18be-393b-97a3-4a598ff5d4ac",
                                        "glosses": [
                                            "The usage of psychological influence over a person, event, or situation to gain a desired outcome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "755eb3b6-eb44-4cd5-b546-7d3415bd7769",
                                                "sense_id": "bc8af5ca-ab1d-31b0-b65d-72c7d94a29f4",
                                                "text": "The counselor was able to reach the disturbed teen through positive psychological manipulation."
                                            },
                                            {
                                                "example_id": "2d75dd0c-c05d-46b1-9eb7-4552a930d045",
                                                "sense_id": "bc8af5ca-ab1d-31b0-b65d-72c7d94a29f4",
                                                "text": "Through subtle manipulations he orchestrated the downfall of his rival."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70e37642-3165-4085-845a-417dcf7059ae",
                        "source_entry_id": "07451729-ad16-3497-a8da-8e2436814d1f",
                        "target_lang_word": "manipulation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manipulation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea3f0556-a35d-3a48-aabc-52aa23963da1",
                                        "entry_id": "d627d84c-901e-3665-8939-b6ff862e9e3b",
                                        "glosses": [
                                            "Action de manipuler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "604d3691-9911-4a54-b4aa-2dfa80a27a51",
                                                "sense_id": "ea3f0556-a35d-3a48-aabc-52aa23963da1",
                                                "text": "Le trempage doit être fait jusqu'à complète imbibition et avec le moins de manipulation possible pour éviter des détériorations de la matière."
                                            },
                                            {
                                                "example_id": "21fcb5c9-eed7-4a24-9543-fb5a8e3416c0",
                                                "sense_id": "ea3f0556-a35d-3a48-aabc-52aa23963da1",
                                                "text": "Cela dit, il est absolument évident que Stendhal et Balzac, par-delà des manipulations scripturales de calendriers tiennent d’abord à ce que les choses soient claires et n’éprouvent nul besoin de les obscurcir, de les déséclairer."
                                            },
                                            {
                                                "example_id": "328141d5-b6ad-4f54-97e7-eefb975b4376",
                                                "sense_id": "ea3f0556-a35d-3a48-aabc-52aa23963da1",
                                                "text": "Toute manipulation, sans gestes superflus, sans paroles inutiles, était faite par des hommes et des femmes peu nombreux, économes de leurs efforts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99dbec0b-2eac-375b-896f-f10820e86555",
                                        "entry_id": "d627d84c-901e-3665-8939-b6ff862e9e3b",
                                        "glosses": [
                                            "Exercice scolaire où les étudiants manipulent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a75e819-a1a0-4af3-8337-d05e807ff52d",
                                                "sense_id": "99dbec0b-2eac-375b-896f-f10820e86555",
                                                "text": "La mesure des longueurs d’onde est une manipulation délicate."
                                            },
                                            {
                                                "example_id": "2689b801-aa27-483d-aa02-b68d5135189f",
                                                "sense_id": "99dbec0b-2eac-375b-896f-f10820e86555",
                                                "text": "Salle de manipulations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d67b0a98-b573-3e4b-be87-c706e8161815",
                                        "entry_id": "d627d84c-901e-3665-8939-b6ff862e9e3b",
                                        "glosses": [
                                            "Action de manipuler psychiquement, de rendre quelqu’un le jouet de ses intrigues."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e0a43f9-036e-4800-b2aa-3eebdfed4315",
                                                "sense_id": "d67b0a98-b573-3e4b-be87-c706e8161815",
                                                "text": "La première action est de démonter la manipulation des individus à la fois agresseurs, martyrs de dieu, en fait instrument de pouvoirs cléricaux et théocratiques à la recherche de pouvoirs politiques, économiques et financiers."
                                            },
                                            {
                                                "example_id": "f52d0c9e-c479-4388-9baa-491b4184492c",
                                                "sense_id": "d67b0a98-b573-3e4b-be87-c706e8161815",
                                                "text": "Elle n'avait en rien conforté la thèse du rédacteur en chef, considérant leur rencontre au salon de thé comme une tentative de manipulation par un pseudo-privé en manque de clientèle et qui avançait des révélations sans la queue d'une preuve. Autant dire, intox, bidon, pipeau et couille de loup dans le jargon professionnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dae9fcc1-3cb5-331a-9e24-42a7ae39bc90",
                                        "entry_id": "d627d84c-901e-3665-8939-b6ff862e9e3b",
                                        "glosses": [
                                            "Action de diriger secrètement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d607476c-6295-4dd3-9895-b72955b64945",
                                                "sense_id": "dae9fcc1-3cb5-331a-9e24-42a7ae39bc90",
                                                "text": "Dans nos démocraties transparentes, les peuples ont appris à « décrypter » les manipulations médiatiques, et la meilleure communication politique du monde, quand bien même elle paraît efficace, finit toujours par se retourner contre ses auteurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
