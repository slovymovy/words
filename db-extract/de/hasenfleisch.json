                "senses": [
                    {
                        "sense_id": "fc28f44c-4786-3241-a946-808e6bb856c1",
                        "entry_id": "45ebb8c8-113d-3a6b-a352-80affc888881",
                        "glosses": [
                            "als Nahrungsmittel verwendetes Fleisch von (Feld-)Hasen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a344484-cf06-4403-9900-b7184d7a4dd4",
                                "sense_id": "fc28f44c-4786-3241-a946-808e6bb856c1",
                                "text": "„Als sicher aber gilt, dass Papst Zacharias 751 nach Christus den Verzehr von Hasenfleisch wegen seiner vermeintlich triebfördernden und daher Sitte und Moral gefährdenden Eigenschaften untersagte.“"
                            },
                            {
                                "example_id": "74212196-22e3-4c49-9048-d9f98956fb41",
                                "sense_id": "fc28f44c-4786-3241-a946-808e6bb856c1",
                                "text": "„Einer Mutter, die ein Kind mit Hasenscharte zur Welt brachte, sagten die abergläubischen Chinesen nach, sie habe im letzten Monat der Schwangerschaft Hasenfleisch gegessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
