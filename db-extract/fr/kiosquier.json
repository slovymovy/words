                        "sense_id": "15014215-5bff-3401-a926-1a3411f77b01",
                        "entry_id": "9a5e6670-6ec5-38dd-b4cb-1c7511d664ac",
                        "glosses": [
                            "Personne dont le métier est de vendre des journaux dans un kiosque à journaux"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5ee4132-9774-4d25-93c0-d5bd498101dd",
                                "sense_id": "15014215-5bff-3401-a926-1a3411f77b01",
                                "text": "Alors qu’il vient de donner cinquante centimes à un kiosquier, Beckett se retrouve face à face avec son admirateur."
                            },
                            {
                                "example_id": "e3a8f876-ec10-4a1d-a5e9-a1337eff6241",
                                "sense_id": "15014215-5bff-3401-a926-1a3411f77b01",
                                "text": "Toute la semaine, les kiosquiers français ont été en rupture de stock quotidienne, signe que le journal a continué à se vendre très rapidement."
                            },
                            {
                                "example_id": "c11ac666-2583-4778-af95-00f31a4bc53a",
                                "sense_id": "15014215-5bff-3401-a926-1a3411f77b01",
                                "text": "Tremblez, kiosquiers, l’ouragan « Ebdo » revient en 6ᵉ semaine !"
                            }
                        ]
                    }
                ],
