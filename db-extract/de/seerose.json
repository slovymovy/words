                "senses": [
                    {
                        "sense_id": "df213dd1-f59d-32b3-a810-2092ea125130",
                        "entry_id": "463cca38-d214-3564-8d35-6e22f8ab0fbf",
                        "glosses": [
                            "Vertreter der Pflanzengattung Nymphaea aus der Familie der Seerosengewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1764624b-8a73-4f40-95cd-a98da55b92c5",
                                "sense_id": "df213dd1-f59d-32b3-a810-2092ea125130",
                                "text": "In unserem Gartenteich blühen gerade die Seerosen."
                            },
                            {
                                "example_id": "5e82ba95-a3f1-47da-a889-fdedaa6539f6",
                                "sense_id": "df213dd1-f59d-32b3-a810-2092ea125130",
                                "text": "„Auf einmal sah sie direkt vor sich ein paar Seerosen, die manchmal am Ufer des Sees wuchsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d70f8455-8d1d-3ec9-b138-cf7181ee6ab1",
                        "entry_id": "463cca38-d214-3564-8d35-6e22f8ab0fbf",
                        "glosses": [
                            "sessiles Meerestier der Ordnung Actinaria aus der Klasse der Blumentiere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b35c393-ec60-4997-bc91-04fcd187f676",
                                "sense_id": "d70f8455-8d1d-3ec9-b138-cf7181ee6ab1",
                                "text": "Seerosen, auch Seeanemonen genannt, sehen zwar aus wie Pflanzen, sind aber Tiere."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
