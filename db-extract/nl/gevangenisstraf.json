                "senses": [
                    {
                        "sense_id": "01ac8f5f-8d50-378f-9970-a5a3c55b822e",
                        "entry_id": "ca54e728-d9ea-3699-81fa-d7316fa569f2",
                        "glosses": [
                            "een veroordeling waarbij iemand een zekere tijd zijn vrijheid verliest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad6bfdbf-967c-4ac7-8f50-6bcfb162cfe5",
                                "sense_id": "01ac8f5f-8d50-378f-9970-a5a3c55b822e",
                                "text": "De bankmedewerker stal miljarden en kwam er vanaf met een voorwaardelijk gevangenisstrafje."
                            },
                            {
                                "example_id": "1d438113-5bef-4042-b8b1-4d428d03e37a",
                                "sense_id": "01ac8f5f-8d50-378f-9970-a5a3c55b822e",
                                "text": "In Californië kun je bij naaktlopen in de openbare ruimte een boete van 1.000 dollar of een gevangenisstraf van 90 dagen krijgen."
                            },
                            {
                                "example_id": "1f77f130-f9bb-4108-a5c9-cad525ee9dd4",
                                "sense_id": "01ac8f5f-8d50-378f-9970-a5a3c55b822e",
                                "text": "Het afluisteren van telefoons was niet zomaar een dwangmiddel. Daar was zowel een uitspraak van de rechtbank voor nodig als een gegronde verdenking van een misdrijf met minstens twee jaar gevangenisstraf als strafmaat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55fdb8dd-62a4-4a13-ad09-288ee026794f",
                        "source_entry_id": "ca54e728-d9ea-3699-81fa-d7316fa569f2",
                        "source_sense_id": "01ac8f5f-8d50-378f-9970-a5a3c55b822e",
                        "source_sense_description": "een veroordeling waarbij iemand een zekere tijd zijn vrijheid verliest",
                        "target_lang_word": "Gefängnisstrafe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefängnisstrafe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61229c00-d1c3-3336-98f9-55a87bfaa71a",
                                        "entry_id": "1ce2f706-836d-3c95-b39c-a1d7c31bbcf7",
                                        "glosses": [
                                            "ein zur Bestrafung eines Vergehens gerichtlich angeordneter Gefängnisaufenthalt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9c5956c-dcb6-4f04-82b6-3386db08ba04",
                                                "sense_id": "61229c00-d1c3-3336-98f9-55a87bfaa71a",
                                                "text": "Der Angeklagte wurde zu einer dreijährigen Gefängnisstrafe verurteilt."
                                            },
                                            {
                                                "example_id": "474762da-0611-4c33-81f4-6c4dbbc32d07",
                                                "sense_id": "61229c00-d1c3-3336-98f9-55a87bfaa71a",
                                                "text": "„Max hörte ihn erzählen, wie er einen Hilfsrabbiner vor einer Gefängnisstrafe bewahrt habe.“"
                                            },
                                            {
                                                "example_id": "8759ccfa-cb7f-4238-a5f3-507ab73c973e",
                                                "sense_id": "61229c00-d1c3-3336-98f9-55a87bfaa71a",
                                                "text": "„Die Spruchkammern sprachen 9000 Gefängnisstrafen aus, über 500000 Geldstrafen und 25000 Vermögensbeschlagnahmungen.“"
                                            },
                                            {
                                                "example_id": "a5919b83-7e4f-4fc9-b3c3-3dddd4c45674",
                                                "sense_id": "61229c00-d1c3-3336-98f9-55a87bfaa71a",
                                                "text": "„Leo Kämper und Metzger Bronski hatten ihre zweimonatige Gefängnisstrafe abgesessen, und die Ereignisse der Dezembernacht rückten in den Hintergrund.“"
                                            },
                                            {
                                                "example_id": "f7b69526-2cbf-4475-bc2d-cf1dba50af13",
                                                "sense_id": "61229c00-d1c3-3336-98f9-55a87bfaa71a",
                                                "text": "„Zwischen Juni und November 1924 verbüßte er eine Gefängnisstrafe in Greifswald – er hatte Getreide verschoben, das Geld für Drogenkonsum ausgegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "61a6f750-b4dc-3e13-815b-3f11febeb374",
                                        "entry_id": "1ce2f706-836d-3c95-b39c-a1d7c31bbcf7",
                                        "glosses": [
                                            "eine Haftstrafe zwischen einem Tag und fünf Jahren ohne generelle Arbeitspflicht"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d0bb152-bfb0-4bf8-bc06-7bc386204858",
                                                "sense_id": "61a6f750-b4dc-3e13-815b-3f11febeb374",
                                                "text": "„Nach alledem wurde der bauleitende Architekt zu einer Gefängnisstrafe von 20 Tagen, der selbständige Architekt zu einer Gefängnisstrafe von 30 Tagen und der Unternehmer zu einer Gefängnisstrafe von 40 Tagen verurteilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fadbe54-7036-4d1a-9fc5-39ebdb358d16",
                        "source_entry_id": "ca54e728-d9ea-3699-81fa-d7316fa569f2",
                        "source_sense_id": "01ac8f5f-8d50-378f-9970-a5a3c55b822e",
                        "source_sense_description": "een veroordeling waarbij iemand een zekere tijd zijn vrijheid verliest",
                        "target_lang_word": "imprisonment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprisonment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                        "entry_id": "fe5aedf6-b95e-3f90-8902-576163ce428b",
                                        "glosses": [
                                            "A confinement in a place, especially a prison or a jail, especially as punishment for a crime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "703723e8-a699-43b7-b7e0-5522de697c08",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "His sinews woxen weake and raw / Through long emprisonment and hard constraint."
                                            },
                                            {
                                                "example_id": "3ac79ea7-a2c2-47f0-8141-7d1d309527b4",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "Every confinement of the person is an imprisonment, whether it be in a common prison, or in a private house, or even by forcibly detaining one in the public streets."
                                            },
                                            {
                                                "example_id": "567f1ae2-8bd0-4bd3-9da4-3a7859e2107d",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "Oh, by what plots, by what forswearings, betrayings, oppressions, imprisonments, tortures, poisonings, and under what reasons of state and politic subtilty, have these forenamed kings […] pulled the vengeance of God upon themselves […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
