                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f52ff02-46ee-41da-8a42-d07aca59ea4a",
                                "sense_id": "2723109d-d8fc-3fad-b72e-14b970c14718",
                                "text": "Er warf plötzlich den linken Arm in die Luft und schlug hintenüber zu Boden, mit einem starken Krach und so steif, daß das seidene Kleid keine einzige Falte warf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
