    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04a1ac72-e155-3b6d-a70d-519d9a6bba82",
                    "sense_definition": "A small bunch of flowers; a bouquet or nosegay.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little girl picked wildflowers in the meadow to make a charming <w>posy</w> for her mother.",
                            "target_lang_translations": {
                                "ru": "Маленькая девочка собирала на лугу полевые цветы, чтобы составить прелестный <w>букетик</w> для своей мамы."
                            }
                        },
                        {
                            "text": "Each bridesmaid held a delicate <w>posy</w> tied with silk ribbons during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Во время церемонии каждая подружка невесты держала изящный <w>букетик</w>, перевязанный шелковыми лентами."
                            }
                        }
                    ],
                    "synonyms": [
                        "bouquet",
                        "nosegay"
                    ],
                    "common_phrases": [
                        "pocket full of posies"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой букет цветов; букетик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "букетик",
                                "target_lang_sense_clarification": "маленький букет цветов"
                            },
                            {
                                "target_lang_word": "букет",
                                "target_lang_sense_clarification": "связка срезанных цветов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11797ff0-4524-3ef4-bce8-b81c3b6510bb",
                    "sense_definition": "A brief verse of poetry, especially a motto or sentimental inscription inside a ring.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique wedding band was engraved with a romantic <w>posy</w> written in old script.",
                            "target_lang_translations": {
                                "ru": "На старинном обручальном кольце была выгравирована романтическая <w>стихотворная надпись</w>, выполненная старинным шрифтом."
                            }
                        },
                        {
                            "text": "He asked the jeweler to carve a gentle <w>posy</w> inside the golden ring.",
                            "target_lang_translations": {
                                "ru": "Он попросил ювелира вырезать нежную <w>надпись</w> на внутренней стороне золотого кольца."
                            }
                        }
                    ],
                    "synonyms": [
                        "motto",
                        "inscription"
                    ],
                    "common_phrases": [
                        "posy ring"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое стихотворение или сентиментальная стихотворная надпись, девиз (особенно на внутренней стороне кольца)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надпись",
                                "target_lang_sense_clarification": "гравировка или девиз на кольце"
                            },
                            {
                                "target_lang_word": "стихотворная надпись",
                                "target_lang_sense_clarification": "короткий стих или девиз на подарке или украшении"
                            },
                            {
                                "target_lang_word": "стишок",
                                "target_lang_sense_clarification": "короткое поэтическое четверостишие или строка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}