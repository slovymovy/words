                {
                    "sense_id": "63cfa194-ecb0-3267-8250-f4e394c41059",
                    "sense_definition": "Не сильно, без большого усилия или нажима (о физическом действии).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>слегка</w> коснулся её руки, чтобы привлечь внимание.",
                            "target_lang_translations": {
                                "en": "He <w>lightly</w> touched her hand to get her attention.",
                                "nl": "Hij raakte haar hand <w>zachtjes</w> aan om haar aandacht te trekken.",
                                "pl": "On <w>lekko</w> dotknął jej ręki, żeby zwrócić na siebie uwagę.",
                                "de": "Er berührte <w>leicht</w> ihre Hand, um ihre Aufmerksamkeit zu erregen.",
                                "fr": "Il a <w>légèrement</w> effleuré sa main pour attirer son attention.",
                                "it": "Lui le ha <w>leggermente</w> sfiorato la mano per attirare la sua attenzione.",
                                "cs": "Aby upoutal její pozornost, <w>lehce</w> se dotkl její ruky.",
                                "tr": "Dikkat çekmek için eline <w>hafifçe</w> dokundu.",
                                "es": "Él <w>suavemente</w> tocó su mano para llamar su atención.",
                                "zh": "他<w>轻轻</w>碰了碰她的手以引起注意。"
                            }
                        },
                        {
                            "text": "Ветер <w>слегка</w> покачивал ветки деревьев в саду.",
                            "target_lang_translations": {
                                "en": "The wind was <w>gently</w> rocking the tree branches in the garden.",
                                "nl": "De wind deed de takken van de bomen in de tuin <w>lichtjes</w> wiegen.",
                                "pl": "Wiatr <w>delikatnie</w> kołysał gałęziami drzew w ogrodzie.",
                                "de": "Der Wind ließ die Äste der Bäume im Garten <w>sanft</w> schaukeln.",
                                "fr": "Le vent faisait <w>légèrement</w> osciller les branches des arbres dans le jardin.",
                                "it": "Il vento faceva <w>delicatamente</w> oscillare i rami degli alberi in giardino.",
                                "cs": "Vítr <w>jemně</w> pohupoval větvemi stromů v zahradě.",
                                "tr": "Rüzgar bahçedeki ağaç dallarını <w>hafifçe</w> sallıyordu.",
                                "es": "El viento <w>suavemente</w> mecía las ramas de los árboles en el jardín.",
                                "zh": "风在<w>轻轻</w>摇动花园里的树枝。"
                            }
