                "senses": [
                    {
                        "sense_id": "24ce708f-ff80-3a70-a6be-a675cd612af0",
                        "entry_id": "05945577-127a-3787-9bf1-22a9821c3de8",
                        "glosses": [
                            "Sinn, Grund der Existenz, des Daseins von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f497d0d6-dfc2-42ed-9fd3-9cc2a314f496",
                                "sense_id": "24ce708f-ff80-3a70-a6be-a675cd612af0",
                                "text": "„Roh gesagt, scheinen mir Bücher diesen Existenzzweck zu haben: uns zum Bewußtsein und damit zum Genuß des eigenen Daseins zu verhelfen.“"
                            },
                            {
                                "example_id": "daf615aa-ea64-4c03-a339-b9f4adc1618b",
                                "sense_id": "24ce708f-ff80-3a70-a6be-a675cd612af0",
                                "text": "„Der Purpose einer Organisation beschreibt ihren Existenzzweck und ihre langfristige Entwicklungsrichtung.“"
                            },
                            {
                                "example_id": "b8702af5-999f-4b5f-b313-0d17d9007013",
                                "sense_id": "24ce708f-ff80-3a70-a6be-a675cd612af0",
                                "text": "„Sein Existenzzweck ist das Wohlergehen der Gemeinschaft als Ganzes, weshalb es ihm an nichts fehlt, was er für sein persönliches Wohlbefinden benötigt.“"
                            },
                            {
                                "example_id": "af1c9988-f2da-4c24-a570-78378aaf8826",
                                "sense_id": "24ce708f-ff80-3a70-a6be-a675cd612af0",
                                "text": "„Falls Sie erfolgreich sind, werde ich meinen Existenzzweck niederlegen und die heilige Gelegenheit für jeden, das Glück zu erfahren.“"
                            },
                            {
                                "example_id": "2a03363c-6a1a-4735-9287-f2721230509b",
                                "sense_id": "24ce708f-ff80-3a70-a6be-a675cd612af0",
                                "text": "„In Wahrheit hört die Gesellschaft nicht zu bestehen auf, sondern sie hört nur auf, ihre bisherigen Existenzzwecke zu verfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
