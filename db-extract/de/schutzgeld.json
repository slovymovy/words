                ],
                "senses": [
                    {
                        "sense_id": "d1c03130-b804-3bfd-813e-6b11f1239871",
                        "entry_id": "60dd25bb-73ef-385a-897a-dd8265125dbf",
                        "glosses": [
                            "regelmäßig zu entrichtender Geldbetrag, den eine kriminelle Organisation unter Androhung oder Anwendung von Gewalt von Geschäftsleuten (Wirte, Ladenbesitzer) erpresst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ef34c14-f77c-4aa0-89c1-008fbc44dfd1",
                                "sense_id": "d1c03130-b804-3bfd-813e-6b11f1239871",
                                "text": "„Rivalisierende Banden der vietnamesischen Zigarettenmafia kämpfen um die Verkaufsplätze und treiben Schutzgeld ein.“"
                            },
                            {
                                "example_id": "bcd05427-caea-45a9-b208-7768c723c39b",
                                "sense_id": "d1c03130-b804-3bfd-813e-6b11f1239871",
                                "text": "„Sie verspricht Schutz und Sicherheit und verlangt dafür eine monatliche Entlohnung, das sogenannte Schutzgeld.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "058c6942-274f-4755-bfa4-2efe20ee35d3",
                        "source_entry_id": "60dd25bb-73ef-385a-897a-dd8265125dbf",
                        "source_sense_id": "d1c03130-b804-3bfd-813e-6b11f1239871",
                        "target_lang_word": "protection money",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protection money",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cdfb4d0-4e84-344c-858a-b9ef9e1509ba",
                                        "entry_id": "a162f91e-579b-3c74-8d73-c8299cd2a1ec",
                                        "glosses": [
                                            "Money paid, especially at regular intervals, to criminals or to corrupt officials who threaten to cause harm to the payer or to his or her business if the money is not paid."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b540e9a-687a-41f3-b1da-43b76cca8a5b",
                                                "sense_id": "3cdfb4d0-4e84-344c-858a-b9ef9e1509ba",
                                                "text": "Four members of an Asian gang were arrested yesterday and charged with extortion and conspiracy for demanding protection money from Chinese restaurants in Sunset Park, Brooklyn."
                                            },
                                            {
                                                "example_id": "f69887c8-4222-47df-8ca1-d162d4d86c14",
                                                "sense_id": "3cdfb4d0-4e84-344c-858a-b9ef9e1509ba",
                                                "text": "[T]he Mungiki . . . hit the headlines in April with a string of beheadings as they tussled for control of lucrative bus routes by executing drivers and conductors who refused to pay protection money."
                                            },
                                            {
                                                "example_id": "6a25027c-45f3-47c1-8ec3-ead48686f53e",
                                                "sense_id": "3cdfb4d0-4e84-344c-858a-b9ef9e1509ba",
                                                "text": "[T]he FSB, interior ministry and police collect protection money from businesses."
                                            },
                                            {
                                                "example_id": "155c03cc-1c20-4bc6-b822-a66ab3ef0a38",
                                                "sense_id": "3cdfb4d0-4e84-344c-858a-b9ef9e1509ba",
                                                "text": "Those in the Lowland line who lay near him, and desired to enjoy their lives and property in quiet, were contented to pay him a small composition, in name of protection money, and comforted themselves with the old proverb that it was better to \"fleech the deil than fight him.\""
                                            },
                                            {
                                                "example_id": "95df5707-d0e5-4268-8f05-6faac799ba2a",
                                                "sense_id": "3cdfb4d0-4e84-344c-858a-b9ef9e1509ba",
                                                "text": "[T]he police had raised the tariff for sporting houses, and would collect seventy-five and a hundred a month protection money."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf062e2c-c795-4028-951f-3754dbb31a53",
                        "source_entry_id": "60dd25bb-73ef-385a-897a-dd8265125dbf",
                        "source_sense_id": "d1c03130-b804-3bfd-813e-6b11f1239871",
