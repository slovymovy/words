                                                "sense_id": "254f3c77-11f9-30e6-a240-88661c75bb99",
                                                "text": "Un petit ramoneur."
                                            },
                                            {
                                                "example_id": "530f22f4-7cc9-4583-9530-55de12a8da1c",
                                                "sense_id": "254f3c77-11f9-30e6-a240-88661c75bb99",
                                                "text": "Il était noir comme un ramoneur."
                                            },
                                            {
                                                "example_id": "969f4e62-54c0-439a-8d08-98b1d50c5315",
                                                "sense_id": "254f3c77-11f9-30e6-a240-88661c75bb99",
                                                "text": "Un jeune ramoneur dont la figure bouffie était noire, le corps brun de suie, les vêtements déguenillés, tendit la main à cet homme pour lui arracher ses derniers sous."
                                            },
                                            {
                                                "example_id": "15d2e77b-a918-4735-a7f1-1a10bfafecbe",
                                                "sense_id": "254f3c77-11f9-30e6-a240-88661c75bb99",
                                                "text": "Les ramoneurs savoyards étaient aussi revenus, poussant leur cri d’automne, qui déjà, les années précédentes, me serrait le cœur à me faire pleurer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88a4c699-22ff-37da-97e1-2c5f1cf05aeb",
