                    },
                    {
                        "translation_id": "949d88de-4aff-450b-9948-2883d109d0d9",
                        "source_entry_id": "93d5b5ae-6510-38d4-8e1e-0d7cb6482d8d",
                        "source_sense_id": "add71f3a-3486-39f9-9104-e1d976e8ad71",
                        "source_sense_description": "de manier waarop men te werk gaat",
                        "target_lang_word": "méthode",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méthode",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4311b4c-a226-3bc8-bf1c-86566443cf8e",
                                        "entry_id": "99ec64b9-2d60-3bd6-abba-3806fb2c971c",
                                        "glosses": [
                                            "Manière de conduire sa pensée, de penser, de dire ou de faire quelque chose suivant certains principes et avec un certain ordre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97444608-c69f-492e-b4dc-8066d7df779e",
                                                "sense_id": "c4311b4c-a226-3bc8-bf1c-86566443cf8e",
                                                "text": "[…] le progrès est un perpétuel devenir, nulle méthode ne saurait être considérée comme immuable, tout est en mouvement, tout est continuellement améliorable, tout ce qui existe aujourd’hui sera demain mieux encore…"
                                            },
                                            {
                                                "example_id": "f8cbbf81-19c7-4e9c-ab63-6f9c2e89eb43",
                                                "sense_id": "c4311b4c-a226-3bc8-bf1c-86566443cf8e",
                                                "text": "Mais cette scolastique de l’espionnage, et la méthode si raisonnable des recoupements, enivrent ceux qui y participent, et encore plus ceux qui les ont inventées."
                                            },
                                            {
                                                "example_id": "15a3c82e-ae03-42c0-b5b2-8799db5bccad",
                                                "sense_id": "c4311b4c-a226-3bc8-bf1c-86566443cf8e",
                                                "text": "Arsène André étend ce mépris aux méthodes scolaires. […], une pédagogie qui refuse par système le bénéfice éprouvé des leçons sues par cœur."
                                            },
                                            {
                                                "example_id": "ca11ee58-debb-4dea-ab82-06f37f2a4530",
                                                "sense_id": "c4311b4c-a226-3bc8-bf1c-86566443cf8e",
                                                "text": "Quelle que soit la méthode de synthèse utilisée, l’alcool γ-acétopropylique se sépare et se purifie par distillation sous vide (78-80°/5 mm Hg)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c43e3068-b675-3b44-9614-3409f8c84688",
                                        "entry_id": "99ec64b9-2d60-3bd6-abba-3806fb2c971c",
                                        "glosses": [
                                            "Disposition des matières et des pensées dans l’ordre le plus conforme à la raison et le plus propre à faciliter l’intelligence de l’ensemble, en parlant des ouvrages de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d7b498b-21e5-465b-8849-32a63dd57084",
                                                "sense_id": "c43e3068-b675-3b44-9614-3409f8c84688",
                                                "text": "Il n’y a point de méthode, il y a beaucoup de méthode dans ce livre."
                                            },
                                            {
                                                "example_id": "91ad5566-9f6b-47cc-a666-b20db69b79e8",
                                                "sense_id": "c43e3068-b675-3b44-9614-3409f8c84688",
                                                "text": "Le défaut de cet exposé est une complète absence de méthode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0599b662-3b2e-34ca-9471-1b1104b3d473",
                                        "entry_id": "99ec64b9-2d60-3bd6-abba-3806fb2c971c",
                                        "glosses": [
                                            "Distribution des êtres de même nature en plusieurs divisions selon une classification naturelle, par opposition au système."
                                        ],
                                        "tags": [
                                            "Histoire naturelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33aecc2a-ab16-492d-b2b3-968d7557402c",
                                                "sense_id": "0599b662-3b2e-34ca-9471-1b1104b3d473",
                                                "text": "Méthode de classification de Linné, de Jussieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c4b3095-4d86-31fc-8d8e-51003b55a816",
                                        "entry_id": "99ec64b9-2d60-3bd6-abba-3806fb2c971c",
                                        "glosses": [
                                            "Titre de certains livres élémentaires, et particulièrement de ceux qui concernent l’étude des langues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e79cd509-e843-4c7b-b837-d5abe011c518",
                                                "sense_id": "8c4b3095-4d86-31fc-8d8e-51003b55a816",
                                                "text": "La Méthode grecque, la méthode latine de Royal."
                                            },
                                            {
                                                "example_id": "12c9dc5d-4a30-4580-8cce-b7fff9348f53",
                                                "sense_id": "8c4b3095-4d86-31fc-8d8e-51003b55a816",
                                                "text": "Méthode de violon, de dessin, d’aquarelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e05f3660-cb5e-3ba3-9df8-d648e8a60b20",
                                        "entry_id": "99ec64b9-2d60-3bd6-abba-3806fb2c971c",
                                        "glosses": [
                                            "Usage, coutume, habitude, manière d’être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0421e15d-b6e6-4658-a56e-b1650dba5a62",
                                                "sense_id": "e05f3660-cb5e-3ba3-9df8-d648e8a60b20",
                                                "text": "[…] je décidai de passer l’après midi avec eux, d’étudier leurs méthodes de plonge et de prendre plusieurs films."
                                            },
                                            {
                                                "example_id": "1b2a7564-a580-442d-a0d9-81091e07b95f",
                                                "sense_id": "e05f3660-cb5e-3ba3-9df8-d648e8a60b20",
                                                "text": "Chacun a sa méthode."
                                            },
                                            {
                                                "example_id": "28eb7cb4-8262-4d8d-b1f6-cd5a21b08d15",
                                                "sense_id": "e05f3660-cb5e-3ba3-9df8-d648e8a60b20",
                                                "text": "Selon sa méthode, il est allé dormir après dîner."
                                            },
                                            {
                                                "example_id": "35c0e947-1fb5-411a-b6b9-e01e8c77a9b8",
                                                "sense_id": "e05f3660-cb5e-3ba3-9df8-d648e8a60b20",
                                                "text": "C’est sa méthode de tout faire par lui-même. Il vieillit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b3ddf81-ad52-330d-adc6-48e1c627500f",
                                        "entry_id": "99ec64b9-2d60-3bd6-abba-3806fb2c971c",
                                        "glosses": [
                                            "Fonction ou procédure associée à une classe ou un objet."
                                        ],
                                        "tags": [
                                            "Programmation orientée objet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
