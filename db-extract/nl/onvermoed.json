                "senses": [
                    {
                        "sense_id": "c535ea29-bde0-3b27-ac44-11bfb3e91b3b",
                        "entry_id": "f1c8e3c1-57e8-31ed-8f0f-047203252558",
                        "glosses": [
                            "waar je geen vermoeden van had en toch gebeurt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d561e4bb-964d-48fa-bc7b-4bcccbec667b",
                                "sense_id": "c535ea29-bde0-3b27-ac44-11bfb3e91b3b",
                                "text": "De 32-jarige Peter Kuipers Munneke wordt de nieuwe weerman van de NOS. Hij voegt zich vanaf 1 maart bij het team dat verder bestaat uit Gerrit Hiemstra, Willemijn Hoebert en Marco Verhoef. 'Na een onorthodoxe zoektocht die meer dan honderd gegadigden aantrok, hebben we een nieuw en onvermoed talent gevonden', meldt de NOS, die na het vertrek van de legendarische Erwin Kroll op zoek was naar een opvolger."
                            },
                            {
                                "example_id": "1d2b42c1-3512-49c6-b2aa-1064ffee2135",
                                "sense_id": "c535ea29-bde0-3b27-ac44-11bfb3e91b3b",
                                "text": "Oolbekkink boort voor veertig euro per meter (ex-BTW). Een eenvoudige bron met toebehoren kost, als alles vlotjes verloopt zo'n duizend euro. Maar zit het water diep of loopt het tegen door onvermoed dikke of stenige grondlagen, dan wordt dat al snel meer."
                            },
                            {
                                "example_id": "8c0f48d9-d527-4372-adb3-aff26b1f8faf",
                                "sense_id": "c535ea29-bde0-3b27-ac44-11bfb3e91b3b",
                                "text": "De slotfase was toch nog onvermoed hectisch. Eerst liet Habib Bamogo na Nice op 3-2 te brengen door een strafschop te missen, vervolgens maakte André Ayew zijn derde van de avond en scoorde ook Renato Civelli nog in blessuretijd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acea202f-9393-42d3-9196-7c3e5eef3bfe",
                        "source_entry_id": "f1c8e3c1-57e8-31ed-8f0f-047203252558",
                        "source_sense_id": "c535ea29-bde0-3b27-ac44-11bfb3e91b3b",
                        "target_lang_word": "unsuspected",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsuspected",
