                        ],
                        "examples": [
                            {
                                "example_id": "125b0ea4-d98b-41c4-93a6-8086d9cc1c56",
                                "sense_id": "02de3b40-4cdd-3a3f-aca4-832013552c81",
                                "text": "„Die berühmte Reimchronik des sogenannten Dalimil verurteilte die Kolonisierungspolitik der böhmischen Könige, die die Fremden nur hereingeholt habe, um Erträge aus dem Land zu pressen.“"
                            },
                            {
                                "example_id": "3a1270b3-99c6-4018-8ad7-503218741890",
                                "sense_id": "02de3b40-4cdd-3a3f-aca4-832013552c81",
                                "text": "„Endlich mögen auch die altdänischen und schwedischen Reimchroniken berücksichtigt werden, die zwar nichts Eigenthümliches melden, aber doch wenigstens das schon Bekannte bestätigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
