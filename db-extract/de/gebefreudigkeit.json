                "senses": [
                    {
                        "sense_id": "b4b8e94f-445b-3c75-bce4-987364414823",
                        "entry_id": "3ab6c303-2197-371b-9fec-2ad4a79df991",
                        "glosses": [
                            "persönliche Eigenschaft, gerne etwas den Mitbürgern kostenlos zu überlassen beziehungsweise zu schenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c3f958-d68d-44a6-b748-6539ada210a2",
                                "sense_id": "b4b8e94f-445b-3c75-bce4-987364414823",
                                "text": "„Die liebevolle Gebefreudigkeit Gottes äußert sich in den Worten über die Gebetserhörung.“"
                            },
                            {
                                "example_id": "5de55d46-2f8d-4b5a-a816-4885a4bb2732",
                                "sense_id": "b4b8e94f-445b-3c75-bce4-987364414823",
                                "text": "„Ein Großstadtbettler hat sehr schnell heraus, zu welchen Zeiten und an welchen Stellen die Gebefreudigkeit am größten ist.“"
                            },
                            {
                                "example_id": "4aeacc17-3a34-48aa-b121-139165fe97da",
                                "sense_id": "b4b8e94f-445b-3c75-bce4-987364414823",
                                "text": "„Die Gebefreudigkeit der Spender wurde durch das Versprechen der Ablaßgewährung angeregt.“"
                            },
                            {
                                "example_id": "bcf94c38-b196-4a43-8dd3-1cd27c2f386c",
                                "sense_id": "b4b8e94f-445b-3c75-bce4-987364414823",
                                "text": "„Lewin legte daran anknüpfend das Ziel der Gemeinschaftserziehung dar: »Das Helfenkönnen und die Gebefreudigkeit müssen die elementarsten Eigenschaften unserer Kinder werden.«“"
                            },
                            {
                                "example_id": "a012a70e-608c-4028-ba53-d4009dfc32ea",
                                "sense_id": "b4b8e94f-445b-3c75-bce4-987364414823",
                                "text": "„Das Klima war zumeist von einer wundersamen warmen Milde, allenthalben gab es das herrlichste Süßwasser und die Erde war, ohne gepflegt zu werden, von einer unerhörten Gebefreudigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afa61c4b-465f-4c21-9eb8-c790cc529039",
                        "source_entry_id": "3ab6c303-2197-371b-9fec-2ad4a79df991",
                        "source_sense_id": "b4b8e94f-445b-3c75-bce4-987364414823",
                        "source_sense_description": "persönliche Eigenschaft, gerne etwas den Mitbürgern kostenlos zu überlassen beziehungsweise zu schenken",
                        "target_lang_word": "générosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "générosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7cb7ba-ac98-3b4a-a295-e3f94d604b0f",
                                        "entry_id": "d78f48d2-77ee-30c1-b6f4-e87a6c2fe2b7",
                                        "glosses": [
                                            "Disposition à donner plus qu’on n’est tenu de donner et à recevoir moins qu’on pourrait réclamer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55357a90-c84a-4d20-9712-edc93494e5b5",
                                                "sense_id": "2e7cb7ba-ac98-3b4a-a295-e3f94d604b0f",
                                                "text": "Sa générosité n'est pas faiblesse ; son obligeance ne dépasse pas les obligations normales et naturelles ; aucune arrière-pensée en son comportement."
                                            },
                                            {
                                                "example_id": "0001200f-2370-4aba-8a1c-c0ad8411e80b",
                                                "sense_id": "2e7cb7ba-ac98-3b4a-a295-e3f94d604b0f",
                                                "text": "À son hypocrite travail d’approche, n’avaient répondu que des demi-promesses et de menues privautés, en échange de gestes de générosité financière d’importance croissante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "009b63e1-f16e-31f4-aeba-e119b727c559",
                                        "entry_id": "d78f48d2-77ee-30c1-b6f4-e87a6c2fe2b7",
                                        "glosses": [
                                            "Noblesse, élévation de sentiments."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f9cff8a-7411-4cd4-b351-3847735b02cc",
                                                "sense_id": "009b63e1-f16e-31f4-aeba-e119b727c559",
                                                "text": "Au début de son pontificat, il s'était, il est vrai, montré bienveillant, moins par générosité naturelle, que dans le dessein de favoriser la conversion des juifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38ca1a12-783b-302d-bbf5-83b26c3cf181",
                                        "entry_id": "d78f48d2-77ee-30c1-b6f4-e87a6c2fe2b7",
                                        "glosses": [
                                            "Actes de générosité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41f912c-f0ef-4b2c-a511-98de696afa6a",
                                                "sense_id": "38ca1a12-783b-302d-bbf5-83b26c3cf181",
                                                "text": "Faire des générosités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4642a437-14e9-4efc-ada1-4611646ab8cb",
                        "source_entry_id": "3ab6c303-2197-371b-9fec-2ad4a79df991",
                        "source_sense_id": "b4b8e94f-445b-3c75-bce4-987364414823",
                        "source_sense_description": "persönliche Eigenschaft, gerne etwas den Mitbürgern kostenlos zu überlassen beziehungsweise zu schenken",
                        "target_lang_word": "largesse",
