                                "target_senses": [
                                    {
                                        "sense_id": "9c6a1fdc-760a-3cf9-91e1-46ab94204812",
                                        "entry_id": "a2304bdf-14a3-38d0-b881-50af9609e98c",
                                        "glosses": [
                                            "A severe mental disorder, sometimes with physical damage to the brain, marked by a deranged personality and a distorted view of reality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b155b483-b2a0-4a27-b739-809d7ab9c8b4",
                                                "sense_id": "9c6a1fdc-760a-3cf9-91e1-46ab94204812",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese[…]began to totter, slur their speech and behave like someone inebriated. The poisoning was irreversible, and soon ended in psychosis and death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
