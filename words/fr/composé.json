                {
                    "sense_id": "a3af9f81-cf50-3840-9b39-a70444768f1a",
                    "sense_definition": "Qualifie un temps verbal formé à l'aide d'un auxiliaire et d'un participe passé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves apprennent à conjuguer le passé <w>composé</w> dès le début de l'année."
                        },
                        {
                            "text": "Le plus-que-parfait est également un temps <w>composé</w> très utilisé en français."
                        }
                    ],
                    "antonyms": [
                        "simple"
                    ],
                    "common_phrases": [
                        "passé composé",
                        "temps composé"
                    ]
                },
                {
                    "sense_id": "27f51138-23d9-3b33-bafa-dce123d4c482",
                    "sense_definition": "Formé par la réunion de plusieurs éléments ou parties distincts.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce plat traditionnel est <w>composé</w> de légumes de saison et d'épices variées."
                        },
                        {
                            "text": "Le jury est <w>composé</w> de cinq spécialistes reconnus dans leur domaine."
                        }
                    ],
                    "antonyms": [
                        "simple"
                    ],
                    "common_phrases": [
