        "nl-extract.jsonl": [
            {
                "entry_id": "2594dad3-c163-39e1-a375-9d33f7593db2",
                "word": "samenwerking",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "44ce0320-8058-4109-a851-5f4a2dbf6797",
                        "entry_id": "2594dad3-c163-39e1-a375-9d33f7593db2",
                        "tags": [
                            "plural"
                        ],
                        "form": "samenwerkingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2d7d6ba-9c68-36e3-bf20-3eb5894128f2",
                        "entry_id": "2594dad3-c163-39e1-a375-9d33f7593db2",
                        "glosses": [
                            "het samenwerken van meerdere personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ef2a83c-e5f7-474e-b250-7568ed6d5cce",
                                "sense_id": "d2d7d6ba-9c68-36e3-bf20-3eb5894128f2",
                                "text": "Voor het slagen van het project is een goede samenwerking van belang."
                            },
                            {
                                "example_id": "2d9f2362-9582-4e32-895f-d53be4e10d4d",
                                "sense_id": "d2d7d6ba-9c68-36e3-bf20-3eb5894128f2",
                                "text": "Het ritme van het lopen met soms wel 70.000 stappen per dag vormde een innerlijke kadans, waarvan sommige wetenschappers beweren dat er op deze manier een inventieve samenwerking ontstaat tussen de twee helften van je brein."
                            },
                            {
                                "example_id": "1c5d7378-3887-4907-9d3f-5df09efc254b",
                                "sense_id": "d2d7d6ba-9c68-36e3-bf20-3eb5894128f2",
                                "text": "Denemarken ook nauwelijks, in de pers hadden ze het uitgebreid gehad over de gemoedelijke verhouding tussen de Deense bevolking en de Duitse gasten. De koning en de regering van Denemarken zaten nog op hun plaats en de samenwerking leek uitstekend te functioneren binnen de Germaanse verbroedering."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4de253ec-8499-4580-b92e-20f400c7aaa3",
                        "source_entry_id": "2594dad3-c163-39e1-a375-9d33f7593db2",
                        "source_sense_id": "d2d7d6ba-9c68-36e3-bf20-3eb5894128f2",
                        "source_sense_description": "het samenwerken van meerdere personen",
                        "target_lang_word": "Zusammenarbeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammenarbeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4fcff40-0d0f-32e2-918b-3a264d987965",
                                        "entry_id": "54d35c7c-f4a5-3337-8bd8-0048c5686b65",
                                        "glosses": [
                                            "das gemeinschaftliche Arbeiten an einer Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42e0e432-39e1-46a5-a7dc-d90ffe116d56",
                                                "sense_id": "f4fcff40-0d0f-32e2-918b-3a264d987965",
                                                "text": "Aufgrund der komplexen Anforderungen waren sie zur Zusammenarbeit gezwungen."
                                            },
                                            {
                                                "example_id": "a16ff781-06a3-40e2-bde5-a79580b1ee88",
                                                "sense_id": "f4fcff40-0d0f-32e2-918b-3a264d987965",
                                                "text": "„Das Komitee sollte Arbeitsgruppen für die verschiedenen Gebiete ernennen, die in Zusammenarbeit mit Filmexperten Empfehlungen und Vorschläge für einen Produktionsplan und seine praktische Verwirklichung vorlegen würden.“"
                                            },
                                            {
                                                "example_id": "a35170d5-0a80-46b0-a567-920e6d60e04b",
                                                "sense_id": "f4fcff40-0d0f-32e2-918b-3a264d987965",
                                                "text": "„Wielands Zusammenarbeit mit Schweitzer war eng, was nicht die Regel war und ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f430ae1-2de3-44ed-8aab-9c1ddd365896",
                        "source_entry_id": "2594dad3-c163-39e1-a375-9d33f7593db2",
                        "source_sense_id": "d2d7d6ba-9c68-36e3-bf20-3eb5894128f2",
                        "source_sense_description": "het samenwerken van meerdere personen",
                        "target_lang_word": "collaboration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collaboration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ffb8c58-700e-37b8-b472-b80adc7f8977",
                                        "entry_id": "3e2fad05-beab-36a5-8c5c-e71bcf8f2ea9",
                                        "glosses": [
                                            "Action de travailler de concert avec un ou plusieurs autres."
                                        ],
                                        "tags": [],
                                        "note": "Il se dit principalement des travaux littéraires, scientifiques ou administratifs",
                                        "examples": [
                                            {
                                                "example_id": "e5a88273-365d-45e2-9584-8434d3a1a05d",
                                                "sense_id": "3ffb8c58-700e-37b8-b472-b80adc7f8977",
                                                "text": "En 1873, le bryologue RENAUD publiait, en collaboration avec D. LALOY, un excellent Catalogue des plantes phanérogames et des Mousses observées jusqu'à cette époque dans le département de la Haute-Saône ; […]."
                                            },
                                            {
                                                "example_id": "466a72bd-e5c7-4ee4-948a-d49dcba92600",
                                                "sense_id": "3ffb8c58-700e-37b8-b472-b80adc7f8977",
                                                "text": "Elles étaient deux sœurs. J’allais les voir de temps à autre dans le coquet appartement de Passy où elles vivaient avec leur mère. Intelligentes, instruites, elles se destinaient à la littérature et préparaient en collaboration leur premier roman."
                                            },
                                            {
                                                "example_id": "c45db796-c1e9-4759-af15-7657403988be",
                                                "sense_id": "3ffb8c58-700e-37b8-b472-b80adc7f8977",
                                                "text": "Sa santé laissant de plus en plus à désirer il avait refusé le renouvellement de son mandat de T∴ P∴ S∴ G∴ C∴, mais le Sup∴ Cons∴, désireux de lui témoigner sa reconnaissance et de conserver sa précieuse collaboration, lui décerna à l'unanimité le titre de T∴ P∴ S∴ G∴ C∴ d'Honneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e72fbb3-4e03-3db3-a6dc-8c972e90b6d7",
                                        "entry_id": "3e2fad05-beab-36a5-8c5c-e71bcf8f2ea9",
                                        "glosses": [
                                            "Travaux et soins communs du mari et de la femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4e5052c-6a18-4c1b-937b-cccb73418c22",
                                                "sense_id": "2e72fbb3-4e03-3db3-a6dc-8c972e90b6d7",
                                                "text": "Le survivant hérite des biens acquis par la collaboration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85770816-5f5c-3e27-83a5-8052fcb2f303",
                                        "entry_id": "3e2fad05-beab-36a5-8c5c-e71bcf8f2ea9",
                                        "glosses": [
                                            "Fait de travailler avec l’ennemi."
                                        ],
                                        "tags": [],
                                        "note": "Ce terme a plus particulièrement été utilisé lors de la Seconde Guerre mondiale pour parler de la collaboration avec les nazis. La forme péjorative collabo est parfois employée dans ce sens",
                                        "examples": [
                                            {
                                                "example_id": "1d0628c6-ce88-4c0c-a975-12e138b91965",
                                                "sense_id": "85770816-5f5c-3e27-83a5-8052fcb2f303",
                                                "text": "Le chanteur corse avait cédé l’antenne à un chanteur parisien qui n’avais jamais bien su s’il avait été fait pour la goualante ou pour le prêche, et qui coupait ses refrains grivois de prônes où le bon sens se confondait avec la sottise, où la collaboration se mêlait au système D, et la vulgarité au contentement de soi."
                                            },
                                            {
                                                "example_id": "f66a261d-6277-4625-98a2-5c5002ea5991",
                                                "sense_id": "85770816-5f5c-3e27-83a5-8052fcb2f303",
                                                "text": "La collaboration, comme du reste la résistance active, fut, partout en Europe occidentale, l'aventure d'une minorité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bbb2538-8554-4002-bd32-90e72eb02b24",
                        "source_entry_id": "2594dad3-c163-39e1-a375-9d33f7593db2",
                        "source_sense_id": "d2d7d6ba-9c68-36e3-bf20-3eb5894128f2",
