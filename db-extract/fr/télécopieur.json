                "senses": [
                    {
                        "sense_id": "d11753ad-94f9-3edc-9181-eaa8fee08fcf",
                        "entry_id": "59a8df98-b1d5-350e-9538-f5a7825a7b09",
                        "glosses": [
                            "Appareil émetteur et récepteur de télécopie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5390c433-129a-4ae8-9353-9b31d95c65ee",
                                "sense_id": "d11753ad-94f9-3edc-9181-eaa8fee08fcf",
                                "text": "Je suis assis à ma table en pin à lorgner … vers le télécopieur qui s'est mis depuis quelques secondes à me tirer la langue en format A4."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "839d512d-c42e-40b1-a1f0-1b319192dde0",
                        "source_entry_id": "59a8df98-b1d5-350e-9538-f5a7825a7b09",
                        "source_sense_id": "d11753ad-94f9-3edc-9181-eaa8fee08fcf",
                        "target_lang_word": "Faxgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faxgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                                        "entry_id": "96dafd84-c1ec-355e-a4e1-718282d0d532",
                                        "glosses": [
                                            "Gerät, das Papier/Dokumente a) scannt und versendet und b) empfängt und ausdruckt"
                                        ],
                                        "tags": [
                                            "Telekommunikation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efb417bc-fd77-48e0-ab1d-e8278075c289",
                                                "sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                                                "text": "„»Aber wer hat denn heutzutage noch ein Faxgerät?«, fragt Arjona.“"
                                            },
                                            {
                                                "example_id": "ca65e463-86c3-498e-9569-606ffcc84029",
                                                "sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                                                "text": "Faxgeräte werden heute nur noch selten benutzt."
                                            },
                                            {
                                                "example_id": "c1e22df6-5850-4b9d-acac-913bc63dd153",
                                                "sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                                                "text": "In unserem Büro steht noch ein Faxgerät herum."
                                            },
                                            {
                                                "example_id": "3fa8591b-d6e4-46cc-bddd-38c9dd6425b1",
                                                "sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                                                "text": "„Mit Beginn des 21. Jahrhundert und dem Siegeszug des Internets, so dachte man, würden Faxgerät und Fax aus der modernen Arbeitswelt verschwinden.“"
                                            },
                                            {
                                                "example_id": "b962b44d-a2d9-4f35-8644-732af27abf4e",
                                                "sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                                                "text": "[Coronapandemie 2020:] „Wenn viel los ist, piept das Faxgerät in einem Gesundheitsamt auch mal mehrere Hundert Mal am Tag: Was ankommt, sind Testergebnisse aus Laboren und anderen Gesundheitsämtern sowie Listen mit Kontaktpersonen.“"
                                            },
                                            {
                                                "example_id": "8beb901c-3bc7-4dd9-b947-a6379788191d",
                                                "sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                                                "text": "[Coronapandemie 2021:] „Während Labore inzwischen Daten elektronisch übermitteln, kommunizieren Ämter untereinander weiterhin per Faxgerät.“"
                                            },
                                            {
                                                "example_id": "adced1f8-7d98-46c3-96d6-b49f9e4745fb",
                                                "sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                                                "text": "„Immer wieder fiel die Wortkombination \"Digitale Steinzeit\" in der Bewältigung der Corona-Pandemie in den vergangenen Monaten. Doch statt Faxgeräten setzt man mittlerweile auch auf den digitalen Fortschritt.“"
                                            },
                                            {
                                                "example_id": "59257708-0b6f-445e-8fda-a43c66da4514",
                                                "sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                                                "text": "„In den 1990er- und 2000er-Jahren erlebte das Faxgerät seine Blütezeit.“"
                                            },
                                            {
                                                "example_id": "a7fcd879-8064-4c86-87c6-b39b8ee56e23",
                                                "sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                                                "text": "„Schon der Datenaustausch innerhalb der deutschen Polizeibehörden verläuft nicht reibungslos, ganz zu schweigen vom Datenaustausch mit anderen Bundesbehörden. Innenminister de Maizière erzählt, wie etwa bei der Bewältigung der Flüchtlingswelle Dokumente ausgedruckt und anschließend per Faxgerät übermittelt wurden, weil es keine Schnittstellen zwischen den Datenbanken gab.“"
                                            },
                                            {
                                                "example_id": "892e7bb4-dfa9-4916-a1b6-4f8e81b62e79",
                                                "sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                                                "text": "„Das Faxgerät, von dem im vergangenen Sommer die Drohung an Basay-Yildiz geschickt wurde, ihre kleine Tochter zu \"schlachten\", steht offenbar im 1. Polizeirevier der Stadt Frankfurt am Main.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ab64016-b6d8-48fa-9708-7ce353e2c267",
                        "source_entry_id": "59a8df98-b1d5-350e-9538-f5a7825a7b09",
                        "source_sense_id": "d11753ad-94f9-3edc-9181-eaa8fee08fcf",
                        "target_lang_word": "facsimile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "facsimile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d088309-61ee-35c2-ae87-791cca5b3ece",
                                        "entry_id": "91ad8348-db54-39fc-af18-693551f28107",
                                        "glosses": [
                                            "A copy or reproduction."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04062f0b-1adb-433b-a708-8e19ffe94d85",
                                                "sense_id": "3d088309-61ee-35c2-ae87-791cca5b3ece",
                                                "text": "To paraphrase the critic of the Times, if one may make the facsimile of a human being out of bronze, why not the facsimile of a Brillo carton out of plywood?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae3c2273-e1dd-3e5e-bfd5-95f67ff975ce",
                                        "entry_id": "91ad8348-db54-39fc-af18-693551f28107",
                                        "glosses": [
                                            "Reproduction in the exact form as the original."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f0a5b87-3234-4fd4-81ea-5e3267a65bac",
                                                "sense_id": "ae3c2273-e1dd-3e5e-bfd5-95f67ff975ce",
                                                "text": "Indeed his rendering is so excellent an example of mediæval learning and latinity that, even at the risk of sating the learned reader with too many antiquities, I have made up my mind to give it in fac-simile, together with an expanded version for the benefit of those who find the contractions troublesome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97626b8a-6881-3177-95c0-059b96b77ecb",
                                        "entry_id": "91ad8348-db54-39fc-af18-693551f28107",
                                        "glosses": [
                                            "A fax, a machine for making and sending copies of printed material and images via radio or telephone network."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f03e30d9-e4c0-3a14-a433-cf081057eb4b",
                                        "entry_id": "91ad8348-db54-39fc-af18-693551f28107",
                                        "glosses": [
                                            "The image sent by the machine itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
