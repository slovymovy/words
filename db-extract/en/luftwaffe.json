                "senses": [
                    {
                        "sense_id": "1af80867-0894-3ca2-bbb9-a87eaa604f8b",
                        "entry_id": "e8e909f4-b35d-310a-87ce-f739e7f0db13",
                        "glosses": [
                            "The German air force, especially during the Second World War."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d37769c-16d2-442f-a9fe-e5810ae3af1b",
                                "sense_id": "1af80867-0894-3ca2-bbb9-a87eaa604f8b",
                                "text": "Politicians insist that lockdown under coronavirus is like the experience of wartime. It’s not – except in one way, which I’ll come to. It’s so quiet, for one thing. War is noisy. Sirens, soldiers tramping past singing, Luftwaffe engines in the night sky."
                            },
                            {
                                "example_id": "e2effa27-c59c-4497-b812-87c3e3be9308",
                                "sense_id": "1af80867-0894-3ca2-bbb9-a87eaa604f8b",
                                "text": "Owing to its location at the entrance to the River Tyne, South Shields was of strategic importance in the Second World War, especially to the merchant navy, and the town was heavily hit by a Luftwaffe strike in October 1941."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22cb940d-b5e6-4cbf-a157-698311ce5af3",
                        "source_entry_id": "e8e909f4-b35d-310a-87ce-f739e7f0db13",
                        "source_sense_id": "1af80867-0894-3ca2-bbb9-a87eaa604f8b",
                        "source_sense_description": "(military) the German air force, especially during the Second World War",
                        "target_lang_word": "Luftwaffe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftwaffe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e55480b2-460c-3ce1-b3de-f8a14b860e6c",
                                        "entry_id": "59efbdb1-fbc2-3fc1-b78c-b9cc3310e1e4",
                                        "glosses": [
                                            "für den Luftkrieg bestimmte Teilstreitkraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "067bac73-274f-4289-a015-603cdba8c682",
                                                "sense_id": "e55480b2-460c-3ce1-b3de-f8a14b860e6c",
                                                "text": "„Eine Frage wird die einer größeren Integration der Streitkräfte sein, ob es überhaupt Zweck hat, daß es eine belgische Luftwaffe gibt, eine holländische Luftwaffe, daß es eine deutsche Luftwaffe gibt und eine französische Luftwaffe, ob es nicht eine gemeinsame Luftwaffe geben muß ähnlich wie beim EVG-Vertrag.“"
                                            },
                                            {
                                                "example_id": "3447f672-9e66-45d4-be12-a07a999706fd",
                                                "sense_id": "e55480b2-460c-3ce1-b3de-f8a14b860e6c",
                                                "text": "„Seit der letzten Anfrage an die französische und britische Regierung vom 22. Juli 1949, […], stand lediglich fest, daß England willens war, eine österreichische Luftwaffe mit 5.000 Mann und insgesamt 90 Flugzeugen auszurüsten, und Frankreich sich bereit erklärte, leichte Waffen und Ausrüstung zur Verfügung zu stellen, […] .“"
                                            },
                                            {
                                                "example_id": "90a860fa-41ea-4cc9-8b54-8b2ca0793c73",
                                                "sense_id": "e55480b2-460c-3ce1-b3de-f8a14b860e6c",
                                                "text": "„Obwohl sich das Nazi-Regime nicht so extrem verhielt, gibt es zahlreiche Beispiele in Luftwaffe und Wehrmacht, wo die Loyalität gegenüber Hitler und der Partei mehr als die Befähigung zählte.“"
                                            },
                                            {
                                                "example_id": "35247b50-47a7-41de-807f-f245544e7721",
                                                "sense_id": "e55480b2-460c-3ce1-b3de-f8a14b860e6c",
                                                "text": "„Die deutsche Luftwaffe griff auch gestern mit stärkeren Verbänden von Kampf- und Sturzkampfflugzeugen britische Stellungen an der Nordküste Kretas wirksam an und versenkte im Seegebiet der Insel ein Vorpostenboot.“"
                                            },
                                            {
                                                "example_id": "28eff341-79d3-4199-bdc7-d2b08bd109b0",
                                                "sense_id": "e55480b2-460c-3ce1-b3de-f8a14b860e6c",
                                                "text": "„Der Einbau der Luftwaffe in die NATO-Luftverteidigung“"
                                            },
                                            {
                                                "example_id": "85915ec7-46e6-4597-9e8e-150dae80ae44",
                                                "sense_id": "e55480b2-460c-3ce1-b3de-f8a14b860e6c",
                                                "text": "„Das allwetterfähige mittlere Transportflugzeug A400M wird eine Lücke in der strategischen Lufttransportfähigkeit der Bundeswehr schließen und die Transportkapazität der Luftwaffe außerordentlich steigern: […] .“"
                                            },
                                            {
                                                "example_id": "69efbaed-0231-40f0-b251-8be7fc28f4fd",
                                                "sense_id": "e55480b2-460c-3ce1-b3de-f8a14b860e6c",
                                                "text": "„ARMEE aktuell – die Zeitschrift für die Armeeangehörigen der Luftwaffe – Erscheint zweimal jährlich“"
                                            },
                                            {
                                                "example_id": "797e7881-3678-44a9-a811-ca7ddacd077c",
                                                "sense_id": "e55480b2-460c-3ce1-b3de-f8a14b860e6c",
                                                "text": "„Organisatorisch teilt sich die Schweizer Armee in die Teilstreitkräfte Heer und Luftwaffe, die Logistikbasis der Armee, die Führungsunterstützungsbasis der Armee, den Stab des Chefs der Armee, den Planungs- und den Führungsstab sowie die höhere Kaderausbildung der Armee auf.“"
                                            },
                                            {
                                                "example_id": "e6a2c70a-7be4-4284-b2c2-d010d5f6d404",
                                                "sense_id": "e55480b2-460c-3ce1-b3de-f8a14b860e6c",
                                                "text": "„Die Luftwaffen der Nato besitzen meist Hunderte Flieger, die geschützt werden müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
