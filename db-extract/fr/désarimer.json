                "senses": [
                    {
                        "sense_id": "4b1013c2-60f6-3b23-97ae-f38ddcc43676",
                        "entry_id": "24a2723a-b50b-3ae4-ac55-1e2828d611e8",
                        "glosses": [
                            "Orthographe ancienne de désarrimer (défaire l’arrimage)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e17fea00-aadc-47eb-bcd2-01cffcff279d",
                                "sense_id": "4b1013c2-60f6-3b23-97ae-f38ddcc43676",
                                "text": "Elle se conserve mieux ainsi que dans des pièces en bois qui, quoique bien carbonisées, ont besoin d’être changées au bout d’un an, ou au moins lavées souvent et « recarbonisées », opération difficile, parce qu’il faudrait « désarimer la cale »."
                            },
                            {
                                "example_id": "85cff28b-2095-46f4-ab69-bc44266b4666",
                                "sense_id": "4b1013c2-60f6-3b23-97ae-f38ddcc43676",
                                "text": "Le 24, j’ai fait travailler mon équipage à aider au Profond, qui est obligé de se désarimer d’un bout à l’autre."
                            }
                        ]
                    }
                ],
