                                    },
                                    {
                                        "sense_id": "fdc31fd3-47bf-3fdd-a3da-334e92786334",
                                        "entry_id": "3c3303be-c477-3b1e-99bd-e00622ebb820",
                                        "glosses": [
                                            "A living."
                                        ],
                                        "tags": [
                                            "Australia",
