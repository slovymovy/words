                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b92d0d39-2182-4ba9-96d2-1a831f194816",
                                                "sense_id": "14835801-2919-3429-882f-a35d5f3c4296",
                                                "text": "„Dabei ist das Kernproblem nicht die wörtliche Übersetzung wie sie ein Dolmetscher vornimmt, sondern die Erhaltung der Ausdrucksstärke, der Stimmung und des Gehalts bei der interlingualen Übertragung.“"
                                            },
                                            {
                                                "example_id": "ef086c46-373c-4d27-be20-ed755974a12b",
                                                "sense_id": "14835801-2919-3429-882f-a35d5f3c4296",
                                                "text": "Jeder Sprachkontakt ist ein interlinguales Phänomen. Es ist dabei zwischen solchen Kontakten zu unterscheiden, die sowohl interlinguale als auch interethnische Phänomene sind, und solchen, die ausschließlich interlingual beschränkt bleiben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
