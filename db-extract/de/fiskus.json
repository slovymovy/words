                                "target_senses": [
                                    {
                                        "sense_id": "15e6c81e-e821-3d36-9e16-664d1c7c9ea1",
                                        "entry_id": "855945fc-a53a-3d55-8187-b56485d15886",
                                        "glosses": [
                                            "L’administration fiscale d’un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d532844d-dcd6-4d43-a073-21c16758fa91",
                                                "sense_id": "15e6c81e-e821-3d36-9e16-664d1c7c9ea1",
                                                "text": "Les réformes de 1972-1973 ont permis à la BCEAO et à la BEAC de modifier les conditions d’attribution de leurs concours aux Trésors publics nationaux, notamment en accroissant le volume de leurs interventions […]"
                                            },
                                            {
                                                "example_id": "a98ded76-b667-436b-a1da-7850b6bfa177",
                                                "sense_id": "15e6c81e-e821-3d36-9e16-664d1c7c9ea1",
                                                "text": "C’est surtout par la place que le Trésor public a prise sur les marchés monétaires que ceux-ci ont été transformés, par comparaison avec ce qu’ils étaient avant 1914."
                                            },
                                            {
                                                "example_id": "e54c33ce-e339-45b3-9cc2-1cdf1cfc47d0",
                                                "sense_id": "15e6c81e-e821-3d36-9e16-664d1c7c9ea1",
                                                "text": "Les gredins qui opèrent ne cherchent qu’à soulager de numéraire à leur bénéfice quelques Trésors publics, nullement à nuire à leur pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
