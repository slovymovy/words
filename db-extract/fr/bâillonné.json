                        "glosses": [
                            "Se dit d'un animal dont la gueule est munie d'un bâillon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c61e25e-470b-43f4-91f8-ff6aac0b7eed",
                                "sense_id": "f75ede13-0289-38fa-b1b4-b75b70ae6f8f",
                                "text": "De gueules au dextrochère d'or vêtu d'une manipule du même, tenant un serpent d'argent bâillonné de sable et sortant d'une nuée d'argent mouvant du flanc dextre de l'écu, au chef cousu d'azur chargé d'une échelle d'argent accostée de deux étoiles du même, qui est de la ville de Villossanges dans le Puy-de-Dôme → voir illustration « serpent bâillonné »"
                            }
                        ]
                    }
