                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d2a4f60-3466-4365-9426-835768859347",
                                                "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                                "text": "Really meh?",
                                                "translation": "Really? I don’t think so.",
                                                "english": "Really? I don’t think so."
                                            },
                                            {
                                                "example_id": "a4e1c037-758a-4210-969c-c7398c488c86",
                                                "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                                "text": "This one your one meh?",
                                                "translation": "Is this really yours?",
                                                "english": "Is this really yours?"
                                            },
                                            {
                                                "example_id": "4321155d-20e4-430e-8bfd-3e58fbb43918",
                                                "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                                "text": "You got send [e-mail] meh? I never receive leh."
                                            },
                                            {
                                                "example_id": "5930afc8-7b8d-4c5e-a9e3-85a94c9f8fb2",
                                                "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                                "text": "“Nice meh?” I would think sourly."
                                            },
                                            {
                                                "example_id": "76b6a440-72a2-4f06-a396-f68567552de3",
                                                "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                                "text": "\"Huh? At this hour? Really meh?\" He couldn't believe his own ears."
                                            },
                                            {
                                                "example_id": "fbdf3e16-69cf-4b0e-a194-5cd5a522ad36",
                                                "sense_id": "3202fac6-6564-3c67-a3f1-4ac77d10b147",
                                                "text": "Not pain, meh. When you have eczema and do tattoos?"
                                            }
                                        ]
                                    }
                                ]
                            },
