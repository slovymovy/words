                                        "sense_id": "d61ad273-6db0-3882-8fb5-2052dd138b76",
                                        "entry_id": "265e7edb-98bd-3d5a-a2ca-702b77e4fa49",
                                        "glosses": [
                                            "Qualité de ce qui domine en importance ou en quantité."
                                        ],
                                        "tags": [],
