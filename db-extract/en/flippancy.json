                    }
                ],
                "translations": [
                    {
                        "translation_id": "4629a60f-f430-4bf4-91f9-c5b29c60d5de",
                        "source_entry_id": "a772019d-41b4-3195-9c57-5599284b4b18",
                        "source_sense_id": "cdcaee90-3b2e-3bdd-a41a-5bcd2599ecb8",
                        "source_sense_description": "Schnoddrigkeit, vorlaute Art",
                        "target_lang_word": "Schnoddrigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnoddrigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28e72ca6-eee0-367c-8a9e-2313842e936a",
                                        "entry_id": "33390ed8-2f05-329e-86f6-35360ba8a8f0",
                                        "glosses": [
                                            "Eigenschaft einer Äußerung, die andern gegenüber abweisend/ruppig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e7d19c6-93b3-4e36-97fc-04c2bda8d6d7",
                                                "sense_id": "28e72ca6-eee0-367c-8a9e-2313842e936a",
                                                "text": "„Gewiß, ich weiß, hinter dieser Sprödigkeit nach außen und hinter der Schnoddrigkeit, hinter diesem allzeit kampfbereiten Wesen steckt eine Weichheit, die unter keinen Umständen gezeigt werden soll.“"
                                            },
                                            {
                                                "example_id": "fce3d5ba-7e33-4443-85d2-ca3dbed61f18",
                                                "sense_id": "28e72ca6-eee0-367c-8a9e-2313842e936a",
                                                "text": "„Mit Witz, Schnoddrigkeit, Derbheit umhüllte er den harten Kern des Todes, der in ihm wuchs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efe04094-b0df-4717-b93a-e273dd2bdeca",
                        "source_entry_id": "a772019d-41b4-3195-9c57-5599284b4b18",
                        "source_sense_id": "f337dce1-9a70-3ceb-924d-69aaeb76d447",
                        "source_sense_description": "Leichtfertigkeit, Frivolität",
                        "target_lang_word": "Leichtfertigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leichtfertigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78b5e293-d38e-3396-9890-bb16819cd0c1",
                                        "entry_id": "601e2e35-6592-3ac0-9840-f7f73e3a613b",
                                        "glosses": [
                                            "Neigung zu unüberlegtem, riskanten Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7757c735-caad-401d-9d62-641c9c0813c1",
                                                "sense_id": "78b5e293-d38e-3396-9890-bb16819cd0c1",
                                                "text": "„Er wurde verlegen, als habe er eine Jungfer zur Leichtfertigkeit überredet.“"
                                            },
                                            {
                                                "example_id": "67de19ba-359b-4cbf-be42-5fb217b65184",
                                                "sense_id": "78b5e293-d38e-3396-9890-bb16819cd0c1",
                                                "text": "„Ich entdeckte nämlich ein Mittel gegen Leichtfertigkeit, und zwar die Vorsorge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9081ff64-003b-4095-98a9-e2a04ddbc218",
                        "source_entry_id": "a772019d-41b4-3195-9c57-5599284b4b18",
                        "source_sense_id": "f337dce1-9a70-3ceb-924d-69aaeb76d447",
                        "source_sense_description": "Leichtfertigkeit, Frivolität",
                        "target_lang_word": "Frivolität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frivolität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a075307c-fb5f-314d-bc49-d605bd988828",
                                        "entry_id": "5dbf5d8d-f141-3933-b682-79be9602bc75",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße unüberlegtes, leichtfertiges (frivoles) Verhalten zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93608c3b-bd85-4fac-a0d7-21f0e2f773e1",
                                                "sense_id": "a075307c-fb5f-314d-bc49-d605bd988828",
                                                "text": "„Der alte Erzbischof mußte zusehen, wie diese Priester die jungen Theologen mit Frivolität und Vorurtheilen gegen die Kirche erfüllten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "29c8c453-0a80-3942-8957-77637d792506",
                                        "entry_id": "5dbf5d8d-f141-3933-b682-79be9602bc75",
                                        "glosses": [
                                            "Handlungsweise, die moralisch bedenkliches, schlüpfriges (frivoles) Verhalten zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17a885f6-f736-4497-8fa0-56ee3d517898",
                                                "sense_id": "29c8c453-0a80-3942-8957-77637d792506",
                                                "text": "„Die ländliche Frivolität fasziniert Seidl, der überaus raue Umgang mit der Sexualität wird zu einer Nebenlinie dieses Films.“"
                                            },
                                            {
                                                "example_id": "4853601d-a639-49e2-9de9-9794d308bcf7",
                                                "sense_id": "29c8c453-0a80-3942-8957-77637d792506",
                                                "text": "„Trotz aller Schikanen, Frivolitäten und Lügen glaubte ich an sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d1f8ec6c-4d23-3fe0-860e-8f4021183553",
                                        "entry_id": "5dbf5d8d-f141-3933-b682-79be9602bc75",
                                        "glosses": [
                                            "Tat/Bemerkung, die unüberlegtes, leichtfertiges (frivoles) Verhalten zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fedf3cc-d715-4712-a209-d55297229c56",
                                                "sense_id": "d1f8ec6c-4d23-3fe0-860e-8f4021183553",
                                                "text": "„Die Sprüche zum Lobe des Weines sind voller Frivolitäten. Das ist keine Freude am Trinken und im Trinkerkreise mehr; ‚der Wein ist ein Gottesspötter‘, das Bibelwort bestätigt sich auch hier, nicht überall, aber im Kreise dieses Dichters.“"
                                            },
                                            {
                                                "example_id": "6eb0dbd1-9508-46d2-816e-05f1aa126fe1",
                                                "sense_id": "d1f8ec6c-4d23-3fe0-860e-8f4021183553",
                                                "text": "„Es sind dies Ausdrücke, die sich bis zur Frivolität steigern können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "412c8dd4-8ac7-3ea7-a24c-3816067e1128",
                                        "entry_id": "5dbf5d8d-f141-3933-b682-79be9602bc75",
                                        "glosses": [
                                            "Tat oder Bemerkung, die moralisch bedenkliches, schlüpfriges (frivoles) Verhalten zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8df0e2e6-de53-44b4-aeda-4ed15debd48b",
                                                "sense_id": "412c8dd4-8ac7-3ea7-a24c-3816067e1128",
                                                "text": "„Und alle diese Frivolitäten, diese Unziemlichkeiten, diese Derbheiten können das Publikum nicht zurückhalten, schaarenweis in das Schauspiel zu strömen, wenn Käthchen von Heilbronn auf dem Anschlagzettel steht?“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "20e9ac22-49fe-3eec-bace-09c25df3165f",
                                        "entry_id": "5dbf5d8d-f141-3933-b682-79be9602bc75",
                                        "glosses": [
                                            "spezielle Art der Spitze, Klöppelei"
                                        ],
                                        "tags": [
                                            "Handarbeit",
                                            "Knüpfen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4594e45d-2ff3-463b-a25f-2dc78370101d",
                                                "sense_id": "20e9ac22-49fe-3eec-bace-09c25df3165f",
                                                "text": "Die Frivolität ist eine leichte Spitze, die von Hand mit Hilfe eines Schiffchens hergestellt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dceb8145-b82d-4e83-9b11-42938dd73937",
                        "source_entry_id": "a772019d-41b4-3195-9c57-5599284b4b18",
                        "source_sense_id": "f337dce1-9a70-3ceb-924d-69aaeb76d447",
                        "source_sense_description": "Leichtfertigkeit, Frivolität",
                        "target_lang_word": "frivolité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frivolité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f266a02e-a4a5-3e72-80f6-12daf97ef00d",
                                        "entry_id": "4f83e7af-42e7-38b2-b6bb-e43f149e635a",
                                        "glosses": [
                                            "Caractère de ce qui est frivole, qui n’est pas important."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f52aa529-1f57-4718-898c-75c5ef36aea5",
                                                "sense_id": "f266a02e-a4a5-3e72-80f6-12daf97ef00d",
                                                "text": "La frivolité de ces amusements."
                                            },
                                            {
                                                "example_id": "b9c71bfd-176f-4e3e-b571-d99ea179e9d8",
                                                "sense_id": "f266a02e-a4a5-3e72-80f6-12daf97ef00d",
                                                "text": "Il y a bien de la frivolité dans cet ouvrage."
                                            },
                                            {
                                                "example_id": "d7ad85d2-50f7-4baf-a4c6-732be99ebc36",
                                                "sense_id": "f266a02e-a4a5-3e72-80f6-12daf97ef00d",
                                                "text": "La frivolité est la plus jolie réponse à l’angoisse."
                                            },
                                            {
                                                "example_id": "83f4819d-75e2-4c67-9908-3706f1273222",
                                                "sense_id": "f266a02e-a4a5-3e72-80f6-12daf97ef00d",
                                                "text": "Rien n’est plus sot que de traiter avec sérieux de choses frivoles ; mais rien n’est plus spirituel que de faire servir les frivolités à des choses sérieuses."
                                            },
                                            {
                                                "example_id": "a5a7c296-1646-4e10-90bc-fdc42dd5997d",
                                                "sense_id": "f266a02e-a4a5-3e72-80f6-12daf97ef00d",
                                                "text": "La frivolité est le meilleur moyen d’aborder simplement les sujets les plus délicats."
                                            },
                                            {
                                                "example_id": "0375d9fe-b003-46c4-911e-74f60c552e80",
                                                "sense_id": "f266a02e-a4a5-3e72-80f6-12daf97ef00d",
                                                "text": "La frivolité est encore ce qu’il y a de plus sérieux chez les femmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc608ad9-9e6b-3415-914a-a4f4e3c099f8",
                                        "entry_id": "4f83e7af-42e7-38b2-b6bb-e43f149e635a",
                                        "glosses": [
                                            "Choses frivoles."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0b7c140-92fb-42a8-a6e8-b550967c6648",
                                                "sense_id": "fc608ad9-9e6b-3415-914a-a4f4e3c099f8",
                                                "text": "Ne s’occuper que de frivolités."
                                            },
                                            {
                                                "example_id": "b30e2851-4e13-482a-a890-f0705260d813",
                                                "sense_id": "fc608ad9-9e6b-3415-914a-a4f4e3c099f8",
                                                "text": "Marchande de frivolités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62a0bb89-0ad9-36ee-97c3-02a6c9a70338",
                                        "entry_id": "4f83e7af-42e7-38b2-b6bb-e43f149e635a",
                                        "glosses": [
                                            "Caractère de celui qui est frivole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15261a60-3b12-4e45-adc8-b13c1351bc57",
                                                "sense_id": "62a0bb89-0ad9-36ee-97c3-02a6c9a70338",
                                                "text": "Sa frivolité est excessive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8db934f7-3f9b-331a-95cc-405d984f4bd1",
                                        "entry_id": "4f83e7af-42e7-38b2-b6bb-e43f149e635a",
                                        "glosses": [
                                            "Dentelle de fil faite à la main, à l’aide d’une navette."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b3bdf2e-13e3-4f61-be15-b592281e68fb",
                                                "sense_id": "8db934f7-3f9b-331a-95cc-405d984f4bd1",
                                                "text": "Faire de la frivolité."
                                            },
                                            {
                                                "example_id": "811ba3d1-c5a3-4625-beb5-2c7b280de2b8",
                                                "sense_id": "8db934f7-3f9b-331a-95cc-405d984f4bd1",
                                                "text": "Elle a cette manie, tout en marchant, d’emmêler sur un petit instrument en forme de losange des fils compliqués.\nLorsqu’on lui demande ce que signifie cette dentelle, tout en minaudant, elle répond :\n— C’est ma petite frivolité…"
                                            },
                                            {
                                                "example_id": "62a7f974-e2e1-444e-befc-6207fc369610",
                                                "sense_id": "8db934f7-3f9b-331a-95cc-405d984f4bd1",
                                                "text": "La chambre de Mme Daigne est sale, mais coquette ; il y a une armoire à glace et un carré de moquette devant un fauteuil garni d’une têtière en frivolité."
                                            },
                                            {
                                                "example_id": "78067f67-a19d-49a7-806d-ad68a5bf588b",
                                                "sense_id": "8db934f7-3f9b-331a-95cc-405d984f4bd1",
                                                "text": "Ma mère ne gaspillait jamais une seconde ; en lisant, elle tricotait ; quand elle causait avec mon père ou avec des amis, elle cousait, ravaudait ou brodait ; dans les métros et les tramways elle confectionnait des kilomètres de « frivolité » dont elle ornait nos jupons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fddfa5de-2cc2-3974-a7d7-f5a7acbcf94c",
                                        "entry_id": "4f83e7af-42e7-38b2-b6bb-e43f149e635a",
                                        "glosses": [
                                            "Testicules d’animaux (agneau, bélier, bœuf). On parle aussi de rognons blancs."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fba39616-3437-47e8-af55-07260eb0dffb",
                                                "sense_id": "fddfa5de-2cc2-3974-a7d7-f5a7acbcf94c",
                                                "text": "Des frivolités d’agneau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28dfb325-34bd-454d-98af-793706b8d790",
