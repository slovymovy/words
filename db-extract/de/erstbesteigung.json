                "senses": [
                    {
                        "sense_id": "892cac50-8f1a-3d8e-8682-b0100909bcfb",
                        "entry_id": "e92e6092-9cf1-3818-ac1c-87ce782f3dfd",
                        "glosses": [
                            "erstmalige Besteigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e321ee-d519-4339-a539-0e8d172090a4",
                                "sense_id": "892cac50-8f1a-3d8e-8682-b0100909bcfb",
                                "text": "„Nachdem in mehreren Anläufen die zweifelsfrei höchste Stelle des Kibo ermittelt werden konnte, kommt es am 6. Oktober 1889 endlich und ohne weitere Umstände zur Erstbesteigung der höchsten Erhebung des Kilimandscharo-Massivs durch Meyer und Putscheller.“"
                            },
                            {
                                "example_id": "0843cb68-cdb2-45f0-bc17-d842fb8d55c9",
                                "sense_id": "892cac50-8f1a-3d8e-8682-b0100909bcfb",
                                "text": "„Für Purtscheller war die Erstbesteigung am 6. Oktober ein besonderes Geschenk, er konnte auf dem Gipfel seinen 40. Geburtstag feiern.“"
                            },
                            {
                                "example_id": "e3145a9b-b713-4690-9e30-2a7cd59d452b",
                                "sense_id": "892cac50-8f1a-3d8e-8682-b0100909bcfb",
                                "text": "„Bei der missglückten Erstbesteigung des «Schicksalsbergs der Deutschen» kamen sechzehn Menschen ums Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
