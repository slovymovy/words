                ],
                "senses": [
                    {
                        "sense_id": "018b26c5-fc17-3996-bc16-e5f7db9f868d",
                        "entry_id": "ab22a865-ce15-3780-9901-738ff5f566b3",
                        "glosses": [
                            "Qui a de l’affectation, qui manque de naturel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4541302-0467-487e-a6c5-b91dbac38452",
                                "sense_id": "018b26c5-fc17-3996-bc16-e5f7db9f868d",
                                "text": "Geste affecté."
                            },
                            {
                                "example_id": "8b89b069-9d42-4c7d-959e-51f960af2fad",
                                "sense_id": "018b26c5-fc17-3996-bc16-e5f7db9f868d",
                                "text": "Humilité, modestie affectée."
                            },
                            {
                                "example_id": "a68734e1-3008-4ded-ac70-318b7959edc5",
                                "sense_id": "018b26c5-fc17-3996-bc16-e5f7db9f868d",
                                "text": "Ce comédien est affecté dans son jeu."
                            },
                            {
                                "example_id": "eace46f6-4e01-4faf-a70c-66684f5d9027",
                                "sense_id": "018b26c5-fc17-3996-bc16-e5f7db9f868d",
                                "text": "Cet écrivain est affecté dans son style."
                            },
                            {
                                "example_id": "b1521551-424f-4edb-ac01-fcb764855c88",
                                "sense_id": "018b26c5-fc17-3996-bc16-e5f7db9f868d",
                                "text": "Langage affecté."
                            },
                            {
                                "example_id": "a0d539cc-c4f4-4db2-9a47-7abece82348a",
                                "sense_id": "018b26c5-fc17-3996-bc16-e5f7db9f868d",
                                "text": "S’il convient de commencer par les « affects », c’est, je l’ai laissé entendre, que leur appellation renvoie à la nature même de la sensibilité, qui est réceptivité, du fait qu’elle est un être affecté."
                            }
                        ]
                    },
                    {
                        "sense_id": "ceac676b-6aac-3d03-b970-25505c84ff00",
                        "entry_id": "ab22a865-ce15-3780-9901-738ff5f566b3",
                        "glosses": [
                            "Qui éprouve un sentiment de peine en réaction à un événement, à une information."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d8a2bd8-941c-40c7-b043-f09575399515",
                                "sense_id": "ceac676b-6aac-3d03-b970-25505c84ff00",
                                "text": "Les Anglais se montraient fort affectés, et l’un d’eux sourcilla devant l’attitude de la jeune femme, dont il ne comprenait pas les paroles."
                            },
                            {
                                "example_id": "7e252020-8ca2-4cce-ada6-a986d811b6bb",
                                "sense_id": "ceac676b-6aac-3d03-b970-25505c84ff00",
                                "text": "Sa femme est morte depuis une génération, il n’a pas de rejetons et il ne serait nullement affecté si le bon Dieu daignait le rappeler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc796c92-e800-46b0-8862-18bb7eaecd1f",
                        "source_entry_id": "ab22a865-ce15-3780-9901-738ff5f566b3",
                        "target_lang_word": "affected",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
