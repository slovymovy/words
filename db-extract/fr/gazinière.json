        "fr-extract.jsonl": [
            {
                "entry_id": "975bcfad-c8a0-3b8f-9acb-6d678a95cf59",
                "word": "gazinière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5fc9b991-2d28-4a7b-9b5a-628d6c1ef271",
                        "entry_id": "975bcfad-c8a0-3b8f-9acb-6d678a95cf59",
                        "tags": [
                            "plural"
                        ],
                        "form": "gazinières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b1e546a-a5f9-3787-9700-76f29f76b766",
                        "entry_id": "975bcfad-c8a0-3b8f-9acb-6d678a95cf59",
                        "glosses": [
                            "Cuisinière fonctionnant au gaz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "866b4398-f844-40f7-9c8a-2563188b33d6",
                                "sense_id": "2b1e546a-a5f9-3787-9700-76f29f76b766",
                                "text": "Dans le même temps [en 1934], La gazette lance un grand concours pour baptiser cet engin-miracle. Elle reçoit 4 000 réponses et déclare vainqueurs ex aequo les quatre concurrents ayant proposé la gazinière."
                            },
                            {
                                "example_id": "a6f22d3d-98b7-444c-a57c-67f27a8fb871",
                                "sense_id": "2b1e546a-a5f9-3787-9700-76f29f76b766",
                                "text": "Ils étaient tous les deux dans la cuisine, lui, assis à table, regardait par la fenêtre, ma mère debout près de la gazinière."
                            },
                            {
                                "example_id": "48d30e94-e2b7-443e-ae7f-f4b5f9bc228c",
                                "sense_id": "2b1e546a-a5f9-3787-9700-76f29f76b766",
                                "text": "Les gens faisaient fond de plus belle, sur une existence meilleure grâce aux choses. Selon leurs moyens, ils changeaient la cuisinière à charbon pour un gazinière, […]"
                            },
                            {
                                "example_id": "a55a6caa-afc3-4402-8c1b-83cb9d4e4cc0",
                                "sense_id": "2b1e546a-a5f9-3787-9700-76f29f76b766",
                                "text": "Je pensais à la lueur des gazinières de ma grand-mère, faible, inextinguible. Et pendant que le vent arrachait les crénelures des corniches, je cherchais la gazinière."
                            },
                            {
                                "example_id": "882c08a1-eefe-4a54-ba33-a74a4b55ab51",
                                "sense_id": "2b1e546a-a5f9-3787-9700-76f29f76b766",
                                "text": "Sa gazinière était à son image, capricieuse et sujette à certains retours de flamme. « À chaque fois que je l’allume, disait-elle à ma mère, je fais mon acte de contrition. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99b89d8d-c299-4926-acf2-e7989246450e",
                        "source_entry_id": "975bcfad-c8a0-3b8f-9acb-6d678a95cf59",
                        "source_sense_id": "2b1e546a-a5f9-3787-9700-76f29f76b766",
                        "target_lang_word": "Gasherd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gasherd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0164663b-ef8c-3b07-a5b6-e66973db7f00",
                                        "entry_id": "f8805933-2261-3f7e-84df-a89a9ae8bf02",
                                        "glosses": [
                                            "Herd, bei dem die Erhitzung durch eine Gasflamme entsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9259dd94-4144-4d65-a51d-3d61f267e10d",
                                                "sense_id": "0164663b-ef8c-3b07-a5b6-e66973db7f00",
                                                "text": "Wir haben nur einen alten Gasherd zum Kochen."
                                            },
                                            {
                                                "example_id": "3c7ab381-099f-4aef-b866-7035ef82bc07",
                                                "sense_id": "0164663b-ef8c-3b07-a5b6-e66973db7f00",
                                                "text": "„Auf dem Gasherd kocht das Wasser im Kessel.“"
                                            },
                                            {
                                                "example_id": "f9145bd8-4b9b-4842-96c3-41a6082522f2",
                                                "sense_id": "0164663b-ef8c-3b07-a5b6-e66973db7f00",
                                                "text": "„Streichhölzer lagen auf dem Gasherd, gemahlener Kaffee stand da in einer luftdichten Dose, Filterpapier daneben, Schinken, Eier, Büchsengemüse im Eisschrank.“"
                                            },
                                            {
                                                "example_id": "00dfc870-0ecd-4fb4-a9a3-206423169c9f",
                                                "sense_id": "0164663b-ef8c-3b07-a5b6-e66973db7f00",
                                                "text": "„Gerda zeigt auf einen alten Gasherd, der auf der Kommode steht.“"
                                            },
                                            {
                                                "example_id": "a67667c5-9e47-426f-abe1-d0361099b346",
                                                "sense_id": "0164663b-ef8c-3b07-a5b6-e66973db7f00",
                                                "text": "„Er trank den wässerigen Rest des Cocktails aus und ging in die Küche, schloß Tür und Fenster und öffnete das Backrohr des Gasherds.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c740a412-5336-4f94-8361-52181335e997",
                        "source_entry_id": "975bcfad-c8a0-3b8f-9acb-6d678a95cf59",
