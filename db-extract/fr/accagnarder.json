                ],
                "senses": [
                    {
                        "sense_id": "51a4fc51-4a37-333b-afaa-ea24452dcd71",
                        "entry_id": "beb091fe-eea9-38ab-b496-b73855e5058e",
                        "glosses": [
                            "Accoutumer quelqu’un à mener une vie obscure et fainéante, rendre mou, lâche."
                        ],
                        "tags": [
                            "familiar",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4fecefd1-8f81-38e3-9310-e7c56caac2c9",
                        "entry_id": "beb091fe-eea9-38ab-b496-b73855e5058e",
                        "glosses": [
                            "Paresser."
                        ],
                        "tags": [
                            "obsolete",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "845f8720-6755-4fe5-b025-dc83827bc745",
                                "sense_id": "4fecefd1-8f81-38e3-9310-e7c56caac2c9",
                                "text": "Si vous ne vous sentez pas en veine de travail, encore, il ne faut pas vous accagnarder, au lieu même de vos motifs."
                            },
                            {
                                "example_id": "b4573574-e44d-4854-ba8d-4f3aaa8aebb1",
                                "sense_id": "4fecefd1-8f81-38e3-9310-e7c56caac2c9",
                                "text": "Il s’acagnardait des après-midi dans un fauteuil, s’essorait dans des songee."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6c191b9-05ac-39bd-a1e7-608e9c213d23",
                        "entry_id": "beb091fe-eea9-38ab-b496-b73855e5058e",
                        "glosses": [
                            "Mener une vie obscure et fainéante."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "02c39524-af09-4751-ba19-e79248a1d7e9",
                                "sense_id": "f6c191b9-05ac-39bd-a1e7-608e9c213d23",
                                "text": "Et de s’accagnarder dans sa cache de vert, souffle retenu, comme un vrai militaire."
                            }
                        ]
                    }
