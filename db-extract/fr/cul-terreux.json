                    },
                    {
                        "sense_id": "ad6565e3-1b0e-36d4-952a-cc7cfff14b83",
                        "entry_id": "03d6cf36-68d5-33e0-a42a-93a786d8dbc1",
                        "glosses": [
                            "boer"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "c55621d8-e8d1-484b-9c84-b92de321131e",
                                "sense_id": "ad6565e3-1b0e-36d4-952a-cc7cfff14b83",
                                "text": "Comment, ma fille épouser un cul-terreux? Pas question!",
                                "translation": "Wat, mijn dochter trouwen met een boer? Geen sprake van!"
                            }
                        ]
                    }
                ],
