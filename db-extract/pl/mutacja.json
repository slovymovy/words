                "translations": [
                    {
                        "translation_id": "909aca8d-0153-4883-8d68-e418130d2c3c",
                        "source_entry_id": "5819c0cc-1f0d-3a75-8c58-db9f54f49b07",
                        "source_sense_id": "3a545f97-3a20-366f-8a83-51864eb8b999",
