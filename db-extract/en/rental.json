    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7966c042-4737-3fc3-a8b0-902130db59d0",
                "word": "rental",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "79d09fc0-7dec-3661-910b-8d87aecc73e5",
                        "entry_id": "7966c042-4737-3fc3-a8b0-902130db59d0",
                        "glosses": [
                            "Relating to rent."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "91707cb7-316e-39ad-8f0f-bf9a921e0727",
                        "entry_id": "7966c042-4737-3fc3-a8b0-902130db59d0",
                        "glosses": [
                            "Relating to renting."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3261dc25-5a5f-47e4-8c83-ebef54eccdb4",
                                "sense_id": "91707cb7-316e-39ad-8f0f-bf9a921e0727",
                                "text": "Deep welfare cuts and rising rents have resulted in a growing gap in many areas of the country between what help people on low incomes receive to cover their housing and what that housing actually costs in the private rental sector."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                "word": "rental",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c5bb6d0c-dbee-4a4b-bfdf-a72108841a42",
                        "entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                        "tags": [
                            "plural"
                        ],
                        "form": "rentals"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27582955-a074-3706-8826-8d5f718b790b",
                        "entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                        "glosses": [
                            "Something that is rented."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9aecac82-36a4-4518-87bb-5542b37efb93",
                                "sense_id": "27582955-a074-3706-8826-8d5f718b790b",
                                "text": "It's just a rental, so I don't need to take very good care of it."
                            },
                            {
                                "example_id": "df180730-06bc-4f29-9ba8-404de780b5bb",
                                "sense_id": "27582955-a074-3706-8826-8d5f718b790b",
                                "text": "Furthermore, whilst we would have been pleased to have been able to give you some quoteworthy examples of men cruelly dominating the choice of video movie rentals, these simply did not appear in the diaries either."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbf7b2bc-00a2-3e34-92cb-0d3947b97e62",
                        "entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                        "glosses": [
                            "The payment made to rent something."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "feb2229b-5f78-45fa-9811-7882d32f0213",
                                "sense_id": "cbf7b2bc-00a2-3e34-92cb-0d3947b97e62",
                                "text": "On a grass roots level we are making the film available at a nominal rental to gay organizations, student groups, and religious affiliates so that gay people and their straight friends can see GAY USA now."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce4647da-e8e5-3805-8e04-8216407e0db7",
                        "entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                        "glosses": [
                            "A business that rents out something to its customers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "519616a5-36c6-3a29-9b23-125ad20f965f",
                        "entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                        "glosses": [
                            "An act of renting."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a147a19b-192b-3128-a303-315a45aaf471",
                        "entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                        "glosses": [
                            "A player traded to a team with a year or less on his contract"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "91c45727-d814-4448-ab0f-2e93ee3aa643",
                                "sense_id": "a147a19b-192b-3128-a303-315a45aaf471",
                                "text": "[When the trade deadline approaches], Everyone wants to talk about which preening millionaire is going to be shipped out of town because he can't get along with his GM, or what veteran is going to finally get a shot at a Cup, or which guy is going to a contender as a \"rental.\" Sure, it's gossip. Is that so wrong?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c724e6c-87cd-4590-8411-4e0f5246b963",
                        "source_entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                        "source_sense_description": "something rented",
                        "target_lang_word": "аре́нда",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аре́нда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c41273b2-5e4f-318f-8cd7-77f3b38f8b87",
                                        "entry_id": "06e3ec47-70a5-3d91-9747-73ece4a59a72",
                                        "glosses": [
                                            "фин., экон. сделка найма и передачи имущества, помещения, территории во временное пользование"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5082cdf-7235-4700-ab2d-caaa5fc16baf",
                                                "sense_id": "c41273b2-5e4f-318f-8cd7-77f3b38f8b87",
                                                "text": "Здесь уже более конкретно согласуются вопросы размещения дилерского центра, условий аренды или собственности земельного участка."
                                            },
                                            {
                                                "example_id": "20032755-aedf-45c1-9fb7-27636eebdfa5",
                                                "sense_id": "c41273b2-5e4f-318f-8cd7-77f3b38f8b87",
                                                "text": "Университет арендовал два этажа здания колледжа с первых дней существования ФГА, но срок действия договора аренды истёк 21 августа этого года."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f924fdf-7135-3b28-a6fb-a62d0c15d787",
                                        "entry_id": "06e3ec47-70a5-3d91-9747-73ece4a59a72",
                                        "glosses": [
                                            "пользование, предусмотренное условиями аренды [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5effa772-8890-4a86-933c-a9e998d1e067",
                                                "sense_id": "3f924fdf-7135-3b28-a6fb-a62d0c15d787",
                                                "text": "Идея такова: сдавать площади в аренду для производителей комплектующих."
                                            },
                                            {
                                                "example_id": "bed91da8-b27f-47bc-b2df-03ec1f44c138",
                                                "sense_id": "3f924fdf-7135-3b28-a6fb-a62d0c15d787",
                                                "text": "Нежелание идти навстречу предпринимателям по вопросу предоставления помещений в аренду."
                                            },
                                            {
                                                "example_id": "9beddc46-dc3b-41b3-a2f2-4c0df1dfa1e5",
                                                "sense_id": "3f924fdf-7135-3b28-a6fb-a62d0c15d787",
                                                "text": "На каждом этаже ― компьютерный зал, зал для занятий, прачечная с автоматическими стиральными машинами, комната для отдыха с телевизором и разнообразными бесплатными ежедневными газетами, и кухня со микроволновками, тостерами, холодильниками и т. д. Кроме того, каждому в комнату могут доставить холодильник или двухъярусную кровать в аренду."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "844a9d6c-1026-3bec-8d87-c3dca93f8cce",
                                        "entry_id": "06e3ec47-70a5-3d91-9747-73ece4a59a72",
                                        "glosses": [
                                            "услуга, предоставляемая в связи с арендой [1], предоставление такой услуги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f25bb446-e214-4316-b14e-5bc235d74a0b",
                                                "sense_id": "844a9d6c-1026-3bec-8d87-c3dca93f8cce",
                                                "text": "Компаниям, занятым лишь лесозаготовками и лесопилением, предоставляют аренду на короткий срок и без права ведения лесного хозяйства под лицензии на определенный объем заготовки древесины."
                                            },
                                            {
                                                "example_id": "18629ab6-ed7f-4114-b0b4-648a8d3b529c",
                                                "sense_id": "844a9d6c-1026-3bec-8d87-c3dca93f8cce",
                                                "text": "Плата за билеты еле покрывает расходы по аренде помещения."
                                            },
                                            {
                                                "example_id": "6bd666c7-52f1-413f-95d8-d07d056d4eab",
                                                "sense_id": "844a9d6c-1026-3bec-8d87-c3dca93f8cce",
                                                "text": "До 2003 года стоимость аренды торгового места за месяц на рынке «Привокзальный» составляла около полутора тысяч рублей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a20d019a-2a9c-340f-824d-d5282ff02df9",
                                        "entry_id": "06e3ec47-70a5-3d91-9747-73ece4a59a72",
                                        "glosses": [
                                            "разг. плата за аренду [3]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ab76d9-1c3a-4932-98b7-726d4326cd9d",
                                                "sense_id": "a20d019a-2a9c-340f-824d-d5282ff02df9",
                                                "text": "Денег уже нет, а нам ещё аренду платить."
                                            },
                                            {
                                                "example_id": "54b9eb97-c072-42d7-9ab7-46eeb913ef7b",
                                                "sense_id": "a20d019a-2a9c-340f-824d-d5282ff02df9",
                                                "text": "Звонят поставщики, нужно платить аренду, счета арестованы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40f51da6-1890-348d-871c-0c001d8f9a81",
                                        "entry_id": "06e3ec47-70a5-3d91-9747-73ece4a59a72",
                                        "glosses": [
                                            "истор. вид государственной награды (в дореволюционной России)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8cdd1f3-3d2b-4410-b4f4-c4b4f3b4e699",
                                                "sense_id": "40f51da6-1890-348d-871c-0c001d8f9a81",
                                                "text": "Одною из особенностей характера графа Милорадовича была необыкновенная расточительность: он всегда был в долгу как в шелку, и ни большое содержание, которое он получал, ни аренды, назначаемые ему от государя, — ничто не могло выпутать его из его бесконечных долгов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22be8163-3084-48f1-9285-bbf67af6b482",
