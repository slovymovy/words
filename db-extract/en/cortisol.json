                    {
                        "translation_id": "4ced84b3-138d-48fc-bb7a-81d73cf784a1",
                        "source_entry_id": "509501a3-2e37-37db-8d5c-8651e315718e",
                        "source_sense_id": "88d10506-290b-3be0-9390-d072342cc2b3",
                        "source_sense_description": "Translations",
                        "target_lang_word": "cortisol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cortisol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3546b865-7599-39f5-b400-4ee5392740a9",
                                        "entry_id": "b9c377b5-acd4-3a8d-bec4-a6d996b1c5f9",
                                        "glosses": [
                                            "Hormone du stress produite dans les glandes surrénales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ef0dc5-621f-4748-93da-838c7cb79613",
                                                "sense_id": "3546b865-7599-39f5-b400-4ee5392740a9",
                                                "text": "Une insuffisance surrénalienne primaire partielle donne un tableau intermédiaire: l’élimination urinaire de cortisol est à la limite inférieure de l’intervalle normal ; de plus, le cortisol plasmatique répond à un test de stimulation court à l’ACTH."
                                            },
                                            {
                                                "example_id": "719cbc7b-0664-40d6-b13d-8615ee816ca6",
                                                "sense_id": "3546b865-7599-39f5-b400-4ee5392740a9",
                                                "text": "Le cortisol on l’appelle souvent l’hormone du stress, et c’est pas faux. Je suis sûr que les moines, par exemple, sécrètent très peu de cortisol."
                                            },
                                            {
                                                "example_id": "217cd435-b11f-454c-abb2-65f3e99ace97",
                                                "sense_id": "3546b865-7599-39f5-b400-4ee5392740a9",
                                                "text": "À la clé, une réduction de la fréquence cardiaque et de la tension artérielle, et une baisse significative de la production de cortisol et d’adrénaline, responsables du stress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "192893c4-001c-482f-8003-064d0d94398a",
                        "source_entry_id": "509501a3-2e37-37db-8d5c-8651e315718e",
                        "source_sense_id": "88d10506-290b-3be0-9390-d072342cc2b3",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Cortisol",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cortisol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b93bbbe5-10ae-33ca-9862-6d7e22c1c605",
                                        "entry_id": "3ba7e8b5-681f-333d-8a8d-aa66431ecdb2",
                                        "glosses": [
                                            "in der Nebennierenrinde produziertes und Entzündungen hemmendes Hormon, das für viele Stoffwechselvorgänge zuständig ist und unter anderem den Blutzuckerspiegel durch Bereitstellung von Glukose erhöht, um in Stresssituationen Energie zur Verfügung zu stellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9143d9cb-d9da-4202-8795-7059c0de8afe",
                                                "sense_id": "b93bbbe5-10ae-33ca-9862-6d7e22c1c605",
                                                "text": "„In lebensgefährlichen Situationen wird der Körper mit Stresshormonen wie Cortisol und Adrenalin überschwemmt.“"
                                            },
                                            {
                                                "example_id": "ee860daa-2d07-4cc1-a51c-ddc91f1874f4",
                                                "sense_id": "b93bbbe5-10ae-33ca-9862-6d7e22c1c605",
                                                "text": "„Normalerweise schützt die Plazenta den Fötus vor dem Stresshormon Cortisol.“"
                                            },
                                            {
                                                "example_id": "64ebadad-df4e-44bf-bc02-1c517999f2ec",
                                                "sense_id": "b93bbbe5-10ae-33ca-9862-6d7e22c1c605",
                                                "text": "„Cortisol verhindert die Reparatur der Telomere: Stress macht alt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
