                        "entry_id": "0a284b9f-7beb-378d-a362-ffadb9acce6d",
                        "glosses": [
                            "hiermee wordt in de muziektheorie de leer der meerstemmigheid verstaan"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1bcd98fe-bdac-3824-803d-0927c0d930fc",
                        "entry_id": "0a284b9f-7beb-378d-a362-ffadb9acce6d",
                        "glosses": [
                            "afwijking t.o.v. de omgeving"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "032b81d3-2a0a-4293-89c2-67894168383f",
                                "sense_id": "1bcd98fe-bdac-3824-803d-0927c0d930fc",
                                "text": "De buitenproportioneel grote klokkentoren van rode baksteen met een witte marmeren omgang en een groen puntdak bracht met zijn asymmetrische plaatsing een belachelijk contrapunt aan in de rationele, paradeerbare ruimte, dat juist vanwege het feit dat het concessieloos gewaagd en overdreven was effectief en elegant uitpakte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b0b7b13-3db3-43d7-a840-2aa24db6f9da",
                        "source_entry_id": "0a284b9f-7beb-378d-a362-ffadb9acce6d",
                        "source_sense_id": "71c153bd-0e55-3e7c-8b36-d46631cc56ac",
                        "source_sense_description": "leer der meerstemmigheid",
                        "target_lang_word": "Kontrapunkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kontrapunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c90120-7ad9-358d-88c4-e3be730dcc68",
                                        "entry_id": "0f0690d8-cd8e-3c1a-ae98-7b998a337d14",
                                        "glosses": [
                                            "melodisch und rhythmisch eigenständig geführte Stimme (eigenständige Gegenstimme zum Thema, gleichwertiger „Partner“ der anderen Stimme(n) in einem polyphonen Satz)"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcb817e1-c6df-4ae9-8f2a-d110f3406d2e",
                                                "sense_id": "f7c90120-7ad9-358d-88c4-e3be730dcc68",
                                                "text": "Man „nennt […] die Stimme, die in einer Fuge gleichzeitig mit dem Thema bzw. Soggetto erklingt, dessen Kontrapunkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c158289c-5ba0-336e-a392-f5d8cff577d3",
                                        "entry_id": "0f0690d8-cd8e-3c1a-ae98-7b998a337d14",
                                        "glosses": [
                                            "die Kunst beziehungsweise Technik, Gegenstimmen zu gegebenen Tonfolgen zu erfinden"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ba9a894-0a5b-4cb9-bff8-94d145e74a79",
                                                "sense_id": "c158289c-5ba0-336e-a392-f5d8cff577d3",
                                                "text": "„Der Kontrapunkt als Kompositionstechnik unterlag in der Musikgeschichte sich wandelnden Regeln, die von der wechselnden Bewertung von Konsonanzen und Dissonanzen abhingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fa64f233-da8a-3faf-a918-6e30ed204be3",
                                        "entry_id": "0f0690d8-cd8e-3c1a-ae98-7b998a337d14",
                                        "glosses": [
                                            "synonyme Verwendung für Polyphonie, Mehrstimmigkeit"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7028ceaa-2836-42db-9a88-f14d5ac8d333",
                                                "sense_id": "fa64f233-da8a-3faf-a918-6e30ed204be3",
                                                "text": "„Polyphonie in diesem Sinn ist eine Form der Mehrstimmigkeit, bei der die einzelnen Stimmen im Wesentlichen gleichwertig sind. Dies wird erreicht, indem ein Komponist ihren Verlauf nach den Regeln des Kontrapunkts führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "35fab730-f27e-3f96-b2cb-a7206db640fa",
                                        "entry_id": "0f0690d8-cd8e-3c1a-ae98-7b998a337d14",
                                        "glosses": [
                                            "deutlich erkennbarer Gegensatz"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dbe0dfe-0b9a-4f1d-9cfa-4769cd45ab1d",
                                                "sense_id": "35fab730-f27e-3f96-b2cb-a7206db640fa",
                                                "text": "„Mit der Betonung des kompromisslosen Kampfes gegen Israel setzt er bewusst einen Kontrapunkt zu Mahmud Abbas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f9bf9d0-dc50-4338-b8a8-0e837f1bef67",
                        "source_entry_id": "0a284b9f-7beb-378d-a362-ffadb9acce6d",
