                                        "examples": [
                                            {
                                                "example_id": "d768afa5-2a6b-4eea-ba42-7418989b9dbe",
                                                "sense_id": "d8adae6d-1126-332c-951e-37f95f6f5d8f",
                                                "text": "No way could I pull off being a Gorean kajira. I wasn't nearly submissive enough."
                                            },
                                            {
                                                "example_id": "d06b8d0a-9fd5-4860-81bb-67bd85ca9739",
                                                "sense_id": "d8adae6d-1126-332c-951e-37f95f6f5d8f",
                                                "text": "In fact, players have incorporated Gorean roleplay into a number of online games, adopting the social structures, institutions, and in some cases even the language of Gor."
                                            },
                                            {
                                                "example_id": "ca7f3c16-7164-44da-8f37-4790c0ba6917",
                                                "sense_id": "d8adae6d-1126-332c-951e-37f95f6f5d8f",
                                                "text": "The photos show that Gorean slave dress code means wearing “silks,” which amounts to being naked or almost naked."
                                            }
