                "senses": [
                    {
                        "sense_id": "884aee6d-c49a-3a10-8e66-5cc268cdcf82",
                        "entry_id": "eb901fd0-4ad3-35ee-bf91-d7d17e797acc",
                        "glosses": [
                            "Kraftwagen zum Transport weniger Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31a59521-f4a4-4cc4-95ef-d5f09b28a5a9",
                                "sense_id": "884aee6d-c49a-3a10-8e66-5cc268cdcf82",
                                "text": "Der Absatz von Personenwagen ist auch in diesem Quartal wieder gestiegen."
                            },
                            {
                                "example_id": "e72b6cf5-b5f1-4fa6-a7ca-4cd1d1d6bbdb",
                                "sense_id": "884aee6d-c49a-3a10-8e66-5cc268cdcf82",
                                "text": "„In Berlin waren im Oktober 1945 nur siebentausend Personenwagen zugelassen, fast ausschließlich Dienstfahrzeuge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "000e0955-a419-3fe4-ad8f-44ddddd74378",
                        "entry_id": "eb901fd0-4ad3-35ee-bf91-d7d17e797acc",
                        "glosses": [
                            "Eisenbahnwagen zum Transport von Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7549433-855a-46fa-b54f-34634abe82aa",
                                "sense_id": "000e0955-a419-3fe4-ad8f-44ddddd74378",
                                "text": "In den USA gibt es viel mehr Personenwagen mit Klimaanlage als in Europa."
                            },
                            {
                                "example_id": "f8c43046-bc80-446f-a174-9b91fcbcf94c",
                                "sense_id": "000e0955-a419-3fe4-ad8f-44ddddd74378",
                                "text": "„Und nicht gerade friedensmäßig sieht er aus, widersprüchlich ist er zusammengesetzt: vorn Personenwagen mit vernagelten Fenstern, hinten Viehwaggons.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abeea249-521d-41d4-ad91-bd457c1e30c3",
                        "source_entry_id": "eb901fd0-4ad3-35ee-bf91-d7d17e797acc",
                        "source_sense_id": "884aee6d-c49a-3a10-8e66-5cc268cdcf82",
                        "source_sense_description": "Kraftwagen zum Transport weniger Personen",
                        "target_lang_word": "car",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "car",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0ba1e7a-775e-340c-a90e-3a8b7b4ec8a1",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "A wheeled vehicle that moves independently, with at least three wheels, powered mechanically, steered by a driver and mostly for personal transportation but relatively smaller than a truck/lorry and a bus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a2bc4b-1683-4f6b-85fd-9495fad32f45",
                                                "sense_id": "c0ba1e7a-775e-340c-a90e-3a8b7b4ec8a1",
                                                "text": "He drove his car to the theatre."
                                            },
                                            {
                                                "example_id": "3f37d23b-8723-4c23-adf2-86c687acda53",
                                                "sense_id": "c0ba1e7a-775e-340c-a90e-3a8b7b4ec8a1",
                                                "text": "He was thinking about buying a brand new car."
                                            },
                                            {
                                                "example_id": "5bca7500-8738-4278-900c-ad2c223530d9",
                                                "sense_id": "c0ba1e7a-775e-340c-a90e-3a8b7b4ec8a1",
                                                "text": "I'm a stunt; ride in the car with some bump in the trunk."
                                            },
                                            {
                                                "example_id": "4a40a12a-ccbc-4913-9229-393cf4c74bd6",
                                                "sense_id": "c0ba1e7a-775e-340c-a90e-3a8b7b4ec8a1",
                                                "text": "If successful, Edison and Ford—in 1914—would move society away from the ever more expensive and then universally known killing hazards of gasoline cars: […] ."
                                            },
                                            {
                                                "example_id": "26cc2295-215e-4c2e-8c97-c0780fd3175f",
                                                "sense_id": "c0ba1e7a-775e-340c-a90e-3a8b7b4ec8a1",
                                                "text": "The race around the Interlagos circuit in São Paolo effectively became a 12-lap dash to the flag when Valtteri Bottas triggered the safety car after he pulled his Mercedes over with engine trouble."
                                            },
                                            {
                                                "example_id": "83509905-3d6c-4b9b-89fb-7383e329ac89",
                                                "sense_id": "c0ba1e7a-775e-340c-a90e-3a8b7b4ec8a1",
                                                "text": "Then, of course, there are the cars themselves. The most valuable classic car ever sold at auction was a 1962 Ferrari 250 GTO that sold for more than $48 million in 2018. Of the top ten most valuable cars ever sold at auction, six are Ferraris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d4c712c-790e-3966-b527-44ac30e1ced4",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "A wheeled vehicle, drawn by a horse or other animal."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24010905-533b-4fb7-aa2e-4d488e2706d0",
                                                "sense_id": "7d4c712c-790e-3966-b527-44ac30e1ced4",
                                                "text": "It shall suffice me to enioy your loue,\nWhich whiles I haue, I thinke my selfe as great,\nAs Caesar riding in the Romaine streete,\nWith captiue kings at his triumphant Carre."
                                            },
                                            {
                                                "example_id": "6af350b7-412e-4b0b-80d1-d09f84dec25f",
                                                "sense_id": "7d4c712c-790e-3966-b527-44ac30e1ced4",
                                                "text": "He has deserved it [armour], were it carbuncled\nLike holy Phoebus’ car."
                                            },
                                            {
                                                "example_id": "768078db-b6ac-4640-ae35-25a1a9473dc3",
                                                "sense_id": "7d4c712c-790e-3966-b527-44ac30e1ced4",
                                                "text": "The Red Foliot sate in his car of polished ebony, drawn by six black horses with flowing manes and tails; before him went his musicians, pipers and minstrels doing their craft, and behind him fifty spearmen, weighed down with armour and ponderous shields that covered them from chin to toe."
                                            },
                                            {
                                                "example_id": "8dfdeffc-091c-4732-a4cf-05d8ca2991bd",
                                                "sense_id": "7d4c712c-790e-3966-b527-44ac30e1ced4",
                                                "text": "In a poem by Sappho, Aphrodite is represented as riding in a car drawn by sparrows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0014dd2a-c9b2-39a0-8856-7ec05df76a80",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "A wheeled vehicle, drawn by a horse or other animal.",
                                            "A cart."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fab7cb8-004b-32d6-94a7-cab0730ad45b",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "A wheeled vehicle, drawn by a horse or other animal.",
                                            "A chariot."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0199a9e5-2c8e-3afa-ae2e-56cfd4ca7965",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "A wheeled vehicle, drawn by a horse or other animal.",
                                            "A four-wheeled cab, as opposed to a (two-wheeled) Hansom cab."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8de2830a-7943-3a78-a9a1-28d26a237b16",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "Any vehicle designed to run on rails, especially an unpowered one towed by being connected to others.",
                                            "An unpowered unit in a railroad train, used to hold either passengers or cargo."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa7763b8-adf7-43cc-9ff5-cec4e48de7d6",
                                                "sense_id": "8de2830a-7943-3a78-a9a1-28d26a237b16",
                                                "text": "The conductor coupled the cars to the locomotive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c6e4e86-1e42-32c0-ade5-2c7a9117a3b7",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "Any vehicle designed to run on rails, especially an unpowered one towed by being connected to others.",
                                            "A similar vehicle used in special contexts, such as mines, quarries, and mills."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27b9ee77-0e24-34c4-b6b2-8914e728c808",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "Any vehicle designed to run on rails, especially an unpowered one towed by being connected to others.",
                                            "an individual vehicle, powered or unpowered, in a multiple unit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
