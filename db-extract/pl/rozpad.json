                                        "sense_id": "145fa878-a511-3193-99d7-c348a5f3b61a",
                                        "entry_id": "8cbb7793-e86a-3b00-8bb3-dfd8f9e245ac",
                                        "glosses": [
                                            "The process or result of being gradually decomposed; rot, decomposition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1e9f14d-95aa-4ac2-bfa4-259098c06a9b",
                                                "sense_id": "145fa878-a511-3193-99d7-c348a5f3b61a",
                                                "text": "I fancied at first the stuff was paraffin wax, and smashed the jar accordingly. But the odor of camphor was unmistakable. It struck me as singularly odd, that among the universal decay, this volatile substance had chanced to survive, perhaps through many thousand years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f96fd6d1-68d3-3929-9858-b8d57b19281f",
                                        "entry_id": "8cbb7793-e86a-3b00-8bb3-dfd8f9e245ac",
                                        "glosses": [
                                            "A deterioration of condition; loss of status, quality, strength, or fortune."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
