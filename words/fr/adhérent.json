    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "415bfb02-4703-388c-aa06-55579eff1ecd",
                    "sense_definition": "Personne qui est membre d'une association, d'un parti ou d'une organisation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personne_membre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque <w>adhérent</w> de l'association doit payer une cotisation annuelle avant la fin du mois."
                        },
                        {
                            "text": "Le club sportif compte désormais plus de cinq cents <w>adhérents</w> réguliers cette saison."
                        }
                    ],
                    "synonyms": [
                        "membre"
                    ],
                    "common_phrases": [
                        "carte d'adhérent",
                        "nouvel adhérent"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d55aed43-da49-308f-91eb-0802abc69b5c",
                    "sense_definition": "Qui se colle, qui tient ou est fixé à une surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propriete_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette colle spéciale reste très <w>adhérente</w> même sur du plastique lisse."
                        },
                        {
                            "text": "Ces nouveaux pneus offrent une bande de roulement particulièrement <w>adhérente</w> sur route mouillée."
                        }
                    ],
                    "common_phrases": [
                        "matière adhérente",
                        "surface adhérente"
                    ]
                },
                {
                    "sense_id": "62691b01-3b2c-3f94-9a26-e4b724cb8cf1",
                    "sense_definition": "En parlant d'un organe ou d'une pièce florale, qui est uni ou soudé à une autre partie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chez cette espèce de fleur, le calice reste <w>adhérent</w> à l'ovaire pendant toute la fructification."
                        },
                        {
                            "text": "Les botanistes ont observé un pétale <w>adhérent</w> au réceptacle de cette plante rare."
                        }
                    ],
                    "synonyms": [
                        "adné"
                    ]
                },
                {
                    "sense_id": "f626d34b-e4d3-3976-a61a-040d2cd68e39",
                    "sense_definition": "En topologie, qualifie un point qui appartient à l'adhérence d'une partie d'un espace.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un point est dit <w>adhérent</w> à un ensemble si tout voisinage de ce point rencontre cet ensemble."
                        },
                        {
                            "text": "Le professeur a démontré que ce point frontière était <w>adhérent</w> à la partie considérée."
                        }
                    ],
                    "common_phrases": [
                        "point adhérent"
                    ]
                }
            ]
        }
    ]
