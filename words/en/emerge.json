                                "ru": "Солнце <w>вышло</w> из-за туч.",
                                "de": "Die Sonne <w>erschien</w> hinter den Wolken.",
                                "nl": "De zon <w>kwam</w> achter de wolken vandaan.",
                                "pl": "Słońce <w>wyłoniło się</w> zza chmur.",
                                "fr": "Le soleil a <w>émergé</w> de derrière les nuages.",
                                "it": "Il sole è <w>emerso</w> da dietro le nuvole.",
                                "cs": "Slunce se <w>vynořilo</w> zpoza mraků.",
                                "tr": "Güneş bulutların arkasından <w>ortaya çıktı</w>.",
                                "es": "El sol <w>emergió</w> de detrás de las nubes.",
                                "zh": "太阳从云层后<w>显露</w>了出来。"
                            }
                        },
                        {
                            "text": "A dark figure <w>emerged</w> from the shadows.",
                            "target_lang_translations": {
                                "ru": "Тёмная фигура <w>вышла</w> из тени.",
                                "de": "Eine dunkle Gestalt <w>tauchte</w> aus den Schatten auf.",
                                "nl": "Een donkere figuur <w>dook</w> op uit de schaduwen.",
                                "pl": "Ciemna postać <w>wyłoniła się</w> z cienia.",
                                "fr": "Une silhouette sombre a <w>émergé</w> de l'ombre.",
                                "it": "Una figura scura è <w>emersa</w> dall'ombra.",
                                "cs": "Temná postava se <w>vynořila</w> ze stínů.",
                                "tr": "Karanlıktan koyu bir figür <w>belirdi</w>.",
                                "es": "Una figura oscura <w>apareció</w> de entre las sombras.",
                                "zh": "一个黑影从阴影中<w>出现</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "appear",
                        "come forth"
                    ],
                    "antonyms": [
                        "disappear",
                        "vanish"
                    ],
                    "common_phrases": [
                        "emerge from the shadows",
                        "emerge from the darkness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Появляться в поле зрения или выходить из скрытого или замкнутого пространства.",
