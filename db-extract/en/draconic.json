            {
                "entry_id": "63d9d697-d8a1-3ca8-9ebb-2933871ccfc2",
                "word": "Draconic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "672a1ebd-aee7-4572-baaa-798541a2e4e2",
                        "entry_id": "63d9d697-d8a1-3ca8-9ebb-2933871ccfc2",
                        "tags": [
