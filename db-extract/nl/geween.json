                                        "sense_id": "eb4bb879-3a73-34f7-970a-cebf09edf463",
                                        "entry_id": "ddf12ac3-87c9-33d8-9115-42b333d54d1d",
                                        "glosses": [
                                            "The act of one who cries; a weeping or shouting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe70289b-aca6-4c62-8824-11ccf2522a94",
                                                "sense_id": "eb4bb879-3a73-34f7-970a-cebf09edf463",
                                                "text": "Their constant cryings kept us awake!"
                                            },
                                            {
                                                "example_id": "0c973914-1c09-439b-854c-0a38ca4b46bd",
                                                "sense_id": "eb4bb879-3a73-34f7-970a-cebf09edf463",
                                                "text": "[…] their breathings, cryings, and excretings would have been damaged […]"
                                            }
                                        ]
                                    }
