                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c2d490d-3a4e-322d-82a0-a3c84c43b0b9",
                                        "entry_id": "8685ab7b-1a83-32dc-9ba8-7a56e62ac2b5",
                                        "glosses": [
                                            "The chattering damsel of a mill."
