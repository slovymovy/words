{
    "word_family": [
        "fortune",
        "fortunate",
        "unfortunate",
        "fortunately"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                    "sense_definition": "Used to express disappointment, regret, or sorrow regarding a statement or event.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Unfortunately</w>, we arrived too late to catch the train.",
                            "target_lang_translations": {
                                "ru": "<w>К сожалению</w>, мы приехали слишком поздно, чтобы успеть на поезд.",
                                "zh": "<w>遗憾的是</w>，我们到得太晚，没赶上火车。"
                            }
                        },
                        {
                            "text": "I wanted to help you, but <w>unfortunately</w> I have no money.",
                            "target_lang_translations": {
                                "ru": "Я хотел помочь тебе, но, <w>к сожалению</w>, у меня нет денег.",
                                "zh": "我想帮你，但<w>可惜</w>我没钱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sadly",
                        "regrettably",
                        "alas",
                        "sad to say",
                        "unluckily"
                    ],
                    "antonyms": [
                        "fortunately",
                        "luckily"
                    ],
                    "common_phrases": [
                        "but unfortunately",
                        "unfortunately not",
                        "unfortunately for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения разочарования или сожаления по поводу какого-либо факта или события.",
                        "zh": "用于表达对某事感到失望、遗憾或难过。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "к сожалению",
                                "target_lang_sense_clarification": "выражение сожаления"
                            },
                            {
                                "target_lang_word": "к несчастью",
                                "target_lang_sense_clarification": "выражение огорчения или неудачи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遗憾的是",
                                "target_lang_sense_clarification": "用于句首，表达对事实的遗憾"
                            },
                            {
                                "target_lang_word": "可惜",
                                "target_lang_sense_clarification": "表达对某事未达成或损失的惋惜"
                            },
                            {
                                "target_lang_word": "不凑巧",
                                "target_lang_sense_clarification": "指事情发生得不合时宜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bf31a51-c605-3352-82e9-c91eac358792",
                    "sense_definition": "In a manner resulting from bad luck or an unfavorable event.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The decision was <w>unfortunately</w> timed right before the holiday.",
                            "target_lang_translations": {
                                "ru": "Решение было <w>неудачно</w> принято прямо перед праздником.",
                                "zh": "这个决定做得<w>不凑巧</w>，正好在假期之前。"
                            }
                        },
                        {
                            "text": "There is an <w>unfortunately</w> large gap in the data we collected.",
                            "target_lang_translations": {
                                "ru": "В собранных нами данных, <w>к сожалению</w>, есть большой пробел.",
                                "zh": "我们收集的数据中存在一个<w>不幸地</w>巨大的缺口。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unluckily",
                        "sadly",
                        "regrettably"
                    ],
                    "antonyms": [
                        "fortunately",
                        "luckily"
                    ],
                    "common_phrases": [
                        "unfortunately common",
                        "unfortunately rare",
                        "unfortunately large"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неудачным образом или вследствие неблагоприятного стечения обстоятельств.",
                        "zh": "以一种不走运或不理想的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неудачно",
                                "target_lang_sense_clarification": "наречие образа действия"
                            },
                            {
                                "target_lang_word": "к сожалению",
                                "target_lang_sense_clarification": "оценка ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不幸地",
                                "target_lang_sense_clarification": "强调结果不佳或遭遇不幸"
                            },
                            {
                                "target_lang_word": "不凑巧地",
                                "target_lang_sense_clarification": "强调时机或情况不佳"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}