                        "entry_id": "782bed16-3428-3ce1-b944-fba8e8d87603",
                        "glosses": [
                            "zeer nauwgezet, goed, juist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67121014-5fbf-4d5b-8d38-f7b71db107e8",
                                "sense_id": "c34504d7-a7a6-397e-9a3b-8eb7df7835c4",
                                "text": "Een meticuleuze aanpak."
