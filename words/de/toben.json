                    "frequency": "Low",
                    "semantic_group_id": "begeisterung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem gelungenen Auftritt <w>tobte</w> das gesamte Publikum im Theater vor Begeisterung."
                        },
                        {
                            "text": "Als der entscheidende Treffer fiel, <w>tobten</w> tausende Zuschauer auf den Tribünen."
