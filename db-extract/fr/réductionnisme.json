                "senses": [
                    {
                        "sense_id": "13dbd3e4-6a3c-3bf3-bc55-19df07546a47",
                        "entry_id": "a5a1d935-3834-3209-8ad6-dddd8c295f08",
                        "glosses": [
                            "Méthode scientifique qui consiste à fragmenter des systèmes complexes en éléments plus simples à étudier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2249a8cc-8b46-4a41-9693-5270f3cff9bd",
                                "sense_id": "13dbd3e4-6a3c-3bf3-bc55-19df07546a47",
                                "text": "En un second sens, péjoratif, le réductionnisme est une thèse ontologique, et non simplement épistémologique ou méthodologique, visant à réduire la complexité à un seul facteur."
                            },
                            {
                                "example_id": "cb515d90-b77d-4136-b959-bd2e169dfba2",
                                "sense_id": "13dbd3e4-6a3c-3bf3-bc55-19df07546a47",
                                "text": "Cette mise en question de déterminisme va de pair avec une critique du réductionnisme, le premier impliquant le second."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32b3292c-8c16-48cc-973b-52568b5b460a",
                        "source_entry_id": "a5a1d935-3834-3209-8ad6-dddd8c295f08",
                        "source_sense_id": "13dbd3e4-6a3c-3bf3-bc55-19df07546a47",
                        "target_lang_word": "Reduktionismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reduktionismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ca18622-67e1-3a03-81c2-c5b5f52270c0",
                                        "entry_id": "6ae47744-c3a2-33bf-aa74-1d79b9b13498",
                                        "glosses": [
                                            "Betrachtungsweise, bei der Einzelelemente in einem System für sich in ihrer Bedeutung zu stark gewichtet werden, ohne ihre Verflechtung im ganzen System zu sehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea214f1-9d0e-467a-a8d3-3bf412c76fc0",
                                                "sense_id": "7ca18622-67e1-3a03-81c2-c5b5f52270c0",
                                                "text": "Der Satz „Das Ganze ist mehr als die Summe seiner Teile.“ läuft jedem Reduktionismus zuwider."
                                            },
                                            {
                                                "example_id": "d90d36a4-dd34-450e-9df4-ac55682f971b",
                                                "sense_id": "7ca18622-67e1-3a03-81c2-c5b5f52270c0",
                                                "text": "Einen krasseren Reduktionismus als die Aussage „Das Phänomen Leben besteht aus nichts Anderem als Biochemie.“ kann man sich kaum vorstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
