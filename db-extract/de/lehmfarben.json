                "senses": [
                    {
                        "sense_id": "0107aa78-9b0b-30b0-ad2a-5d74b3778bce",
                        "entry_id": "7edb5124-6be9-3522-aa0f-5cab309da9c2",
                        "glosses": [
                            "in einem an Lehm erinnernden Braunton, braun wie Lehm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a75387a-ed44-474c-9e0f-c691401b2cbe",
                                "sense_id": "0107aa78-9b0b-30b0-ad2a-5d74b3778bce",
                                "text": "„Am Flussrand machten sie halt und beobachteten das aufgewühlte, lehmfarbene Wasser, wie es flach und stetig durch die Wüste schäumte.“"
                            },
                            {
                                "example_id": "5ceefbb3-182b-40ce-8bb0-359f3d8c6b7b",
                                "sense_id": "0107aa78-9b0b-30b0-ad2a-5d74b3778bce",
                                "text": "„Seinen Overall hatte er in die hohen Stiefel gesteckt und um seinen Hals hing eine Schlange, dünn wie eine Peitsche und lehmfarben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
