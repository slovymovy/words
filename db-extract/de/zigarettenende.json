                "senses": [
                    {
                        "sense_id": "c8ac3cca-b9ca-3a45-9767-30b3b4de6ce5",
                        "entry_id": "1064de6b-9df9-3863-b262-8a9cddbdc372",
                        "glosses": [
                            "übrig gebliebener Teil einer Zigarette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a7b76c6-f497-4409-9abf-8c215fa6a34f",
                                "sense_id": "c8ac3cca-b9ca-3a45-9767-30b3b4de6ce5",
                                "text": "„Das Zigarettenende jedoch saß festgeklebt im Mundwinkel und blieb, wo es war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "919cbaa8-29e7-4a4e-8d46-ee25ed5b9901",
                        "source_entry_id": "1064de6b-9df9-3863-b262-8a9cddbdc372",
                        "source_sense_id": "c8ac3cca-b9ca-3a45-9767-30b3b4de6ce5",
                        "source_sense_description": "übrig gebliebener Teil einer Zigarette",
                        "target_lang_word": "mégot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mégot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c606dbdd-247d-3b9f-810f-dbcbb4c8c548",
                                        "entry_id": "80b65cac-251d-3c50-9b39-ae62c9d49021",
                                        "glosses": [
                                            "Bout qui reste d’un cigare ou d’une cigarette quand on a fini de les fumer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "652d85c6-1cdd-4516-9c94-35760e8da17d",
                                                "sense_id": "c606dbdd-247d-3b9f-810f-dbcbb4c8c548",
                                                "text": "Une antique Remington occupait l’extrémité d’une table, voisinant avec un registre ouvert et tout ce qu’il fallait pour écrire, plus un cendrier débordant de mégots, une petite lampe à abat-jour vert, un téléphone, un trébuchet sensible comme une midinette, une loupe d’horloger, une pierre de touche, etc."
                                            },
                                            {
                                                "example_id": "2140c9da-23b7-4590-abee-f2d0d540ea34",
                                                "sense_id": "c606dbdd-247d-3b9f-810f-dbcbb4c8c548",
                                                "text": "Il marcherait derrière elle et, comme un clochard suit avec entêtement un fumeur de cigare pour ramasser le mégot, il suivrait la robe rouge pour en respirer, amer ou non, le parfum."
                                            },
                                            {
                                                "example_id": "064bd9fc-1139-4293-8ea0-7c2b9d057d23",
                                                "sense_id": "c606dbdd-247d-3b9f-810f-dbcbb4c8c548",
                                                "text": "Le père avait fini sa cigarette depuis longtemps, mais ses doigts serraient toujours le mégot mouillé et émincé qui s’était éteint tout seul. Il en fit tomber la cendre puis, tordant le papier pour y enfermer ce qu’il contenait encore de tabac, il tira de la poche de son tablier une petite boîte de métal blanc poli par le frottement et y mit ce mégot."
                                            },
                                            {
                                                "example_id": "4d65b41b-2b00-4f2e-988e-38e42b3b27ba",
                                                "sense_id": "c606dbdd-247d-3b9f-810f-dbcbb4c8c548",
                                                "text": "Sur la table, un verre encore à moitié plein où macéraient une douzaine de mégots. Partout de la vaisselle sale."
                                            },
                                            {
                                                "example_id": "0f2bdf1e-6e17-43e1-ab80-2f1a686896ff",
                                                "sense_id": "c606dbdd-247d-3b9f-810f-dbcbb4c8c548",
                                                "text": "Au Canada, on estime que 8000 tonnes de mégots de cigarette sont jetées par terre chaque année, la plupart à moins de trois mètres d'un cendrier. Ceux-ci contiennent des filtres en acétate de cellulose, dont la décomposition peut prendre jusqu'à 15 ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9df16cd-7583-3d0e-b9ab-02f93c10ce5d",
                                        "entry_id": "80b65cac-251d-3c50-9b39-ae62c9d49021",
                                        "glosses": [
                                            "Cigarette ou cigare presque entièrement consumés."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79c2fac5-3c38-4aa3-ade8-1ec0ae584926",
                                                "sense_id": "a9df16cd-7583-3d0e-b9ab-02f93c10ce5d",
                                                "text": "Il tira un peu plus fort sur son mégot et la lueur de la braise éclaira faiblement un nouveau cigare posé sur la pierre."
                                            },
                                            {
                                                "example_id": "41ab50af-a03c-41e9-a297-ea26b32b4f3f",
                                                "sense_id": "a9df16cd-7583-3d0e-b9ab-02f93c10ce5d",
                                                "text": "Il avait une chemise ouverte jusqu’au nombril, une paire de lunettes qui pendait sur son torse et un mégot au coin de la bouche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
