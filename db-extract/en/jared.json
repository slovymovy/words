                        "glosses": [
                            "A male given name from Hebrew of Biblical origin; rare in the English-speaking world until the 1960s."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f1f5d6c6-9caa-45c4-b06f-268ee683eb36",
                                "sense_id": "11079594-445b-3cfe-bb36-1fe9381d2132",
                                "text": "Some experts, such as geographer Jared Diamond in his 2005 book, “Collapse,” used Easter Island as a cautionary tale of how the exploitation of limited resources can result in catastrophic population decline, ecological devastation and the destruction of a society through infighting."
                            }
                        ]
                    },
                    {
                        "sense_id": "230326b7-85ab-30b3-b434-0b4060ce69d9",
                        "entry_id": "5cdf9d94-0d2c-350d-921d-1a498411aa90",
                        "glosses": [
                            "A man mentioned in the Book of Genesis, a descendant of Adam and of Seth, the father of Enoch, an ancestor of Noah."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d3bf94bb-d028-4d45-9ae4-fdb048781ddc",
                                "sense_id": "230326b7-85ab-30b3-b434-0b4060ce69d9",
                                "text": "And Jared lived after he begat Enoch eight hundred years, and begat sons and daughters:"
                            }
                        ]
                    },
                    {
                        "sense_id": "ffb86589-1d31-3000-b9d3-4cd509dc7930",
                        "entry_id": "5cdf9d94-0d2c-350d-921d-1a498411aa90",
                        "glosses": [
                            "The ancestor of the Jaredites in the Book of Mormon."
