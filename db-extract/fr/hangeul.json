                                        "glosses": [
                                            "im Koreanischen verwendete, sowohl phonografisch als auch syllabografisch strukturierte Schrift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "372b64e0-10c2-413b-9b89-cb7e677a5cb8",
                                                "sense_id": "99358e51-0ff1-3854-8fee-4fc7224cf3ed",
                                                "text": "Der Text ist in Hangeul geschrieben."
                                            },
                                            {
                                                "example_id": "060c7390-d445-43f3-ab82-014953691bf1",
                                                "sense_id": "99358e51-0ff1-3854-8fee-4fc7224cf3ed",
                                                "text": "„Hangeul ist so aufgebaut, dass man damit alle möglichen Lautmalereien und Klänge wiedergeben und aufzeichnen kann.“"
                                            }
