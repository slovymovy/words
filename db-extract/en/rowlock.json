                        "target_lang_word": "dame de nage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dame de nage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45b567a0-61c6-3e6b-be88-ddc41dacee30",
                                        "entry_id": "48e0aebb-f9f9-3706-861c-dbccb4c7aedd",
                                        "glosses": [
                                            "Ferrure en forme de U sur pivot, fixée sur le plat-bord d’une barque ou au bout d’un portant et dans laquelle on fixe les avirons pour ramer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00169036-2788-4905-ad61-a1ff6446eea1",
                                                "sense_id": "45b567a0-61c6-3e6b-be88-ddc41dacee30",
                                                "text": "Les systèmes de nage ou portants sont constitués de tubes, en métal ou en matériaux composites, qui supportent la dame de nage, mobile autour d'un axe fixe, dans laquelle vient se fixer l'aviron. Cette dame de nage est fermée par une barrette."
                                            },
                                            {
                                                "example_id": "fda98320-568d-4b07-94b4-12ab7a9de8ff",
                                                "sense_id": "45b567a0-61c6-3e6b-be88-ddc41dacee30",
                                                "text": "Il bloqua les deux avirons dans les dames de nage et, le dos tourné au couchant, souqua vers la pointe de l’île."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df2225b1-a332-3b70-9e49-70e820007cd8",
                                        "entry_id": "48e0aebb-f9f9-3706-861c-dbccb4c7aedd",
                                        "glosses": [
                                            "Échancrure en forme de demi-lune, pratiquée dans le plat-bord ou le tableau arrière d’un canot, d’une embarcation, servant à maintenir un aviron ou une godille pendant la nage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba85c9e9-9f34-4d44-8d44-e3de49f81d5d",
                                                "sense_id": "df2225b1-a332-3b70-9e49-70e820007cd8",
                                                "text": "Martin, caché derrière une touffe d’euphorbes, regardait la silhouette noiraude patauger dans l’eau claire et se hisser péniblement en s’agrippant aux dames de nage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
