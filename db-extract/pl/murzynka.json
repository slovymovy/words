                            {
                                "example_id": "8d3eedd3-6c9c-4ac0-820a-efeb92b0c61e",
                                "sense_id": "cdddbd90-859f-341b-be82-a9d4e2c1e3aa",
                                "text": "Oglądam niewolnicę pod cieniem kolumny. • Murzynkę uśmiechniętą, co na remingtonie • Przepisuje mój sonet o wyblakłym tonie"
                            }
