{
    "word_family": [
        "gnarl"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8d541c22-90fd-3b53-b333-35c4610f228c",
                    "sense_definition": "Knotty and misshapen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old oak tree had <w>gnarled</w> branches that twisted in every direction.",
                            "target_lang_translations": {
                                "zh": "那棵老橡树长着<w>多节</w>的树枝，向四面八方扭曲着。"
                            }
                        },
                        {
                            "text": "He walked through the forest, stepping over <w>gnarled</w> roots that poked out of the ground.",
                            "target_lang_translations": {
                                "zh": "他走过森林，跨过那些从地里冒出来的<w>扭曲</w>的树根。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gnarly"
                    ],
                    "common_phrases": [
                        "gnarled branches",
                        "gnarled roots"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容树木或根部多节、扭曲、变形的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "多节的",
                                "target_lang_sense_clarification": "指树木或根部表面凹凸不平、有节疤。"
                            },
                            {
                                "target_lang_word": "扭曲的",
                                "target_lang_sense_clarification": "指形状不规则、弯曲变形。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f6e0165-35c3-37da-aef2-0eea80000ed3",
                    "sense_definition": "Made rough by age or hard work.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer held the tool with his <w>gnarled</w> hands after years of labor.",
                            "target_lang_translations": {
                                "zh": "经过多年的劳作，农夫用他那双<w>粗糙</w>的手握着工具。"
                            }
                        },
                        {
                            "text": "She looked at her <w>gnarled</w> fingers, remembering the decades spent working in the garden.",
                            "target_lang_translations": {
                                "zh": "她看着自己<w>变形</w>的手指，回想起在花园里劳作的几十年时光。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gnarled hands",
                        "gnarled fingers"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容人的手或手指因年老或长期劳作而变得粗糙、变形。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "粗糙的",
                                "target_lang_sense_clarification": "指皮肤因劳作而变得粗糙、布满老茧。"
                            },
                            {
                                "target_lang_word": "变形的",
                                "target_lang_sense_clarification": "指关节因长期劳作或衰老而变得肿大、弯曲。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a67d99f-6ece-32d1-a586-518ad0ed5ce4",
                    "sense_definition": "Simple past and past participle of <w>gnarl</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold wind had <w>gnarled</w> the wood of the old fence over many years.",
                            "target_lang_translations": {
                                "zh": "多年来，寒风将旧栅栏的木头吹得<w>扭曲</w>变形了。"
                            }
                        },
                        {
                            "text": "The storm <w>gnarled</w> the metal frame until it was completely twisted.",
                            "target_lang_translations": {
                                "zh": "暴风雨将金属框架<w>扭曲</w>得完全变了形。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb gnarl."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使……变得扭曲、变形（动词 gnarl 的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……扭曲",
                                "target_lang_sense_clarification": "指因外力或环境影响导致物体形状改变。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}