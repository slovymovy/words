                ],
                "senses": [
                    {
                        "sense_id": "e35bc6e8-489c-30bc-96f4-840143f1ada4",
                        "entry_id": "3c7ef381-f9f9-306f-aed4-fda384e41588",
                        "glosses": [
                            "vriendelijk gebaar van een iemand die veinst een vriend te zijn, kort voordat zijn ware bedoelingen duidelijk worden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0ec33a2d-e2b8-4a0a-aebb-d696b0baa206",
                                "sense_id": "e35bc6e8-489c-30bc-96f4-840143f1ada4",
                                "text": "Ik vind de kus-emoji-zonder-hartje 😗 altijd heel ingewikkeld. Als ik hem krijg denk ik steevast: wat voor kus is dat, een kus zonder liefde? Is dat zo’n plichtmatige natte pakkerd, die je vroeger, voor corona, gelaten moest ondergaan? Of is het een judaskus die aardig lijkt, maar je genadeloos verraadt?"
                            },
                            {
                                "example_id": "e8f7924e-f813-47fe-80a8-600e036f11d7",
                                "sense_id": "e35bc6e8-489c-30bc-96f4-840143f1ada4",
                                "text": "Een Judaskus word wel gegeven\nAan dien men staat naar goed en leven.\nDe lippe brand door liefdeschyn,\nEn 't hart dekt doodelyk venyn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2c2c082-46ee-4305-b9d4-0f2ef7775a27",
                        "source_entry_id": "3c7ef381-f9f9-306f-aed4-fda384e41588",
                        "source_sense_id": "e35bc6e8-489c-30bc-96f4-840143f1ada4",
                        "source_sense_description": "vriendelijk gebaar van een iemand die veinst een vriend te zijn, kort voordat zijn ware bedoelingen duidelijk worden",
                        "target_lang_word": "Judaskuss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Judaskuss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c67a929-942d-3f8b-aeaf-f649b4e1da99",
                                        "entry_id": "6bba73b4-4d65-3d82-bb6e-7c42a0f1dc12",
                                        "glosses": [
                                            "geheuchelter oder verräterischer Kuss oder andere, eigentlich freundliche Geste, die aber mit gegenteiliger Intention ausgeführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14a627d1-e547-4bb0-b3e0-530f63ef7e4a",
                                                "sense_id": "2c67a929-942d-3f8b-aeaf-f649b4e1da99",
                                                "text": "Die Unterstützung, die er ihm stets entgegenbrachte, entpuppte sich als reiner Judaskuss."
                                            }
                                        ],
