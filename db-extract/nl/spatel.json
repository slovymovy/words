                                            {
                                                "example_id": "9f8157a4-6b0c-4a5f-a2af-170721edf6ee",
                                                "sense_id": "52c22e53-a57b-3f08-90b8-29987e246239",
                                                "text": "The croupier delicately faced her other two cards with the tip of his spatula. A four! She had lost!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d2a0b09-f59b-39ed-9801-f40b0567a888",
                                        "entry_id": "6f069a63-ca36-3847-8919-09b7fed94430",
                                        "glosses": [
                                            "A sclerotized, T-shaped plate in the prothorax of larvae of flies belonging to family Cecidomyiidae, the gall midges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf3e4b0d-e58c-4506-a330-a4fcb554825f",
                                                "sense_id": "6d2a0b09-f59b-39ed-9801-f40b0567a888",
                                                "text": "The third instars are similar to other members of the genus except for a three-pronged spatula (typically two-pronged) and five lateral papillae (typically four) and with a nonbristled first instar."
                                            }
                                        ]
                                    }
