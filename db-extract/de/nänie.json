                        "source_entry_id": "aae7c1cf-2bd8-3dea-a7ad-53a6ce9ec7d5",
                        "source_sense_id": "72b58696-d830-302f-828c-404cd0337b7c",
                        "source_sense_description": "Totenklage beim Leichenzug im antiken Rom",
                        "target_lang_word": "nénie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nénie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "082dbd36-ae52-384f-a756-062fe344cd7e",
                                        "entry_id": "f6656c33-0d8c-31ab-800c-e325bd5bca7c",
                                        "glosses": [
                                            "Chant funèbre, lamentation rituelle en usage aux funérailles dans l’ancienne Rome et effectuée par des pleureuses qu'on louait."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7d7097d-9cfc-4795-8ea9-c97cff72cba4",
                                                "sense_id": "082dbd36-ae52-384f-a756-062fe344cd7e",
                                                "text": "Quand les premières pelletées roulèrent sur la maigre dépouille du comédien, le Pédant, ému et ne pouvant retenir une larme qui, du bout de son nez rouge, tomba dans la fosse comme une perle du cœur, soupira d’une voix dolente, en manière d’oraison funèbre, cette exclamation qui fut toute la nénie et myriologie du défunt : « Hélas ! pauvre Matamore ! »"
                                            },
                                            {
                                                "example_id": "2de32ad8-36be-4d67-abf5-056ff92329d5",
                                                "sense_id": "082dbd36-ae52-384f-a756-062fe344cd7e",
                                                "text": "C’est comme une nénie de séparation éternelle, comme l’adieu d’un voyage sans retour."
                                            },
                                            {
                                                "example_id": "02eb6428-f020-43f3-847d-3ba497109ece",
                                                "sense_id": "082dbd36-ae52-384f-a756-062fe344cd7e",
                                                "text": "Possesseurs de fruits mûrs que dirai-je aux insultes\nOuïr ta voix figure en nénie ô maman\nPuisqu’ils n’eurent enfin la pubère et l’adulte\nDu prétexte sinon que s’aimer nuitamment"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
