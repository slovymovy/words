                "senses": [
                    {
                        "sense_id": "b5240b9f-4e56-364f-80d1-4e7570ee4269",
                        "entry_id": "4cda12a1-ccea-3058-8f55-ee275acb1f4b",
                        "glosses": [
                            "(abgezogenes) Fell eines Schwarzbären"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62c9f1b6-1d57-416e-9143-ea133d07265b",
                                "sense_id": "b5240b9f-4e56-364f-80d1-4e7570ee4269",
                                "text": "„Nun hatte ich die einmalige Gelegenheit, den Pfeilköcher, der dem Gefangenen gehörte, zu studieren. Er war aus einem Stück Schwarzbärfell gemacht.“"
                            },
                            {
                                "example_id": "519aad31-6679-434b-a040-09b2a06f302a",
                                "sense_id": "b5240b9f-4e56-364f-80d1-4e7570ee4269",
                                "text": "„Statt Schwarzbärfellen verarbeitet der Hersteller die dichteren Pelze brauner Bären, die vor dem Zuschnitt erst schwarz gefärbt werden müssen, damit sie später ein einheitliches Bild abgeben.“"
                            },
                            {
                                "example_id": "48596365-2d27-4aac-a1b8-6223731e5fab",
                                "sense_id": "b5240b9f-4e56-364f-80d1-4e7570ee4269",
                                "text": "Es gibtein riesiges Himmelbett, auf dem Boden liegt ein Schwarzbärfell, in einem gewaltigen Regal prangen ledergebundene Klassiker, der Wandschrank ist so groß wie eine durchschnittliche New Yorker Wohnung."
                            },
                            {
                                "example_id": "f27ef6ea-b401-4a1c-98d4-1d075288379a",
                                "sense_id": "b5240b9f-4e56-364f-80d1-4e7570ee4269",
                                "text": "Aracnan warf das Schwarzbärfell ab, das er um die Schultern trug, und setzte sich mit einem zufriedenen Seufzen neben das Feuer."
                            },
                            {
                                "example_id": "e5c43d2b-c37c-48c5-add2-78927a8766d6",
                                "sense_id": "b5240b9f-4e56-364f-80d1-4e7570ee4269",
                                "text": "Für ein Biberfell nahm Boone 18, für ein Schwarzbärfell allerdings nur 10 Schilling."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
