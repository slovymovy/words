                                ]
                            },
                            {
                                "target_word": "encore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2765a091-8cb9-3993-9870-f6ae1517f032",
                                        "entry_id": "9bbdc2bb-a3b5-39b2-b312-98fb4181d901",
                                        "glosses": [
                                            "To call for an extra performance or repetition of, or by."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06b40b52-d68b-488c-b3ad-8231b1d9b17b",
                                                "sense_id": "2765a091-8cb9-3993-9870-f6ae1517f032",
                                                "text": "to encore a performer"
                                            },
                                            {
                                                "example_id": "eb90a86b-cc43-4ff8-ad5e-4c914afc6a1e",
                                                "sense_id": "2765a091-8cb9-3993-9870-f6ae1517f032",
                                                "text": "to encore a song"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eba6bd5-d2c9-39da-a5fb-57c7caf585b0",
                                        "entry_id": "9bbdc2bb-a3b5-39b2-b312-98fb4181d901",
                                        "glosses": [
                                            "To call for an encore."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1efcf4c4-f37a-340b-a1c7-97f283eea659",
                                        "entry_id": "9bbdc2bb-a3b5-39b2-b312-98fb4181d901",
                                        "glosses": [
                                            "To perform an encore."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9c0cf39-e7b7-47c4-80aa-db7118b19fcd",
                                                "sense_id": "1efcf4c4-f37a-340b-a1c7-97f283eea659",
                                                "text": "In youth we encore the sentiment, 'Oh, bless my country, Heaven! he said, and died:' but, as we advance in life, we think, 'How weak it is to pity Cato's case, Who might have lived, and had a handsome place!'"
                                            },
                                            {
                                                "example_id": "556f61fc-0bc2-4986-a2d4-5c792795b17c",
                                                "sense_id": "1efcf4c4-f37a-340b-a1c7-97f283eea659",
                                                "text": "They encored with a cover of the Beatles' “Blackbird,” “The Bigger You Love” in 1970, and “Ha Ha Ha” in early '71."
                                            },
                                            {
                                                "example_id": "bd964394-6213-44df-b481-3ea05a716b6f",
                                                "sense_id": "1efcf4c4-f37a-340b-a1c7-97f283eea659",
                                                "text": "Truly unbelievable. Left us all gasping for breath, and wanting more. I think they encored twice, but twenty encores would have been too few."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
