                    {
                        "sense_id": "88ead97b-1444-30e2-9bce-c2a151fbfbb8",
                        "entry_id": "dd61146b-f976-3f51-90c4-3843000f220b",
                        "glosses": [
                            "Able to be changed in scale; resizeable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8afdc0ba-6a4d-434b-9fee-45b6206591a8",
                                "sense_id": "88ead97b-1444-30e2-9bce-c2a151fbfbb8",
                                "text": "To use one of the ugliest words in the contemporary lexicon, Glasman and his colleagues believe that micro-democracy is scalable: get it right at the local level, and the rest will follow."
                            }
                        ]
                    },
                    {
                        "sense_id": "875cb4e2-aa57-3283-9750-155e3b096d0c",
                        "entry_id": "dd61146b-f976-3f51-90c4-3843000f220b",
                        "glosses": [
                            "Able to greatly increase in capacity, with relative ease."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cec7e7c-bb93-46bc-9304-991a5b1fd8ec",
                                "sense_id": "875cb4e2-aa57-3283-9750-155e3b096d0c",
                                "text": "Most systems have a small host table, but it cannot be used for all applications because it is not scalable and does not have a standard method for automatic distribution."
                            }
                        ]
                    },
                    {
                        "sense_id": "905c61fa-dc8c-3895-a567-3e6fbd8bc639",
                        "entry_id": "dd61146b-f976-3f51-90c4-3843000f220b",
                        "glosses": [
                            "Suitable to provide accurate dimensions to manufacturing staff by being measured and having the measurements multiplied by the scale factor."
                        ],
                        "tags": [
                            "of an engineering drawing or its features"
                        ],
                        "examples": []
                    }
                ],
