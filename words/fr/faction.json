{
    "word_family": [
        "factionnaire",
        "factieux",
        "factionnalisme"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "895a9c36-573d-3cdb-836a-463d3cd33105",
                    "sense_definition": "Groupe de personnes au sein d'un parti ou d'une communauté, luttant pour défendre des opinions divergentes ou prendre le pouvoir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "groupe_politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le parti politique est déchiré par une lutte de <w>factions</w> rivales qui refusent tout compromis."
                        },
                        {
                            "text": "Une <w>faction</w> dissidente tente d'imposer son propre programme avant le vote final de la commission."
                        }
                    ],
                    "synonyms": [
                        "clan",
                        "clique"
                    ],
                    "common_phrases": [
                        "chef de faction",
                        "lutte de factions"
                    ]
                },
                {
                    "sense_id": "f16a0f5f-60e1-3411-a05c-38f3bdea7414",
                    "sense_definition": "Service de surveillance ou tour de garde assuré successivement par des militaires.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "garde_militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deux soldats montent la garde et restent en <w>faction</w> devant la porte du quartier général."
                        },
                        {
                            "text": "Après plusieurs heures sous la pluie, son camarade vient enfin relever sa <w>faction</w> près du pont."
                        }
                    ],
                    "synonyms": [
                        "garde",
                        "guet"
                    ],
                    "common_phrases": [
                        "être en faction",
                        "monter la faction"
                    ]
                },
                {
                    "sense_id": "cec5712c-3b46-3ef7-9bdd-735c2d2bfa7f",
                    "sense_definition": "Fait de se poster quelque part en attendant activement quelqu'un ou quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "garde_militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le détective privé a décidé de rester en <w>faction</w> devant la résidence pour surveiller les allées et venues."
                        },
                        {
                            "text": "Elle s'est mise en <w>faction</w> près de l'entrée principale pour intercepter le directeur dès son arrivée."
                        }
                    ],
                    "synonyms": [
                        "attente",
                        "surveillance"
                    ],
                    "common_phrases": [
                        "rester en faction",
                        "se mettre en faction"
                    ]
                },
                {
                    "sense_id": "6fb14e93-9fdd-3ba1-865b-457de2cf132c",
                    "sense_definition": "Coalition ou regroupement d'intérêts constitué au sein d'une assemblée délibérante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "groupe_politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au sein de cette assemblée, une <w>faction</w> modérée tente de rallier les indécis pour voter le texte."
                        },
                        {
                            "text": "La <w>faction</w> conservatrice s'est fermement opposée à tout assouplissement du règlement intérieur."
                        }
                    ],
                    "synonyms": [
                        "coalition",
                        "tendance"
                    ]
                },
                {
                    "sense_id": "fc758b16-d758-37e0-bbbd-9e88d72f8cde",
                    "sense_definition": "Soldat ou sentinelle chargée de monter la garde.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "garde_militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'officier vérifiait la vigilance de chaque <w>faction</w> postée aux abords de la forteresse médiévale."
                        },
                        {
                            "text": "Dans la pénombre, la <w>faction</w> immobile surveillait le chemin menant aux remparts de la ville."
                        }
                    ],
                    "synonyms": [
                        "factionnaire",
                        "sentinelle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "au sens de garde ou sentinelle"
                        }
                    ]
                }
            ]
        }
    ]
}