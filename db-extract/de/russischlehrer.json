                ],
                "senses": [
                    {
                        "sense_id": "98d29e7f-f28c-3dca-b55a-2c1f23896405",
                        "entry_id": "e8bf4682-1859-3000-8e41-fa63f88e188c",
                        "glosses": [
                            "Professeur de russe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eddf8007-c74c-4936-b2c7-889a6f4c5dea",
                                "sense_id": "98d29e7f-f28c-3dca-b55a-2c1f23896405",
                                "text": "Um sich die Reise zu finanzieren, arbeitet er als Russischlehrer an einer Nachhilfeschule.",
                                "translation": "Pour financer son voyage, il donne des cours de russe [litt. il travaille en tant que professeur de russe] dans une école de soutien."
                            },
                            {
                                "example_id": "15bb0240-8eec-4e8b-9e66-8dc6776590a0",
                                "sense_id": "98d29e7f-f28c-3dca-b55a-2c1f23896405",
                                "text": "Nach 1945 seien dann auch in großer Zahl Deutschlehrer zu Russischlehrern umgeschult worden, eine Entwicklung, die sich nach dem Jahre 1990 wieder in ihr Gegenteil gekehrt habe.",
                                "translation": "Après 1945, des professeurs d’allemand auraient ainsi également été convertis en professeurs de russe en grand nombre, une évolution dont la tendance se serait réinversée après 1990."
                            }
                        ]
                    }
                ],
