                        "glosses": [
                            "истор. уменьш. к деньга, медная монета в полкопейки"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bddaec38-49a7-31c2-8dc4-c629f30ea277",
                        "entry_id": "2aace080-8b63-3e49-a238-859b7095570a",
                        "glosses": [
                            "разг. то же, что монетка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e30878b4-a533-4cca-9ab7-6e31852703ae",
                                "sense_id": "bddaec38-49a7-31c2-8dc4-c629f30ea277",
                                "text": "— Эта штука, брат, для денег. Вот видишь, сюда денежка засовывается."
                            }
                        ]
                    },
                    {
                        "sense_id": "eed2d94d-3dfa-3f6b-a032-9eba405b51b9",
                        "entry_id": "2aace080-8b63-3e49-a238-859b7095570a",
                        "glosses": [
                            "перен., разг. то же, что деньжата"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d609a0ea-3c30-43ef-8329-7d260d9e9998",
                                "sense_id": "eed2d94d-3dfa-3f6b-a032-9eba405b51b9",
                                "text": "Я ведь, маточка, деньги коплю, откладываю; у меня денежка водится."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ca3e25a-3ac1-4f58-874f-1a81218f60d8",
