                "word": "périastre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "283ecf48-f8e4-4da7-bd35-974ab1ac2dbf",
                        "entry_id": "b4c61492-9e23-3cb6-9b7b-3643a555df76",
