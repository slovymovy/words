                                            {
                                                "example_id": "d66b14b2-e288-4ba7-9669-c78ec6a0085b",
                                                "sense_id": "ea6d614c-a62f-3264-9451-6323477ac928",
                                                "text": "De vaargeul was goed afgebakend."
