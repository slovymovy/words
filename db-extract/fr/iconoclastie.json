                "senses": [
                    {
                        "sense_id": "ed556d6d-2ef6-33ff-a899-e2ea165bd996",
                        "entry_id": "48a433ce-2236-32b7-845c-92c6b80f3898",
                        "glosses": [
                            "Iconoclasme, iconoclasie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b915f4d-dc2e-408f-b6da-5495d8344ceb",
                                "sense_id": "ed556d6d-2ef6-33ff-a899-e2ea165bd996",
                                "text": "En 727, le pape Grégoire II refusa d'accepter le décret de l’empereur Léon III qui établissait l’iconoclastie."
                            },
                            {
                                "example_id": "2616e539-8ff1-4784-b729-264e340d57be",
                                "sense_id": "ed556d6d-2ef6-33ff-a899-e2ea165bd996",
                                "text": "Et pour imaginer un nouvel art, il faut briser l’art ancien. Et ainsi l’art nouveau semble une sorte d’iconoclastie.\nCar toute construction est faite de débris, et rien n’est nouveau en ce monde que les formes.\nMais il faut détruire les formes."
                            }
                        ]
                    }
                ],
