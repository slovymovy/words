                "senses": [
                    {
                        "sense_id": "2b0000e6-6959-35fb-b7ec-c75754951e52",
                        "entry_id": "170842f4-055e-3eb5-8723-e0ff190420be",
                        "glosses": [
                            "changing table"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "bc0e72ac-5f3e-437c-957b-fba3ca2ae4e7",
                                "sense_id": "2b0000e6-6959-35fb-b7ec-c75754951e52",
                                "text": "Wickeltische für Babys gibt es jetzt schon in allen Jumbos.",
                                "translation": "Changing tables for babies are already available in all jumbos.",
                                "english": "Changing tables for babies are already available in all jumbos."
                            },
                            {
                                "example_id": "ed1c6de1-8925-45d3-9b7d-a36ad70f1bf8",
                                "sense_id": "2b0000e6-6959-35fb-b7ec-c75754951e52",
                                "text": "Auch die Gestaltung des Kinderhauses haben die Eltern übernommen. Ein Vater hat einen Wickeltisch für die Krabbelgruppe gebaut, eine Mutter hat Bilder an die Wände gemalt, andere haben Gardinen genäht.",
                                "translation": "The parents also took over the design of the children's home. One father has built a changing table for the toddler group, one mother painted pictures on the walls, others sewed curtains.",
                                "english": "The parents also took over the design of the children's home. One father has built a changing table for the toddler group, one mother painted pictures on the walls, others sewed curtains."
                            },
                            {
                                "example_id": "f2b1dd22-aaf7-4831-bec3-faec755c278b",
                                "sense_id": "2b0000e6-6959-35fb-b7ec-c75754951e52",
                                "text": "Väter haben es im US-Bundesstaat New York künftig leichter, wenn sie mit dem Nachwuchs unterwegs sind: Ein neues Gesetz sieht vor, dass Herrentoiletten mit Wickeltischen ausgestattet werden müssen.",
                                "translation": "Fathers in the US state of New York will find it easier in the future if they are out and about with their offspring: A new law stipulates that restrooms for men must be equipped with changing tables.",
                                "english": "Fathers in the US state of New York will find it easier in the future if they are out and about with their offspring: A new law stipulates that restrooms for men must be equipped with changing tables."
                            }
                        ]
                    }
