                        "entry_id": "8e1baba5-2f61-302c-b578-c7687dc0eb64",
                        "glosses": [
                            "Artificial, acting as a substitute for part of the body; relating to prosthesis."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "efd6c44d-2944-484b-aaa3-0a32196c1d75",
                                "sense_id": "d8e35082-5adb-3df7-a478-cd5acd900002",
                                "text": "prosthetic leg/arm"
                            },
                            {
                                "example_id": "bc0725f8-c62c-47f7-ac72-b4def08741e9",
                                "sense_id": "d8e35082-5adb-3df7-a478-cd5acd900002",
                                "text": "Opposite of natural monsters there are technological monsters such as terminators, cyborgs, and robocops—all of which undermine dichotomies between the artificial and the organic, the prosthetic and the natural."
                            }
                        ]
                    },
