                    {
                        "form_id": "e3ce661d-0cf8-4993-a41c-881c57569100",
                        "entry_id": "2e28323b-1392-3bc5-aa2d-eb8fb2fc3539",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "soupçonneuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85c6fcfa-1984-322f-9467-1809fb0cda08",
                        "entry_id": "2e28323b-1392-3bc5-aa2d-eb8fb2fc3539",
                        "glosses": [
                            "Qui est défiant, qui est enclin à soupçonner, qui soupçonne facilement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72dcff8c-4d81-4049-9b9c-feaf0a6d569c",
                                "sense_id": "85c6fcfa-1984-322f-9467-1809fb0cda08",
                                "text": "Un seul amant, c’est ennuyeux,\nC’est monotone et soupçonneux,\nTandis que deux c’est vraiment mieux."
                            },
                            {
                                "example_id": "1b31b7ab-05f8-4d51-a99b-d4159fce7a3b",
                                "sense_id": "85c6fcfa-1984-322f-9467-1809fb0cda08",
                                "text": "Tout son être se révoltait à la pensée d'épouser un de […] ces intendants soupçonneux et méprisants qui venaient parfois rendre visite à son grand-père et la soupesaient des yeux, comme si elle eût été un animal à vendre."
                            },
                            {
                                "example_id": "b4132cef-2664-42c2-a687-4ab557f9d5bc",
                                "sense_id": "85c6fcfa-1984-322f-9467-1809fb0cda08",
                                "text": "— Être d’humeur soupçonneuse, d’un caractère soupçonneux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c11aaae-c248-44cb-a7ba-05af1b755a31",
                        "source_entry_id": "2e28323b-1392-3bc5-aa2d-eb8fb2fc3539",
                        "source_sense_id": "85c6fcfa-1984-322f-9467-1809fb0cda08",
                        "target_lang_word": "argwöhnisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argwöhnisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc9e7871-b07c-3b9c-8235-74a1b7036f40",
                                        "entry_id": "ed7602fb-16b0-30c1-b7da-a69e40e6b5b8",
                                        "glosses": [
                                            "voll Argwohn, zum Verdacht neigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42992301-038d-44e5-a22a-126e7842e0f1",
                                                "sense_id": "fc9e7871-b07c-3b9c-8235-74a1b7036f40",
                                                "text": "Unser Nachbar ist ein argwöhnischer Mensch."
                                            },
                                            {
                                                "example_id": "44f1c6f3-1939-4847-8b13-ca8ca823ea3a",
                                                "sense_id": "fc9e7871-b07c-3b9c-8235-74a1b7036f40",
                                                "text": "Er ist argwöhnisch gegen seinen Schwager."
                                            },
                                            {
                                                "example_id": "d5c5c9a4-5fab-4ade-b376-ce3ac6748a36",
                                                "sense_id": "fc9e7871-b07c-3b9c-8235-74a1b7036f40",
                                                "text": "Sie schaute ihn argwöhnisch an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a17f7a32-fda3-4009-b284-a33405266ed5",
                        "source_entry_id": "2e28323b-1392-3bc5-aa2d-eb8fb2fc3539",
                        "source_sense_id": "85c6fcfa-1984-322f-9467-1809fb0cda08",
                        "target_lang_word": "misstrauisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misstrauisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86d25ef3-84e1-3cc9-8d4e-298fe3c8e31b",
                                        "entry_id": "79cff8a9-c2d0-3e13-b129-8729d0f13b76",
                                        "glosses": [
                                            "jemandem oder etwas nicht trauend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99c27475-2e9e-4e28-8e16-c8305c272c5a",
                                                "sense_id": "86d25ef3-84e1-3cc9-8d4e-298fe3c8e31b",
                                                "text": "Er ist ein misstrauischer Mensch."
                                            },
                                            {
                                                "example_id": "f102dd7e-fa18-4c0d-9363-66b824b86f5c",
                                                "sense_id": "86d25ef3-84e1-3cc9-8d4e-298fe3c8e31b",
                                                "text": "Misstrauisch beäugte der Vogel das angebotene Futter."
                                            },
                                            {
                                                "example_id": "0ea64603-9504-4395-8507-f6a2902b167c",
                                                "sense_id": "86d25ef3-84e1-3cc9-8d4e-298fe3c8e31b",
                                                "text": "„Anna war vor misstrauischen Nachbarn und der Gestapo weiter nur durch die dünne Hülle ihrer Tarnung als Muslimin geschützt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8415315-b422-417e-988f-6c6ff1b2c032",
                        "source_entry_id": "2e28323b-1392-3bc5-aa2d-eb8fb2fc3539",
                        "source_sense_id": "85c6fcfa-1984-322f-9467-1809fb0cda08",
                        "target_lang_word": "suspicious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suspicious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Arousing suspicion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa35fb88-2a10-4050-ac80-f679bdbafeff",
                                                "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                                "text": "His suspicious behaviour brought him to the attention of the police."
                                            },
                                            {
                                                "example_id": "27a8111f-9f4a-4205-9372-e2404ba097b3",
                                                "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                                "text": "If their views were entrancing their sanitation was primeval; if they possessed stables they were also next to the gas-works; if their gardens were delightful there were odours suspicious of mice in the bedrooms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Distrustful or tending to suspect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3193b015-3423-4083-a9da-ef80353812ab",
                                                "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                                "text": "We know he has a suspicious attitude to get-rich-quick schemes."
                                            },
                                            {
                                                "example_id": "dbd8c4d7-ff77-4d72-bdc0-98c2d27eee70",
                                                "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                                "text": "Betraide by fortune and ſuſpitious loue,\nThreatned with frowning wrath and iealouſie,\nSurpriz’d with feare and hideous reuenge,\nI ſtand agaſt: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21af017c-5f19-33cd-8cfd-93039e522500",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Expressing suspicion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6586499-bdf0-4296-a6aa-3e12479378d1",
                                                "sense_id": "21af017c-5f19-33cd-8cfd-93039e522500",
                                                "text": "She gave me a suspicious look."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "949fdece-67df-45ac-950a-beff85b092b8",
                        "source_entry_id": "2e28323b-1392-3bc5-aa2d-eb8fb2fc3539",
