                "senses": [
                    {
                        "sense_id": "0ac13488-277a-3a86-b728-af0471fac278",
                        "entry_id": "02c59892-8ee1-3bbb-9042-988bd39cc982",
                        "glosses": [
                            "Éclore à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2b7a816-f912-45c3-818f-582f8b775443",
                                "sense_id": "0ac13488-277a-3a86-b728-af0471fac278",
                                "text": "En outre, la persécution suscite les martyrs et le courage est contagieux; enfin les faits sur lesquels repose la doctrine incriminée subsistent et sont susceptibles de la faire rééclore dans les âmes pendant et après la persécution."
                            },
                            {
                                "example_id": "88cb8ecb-2d49-4f51-8848-d36252f82362",
                                "sense_id": "0ac13488-277a-3a86-b728-af0471fac278",
                                "text": "Pour ce lieu mythique de la Résistance, où peuvent rééclore les fantasmes d'amour fou, il fera résonner le véritable appel de Juin, celui qui lancera l'assaut contre l'ancienne pyramide sociale."
                            }
                        ]
                    }
