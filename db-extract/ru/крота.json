                "senses": [
                    {
                        "sense_id": "52f0dbcf-1062-303a-84a8-f4dba4fa187b",
                        "entry_id": "cf1db214-7e93-32e4-86ee-e2391f4d5abe",
                        "glosses": [
                            "старинный струнный смычковый инструмент кельтского происхождения, распространённый в XI—XVI вв. в Ирландии и Уэльсе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cda7047-b36b-48c9-8aa0-ec22937751b7",
                                "sense_id": "52f0dbcf-1062-303a-84a8-f4dba4fa187b",
                                "text": "Крота (Chrotta) — один из древнейших европейских смычковых инструментов. О нём говорится уже в двустишии Венанция Фортуната (609): «Romanusque lyra plaudat tibi, Barbarus, harpa Graecus Achilliaca, chrotta Britanna canat»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4f1428f-ad81-4c6e-b27e-5f2e30261b7d",
                        "source_entry_id": "cf1db214-7e93-32e4-86ee-e2391f4d5abe",
                        "source_sense_id": "52f0dbcf-1062-303a-84a8-f4dba4fa187b",
                        "target_lang_word": "crowd",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crowd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "692ed0dc-5e0f-3757-9a8e-1a1c50db9afc",
                                        "entry_id": "217d22c7-cb9f-39df-84d4-fc8ee86ba0da",
                                        "glosses": [
                                            "To press forward; to advance by pushing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7446aba-5cfa-40bb-8052-a8f141aa628b",
                                                "sense_id": "692ed0dc-5e0f-3757-9a8e-1a1c50db9afc",
                                                "text": "The man crowded into the packed room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ef4a096-c34d-3b90-9c67-f51785734d75",
                                        "entry_id": "217d22c7-cb9f-39df-84d4-fc8ee86ba0da",
                                        "glosses": [
                                            "To press together or collect in numbers."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55446406-416e-400b-9b65-2daea61aaab2",
                                                "sense_id": "1ef4a096-c34d-3b90-9c67-f51785734d75",
                                                "text": "They crowded through the archway and into the park."
                                            },
                                            {
                                                "example_id": "d71501bb-8887-44dd-a029-4c5740cd0bca",
                                                "sense_id": "1ef4a096-c34d-3b90-9c67-f51785734d75",
                                                "text": "[T]he whole company closed their ranks, and crowded about the fire."
                                            },
                                            {
                                                "example_id": "5ae57e16-ab89-46ac-a95b-d4770046ef2d",
                                                "sense_id": "1ef4a096-c34d-3b90-9c67-f51785734d75",
                                                "text": "Images came crowding on his mind faster than he could put them into words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b4a1784-f4a5-35dc-ac47-64a22472af02",
                                        "entry_id": "217d22c7-cb9f-39df-84d4-fc8ee86ba0da",
                                        "glosses": [
                                            "To press or drive together, especially into a small space; to cram."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a668904-477a-46e9-90ce-5b8dccd1b82e",
                                                "sense_id": "8b4a1784-f4a5-35dc-ac47-64a22472af02",
                                                "text": "He tried to crowd too many cows into the cow-pen."
                                            },
                                            {
                                                "example_id": "96826c33-02b2-4838-822e-f5a85d8d3e88",
                                                "sense_id": "8b4a1784-f4a5-35dc-ac47-64a22472af02",
                                                "text": "[…]The Time (miſ-order’d) doth in common ſence / Crowd vs, and cruſh vs, to this monſtrous Forme, / To hold our ſafetie vp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7c27e7e-0d58-333e-b259-50138e9d72ab",
                                        "entry_id": "217d22c7-cb9f-39df-84d4-fc8ee86ba0da",
                                        "glosses": [
                                            "To fill by pressing or thronging together"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9641935f-8a2a-4511-9c16-d610780f05be",
                                                "sense_id": "b7c27e7e-0d58-333e-b259-50138e9d72ab",
                                                "text": "The balconies and verandas were crowded with spectators, anxious to behold their future sovereign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "228a0a23-8ade-36bc-adfb-f216a997e8dc",
                                        "entry_id": "217d22c7-cb9f-39df-84d4-fc8ee86ba0da",
                                        "glosses": [
                                            "To push, to press, to shove."
                                        ],
                                        "tags": [
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "798710c4-e1a3-4232-9dc6-f15dceaaabe1",
                                                "sense_id": "228a0a23-8ade-36bc-adfb-f216a997e8dc",
                                                "text": "They tried to crowd her off the sidewalk."
                                            },
                                            {
                                                "example_id": "514eb5b2-b497-412e-9e24-6b56b77fdd58",
                                                "sense_id": "228a0a23-8ade-36bc-adfb-f216a997e8dc",
                                                "text": "Alexis's mementos and numerous dance trophies were starting to crowd her out of her little bedroom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4beadd4-a72d-31ba-a3fd-945f8cdc1b64",
                                        "entry_id": "217d22c7-cb9f-39df-84d4-fc8ee86ba0da",
                                        "glosses": [
                                            "To approach another ship too closely when it has right of way."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1dc704e-19d9-3540-bffb-bf2b0b7733e5",
                                        "entry_id": "217d22c7-cb9f-39df-84d4-fc8ee86ba0da",
                                        "glosses": [
                                            "To carry excessive sail in the hope of moving faster."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a7e5603-12ab-46ed-b4df-513ae35bc2cc",
                                                "sense_id": "a1dc704e-19d9-3540-bffb-bf2b0b7733e5",
                                                "text": "With all her might she crowds all sail off shore; in so doing, fights ’gainst the very winds that fain would blow her homeward; seeks all the lashed sea’s landlessness again; for refuge’s sake forlornly rushing into peril; her only friend her bitterest foe!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8128405-35ba-355c-a1b3-18f96533db15",
                                        "entry_id": "217d22c7-cb9f-39df-84d4-fc8ee86ba0da",
                                        "glosses": [
                                            "To press by solicitation; to urge; to dun; hence, to treat discourteously or unreasonably."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crowd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90cd2b53-6c0c-3848-b5eb-49fb660ab581",
                                        "entry_id": "19ea824c-5b43-3747-ac51-f9e206e7ca26",
                                        "glosses": [
                                            "A group of people congregated or collected into a close body without order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f0c4567-06fb-490a-b771-e22f48af43ab",
                                                "sense_id": "90cd2b53-6c0c-3848-b5eb-49fb660ab581",
                                                "text": "After the movie let out, a crowd of people pushed through the exit doors."
                                            },
                                            {
                                                "example_id": "2e2d6c50-6534-4f6f-a551-0e2936180dcf",
                                                "sense_id": "90cd2b53-6c0c-3848-b5eb-49fb660ab581",
                                                "text": "Athelstan Arundel walked home[…], foaming and raging. […] He walked the whole way, walking through crowds, and under the noses of dray-horses, carriage-horses, and cart-horses, without taking the least notice of them."
                                            },
                                            {
                                                "example_id": "6a3e49b3-f9a7-4617-9155-881cb8203985",
                                                "sense_id": "90cd2b53-6c0c-3848-b5eb-49fb660ab581",
                                                "text": "He tried to persuade Cicely to stay away from the ball-room for a fourth dance.[…]But she said she must go back, and when they joined the crowd again[…]she found her mother standing up before the seat on which she had sat all the evening searching anxiously for her with her eyes, and her father by her side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "609a789d-35c0-3c49-88dd-9ff6eef36e93",
                                        "entry_id": "19ea824c-5b43-3747-ac51-f9e206e7ca26",
                                        "glosses": [
                                            "Several things collected or closely pressed together; also, some things adjacent to each other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4846a24-b1f3-4053-a0e1-0adc4ccdbd3f",
                                                "sense_id": "609a789d-35c0-3c49-88dd-9ff6eef36e93",
                                                "text": "There was a crowd of toys pushed beneath the couch where the children were playing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13ff622e-50e1-32ea-a920-a4c37318889e",
                                        "entry_id": "19ea824c-5b43-3747-ac51-f9e206e7ca26",
                                        "glosses": [
                                            "The so-called lower orders of people; the populace; the vulgar."
                                        ],
                                        "tags": [
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c30ac2e4-dde8-484c-9561-c2d66d27c0a5",
                                                "sense_id": "13ff622e-50e1-32ea-a920-a4c37318889e",
                                                "text": "He went not, with the Crowd, to ſee a Shrine;"
                                            },
                                            {
                                                "example_id": "58c253e0-6bde-41be-b7ea-bf2bab8fd430",
                                                "sense_id": "13ff622e-50e1-32ea-a920-a4c37318889e",
                                                "text": "[…]To fool the crowd with glorious lies,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f7d79e2-eebb-3a54-b60c-269a3a27392b",
                                        "entry_id": "19ea824c-5b43-3747-ac51-f9e206e7ca26",
                                        "glosses": [
                                            "A group of people united or at least characterised by a common interest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ae4363-be72-4aaa-9e76-973286b2a82f",
                                                "sense_id": "1f7d79e2-eebb-3a54-b60c-269a3a27392b",
                                                "text": "That obscure author's fans were a nerdy crowd which hardly ever interacted before the Internet age."
                                            },
                                            {
                                                "example_id": "cd9a2781-e9e1-4ce4-b91a-8604580f47ed",
                                                "sense_id": "1f7d79e2-eebb-3a54-b60c-269a3a27392b",
                                                "text": "We're concerned that our daughter has fallen in with a bad crowd."
                                            },
                                            {
                                                "example_id": "ca967d87-8bc8-4a38-bc7e-5b5a1670ee6a",
                                                "sense_id": "1f7d79e2-eebb-3a54-b60c-269a3a27392b",
                                                "text": "Maybe it was time I joined the crowd and bought a few of those for my own office."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crowd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6acca00e-037a-30a2-a606-8c3ef22abef2",
                                        "entry_id": "67a387b1-a72b-37ce-aa60-5e9c1cae7af4",
                                        "glosses": [
                                            "Alternative form of crwth."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
