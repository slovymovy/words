                "senses": [
                    {
                        "sense_id": "f169ce17-8776-3e9c-bbd5-4ea6703fb8ee",
                        "entry_id": "52bcab8a-53bb-37ce-96fb-ad60ae1c5374",
                        "glosses": [
                            "psychische Störung, bei der Migranten aufgrund von psychischen Belastungen an Stress, Depressionen, Nervosität, Schlaflosigkeit und Realitätsverlust leiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99fa5f66-665f-4126-aa1c-16162a8ebcbb",
                                "sense_id": "f169ce17-8776-3e9c-bbd5-4ea6703fb8ee",
                                "text": "Dieser ist bekannt für seine Erfolge beim sogenannten Ulysses-Syndrom, einer Depression, die Migrant*innen [sic] oft aufgrund der Belastung während ihrer Fluchterfahrung erleiden."
                            },
                            {
                                "example_id": "01fef18c-ed2d-4fbc-97b1-c6a04557255b",
                                "sense_id": "f169ce17-8776-3e9c-bbd5-4ea6703fb8ee",
                                "text": "Menschen mit Ulysses-Syndrom sind ständig in einem Zustand der Spannung, die oft Ursache für Schlaflosigkeit, Appetitlosigkeit, unter andere Symptome ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "80935d92-0186-3d7e-af93-2221525d5c23",
                        "entry_id": "52bcab8a-53bb-37ce-96fb-ad60ae1c5374",
                        "glosses": [
                            "psychische Störung, bei welcher der Kranke wegen eines falschen Befundes oder einer unklaren Diagnose eine Irrfahrt von Arzt zu Arzt durchführt, beziehungsweise eine Behandlung nach der anderen erfährt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50476e1a-99d2-407c-9ccc-4f05f9ccefd9",
                                "sense_id": "80935d92-0186-3d7e-af93-2221525d5c23",
                                "text": "Sie sind nach dem Kanadier Rang, der das Ulysses-Syndrom 1972 beschrieben hat, die Folge von 1. unnötigen Untersuchungen wie Massenscreening, Versicherungs-Untersuchungen, übereifrigen und kritiklosen Ärzten […]"
                            },
                            {
                                "example_id": "08be5488-08b3-4d83-a0cc-3942cc301816",
                                "sense_id": "80935d92-0186-3d7e-af93-2221525d5c23",
                                "text": "Als Odysseus- oder engl. Ulysses-Syndrom bezeichnet man Zustände, bei denen der Kranke wegen eines falschen Befundes oder einer unklaren Diagnose eine Irrfahrt von Arzt zu Arzt durchführt bzw eine Behandlung nach der anderen erfährt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1554e5de-e619-3155-b2cd-cbb1c65436da",
                        "entry_id": "52bcab8a-53bb-37ce-96fb-ad60ae1c5374",
                        "glosses": [
                            "psychische Störung, bei der ein Patient eine irreversible Selbstbindung vornimmt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7ff41c7-8c03-419f-b93a-d0a062c8e34a",
                                "sense_id": "1554e5de-e619-3155-b2cd-cbb1c65436da",
                                "text": "Situationen, bei denen eine irreversible Selbstbindung vorgenommen wird, werden als Odysseus-Syndrom bezeichnet."
                            },
                            {
                                "example_id": "2f90255e-e2ed-466c-a08b-7af0ced48f58",
                                "sense_id": "1554e5de-e619-3155-b2cd-cbb1c65436da",
                                "text": "Die krankhafte Überzeugung, dass eine nahestehende Person verstorben sei, obwohl diese tatsächlich noch lebt, heißt Odysseus-Syndrom."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
