                "senses": [
                    {
                        "sense_id": "af64d212-d7f9-3762-807c-65d8d8ef9865",
                        "entry_id": "cfb0107e-4bd5-3470-8b9b-15ee83c17dfe",
                        "glosses": [
                            "Répétition inutile ou fastidieuse d’une chose qu’on a déjà dite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca37bd7f-4fe8-4cf0-b8ee-af99fe62d8d0",
                                "sense_id": "af64d212-d7f9-3762-807c-65d8d8ef9865",
                                "text": "On ne peut, sans redite oiseuse, parler encore de sa « mécanique »."
                            },
                            {
                                "example_id": "e8eebe0e-b79d-4e17-adbc-3ac08bbd2ecc",
                                "sense_id": "af64d212-d7f9-3762-807c-65d8d8ef9865",
                                "text": "Ce ne sont que redites."
                            },
                            {
                                "example_id": "252a3237-f73e-4842-a941-1544cbf79934",
                                "sense_id": "af64d212-d7f9-3762-807c-65d8d8ef9865",
                                "text": "Tomber dans d’éternelles redites."
                            },
                            {
                                "example_id": "b2985c59-abae-4eef-af42-abed5facd3eb",
                                "sense_id": "af64d212-d7f9-3762-807c-65d8d8ef9865",
                                "text": "Il faut éviter les redites."
                            },
                            {
                                "example_id": "9692f037-b738-469f-8c00-2733ab9b6589",
                                "sense_id": "af64d212-d7f9-3762-807c-65d8d8ef9865",
                                "text": "C’est alors que commence le chant des sirènes. Où sont les bras de Nishio-san ? Je pourrais lui téléphoner. Mais mon japonais est devenu si pauvre qu’il me condamne aux redites affadissantes."
                            }
                        ]
                    },
                    {
                        "sense_id": "97df9529-9e61-3b96-9957-50187b831632",
                        "entry_id": "cfb0107e-4bd5-3470-8b9b-15ee83c17dfe",
                        "glosses": [
                            "Répétition inutile ou fastidieuse d’une chose qu’on a déjà dite.",
                            "Répétition inutile ou fastidieuse d’une chose."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "65d2eaf8-b0cb-4268-aa15-2c10fcff4a52",
                                "sense_id": "97df9529-9e61-3b96-9957-50187b831632",
                                "text": "Ce jeu vidéo sans originalité aucune constitue une véritable redite par rapport aux opus précédents de la série."
                            },
                            {
                                "example_id": "98f8b966-1a2b-4c7f-abb5-c67c3127c885",
                                "sense_id": "97df9529-9e61-3b96-9957-50187b831632",
                                "text": "La firme craint évidemment une redite des campagnes du Brexit ou présidentielles 2016 aux États-Unis."
                            }
                        ]
                    }
