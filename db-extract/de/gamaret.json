                "senses": [
                    {
                        "sense_id": "20f01e62-6f59-373d-8dd3-4bdee4a9bbed",
                        "entry_id": "4395d39b-2fd5-3fc3-be0c-c6addae71374",
                        "glosses": [
                            "eine neugezüchtete rote Rebsorte der Eidgenössischen Forschungsanstalt für Pflanzenbau Agroscope in Pully"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13291c99-9475-4f77-b0d9-47d374913378",
                                "sense_id": "20f01e62-6f59-373d-8dd3-4bdee4a9bbed",
                                "text": "Dank der sehr hohen Resistenz gegen Grauschimmelfäule (Botrytis cinerea) und einer frühen Reife erfreut sich der Gamaret großer Beliebtheit bei den Produzenten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f6265265-3acb-3e6f-bd6b-52839eb88970",
                        "entry_id": "4395d39b-2fd5-3fc3-be0c-c6addae71374",
                        "glosses": [
                            "ein Wein, der aus Trauben von [1] hergestellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a007788-4960-4647-b134-6315b538dcd9",
                                "sense_id": "f6265265-3acb-3e6f-bd6b-52839eb88970",
                                "text": "„Schweinefleisch kann wunderbar mit üppigeren Weinen gepaart werden. Spare Ribs vom Grill oder Kotelett harmoniert mit Malbec, Gamaret oder gar einem Syrah.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
