                        "examples": [
                            {
                                "example_id": "b69bb735-edc6-4cb8-94bc-3ea57552bc1f",
                                "sense_id": "11d340e0-0ef2-3fa9-972c-1961ea8ed614",
                                "text": "Enige kilometers voor de kust komen we tot stilstand. De bemanningsleden gebruiken een zogenoemde hydrofoon – een onder water werkend luisterapparaat – om dolfijnen en walvissen te spotten."
                            },
                            {
                                "example_id": "9842205e-4880-48c8-9f15-1bafe09d1b25",
                                "sense_id": "11d340e0-0ef2-3fa9-972c-1961ea8ed614",
                                "text": "Rijkswaterstaat heeft ten westen van Texel het eerste Nederlandse meetstation te water gelaten. Het meetstation bestaat uit een meetboei met daaraan een onderwatermicrofoon (hydrofoon) en opname-apparatuur. De boei is 30 kilometer uit de kust afgezonken en door een drijver komt de hydrofoon een paar meter boven de bodem te hangen. De hydrofoon meet een maand alle geluiden in het water. Daarna wordt de opnameapparatuur opgehaald om te worden uitgelezen."
                            }
                        ]
