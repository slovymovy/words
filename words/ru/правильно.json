{
    "word_family": [
        "правильный",
        "правило",
        "правильность",
        "неправильный",
        "исправить",
        "поправить",
        "править",
        "управление"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ea915411-0321-36b7-9c3a-676f505108d0",
                    "sense_definition": "Так, как следует; верно, без ошибок, должным образом.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ученик <w>правильно</w> решил сложную задачу по математике.",
                            "target_lang_translations": {
                                "en": "The student solved the complex math problem <w>correctly</w>.",
                                "zh": "学生<w>正确</w>地解出了那道复杂的数学题。"
                            }
                        },
                        {
                            "text": "Вы <w>правильно</w> поняли мой вопрос с первого раза.",
                            "target_lang_translations": {
                                "en": "You understood my question <w>correctly</w> the first time.",
                                "zh": "你第一次就<w>正确</w>地理解了我的问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "верно",
                        "корректно",
                        "грамотно"
                    ],
                    "antonyms": [
                        "неправильно"
                    ],
                    "common_phrases": [
                        "правильно понять",
                        "правильно сделать",
                        "правильно ответить",
                        "писать правильно"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that is accurate, without errors, or as required.",
                        "zh": "以准确、无误或符合要求的方式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "correctly",
                                "target_lang_sense_clarification": "accurate or without error"
                            },
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "informal, often used in spoken language"
                            },
                            {
                                "target_lang_word": "properly",
                                "target_lang_sense_clarification": "in the correct or appropriate manner"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正确地",
                                "target_lang_sense_clarification": "准确或无误地"
                            },
                            {
                                "target_lang_word": "对",
                                "target_lang_sense_clarification": "口语中常用的表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8474e6ef-4317-3016-9122-d668f0a4580d",
                    "sense_definition": "Оценка ситуации или действия как верных, справедливых или соответствующих нормам.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "predicative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Было бы <w>правильно</w> позвонить родителям и предупредить их.",
                            "target_lang_translations": {
                                "en": "It would be <w>right</w> to call your parents and warn them.",
                                "zh": "给父母打个电话通知他们是<w>对</w>的。"
                            }
                        },
                        {
                            "text": "Ты поступил <w>правильно</w>, когда сказал правду.",
                            "target_lang_translations": {
                                "en": "You acted <w>correctly</w> when you told the truth.",
                                "zh": "你说出真相，这样做很<w>对</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "верно",
                        "справедливо"
                    ],
                    "antonyms": [
                        "неправильно"
                    ],
                    "common_phrases": [
                        "это правильно",
                        "абсолютно правильно",
                        "поступить правильно",
                        "сделать правильно"
                    ],
                    "target_lang_definitions": {
                        "en": "Assessing a situation or action as fair, just, or appropriate.",
                        "zh": "评价某种情况或行为是公正、合理或恰当的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "morally or situationally appropriate"
                            },
                            {
                                "target_lang_word": "correctly",
                                "target_lang_sense_clarification": "in accordance with rules or propriety"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对",
                                "target_lang_sense_clarification": "道德上或情境上合适"
                            },
                            {
                                "target_lang_word": "正确",
                                "target_lang_sense_clarification": "符合规范或道理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07a38f4c-006f-3744-a589-d9a1586a973e",
                    "sense_definition": "Возглас, выражающий согласие с собеседником или подтверждение сказанного.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Нам нужно поторопиться, чтобы успеть на поезд. — <w>Правильно</w>!",
                            "target_lang_translations": {
                                "en": "— We need to hurry to catch the train. — <w>Right</w>!",
                                "zh": "— 我们得快点，不然赶不上火车了。— <w>没错</w>！"
                            }
                        },
                        {
                            "text": "— Это лучший выход из сложившейся ситуации. — <w>Правильно</w>, я согласен.",
                            "target_lang_translations": {
                                "en": "— This is the best way out of the situation. — <w>That's right</w>, I agree.",
                                "zh": "— 这是目前情况下最好的解决办法。— <w>对</w>，我同意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "верно",
                        "и то верно",
                        "точно"
                    ],
                    "common_phrases": [
                        "совершенно правильно"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An exclamation expressing agreement or confirmation.",
                        "zh": "表示同意或确认对方所说内容的感叹词。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "expressing agreement"
                            },
                            {
                                "target_lang_word": "that's right",
                                "target_lang_sense_clarification": "confirming a statement"
                            },
                            {
                                "target_lang_word": "correct",
                                "target_lang_sense_clarification": "formal confirmation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对",
                                "target_lang_sense_clarification": "表示同意"
                            },
                            {
                                "target_lang_word": "没错",
                                "target_lang_sense_clarification": "确认对方的陈述"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d6e0feda-d5b8-3182-be9a-a1ef7435ae76",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>правильный</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ваше утверждение абсолютно <w>правильно</w> и не требует доказательств.",
                            "target_lang_translations": {
                                "en": "Your statement is absolutely <w>correct</w> and requires no proof.",
                                "zh": "你的陈述完全<w>正确</w>，无需证明。"
                            }
                        },
                        {
                            "text": "Это решение <w>правильно</w> с точки зрения действующего закона.",
                            "target_lang_translations": {
                                "en": "This decision is <w>correct</w> from the point of view of the current law.",
                                "zh": "从现行法律的角度来看，这个决定是<w>正确</w>的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the adjective meaning accurate, true, or conforming to rules.",
                        "zh": "形容词“正确的”的短形式，表示准确、真实或符合规则。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "correct",
                                "target_lang_sense_clarification": "factually accurate"
                            },
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "just or true"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正确",
                                "target_lang_sense_clarification": "事实准确"
                            },
                            {
                                "target_lang_word": "对",
                                "target_lang_sense_clarification": "公正或真实"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}