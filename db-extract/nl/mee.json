                        "translation_id": "aeff1ec6-37d3-4ec5-a7e0-e3abd518e656",
                        "source_entry_id": "5176acf9-a7b0-32a7-b5e8-e58553737c9a",
                        "source_sense_id": "cf03db11-0804-3882-92e1-b92b29078ab8",
