                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ea4cd55-d1a7-495d-a487-2d596ba744d8",
                                                "sense_id": "ebdfa334-6009-3b34-bf27-35c74357ba93",
                                                "text": "George Orwell's novel 1984 proposed that people's thoughts could be constrained by the redefinition of words in their language."
                                            },
                                            {
                                                "example_id": "81ac925d-7762-4e60-9d9a-45f7af76f4bc",
                                                "sense_id": "ebdfa334-6009-3b34-bf27-35c74357ba93",
                                                "text": "Although the value of the kilogram will not change, the redefinition of the kilogram using a constant will ensure it remains reliable, and enable far more accurate mass measurements in the future."
                                            }
                                        ]
                                    }
                                ]
