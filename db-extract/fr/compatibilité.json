        "fr-extract.jsonl": [
            {
                "entry_id": "20d62015-90b6-3689-8945-f25defc07337",
                "word": "compatibilité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bf2fc8f5-2280-4e0a-be1e-76c0e2763474",
                        "entry_id": "20d62015-90b6-3689-8945-f25defc07337",
                        "tags": [
                            "plural"
                        ],
                        "form": "compatibilités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91b974eb-bed9-3747-800a-3a24d1d49a27",
                        "entry_id": "20d62015-90b6-3689-8945-f25defc07337",
                        "glosses": [
                            "Qualité de ce qui est compatible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b11f6bd-ffe2-4b18-9101-daee36678d92",
                                "sense_id": "91b974eb-bed9-3747-800a-3a24d1d49a27",
                                "text": "Il y a une grande compatibilité d’humeur entre ces deux personnes."
                            },
                            {
                                "example_id": "bdf6c882-806d-4fe0-8423-dbfb0193dade",
                                "sense_id": "91b974eb-bed9-3747-800a-3a24d1d49a27",
                                "text": "Il n’y a pas compatibilité entre ces deux fonctions."
                            },
                            {
                                "example_id": "0830513a-8606-4fea-97c6-1ef3afa562b5",
                                "sense_id": "91b974eb-bed9-3747-800a-3a24d1d49a27",
                                "text": "La deuxième possibilité conduit à supposer que les firmes peuvent avoir intérêt à développer la compatibilité de leurs technologies ou de leurs produits."
                            },
                            {
                                "example_id": "ef729ec4-460e-462b-96cd-e6652e97f4ec",
                                "sense_id": "91b974eb-bed9-3747-800a-3a24d1d49a27",
                                "text": "Compatibilité des logiciels informatiques."
                            },
                            {
                                "example_id": "cbc26606-732e-42ed-83e1-fa3e3e2ccff5",
                                "sense_id": "91b974eb-bed9-3747-800a-3a24d1d49a27",
                                "text": "[…] un rapport de compatibilité, tel qu’il est notamment pratiqué en matière d’urbanisme, tolère un écart avec la norme de référence, du moment qu’elle ne s’en trouve pas remise en cause, tandis qu’un rapport de conformité exige une adéquation parfaite […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "57bba5de-7075-3f4e-a2f5-426746807cc9",
                        "entry_id": "20d62015-90b6-3689-8945-f25defc07337",
                        "glosses": [
                            "Capacité de deux plasmides à coexister de façon stable à l’intérieur d'un hôte commun."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9ca610f-f74f-4fbe-a43c-e3f263f69f13",
                        "source_entry_id": "20d62015-90b6-3689-8945-f25defc07337",
                        "target_lang_word": "Kompatibilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kompatibilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b3a44e7-7445-39c2-9f12-82e1d69485e6",
                                        "entry_id": "8ae90ea4-18a7-3c96-bb9d-7d9cb911256a",
                                        "glosses": [
                                            "die Eigenschaft kompatibel zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8945dd49-f8a1-4e89-a866-0c01bf027219",
                                                "sense_id": "2b3a44e7-7445-39c2-9f12-82e1d69485e6",
                                                "text": "Bevor man die Bauteile in den Computer einbaut, sollte man auf deren Kompatibilität achten."
                                            },
                                            {
                                                "example_id": "de0dba87-1b73-44a0-b621-94a6415868cc",
                                                "sense_id": "2b3a44e7-7445-39c2-9f12-82e1d69485e6",
                                                "text": "„Allerdings ist das so eine Sache mit der Kompatibilität von Sehnsucht und Realität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f10e37d-0ae9-3287-b5b2-f6d7e733d5c9",
                                        "entry_id": "8ae90ea4-18a7-3c96-bb9d-7d9cb911256a",
                                        "glosses": [
                                            "Verträglichkeit, Kombinierbarkeit sprachlicher Elemente im Satz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c843ee15-745c-4a88-b1f0-bdbcb74a9ae0",
                                                "sense_id": "3f10e37d-0ae9-3287-b5b2-f6d7e733d5c9",
                                                "text": "„Auf semantischen Merkmalen als bedeutungskonstitutiven Elementen beruhen Kompatibilität oder Inkompatibilität lexikalischer Einheiten.“"
                                            },
                                            {
                                                "example_id": "15e001d2-59d7-40dd-afb1-9c68657d4b3a",
                                                "sense_id": "3f10e37d-0ae9-3287-b5b2-f6d7e733d5c9",
                                                "text": "„Die Kompatibilität, die in den soeben genannten Forschungsrichtungen als eine primär semantische Erscheinung gewertet wurde, muß auf der Ausdrucksseite der Sprache eine irgendwie geartete Entsprechung haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31cea3fe-36a7-407e-8759-0afad103c8af",
                        "source_entry_id": "20d62015-90b6-3689-8945-f25defc07337",
                        "target_lang_word": "compatibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compatibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cdf9bee-894d-3c2a-a51f-019e5b88d837",
                                        "entry_id": "b5cddaf9-ca97-305c-86d0-854e03951b17",
                                        "glosses": [
                                            "The state of being compatible; in which two or more things are able to exist or work together in combination without problems or conflict."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1769cd0-a806-4e8a-a9a6-082f3c9f72d7",
                                                "sense_id": "9cdf9bee-894d-3c2a-a51f-019e5b88d837",
                                                "text": "One huge self-inflicted wound the industry is now suffering from is the lack of coupling compatibility. Up to the 1980s virtually everything had compatible drawgear on a given route, so there was every chance of pushing a failed train out of the way. Since privatisation, compatibility has been lost and in the last few years operators seem to have gone out of their way to avoid compatibility."
                                            },
                                            {
                                                "example_id": "9e83d0b9-ab64-40e8-85d7-c391069b4516",
                                                "sense_id": "9cdf9bee-894d-3c2a-a51f-019e5b88d837",
                                                "text": "They will feature wider gangways for better wheelchair accessibility, as well as compatibility with platform screen doors - should these ever be introduced in the future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785b7a41-df05-3c09-9a36-cc3b8bf0889e",
                                        "entry_id": "b5cddaf9-ca97-305c-86d0-854e03951b17",
                                        "glosses": [
                                            "the capability of two or more items or components of equipment or material to exist or function in the same system or environment without mutual interference."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfe37068-e6e2-3d0f-851d-37f3bda1dc41",
                                        "entry_id": "b5cddaf9-ca97-305c-86d0-854e03951b17",
                                        "glosses": [
                                            "the ability to execute a given program on different types of computers without modification of the program or the computers. See backward compatibility and forward compatibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef86dd91-8774-3ea4-be12-0ae4157ffe82",
                                        "entry_id": "b5cddaf9-ca97-305c-86d0-854e03951b17",
                                        "glosses": [
                                            "the capability that allows the substitution of one subsystem (storage facility), or of one functional unit (e.g., hardware, software), for the originally designated system or functional unit in a relatively transparent manner, without loss of information and without the introduction of errors."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87c945b1-f7c1-3b3c-907b-605330f90e3e",
                                        "entry_id": "b5cddaf9-ca97-305c-86d0-854e03951b17",
                                        "glosses": [
                                            "the continuity or good fit of material or members or components while being deformed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
