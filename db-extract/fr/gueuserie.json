                "entry_id": "96b61667-feee-3f67-b430-c665d1d66d10",
                "word": "gueuserie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "eb466374-159f-4081-a11f-96649019c05b",
                        "entry_id": "96b61667-feee-3f67-b430-c665d1d66d10",
                        "tags": [
