                                    {
                                        "sense_id": "6496b63c-fd32-352d-82a1-b1d566510f9c",
                                        "entry_id": "144334f8-2423-35a0-9a72-136893255d10",
                                        "glosses": [
                                            "A dog from a group of small, lively breeds, originally bred for the hunting of burrowing prey such as rats, rabbits, foxes, and even otters; this original function is reflected in some of their names (e.g. rat terrier)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0741c9db-6b43-33fb-bba3-a5725046ee5d",
                                        "entry_id": "144334f8-2423-35a0-9a72-136893255d10",
                                        "glosses": [
                                            "Someone displaying terrier-like qualities such as determined pursuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f2a06dc-2659-4bcb-ad78-d962968c3537",
                                                "sense_id": "0741c9db-6b43-33fb-bba3-a5725046ee5d",
                                                "text": "One of the LNER dispatch staff is a terrier when it comes to masks, challenging anyone without them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "terrier",
