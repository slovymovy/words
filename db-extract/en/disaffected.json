                    },
                    {
                        "form_id": "66becf17-1c4b-4d07-be97-7a3c74f8b19c",
                        "entry_id": "5436f922-a321-3e01-acc0-970499a51f01",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most disaffected"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "719b7172-7037-31d4-812c-2b4e7fc316b4",
                        "entry_id": "5436f922-a321-3e01-acc0-970499a51f01",
                        "glosses": [
                            "Alienated or estranged, often with hostile effect; rebellious, resentful; disloyal; malcontent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0603973-dae5-4f9d-831f-efcbc8b7cfba",
                                "sense_id": "719b7172-7037-31d4-812c-2b4e7fc316b4",
                                "text": "The main reason for this state of affairs is probably that, for the exceptionally able man who accepts the present order of society, a multitude of other avenues to influence and power are open, while to the disaffected and dissatisfied an intellectual career is the most promising path to both influence and the power to contribute to the achievement of his ideals."
                            },
                            {
                                "example_id": "3e717b14-87ec-4005-b207-e7bd3b054f9c",
                                "sense_id": "719b7172-7037-31d4-812c-2b4e7fc316b4",
                                "text": "Joe Biden is making a clear attempt to appeal to disaffected Republicans and independent voters in the final weeks of the election, promising he’d be a president that would work hard not just for those who support him, but also for those who do not."
                            }
                        ]
                    },
                    {
                        "sense_id": "02cc6033-7a71-35ba-97fe-75373eedfc5a",
                        "entry_id": "5436f922-a321-3e01-acc0-970499a51f01",
                        "glosses": [
                            "Affected with disease."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
