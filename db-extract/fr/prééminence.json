                                        "sense_id": "d98288b1-f112-3bfa-b1ff-c0a8fdaf7152",
                                        "entry_id": "277a2a49-eadc-3ac1-a3dc-676d96f79ca1",
                                        "glosses": [
                                            "Rare spelling of preeminence."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1038e532-804b-4b47-838e-cda84d8eb7a1",
                                                "sense_id": "d98288b1-f112-3bfa-b1ff-c0a8fdaf7152",
                                                "text": "When the minister and his wife entered their new home, a great assembly of both parties gathered, and all the ladies struggled for preëminence in the delicious cates and viands they brought."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f653cc8-c249-429a-b040-c3b59587522c",
                        "source_entry_id": "c2112eff-1c83-3f98-b2dc-77eb60bc5a85",
                        "source_sense_id": "2bbd3761-87f5-3471-8350-01f6f43ca985",
                        "target_lang_word": "pre-eminence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pre-eminence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41ec08ba-3f0a-305b-9f38-48c60cbc493e",
                                        "entry_id": "5620f848-cc9e-3544-b3af-e59914808dce",
                                        "glosses": [
                                            "Alternative spelling of preeminence."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d7b601c-7b7b-449d-b4e7-9e1f5578d08b",
                                                "sense_id": "41ec08ba-3f0a-305b-9f38-48c60cbc493e",
                                                "text": "And being always with her, and always talking confidentially, and his feelings exactly in that favourable state which a recent disappointment gives, those soft light eyes could not be very long in obtaining the pre-eminence."
                                            },
                                            {
                                                "example_id": "79339d94-787f-4956-a60d-f20ba199e1ed",
                                                "sense_id": "41ec08ba-3f0a-305b-9f38-48c60cbc493e",
                                                "text": "While the Deutsche Bundesbahn has not reattained the pre-eminence in European railway speed that the German railways enjoyed before the 1939-1945 war, speeds in that country are steadily moving upwards [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
