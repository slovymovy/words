                    {
                        "form_id": "a9abc952-0326-4e3c-81b4-f31785236dcf",
                        "entry_id": "cfd3769e-f3b0-329e-9582-cbd2951cb53d",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "présomptueuses"
