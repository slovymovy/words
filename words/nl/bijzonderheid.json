{
    "word_family": [
        "bijzonder",
        "bijzonderlijk",
        "bijzonderen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "010f2cb4-f3d8-3d28-9f13-35a19c3d075c",
                    "sense_definition": "een klein onderdeel van een groter geheel dat specifiek of interessant is",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "informatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de bijlage van het rapport vind je meer <w>bijzonderheden</w> over de resultaten van het onderzoek.",
                            "target_lang_translations": {
                                "en": "In the appendix of the report, you will find more <w>details</w> about the results of the study."
                            }
                        },
                        {
                            "text": "De gids vertelde ons veel interessante <w>bijzonderheden</w> over de geschiedenis van dit oude kasteel.",
                            "target_lang_translations": {
                                "en": "The guide told us many interesting <w>particulars</w> about the history of this old castle."
                            }
                        }
                    ],
                    "synonyms": [
                        "detail",
                        "specificatie"
                    ],
                    "antonyms": [
                        "hoofdlijn"
                    ],
                    "common_phrases": [
                        "nadere bijzonderheden",
                        "voor meer bijzonderheden"
                    ],
                    "target_lang_definitions": {
                        "en": "a small part of a larger whole that is specific or interesting"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "detail",
                                "target_lang_sense_clarification": "an individual feature or fact"
                            },
                            {
                                "target_lang_word": "particular",
                                "target_lang_sense_clarification": "a specific item or detail"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06993261-2a92-3b5a-9eb0-5218dc43fbf6",
                    "sense_definition": "de eigenschap van het uniek, speciaal of ongewoon zijn",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>bijzonderheid</w> van dit schilderij ligt in het unieke gebruik van licht en schaduw.",
                            "target_lang_translations": {
                                "en": "The <w>uniqueness</w> of this painting lies in the unique use of light and shadow."
                            }
                        },
                        {
                            "text": "Zij waardeerden de <w>bijzonderheid</w> van het moment en bleven even stil staan.",
                            "target_lang_translations": {
                                "en": "They appreciated the <w>specialness</w> of the moment and stood still for a while."
                            }
                        }
                    ],
                    "synonyms": [
                        "uniekheid",
                        "apartheid"
                    ],
                    "antonyms": [
                        "gewoonheid",
                        "normaliteit"
                    ],
                    "target_lang_definitions": {
                        "en": "the quality of being unique, special, or unusual"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uniqueness",
                                "target_lang_sense_clarification": "the state of being the only one of its kind"
                            },
                            {
                                "target_lang_word": "specialness",
                                "target_lang_sense_clarification": "the quality of being exceptional"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f262705-462a-3364-ab9f-09a7919f06d9",
                    "sense_definition": "een kenmerkende of opvallende eigenschap die iets onderscheidt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een geografische <w>bijzonderheid</w> van dit land is dat het grotendeels onder de zeespiegel ligt.",
                            "target_lang_translations": {
                                "en": "A geographical <w>peculiarity</w> of this country is that it lies largely below sea level."
                            }
                        },
                        {
                            "text": "De architect wees op een architectonische <w>bijzonderheid</w> die typisch is voor deze regio.",
                            "target_lang_translations": {
                                "en": "The architect pointed out an architectural <w>feature</w> that is typical for this region."
                            }
                        }
                    ],
                    "synonyms": [
                        "kenmerk",
                        "eigenaardigheid"
                    ],
                    "common_phrases": [
                        "geografische bijzonderheid"
                    ],
                    "target_lang_definitions": {
                        "en": "a characteristic or striking feature that distinguishes something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peculiarity",
                                "target_lang_sense_clarification": "a strange or unusual feature"
                            },
                            {
                                "target_lang_word": "characteristic",
                                "target_lang_sense_clarification": "a distinguishing feature"
                            },
                            {
                                "target_lang_word": "feature",
                                "target_lang_sense_clarification": "a prominent or distinctive part"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "466631b4-b9ab-3ece-b801-2854f5085566",
                    "sense_definition": "een uitzonderlijke of opmerkelijke omstandigheid",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gebeurtenis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een grote <w>bijzonderheid</w> dat de koning persoonlijk bij de opening aanwezig was.",
                            "target_lang_translations": {
                                "en": "It was a great <w>rarity</w> that the king was personally present at the opening."
                            }
                        },
                        {
                            "text": "Zulke weersomstandigheden zijn in deze tijd van het jaar een echte <w>bijzonderheid</w>.",
                            "target_lang_translations": {
                                "en": "Such weather conditions are a real <w>exception</w> at this time of year."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitzondering",
                        "zeldzaamheid"
                    ],
                    "antonyms": [
                        "regelmaat"
                    ],
                    "target_lang_definitions": {
                        "en": "an exceptional or remarkable circumstance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rarity",
                                "target_lang_sense_clarification": "something that is very uncommon"
                            },
                            {
                                "target_lang_word": "exception",
                                "target_lang_sense_clarification": "something that does not follow the rule"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}