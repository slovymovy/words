                "senses": [
                    {
                        "sense_id": "0996df10-0ee1-33eb-9510-341c26bf0a0f",
                        "entry_id": "b7397a05-1ab2-31c5-bc37-6c390d7b2ae9",
                        "glosses": [
                            "Donner un caractère rappelant Bangkok à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b030e5c9-ed67-473a-a3c0-53ec542e1934",
                                "sense_id": "0996df10-0ee1-33eb-9510-341c26bf0a0f",
                                "text": "Paris va se \"bangkokiser\" c'est bien ce que j'ai écrit cette semaine, les projets vont dans ce sens."
                            },
                            {
                                "example_id": "58e85cf7-ae58-4bb6-9ff0-4cdcae75d03a",
                                "sense_id": "0996df10-0ee1-33eb-9510-341c26bf0a0f",
                                "text": "Tu parles si je suis « sabaï dee » lorsque j’arrive dans mon refuge, loin de la circulation, de la pollution de Chiang Mai en train de se « bangkokiser »."
                            },
                            {
                                "example_id": "6a784f99-4d59-421c-8108-dea327113686",
                                "sense_id": "0996df10-0ee1-33eb-9510-341c26bf0a0f",
                                "text": "Avec un développement aussi vertical qu'horizontal, on peut même dire qu'elle se 'bangkokise' gaillardement, attirant de plus en plus de gros investisseurs."
                            }
                        ]
                    }
