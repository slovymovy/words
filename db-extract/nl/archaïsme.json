                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29574804-17a4-4ff2-b7a0-a45d16f5c42e",
                                                "sense_id": "859a84bc-747e-3251-becd-fecc19fbe7a2",
                                                "text": "In this text, the word \"methinks\" appears to be a deliberate archaism."
                                            },
                                            {
                                                "example_id": "978e9405-351e-4f13-a194-24f1b12acf21",
                                                "sense_id": "859a84bc-747e-3251-becd-fecc19fbe7a2",
                                                "text": "He had the fastidiousness, the preciosity, the love of archaisms, of your true decadent."
