                    {
                        "sense_id": "ffef6ff3-7167-31e2-a284-2e9099076f63",
                        "entry_id": "25e9f83b-4dfb-35f0-9179-04d41d6559ac",
                        "glosses": [
                            "To cause (someone) to be anxious; to worry."
                        ],
                        "tags": [
                            "dialectal",
                            "nonstandard",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e340a5dd-4edd-4d05-8ed8-e173b660c43b",
                                "sense_id": "ffef6ff3-7167-31e2-a284-2e9099076f63",
                                "text": "“Yes; don't worrit your poor mother,” said Mrs. Sanders. “She's quite enough to worrit her, as it is, without you, Tommy,” said Mrs. Cluppins, with sympathising resignation."
                            },
                            {
                                "example_id": "d5460a1b-e02f-401a-aeb9-c34d1da45293",
                                "sense_id": "ffef6ff3-7167-31e2-a284-2e9099076f63",
                                "text": "'Och, it's you, is it, Mr Kilmartin? Wherever have ye been? The young lady was fair worrit to death when ye didna come home.'"
                            },
                            {
                                "example_id": "53197be3-4ba5-4dae-bcde-7e85444c4bf7",
                                "sense_id": "ffef6ff3-7167-31e2-a284-2e9099076f63",
                                "text": "I dinna wish to worrit myself about ye running off to the nunnery or wi' another man."
                            }
                        ]
                    },
                    {
                        "sense_id": "caf1f498-a5af-3819-a226-b0e94d9292ea",
                        "entry_id": "25e9f83b-4dfb-35f0-9179-04d41d6559ac",
                        "glosses": [
                            "To be anxious; to worry."
                        ],
                        "tags": [
                            "dialectal",
                            "intransitive",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "3e41ae29-5fa4-4645-a573-85c950139bee",
                                "sense_id": "caf1f498-a5af-3819-a226-b0e94d9292ea",
                                "text": "Well Sir, would you believe it, there’s that in Mr Pontifex’s face which is just like young Watkins; he looks that worrited and scrunched up at times, but it’s never for the same reason, […]"
                            },
                            {
                                "example_id": "d3f95959-2746-4d11-9fd0-a42f476b1950",
                                "sense_id": "caf1f498-a5af-3819-a226-b0e94d9292ea",
                                "text": "I'd best be turning for home. Mrs. Maggot will be worriting with the night getting thick."
                            }
                        ]
                    }
