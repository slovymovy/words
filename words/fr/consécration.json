                    "frequency": "Low",
                    "semantic_group_id": "légitimation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle loi apporte enfin la <w>consécration</w> juridique d'un droit longtemps réclamé."
