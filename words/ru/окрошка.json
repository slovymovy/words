                    "sense_id": "fa429a2d-5f51-3298-97c0-0cece6814f00",
                    "sense_definition": "Традиционный русский холодный суп на квасе или кефире с мелко нарезанными овощами, зеленью и мясом.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "кулинария",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В жаркий летний день мы с удовольствием приготовили холодную <w>окрошку</w> на квасе.",
                            "target_lang_translations": {
                                "en": "On a hot summer day, we gladly made cold <w>okroshka</w> with kvass."
                            }
                        },
                        {
                            "text": "Летом в меню многих ресторанов традиционно появляется мясная <w>окрошка</w> со свежей зеленью.",
                            "target_lang_translations": {
                                "en": "In summer, meat <w>okroshka</w> with fresh herbs traditionally appears on the menu of many restaurants."
                            }
                        }
                    ],
                    "common_phrases": [
                        "окрошка на квасе",
                        "окрошка на кефире",
                        "холодная окрошка",
                        "приготовить окрошку"
                    ],
                    "target_lang_definitions": {
                        "en": "A traditional Russian cold soup based on kvass or kefir with finely chopped vegetables, herbs, and meat."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "okroshka",
                                "target_lang_sense_clarification": "cold vegetable and meat soup"
                            },
                            {
                                "target_lang_word": "cold soup",
                                "target_lang_sense_clarification": "general descriptive term"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1b20529-8595-351f-b47e-8897dfc518e8",
                    "sense_definition": "Беспорядочная смесь, механическое соединение разнородных мыслей, фактов или элементов.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "смесь",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В голове у студента перед сложным экзаменом образовалась полная <w>окрошка</w> из разных формул и понятий.",
                            "target_lang_translations": {
                                "en": "Before the difficult exam, a complete <w>jumble</w> of different formulas and concepts formed in the student's head."
                            }
                        },
                        {
                            "text": "Его новая статья представляла собой бессмысленную <w>окрошку</w> из чужих идей и случайных цитат.",
                            "target_lang_translations": {
                                "en": "His new article was a meaningless <w>mishmash</w> of other people's ideas and random quotes."
                            }
                        }
                    ],
                    "synonyms": [
                        "эклектика",
                        "солянка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "переносное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A chaotic mixture, mishmash, or mechanical jumble of diverse thoughts, facts, or elements."
                    },
                    "translations": {
