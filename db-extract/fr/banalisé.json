                    {
                        "sense_id": "f4f98b13-1687-348a-bfb5-2ed5d388f26b",
                        "entry_id": "c0fa14f2-d0b0-3775-bafa-ca900fdf865c",
                        "glosses": [
                            "Se dit d’un objet, souvent un véhicule, utilisé sans marques indiquant son lien avec la police, afin de ne pas être repéré par des tiers, par exemple des personnes surveillées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4c6d2e7-e96f-403b-973d-1dab27368495",
                                "sense_id": "f4f98b13-1687-348a-bfb5-2ed5d388f26b",
                                "text": "D’après les hommes en planque dans la voiture banalisée en bas de l’immeuble, le suspect n’a pas vu M. Durand de la semaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "e782f3e4-6068-32da-8308-476e06723808",
                        "entry_id": "c0fa14f2-d0b0-3775-bafa-ca900fdf865c",
                        "glosses": [
                            "Se dit d’une journée travaillée par les professeurs, mais chômée par les élèves."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "49dc50ff-bbf5-3122-96f0-775706d7b2fc",
                        "entry_id": "c0fa14f2-d0b0-3775-bafa-ca900fdf865c",
                        "glosses": [
                            "Courant, commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78a9a575-4e0f-4d06-a488-4a505f0548bb",
                                "sense_id": "49dc50ff-bbf5-3122-96f0-775706d7b2fc",
                                "text": "Le racisme le plus banalisé au Canada, c’est celui du Canada anglais envers les Québécois francophones."
                            }
                        ]
                    }
