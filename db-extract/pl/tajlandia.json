                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dae792d5-23ea-43f9-b55d-aa76d2fd8566",
                                                "sense_id": "25d95279-2539-321e-afc3-5ae8b1cf4ebe",
                                                "text": "Wir fliegen im Urlaub nach Thailand."
                                            },
                                            {
                                                "example_id": "1d2aa895-c6c4-47cb-997a-1f6f3d974509",
                                                "sense_id": "25d95279-2539-321e-afc3-5ae8b1cf4ebe",
                                                "text": "Bangkok ist die Hauptstadt von Thailand."
                                            },
                                            {
                                                "example_id": "c21f1898-bd27-4c9a-9c9f-aa2f64d10308",
                                                "sense_id": "25d95279-2539-321e-afc3-5ae8b1cf4ebe",
                                                "text": "Opa erzählt gern Geschichten von dem Thailand der 50er Jahre."
                                            },
                                            {
                                                "example_id": "930d0dbf-d125-44cd-9428-888ab0b2b39e",
                                                "sense_id": "25d95279-2539-321e-afc3-5ae8b1cf4ebe",
                                                "text": "„Zwei Monate nach den schweren Unruhen in Thailand hat eine Bombenexplosion in der Hauptstadt Bangkok eine wichtige Nachwahl überschattet.“"
                                            },
                                            {
                                                "example_id": "0e13dba9-b12b-4353-8cb6-1b30caa10eac",
                                                "sense_id": "25d95279-2539-321e-afc3-5ae8b1cf4ebe",
                                                "text": "„Das Territorium Thailands nimmt einen beträchtlichen Teil der Landfläche Südostasiens ein und erstreckt sich südöstlich der letzten Ausläufer des Himalaya bis auf die Malaiische Halbinsel und umschließt dabei den Golf von Thailand, ein Randmeer des Südchinesischen Meeres.“"
                                            }
                                        ],
