                        "glosses": [
                            "Overgrown with ivy or another climbing plant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2992af4b-32be-4f5a-b7b5-5b1681601796",
                                "sense_id": "fdfdd477-c00e-3e3e-b844-170b20933b25",
                                "text": "[…] Lancelot Carnaby stopped from his rash venture into the water, and drew himself back into an ivied bush, which served as the finial of the little garden-hedge."
                            },
                            {
                                "example_id": "1c5543a8-bd99-4c22-a0ba-883b4a1731cb",
                                "sense_id": "fdfdd477-c00e-3e3e-b844-170b20933b25",
                                "text": "But he was broodingly unable to see even the most ivied tower as anything but a pile of stones till, inexplicably, the miracle of recovered hope and courage transformed him."
                            },
                            {
                                "example_id": "8a57a374-6231-4e86-bc57-c599b9ccb7b4",
                                "sense_id": "fdfdd477-c00e-3e3e-b844-170b20933b25",
                                "text": "Even a place as innocent and unsqualid as the ivied Wesleyan University in Connecticut provokes contempt[…]"
                            },
                            {
                                "example_id": "2a0be883-7c4c-4388-b981-047220b39fb3",
                                "sense_id": "fdfdd477-c00e-3e3e-b844-170b20933b25",
                                "text": "[…] great glossy-leaved mango trees ivied with pepper vines […]"
                            }
                        ]
                    }
