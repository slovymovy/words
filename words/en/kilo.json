    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50d22ba8-3d7e-38b0-b2c0-85e3c7a05e75",
                    "sense_definition": "A short form of <w>kilogram</w>, a unit of mass equal to one thousand grams.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like to buy a <w>kilo</w> of fresh apples from the local market.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел купить <w>килограмм</w> свежих яблок на местном рынке."
                            }
                        },
                        {
                            "text": "The recipe requires exactly one <w>kilo</w> of flour to make the large cake.",
                            "target_lang_translations": {
                                "ru": "Для приготовления этого большого торта по рецепту требуется ровно один <w>килограмм</w> муки."
                            }
                        }
                    ],
                    "synonyms": [
                        "kilogram"
                    ],
                    "common_phrases": [
                        "one kilo",
                        "per kilo",
                        "half a kilo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма слова килограмм, единица массы, равная одной тысяче граммов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кило",
                                "target_lang_sense_clarification": "разговорное сокращение от килограмм"
                            },
                            {
                                "target_lang_word": "килограмм",
                                "target_lang_sense_clarification": "полная форма единицы веса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e78ab85-93bb-3dca-9818-b7c1176f6625",
                    "sense_definition": "The word used to represent the letter K in the NATO phonetic alphabet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "phonetic_alphabet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot confirmed the coordinates by spelling them out, starting with <w>Kilo</w>.",
                            "target_lang_translations": {
                                "ru": "Пилот подтвердил координаты, продиктовав их по буквам, начиная с «<w>Кило</w>»."
                            }
                        },
                        {
                            "text": "In radio communications, the letter K is always referred to as <w>Kilo</w> to avoid confusion.",
                            "target_lang_translations": {
                                "ru": "В радиосвязи буква K всегда обозначается как «<w>Кило</w>», чтобы избежать путаницы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, используемое для обозначения буквы K в фонетическом алфавите НАТО."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кило",
                                "target_lang_sense_clarification": "кодовое слово для буквы K"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}