                    ],
                    "common_phrases": [
                        "advies geven",
                        "lessen geven"
                    ],
                    "target_lang_definitions": {
                        "en": "to offer something as a suggestion or lesson",
                        "ru": "предлагать что-либо в качестве совета или урока"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "give",
                                "target_lang_sense_clarification": "to provide advice or lessons"
                            },
                            {
                                "target_lang_word": "offer",
                                "target_lang_sense_clarification": "to present for consideration"
                            },
                            {
                                "target_lang_word": "share",
                                "target_lang_sense_clarification": "to tell others about experiences"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "давать",
                                "target_lang_sense_clarification": "предоставлять советы или уроки"
                            },
                            {
                                "target_lang_word": "делиться",
                                "target_lang_sense_clarification": "рассказывать об опыте"
                            },
                            {
