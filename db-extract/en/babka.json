                                                "sense_id": "beda7ba7-c594-3346-8a2e-6b85cb799add",
                                                "text": "Ale fajna babka idzie chodnikiem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "5f8f4b97-74c3-3c5f-b601-51da80b7bf29",
                                        "entry_id": "57d35a10-27de-3423-87e5-269a941321a5",
                                        "glosses": [
                                            "słodkie ciasto pieczone w formie prostokątnej lub mającej kształt ściętego stożka"
                                        ],
                                        "tags": [
                                            "cuk."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b45cd18e-b783-4d44-8c32-2eb89d26a3e5",
                                                "sense_id": "5f8f4b97-74c3-3c5f-b601-51da80b7bf29",
                                                "text": "Upiekłam babkę dla gości."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "769b9725-d7ef-368c-9b1f-5f189e5bebe4",
                                        "entry_id": "57d35a10-27de-3423-87e5-269a941321a5",
                                        "glosses": [
                                            "zob. babka z piasku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc999cd2-3002-4429-bda0-4e36a7281b74",
                                                "sense_id": "769b9725-d7ef-368c-9b1f-5f189e5bebe4",
                                                "text": "Ten piasek jest świetny. Babki, które stawialiśmy, są niezwykle foremne."
                                            }
                                        ],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "b020ca17-1a40-3d0d-8762-36e0669b3d9c",
                                        "entry_id": "57d35a10-27de-3423-87e5-269a941321a5",
                                        "glosses": [
                                            "Plantago, rodzaj roślin z rodziny babkowatych"
                                        ],
                                        "tags": [],
