                ],
                "translations": [
                    {
                        "translation_id": "8da190e2-8be9-470a-b303-d4d153b636b8",
                        "source_entry_id": "80db5ea0-ad7c-398d-8416-2394f7230abb",
                        "source_sense_description": "строить заново или иначе",
                        "target_lang_word": "rebuild",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rebuild",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e40adec1-be66-3d3b-bb56-4d57a8d18bb5",
                                        "entry_id": "ac1c032b-1c82-3f13-a9a8-7633446b57f0",
                                        "glosses": [
                                            "To build again or anew."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06a8b649-91ec-43dc-b96b-0e7da1023266",
                                                "sense_id": "e40adec1-be66-3d3b-bb56-4d57a8d18bb5",
                                                "text": "The economics of rebuilding all the stations covered by the electrification would be prohibitive, but to help bring home to the Glasgow public that their North Clyde suburban service has been transformed, not merely re-equipped with new trains, stations have at least been associated psychologically with the rolling stock by a common colour scheme."
                                            },
                                            {
                                                "example_id": "402a5e3c-ed33-4c12-819d-a0a867a6ebb2",
                                                "sense_id": "e40adec1-be66-3d3b-bb56-4d57a8d18bb5",
                                                "text": "We cannot forget the hurts and pain which have been dealt by the two opposing forces, but we must seek to heal the wounds and go forward. Are we going to allow the wounds to fester until we die, or are we big enough, collectively and individually, to write it off as a bad experience and begin to rebuild?"
                                            },
                                            {
                                                "example_id": "32c0c2b9-9a74-47b4-b828-45327f1b73fb",
                                                "sense_id": "e40adec1-be66-3d3b-bb56-4d57a8d18bb5",
                                                "text": "“Even after this utter devastation, most people in the Greenwood community, most African Americans in Tulsa said to themselves and to their larger community, ‘we shall not be moved.’ And they rebounded and rebuilt and created an incarnation of Black Wall Street that would surpass its initial version.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b3b5efd-d076-32fa-8892-4d68f7e6c861",
                                        "entry_id": "ac1c032b-1c82-3f13-a9a8-7633446b57f0",
                                        "glosses": [
                                            "To attempt to improve one's performance during a period of struggling."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f754e8a-0ebe-4989-85cd-3de0fd2c36c3",
                                                "sense_id": "9b3b5efd-d076-32fa-8892-4d68f7e6c861",
                                                "text": "After missing the playoffs for the seventh straight season in a row, the Detroit Red Wings are trying to rebuild."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rebuild",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "120e6e9d-103d-3256-a9af-333f0c133669",
                                        "entry_id": "29bc4592-b056-3525-834d-a105f7e5d5b0",
                                        "glosses": [
                                            "A process or result of rebuilding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17334b61-aa2f-407e-8cf2-fa6703db12cf",
                                                "sense_id": "120e6e9d-103d-3256-a9af-333f0c133669",
                                                "text": "Although the new features of the rebuilds were mainly the application of successful standard principles, the retention of the outside admission cylinders with their necessary high-pressure valve rod glands, of which the Southern lacked previous experience with an engine of this size, caused some unexpected teething troubles."
                                            },
                                            {
                                                "example_id": "430ce671-f426-415a-a907-9e1f6bd328a5",
                                                "sense_id": "120e6e9d-103d-3256-a9af-333f0c133669",
                                                "text": "Doc's spirits lifted at the suggestion that Cochrane was already thinking about painting the finished rebuild."
                                            },
                                            {
                                                "example_id": "b943e660-d4df-471c-9a19-5dc6a65d3a35",
                                                "sense_id": "120e6e9d-103d-3256-a9af-333f0c133669",
                                                "text": "The cost of the rebuild can quickly escalate with significant crankshaft and bearing work, and some folks allow the cost to keep them from doing the work, even when it is warranted."
                                            },
                                            {
                                                "example_id": "aff67277-f218-48dc-aafb-254e371e54b3",
                                                "sense_id": "120e6e9d-103d-3256-a9af-333f0c133669",
                                                "text": "Torque Fasteners — Illustrates a fastener that must be properly tightened with a torque wrench at this point in the rebuild."
                                            },
                                            {
                                                "example_id": "eae2a63c-55f3-4db0-b96e-d7936abf322c",
                                                "sense_id": "120e6e9d-103d-3256-a9af-333f0c133669",
                                                "text": "Lovingly restored and exquisitely maintained, the great frigate is docked at Boston and open to the public. She is still in commission and crewed by members of the U.S. Navy. After a number of rebuilds and modifications, the frigate Constellation is now anchored in Baltimore Harbor as a museum."
                                            },
                                            {
                                                "example_id": "96833f74-715d-434c-8804-b64ba9ca332f",
                                                "sense_id": "120e6e9d-103d-3256-a9af-333f0c133669",
                                                "text": "Approval has been granted for a £545 million rebuild of Paris Gare du Nord, despite fierce opposition. [...] Initially rejected in June 2019, the rebuild is intended to meet an expected increase in passenger numbers to 800,000 per day by 2023 and 900,000 by 2024."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a89a051e-9a95-3998-8916-7a809fd249ec",
                                        "entry_id": "29bc4592-b056-3525-834d-a105f7e5d5b0",
                                        "glosses": [
                                            "(said of sports teams) A period during which an attempt is made to improve during a period of struggling."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "739dfa17-725a-4097-86fa-80c075d18280",
                                                "sense_id": "a89a051e-9a95-3998-8916-7a809fd249ec",
                                                "text": "Since they failed to make it to the playoffs after five consecutive seasons, the team has gone through a lengthy rebuild."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98ba90e9-1f8c-4e00-a496-924788875583",
                        "source_entry_id": "80db5ea0-ad7c-398d-8416-2394f7230abb",
                        "source_sense_description": "строить заново или иначе",
                        "target_lang_word": "reconstruct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reconstruct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ede096ae-1556-385f-acc7-64f13d0ce0bb",
                                        "entry_id": "61f61865-5462-3a60-9712-d4e222259378",
                                        "glosses": [
                                            "To construct again; to restore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6df9a42-28be-4ffc-9e09-fcefabfbe4ef",
                                                "sense_id": "ede096ae-1556-385f-acc7-64f13d0ce0bb",
                                                "text": "As it was necessary to reconstruct the culvert close to the original position, the hazards of tunnelling through clay in an unstable condition, due to the absorption of water, had to be reduced by the application of electro-osmosis to dry out the material."
                                            },
                                            {
                                                "example_id": "ecb78333-8326-4436-9038-14ace2eeeb45",
                                                "sense_id": "ede096ae-1556-385f-acc7-64f13d0ce0bb",
                                                "text": "[...] after the original Victorian station was demolished and then entombed in concrete in the 1960s, Birmingham New Street became a byword for the worst excesses of the much-loathed Brutalist architecture so widely used to reconstruct inner-city post-war Britain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "547e422b-3890-3a4b-8b37-f27ef603cf7a",
                                        "entry_id": "61f61865-5462-3a60-9712-d4e222259378",
                                        "glosses": [
                                            "To attempt to understand an event by recreating or talking through the circumstances."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
