                        "glosses": [
                            "Couche ou partie du cortex cérébral d’origine la plus ancienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f515cd2-56df-4939-86d6-81f8c53f7cbd",
                                "sense_id": "2fc82a46-a23e-39a6-9a22-55f44ceb7b9f",
                                "text": "Le cortex du bulbe olfactif fait partie du paléocortex."
                            },
                            {
                                "example_id": "b1c1eb64-9d98-463d-ade1-4f238eb967df",
                                "sense_id": "2fc82a46-a23e-39a6-9a22-55f44ceb7b9f",
                                "text": "Cette partie du cerveau va continuer de se développer chez les mammifères, repoussant l’allocortex, constitué du paléocortex et de l’archicortex, dans le système limbique."
                            }
                        ]
                    }
