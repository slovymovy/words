                "senses": [
                    {
                        "sense_id": "87c19d38-8796-303c-8d69-a4744c1cb220",
                        "entry_id": "488b4cd0-5102-3662-ae2e-4e4ca91e36a6",
                        "glosses": [
                            "der Amtsdiener, der Gerichtsdiener; auch der Rangniedere bei einem Amt"
                        ],
                        "tags": [
                            "Alemannic",
                            "Swabian",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "a248a80d-f6d7-4cb5-ba24-864e6204f771",
                                "sense_id": "87c19d38-8796-303c-8d69-a4744c1cb220",
                                "text": "Der Weibel brachte die Schriftstücke vorbei."
                            },
                            {
                                "example_id": "40c51527-1898-4ba7-bb3f-00ce04e919a6",
                                "sense_id": "87c19d38-8796-303c-8d69-a4744c1cb220",
                                "text": "„Wu Djän-én warf sich auf sein Antlitz so vernehmlich, als ob man Knoblauch stampfte, während der Großkanzler eine dritte Bestallungsurkunde ergriff, Lai-bau's Namen einfügte und ihn zum Weibel beim Lehnsfürsten von Streiterstadt in der Provinz Schantung machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
