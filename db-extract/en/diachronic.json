                    },
                    {
                        "translation_id": "8d6934bc-030b-4eac-89ea-ec002d36855c",
                        "source_entry_id": "1b421445-a079-3da4-8435-966865af0029",
                        "source_sense_description": "changing with time",
                        "target_lang_word": "diachronique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diachronique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f7554ed-7a9a-3028-b9e8-e452b14d4fee",
                                        "entry_id": "8921aa5f-f996-3cd7-994c-d59d9583dd38",
                                        "glosses": [
                                            "Qui est relatif à la diachronie, à l’évolution d’un fait dans le temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe27690a-557a-4b84-997f-b763208cc74e",
                                                "sense_id": "8f7554ed-7a9a-3028-b9e8-e452b14d4fee",
                                                "text": "Du point de vue diachronique, il faudrait analyser la vie des parémies retenues depuis le Moyen Âge jusqu'à nos jours, afin de découvrir l'évolution morphosyntaxique des parémies et de déterminer leur utilisation."
                                            },
                                            {
                                                "example_id": "46d7d3f8-f1a7-4f38-8591-66d7f2579329",
                                                "sense_id": "8f7554ed-7a9a-3028-b9e8-e452b14d4fee",
                                                "text": "L'origine onomatopéique d'un lexème est une question diachronique, sans pertinence en tant que telle pour la sémantique de la parole : ainsi, il n'est pas fondamental pour nous de trancher parmi les nombreux cas qui peuvent faire débats (quid de gong, flaque, grogner, grommeler, siffler, claquer, vrombir... ?)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8b77f32-1d60-4e35-9733-4522ec43957e",
                        "source_entry_id": "1b421445-a079-3da4-8435-966865af0029",
                        "source_sense_description": "changing with time",
                        "target_lang_word": "diachronisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diachronisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43f04717-e86b-396d-8fc2-940871d59a22",
                                        "entry_id": "02dc768b-3cc8-3b7a-b70a-5accabe66d05",
                                        "glosses": [
                                            "die Sprachgeschichte (Diachronie) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfd2674c-19e8-45c0-b4db-6e7fa580a42d",
                                                "sense_id": "43f04717-e86b-396d-8fc2-940871d59a22",
                                                "text": "„Außer in der graphischen Gestalt ihrer Elemente unterscheiden sich die beiden Systeme: diachronisch durch ihre Entstehung und synchronisch durch die Funktionen, die sie in schriftlichen Texten haben.“"
                                            },
                                            {
                                                "example_id": "74020acf-6b60-43df-a465-5f4ec922013f",
                                                "sense_id": "43f04717-e86b-396d-8fc2-940871d59a22",
                                                "text": "„Auch die dynamisch-geschichtliche Sprachentwicklung, die diachronische Achse, ist zu berücksichtigen.“"
                                            },
                                            {
                                                "example_id": "22d8843e-bb3a-4e48-a65a-12a03b050034",
                                                "sense_id": "43f04717-e86b-396d-8fc2-940871d59a22",
                                                "text": "„Onomasiologie und Semasiologie untersuchen die lexikalischen Einheiten und Beziehungen sowohl unter synchronischem als auch unter diachronischem Aspekt, also sowohl den Zustand als auch die Veränderungen des Systems der Benennungen und der Wortbedeutungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5cb2959-a238-3e50-a73a-5bba54553e28",
                                        "entry_id": "02dc768b-3cc8-3b7a-b70a-5accabe66d05",
                                        "glosses": [
                                            "geschichtlich, historisch dokumentiert"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e522fe8-ff57-4a49-8061-76f68a30a0c7",
                                                "sense_id": "d5cb2959-a238-3e50-a73a-5bba54553e28",
                                                "text": "„Wenn man Entwicklung als existentielle Metapher im Sinne eines Nicht-Mehr-Zurückkönnens (diachronisch) auffaßt, so ist dem Movement im gewandelten Verstehen von Participatory Democracy eben solches widerfahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
