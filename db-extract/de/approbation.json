                    {
                        "form_id": "ec9a5092-716f-4e89-bed0-0c41dcb9e2df",
                        "entry_id": "bb911375-71d6-3144-b9ee-2ba4c5f8c1a6",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Approbation"
                    },
                    {
                        "form_id": "d970b383-6493-4b37-a81f-b19ac8cc6773",
                        "entry_id": "bb911375-71d6-3144-b9ee-2ba4c5f8c1a6",
                        "tags": [
                            "accusative",
