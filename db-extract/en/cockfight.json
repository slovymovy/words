                                        "sense_id": "499b7ba7-64d9-3cc8-90c4-f62167e40f4d",
                                        "entry_id": "0466a68f-99f7-3f42-ac4c-b066591a3eb5",
                                        "glosses": [
                                            "語義1のために用いる鶏。春の季語。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6e661c4-f231-4181-866f-4ef57a8b5b26",
                                                "sense_id": "499b7ba7-64d9-3cc8-90c4-f62167e40f4d",
                                                "text": "闘鶏の眼つむれて飼はれけり"
                                            },
                                            {
                                                "example_id": "062d0ff9-3c43-4630-909f-8b85c15c5c58",
                                                "sense_id": "499b7ba7-64d9-3cc8-90c4-f62167e40f4d",
                                                "text": "二人は羽がい締めにされた闘鶏のように、また人々の腕の中で怒り立った。"
                                            }
                                        ]
                                    }
                                ]
                            }
