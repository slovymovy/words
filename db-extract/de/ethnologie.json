                                "example_id": "43652f29-99e7-46c0-8a98-330050cc8a2d",
                                "sense_id": "af9ef932-841b-3d1c-85c9-919bff4105d9",
                                "text": "Die Ethnologie ist ein äußerst interessantes Studienfach."
                            }
