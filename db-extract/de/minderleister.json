                "translations": [
                    {
                        "translation_id": "d9cd7961-ac4e-4909-8f95-175c965cb1c5",
                        "source_entry_id": "8f8d0a34-9bf8-3d8e-9955-3887bf975341",
                        "source_sense_id": "559ec4b5-281b-3e6f-9c95-8d0144cf9aed",
                        "target_lang_word": "underachiever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "underachiever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4d2006b-1b13-3274-bdba-6e71af37f371",
                                        "entry_id": "99e221e7-39ee-37bd-aba1-65c43670daf5",
                                        "glosses": [
                                            "One who underachieves, i.e. performs less well than expected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49ece40b-5dc4-4b7e-8882-4d5c3540e764",
                                                "sense_id": "c4d2006b-1b13-3274-bdba-6e71af37f371",
                                                "text": "Woody Allen has provided what is probably the best theological answer to the problem of evil: God is not evil; He is just an underachiever."
                                            },
                                            {
                                                "example_id": "bf5452ef-e44e-4062-a56f-d65fcc66ed96",
                                                "sense_id": "c4d2006b-1b13-3274-bdba-6e71af37f371",
                                                "text": "Bart: (reading his permanent record) \"Underachiever and proud of it.\" How old is this thing?"
                                            },
                                            {
                                                "example_id": "4c649146-57f2-4c4c-a5f3-ff9c8d5495b6",
                                                "sense_id": "c4d2006b-1b13-3274-bdba-6e71af37f371",
                                                "text": "For the TLC undertaking, he employs only underachievers, cronies who have been hired for their ability to make the work site madcap and, therefore, filmable."
                                            },
                                            {
                                                "example_id": "d8a3c739-fa73-471f-91fb-39d7c09e8aeb",
                                                "sense_id": "c4d2006b-1b13-3274-bdba-6e71af37f371",
                                                "text": "This unsung, underrated, under-appreciated / The one them underachievers had underestimated / Finally graduated, I'm one of the most hated"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
