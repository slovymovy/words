                "senses": [
                    {
                        "sense_id": "34b92658-e03c-390a-a047-3f9cf8263bb2",
                        "entry_id": "0d59f5fd-696e-39e7-90dc-5ddd660d6273",
                        "glosses": [
                            "de echtgenote van broer of zus, of de zus van de echtgenoot of echtgenote"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b27bc17-0e11-41d3-94bc-72858a110775",
                                "sense_id": "34b92658-e03c-390a-a047-3f9cf8263bb2",
                                "text": "Maren, hoor je me?' Maar ze weet dat haar schoonzuster er niet meer is."
                            },
                            {
                                "example_id": "133bdf75-8ef9-46ef-b05f-7b1c8967d8f6",
                                "sense_id": "34b92658-e03c-390a-a047-3f9cf8263bb2",
                                "text": "Haar schoonzuster ziet er niet vredig uit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c51ed01c-8f9b-4b8a-92f3-590fc1f42c88",
                        "source_entry_id": "0d59f5fd-696e-39e7-90dc-5ddd660d6273",
                        "source_sense_id": "34b92658-e03c-390a-a047-3f9cf8263bb2",
                        "source_sense_description": "de echtgenote van broer of zus, of de zus van de echtgenoot of echtgenote",
                        "target_lang_word": "Schwägerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwägerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5854a572-cd28-3e2c-ad70-c1d2863d82ac",
                                        "entry_id": "46294ce9-0951-3d06-9c89-9c531343f40e",
                                        "glosses": [
                                            "Schwester des Ehepartners"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a4892be-bcdf-49db-8456-cf8481d55b8e",
                                                "sense_id": "5854a572-cd28-3e2c-ad70-c1d2863d82ac",
                                                "text": "Juttas Schwägerin mischt sich dauernd in ihre Eheangelegenheiten ein und ihr Mann Otto lässt das auch noch zu."
                                            },
                                            {
                                                "example_id": "f410b309-094b-4bf0-8328-055593d70374",
                                                "sense_id": "5854a572-cd28-3e2c-ad70-c1d2863d82ac",
                                                "text": "„Meine Schwägerin stand in der Stube und gab mir die Hand.“"
                                            },
                                            {
                                                "example_id": "f98c322f-64b8-4430-b5e5-c4509cdefeb3",
                                                "sense_id": "5854a572-cd28-3e2c-ad70-c1d2863d82ac",
                                                "text": "„Tourés Schwägerin betrat den Raum.“"
                                            },
                                            {
                                                "example_id": "75be08bb-230c-4cbd-b5cc-40c586416f6d",
                                                "sense_id": "5854a572-cd28-3e2c-ad70-c1d2863d82ac",
                                                "text": "„Der Schwägerin Wu war der Ehrensitz angewiesen worden.“"
                                            },
                                            {
                                                "example_id": "d0ed6be7-3076-4696-824c-8e89204b77d7",
                                                "sense_id": "5854a572-cd28-3e2c-ad70-c1d2863d82ac",
                                                "text": "„Nachmittags hört er schon die Schwägerinnen in der Küche sitzen und reden, wenn er sein Jackett an der Garderobe aufhängt und die Schuhe abstreift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9ca3b66-0f6c-3893-b2fb-882cfb6e67e4",
                                        "entry_id": "46294ce9-0951-3d06-9c89-9c531343f40e",
                                        "glosses": [
                                            "Ehepartnerin eines Geschwisters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a1b145-ce06-40c4-b460-614b96ff6bb7",
                                                "sense_id": "c9ca3b66-0f6c-3893-b2fb-882cfb6e67e4",
                                                "text": "„Nachmittags hört er schon die Schwägerinnen in der Küche sitzen und reden, wenn er sein Jackett an der Garderobe aufhängt und die Schuhe abstreift.“"
                                            },
                                            {
                                                "example_id": "35c0bc3e-6642-45f4-b4b9-035d1db9e9cd",
                                                "sense_id": "c9ca3b66-0f6c-3893-b2fb-882cfb6e67e4",
                                                "text": "„Offensichtlich hatten die Gedanken, die ihr jetzt durch den Kopf gingen, mit dem Gerede ihrer Schwägerin nichts zu tun.“"
                                            },
                                            {
                                                "example_id": "7062aeaf-219f-491a-bfb4-795b15a7c06e",
                                                "sense_id": "c9ca3b66-0f6c-3893-b2fb-882cfb6e67e4",
                                                "text": "„Als am Nachmittag des 26. Januars der Reiter mit dem ungeöffneten Brief in der Satteltasche nach Götzlack zurückkehrte, wähnte Else ihren Schwiegervater und die Schwägerin mit dem Treck auf dem Weg gen Westen und konzentrierte sich nun auf die eigene Flucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
