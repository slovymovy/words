                "senses": [
                    {
                        "sense_id": "68ef9046-7932-36af-adcb-18159daf5c99",
                        "entry_id": "4f61a7f8-13fc-3430-a3f5-d896f13a1da0",
                        "glosses": [
                            "filozof, który głosi poglądy w nurcie naturalizmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8026103d-3094-44e8-8d5b-cc22e912b6a7",
                                "sense_id": "68ef9046-7932-36af-adcb-18159daf5c99",
                                "text": "Tymczasem naturalista zaprzecza, jakoby odpowiedzi na nurtujące człowieka pytania moralne egzystowały antecedentnie, że są niezależne od indywidualnych odpowiedzi lub zdolności do ich udzielania, że ich nośnikiem jest wspólnota"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1d7475dc-5395-3dd0-8d62-85010c9a452f",
                        "entry_id": "4f61a7f8-13fc-3430-a3f5-d896f13a1da0",
                        "glosses": [
                            "pisarz, który tworzy w nurcie naturalizmu literackiego"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6f9616c5-5971-356f-b85f-ede732a6dd94",
                        "entry_id": "4f61a7f8-13fc-3430-a3f5-d896f13a1da0",
                        "glosses": [
                            "artysta, który tworzy w nurcie naturalizmu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "c8594cce-712c-32cf-b867-5c29acc720dc",
                        "entry_id": "4f61a7f8-13fc-3430-a3f5-d896f13a1da0",
                        "glosses": [
                            "przyrodnik"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "28b318aa-d139-48ce-b295-44ef62ca599d",
                                "sense_id": "c8594cce-712c-32cf-b867-5c29acc720dc",
                                "text": "Sławny naturalista M. Audubon doniósł z odległości 100 mil do portu Union, pod szer. półn. 49°,10, że odkrył zwierzę ssące, któreby stać się mogło wielce użytecznem. Zwierzę to podobne jest do kangura"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dce434e6-eeb8-442f-9d3b-4fa6eb62390f",
                        "source_entry_id": "4f61a7f8-13fc-3430-a3f5-d896f13a1da0",
                        "source_sense_id": "1d7475dc-5395-3dd0-8d62-85010c9a452f",
                        "target_lang_word": "naturalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naturalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc4acccb-89e9-3f06-86ab-62340001564d",
                                        "entry_id": "46319659-a053-3f2a-ac7b-5afeb9274c1f",
                                        "glosses": [
                                            "A natural philosopher; a scientist."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20930853-6da9-47e1-811d-19d044b77144",
                                                "sense_id": "dc4acccb-89e9-3f06-86ab-62340001564d",
                                                "text": "It has also been asserted, by some naturalists, that men do not attain their full growth and strength till thirty; but that women arrive at maturity by twenty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "619d5a92-42d9-34cc-8ba2-4094716a172d",
                                        "entry_id": "46319659-a053-3f2a-ac7b-5afeb9274c1f",
                                        "glosses": [
                                            "A person who believes in or advocates the tenets of philosophical or methodological naturalism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "accede3c-58a7-383c-a11a-8bdd34ce480a",
                                        "entry_id": "46319659-a053-3f2a-ac7b-5afeb9274c1f",
                                        "glosses": [
                                            "An expert in natural history or the study of plants and animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48a0402e-9fbe-472e-a4fe-6f9ddb78568c",
                                                "sense_id": "accede3c-58a7-383c-a11a-8bdd34ce480a",
                                                "text": "I will leave off all my childish fooleries and diversions, and set about studying with such a rage, that when you come back next year, you may find the tongue I have now in my mouth more forky than that of some serpents mentioned by Pliny the naturalist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b06c82d9-2dac-36cd-a9a2-5fbafb3590e9",
                                        "entry_id": "46319659-a053-3f2a-ac7b-5afeb9274c1f",
                                        "glosses": [
                                            "A creative artist who attempts to faithfully represent nature; an adherent of artistic naturalism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "naturalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c625d9d7-96b6-3d88-b688-4f5882d61c12",
                                        "entry_id": "77ce6525-138f-39de-87c9-cfc1207ca96e",
                                        "glosses": [
                                            "Synonym of naturalistic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53a1a24f-2dfc-4812-afe4-d81617f629e3",
                                                "sense_id": "c625d9d7-96b6-3d88-b688-4f5882d61c12",
                                                "text": "Trinity received “Birds of America” in 1900 as a gift from Dr. Gordon Russell, a physician and alumnus who was a collector of ornithological and naturalist art."
                                            },
                                            {
                                                "example_id": "5943a702-bf4b-428b-b9a9-48a4d8d666d1",
                                                "sense_id": "c625d9d7-96b6-3d88-b688-4f5882d61c12",
                                                "text": "Its author – Henry Handel Richardson was the nom de plume of Ethel Florence Lindesay Richardson – had indeed read, and on occasion translated, these great European writers and they provided the naturalist style and intellectual inquiry resonant in all her fiction. […] The honesty and authorial detachment that is so remarkable in her work – she is one of the least obtrusive, least judgmental of all the great naturalist writers – seems to come from a distance, almost as though the particularly acute insight of the adult writer could only be seen through the filter of childhood experience."
                                            },
                                            {
                                                "example_id": "0a5d7838-31cb-4bae-96f2-35e0a926de22",
                                                "sense_id": "c625d9d7-96b6-3d88-b688-4f5882d61c12",
                                                "text": "The restaurant feels of-the-moment Los Angeles in its naturalist beauty (plants breathe life into the minimalist space) and its wide-open creativity, though much of Bost’s culinary background is steeped in grand French traditions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db580663-7c46-4972-b1cf-e2c4431a6a1d",
                        "source_entry_id": "4f61a7f8-13fc-3430-a3f5-d896f13a1da0",
                        "source_sense_id": "1d7475dc-5395-3dd0-8d62-85010c9a452f",
                        "target_lang_word": "naturaliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naturaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                        "entry_id": "ec20e2e4-0233-32df-bf15-b1b9c283e4e7",
                                        "glosses": [
                                            "Qualifie un romancier partisan du naturalisme, ou une œuvre littéraire répondant aux principes du naturalisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75089294-f4c9-424d-b8e9-9a871f6dfd0d",
                                                "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                                "text": "Les romanciers naturalistes."
                                            },
                                            {
                                                "example_id": "f1617b30-265f-4ce0-a345-e6baad35b8c9",
                                                "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                                "text": "Un roman naturaliste."
                                            },
                                            {
                                                "example_id": "895676a6-fa87-4729-8183-8d06c7bbefea",
                                                "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                                "text": "L'École naturaliste."
                                            },
                                            {
                                                "example_id": "a8d0a494-ece5-4571-b90d-79450e4555c5",
                                                "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                                "text": "Et c'est le théâtre naturaliste. C'est, pour faire vrai, l'acteur tournant le dos au public. C'est le quartier de viande saignant. C'est la réalité crue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0056226-ad85-323f-8e90-03b837637036",
                                        "entry_id": "ec20e2e4-0233-32df-bf15-b1b9c283e4e7",
                                        "glosses": [
                                            "Conforme au naturalisme, approche des sciences humaines selon laquelle il existe une réalité objective répondant à un certain nombre de règles, par opposition au constructivisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edfab6ce-ad5a-4d42-b8b5-9df9de35944f",
                                                "sense_id": "d0056226-ad85-323f-8e90-03b837637036",
                                                "text": "Selon la conception naturaliste (ou positiviste) de la science, il existerait des régularités et des tendances générales dans le comportement humain qui peuvent être décelées grâce à l'expérimentation et à l'observation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "naturaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a487877c-8f7b-3fc3-bb16-3db995ff7cbc",
                                        "entry_id": "4fb46353-1ac0-3077-bcfe-db88b564dcea",
                                        "glosses": [
                                            "Romancier partisan du naturalisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7185ad82-16f1-412d-ab6a-b800137115a7",
                                                "sense_id": "a487877c-8f7b-3fc3-bb16-3db995ff7cbc",
                                                "text": "Élevée par des parents soigneux de ses lectures et n’ayant pas beaucoup d’idées dans la cervelle, mais les ayant saines et bonnes, jamais elle ne connut les Naturalistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                        "entry_id": "4fb46353-1ac0-3077-bcfe-db88b564dcea",
                                        "glosses": [
                                            "Savant qui s’applique à l’histoire naturelle, qui s’attache à l’étude des plantes, des minéraux, des animaux, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99d398f1-867f-4a70-84c2-425bf0e9acc3",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Celui qui ne connaît d'un animal que le nom et la place qui lui revient dans un système de nomenclature plus ou moins bien assis, ne mérite pas plus le titre de naturaliste qu'un garçon de bibliothèque n'est digne de l'épithète de savant parce qu'il sait par cœur le titre de ses livres, leur numéro d'ordre et la case où ils sont logés."
                                            },
                                            {
                                                "example_id": "edae7d82-4e34-4bdd-a412-f0e3afacf736",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Ce sont les pigeons, pour la douceur desquels quelques naturalistes ont escrit qu’eux et les tourtres estoient sans fiel."
                                            },
                                            {
                                                "example_id": "007bbe5f-1ffb-49cd-94f7-c44d2075abf1",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Un naturaliste allemand, envoyé par une société scientifique de son pays, habitait également Adwa."
                                            },
                                            {
                                                "example_id": "63116f62-545c-43b1-afb4-df217477afbf",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Autour de cette vasque, sous d'élégantes vitrines fixées par des armatures de cuivre, étaient classés et étiquetés les plus précieux produits de la mer qui eussent jamais été livrés aux regards d'un naturaliste. On conçoit ma joie de professeur."
                                            },
                                            {
                                                "example_id": "013fe35d-0936-49f6-a945-61f6a32f9b4c",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Très vite incriminés, les naturalistes ont procédé à une enquête visant à reconstituer la progression des loups depuis les Abruzzes jusqu'au Mercantour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f539ab4-618f-3de4-b6b1-0771d10b6e44",
                                        "entry_id": "4fb46353-1ac0-3077-bcfe-db88b564dcea",
                                        "glosses": [
                                            "Taxidermiste."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
