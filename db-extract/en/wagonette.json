                "senses": [
                    {
                        "sense_id": "e670651f-1c23-342e-ae42-3930b9c874e7",
                        "entry_id": "e76d04f0-2c4a-3d88-81ba-730880ded170",
                        "glosses": [
                            "A kind of four-wheeled horse-drawn carriage, normally uncovered."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "487028ab-dbc8-4460-a11f-34c079e69123",
                                "sense_id": "e670651f-1c23-342e-ae42-3930b9c874e7",
                                "text": "The cabs here are mostly covered waggonettes, with one horse. They hold four people; the sides have coloured glass, and behind the driver there is a window which is drawn aside when you communicate with him."
                            },
                            {
                                "example_id": "cea22dde-5880-4301-a42d-3bfd34ea4cb3",
                                "sense_id": "e670651f-1c23-342e-ae42-3930b9c874e7",
                                "text": "On glowing summer afternoons wagonettes came full of Americans and cultured suburbans to see the sepulchre"
                            },
                            {
                                "example_id": "6271a30a-c494-45cf-8e7e-6563a1e5dedb",
                                "sense_id": "e670651f-1c23-342e-ae42-3930b9c874e7",
                                "text": "The departure was not unduly prolonged.[…]Within the door Mrs. Spoker hastily imparted to Mrs. Love a few final sentiments on the subject of Divine Intention in the disposition of buckets; farewells and last commiserations; a deep, guttural instigation to the horse; and the wheels of the waggonette crunched heavily away into obscurity."
                            },
                            {
                                "example_id": "93fdb80b-7256-4a55-ab3b-e4d5795a5bda",
                                "sense_id": "e670651f-1c23-342e-ae42-3930b9c874e7",
                                "text": "He was a peasant worker from Tienchen County, and had been working on the dam, carrying earth and stone or pushing wagonettes here for half a year."
                            }
                        ]
                    }
                ],
