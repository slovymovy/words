                        "glosses": [
                            "Action de faire bouillir une substance dans l’eau et qui a pour but d’obtenir deux produits, l’un solide cuit et l’autre liquide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64e77244-453c-4ec0-9ade-88a18e6ff96c",
                                "sense_id": "b22f2b41-4ef1-3570-a10f-88afedb11678",
                                "text": "Le pot-au-feu des ménages est une élixation."
                            },
                            {
                                "example_id": "49ee82b2-5cde-4a12-96ce-24287a7bca08",
                                "sense_id": "b22f2b41-4ef1-3570-a10f-88afedb11678",
                                "text": "C’est ainsi qu’un des personnages du roman, Papiton, utilise un mot rare en s’adressant à sa femme, Mamitate, en lui déclarant : « ton pot-au-feu n’est qu'une élixation »."
                            }
                        ]
                    }
