                        "glosses": [
                            "S’éblouir soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d483f313-8300-4adc-988f-df548cf76dea",
                                "sense_id": "df243572-69b2-33db-9982-c92ade10ec3b",
                                "text": "A mener cette vie, IN ne sut plus où donner de la tête, tellement il s’autoéblouissait, si bien que sa tête, justement, finit par enfler, enfler…."
                            },
                            {
                                "example_id": "45226637-fd25-4b21-b234-4cdef4c17678",
                                "sense_id": "df243572-69b2-33db-9982-c92ade10ec3b",
                                "text": "Et puis y a ça, aussi : ils bichent d’être en smok, les gaziers. Ils s’autoéblouissent."
                            }
                        ]
                    }
