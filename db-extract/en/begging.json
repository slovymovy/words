                        "entry_id": "0f79477e-fe25-365f-b94b-e8750416db7b",
                        "glosses": [
                            "The act of one who begs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9963b6ba-5691-48fb-8cc2-37fc75f1661e",
                                "sense_id": "42f6cdb6-3f24-3e2b-8659-8cbd59ed769c",
                                "text": "The Brahmans were very annoying in their beggings for money […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "46983c32-face-3fe7-b39e-e732a1eecf98",
                        "entry_id": "0f79477e-fe25-365f-b94b-e8750416db7b",
                        "glosses": [
                            "Money or goods acquired by begging."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "eed7e587-634c-4fc0-ac4d-f3c8d86b6944",
                                "sense_id": "46983c32-face-3fe7-b39e-e732a1eecf98",
                                "text": "Then a thin old hag […] moaned out, \"Twopence for two ounces!\" and had to go out of the shop unmeated, since her earnings — or her beggings — had not brought her enough to have that small price to spare."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9690a8b-5441-46c0-883b-ed03c351bdea",
                        "source_entry_id": "0f79477e-fe25-365f-b94b-e8750416db7b",
                        "source_sense_description": "the act of one who begs",
                        "target_lang_word": "manche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c265a5b5-952f-3156-af95-d35fdf74f604",
                                        "entry_id": "d41bd39e-ce9a-31dd-9f3a-e066ffafab61",
                                        "glosses": [
                                            "Partie du vêtement, de forme et de dimension variable, dans laquelle on passe le bras et qui le recouvre en totalité ou en partie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12f93416-538f-4d31-8839-cfb8fcfd636b",
                                                "sense_id": "c265a5b5-952f-3156-af95-d35fdf74f604",
                                                "text": "Ses bras, à la fois mignons et potelés, sortaient de manches à sabots fourrées de dentelles."
                                            },
                                            {
                                                "example_id": "e57a7d9b-7bc2-479f-954d-16f3542a6f10",
                                                "sense_id": "c265a5b5-952f-3156-af95-d35fdf74f604",
                                                "text": "Avec une révérence, elle se présentait, la bonne vieille, fière d’être appelée, et posait un pied sur les marches du seuil ; son costume propret était rehaussé toujours de fausses manches blanches."
                                            },
                                            {
                                                "example_id": "20ca2ce1-4e97-40da-9cab-b20e5c75d682",
                                                "sense_id": "c265a5b5-952f-3156-af95-d35fdf74f604",
                                                "text": "En sabots, les manches relevées sur leurs bras blancs, les filles balayaient le devant des boutiques."
                                            },
                                            {
                                                "example_id": "5a8e6bcf-fa93-400c-98b0-7ee8d503d603",
                                                "sense_id": "c265a5b5-952f-3156-af95-d35fdf74f604",
                                                "text": "[…]; et le maréchal, avec son tablier de cuir et ses manches de chemise retroussées jusqu’à l’épaule, tenait le cheval par la bride, parce que le cheval était un peu nerveux."
                                            },
                                            {
                                                "example_id": "84eccf23-e268-4e7a-976a-2bf45c9ca69c",
                                                "sense_id": "c265a5b5-952f-3156-af95-d35fdf74f604",
                                                "text": "Il secoua la tête, jeta un soupir puis essuya son front avec le revers de sa manche de chemise : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f913fd1-c5ca-3c1a-90b0-1b0f8065f5e0",
                                        "entry_id": "d41bd39e-ce9a-31dd-9f3a-e066ffafab61",
                                        "glosses": [
                                            "Conduit d’évacuation, tuyau à liquide ou à gaz."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4203e5b-8a30-4288-ac4b-8b74043d735f",
                                                "sense_id": "1f913fd1-c5ca-3c1a-90b0-1b0f8065f5e0",
                                                "text": "Manche à incendie, à eau, à charbon, à vent, à air, d’appendice, filtres à manches ou manche d’Hippocrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71618808-c0f0-33d4-b335-64f3aabf32d8",
                                        "entry_id": "d41bd39e-ce9a-31dd-9f3a-e066ffafab61",
                                        "glosses": [
                                            "Manche à air : drapeau creux indiquant le vent sur les aéroports."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b171b7ad-1fb1-3dc9-a708-7facbf59dec4",
                                        "entry_id": "d41bd39e-ce9a-31dd-9f3a-e066ffafab61",
                                        "glosses": [
                                            "Filet de pêche long d’une dizaine de mètres et fermé à une extrémité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8764b90-3dca-3fc0-ab71-3770afb40b65",
                                        "entry_id": "d41bd39e-ce9a-31dd-9f3a-e066ffafab61",
                                        "glosses": [
                                            "Bras de mer, et particulièrement le bras de mer séparant l’Angleterre de la France (la Manche)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ef37883-d8cc-4dc5-b540-dd47deedb806",
                                                "sense_id": "e8764b90-3dca-3fc0-ab71-3770afb40b65",
                                                "text": "La manche de Bristol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a447602e-acd1-366a-9963-fa82286993ca",
                                        "entry_id": "d41bd39e-ce9a-31dd-9f3a-e066ffafab61",
                                        "glosses": [
                                            "Partie liée à une ou plusieurs autre(s) dans certains jeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa4a3ca-9582-4bff-b160-cc716c192877",
                                                "sense_id": "a447602e-acd1-366a-9963-fa82286993ca",
                                                "text": "Épreuve, jeu, partie en trois manches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6802a520-462d-365d-a10e-a29be9fc8b43",
                                        "entry_id": "d41bd39e-ce9a-31dd-9f3a-e066ffafab61",
                                        "glosses": [
                                            "Meuble représentant une manche d’un vêtement dans les armoiries. Plutôt en usage en héraldique anglaise, elle est représentée sans membre humain. Elle est généralement dénommée manche mal-taillée en héraldique française car la forme du vêtement s’est perdue au fil du temps pour adopter une forme souvent peu reconnaissable."
                                        ],
                                        "tags": [
                                            "Très rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dca810e1-f38f-481b-80d8-46a3edb8b944",
                                                "sense_id": "6802a520-462d-365d-a10e-a29be9fc8b43",
                                                "text": "D’argent, à une manche de sable, qui est de la famille Hastings en Angleterre"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "manche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8c0c84f-66c2-3486-81ad-bf3e060cd356",
                                        "entry_id": "ec935d0b-ff9a-37cd-b509-831a841a1bd8",
                                        "glosses": [
                                            "Partie préhensible d’un instrument, d’un outil, par laquelle on le tient pour en faire usage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e78a7a-6c02-47ea-b0e0-d49e9bbc3d8e",
                                                "sense_id": "d8c0c84f-66c2-3486-81ad-bf3e060cd356",
                                                "text": "Manche de marteau."
                                            },
                                            {
                                                "example_id": "6c8fe52e-2ac6-4229-960b-aae8684648dc",
                                                "sense_id": "d8c0c84f-66c2-3486-81ad-bf3e060cd356",
                                                "text": "Oui ! je l'approuve parce que c'est ignoble ! un élève que j'avais stylé à la vertu !.. et c'est vous qui le débauchez... vous, son oncle !.. un homme qui a blanchi dans les manches de couteaux !"
                                            },
                                            {
                                                "example_id": "4fe6d85a-935f-4668-81fd-9eced94ec840",
                                                "sense_id": "d8c0c84f-66c2-3486-81ad-bf3e060cd356",
                                                "text": "L’ouvrier se sert d’une lame courte et tranchante, engagée dans un manche d’os, avec laquelle il pratique, au bas de l’arbre, une entaille circulaire et assez profonde pour arriver jusqu'à l’aubier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78a4aba7-d0bd-379c-8b4d-3e6b7a6998d2",
                                        "entry_id": "ec935d0b-ff9a-37cd-b509-831a841a1bd8",
                                        "glosses": [
                                            "Partie préhensible d’un instrument, d’un outil, par laquelle on le tient pour en faire usage.",
                                            "Partie d'un instrument à cordes, où l’on pose les doigts de la main gauche pour former les tons différents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e4f9bb9-7583-42fb-b212-6e2e6c923db8",
                                                "sense_id": "78a4aba7-d0bd-379c-8b4d-3e6b7a6998d2",
                                                "text": "Dans les enregistrements de guitare acoustique, on entend plus souvent le bruit des glissements de doigts sur le manche que le son de la guitare elle-même."
                                            },
                                            {
                                                "example_id": "d51800a2-7c37-4943-82fe-5eb5e65d7416",
                                                "sense_id": "78a4aba7-d0bd-379c-8b4d-3e6b7a6998d2",
                                                "text": "Le manche d’une basse, d’une contrebasse, d’un violon, d’une guitare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a031c1a-fe3e-3b1a-b555-d2f61cceb233",
                                        "entry_id": "ec935d0b-ff9a-37cd-b509-831a841a1bd8",
                                        "glosses": [
                                            "Partie préhensible d’un instrument, d’un outil, par laquelle on le tient pour en faire usage.",
                                            "Manche à balai."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa8497af-1a38-4b5f-97b6-5f3df25d6e61",
                                                "sense_id": "4a031c1a-fe3e-3b1a-b555-d2f61cceb233",
                                                "text": "Malgré la marche extrêmement régulière du moteur, malgré son déploiement absolu de puissance, j’ai dû arracher le manche de toute la force de mes deux bras. L’appareil eut comme un sursaut nerveux."
                                            },
                                            {
                                                "example_id": "79f3d28c-f0bd-4f85-b93c-e015f2083aa2",
                                                "sense_id": "4a031c1a-fe3e-3b1a-b555-d2f61cceb233",
                                                "text": "Il suffit pour cela de se mettre en vol inversé, à très, très basse vitesse, puis de pousser soudainement sur le manche pour faire décrocher l'avion tout en mettant le palonnier en butée d'un côté pour le faire partir en vrille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56fb6b23-ffb7-34a8-a83c-2b42a70e10a8",
                                        "entry_id": "ec935d0b-ff9a-37cd-b509-831a841a1bd8",
                                        "glosses": [
                                            "Os visible d’une pièce de viande."
                                        ],
                                        "tags": [
                                            "Boucherie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c9fe28a-68f7-4575-8f75-34b243d4925d",
                                                "sense_id": "56fb6b23-ffb7-34a8-a83c-2b42a70e10a8",
                                                "text": "Manche d’une côtelette d’agneau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9d4b396-df4a-3a52-8b9b-d4530a0d3f70",
                                        "entry_id": "ec935d0b-ff9a-37cd-b509-831a841a1bd8",
                                        "glosses": [
                                            "Contravention."
                                        ],
                                        "tags": [
                                            "Occitanie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "265f9766-aabe-44f0-a3b1-715ae019136b",
                                                "sense_id": "c9d4b396-df4a-3a52-8b9b-d4530a0d3f70",
                                                "text": "Justement, le cordonnier de la rue Victor-Hugo soupire: « Pour faire des achats, les gens doivent se déplacer exprès, et s'ils viennent en voiture, ils peuvent se prendre un manche. Dans les grandes surfaces, ils n'ont pas ces problèmes: ils ont toute la place pour se garer, et toutes sortes de commerces. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "manche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24144126-7803-3914-94c3-143062fb5f3d",
                                        "entry_id": "d8707c33-6e4e-3c9d-a171-6a1558432a2f",
                                        "glosses": [
                                            "Somme collectée au cours d’une quête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734147a6-3df3-4186-aeb4-551647344192",
                                                "sense_id": "24144126-7803-3914-94c3-143062fb5f3d",
                                                "text": "Au bout de ce temps tu auras un sixième de la manche."
                                            },
                                            {
                                                "example_id": "e7ced68b-3e0c-4471-8d76-90ce77db69d1",
                                                "sense_id": "24144126-7803-3914-94c3-143062fb5f3d",
                                                "text": "Une nouvelle forme de « manche » depuis quelques semaines : « vous n’auriez pas deux francs pour que j’aille me saouler la gueule ? » Un jeune, avec une boucle d’oreille. Le cynisme a remplacé l’appel à la pitié. Créativité permanente des hommes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "manche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e0c5fdf-7666-3148-a357-0fb592ec8c9d",
                                        "entry_id": "8645a02a-c8e3-3b8b-ab95-faf48807262e",
                                        "glosses": [
                                            "Sot, maladroit, nul."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65ca872e-7cef-4010-bc12-7d6d952224ca",
                                                "sense_id": "6e0c5fdf-7666-3148-a357-0fb592ec8c9d",
                                                "text": "Ce que j’ai pu être manche ! Elle a cherché à m’amener chez elle et j’ai pas voulu. Je croyais que c’était un traquenard de Saltierra."
                                            }
                                        ]
                                    }
                                ]
