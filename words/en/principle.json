{
    "word_family": [
        "principled",
        "unprincipled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0505fcbf-69f2-3175-8eb9-7ac8c5ada3f8",
                    "sense_definition": "A moral rule or standard of good behavior that guides a person's actions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ethics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She refused to lie to her boss as a matter of <w>principle</w>.",
                            "target_lang_translations": {
                                "ru": "Она отказалась лгать своему начальнику из <w>принципа</w>.",
                                "zh": "出于<w>原则</w>问题，她拒绝向老板撒谎。"
                            }
                        },
                        {
                            "text": "He is a man of high <w>principles</w> who always keeps his promises.",
                            "target_lang_translations": {
                                "ru": "Он человек высоких <w>принципов</w>, который всегда сдерживает свои обещания.",
                                "zh": "他是一个有高尚<w>原则</w>的人，总是信守承诺。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "matter of principle",
                        "on principle",
                        "against my principles",
                        "high principles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Моральное правило или стандарт поведения, которым руководствуется человек в своих поступках.",
                        "zh": "指引个人行为的道德准则或行为标准。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принцип",
                                "target_lang_sense_clarification": "моральное правило"
                            },
                            {
                                "target_lang_word": "убеждение",
                                "target_lang_sense_clarification": "внутренняя уверенность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "原则",
                                "target_lang_sense_clarification": "道德准则"
                            },
                            {
                                "target_lang_word": "信念",
                                "target_lang_sense_clarification": "内在的道德确信"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89bb1a3c-abe3-3391-bf42-17e93a09d064",
                    "sense_definition": "A fundamental truth, law, or assumption that serves as the foundation for a system of belief, reasoning, or scientific theory.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "foundation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization works on the <w>principle</w> that all members have equal rights.",
                            "target_lang_translations": {
                                "ru": "Организация работает по <w>принципу</w>, согласно которому все члены имеют равные права.",
                                "zh": "该组织遵循所有成员享有平等权利的<w>原则</w>。"
                            }
                        },
                        {
                            "text": "Archimedes' <w>principle</w> explains why ships are able to float on water.",
                            "target_lang_translations": {
                                "ru": "<w>Принцип</w> (закон) Архимеда объясняет, почему корабли могут держаться на воде.",
                                "zh": "阿基米德<w>定律</w>解释了为什么船只能够浮在水面上。"
                            }
                        },
                        {
                            "text": "We agreed to the deal in <w>principle</w>, but we still need to discuss the details.",
                            "target_lang_translations": {
                                "ru": "Мы согласились на сделку в <w>принципе</w>, но нам всё ещё нужно обсудить детали.",
                                "zh": "我们<w>原则</w>上同意了这项交易，但仍需讨论细节。"
                            }
                        }
                    ],
                    "synonyms": [
                        "premise",
                        "tenet"
                    ],
                    "common_phrases": [
                        "in principle",
                        "guiding principle",
                        "basic principle",
                        "general principle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фундаментальная истина, закон или допущение, служащее основой системы убеждений, рассуждений или научной теории.",
                        "zh": "作为信仰体系、推理或科学理论基础的基本真理、定律或假设。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принцип",
                                "target_lang_sense_clarification": "основополагающая истина"
                            },
                            {
                                "target_lang_word": "основа",
                                "target_lang_sense_clarification": "база, фундамент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "原则",
                                "target_lang_sense_clarification": "基本规律或准则"
                            },
                            {
                                "target_lang_word": "基础",
                                "target_lang_sense_clarification": "事物的根基"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d96abc09-d18c-3da6-906e-8041dffd1072",
                    "sense_definition": "A chemical substance, especially one found in a plant, that produces a specific quality or effect.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Caffeine is the active <w>principle</w> found in coffee beans.",
                            "target_lang_translations": {
                                "ru": "Кофеин — это действующее <w>начало</w>, содержащееся в кофейных зернах.",
                                "zh": "咖啡因是咖啡豆中发现的活性<w>成分</w>。"
                            }
                        },
                        {
                            "text": "Scientists isolated the bitter <w>principle</w> from the medicinal herb.",
                            "target_lang_translations": {
                                "ru": "Ученые выделили горькое <w>начало</w> из лекарственного растения.",
                                "zh": "科学家从这种药草中分离出了苦味<w>成分</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "active principle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Химическое вещество, особенно растительного происхождения, создающее определенное качество или эффект.",
                        "zh": "一种化学物质，尤指植物中产生特定性质或效果的成分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начало",
                                "target_lang_sense_clarification": "химический термин"
                            },
                            {
                                "target_lang_word": "действующее вещество",
                                "target_lang_sense_clarification": "активный компонент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成分",
                                "target_lang_sense_clarification": "化学或药理学中的活性物质"
                            },
                            {
                                "target_lang_word": "活性物质",
                                "target_lang_sense_clarification": "具有特定功能的化学成分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45b74ad2-36fc-302c-a61f-41c30baff626",
                    "sense_definition": "To equip with principles or establish rules of conduct.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The parents tried to <w>principle</w> their children in honesty and integrity.",
                            "target_lang_translations": {
                                "ru": "Родители пытались <w>привить</w> своим детям <w>принципы</w> честности и порядочности.",
                                "zh": "父母试图向孩子们<w>灌输</w>诚实和正直的原则。"
                            }
                        },
                        {
                            "text": "He was well <w>principled</w> by his mentors before entering the profession.",
                            "target_lang_translations": {
                                "ru": "Наставники хорошо <w>воспитали</w> его перед тем, как он вошел в профессию.",
                                "zh": "在进入这一行业之前，他受到了导师良好的<w>原则教导</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прививать принципы или устанавливать правила поведения.",
                        "zh": "向某人灌输原则或建立行为准则。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прививать принципы",
                                "target_lang_sense_clarification": "обучать морали"
                            },
                            {
                                "target_lang_word": "воспитывать",
                                "target_lang_sense_clarification": "формировать личность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灌输原则",
                                "target_lang_sense_clarification": "教导道德准则"
                            },
                            {
                                "target_lang_word": "培养",
                                "target_lang_sense_clarification": "塑造品格"
                            }
                        ]
                    }
                }
            ]
        }
    ]
