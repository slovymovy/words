                "senses": [
                    {
                        "sense_id": "fc06f752-f0af-33fa-894d-109150c8301a",
                        "entry_id": "0ec75527-d233-399f-87b7-5faf467ca5cb",
                        "glosses": [
                            "To obey incorrectly; to make a mistake in following orders."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "685c3d30-f22e-4d8e-8a2b-23bc60a311d4",
                                "sense_id": "fc06f752-f0af-33fa-894d-109150c8301a",
                                "text": "the dispatcher may properly perform his duties in issuing an order, which may then be misunderstood or misobeyed through negligence, forgetfulness, absentmindedness, or in some other manner, with no opportunity for the dispatcher to detect such errors in time to avoid accident."
                            },
                            {
                                "example_id": "57870559-2bd1-43e2-add4-a806ee39cda2",
                                "sense_id": "fc06f752-f0af-33fa-894d-109150c8301a",
                                "text": "This right had been accepted by relative tribals but misobeyed and effaced by non-tribals and foreign peasants."
                            },
                            {
                                "example_id": "71c2cf84-feb1-4a78-93d5-4e2c5fe91913",
                                "sense_id": "fc06f752-f0af-33fa-894d-109150c8301a",
                                "text": "It is possible to take liberty with secular and vedic injunctions: one may obey, not obey or misobey them, but the same cannot be done with regard to objects of knowledge."
                            }
                        ]
                    }
