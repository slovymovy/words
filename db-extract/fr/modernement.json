                    {
                        "sense_id": "534be7e9-805c-3ca1-b335-212bf07503af",
                        "entry_id": "97085f1b-c487-38a5-aae5-bcceabbe1c9d",
                        "glosses": [
                            "D’une façon moderne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9197fce-a842-4ff3-a943-b3ce85be0138",
                                "sense_id": "534be7e9-805c-3ca1-b335-212bf07503af",
                                "text": "On n'a pu confondre ces anciennes et primordiales assemblées connues sous le nom de parlement de France, avec les cours de justice si modernement établies, telles qu'elles sont aujourd'hui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1abc1d76-2037-4b63-8cf6-4eb406542458",
                        "source_entry_id": "97085f1b-c487-38a5-aae5-bcceabbe1c9d",
                        "source_sense_id": "534be7e9-805c-3ca1-b335-212bf07503af",
