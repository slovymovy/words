                "senses": [
                    {
                        "sense_id": "28b83cec-5d5c-3546-bfbf-b7210f521a6a",
                        "entry_id": "502393a3-3def-3776-be2e-998d19bd4932",
                        "glosses": [
                            "bestimmte Anforderungen/Maßnahmen, welche die Sicherheit im Verkehr gewährleisten sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ba3b38e-d263-4036-ade2-a21513f03132",
                                "sense_id": "28b83cec-5d5c-3546-bfbf-b7210f521a6a",
                                "text": "„Neue Autos haben einen viel höheren Verkehrssicherheitsstandard als zehn Jahre alte Autos.“"
                            },
                            {
                                "example_id": "f992184b-c711-4a31-98dc-131b8e88a34d",
                                "sense_id": "28b83cec-5d5c-3546-bfbf-b7210f521a6a",
                                "text": "„Außerdem ist für einen ausreichenden Verkehrssicherheitsstandard neben der äußeren Fahrspur ein auch vom Lkw-Verkehr benutzbarer Nothaltestreifen unverzichtbar, so dass eine entsprechende Verbreiterung erforderlich wäre.“"
                            },
                            {
                                "example_id": "bb21b97c-ab7f-450a-aa4a-f41e94171485",
                                "sense_id": "28b83cec-5d5c-3546-bfbf-b7210f521a6a",
                                "text": "„Wenn Sie Übergangsfristen verlangen, müssen Sie bedenken, dass wir unsere Umweltstandards, Verkehrssicherheitsstandards und die Qualität der Leistung durchsetzen wollen.“"
                            },
                            {
                                "example_id": "fbd65639-49d0-4288-906a-f6f802e45fcf",
                                "sense_id": "28b83cec-5d5c-3546-bfbf-b7210f521a6a",
                                "text": "„Wir werden diese Zusammenarbeit weiter stärken und ausbauen und uns für das aktive Engagement der zuständigen internationalen Organisationen einsetzen, um die internationalen Verkehrssicherheitsstandards anzuheben.“"
                            },
                            {
                                "example_id": "57e3d391-b761-45c2-a2eb-45913b8a4920",
                                "sense_id": "28b83cec-5d5c-3546-bfbf-b7210f521a6a",
                                "text": "„Jedoch sind trotz der tendenziell rückläufigen Verkehrsunfälle angesichts des hohen Verkehrsaufkommens und der prognostizierten Verkehrszuwächse weiterhin erhebliche Anstrengungen für einen hohen Verkehrssicherheitsstandard erforderlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
