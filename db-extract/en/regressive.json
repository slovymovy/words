                        "translation_id": "f39bea49-e933-4a64-bc3a-60a217c79656",
                        "source_entry_id": "52dc07d8-4593-3bbb-a6a9-909832e614b3",
                        "source_sense_description": "whose rate decreases as the amount increases",
                        "target_lang_word": "regressiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regressiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26880ace-2661-3c86-8a51-f6fb40e38152",
                                        "entry_id": "a95a67b9-9adc-351f-ab13-ec9b3583211f",
                                        "glosses": [
                                            "Rückgang, Rückschritt zeigend; sich vermindernd, abnehmend"
                                        ],
                                        "tags": [
                                            "finance",
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5973bb77-3d67-471e-84e7-184a8df944da",
                                                "sense_id": "26880ace-2661-3c86-8a51-f6fb40e38152",
                                                "text": "„Die regressive Entwicklung des Patienten begann lange vor dem Unfall.“"
                                            },
                                            {
                                                "example_id": "c674f77b-b5c0-4bbb-b947-fed169561b1f",
                                                "sense_id": "26880ace-2661-3c86-8a51-f6fb40e38152",
                                                "text": "„Die gezeigte Rechtschreibleistung entwickelt sich regressiv und erfüllt die Anforderungen im Verhältnis zu Gleichaltrigen nicht mehr […].“"
                                            },
                                            {
                                                "example_id": "38dd4b03-1372-421a-a1da-d36dcc700fde",
                                                "sense_id": "26880ace-2661-3c86-8a51-f6fb40e38152",
                                                "text": "„Eine regressive Entwicklung der Polizei bedeutet daher eine Gefahr für die Demokratie, wie umgekehrt eine demokratische Polizei Voraussetzung ist für die Demokratisierung der Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "559f8856-4bcc-4356-8d0c-323dcfc35f92",
                                                "sense_id": "26880ace-2661-3c86-8a51-f6fb40e38152",
                                                "text": "Das ist ein regressiver Steuersatz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8238cfc8-234c-3421-903d-ce7b38b815a6",
                                        "entry_id": "a95a67b9-9adc-351f-ab13-ec9b3583211f",
                                        "glosses": [
                                            "sich zurückentwickelnd, abnehmend"
                                        ],
                                        "tags": [
                                            "bei Tumoren oder Organen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0a6c50b-27b4-4ebb-b562-d66b89f47cd1",
                                                "sense_id": "8238cfc8-234c-3421-903d-ce7b38b815a6",
                                                "text": "Dieser Tumor ist regressiv; er ist dabei, sich zurückzubilden."
                                            },
                                            {
                                                "example_id": "c2605ec3-ab28-40c3-ba75-31773ae21eb4",
                                                "sense_id": "8238cfc8-234c-3421-903d-ce7b38b815a6",
                                                "text": "„Damit können in späteren Stadien dieser Krankheit mehr oder weniger manifeste regressive Veränderungen in verschiedenen Organen in Erscheinung treten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6855fbfb-bec5-3fde-812e-29c9963e133c",
                                        "entry_id": "a95a67b9-9adc-351f-ab13-ec9b3583211f",
                                        "glosses": [
                                            "über ein Verhalten, das in kindliche Muster zurückfällt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46980cf4-daf9-498e-a2dc-cfefa1997e94",
                                                "sense_id": "6855fbfb-bec5-3fde-812e-29c9963e133c",
                                                "text": "Diese Mutter hat bezüglich ihres Sohnes ein regressives Verhalten."
                                            }
                                        ],
