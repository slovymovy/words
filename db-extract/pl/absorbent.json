                "translations": [
                    {
                        "translation_id": "deaf7a30-9f68-4d3c-b2c3-6670fae66cf0",
                        "source_entry_id": "46f021bf-9a22-3d31-9092-2ce2c5c76093",
                        "source_sense_id": "0010b205-f651-3b48-98c0-088225373dc3",
                        "target_lang_word": "absorbent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absorbent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87de8eaf-c01a-35ff-806a-6e2f2f438f95",
                                        "entry_id": "2849761f-a2b7-3b7f-8f56-c2b387cccd47",
                                        "glosses": [
                                            "Having the ability or tendency to absorb; able to soak up liquid easily; absorptive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6aec63a-b9f9-4b35-a219-a3e3a2e594a4",
                                                "sense_id": "87de8eaf-c01a-35ff-806a-6e2f2f438f95",
                                                "text": "Those paper towels were amazingly absorbent. That was quite a spill."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absorbent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cc05f7a-6b73-303c-a892-4b99711eabdd",
                                        "entry_id": "aceec0a7-b3da-30e0-95c9-0816f0bfe0e4",
                                        "glosses": [
                                            "Anything which absorbs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "318aac09-fbfc-45b6-87e4-5114e5ac27e9",
                                                "sense_id": "1cc05f7a-6b73-303c-a892-4b99711eabdd",
                                                "text": "In the Southern Ocean the winter is not so excessively cold, but the summer is far less hot, for the clouded sky seldom allows the sun to warm the ocean, itself a bad absorbent of heat: and hence the mean temperature of the year […] is low."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36ff1358-867d-3b30-9d0c-12d7e1a8d427",
                                        "entry_id": "aceec0a7-b3da-30e0-95c9-0816f0bfe0e4",
                                        "glosses": [
                                            "The vessels by which the processes of absorption are carried on, as the lymphatics in animals, the extremities of the roots in plants."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "441479d9-7279-3f34-8f62-d6fa62bf9feb",
                                        "entry_id": "aceec0a7-b3da-30e0-95c9-0816f0bfe0e4",
                                        "glosses": [
                                            "Any substance which absorbs and neutralizes acid fluid in the stomach and bowels, as magnesia, chalk, etc.; also a substance, e.g., iodine, which acts on the absorbent vessels so as to reduce enlarged and indurated parts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a6b0a7e-b47a-3e3a-895b-b59887f236a2",
                                        "entry_id": "aceec0a7-b3da-30e0-95c9-0816f0bfe0e4",
                                        "glosses": [
                                            "A liquid used in the process of separating gases or volatile liquids, in oil refining."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
