                                "target_senses": [
                                    {
                                        "sense_id": "191b5fb9-93d0-3cbd-8bd3-367dbd67c419",
                                        "entry_id": "f96a07a2-ed93-36ad-99f9-a77178faf2c0",
                                        "glosses": [
                                            "schaufelähnliches Werkzeug zum Umgraben der Erde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e0b187e-73bc-44c1-aa10-cb0c81a442d3",
                                                "sense_id": "191b5fb9-93d0-3cbd-8bd3-367dbd67c419",
                                                "text": "Der Spaten ist sehr schmal."
                                            },
                                            {
                                                "example_id": "40b67d71-dce6-4c74-8955-62112c566e78",
                                                "sense_id": "191b5fb9-93d0-3cbd-8bd3-367dbd67c419",
                                                "text": "„Denn selber Frühaufsteher, sah er, so früh er auch aufstand, seinen Pächter schon immer ungewaschen und ungekämmt mit Hacke und Spaten und Sichel emsig bei der Arbeit.“"
                                            },
                                            {
                                                "example_id": "518fa3b1-6e54-4f78-a47f-54cdef134382",
                                                "sense_id": "191b5fb9-93d0-3cbd-8bd3-367dbd67c419",
                                                "text": "„Der Spaten drang kaum mit der Spitze in den harten Lehm ein, und die so herausgestochenen gelben, zusammengetrockneten Klümpchen rutschten in den Graben zurück, bevor der Dulder mit übermenschlicher Anstrengung den Spaten nach hinten schwenken und den Lehm über den Grabenrand werfen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
