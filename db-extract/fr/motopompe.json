                "senses": [
                    {
                        "sense_id": "3286e83a-833b-37a5-b958-9b8b46f9aeb9",
                        "entry_id": "d3b950b0-51e4-3e10-92cb-7b34892eed9e",
                        "glosses": [
                            "Pompe pouvant être remorquée, munie de son propre moteur à combustion interne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a68b3108-f90e-426f-b7d3-6c1a7a778460",
                                "sense_id": "3286e83a-833b-37a5-b958-9b8b46f9aeb9",
                                "text": "Tout le temps qu’elle servit dans l’équipe de prospection, que ce soit à Binda ou Vuka, notre motopompe ne nous rapporta pas plus de 2,5 carats de diamant."
                            },
                            {
                                "example_id": "e37921f5-2d2c-40f7-a917-d8362ef2895b",
                                "sense_id": "3286e83a-833b-37a5-b958-9b8b46f9aeb9",
                                "text": "Depuis mardi, des opérations de vidange du bassin sont en cours à l'aide de trois motopompes des pompiers, en présence de la DIR Est."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a50d365-167b-3a62-8137-cf47999375ae",
                        "entry_id": "d3b950b0-51e4-3e10-92cb-7b34892eed9e",
                        "glosses": [
                            "Toute pompe actionnée par un moteur qui lui est propre."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
