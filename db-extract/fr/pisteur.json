                        ],
                        "form": "pisteuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c4c0ee8-f8dc-3eb7-825b-c720b4574f59",
                        "entry_id": "0572566d-f0ef-36a1-81c1-0ec65f3bcdf8",
                        "glosses": [
                            "Qui suit une piste pour retrouver quelqu’un ou quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1956704-9647-400a-a480-eea724a62935",
                                "sense_id": "5c4c0ee8-f8dc-3eb7-825b-c720b4574f59",
                                "text": "Le chien pisteur, celui qui débusquait les sentiers dont l’odeur s’harmonisait avec celle du voyageur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb98ac67-4e7f-4439-9057-2e214f2a0775",
                        "source_entry_id": "0572566d-f0ef-36a1-81c1-0ec65f3bcdf8",
                        "source_sense_id": "5c4c0ee8-f8dc-3eb7-825b-c720b4574f59",
                        "target_lang_word": "tracker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tracker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f88c8d0-f114-3554-9b17-a9c4bcb57517",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "Agent noun of track; one who, or that which, tracks or pursues, as a man or dog that follows game."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f383798b-3baa-43af-9b5f-759e964ae0e4",
                                                "sense_id": "8f88c8d0-f114-3554-9b17-a9c4bcb57517",
                                                "text": "On Friday night, eight US Air Force KC-135 Stratotankers took off from Altus, Oklahoma, according to data from FlightRadar24. Over Kansas the tankers refueled two groups of planes, identified on air traffic control audio by their callsigns MYTEE11 FLT and MYTEE21 FLT. The callsign MYTEE has previously been associated with special activity flights by B-2 bombers, and multiple flight trackers on social media said the planes being refueled were B-2 bombers out of Whiteman Air Force Base in Missouri."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "146e0944-2560-3357-9ac4-7c01515cfae0",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "Agent noun of track; one who, or that which, tracks or pursues, as a man or dog that follows game.",
                                            "A person employed to follow and monitor a political rival."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d21312d5-319f-41b5-bee8-7941b31acc6f",
                                                "sense_id": "146e0944-2560-3357-9ac4-7c01515cfae0",
                                                "text": "While she and Mr. Fetterman were often in different places, she would turn up at events early so she could shoot and post photos of the crowds, the lines, the people. At most events there was a tracker: a guy from the Oz team who monitored the goings-on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4c48db4-156b-3fbc-995b-b8865d0b95fd",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "In an organ, a light strip of wood connecting (in path) a key and a pallet, to communicate motion by pulling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cd5f5be-00c9-3dd7-9b75-e0023847101b",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "A type of computer software for composing music by aligning notes or samples on parallel timelines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60336015-1bb1-4f14-bd26-d052ce431c83",
                                                "sense_id": "2cd5f5be-00c9-3dd7-9b75-e0023847101b",
                                                "text": "Trackers have broken out of the demoscene, are are^([sic]) now in use by thousands of professional musicians. It's not uncommon to hear about people using trackers on DJ forums, and electronic music production communities[…]"
                                            },
                                            {
                                                "example_id": "a6883673-5bb5-4845-8b1e-f9b1b8ba473c",
                                                "sense_id": "2cd5f5be-00c9-3dd7-9b75-e0023847101b",
                                                "text": "Although there were a few game companies outside the Amiga scene that used a tracker format (Epic Mega-Games, for instance), the majority used the better-supported MIDI."
                                            },
                                            {
                                                "example_id": "994b5dfc-2a00-4b88-b4c9-90c19196192e",
                                                "sense_id": "2cd5f5be-00c9-3dd7-9b75-e0023847101b",
                                                "text": "At the time, tracking chiptunes (i.e. using trackers) was the fundamental method of chipmusic-making."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b0f7951-9d4a-3cb9-8e74-748a924bcedb",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "A musician who writes music in a tracker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80bbadf5-5cdf-4495-b951-002f100f5c41",
                                                "sense_id": "2b0f7951-9d4a-3cb9-8e74-748a924bcedb",
                                                "text": "You can always find musicians. There are more trackers than coders, pixelers, organizers, couriers, and designers combined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00bff621-c980-306a-b8e6-2fc2d7d82aa2",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "A computer program that monitors something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbf882be-4eb8-3797-971c-442bcfef1902",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "A computer program that monitors something.",
                                            "Server software that coordinates peers in the BitTorrent protocol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ae37aac-7196-35f2-a90d-454a5ecf6913",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "A tracker mortgage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "8cb51893-8154-3a68-90b1-3e169a178548",
                "word": "pisteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "02b2cc11-39e2-4d4e-8dae-3e96061ca7d1",
                        "entry_id": "8cb51893-8154-3a68-90b1-3e169a178548",
                        "tags": [
                            "plural"
                        ],
                        "form": "pisteurs"
                    },
                    {
                        "form_id": "a682ced9-b4fe-4d76-a34d-845fddf5e222",
                        "entry_id": "8cb51893-8154-3a68-90b1-3e169a178548",
                        "tags": [
                            "feminine"
                        ],
                        "form": "pisteuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "84048721-d54b-34d0-8091-65240398c855",
                        "entry_id": "8cb51893-8154-3a68-90b1-3e169a178548",
                        "glosses": [
                            "Personne qui suit une piste pour retrouver quelqu’un ou quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98e9d97e-fd62-49cd-a1d5-740bb2411911",
                                "sense_id": "84048721-d54b-34d0-8091-65240398c855",
                                "text": "Seule dans le Nodal 3, Susan attendait le retour de son pisteur."
                            },
                            {
                                "example_id": "632a2c3b-ac84-46bc-a45c-88628a19d4b4",
                                "sense_id": "84048721-d54b-34d0-8091-65240398c855",
                                "text": "Ahiga s’approcha du corps du pisteur Navajo sur lequel les mouches s’activaient déjà. Il le fit rouler avec son pied, afin que le cadavre fût face contre terre. Il se saisit de son poignard et se pencha sur lui. D’un geste précis, il entailla la peau au niveau de son front, puis, faisant un tour complet par la nuque, il revint à son point de départ. Il s’assit ensuite du côté de la tête et, les pieds bien calés contre les épaules du traître, arracha le cuir chevelu d’un coup sec. Le scalp céda avec un bruit de déchirure. Ahiga se redressa et tendit le lambeau sanguinolent à son père."
                            }
                        ]
                    },
                    {
                        "sense_id": "081eaeda-24a4-3a48-98bb-b91cae7dc8dd",
                        "entry_id": "8cb51893-8154-3a68-90b1-3e169a178548",
                        "glosses": [
                            "Personne qui suit une piste pour retrouver quelqu’un ou quelque chose.",
                            "Chasseur à l’affût des traces laissées par un gibier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b401751b-41d1-4f85-af35-1ab9a3462bf6",
                                "sense_id": "081eaeda-24a4-3a48-98bb-b91cae7dc8dd",
                                "text": "Un blanc peut pister, bien sûr, mais il ne sera jamais qu’un amateur face à un véritable pisteur africain."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1c31dc6-663e-3912-90a2-86d034080109",
                        "entry_id": "8cb51893-8154-3a68-90b1-3e169a178548",
                        "glosses": [
                            "Personne qui suit une piste pour retrouver quelqu’un ou quelque chose.",
                            "Personne suivant avec insistance des femmes."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "db379fae-f606-4326-ac06-655f91a73081",
                                "sense_id": "d1c31dc6-663e-3912-90a2-86d034080109",
                                "text": "Dans cet enfer bigarré de Montmartre, où les nègres viveurs et dédaigneux, les souteneurs, les pisteurs, les camelots, les bohèmes, les gigolos et les filles se croisent, se heurtent, se décrient et se mêlent, Fernande donc se trouvait seule et, ne sachant à qui se confier, sentait l’envahir un cruel désenchantement."
                            }
                        ]
                    },
                    {
                        "sense_id": "8141e1f5-ebf8-3419-a366-5e73bb938220",
                        "entry_id": "8cb51893-8154-3a68-90b1-3e169a178548",
                        "glosses": [
                            "Personne chargée de trouver des clients pour un hôtel, un restaurant."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f66bac72-c24a-48b6-b739-c68f772f1d37",
                                "sense_id": "8141e1f5-ebf8-3419-a366-5e73bb938220",
                                "text": "Anatole !… Anatole !, - lui criait son oncle de la rue - nous sommes chez Conception ! le pisteur de l'hôtel t’y mènera."
                            },
                            {
                                "example_id": "f1528a18-0895-475e-a262-05191faca3bb",
                                "sense_id": "8141e1f5-ebf8-3419-a366-5e73bb938220",
                                "text": "Le cabaret où il était entré, à une heure et demie, était une petite boîte qui s’appelait Le Parc aux Cerfs. Le pisteur et le barman se souvenaient de lui."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce1f2876-d6c6-3f59-9f1b-41369725b6ef",
                        "entry_id": "8cb51893-8154-3a68-90b1-3e169a178548",
                        "glosses": [
                            "Employé chargé d’accueillir les clients à l'entrée d’un hôtel."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7cd0db0f-7a56-423e-a07d-152a58aa775e",
                                "sense_id": "ce1f2876-d6c6-3f59-9f1b-41369725b6ef",
                                "text": "En face se dresse le Grand-Hôtel, avec son garage, sa pompe à essence, ses parasols et son portier à casquette galonnée qu’on appelle le pisteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbe469d5-57c8-34e3-82b1-3923be0023b0",
                        "entry_id": "8cb51893-8154-3a68-90b1-3e169a178548",
                        "glosses": [
                            "Moniteur de ski chargé d’entretenir l’état des pistes."
                        ],
                        "tags": [
                            "Sports d’hiver"
                        ],
                        "examples": [
                            {
                                "example_id": "9e01f3db-c7dd-46b5-a477-2f8dd70245f2",
                                "sense_id": "cbe469d5-57c8-34e3-82b1-3923be0023b0",
                                "text": "Dans la publicité des stations dites sportives , celles notamment où se pratique le \" ski hors piste\" , le pisteur a détrôné le moniteur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e24a1697-9cb3-4f33-9b1a-26aaefdf3145",
                        "source_entry_id": "8cb51893-8154-3a68-90b1-3e169a178548",
                        "target_lang_word": "Fährtenleser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fährtenleser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6828b03d-20e5-3d4f-8d8b-00c200f388d7",
                                        "entry_id": "080b2647-3c59-3e86-87e6-450a4594cb61",
                                        "glosses": [
                                            "Person, die in der Lage ist, Fährten aufzuspüren und aus ihnen Informationen zu gewinnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "378e5dc6-d3c9-4982-980e-439d707856a1",
                                                "sense_id": "6828b03d-20e5-3d4f-8d8b-00c200f388d7",
                                                "text": "„Zur Vorhut gehörte ein erfahrener Fährtenleser, aber der harte, kiesige Boden bot keinen Anhalt.“"
                                            },
                                            {
                                                "example_id": "a2c04424-2b5d-4620-8ae6-72b44ac2c093",
                                                "sense_id": "6828b03d-20e5-3d4f-8d8b-00c200f388d7",
                                                "text": "„›Kommen Sie‹, sagt Colter. ›Ich helfe Ihnen. Ich bin ein ziemlich guter Fährtenleser.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
