                "senses": [
                    {
                        "sense_id": "27d541c5-47d8-34ac-b283-7bc84c06d66b",
                        "entry_id": "650b219f-15b1-341c-960a-45505b14c3ce",
                        "glosses": [
                            "historische Entwicklung/Geschichte der Denkweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd11e866-ebfa-4bb6-b8a0-5f7637deac83",
                                "sense_id": "27d541c5-47d8-34ac-b283-7bc84c06d66b",
                                "text": "„Es muß nicht immer Lessing sein. Obwohl natürlich, wie Sie schon gelesen haben (…), eine Berufung auf die klangvollen Namen unserer Geistesgeschichte sich in hervorragender Weise dazu eignet, jeden Widerspruch oder auch nur den Anflug eines Zweifels von vornherein zu unterbinden.“"
                            },
                            {
                                "example_id": "d41c76ad-caaf-41d1-91e9-33b624047935",
                                "sense_id": "27d541c5-47d8-34ac-b283-7bc84c06d66b",
                                "text": "„Etwa um das Jahr 600 vor Christus geschah ein Einschnitt in der europäischen Geistesgeschichte, dessen Folgen nicht hoch genug eingeschätzt werden können.“"
                            },
                            {
                                "example_id": "7a919041-e3c2-4de0-ab1f-985a96981f5a",
                                "sense_id": "27d541c5-47d8-34ac-b283-7bc84c06d66b",
                                "text": "„In die Geistesgeschichte gehört er so wenig wie in die des Kunstromans; wohl aber in die Geschichte der Verarbeiter von sozialem Rohstoff, den er auf der großen Plantage der Hauptstadt ballenweise erntet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
