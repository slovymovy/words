                                                "example_id": "abb0e80a-f5f6-433c-8a08-4906d9ff87d0",
                                                "sense_id": "08d55754-5b6f-3f68-966c-1d0404ad32a0",
                                                "text": "Meine Mutter fährt jedes Jahr nach Rügen, um dort Fahrrad zu fahren."
                                            },
                                            {
                                                "example_id": "26dfeb5a-7666-4afd-a290-801c1e7cac85",
                                                "sense_id": "08d55754-5b6f-3f68-966c-1d0404ad32a0",
                                                "text": "Unseren letzten Urlaub verbrachten wir auf Rügen."
                                            },
