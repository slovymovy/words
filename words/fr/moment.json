                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Attends-moi ici un <w>moment</w>, je reviens tout de suite.",
                            "target_lang_translations": {
                                "en": "Wait for me here a <w>moment</w>, I'll be right back.",
                                "ru": "Подожди меня здесь <w>минутку</w>, я сейчас вернусь.",
                                "nl": "Wacht hier een <w>ogenblikje</w> op me, ik ben zo terug.",
                                "de": "Warte hier einen <w>Moment</w> auf mich, ich bin gleich zurück.",
                                "pl": "Poczekaj tu na mnie <w>chwilę</w>, zaraz wrócę.",
                                "it": "Aspettami qui un <w>momento</w>, torno subito.",
                                "cs": "Počkej tu na mě <w>chvilku</w>, hned se vrátím.",
                                "tr": "Beni burada bir <w>an</w> bekle, hemen geri geliyorum.",
                                "es": "Espérame aquí un <w>momento</w>, vuelvo enseguida.",
                                "zh": "在这儿等我<w>一会儿</w>，我马上回来。"
                            }
                        },
                        {
                            "text": "Nous avons passé un très bon <w>moment</w> ensemble hier soir.",
                            "target_lang_translations": {
                                "en": "We had a really good <w>time</w> together last night.",
                                "ru": "Вчера вечером мы отлично провели <w>время</w> вместе.",
                                "nl": "Gisteravond hebben we samen echt een fijne <w>tijd</w> gehad.",
                                "de": "Wir haben gestern Abend zusammen eine richtig schöne <w>Zeit</w> verbracht.",
                                "pl": "Wczoraj wieczorem spędziliśmy razem bardzo miłe <w>chwile</w>.",
                                "it": "Ieri sera abbiamo passato davvero un bel <w>momento</w> insieme.",
                                "cs": "Včera večer jsme spolu strávili moc hezké <w>chvíle</w>.",
                                "tr": "Dün akşam birlikte çok güzel <w>vakit</w> geçirdik.",
                                "es": "Anoche pasamos un <w>rato</w> muy agradable juntos.",
                                "zh": "昨天晚上我们一起度过了一段非常愉快的<w>时光</w>。"
                            }
                        }
