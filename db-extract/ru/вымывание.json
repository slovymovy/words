                "senses": [
                    {
                        "sense_id": "e670afb1-f737-3211-b2c2-855b9a48e9c0",
                        "entry_id": "714f2f46-e639-3ad9-996e-a6bd000fdceb",
                        "glosses": [
                            "устар. то же, что мытьё, очищение с помощью жидкости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba71744d-ec61-4c4d-a64f-579b07e1f22d",
                                "sense_id": "e670afb1-f737-3211-b2c2-855b9a48e9c0",
                                "text": "Наблюдать весьма чистоту в белье, неленостным вымыванием оного."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf722066-4910-3805-90b2-7dbe2d459567",
                        "entry_id": "714f2f46-e639-3ad9-996e-a6bd000fdceb",
                        "glosses": [
                            "удаление или уменьшение концентрации чего-либо потоками, струями жидкости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c3f59c8-b4e1-4ddd-8c4a-a476fe2a6624",
                                "sense_id": "bf722066-4910-3805-90b2-7dbe2d459567",
                                "text": "Переработка мерзлых берегов происходит в основном путем вытаивания и вымывания грунтов нижней части берега в виде ниши и нависания над ней верхней части берега в виде уступа."
                            }
                        ]
                    },
                    {
                        "sense_id": "30c46c95-c558-3e8c-9577-a1214e0dd713",
                        "entry_id": "714f2f46-e639-3ad9-996e-a6bd000fdceb",
                        "glosses": [
                            "перен. удаление, уменьшение количества чего-либо в результате добавления чего-либо дополнительного"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c6d19cd-fc48-43a0-a8e1-d159e184e508",
                                "sense_id": "30c46c95-c558-3e8c-9577-a1214e0dd713",
                                "text": "Кризис финансов и вымывание из оборота металлических денег не только наносили серьезный удар по экономике страны, но и подрывали политическую обстановку."
                            }
                        ]
                    }
