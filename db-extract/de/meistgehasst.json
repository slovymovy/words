                ],
                "senses": [
                    {
                        "sense_id": "25038bc2-42c8-382d-81a1-b7dbf4939b1f",
                        "entry_id": "ea8f18a7-ef0c-366c-b58f-469720712bab",
                        "glosses": [
                            "am meisten gehasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bde8c949-2b58-40f7-a2e1-24873996a10b",
                                "sense_id": "25038bc2-42c8-382d-81a1-b7dbf4939b1f",
                                "text": "„Für eine ganze Weile war ich die meistgehasste Person in Amerika.“"
                            },
                            {
                                "example_id": "7821ddf8-8982-4f19-9c71-05c9038d7f87",
                                "sense_id": "25038bc2-42c8-382d-81a1-b7dbf4939b1f",
                                "text": "„Die Wall Street ließ sich aus seinem Alltag als Vorstandsvorsitzender eines börsennotierten Unternehmens nicht verdrängen. Sie war meistgehasster Feind und bester Freund, Verbündeter und Widersacher in einem.“"
                            },
                            {
                                "example_id": "ee3edb81-4a55-4f33-8bda-7f3d53251a51",
                                "sense_id": "25038bc2-42c8-382d-81a1-b7dbf4939b1f",
                                "text": "„Du brauchst dringender einen Arzt als einen verfickten Solo-Kreuzzug zur Rettung des meistgehassten Menschen auf Gottes grüner Erde.“"
                            },
                            {
                                "example_id": "e29b4994-b47c-4d4a-aa65-765e81a8c7f6",
                                "sense_id": "25038bc2-42c8-382d-81a1-b7dbf4939b1f",
                                "text": "„Er war Jasper Boonstra, der meistgehasste Geschäftsmann im Land.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
