                        ],
                        "examples": [
                            {
                                "example_id": "a1351b60-40a6-44d5-9177-52a4beba92e5",
                                "sense_id": "b51fc53b-e5e9-3d0b-aeb9-759878c15de0",
                                "text": "Topless zonnen wordt in vele Arabische landen afgeraden."
                            },
                            {
                                "example_id": "7d37905d-48d2-48bb-a50a-a86bb6697236",
                                "sense_id": "b51fc53b-e5e9-3d0b-aeb9-759878c15de0",
                                "text": "En dan te bedenken dat je in Amerika niet eens topless op het strand mag liggen."
                            },
                            {
                                "example_id": "3f4aed4e-ca74-4c6c-b93c-7c4f279a6a2c",
                                "sense_id": "b51fc53b-e5e9-3d0b-aeb9-759878c15de0",
                                "text": "Enkele mannelijke beroemdheden braken een lans voor de mannenrok, inclusief blote benen. Andere heren kozen voor jassen of rokkostuums tot op de grond, waarmee ze een vrouwelijk silhouet creëerden. Model Cara Delevingne zette op haar beurt vrouwelijkheid centraal door topless doch bedekt met bodypaint te verschijnen."
                            }
                        ]
                    }
                ],
