                ],
                "senses": [
                    {
                        "sense_id": "b17e9b2e-c50e-31a6-b310-41cc4f2c5d23",
                        "entry_id": "5c9fa405-621c-35e5-a47f-900c5ba0c057",
                        "glosses": [
                            "To limit the number of possible values of a quantity, or states of a system, by applying the rules of quantum mechanics"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c66a207c-fd86-338b-b674-213b6539a081",
                        "entry_id": "5c9fa405-621c-35e5-a47f-900c5ba0c057",
                        "glosses": [
                            "To approximate a continuously varying signal by one whose amplitude can only have a set of discrete values"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fbba6d07-0198-3570-ade0-ea0e8c02ae65",
                        "entry_id": "5c9fa405-621c-35e5-a47f-900c5ba0c057",
                        "glosses": [
                            "To shift each beat in a rhythmic pattern to the nearest beat of a given resolution (eighth note, sixteenth note, etc.), or to adjust the frequency or pitch of a note to the nearest perfect tone in a given musical scale"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8f910f24-ef60-3fc3-8f9c-367af96caafa",
                        "entry_id": "5c9fa405-621c-35e5-a47f-900c5ba0c057",
                        "glosses": [
                            "To associate a given set of numbers with a set of numeric values in another encoding or numerical system (e.g. in a discrete mathematics)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc439cc8-d332-45aa-9354-02282d5ea369",
                        "source_entry_id": "5c9fa405-621c-35e5-a47f-900c5ba0c057",
                        "source_sense_description": "to limit the number of possible values",
                        "target_lang_word": "quantifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quantifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdc8158e-a0b0-3715-b9bc-8a20344ede2d",
                                        "entry_id": "9aab4ca1-c775-34a4-b63f-67be42b3630c",
                                        "glosses": [
                                            "Évaluer la quantité ; dénombrer ; évaluer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff91c930-60f2-483d-b372-9aadd9e53ba9",
                                                "sense_id": "bdc8158e-a0b0-3715-b9bc-8a20344ede2d",
                                                "text": "Il faut dire : avant que le travail humain ne se quantifiât en marchandises, le travail était déjà l'utilisation ou l'emploi de la force de travail. J'essaie de dire : avant que le travail humain ne se quantifiât en objets. Le travail était déjà incorporé et quantifiable chez les êtres humains."
                                            },
                                            {
                                                "example_id": "fe8fda80-f9c9-401e-8fc4-e0d43a7a85b5",
                                                "sense_id": "bdc8158e-a0b0-3715-b9bc-8a20344ede2d",
                                                "text": "Une fois l’intermittence des signaux quantifiée, il est possible de séparer l’influence de cette disparition sur la fluctuation de fréquence."
                                            },
                                            {
                                                "example_id": "f157bcb5-f4da-4d10-b0d7-4229231fb7ab",
                                                "sense_id": "bdc8158e-a0b0-3715-b9bc-8a20344ede2d",
                                                "text": "— […]. En fait elle est aussi nulle que toi.\nBennett réfléchit quelques temps, en se demandant comment on quantifiait la nullité.\n— Peut-être même encore plus nulle, dit-il au bout d'un moment de réflexion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "415d6dc4-d851-3102-90fc-9ca736abfd32",
                                        "entry_id": "9aab4ca1-c775-34a4-b63f-67be42b3630c",
                                        "glosses": [
                                            "Synonyme de discrétiser."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4390686c-c573-358b-b63a-50f505fac05a",
                                        "entry_id": "9aab4ca1-c775-34a4-b63f-67be42b3630c",
                                        "glosses": [
                                            "Appliquer la physique quantique à un problème de physique classique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6aba786-1b80-4a2a-ac7e-0490aa587b27",
                                                "sense_id": "4390686c-c573-358b-b63a-50f505fac05a",
                                                "text": "Quantifier l’électrodynamique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c43acb6-1076-4e69-b460-ee1799061f5f",
                        "source_entry_id": "5c9fa405-621c-35e5-a47f-900c5ba0c057",
                        "source_sense_description": "to limit the number of possible values",
                        "target_lang_word": "discrétiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discrétiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40fb58be-2981-35f2-b906-b4b269156804",
                                        "entry_id": "b0307c3a-5f3f-3e58-9143-ebe0659e6286",
                                        "glosses": [
                                            "Rendre discret, dégager des valeurs individuelles à partir de quelque chose de continu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82877674-7bb2-4a47-a263-a22dd1894ba2",
                                                "sense_id": "40fb58be-2981-35f2-b906-b4b269156804",
                                                "text": "Ceci dit, reste à savoir comment discrétiser au mieux les variables."
                                            },
                                            {
                                                "example_id": "71c2c7e2-25b3-49f6-9e1d-9edaffc23806",
                                                "sense_id": "40fb58be-2981-35f2-b906-b4b269156804",
                                                "text": "Cette même problématique du choix des variables à discrétiser se retrouve pour les modèles de Maxwell-Debye et Maxwell Lorentz (cf. chapitre 11)."
                                            },
                                            {
                                                "example_id": "6e105d9b-a891-4b1d-ac60-d3769651db05",
                                                "sense_id": "40fb58be-2981-35f2-b906-b4b269156804",
                                                "text": "Il est à noter que des variables numériques peuvent être présentées dans un tableau de contingence, à condition de les discrétiser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3a68070-a9a3-4194-9c14-b444bf6ca952",
                        "source_entry_id": "5c9fa405-621c-35e5-a47f-900c5ba0c057",
                        "source_sense_description": "to limit the number of possible values",
                        "target_lang_word": "quantisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quantisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef87467c-8b14-3257-a4ac-c99322b6044c",
                                        "entry_id": "6f1c9712-f755-3401-8d43-9ed8d096c12b",
                                        "glosses": [
                                            "in messbare Größen unterteilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a308dd-d3d0-4c6a-b2ed-4ae31d6ddd5b",
                                                "sense_id": "ef87467c-8b14-3257-a4ac-c99322b6044c",
                                                "text": "„Im Alltag nehmen wir oft gar nicht mehr bewußt wahr, daß wir quantisieren. Längenangaben machen wir eben in Metern oder auch Kilometern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21413611-8326-3627-b807-b43a6dfa05d1",
                                        "entry_id": "6f1c9712-f755-3401-8d43-9ed8d096c12b",
                                        "glosses": [
                                            "Audio- oder MIDI-Dateien rhythmisch korrigieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e92cfc61-c23a-4f40-ba13-d9f1eaa35399",
                                                "sense_id": "21413611-8326-3627-b807-b43a6dfa05d1",
                                                "text": "„Wenn Sie mit dem Timing einer Audioaufnahme nicht zufrieden sind, können Sie diese quantisieren, um die Positionen einzelner Noten zu korrigieren.“"
                                            },
                                            {
                                                "example_id": "453da7a6-ac35-45e4-b7e1-cb65bbcdad3d",
                                                "sense_id": "21413611-8326-3627-b807-b43a6dfa05d1",
                                                "text": "In den folgenden Übungen importieren Sie einen Drum-Loop in Ihr Projekt, wählen einen Flex-Modus aus, mit dem Logic die Anfänge der Noten oder die einzelnen Schläge der Drums in der Audiodatei aufspürt, und quantisieren die Audioregion, um die zeitliche Position zu korrigieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
