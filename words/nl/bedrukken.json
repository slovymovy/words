                    "sense_id": "64a47f7e-3350-3d32-8e58-ffba9a1d5cb6",
                    "sense_definition": "een tekst of afbeelding op een voorwerp of materiaal aanbrengen via een drukproces",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "drukwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vereniging laat nieuwe shirts <w>bedrukken</w> met hun eigen logo.",
                            "target_lang_translations": {
                                "fr": "L'association fait <w>imprimer</w> de nouveaux maillots avec son propre logo."
                            }
                        },
                        {
                            "text": "De etiketten worden zorgvuldig met een speciale tekst <w>bedrukt</w>.",
                            "target_lang_translations": {
                                "fr": "Les étiquettes sont soigneusement <w>imprimées</w> avec un texte spécial."
                            }
                        }
                    ],
                    "common_phrases": [
                        "t-shirts bedrukken",
                        "met een logo bedrukken"
                    ],
                    "target_lang_definitions": {
                        "fr": "Appliquer un texte ou une image sur un objet ou un matériau au moyen d'un procédé d'impression"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "imprimer",
                                "target_lang_sense_clarification": "sur un support, un vêtement, etc."
                            },
                            {
                                "target_lang_word": "sérigraphier",
                                "target_lang_sense_clarification": "imprimer via sérigraphie"
                            },
                            {
                                "target_lang_word": "marquer",
                                "target_lang_sense_clarification": "apposer un visuel ou un logo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dfd37a6-0537-3276-9b7b-3757b6dcaf48",
                    "sense_definition": "iemand een somber of terneergeslagen gevoel bezorgen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het slechte nieuws over haar gezondheid <w>bedrukte</w> de hele familie.",
                            "target_lang_translations": {
                                "fr": "La mauvaise nouvelle concernant sa santé a <w>attristé</w> toute la famille."
                            }
                        },
                        {
                            "text": "De aanhoudende financiële zorgen <w>bedrukken</w> hem al wekenlang.",
                            "target_lang_translations": {
                                "fr": "Les soucis financiers permanents l'<w>oppressent</w> depuis des semaines."
                            }
                        }
                    ],
                    "synonyms": [
