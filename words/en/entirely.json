                                "zh": "我承认这个错误<w>完全</w>是我的责任。",
                                "pl": "Przyznaję, że <w>całkowicie</w> ponoszę winę za ten błąd.",
                                "de": "Ich gebe zu, dass ich <w>vollkommen</w> allein an dem Fehler schuld bin.",
                                "nl": "Ik geef toe dat de fout <w>volledig</w> aan mij te wijten is.",
                                "fr": "Je reconnais que je suis <w>entièrement</w> responsable de cette erreur.",
                                "it": "Ammetto di essere <w>interamente</w> responsabile dell'errore.",
                                "cs": "Přiznávám, že za tuto chybu nesu vinu <w>zcela</w> já.",
                                "tr": "Hatanın <w>tamamen</w> benim suçum olduğunu kabul ediyorum.",
                                "es": "Admito que soy <w>enteramente</w> culpable del error."
                            }
