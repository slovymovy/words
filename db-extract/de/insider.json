                        "form": "die Insider"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5e35f81-7f4f-3424-8e99-1451f5ccb609",
                        "entry_id": "24ae2a7c-b044-3947-89e8-ff9af0f30c86",
                        "glosses": [
                            "jemand, der über interne Informationen auf einem Gebiet verfügt; ein Eingeweihter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "875c0f6e-2406-4691-8fbf-7b872c79214b",
                                "sense_id": "d5e35f81-7f4f-3424-8e99-1451f5ccb609",
                                "text": "Diese Kundgebung ist eigentlich nur für Insider interessant."
                            },
                            {
                                "example_id": "497e0f17-2771-478c-873f-1588e53df511",
                                "sense_id": "d5e35f81-7f4f-3424-8e99-1451f5ccb609",
                                "text": "„Ende vergangener Woche, erzählt ein Insider, wurden derweil irgendwo in Potsdam neue Dateien vom Laptop gezogen und in einen Umschlag gesteckt.“"
                            },
                            {
                                "example_id": "80d47f77-d884-4f13-bc7c-2eaa7dc8f2f2",
                                "sense_id": "d5e35f81-7f4f-3424-8e99-1451f5ccb609",
                                "text": "„Hinter Paarreim und Lautmalerei, hinter Alliterationen und Metaphorik spürt man die mit Konsequenz geführte Feder eines Insiders, der das, was er berichtet, selbst erlebt hat.“"
                            },
                            {
                                "example_id": "37f414fa-e148-48c0-b7e0-6e21db93eedc",
                                "sense_id": "d5e35f81-7f4f-3424-8e99-1451f5ccb609",
                                "text": "„Laut Insidern waren es etwa 11,8 Millionen Euro.“"
                            },
                            {
                                "example_id": "b862fd62-2b93-4753-ad75-681b73bd8f9e",
                                "sense_id": "d5e35f81-7f4f-3424-8e99-1451f5ccb609",
                                "text": "„Auch das Festival war etwas für Insider.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cd375ac0-bb6b-361b-a566-d283be18871a",
                        "entry_id": "24ae2a7c-b044-3947-89e8-ff9af0f30c86",
                        "glosses": [
                            "Mitglied einer Gruppe; Person, die zu einer bestimmten Gemeinschaft gehört und dort integriert ist"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0a2d5236-ea9d-3ba2-a86e-fe191765047c",
                        "entry_id": "24ae2a7c-b044-3947-89e8-ff9af0f30c86",
                        "glosses": [
                            "ein Witz, den man nur versteht, wenn man bestimmte Hintergrundinformationen kennt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "88348404-0d6a-4712-9ad7-c7df9b245f3b",
                                "sense_id": "0a2d5236-ea9d-3ba2-a86e-fe191765047c",
                                "text": "„Ich versteh den Witz nicht.“ - „Kein Wunder, ist ja auch ein Insider.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68ec8aae-733d-4e1c-8c94-445d65445cb5",
                        "source_entry_id": "24ae2a7c-b044-3947-89e8-ff9af0f30c86",
                        "source_sense_id": "d5e35f81-7f4f-3424-8e99-1451f5ccb609",
                        "source_sense_description": "jemand, der über interne Informationen auf einem Gebiet verfügt; ein Eingeweihter",
                        "target_lang_word": "insider",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insider",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad762c0e-6306-3a19-813f-45c5d9e5295d",
                                        "entry_id": "b1a0eb87-dbb6-3e15-848d-3d75283dd55e",
                                        "glosses": [
                                            "A person who has special knowledge about the inner workings of a group, organization, or institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90e2ac29-da59-4e28-b2c5-4d0650b7793d",
                                                "sense_id": "ad762c0e-6306-3a19-813f-45c5d9e5295d",
                                                "text": "Near-synonyms: initiate, old hand, habitué"
                                            },
                                            {
                                                "example_id": "56a483be-fdaf-4612-a228-a68b75aaadca",
                                                "sense_id": "ad762c0e-6306-3a19-813f-45c5d9e5295d",
                                                "text": "Heavy losses were sustained in Simms Petroleum, which took a greater toll from supposed \"Wall Street insiders\" than from the general public."
                                            },
                                            {
                                                "example_id": "62710243-4e98-48b8-8ee3-24852e250f20",
                                                "sense_id": "ad762c0e-6306-3a19-813f-45c5d9e5295d",
                                                "text": "He is also an astute ANC insider who spent ten years on Robben Island alongside Nelson Mandela and the other “grandees” of the movement."
                                            },
                                            {
                                                "example_id": "dc3c9760-fc11-4f03-864c-f00195164934",
                                                "sense_id": "ad762c0e-6306-3a19-813f-45c5d9e5295d",
                                                "text": "In a thread called “Calm Before the Storm”, and in subsequent posts, Q established his legend as a government insider with top security clearance who knew the truth about a secret struggle for power involving Donald Trump, the “deep state”, Robert Mueller, the Clintons, pedophile rings, and other stuff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c80b078e-086b-3dfc-a6b6-cd48b6bac2d3",
                                        "entry_id": "b1a0eb87-dbb6-3e15-848d-3d75283dd55e",
                                        "glosses": [
                                            "A person who is within an enclosed space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "325d4a63-f945-4fc1-a94a-490b6712d4c5",
                                                "sense_id": "c80b078e-086b-3dfc-a6b6-cd48b6bac2d3",
                                                "text": "To the insider, the ceiling is like a small firmament twinkling with astral radiations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f414a88-3802-4e37-96c1-a30b31bcb5ae",
                        "source_entry_id": "24ae2a7c-b044-3947-89e8-ff9af0f30c86",
