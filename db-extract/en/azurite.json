                        "tags": [
                            "plural"
                        ],
                        "form": "azurites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e9e6743-aa47-3e2a-bc80-72c2b3348f9a",
                        "entry_id": "1bae22e2-80b0-3ac8-a54f-18402a8a4fed",
                        "glosses": [
                            "A blue vitreous mineral; a basic hydrated copper carbonate, with the chemical formula Cu²⁺₃(CO₃)₂(OH)₂, used since antiquity as a blue pigment or ores to extract metallic copper."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5f1b020-6d8a-4873-a1a4-9b991fddb337",
                        "source_entry_id": "1bae22e2-80b0-3ac8-a54f-18402a8a4fed",
                        "source_sense_id": "3e9e6743-aa47-3e2a-bc80-72c2b3348f9a",
                        "source_sense_description": "blue, vitreous mineral",
                        "target_lang_word": "azurite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "azurite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                                        "entry_id": "9e8f98f8-327a-3990-b13a-cfe95b5288d7",
                                        "glosses": [
                                            "Minéral de couleur bleue composé à l’état naturel de carbonate de cuivre, de formule Cu₃(CO₃)₂(OH)₂, et servant de minerai de cuivre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2face427-b997-4ff0-a062-c1a907d2b0c4",
                                                "sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                                                "text": "Le bleu intense caractéristique de l’azurite se retrouve dans la majeure partie des tableaux des siècles passés. Réduits en poudre très fine et mélangés à des liants appropriés, les minéraux d’azurite étaient transformés en précieux pigments picturaux."
                                            },
                                            {
                                                "example_id": "117eb2c1-bc89-448d-a6bc-b11f8f8aa58e",
                                                "sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                                                "text": "L’azurite peut être utilisée, comme la malachite comme pigment."
                                            },
                                            {
                                                "example_id": "aa9cb854-221d-407d-a364-45fb5eb74455",
                                                "sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                                                "text": "Dans la collection Guyonneau, sont remarquables les azurites et les tourmalines, dont une énorme en forme de cristal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "azurite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db8171c5-4ffa-3386-9a13-cb4780483761",
                                        "entry_id": "c6dbd7c7-b724-33b7-89ab-931a914d21a3",
                                        "glosses": [
                                            "Plante vivace appartenant au genre Echinops, synonyme d’oursin bleu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
