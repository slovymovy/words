    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "796e4e25-c7d1-332a-b759-d16f69391f2b",
                "word": "Ephraim",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fd83a4fb-eca1-312b-9d2b-8469a9dcee58",
                        "entry_id": "796e4e25-c7d1-332a-b759-d16f69391f2b",
                        "glosses": [
                            "The younger son of Joseph in the Bible, eponymous ancestor of one of the twelve tribes of Israel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac51f3fb-e425-4848-bd91-feafa88fe4a6",
                                "sense_id": "fd83a4fb-eca1-312b-9d2b-8469a9dcee58",
                                "text": "And the name of the second called he Ephraim: For God hath caused me to be fruitful in the land of my affliction."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dde1952-97fe-3fd6-8c0c-74ef3878a5e8",
                        "entry_id": "796e4e25-c7d1-332a-b759-d16f69391f2b",
                        "glosses": [
                            "A male given name from Hebrew."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "726f8ced-782b-327c-8052-7eee54293d6e",
                        "entry_id": "796e4e25-c7d1-332a-b759-d16f69391f2b",
                        "glosses": [
                            "A hunter's name for the grizzly bear."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "242066aa-f0a8-4a43-bfd4-ce2259c5f2f9",
                        "source_entry_id": "796e4e25-c7d1-332a-b759-d16f69391f2b",
                        "source_sense_description": "the younger son of Joseph",
                        "target_lang_word": "Éphraïm",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Éphraïm",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a15e258-073a-30d1-ad99-749ae672cbc5",
                                        "entry_id": "71a2b5ce-977f-3f7b-b897-38f85013c8d9",
                                        "glosses": [
                                            "Second fils d’Asnath et de Joseph, frère de Manassé, patriarche de l’une des douze tribus d’Israël."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40d46f17-6e69-4070-89fa-668152ea76d6",
                                                "sense_id": "7a15e258-073a-30d1-ad99-749ae672cbc5",
                                                "text": "— Malheur à toi, ô peuple ! et aux traîtres de Juda, aux ivrognes d’Éphraïm, à ceux qui habitent la vallée grasse, et que les vapeurs du vin font chanceler !"
                                            },
                                            {
                                                "example_id": "aec4220f-a992-45e9-8cdd-12ddc48dbe14",
                                                "sense_id": "7a15e258-073a-30d1-ad99-749ae672cbc5",
                                                "text": "C’est lui qui avait amené, presque de force, le gras M. Luska, Éphraïm Luska, aux cuisses si épaisses qu’elles l’obligeaient à marcher les jambes écartées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e78a6ac-54e6-48a5-8c48-8e49c1979100",
                        "source_entry_id": "796e4e25-c7d1-332a-b759-d16f69391f2b",
                        "source_sense_description": "the younger son of Joseph",
                        "target_lang_word": "Efrem",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "dcf8a135-f36d-4887-a5fb-30e151e460fb",
                        "source_entry_id": "796e4e25-c7d1-332a-b759-d16f69391f2b",
                        "source_sense_description": "the younger son of Joseph",
                        "target_lang_word": "Efraim",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Efraim",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "09f378da-1c29-3e28-86ce-7d3831b8be82",
                                        "entry_id": "bc8ee51f-05df-3e4c-830a-725970048281",
                                        "glosses": [
                                            "imię męskie"
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb6b170e-6dbb-4488-8356-c66be66b71bf",
                                                "sense_id": "09f378da-1c29-3e28-86ce-7d3831b8be82",
                                                "text": "Ja mu sam włożę jarzmo na wspaniałą szyję, / sam Efraima zaprzęgnę, / orać będzie Juda, / Jakub zaś będzie bronował"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Efraim",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "f3e4f413-23c1-3124-8544-933957e38c0c",
                                        "entry_id": "2dd0204e-a01d-37e7-b3c4-a237eea7dc2f",
                                        "glosses": [
                                            "nazwa jednego z dawnych plemion Izraela"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9232a414-afaa-4db4-a560-4abfdde749ff",
                                                "sense_id": "f3e4f413-23c1-3124-8544-933957e38c0c",
                                                "text": "Odrzucił namiot Józefa / i nie wybrał szczepu Efraima, / lecz wybrał pokolenie Judy, / górę Syjon, którą umiłował"
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    },
                                    {
                                        "sense_id": "395ed061-fa37-3667-be9e-ba2399636a1f",
                                        "entry_id": "2dd0204e-a01d-37e7-b3c4-a237eea7dc2f",
                                        "glosses": [
                                            "jeden z regionów Izraela w środkowej części tego kraju"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1647104-2929-43ce-95bb-9da935d22ae9",
                                                "sense_id": "395ed061-fa37-3667-be9e-ba2399636a1f",
                                                "text": "Aram stanął obozem w Efraimie!"
                                            }
                                        ],
                                        "sense_index_json": "\"2.2\""
                                    }
                                ]
                            }
                        ]
