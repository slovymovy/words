                "forms": [],
                "senses": [
                    {
                        "sense_id": "719187f5-05b6-33ba-907a-df47979f30d4",
                        "entry_id": "e8f32d1a-211c-3f39-8593-422ecbfbd981",
                        "glosses": [
                            "noch naar rechts noch naar links van richting veranderend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1d86a1f-1aaa-45ad-acbd-fc14101c2e82",
                                "sense_id": "719187f5-05b6-33ba-907a-df47979f30d4",
                                "text": "Bij het volgende stoplicht ga je rechtdoor en daarna rechtsaf."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83642b88-c9e5-4ac2-8772-f4ee25679b1e",
                        "source_entry_id": "e8f32d1a-211c-3f39-8593-422ecbfbd981",
                        "source_sense_id": "719187f5-05b6-33ba-907a-df47979f30d4",
                        "source_sense_description": "noch naar rechts noch naar links van richting veranderend",
                        "target_lang_word": "tout droit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tout droit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2e917a1-5fba-37e1-9261-1482d7ca7e8d",
                                        "entry_id": "245760ad-5b6c-342e-ad5b-11014521132b",
                                        "glosses": [
                                            "En avant et sans dévier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c38a632c-55b3-4b8c-9613-151e93f5b8fc",
                                                "sense_id": "d2e917a1-5fba-37e1-9261-1482d7ca7e8d",
                                                "text": "Allez tout droit au bout de la rue et là-bas vous trouverez le magasin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c07a935c-d131-3b40-87b3-af2b9039511b",
                                        "entry_id": "245760ad-5b6c-342e-ad5b-11014521132b",
                                        "glosses": [
                                            "Directement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfc27256-7213-4736-9b2b-bec2350ec195",
                                                "sense_id": "c07a935c-d131-3b40-87b3-af2b9039511b",
                                                "text": "Kruger et le président Steyn, celui de l’État Libre, se sont rencontrés à ce qu’on dit, et on va tout droit vers une nouvelle guerre. C’est pour ça que je suis rentré."
                                            },
                                            {
                                                "example_id": "ad7f6da4-5305-491b-b170-f4d482e46b7b",
                                                "sense_id": "c07a935c-d131-3b40-87b3-af2b9039511b",
                                                "text": "– Je sais, dit Tarrou sans préambule, que je puis parler tout droit avec vous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c62fcf0-9768-49c8-b8d4-1aada7c02ac1",
                        "source_entry_id": "e8f32d1a-211c-3f39-8593-422ecbfbd981",
                        "source_sense_id": "719187f5-05b6-33ba-907a-df47979f30d4",
                        "source_sense_description": "noch naar rechts noch naar links van richting veranderend",
                        "target_lang_word": "напрямик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "напрямик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c97f4310-f419-34e2-8aa2-59b9a03f5630",
                                        "entry_id": "5757d96b-10af-36b0-890b-5e0f83d5b498",
                                        "glosses": [
                                            "разг. по прямой линии; кратчайшим путём"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55c31117-1c25-44cc-ab40-9fd03c2546e7",
                                                "sense_id": "c97f4310-f419-34e2-8aa2-59b9a03f5630",
                                                "text": "Если бы птица полетела напрямик с моря через горы, то, наверное, не встретила бы ни одного жилья, ни одной живой души на расстоянии пятисот верст и больше…"
                                            },
                                            {
                                                "example_id": "72f14706-755e-440d-ae12-4d673e0b7987",
                                                "sense_id": "c97f4310-f419-34e2-8aa2-59b9a03f5630",
                                                "text": "Отряд шёл к стойбищу напрямик, по степной сакме."
                                            },
                                            {
                                                "example_id": "22d89fb7-cd2f-4a94-9fc7-8e8b93015fb3",
                                                "sense_id": "c97f4310-f419-34e2-8aa2-59b9a03f5630",
                                                "text": "Он скакал, объезжая каждый куст, каждую канаву, при спусках замедляя аллюр, наши скакали напрямик и, конечно, легко его поймали."
                                            },
                                            {
                                                "example_id": "5fcb2002-bf88-43bc-98f3-527d36d7d18d",
                                                "sense_id": "c97f4310-f419-34e2-8aa2-59b9a03f5630",
                                                "text": "Весело наискось глубоко всадить топор и потом напрямик подсечь подкошенное и дальше, и дальше врубаться в дерево."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63917465-61c0-39a6-ae65-1be891231759",
                                        "entry_id": "5757d96b-10af-36b0-890b-5e0f83d5b498",
                                        "glosses": [
                                            "перен., разг. без обиняков; откровенно, прямо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f3d1113-2089-4b3a-9c69-74ed6c791584",
                                                "sense_id": "63917465-61c0-39a6-ae65-1be891231759",
                                                "text": "— Нет, скажи напрямик, ты не хочешь играть?"
                                            },
                                            {
                                                "example_id": "8a2572c1-7c66-464c-a589-cade0f83cdc7",
                                                "sense_id": "63917465-61c0-39a6-ae65-1be891231759",
                                                "text": "Но едва успел он выехать со двора, как отец её вошёл, и напрямик велел ей быть готовой на завтрашний день."
                                            },
                                            {
                                                "example_id": "f08c9eb7-5292-4fc0-86cf-a903512ea83d",
                                                "sense_id": "63917465-61c0-39a6-ae65-1be891231759",
                                                "text": "— Пожалуйста, без извинений! спрашивайте напрямик. В чём вы извиняетесь?"
                                            },
                                            {
                                                "example_id": "c8829130-3885-4ecc-8a41-11eb79e3b6e3",
                                                "sense_id": "63917465-61c0-39a6-ae65-1be891231759",
                                                "text": "— Нет уж, вы напрямик скажите, Патап Максимыч, можно нам надеяться аль не можно?"
                                            },
                                            {
                                                "example_id": "5a23694d-843c-47cb-b9a2-87e7d420e15f",
                                                "sense_id": "63917465-61c0-39a6-ae65-1be891231759",
                                                "text": "А вы степенно скажите, что нам, казакам, надо держаться за генерала Корнилова, как дитю за материн подол. Это без всяких лукавствий, напрямик!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53e01ba3-5246-3074-8f03-e1ae20591143",
                                        "entry_id": "5757d96b-10af-36b0-890b-5e0f83d5b498",
                                        "glosses": [
                                            "употребляется как несогласованное определение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76adcec0-304d-4898-afe3-136ea37795dd",
                                                "sense_id": "53e01ba3-5246-3074-8f03-e1ae20591143",
                                                "text": "Кто любит верховую езду, кому случалось пускать во всю мочь коня на охоте или на войне, тот поймет, почему Лев Николаевич избегает скучных, проторенных, заезженных дорог и предпочитает езду напрямик, по невидимым дорожкам, среди неведомых полей, где ближе к природе, к лесной чаще, к нетронутой первобытности."
                                            },
                                            {
                                                "example_id": "68b90ee4-ffdf-41a7-8c15-a19cabaeea60",
                                                "sense_id": "53e01ba3-5246-3074-8f03-e1ae20591143",
                                                "text": "Хамство напрямик, в лоб, встречается на каждом шагу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26492660-8bf1-4092-95ec-fdb4bb337596",
                        "source_entry_id": "e8f32d1a-211c-3f39-8593-422ecbfbd981",
