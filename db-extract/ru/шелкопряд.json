                        "source_sense_id": "cc9ecbc5-df5c-3826-b340-1cc563e348f5",
                        "target_lang_word": "Seidenspinner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seidenspinner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef3f8d64-7536-3259-a091-d4f60650e9f7",
                                        "entry_id": "6a76f7c8-355e-3852-a010-be73b9153139",
                                        "glosses": [
                                            "ursprünglich in China beheimateter Schmetterling, dessen Larven (Seidenraupen) zur Herstellung von Seide genutzt werden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb9dbd43-8e75-4cef-baca-c986e369e1cd",
                                                "sense_id": "ef3f8d64-7536-3259-a091-d4f60650e9f7",
                                                "text": "Der Seidenspinner oder Maulbeerspinner ist ein ursprünglich in China beheimateter Schmetterling aus der Familie der Echten Spinner."
                                            },
                                            {
                                                "example_id": "912ebb4a-2b65-441f-aa3f-6d3dc9af5a6f",
                                                "sense_id": "ef3f8d64-7536-3259-a091-d4f60650e9f7",
                                                "text": "„Die weltweit meistgegessenen Insekten wurden ignoriert: Puppen der Seidenspinner, Raupen afrikanischer Nachtfalter, Ameisen, Termiten, Bienenbrut, Wespen, Hornissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9873173-8cdf-3fcb-8298-2e4a6114e3de",
                                        "entry_id": "6a76f7c8-355e-3852-a010-be73b9153139",
                                        "glosses": [
                                            "Angehöriger der Familie Bombycidae innerhalb der Schmetterlinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ee8151-39e4-424d-a64d-86f8c3479fc5",
                                                "sense_id": "f9873173-8cdf-3fcb-8298-2e4a6114e3de",
                                                "text": "„Anfang August ist die Flugzeit des Japanischen Seidenspinners, mit 14,5 cm Flügelspannweite einer der größten Schmetterlinge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93843f93-89d9-4bbf-8959-4a8652823066",
                        "source_entry_id": "54fd72e8-0397-3e67-b2f2-fbba061f7fc1",
                        "source_sense_id": "cc9ecbc5-df5c-3826-b340-1cc563e348f5",
