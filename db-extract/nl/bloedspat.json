                "senses": [
                    {
                        "sense_id": "18e11fe5-ff7c-329f-b52a-c3cb283d8bcd",
                        "entry_id": "6c478e30-b680-31f1-bdc5-9e0d34d18123",
                        "glosses": [
                            "druppel bloed die ergens met kracht tegenaan gevallen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9843e92d-5b27-441b-a022-d4f00a3d5ee3",
                                "sense_id": "18e11fe5-ff7c-329f-b52a-c3cb283d8bcd",
                                "text": "Frans J. had de auto en allerlei andere spullen van Peters in zijn bezit, inclusief foto's die Peters nog maakte van een Koninginnedagconcert. Ook belde hij later uit naam van Peters met diens telefoon en zocht hij op internet naar termen zoals lijkbezorging, dood, kogel door hoofd, en het wapen dat bij de spullen van Peters werd gevonden. In J.'s auto zat een bloedspat van Peters."
                            },
                            {
                                "example_id": "4428cfba-28cd-404d-8793-f8da7edef697",
                                "sense_id": "18e11fe5-ff7c-329f-b52a-c3cb283d8bcd",
                                "text": "H. verbleef ten tijde van de twee moorden op de Brunssummerheide, op 7 mei, in het huis van zijn ouders in Brunssum. Hij verliet het pand om circa 10.15 uur en keerde om 13.30 uur terug, met bloedspatten op zijn kleding en geestelijk verward. Het OM wijst erop dat toen al bekend was dat er twee ernstige misdrijven op de heide hadden plaatsgevonden. Ook was de moord in Den Haag, drie dagen eerder, ruimschoots landelijk in het nieuws geweest."
                            }
                        ]
                    }
