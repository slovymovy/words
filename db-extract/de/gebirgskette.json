                                "target_senses": [
                                    {
                                        "sense_id": "43b6d1f7-0fda-3837-a684-023a912c4d94",
                                        "entry_id": "02232d75-03bb-3ab9-8f52-d1a13b6d3d48",
                                        "glosses": [
                                            "Relief rassemblant plusieurs montagnes, sommets, pics, monts et autres aiguilles, né soit de la collision de deux plaques continentales, soit de la subduction d’une plaque océanique sous une plaque océanique ou continentale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b98e88c-3175-4d10-895f-64c372fab51b",
                                                "sense_id": "43b6d1f7-0fda-3837-a684-023a912c4d94",
                                                "text": "Une chaîne de montagnes active présente généralement des pentes importantes et des formes acérées, alors qu’une chaîne de montagnes inactive présente généralement des formes plus douces."
                                            }
                                        ]
