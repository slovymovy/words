                                        "entry_id": "d09ee64c-60d8-324e-8b47-8afbed393b45",
                                        "glosses": [
                                            "zu einem früheren Zeitpunkt als erwartet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da457e7f-ef85-430e-95b4-1c6a9781c37a",
                                                "sense_id": "54cabf8c-3814-3889-9088-99c20b25eb52",
                                                "text": "Er konnte schon mit 5 Jahren lesen."
                                            },
                                            {
                                                "example_id": "8f9732d7-6d1c-422c-bed7-68b04ff9b9c3",
                                                "sense_id": "54cabf8c-3814-3889-9088-99c20b25eb52",
                                                "text": "Du bist schon da? Ich dachte, du arbeitest heute länger."
                                            },
                                            {
                                                "example_id": "785a2281-775c-43fb-b71c-a8cba15b2c88",
                                                "sense_id": "54cabf8c-3814-3889-9088-99c20b25eb52",
                                                "text": "Ach, heute schon."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
