                "senses": [
                    {
                        "sense_id": "418883f6-f67d-3b9d-80cf-ecb341c6a46c",
                        "entry_id": "83712001-575c-30d3-9b3c-9a693a71cd52",
                        "glosses": [
                            "meist erbliche Anomalie der Netzhaut, bei der Farben falsch wahrgenommen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cf421ef-e49a-41ee-b453-8c24dbf79d02",
                                "sense_id": "418883f6-f67d-3b9d-80cf-ecb341c6a46c",
                                "text": "„Die Farbensinnstörung der Tabiker ist durch eine fortschreitende Rot-Grünblindheit gekennzeichnet, der die totale Farbenblindheit folgt.“"
                            },
                            {
                                "example_id": "e5426904-dfc8-49dd-b320-c726502b1570",
                                "sense_id": "418883f6-f67d-3b9d-80cf-ecb341c6a46c",
                                "text": "„Die Farbensinnstörungen isolieren also einen Erregungsvorgang, den man normalerweise wenigstens isoliert beinflussen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
