                    "sense_id": "02080267-bc2b-34a1-b886-8a7715d891ec",
                    "sense_definition": "niet meer levend",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vogel lag <w>dood</w> op de grond in de tuin.",
                            "target_lang_translations": {
                                "en": "The bird lay <w>dead</w> on the ground in the garden."
                            }
                        },
                        {
                            "text": "Mijn grootouders zijn al heel lang <w>dood</w>.",
                            "target_lang_translations": {
                                "en": "My grandparents have been <w>dead</w> for a very long time."
                            }
                        }
                    ],
                    "antonyms": [
                        "levend"
                    ],
                    "common_phrases": [
                        "zo dood als een pier"
                    ],
                    "target_lang_definitions": {
