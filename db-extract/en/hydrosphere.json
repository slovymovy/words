                        "entry_id": "e8772afc-379b-3ec6-8e67-3b14e4eb5fec",
                        "glosses": [
                            "All the liquid waters of the Earth or another astronomical body, as distinguished from the land and the gases of the atmosphere."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
