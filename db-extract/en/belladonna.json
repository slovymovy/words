                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tollkirsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07008641-065a-33a2-a0ef-fced39e9e7fc",
                                        "entry_id": "b882986b-af02-3719-a70f-4567cf58c86e",
                                        "glosses": [
                                            "Giftpflanze der Gattung Atropa aus der Familie der Nachtschattengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a8382f3-212e-4ea5-962b-5c1d16feac32",
                                                "sense_id": "07008641-065a-33a2-a0ef-fced39e9e7fc",
                                                "text": "Tollkirschen sind krautige, aufrecht wachsende Pflanzen."
                                            },
                                            {
                                                "example_id": "e7116aa0-8db1-4620-8d06-87a51de9ed90",
                                                "sense_id": "07008641-065a-33a2-a0ef-fced39e9e7fc",
                                                "text": "„In der mittelalterlichen Volkskunde spielte Bilsenkraut bei den Praktiken des Hexenkults eine wichtige Rolle, wo es zusammen mit Stechapfel und Tollkirsche als Ingredienz von Hexensalben verwandt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6af66c0b-49cc-3b11-ac57-f5a2e5a49d3f",
                                        "entry_id": "b882986b-af02-3719-a70f-4567cf58c86e",
                                        "glosses": [
                                            "speziell die schwarze Tollkirsche (Atropa belladonna)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fe21ba4-6236-4639-b890-966ca0ec6a23",
                                                "sense_id": "6af66c0b-49cc-3b11-ac57-f5a2e5a49d3f",
                                                "text": "„In der mittelalterlichen Volkskunde spielte Bilsenkraut bei den Praktiken des Hexenkults eine wichtige Rolle, wo es zusammen mit Stechapfel und Tollkirsche als Ingredienz von Hexensalben verwandt wurde.“"
                                            },
                                            {
                                                "example_id": "3d81fce8-7878-4252-8aa2-220e6ca049ee",
                                                "sense_id": "6af66c0b-49cc-3b11-ac57-f5a2e5a49d3f",
                                                "text": "Die Tollkirsche ist in unseren Wäldern weit verbreitet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "864f4939-6852-3ffb-98ca-a7ae9c662d78",
                                        "entry_id": "b882986b-af02-3719-a70f-4567cf58c86e",
                                        "glosses": [
                                            "Frucht von [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c75c762-ade2-4f3f-9ccf-cdcc56809581",
                                                "sense_id": "864f4939-6852-3ffb-98ca-a7ae9c662d78",
                                                "text": "Bei Kindern können schon 3 bis 5 Tollkirschen zum Tod führen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c2f23e5-81d7-4b62-9cd5-7a001eeea520",
                        "source_entry_id": "2599b7a1-4057-3808-ab41-41a6ced5ac38",
                        "source_sense_id": "6de96a30-a4a5-36ee-8309-a00152a7fd22",
                        "source_sense_description": "Medizin, Pharmazie: Atropin, Belladonna",
                        "target_lang_word": "Atropin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atropin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                                        "entry_id": "f63bc2b6-f56f-3ae7-81cd-cda3442bfd24",
                                        "glosses": [
                                            "hochgiftiges Alkaloid oder krampflösendes Arzneimittel, das in Nachtschattengewächsen, besonders in der Tollkirsche Atropa belladonna, vorkommt"
                                        ],
                                        "tags": [
                                            "Pharmazeutische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42df721c-2ecb-477b-9071-dfb34a649a9f",
                                                "sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                                                "text": "„Die Kinder haben Probleme mit den Augen, ich träufle ihnen alle vier Stunden Atropin in die Augen.“"
                                            },
                                            {
                                                "example_id": "af9190d3-b880-4e36-b25c-b80c38bc46ae",
                                                "sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                                                "text": "„Ein altbekannter Antagonist an diesen Rezeptoren ist Atropin, das Gift der Tollkirsche.“"
                                            },
                                            {
                                                "example_id": "1f20eea2-9c71-4f04-95cc-6b6a6891a0cd",
                                                "sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                                                "text": "„In der Drogenszene in Bern und Biel ist Kokain im Umlauf, das mit giftigem Atropin verunreinigt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb907e54-3910-4e52-9604-ac18aa0d35fa",
                        "source_entry_id": "2599b7a1-4057-3808-ab41-41a6ced5ac38",
                        "source_sense_id": "6de96a30-a4a5-36ee-8309-a00152a7fd22",
                        "source_sense_description": "Medizin, Pharmazie: Atropin, Belladonna",
                        "target_lang_word": "Belladonna",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Belladonna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d01be487-182a-3ddd-ad1c-a6a6747d62ed",
                                        "entry_id": "f3db8341-d0f8-397c-8ecf-c30341237e71",
                                        "glosses": [
                                            "Tollkirsche"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dcf23cfb-0640-39b9-a8fa-d8da132c20e4",
                                        "entry_id": "f3db8341-d0f8-397c-8ecf-c30341237e71",
                                        "glosses": [
                                            "aus Tollkirsche hergestelltes Medikament"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db3fa430-5af3-4a34-84e0-8fec2a587c6d",
                                                "sense_id": "dcf23cfb-0640-39b9-a8fa-d8da132c20e4",
                                                "text": "„Ihr Gesicht war scharlachrot, ihre Augen waren groß und leuchtend, als habe sie Belladonna in sie geträufelt.“"
                                            },
                                            {
                                                "example_id": "6bcfea2f-55fc-44f9-84d8-aa1b1e57a2b9",
                                                "sense_id": "dcf23cfb-0640-39b9-a8fa-d8da132c20e4",
                                                "text": "„Und im selben Augenblick kam eine große, schöne und ordentlich bemalte Frau herein, mit Strümpfen wie aus Glas, mit Belladonna in den Augen, mit roten Schuhen und einem Hut, dessen Krempe so groß war, daß sie sich schräg durch die Tür zwängen mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
