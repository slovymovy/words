                    {
                        "sense_id": "85da1364-5ea1-3916-b320-c03fa190cf45",
                        "entry_id": "95e034e4-7471-3374-91dd-076a5df0820c",
                        "glosses": [
                            "rodzaj małego stalowego pręta, który w połączeniu z młotkiem służy jako narzędzie rzemieślnicze, jubilerskie i cyzelerskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43506927-72c2-4b06-9f2c-3fee99ebaebb",
                                "sense_id": "85da1364-5ea1-3916-b320-c03fa190cf45",
                                "text": "W introligatorstwie i zdobieniu skóry technikami introligatorskimi stosowana jest technika złocenia na gorąco, polegająca na przyklejaniu pozłoty przy pomocy rozgrzanych metalowych punc i tłoków"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d55c2196-761d-3076-a08d-4621d0a2d0bb",
                        "entry_id": "95e034e4-7471-3374-91dd-076a5df0820c",
                        "glosses": [
                            "punca (1.1) z imiennikiem danego złotnika"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "1d6b616f-4f79-3b2c-a603-b6470615525b",
                        "entry_id": "95e034e4-7471-3374-91dd-076a5df0820c",
                        "glosses": [
                            "znak wykonany puncą (1.1-2)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36cb9e77-b760-4f21-ab18-1a59eb6fb673",
                                "sense_id": "1d6b616f-4f79-3b2c-a603-b6470615525b",
                                "text": "Praktyczny wuj Filip właśnie odczytuje przez jubilerską lupkę punce na łyżeczce"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "33ad7da0-5813-34b0-87a1-4a86a4471935",
                        "entry_id": "95e034e4-7471-3374-91dd-076a5df0820c",
                        "glosses": [
                            "rodzaj stempla tłoczącego wzór na monecie, też: część graweru monety wybita takim stemplem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe65cc0d-5a6b-4087-9d0b-713e151873b7",
                                "sense_id": "33ad7da0-5813-34b0-87a1-4a86a4471935",
                                "text": "Czy inna punca Orła daje nam nową odmianę trojaka, czy jednak nie?"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
