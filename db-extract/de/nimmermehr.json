                        ]
                    },
                    {
                        "translation_id": "25525af7-40d3-45b8-9568-2314e918930c",
                        "source_entry_id": "03feacea-9af3-31d9-a250-4a78c5435fc6",
                        "source_sense_id": "4cf45022-4644-377c-aede-2313d6d86e2b",
                        "source_sense_description": "veraltend: niemals mehr (wieder)",
                        "target_lang_word": "plus jamais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a549a416-2ad5-4bf8-aab5-09c2a0f2012b",
                        "source_entry_id": "03feacea-9af3-31d9-a250-4a78c5435fc6",
                        "source_sense_id": "4cf45022-4644-377c-aede-2313d6d86e2b",
                        "source_sense_description": "veraltend: niemals mehr (wieder)",
                        "target_lang_word": "jamais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jamais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                                        "entry_id": "ca4ae110-2ce5-3c98-8e8a-e500eb075dce",
                                        "glosses": [
                                            "En un temps quelconque, futur ou hypothétique."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5072ce44-213a-4360-9006-694f2232329d",
                                                "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                                                "text": "« Au revoir, mam’zelle ; si vous voulez jamais avoir de mes nouvelles, demandez Gras Double, tout le monde vous répondra. »"
                                            },
                                            {
                                                "example_id": "a570739c-9479-4ea4-bb44-794de4591996",
                                                "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                                                "text": "Quant à ce dernier, nous ne comptions guère le rejoindre jamais, bien que j’eusse une lueur d’espérance que le capitaine Robson ferait un effort pour nous délivrer."
                                            },
                                            {
                                                "example_id": "16d5fd6e-17c9-4f6e-9bd4-e58007911fc5",
                                                "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                                                "text": "[…] la jeune comtesse avait déclaré qu’elle préférait entrer dans un couvent plutôt que d’être jamais la femme du comte de Ravenstein."
                                            },
                                            {
                                                "example_id": "2f63d7a2-87aa-4d25-8d2a-7009aab33ac0",
                                                "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                                                "text": "Vous avez sauvé la vie de ma nièce, lui dit le général avec effusion, comment m’acquitterai-je jamais envers vous ?"
                                            },
                                            {
                                                "example_id": "4e68c7ba-d3ba-4a5c-8b31-112fcf0e4b03",
                                                "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                                                "text": "Ce n'est pas à cette allure que vont jamais les gentlemen, soucieux de leur respectabilité."
                                            },
                                            {
                                                "example_id": "923a807b-4e15-4120-af07-6aac99ef0e24",
                                                "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                                                "text": "Le monde entier prenait part aux hostilités, sans pouvoir envisager la possibilité d’une paix prochaine, sans même l’espoir de recouvrer jamais la paix."
                                            },
                                            {
                                                "example_id": "5de44719-4d1e-4fff-88ad-077512ba28dd",
                                                "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                                                "text": "Si les barbares s'emparent jamais de l'empire du monde, ils seront forcés d'adopter certaines de nos méthodes ; ils finiront pas nous ressembler."
                                            },
                                            {
                                                "example_id": "dd4c6248-6efb-41ff-a331-b1429c89fece",
                                                "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                                                "text": "Et il descendit de sa chaire, plus rouge et plus excité que jamais, les yeux lançant des éclairs et brandissant vers la nef un poing terrible et vengeur."
                                            },
                                            {
                                                "example_id": "12bee697-b0dc-4844-9634-dcffde7df738",
                                                "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                                                "text": "Depuis le matin, il giboulait. Le ciel et la terre avaient une même couleur de boue et les pins de la forêt bavaroise étaient plus noirs que jamais."
                                            },
                                            {
                                                "example_id": "f82d246a-79dd-42ce-8f4e-a825d8ad429e",
                                                "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                                                "text": "Carmen est morte, l’innocente et plaintive Carmen. Mais la chanson est plus vivante que jamais, plus impitoyable que jamais, plus torturante que jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cfcfa08-dae3-3082-8182-cf76e98ace99",
                                        "entry_id": "ca4ae110-2ce5-3c98-8e8a-e500eb075dce",
                                        "glosses": [
                                            "Toujours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a44fd20-bebb-4aa2-829d-04d3596be123",
                                                "sense_id": "2cfcfa08-dae3-3082-8182-cf76e98ace99",
                                                "text": "[…] j’irais y ensevelir pour jamais mon existence ; inconnu de l’univers, que j’aurais oublié […]"
                                            },
                                            {
                                                "example_id": "7fefe821-2925-44e6-8d34-780027213bcd",
                                                "sense_id": "2cfcfa08-dae3-3082-8182-cf76e98ace99",
                                                "text": "Là, tous ces amis, qui avaient été si étroitement attachés les uns aux autres par le danger commun, allaient se séparer pour jamais, peut-être !"
                                            },
                                            {
                                                "example_id": "f804e6a1-d628-4e98-9db4-d0d7daa23499",
                                                "sense_id": "2cfcfa08-dae3-3082-8182-cf76e98ace99",
                                                "text": "Kurt, aussi rose que jamais, était, lui aussi, sur son séant, à un mètre de Bert […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93321a7e-7863-3f77-996f-3d11453f1c3f",
                                        "entry_id": "ca4ae110-2ce5-3c98-8e8a-e500eb075dce",
                                        "glosses": [
                                            "En nul temps, à aucune occasion, en aucune façon — Note d’usage : Se rencontre combiné avec la particule négative ne (sauf, en réponse à une question, où son omission est de règle)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50c165a6-a855-3498-9428-007b53a037b2",
                                        "entry_id": "ca4ae110-2ce5-3c98-8e8a-e500eb075dce",
                                        "glosses": [
                                            "En nul temps, à aucune occasion, en aucune façon — Note d’usage : Se rencontre combiné avec la particule négative ne (sauf, en réponse à une question, où son omission est de règle).",
                                            "En particulier pour une absence passé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7fe9ebc-c65d-4f88-8dd4-5bcf3e631ef4",
                                                "sense_id": "50c165a6-a855-3498-9428-007b53a037b2",
                                                "text": "Jamais « l’Ami du Peuple » ne s’est élevé contre des hommes privés ; jamais il n’a attaqué que des hommes publics, […] les mandataires du peuple qui oublient leurs devoirs pour trahir leurs commettants."
                                            },
                                            {
                                                "example_id": "6e4c29fc-098b-4c2f-ab4d-0571b9949cc4",
                                                "sense_id": "50c165a6-a855-3498-9428-007b53a037b2",
                                                "text": "Je forme une entreprise qui n’eut jamais d’exemple et dont l’exécution n’aura point d’imitateur. Je veux montrer à mes semblables un homme dans toute la vérité de la nature, et cet homme, ce sera moi."
                                            },
                                            {
                                                "example_id": "41c0c43d-c399-49e7-9d77-2784916daba0",
                                                "sense_id": "50c165a6-a855-3498-9428-007b53a037b2",
                                                "text": "Le sacro-saint règlement et l’esprit de corps furent ainsi respectés, mais Blosseville et son équipage ne revinrent jamais."
                                            },
                                            {
                                                "example_id": "14cab78b-e2d4-4833-a266-1f5c68aca279",
                                                "sense_id": "50c165a6-a855-3498-9428-007b53a037b2",
                                                "text": "Jamais Président n’avait été inauguré dans des circonstances aussi dramatiques."
                                            },
                                            {
                                                "example_id": "19487ca7-a601-4435-98d6-8b43097f6bb7",
                                                "sense_id": "50c165a6-a855-3498-9428-007b53a037b2",
                                                "text": "Un campement à la bordure d’une forêt, et éclairé par quelques bougies, donne d’étranges apparences ; je crus voir une falaise et des cavernes ; je revis ce lieu plus d’une fois ; jamais je n’y pus reconnaître ma première impression […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d430727-879f-35b6-a394-c8f5793e2339",
                                        "entry_id": "ca4ae110-2ce5-3c98-8e8a-e500eb075dce",
                                        "glosses": [
                                            "En nul temps, à aucune occasion, en aucune façon — Note d’usage : Se rencontre combiné avec la particule négative ne (sauf, en réponse à une question, où son omission est de règle).",
                                            "Sous forme rhétorique: jamais dire jamais"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "481e762e-849f-4f7b-acc3-5b95f0502bf6",
                                                "sense_id": "0d430727-879f-35b6-a394-c8f5793e2339",
                                                "text": "Mais voyons la lettre ; (Il lit) : « Monsieur, comme je ne puis jamais être à vous ...» Jamais! il ne faut jamais dire jamais. Qui est-ce qui peut répondre-de l’avenir? — Vous me l’aviez dit, mon oncle. — Jamais! je voulais dire à présent, mais nous ne pouvons jamais dire jamais pour l’avenir."
                                            },
                                            {
                                                "example_id": "6c365b71-0ce4-405f-ac52-f5282ffedb2c",
                                                "sense_id": "0d430727-879f-35b6-a394-c8f5793e2339",
                                                "text": "Le lendemain où M. de Serre, alors garde-des-sceaux, avait fait retentir les échos de la Chambre élective du terrible mot jamais ! on donnait au Gymnase une représentation de cet opéra. A la scène xn, Géronte, consulté par sa pupille sur le contenu de la lettre qu'il l’a chargée d’écrire à son amant, y blâme cette phrase : Monsieur, comme je ne puis jamais être à vous; et ajoute : jamais! il ne faut jamais dire jamais; qui est-ce qui peut répondre de l’avenir?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "021c63ae-d516-32ca-b7e3-cc3758991234",
                                        "entry_id": "ca4ae110-2ce5-3c98-8e8a-e500eb075dce",
                                        "glosses": [
                                            "En nul temps, à aucune occasion, en aucune façon — Note d’usage : Se rencontre combiné avec la particule négative ne (sauf, en réponse à une question, où son omission est de règle).",
                                            "En particulier sous forme impérative, conditionnelle, présente ou future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca9e70c-12d2-45f1-be22-453ceece5433",
                                                "sense_id": "021c63ae-d516-32ca-b7e3-cc3758991234",
                                                "text": "Elle s’était repliée sur elle-même, l’air agressif.\nJ’avais vu la même expression, dans une maternité, sur le visage d’une jeune femme qui venait d’accoucher après beaucoup de souffrances. Son mari arriva et esquissa un geste de tendresse. Elle se recula contre le mur où était accoté son lit et jeta sur l’homme un regard de rancune. « Jamais plus », gronda-t-elle."
                                            },
                                            {
                                                "example_id": "bb3701e7-4cc4-4615-a2da-2382af36bda5",
                                                "sense_id": "021c63ae-d516-32ca-b7e3-cc3758991234",
                                                "text": "Jamais menelaus avec Vous ne coucherait"
                                            },
                                            {
                                                "example_id": "edf3a2ac-ba2a-4101-9c1a-574b602a52cc",
                                                "sense_id": "021c63ae-d516-32ca-b7e3-cc3758991234",
                                                "text": "Car il m’a fait plus de bien et de courtoisie que homme du monde jamais ne pourrait oublier les bienfaits"
                                            },
                                            {
                                                "example_id": "e53e747e-9b1f-4e9a-a59d-1700356d3420",
                                                "sense_id": "021c63ae-d516-32ca-b7e3-cc3758991234",
                                                "text": "Jamais ogier le danois ne frappa chevalier qu’il ne fut armé de tous poings"
                                            },
                                            {
                                                "example_id": "6373c6de-492e-4de2-a791-479126206d01",
                                                "sense_id": "021c63ae-d516-32ca-b7e3-cc3758991234",
                                                "text": "jamais beuf ſa tête cornue ne mettrait en jouc de charrue"
                                            },
                                            {
                                                "example_id": "ede24d5c-ad1d-4101-a3c7-5e8880083d3e",
                                                "sense_id": "021c63ae-d516-32ca-b7e3-cc3758991234",
                                                "text": "Jamais je ne remettrai plus les pieds dans une barque !"
                                            },
                                            {
                                                "example_id": "e8a160c6-7210-4724-8a2b-ae88b7f057ff",
                                                "sense_id": "021c63ae-d516-32ca-b7e3-cc3758991234",
                                                "text": "Je ne traverse pas si la route juste devant moi est encombrée. Les rails ne doivent être franchis que si la voie routière en face est dégagée. Je ne m’arrête jamais sur la voie ferrée."
                                            }
                                        ]
                                    }
                                ]
                            },
