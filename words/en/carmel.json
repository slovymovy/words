{
    "word_family": [
        "caramel"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9cd9999c-911b-3b9f-8cd9-3e84e767b8ec",
                    "sense_definition": "A mountain range in Israel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The prophet Elijah famously confronted the prophets of Baal on mount <w>Carmel</w>.",
                            "target_lang_translations": {
                                "zh": "先知以利亚曾在<w>卡梅尔山</w>上与巴力的先知们对峙，这非常出名。"
                            }
                        },
                        {
                            "text": "Many tourists visit the beautiful <w>Carmel</w> mountain range every year.",
                            "target_lang_translations": {
                                "zh": "每年都有许多游客造访美丽的<w>卡梅尔山</w>脉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mount carmel"
                    ],
                    "target_lang_definitions": {
                        "zh": "以色列的一座山脉。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卡梅尔山",
                                "target_lang_sense_clarification": "指地理上的卡梅尔山脉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4287283-78e1-3108-9973-7ae2855d29c0",
                    "sense_definition": "A city in Monterey County, California, United States.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to spend their summer vacation in the coastal town of <w>Carmel</w>.",
                            "target_lang_translations": {
                                "zh": "他们决定去海滨小镇<w>卡梅尔</w>度暑假。"
                            }
                        },
                        {
                            "text": "The famous artist lived in <w>Carmel</w> for many years.",
                            "target_lang_translations": {
                                "zh": "那位著名的艺术家在<w>卡梅尔</w>住了很多年。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "carmel by the sea"
                    ],
                    "target_lang_definitions": {
                        "zh": "美国加利福尼亚州蒙特雷县的一座城市。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卡梅尔",
                                "target_lang_sense_clarification": "指加州的地名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6edc2c37-4220-3dd8-9376-33228e1a9691",
                    "sense_definition": "A female given name.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Carmel</w> is a popular name in many English-speaking countries.",
                            "target_lang_translations": {
                                "zh": "<w>卡梅尔</w>在许多英语国家是一个很受欢迎的名字。"
                            }
                        },
                        {
                            "text": "My friend <w>Carmel</w> is visiting from Ireland next week.",
                            "target_lang_translations": {
                                "zh": "我的朋友<w>卡梅尔</w>下周要从爱尔兰来看我。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "女性名字。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卡梅尔",
                                "target_lang_sense_clarification": "女性人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e1ac2b4-0a25-3d4b-b152-2e8591494c0e",
                    "sense_definition": "The Native American people of the Monterey region.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Carmel</w> people have a long history in the central coast of California.",
                            "target_lang_translations": {
                                "zh": "<w>卡梅尔人</w>在加利福尼亚州中部海岸有着悠久的历史。"
                            }
                        },
                        {
                            "text": "Researchers are studying the traditions of the <w>Carmel</w> tribe.",
                            "target_lang_translations": {
                                "zh": "研究人员正在研究<w>卡梅尔</w>部落的传统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Rumsen",
                        "Rumsien",
                        "Carmeleno"
                    ],
                    "target_lang_definitions": {
                        "zh": "加利福尼亚州蒙特雷地区的原住民。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卡梅尔人",
                                "target_lang_sense_clarification": "指特定原住民群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "134d7048-6a2f-35a1-9e24-c2a6814b2758",
                    "sense_definition": "The language of the Rumsen people.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Linguists are working to document the <w>Carmel</w> language.",
                            "target_lang_translations": {
                                "zh": "语言学家们正在努力记录<w>卡梅尔语</w>。"
                            }
                        },
                        {
                            "text": "Few people today can speak the <w>Carmel</w> language fluently.",
                            "target_lang_translations": {
                                "zh": "如今很少有人能流利地说<w>卡梅尔语</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Rumsen",
                        "Rumsien"
                    ],
                    "target_lang_definitions": {
                        "zh": "卡梅尔原住民使用的语言。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卡梅尔语",
                                "target_lang_sense_clarification": "指特定原住民语言"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95092902-708a-3df4-bf15-8535bea4f130",
                    "sense_definition": "Alternative form of <w>caramel</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She added a drizzle of <w>carmel</w> sauce to the ice cream.",
                            "target_lang_translations": {
                                "zh": "她在冰淇淋上淋了一点<w>焦糖</w>酱。"
                            }
                        },
                        {
                            "text": "The dessert was topped with a sweet <w>carmel</w> glaze.",
                            "target_lang_translations": {
                                "zh": "甜点上面覆盖着一层甜甜的<w>焦糖</w>釉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "carmel sauce"
                    ],
                    "target_lang_definitions": {
