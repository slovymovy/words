                ],
                "senses": [
                    {
                        "sense_id": "58d590a5-a578-36f6-a63d-c120434055cf",
                        "entry_id": "164b784c-a672-3b8c-841e-a89e1642587a",
                        "glosses": [
                            "Cambrioler."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ef959fc5-f07a-45e3-8e69-44c9c6109d48",
                                "sense_id": "58d590a5-a578-36f6-a63d-c120434055cf",
                                "text": "Quand tu m’as dit que tu étais un tocard, j’t’ai pas cru, mais j’crois bien qu’c’est toi qui as raison. Faut jamais contrarier les vocations, la tienne c’est d’piquer les bicyclettes et d’baluchonner les chambres de bonnes."
                            },
                            {
                                "example_id": "9a3cddb7-38a5-4873-a3cf-885387cb8aa9",
                                "sense_id": "58d590a5-a578-36f6-a63d-c120434055cf",
                                "text": "Faudrait, toi au volant, Jo et moi pour enquiller dans le casino et baluchonner."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc3d7a09-dca9-33c9-95d5-2a99d5b5feb7",
                        "entry_id": "164b784c-a672-3b8c-841e-a89e1642587a",
                        "glosses": [
                            "Faire son baluchon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "99b2bbdf-840a-3087-b525-12f842af8780",
                        "entry_id": "164b784c-a672-3b8c-841e-a89e1642587a",
                        "glosses": [
                            "Mettre en réserve un objet pour le protéger, en le rendant inutilisable temporairement, jusqu’à ce qu’il soit déballuchonné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ae0659-0f07-40c0-9073-728e41c054f4",
                                "sense_id": "99b2bbdf-840a-3087-b525-12f842af8780",
                                "text": "En plus, bonjour la pompe à Px... une bidouille qui vaut rien et c'est parti... je baluchonne, je débaluchonne, je baluchonne, je débaluchonne..."
                            }
                        ]
                    }
