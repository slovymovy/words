                "senses": [
                    {
                        "sense_id": "5e3bb83d-b41e-34ca-8110-73ea4ff284ce",
                        "entry_id": "3704bb45-f4ce-39b8-9ef2-148e08da3b42",
                        "glosses": [
                            "устар. связанный, соотносящийся по значению с существительным перл; состоящий из жемчужин; похожий на жемчуг"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab1097fb-eaa4-4891-bff1-5ff3ff7a0e21",
                                "sense_id": "5e3bb83d-b41e-34ca-8110-73ea4ff284ce",
                                "text": "О цвет прекрасный, осыпаем // Поутру пе́рловой росой, // Зефиром в полдень лобызаем! // Открой скорей румянец твой."
                            },
                            {
                                "example_id": "fd3d8f24-667f-4377-a1eb-90a1b00ef28d",
                                "sense_id": "5e3bb83d-b41e-34ca-8110-73ea4ff284ce",
                                "text": "Златую косу заплела // С искусством, в наши дни не новым, // И обвила венцом перло́вым // Окружность бледного чела."
                            }
                        ]
                    }
                ],
