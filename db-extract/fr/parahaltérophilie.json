                        "glosses": [
                            "Haltérophilie adaptée aux sportifs handicapés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b1fac80-00ac-42b4-bd02-8c09b0627400",
                                "sense_id": "0f470604-2a60-37d9-98e7-c983ed9288f2",
                                "text": "De ce chantier à 136 millions d'euros doit émerger une salle omnisports de 9 000 places où se disputeront les épreuves de badminton, de gymnastique rythmique et de parahaltérophilie (lire aussi p.16)."
                            },
                            {
                                "example_id": "db9af2e1-1b31-4e4e-acd7-af929b875905",
                                "sense_id": "0f470604-2a60-37d9-98e7-c983ed9288f2",
                                "text": "L’enceinte, située à la ZAC Gare des Mines-Fillettes – « au cœur d’un quartier en devenir », précise-t-on à la Mairie de Paris – figure sur la carte des sites des Jeux olympiques et paralympiques de 2024 et accueillera les épreuves de badminton et de gymnastique rythmique durant les JO (du 26 juillet au 11 août 2024) puis de parabadminton et parahaltérophilie lors des jeux paralympiques (du 28 août au 8 septembre 2024)."
                            },
                            {
                                "example_id": "358aca31-5a9a-4caf-8e5e-08fb50e640b0",
                                "sense_id": "0f470604-2a60-37d9-98e7-c983ed9288f2",
                                "text": "L’équipe de France de parahaltérophilie se prépare à Besançon"
                            }
                        ]
                    }
