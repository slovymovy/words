                        "cross_references": [
                            {
                                "target_word": "imaginary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d6925f0-1213-36fb-ab1b-2eabc8fb353f",
                                        "entry_id": "6980c692-ede3-30f2-bafc-fd0f709e998e",
                                        "glosses": [
                                            "Existing only in the imagination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a8b7d90-c206-4d77-bcf9-bcb9a6f714be",
                                                "sense_id": "1d6925f0-1213-36fb-ab1b-2eabc8fb353f",
                                                "text": "imaginary friend"
                                            },
                                            {
                                                "example_id": "d46d1de2-bed8-4fd7-8e3d-0c33dcf2da4a",
                                                "sense_id": "1d6925f0-1213-36fb-ab1b-2eabc8fb353f",
                                                "text": "Unicorns are imaginary."
                                            },
                                            {
                                                "example_id": "53153e7e-13eb-4775-bc4d-02dd43843a93",
                                                "sense_id": "1d6925f0-1213-36fb-ab1b-2eabc8fb353f",
                                                "text": "Wilt thou add to all the griefs I suffer / Imaginary ills and fancied tortures?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e698ac-575c-39de-a9f5-1010fbf302d8",
                                        "entry_id": "6980c692-ede3-30f2-bafc-fd0f709e998e",
                                        "glosses": [
                                            "Having no real part; that part of a complex number which is a multiple of √ (called imaginary unit)."
                                        ],
                                        "tags": [
                                            "of a number"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4790ef7b-d4f5-3b7d-aa5b-c0da330af759",
                                        "entry_id": "6980c692-ede3-30f2-bafc-fd0f709e998e",
                                        "glosses": [
                                            "Having no real part; that part of a complex number which is a multiple of √ (called imaginary unit)."
                                        ],
                                        "tags": [
