                        "translation_id": "2a1f4e37-da19-4189-b62f-4a8894d7c818",
                        "source_entry_id": "4f49a0ca-37d6-3b82-b534-05493efd727f",
                        "source_sense_id": "3d4279a3-dd03-33df-94d5-41a018b9678a",
                        "source_sense_description": "Fenster einer Kirche",
                        "target_lang_word": "vitrail",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vitrail",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a63c4a77-acc9-331f-a702-dc44faadefc1",
                                        "entry_id": "bd13579b-9cae-3b5a-96f0-2684275c4f47",
                                        "glosses": [
                                            "Panneau de verres assemblés par compartiments, enchâssés dans des cadres de plomb et qui le plus souvent forment une décoration ou représentent un sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "012aa887-5509-4fb5-b6b7-013d2c3c636f",
                                                "sense_id": "a63c4a77-acc9-331f-a702-dc44faadefc1",
                                                "text": "C’était une retraite obscure et religieuse où le jour ne pénétrait qu’à travers les vitraux coloriés et où tout disposait l’âme à la prière."
                                            },
                                            {
                                                "example_id": "779454a8-0f4a-4ce9-8c83-d43a2d1a8aff",
                                                "sense_id": "a63c4a77-acc9-331f-a702-dc44faadefc1",
                                                "text": "Les vitraux de plomb disjoints laissaient tomber les verres octogones des croisées qui semblaient éborgnées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fab72327-0bfa-4c9d-9349-e7cdf4291afc",
                        "source_entry_id": "4f49a0ca-37d6-3b82-b534-05493efd727f",
                        "source_sense_id": "3d4279a3-dd03-33df-94d5-41a018b9678a",
                        "source_sense_description": "Fenster einer Kirche",
                        "target_lang_word": "kerkraam",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kerkraam",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "db10387f-9e8f-31fc-84c7-2dd7f5c028f4",
                                        "entry_id": "75d7e378-1a57-368f-a96e-2617d0bf2550",
                                        "glosses": [
                                            "raam van een kerk; gebrandschilderd venster"
                                        ],
                                        "tags": [
                                            "gekleurd"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1066924-2fc7-497d-9dac-9da3dfc055f3",
                                                "sense_id": "db10387f-9e8f-31fc-84c7-2dd7f5c028f4",
                                                "text": "Kerkramen uit brief Van Gogh terecht: Twee glas-in-loodramen waar Vincent van Gogh over schreef in een brief aan zijn broer Theo zijn gevonden in een kerk in Engeland. Kunsthistoricus Max Donnelly heeft vastgesteld dat de ramen waar Van Gogh over schreef zijn geïnstalleerd in een kerk in het plaatsje Owlsebury in het graafschap Hampshire."
                                            },
                                            {
                                                "example_id": "343dab5c-2eb9-48b0-920d-9076d32f8098",
                                                "sense_id": "db10387f-9e8f-31fc-84c7-2dd7f5c028f4",
                                                "text": "In een oudere misbruikzaak was op een foto een kerkraam te zien. De politie liet speciale software schrijven, die via Google Earth alle kerkramen vergeleek met het raam op de foto. Zo kwam de politie achter het adres waar twee kinderen werden misbruikt door een pedoseksueel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e4a4bda-05a1-403d-9794-7a6b6adeb1d5",
                        "source_entry_id": "4f49a0ca-37d6-3b82-b534-05493efd727f",
                        "source_sense_id": "3d4279a3-dd03-33df-94d5-41a018b9678a",
                        "source_sense_description": "Fenster einer Kirche",
                        "target_lang_word": "vitral",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vitral",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "403bdd59-ea1a-31da-9914-4e619c59695b",
                                        "entry_id": "0c5d1029-ec1b-3293-968d-638d4a63ef36",
                                        "glosses": [
                                            "Composición formada por vidrios de colores pintados y cubiertos por esmalte que se unen por medio de varillas de plomo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc7d6b7-5245-4a1d-adc2-72b73dfd79e1",
                                                "sense_id": "403bdd59-ea1a-31da-9914-4e619c59695b",
                                                "text": "¡Oh, vitrales policromos\nfileteados de plomos,\nque brilláis bajo los domos!"
                                            },
                                            {
                                                "example_id": "69dd38e4-7457-49f2-a2f6-c2db6524d885",
                                                "sense_id": "403bdd59-ea1a-31da-9914-4e619c59695b",
                                                "text": "no, es una historia vieja y triste que, juntos, por un momento, hemos mirado los dos esta mañana, como se miran todas las tristes y viejas historias de amor que pasaron en otros, hace ya muchos siglos, y que todavía se ven escritas en los libros, y clareando en los vitrales de las ventanas góticas."
                                            },
                                            {
                                                "example_id": "45b49baf-0fa9-4042-bc5c-387645b9cbe4",
                                                "sense_id": "403bdd59-ea1a-31da-9914-4e619c59695b",
                                                "text": "Un vitral sangra en el fondo de la nave de la catedral de Trondheim, sin el luminoso esplendor de los vitrales de las catedrales españolas, con el encanto de una herida espiritual casi cerrada."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
