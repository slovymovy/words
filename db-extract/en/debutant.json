                    },
                    {
                        "translation_id": "1243287b-e6ca-408e-a76f-5f4444deaca5",
                        "source_entry_id": "96fa9c18-4435-3c55-925a-107d8d9d4cef",
                        "source_sense_id": "6e6b9137-3f25-385b-a722-033cd7751d8d",
                        "source_sense_description": "debuting male",
                        "target_lang_word": "débutant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débutant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2c7f20-ee89-3ae0-b4e6-9ede5377820b",
                                        "entry_id": "546aa06b-8cad-3e51-81d9-78cfa2a4adc2",
                                        "glosses": [
                                            "Qui débute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8db62b5f-82fe-4a03-acbe-0137bb3a773e",
                                                "sense_id": "5e2c7f20-ee89-3ae0-b4e6-9ede5377820b",
                                                "text": "Parmi toutes les saintes niaiseries du premier amour, […] on a celle de vouloir se tuer, si l'on n'est pas aimé. J'étais donc bien résolu à faire comme tous les amoureux débutants, si j'étais repoussé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "débutant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78ef1bc3-bdc6-33db-aeb4-05b597522cbd",
                                        "entry_id": "5fdf8712-40a1-3555-aa1b-eed93c95ac8a",
                                        "glosses": [
                                            "Celui qui débute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61d444a0-33f6-46e4-bf07-429faf81bffb",
                                                "sense_id": "78ef1bc3-bdc6-33db-aeb4-05b597522cbd",
                                                "text": "Un débutant dans la carrière des lettres."
                                            },
                                            {
                                                "example_id": "e3b6b610-c100-48fc-bc5b-af7d99c36866",
                                                "sense_id": "78ef1bc3-bdc6-33db-aeb4-05b597522cbd",
                                                "text": "La timidité, l’émotion d’un débutant."
                                            },
                                            {
                                                "example_id": "0a62bf0c-5cf9-48ce-89e5-b7711746262c",
                                                "sense_id": "78ef1bc3-bdc6-33db-aeb4-05b597522cbd",
                                                "text": "Atelier informatique pour les débutants et semi-débutants' — (Saint-Cloud magazine, novembre 2022, page 37)"
                                            },
                                            {
                                                "example_id": "d593cf41-0abe-4c0b-8119-db3f46db4f08",
                                                "sense_id": "78ef1bc3-bdc6-33db-aeb4-05b597522cbd",
                                                "text": "II est toujours surprenant de constater à quel point un débutant, et ceci dans quelque pratique sportive que ce soit, s’intéresse à l’aspect matériel du nouveau sport auquel il a décidé de se consacrer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "débutant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17716f69-0ae4-38a5-b220-6d0beb30924a",
                                        "entry_id": "d11cf1be-a9f2-3fca-9d37-a940760f709a",
                                        "glosses": [
                                            "Participe présent de débuter."
                                        ],
