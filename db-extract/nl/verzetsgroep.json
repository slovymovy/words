                        "target_lang_word": "Widerstandsgruppe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widerstandsgruppe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d6d5619-30d7-384c-9b15-740f53d8e67f",
                                        "entry_id": "08366c8e-7c7a-397d-8381-7268b104d95c",
                                        "glosses": [
                                            "Gruppe von Widerstandskämpfern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc8556b6-9e48-4c16-a1d3-c56bc197af3a",
                                                "sense_id": "9d6d5619-30d7-384c-9b15-740f53d8e67f",
                                                "text": "„Die Widerstandsgruppe hat mit ihrem Leben für ihre aufrüttelnden Worte bezahlt.“"
                                            },
                                            {
                                                "example_id": "bcfe92ef-87d4-44b0-b531-ea58e41d4dcd",
                                                "sense_id": "9d6d5619-30d7-384c-9b15-740f53d8e67f",
                                                "text": "„Zu Beginn des 20. Jahrhunderts formierten sich neue nationale Widerstandsgruppen.“"
                                            },
                                            {
                                                "example_id": "e9ac44fc-8002-4b79-a83e-443dc8a6db27",
                                                "sense_id": "9d6d5619-30d7-384c-9b15-740f53d8e67f",
                                                "text": "„Längst hatte die Gestapo viele tschechische Widerstandsgruppen unterwandert.“"
                                            },
                                            {
                                                "example_id": "b25255da-ff64-40db-bacf-c42e0fe7948b",
                                                "sense_id": "9d6d5619-30d7-384c-9b15-740f53d8e67f",
                                                "text": "„Mehr als 40 Kämpfer dieser Widerstandsgruppe wurden in die Konzentrationslager verschleppt, zwölf von ihnen starben dort.“"
                                            },
                                            {
                                                "example_id": "be5c039f-f224-40ac-9be7-d29e4b799941",
                                                "sense_id": "9d6d5619-30d7-384c-9b15-740f53d8e67f",
                                                "text": "„Bereits 1983 gab es in Pakistan 339 Flüchtlingscamps, in denen jeweils nur eine Widerstandsgruppe das Sagen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
