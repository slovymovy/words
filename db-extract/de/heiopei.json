                "senses": [
                    {
                        "sense_id": "792420c4-4548-363f-942d-28abe6bf1a74",
                        "entry_id": "6b52fe20-c0f5-3e84-92f5-9de20807648a",
                        "glosses": [
                            "aufschneiderische, wenig intelligente Person"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "6243b44d-58f8-4652-a3ae-c23641120100",
                                "sense_id": "792420c4-4548-363f-942d-28abe6bf1a74",
                                "text": "„Sobald der gut gelaunte Heiopei den Raum betritt, brennt die Luft.“"
                            },
                            {
                                "example_id": "158b4070-893a-49ca-8be9-f09e26360d02",
                                "sense_id": "792420c4-4548-363f-942d-28abe6bf1a74",
                                "text": "„So viel an dieser Stelle zum Thema Eiapopeia und Heidschi Bumbeidschi. Und, logisch, wer kein Heiopei ist, der hat das alles eh schon gewusst.“"
                            },
                            {
                                "example_id": "45f3c3a5-22d3-4283-825a-0b779b20842e",
                                "sense_id": "792420c4-4548-363f-942d-28abe6bf1a74",
                                "text": "„Mit anderen Worten: Liebe Leute in Georgia, seid ihr noch ganz bei Trost, einen solchen Heiopei zu wählen?“"
                            },
                            {
                                "example_id": "ceefd0a0-89e9-4304-995a-8720c722e90f",
                                "sense_id": "792420c4-4548-363f-942d-28abe6bf1a74",
                                "text": "„Ihr erster Gedanke war: «Was ist denn das für ein Heiopei mit seinem Thrombosestrümpfen?»“"
                            },
                            {
                                "example_id": "0dc63c3b-84ac-4937-a7ce-417d502cd29f",
                                "sense_id": "792420c4-4548-363f-942d-28abe6bf1a74",
                                "text": "„Die Vetternwirtschaft sorgt dafür, dass sich nicht einfach jeder Heiopei mit Geld und einem Businessplan in die Szene einkaufen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
