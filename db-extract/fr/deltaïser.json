                                "example_id": "12f649c5-30b8-48e2-a002-31a0c00061a9",
                                "sense_id": "d49bc9fa-5f91-340f-9572-d38d77a5e6c2",
                                "text": "J'aime bien mais tu peux la deltaïser pour voir."
