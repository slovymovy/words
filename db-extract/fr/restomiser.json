                        "examples": [
                            {
                                "example_id": "5bd74c31-1748-47ab-a2fb-d36d9c43f822",
                                "sense_id": "485869fc-644d-3774-b5ea-f94fbc37bab1",
                                "text": "D'abord je remets mon réservoir restomisé, j'ajoute l'essence, je guette fiévreusement le moindre suintement, tant qu'à faire j'avais monté un robinet neuf.... rien."
                            },
                            {
                                "example_id": "94a59369-6a02-42b2-83de-b384d24a3258",
                                "sense_id": "485869fc-644d-3774-b5ea-f94fbc37bab1",
                                "text": "Alors pour me détendre, j'ai restomisé le réservoir de carburant puis je l'ai installé avec les silent-blocs qui vont bien et après avoir nettoyé à l'essence le feutre placé entre le réservoir et les deux colliers de fixation."
                            },
                            {
                                "example_id": "7e21be5c-389d-41ed-b47b-0023574fa001",
                                "sense_id": "485869fc-644d-3774-b5ea-f94fbc37bab1",
                                "text": "question : pourquoi pas \"restomiser\" l’intérieur de la cuve du carbu ?"
                            }
                        ]
