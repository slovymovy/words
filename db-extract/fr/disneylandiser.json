                ],
                "senses": [
                    {
                        "sense_id": "d3c2cd5f-e63a-3561-82f3-9e152122989d",
                        "entry_id": "6884ba0d-22de-309d-a2c0-326d6bec7c8d",
                        "glosses": [
                            "Transformer un endroit, une région, une société, pour répondre aux attentes et aux présupposés des touristes, comme dans un parc d’attractions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48a04a25-bec1-4bc1-9222-a211e3d5f03a",
                                "sense_id": "d3c2cd5f-e63a-3561-82f3-9e152122989d",
                                "text": "Disneylandiser un lieu, c’est en mettre en scène les singularités locales, exacerbées de façon à les rendre uniques et inoubliables."
                            },
                            {
                                "example_id": "9b1f7d93-5bbc-4633-9868-88deee002ced",
                                "sense_id": "d3c2cd5f-e63a-3561-82f3-9e152122989d",
                                "text": "Il y a un danger de « disneylandiser » le Vieux-Québec, un danger qui existe dans toutes les grandes villes patrimoniales attrayantes et à bon marché."
                            },
                            {
                                "example_id": "6fe660e9-5961-42e9-8fb9-142d8211b5e9",
                                "sense_id": "d3c2cd5f-e63a-3561-82f3-9e152122989d",
                                "text": "On peut, raisonnablement, choisir de faire disparaître le bâtiment restant de Drancy. On n’a, en revanche, aucun droit de promouvoir ou de disneylandiser ce site sous couvert de ce qu’un article récent du journal \"Le Monde\" appelle, sans s’interroger sur l’accouplement de ces deux termes, « tourisme de mémoire »."
                            }
                        ]
                    }
                ],
