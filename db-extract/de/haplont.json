                "senses": [
                    {
                        "sense_id": "9bd26924-286b-3001-af98-31e2a785ea8a",
                        "entry_id": "b1b9fb9f-236e-304d-b0b4-e60c4d8888e4",
                        "glosses": [
                            "Organismus, dessen Körperzellen (Zellen, die keine Keimzellen sind) einen einfachen Chromosomensatz enthalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc7fc5c6-f034-4347-b567-e855289fdaa9",
                                "sense_id": "9bd26924-286b-3001-af98-31e2a785ea8a",
                                "text": "Die Zellen der Diplonten sind gegenüber denen der Haplonten etwas vergrößert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d04be706-4a53-47f3-a1ab-8aa77f4050ee",
                        "source_entry_id": "b1b9fb9f-236e-304d-b0b4-e60c4d8888e4",
                        "source_sense_id": "9bd26924-286b-3001-af98-31e2a785ea8a",
                        "target_lang_word": "haplont",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haplont",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "389ed60b-3831-3990-b372-036db8bca69b",
                                        "entry_id": "c67cedca-f73b-3b88-bc64-6c94990dc004",
                                        "glosses": [
                                            "Any haplontic organism; any organism whose zygotes undergo zygotic meiosis (meiosis immediately after the fusion of cell nuclei)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19d2a936-8700-4166-8358-edae79ef8ad1",
                                                "sense_id": "389ed60b-3831-3990-b372-036db8bca69b",
                                                "text": "1933, John Milton Webber, Cytological Features of Nicotiana Glucinosa Haplonts, M. C. Merrill (editorial supervisor), Journal of Agricultural Research, Volume 47, U.S. Department of Agriculture, page 864,\nThe behavior of haplont Nicotiana glutinosa is in harmony with the foregoing facts. […] The occurrence of diploid cells in the callus of decapitated haplonts may be attributed to causes similar to those resulting in diploid cells in proximal callus."
                                            },
                                            {
                                                "example_id": "945d4797-e53b-42dd-a6cc-40cfd3964555",
                                                "sense_id": "389ed60b-3831-3990-b372-036db8bca69b",
                                                "text": "It is thus an amphimictic haplont, but clonal selling gives progeny identical among themselves and with their parents."
                                            },
                                            {
                                                "example_id": "e2d4ad0c-f373-499c-8b6c-c3dc244e8d6d",
                                                "sense_id": "389ed60b-3831-3990-b372-036db8bca69b",
                                                "text": "The first transition is a vegetative cell to a gamete, followed by gamete fusion and the production of a zygote. This involves syngamy and in haplont life cycles the 1n gametes fuse to form a 2n motile or non-motile zygote. There can be one stage or two-stage meiosis with resultant haplonts to begin the cycle again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a88c960-67e6-4d7e-b900-439674b3cfef",
                        "source_entry_id": "b1b9fb9f-236e-304d-b0b4-e60c4d8888e4",
                        "source_sense_id": "9bd26924-286b-3001-af98-31e2a785ea8a",
                        "target_lang_word": "haplonte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haplonte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12e854e9-1548-34db-8666-9e4c6a330dab",
                                        "entry_id": "1fffa8f8-5c93-3f88-aac4-b9c050cdc029",
                                        "glosses": [
                                            "Organisme qui vit principalement dans une phase haploïde, c’est-à-dire à n chromosomes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9ce4c0a-4899-4dfb-add9-13be98864455",
                                                "sense_id": "12e854e9-1548-34db-8666-9e4c6a330dab",
                                                "text": "Chaque haplonte femelle, resté immobile en son lieu de naissance, peut être approché par un haplonte mâle, ce qui aboutit à la formation d’une seule cellule-œuf apte à engendrer un diplonte de nouvelle génération."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
