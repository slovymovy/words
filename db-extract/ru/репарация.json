                                    }
                                ]
                            },
                            {
                                "target_word": "repair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b696eb7-78a5-32a2-97da-8db273dcbe34",
                                        "entry_id": "61ab0ea4-6e91-335f-b151-44430bd2d1df",
                                        "glosses": [
                                            "To pair again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1786c45-30ba-44e1-bd0b-b6755609b7a1",
                                                "sense_id": "5b696eb7-78a5-32a2-97da-8db273dcbe34",
                                                "text": "Please try to repair the two earbuds to each other. Place both earbuds back into the charging case, wait for four seconds, then open it and see if they have been repaired with one another."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33be0601-d1ff-4d43-be99-fe6cddc38496",
                        "source_entry_id": "eedea090-cf72-366e-9853-7413167df439",
                        "source_sense_description": "возмещение материального ущерба",
                        "target_lang_word": "reparation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reparation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f00e9f92-a618-3fce-b23a-14a6e0050deb",
                                        "entry_id": "c3afe225-785b-375e-a253-464c26832b13",
                                        "glosses": [
                                            "A payment of time, effort or money to compensate for past transgression(s)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6b4d83c-20ff-46a4-8e08-1012936a96cd",
                                                "sense_id": "f00e9f92-a618-3fce-b23a-14a6e0050deb",
                                                "text": "I am sensible of the scandal I have given by my loose writings, and make what reparation I am able."
                                            },
                                            {
                                                "example_id": "4a411a7e-a015-4bc5-bffa-4300ee67561a",
                                                "sense_id": "f00e9f92-a618-3fce-b23a-14a6e0050deb",
                                                "text": "A feature of locomotive operation on the Region de l'Est of the French National Railways, not only on the old Alsace-Lorraine lines, but also on the Est proper, is the wide use still made of ex-German engines received as reparations after the 1914-19 war."
                                            },
                                            {
                                                "example_id": "06530aab-00cb-4f8c-924e-667434bdd839",
                                                "sense_id": "f00e9f92-a618-3fce-b23a-14a6e0050deb",
                                                "text": "Biotic Leader: So how about if I kill Chairman Burns and finish this charade?\nChairman Burns: Please! I was trying to help you people!\nShepard: Let's not do anything we're all going to regret.\nBiotic Leader: Why not? What have we got to lose?\nBiotic Leader: Since the chairman here decided we didn't get reparations, we've got nothing left to live for!\nChairman Burns: But I've changed my mind! Seeing y-you all, it's c-clear that you all d-deserve...\nBiotic Leader: You had your chance! Some L2s are nearly crippled from side effects of the implants, but you voted against reparations!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c83cf2-c898-350a-9938-83e702a5f217",
                                        "entry_id": "c3afe225-785b-375e-a253-464c26832b13",
                                        "glosses": [
                                            "The act of renewing, restoring, etc., or the state of being renewed or repaired."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20b1a92c-53d9-476a-b88e-f59e9ede28d8",
                                                "sense_id": "06c83cf2-c898-350a-9938-83e702a5f217",
                                                "text": "the reparation of a bridge or of a highway"
                                            },
                                            {
                                                "example_id": "1a1eeb24-cd3d-454e-a4f4-19c3467b1b94",
                                                "sense_id": "06c83cf2-c898-350a-9938-83e702a5f217",
                                                "text": "The church at Lichfield, in which we had a seat, wanted reparation, so I was to go and find a seat in other churches; and having bad eyes, and being awkward about this, I used to go and read in the fields on Sunday."
                                            }
                                        ]
                                    }
                                ]
                            }
