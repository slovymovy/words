                ],
                "senses": [
                    {
                        "sense_id": "1d275665-d4cb-3971-9d47-ec9633690e1a",
                        "entry_id": "2ecf3a14-c04d-3fbc-a05f-0b200f349e2c",
                        "glosses": [
                            "in einem an Senf erinnernden Gelbton, gelb wie Senf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac7b60dd-4474-4c5d-bd61-63aa2130cda4",
                                "sense_id": "1d275665-d4cb-3971-9d47-ec9633690e1a",
                                "text": "„Es war senfgelb und nur fünf Stockwerke hoch.“"
                            },
                            {
                                "example_id": "a1688105-3fb2-4470-9d32-05d44e494a15",
                                "sense_id": "1d275665-d4cb-3971-9d47-ec9633690e1a",
                                "text": "„Der Rest von ihm in einem braunen Anzug von der Stange. Braune Schuhe. Eine senfgelbe Weste.“"
                            },
                            {
                                "example_id": "fe6118b9-6ca7-4bb5-8223-25ba94e492e7",
                                "sense_id": "1d275665-d4cb-3971-9d47-ec9633690e1a",
                                "text": "„Um die an alle Gefangenen verteilte senfgelbe Kleidung nicht tragen zu müssen, erwarb Churchill einen dunklen Tweedanzug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
