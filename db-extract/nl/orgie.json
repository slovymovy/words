                "translations": [
                    {
                        "translation_id": "08f91b16-c5be-45ec-87f6-aa069ae72522",
                        "source_entry_id": "9264f5ca-34c6-3e8c-826c-4c137123d5cf",
                        "target_lang_word": "Orgie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orgie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "019ecdb7-f9d9-3353-b903-730771f8c0bf",
                                        "entry_id": "cc2aef91-177f-3283-b18f-17e9ba95a3b6",
                                        "glosses": [
                                            "große Feier mit üppigem Essen, die durch ausschweifendes, unsittliches Handeln (oft sexuellen Charakters) geprägt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1214e530-3230-47b0-9f7f-f218483c88ff",
                                                "sense_id": "019ecdb7-f9d9-3353-b903-730771f8c0bf",
                                                "text": "Ja, ich möchte an dieser Orgie teilnehmen."
                                            },
                                            {
                                                "example_id": "cc1c06a8-3864-4ee9-8ead-5580eb0e8e09",
                                                "sense_id": "019ecdb7-f9d9-3353-b903-730771f8c0bf",
                                                "text": "„Die Orgie begann unverzüglich.“"
                                            },
                                            {
                                                "example_id": "bbe184a2-1694-431d-a926-b265632dfb7f",
                                                "sense_id": "019ecdb7-f9d9-3353-b903-730771f8c0bf",
                                                "text": "„Der Gegensatz ist überdeutlich: Kaahumanu, diese große Königin, die während der furchtbaren Orgien, die nach alter Sitte auf den Tod des Königs folgten, »geschmäht« wurde, wandelte sich später zu einer frommen Christin und wurde eine treue und standhafte Freundin der Missionare.“"
                                            },
                                            {
                                                "example_id": "b94f3347-30e9-4482-a97f-e78ef110a175",
                                                "sense_id": "019ecdb7-f9d9-3353-b903-730771f8c0bf",
                                                "text": "„Der etwa vierzigjährige Herrscher schien jedoch Orgien jeder Art längst nicht mehr gewachsen.“"
                                            },
                                            {
                                                "example_id": "70736106-218d-4548-98d9-15901a7b0f9d",
                                                "sense_id": "019ecdb7-f9d9-3353-b903-730771f8c0bf",
                                                "text": "„Und diese beiden miteinander verflochtenen Stränge machten es schwer, die Orgie zu diskreditieren.“"
                                            },
                                            {
                                                "example_id": "28d8d9a1-f446-4a08-b008-f4d20d62fb4f",
                                                "sense_id": "019ecdb7-f9d9-3353-b903-730771f8c0bf",
                                                "text": "„Es war eine Kaschemme, eine mitternächtliche Orgie in einer richtigen Lasterhöhle, ein Schandbetrieb widerlichster Art.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f148d89-62b2-3240-8a4f-b423575d438b",
                                        "entry_id": "cc2aef91-177f-3283-b18f-17e9ba95a3b6",
                                        "glosses": [
                                            "Maßlosigkeit, großes Ausmaß von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db21973-a2b6-42c9-b82e-a762a1bc8632",
                                                "sense_id": "6f148d89-62b2-3240-8a4f-b423575d438b",
                                                "text": "„Der Tanz um das Goldene Kalb war eine Orgie der Hoffnungslosigkeit.“"
                                            },
                                            {
                                                "example_id": "4b66c8e7-37df-4591-b7d9-7746a2ff5fb3",
                                                "sense_id": "6f148d89-62b2-3240-8a4f-b423575d438b",
                                                "text": "„Tim Kretschmer, 17, liebte Waffen und Computerspiele – und stürzte sich in eine Orgie der Gewalt, eine Serie von Exekutionen.“"
                                            },
                                            {
                                                "example_id": "0f74a133-95f7-4509-b5de-8ddfcbe6a99f",
                                                "sense_id": "6f148d89-62b2-3240-8a4f-b423575d438b",
                                                "text": "„Rasch entfernten sich die beiden Männer von dieser Orgie des Lärms und bald nahmen sie die schalldichten Mauern der Urwaldbüsche auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0859b9f-4b59-43fd-99fb-5622a03dd915",
                        "source_entry_id": "9264f5ca-34c6-3e8c-826c-4c137123d5cf",
                        "target_lang_word": "orgy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orgy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ba36fb2-5e9d-3d25-ba2b-4c76cab15315",
                                        "entry_id": "6ab3d82c-34bf-3799-b737-0e65ca360f3b",
                                        "glosses": [
                                            "A secret rite or ceremony, typically involving riotous and dissolute behavior, including dancing, drunkenness and indiscriminate sexual activity, undertaken in honor of various pagan gods or goddesses (such as Attis, Bacchus, Ceres, Dionysus, Osiris, etc)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9628806b-3f24-49d0-85f3-6acf279df119",
                                                "sense_id": "2ba36fb2-5e9d-3d25-ba2b-4c76cab15315",
                                                "text": "Human sacrifices of a definitely black magical order took place at the tomb of Osiris, while similar orgies with human victims were performed at Heliopolis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79ca2bbf-f112-388b-ab8b-cc6b2d567dd3",
                                        "entry_id": "6ab3d82c-34bf-3799-b737-0e65ca360f3b",
                                        "glosses": [
                                            "A gathering of people to engage in group sex."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3da6455f-e487-3392-a62a-4e42093b8291",
                                        "entry_id": "6ab3d82c-34bf-3799-b737-0e65ca360f3b",
                                        "glosses": [
                                            "An instance or period of excessive indulgence in a specified activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6499e3c0-e320-491c-a795-702ce2777c2d",
                                                "sense_id": "3da6455f-e487-3392-a62a-4e42093b8291",
                                                "text": "Gorea 07: 'OUR DEFENSES WERE USELESS AGAINST GOREA AS IT SWEPT THROUGH OUR EMPIRE IN AN ORGY OF ANNIHILATION.'"
                                            },
                                            {
                                                "example_id": "99ca7ec0-4461-45ce-9612-ab05049fe538",
                                                "sense_id": "3da6455f-e487-3392-a62a-4e42093b8291",
                                                "text": "It's an orgy of perfectly choreographed cartoon uber violence and is the game the Devil May Cry series always promised but never delivered."
                                            },
                                            {
                                                "example_id": "c0975d6d-b6c9-4bfd-aad8-1767fc0a3b5f",
                                                "sense_id": "3da6455f-e487-3392-a62a-4e42093b8291",
                                                "text": "The wails of the injured and the roars of the dead-on-the-march overwhelmed the tinny speakers in the cell, and they all watched as nearly one thousand people reduced themselves to a few frantic hundred in less than an hour, then settled into a sustained orgy of battery, rapine and rape with no end in sight but the total depopulation of the entire facility."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f15a600d-3920-4c59-ba0a-d9074ab43aea",
                        "source_entry_id": "9264f5ca-34c6-3e8c-826c-4c137123d5cf",
                        "target_lang_word": "orgie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orgie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44498650-5ab3-3f37-9413-7d9b05cad9e4",
                                        "entry_id": "b218ccf0-a7a6-3f05-922c-4e706c49fe94",
                                        "glosses": [
                                            "Fêtes de Bacchus."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "note": "Dans ce sens, il s’emploie surtout au pluriel, comme bacchanales",
                                        "examples": [
                                            {
                                                "example_id": "b8cc23d0-c1fb-4dc4-a48c-512022edb80a",
                                                "sense_id": "44498650-5ab3-3f37-9413-7d9b05cad9e4",
                                                "text": "Il prétend que Bacchus et ses orgies étaient célébrés par les Grecs avant qu’ils eussent pu connaître les livres de Moïse; et qu’ils n’ont pas pu prendre l’idée de Bacchus sur les livres juifs qu’ils n'entendaient pas; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb6826f-56b1-3ef3-bf5d-e883cdc8bd74",
                                        "entry_id": "b218ccf0-a7a6-3f05-922c-4e706c49fe94",
                                        "glosses": [
                                            "Débauche de toute sorte et particulièrement débauche sexuelle en groupe ou d’excès de table."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "972ea821-a83d-4e25-9bef-8df616eaa90b",
                                                "sense_id": "deb6826f-56b1-3ef3-bf5d-e883cdc8bd74",
                                                "text": "Elle finit par raconter que, si les uns accusaient simplement M. Grandguillot d’avoir joué à la Bourse, d’autres affirmaient qu’il avait des femmes, à Marseille. Enfin, des orgies, des passions abominables."
                                            },
                                            {
                                                "example_id": "e77838df-0ac6-478b-910b-5ecba02b1d33",
                                                "sense_id": "deb6826f-56b1-3ef3-bf5d-e883cdc8bd74",
                                                "text": "Jamais, peut-être, pareille orgie ne s’était déroulée à la face du ciel depuis les tristes âges du paganisme, et, si je n’avais été prévenu, je me serais cru transporté par un songe diabolique dans les sentines de Suburre, dans les lupanars de Capoue."
                                            },
                                            {
                                                "example_id": "6424edbb-d9c6-4b8d-a528-88e24c1a0d53",
                                                "sense_id": "deb6826f-56b1-3ef3-bf5d-e883cdc8bd74",
                                                "text": "À l’orgie latine succédèrent les ébats des Barbares, dignes héritiers de ces Romains gorgés de falerne et de sang, épuisés de stupre, sombrés dans les velléités."
                                            },
                                            {
                                                "example_id": "494a2795-83f5-4a29-afbb-6fda1d8ccbf3",
                                                "sense_id": "deb6826f-56b1-3ef3-bf5d-e883cdc8bd74",
                                                "text": "Nous ne voulons pas entrer dans la vie privée de beaucoup de canotiers; mais à en croire les apparences, le canotage ne serait, pour quelques amateurs, qu’un prétexte d’orgies, une occasion de plaisirs faciles, au lieu d’un amusement salutaire et convenable à la dignité de l’homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "080740dd-49db-3442-8b7c-6bc96c895dcc",
                                        "entry_id": "b218ccf0-a7a6-3f05-922c-4e706c49fe94",
                                        "glosses": [
                                            "Excès ; surabondance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9adbe8cc-45d6-4119-b7ed-0c983ad21847",
                                                "sense_id": "080740dd-49db-3442-8b7c-6bc96c895dcc",
                                                "text": "Nous allons faire une orgie de sushis, dit Kakuro en déployant sa serviette d'un geste enthousiaste."
                                            },
                                            {
                                                "example_id": "4bcb80dd-10b6-42bd-bae8-4dbe4c9106fd",
                                                "sense_id": "080740dd-49db-3442-8b7c-6bc96c895dcc",
                                                "text": "La fête se termina par des réjouissances bruyantes : musique, sonneries de clairons, roulements de tambours, fantasias échevelées, décharges retentissantes d’artillerie et de mousqueterie, — une orgie de couleurs, de mouvement et de bruit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5349386-de4b-4d28-8e5d-e77224e1a3a3",
