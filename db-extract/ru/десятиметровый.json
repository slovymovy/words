                "senses": [
                    {
                        "sense_id": "3a3c3ffb-aa5e-3921-a8fc-ff76c940b85c",
                        "entry_id": "f6652a46-a4af-3745-8a28-58a188bb6c06",
                        "glosses": [
                            "имеющий размер (длину, высоту, ширину и т. п.) в десять метров"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fccb97e-fec7-4df7-8099-e79c193d0484",
                                "sense_id": "3a3c3ffb-aa5e-3921-a8fc-ff76c940b85c",
                                "text": "Огромные, сплошь покрытые пеной валы вздымались на десятиметровую высоту."
                            },
                            {
                                "example_id": "c0258898-4925-46ba-9e75-a21747bc5793",
                                "sense_id": "3a3c3ffb-aa5e-3921-a8fc-ff76c940b85c",
                                "text": "С трудом втискивались в тесно заставленную десятиметровую комнату."
                            }
                        ]
                    }
                ],
