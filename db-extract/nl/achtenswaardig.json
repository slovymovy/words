                                            {
                                                "example_id": "26044547-532b-4ba6-9c51-6bb2ffd66b21",
                                                "sense_id": "ea658864-e5df-3a36-a2cd-43df7b6df8f2",
                                                "text": "In seiner Abschlussprüfung erzielte er eine respektable Leistung."
                                            }
