                ],
                "senses": [
                    {
                        "sense_id": "1c36ba0e-ca2f-3721-afaa-fc1179033009",
                        "entry_id": "dab51bf2-b11d-3638-afd0-711f34f931e8",
                        "glosses": [
                            "Hummel oder Honigbiene, die nach der Ablage von Eiern der Fliegenart Apocephalus borealis in ihrem Körper ziellos umherfliegen, da die Larven das Gehirn der Biene angreifen, was schließlich zum Tod der Biene führt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "98599b18-6f84-4b4f-8f7d-51c62ec9c273",
                                "sense_id": "1c36ba0e-ca2f-3721-afaa-fc1179033009",
                                "text": "„Im Jahr 2008 sind die Zombie-Bienen der Forschung erstmals aufgefallen.“"
                            },
                            {
                                "example_id": "45e17818-4f92-4def-bf83-f6237d80e870",
                                "sense_id": "1c36ba0e-ca2f-3721-afaa-fc1179033009",
                                "text": "„Bei den Zombie-Bienen und den sie parasitierenden Fliegen konnten Forscher aber mittlerweile zweifelsfrei nachweisen, dass beide auch mit bestimmten Viren infiziert waren.“"
                            },
                            {
                                "example_id": "3aad4e7f-9ec6-4b62-9773-039d37090e1b",
                                "sense_id": "1c36ba0e-ca2f-3721-afaa-fc1179033009",
                                "text": "„Imker in den USA werden langsam unruhig. Denn nicht nur wie bisher an der Westküste finden sie sogenannte Zombie-Bienen in ihren Stöcken – sondern auch vermehrt an der Ostküste.“"
                            },
                            {
                                "example_id": "150f452d-efb8-4aa9-b70b-d6c82ada5625",
                                "sense_id": "1c36ba0e-ca2f-3721-afaa-fc1179033009",
                                "text": "„Die Zombie-Bienen schwirren wohl selbst in den betroffenen Gebieten nur sporadisch durch die Nacht.“"
                            },
                            {
                                "example_id": "aa0f9ffa-94d8-488b-ab1f-eba1e3a3569e",
                                "sense_id": "1c36ba0e-ca2f-3721-afaa-fc1179033009",
                                "text": "„Sie schickte Fotos und Proben an den Biologen John Hafernik, der gemeinsam mit seinen Kollegen das Projekt \"ZomBee Watch\" ins Leben rief, bei dem Sichtungen von Zombie-Bienen gemeldet werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
