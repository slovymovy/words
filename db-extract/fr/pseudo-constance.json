                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d38a638-516d-4f02-9c52-ca563f39e0f5",
                                "sense_id": "2231d210-cddd-3206-9519-63b1959a8601",
                                "text": "On compounde ou on isochronise pour les charges extrêmes, et la pseudo-constance est obtenue pour les charges intermédiaires."
                            },
                            {
                                "example_id": "5bc08673-854d-4d16-8ffc-5d2739bee8b0",
                                "sense_id": "2231d210-cddd-3206-9519-63b1959a8601",
                                "text": "Dans ce cas, la pseudo-constance (d) de la forme pseudo-rectangulaire, loin d’être détruite radicalement par le mouvement, réagit sur l’apparence de celui-ci et la transforme."
                            },
                            {
                                "example_id": "a2a97cb7-a649-4fd4-9bc8-451dcc46ffdc",
                                "sense_id": "2231d210-cddd-3206-9519-63b1959a8601",
                                "text": "Selon Véronique Rouyer, il existerait, avant la phase de constance de genre, une phase de pseudo-constance traditionnelle."
                            }
                        ]
                    }
