                                        ]
                                    },
                                    {
                                        "sense_id": "2b7f931f-5a92-32db-9605-beaf7217ce0f",
                                        "entry_id": "e4785d3c-2de5-3bd9-a12d-dfe4b9ca1ee7",
                                        "glosses": [
                                            "osoba, která jinou osobu vykořisťuje, okrádá"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f299e0a-2786-4cbb-9574-285bc154988d",
                                                "sense_id": "2b7f931f-5a92-32db-9605-beaf7217ce0f",
                                                "text": "Ti vyděrači už zase zvedli účet za elektřinu."
                                            }
                                        ]
                                    }
                                ]
