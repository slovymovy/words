                                            {
                                                "example_id": "e803d98f-89ba-467a-8ac3-b92dcf6b2855",
                                                "sense_id": "51c0273c-1874-3b0d-903f-21f9d36e830e",
                                                "text": "Der hermetisch abgeriegelte Stadtkern wurde zur Sperrzone erklärt."
                                            },
                                            {
                                                "example_id": "19aa5c7f-d241-4d94-b8fb-48848080e9c5",
                                                "sense_id": "51c0273c-1874-3b0d-903f-21f9d36e830e",
                                                "text": "Der hermetisch abgesperrte Kühlraum wurde zur Falle."
                                            },
                                            {
                                                "example_id": "f5161998-e963-4e18-be8c-614f3436a060",
                                                "sense_id": "51c0273c-1874-3b0d-903f-21f9d36e830e",
                                                "text": "„Solche Ausbrüche aus dem hermetischen Zirkel orthodoxen Lebens aber gibt es nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f6533140-95d2-3156-9ed0-217b623ac9ad",
                                        "entry_id": "8d09bd1d-e1ba-3c80-88e6-be046e38207b",
