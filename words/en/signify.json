{
    "word_family": [
        "sign",
        "signal",
        "significance",
        "significant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "615b804c-e53e-3409-9187-84a9393b4cdc",
                    "sense_definition": "To have a particular meaning or to represent something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The red light <w>signifies</w> that you must stop your car immediately.",
                            "target_lang_translations": {
                                "tr": "Kırmızı ışık, arabanızı derhal durdurmanız gerektiğini <w>anlamına gelir</w>."
                            }
                        },
                        {
                            "text": "A white flag often <w>signifies</w> a desire for peace or surrender.",
                            "target_lang_translations": {
                                "tr": "Beyaz bayrak genellikle barış veya teslim olma isteğini <w>temsil eder</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mean",
                        "betoken",
                        "import"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin belirli bir anlama gelmesi veya bir şeyi temsil etmesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "anlamına gelmek",
                                "target_lang_sense_clarification": "Bir şeyin ifade ettiği anlamı belirtmek için kullanılır."
                            },
                            {
                                "target_lang_word": "işaret etmek",
                                "target_lang_sense_clarification": "Bir durumun veya nesnenin bir şeye delalet etmesi."
                            },
                            {
                                "target_lang_word": "temsil etmek",
                                "target_lang_sense_clarification": "Bir şeyi simgelemek veya onun yerine geçmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65f41cd4-2f06-3fff-a309-9bb28d52ef45",
                    "sense_definition": "To communicate an intention or message through a gesture or sign.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>signified</w> his agreement by nodding his head slowly.",
                            "target_lang_translations": {
                                "tr": "Başını yavaşça sallayarak onayladığını <w>belirtti</w>."
                            }
                        },
                        {
                            "text": "She <w>signified</w> to the waiter that she was ready for the bill.",
                            "target_lang_translations": {
                                "tr": "Garsona hesabı istediğini <w>işaret etti</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir niyet veya mesajı jest veya işaret yoluyla iletmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "işaret etmek",
                                "target_lang_sense_clarification": "Birine bir şeyi anlatmak için el, kol veya baş hareketi yapmak."
                            },
                            {
                                "target_lang_word": "belirtmek",
                                "target_lang_sense_clarification": "Bir durumu veya isteği sözsüz olarak ifade etmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1173d73-8eac-34a0-9a29-dfd86fbc87b1",
                    "sense_definition": "To be important or to make a difference, usually used in negative or questioning contexts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It does not <w>signify</w> whether we arrive early or late.",
                            "target_lang_translations": {
                                "tr": "Erken ya da geç varmamız bir şey <w>ifade etmiyor</w>."
                            }
                        },
                        {
                            "text": "What does it <w>signify</w> if the plan changes now?",
                            "target_lang_translations": {
                                "tr": "Planın şimdi değişmesi ne <w>anlama geliyor</w>?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Önemli olmak veya bir fark yaratmak (genellikle olumsuz veya soru cümlelerinde)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "önem taşımak",
                                "target_lang_sense_clarification": "Bir durumun bir değerinin veya etkisinin olması."
                            },
                            {
                                "target_lang_word": "fark etmek",
                                "target_lang_sense_clarification": "Bir durumun sonucu değiştirip değiştirmediği bağlamında."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4d4c47b-3bea-3719-8104-f7f88cd1b23f",
                    "sense_definition": "To assign a specific meaning or level of importance to something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ceremony <w>signifies</w> the start of a new era for the company.",
                            "target_lang_translations": {
                                "tr": "Tören, şirket için yeni bir dönemin başlangıcını <w>simgeliyor</w>."
                            }
                        },
                        {
                            "text": "Historians <w>signify</w> this event as a turning point in the war.",
                            "target_lang_translations": {
                                "tr": "Tarihçiler bu olayı savaşta bir dönüm noktası olarak <w>nitelendiriyor</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeye belirli bir anlam veya önem derecesi atamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "anlam yüklemek",
                                "target_lang_sense_clarification": "Bir olaya veya nesneye özel bir değer veya anlam atfetmek."
                            },
                            {
                                "target_lang_word": "nitelendirmek",
                                "target_lang_sense_clarification": "Bir şeyi belirli bir şekilde tanımlamak veya sınıflandırmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8124660f-84e8-37cb-91a2-475d6a484cc4",
                    "sense_definition": "To transform something into a sign or symbol.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist sought to <w>signify</w> the abstract concept of freedom through sculpture.",
                            "target_lang_translations": {
                                "tr": "Sanatçı, heykel aracılığıyla soyut özgürlük kavramını <w>simgeselleştirmeye</w> çalıştı."
                            }
                        },
                        {
                            "text": "They <w>signified</w> the territory by placing markers along the border.",
                            "target_lang_translations": {
                                "tr": "Sınır boyunca işaretler yerleştirerek bölgeyi <w>işaretlediler</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi işaret veya sembole dönüştürmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "simgeselleştirmek",
                                "target_lang_sense_clarification": "Bir kavramı sembol haline getirmek."
                            },
                            {
                                "target_lang_word": "işaretlemek",
                                "target_lang_sense_clarification": "Bir yeri veya nesneyi belirgin hale getirmek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}