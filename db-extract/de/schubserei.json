                "senses": [
                    {
                        "sense_id": "bdf8a8dc-3229-347e-ad31-35de85e847d7",
                        "entry_id": "6123e375-e011-3525-bd07-4afaa3fbfb49",
                        "glosses": [
                            "Stoßen oder Schieben einer anderen Person, oft mit der Absicht, diese Person zu ärgern oder zu provozieren, wobei dies oft zu einem Konflikt oder einer Streitigkeit führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3a5777b-7101-42ee-b1a2-f62e318c9c4b",
                                "sense_id": "bdf8a8dc-3229-347e-ad31-35de85e847d7",
                                "text": "„Wir in Endeln begannen unsere Kämpfe seit eh und je auf dem Schulhof oder nachmittags beim Cowboy- und Indianerspiel immer mit einer Schubserei, die dann in einem Ringkampf endete. Wer unten auf dem Boden lag, hatte verloren.“"
                            },
                            {
                                "example_id": "bb48cf8c-6fb1-4a4f-8e90-ba0dc016ec6d",
                                "sense_id": "bdf8a8dc-3229-347e-ad31-35de85e847d7",
                                "text": "„Die waren genauso schnell auf den Beinen, und schon ging die übliche, von wüsten Drohungen begleitete Schubserei los.“"
                            },
                            {
                                "example_id": "6a09de85-8401-42f6-9d55-58f7f1aef4d6",
                                "sense_id": "bdf8a8dc-3229-347e-ad31-35de85e847d7",
                                "text": "„Eine Schubserei und Stoßerei. Das Ganze verlagerte sich auf die andere Straßenseite zu einem Blumenverkaufsstand, wo Spätberufene Blumen vom Automaten herauslassen können. Dort war ein kleiner Vorplatz. Hier ging die Schubserei weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
