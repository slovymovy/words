                "translations": [
                    {
                        "translation_id": "a1caea33-ea66-4dc3-9f3e-c786ad255cb2",
                        "source_entry_id": "08bd4d9b-2d9b-341d-801e-37849285316e",
                        "source_sense_id": "15256272-06f6-3ca7-b0d2-080743417044",
