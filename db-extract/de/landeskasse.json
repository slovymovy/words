                "senses": [
                    {
                        "sense_id": "e3d63ef3-b9d9-34ad-a057-53f5786d9c40",
                        "entry_id": "6bd8f29c-3c76-3534-8934-63b27adc0eb9",
                        "glosses": [
                            "Gesamtheit der vorhandenen Geldmittel eines Staates oder Bundeslandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c28fac22-76d2-49b0-b9b8-6a0f8ebb114f",
                                "sense_id": "e3d63ef3-b9d9-34ad-a057-53f5786d9c40",
                                "text": "„Das Land Salzburg hat von der Möglichkeit solcher Landesausspielungen bislang keinen Gebrauch gemacht und kann zumindest in gegenständlicher Angelegenheit daher keinesfalls das Ziel unterstellt werden, die Einnahmen der Landeskasse zu maximieren.“"
                            },
                            {
                                "example_id": "ddf2e784-8222-4c7e-94fb-0eb66729e192",
                                "sense_id": "e3d63ef3-b9d9-34ad-a057-53f5786d9c40",
                                "text": "„Ist der Rechtsanwalt sonst gerichtlich bestellt oder beigeordnet worden, erhält er die Vergütung aus der Landeskasse, wenn ein Gericht des Landes den Rechtsanwalt bestellt oder beigeordnet hat, im Übrigen aus der Bundeskasse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1bd2eec-d2da-4b6f-8cf2-aa08f945f01e",
                        "source_entry_id": "6bd8f29c-3c76-3534-8934-63b27adc0eb9",
                        "source_sense_id": "e3d63ef3-b9d9-34ad-a057-53f5786d9c40",
                        "source_sense_description": "Gesamtheit der vorhandenen Geldmittel eines Staates oder Bundeslandes",
                        "target_lang_word": "trésor public",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trésor public",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30a542ea-d4a7-39e7-a152-582ccb846857",
                                        "entry_id": "1da07ebb-d8b9-3061-be32-ec5c0924ccb4",
                                        "glosses": [
                                            "Administration fiscale d’un pays."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd09f21b-02a5-4de8-a030-1716c6ccde17",
                                                "sense_id": "30a542ea-d4a7-39e7-a152-582ccb846857",
                                                "text": "Les trésors publics, appelés aerarium pendant l'empire Romain, appartenaient à la république, c'est-à-dire au peuple Romain, alors que le fisc était le patrimoine particulier du prince."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa8feb8-7d50-3a78-ab9f-f4f70ef5333b",
                                        "entry_id": "1da07ebb-d8b9-3061-be32-ec5c0924ccb4",
                                        "glosses": [
                                            "Ensemble des moyens financiers dont dispose l'État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3fec467-3697-4095-b601-3e9824a5b044",
                                                "sense_id": "afa8feb8-7d50-3a78-ab9f-f4f70ef5333b",
                                                "text": "La banque centrale finance un déficit du trésor public soit par avances directes, soit par achat d'effets publics émis sur le marché monétaire."
                                            },
                                            {
                                                "example_id": "b2a51cec-7c70-4119-b757-f47ed6454e43",
                                                "sense_id": "afa8feb8-7d50-3a78-ab9f-f4f70ef5333b",
                                                "text": "[L'intervention du gouvernement] est un mal (…) parce qu'elle est coûteuse, soit pour le contribuable, quant [elle] est gratuite, c'est-à-dire, quand elle a lieu aux frais du trésor public ; soit pour le consommateur, quand on prélève les frais en une taxe sur la marchandise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
