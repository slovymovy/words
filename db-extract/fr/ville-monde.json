                                        "entry_id": "6a1801c2-382d-33a2-a22b-36b885d0cd14",
                                        "glosses": [
                                            "A city that links a major economic state or region into the world economy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b954ac4d-8a17-46b5-a115-888dc6e41046",
                                                "sense_id": "a06b0fd5-3354-367e-a200-fffa2e381f92",
                                                "text": "Exporting advanced services across the globe, they represent mini-economies in themselves. I am much more likely to run into an American who is a leading global innovator in an alpha city like Shanghai or Dubai than I am to see her or him in St. Louis, Missouri, or Manchester, England."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
