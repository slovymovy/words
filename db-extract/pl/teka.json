                    },
                    {
                        "sense_id": "af30e7ab-7ebf-3070-b022-291ef05e8ecb",
                        "entry_id": "e42005fc-5242-374a-b957-d1be0360d145",
                        "glosses": [
                            "zbiór prac jednego artysty lub wielu artystów na jeden temat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "185dd2e2-9ef7-484e-82bb-3a31256eeeac",
                                "sense_id": "af30e7ab-7ebf-3070-b022-291ef05e8ecb",
                                "text": "Dziś w Hejdyku pozostały może dwie, może trzy stare chaty. Reszta istnieje w tekach Zofii Góralczyk, na wydanych przez nią pocztówkach"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "4fa4601d-42b5-31bc-b21b-473169545bee",
                        "entry_id": "e42005fc-5242-374a-b957-d1be0360d145",
                        "glosses": [
                            "zbiór dokumentów i maszynopisów czekających na wydanie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "400e4b0e-08a7-33b6-b290-b74910b0db9c",
                        "entry_id": "e42005fc-5242-374a-b957-d1be0360d145",
                        "glosses": [
                            "stanowisko ministra mającego pod sobą departament lub premiera"
                        ],
                        "tags": [
                            "publ."
                        ],
                        "examples": [
                            {
                                "example_id": "cd90f558-e7c7-47e8-902b-fe74b1beeae6",
                                "sense_id": "400e4b0e-08a7-33b6-b290-b74910b0db9c",
                                "text": "Chciał ukończyć studia w prestiżowym Uniwersytecie Tokijskim, a zwieńczeniem kariery miała być teka premiera japońskiego rządu"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1864990d-1901-4906-a863-a068dd198ad9",
                        "source_entry_id": "e42005fc-5242-374a-b957-d1be0360d145",
                        "source_sense_id": "af30e7ab-7ebf-3070-b022-291ef05e8ecb",
                        "target_lang_word": "portfolio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portfolio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3673c17-aae7-3cd0-be33-f83350b6d8a8",
                                        "entry_id": "2c6f1713-3429-3faa-8118-57d14ed6e5f3",
                                        "glosses": [
                                            "A case for carrying papers, drawings, photographs, maps and other flat documents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8c658c0-1e38-4bc7-94d7-57daf7dadd0a",
                                                "sense_id": "d3673c17-aae7-3cd0-be33-f83350b6d8a8",
                                                "text": "He opened an embroidered portfolio; and, from its perfumed depths, took out a letter, which he began to read aloud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9602d9e-9c7b-3e4c-a349-7ee120e1b699",
                                        "entry_id": "2c6f1713-3429-3faa-8118-57d14ed6e5f3",
                                        "glosses": [
                                            "The collection of such documents, especially the works of an artist or photographer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a19c74e0-2364-32aa-8c7a-8e9d7d616245",
                                        "entry_id": "2c6f1713-3429-3faa-8118-57d14ed6e5f3",
                                        "glosses": [
                                            "The post and the responsibilities of a cabinet minister or other head of a government department."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70111a80-8910-36db-9dfc-d6a5b4e08a50",
                                        "entry_id": "2c6f1713-3429-3faa-8118-57d14ed6e5f3",
                                        "glosses": [
                                            "The group of investments and other assets held by an investor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b949b2a-9f4b-4749-8391-62731fb438c8",
                                                "sense_id": "70111a80-8910-36db-9dfc-d6a5b4e08a50",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "995f8fd3-4cc8-37c6-a88a-0c2d3d2ff7f3",
                                        "entry_id": "2c6f1713-3429-3faa-8118-57d14ed6e5f3",
                                        "glosses": [
                                            "A collection of assets; (figurative) any collection of things considered as investments or assets, (rarely) also liabilities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d56def21-eb39-40df-92c9-0f8c297a3d66",
                                                "sense_id": "995f8fd3-4cc8-37c6-a88a-0c2d3d2ff7f3",
                                                "text": "I would like to introduce you to our portfolio of services."
                                            },
                                            {
                                                "example_id": "6552be93-e0a4-408a-a4f5-2760e2109fc8",
                                                "sense_id": "995f8fd3-4cc8-37c6-a88a-0c2d3d2ff7f3",
                                                "text": "In the past, thoughts were too real to be kept like a cultural portfolio of stocks and bonds. But now we have mental assets."
                                            },
                                            {
                                                "example_id": "a3696d56-f3c8-451b-9ed2-00cb6f879ebc",
                                                "sense_id": "995f8fd3-4cc8-37c6-a88a-0c2d3d2ff7f3",
                                                "text": "Father: Darling, and no disrespect to you, Vicar, but what I'm thinking is this. How about a mixed portfolio, whereby we spread him through Judaism, Islam, Hindu, and so on, maintaining a firm base in the Church of England?\nMother: It does sound safer.\nFather: Exactly."
                                            },
                                            {
                                                "example_id": "1dbeaafe-18a5-423e-afc3-760809e2b465",
                                                "sense_id": "995f8fd3-4cc8-37c6-a88a-0c2d3d2ff7f3",
                                                "text": "Promising to protect the welfare state while adding further obligations to its portfolio has become customary for SPD and Greens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "367aba13-cc82-38c6-aba0-e06de38524ab",
                                        "entry_id": "2c6f1713-3429-3faa-8118-57d14ed6e5f3",
                                        "glosses": [
                                            "A range of products."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e394437-dce6-4b4c-a7df-86c47ee999f5",
                                                "sense_id": "367aba13-cc82-38c6-aba0-e06de38524ab",
                                                "text": "product portfolio"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
