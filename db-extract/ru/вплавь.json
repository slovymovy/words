                                    {
                                        "sense_id": "a6cd58e0-34ba-38e3-8f16-d6a108fb8e45",
                                        "entry_id": "98a8621b-85e0-3be6-913b-5efcb94be0e9",
                                        "glosses": [
                                            "Qui peut nager."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87a8702e-51cb-4d22-bbae-7f5b4ede38db",
                                                "sense_id": "a6cd58e0-34ba-38e3-8f16-d6a108fb8e45",
                                                "text": "De l'œuf sort une larve nageante, le miracidium, qui pénètre dans un mollusque gastéropode d’eau douce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbb67c4b-f0e2-3d87-aea0-c7d06aa5d853",
                                        "entry_id": "98a8621b-85e0-3be6-913b-5efcb94be0e9",
                                        "glosses": [
                                            "Qui se soutient sur l’eau (feuilles ; plantes)."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nageant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e3c876c-aa46-3ac7-9099-149c9790cf03",
                                        "entry_id": "e943ddab-146d-3c96-928e-33d331cb37f0",
                                        "glosses": [
                                            "Participe présent du verbe nager."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8ac8589-ac03-4225-9f84-b2dee8cc863b",
                                                "sense_id": "8e3c876c-aa46-3ac7-9099-149c9790cf03",
                                                "text": "Si vous vous retrouvez pris dans la baïne, ne tentez pas de rejoindre la terre ferme en nageant à contre-courant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abf1aa2c-1196-3baf-a1d9-6aa2cbf0c293",
                                        "entry_id": "e943ddab-146d-3c96-928e-33d331cb37f0",
                                        "glosses": [
                                            "Se dit d’un poisson qui est représenté en fasce la tête orientée vers dextre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1322f77a-b521-469a-97b9-9371fb558d9d",
                                                "sense_id": "abf1aa2c-1196-3baf-a1d9-6aa2cbf0c293",
                                                "text": "Écartelé, au 1 et 4 de sable au lion d’argent armé, lampassé et couronné d’or, au 2 et 3 d’azur à trois poissons d’argent nageant l’un sur l’autre, le second contourné, qui est de La-Tourette → voir illustration « poissons nageant »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f763dc8d-6cda-3140-a3ad-b0aafa58922b",
                                        "entry_id": "e943ddab-146d-3c96-928e-33d331cb37f0",
                                        "glosses": [
                                            "Se dit du dauphin qui est représenté en fasce la tête orientée vers dextre le corps ondulant."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49bfa638-9680-4318-8121-bf8f2fe60181",
                                                "sense_id": "f763dc8d-6cda-3140-a3ad-b0aafa58922b",
                                                "text": "Parti, au premier de gueules au lion d’or lampassé et vilené de gueules surmonté d’une couronne d’or, accompagné de deux burèles vivrées cousues d’azur, l’une en chef et l’autre en pointe, au second d’azur aux trois dauphins d’or nageant l'un sur l'autre, qui est de Lavandou → voir illustration « dauphins nageant »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cee2823-17eb-3aed-b708-c3311cab07d0",
                                        "entry_id": "e943ddab-146d-3c96-928e-33d331cb37f0",
                                        "glosses": [
                                            "Se dit des oiseaux qui sont représentés sans pattes et/ou posés sur une onde (rivière, mer…)."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c54b088e-f963-4d14-8632-c56dbe350064",
                                                "sense_id": "6cee2823-17eb-3aed-b708-c3311cab07d0",
                                                "text": "D’azur semé de fleurs de lys d’or au cygne d’argent nageant sur une champagne ondée du même chargée de deux burèles ondées du champ, qui est de Châtrices → voir illustration « cygne nageant »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
