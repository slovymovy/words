                "senses": [
                    {
                        "sense_id": "2c9096d3-3abc-3992-a1a8-e32ee4f44509",
                        "entry_id": "8140f21e-289a-302d-b945-08b94cdf1268",
                        "glosses": [
                            "Arriver à toute vitesse, débouler ^([1])."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "34155f68-413d-4020-90ab-de23822f14b5",
                                "sense_id": "2c9096d3-3abc-3992-a1a8-e32ee4f44509",
                                "text": "Donc ok ? D'accord, les gars ? Je pars en éclaireur et en cas de pépin vous raboulez tous."
                            }
                        ]
                    },
                    {
                        "sense_id": "04eaca56-0fd7-31ba-b29c-aa01ab9bc3d4",
                        "entry_id": "8140f21e-289a-302d-b945-08b94cdf1268",
                        "glosses": [
                            "Venir, revenir ^([2])."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "987a30fc-0b1b-489d-b314-ae542b339ae3",
                                "sense_id": "04eaca56-0fd7-31ba-b29c-aa01ab9bc3d4",
                                "text": "Ma mère me tirait violemment : « Tu te raboules ou quoi ? Tu ne vas pas rester là avec cet air idiot pendant une semaine, non ? »"
                            }
                        ]
                    },
                    {
                        "sense_id": "888efe66-2739-3099-b44a-6fc1a5a928d7",
                        "entry_id": "8140f21e-289a-302d-b945-08b94cdf1268",
                        "glosses": [
                            "Donner, en parlant d’argent."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "39f12d6c-c02b-4cd3-9d62-752518d78031",
                                "sense_id": "888efe66-2739-3099-b44a-6fc1a5a928d7",
                                "text": "OK, faut que tu raques, enlève ton froc, raboule le fric, Fait pas de phases de break, c'est la ruée vers l'or"
                            }
                        ]
                    },
