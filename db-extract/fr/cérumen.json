                        "source_sense_id": "884b340d-34ca-3322-97d9-ec7f42ca8193",
                        "source_sense_description": "Substance cireuse sécrétée par l’oreille",
                        "target_lang_word": "се́ра",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "се́ра",
