                "senses": [
                    {
                        "sense_id": "23b0df7f-10f3-3b3c-808c-c292ea44e2be",
                        "entry_id": "bcc4e6eb-984f-3040-a264-bd17233b6673",
                        "glosses": [
                            "Athlète courant le 100 mètres haies (pour les femmes), le 110 mètres haies (pour les hommes) ou le 400 mètres haies."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "a1868db1-1c99-47aa-958b-750fbe145e87",
                                "sense_id": "23b0df7f-10f3-3b3c-808c-c292ea44e2be",
                                "text": "Le hurdler britannique Callum Priestley a été suspendu deux ans pour dopage par la Fédération britannique d’athlétisme (UKA) pour avoir pris du clenbutérol, un anabolisant."
                            },
                            {
                                "example_id": "54bc865d-929b-4536-ae87-b3e6419f47c5",
                                "sense_id": "23b0df7f-10f3-3b3c-808c-c292ea44e2be",
                                "text": "Dans ce contexte, les absences du hurdler Ladji Doucouré et de Mehdi Baala, médaillé olympique et double champion d’Europe sortant du 1500 m (2002/2006), sont quasiment passées inaperçues."
                            },
                            {
                                "example_id": "e65d7e36-ea83-43b8-bf3b-36c78c293780",
                                "sense_id": "23b0df7f-10f3-3b3c-808c-c292ea44e2be",
                                "text": "Après avoir perdu en route le hurdler multimédaillé Pascal Martinot-Lagarde, devancé par trois concurrents, et Renaud Lavillenie, blessé, l’équipe de France manque cruellement de piliers."
                            }
                        ]
                    }
