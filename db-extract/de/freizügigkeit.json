                    },
                    {
                        "sense_id": "06af0c8e-3de2-3d25-ac2d-8f6af5469a8d",
                        "entry_id": "a1722f76-88e2-3b79-8be7-7bd48aa6d2d0",
                        "glosses": [
                            "Audace."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "52391c67-f393-31b4-bcbd-97a2de5ade06",
                        "entry_id": "a1722f76-88e2-3b79-8be7-7bd48aa6d2d0",
                        "glosses": [
                            "Largeur d’esprit."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e0064a4d-1d9a-3b93-a9d8-8243066bd872",
                        "entry_id": "a1722f76-88e2-3b79-8be7-7bd48aa6d2d0",
                        "glosses": [
                            "Le droit du libre choix du lieu de résidence : liberté de circulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2efb499e-27a9-4695-952c-9088c83b2169",
                                "sense_id": "e0064a4d-1d9a-3b93-a9d8-8243066bd872",
                                "text": "Alle Deutschen genießen Freizügigkeit im ganzen Bundesgebiet. (article 11 de la loi fondamentale allemande)"
                            },
                            {
                                "example_id": "319a2444-57c1-4e6a-b7b2-2c9641d747a5",
                                "sense_id": "e0064a4d-1d9a-3b93-a9d8-8243066bd872",
                                "text": "Mit der Unionsbürgerschaft geht automatisch das Recht auf Freizügigkeit, das Recht auf Zugang zum EU-Binnenmarkt sowie das aktive und passive Wahlrecht bei Europa- und Kommunalwahlen einher, und zwar in allen Mitgliedstaaten.",
                                "translation": "La citoyenneté de l’Union confère automatiquement le droit à la libre circulation, l’accès au marché intérieur de l’UE et le droit de vote et d’éligibilité aux élections européennes et locales."
                            }
                        ]
                    },
                    {
                        "sense_id": "30e76a4d-6cae-3b24-8c8d-dceb378e69e8",
                        "entry_id": "a1722f76-88e2-3b79-8be7-7bd48aa6d2d0",
                        "glosses": [
                            "Libertinage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09bdc74c-8cde-4cc6-b59d-e88e4814d92e",
                                "sense_id": "30e76a4d-6cae-3b24-8c8d-dceb378e69e8",
                                "text": "Seit 2016 entfernt die chinesische Medienanstalt alles aus ausländischen Filmen und Serien, was sie als „vulgäre, unmoralische und ungesunde Inhalte“ definiert. Dazu zählen sexuelle Freizügigkeit, Rauchen, Gewalt, Affären. Und besonders oft: Homosexualität.",
                                "translation": "Depuis 2016, l’autorité chinoise des médias élimine des films et séries étrangers tout ce qu’elle définit comme « contenu vulgaire, immoral et malsain ». En font partie le libertinage sexuel, le tabagisme, la violence, les liaisons. Et particulièrement souvent : l’homosexualité."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "23a91778-cbe8-3cde-86ce-c4ee71843ae6",
                "word": "Freizügigkeit",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "038db07b-70db-43d9-9d06-9d8b57f614e0",
                        "entry_id": "23a91778-cbe8-3cde-86ce-c4ee71843ae6",
                        "tags": [
