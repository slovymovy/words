{
    "word_family": [
        "flocking",
        "flocker",
        "flocky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c3de4f80-0f00-39db-b544-72e6ef479288",
                    "sense_definition": "a group of birds that are together, especially for migration or feeding",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "animal_groups",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>flock</w> of geese flew over the lake in a perfect V-formation.",
                            "target_lang_translations": {
                                "ru": "Большая <w>стая</w> гусей пролетела над озером идеальным клином."
                            }
                        },
                        {
                            "text": "We watched a <w>flock</w> of birds gather in the trees before sunset.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как <w>стая</w> птиц собирается на деревьях перед закатом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flock of birds",
                        "flock of geese",
                        "flock of seagulls"
                    ],
                    "target_lang_definitions": {
                        "ru": "группа птиц, держащихся вместе, особенно во время миграции или кормления"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа птиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "696f7cfe-d97a-3cd6-811b-746ba5eefa91",
                    "sense_definition": "a group of certain animals, such as sheep or goats, that live and feed together",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "animal_groups",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer led his <w>flock</w> of sheep to the green pasture on the hill.",
                            "target_lang_translations": {
                                "ru": "Фермер погнал свою <w>отару</w> овец на зеленое пастбище на холме."
                            }
                        },
                        {
                            "text": "A <w>flock</w> of sheep was grazing peacefully in the meadow.",
                            "target_lang_translations": {
                                "ru": "<w>Стадо</w> овец мирно паслось на лугу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flock of sheep",
                        "flock of goats",
                        "tend the flock"
                    ],
                    "target_lang_definitions": {
                        "ru": "группа определенных животных, таких как овцы или козы, которые живут и пасутся вместе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отара",
                                "target_lang_sense_clarification": "группа овец"
                            },
                            {
                                "target_lang_word": "стадо",
                                "target_lang_sense_clarification": "группа животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50c5c6d6-f379-309c-9df0-c5bcd777a212",
                    "sense_definition": "a large number of people moving or staying together",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "human_groups",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>flock</w> of tourists arrived at the museum just as it opened.",
                            "target_lang_translations": {
                                "ru": "<w>Толпа</w> туристов прибыла к музею как раз к его открытию."
                            }
                        },
                        {
                            "text": "The celebrity was surrounded by a <w>flock</w> of reporters asking questions.",
                            "target_lang_translations": {
                                "ru": "Знаменитость была окружена <w>толпой</w> репортеров, задающих вопросы."
                            }
                        }
                    ],
                    "synonyms": [
                        "bunch",
                        "horde",
                        "host",
                        "throng"
                    ],
                    "common_phrases": [
                        "flock of tourists",
                        "flock of reporters"
                    ],
                    "target_lang_definitions": {
                        "ru": "большое количество людей, движущихся или находящихся вместе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толпа",
                                "target_lang_sense_clarification": "большое скопление людей"
                            },
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "несколько человек вместе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c2f34ca-9818-3b83-a335-fbca7f8aae4e",
                    "sense_definition": "the members of a particular church or the people served by a pastor",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "human_groups",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest spoke kindly to his <w>flock</w> during the Sunday morning service.",
                            "target_lang_translations": {
                                "ru": "Священник по-доброму обратился к своей <w>пастве</w> во время воскресной утренней службы."
                            }
                        },
                        {
                            "text": "The minister worked hard to care for the spiritual needs of his <w>flock</w>.",
                            "target_lang_translations": {
                                "ru": "Священнослужитель усердно трудился, заботясь о духовных нуждах своей <w>паствы</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "congregation"
                    ],
                    "common_phrases": [
                        "pastor and his flock",
                        "care for the flock"
                    ],
                    "target_lang_definitions": {
                        "ru": "члены определенной церкви или люди, находящиеся под духовным руководством пастора"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паства",
                                "target_lang_sense_clarification": "верующие прихода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c2522cb-7207-39f0-aa8d-e3e0236a86e8",
                    "sense_definition": "tufts of wool, cotton, or fiber used for stuffing furniture or mattresses",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "materials",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old mattress was filled with coarse <w>flocks</w> of wool.",
                            "target_lang_translations": {
                                "ru": "Старый матрас был набит грубыми <w>клочьями</w> шерсти."
                            }
                        },
                        {
                            "text": "He used wool <w>flocks</w> to provide extra padding for the chair.",
                            "target_lang_translations": {
                                "ru": "Он использовал шерстяные <w>очесы</w>, чтобы сделать стул более мягким."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "клочья шерсти, хлопка или волокна, используемые для набивки мебели или матрасов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клок",
                                "target_lang_sense_clarification": "пучок волокна"
                            },
                            {
                                "target_lang_word": "очесы",
                                "target_lang_sense_clarification": "отходы волокнистых материалов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8ecd9c1-4f41-3847-af77-0e69bcb2663a",
                    "sense_definition": "to move or gather together in large numbers",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thousands of fans <w>flocked</w> to the stadium to see the concert.",
                            "target_lang_translations": {
                                "ru": "Тысячи фанатов <w>стекались</w> к стадиону, чтобы увидеть концерт."
                            }
                        },
                        {
                            "text": "During the summer, people <w>flock</w> to the beach to enjoy the sun.",
                            "target_lang_translations": {
                                "ru": "Летом люди <w>толпами идут</w> на пляж, чтобы насладиться солнцем."
                            }
                        }
                    ],
                    "synonyms": [
                        "swarm",
                        "throng"
                    ],
                    "common_phrases": [
                        "flock to the beach",
                        "flock to see"
                    ],
                    "target_lang_definitions": {
                        "ru": "двигаться или собираться вместе в большом количестве"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стекаться",
                                "target_lang_sense_clarification": "собираться в одном месте"
                            },
                            {
                                "target_lang_word": "толпиться",
                                "target_lang_sense_clarification": "собираться толпой"
                            },
                            {
                                "target_lang_word": "сбиваться",
                                "target_lang_sense_clarification": "собираться в группу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c89ba788-7ed2-3867-9933-a82a32a8f5db",
                    "sense_definition": "to coat a surface with small fibers to create a velvet-like texture",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "coating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manufacturer decided to <w>flock</w> the inside of the jewelry box.",
                            "target_lang_translations": {
                                "ru": "Производитель решил <w>флокировать</w> внутреннюю часть шкатулки для украшений."
                            }
                        },
                        {
                            "text": "They used a special machine to <w>flock</w> the wallpaper with red wool.",
                            "target_lang_translations": {
                                "ru": "Они использовали специальный станок, чтобы <w>нанести ворс</w> из красной шерсти на обои."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in manufacturing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "покрывать поверхность мелкими волокнами для создания бархатистой текстуры"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флокировать",
                                "target_lang_sense_clarification": "наносить ворс"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "66ea01d5-7726-3f29-8a96-39d5bf1fc5c1",
                    "sense_definition": "an English family name",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the <w>Flock</w> family who donated the land.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Флок</w>, которая пожертвовала землю."
                            }
                        },
                        {
                            "text": "Mr. <w>Flock</w> has lived in this neighborhood for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Флок</w> живет в этом районе уже более сорока лет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "английская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Флок",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}