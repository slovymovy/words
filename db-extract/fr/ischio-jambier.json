                                "target_senses": [
                                    {
                                        "sense_id": "a345a747-8540-3bb7-a4de-2d5f5407fbf0",
                                        "entry_id": "0216bf2e-d2a1-3320-8782-2d252daed324",
                                        "glosses": [
                                            "One of the great tendons situated in each side of the ham, or space back of the knee, and connected with the muscles of the back of the thigh."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2edf00ec-f8f8-3600-bf0e-5ce9ca876fde",
                                        "entry_id": "0216bf2e-d2a1-3320-8782-2d252daed324",
                                        "glosses": [
                                            "The biceps femoris, semimembranosus, and semitendinosus muscles."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "415f7fe3-bb15-4309-9758-96575dc50867",
                                                "sense_id": "2edf00ec-f8f8-3600-bf0e-5ce9ca876fde",
                                                "text": "Developing muscle around both sides of a joint (think biceps and triceps, abs and low back, quads and hamstrings) should be one of your primary training considerations because strength on each side leads to lower injury rates."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hamstring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83ad3453-3c21-32c3-bdd0-0f4363749854",
                                        "entry_id": "8ca16d54-738f-3949-8dd7-21a1bf005004",
                                        "glosses": [
                                            "To lame or disable by cutting the tendons of the ham or knee; to hough."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2370504-eaf0-326f-90ca-2fc5c8a4ed78",
                                        "entry_id": "8ca16d54-738f-3949-8dd7-21a1bf005004",
                                        "glosses": [
                                            "To cripple; to incapacitate; to disable."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe889f1e-388a-422e-91a5-2abed0d2e64c",
                                                "sense_id": "c2370504-eaf0-326f-90ca-2fc5c8a4ed78",
                                                "text": "So have they hamstrung the valor of the subject by seeking to effeminate us all at home."
                                            },
                                            {
                                                "example_id": "6b1a77f9-4197-4bfa-baae-33f3440f268a",
                                                "sense_id": "c2370504-eaf0-326f-90ca-2fc5c8a4ed78",
                                                "text": "Its trademark policies of privatization, deregulation, tax cuts and free trade deals: these have liberated corporations to accumulate enormous profits and treat the atmosphere like a sewage dump, and hamstrung our ability, through the instrument of the state, to plan for our collective welfare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
