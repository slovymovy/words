                "senses": [
                    {
                        "sense_id": "6684b13b-9bb9-3d88-b1b1-c9007a059b56",
                        "entry_id": "f3d1fc38-2cf5-3d02-8896-aaaf1de9ea13",
                        "glosses": [
                            "niespełniający oczekiwań, niezbyt dobry, pozostawiający wiele do życzenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bd77d64-0069-4df3-b0e8-a94074b2e846",
                                "sense_id": "6684b13b-9bb9-3d88-b1b1-c9007a059b56",
                                "text": "Stosowanie tych nowych norm powinno doprowadzić do usunięcia z rynku produktów o niezadowalającej jakości […]"
                            },
                            {
                                "example_id": "38eb13fa-2aa8-45e0-9080-3cdb9b152d4a",
                                "sense_id": "6684b13b-9bb9-3d88-b1b1-c9007a059b56",
                                "text": "Ponad dziesięć lat po tym, jak wybuchł globalny kryzys, rozwój gospodarczy nadal jest niezadowalający."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
