                        "glosses": [
                            "A government dominated by the cotton industry, as in the United States prior to the Civil War."
                        ],
                        "tags": [
                            "US",
                            "historical",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1be801f4-583e-4a01-82c6-d4f04b0f6efe",
                                "sense_id": "9deae50a-e0ec-3de3-9641-0f487d63aac1",
                                "text": "The whole school argue political or national economy as a party question: it is Cottonocracy versus Cornocracy — the nation is to be crucified between them."
                            },
                            {
                                "example_id": "ee74928b-f48e-4604-89ae-e6f8eaa0fa87",
                                "sense_id": "9deae50a-e0ec-3de3-9641-0f487d63aac1",
                                "text": "Make a question between our nation and England about fifty desarters^([sic]), and if the ministers of the day only dared to talk of fighting, the members of all the manufactoren^([sic]) towns in England, the cottonocracy of Great Britain, would desert too!"
                            },
                            {
                                "example_id": "2be8bded-348c-4ecf-8989-928fb2e7bdb5",
                                "sense_id": "9deae50a-e0ec-3de3-9641-0f487d63aac1",
                                "text": "The Lancashire cottonocracy was still waiting for El Dorado, and was quite prepared to believe that the opium trade was delaying its arrival."
                            }
                        ]
                    }
