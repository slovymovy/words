        "fr-extract.jsonl": [
            {
                "entry_id": "c9b2fe81-6332-3d39-b045-65c351e82887",
                "word": "décombres",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "819c86e2-525b-3f40-a2fb-1499fa9c117e",
                        "entry_id": "c9b2fe81-6332-3d39-b045-65c351e82887",
                        "glosses": [
                            "Amas de matériaux inutiles qui restent sur le terrain après la démolition d’un bâtiment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29b12453-2254-48c1-b99c-2d7360fdf80c",
                                "sense_id": "819c86e2-525b-3f40-a2fb-1499fa9c117e",
                                "text": "[…], et tantôt louvoyant, tantôt escaladant, car le chemin était parsemé d’entassements de décombres, ils arrivèrent non sans peine à la muraille indiquée par le Cornouaillais."
                            },
                            {
                                "example_id": "c7cd1739-fea7-480c-af1e-462372200f34",
                                "sense_id": "819c86e2-525b-3f40-a2fb-1499fa9c117e",
                                "text": "Son enfance s’était écoulée là, dans les ruines grises, parmi les décombres et la poussière d’un passé dont elle ignorait tout."
                            },
                            {
                                "example_id": "372471ac-7ceb-4c7e-a5b3-09c83aaf81eb",
                                "sense_id": "819c86e2-525b-3f40-a2fb-1499fa9c117e",
                                "text": "Une affreuse paix régna sur ces décombres que tous avaient abandonnés."
                            },
                            {
                                "example_id": "9ad320b2-395e-46d6-a0c9-f41bbaf5cfc3",
                                "sense_id": "819c86e2-525b-3f40-a2fb-1499fa9c117e",
                                "text": "Les petits chevaux des Cosaques escaladent les amas de décombres, entre des lambeaux de murs placardés d’affiches portant la dernière proclamation de Gœbbels : « Tout Allemand doit défendre sa capitale. Les hordes rouges seront arrêtées. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fc37bf7-8d1e-4a8b-9df1-189b3fb1ad2d",
                        "source_entry_id": "c9b2fe81-6332-3d39-b045-65c351e82887",
                        "source_sense_id": "819c86e2-525b-3f40-a2fb-1499fa9c117e",
                        "target_lang_word": "rubble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rubble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                                        "entry_id": "3ff6a9da-e156-3ef4-bb86-9e9f74737a82",
                                        "glosses": [
                                            "The broken remains of an object, usually rock or masonry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8fac65a-71ab-4493-920d-e1809b8bd185",
                                                "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                                                "text": "The main East Coast line from Edinburgh to Berwick was blocked at Cockburnspath and Grantshouse by flood water, which washed away part of an embankment, and by the collapse of about 300 tons of rubble on to the track."
                                            },
                                            {
                                                "example_id": "4c06c861-e286-49e7-8d70-d44c8fabe967",
                                                "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                                                "text": "The old boulevard now was a sagging ruin, waiting for the wreckers. … You'd have to loathe yourself vividly to be indifferent to such destruction or, worse, rejoice at the crushing of the locus of these middle-class settlements, glad that history had made rubble of them."
                                            },
                                            {
                                                "example_id": "cda0aea3-0c8e-4382-9e8b-6cc71cbe7883",
                                                "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale.[…]Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ee50b7-6235-3c4a-9077-3646c34eb1ec",
                                        "entry_id": "3ff6a9da-e156-3ef4-bb86-9e9f74737a82",
                                        "glosses": [
                                            "A mass or stratum of fragments of rock lying under the alluvium and derived from the neighbouring rock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ba0d85-a578-439f-b97f-e4baed25a644",
                                                "sense_id": "55ee50b7-6235-3c4a-9077-3646c34eb1ec",
                                                "text": "The overlying beds are composed of such calcareous rubble and flints, rudely stratified"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c9de155-140c-34bb-bf85-a98a64033ebd",
                                        "entry_id": "3ff6a9da-e156-3ef4-bb86-9e9f74737a82",
                                        "glosses": [
                                            "The whole of the bran of wheat before it is sorted into pollard, bran, etc."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dialectal",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
