                        "entry_id": "22bf9820-7667-3001-8088-fc303d2067d5",
                        "glosses": [
                            "A strong natural dislike or hatred; antipathy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "039b8a91-082a-477e-be86-fef3e52748a7",
                                "sense_id": "cdcdbb6e-2579-3cb0-be10-79d9af5b5e32",
                                "text": "Their longstanding antagonism is manifested in frequent scuffles and shouting matches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d7c02e7-a82c-4c76-867c-6c9511026694",
