                "senses": [
                    {
                        "sense_id": "4678065e-2b0e-3ca1-adb3-98a8dba219d1",
                        "entry_id": "8ada2e83-1df0-3a75-b229-772f6ae8fd18",
                        "glosses": [
                            "Verbot für Fluggeräte, sich in einem Luftraum zu bewegen und folglich auch das Verbot diesen zu betreten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "895d8b7d-72df-4e54-97b3-56830141e519",
                                "sense_id": "4678065e-2b0e-3ca1-adb3-98a8dba219d1",
                                "text": "Als ein Vulkanausbruch begann, wurde ein Flugverbot verhängt und alle Flugzeuge im Luftraum mussten landen."
                            },
                            {
                                "example_id": "f44622ed-c7bf-4d02-bf26-b1f568396008",
                                "sense_id": "4678065e-2b0e-3ca1-adb3-98a8dba219d1",
                                "text": "Nach den Anschlägen in New York City am 9. September 2001 wurde vom amerikanischen Präsidenten ein Flugverbot (für die USA) verhängt und alle Flugzeuge zum Landen gezwungen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
