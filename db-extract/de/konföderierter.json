                                "target_senses": [
                                    {
                                        "sense_id": "de45a218-ad68-3443-9e78-9918a00de39e",
                                        "entry_id": "c7cd510a-e23f-3a4e-ba78-ac7d92016575",
                                        "glosses": [
                                            "A citizen of the Confederate States of America."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81528e45-ce21-4912-9d30-b03bf405762d",
                                                "sense_id": "de45a218-ad68-3443-9e78-9918a00de39e",
                                                "text": "In fact, I heard everything in the world except that the Confederates lost the war. When I was ten years old, it was a violent shock to learn that General Lee had been defeated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62b80a22-67a5-3f1b-9a72-a62b45c3d440",
                                        "entry_id": "c7cd510a-e23f-3a4e-ba78-ac7d92016575",
