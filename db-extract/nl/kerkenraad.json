                        "entry_id": "0fae0de8-bd2d-3d84-9bbf-d2a8af581f92",
                        "glosses": [
                            "college van ouderlingen en diakenen, de predikant, en soms kerkvoogden dat het toezicht heeft over een protestantse kerkelijke gemeente"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b64a46-ff65-4c53-9dc3-57efdfb45c9c",
                                "sense_id": "3faf8212-2efe-34ea-81a2-8d9a6221fb55",
                                "text": "Een aantal gemeenteleden heeft aan de kerkenraad het verzoek gedaan, het besluit over de gebouwensluiting opnieuw te overwegen en te wijzigen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a854ee9-9925-3748-8e64-806615f2a702",
