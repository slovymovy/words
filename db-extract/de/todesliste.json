                "senses": [
                    {
                        "sense_id": "a6ede9f8-080a-322c-baab-f8a4fb99dc75",
                        "entry_id": "f7588532-7cb2-3c23-8927-aba21527dfd6",
                        "glosses": [
                            "Liste von Personen, die getötet werden sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5718340c-a6df-4c8f-8899-21c587214d51",
                                "sense_id": "a6ede9f8-080a-322c-baab-f8a4fb99dc75",
                                "text": "„Ein Mahner gegen Gewalt, der katholische Erzbischof von Bulawayo, Pius Ncube, wurde vom CIO auf eine Todesliste gesetzt, vermutlich auf Anweisung des Präsidenten selbst.“"
                            },
                            {
                                "example_id": "de584ce1-0aff-4916-a802-0c6c8da52aaf",
                                "sense_id": "a6ede9f8-080a-322c-baab-f8a4fb99dc75",
                                "text": "„Wer sich gegen ihn wandte, kam auf die Todesliste.“"
                            },
                            {
                                "example_id": "7b02dc17-e282-4bf7-8fe7-91d88c12f4be",
                                "sense_id": "a6ede9f8-080a-322c-baab-f8a4fb99dc75",
                                "text": "„Khalil al-Wazir, der von Seiten der Exil-PLO das Vorgehen mit den Aufständischen koordinierte und ihnen finanzielle Unterstützung zukommen ließ, wurde von Israel auf die Todesliste gesetzt und im April 1988 in Tunis ermordet.“"
                            },
                            {
                                "example_id": "ff95aae9-0bb2-4922-9820-1cb2a5cb9de7",
                                "sense_id": "a6ede9f8-080a-322c-baab-f8a4fb99dc75",
                                "text": "„Bei einigen der korrupteren Mitglieder der Streitkräfte steht er auf der Todesliste.“"
                            },
                            {
                                "example_id": "1d5c1917-3912-46c4-836a-c083c5e5bd78",
                                "sense_id": "a6ede9f8-080a-322c-baab-f8a4fb99dc75",
                                "text": "„Vielleicht war er auf einer Todesliste gelandet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
