                        "examples": [
                            {
                                "example_id": "b7cb2fd2-a4dd-409e-8a2e-41e45cf8fb62",
                                "sense_id": "892338e8-9fe0-346a-97c0-63de954649fd",
                                "text": "кедро́вый оре́х",
                                "translation": "pine nut",
                                "english": "pine nut"
                            },
                            {
                                "example_id": "674a9e32-9e65-4eeb-a362-7d46a0ab9bb9",
                                "sense_id": "892338e8-9fe0-346a-97c0-63de954649fd",
                                "text": "кедро́вая ро́ща",
                                "translation": "cedar grove",
                                "english": "cedar grove"
                            },
                            {
                                "example_id": "33b58642-381d-4dc7-81b6-75fb3e18dec3",
                                "sense_id": "892338e8-9fe0-346a-97c0-63de954649fd",
                                "text": "Ма́сло кедро́вых оре́хов, пригото́вленное холо́дным путё́м из сырья́ надлежа́щего ка́чества и с соблюде́нием необходи́мых техни́ческих тре́бований, представля́ет собо́ю жи́дкость золоти́стого цве́та, прия́тного масляни́стого вку́са и без вся́кого за́паха."
                            }
                        ]
                    }
