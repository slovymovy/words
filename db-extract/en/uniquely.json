                                "example_id": "510bf5fc-fbe3-42bb-8157-6212e49be5d5",
                                "sense_id": "c4de7638-1dc2-3a4f-8fd5-2e2c9f503105",
                                "text": "This hospitability to established acts is part of what makes country music unique and, these days, uniquely profitable."
                            },
                            {
                                "example_id": "6299b696-4fc0-438e-83ce-6ad98b932ac5",
                                "sense_id": "c4de7638-1dc2-3a4f-8fd5-2e2c9f503105",
                                "text": "“The NBA and FIBA are uniquely positioned to build on the rich tradition of European basketball. We look forward to collaborating with FIBA to explore the creation of a new league for fans across the continent,” Silver added."
                            }
                        ]
