                        "entry_id": "a7f3b1ee-3c39-3a9b-9d49-b67816e4a3ce",
                        "glosses": [
                            "umgangssprachliche Bezeichnung für eine Handfeuerwaffe, ohne Bezug zur Größe oder Ausführung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddde79bc-fb9e-4e7d-b776-b70f163a9937",
                                "sense_id": "32332e00-7f54-39fc-8905-5dafb05ea335",
                                "text": "Aus der Jackentasche zog er eine Wumme."
                            },
                            {
                                "example_id": "fc9f7b96-78ff-4e29-9d80-148793980d2d",
                                "sense_id": "32332e00-7f54-39fc-8905-5dafb05ea335",
                                "text": "„Der Sänger sang: »Ich kauf mir ’ne Wumme, so lang wie mein Bein, und jedem, der blöd kommt, dem knall’ ich eins rein ...«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
