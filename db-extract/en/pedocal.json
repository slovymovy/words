                    {
                        "sense_id": "8a0ed1ca-10d0-362b-aa85-56b15797b0b6",
                        "entry_id": "26446412-7d16-304a-9c0f-e1974d5eced8",
                        "glosses": [
                            "Any of a class of soils that are rich in calcium carbonate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfa06b55-b280-4a10-924f-9413851b669c",
                                "sense_id": "8a0ed1ca-10d0-362b-aa85-56b15797b0b6",
                                "text": "Pedocals rich in calcium carbonate occur in regions of low rainfall and high temperature, and usually bear grasses and brush."
                            },
                            {
                                "example_id": "e3fd790b-777b-499c-b12e-80671120e87c",
                                "sense_id": "8a0ed1ca-10d0-362b-aa85-56b15797b0b6",
                                "text": "Pedocals are highly alkaline (high pH readings) soils with little or no humus and are formed in arid regions where subsurface evaporation of water crystallizes as calcium or lime deposits. Alkali soils are also pedocals, with a salt content high enough to kill plants. They are found in some southwestern states of the United States."
                            },
                            {
                                "example_id": "aa138be4-f6c9-4653-979d-ddea8a9172f1",
                                "sense_id": "8a0ed1ca-10d0-362b-aa85-56b15797b0b6",
                                "text": "They^([zonal soils]) occur in latitudinal zone and are further divided into pedalfers and pedocals."
                            }
                        ]
                    }
                ],
