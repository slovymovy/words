                                "text": "Vietnam, California, back in and on a mission."
                            }
                        ]
                    },
                    {
                        "sense_id": "543ac90f-a55b-393d-8f47-1daca3398e05",
                        "entry_id": "49f1a31b-01ad-3e49-bf29-5f377af8ee91",
                        "glosses": [
                            "A situation in which one cannot win."
                        ],
                        "tags": [
                            "US",
                            "broadly",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b448f6aa-b2e0-4fc6-83a0-4d5a9666f496",
                                "sense_id": "543ac90f-a55b-393d-8f47-1daca3398e05",
                                "text": "Everyone was miserable, including Coppola. \"It was my Vietnam,\" he moaned a few months later."
                            },
                            {
                                "example_id": "023d2cc2-c381-4434-a291-38775f37d3a7",
                                "sense_id": "543ac90f-a55b-393d-8f47-1daca3398e05",
                                "text": "Judy is the great deceiver / Judy is your Viet Nam"
                            }
                        ]
                    }
