                "translations": [
                    {
                        "translation_id": "07264713-a555-4e0f-84e5-b2dee0cfc123",
                        "source_entry_id": "df45dd78-8806-3337-b1bc-cfeb47ada4e6",
                        "source_sense_id": "d649962e-e715-3ef7-9c4c-d02327e7a125",
                        "target_lang_word": "vital",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vital",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3037493-08ee-3820-8034-9b628d03ed60",
                                        "entry_id": "6762772c-86fd-3e51-976c-6eb16056418a",
                                        "glosses": [
                                            "lebendig, kräftig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d09e204-b0ad-4a52-ae94-71427a0214c1",
                                                "sense_id": "a3037493-08ee-3820-8034-9b628d03ed60",
                                                "text": "Für seine zweiundneunzig Lebensjahre ist Herr Zusewinkel noch sehr vital."
                                            },
                                            {
                                                "example_id": "105a0db7-55b0-49c9-96d8-eec708e28812",
                                                "sense_id": "a3037493-08ee-3820-8034-9b628d03ed60",
                                                "text": "Die Interpretation der [Musik-]Werke ist vital und hoffnungsfroh, in jedem Fall mitreißend und energiegeladen."
                                            },
                                            {
                                                "example_id": "0b05918a-d462-4868-aefb-04881e44d396",
                                                "sense_id": "a3037493-08ee-3820-8034-9b628d03ed60",
                                                "text": "Die Limousin-Rinder zählen zu den besten Fleischrassen. Sie sind robust, vital und langlebig."
                                            },
                                            {
                                                "example_id": "0b8c3e2d-b1c5-427b-a327-70e9884dbb21",
                                                "sense_id": "a3037493-08ee-3820-8034-9b628d03ed60",
                                                "text": "\"Die Europäische Union ist heute mit Rumänien und Bulgarien direkt am Schwarzen Meer vertreten. Wir haben dort eine Reihe von frozen conflicts, die gar nicht so gefroren, sondern recht vital sind. […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c37b9fa6-9107-3526-9502-ec9334a68579",
                                        "entry_id": "6762772c-86fd-3e51-976c-6eb16056418a",
                                        "glosses": [
                                            "von lebenswichtiger Bedeutung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2252836a-e471-4b72-ae14-e3bab8e33585",
                                                "sense_id": "c37b9fa6-9107-3526-9502-ec9334a68579",
                                                "text": "[…] das kleine Benin [ist] von großer Bedeutung: \"Deutschland hat ein absolut vitales Interesse, dass Benin stabil bleibt, dass wir sozusagen einen Kontrapunkt gegen Mali haben. […],\" [sagt Elke Erlecke, sie leitet das Büro der Konrad-Adenauer-Stiftung in Cotonou, dem wirtschaftlichen Zentrum Benins]."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
