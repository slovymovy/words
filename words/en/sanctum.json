                    "sense_id": "8236a9b3-2e3a-32f7-a3f7-fba39e02984d",
                    "sense_definition": "A sacred place, or a very private room or retreat where one is free from intrusion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author spent every afternoon writing quietly in his private <w>sanctum</w> upstairs.",
                            "target_lang_translations": {
                                "ru": "Каждый день после полудня автор проводил за спокойным писательством в своём личном <w>убежище</w> наверху."
                            }
                        },
                        {
                            "text": "No visitors were ever allowed to enter the artist's inner <w>sanctum</w> without permission.",
                            "target_lang_translations": {
                                "ru": "Никому из посетителей не разрешалось входить в <w>святая святых</w> художника без разрешения."
                            }
                        }
                    ],
                    "synonyms": [
                        "sanctuary",
                        "refuge",
                        "retreat",
                        "haven"
                    ],
                    "common_phrases": [
                        "inner sanctum",
                        "private sanctum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Святилище, а также уединённое, сугубо личное место или кабинет, куда нет доступа посторонним."
                    },
