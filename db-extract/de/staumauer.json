                "senses": [
                    {
                        "sense_id": "e7714ed3-f606-37f8-9f5a-be92e5b50816",
                        "entry_id": "ceba8be1-d644-3b23-9f75-ea1b0fe3dc5b",
                        "glosses": [
                            "Mauer, hinter der ein Stausee oder ein Fluss aufgestaut ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbadabdc-c07d-41dd-88fb-93c1efc73b79",
                                "sense_id": "e7714ed3-f606-37f8-9f5a-be92e5b50816",
                                "text": "„Ried tritt ans Geländer der Staumauer.“"
                            },
                            {
                                "example_id": "3588141c-9cc8-4a6a-a147-ba8a07c9102a",
                                "sense_id": "e7714ed3-f606-37f8-9f5a-be92e5b50816",
                                "text": "„Der Reporter erklärte, dass die Staumauer am oberen Ende beschädigt sei und der Schaden sich glücklicherweise nur bis etwa zwei Meter unter die Wasserlinie erstrecke.“"
                            },
                            {
                                "example_id": "58b19882-7845-45cd-8c18-ed1ae015b80c",
                                "sense_id": "e7714ed3-f606-37f8-9f5a-be92e5b50816",
                                "text": "„Sand und Steine, die der Fluss mit sich trägt, bleiben an der Staumauer hängen.“"
                            },
                            {
                                "example_id": "006184ff-d14f-4ebf-b067-8f0684fa7940",
                                "sense_id": "e7714ed3-f606-37f8-9f5a-be92e5b50816",
                                "text": "„Die anhaltenden Proteste gegen den Staudamm in Belo Monte haben den Bau der Staumauer mehrfach aufgehalten.“"
                            },
                            {
                                "example_id": "05a9f650-365c-4d29-926b-d502cfea1f92",
                                "sense_id": "e7714ed3-f606-37f8-9f5a-be92e5b50816",
                                "text": "„Um ein Brechen der Staumauer der höher gelegenen Steinbachtalsperre zu verhindern, lassen die Behörden Wasser ab.“"
                            },
                            {
                                "example_id": "1187a8f0-bd04-4bf9-8ad1-94486a8bf03f",
                                "sense_id": "e7714ed3-f606-37f8-9f5a-be92e5b50816",
                                "text": "„Die unterhalb des porösen Damms liegenden Ortschaften wurden evakuiert, das Ablassen des Wassers, das die Staumauer belastet, ging langsamer vonstatten als geplant.“"
                            },
                            {
                                "example_id": "d9b8b046-1dcc-407c-b732-2c6879e87b11",
                                "sense_id": "e7714ed3-f606-37f8-9f5a-be92e5b50816",
                                "text": "„Die Talsperre drohte aufgrund des stundenlangen Starkregens zeitweise überzulaufen, das Wasser schwappte bereits über die Dammkrone der Staumauer.“"
                            },
                            {
                                "example_id": "ade4670a-792c-4998-b283-ae81684481f6",
                                "sense_id": "e7714ed3-f606-37f8-9f5a-be92e5b50816",
                                "text": "„Der Grand Ethiopian Renaissance Dam ist ein gewaltiges Projekt. Er staut den Blauen Nil auf knapp zwei Kilometer Länge auf. Geplant ist, dass die Turbinen in den Staumauern bis zu 6000 Megawatt Strom liefern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "502b91d4-0235-4ee8-989f-389a8ab354ea",
                        "source_entry_id": "ceba8be1-d644-3b23-9f75-ea1b0fe3dc5b",
                        "source_sense_id": "e7714ed3-f606-37f8-9f5a-be92e5b50816",
                        "source_sense_description": "Mauer, hinter der ein Stausee oder ein Fluss aufgestaut ist",
                        "target_lang_word": "dam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f6724db-70d5-3882-8196-5ca32b2b85b5",
                                        "entry_id": "0b08a50d-f7c3-339f-a89e-879e5d5484e6",
                                        "glosses": [
                                            "A structure placed across a flowing body of water to stop the flow or part of the flow, generally for purposes such as retaining or diverting some of the water or retarding the release of accumulated water to avoid abrupt flooding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8128bc5-3530-4200-a63a-fe50847e7700",
                                                "sense_id": "5f6724db-70d5-3882-8196-5ca32b2b85b5",
                                                "text": "A dam is often an essential source of water to farmers of hilly country."
                                            },
                                            {
                                                "example_id": "ec560955-52e2-4444-b120-48be4388dfff",
                                                "sense_id": "5f6724db-70d5-3882-8196-5ca32b2b85b5",
                                                "text": "Nothing could be more business-like than the construction of the stout dams, and nothing more gently rural than the limpid lakes, with the grand old forest trees marshalled round their margins[…]"
                                            },
                                            {
                                                "example_id": "6557cd86-682f-4812-b826-28ffdd644a41",
                                                "sense_id": "5f6724db-70d5-3882-8196-5ca32b2b85b5",
                                                "text": "Most of the Himalayan rivers have been relatively untouched by dams near their sources. Now the two great Asian powers, India and China, are rushing to harness them as they cut through some of the world's deepest valleys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8909ff9f-6938-3099-9811-83a3b2ed3132",
                                        "entry_id": "0b08a50d-f7c3-339f-a89e-879e5d5484e6",
                                        "glosses": [
                                            "The water reservoir resulting from placing such a structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9b346b9-65e1-4225-ba4a-44443190b5dc",
                                                "sense_id": "8909ff9f-6938-3099-9811-83a3b2ed3132",
                                                "text": "Boats may only be used at places set aside for boating on the dam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "344eee2b-985e-3153-a932-db33d22f5d2b",
                                        "entry_id": "0b08a50d-f7c3-339f-a89e-879e5d5484e6",
                                        "glosses": [
                                            "A device to prevent a tooth from getting wet during dental work, consisting of a rubber sheet held with a band."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2170b3ec-d405-3c37-aeb9-796cd55d8d2a",
                                        "entry_id": "0b08a50d-f7c3-339f-a89e-879e5d5484e6",
                                        "glosses": [
                                            "A reservoir."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "South-Africa"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "407570af-75a2-368c-a4aa-e7745603cf52",
                                        "entry_id": "0b08a50d-f7c3-339f-a89e-879e5d5484e6",
                                        "glosses": [
                                            "A firebrick wall, or a stone, which forms the front of the hearth of a blast furnace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "565a6418-8595-3ada-9d23-d71b3e140ade",
                                        "entry_id": "23417c88-5a2e-33e6-8b6e-6b4525022cb6",
                                        "glosses": [
                                            "To block the flow of water."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "022c2855-a8c6-4465-b049-b5f9eba0ff0a",
                                                "sense_id": "565a6418-8595-3ada-9d23-d71b3e140ade",
                                                "text": "Home I vvould go, / But that my Dores are hatefull to my eyes. / Fill'd and damm'd up vvith gaping Creditors, / VVatchfull as Fovvlers vvhen their Game vvill ſpring; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7c64243-d90a-34f9-a807-62a0bfbe83c5",
                                        "entry_id": "cd13c334-52d4-3bce-8e2b-1410924272ac",
                                        "glosses": [
                                            "Female parent, mother, generally regarding breeding of animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e38b2861-720a-44af-ac2c-0a4de2a4f01f",
                                                "sense_id": "a7c64243-d90a-34f9-a807-62a0bfbe83c5",
                                                "text": "More dear […] than younglings to their dam."
                                            },
                                            {
                                                "example_id": "5d06b523-18b6-40d9-9120-8d31a34c31a0",
                                                "sense_id": "a7c64243-d90a-34f9-a807-62a0bfbe83c5",
                                                "text": "The dam runs lowing up and down, / Looking the way her harmless young one went."
                                            },
                                            {
                                                "example_id": "40c2bd65-241d-4af1-b803-7e8de40b6d9e",
                                                "sense_id": "a7c64243-d90a-34f9-a807-62a0bfbe83c5",
                                                "text": "Hunters assure us, that to chuse the best dog, and which they purpose to keepe from out a litter of other young whelps, there is no better meane than the damme herselfe[…]."
                                            },
                                            {
                                                "example_id": "35401934-466f-4c1a-b080-dc130ee00363",
                                                "sense_id": "a7c64243-d90a-34f9-a807-62a0bfbe83c5",
                                                "text": "she / Resolved that Juan should be quite a paragon, / And worthy of the noblest pedigree / (His sire was from Castile, his dam from Aragon)[…]."
                                            },
                                            {
                                                "example_id": "21c3b6ee-e1e4-45ba-9746-075c3623a630",
                                                "sense_id": "a7c64243-d90a-34f9-a807-62a0bfbe83c5",
                                                "text": "The sky was cloudless—the moon rolled across the surface like a lamb searching for its dam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd0cccb8-78c7-3442-91b5-8812968f1993",
                                        "entry_id": "cd13c334-52d4-3bce-8e2b-1410924272ac",
                                        "glosses": [
                                            "A kind of crowned piece in the game of draughts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32876a6e-2766-3a30-93f8-62c5dc39a62d",
                                        "entry_id": "1e8754e1-7058-3dda-879a-8796c6a7de81",
                                        "glosses": [
                                            "An obsolete Indian copper coin, equal to a fortieth of a rupee."
                                        ],
                                        "tags": [
                                            "India",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84a99a1d-edc6-461a-84f5-c2b5e9710bce",
                                                "sense_id": "32876a6e-2766-3a30-93f8-62c5dc39a62d",
                                                "text": "[…] A small Indian coin; whence comes the saying \"I don't care a dam for you,\" that is I don't value you a farthing, and not as generally given, \"I don't care a damn\" or a \"curse for you.\" [Possibly a folk etymology.]"
                                            }
                                        ]
                                    },
