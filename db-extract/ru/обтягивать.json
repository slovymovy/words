                "translations": [
                    {
                        "translation_id": "00eada3f-d1f6-49d3-9536-d3dce51705d9",
                        "source_entry_id": "11846a58-07a6-383f-9dda-4f735d64965d",
                        "target_lang_word": "anschmiegen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anschmiegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54781db3-c247-3cb6-b61a-d70e49943b0e",
                                        "entry_id": "90a17bf2-3c52-3af2-aba1-2b82f04cedf6",
                                        "glosses": [
                                            "sich zärtlich irgendwo herandrücken oder anlehnen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7288e7d8-8ad0-4372-9207-b6cb4132b580",
                                                "sense_id": "54781db3-c247-3cb6-b61a-d70e49943b0e",
                                                "text": "Bernd war glücklich, als er mit Suleika im Bett lag und spürte, wie sie sich an ihn anschmiegte."
                                            },
                                            {
                                                "example_id": "c9ea6c0b-25fc-4958-a1cb-7c14682ecda1",
                                                "sense_id": "54781db3-c247-3cb6-b61a-d70e49943b0e",
                                                "text": "„Dieser Eingang hatte ein Vordach, von zwei Säulen getragen, an deren eine er sich anschmiegte, um einigermaßen vor der Nässe geschützt, doch in der Nähe bleiben zu können, um einen der abfahrenden Wagen genau zu beobachten.“"
                                            },
                                            {
                                                "example_id": "9ca42681-1bde-48a3-9ee9-1db6b1cb530f",
                                                "sense_id": "54781db3-c247-3cb6-b61a-d70e49943b0e",
                                                "text": "Dieses Kleid schmiegt sich vorzüglich an Ihre Figur an, Frau Engel."
                                            },
                                            {
                                                "example_id": "8c5d9a98-699d-48be-983f-08e2d2d39ea1",
                                                "sense_id": "54781db3-c247-3cb6-b61a-d70e49943b0e",
                                                "text": "Viele kleine Hütten schmiegen sich dort an den Abhang an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65aaa667-3120-3e4b-89dd-b479bc399354",
