                ],
                "translations": [
                    {
                        "translation_id": "5ba254a1-1920-4a3f-ac90-50a3cfd5d1f5",
                        "source_entry_id": "71176eac-abdc-315d-825b-0b03e4d39d03",
                        "source_sense_id": "2bebc9e3-1f73-3bca-b4f2-3f09d2a44096",
                        "target_lang_word": "stowaway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stowaway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62c37d60-27a0-34ce-a0dc-f0419b5abbf7",
                                        "entry_id": "f8f5985b-2f22-39f1-b8b4-6be868257edb",
                                        "glosses": [
                                            "A person who hides on board a ship, train, etc. so as to get a free passage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f75d93-7542-4d6a-93c6-1a9eaf4b0946",
                                                "sense_id": "62c37d60-27a0-34ce-a0dc-f0419b5abbf7",
                                                "text": "“Oh, I don't mind 'em, sir,” said Archy; “I knew it all before now. Didn't I hear 'em in the hold? And didn't I tell Cabaco here of it? What say ye, Cabaco? They are stowaways, Mr. Flask.”"
                                            },
                                            {
                                                "example_id": "55c67b10-67bc-4cf0-b8c3-1d2c61180587",
                                                "sense_id": "62c37d60-27a0-34ce-a0dc-f0419b5abbf7",
                                                "text": "In every sense of the expression he is ‘on deck’; but my Jim, for the most part, skulked down below as though he had been a stowaway."
                                            },
                                            {
                                                "example_id": "65e47e6e-3908-4f84-b4d5-ede859ef6e7a",
                                                "sense_id": "62c37d60-27a0-34ce-a0dc-f0419b5abbf7",
                                                "text": "One explanation came to me, and I leaped at it—the possibility of a stowaway hidden in the hold, some maniacal fugitive who had found in the little cargo boat’s empty hull ample room to hide."
                                            },
                                            {
                                                "example_id": "81eb2885-0f95-4450-b7fb-5737fc33df80",
                                                "sense_id": "62c37d60-27a0-34ce-a0dc-f0419b5abbf7",
                                                "text": "My client is an infant, a poor foreign immigrant who started scratch as a stowaway and is now trying to turn an honest penny."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a492275f-f7b0-4748-b89d-6a4464f52460",
                        "source_entry_id": "71176eac-abdc-315d-825b-0b03e4d39d03",
                        "source_sense_id": "2bebc9e3-1f73-3bca-b4f2-3f09d2a44096",
                        "target_lang_word": "gapowicz",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gapowicz",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "8e06ec02-597a-3b35-881e-24c7b0d79ee6",
                                        "entry_id": "95aaf4d3-9bd2-3a0d-b2bf-0c00db668f6f",
                                        "glosses": [
                                            "pasażer podróżujący bez biletu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36952163-b522-4659-9a9c-0e2e8f5972a0",
                                                "sense_id": "8e06ec02-597a-3b35-881e-24c7b0d79ee6",
                                                "text": "Konduktorzy złapali w przedziale obok dwóch gapowiczów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "41ee05b6-24e0-37a1-ab03-71773d59d1c1",
                                        "entry_id": "95aaf4d3-9bd2-3a0d-b2bf-0c00db668f6f",
                                        "glosses": [
                                            "osoba przyglądająca się (bezmyślnie)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d861fa4b-d123-4e9c-b146-1026eaa42ff3",
                                                "sense_id": "41ee05b6-24e0-37a1-ab03-71773d59d1c1",
                                                "text": "Dookoła pełno było gapowiczów z aparatami."
                                            }
