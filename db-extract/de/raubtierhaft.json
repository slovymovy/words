                "senses": [
                    {
                        "sense_id": "956f8ef7-cf0b-354b-b1f4-a7efe60934aa",
                        "entry_id": "d2799676-90b2-383e-91e8-7bc271bbcb78",
                        "glosses": [
                            "an ein Raubtier erinnernd, wie bei einem Raubtier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdf27714-1c10-4ebe-8ec2-e67f65a16195",
                                "sense_id": "956f8ef7-cf0b-354b-b1f4-a7efe60934aa",
                                "text": "„Der Übergang zum Kapitalismus erfolgte ohne adäquate Gesetze und Infrastrukturen. Die Bruderschaften hingegen verfügten über Geld, über eine raubtierhafte Wendigkeit und über Mittel zur Einschüchterung.“"
                            },
                            {
                                "example_id": "b7eb6c73-3514-4e13-8daf-b126a127c9c2",
                                "sense_id": "956f8ef7-cf0b-354b-b1f4-a7efe60934aa",
                                "text": "„Das Auto stand auf Ben Clarks Gelände in der vordersten Reihe; es wirkte bösartig, primitiv und raubtierhaft, wie es da zwischen den biederen Familienkutschen kauerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
