                    },
                    {
                        "sense_id": "e3cc2d78-885b-30e6-907b-941664872bf7",
                        "entry_id": "2887b027-0490-31a6-ba57-9a2d0331545a",
                        "glosses": [
                            "A floor covering made of drugget."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "28f561ca-1117-4c6a-9c47-093677abc295",
                                "sense_id": "e3cc2d78-885b-30e6-907b-941664872bf7",
                                "text": "There was the handsome carpet, new on the occasion of Mr. Gooch's marriage, but it was carefully covered with a drab drugget; the curtains were of a pretty pink damask, but they were enveloped in brown holland bags, by which same material the chairs and sofas were covered."
                            },
                            {
                                "example_id": "25c31b4c-dcbe-49d9-a1bc-3561e08079b0",
                                "sense_id": "e3cc2d78-885b-30e6-907b-941664872bf7",
                                "text": "This carpet was a small square drugget in the centre of the room[…]"
                            },
                            {
                                "example_id": "6cc1c6b5-b9e6-401c-8e15-8d48c2fbe22f",
                                "sense_id": "e3cc2d78-885b-30e6-907b-941664872bf7",
                                "text": "There was a neat hat-and-umbrella stand, and the stranger's weary feet fell soft on a good, serviceable dark-red drugget, which matched in colour the flock-paper on the walls."
                            },
                            {
                                "example_id": "36bab3d1-5979-4542-93f0-67648b775f3b",
                                "sense_id": "e3cc2d78-885b-30e6-907b-941664872bf7",
                                "text": "Bradshaw is always ready to talk 'manufactories', and here he confides that the town [Basingstoke] \"carried on a rather considerable business in druggets, which has since fallen off\". (Druggets has me reaching for my dictionary - it refers to a coarse woollen fabric used to make floor coverings)."
                            }
                        ]
                    }
