                                        "sense_id": "180ff7ce-08c8-3d23-a4fb-d84da1ed4880",
                                        "entry_id": "8758a32e-c4b4-3beb-8a63-8c8341fbfe2c",
                                        "glosses": [
                                            "Qui procède par intervalles moindres que le demi-ton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c25fe59d-dc53-49ce-80ea-9613903aa1ee",
                                                "sense_id": "180ff7ce-08c8-3d23-a4fb-d84da1ed4880",
                                                "text": "Ces transitions enharmoniques se répètent à satiété, et l’abus de la cadence plagale lui ôte une grande partie de sa solennité religieuse."
                                            },
                                            {
                                                "example_id": "49ae9309-d80a-4165-9cbf-1e6c042b268f",
                                                "sense_id": "180ff7ce-08c8-3d23-a4fb-d84da1ed4880",
                                                "text": "Intervalle enharmonique."
                                            },
                                            {
                                                "example_id": "e6b0169a-1a02-4f94-a4dc-94b4bbfa6ce8",
                                                "sense_id": "180ff7ce-08c8-3d23-a4fb-d84da1ed4880",
                                                "text": "La musique des psaumes chantés ici appartient aux trois genres de la musique byzantine : diatonique, enharmonique et chromatique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
