        "fr-extract.jsonl": [
            {
                "entry_id": "f8faec1c-f404-30be-9b10-0819d97e329c",
                "word": "bimbeloterie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fd33aad4-b244-4a1c-9d25-1efce4b69c13",
                        "entry_id": "f8faec1c-f404-30be-9b10-0819d97e329c",
                        "tags": [
                            "plural"
                        ],
                        "form": "bimbeloteries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "394a8fed-4367-3424-8765-479dbac1e301",
                        "entry_id": "f8faec1c-f404-30be-9b10-0819d97e329c",
                        "glosses": [
                            "Fabrication ou vente de bimbelots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffd49909-399b-4d64-baa1-2f04fc7a943e",
                                "sense_id": "394a8fed-4367-3424-8765-479dbac1e301",
                                "text": "La mère était une bonne femme, par malheur, et n’apprit rien à Paquette qu’un peu de doreloterie et de bimbeloterie qui n’empêchait pas la petite de devenir fort grande et de rester fort pauvre."
                            },
                            {
                                "example_id": "9f5a645c-268b-442d-a213-0f9bc15d685a",
                                "sense_id": "394a8fed-4367-3424-8765-479dbac1e301",
                                "text": "La bimbeloterie était une des principales branches de l’industrie parisienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "4487266a-1f33-34c3-8a1c-a3c0b0698c1d",
                        "entry_id": "f8faec1c-f404-30be-9b10-0819d97e329c",
                        "glosses": [
                            "Les produits mêmes de cette industrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f9f3b0b-5c12-489a-b143-341e9a95b098",
                                "sense_id": "4487266a-1f33-34c3-8a1c-a3c0b0698c1d",
                                "text": "Ce qu’ils vendaient, ce n’étaient pas des choses dont on a besoin, qui servent dans un métier ou à la maison, ou aux champs, que sais-je ?… des harnais pour les chevaux, de la bimbeloterie, des outils, des boucles, des tissus, etc. ; non, ils vendaient des feuilles de papier avec dessus des figures."
                            },
                            {
                                "example_id": "a5532457-ae2a-4396-bcaa-dfb8a5cd39f9",
                                "sense_id": "4487266a-1f33-34c3-8a1c-a3c0b0698c1d",
                                "text": "On aurait pu faire de la monnaie en achetant une bimbeloterie, a dit Marion."
                            },
                            {
                                "example_id": "159abc89-6be7-4a28-9439-7f9da7986e4c",
                                "sense_id": "4487266a-1f33-34c3-8a1c-a3c0b0698c1d",
                                "text": "Boutique de bimbeloterie."
                            },
                            {
                                "example_id": "8313b7e6-b1c0-44e5-ab22-8efc549de3d0",
                                "sense_id": "4487266a-1f33-34c3-8a1c-a3c0b0698c1d",
                                "text": "La bimbeloterie de Paris."
                            }
                        ]
                    },
                    {
                        "sense_id": "961b71fc-ad28-31d9-8605-c76190ba411c",
                        "entry_id": "f8faec1c-f404-30be-9b10-0819d97e329c",
                        "glosses": [
                            "Articles de grande valeur (bijoux notamment), méprisés par la personne qui emploie ce terme pour les dévaloriser dans son discours."
                        ],
                        "tags": [
                            "Par dérision"
                        ],
                        "examples": [
                            {
                                "example_id": "bb587059-4a3d-499d-84ff-ecb2827f2f5f",
                                "sense_id": "961b71fc-ad28-31d9-8605-c76190ba411c",
                                "text": "— [cris de Bianca Castafiore] CIEL ! MES BIJOUX !\n — [commentaire du capitaine Haddock, se trouvant dans une autre pièce du château] Ça y est ! Elle a de nouveau égaré sa bimbeloterie."
                            },
                            {
                                "example_id": "671e1e02-8a45-400b-a957-f40b1ab78aaf",
                                "sense_id": "961b71fc-ad28-31d9-8605-c76190ba411c",
                                "text": "L'expansion du système est à son maximum ; il ne s'agit plus seulement d'avoir du goût pour ce mauvais goût moderne dont on a rêvé, de toute façon, parce qu'il était le signe du progrès social, il s'agit d'aimer aussi la bimbeloterie nostalgique qui continue d'encombrer le monde moderne : le souvenir des vacances en Haute-Savoie qui traîne sur le poste de télévision."
                            }
                        ]
                    }
                ],
