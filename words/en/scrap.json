    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e256e1f3-9166-3d7d-b35c-d390f235fee6",
                    "sense_definition": "A small piece or detached fragment of something larger.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "fragment_or_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wrote her phone number on a <w>scrap</w> of paper.",
                            "target_lang_translations": {
                                "ru": "Она записала свой номер телефона на <w>клочке</w> бумаги.",
                                "zh": "她把电话号码写在了一张<w>纸片</w>上。",
                                "pl": "Zapisała swój numer telefonu na <w>kawałku</w> papieru.",
                                "cs": "Napsala své telefonní číslo na <w>útržek</w> papíru.",
                                "fr": "Elle a écrit son numéro de téléphone sur un <w>bout</w> de papier.",
                                "it": "Ha scritto il suo numero di telefono su un <w>foglietto</w> di carta."
                            }
                        },
                        {
                            "text": "I found a <w>scrap</w> of fabric that matches the curtains perfectly.",
                            "target_lang_translations": {
                                "ru": "Я нашел <w>лоскуток</w> ткани, который идеально подходит к шторам.",
                                "zh": "我找到了一块和窗帘颜色很搭的<w>布头</w>。",
                                "pl": "Znalazłam <w>kawałek</w> materiału, który idealnie pasuje do zasłon.",
                                "cs": "Našla jsem <w>kousek</w> látky, který se perfektně hodí k závěsům.",
                                "fr": "J'ai trouvé un <w>bout</w> de tissu qui s'accorde parfaitement avec les rideaux.",
                                "it": "Ho trovato un <w>ritaglio</w> di stoffa che si abbina perfettamente alle tende."
                            }
                        }
                    ],
                    "synonyms": [
                        "piece",
                        "bit",
                        "fragment",
                        "shred",
                        "remnant"
                    ],
                    "common_phrases": [
                        "scrap of paper",
                        "scrap of cloth",
                        "scrap of material"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький кусочек или оторванный фрагмент чего-то большего.",
                        "zh": "指某物的一小块或碎片。",
                        "pl": "Mały kawałek lub oderwany fragment czegoś większego.",
                        "cs": "Malý kousek nebo odtržený fragment něčeho většího.",
                        "fr": "Un petit morceau ou un fragment détaché de quelque chose de plus grand.",
                        "it": "Un piccolo pezzo o frammento staccato da qualcosa di più grande."
                    },
