                                        "glosses": [
                                            "ostry, dynamiczny podgatunek rocka alternatywnego z mocno zniekształconym, „brudnym” brzmieniem gitar, zapoczątkowany w latach 80. XX w."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2599935e-f418-4837-9369-fdfae6ea47bc",
                                                "sense_id": "3daae463-dc9f-3a26-960c-d63fdf834121",
                                                "text": "Kiedy potem pojawił się grunge, zakwalifikowano nas do tego nurtu, choć nie mieliśmy z nim nic wspólnego"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
