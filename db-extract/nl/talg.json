                                            {
                                                "example_id": "9e7c0570-069a-41ad-b9d1-0baadf76e123",
                                                "sense_id": "a193b246-a900-355e-8f90-259dcfdc6ee7",
                                                "text": "to tallow sheep"
                                            }
