                    {
                        "form_id": "cb1c8f24-67de-48b8-9de1-3021f752e27a",
                        "entry_id": "69b46365-5c5e-34c8-9d00-2ffa3a6d1eff",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Teststreifen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                        "entry_id": "69b46365-5c5e-34c8-9d00-2ffa3a6d1eff",
                        "glosses": [
                            "längliches Objekt (aus Papier oder Kunststoff), das dem (chemischen) Nachweis einzelner Stoffe oder deren Konzentrationen dient; Anwendungen sind beispielsweise Blutzucker- und Schwangerschaftstests"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6834def0-64d4-43fd-9f4e-201a632572f2",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Mittels des Teststreifens wird aus der Urinprobe ersichtlich, ob eine Entzündung oder Infektion im Bereich der Harnwege vorliegt.“"
                            },
                            {
                                "example_id": "2ad0f508-e4f1-4ab9-9b8e-d132611fb96d",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Nach dem Auffangen des sogenannten Mittelstrahlurins“ […] „in einem geeigneten Gefäß taucht man den Teststreifen ein.“"
                            },
                            {
                                "example_id": "ec88e135-19de-4667-9b40-f603974d406f",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Mehrfach unterteilte Teststreifen können im Rahmen eines Urin-Schnelltests durch ihre Verfärbung Blut, Zucker (Glukose) oder Nirit (Abbauprodukt von Bakterien) im Harn anzeigen.“"
                            },
                            {
                                "example_id": "da5fcec1-52ba-475f-b2b9-9b364890bf6e",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "[Schwangerschaftstest:] „Der Test mittels des in den Urinstrahl gehaltenen Teststreifens/-stäbchens führt frühestens ca. 14 Tage nach der Befruchtung der Eizelle zu einem Ergebnis mit einer Zuverlässigkeit von über 95 Prozent.“"
                            },
                            {
                                "example_id": "51dbf150-d9c1-47bd-8637-c4105e831fdc",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Auch auf eine vorliegende Schwangerschaft kann der Urin untersucht werden. Dabei setzt man spezielle Teststreifen ein, um das Schwangerschaftshormon Beta-HCG nachzuweisen.“"
                            },
                            {
                                "example_id": "285c4008-bdce-43d4-9532-4ff884f7801e",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Ohne Teststreifen läuft bei der Blutzuckermessung gar nichts.“"
                            },
                            {
                                "example_id": "626127f2-aa1f-4eb4-aad2-1bd1d312268a",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Früher konnte der Blutzucker nur mit einem Tropfen Blut und Teststreifen ermittelt werden. Heutzutage lässt sich der Zuckerspiegel im Gewebe durch am Körper angebrachte Sensoren kontinuierlich erfassen und per Funk an ein Smartphone oder ein Lese- und Aufzeichnungsgerät senden.“"
                            },
                            {
                                "example_id": "87ab70dd-9a30-483a-ad6c-7e490ae121b1",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "[Diabetes:] „Viele Betroffene überprüfen mehrmals täglich ihren aktuellen Blutzuckerwert mithilfe von Teststreifen.“"
                            },
                            {
                                "example_id": "edcbc802-dd8e-4c0d-ab2e-12cec04b4b4b",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Wenn die Sensoren die Flüssigkeit aufgenommen haben, kommt der Teststreifen ins Gerät, das eine präzise Grundlage liefert.“"
                            },
                            {
                                "example_id": "34c88018-3b9e-44db-88c5-5b9daf2587c9",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Der Teststreifen enthält in einer kleinen Reaktionskammer Enzyme, die mit der Glukose im angesaugten Bluttropfen reagieren.“"
                            },
                            {
                                "example_id": "5560437d-65ec-4e51-9818-d87520ae7420",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Diese Enzyme reagieren mit der Glukose im aufgetragenen Bluttropfen, wodurch sich der Teststreifen verfärbt.“"
                            },
                            {
                                "example_id": "f2102f4f-a296-4b6b-8649-1acd7fd8a91e",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "[Guajak-Test:] „Das im Blut vorhandene Hämoglobin wird dann durch eine Reaktion mit Wasserstoffperoxid sichtbar: Der Teststreifen verfärbt sich blau.“"
                            },
                            {
                                "example_id": "70b4f7cf-dd32-4f17-896d-3ca82876a0fe",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Die jeweiligen Teststreifen funktionieren ausschließlich mit entsprechenden Messgeräten.“"
                            },
                            {
                                "example_id": "343b3b7a-0f6f-43d5-b4a7-ddfd79c57e16",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Um Fehler bei der Blutzuckermessung zu vermeiden, müssen Patienten darauf achten, dass die Codierung des Teststreifens mit dem Code im Messgerät übereinstimmt.“"
                            },
                            {
                                "example_id": "47b526f5-7d20-484e-951b-8a0a70d07376",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Außerdem sollten sie die Teststreifen nach dem Ablaufdatum nicht mehr verwenden.“"
                            },
                            {
                                "example_id": "3172b1d9-4501-47d8-82c3-5c3191ed8363",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "[11. November 1966:] „Das Stuttgarter Gesundheitsministerium gibt bekannt, dass Baden-Württemberg als erstes Bundesland ab 1967 Reihenuntersuchungen zur Früherkennung von Diabetes vornehmen wird. Zukünftig sollen jedes Jahr 1,25 Mio. Menschen Teststreifen zur Eigenkontrolle des Zuckergehalts im Urin erhalten.“"
                            },
                            {
                                "example_id": "d4b10d13-f8cd-4907-b7a6-0557a01116a2",
                                "sense_id": "0111b77c-31f1-3258-bd4c-31d34edacff7",
                                "text": "„Taucht die Frau einen dieser Streifen in ihren Urin, reagiert der Teststreifen auf bestimmte chemische Inhaltsstoffe, die sich im Verlauf des Menstruationszyklus verändern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
