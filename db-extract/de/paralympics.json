                                "sense_id": "14188cb9-32d1-3ebc-98f0-847ab42e4f20",
                                "text": "Bald finden die Paralympics statt."
                            },
                            {
                                "example_id": "e58c7dfd-1e67-4757-b862-e03ff85b4afc",
                                "sense_id": "14188cb9-32d1-3ebc-98f0-847ab42e4f20",
                                "text": "Herberts blinde Cousine nimmt an den nächsten Paralympics teil."
                            },
                            {
                                "example_id": "5392c892-acdf-440c-87bd-fd5fefd8e1d4",
                                "sense_id": "14188cb9-32d1-3ebc-98f0-847ab42e4f20",
                                "text": "Ein Arbeitskollege meines Schwagers hat sich für die Paralympics qualifiziert."
                            },
                            {
                                "example_id": "775c9972-dc7a-4592-b7ee-86718564bc05",
                                "sense_id": "14188cb9-32d1-3ebc-98f0-847ab42e4f20",
                                "text": "„In diesem Jahr dreht sich alles um die Paralympics und den Radballsport.“"
                            }
                        ],
