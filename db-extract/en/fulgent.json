                ],
                "senses": [
                    {
                        "sense_id": "f1cefa0e-90c6-390e-abdc-2033e7bcbbfd",
                        "entry_id": "41943267-dea7-3897-9c59-4c8566c19c1c",
                        "glosses": [
                            "Shining brilliantly; radiant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e88f9a85-605b-4309-b928-7e7bf9b31034",
                                "sense_id": "f1cefa0e-90c6-390e-abdc-2033e7bcbbfd",
                                "text": "And univerſally, the greateſt and moſt fulgent tails always ariſe from Comets, immediately after their paſſing by the neighbourhood of the Sun."
                            },
                            {
                                "example_id": "081167d2-95c6-44a7-b278-8fd5bab622c8",
                                "sense_id": "f1cefa0e-90c6-390e-abdc-2033e7bcbbfd",
                                "text": "Shirley takes life easily: is not that fact written in her eye? In her good-tempered moments, is it not as full of lazy softness as in her brief fits of anger it is fulgent with quick-flashing fire?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b80ad89-d7c0-4a10-8c2a-8fba486a62f5",
                        "source_entry_id": "41943267-dea7-3897-9c59-4c8566c19c1c",
                        "source_sense_id": "f1cefa0e-90c6-390e-abdc-2033e7bcbbfd",
                        "source_sense_description": "shining brilliantly — see also radiant",
                        "target_lang_word": "éclatant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclatant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6c0deca-446e-308a-a002-5ddf28d3e5b0",
                                        "entry_id": "cbae6a01-2c03-3740-9fb0-96e38e0a65ce",
                                        "glosses": [
                                            "Qui a de l’éclat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e36944a-a95e-4407-80fd-4057d20f0eeb",
                                                "sense_id": "c6c0deca-446e-308a-a002-5ddf28d3e5b0",
                                                "text": "Le jour était ensoleillé, de telle sorte qu’après cette lumière éclatante du dehors, sa chambre, au rez-de-chaussée, me paraissait tout à fait noire."
                                            },
                                            {
                                                "example_id": "46a521b4-c35c-404f-9cd3-d094183c14b5",
                                                "sense_id": "c6c0deca-446e-308a-a002-5ddf28d3e5b0",
                                                "text": "On retrouve chez Abramow un héritage lisible de Guy Bourdin (1928-1991), immense photographe des années 1970, dont les cadrages acrobatiques, et les couleurs éclatantes, rendaient les mannequins à la fois ultrasexys et parfaitement puissantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7f82942-5ee2-3d5e-9058-5de254e52fdc",
                                        "entry_id": "cbae6a01-2c03-3740-9fb0-96e38e0a65ce",
                                        "glosses": [
                                            "Qui fait un bruit perçant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0b4baa6-3db3-4559-a787-66a23bd4d813",
                                                "sense_id": "f7f82942-5ee2-3d5e-9058-5de254e52fdc",
                                                "text": "Son éclatant."
                                            },
                                            {
                                                "example_id": "f345f317-d83e-42fc-9b4f-862536cb4704",
                                                "sense_id": "f7f82942-5ee2-3d5e-9058-5de254e52fdc",
                                                "text": "Voix éclatante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "349d64c7-7cfd-3015-b5d6-57ab4b7445e0",
                                        "entry_id": "cbae6a01-2c03-3740-9fb0-96e38e0a65ce",
                                        "glosses": [
                                            "Qualifie les choses qui se font remarquer, entre toutes les autres choses semblables, par leur importance, leur célébrité, leur publicité, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b0eec06-1b88-44bd-8e1b-e779221072ba",
                                                "sense_id": "349d64c7-7cfd-3015-b5d6-57ab4b7445e0",
                                                "text": "En dépit de sa réussite, l’Europe connaissait d'intenses frustrations. Cette réussite était pourtant éclatante. Les progrès scientifiques, technologiques et industriels y étaient impressionnants."
                                            },
                                            {
                                                "example_id": "66166128-d2af-4da8-a629-04c19acdb060",
                                                "sense_id": "349d64c7-7cfd-3015-b5d6-57ab4b7445e0",
                                                "text": "Gloire éclatante."
                                            },
                                            {
                                                "example_id": "335895ed-7da7-4a4b-be56-847f748ade82",
                                                "sense_id": "349d64c7-7cfd-3015-b5d6-57ab4b7445e0",
                                                "text": "Action éclatante."
                                            },
                                            {
                                                "example_id": "cff97d0b-6d11-4245-ae0c-87a4e21acd23",
                                                "sense_id": "349d64c7-7cfd-3015-b5d6-57ab4b7445e0",
                                                "text": "Un éclatant désaveu."
                                            },
                                            {
                                                "example_id": "bc14e33a-8b57-4b72-bafa-4e6a5ad900a2",
                                                "sense_id": "349d64c7-7cfd-3015-b5d6-57ab4b7445e0",
                                                "text": "Il disparaissait comme les autres dans le nimbe de cette personne éclatante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "éclatant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4387342-806c-350f-bd52-433a74eeee73",
                                        "entry_id": "d2458057-9bb2-30f0-adb9-87a7ab9cd386",
                                        "glosses": [
                                            "Participe présent de éclater."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e949d25-a0d2-4333-903b-4ad71242a48b",
                                                "sense_id": "d4387342-806c-350f-bd52-433a74eeee73",
                                                "text": "Eh ! mais il est depuis quinze jours dans le lit d’Arsène, dit la petite Niseron en éclatant de rire ; si cette grande paresseuse faisait son lit, elle l’aurait trouvé…"
                                            }
                                        ]
                                    }
                                ]
