    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "420289fa-391b-3ec3-bf66-b8a9677e6b79",
                    "sense_definition": "Témoignage public de respect, d'admiration ou de reconnaissance envers une personne ou son œuvre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la ville s'est rassemblée pour rendre <w>hommage</w> aux victimes de la catastrophe."
                        },
                        {
                            "text": "L'artiste a composé cette nouvelle mélodie en <w>hommage</w> à son mentor disparu."
                        }
                    ],
                    "synonyms": [
                        "tribut",
                        "éloge",
                        "reconnaissance"
                    ],
                    "antonyms": [
                        "mépris",
                        "affront",
                        "insulte"
                    ],
                    "common_phrases": [
                        "rendre hommage",
                        "en hommage à"
                    ]
                },
                {
                    "sense_id": "5926b861-6bc2-3a11-884d-f71476553685",
                    "sense_definition": "Marque ou témoignage de politesse respectueuse et déférente, principalement employé au pluriel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez présenter mes sincères <w>hommages</w> à votre famille lors de votre prochain séjour."
                        },
                        {
                            "text": "L'ambassadeur s'est incliné avec déférence pour offrir ses <w>hommages</w> à la souveraine."
                        }
                    ],
                    "synonyms": [
                        "respects",
                        "civilités",
                        "salutations"
                    ],
                    "common_phrases": [
                        "présenter ses hommages",
                        "mes hommages"
                    ]
                },
                {
                    "sense_id": "9e5d70a8-de54-31d6-8bb4-1af615c3d43f",
                    "sense_definition": "Devoir féodal de fidélité et de soumission qu'un vassal rendait solennellement à son seigneur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chevalier s'agenouilla devant son suzerain pour lui prêter l'<w>hommage</w> féodal."
                        },
                        {
                            "text": "Le baron refusa de rendre <w>hommage</w> au roi, rompant ainsi son serment."
                        }
                    ],
                    "synonyms": [
                        "allégeance"
                    ],
                    "common_phrases": [
                        "rendre hommage"
                    ]
                },
                {
                    "sense_id": "eff82859-b649-3db7-a3ea-b1347450bcf3",
                    "sense_definition": "Don ou dédicace faite à une personne en témoignage de considération ou de gratitude.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le romancier a fait <w>hommage</w> de son manuscrit au directeur de l'académie."
                        },
                        {
                            "text": "Elle reçut ce tableau précieux comme l'<w>hommage</w> sincère d'un peintre reconnaissant."
                        }
                    ],
                    "synonyms": [
                        "dédicace",
                        "offrande"
                    ],
                    "common_phrases": [
                        "faire hommage"
                    ]
                }
            ]
        }
    ]
}