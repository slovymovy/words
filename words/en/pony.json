                        "zh": [
                            {
                                "target_lang_word": "小杯",
                                "target_lang_sense_clarification": "饮料量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf572d88-ca93-3fe2-97a9-e4b2ce39429b",
                    "sense_definition": "Crap; rubbish, nonsense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't listen to him, he is talking absolute <w>pony</w>.",
                            "target_lang_translations": {
                                "ru": "Не слушай его, он несет полную <w>чушь</w>.",
                                "zh": "别听他的，他完全是在<w>胡扯</w>。"
                            }
                        },
                        {
                            "text": "That excuse was a load of <w>pony</w>.",
                            "target_lang_translations": {
                                "ru": "Это оправдание было полным <w>бредом</w>.",
                                "zh": "那个借口简直是一堆<w>垃圾</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "load of pony"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Cockney rhyming slang (pony and trap = crap)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чушь, ерунда, бред (рифмованный сленг).",
                        "zh": "废话、垃圾、胡说八道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чушь",
                                "target_lang_sense_clarification": "ерунда"
                            },
                            {
