                                                "example_id": "da18c54d-b519-435f-aa92-f998ec7e86e7",
                                                "sense_id": "8938b179-f452-385d-883c-73d6b66e2421",
                                                "text": "Bei zu wenig Erfahrung sind die steileren Wege zu meiden."
                                            },
                                            {
                                                "example_id": "2803697d-a324-4425-9d74-3cf3acc669d8",
                                                "sense_id": "8938b179-f452-385d-883c-73d6b66e2421",
                                                "text": "Ich meide lieber den Kontakt zu ihm."
                                            },
                                            {
                                                "example_id": "ad358f76-72e2-42ec-b45a-ef5a61a60588",
                                                "sense_id": "8938b179-f452-385d-883c-73d6b66e2421",
                                                "text": "„Ida mied seinen Blick.“"
                                            },
                                            {
                                                "example_id": "bc76b85e-b09d-46b0-8faa-90a9e55f8a27",
                                                "sense_id": "8938b179-f452-385d-883c-73d6b66e2421",
                                                "text": "„Eine Hälfte der Probanden nahm regelmäßig Erdnussprodukte zu sich, die andere Hälfte mied sie.“"
