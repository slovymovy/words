                "forms": [],
                "senses": [
                    {
                        "sense_id": "2190818d-d355-3698-bf5c-d06b2e311964",
                        "entry_id": "f76876ba-4323-3638-b4d0-165af7d95c2f",
                        "glosses": [
                            "Structure en motte arrondie formée dans certaines tourbières ou zones humides paratourbeuses par la pousse annuelle de certaines plantes sur leurs anciennes racines et feuilles mortes en décomposition ralenties par l’acidité du milieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d2d6e31-b080-4a67-89c2-f1b38ab408fa",
                                "sense_id": "2190818d-d355-3698-bf5c-d06b2e311964",
                                "text": "Cet empilement crée des mottes instables, appelées touradons, qui sont encore plus impressionnantes quand elles ont été brûlées."
                            },
                            {
                                "example_id": "aa43abff-b992-49bb-92aa-5f283c87723f",
                                "sense_id": "2190818d-d355-3698-bf5c-d06b2e311964",
                                "text": "Le nid est une petite coupe d’herbes sèches assez profonde placée dans une touffe d’herbe, […] sur un touradon ou encore dans la mousse."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e7f2d20-e2b5-3df2-9623-c8f87d0d5619",
                        "entry_id": "f76876ba-4323-3638-b4d0-165af7d95c2f",
                        "glosses": [
                            "Butte de sable ou de débris végétaux accumulée par le vent autour d’une plante ou d’un obstacle."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
