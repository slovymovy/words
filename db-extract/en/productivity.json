                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29eb20a7-8ed0-440c-afd3-69acf64afa41",
                                                "sense_id": "f0402bce-ae1c-31fd-a5be-22d5af6948eb",
                                                "text": "Dit gesprek was niet erg vruchtbaar en verzandde in gekijf."
