                "senses": [
                    {
                        "sense_id": "d65527f6-f2ce-36f5-94d3-bcc17e242067",
                        "entry_id": "6c95319e-2426-399b-8462-11c5d9882669",
                        "glosses": [
                            "Argot de français parlé en Côte d’Ivoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2083609d-87f8-4021-8610-95fc08749750",
                                "sense_id": "d65527f6-f2ce-36f5-94d3-bcc17e242067",
                                "text": "Le succès de ce type de langage en marge du français académique chez les adultes, entraîne au niveau de la jeunesse déscolarisée des années 1980, la création d'un parler similaire : le nouchi."
                            },
                            {
                                "example_id": "7c50cea3-dff5-4e0e-a292-407e21e55009",
                                "sense_id": "d65527f6-f2ce-36f5-94d3-bcc17e242067",
                                "text": "Le nouchi : une langue qui, comme le zouglou, est une pure invention des jeunes de la ville. Avec des mots de récupération piochés dans les grands courants linguistiques nationaux auxquels s'ajoutent des emprunts français et anglais."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e2cfb5e-2a52-3613-a9b5-0562995220e3",
                        "entry_id": "6c95319e-2426-399b-8462-11c5d9882669",
                        "glosses": [
                            "Personne jugée parfaitement adaptée à la vie des milieux populaires urbains ivoiriens."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "cf21c0ad-1c13-431d-a61e-576a1208b490",
                                "sense_id": "7e2cfb5e-2a52-3613-a9b5-0562995220e3",
                                "text": "Noooon ! Toi tu as fini avec ça deh ! Tu es un vrai nouchi ! C’est que tu as duré en Côte d’Ivoire !"
                            },
                            {
                                "example_id": "e778d307-3a58-4724-adb8-a29f1da7690d",
                                "sense_id": "7e2cfb5e-2a52-3613-a9b5-0562995220e3",
                                "text": "Tchiééé vieux môgô, tu as bara dans tout tiéka ici là! tu es vrai nouchi même!\nViens prendre ton gbô!"
                            }
                        ]
                    }
                ],
