        "ru-extract.jsonl": [
            {
                "entry_id": "3732157e-0b1d-3e31-a981-030a477f44b5",
                "word": "pisanie",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "47c434b6-0522-3401-b280-0351ec89c947",
                        "entry_id": "3732157e-0b1d-3e31-a981-030a477f44b5",
                        "glosses": [
                            "письмо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30c51a02-8976-46b0-8cca-326216a3aecf",
                                "sense_id": "47c434b6-0522-3401-b280-0351ec89c947",
                                "text": "W pośrodku izdebki stał stół z pulpitem do czytania i pisania, z podwyższonym siedzeniem i wszystkim przyborem do pisania ówczesnym, trzcinami, inkaustem i pargaminami. [Józef Ignacy Kraszewski. Boleszczyce (1877)]",
                                "translation": "Среди комнаты стоял стол с аналоем для чтения и письма, с высоким сиденьем и всеми прочими тогдашними приспособлениями для письма, тростниковыми ручками, едкой жидкостью и пергаментом."
                            }
                        ]
                    },
                    {
                        "sense_id": "1616fbb7-9a54-3030-9453-e1c42f14daf2",
                        "entry_id": "3732157e-0b1d-3e31-a981-030a477f44b5",
                        "glosses": [
                            "грамота"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5888aae9-17a7-4678-8235-9fe71b7c49ca",
                                "sense_id": "1616fbb7-9a54-3030-9453-e1c42f14daf2",
                                "text": "... podeszła Walentowa i oświadczyła swą dobrą o tym pamięć, że panna Marta niegdyś w onych starych i inszych, wcale inszych niż teraźniejsze czasach, troje jej dzieci czytania i pisania nauczyła; [Eliza Orzeszkowa. Nad Niemnem (1886-1887)]",
                                "translation": "Подошла жена Валенты, она до сих пор с благодарностью вспоминает, как панна Марта когда-то учила грамоте ее детей…"
                            }
                        ]
                    },
                    {
                        "sense_id": "ec59b756-fd66-3070-adeb-c2a1038bd39b",
                        "entry_id": "3732157e-0b1d-3e31-a981-030a477f44b5",
                        "glosses": [
                            "писание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76f68a93-f54a-4647-8899-87ebe1f14dfc",
                                "sense_id": "ec59b756-fd66-3070-adeb-c2a1038bd39b",
                                "text": "Około kilku dziesiątek pisarzy ledwie mógł starczyć pisania listów i przepisywania wiadomości. [Józef Ignacy Kraszewski. Król Piast (1876-1887)]",
                                "translation": "Нескольких десятков писарей еле хватало на писание писем и переписку донесений… [. ()]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
