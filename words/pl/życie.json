                    "sense_id": "c33442fc-536d-3f17-a0a1-30f34c9e427c",
                    "sense_definition": "stan organizmów żywych charakteryzujący się procesami biologicznymi, trwający od narodzin do śmierci",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "istnienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarze do samego końca walczyli o <w>życie</w> tego młodego pacjenta.",
                            "target_lang_translations": {
                                "en": "Doctors fought for the young patient's <w>life</w> until the very end."
                            }
                        },
                        {
                            "text": "Naukowcy szukają śladów, które potwierdzą <w>życie</w> na innych planetach.",
                            "target_lang_translations": {
                                "en": "Scientists are looking for signs that would confirm <w>life</w> on other planets."
                            }
                        }
                    ],
                    "synonyms": [
                        "egzystencja",
                        "byt",
                        "istnienie"
                    ],
                    "antonyms": [
                        "śmierć"
                    ],
                    "common_phrases": [
