                    },
                    {
                        "sense_id": "fe31d36e-33c2-37d1-8ba1-8a7bac3f6552",
                        "entry_id": "2f3772fc-ed19-359b-85d4-f81c57701626",
                        "glosses": [
                            "het uitstralen:",
                            "getoonde indruk van iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a459a6aa-f1e8-44c6-bbc8-4b69da09ef11",
                                "sense_id": "fe31d36e-33c2-37d1-8ba1-8a7bac3f6552",
                                "text": "La Planche heeft niet de mythische uitstraling van de Mont Ventoux, de Tourmalet of de Alpe d’Huez, maar aan de reputatie wordt gewerkt. De vorige aankomsten waren vol betekenis."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0ba43f3-fc81-37aa-99fb-b647dda60de0",
                        "entry_id": "2f3772fc-ed19-359b-85d4-f81c57701626",
                        "glosses": [
                            "het uitstralen:",
                            "uiterlijk, hoe iets of iemand eruitziet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95c031d9-a342-49a8-b618-95ff6ad19a6a",
                                "sense_id": "f0ba43f3-fc81-37aa-99fb-b647dda60de0",
                                "text": "Het was een lange slanke vent van in de veertig, en in tegenstelling tot alle andere hikers was hij glad geschoren met een verzorgde, gezonde uitstraling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0294b2b-958b-4d58-9d11-358690daedd1",
                        "source_entry_id": "2f3772fc-ed19-359b-85d4-f81c57701626",
                        "target_lang_word": "efluvio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "efluvio",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "894c784e-6550-3fed-b689-9de7da7135e2",
                                        "entry_id": "c2de9138-efdb-3fdb-bb87-ab4373e43068",
                                        "glosses": [
                                            "Emanación sutil de partículas que producen un ligero olor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58a69b3d-3b49-4003-9c17-387797989e82",
                                                "sense_id": "894c784e-6550-3fed-b689-9de7da7135e2",
                                                "text": "Se percibía un efluvio marino, olor a algas y a marisco."
                                            },
                                            {
                                                "example_id": "dbc82cf1-6153-4583-b323-e9fc3b448b45",
                                                "sense_id": "894c784e-6550-3fed-b689-9de7da7135e2",
                                                "text": "Durante este tiempo asaban al pájaro, el cual cocía y amarilleaba asándose; el jugo del pájaro goteaba, fluía por todas partes, tenía un efluvio muy suave."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb3c16dc-3c59-3b67-ac81-446815f01ed4",
                                        "entry_id": "c2de9138-efdb-3fdb-bb87-ab4373e43068",
                                        "glosses": [
                                            "En sentido figurado, emanación sutil que se percibe, beneficiosa o maléfica, de las estrellas, la luna, el amor, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b8707c7-8011-4fab-a555-1ded2afbb4c2",
                                                "sense_id": "bb3c16dc-3c59-3b67-ac81-446815f01ed4",
                                                "text": "No, no se pararán. Acaso el instinto de cobardía propio de su raza les moverá a agazaparse breves minutos detrás de un arbusto o de una peña; pero al primer imperceptible efluvio amoroso que les traiga la cortante brisa."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
