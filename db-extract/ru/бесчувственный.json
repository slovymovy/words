                            "singular",
                            "feminine",
                            "short-form"
                        ],
                        "form": "бесчу́вственна"
                    },
                    {
                        "form_id": "9a11070e-cb2f-45a1-94b6-020a245653e2",
                        "entry_id": "81c643a8-0d1f-3433-b032-6d8c116cdef9",
