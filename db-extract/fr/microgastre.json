                        "glosses": [
                            "Genre d’hyménoptères parasitoïdes, plus petits que les ichneumons, et dont les larves se développent sur les chenilles de nombreuses espèces de papillons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0c0f47a-8204-4b27-b4c3-653563c8057f",
                                "sense_id": "9e3b86ee-f758-381e-9a22-a68c198e40bc",
                                "text": "Les Microgastres sont des Hyménoptères de petite taille ; leurs larves vivent isolées dans le corps de petites Chenilles telles que celles des Pyrales, ou en société dans des Chenilles de taille moyenne."
                            },
                            {
                                "example_id": "432c88e4-3a57-440f-a557-42e34f5d633c",
                                "sense_id": "9e3b86ee-f758-381e-9a22-a68c198e40bc",
                                "text": "Les Microgastres ont les antennes assez épaisses, droites ou arquées, jamais contournées à l’extrémité, toujours composées de dix-huit articles dans les deux sexes."
                            }
                        ]
                    }
