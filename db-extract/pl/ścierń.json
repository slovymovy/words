                "senses": [
                    {
                        "sense_id": "e48aeba8-ba69-3a97-ba75-05cacbc0f34b",
                        "entry_id": "5c5b68c1-5d93-33a4-a090-93d608a77538",
                        "glosses": [
                            "stubble, what is left on the field after its being mowed down"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "8c6d5eab-2e54-4b38-827a-da77b084b830",
                                "sense_id": "e48aeba8-ba69-3a97-ba75-05cacbc0f34b",
                                "text": "Jeszcze złoty wóz Feba, w kół ognistych toku,\nNie dostarczył szat nowych czterém coróm^([sic]) roku,\nJeszcze w pierwotne brózdy pokraiana niwa\nNie dała dwukrotnego swemu panu żniwa,\nI ptak, co był w iesieni ścierń smutną porzucił,\nJeszcze z wiosną na gniazdo oyczyste nie wrócił...",
                                "translation": "The golden carriage of Phoebus, in its fiery wheels' course,\nHadn't yet given new robes to the four daughters of the year;\nThe field, being cut up into initial furrows,\nHadn't yet given a double harvest to its master;\nAnd the bird that had abandoned the sad stubble in the fall\nHadn't yet returned to its native nest with the spring...",
                                "english": "The golden carriage of Phoebus, in its fiery wheels' course,\nHadn't yet given new robes to the four daughters of the year;\nThe field, being cut up into initial furrows,\nHadn't yet given a double harvest to its master;\nAnd the bird that had abandoned the sad stubble in the fall\nHadn't yet returned to its native nest with the spring..."
                            },
                            {
                                "example_id": "6cbaa6d6-7778-4fad-afbd-402b94b1b2fa",
                                "sense_id": "e48aeba8-ba69-3a97-ba75-05cacbc0f34b",
                                "text": "Stok się tu wyrównywał w rozległą płaszczyznę, w zachodzącym słońcu rudniała ścierń; tu i tam rosły kępy drzew — modrzewi i brzóz.",
                                "translation": "The slope here flattened out into a wide plain; the stubble was turning red in the setting sun; here and there grew clumps of trees — larches and birches.",
                                "english": "The slope here flattened out into a wide plain; the stubble was turning red in the setting sun; here and there grew clumps of trees — larches and birches."
                            }
                        ]
                    }
