                    ]
                },
                {
                    "sense_id": "28cad73f-a3eb-32da-8808-07ed4c3fcefe",
                    "sense_definition": "Personne qui possède et prend soin d'un animal domestique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien attend patiemment son <w>maître</w> devant la porte du magasin."
                        },
                        {
                            "text": "Ce chat reconnaît les pas de son <w>maître</w> dès qu'il monte l'escalier."
