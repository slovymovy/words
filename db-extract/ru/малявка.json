                    {
                        "sense_id": "33d4fbe5-9798-39cc-ba05-d032dea2bc6c",
                        "entry_id": "d3eda112-18eb-3b57-9bf1-7ce259bf3095",
                        "glosses": [
                            "уменьш.-ласк. разг. очень маленький ребёнок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a22265-9803-457c-ae17-f500b9c0d3ed",
                                "sense_id": "33d4fbe5-9798-39cc-ba05-d032dea2bc6c",
                                "text": "Малявка ты ещё, чтобы с нами за яблоками к соседям лазить."
                            },
                            {
                                "example_id": "634f00ac-ade9-4ae9-af95-a1195ed84ab4",
                                "sense_id": "33d4fbe5-9798-39cc-ba05-d032dea2bc6c",
                                "text": "Вот ещё! Мне с малявкой возиться?!"
                            }
                        ]
                    }
                ],
