                ],
                "senses": [
                    {
                        "sense_id": "3b65da21-8669-349c-859c-d4a25ddd3ee5",
                        "entry_id": "bdb299d1-8583-3236-b920-4186126ea2fe",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "912d1a75-864f-4baa-855c-737134b7f8aa",
                                "sense_id": "3b65da21-8669-349c-859c-d4a25ddd3ee5",
                                "text": "Frau Müllers ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5e1121f8-effd-4ad7-b486-683c5fe58b53",
                                "sense_id": "3b65da21-8669-349c-859c-d4a25ddd3ee5",
                                "text": "Herr Müllers wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cd277776-e6d8-4c70-8c81-cc6719c5237c",
                                "sense_id": "3b65da21-8669-349c-859c-d4a25ddd3ee5",
                                "text": "Die Müllers fliegen heute nach Stockholm."
                            },
                            {
                                "example_id": "ea0f0b78-38d2-4284-a6af-446df80a7df8",
                                "sense_id": "3b65da21-8669-349c-859c-d4a25ddd3ee5",
                                "text": "Der Müllers trägt nie die Pullover, die die Müllers ihm strickt."
                            },
                            {
                                "example_id": "04cc8a2c-ba51-48a6-97df-082d61f5afb4",
                                "sense_id": "3b65da21-8669-349c-859c-d4a25ddd3ee5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Müllers kommt, geht der Herr Müllers.“"
                            },
                            {
                                "example_id": "4069db63-c7c7-4b4e-917c-ff7350f44c90",
                                "sense_id": "3b65da21-8669-349c-859c-d4a25ddd3ee5",
                                "text": "Müllers kommt und geht."
                            },
                            {
                                "example_id": "5aa9e85b-a676-4369-8986-f7c3a905dfac",
                                "sense_id": "3b65da21-8669-349c-859c-d4a25ddd3ee5",
                                "text": "Müllers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
