                                "target_lang_sense_clarification": "a very small drop"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "капля",
                                "target_lang_sense_clarification": "небольшой объем жидкости"
                            },
                            {
                                "target_lang_word": "капелька",
                                "target_lang_sense_clarification": "очень маленькая капля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e5f5206-91db-3ca1-8c29-5e34e937c1ee",
                    "sense_definition": "een elektronische sleutel in de vorm van een druppel die werkt met RFID-technologie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hield mijn <w>druppel</w> tegen de scanner om de deur te openen.",
                            "target_lang_translations": {
                                "en": "I held my <w>fob</w> against the scanner to open the door.",
                                "ru": "Я приложил свой <w>магнитный ключ</w> к сканеру, чтобы открыть дверь."
                            }
                        },
                        {
                            "text": "Ben je je <w>druppel</w> vergeten om het kantoor binnen te komen?",
                            "target_lang_translations": {
                                "en": "Did you forget your <w>key fob</w> to enter the office?",
                                "ru": "Ты забыл свой <w>брелок</w>, чтобы войти в офис?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "elektronische druppel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt voor toegangssleutels"
