                        "cross_references": [
                            {
                                "target_word": "likelihood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "606082e3-2fd3-39ca-873b-f2ce7a2bd292",
                                        "entry_id": "9e407b1a-a0c8-3889-8d2f-ba226aa1688c",
                                        "glosses": [
                                            "The probability of a specified outcome; the chance of something happening; probability; the state or degree of being probable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9ca4a34-96c6-4921-85ef-a8e10a99ccb9",
                                                "sense_id": "606082e3-2fd3-39ca-873b-f2ce7a2bd292",
                                                "text": "In all likelihood the meeting will be cancelled."
                                            },
                                            {
                                                "example_id": "03f83326-2ae8-4099-bc68-f0d38a331ddf",
                                                "sense_id": "606082e3-2fd3-39ca-873b-f2ce7a2bd292",
                                                "text": "The likelihood is that the inflation rate will continue to rise."
                                            },
                                            {
                                                "example_id": "06e3d8c9-683b-461f-abe3-a33226b4215b",
                                                "sense_id": "606082e3-2fd3-39ca-873b-f2ce7a2bd292",
                                                "text": "While starting early can increase your likelihood of attaining millionaire status, the investments you choose play an equally important role."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0c90184-ed9e-30a1-ae00-39e91869be51",
                                        "entry_id": "9e407b1a-a0c8-3889-8d2f-ba226aa1688c",
                                        "glosses": [
                                            "The probability that some fixed outcome was generated by a random distribution with a specific parameter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6600937d-2128-3f01-b2b1-95652dc68707",
                                        "entry_id": "9e407b1a-a0c8-3889-8d2f-ba226aa1688c",
                                        "glosses": [
                                            "Likeness, resemblance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e04460f1-d399-4c37-9cce-868192bc7746",
                                                "sense_id": "6600937d-2128-3f01-b2b1-95652dc68707",
                                                "text": "There is no likelihood between pure light and black darkness, […]or between righteousness and reprobation."
                                            }
                                        ]
                                    },
