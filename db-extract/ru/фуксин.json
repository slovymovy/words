                    {
                        "translation_id": "a6be8fc0-e621-4da7-8cb0-6a465781acab",
                        "source_entry_id": "b974ef78-d9ce-301a-9c17-a1908b4ab621",
                        "source_sense_id": "12dee9fc-b5c6-3cb0-9f65-6e686c943e92",
                        "target_lang_word": "Fuchsin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fuchsin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6feda785-99af-3657-9707-99cfd897ed6f",
                                        "entry_id": "90f8a1ce-68fa-3533-9db8-17d22eea193f",
                                        "glosses": [
                                            "ein synthetischer, magentaroter Farbstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d81e294-562f-4cf2-8891-3587ff5db31a",
                                                "sense_id": "6feda785-99af-3657-9707-99cfd897ed6f",
                                                "text": "Diese erste Farbe wurde sowohl in Höchst als auch bei Bayer und BASF unter dem Namen Fuchsin vermarktet."
                                            },
                                            {
                                                "example_id": "6bec1dbe-6042-420b-aa72-12bda73a6e54",
                                                "sense_id": "6feda785-99af-3657-9707-99cfd897ed6f",
                                                "text": "Rehn fand auch die Ursache heraus: Es war das damals in Färbereien häufig verwandte Fuchsin, ein sogenanntes aromatisches Amin."
                                            },
                                            {
                                                "example_id": "299808f8-4615-4463-939f-826d9e37d8df",
                                                "sense_id": "6feda785-99af-3657-9707-99cfd897ed6f",
                                                "text": "BASF-Gründer Friedrich Engelhorn stellte aus dem Abfallprodukt Steinkohlenteer Anilin und Fuchsin her und experimentierte mit künstlichen Farben."
                                            },
                                            {
                                                "example_id": "1170e608-82dc-4b4b-acf7-a093c4b36cd3",
                                                "sense_id": "6feda785-99af-3657-9707-99cfd897ed6f",
                                                "text": "Sie können nachträglich mittels Fuchsin rot gefärbt werden (bei Verwendung der Phasenkontrastmikroskopie ist dies nicht mehr notwendig.)"
                                            },
                                            {
                                                "example_id": "817702c0-1263-4417-b716-21bd57b49254",
                                                "sense_id": "6feda785-99af-3657-9707-99cfd897ed6f",
                                                "text": "Dies wurde ab Mitte des 19. Jahrhunderts durch die erstmalige Verfügbarkeit industriell gefertigter Farben (Teerfarben wie z. B. Mauvein und Fuchsin, insbesondere Azofarbstoff wie Anilingelb) und weiteren Künstlerbedarfs begünstigt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
