                                            {
                                                "example_id": "44a8e55d-a217-41d7-aead-840980d96f82",
                                                "sense_id": "0173dbfd-1037-32a1-8f07-dca1b1c9b0c7",
                                                "text": "Astern sind sehr geschätzte Blütenpflanzen für den Garten im Herbst."
                                            },
                                            {
                                                "example_id": "5a48eaa9-f0e4-4716-8fbd-8966149e3903",
                                                "sense_id": "0173dbfd-1037-32a1-8f07-dca1b1c9b0c7",
                                                "text": "„Mit einer seiner Schwimmflossen kippte er ein Taburett um, auf dem ein überquellender Aschenbecher und eine kleine Vase mit Astern standen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
