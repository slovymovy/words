                                            {
                                                "example_id": "e8c2e13c-773c-48cd-a6b6-b8dc6cdf06a7",
                                                "sense_id": "ff03fc2b-0f71-311a-8df8-97fa3f607976",
                                                "text": "Herr Danzig wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "376efa94-6fae-42f3-8fb7-d77b609ebf7e",
                                                "sense_id": "ff03fc2b-0f71-311a-8df8-97fa3f607976",
                                                "text": "Die Danzigs fliegen heute nach Kanada."
                                            },
                                            {
                                                "example_id": "fe110ab5-d95d-45cf-b74a-d61265fa5043",
                                                "sense_id": "ff03fc2b-0f71-311a-8df8-97fa3f607976",
                                                "text": "Der Danzig trägt nie die Pullover, die die Danzig ihm strickt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
