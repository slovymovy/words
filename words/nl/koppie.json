            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01438744-100d-319b-836b-8d3631481181",
                    "sense_definition": "Verkleinwoord van <w>kop</w>: een kleine drinkbeker, of een klein hoofd (vooral van een dier of informeel van een mens).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "drinkgerei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zullen we gezellig een <w>koppie</w> koffie drinken in de keuken?",
                            "target_lang_translations": {
                                "en": "Shall we have a cozy <w>cup</w> of coffee in the kitchen?"
                            }
                        },
                        {
                            "text": "Het kleine vogeltje hield zijn <w>koppie</w> schuin om ons beter te kunnen zien.",
                            "target_lang_translations": {
                                "en": "The little bird tilted its <w>head</w> to see us better."
                            }
                        }
                    ],
                    "synonyms": [
                        "kopje"
                    ],
                    "common_phrases": [
                        "koppie koffie",
                        "koppie thee"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak informeel gebruikt voor een kopje koffie of thee."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Diminutive of 'kop': a small drinking cup, or a small head (especially of an animal or informally of a person)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cup",
                                "target_lang_sense_clarification": "small drinking vessel"
                            },
                            {
                                "target_lang_word": "head",
                                "target_lang_sense_clarification": "small head of an animal or person"
                            },
                            {
                                "target_lang_word": "cuppa",
                                "target_lang_sense_clarification": "informal term for a cup of tea or coffee"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86736223-9e6e-3139-afdf-55b5343a07aa",
                    "sense_definition": "Pienter verstand, slimheid of intellect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intelligentie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je <w>koppie</w> erbij houden als je dit moeilijke examen maakt.",
                            "target_lang_translations": {
                                "en": "You need to keep your <w>head</w> in the game when taking this difficult exam."
                            }
                        },
                        {
                            "text": "Dat was een slimme zet van hem, dat getuigt echt van <w>koppie</w>.",
                            "target_lang_translations": {
                                "en": "That was a smart move of his, it really shows <w>brains</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "verstand",
                        "slimheid",
                        "brein"
                    ],
                    "antonyms": [
                        "domheid"
                    ],
                    "common_phrases": [
                        "koppie erbij houden",
                        "koppie koppie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vooral gebruikt in informele en spreektaaluitdrukkingen."
                        }
                    ],
                    "target_lang_definitions": {
