                    {
                        "sense_id": "ad9025d9-8844-32b3-97e3-f1e381621cf2",
                        "entry_id": "090f37a3-66ff-3ac8-b089-32ae1ec3e626",
                        "glosses": [
                            "Qui fait naître."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "243f2930-963d-4d92-ac35-81573fb60a74",
                                "sense_id": "ad9025d9-8844-32b3-97e3-f1e381621cf2",
                                "text": "Nature naturante, qui est Dieu ; nature naturée, qui est l’universalité des choses naturelles."
                            },
                            {
                                "example_id": "7a7793f3-a438-4a2e-9659-b317390b1054",
                                "sense_id": "ad9025d9-8844-32b3-97e3-f1e381621cf2",
                                "text": "Les expressions nature naturée et nature naturante sont si heureuses et si énergiques qu’il eût été dommage que Spinosa ne les eût pas employées."
                            },
                            {
                                "example_id": "24d629a6-c3a7-4a33-9bdf-d497201eed2c",
                                "sense_id": "ad9025d9-8844-32b3-97e3-f1e381621cf2",
                                "text": "C’est l’état de compréhension par le frottement des paysages, et non plus par le frôlement des humains. C’est la nature naturée de Spinoza suscitant la nature naturante. Le déplacement n’est qu’un prétexte à métempsychose."
                            }
                        ]
                    }
