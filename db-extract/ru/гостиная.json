                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a62750a9-8490-4dec-83eb-60ee03113403",
                        "source_entry_id": "7054af98-5e51-3b17-8317-6e0100fb523c",
                        "source_sense_id": "2b80fb74-41b3-3c56-91ad-5f13f2a92744",
                        "target_lang_word": "living room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "living room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6f008f-097f-3184-b7ba-f2902d139d50",
                                        "entry_id": "d7c118d7-0561-31b4-9f1f-c582d4d2da47",
                                        "glosses": [
                                            "A room in a private house used for general social and leisure activities."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "813c0c51-dd9f-47e2-9535-70ba92625936",
                                                "sense_id": "ee6f008f-097f-3184-b7ba-f2902d139d50",
                                                "text": "We relax in the living room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a344a29c-2c21-3695-a1cf-bdd7cfd55cd6",
                                        "entry_id": "d7c118d7-0561-31b4-9f1f-c582d4d2da47",
                                        "glosses": [
                                            "Land intended for settlers."
                                        ],
                                        "tags": [
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "801d8950-3041-44cb-bff3-1a9d3fd8b787",
                                                "sense_id": "a344a29c-2c21-3695-a1cf-bdd7cfd55cd6",
                                                "text": "But in the quest for ‘lebensraum’ — the Nazi quest for living room for the German people — he was to find to his ultimate cost the Russians were made of sterner stuff than he had envisaged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15c801f4-29c8-4ffd-a3b5-a06ae1456676",
                        "source_entry_id": "7054af98-5e51-3b17-8317-6e0100fb523c",
                        "source_sense_id": "2b80fb74-41b3-3c56-91ad-5f13f2a92744",
                        "target_lang_word": "Wohnzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohnzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                        "entry_id": "a2326fd5-4ead-3ace-b316-69930fc7b9fa",
                                        "glosses": [
                                            "Raum in einem Haus oder einer Wohnung, der für den Aufenthalt von Personen am Tag bestimmt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c88b32-8655-4e34-81e9-fec041e72d1e",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "Das Wohnzimmer ist meist der größte Wohnraum."
                                            },
                                            {
                                                "example_id": "6d44d3f2-fe32-45ca-8b5b-d30f5d946645",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Er stand auf, ließ Hugo und mich im Arbeitszimmer zurück und ging ins Wohnzimmer, wo er sich einen Whiskey aus der Hausbar einschenken würde, einen großen.“"
                                            },
                                            {
                                                "example_id": "648a9392-9d10-4fc8-a742-28cdd4675c4b",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Morell saß, an einem Glas Brandy nippend, in dem warmen Wohnzimmer in Westminster, dem seine Frau eine echt weibliche Note gegeben hatte.“"
                                            },
                                            {
                                                "example_id": "263baad3-9cc7-4d71-b4b3-da18c5f7a8c1",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Sie rannte mit wehender Pelerine ins Wohnzimmer und warf Aschenbecher unter das Klavier.“"
                                            },
                                            {
                                                "example_id": "3b550fb1-50f0-4a46-a6d6-5ec4008cee0d",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Neben ihrer Schlafcouch im Wohnzimmer hängt ein Wandteppich mit einer idyllischen Waldszene.“"
                                            },
                                            {
                                                "example_id": "b3287855-da2a-4b2e-87b9-3435fb7fb86f",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Er beobachtete den unten schmiedeeisernen, oben grüngekachelten Ofen im Wohnzimmer wie ein widerspenstiges, gefährliches Biest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87274038-cbab-372d-9ed1-ae28097ecfc4",
                                        "entry_id": "a2326fd5-4ead-3ace-b316-69930fc7b9fa",
                                        "glosses": [
                                            "Einrichtung eines Wohnzimmers^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab2700c-fda7-4abe-b0d4-455145bd5ac8",
                                                "sense_id": "87274038-cbab-372d-9ed1-ae28097ecfc4",
                                                "text": "Wir haben uns endlich entschlossen, ein neues Wohnzimmer zu kaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ee99522-591e-4d2e-9c91-df820dcc6573",
                        "source_entry_id": "7054af98-5e51-3b17-8317-6e0100fb523c",
                        "source_sense_id": "2b80fb74-41b3-3c56-91ad-5f13f2a92744",
                        "target_lang_word": "Gästezimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gästezimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76e3fd48-eb7e-3274-93f6-a52d2d07e2ff",
                                        "entry_id": "f0ac0b3a-a867-377e-9ba5-6c61b2fb41f8",
                                        "glosses": [
                                            "Zimmer, in dem Gäste untergebracht werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93145207-aca5-4129-ab6f-33174f6514e1",
                                                "sense_id": "76e3fd48-eb7e-3274-93f6-a52d2d07e2ff",
                                                "text": "„Zu Hause schob ich den Koffer des Onkels ins Gästezimmer und kochte für uns erst einmal einen Tee.“"
                                            },
                                            {
                                                "example_id": "dd0a4064-f364-4e31-a61c-76bea710b358",
                                                "sense_id": "76e3fd48-eb7e-3274-93f6-a52d2d07e2ff",
                                                "text": "„Sie erhielt ein Gästezimmer mit eigener Terrasse und einem breiten eisernen Bett.“"
                                            },
                                            {
                                                "example_id": "0ecb9931-564e-482e-8600-44d718108d33",
                                                "sense_id": "76e3fd48-eb7e-3274-93f6-a52d2d07e2ff",
                                                "text": "„Ich habe mein Gästezimmer gelüftet, das Bett neu bezogen und mein WLAN-Passwort geändert.“"
                                            },
                                            {
                                                "example_id": "f4320f75-60c8-4224-a618-155a92bda1c3",
                                                "sense_id": "76e3fd48-eb7e-3274-93f6-a52d2d07e2ff",
