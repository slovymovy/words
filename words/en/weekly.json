        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd744995-f011-3300-8475-5b8ebb7ab060",
                    "sense_definition": "A publication that is published once a week.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather enjoys reading the local <w>weekly</w> every Sunday morning.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка любит читать местный <w>еженедельник</w> каждое воскресное утро.",
                                "zh": "我祖父喜欢在每周日早上阅读当地的<w>周刊</w>。"
                            }
