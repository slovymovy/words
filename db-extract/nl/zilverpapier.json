                        "entry_id": "5526ace6-e1c7-3950-ad64-83db80510a81",
                        "glosses": [
                            "papier dat aan een kant verzilverd of zilverkleurig is (gebruikt voor natuurkundige experimenten, als verpakkingsmateriaal en voor versieringen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf7ddc5-f9b2-414d-952d-f8c99446a3fa",
                                "sense_id": "f82c7b25-2feb-36b8-9741-a0fa0e1bcf7c",
                                "text": "Hij luistert naar de piepjes en kijkt naar de uitslag van de meter. Uit ervaring weet hij dat het meestal niks is: aluminiumfolie, zilverpapier en lipjes van bierblikjes."
                            },
                            {
                                "example_id": "5bafc995-f1e7-44ce-aac7-8c41e56bfd87",
                                "sense_id": "f82c7b25-2feb-36b8-9741-a0fa0e1bcf7c",
                                "text": "⧖ Zamboni’s - Kolommen bestaan uit schijfjes zilverpapier aan den witten kant bestreken met een mengsel van Bruinsteen - Oxide en Honig."
                            }
                        ]
                    },
                    {
                        "sense_id": "f72ec914-a613-3a4c-8c86-d215e8368ec1",
                        "entry_id": "5526ace6-e1c7-3950-ad64-83db80510a81",
                        "glosses": [
                            "zilverkleurig folie, sinds de tweede helft van de 20e eeuw doorgaans gemaakt van aluminiumfolie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0319380-1f8f-4786-8e10-12ae0d63da5d",
                                "sense_id": "f72ec914-a613-3a4c-8c86-d215e8368ec1",
                                "text": "De waterpijp stamt uit Noord-Afrika en het Midden-Oosten. In de kop zit vaak tabak. Om die te verhitten worden bovenin de kop gloeiende kooltjes op zilverpapier met gaatjes gelegd."
                            }
                        ]
                    }
