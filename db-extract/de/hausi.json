                        "form": "die Hausis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a9f1b40-5937-3fd1-9ce6-c6f67a817493",
                        "entry_id": "18fea31d-df21-3c66-93e2-ebe68d33d43f",
                        "glosses": [
                            "Aufgabe, die ein Schüler vom Lehrer aufbekommt und die in der Regel zu Hause gemacht werden soll"
                        ],
                        "tags": [
                            "Schülersprache",
                            "Kurzwort"
                        ],
                        "examples": [
                            {
                                "example_id": "9b340a9e-aab7-4acf-9978-9896c9471bf0",
                                "sense_id": "6a9f1b40-5937-3fd1-9ce6-c6f67a817493",
                                "text": "„Während manche Lehrkräfte erwarteten, dass Eltern zumindest darauf achten, dass die „Hausis“ erledigt werden, betonten andere, dass sich Mütter und Väter bitte nicht einmischen sollen.“"
                            },
                            {
                                "example_id": "2d097eeb-583b-4330-b86f-5a2d680b5106",
                                "sense_id": "6a9f1b40-5937-3fd1-9ce6-c6f67a817493",
                                "text": "„Ich wünsche mir, dass ich meine Hausis alleine machen kann.“"
                            },
                            {
                                "example_id": "851ab2a1-321d-4bba-8f09-c0c95f113cf2",
                                "sense_id": "6a9f1b40-5937-3fd1-9ce6-c6f67a817493",
                                "text": "„Wir hatten alle Pläne für den Nachmittag, doch die Hausis machen uns wieder einen Strich durch die Rechnung.“"
                            },
                            {
                                "example_id": "b40e7783-c415-468c-83a3-69c263f317d1",
                                "sense_id": "6a9f1b40-5937-3fd1-9ce6-c6f67a817493",
                                "text": "„Am Freitag nach der Schule gemeinsam Essen, Hausis machen, Zocken und Rausgehen.“"
                            },
                            {
                                "example_id": "d7808c75-5d3a-4924-aa80-3856126dadb6",
                                "sense_id": "6a9f1b40-5937-3fd1-9ce6-c6f67a817493",
                                "text": "„Ja, die Klassenlehrerin sei toll, die Hausis auch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
