                                    {
                                        "sense_id": "932200a2-c655-3f12-a958-cd5527676d62",
                                        "entry_id": "8fc3d77d-56d5-3156-ab14-910c6cb153e6",
                                        "glosses": [
                                            "Raubtier aus der Familie der Marder, das ein dichtes bräunliches Fell hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0725d0be-2e33-486d-95bf-9427d516b590",
                                                "sense_id": "932200a2-c655-3f12-a958-cd5527676d62",
                                                "text": "„Aus einer Pelztierfarm in Süderbrarup (Kreis Schleswig-Flensburg) sind in der Nacht zum Sonntag tausende Nerze entwichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7ce38fb-4bb3-3569-bb95-7a23870b5bb4",
                                        "entry_id": "8fc3d77d-56d5-3156-ab14-910c6cb153e6",
                                        "glosses": [
                                            "Fell des unter [1] beschriebenen Raubtiers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "773a4b7b-b791-4334-af87-91160ab06c3f",
                                                "sense_id": "d7ce38fb-4bb3-3569-bb95-7a23870b5bb4",
                                                "text": "Als Anita gestern ihren Mantel aus Nerz trug, wurde sie in der Fußgängerzone mit faulen Eiern beworfen."
                                            },
                                            {
                                                "example_id": "36f5c568-e4ea-4974-919d-a6698c53a4ba",
                                                "sense_id": "d7ce38fb-4bb3-3569-bb95-7a23870b5bb4",
                                                "text": "Der Kürschner verarbeitet hauptsächlich Nerze."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9d9adff9-1cdf-329d-b7a2-403c6a180511",
                                        "entry_id": "8fc3d77d-56d5-3156-ab14-910c6cb153e6",
                                        "glosses": [
                                            "ein aus mehreren unter [2] beschriebenen Fellen hergestellter Pelz (zum Beispiel eine Jacke oder ein Mantel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80ef332-a608-4d1a-9256-3cfb2fdea681",
                                                "sense_id": "9d9adff9-1cdf-329d-b7a2-403c6a180511",
                                                "text": "Tante Ulla wünscht sich von ihrem Mann einen Nerz zum Geburtstag."
                                            },
                                            {
                                                "example_id": "f2345526-27ce-4377-bdc1-8217a6a9e88b",
                                                "sense_id": "9d9adff9-1cdf-329d-b7a2-403c6a180511",
                                                "text": "Zum großen Entsetzen zahlreicher Gäste wurden bei der Gala auch echte Nerze getragen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Nerz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cde88e76-edab-3149-8801-1e6928251b1e",
                                        "entry_id": "ea1d9ef1-3727-3b77-af82-3a7c325f1196",
