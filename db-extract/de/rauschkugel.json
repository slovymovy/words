                "senses": [
                    {
                        "sense_id": "c39e0a95-b793-3d5e-aaeb-502801acea82",
                        "entry_id": "f870823e-69a5-3e0f-907f-541d5d7625a0",
                        "glosses": [
                            "betrunkene Person; Person, die regelmäßig Alkohol konsumiert"
                        ],
                        "tags": [
                            "Austrian German",
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d15221e4-e8b2-4ff7-97d5-ce3de556017a",
                                "sense_id": "c39e0a95-b793-3d5e-aaeb-502801acea82",
                                "text": "„Die sprachlose Rauschkugel durfte wegen des Verdachts auf Trunkenheit im Verkehr in Folge des Konsums von Drogen oder anderer berauschender Mittel nicht mehr weiterfahren.“"
                            },
                            {
                                "example_id": "ef418c05-6951-44e2-b435-7ad97f57c613",
                                "sense_id": "c39e0a95-b793-3d5e-aaeb-502801acea82",
                                "text": "„Gaudard fächert hierfür eine ganze Reihe von Tonfällen auf – gibt die muntere Rauschkugel, die stolz ihren geliebten vierzigprozentigen Whisky Marke Bushmills herumzeigt, und die frech plappernde Lebenskünstlerin, die freilich schon eine leicht verzwungene Fröhlichkeit zur Schau stellt.“"
                            },
                            {
                                "example_id": "3fe75406-bfca-406e-b324-49c23a7ff8c4",
                                "sense_id": "c39e0a95-b793-3d5e-aaeb-502801acea82",
                                "text": "„Somit rasch gefasst, steht die Rauschkugel morgen vor Gericht.“"
                            },
                            {
                                "example_id": "f567c056-18d5-4d4a-b8b9-93a9c502dbc1",
                                "sense_id": "c39e0a95-b793-3d5e-aaeb-502801acea82",
                                "text": "„Und diese Rauschkugel will uns jetzt durchs Dorf führen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
