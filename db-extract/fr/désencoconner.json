                ],
                "senses": [
                    {
                        "sense_id": "3c01fef7-3beb-3505-be09-4caa075e9c09",
                        "entry_id": "98e1bd99-b599-36a8-9e08-d169527047db",
                        "glosses": [
                            "Sortir de son cocon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf19807-bcf6-4471-afb2-7c8b6a452c9d",
                                "sense_id": "3c01fef7-3beb-3505-be09-4caa075e9c09",
                                "text": "Je me désencoconne. Il faut bien s’éveiller du doux sommeil des matinées ménagères, aux tâches organiques."
                            },
                            {
                                "example_id": "a77b938c-d0e8-4f50-b8bb-314d7aa21c06",
                                "sense_id": "3c01fef7-3beb-3505-be09-4caa075e9c09",
                                "text": "Je me désencoconne, l’enveloppe dans la moitié de mon duvet."
                            },
                            {
                                "example_id": "87f4c823-004b-444f-96cb-702623b310c3",
                                "sense_id": "3c01fef7-3beb-3505-be09-4caa075e9c09",
                                "text": "Le paresseux lui-même, l’engourdi, pareil à ce sourd-muet dont l’Évangile nous dit qu’il est si difficile à débarrasser, le voici, désencoconné, qui saute à la corde avec le lien de sa ligature !"
                            }
                        ]
                    }
