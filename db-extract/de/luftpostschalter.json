                "senses": [
                    {
                        "sense_id": "1946f9fc-a7de-304b-aca3-b9c70f6f094b",
                        "entry_id": "b337c936-2aa7-316a-b6f2-05b597a11179",
                        "glosses": [
                            "Schalter in einem Postamt für die Abfertigung von Luftpostsendungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "617a2cfe-3932-4604-b277-906ba9ce91de",
                                "sense_id": "1946f9fc-a7de-304b-aca3-b9c70f6f094b",
                                "text": "„Alle genannten Postämter verfügten an einem besonderen Luftpostschalter über eigene Luftpost-Stempel:...“"
                            },
                            {
                                "example_id": "67fecc3b-426e-413c-b460-7b946ab1af93",
                                "sense_id": "1946f9fc-a7de-304b-aca3-b9c70f6f094b",
                                "text": "„Selbst wenn ich keinerlei Brief erwartete, blieb ich vor dem Schalter der postlagernden Sendungen stehen, denn man muss die Geister der zerrissenen Briefe ehren, und vor dem Luftpostschalter stand ich, um die Geister der nicht abgeschickten Briefe zu grüßen.“"
                            },
                            {
                                "example_id": "0a45f339-25e0-44a0-b41d-caf9311a5fcd",
                                "sense_id": "1946f9fc-a7de-304b-aca3-b9c70f6f094b",
                                "text": "„Am Luftpostschalter tauschte ich diese gegen ein recht großes, schweres Paket ein, das ich alleine nicht einmal anheben konnte.“"
                            },
                            {
                                "example_id": "a131e330-7275-4d4c-8390-7e281c1b6348",
                                "sense_id": "1946f9fc-a7de-304b-aca3-b9c70f6f094b",
                                "text": "„Ein weiterer GanzsachenUmschlag mit dem Aufdruck „Dr 15“ lief als Expressbrief am 11.8.1944 vom Luftpostschalter Syntagmaplatz, Athen, nach Thessaloniki, wo er am 17.8.1944 ankam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
