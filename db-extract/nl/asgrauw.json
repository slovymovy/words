                "senses": [
                    {
                        "sense_id": "62a94c82-8f29-3f3c-8c25-5f2ec67756e0",
                        "entry_id": "8e7a1cfd-ba47-3a55-a139-e647749317e9",
                        "glosses": [
                            "de grauwe kleur van as hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c3569eb-3040-4276-8426-d3f064710862",
                                "sense_id": "62a94c82-8f29-3f3c-8c25-5f2ec67756e0",
                                "text": "We varen op haar richtingsgevoel, steeds dieper het bos in. Het ligt er mysterieus bij – asgrauw, mistig, en de bladeren lijken wel als enige aan het sepia-effect te zijn ontsnapt."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ba9a8a7-3f09-3844-9fa9-ad0d51bd85ce",
                        "entry_id": "8e7a1cfd-ba47-3a55-a139-e647749317e9",
                        "glosses": [
                            "met een lichte kleur, van het gezicht of huid, vooral als gevolg van ziekte, shock, angst"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2409d8a9-dae6-4cbb-bd62-bccc8d849ad2",
                                "sense_id": "0ba9a8a7-3f09-3844-9fa9-ad0d51bd85ce",
                                "text": "In het tl-licht lijkt haar gezicht asgrauw met donkere kringen onder haar ogen."
                            },
                            {
                                "example_id": "37606a3c-e134-4ac7-822e-e57adead5d74",
                                "sense_id": "0ba9a8a7-3f09-3844-9fa9-ad0d51bd85ce",
                                "text": "Zijn asgrauwe gezicht behoorde toe aan een man die per vergissing een enkele reis hel had genomen en zich realiseerde dat zijn leven voorbij was."
                            }
                        ]
                    }
                ],
