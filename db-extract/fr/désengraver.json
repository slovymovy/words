                        "glosses": [
                            "Remettre à flot un bateau engravé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c8b6e6e-0271-48b2-a7fd-fc44e869ac3d",
                                "sense_id": "b496f52a-0bad-3bb2-a391-bab9a0827af7",
                                "text": "Le 19 de ce mois, un vent du sud ayant soufflé, nous arrivâmes à Maassah de Zélach, où le peu d’eau fit engraver nos barques à l’exception de deux ; à force de bras nous parvînmes à les désengraver."
                            },
                            {
                                "example_id": "c562280c-ea01-4e89-a83f-05d6605487dc",
                                "sense_id": "b496f52a-0bad-3bb2-a391-bab9a0827af7",
                                "text": "Lorsqu’on veut désengraver un bateau ou tout autre corps flottant, on commence par sonder la rivière autour du bateau, pour reconnaître quelle est la partie qui touche et dans quelle direction on doit agir sur le bateau pour le dégager plus facilement."
                            }
                        ]
                    }
