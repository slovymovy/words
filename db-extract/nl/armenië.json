                                                "sense_id": "14596501-57d1-338a-a39c-a865c74eaf9a",
                                                "text": "Ich komme gerade aus Armenien."
                                            },
                                            {
                                                "example_id": "de4478a2-6abd-4acc-b7c7-efb7e8e5c73e",
                                                "sense_id": "14596501-57d1-338a-a39c-a865c74eaf9a",
                                                "text": "Eriwan ist die Hauptstadt von Armenien."
                                            },
                                            {
                                                "example_id": "d37c6768-d44d-4305-9650-212e3f5c015f",
                                                "sense_id": "14596501-57d1-338a-a39c-a865c74eaf9a",
                                                "text": "Vergleicht man das Armenien der 1990er Jahre mit dem heutigen, erkennt man eine positive Entwicklung."
                                            },
                                            {
                                                "example_id": "f6f3c885-1144-47ac-8a70-b18b8e9a173c",
                                                "sense_id": "14596501-57d1-338a-a39c-a865c74eaf9a",
                                                "text": "„Armenien ist ein sehr ausgeprägtes Gebirgsland – denn 90 % der Landesfläche liegen mehr als 1.000 Meter über dem Meeresspiegel, die mittlere Höhe beträgt sogar 1.800 Meter.“"
                                            },
                                            {
                                                "example_id": "e5dfa6e8-84be-41d6-81a7-6a36c65bfb29",
                                                "sense_id": "14596501-57d1-338a-a39c-a865c74eaf9a",
                                                "text": "„Armenien ist reich an Bodenschätzen (Bunt- und Edelmetalle, Eisen), hat aber kaum erschlossene Energierohstoffe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
