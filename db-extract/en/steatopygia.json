                                        "sense_id": "5d1ccca3-9d37-370d-9a30-64d2ef9296db",
                                        "entry_id": "576056c7-bfe6-3c1d-963d-0e06cc269a4d",
                                        "glosses": [
                                            "État graisseux des fesses, comme chez les hottentotes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c99e90e-a282-4b15-8880-e316793c473d",
                                                "sense_id": "5d1ccca3-9d37-370d-9a30-64d2ef9296db",
                                                "text": "Le 31 juillet, Paul Topinard est invité à faire une conférence sur « la stéatopygie des Hottentotes au Jardin d'acclimatation ». Le texte en sera partiellement reproduit dans la Revue d'anthropologie en 1889, avec une photographie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c70fd0f-74b1-3087-b7d5-c98f1eede1b7",
                                        "entry_id": "576056c7-bfe6-3c1d-963d-0e06cc269a4d",
                                        "glosses": [
                                            "Développement du fessier chez une personne."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48c6128b-738e-423d-858d-abab8c06f2d4",
                                                "sense_id": "2c70fd0f-74b1-3087-b7d5-c98f1eede1b7",
                                                "text": "Une fille toute en rondeurs, de ces rondeurs qui tiennent quand on a dix-neuf ans mais qui sombrent dans la stéatopygie la trentaine venue."
                                            },
                                            {
                                                "example_id": "65dddd50-eb74-4c6b-ba3e-af92cc1a2256",
                                                "sense_id": "2c70fd0f-74b1-3087-b7d5-c98f1eede1b7",
                                                "text": "La priorité chez eux était la chute de rein. Le cul quoi ! Et sur ce sujet, leur sévérité était impardonnable. Ils ne supportaient pas la moindre stéatopygie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
