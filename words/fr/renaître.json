                            {
                                "target_lang_word": "复兴",
                                "target_lang_sense_clarification": "传统或思潮重新兴起"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4524823-306d-3d3c-929a-82c88055dff7",
                    "sense_definition": "Reparaître au regard après avoir disparu, en parlant d'un cours d'eau souterrain ou de la clarté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La rivière souterraine s'enfonce sous la roche et <w>renaît</w> en aval de la vallée.",
                            "target_lang_translations": {
                                "en": "The underground river sinks beneath the rock and <w>resurfaces</w> downstream in the valley.",
                                "ru": "Подземная река уходит под скалу и <w>выходит на поверхность</w> ниже по течению долины.",
                                "de": "Der unterirdische Fluss versinkt unter dem Felsen und <w>tritt</w> weiter unten im Tal <w>zutage</w>.",
                                "es": "El río subterráneo se hunde bajo la roca y <w>resurge</w> aguas abajo del valle.",
                                "zh": "这条地下河潜入岩石之下，又在山谷下游<w>涌出</w>地面。"
                            }
                        },
                        {
                            "text": "Après la tempête, le soleil perce les nuages et le jour <w>renaît</w> enfin.",
                            "target_lang_translations": {
                                "en": "After the storm, the sun breaks through the clouds and daylight finally <w>reappears</w>.",
                                "ru": "После бури солнце пробивается сквозь тучи, и дневной свет наконец вновь <w>забрезжил</w>.",
                                "de": "Nach dem Sturm durchbricht die Sonne die Wolken, und endlich <w>wiedererscheint</w> das Tageslicht.",
                                "es": "Después de la tormenta, el sol atraviesa las nubes y por fin <w>reaparece</w> la claridad del día.",
                                "zh": "暴风雨过后，太阳穿透云层，天光终于<w>重现</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reparaître"
                    ],
                    "antonyms": [
                        "disparaître"
                    ],
                    "target_lang_definitions": {
                        "en": "To reappear to view after disappearing, said of an underground river or of light.",
                        "ru": "Снова появиться на виду после исчезновения — о подземной реке или свете.",
                        "de": "Nach dem Verschwinden wieder sichtbar werden, etwa bei unterirdischen Flüssen oder beim Tageslicht.",
                        "es": "Volver a aparecer a la vista tras desaparecer, referido a un río subterráneo o a la luz.",
                        "zh": "地下河流或光亮消失后，又重新出现在人们的视线中。"
                    },
