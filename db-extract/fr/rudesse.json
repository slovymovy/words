        "fr-extract.jsonl": [
            {
                "entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                "word": "rudesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b2dbbacc-3327-408b-af46-370cdfea947c",
                        "entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                        "tags": [
                            "plural"
                        ],
                        "form": "rudesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a467834a-434d-3bb2-9824-e842efa7a307",
                        "entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                        "glosses": [
                            "Caractère de ce qui est rude, âpre au toucher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e535ac3-3416-419a-9796-e5075a78efcc",
                                "sense_id": "a467834a-434d-3bb2-9824-e842efa7a307",
                                "text": "La rudesse de la barbe, de la peau."
                            },
                            {
                                "example_id": "7b4d6e61-c0c8-4e18-8120-7f557aeb1123",
                                "sense_id": "a467834a-434d-3bb2-9824-e842efa7a307",
                                "text": "La rudesse de la toile neuve."
                            },
                            {
                                "example_id": "10dcb8b7-2f32-49c0-93e0-ca314bd86533",
                                "sense_id": "a467834a-434d-3bb2-9824-e842efa7a307",
                                "text": "Une crainte confirmée dès les premiers tours de roue, alors que les vibrations du train m'obligent à glisser sous mes fesses la fameuse saucisse pour amortir les secousses et rendre plus confortable la rudesse granitique du bois de la banquette."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b6479ff-deff-3653-ac29-b213ba62647a",
                        "entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                        "glosses": [
                            "Violence, impétuosité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2ee4dd22-3bcf-43b2-a578-c5d48e1a56c2",
                                "sense_id": "1b6479ff-deff-3653-ac29-b213ba62647a",
                                "text": "L’attaque fut d’une telle rudesse que l’ennemi lâcha pied aussitôt."
                            }
                        ]
                    },
                    {
                        "sense_id": "dff97590-9a63-3404-8e11-fc19d44d5968",
                        "entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                        "glosses": [
                            "Caractère de ce qui est rigoureux, pénible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f55e405c-77be-41ad-85ba-0db3e78b6e1b",
                                "sense_id": "dff97590-9a63-3404-8e11-fc19d44d5968",
                                "text": "La rudesse de l’hiver."
                            }
                        ]
                    },
                    {
                        "sense_id": "fce1ecef-9542-3de4-9554-46c6f3e3d7c4",
                        "entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                        "glosses": [
                            "Caractère de ce qui, par sa dureté, est choquant, désagréable à voir, à entendre, à lire, etc., en parlant de choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c908b8ea-a8b8-4b18-b598-d2ab8976e699",
                                "sense_id": "fce1ecef-9542-3de4-9554-46c6f3e3d7c4",
                                "text": "Ses traits ont de la rudesse."
                            },
                            {
                                "example_id": "117601fc-e783-4aa2-a7cb-958af0e8b962",
                                "sense_id": "fce1ecef-9542-3de4-9554-46c6f3e3d7c4",
                                "text": "– Tu as raison, répondit le père d’un ton de douceur qui contrastait avec la rudesse de la jeune fille, mais c’est qu’on ne te laisserait pas entrer dans les églises."
                            },
                            {
                                "example_id": "ffcd4db4-ecf0-463f-8213-9a67e5100a98",
                                "sense_id": "fce1ecef-9542-3de4-9554-46c6f3e3d7c4",
                                "text": "La rudesse de son style."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c7cc817-628d-36df-abd7-91a5a0781109",
                        "entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                        "glosses": [
                            "Caractère de ce qu’il y a de rude dans l’esprit, dans le caractère, dans l’humeur, dans les manières d’agir de certaines gens."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6398075a-b2bd-49f5-b0e0-ce6fa6c8fee4",
                                "sense_id": "5c7cc817-628d-36df-abd7-91a5a0781109",
                                "text": "En entrant, il s'était incliné devant M. Madeleine avec un regard où il n'y avait ni rancune, ni colère, ni défiance, il s'était arrêté à quelques pas derrière le fauteuil du maire ; et maintenant il se tenait là, debout, dans une attitude presque disciplinaire, avec la rudesse naïve et froide d'un homme qui n'a jamais été doux et qui a toujours été patient."
                            },
                            {
                                "example_id": "87c2c849-a34d-425f-bf4b-a12adf2e6613",
                                "sense_id": "5c7cc817-628d-36df-abd7-91a5a0781109",
                                "text": "La rudesse de son caractère, de son humeur."
                            },
                            {
                                "example_id": "1989d427-9d11-491a-b51b-7985709a7465",
                                "sense_id": "5c7cc817-628d-36df-abd7-91a5a0781109",
                                "text": "Quelle rudesse de langage!"
                            },
                            {
                                "example_id": "5b0b210f-fedc-44b1-b9ea-77249832b3a8",
                                "sense_id": "5c7cc817-628d-36df-abd7-91a5a0781109",
                                "text": "La rudesse de l’accueil qui lui a été fait."
                            },
                            {
                                "example_id": "522bab8e-d5a8-4027-a8ed-d4c37edceb34",
                                "sense_id": "5c7cc817-628d-36df-abd7-91a5a0781109",
                                "text": "Traiter quelqu’un avec rudesse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77338609-cfc4-4e71-ad11-00db32bc01b7",
                        "source_entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                        "target_lang_word": "Schroffheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schroffheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4045a461-91fd-3e98-ae65-e2e9ff18b432",
                                        "entry_id": "f62f11de-876b-3999-a4b0-be92b3aa0b04",
                                        "glosses": [
                                            "Eigenschaft eines Geländes/Berges, steil und kantig zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "194923c5-e1cb-320a-acce-f575e87447af",
                                        "entry_id": "f62f11de-876b-3999-a4b0-be92b3aa0b04",
                                        "glosses": [
                                            "Eigenschaft einer Person, sich schroff/grob zu verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "295e8ddf-cd3e-4968-84b3-544ccca766c8",
                                                "sense_id": "194923c5-e1cb-320a-acce-f575e87447af",
                                                "text": "„Er tat ausgesprochen höflich und gebärdete sich wie im Caféhaus, glich ihre flach intonierte Schroffheit durch gestelzte Galanterie aus.“"
                                            },
                                            {
                                                "example_id": "f18495c8-4e2f-4813-9f82-145fa7f40503",
                                                "sense_id": "194923c5-e1cb-320a-acce-f575e87447af",
                                                "text": "„Er war von mässig hohem Wuchs und hatte ein kluges Gesicht, in das der vorspringende Unterkiefer einen Zug von Schroffheit und Härte brachten, ohne dass dieser Zug das Gesicht entstellte, dem er vielmehr etwas besonders Lebendiges und Ausdrucksvolles verlieh.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f542b9d-1f72-4567-b2ce-3eccf434f82a",
                        "source_entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                        "target_lang_word": "Zusammenhanglosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammenhanglosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b905759-97de-3f82-a70d-748f0acae1ca",
                                        "entry_id": "574f18e1-0da9-3916-93d6-d6a1b6c46eaf",
                                        "glosses": [
                                            "Zusammenhanglossein; Eigenschaft, zusammenhanglos zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d63814-088f-46e6-9f09-747ff24479d5",
                                                "sense_id": "3b905759-97de-3f82-a70d-748f0acae1ca",
                                                "text": "„Die Zusammenhanglosigkeit der Dialoge weist auf den verlorenen Lebenssinn der Figuren hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6255706f-9aca-4713-b875-2044df40fa33",
                        "source_entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                        "target_lang_word": "Plötzlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plötzlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02c2a48c-bfcb-3bf3-9c0c-856373f3cf01",
                                        "entry_id": "5b0a4a83-989e-37f8-9ed3-2ed8d4c60dfc",
                                        "glosses": [
                                            "Eigenschaft eines Vorgangs, der sich schlagartig/unvermittelt ereignet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aad0de78-2b4b-4c12-b0c2-ac0ca8d81612",
                                                "sense_id": "02c2a48c-bfcb-3bf3-9c0c-856373f3cf01",
                                                "text": "„Die Sterne erschienen mit jäher Plötzlichkeit wie hergezaubert.“"
                                            },
                                            {
                                                "example_id": "135ba0d2-d995-4697-b11f-fb7394161c76",
                                                "sense_id": "02c2a48c-bfcb-3bf3-9c0c-856373f3cf01",
                                                "text": "„Der Zusammenbruch von Autorität und Macht, der in der Regel nicht nur die Zeitungsleser in seiner Plötzlichkeit überrascht, sondern auch alle Geheimdienste und ihre Experten, die solche Dinge beobachten, wird nur dann zu einer Revolution im vollen Wortsinne, wenn Menschen bereit und in der Lage sind, die Macht aufzugreifen, in das Machtvakuum vorzustoßen und sozusagen einzudringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a375bf16-6b98-4345-bf6e-fd48d5e9bf82",
                        "source_entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                        "target_lang_word": "Übereilung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "61fbd6c9-1e14-4305-8d49-9d72df94e8f4",
                        "source_entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                        "target_lang_word": "Hast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4679f53b-4c04-3c31-924d-ae0db797996b",
                                        "entry_id": "bbe5c6e3-0efd-3c18-824a-1d0148c138ce",
                                        "glosses": [
                                            "Ausführung von Tätigkeiten in großer Geschwindigkeit unter innerer Anspannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce27c0db-a4a9-450c-9b44-7cb601f7ec59",
                                                "sense_id": "4679f53b-4c04-3c31-924d-ae0db797996b",
                                                "text": "Warum diese Eile, diese fast krankhafte Hast?"
                                            },
                                            {
                                                "example_id": "c781d7b4-812a-46bc-b47f-ca39602c2507",
                                                "sense_id": "4679f53b-4c04-3c31-924d-ae0db797996b",
                                                "text": "Gleich hinter ihnen erschien Tatjana Wlaßjewna – sie wies mit der Hand nach Ilja und sprach in atemloser Hast: »Er hat uns gestanden … daß er den Geldwechsler Poluektow ermordet hat … damals, erinnern Sie sich?«"
                                            },
                                            {
                                                "example_id": "8cc1b43d-b330-4fae-a74a-43a49f800472",
                                                "sense_id": "4679f53b-4c04-3c31-924d-ae0db797996b",
                                                "text": "Das trieb zu neuer, wilder Hast …"
                                            },
                                            {
                                                "example_id": "bfbfeb75-7b65-4eeb-957a-d4161651f681",
                                                "sense_id": "4679f53b-4c04-3c31-924d-ae0db797996b",
                                                "text": "„Mit blechernen Löffeln schöpften sie aus einfachen Metallschüsseln eine heiße Flüssigkeit, die sie mit einer gewissen Hast zum Munde führten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ec5d335-2f94-3339-8f95-86d27db4e0e3",
                                        "entry_id": "bbe5c6e3-0efd-3c18-824a-1d0148c138ce",
                                        "glosses": [
                                            "unüberlegte, vorschnelle Ausführung von Tätigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ad3130-53f0-4a77-99fc-e125e51c18db",
                                                "sense_id": "3ec5d335-2f94-3339-8f95-86d27db4e0e3",
                                                "text": "Man hatte in der Hast eine feine Kindergeige ergriffen, die Tazita aus der Frühzeit besaß."
                                            },
                                            {
                                                "example_id": "b9e381c4-4c64-43f2-8b67-07b88d41d01e",
                                                "sense_id": "3ec5d335-2f94-3339-8f95-86d27db4e0e3",
                                                "text": "Und mit überstürzter Hast empfahl er sich."
                                            },
                                            {
                                                "example_id": "51dcac4d-9ace-416a-8b32-89537ba19600",
                                                "sense_id": "3ec5d335-2f94-3339-8f95-86d27db4e0e3",
                                                "text": "Er sattelte das Pferd und ritt in aller Hast fort."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43631181-e9cd-4a4e-9524-b56b09db96eb",
                        "source_entry_id": "93d32ba4-4121-38a5-84f0-13d6f1439c54",
                        "target_lang_word": "Grobheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grobheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9039bee-2472-311c-b3c2-a86df776c277",
                                        "entry_id": "10a1e9dd-9f72-37c4-b2b5-04993288f9d2",
                                        "glosses": [
                                            "grobe, ruppige, wenig feinfühlige Art"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0acdf27-673b-46f6-a56f-e26847bee8cf",
                                                "sense_id": "b9039bee-2472-311c-b3c2-a86df776c277",
                                                "text": "Seine Grobheit erregte immer wieder Abscheu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e52ce0ac-dc7f-3bca-aaac-67460c5d19af",
                                        "entry_id": "10a1e9dd-9f72-37c4-b2b5-04993288f9d2",
                                        "glosses": [
                                            "Verhalten, sich grob zu äußern oder grob zu handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6388195d-774f-4716-a9a3-8e5046cecb66",
                                                "sense_id": "e52ce0ac-dc7f-3bca-aaac-67460c5d19af",
                                                "text": "„Auf dem Heimweg brabbelt er allerlei sexuelle Grobheiten vor sich hin.“"
                                            },
                                            {
                                                "example_id": "bebb6783-735c-4b1f-8b4b-ecf1b9c7c117",
                                                "sense_id": "e52ce0ac-dc7f-3bca-aaac-67460c5d19af",
                                                "text": "„Mochten sich die einen an Luthers Schriften begeistern, andere sich über sie empören, wieder andere sich kopfschüttelnd über seine Grobheiten amüsieren – gleichgültig ließen sie niemanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e5ba6207-6ee8-3f54-a9d6-084ecc8c99d5",
                                        "entry_id": "10a1e9dd-9f72-37c4-b2b5-04993288f9d2",
                                        "glosses": [
                                            "Eigenschaft eines groben, rauen Materials; Eigenschaft, sich grob/rau anzufühlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751abf1b-028a-4f66-9a64-4e1a31faa2af",
                                                "sense_id": "e5ba6207-6ee8-3f54-a9d6-084ecc8c99d5",
                                                "text": "Ein Tuch von solcher Grobheit schien uns in diesem Fall nicht passend zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
