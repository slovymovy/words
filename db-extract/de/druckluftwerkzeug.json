                ],
                "senses": [
                    {
                        "sense_id": "b23c3ca1-7e72-37e2-ab8e-f565fafbd4a3",
                        "entry_id": "a94f26a1-503b-3257-8194-989049958a84",
                        "glosses": [
                            "Werkzeug, das mit Druckluft angetrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bc3381b-1552-4e18-9651-7d1346a920e3",
                                "sense_id": "b23c3ca1-7e72-37e2-ab8e-f565fafbd4a3",
                                "text": "„Die topaktuellen ELMAG - Druckluftwerkzeuge sind hochergonomische Hightech-Produkte für Handwerk, Gewerbe und Industrie, aber auch für private Werkstätten und Garagen.“"
                            },
                            {
                                "example_id": "6ff78941-4908-46d1-908e-1e0670b1a34d",
                                "sense_id": "b23c3ca1-7e72-37e2-ab8e-f565fafbd4a3",
                                "text": "„Das gilt nicht nur für die Endreinigung, sondern auch für die Absaugung direkt am Elektro- oder Druckluftwerkzeug.“"
                            },
                            {
                                "example_id": "2c61b0bc-7ec0-4b09-9d97-a8fd2f364b61",
                                "sense_id": "b23c3ca1-7e72-37e2-ab8e-f565fafbd4a3",
                                "text": "„Airtool wurde 1979 gegründet und handelt mit Druckluftwerkzeugen für Gewerbe und Industrie.“"
                            },
                            {
                                "example_id": "8f2dbb2c-cba4-4131-80ec-9af9454dd80a",
                                "sense_id": "b23c3ca1-7e72-37e2-ab8e-f565fafbd4a3",
                                "text": "„Die Abgabeleistung der Kolbenkompressoren ist begrenzt, dennoch ist es möglich, neben Ausblaspistolen auch Druckluftwerkzeuge zu betreiben, die einen höheren Luftbedarf haben – wenn auch nur kurz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
