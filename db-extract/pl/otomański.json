                "translations": [
                    {
                        "translation_id": "38fab9a0-ad55-49f2-b132-8bde23f51422",
                        "source_entry_id": "5938fcce-11af-32ba-bfec-e09a39e3e84c",
                        "source_sense_id": "cd7c59e3-c8ec-3299-bbc9-0cb3ac4a2560",
                        "target_lang_word": "Ottoman",
