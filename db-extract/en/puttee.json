    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "003a1770-d162-3023-a375-68b3aa691fd7",
                "word": "puttee",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0895f4d3-c6d0-41ed-960a-30586a4c737c",
                        "entry_id": "003a1770-d162-3023-a375-68b3aa691fd7",
                        "tags": [
                            "plural"
                        ],
                        "form": "puttees"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6fc6a90-515e-3f88-bcb9-80e01a9cde02",
                        "entry_id": "003a1770-d162-3023-a375-68b3aa691fd7",
                        "glosses": [
                            "A strip of cloth wound round the leg, worn for protection or support by hikers, soldiers etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34f5877f-f0cd-4e4f-a194-24ed8d5f9b74",
                                "sense_id": "c6fc6a90-515e-3f88-bcb9-80e01a9cde02",
                                "text": "he bought himself a pair of Fox's puttees for going out and polished his belt until it shone like mahogany, and I bet he was never pulled up for having dirty buttons."
                            },
                            {
                                "example_id": "b0f561aa-d9f7-4b3b-b45b-e09006726364",
                                "sense_id": "c6fc6a90-515e-3f88-bcb9-80e01a9cde02",
                                "text": "From Hui-li-chou northwards I was escorted by real soldiers, quite of the new service. They looked rather shipshape in khaki suits and puttees, and their guns were of a good model, but they handled them in careless fashion at first, belabouring laden ponies and even coolies who were slow in getting out of the way of my chair."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec8ee9b6-311a-4ed7-914a-881b4d26e8b1",
                        "source_entry_id": "003a1770-d162-3023-a375-68b3aa691fd7",
                        "source_sense_id": "c6fc6a90-515e-3f88-bcb9-80e01a9cde02",
                        "source_sense_description": "strip of cloth wound round the leg for protection",
                        "target_lang_word": "bande molletière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bande molletière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d125ae1-4971-30ea-9f32-955f2ca5220c",
                                        "entry_id": "2109ac21-4a38-3639-821b-054856de7ce8",
                                        "glosses": [
                                            "Bande de tissu entourant les mollets, portée notamment par les soldats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87132040-5621-462e-8bb1-6e1fcd882364",
                                                "sense_id": "1d125ae1-4971-30ea-9f32-955f2ca5220c",
                                                "text": "Vous feriez mieux, quand le froid de l’hiver viendra, de vous mettre des bandes molletières, parce que les bas, ça réchauffe pas."
                                            },
                                            {
                                                "example_id": "14379e41-f12c-4930-878b-90944641d282",
                                                "sense_id": "1d125ae1-4971-30ea-9f32-955f2ca5220c",
                                                "text": "Nous sautons et ressautons un ruisseau qui s'empêtre dans nos jambes comme une bande molletière défaite."
                                            },
                                            {
                                                "example_id": "92d2046f-4475-4344-9953-7239dfc78f9b",
                                                "sense_id": "1d125ae1-4971-30ea-9f32-955f2ca5220c",
                                                "text": "Ses bandes molletières lui faisaient des mollets énormes dont émergeaient des pieds étonnamment grands pour sa taille."
                                            },
                                            {
                                                "example_id": "5e90375c-b0cf-4130-96ad-c624213f96a7",
                                                "sense_id": "1d125ae1-4971-30ea-9f32-955f2ca5220c",
                                                "text": "Un corps était là contre la porte, intact, d’un homme qui pouvait avoir quarante ans, les jambes prises dans des bandes molletières, une vareuse militaire en oreiller sous sa tête."
                                            },
                                            {
                                                "example_id": "0891a623-bcca-4098-8a24-efcd86a54b0e",
                                                "sense_id": "1d125ae1-4971-30ea-9f32-955f2ca5220c",
                                                "text": "Le troisième jour, des fourragères déversèrent au milieu de la cour des chaussures, des pantalons, des vareuses, des capotes, des ceinturons, des bidons, des bandes molletières…"
                                            },
                                            {
                                                "example_id": "8986e4d9-7fc7-4379-a37b-978262d465da",
                                                "sense_id": "1d125ae1-4971-30ea-9f32-955f2ca5220c",
                                                "text": "J’enfilai un vieux costume et gagnai le fort d’Ivry, muni de mon masque à gaz et d’une musette.\nHabillé de bric et de broc, j’avais dû garder mon pantalon civil sur lequel j’avais enroulé des bandes molletières réglementaires. Casqué, armé d’un vieux fusil Gras, doté de cinquante cartouches, je pris place dans un autobus"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
