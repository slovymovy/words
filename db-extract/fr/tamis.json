                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7066d628-78da-4ed7-9a46-797556122cb2",
                        "source_entry_id": "e2c743e4-2647-3f20-b19f-d4236a1b51f1",
