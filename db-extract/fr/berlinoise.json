                "senses": [
                    {
                        "sense_id": "9a264420-325b-3887-bcbe-efad1ca9974e",
                        "entry_id": "2c5b8e81-5793-31dd-b90f-33c6f3a27c70",
                        "glosses": [
                            "Habitante de Berlin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f624e680-66dc-4039-95dc-2de55a196d6b",
                                "sense_id": "9a264420-325b-3887-bcbe-efad1ca9974e",
                                "text": "Le jeune Desherbiers avait bien supporté la fatigue des marches, il commençait même à se donner des airs en faisant résonner les molettes de ses éperons sur le pavé, en portant son bonnet de police coquettement posé sur l’oreille droite, et les Berlinoises, qui avaient remarqué sa jolie tête blonde, lui eurent bientôt appris à walser."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06f11cd0-4771-4065-9f21-b07f4b504741",
                        "source_entry_id": "2c5b8e81-5793-31dd-b90f-33c6f3a27c70",
                        "source_sense_id": "9a264420-325b-3887-bcbe-efad1ca9974e",
                        "target_lang_word": "Berlinerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berlinerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6e3b245-31ea-3927-b6b3-a60b79f0bee8",
                                        "entry_id": "06746585-db57-305c-8e64-2f7aef064b6b",
                                        "glosses": [
                                            "eine in Berlin (Deutschland) geborene oder dort auf Dauer lebende weibliche Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c110d220-211f-4acf-a1f4-0ca96bc9ede5",
                                                "sense_id": "d6e3b245-31ea-3927-b6b3-a60b79f0bee8",
                                                "text": "Jede Frau, die in Berlin das Wahlrecht hat, gilt als Berlinerin."
                                            },
                                            {
                                                "example_id": "4773b357-70a1-4b63-bb01-a12e79191566",
                                                "sense_id": "d6e3b245-31ea-3927-b6b3-a60b79f0bee8",
                                                "text": "„Ich kannte einen Bühnenarbeiter, der einmal von einem Berliner beim Militär betrogen worden war und seitdem jeden Berliner und jede Berlinerin wie persönliche Feinde behandelte.“"
                                            },
                                            {
                                                "example_id": "dd73919d-cbb1-42ca-a5a6-f35966dfecb8",
                                                "sense_id": "d6e3b245-31ea-3927-b6b3-a60b79f0bee8",
                                                "text": "„Im Sommer 1933 kam eine junge Berlinerin aufs Gut Kukehnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
