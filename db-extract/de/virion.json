                "senses": [
                    {
                        "sense_id": "15fd932a-2e92-3485-9956-62e116340980",
                        "entry_id": "6749f4a3-ff2e-3fda-ae00-dd9eeadf2270",
                        "glosses": [
                            "reifes, infektiöses Virus, das außerhalb der Wirtszelle vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "561f7a66-42fb-42da-8759-f2dda769c503",
                                "sense_id": "15fd932a-2e92-3485-9956-62e116340980",
                                "text": "„Im Gegensatz hierzu neutralisiert das korrespondierende Antiserum das Virion, da es mit den Antigenen des Hüllproteins reagiert; das gleiche Antiserum ist ohne jeden Einfluß auf die infektiöse Nucleinsäure, die aus dem Virion isoliert wurde.“"
                            },
                            {
                                "example_id": "581290a2-1339-4398-8f11-857d9a594e27",
                                "sense_id": "15fd932a-2e92-3485-9956-62e116340980",
                                "text": "„Das Virion wird zum bösen Virus, und unterwirft sie zur Zwangsarbeit.“"
                            },
                            {
                                "example_id": "68831e57-6d17-478d-8db1-062ed03165cb",
                                "sense_id": "15fd932a-2e92-3485-9956-62e116340980",
                                "text": "„Mit dem S-Protein bindet das Virion an die Zellmembran der Wirtszelle.“"
                            },
                            {
                                "example_id": "dc828281-cfff-413d-b0bb-5f7bdaa633c9",
                                "sense_id": "15fd932a-2e92-3485-9956-62e116340980",
                                "text": "„Merkwürdigerweise enthält das Virion Ribosomen, die durch Mitnahme aus der Zelle in das Virion gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
