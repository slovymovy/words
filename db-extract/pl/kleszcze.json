                                    {
                                        "sense_id": "6c913cde-1435-3e66-8161-8e41860ee012",
                                        "entry_id": "22b29761-4e28-310f-b266-ffea551184c7",
                                        "glosses": [
                                            "An instrument or tool used for picking things up without touching them with the hands or fingers, consisting of two slats or grips hinged at the end or in the middle, and sometimes including a spring to open the grips."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d07ab7c-a47b-459e-b369-e3a1d041e318",
                                                "sense_id": "6c913cde-1435-3e66-8161-8e41860ee012",
                                                "text": "There was also hairdressing: hairdressing, too, really was hairdressing in those times — no running a comb through it and that was that. It was curled, frizzed, waved, put in curlers overnight, waved with hot tongs;[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "115b337a-92a9-3256-87d0-5980d50521fb",
                                        "entry_id": "22b29761-4e28-310f-b266-ffea551184c7",
                                        "glosses": [
                                            "A large scissors-like two-piece center-hinged forged-iron implement with oval-loop handles and with pointed tips turned inward (in the same plane as and perpendicular to the handles) to facilitate lifting and carrying a block of ice. Often called ice tongs."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": []
                                    }
