{
    "word_family": [
        "generation",
        "generator",
        "generative",
        "regeneration",
        "degenerate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce56fa79-e923-35a6-a04e-222cd98891cf",
                    "sense_definition": "To bring into being; to cause something to exist or happen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new marketing campaign helped to <w>generate</w> a lot of sales for the company.",
                            "target_lang_translations": {
                                "ru": "Новая маркетинговая кампания помогла <w>сгенерировать</w> большой объем продаж для фирмы.",
                                "zh": "新的营销活动帮助公司<w>产生</w>了大量销售额。"
                            }
                        },
                        {
                            "text": "We need to <w>generate</w> fresh ideas to solve this problem effectively.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>генерировать</w> свежие идеи, чтобы эффективно решить эту проблему.",
                                "zh": "我们需要<w>创造</w>新颖的思路来有效地解决这个问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "create",
                        "produce",
                        "bring about",
                        "make",
                        "engender"
                    ],
                    "antonyms": [
                        "annihilate",
                        "obliterate"
                    ],
                    "common_phrases": [
                        "generate income",
                        "generate interest",
                        "generate ideas",
                        "generate traffic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать к жизни; быть причиной возникновения чего-либо (например, идей, продаж).",
                        "zh": "导致某事发生或存在；产生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порождать",
                                "target_lang_sense_clarification": "быть источником, служить причиной"
                            },
                            {
                                "target_lang_word": "генерировать",
                                "target_lang_sense_clarification": "создавать (идеи, контент, доход)"
                            },
                            {
                                "target_lang_word": "создавать",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "产生",
                                "target_lang_sense_clarification": "引起、出现"
                            },
                            {
                                "target_lang_word": "创造",
                                "target_lang_sense_clarification": "制造出新的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d51c0612-a402-32b1-89b8-ae66ceefc3b5",
                    "sense_definition": "To produce energy, heat, or a substance as a result of a chemical or physical process.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wind turbines are used to <w>generate</w> electricity in many coastal areas.",
                            "target_lang_translations": {
                                "ru": "Ветряные турбины используются, чтобы <w>вырабатывать</w> электричество во многих прибрежных районах.",
                                "zh": "许多沿海地区使用风力涡轮机来<w>发电</w>。"
                            }
                        },
                        {
                            "text": "The friction between the moving parts will <w>generate</w> heat.",
                            "target_lang_translations": {
                                "ru": "Трение между движущимися частями будет <w>вырабатывать</w> тепло.",
                                "zh": "运动部件之间的摩擦会<w>产生</w>热量。"
                            }
                        }
                    ],
                    "synonyms": [
                        "produce",
                        "make"
                    ],
                    "antonyms": [
                        "extinguish"
                    ],
                    "common_phrases": [
                        "generate electricity",
                        "generate power",
                        "generate heat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить энергию, тепло или вещество в результате химического или физического процесса.",
                        "zh": "通过物理或化学过程制造出能量、热量或物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырабатывать",
                                "target_lang_sense_clarification": "производить энергию или вещество"
                            },
                            {
                                "target_lang_word": "генерировать",
                                "target_lang_sense_clarification": "технический термин (электричество, сигналы)"
                            },
                            {
                                "target_lang_word": "производить",
                                "target_lang_sense_clarification": "изготовлять, выпускать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发电",
                                "target_lang_sense_clarification": "专门指产生电力"
                            },
                            {
                                "target_lang_word": "产生",
                                "target_lang_sense_clarification": "制造出热量或物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24c56485-0b09-3e9a-8df0-f5d5432f363a",
                    "sense_definition": "To form a geometric figure by moving a point, line, or surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rotating a circle around its diameter will <w>generate</w> a sphere.",
                            "target_lang_translations": {
                                "ru": "Вращение круга вокруг своего диаметра <w>образует</w> сферу.",
                                "zh": "将圆绕其直径旋转即可<w>形成</w>一个球体。"
                            }
                        },
                        {
                            "text": "A simple mathematical formula can <w>generate</w> a complex curve.",
                            "target_lang_translations": {
                                "ru": "Простая математическая формула может <w>создать</w> сложную кривую.",
                                "zh": "一个简单的数学公式就能<w>形成</w>一条复杂的曲线。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Образовывать геометрическую фигуру путем перемещения точки, линии или поверхности.",
                        "zh": "通过点、线或面的移动形成几何图形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "образовывать",
                                "target_lang_sense_clarification": "составлять форму или фигуру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "形成",
                                "target_lang_sense_clarification": "构成某种形状"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e10a5aab-9a1e-37d6-b180-7aa3d2ac4cd5",
                    "sense_definition": "To procreate or produce offspring.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These organisms can <w>generate</w> new cells very rapidly.",
                            "target_lang_translations": {
                                "ru": "Эти организмы могут <w>производить</w> новые клетки очень быстро.",
                                "zh": "这些生物体能够非常迅速地<w>产生</w>新细胞。"
                            }
                        },
                        {
                            "text": "The species is able to <w>generate</w> many offspring in a single season.",
                            "target_lang_translations": {
                                "ru": "Этот вид способен <w>производить</w> многочисленное потомство за один сезон.",
                                "zh": "该物种能够在单个季节内<w>繁殖</w>大量后代。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spawn"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "biological or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить потомство или размножаться.",
                        "zh": "繁衍或产生后代。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "производить",
                                "target_lang_sense_clarification": "давать потомство"
                            },
                            {
                                "target_lang_word": "порождать",
                                "target_lang_sense_clarification": "давать жизнь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "繁殖",
                                "target_lang_sense_clarification": "生物学意义上的产生后代"
                            },
                            {
                                "target_lang_word": "产生",
                                "target_lang_sense_clarification": "指细胞或生物体的生成"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "110c2f74-b48f-3308-bbce-c4e56007464d",
                    "sense_definition": "Created or brought into existence; not eternal or self-existent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that the universe is <w>generate</w> and therefore must have a beginning.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что вселенная <w>сотворена</w>, и поэтому должна иметь начало.",
                                "zh": "哲学家认为宇宙是<w>被创造的</w>，因此必然有一个开端。"
                            }
                        },
                        {
                            "text": "They debated whether the soul is <w>generate</w> or ingenerate.",
                            "target_lang_translations": {
                                "ru": "Они спорили о том, является ли душа <w>сотворенной</w> или несотворенной.",
                                "zh": "他们争论灵魂究竟是<w>被创造的</w>还是非创造的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ingenerate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly used in philosophy or theology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сотворенный, созданный; имеющий начало во времени (в отличие от вечного).",
                        "zh": "被创造出来的；非永恒或自存的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сотворенный",
                                "target_lang_sense_clarification": "философский термин"
                            },
                            {
                                "target_lang_word": "рожденный",
                                "target_lang_sense_clarification": "возникший, не изначальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "被创造的",
                                "target_lang_sense_clarification": "哲学或神学语境"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}