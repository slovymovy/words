    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0e9d0280-0019-3fb6-84eb-7149f730e445",
                "word": "Instagram",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4979429e-07b2-3a70-a3d1-b8723f20ff53",
                        "entry_id": "0e9d0280-0019-3fb6-84eb-7149f730e445",
                        "glosses": [
                            "An online photo- and video-sharing social networking service, originally designed to mimic old-fashioned instant cameras."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "15d9c6fc-b747-40c6-99ed-d40246ba358e",
                                "sense_id": "4979429e-07b2-3a70-a3d1-b8723f20ff53",
                                "text": "Carla's got a boyfriend / I spotted him on Instagram / Followed him about a bit"
                            },
                            {
                                "example_id": "6e5ec909-7130-43e5-afad-db0e63e1abe4",
                                "sense_id": "4979429e-07b2-3a70-a3d1-b8723f20ff53",
                                "text": "Megan has 53 posts, follows all her followers and has 41.7k followers on Instagram."
                            },
                            {
                                "example_id": "825f5117-4604-4e1b-9660-ad2eca537f02",
                                "sense_id": "4979429e-07b2-3a70-a3d1-b8723f20ff53",
                                "text": "He posted a gym reel on Instagram."
                            },
                            {
                                "example_id": "7bc2449f-7658-4c03-94a3-27f7b4f62ed0",
                                "sense_id": "4979429e-07b2-3a70-a3d1-b8723f20ff53",
                                "text": "According to a survey commissioned by the credit card company Barclay, 9 percent of shoppers in Britain admitted to buying clothes online for Instagram. After posting pictures of themselves wearing the item online, they return it."
                            },
                            {
                                "example_id": "f66b71ec-e9e6-478d-ac43-82945ef40ee4",
                                "sense_id": "4979429e-07b2-3a70-a3d1-b8723f20ff53",
                                "text": "One who is quickly causing controversy — although his 249K Instagram follower tally is a far cry from Tate’s 4.6 million before Tate was banned — is Myron Gaines, co-host of the Fresh and Fit podcast which markets itself as the No. 1 men’s podcast in the world."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "037a8bd7-a6d9-47d2-b850-5576dca7d5dd",
                        "source_entry_id": "0e9d0280-0019-3fb6-84eb-7149f730e445",
                        "source_sense_id": "4979429e-07b2-3a70-a3d1-b8723f20ff53",
                        "source_sense_description": "online photo-sharing service",
                        "target_lang_word": "Instagram",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Instagram",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d73957-9e0c-3260-af51-223604adca5a",
                                        "entry_id": "55c4d306-ecd7-31c6-ac8c-52f36d684a53",
                                        "glosses": [
                                            "Application, réseau social et service de partage de photos et de vidéos, disponibles sur plates-formes mobiles de type iOS, Android et Windows Phone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bf3fc5f-9147-4708-ae7f-d9518e09c0a6",
                                                "sense_id": "a0d73957-9e0c-3260-af51-223604adca5a",
                                                "text": "Dernièrement, c’est l’influenceuse allemande Julia Lassner, suivie par plus de 50 000 personnes sur Instagram, qui a été choisie pour cibler « les jeunes actifs qui voyagent de façon responsable »."
                                            },
                                            {
                                                "example_id": "513390c2-5b71-4f60-bb6a-cca118bffdc0",
                                                "sense_id": "a0d73957-9e0c-3260-af51-223604adca5a",
                                                "text": "Elle l’a annoncé sobrement vendredi dernier, avec l’air de ne pas trop vouloir déranger l’internaute occupé à faire défiler les publications de son fil Instagram."
                                            },
                                            {
                                                "example_id": "c2c7f612-752a-47bb-9ae0-9fa12bf40c4b",
                                                "sense_id": "a0d73957-9e0c-3260-af51-223604adca5a",
                                                "text": "La rencontre avec Julie Ledru, découverte sur Instagram, a été déterminante."
                                            },
                                            {
                                                "example_id": "55c1012d-f198-4c16-8afd-98c5eeb3e816",
                                                "sense_id": "a0d73957-9e0c-3260-af51-223604adca5a",
                                                "text": "Kevin possédait un vieux compte Facebook qui réunissait ses parents et une poignée d'amis, ainsi qu'un Instagram datant de ses années d’AgroParisTech et un Twitter qu'il utilisait de manière passive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80c9c6cc-ed59-4b48-82b8-71a6056b88ed",
                        "source_entry_id": "0e9d0280-0019-3fb6-84eb-7149f730e445",
                        "source_sense_id": "4979429e-07b2-3a70-a3d1-b8723f20ff53",
                        "source_sense_description": "online photo-sharing service",
                        "target_lang_word": "Instagram",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Instagram",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "551c5613-7dd1-3262-a598-fe1b1d307e66",
                                        "entry_id": "cd2fc5b1-bdd5-34e7-968e-7ab7046732a6",
                                        "glosses": [
                                            "ein soziales Netzwerk, bei dem Nutzer Fotos und Videos (für einen begrenzten Zeitraum) zu veröffentlichen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "016d16ae-5240-4860-950e-75169231b59e",
                                                "sense_id": "551c5613-7dd1-3262-a598-fe1b1d307e66",
                                                "text": "Meine Tochter postet ihre Urlaubsfotos unter anderem auf Instagram."
                                            },
                                            {
                                                "example_id": "0dfeb7de-4769-4203-b9b1-c13324897453",
                                                "sense_id": "551c5613-7dd1-3262-a598-fe1b1d307e66",
                                                "text": "„Alaattin Çakıcı sitzt wegen etlicher Straftaten in Haft. Das hält ihn nicht davon ab, Kritikern zu drohen. Kürzlich verbreitete er über Instagram eine Liste mit Namen von Journalisten, die ihm nicht genehm sind.“"
                                            },
                                            {
                                                "example_id": "e7d43149-561b-48a8-9186-6f5fa0020bdf",
                                                "sense_id": "551c5613-7dd1-3262-a598-fe1b1d307e66",
                                                "text": "„Duck Face, Thigh Gap, Foodporn: Auf Instagram ist vieles möglich. Hauptsache es gibt ein Bild davon.“"
                                            },
                                            {
                                                "example_id": "5b74fc6d-ac24-4994-b3e7-3ef5ba3786ac",
                                                "sense_id": "551c5613-7dd1-3262-a598-fe1b1d307e66",
                                                "text": "„Das Foto wird auf dem sozialen Netzwerk Instagram natürlich wunderbar spontan aussehen, also irgendwie nach: Huch, wer hat mich denn da zufällig beim Teetrinken und Verträumtgucken fotografiert? In Wirklichkeit allerdings hat die junge Frau einen Fotografen dabei, er wechselt blitzschnell zwischen drei Kameras und dirigiert sie mit Kommandos wie ‚Hals länger machen‘ oder ‚nicht so stark saugen, das ist zuviel Duck Face‘.“"
                                            },
                                            {
                                                "example_id": "5ccbcf04-1211-4119-9d91-af578c5e71b5",
                                                "sense_id": "551c5613-7dd1-3262-a598-fe1b1d307e66",
                                                "text": "„Der Ankauf der populären Smartphone-App Instagram, mit der sich Fotoaufnahmen machen, bearbeiten und teilen lassen, dürfte nur ein erster Schritt sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
