                ],
                "senses": [
                    {
                        "sense_id": "a6f72c7a-49d7-356f-865d-4a59f7f89cea",
                        "entry_id": "8dc93334-4e55-39f4-9e30-8d3bf70ed194",
                        "glosses": [
                            "kaart die hoort bij de soort die troef is (klaveren, ruiten, harten of schoppen)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "61f22daa-f483-3aa7-8240-1807be13418a",
                        "entry_id": "8dc93334-4e55-39f4-9e30-8d3bf70ed194",
                        "glosses": [
                            "beslissend voordeel boven een concurrent dat aanvankelijk verborgen bleef"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1690138-e8e8-48f4-9c4f-7e3a13195362",
                                "sense_id": "61f22daa-f483-3aa7-8240-1807be13418a",
                                "text": "De Tesla-truck zou ongeveer 200.000 dollar kosten (170.000 euro), een pak meer dan een vergelijkbare dieseltruck (tussen 100.000 à 120.000 euro, maar Musk zegt dat de operationele kosten – ‘1,26 dollar per mijl’ – lager zijn dan die van een dieseltruck – ‘1,51 dollar per mijl’.* Het economische gebruik is een belangrijke troefkaart van de elektrische truck. Zo vallen ook de onderhoudskosten lager uit. De Tesla-truck heeft minder bewegende delen, geen cardanaandrijving en geen katalysatoren of filters."
                            },
                            {
                                "example_id": "27ec6d97-d3cb-4429-ae56-891067d469af",
                                "sense_id": "61f22daa-f483-3aa7-8240-1807be13418a",
                                "text": ",,De verhuurders hebben alle troefkaarten in handen,\"zegt een goed ingevoerde bron rond de onderhandelingen. ,,De curatoren van V&D moeten aan de zijlijn toekijken. Het is een politiek spel en de huurbazen spelen dat maximaal uit.\""
                            },
                            {
                                "example_id": "7cc12d23-e473-42fd-b4aa-01af7fb40c6a",
                                "sense_id": "61f22daa-f483-3aa7-8240-1807be13418a",
                                "text": "Om een uur of 4 's morgens speelde de VVD de troefkaart uit en werd gestemd om de het debat om 5 uur af te ronden. Over dat voorstel wilde Mulder hoofdelijk stemmen. Dat pakte enigszins pijnlijk voor hem uit, want hij was de enige PVV'er in het Kamergebouw waar de coalitiefracties juist bleken te zijn voorbereid op zo'n stemming. Ook Van Rooijen stemde voor het 'afrond-voorstel'dat met 78 stemmen voor en één tegen van Mulder werd aangenomen. Om 4 uur 39 hamerde de teruggekeerde Kamervoorzitter Arib na ruim acht uur debatteren af."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55aa37f2-9a0d-42c5-a2a8-38e0c11c2b11",
                        "source_entry_id": "8dc93334-4e55-39f4-9e30-8d3bf70ed194",
                        "source_sense_id": "a6f72c7a-49d7-356f-865d-4a59f7f89cea",
                        "source_sense_description": "kaart van de soort die troef is",
                        "target_lang_word": "trump",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98f99cc4-6142-3928-9416-3423534fdedd",
                                        "entry_id": "532b6aac-bb6d-355f-9b62-f6f97d7f2a93",
                                        "glosses": [
                                            "The suit, in a game of cards, that outranks all others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65156451-0680-462b-ad5e-0d2458e6881b",
                                                "sense_id": "98f99cc4-6142-3928-9416-3423534fdedd",
                                                "text": "Diamonds were declared trump(s)."
                                            },
                                            {
                                                "example_id": "570df95d-0d93-4bd3-98e3-30b749469e38",
                                                "sense_id": "98f99cc4-6142-3928-9416-3423534fdedd",
                                                "text": "And now her Heart with Pleasure jumps,\nShe scarce remembers what is Trumps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cf9a48a-2380-310f-a63e-6acd5a9e99cc",
                                        "entry_id": "532b6aac-bb6d-355f-9b62-f6f97d7f2a93",
                                        "glosses": [
                                            "A playing card of that suit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cabf4c4c-b32c-4067-9b6b-2cbb00fb24bf",
                                                "sense_id": "9cf9a48a-2380-310f-a63e-6acd5a9e99cc",
                                                "text": "He played an even higher trump."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "700fb921-8aa0-3b03-a5c2-06808743e27e",
                                        "entry_id": "532b6aac-bb6d-355f-9b62-f6f97d7f2a93",
                                        "glosses": [
                                            "Something that gives one an advantage, especially one held in reserve."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b4ee706-27bc-4fed-92cd-494f3c2f7f53",
                                                "sense_id": "700fb921-8aa0-3b03-a5c2-06808743e27e",
                                                "text": "VVere Iacke Strawe a liue againe,\nAnd I in as good poſſibility as euer I was,\nI would lay a ſurer trumpe,\nEre I would loſe ſo faire a tricke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93ebeda3-4655-3005-ae97-5fca58236b2d",
                                        "entry_id": "532b6aac-bb6d-355f-9b62-f6f97d7f2a93",
                                        "glosses": [
                                            "An excellent person; a fine fellow, a good egg."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02f67c15-ccab-4a5e-9822-37e4a77d46dd",
                                                "sense_id": "93ebeda3-4655-3005-ae97-5fca58236b2d",
                                                "text": "[W]e permitted no hostile foot to pass over or desecrate his resting place; shall be that which to learn the last trump shall awaken our WASHINGTON."
                                            },
                                            {
                                                "example_id": "fb4a58b0-bbd9-4db6-882d-d7e50d43db0a",
                                                "sense_id": "93ebeda3-4655-3005-ae97-5fca58236b2d",
                                                "text": "All hands voted Queequeg a noble trump; the captain begged his pardon."
                                            },
                                            {
                                                "example_id": "b2fa8565-92e3-4d38-a547-ebb1abbb319c",
                                                "sense_id": "93ebeda3-4655-3005-ae97-5fca58236b2d",
                                                "text": "Brooke was a trump to telegraph right off."
                                            },
                                            {
                                                "example_id": "08add302-1151-40cb-b408-70a0993f7e93",
                                                "sense_id": "93ebeda3-4655-3005-ae97-5fca58236b2d",
                                                "text": "Alfred is a trump, I think you say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7277653-3fec-312f-99c8-672c16f80815",
                                        "entry_id": "532b6aac-bb6d-355f-9b62-f6f97d7f2a93",
                                        "glosses": [
                                            "An old card game, almost identical to whist; the game of ruff."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9518496b-f427-4563-81f4-6a00dbc99241",
                                                "sense_id": "e7277653-3fec-312f-99c8-672c16f80815",
                                                "text": "There be many one that breaketh this carde,[…]and playeth there with oftentimes at the blinde trompe, wherby they be no winners but great losers"
                                            },
                                            {
                                                "example_id": "7db7e76b-413a-4297-8739-5497486bc675",
                                                "sense_id": "e7277653-3fec-312f-99c8-672c16f80815",
                                                "text": "Trionfo,[…]also a trump at cards, or the play called trump or ruff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dd12184-3da3-383f-9c06-ed2cf98f3d9b",
                                        "entry_id": "532b6aac-bb6d-355f-9b62-f6f97d7f2a93",
                                        "glosses": [
                                            "A card of the major arcana of the tarot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c18cdd5-e423-3b3b-a206-4d4b1ad98819",
                                        "entry_id": "6c11c689-14ae-348e-b60a-112514a49315",
                                        "glosses": [
                                            "To play on (a card of another suit) with a trump."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c16de3-40a2-4f68-96c4-327fcbdbbd24",
                                                "sense_id": "4c18cdd5-e423-3b3b-a206-4d4b1ad98819",
                                                "text": "He knew the hand was lost when his ace was trumped."
                                            },
                                            {
                                                "example_id": "f8afa0fd-57e9-4c3f-b56a-1628d2353628",
                                                "sense_id": "4c18cdd5-e423-3b3b-a206-4d4b1ad98819",
                                                "text": "He lost his money at whist after dinner, and actually trumped his partner’s highest spade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6a0d78f-b35f-30a0-9741-5b3a00a23087",
                                        "entry_id": "6c11c689-14ae-348e-b60a-112514a49315",
                                        "glosses": [
                                            "To play a trump, or to take a trick with a trump."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39f37164-1dc9-34e5-ae08-2789d3607f1e",
                                        "entry_id": "6c11c689-14ae-348e-b60a-112514a49315",
                                        "glosses": [
                                            "To get the better of, or finesse, a competitor."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc4c7f46-3ffc-45bb-9b75-c506e563d27f",
                                                "sense_id": "39f37164-1dc9-34e5-ae08-2789d3607f1e",
                                                "text": "to trick or trump mankind"
                                            },
                                            {
                                                "example_id": "500730e5-1c43-4e42-bfb6-b4d41ae36866",
                                                "sense_id": "39f37164-1dc9-34e5-ae08-2789d3607f1e",
                                                "text": "Wren, who had hoped to make his name with his discovery, immediately put De Corpore aside, hoping that in silence his failure would disappear. He was forced to think again about his future and resolved to seek new territory within the New Philosophy which he could call his own, rather than face the embarrassment of being trumped for a second time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d77f86b1-30d4-3f6e-bbdb-6060f51d7cc1",
                                        "entry_id": "6c11c689-14ae-348e-b60a-112514a49315",
                                        "glosses": [
                                            "To impose unfairly; to palm off."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67019a75-ac20-4dd3-9e0f-2316088f1d6f",
                                                "sense_id": "d77f86b1-30d4-3f6e-bbdb-6060f51d7cc1",
                                                "text": "Authors have been trumped upon us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f1cdd65-fa21-3d0b-9d3c-3e3481301eac",
                                        "entry_id": "6c11c689-14ae-348e-b60a-112514a49315",
                                        "glosses": [
                                            "To supersede."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63f683a8-5e89-4a84-9434-448ff2da8ebf",
                                                "sense_id": "1f1cdd65-fa21-3d0b-9d3c-3e3481301eac",
                                                "text": "In this election, it would seem issues of national security trumped economic issues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5b1be33-c8ee-365a-aa24-1dda41a5f86d",
                                        "entry_id": "6c11c689-14ae-348e-b60a-112514a49315",
                                        "glosses": [
                                            "To outweigh; be stronger, greater, bigger than or in other way superior to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9693fc21-c0f0-347f-a1af-8a367bf059fa",
                                        "entry_id": "30af87ad-a8a5-3a4e-a13f-1042ba200f4d",
                                        "glosses": [
                                            "A trumpet."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bf66779-0dd8-48ee-8b0a-aa440bf41c32",
                                                "sense_id": "9693fc21-c0f0-347f-a1af-8a367bf059fa",
                                                "text": "In a moment, in the twinkling of an eye, at the last trump: for the trumpet shall sound, and the dead shall be raised incorruptible"
                                            },
                                            {
                                                "example_id": "a1ad6e4c-6bec-4427-8e8c-fa84150fa6d5",
                                                "sense_id": "9693fc21-c0f0-347f-a1af-8a367bf059fa",
