                    },
                    {
                        "sense_id": "e9a22998-3c45-3577-97fa-af1b93c12742",
                        "entry_id": "332a3ba0-ac23-35a9-a2ec-cb16be851789",
                        "glosses": [
                            "физ. группа из девяти частиц"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86b160a5-8216-42d7-b3c3-c768c876923c",
                                "sense_id": "e9a22998-3c45-3577-97fa-af1b93c12742",
                                "text": "Мезонные адроны с нулевым спином и отрицательной чётностью составляют группу из девяти частиц (нонет), состоящую из унитарного октета и унитарного синглета."
                            }
                        ]
                    }
                ],
