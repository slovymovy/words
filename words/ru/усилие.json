    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5d7a132-c704-3ccd-99d6-fee66a879d9f",
                    "sense_definition": "Напряжение физических или умственных сил для достижения какой-либо цели.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для достижения успеха потребовалось приложить много <w>усилий</w>.",
                            "target_lang_translations": {
                                "de": "Um Erfolg zu haben, war es nötig, viel <w>Anstrengung</w> zu investieren."
                            }
                        },
                        {
                            "text": "Он сделал <w>усилие</w> над собой и наконец встал с кровати.",
                            "target_lang_translations": {
                                "de": "Er überwand sich mit einer <w>Anstrengung</w> und stand endlich vom Bett auf."
                            }
                        }
                    ],
                    "synonyms": [
                        "напряжение"
                    ],
                    "antonyms": [
                        "расслабление",
                        "расслабленность"
                    ],
                    "common_phrases": [
                        "приложить усилия",
                        "волевое усилие"
                    ],
                    "target_lang_definitions": {
                        "de": "Anspannung körperlicher oder geistiger Kräfte, um ein Ziel zu erreichen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Anstrengung",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für den Einsatz von Energie oder Mühe."
                            },
                            {
                                "target_lang_word": "Kraftaufwand",
                                "target_lang_sense_clarification": "Betont den physischen Einsatz von Kraft."
                            },
                            {
                                "target_lang_word": "Bemühung",
                                "target_lang_sense_clarification": "Bezieht sich oft auf den Versuch oder das Bestreben, etwas zu erreichen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b663b7b-62ed-3df3-98ed-bc6decb594f1",
                    "sense_definition": "Физическое воздействие, нагрузка или давление на объект.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На балку действует постоянное механическое <w>усилие</w>.",
                            "target_lang_translations": {
                                "de": "Auf den Balken wirkt eine konstante mechanische <w>Kraft</w>."
                            }
                        },
                        {
                            "text": "Датчик измеряет <w>усилие</w> при сжатии пружины.",
                            "target_lang_translations": {
                                "de": "Der Sensor misst die <w>Kraft</w> beim Zusammendrücken der Feder."
                            }
                        }
                    ],
                    "common_phrases": [
                        "механическое усилие",
                        "измерить усилие"
                    ],
                    "target_lang_definitions": {
                        "de": "Physikalische Einwirkung, Belastung oder Druck auf ein Objekt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kraft",
                                "target_lang_sense_clarification": "Physikalischer Fachbegriff für eine Einwirkung auf einen Körper."
                            },
                            {
                                "target_lang_word": "Belastung",
                                "target_lang_sense_clarification": "Bezieht sich auf den Druck oder die mechanische Beanspruchung eines Materials."
                            }
                        ]
                    }
                }
            ]
        }
    ]
