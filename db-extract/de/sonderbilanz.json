                "senses": [
                    {
                        "sense_id": "e7527293-47cc-3aa9-a149-930c5c379171",
                        "entry_id": "96d44fc6-f439-3887-9436-6ece2106fac3",
                        "glosses": [
                            "Bilanz von Gesellschaftern einer Personengesellschaft, in der deren Sonderbetriebsvermögen bilanziert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e45217-95f3-4e5e-95ed-d19aad798359",
                                "sense_id": "e7527293-47cc-3aa9-a149-930c5c379171",
                                "text": "„Das Sonderbetriebsvermögen wird in der Sonderbilanz dargestellt, die den wirtschaftlichen Erfolg der außerhalb der Gesellschaft erbrachten Leistungen des Gesellschafters erfasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "51c6ae7d-53a0-3d89-9c8e-3df31a582452",
                        "entry_id": "96d44fc6-f439-3887-9436-6ece2106fac3",
                        "glosses": [
                            "Bilanz, die nicht regelmäßig aufgestellt wird, sondern nur einmalig oder mehrmals bei einem besonderen Anlass"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db660fc2-0d8a-4d0d-bd19-b1faa4aa2c9c",
                                "sense_id": "51c6ae7d-53a0-3d89-9c8e-3df31a582452",
                                "text": "„Ausgangsbasis für die Aufstellung dieser Sonderbilanzen ist die Jahresbilanz, sei es, dass die gesetzlichen Vorschriften hierauf verweisen, sei es, dass die Sonderbilanzen aus den Jahresbilanzen […] abgeleitet werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
