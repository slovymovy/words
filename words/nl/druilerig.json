{
    "word_family": [
        "druilen",
        "gedruil",
        "druilregen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0af7ce84-d6f2-37ed-be90-3ba7fa1fadf5",
                    "sense_definition": "gekenmerkt door aanhoudende lichte regen en een grijze, sombere lucht",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weersomstandigheden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>druilerige</w> middag in november waardoor niemand zin had om naar buiten te gaan.",
                            "target_lang_translations": {
                                "en": "It was a <w>drizzly</w> afternoon in November, which meant no one felt like going outside."
                            }
                        },
                        {
                            "text": "Ondanks het <w>druilerig</w> weer besloten we toch een korte wandeling door het bos te maken.",
                            "target_lang_translations": {
                                "en": "Despite the <w>gloomy</w> weather, we decided to take a short walk through the forest anyway."
                            }
                        }
                    ],
                    "synonyms": [
                        "regenachtig",
                        "motsig"
                    ],
                    "antonyms": [
                        "zonnig",
                        "onbewolkt"
                    ],
                    "common_phrases": [
                        "druilerig weer",
                        "druilerige dag",
                        "druilerige ochtend"
                    ],
                    "target_lang_definitions": {
                        "en": "characterized by persistent light rain and a gray, gloomy sky"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drizzly",
                                "target_lang_sense_clarification": "referring to light, steady rain"
                            },
                            {
                                "target_lang_word": "gloomy",
                                "target_lang_sense_clarification": "referring to dark and depressing weather"
                            },
                            {
                                "target_lang_word": "dreary",
                                "target_lang_sense_clarification": "referring to dull and depressing weather"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcaa4015-7f50-30b4-8541-47c0762fa94f",
                    "sense_definition": "zonder energie of enthousiasme; een lusteloze of slaperige indruk makend",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de lange vergadering keek hij met een <w>druilerige</w> blik uit het raam.",
                            "target_lang_translations": {
                                "en": "After the long meeting, he looked out the window with a <w>drowsy</w> expression."
                            }
                        },
                        {
                            "text": "Ik voel me vandaag een beetje <w>druilerig</w> en heb nergens zin in.",
                            "target_lang_translations": {
                                "en": "I feel a bit <w>listless</w> today and don't feel like doing anything."
                            }
                        }
                    ],
                    "synonyms": [
                        "lusteloos",
                        "sloom",
                        "slaperig",
                        "mat"
                    ],
                    "antonyms": [
                        "energiek",
                        "levendig"
                    ],
                    "common_phrases": [
                        "druilerig voelen",
                        "druilerige blik"
                    ],
                    "target_lang_definitions": {
                        "en": "lacking energy or enthusiasm; making a listless or sleepy impression"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drowsy",
                                "target_lang_sense_clarification": "feeling sleepy or lethargic"
                            },
                            {
                                "target_lang_word": "listless",
                                "target_lang_sense_clarification": "having no energy or spirit"
                            },
                            {
                                "target_lang_word": "sluggish",
                                "target_lang_sense_clarification": "moving or reacting more slowly than normal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}