                        ],
                        "form": "das Vordach"
                    },
                    {
                        "form_id": "05852b5c-3b66-4149-882c-c24af71d7006",
                        "entry_id": "6ba9347c-f94a-3d6d-bd85-f36573cbb6bf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Vordächer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "335500b6-e8c6-38de-9570-9256354a4760",
                        "entry_id": "6ba9347c-f94a-3d6d-bd85-f36573cbb6bf",
                        "glosses": [
                            "vorstehendes Dach, das besonders über Eingängen angebracht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe6d5174-875a-4f04-a40a-f97bc72e9bce",
                                "sense_id": "335500b6-e8c6-38de-9570-9256354a4760",
                                "text": "„Unter dem Vordach der Tankstelle steht der Peugeot nach wie vor im Wege.“"
                            },
                            {
                                "example_id": "59691dd3-3574-4238-9e8d-f096a1a350a2",
                                "sense_id": "335500b6-e8c6-38de-9570-9256354a4760",
                                "text": "„Aus den baufälligen Mauern eines Lagers der Straßenmeisterei ragte ein Vordach, in dessen Schutz im Winter Salzsäcke gestapelt wurden.“"
                            },
                            {
                                "example_id": "f5f80261-acbd-400f-b99e-0d712e005d61",
                                "sense_id": "335500b6-e8c6-38de-9570-9256354a4760",
                                "text": "„Auf dem riesigen Bildschirm unter dem Vordach der Imbissbude erklimmen die Radfahrer der Tour de France eine Serpentine.“"
                            },
                            {
                                "example_id": "b4c6641c-1989-41a4-b093-d350d9ddf8e0",
                                "sense_id": "335500b6-e8c6-38de-9570-9256354a4760",
                                "text": "„Schwere Tropfen fallen von den Vordächern, rinnen ihr in den Kragen, lassen sie erschauern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "810b843e-8c17-4701-a840-a9254dfbdd0a",
                        "source_entry_id": "6ba9347c-f94a-3d6d-bd85-f36573cbb6bf",
                        "source_sense_id": "335500b6-e8c6-38de-9570-9256354a4760",
                        "source_sense_description": "vorstehendes Dach, das besonders über Eingängen angebracht ist",
                        "target_lang_word": "auvent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auvent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4aa7a2d-7ee3-3592-b0e0-11af7b8d4d0d",
                                        "entry_id": "ca937beb-7e5d-37a8-946c-d452ac3a18ac",
                                        "glosses": [
                                            "Petit toit en saillie, aménagé ordinairement au-dessus des entrées de bâtiments, pour protéger de la pluie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e57b1106-ed7b-4a17-a392-ac79046cadb7",
                                                "sense_id": "d4aa7a2d-7ee3-3592-b0e0-11af7b8d4d0d",
                                                "text": "Il y avait beau temps, au lavoir communal ou sous les auvents d’aisseaux qu’on échangeait d’oreille à oreille de petites réflexions et qu’on se faisait part d’observations particulières."
                                            },
                                            {
                                                "example_id": "8367fe9f-4674-448d-b6d1-07d36af0b109",
                                                "sense_id": "d4aa7a2d-7ee3-3592-b0e0-11af7b8d4d0d",
                                                "text": "Comme aux très anciennes bâtisses, l’auvent du toit dévale presque jusqu'au sol, en guise de hangar."
                                            },
                                            {
                                                "example_id": "8f0a5cac-5ed8-4b23-bb8b-c5ac339c2f2f",
                                                "sense_id": "d4aa7a2d-7ee3-3592-b0e0-11af7b8d4d0d",
                                                "text": "Il prit un sac plié sur une des cages à lapins alignées sous le petit auvent fiché au flanc de la maison, et se dirigea vers la remise pour y faire provision de foin."
                                            },
                                            {
                                                "example_id": "058ed747-054c-415b-a593-1ac4a7571134",
                                                "sense_id": "d4aa7a2d-7ee3-3592-b0e0-11af7b8d4d0d",
                                                "text": "Bien protégés, les passants réfugiés en dessous des auvents transformés pour la cause en abris provisoires, contemplaient le garçon qui accélérait sa marche en maugréant du fait qu’il n’avait, pour une fois, pas emporté de parapluie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7205bed-e720-4e11-b092-615a32c38f97",
                        "source_entry_id": "6ba9347c-f94a-3d6d-bd85-f36573cbb6bf",
                        "source_sense_id": "335500b6-e8c6-38de-9570-9256354a4760",
                        "source_sense_description": "vorstehendes Dach, das besonders über Eingängen angebracht ist",
                        "target_lang_word": "avant-toit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avant-toit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13bce41d-7457-3dc2-a8bc-93702fa16dbc",
                                        "entry_id": "3582d48d-e2d8-3215-9f75-b28d957878c0",
                                        "glosses": [
                                            "Toit en saillie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25fefde6-5f25-4ca3-9fd5-fcb120b34645",
                                                "sense_id": "13bce41d-7457-3dc2-a8bc-93702fa16dbc",
                                                "text": "Sa chambre d’hôtel spacieuse, nichée sous les avant-toits de la vieille bâtisse, formait un long L, idéal pour tourner en rond fébrilement. Elle marcha du lit king size au bureau, puis au lit et ainsi de suite, caressant son ventre gonflé, le cerveau en ébullition."
                                            },
                                            {
                                                "example_id": "e8d072df-c4f1-40bd-8cc4-f6af491c8968",
                                                "sense_id": "13bce41d-7457-3dc2-a8bc-93702fa16dbc",
                                                "text": "Plus tard, Ella guetta les deux hirondelles sous les avant-toits à l’extérieur de la fenêtre afin de les observer encore de plus près à présent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
