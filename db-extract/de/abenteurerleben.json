                "senses": [
                    {
                        "sense_id": "94d623f5-50f9-32dd-bfd4-a2a15c6a3e7b",
                        "entry_id": "a7208e31-4e73-3a7c-8b0e-2d8e068bb3d0",
                        "glosses": [
                            "das Leben als ein Abenteurer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d466e69-c54a-4873-982e-5c077a45872b",
                                "sense_id": "94d623f5-50f9-32dd-bfd4-a2a15c6a3e7b",
                                "text": "„Es war ein klassisches Abenteurerleben: Nach kurzer Lehrzeit als Architekt in Wien kämpfte er im österreichischen Freiwilligen-Korps für Kaiser Maximilian, den Frankreich den Mexikanern aufgezwungen hatte, bis zu dessen Niederlage und Erschießung 1867.“"
                            },
                            {
                                "example_id": "11e51f4e-ff83-4e1a-8e95-89847022f50e",
                                "sense_id": "94d623f5-50f9-32dd-bfd4-a2a15c6a3e7b",
                                "text": "„Steve Fossett stellte in seinem Abenteurerleben mehrere hundert Weltrekorde auf und geriet schon bei zahlreichen seiner Unternehmen in Lebensgefahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
