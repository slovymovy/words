                "senses": [
                    {
                        "sense_id": "620a5870-3ec4-34d0-83b1-aa9d30265afe",
                        "entry_id": "099ac2ef-15bd-3a1c-b67b-fa772a9c622e",
                        "glosses": [
                            "книжн. крайняя печаль, горесть, тяжёлое переживание, ощущение утраты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76153580-980e-4bea-976e-38bcca0f4955",
                                "sense_id": "620a5870-3ec4-34d0-83b1-aa9d30265afe",
                                "text": "Великою скорбью народной переполнилась наша земля."
                            },
                            {
                                "example_id": "38401fab-b3bb-49e2-940d-1a393224d33c",
                                "sense_id": "620a5870-3ec4-34d0-83b1-aa9d30265afe",
                                "text": "Трудящиеся всего мира с глубочайшей скорбью провожали в могилу своего отца и учителя, лучшего друга и защитника — Ленина."
                            }
                        ]
                    },
                    {
                        "sense_id": "08618005-76b3-3995-92dd-5642243f738e",
                        "entry_id": "099ac2ef-15bd-3a1c-b67b-fa772a9c622e",
                        "glosses": [
                            "книжн., устар. горе, несчастие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bec370df-8c2e-42bf-9ed9-0182b4f7dc28",
                                "sense_id": "08618005-76b3-3995-92dd-5642243f738e",
                                "text": "Избавление от скорбей."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0bd20fb-66d2-334d-a10c-f2d479254901",
                        "entry_id": "099ac2ef-15bd-3a1c-b67b-fa772a9c622e",
                        "glosses": [
                            "рег., устар. болезнь, боль, страдание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9811571-71fa-4bd1-817e-3de5fe5ff309",
                                "sense_id": "d0bd20fb-66d2-334d-a10c-f2d479254901",
                                "text": "Не столько смертей, сколько скорбей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20b44f2f-28a5-440e-bc3e-49ea9b87a054",
                        "source_entry_id": "099ac2ef-15bd-3a1c-b67b-fa772a9c622e",
                        "target_lang_word": "Trauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "843af132-e3e6-3274-9346-7ff53c6c2387",
                                        "entry_id": "87b9744a-2d06-39d8-af1a-d4ec50ec6062",
                                        "glosses": [
                                            "Stimmungslage, die beim Verlust, insbesondere beim Tod eines geliebten Wesens auftritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25b5c650-7301-4963-9854-bb198c7a938c",
                                                "sense_id": "843af132-e3e6-3274-9346-7ff53c6c2387",
                                                "text": "Sie befindet sich in Trauer um ihre Mutter."
                                            },
                                            {
                                                "example_id": "b6e67941-d662-4666-920c-a9c96dbeb0d6",
                                                "sense_id": "843af132-e3e6-3274-9346-7ff53c6c2387",
                                                "text": "„Sadie ist vor Trauer außer sich und macht einen Skandal, als sie die offizielle Ehefrau und eine weitere Geliebte, von der Clarence zwei Kinder hat, auftauchen sieht, ganz abgesehen von mehreren Mätressen, die alle behaupten, die einzigen zu sein, die ihn je geliebt haben.“"
                                            },
                                            {
                                                "example_id": "6aff0a49-4031-4d3b-ad17-63d6f3829616",
                                                "sense_id": "843af132-e3e6-3274-9346-7ff53c6c2387",
                                                "text": "„Dieses blasse, feine, traurige Gesicht, dieser leuchtende Blick, diese sanften, graziösen Bewegungen und vor allem diese tiefe und zarte Trauer, die aus ihren Zügen sprach, das alles riss ihn aus seiner Ruhe und zwang ihn zur Teilnahme.“"
                                            },
                                            {
                                                "example_id": "a84e1568-084b-47da-9ffb-01aaeb5552a2",
                                                "sense_id": "843af132-e3e6-3274-9346-7ff53c6c2387",
                                                "text": "„Daneben steht die Haarsträhne auch für den Begriff »Trauer«; die Klageweiber lösten nämlich bei Beerdigungen ihre Haare und ließen sie als Zeichen der Trauer lose hängen.“"
                                            },
                                            {
                                                "example_id": "5951138c-0ec3-45c7-8745-35c2692bbfe4",
                                                "sense_id": "843af132-e3e6-3274-9346-7ff53c6c2387",
                                                "text": "„Die andern heuchelten keinerlei Trauer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ecec0b8-da5f-303c-bd0c-8e52fe8d48f3",
                                        "entry_id": "87b9744a-2d06-39d8-af1a-d4ec50ec6062",
                                        "glosses": [
                                            "Zeit des Trauerns nach einem Todesfall"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dc720a6d-b17b-3771-bd12-e8e06cf57501",
                                        "entry_id": "87b9744a-2d06-39d8-af1a-d4ec50ec6062",
                                        "glosses": [
                                            "die Trauerkleidung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a49d319-3229-403f-b53d-1271d4b07a9b",
                                                "sense_id": "dc720a6d-b17b-3771-bd12-e8e06cf57501",
                                                "text": "Seit dem Tod ihres Mannes trägt sie nur noch Trauer."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Trauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd7b582-5530-331c-bc67-00627353bee1",
                                        "entry_id": "ea57f6b3-629b-3028-9fd1-107c8e28dbb0",
                                        "glosses": [
                                            "ein deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e28e553-9d8a-435e-88ef-32f6acbadc96",
                                                "sense_id": "9bd7b582-5530-331c-bc67-00627353bee1",
                                                "text": "Morgen kommt Familie Trauer zu Besuch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cf53d2a-93e8-4390-a2d1-48dbbf94f751",
                        "source_entry_id": "099ac2ef-15bd-3a1c-b67b-fa772a9c622e",
                        "target_lang_word": "Gram",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gram",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ef9a86-3f6f-3db5-8341-af76883c52a2",
                                        "entry_id": "8661c269-16b0-3177-817a-6c3e446fa755",
                                        "glosses": [
                                            "tiefer Kummer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b92b0f1c-c19d-406a-aa59-f72ce06db545",
                                                "sense_id": "d3ef9a86-3f6f-3db5-8341-af76883c52a2",
                                                "text": "Nach dem Tode seiner Geliebten raffte ihn der Gram bald hinweg."
                                            },
                                            {
                                                "example_id": "59a452c8-f8dd-4b71-9de4-7011bd38e3ff",
                                                "sense_id": "d3ef9a86-3f6f-3db5-8341-af76883c52a2",
                                                "text": "„Ich hätte ihn lieber in edlen Gram versunken gesehen.“"
                                            },
                                            {
                                                "example_id": "feabe9f3-e9f3-4a6c-99c6-bc9659a01bd7",
                                                "sense_id": "d3ef9a86-3f6f-3db5-8341-af76883c52a2",
                                                "text": "„Vielleicht war sie gestorben aus Gram über den Verlust ihres einzigen Kindes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
