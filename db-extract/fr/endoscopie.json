        "fr-extract.jsonl": [
            {
                "entry_id": "89665771-8036-33f9-8bf2-0191b6777e6f",
                "word": "endoscopie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fce48f70-b9fa-447f-8bb2-c082beaab94c",
                        "entry_id": "89665771-8036-33f9-8bf2-0191b6777e6f",
                        "tags": [
                            "plural"
                        ],
                        "form": "endoscopies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee33762d-dc26-3500-aa97-3a930c3c024c",
                        "entry_id": "89665771-8036-33f9-8bf2-0191b6777e6f",
                        "glosses": [
                            "Examen réalisé avec un endoscope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f84faa-53aa-4c7d-951b-a57b37c292bb",
                                "sense_id": "ee33762d-dc26-3500-aa97-3a930c3c024c",
                                "text": "L’anesthésie. Elle est le plus souvent locale et les indications d’anesthésie générale doivent être rares en fibroscopie souple. L’endoscopie rigide par contre est réalisée sous anesthésie générale."
                            },
                            {
                                "example_id": "0004d696-60b1-48ac-878f-836d9328198e",
                                "sense_id": "ee33762d-dc26-3500-aa97-3a930c3c024c",
                                "text": "Une tumeur sous-muqueuse (TSM) est observée lors d’une endoscopie sur 300."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66e6632e-8c04-4e91-90c0-983e218b20e5",
                        "source_entry_id": "89665771-8036-33f9-8bf2-0191b6777e6f",
                        "source_sense_id": "ee33762d-dc26-3500-aa97-3a930c3c024c",
                        "target_lang_word": "Endoskopie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Endoskopie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3245232-ef65-363a-9d70-49327c83f0d4",
                                        "entry_id": "0494c7b0-a9e6-327c-911d-d03082a17fa1",
                                        "glosses": [
                                            "Verfahren, bei dem schlecht zugängliche Bereiche mit Hilfe eines Endoskops betrachtet werden"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83156aac-ebf8-4b2c-a298-8f55bfc11496",
                                                "sense_id": "d3245232-ef65-363a-9d70-49327c83f0d4",
                                                "text": "Besonders in der Luftfahrt wird die Endoskopie immer öfter für die Wartung zum Beispiel von Flugtriebwerken eingesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c8331484-daa7-322f-b40e-0c5984e23b1b",
                                        "entry_id": "0494c7b0-a9e6-327c-911d-d03082a17fa1",
                                        "glosses": [
                                            "Verfahren, bei dem Hohlorgane und Körperhöhlen mit Hilfe eines Endoskops untersucht oder Eingriffe vorgenommen werden"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "552bfc2a-feb2-4efc-b451-a7b92dd1f87e",
                                                "sense_id": "c8331484-daa7-322f-b40e-0c5984e23b1b",
                                                "text": "Die Endoskopie hatte ursprünglich in der Gastroenterologie ihre stärkste Verbreitung, mittlerweile wird sie jedoch in fast allen Teilbereichen der kurativen Medizin eingesetzt."
                                            },
                                            {
                                                "example_id": "75dedcc2-5749-4ef8-a004-b01f214796ad",
                                                "sense_id": "c8331484-daa7-322f-b40e-0c5984e23b1b",
                                                "text": "Die Endoskopie, die bei vielen Krankheiten wie der akuten Blinddarmentzündung inzwischen Routine ist, wird bei einigen gynäkologischen Tumoren bisher aber nur selten eingesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c2159c30-8740-34ad-8f94-5dc1407e930b",
                                        "entry_id": "0494c7b0-a9e6-327c-911d-d03082a17fa1",
                                        "glosses": [
                                            "der konkrete Vorgang einer Untersuchung oder Therapie mittels eines Endoskops"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f3a86fa-bc40-4f11-992d-6e834a7f01b4",
                                                "sense_id": "c2159c30-8740-34ad-8f94-5dc1407e930b",
                                                "text": "Der Patient musste eine Endoskopie über sich ergehen lassen."
                                            },
                                            {
                                                "example_id": "e51812ed-2ae9-4253-95f4-8a367d5c0a07",
                                                "sense_id": "c2159c30-8740-34ad-8f94-5dc1407e930b",
                                                "text": "Bei fast allen Endoskopien handelt es sich um geplante Eingriffe. Daher muß die uneingeschränkte Einhaltung aller erforderlichen Schutzmaßnahmen zur Infektionsverhütung verlangt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cc7fa49-060d-4b43-984e-8f60437cfc10",
                        "source_entry_id": "89665771-8036-33f9-8bf2-0191b6777e6f",
                        "source_sense_id": "ee33762d-dc26-3500-aa97-3a930c3c024c",
                        "target_lang_word": "endoscopy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endoscopy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fd995e2-3b6e-31c1-b781-a068dca6363f",
                                        "entry_id": "8002e539-3d49-34c5-88e7-bf7d2686a7c6",
                                        "glosses": [
                                            "The examination of a bodily orifice, canal or organ using an endoscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18a86044-56d1-4b27-96d5-8db3f0484885",
                                                "sense_id": "6fd995e2-3b6e-31c1-b781-a068dca6363f",
                                                "text": "But less complex scopes also pose contamination risks – and they’re used on far more people: Each year in the United States, doctors perform more than 15 million colonoscopies and 7 million endoscopies of the upper GI tract."
                                            },
                                            {
                                                "example_id": "a830661b-d70c-4180-b94a-5ef79b2d37d0",
                                                "sense_id": "6fd995e2-3b6e-31c1-b781-a068dca6363f",
                                                "text": "One insurance company, UnitedHealthcare, has announced that starting in June, members with commercial plans seeking gastroenterology endoscopy services – including colonoscopies – will be required to have “prior authorizations” for those services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
