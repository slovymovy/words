                                        "glosses": [
                                            "An arboreal gliding mammal of the family Cynocephalidae of the order Dermoptera, native to Southeast Asia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "014ead1e-8599-4b04-85a3-676fc6042088",
                                                "sense_id": "9846125e-10ed-38fe-ad6f-9b0b90e0e063",
                                                "text": "Colugos, our closest living non-primate relatives, are able to glide as much as 150 metres (more than 490 feet) between trees."
                                            }
                                        ]
                                    }
                                ]
                            }
