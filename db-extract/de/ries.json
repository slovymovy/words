                "senses": [
                    {
                        "sense_id": "b6050b3c-3832-32b7-9ebd-6a53db48cc58",
                        "entry_id": "5b9e98da-6629-3684-bf8f-f8a18efb1ac9",
                        "glosses": [
                            "eine Mengeneinheit für Papierbogen, historisch und je nach Papiersorte unterschiedlich definiert, meist 500 Bogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eabcda04-293a-471f-87c1-af5fde48b79e",
                                "sense_id": "b6050b3c-3832-32b7-9ebd-6a53db48cc58",
                                "text": "„… in den Magazinen lagerten 10761 Ries bedruckten nebst 5329 Ries unbedruckten Papiers …“"
                            },
                            {
                                "example_id": "e263590d-a58b-49d8-b5a3-1a8b449f1584",
                                "sense_id": "b6050b3c-3832-32b7-9ebd-6a53db48cc58",
                                "text": "„Ich schrieb Francia alle Sachen auf, die er mir am nächsten Tag in Cesena besorgen sollte, jedoch ohne zu feilschen: einen Ballen weiße Leinwand, fünfundzwanzig bis dreißig Ellen lang, im Wert von acht bis zehn Zechinen, Faden, Schere, Nadeln, Räucherharz, Myrrhe, Schwefel, Olivenöl, Kampfer, ein Ries Papier, Schreibfedern, Tinte, zwölf Blatt Pergament, Pinsel und einen Olivenzweig, aus dem man einen Stock von eineinhalb Fuß Länge machen könne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
