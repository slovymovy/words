                        "glosses": [
                            "Paysanne mal dégrossie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "770a5b47-8b5f-414a-ae24-14042c4f85f9",
                                "sense_id": "9a22923c-3c94-3b00-adbf-0bb5b18a3c48",
                                "text": "Dans son effroi il se remet entre les mains d’une nouvelle infirmière, une rustaude, une idiote dégourdie qui se consacre à toutes ses déficiences."
                            },
                            {
                                "example_id": "6c79a4b8-8cdf-4d54-b3eb-cea6ee5e83eb",
                                "sense_id": "9a22923c-3c94-3b00-adbf-0bb5b18a3c48",
                                "text": "Rustres et rustaudes sautaient en rond en hurlant un air de danse sauvage qu'accompagnaient faiblement deux violons et une clarinette juchés sur une grande table de cuisine en estrade."
                            }
                        ]
                    }
