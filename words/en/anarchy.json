    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2085bbf4-b4c7-38d6-985a-0338e63b71fa",
                    "sense_definition": "The state of a society being without authorities or an authoritative governing body.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "political_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The collapse of the central government led to a period of <w>anarchy</w> across the region."
                        },
                        {
                            "text": "Some political philosophers argue that a society can function effectively in a state of <w>anarchy</w>."
                        }
                    ],
                    "synonyms": [
                        "anarchism"
                    ],
                    "antonyms": [
                        "order"
                    ],
                    "common_phrases": [
                        "state of anarchy"
                    ]
                },
                {
                    "sense_id": "c8ed0f18-6f32-31b3-b59c-5bb4b53463c5",
                    "sense_definition": "A chaotic and confusing absence of any form of political authority or government.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "political_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country descended into <w>anarchy</w> following the sudden military coup."
                        },
                        {
                            "text": "Without police or laws, the city was plunged into total <w>anarchy</w>."
                        }
                    ],
                    "synonyms": [
                        "disorder"
                    ],
                    "antonyms": [
                        "order"
                    ],
                    "common_phrases": [
                        "plunged into anarchy"
                    ]
                },
                {
                    "sense_id": "598831f3-35ec-37db-bfbd-14a12c1e1c11",
                    "sense_definition": "Confusion in general; disorder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The classroom was in complete <w>anarchy</w> while the teacher was out of the room."
                        },
                        {
                            "text": "There was total <w>anarchy</w> in the store during the holiday sale."
                        }
                    ],
                    "synonyms": [
                        "disorder"
                    ],
                    "antonyms": [
                        "order"
                    ],
                    "common_phrases": [
                        "total anarchy"
                    ]
                },
                {
                    "sense_id": "db94ade1-e53a-393a-bd1a-14912f8ba123",
                    "sense_definition": "The political theory that a community is best organized by the voluntary cooperation of individuals, rather than by a government.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "political_theory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his life studying the history and development of <w>anarchy</w> as a political philosophy."
                        },
                        {
                            "text": "The group advocates for <w>anarchy</w> as a means to achieve true individual freedom."
                        }
                    ],
                    "synonyms": [
                        "anarchism"
                    ]
                }
            ]
        }
    ]
