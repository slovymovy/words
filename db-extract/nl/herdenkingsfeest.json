                    {
                        "sense_id": "50084c56-c307-3cb0-b5d8-ffb94c82fdd6",
                        "entry_id": "33b2c8ed-75fc-394c-86c6-98faf1983013",
                        "glosses": [
                            "een feest dat men viert op een bepaalde zaak of persoon te gedenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea92aa78-ed86-4410-940e-a7aa04d97079",
                                "sense_id": "50084c56-c307-3cb0-b5d8-ffb94c82fdd6",
                                "text": "Op verschillende plaatsen in Irak vieren sjiieten het Ashura-herdenkingsfeest. Tijdens dat feest wordt de dood van Hussein, kleinzoon van de profeet Mohammed, herdacht."
                            },
                            {
                                "example_id": "af2ae035-28d6-45ac-84dc-eaebe7338d91",
                                "sense_id": "50084c56-c307-3cb0-b5d8-ffb94c82fdd6",
                                "text": "Hezbollah-leider Nasrallah heeft gezegd dat zijn strijders in Syrië blijven zolang dat nodig is. Nasrallah sprak in de Libanese hoofdstad Beiroet voor een gehoor van tienduizenden sjiieten, die bijeen zijn voor het sjiitische herdenkingsfeest Ashura."
                            },
                            {
                                "example_id": "a572e958-761e-45d4-85b6-c0fc240ca93d",
                                "sense_id": "50084c56-c307-3cb0-b5d8-ffb94c82fdd6",
                                "text": "Op meer dan tweehonderdduizend schat men het aantal vrouwen en kinderen, die zich in groepen van vijfhonderd voor de muur verdrongen op 14 juni, bij gelegenheid van het feest van de eerstelingen, het Sjavoeot, dat ook het herdenkingsfeest is van de overhandiging door God van de Wetstafels aan Mozes op de berg Sinai."
                            }
                        ]
                    }
