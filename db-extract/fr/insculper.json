                "senses": [
                    {
                        "sense_id": "18c3e0a4-fe3d-363a-9746-07d96186efbc",
                        "entry_id": "f9520047-5a0d-3d58-a7dc-6666e2896f21",
                        "glosses": [
                            "Variante de insculpter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37e77d98-9ae2-40b9-a25c-6fb5d59eabe6",
                                "sense_id": "18c3e0a4-fe3d-363a-9746-07d96186efbc",
                                "text": "N’a pas longtemps que à Lyon au devant de la croix de Colle fut trouvée une lucerne de bronze antique qui me fut donnée : à laquelle estoit attachée une lame en forme de table d’attente, insculpée de lettres majuscules Latines, qui disoyent, […]."
                            },
                            {
                                "example_id": "9213d6b0-4279-4031-ad0a-109b8902f4b3",
                                "sense_id": "18c3e0a4-fe3d-363a-9746-07d96186efbc",
                                "text": "Je lui suis offert, maintenant impatiente. Elle m’attend pour insculper sa marque indélébile dans ma chair."
                            }
                        ]
                    }
                ],
