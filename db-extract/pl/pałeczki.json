                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stäbchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a06d318-9a89-36a8-b31f-9ccea00d4c5d",
                                        "entry_id": "858128b4-5a5b-31a9-9bb2-fc4fd0305b8a",
                                        "glosses": [
                                            "kleiner Stab"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72698e81-9097-4c9a-9625-aaa56f3e1923",
                                                "sense_id": "0a06d318-9a89-36a8-b31f-9ccea00d4c5d",
                                                "text": "Bei geringem Druck zerbricht das Stäbchen."
                                            },
                                            {
                                                "example_id": "702975b8-1e32-4006-8a93-564b80c3cddd",
                                                "sense_id": "0a06d318-9a89-36a8-b31f-9ccea00d4c5d",
                                                "text": "„Der Ingenieur fing an, aus dem Fischbein kleine Stäbchen zu machen und sie an den Enden anzuspitzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f9624d8-566d-3288-819e-f098ce308138",
                                        "entry_id": "858128b4-5a5b-31a9-9bb2-fc4fd0305b8a",
                                        "glosses": [
                                            "Essbesteck für asiatische Speisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "285d69b9-0ebd-4138-8535-9863af4b7c9e",
                                                "sense_id": "2f9624d8-566d-3288-819e-f098ce308138",
                                                "text": "Im Chinarestaurant isst er seine Nudeln mit Stäbchen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cff3a2fa-a59a-3bab-9efb-6e7e873c563e",
                                        "entry_id": "858128b4-5a5b-31a9-9bb2-fc4fd0305b8a",
                                        "glosses": [
                                            "Sinneszelle in der Netzhaut des Auges zum Sehen bei geringer Helligkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "411ef8aa-d9a9-4b73-a9a0-bff1d0f311e8",
                                                "sense_id": "cff3a2fa-a59a-3bab-9efb-6e7e873c563e",
                                                "text": "„Da beim Menschen nur ein Typ von Stäbchen vorhanden ist, kann sich durch die Stäbchen kein Farbeindruck ergeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d91a0479-aa91-310c-b946-398642bd8ff5",
                                        "entry_id": "858128b4-5a5b-31a9-9bb2-fc4fd0305b8a",
                                        "glosses": [
                                            "Grundmasche beim Häkeln"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "80f46331-9ec7-3f2f-a054-5b5b648b1ea3",
