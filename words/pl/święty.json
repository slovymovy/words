    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "924e483f-e099-3bd6-93d9-dd692ff0b8db",
                    "sense_definition": "związany z religią, Bogiem lub kultem; otoczony czcią religijną",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religious_cult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W kościele wiszą <w>święte</w> obrazy przedstawiające sceny biblijne.",
                            "target_lang_translations": {
                                "ru": "В церкви висят <w>святые</w> иконы, изображающие библейские сцены.",
                                "en": "In the church hang <w>sacred</w> paintings depicting biblical scenes."
                            }
                        },
                        {
                            "text": "Jerozolima jest uważana za <w>święte</w> miasto przez wyznawców trzech religii.",
                            "target_lang_translations": {
                                "ru": "Иерусалим считается <w>святым</w> городом последователями трех религий.",
                                "en": "Jerusalem is considered a <w>holy</w> city by followers of three religions."
                            }
                        }
                    ],
                    "antonyms": [
                        "świecki"
                    ],
                    "common_phrases": [
                        "Pismo Święte",
                        "Duch Święty",
                        "msza święta",
                        "Ziemia Święta"
                    ],
                    "target_lang_definitions": {
                        "ru": "связанный с религией, Богом или культом; окруженный религиозным почитанием",
                        "en": "connected with religion, God, or worship; revered in religion"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "святой",
                                "target_lang_sense_clarification": "религиозный"
                            },
                            {
                                "target_lang_word": "священный",
                                "target_lang_sense_clarification": "относящийся к культу"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "holy",
                                "target_lang_sense_clarification": "connected with God or religion"
                            },
                            {
                                "target_lang_word": "sacred",
                                "target_lang_sense_clarification": "dedicated to religious use; revered"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e315346a-d856-3504-b4a6-48aa906c9a26",
                    "sense_definition": "o osobie: uznany przez Kościół za godnego kultu, kanonizowany; żyjący w sposób doskonały religijnie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religious_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Święta</w> Cecylia jest znaną patronką muzyki kościelnej.",
                            "target_lang_translations": {
                                "ru": "<w>Святая</w> Цецилия — известная покровительница церковной музыки.",
                                "en": "<w>Saint</w> Cecilia is the famous patron saint of church music."
                            }
                        },
                        {
                            "text": "Papież ogłosił Jana Pawła II <w>świętym</w> w 2014 roku.",
                            "target_lang_translations": {
                                "ru": "Папа Римский провозгласил Иоанна Павла II <w>святым</w> в 2014 году.",
                                "en": "The Pope declared John Paul II a <w>saint</w> in 2014."
                            }
                        }
                    ],
                    "antonyms": [
                        "grzeszny"
                    ],
                    "common_phrases": [
                        "święty Mikołaj",
                        "święty patron"
                    ],
                    "target_lang_definitions": {
                        "ru": "о человеке: канонизированный Церковью, признанный достойным поклонения; живущий праведной жизнью",
                        "en": "of a person: recognized by the Church as holy, canonized; living a life of religious perfection"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "святой",
                                "target_lang_sense_clarification": "канонизированный"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "saint",
                                "target_lang_sense_clarification": "used as a title before a name (Saint)"
                            },
                            {
                                "target_lang_word": "holy",
                                "target_lang_sense_clarification": "virtuous, spiritually pure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71eb4183-a147-37e3-a53e-94152ff52ccd",
                    "sense_definition": "całkowity, zupełny; używane dla podkreślenia wagi spokoju lub cierpliwości",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emphatic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Daj mi wreszcie <w>święty</w> spokój i przestań zadawać tyle pytań.",
                            "target_lang_translations": {
                                "ru": "Оставь меня наконец в <w>полном</w> покое и перестань задавать столько вопросов.",
                                "en": "Finally leave me in <w>peace</w> and stop asking so many questions."
                            }
                        },
                        {
                            "text": "Podziwiam go, bo trzeba mieć <w>świętą</w> cierpliwość do takich klientów.",
                            "target_lang_translations": {
                                "ru": "Я восхищаюсь им, потому что нужно иметь <w>ангельское</w> терпение к таким клиентам.",
                                "en": "I admire him, because you need the patience of a <w>saint</w> for such customers."
                            }
                        }
                    ],
                    "common_phrases": [
                        "święty spokój",
                        "święta cierpliwość",
                        "święte oburzenie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane głównie w wyrażeniach idiomatycznych"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "полный, абсолютный; используется для усиления значения (обычно покоя или терпения)",
                        "en": "complete, total; used emphatically with peace or patience"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ангельский",
                                "target_lang_sense_clarification": "о терпении"
                            },
                            {
                                "target_lang_word": "святой",
                                "target_lang_sense_clarification": "в идиомах"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "абсолютный"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "peace and quiet",
                                "target_lang_sense_clarification": "in the phrase 'święty spokój'"
                            },
                            {
                                "target_lang_word": "patience of a saint",
                                "target_lang_sense_clarification": "in the phrase 'święta cierpliwość'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffd2cf57-f745-386b-b6b6-0f3a021ca473",
                    "sense_definition": "taki, którego nie wolno naruszyć ani podważyć; niezwykle ważny i szanowany",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inviolable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pamiętaj, że dla nich nawet ustna umowa jest <w>święta</w> i wiążąca.",
                            "target_lang_translations": {
                                "ru": "Помни, что для них даже устный договор <w>свят</w> и обязателен.",
                                "en": "Remember that for them, even a verbal agreement is <w>sacred</w> and binding."
                            }
                        },
                        {
                            "text": "Obrona ojczyzny to dla każdego obywatela <w>święty</w> obowiązek.",
                            "target_lang_translations": {
                                "ru": "Защита отечества — это <w>святая</w> обязанность каждого гражданина.",
                                "en": "Defending the homeland is a <w>sacred</w> duty for every citizen."
                            }
                        }
                    ],
                    "synonyms": [
                        "nietykalny",
                        "niepodważalny"
                    ],
                    "common_phrases": [
                        "święte prawo",
                        "rzecz święta",
                        "święty obowiązek"
                    ],
                    "target_lang_definitions": {
                        "ru": "такой, который нельзя нарушать или оспаривать; чрезвычайно важный и уважаемый",
                        "en": "inviolable, not to be broken or questioned; extremely important and respected"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "святой",
                                "target_lang_sense_clarification": "нерушимый"
                            },
                            {
                                "target_lang_word": "священный",
                                "target_lang_sense_clarification": "высокий, важный"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sacred",
                                "target_lang_sense_clarification": "inviolable, deeply respected"
                            },
                            {
                                "target_lang_word": "inviolable",
                                "target_lang_sense_clarification": "never to be broken or dishonored"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2904ea70-dabf-3dea-81d4-be09d45b8097",
                    "sense_definition": "niewinny, bez grzechu; często używane ironicznie o kimś, kto udaje niewinnego",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral_innocence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ty wcale nie jesteś taki <w>święty</w>, też masz swoje wady.",
                            "target_lang_translations": {
                                "ru": "Ты вовсе не такой <w>святой</w>, у тебя тоже есть свои недостатки.",
                                "en": "You are not such a <w>saint</w> at all; you have your faults too."
                            }
                        },
                        {
                            "text": "Nie udawaj <w>świętego</w>, wszyscy wiemy, że to ty zjadłeś ciastka.",
                            "target_lang_translations": {
                                "ru": "Не прикидывайся <w>святым</w>, мы все знаем, что это ты съел печенье.",
                                "en": "Don't act like a <w>saint</w>; we all know it was you who ate the cookies."
                            }
                        }
                    ],
                    "antonyms": [
                        "grzeszny",
                        "winny"
                    ],
                    "common_phrases": [
                        "udawać świętego"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często w kontekście ironicznym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "невиновный, безгрешный; часто используется иронично о ком-то, кто притворяется невинным",
                        "en": "blameless, sinless; often used ironically of someone pretending to be innocent"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "святой",
                                "target_lang_sense_clarification": "безгрешный"
                            },
                            {
                                "target_lang_word": "безгрешный",
                                "target_lang_sense_clarification": "невинный"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "saint",
                                "target_lang_sense_clarification": "morally perfect person, often ironic"
                            },
                            {
                                "target_lang_word": "innocent",
                                "target_lang_sense_clarification": "free from guilt"
                            },
                            {
                                "target_lang_word": "sinless",
                                "target_lang_sense_clarification": "pure, without fault"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2259801e-2dfc-3356-9c72-a4c749d37c07",
                    "sense_definition": "osoba kanonizowana przez Kościół, uznana za zbawioną i godną kultu religijnego",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religious_person_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielu wiernych modli się do swojego ulubionego <w>świętego</w> o pomoc.",
                            "target_lang_translations": {
                                "ru": "Многие верующие молятся своему любимому <w>святому</w> о помощи.",
                                "en": "Many faithful pray to their favorite <w>saint</w> for help."
                            }
                        },
                        {
                            "text": "Na ścianach kościoła wiszą obrazy <w>świętych</w>.",
                            "target_lang_translations": {
                                "ru": "На стенах церкви висят изображения <w>святых</w>.",
                                "en": "Paintings of <w>saints</w> hang on the church walls."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Wszystkich Świętych",
                        "obcowanie świętych",
                        "żywot świętego"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, канонизированный Церковью, признанный спасенным и достойным культа",
                        "en": "a person canonized by the Church, recognized as having reached heaven and worthy of veneration"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "святой",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "saint",
                                "target_lang_sense_clarification": "canonized person"
                            }
                        ]
                    }
                }
            ]
        },
        {
