                ],
                "senses": [
                    {
                        "sense_id": "f927d9b2-544c-3bce-9ad3-0eeb2a474694",
                        "entry_id": "f22e3a70-ee5a-3040-ab8d-ed6da3ad6455",
                        "glosses": [
                            "kobieta sceptyczna, wątpiąca, niedowierzająca"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e855f8a-c866-4c36-bd02-82a710091613",
                                "sense_id": "f927d9b2-544c-3bce-9ad3-0eeb2a474694",
                                "text": "„Bądź rozsądna – syknęła sceptyczka. – To jedyne rozwiązanie. Inaczej skończysz jak ten twój mężulek. Nie masz tych rozwiązań na pęczki, nie bądź więc głupia. Zresztą i tak jesteś”"
                            },
                            {
                                "example_id": "96d7b3fd-2aa3-4f72-bb27-f25c9c765983",
                                "sense_id": "f927d9b2-544c-3bce-9ad3-0eeb2a474694",
                                "text": "Owszem, doskonale, ale ja jestem… sceptyczka… niedowierzająca… i potrzebuję się przekonać"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db98532b-77dd-4048-9dfb-2cae8112c3b9",
                        "source_entry_id": "f22e3a70-ee5a-3040-ab8d-ed6da3ad6455",
                        "source_sense_id": "f927d9b2-544c-3bce-9ad3-0eeb2a474694",
                        "target_lang_word": "sceptique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sceptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "796c3b7e-45fa-3bff-ab51-acaeed436f16",
                                        "entry_id": "8749c681-9d1d-3832-8468-c4b6e4afd617",
                                        "glosses": [
                                            "Qualifie les philosophes qui disent qu’il n’y a rien de certain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd702c1f-06dd-45fb-91bc-f5659c8147ed",
                                                "sense_id": "796c3b7e-45fa-3bff-ab51-acaeed436f16",
                                                "text": "Pyrrhon est considéré comme l’initiateur de la philosophie sceptique."
                                            },
                                            {
                                                "example_id": "bf6e6c82-776a-4c2c-807e-dc279cef786a",
                                                "sense_id": "796c3b7e-45fa-3bff-ab51-acaeed436f16",
                                                "text": "Les philosophes sceptiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8645fb83-6d06-3248-bbdd-410ba2abe902",
                                        "entry_id": "8749c681-9d1d-3832-8468-c4b6e4afd617",
                                        "glosses": [
                                            "Qualifie les personnes qui affectent de douter de tout ce qui n’est pas prouvé d’une manière évidente, incontestable."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca61de6d-023c-4e4c-bc9c-2d83efedc2f2",
                                                "sense_id": "8645fb83-6d06-3248-bbdd-410ba2abe902",
                                                "text": "À force de rouler à travers les hommes et les pays, d’en observer les coutumes contraires, ses idées se modifièrent, et il devint sceptique."
                                            },
                                            {
                                                "example_id": "15e36dd2-65af-4c17-8b08-ac4780cd36d3",
                                                "sense_id": "8645fb83-6d06-3248-bbdd-410ba2abe902",
                                                "text": "C’est un homme, un écrivain, un esprit sceptique."
                                            },
                                            {
                                                "example_id": "028be6cb-a3cf-467b-ad05-135c748a3d39",
                                                "sense_id": "8645fb83-6d06-3248-bbdd-410ba2abe902",
                                                "text": "Être sceptique, rester sceptique : douter d’une chose."
                                            },
                                            {
                                                "example_id": "00cf56e1-c711-4570-8a47-4b19702f685e",
                                                "sense_id": "8645fb83-6d06-3248-bbdd-410ba2abe902",
                                                "text": "Cette nouvelle m’a laissé sceptique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sceptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c85b8d6a-8c39-3757-8382-d22bfc80c477",
                                        "entry_id": "a92d89df-d9b4-3b44-809a-dc8b9198f23a",
                                        "glosses": [
                                            "Personne qui doute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e8e987d-e764-40e3-8e5c-80dce6c8f795",
                                                "sense_id": "c85b8d6a-8c39-3757-8382-d22bfc80c477",
                                                "text": "Les subtilités de l’ontologie ont fait tout au plus des sceptiques ; c’est à la connaissance de la nature qu’il était réservé de faire de vrais déistes."
                                            },
                                            {
                                                "example_id": "3dd7fc5e-4a56-417a-87bc-dc82d3b40381",
                                                "sense_id": "c85b8d6a-8c39-3757-8382-d22bfc80c477",
                                                "text": "En tant que sceptiques, nous avons observé qu’en général les gens tiennent à leurs croyances pour des raisons liées à certains besoins émotionnels."
                                            },
                                            {
                                                "example_id": "b487efc8-84da-430c-8b18-a68f7b297a0f",
                                                "sense_id": "c85b8d6a-8c39-3757-8382-d22bfc80c477",
                                                "text": "Pyrrhon, bien qu’il n’en souhaitât pas, ni le contraire bien sûr, eut des disciples aux noms différents : les zététiques cherchaient la vérité sans relâche, les sceptiques examinaient tout sans jamais rien trouver, les éphectiques suspendaient leurs jugements, les aporétiques s’affirmaient incertains, y compris de leurs incertitudes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a43c9213-ca7c-34eb-ba33-314cf08e249a",
                                        "entry_id": "a92d89df-d9b4-3b44-809a-dc8b9198f23a",
                                        "glosses": [
                                            "(au féminin) Philosophie pyrrhonienne du doute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0370014e-2e8f-42ac-b8e9-04f358ecc3e2",
                                                "sense_id": "a43c9213-ca7c-34eb-ba33-314cf08e249a",
                                                "text": "Selon cela les doutes de la sceptique établiront le milieu de la vertu intellectuelle, examinant les raisons qui proposent de tous côtés, sans rien déterminer que sur le vraisemblable seulement, et avec sa suspension ordinaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
