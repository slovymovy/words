                        "cross_references": [
                            {
                                "target_word": "Infiltration",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b06260d-b064-34c4-b8f3-c579184d65d8",
                                        "entry_id": "7b9d6e99-8522-38ce-bcb3-a24f844cf153",
                                        "glosses": [
                                            "das Eindringen in feindliche Strukturen zum Spionieren und Sabotieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff66dd08-5f9e-45b8-a4ca-253eb68324a5",
                                                "sense_id": "8b06260d-b064-34c4-b8f3-c579184d65d8",
                                                "text": "„Der Sender berichtete, Damaskus fordere als Bedingung die Einstellung aller Infiltrationen durch türkische Sicherheitskräfte, einen Stopp der Ausbildung syrischer Rebellen durch die Türkei und die Aushändigung syrischer Rebellenführer, die von türkischem Gebiet aus den Aufstand in Syrien leiteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "12a4e35c-d720-3499-a88d-c53544a9e5b2",
                                        "entry_id": "7b9d6e99-8522-38ce-bcb3-a24f844cf153",
                                        "glosses": [
                                            "das Eindringen, Einströmen, Einflößen von Flüssigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d7f17bf-e48a-4729-828a-a0befee4e091",
                                                "sense_id": "12a4e35c-d720-3499-a88d-c53544a9e5b2",
                                                "text": "„Für die Simulation des Bodenwasserhaushalts nimmt die Infiltration eine Schlüsselstellung ein, da sie maßgeblich die Menge an Wasser, die dem Boden zugeführt wird, bestimmt […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7973a429-d031-3c2b-a1dd-11d776c8959b",
                                        "entry_id": "7b9d6e99-8522-38ce-bcb3-a24f844cf153",
                                        "glosses": [
                                            "dauerhafte, meist unbemerkte ideologische Beeinflussung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebf358f0-d7ee-478d-9848-8ff19d7e5986",
                                                "sense_id": "7973a429-d031-3c2b-a1dd-11d776c8959b",
                                                "text": "„Wie stark die ideologische Infiltration die Menschen tatsächlich überzeugte , war nur selten festzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1a616e0d-6ce0-3862-8e8e-404e96164dec",
                                        "entry_id": "7b9d6e99-8522-38ce-bcb3-a24f844cf153",
                                        "glosses": [
                                            "Einlagerung fremdartiger Zellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc01871e-2c23-4cc1-8dbe-ce1413646974",
                                                "sense_id": "1a616e0d-6ce0-3862-8e8e-404e96164dec",
                                                "text": "„Nach hinten werden die Infiltrate dichter und konfluieren mit einander. Um den intrakraniellen Optikus findet sich in der Pia eine zusammenhängende, nicht sehr dichte Infiltration.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
