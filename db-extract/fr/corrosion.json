                ],
                "senses": [
                    {
                        "sense_id": "ec576297-e1cc-38dd-a0cc-77f817dd2053",
                        "entry_id": "d509e94d-6c14-30fa-b33a-cfedcaef459b",
                        "glosses": [
                            "Action de corroder ou de se corroder; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6219ad2-751a-43e9-b29c-cd5489e6badf",
                                "sense_id": "ec576297-e1cc-38dd-a0cc-77f817dd2053",
                                "text": "Un appareil surdimensionné fonctionne le plus souvent au ralenti, tirage fermé. Il s’encrasse, ses émissions de polluants augmentent, et il est soumis à une forte corrosion."
                            },
                            {
                                "example_id": "6181ec1a-e1a2-4325-9577-b1b74a7fb852",
                                "sense_id": "ec576297-e1cc-38dd-a0cc-77f817dd2053",
                                "text": "Le béton armé consiste en une association dans laquelle l’élément résistant à la compression (le béton) protège contre la corrosion l’élément résistant à la traction (l’acier)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "950fc390-d2ce-444f-bee3-684b62a46274",
                        "source_entry_id": "d509e94d-6c14-30fa-b33a-cfedcaef459b",
                        "source_sense_id": "ec576297-e1cc-38dd-a0cc-77f817dd2053",
                        "target_lang_word": "Korrosion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korrosion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc8acd0a-5101-3185-98cd-5a4967f12d7b",
                                        "entry_id": "261e2fa9-3f75-35f5-b2c9-4f431174627d",
                                        "glosses": [
                                            "durch Sauerstoff bewirkte Oxidation eines Stoffes; Oxidbildung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df4fc1a-3641-42a0-b60c-31cf8a6244e3",
                                                "sense_id": "fc8acd0a-5101-3185-98cd-5a4967f12d7b",
                                                "text": "Wenn blanker Stahl keine Schutzschicht erhält, wird dieser, in kürzester Zeit, in Korrosion übergehen."
                                            },
                                            {
                                                "example_id": "5b388bcc-5131-4249-b4f4-19c2a7d30bf5",
                                                "sense_id": "fc8acd0a-5101-3185-98cd-5a4967f12d7b",
                                                "text": "Eisen möchte nicht das Produkt aus Eisenerz, Legierungen und Energie sein, sondern zerfällt mit Hilfe des Sauerstoff, bei der Korrosion, viel lieber zu Rost."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
