                },
                {
                    "sense_id": "2a24ce85-e479-3d90-98ea-1551e1a31ec5",
                    "sense_definition": "Fait d'être compromis ou mis en cause dans une affaire délictueuse, criminelle ou scandaleuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le suspect a catégoriquement nié toute <w>implication</w> dans cette affaire de vol."
