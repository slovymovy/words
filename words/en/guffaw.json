                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "laughter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group of friends <w>guffawed</w> loudly at the silly mistake.",
                            "target_lang_translations": {
                                "de": "Die Gruppe von Freunden <w>lachte schallend</w> über den dummen Fehler.",
                                "es": "El grupo de amigos <w>se rio a carcajadas</w> ruidosamente del error tan tonto."
                            }
                        },
                        {
                            "text": "He <w>guffawed</w> at the absurdity of the situation during the meeting.",
                            "target_lang_translations": {
                                "de": "Er <w>lachte schallend</w> über die Absurdität der Situation während des Meetings.",
