                "word": "Connacht",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b669292e-958b-3a6c-ab35-5b1951145d00",
                        "entry_id": "8b77ce8d-0afa-3f45-a06a-a23ec59b0a93",
                        "glosses": [
                            "Une des quatre provinces d’Irlande, qui se situe dans le nord-ouest de l’île."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3121391c-b445-4976-b03e-0d0d7e464171",
                                "sense_id": "b669292e-958b-3a6c-ab35-5b1951145d00",
                                "text": "L'Irlande, anciennement, a été divisée en cinq parties : Meath, Connacht, Ulster, Leinster et Munster."
                            },
                            {
                                "example_id": "17eaa80f-55df-4dbc-b5eb-4ce0246e8c49",
                                "sense_id": "b669292e-958b-3a6c-ab35-5b1951145d00",
                                "text": "De retour de blessure, Ultan Dillane (Connacht) et Ulupano Seuteni (UBB) étaient ménagés mais ils ont pu eux aussi courir sur la pelouse de Marcel-Deflandre."
                            }
                        ]
                    }
                ],
