                "senses": [
                    {
                        "sense_id": "773521ca-7be3-3cc7-966d-b1dc68bbc604",
                        "entry_id": "1c4a17d2-4072-3335-9f95-5b85e8d74842",
                        "glosses": [
                            "A large, extremely hard, boiled candy, typically spherical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1e0892a-9738-442a-ab98-ea70e31e0fcb",
                                "sense_id": "773521ca-7be3-3cc7-966d-b1dc68bbc604",
                                "text": "If somebody microwaves a large jawbreaker and nibbles on the outside, a crack can cause molten candy to burst out and cause painful burns. Exploding jawbreakers have been documented on television news and in police reports."
                            }
                        ]
                    },
                    {
                        "sense_id": "f646e033-8f3e-3efc-8a35-a8ed3d2e5ae7",
                        "entry_id": "1c4a17d2-4072-3335-9f95-5b85e8d74842",
                        "glosses": [
                            "A long, hard-to-pronounce word."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fba41996-2b8f-4511-aa04-1d16b9128488",
                                "sense_id": "f646e033-8f3e-3efc-8a35-a8ed3d2e5ae7",
                                "text": "The word “callipygous” is something of a jawbreaker."
                            }
                        ]
                    },
                    {
                        "sense_id": "14c2b6f2-54b6-352e-914b-0a557aaa9f8a",
                        "entry_id": "1c4a17d2-4072-3335-9f95-5b85e8d74842",
                        "glosses": [
                            "A hard blow to the side of the face."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6ee4fdac-02b2-4746-8594-235519d00235",
                                "sense_id": "14c2b6f2-54b6-352e-914b-0a557aaa9f8a",
                                "text": "Bendoff went pluckily forward, but only to receive a jawbreaker from Couper's left, […]"
                            }
                        ]
