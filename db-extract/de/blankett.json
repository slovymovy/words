                        "examples": [
                            {
                                "example_id": "205c9b53-7c52-465f-8578-87ec63c77811",
                                "sense_id": "63068cd4-6a00-39eb-825f-027c957d4f69",
                                "text": "„Als Blankett wird im Finanzwesen eine Urkunde bzw. ein Wertpapier bezeichnet, die bzw. das mit einer Blankounterschrift versehen ist, inhaltlich aber noch nicht vervollständigt wurde.“"
                            }
                        ],
