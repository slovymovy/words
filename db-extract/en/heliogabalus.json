    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3be94161-6ecd-379a-9082-7c0a18bc1df9",
                "word": "Heliogabalus",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d66fcb55-b0a3-320d-b3b1-c8cfc8b2a89f",
                        "entry_id": "3be94161-6ecd-379a-9082-7c0a18bc1df9",
                        "glosses": [
                            "Synonym of Elagabalus (“Roman emperor, noted for decadence, eccentricity, femininity, and disregard for Roman religious traditions and sexual taboos”)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdc1dee8-6be0-480a-8fd5-b01aaf78ddee",
                                "sense_id": "d66fcb55-b0a3-320d-b3b1-c8cfc8b2a89f",
                                "text": "But yet I think nobody, could he be sure that the soul of Heliogabalus were in one of his hogs, would yet say that hog were a man or Heliogabalus."
                            },
                            {
                                "example_id": "87563e89-378c-49e3-8c19-3fe3574429b7",
                                "sense_id": "d66fcb55-b0a3-320d-b3b1-c8cfc8b2a89f",
                                "text": "I spent five days in conversing with many others of the ancient learned. I saw most of the first Roman emperors. I prevailed on the governor to call up Heliogabalus's cooks to dress us a dinner, but they could not show us much of their skill, for want of materials."
                            },
                            {
                                "example_id": "24ab8649-d8bb-4f83-a1c9-7f043bdfb88f",
                                "sense_id": "d66fcb55-b0a3-320d-b3b1-c8cfc8b2a89f",
                                "text": "How pleaſed therefore will the Reader be to find, that we have, in the following Work, adhered cloſely to one of the higheſt Principles of the beſt Cook which the preſent Age, or perhaps that of Heliogabalus, hath produced. This great Man, as is well known to all polite Lovers of eating, begins at firſt by ſetting plain Things before his hungry Gueſts, riſing afterwards by Degrees, as their Stomachs may be ſuppoſed to decreaſe, to the very Quinteſſence of Sauce and Spices."
                            },
                            {
                                "example_id": "5ee85c47-4d22-4edf-8fb3-130161f9de60",
                                "sense_id": "d66fcb55-b0a3-320d-b3b1-c8cfc8b2a89f",
                                "text": "I quote in elegiacs all the crimes of Heliogabalus,"
                            }
                        ]
                    },
                    {
                        "sense_id": "5d3aa304-f686-3b69-ba42-280210012782",
                        "entry_id": "3be94161-6ecd-379a-9082-7c0a18bc1df9",
                        "glosses": [
                            "Synonym of Elagabalus (“sun deity”)."
                        ],
