                "senses": [
                    {
                        "sense_id": "874709e8-4672-33b4-8ffd-0aa1798311c1",
                        "entry_id": "d3367e30-66af-3a70-b296-91d732b17d45",
                        "glosses": [
                            "Transformer de façon anamorphique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78b4d70a-5a0a-419f-829a-ee14908ffedf",
                                "sense_id": "874709e8-4672-33b4-8ffd-0aa1798311c1",
                                "text": "Avant d'utiliser une lentille, il faut anamorphiser l'image."
                            },
                            {
                                "example_id": "2198dedf-3ff5-4875-85ee-029be2831b43",
                                "sense_id": "874709e8-4672-33b4-8ffd-0aa1798311c1",
                                "text": "Entourige permet d'envoyer, de recevoir, de déchirer, de traduire, de défraîchir, de peindre, de concevoir, d'anamorphiser, de fractaliser, de chaotiser et de rincer tous messages de type Upix normalisé."
                            },
                            {
                                "example_id": "bc75c729-a5b9-458d-9440-d94926763e93",
                                "sense_id": "874709e8-4672-33b4-8ffd-0aa1798311c1",
                                "text": "Si il était possible également d'inclure une fonction permettant d'anamorphiser les DivX afin (sur une télé 16/9eme) de ne plus être obligé de passer en mode ZOOM pour tous les films (le H&B3110 fait cela très bien et c'est super)."
                            }
                        ]
                    }
                ],
