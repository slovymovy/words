{
    "word_family": [
        "odyssean"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec196e41-4400-38f8-8902-3d9bd4bbd95f",
                    "sense_definition": "An extended adventurous voyage, usually in search of home.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "journey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers began their long <w>odyssey</w> across the uncharted wilderness.",
                            "target_lang_translations": {
                                "zh": "探险家们开始了他们穿越未知荒野的漫长<w>旅程</w>。"
                            }
                        },
                        {
                            "text": "After years of travel, the sailor finally completed his <w>odyssey</w> home.",
                            "target_lang_translations": {
                                "zh": "经过多年的漂泊，水手终于完成了他回家的<w>远征</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "journey",
                        "voyage",
                        "expedition"
                    ],
                    "common_phrases": [
                        "long odyssey",
                        "perilous odyssey"
                    ],
                    "target_lang_definitions": {
                        "zh": "一段漫长且充满冒险的旅程，通常指为了寻找归宿而进行的远行。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "漫长的旅程",
                                "target_lang_sense_clarification": "指代一段充满艰辛与冒险的长期旅行。"
                            },
                            {
                                "target_lang_word": "远征",
                                "target_lang_sense_clarification": "指为了特定目的进行的艰苦长途跋涉。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "018dffc2-7655-3143-b65c-0d327dfce884",
                    "sense_definition": "An intellectual or spiritual quest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "journey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher described his life as a constant <w>odyssey</w> for truth.",
                            "target_lang_translations": {
                                "zh": "这位哲学家将自己的一生描述为一场对真理不断的<w>求索</w>。"
                            }
                        },
                        {
                            "text": "Her personal <w>odyssey</w> led her to discover a new sense of purpose.",
                            "target_lang_translations": {
                                "zh": "她个人的精神<w>探索</w>使她发现了新的人生目标。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quest",
                        "search",
                        "pilgrimage"
                    ],
                    "common_phrases": [
                        "spiritual odyssey",
                        "intellectual odyssey"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在思想或精神层面上进行的探索与追求。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "探索",
                                "target_lang_sense_clarification": "指在精神或知识领域进行的深入追求。"
                            },
                            {
                                "target_lang_word": "求索",
                                "target_lang_sense_clarification": "指为了寻求真理或意义而进行的艰苦精神历程。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "93c6978c-ec10-3d24-9405-99445747a6a2",
                    "sense_definition": "An epic poem, ascribed to Homer, that describes the journey of Odysseus after the fall of Troy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "literature",
                    "name_type": "work_of_art_name",
                    "examples": [
                        {
                            "text": "Students are required to read the <w>Odyssey</w> in their literature class.",
                            "target_lang_translations": {
                                "zh": "学生们在文学课上被要求阅读《<w>奥德赛</w>》。"
                            }
                        },
                        {
                            "text": "The <w>Odyssey</w> remains one of the most influential works of ancient Greek literature.",
                            "target_lang_translations": {
                                "zh": "《<w>奥德赛</w>》依然是古希腊文学中最具影响力的作品之一。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "read the Odyssey"
                    ],
                    "target_lang_definitions": {
                        "zh": "古希腊史诗，相传为荷马所作，记述了奥德修斯在特洛伊战争后的归乡之旅。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "奥德赛",
                                "target_lang_sense_clarification": "指代荷马史诗《奥德赛》。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}