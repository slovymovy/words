            {
                "entry_id": "e424a05d-8ccd-3db4-bbcb-2c996687b783",
                "word": "alcène",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "05c5e856-3013-4b63-91cc-987cda4b144c",
