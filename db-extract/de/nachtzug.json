                                        "sense_id": "0db8169b-5b9e-3948-84e2-8c8b0b73765c",
                                        "entry_id": "da1c65b5-ca99-3d48-8bef-36d37b7ebe8a",
                                        "glosses": [
                                            "Train qui circule la nuit et propose des couchettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b14006d-98cf-4f96-a6a2-32b51e4bf9fa",
                                                "sense_id": "0db8169b-5b9e-3948-84e2-8c8b0b73765c",
                                                "text": "Sur grand écran, le train de nuit avait donné naissance à un sous-genre dont la dramaturgie prenait pour cadre l’atmosphère exiguë d’une couchette."
                                            },
                                            {
                                                "example_id": "934a7d36-1e3f-4ee3-931a-606b1975d41d",
                                                "sense_id": "0db8169b-5b9e-3948-84e2-8c8b0b73765c",
                                                "text": "Le réseau de trains de nuit n’a cessé de se réduire en France. Plus de subventions de l’État et des repreneurs qui se font toujours attendre."
                                            }
                                        ]
                                    }
                                ]
                            }
