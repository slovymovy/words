                "senses": [
                    {
                        "sense_id": "1e6638e1-9617-331f-bbe6-cd7eabf9b178",
                        "entry_id": "28d08915-c24c-3862-a3b9-c8d238e2a4ca",
                        "glosses": [
                            "räumliche Ausbreitung von Geruchsstoffen, deren Erfassung und Bestimmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d915e4ea-2d06-41a2-b99d-6130586635c9",
                                "sense_id": "1e6638e1-9617-331f-bbe6-cd7eabf9b178",
                                "text": "„Der Bestimmung der Geruchsausbreitung als wichtige Grundlage für die Geruchsbelästigung kommt daher eine große Aufmerksamkeit zu.“"
                            },
                            {
                                "example_id": "e9800b83-122c-4648-8033-7a77d2addd29",
                                "sense_id": "1e6638e1-9617-331f-bbe6-cd7eabf9b178",
                                "text": "„Mit Hilfe dieses Screeningmodells ist eine einfache Abschätzung des Kaltluftabflusses und der Geruchsausbreitung innerhalb der Kaltluftabflüsse für beliebige Standorte in Hessen möglich.“"
                            },
                            {
                                "example_id": "05b8bcf4-30b9-4c3b-bcee-c69c3ab25b2d",
                                "sense_id": "1e6638e1-9617-331f-bbe6-cd7eabf9b178",
                                "text": "„Ein Korrekturfaktor für die Berechnung der Konzentrationsspitzen bei Geruchsausbreitung darf maximal so hoch sein, dass die berechneten Immissionskonzentrationen nicht höher als die Emissionskonzentrationen sind.“"
                            },
                            {
                                "example_id": "8c9d39b1-8889-4a78-880e-085d96b8979d",
                                "sense_id": "1e6638e1-9617-331f-bbe6-cd7eabf9b178",
                                "text": "„Mit Blick auf ihr Geruchsimmissionspotenzial sollen sie deshalb unter der Berücksichtigung des Topographieeinflusses auf die Geruchsausbreitung untersucht und beurteilt werden.“"
                            },
                            {
                                "example_id": "8568fc20-6254-45d2-b214-3d195e4574c2",
                                "sense_id": "1e6638e1-9617-331f-bbe6-cd7eabf9b178",
                                "text": "„Diese Probleme sind so schwerwiegend, dass ein Meßsystem zur Ermittlung der Geruchsausbreitung in der Literatur oder als Patent nicht bekannt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
