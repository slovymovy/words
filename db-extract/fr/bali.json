                                "target_senses": [
                                    {
                                        "sense_id": "f4b41f0e-dfe4-3cc5-9b28-ece0daf1ffcf",
                                        "entry_id": "228e90c8-ef31-3e29-83d2-399f730a7da6",
                                        "glosses": [
                                            "A province of Indonesia, primarily made up of the island of Bali."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75ecde6a-0ae3-345d-b1e6-f3c966422491",
                                        "entry_id": "228e90c8-ef31-3e29-83d2-399f730a7da6",
                                        "glosses": [
                                            "An island of Indonesia, just east of Java."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08429b48-e451-4639-b422-6fa97378a717",
                                                "sense_id": "75ecde6a-0ae3-345d-b1e6-f3c966422491",
                                                "text": "Riding along the busy, narrow roads of Bali on her scooter with the sun illuminating her face, Victoria Kjos has a clear destination in sight — the beach."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bali",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b1f9b5d-56a0-35af-977b-50b2e0b74037",
                                        "entry_id": "5e8e014a-2264-3181-8089-fc50ca32efa3",
                                        "glosses": [
                                            "A district of New Taipei City, Taiwan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4198df22-345b-4637-9462-e5336433b5e0",
                                                "sense_id": "9b1f9b5d-56a0-35af-977b-50b2e0b74037",
                                                "text": "Forty minutes later, we found ourselves seated on boulders on the side of Kuan Yin Shan with a lovely view of the river and the town of Tamsui to the east and the farms and field of Pali to the north."
                                            },
                                            {
                                                "example_id": "fcd9e3ef-779d-41f8-8185-1dee477c357b",
                                                "sense_id": "9b1f9b5d-56a0-35af-977b-50b2e0b74037",
                                                "text": "He roused Max from his Taipei hotel suite to tell him the change in plans and to meet the Oregon at the Bali District piers the following day."
                                            },
                                            {
                                                "example_id": "db6592bf-6b6c-4172-a0e3-14ef0687b234",
                                                "sense_id": "9b1f9b5d-56a0-35af-977b-50b2e0b74037",
                                                "text": "New Taipei City’s Bali District (八里, across the river from Tamsui) isn’t a place that immediately springs to mind for tourist attractions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
