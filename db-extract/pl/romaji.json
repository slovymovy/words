                        "glosses": [
                            "zapis języka japońskiego pismem łacińskim, transkrypcja na alfabet łaciński"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7322579-40f9-455f-9e3e-810973f3c2b8",
                                "sense_id": "6e8f98e5-cf6d-36e8-9131-bdf5d5900793",
                                "text": "Pierwsze użycie romaji w Japonii datuje się co najmniej na epokę Meiji, kiedy niektórzy postulowali porzucenie skomplikowanego japońskiego systemu pisma na rzecz alfabetu łacińskiego."
