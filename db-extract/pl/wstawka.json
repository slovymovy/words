                ],
                "senses": [
                    {
                        "sense_id": "d81fd140-5c97-3c03-8d04-39628cf55c28",
                        "entry_id": "fa4e36a0-4087-3cb4-87c2-320c87454903",
                        "glosses": [
                            "element, część konstrukcji wstawione do całości"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "912f5202-6e87-4650-8e84-5878e9841c74",
                                "sense_id": "d81fd140-5c97-3c03-8d04-39628cf55c28",
                                "text": "Plemniki ssaków zbudowane są z główki, wstawki i wici."
                            },
                            {
                                "example_id": "1cef9737-4c2c-452e-898a-72736b064fdc",
                                "sense_id": "d81fd140-5c97-3c03-8d04-39628cf55c28",
                                "text": "Sporo instalacji gazowych posiada już w budynkach izolacyjne wstawki na przyłączach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "84dd8054-5816-30cd-a919-d3912a913e74",
                        "entry_id": "fa4e36a0-4087-3cb4-87c2-320c87454903",
                        "glosses": [
                            "motyw, element uzupełniający kompozycję architektoniczną, plastyczną"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad7d9b98-a912-4b58-8afb-dbcb394dbd37",
                                "sense_id": "84dd8054-5816-30cd-a919-d3912a913e74",
                                "text": "Drewniane wstawki na elewacji pełnią funkcję dekoracyjną oraz urozmaicają prostą bryłę budynku"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "d831635c-cfff-3171-bbec-17dfbbba2d31",
                        "entry_id": "fa4e36a0-4087-3cb4-87c2-320c87454903",
                        "glosses": [
                            "wyraz, tekst, partia baletowa, muzyczna, scena filmowa itp. włączone, wpisane w dany tekst literacki, w sztukę odgrywana na scenie, w film"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e378e176-e2ec-4bd7-a84b-2accf3a03f57",
                                "sense_id": "d831635c-cfff-3171-bbec-17dfbbba2d31",
                                "text": "Dłuższe wypowiedzi malowniczo trącą folklorem i zawierają ludowe wstawki gwarowe"
                            },
                            {
                                "example_id": "3161ed0d-394b-4cb3-af9a-5119f64d950d",
                                "sense_id": "d831635c-cfff-3171-bbec-17dfbbba2d31",
                                "text": "Otwarty organowym wstępem (…) przynosi porcję całkiem przyjemnego, chwytliwego gitarowego riffowania, zgrabnie uzupełnionego instrumentalną wstawką z użyciem syntezatora gitarowego"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "b368dcd6-ef80-3320-bcbd-6b375c5476e1",
                        "entry_id": "fa4e36a0-4087-3cb4-87c2-320c87454903",
                        "glosses": [
                            "element dodany do programu telewizyjnego lub radiowego o odmiennej funkcji i stylu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a0dc733-8782-456f-88e7-362142bb0172",
                                "sense_id": "b368dcd6-ef80-3320-bcbd-6b375c5476e1",
                                "text": "(…) programy telewizyjne są jak nigdy dotąd gęsto posiekane reklamami rozmaitych firm, co dodatkowo świadczy o zubożeniu właścicieli mediów, którzy bez litości faszerują każdy nadawany materiał możliwie zyskownymi wstawkami reklamowymi"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "813d9213-ae6b-301d-a5da-a6265ed4d83c",
                        "entry_id": "fa4e36a0-4087-3cb4-87c2-320c87454903",
