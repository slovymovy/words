                        "glosses": [
                            "Utilisation exagérée ou non justifiée du style gothique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14794f52-2abd-47f2-9225-9346c68425bf",
                                "sense_id": "08a878c7-2aa7-3dae-8ccd-ca7bcc64dd3f",
                                "text": "Ils étudient le passé de l’Église de Lyon, notamment en matière architecturale et liturgique, afin de fonder historiquement la « gothicomanie » du clergé de l’époque, manifestée par la construction et la restauration d’églises dans un style médiéval réinventé."
                            },
                            {
                                "example_id": "0898a143-46e0-49f8-bfa7-434730be7d4b",
                                "sense_id": "08a878c7-2aa7-3dae-8ccd-ca7bcc64dd3f",
                                "text": "Il est bien entendu que l’on se tiendrait soigneusement en garde contre la gothicomanie. Toute apparence de style ogival serait déplacée à cette hauteur, avec cet horizon, et cet entourage, et les reflets d’un passé tout romain."
                            }
                        ]
                    }
