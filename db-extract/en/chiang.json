                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39023910-2e65-4a6e-ab13-afe1c6194dfa",
                                "sense_id": "5b2e5c24-cc0b-3e43-a40d-6cf58130f565",
                                "text": "In his speech at the mass rally mentioned above, Chiang Tse-min described Teng as a loyal comrade-in-arms of Mao Tse-tung and the most prominent successor and developer of Mao Tse-tung thought. He stressed the way that both Teng and Mao formulated their policies in line with the specific situation in China. To support this argument, Chiang said that mainland China had deliberately avoided patterning its version of the market after the Western model in order to prevent the intrusion of decadent Western ideology."
                            }
                        ]
                    }
                ],
