                },
                {
                    "sense_id": "101cd6cd-4d37-3d43-8edc-1e7037909965",
                    "sense_definition": "Showing or expressing feelings of disappointment through one's appearance or voice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feeling_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a <w>disappointed</w> sigh when he saw the rain starting to fall.",
                            "target_lang_translations": {
                                "ru": "Он издал <w>разочарованный</w> вздох, когда увидел, что начинается дождь.",
                                "tr": "Yağmurun yağmaya başladığını görünce <w>hayal kırıklığı dolu</w> bir iç çekti."
                            }
                        },
                        {
                            "text": "There was a <w>disappointed</w> silence in the room after the announcement.",
                            "target_lang_translations": {
                                "ru": "После объявления в комнате повисла <w>разочарованная</w> тишина.",
                                "tr": "Açıklamadan sonra odada <w>hayal kırıklığı yaratan</w> bir sessizlik oldu."
                            }
                        }
