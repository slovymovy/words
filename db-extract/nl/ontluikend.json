                "entry_id": "c5ed0289-4f43-34ae-adea-3ca6807d8d88",
                "word": "ontluikend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ca75e27-adcb-37cc-90d2-6342971f3f21",
                        "entry_id": "c5ed0289-4f43-34ae-adea-3ca6807d8d88",
                        "glosses": [
                            "tot bloei komend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5dabb69-9406-428c-a989-b47b5c8bb4a2",
                                "sense_id": "5ca75e27-adcb-37cc-90d2-6342971f3f21",
                                "text": "Robin van Persie speelde vele Klassiekers in Amsterdam en was daarin niet vaak succesvol. Op 9 februari 2003 echter wel. Via een slim duwtje in de rug van Chivu maakte hij als negentienjarige de weg vrij voor zijn eigen gelijkmaker. Het was toch al de Klassieker van de ontluikende talenten."
                            },
                            {
                                "example_id": "4eb4c1be-375d-4949-8211-3f9578b74abd",
                                "sense_id": "5ca75e27-adcb-37cc-90d2-6342971f3f21",
                                "text": "Nadat hij een verhaal vertelt over zijn ontluikende zangcarrière, concludeert Groothuizen dat hij dan wel weet wat hij later wil worden."
                            },
                            {
                                "example_id": "3a796ea6-7488-402a-8465-053994ee9647",
                                "sense_id": "5ca75e27-adcb-37cc-90d2-6342971f3f21",
                                "text": "De temperatuur had vrijdagnacht een vrije val gemaakt en om de ontluikende knoppen in hun fruitbomen te beschermen tegen de vrieskou hadden de telers hun sproei-installaties aangezet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
