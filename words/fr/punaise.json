{
    "word_family": [
        "punaiser",
        "punaisage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f652e97-b58d-35bb-93b1-51c9b9a2cd21",
                    "sense_definition": "Petit clou court à tête large et plate, servant à fixer des feuilles de papier ou des images sur un support.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a accroché le dessin de son fils au mur avec une <w>punaise</w>."
                        },
                        {
                            "text": "Fais attention en marchant, il y a une <w>punaise</w> tombée sur la moquette."
                        }
                    ],
                    "common_phrases": [
                        "planter une punaise",
                        "enlever une punaise"
                    ]
                },
                {
                    "sense_id": "d811bb77-c1c7-3d1c-9ed0-484a3437b3a3",
                    "sense_definition": "Insecte hématophage et parasite qui s'infiltre souvent dans la literie et pique les humains durant la nuit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "insecte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les voyageurs vérifient toujours le matelas pour s'assurer qu'aucune <w>punaise</w> n'est présente."
                        },
                        {
                            "text": "Il s'est réveillé avec plusieurs boutons causés par une <w>punaise</w> cachée dans les draps."
                        }
                    ],
                    "common_phrases": [
                        "punaise de lit",
                        "piqûre de punaise"
                    ]
                },
                {
                    "sense_id": "17fc12ea-c12b-3acd-af72-e22fa4d54544",
                    "sense_definition": "Insecte au corps aplati, phytophage ou prédateur, qui dégage souvent une odeur désagréable lorsqu'il a peur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "insecte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai aperçu une <w>punaise</w> verte immobile sur une feuille de rosier."
                        },
                        {
                            "text": "Ne touche pas à cette <w>punaise</w> des bois, car son odeur est vraiment infecte."
                        }
                    ],
                    "synonyms": [
                        "hétéroptère"
                    ],
                    "common_phrases": [
                        "punaise des bois",
                        "punaise verte"
                    ]
                },
                {
                    "sense_id": "cd658c35-d56b-3516-8059-3e93da75fbb7",
                    "sense_definition": "Personne désagréable, venimeuse ou malveillante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pejoratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille <w>punaise</w> passe ses journées à médire sur l'ensemble de ses voisins."
                        },
                        {
                            "text": "Il a refusé de serrer la main à cette sale <w>punaise</w> qui l'avait calomnié."
                        }
                    ],
                    "common_phrases": [
                        "sale punaise"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "péjoratif"
                        }
                    ]
                },
                {
                    "sense_id": "ab6fc605-8a7e-3615-8734-62445b5baf48",
                    "sense_definition": "Personne très menue, frêle ou chétive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pejoratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne ne pensait qu'une si petite <w>punaise</w> pouvait montrer autant d'énergie."
                        },
                        {
                            "text": "L'adolescent était resté une minuscule <w>punaise</w> comparé à ses camarades de classe."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "179596cc-c8ea-3ad1-9025-693ee56cf675",
                    "sense_definition": "Cri ou juron familier marquant la surprise, l'admiration ou le dépit, forme atténuée de putain.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh <w>punaise</w>, j'ai complètement oublié mon rendez-vous chez le médecin !"
                        },
                        {
                            "text": "<w>Punaise</w>, la vue depuis le sommet de cette montagne est absolument magnifique !"
                        }
                    ],
                    "common_phrases": [
                        "oh punaise"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c03a44b0-6ae5-3fa3-b678-a353d1648659",
                    "sense_definition": "Première personne du singulier du présent de l'indicatif de <w>punaiser</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>punaise</w> cette note d'information sur le liège pour que chacun puisse la consulter."
                        },
                        {
                            "text": "Avant de partir en réunion, je <w>punaise</w> l'emploi du temps sur le tableau de l'entrée."
                        }
                    ],
                    "traits": [
