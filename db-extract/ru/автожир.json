                                        "glosses": [
                                            "Aéronef à voilure tournante faisant penser à un hélicoptère, mais dont le rotor n’est pas motorisé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4901e583-611f-4699-b831-beced466fcdc",
                                                "sense_id": "4740bd20-f6fc-31ef-bbc6-670a121a5b1a",
                                                "text": "Le Senor Don Juan de la Cierva a réalisé en Espagne, dès 1920, son premier autogire, le type CL, propulsé par un moteur Le Rhône de 60 CV, en utilisant un fuselage de Déperdussin, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e558abbd-c023-3702-aa60-68b09c7fe61c",
                                        "entry_id": "1fc6a8f9-f324-346a-9ab4-da9da0d842b2",
                                        "glosses": [
                                            "Girodyne dont la voilure tournante n’est pas motorisée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3648a1fb-532b-4a97-a9dc-1a8638d38dac",
                                                "sense_id": "e558abbd-c023-3702-aa60-68b09c7fe61c",
                                                "text": "Contrairement à l’hélicoptère, l’autogire ne peut pas faire de vol stationnaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
