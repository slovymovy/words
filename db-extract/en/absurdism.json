                "entry_id": "4c88a073-0b93-393a-a61a-44da65c3dc8d",
                "word": "absurdism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9988dbf7-8c50-4853-aec4-da2490112c48",
                        "entry_id": "4c88a073-0b93-393a-a61a-44da65c3dc8d",
                        "tags": [
                            "plural"
                        ],
                        "form": "absurdisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf42fdbc-adc1-3a03-ac8f-f32995cd3dfb",
                        "entry_id": "4c88a073-0b93-393a-a61a-44da65c3dc8d",
                        "glosses": [
                            "A philosophy which holds that the universe is chaotic and irrational and that any attempt to impose order will ultimately fail."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "86c1d29a-6e78-30a0-9b54-a35f48feea9b",
                        "entry_id": "4c88a073-0b93-393a-a61a-44da65c3dc8d",
                        "glosses": [
                            "Absurdity, something that is absurd"
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c19125e8-5d24-4129-8d6f-62e17246b063",
                                "sense_id": "86c1d29a-6e78-30a0-9b54-a35f48feea9b",
                                "text": "Henri Duval is a swashbuckling adventure with an absurdism straight out of Douglas Fairbanks: Siegel makes his hero a dandy who draws swords on men who insult his clothes."
                            },
                            {
                                "example_id": "aa856470-5ca2-4bd7-97e0-638a3ee39fe9",
                                "sense_id": "86c1d29a-6e78-30a0-9b54-a35f48feea9b",
                                "text": "It is a sense of irrational well-being that can seduce perfectly rational people to believe such absurdisms as “Two can live as cheaply as one…” Later (about 9 1/2 weeks) comes the rational spoilsport follow up “…for half as long.”"
                            }
                        ]
                    }
                ],
