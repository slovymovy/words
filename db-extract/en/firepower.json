                "senses": [
                    {
                        "sense_id": "a8053a62-2344-3515-993d-caacc3f640e0",
                        "entry_id": "669da3f4-10b4-348b-af49-157bad39af87",
                        "glosses": [
                            "The capacity of a weapon to deliver fire onto a target."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b6aea1bd-6d91-3fd9-ac68-fadd442d8568",
                        "entry_id": "669da3f4-10b4-348b-af49-157bad39af87",
                        "glosses": [
                            "The ability to deliver fire."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9dd47365-86a2-3de1-9c7f-ab4c0a5ec56b",
                        "entry_id": "669da3f4-10b4-348b-af49-157bad39af87",
                        "glosses": [
                            "The ability and resources to dominate."
                        ],
                        "tags": [
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "721a86bb-9650-4a74-9b72-a957a290cc73",
                                "sense_id": "9dd47365-86a2-3de1-9c7f-ab4c0a5ec56b",
                                "text": "He'd have to be on every one of his toes, because Larry Cohen, the insurance company's lawyer, would protect the doctor with every bit of legal firepower at his disposal."
                            },
                            {
                                "example_id": "c062e6e7-6fca-4345-b0eb-adf61f8c5a23",
                                "sense_id": "9dd47365-86a2-3de1-9c7f-ab4c0a5ec56b",
                                "text": "United's stature is such that one result must not bring the immediate announcement of a shift in the balance of power in Manchester - but the swathes of empty seats around Old Trafford and the wave of attacks pouring towards David de Gea's goal in the second half emphasised that City quite simply have greater firepower and talent in their squad at present."
                            },
                            {
                                "example_id": "9abad6bb-3576-4a40-bb7a-2ab13da5365c",
                                "sense_id": "9dd47365-86a2-3de1-9c7f-ab4c0a5ec56b",
                                "text": "It was not as if the Knicks were short on firepower, at least. Derrick Rose scored a season-high 30 points. He played like the point guard the Knicks surely hoped they had acquired in June."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7816ab8-77d9-4f8f-8f4f-e173b0dd3f26",
                        "source_entry_id": "669da3f4-10b4-348b-af49-157bad39af87",
