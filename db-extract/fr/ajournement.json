                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f41d93a-c460-3c53-b011-c22ea9c2405d",
                        "entry_id": "0b7bb0d3-cf70-3d5f-ad39-64a584b35e90",
                        "glosses": [
                            "Action d’ajourner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb170f9d-7762-4515-b8a5-04a25dcda4e8",
                                "sense_id": "5f41d93a-c460-3c53-b011-c22ea9c2405d",
                                "text": "Quant à l’ajournement qu'on nous recommande sous tant de différents prétextes, nous nous y attendions. Il y a deux manières de repousser une vérité : la nier, ou en ajourner l'application ; c'est une cause facile à défendre que celle des ajournements ; on a pour soi la plus invincible des puissances humaines, la force d'inertie, cette paresse des choses, des gouvernements et des peuples, […]."
                            },
                            {
                                "example_id": "9f16bf2d-ffd2-4414-b81a-389fca084b6f",
                                "sense_id": "5f41d93a-c460-3c53-b011-c22ea9c2405d",
                                "text": "Dans un contexte épidémique, la première mesure à appliquer dans les limites des possibilités du marché et des plans de gestion est l’ajournement des coupes de bois sains programmées de façon à limiter les produits d’exploitation susceptibles d’être colonisés."
                            }
                        ]
                    },
                    {
                        "sense_id": "bab1affe-e696-374d-bad4-97b84ab80f40",
                        "entry_id": "0b7bb0d3-cf70-3d5f-ad39-64a584b35e90",
                        "glosses": [
                            "Assignation ou avertissement qu’on fait donner par officier public à une personne pour qu’elle se présente devant la justice à un jour désigné."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "13e8fdbf-0263-4772-bd5e-b026519e3a06",
                                "sense_id": "bab1affe-e696-374d-bad4-97b84ab80f40",
                                "text": "Exploit d’ajournement."
                            },
                            {
                                "example_id": "8e93ea5a-3176-4a79-89d8-5f48f7505d78",
                                "sense_id": "bab1affe-e696-374d-bad4-97b84ab80f40",
                                "text": "Ajournement fait à domicile, fait à personne."
                            },
                            {
                                "example_id": "546e7037-b0a8-467f-b79b-40fe2d5ec626",
                                "sense_id": "bab1affe-e696-374d-bad4-97b84ab80f40",
                                "text": "Le délai des ajournements."
                            },
                            {
                                "example_id": "e3e1e7d8-e134-40a1-bd52-454af175b24e",
                                "sense_id": "bab1affe-e696-374d-bad4-97b84ab80f40",
                                "text": "Ajournement à quinzaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e8043cc-acc0-48ee-81c0-35478d1deb88",
                        "source_entry_id": "0b7bb0d3-cf70-3d5f-ad39-64a584b35e90",
                        "target_lang_word": "adjournment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adjournment",
