                "senses": [
                    {
                        "sense_id": "811ae0ee-bc09-3d5b-aeb9-607d4d2acbec",
                        "entry_id": "fe957d09-36d6-3763-b0b3-5b411dfe1de2",
                        "glosses": [
                            "компьютерная программа для обмена сообщениями в реальном времени через Интернет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "314c7dd8-1cef-4ba7-b02f-9284498af45d",
                                "sense_id": "811ae0ee-bc09-3d5b-aeb9-607d4d2acbec",
                                "text": "Для этого вида коммуникации необходима клиентская программа, так называемый мессенджер."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4b0b0ec-4cc9-3fc1-a475-e14c7f3eb458",
                        "entry_id": "fe957d09-36d6-3763-b0b3-5b411dfe1de2",
                        "glosses": [
                            "то же, что сумка-мессенджер; сумка для ношения через плечо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
