                        "glosses": [
                            "relativ kleines, lang gestrecktes, weißes bis farbloses Tier, das sich je nach Art von Mikroben ernährt oder parasitär lebt, indem es Pflanzen, Tiere oder Menschen befällt"
                        ],
                        "tags": [],
                        "examples": [
