                "senses": [
                    {
                        "sense_id": "8c97fe32-31e0-3601-a11d-46df4ee7f2d9",
                        "entry_id": "a364b6ff-7195-30d2-8341-5f2f328721a8",
                        "glosses": [
                            "Zauberin in der griechischen Sage; Tochter von Helios und Perse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0be0e16-f246-40af-9978-423439690c03",
                                "sense_id": "8c97fe32-31e0-3601-a11d-46df4ee7f2d9",
                                "text": "In der Sage betört Circe die Gefährten des Odysseus und verwandelt sie mithilfe eines Zaubertranks in Schweine."
                            },
                            {
                                "example_id": "b5388511-6a15-445f-b50a-de7a73f0cbb3",
                                "sense_id": "8c97fe32-31e0-3601-a11d-46df4ee7f2d9",
                                "text": "„Von oben, aus den Fenstern seiner Festung, sah er das Meer, den Golf von Gaeta, die Landschaft, in der jeder Felsen einen Mythos beherbergt: Das nahe Sperlonga, erzählte Twombly seinen Gästen gern, verdanke seinen Namen den unzähligen Natursteinhöhlen, den ‚Speluncae‘, die auch den grottendunklen deutschen Kneipen ihren Spitznamen gaben; in einer der Grotten solle der Legende nach die Circe gewohnt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
