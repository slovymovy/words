            {
                "entry_id": "3f0da0d9-d82f-336e-a939-90b1ea0c5595",
                "word": "Nintendo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bbe78d8a-6ed6-47d3-8c7c-671e629e9443",
                        "entry_id": "3f0da0d9-d82f-336e-a939-90b1ea0c5595",
                        "tags": [
                            "plural"
                        ],
                        "form": "Nintendos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27645d40-c66e-3535-9a69-b07819d23570",
                        "entry_id": "3f0da0d9-d82f-336e-a939-90b1ea0c5595",
                        "glosses": [
                            "A Nintendo Entertainment System, or other video game system made by Nintendo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb550994-66f0-4dd1-9576-4283171373c5",
                                "sense_id": "27645d40-c66e-3535-9a69-b07819d23570",
                                "text": "Wanna play on my Nintendo after school?"
                            },
                            {
                                "example_id": "c0ad60b8-89d3-4478-87c8-e4edd136fa89",
                                "sense_id": "27645d40-c66e-3535-9a69-b07819d23570",
                                "text": "There is nothing wrong with the accoutrements of personal affluence, but if the numbers of personal stereos, Nintendos, mobile phones and cars grow […]."
                            },
                            {
                                "example_id": "75836c67-7782-4345-94ca-f6c761ec1d6a",
                                "sense_id": "27645d40-c66e-3535-9a69-b07819d23570",
                                "text": "These professionals are the sort whose children play with Nintendos and own bikes"
                            },
                            {
                                "example_id": "d9676e57-1573-4344-bfe1-6e30b251c9c4",
                                "sense_id": "27645d40-c66e-3535-9a69-b07819d23570",
                                "text": "Franz: “How do elves make Nintendos?” Dad: “You ask all the hard questions, don't you? I really don't know.”"
                            },
                            {
                                "example_id": "d32e0bfd-a902-4f96-9cd5-47ce529ff08b",
                                "sense_id": "27645d40-c66e-3535-9a69-b07819d23570",
                                "text": "The only message at home was from my nephew, letting me know my mother was back home, safe and sound, except for a sore \"Nintendo thumb\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf59f519-cf9c-322f-801b-d5cd8ec3428f",
                        "entry_id": "3f0da0d9-d82f-336e-a939-90b1ea0c5595",
                        "glosses": [
                            "Any video game console, especially by those not familiar with video games."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "35ebe5a4-af60-32a9-8cbe-a3432d4fffd8",
                        "entry_id": "3f0da0d9-d82f-336e-a939-90b1ea0c5595",
                        "glosses": [
                            "Any popular product or activity."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "24b293ef-85b5-48ce-8b09-adad9ff6b050",
                                "sense_id": "35ebe5a4-af60-32a9-8cbe-a3432d4fffd8",
                                "text": "He was far more interested in bullfighting, which was the Nintendo of the day, only considerably more dangerous"
                            }
                        ]
                    }
                ],
