{
    "word_family": [
        "terminal",
        "terminaison",
        "interminable",
        "déterminer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d36fc1c7-1625-30fa-8364-cf4d40ad2309",
                    "sense_definition": "Mener à son terme une action, un ouvrage ou un travail ; achever.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_completion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants doivent <w>terminer</w> leurs devoirs avant de sortir s'amuser."
                        },
                        {
                            "text": "Nous avons <w>terminé</w> notre travail avec une heure d'avance sur l'horaire."
                        }
                    ],
                    "synonyms": [
                        "achever",
                        "boucler",
                        "finir"
                    ],
                    "antonyms": [
                        "continuer"
                    ],
                    "common_phrases": [
                        "terminer ses devoirs",
                        "terminer son travail",
                        "terminer la journée"
                    ]
                },
                {
                    "sense_id": "c7f78d80-e0ed-38de-becc-30514a8b7ede",
                    "sense_definition": "Constituer la fin ou l'aboutissement de quelque chose ; clore un ensemble.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un feu d'artifice est venu <w>terminer</w> le festival dans la joie."
                        },
                        {
                            "text": "Une phrase pleine d'espoir <w>termine</w> le dernier chapitre du roman."
                        }
                    ],
                    "synonyms": [
                        "clore",
                        "conclure"
                    ],
                    "common_phrases": [
                        "terminer un discours",
                        "terminer une discussion"
                    ]
                },
                {
                    "sense_id": "5a13380d-c416-3548-afc0-ea69d555ad41",
                    "sense_definition": "Avoir son terminus, s'arrêter définitivement au bout d'un itinéraire déterminé.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "transport_terminus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En raison de travaux sur les voies, le train <w>termine</w> exceptionnellement à Rouen."
                        },
                        {
                            "text": "Cette ligne d'autobus <w>termine</w> son trajet devant la gare maritime."
                        }
                    ]
                },
                {
                    "sense_id": "8cb3e61d-c5db-30c3-9fb0-170f02e42260",
                    "sense_definition": "Constituer la limite ou la bordure extrême dans l'espace ; borner une vue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spatial_boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une chaîne de collines verdoyantes <w>termine</w> admirablement le paysage à l'horizon."
                        },
                        {
                            "text": "Un vieux mur en pierre sèche <w>termine</w> la vue au bout du jardin."
                        }
                    ]
                }
            ]
        }
    ]
}