                                        "glosses": [
                                            "To make quiet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56e6e2b7-c844-3658-aecb-86915a9cf036",
                                        "entry_id": "7a206991-2d65-32b6-a04b-e978b08d71c9",
                                        "glosses": [
                                            "To appease; to allay; to soothe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6c3a115-f2ff-413e-93cf-3874178173f9",
                                                "sense_id": "56e6e2b7-c844-3658-aecb-86915a9cf036",
                                                "text": "VVilt thou then / Huſh my Cares thus, and ſhelter me vvith Love?"
                                            },
                                            {
                                                "example_id": "6bbcb803-117d-4c0c-89e7-5695e0636044",
                                                "sense_id": "56e6e2b7-c844-3658-aecb-86915a9cf036",
                                                "text": "And hush’d my deepest grief of all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d8d7ac-07da-3c96-8ec5-26777ca4bc93",
                                        "entry_id": "7a206991-2d65-32b6-a04b-e978b08d71c9",
                                        "glosses": [
                                            "To clear off soil and other materials overlying the bedrock."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "778214ea-2a89-32e9-81b0-d5fd3f3c36bf",
                                        "entry_id": "a6cf7179-6ce4-3561-8674-3e3c5f874155",
                                        "glosses": [
                                            "A silence, especially after some noise"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57e9db9d-2805-4fc9-af7c-47224840fb22",
                                                "sense_id": "778214ea-2a89-32e9-81b0-d5fd3f3c36bf",
                                                "text": "It is the hush of night."
                                            },
                                            {
                                                "example_id": "65c68985-1050-4f42-ac37-3c0295562840",
                                                "sense_id": "778214ea-2a89-32e9-81b0-d5fd3f3c36bf",
                                                "text": "And there fell a hush upon the gods when they saw that Māna rested, and there was silence on Pegāna save for the drumming of Skarl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef2cafd8-6bf4-3dfb-98f7-dc62b6135da3",
                                        "entry_id": "a6cf7179-6ce4-3561-8674-3e3c5f874155",
                                        "glosses": [
                                            "A mining method using water"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39544bf6-b29f-4b29-882b-7eaf2b7341c7",
                        "source_entry_id": "810ccaee-e0df-3705-b813-499e3aa11682",
                        "source_sense_id": "2a464be1-32ec-385b-865b-27232050e298",
                        "target_lang_word": "silence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                        "entry_id": "bfd0d6b4-da8d-3952-94be-4dc0780406f9",
                                        "glosses": [
                                            "The absence of any sound."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e9bcd0c-9eb5-4a42-8cc6-9c844d0617e5",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "When the motor stopped, the silence was almost deafening."
                                            },
                                            {
                                                "example_id": "55f6e3a1-ad11-465b-8d1e-32a0b17508d3",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "Words like violence break the silence / Come crashing in into my little world"
                                            },
                                            {
                                                "example_id": "f11718a4-2404-489e-9b2a-eb196fdc5117",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "deadly silence"
                                            },
                                            {
                                                "example_id": "4c778e96-2828-4717-a7f5-491620ff76b3",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "in silence"
                                            },
                                            {
                                                "example_id": "1402b33c-c922-47e2-bd6e-3316b118f6a3",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "total silence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a2ec69f-b9b4-3827-ba1b-4b5d082f3bca",
                                        "entry_id": "bfd0d6b4-da8d-3952-94be-4dc0780406f9",
                                        "glosses": [
                                            "The act of refraining from speaking."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04a4d136-34e0-4fec-a582-41819f990e2b",
                                                "sense_id": "6a2ec69f-b9b4-3827-ba1b-4b5d082f3bca",
                                                "text": "\"You have the right to silence,\" said the police officer."
                                            },
                                            {
                                                "example_id": "e38411d7-6f70-40ec-a029-1b668c373688",
                                                "sense_id": "6a2ec69f-b9b4-3827-ba1b-4b5d082f3bca",
                                                "text": "Then we relapsed into a discomfited silence, and wished we were anywhere else. But Miss Thorn relieved the situation by laughing aloud, and with such a hearty enjoyment that instead of getting angry and more mortified we began to laugh ourselves, and instantly felt better."
                                            },
                                            {
                                                "example_id": "5f8e0dcd-8df2-4fc8-90e0-9974119d6c83",
                                                "sense_id": "6a2ec69f-b9b4-3827-ba1b-4b5d082f3bca",
                                                "text": "1832, Daniel Webster, \"a convention\", quoted in The History of the Union, and of the Constitution by Charles Chauncey Burr\nThe administration itself keeps a profound silence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed8ec1e9-32ee-387d-8b3c-8788b5cfd486",
                                        "entry_id": "bfd0d6b4-da8d-3952-94be-4dc0780406f9",
                                        "glosses": [
                                            "Refraining from speaking, for purposes of prayer or meditation; especially, a form of worship practiced by the Society of Friends (Quakers) during meetings."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17096e73-6e24-4588-8f91-aab14aa09f14",
                                                "sense_id": "ed8ec1e9-32ee-387d-8b3c-8788b5cfd486",
                                                "text": "During silence a message came to me that there was that of God in every person."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8ca1bef-0bba-326b-b09d-7e6768927a71",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To make (someone or something) silent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae2e0b35-6617-4043-a25a-200d9f863d09",
                                                "sense_id": "a8ca1bef-0bba-326b-b09d-7e6768927a71",
                                                "text": "Can you silence the crowd, so we can start the show?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f2d8b6c-68c1-3d3d-9ac5-948a0b72d637",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To repress the expression of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a04f3a-f79b-43be-a841-8802eb939503",
                                                "sense_id": "4f2d8b6c-68c1-3d3d-9ac5-948a0b72d637",
                                                "text": "Women, as well as children, have their thoughts or emotions routinely silenced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4b8e26b-b630-383e-8be4-f19c5e36e999",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To suppress criticism, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d57b6d-8215-490a-8606-c89f43a97eb2",
                                                "sense_id": "f4b8e26b-b630-383e-8be4-f19c5e36e999",
                                                "text": "Silence the critics."
                                            },
                                            {
                                                "example_id": "c8d49075-a871-4704-990b-c82bb381132b",
                                                "sense_id": "f4b8e26b-b630-383e-8be4-f19c5e36e999",
                                                "text": "Silence the doubters."
                                            },
                                            {
                                                "example_id": "fadea5db-5b6e-4724-b010-18bc1ec516ce",
                                                "sense_id": "f4b8e26b-b630-383e-8be4-f19c5e36e999",
                                                "text": "A state ideology, mixing nationalism, and basic Marxist economics, going under the name \"Juche\", was constructed, and Kim Il-sung effectively silenced, disposed of and cleared away any opposition, isolating the country and exercising an iron grip on the military, the state media and the government and party organs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eddaa1e-dda3-3515-8efa-538a35bf9294",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To block gene expression."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "675239fb-397f-36c9-a893-402323f248c0",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To murder."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a563b42b-754c-460d-b62d-0122ed55464b",
                                                "sense_id": "675239fb-397f-36c9-a893-402323f248c0",
                                                "text": "They, and others through the years, believed Ruby must have acted on his own since there was no logic to the supposition that anyone could trust an uncontrollable, unreliable loudmouth like Ruby to silence Oswald."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c235d9c-32c4-3cc2-8c53-eb7d00f19d55",
                                        "entry_id": "565984bd-5465-331e-b152-f00c679e5a31",
                                        "glosses": [
                                            "Be silent."
                                        ],
                                        "tags": [
                                            "imperative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7762bc1f-2471-4b82-ae6b-0bd15df27f94",
                                                "sense_id": "6c235d9c-32c4-3cc2-8c53-eb7d00f19d55",
                                                "text": "Silence! Enough of your insolence!"
                                            },
                                            {
                                                "example_id": "628a136e-3da6-475a-a532-29daac5f5485",
                                                "sense_id": "6c235d9c-32c4-3cc2-8c53-eb7d00f19d55",
                                                "text": "(in response to laughter from the audience)\nSilence! I kill you!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "384a0558-ebc8-412b-a346-de9f5adaeb4e",
                        "source_entry_id": "810ccaee-e0df-3705-b813-499e3aa11682",
                        "source_sense_id": "2a464be1-32ec-385b-865b-27232050e298",
                        "target_lang_word": "shut up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shut up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e980016c-2f99-3612-b7f5-154ae352e4a9",
                                        "entry_id": "8400dffb-5528-3090-95fd-e05bba92b96a",
                                        "glosses": [
                                            "To close (a building) so that no one can enter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55595314-c085-37ec-bf20-13c971953d42",
                                        "entry_id": "8400dffb-5528-3090-95fd-e05bba92b96a",
                                        "glosses": [
                                            "To terminate (a business)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7140ed91-3823-33d0-99bb-8404701039f4",
                                        "entry_id": "8400dffb-5528-3090-95fd-e05bba92b96a",
                                        "glosses": [
                                            "To put (someone or something) in a secure enclosed space, such as a room or container."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ec5cfed-3d78-48b5-9829-70c072d858d3",
                                                "sense_id": "7140ed91-3823-33d0-99bb-8404701039f4",
                                                "text": "The wicked prince was shut up in the castle dungeon."
                                            },
                                            {
                                                "example_id": "f32cad7d-7355-4a02-95ab-5c8cd14727dd",
                                                "sense_id": "7140ed91-3823-33d0-99bb-8404701039f4",
                                                "text": "The engineer had shut the locomotive up in the shed for twenty years."
                                            },
                                            {
                                                "example_id": "9066e9c8-e39d-47ab-99ab-6cf1a44aa431",
                                                "sense_id": "7140ed91-3823-33d0-99bb-8404701039f4",
                                                "text": "\"You know the doctor's ways, sir,\" replied Poole, \"and how he shuts himself up. Well, he's shut up again in the cabinet; and I don't like it, sir—I wish I may die if I like it. Mr. Utterson, sir, I'm afraid.\""
                                            },
                                            {
                                                "example_id": "1313a2ca-fc64-45e1-a41b-54a6adeb1465",
                                                "sense_id": "7140ed91-3823-33d0-99bb-8404701039f4",
                                                "text": "\"Oh no, snow!\" whined Falcon Housebird to her mistress, Queeny Diamond-Heart. I'll be shut up at your house! At your mercy! With no way to get away!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a03618f4-c9ab-38ef-996c-96a5dd099ca7",
                                        "entry_id": "8400dffb-5528-3090-95fd-e05bba92b96a",
                                        "glosses": [
                                            "Of a person, to stop talking (said by someone, often one in authority, after one has said something annoying, irrelevant, or false, during a period of peace and quiet, or when one is not allowed to talk) or arguing, or (of a person or thing) making noise."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "ergative",
                                            "imperative",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3b004c5-9117-4545-b387-581f978c8eb8",
                                                "sense_id": "a03618f4-c9ab-38ef-996c-96a5dd099ca7",
                                                "text": "You are talking so loud that I can't hear the music – would you mind shutting up?"
                                            },
                                            {
                                                "example_id": "33724cee-fd75-4bb4-8ace-9dbc0eceaf27",
                                                "sense_id": "a03618f4-c9ab-38ef-996c-96a5dd099ca7",
                                                "text": "He was blathering on about something, but I managed to shut him up."
                                            },
                                            {
                                                "example_id": "ac079156-2aec-4e1e-bcce-37a9dfefcfdb",
                                                "sense_id": "a03618f4-c9ab-38ef-996c-96a5dd099ca7",
                                                "text": "She told us earlier that none of what you just said was true, so shut up!"
                                            },
                                            {
                                                "example_id": "d8f9cfbb-0aa3-4f9b-95eb-2b3ae74d4108",
                                                "sense_id": "a03618f4-c9ab-38ef-996c-96a5dd099ca7",
                                                "text": "This is a quote from the letter: \"Went to the Senate yesterday and you should have seen the carrying on they did. I could hardly get them to shut up so I could speak, and they did the same thing after I had finished. Some said the Senate never did carry on so over any president or anybody else.\""
                                            },
                                            {
                                                "example_id": "082839eb-2bdc-4399-881a-234f3b8ce940",
                                                "sense_id": "a03618f4-c9ab-38ef-996c-96a5dd099ca7",
                                                "text": "Shut up and sleep with me / Come on, why don't you sleep with me?"
                                            },
                                            {
                                                "example_id": "88ac6240-9cb7-4691-ae3f-380fad0eb05b",
                                                "sense_id": "a03618f4-c9ab-38ef-996c-96a5dd099ca7",
                                                "text": "He really doesn't know when to shut up and leave it to those at the heart of the negotiations, who fully understand and appreciate all the nuances, to try and hammer out a deal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db82a329-dc84-3572-9b50-7815bcdd73f8",
                                        "entry_id": "8400dffb-5528-3090-95fd-e05bba92b96a",
                                        "glosses": [
                                            "To murder, kill."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6192e67e-e8c3-4905-83d1-86198bd5e61b",
                                                "sense_id": "db82a329-dc84-3572-9b50-7815bcdd73f8",
                                                "text": "I just heard that your wife was trying to shut you up for the insurance money."
                                            },
                                            {
                                                "example_id": "ebde1ce0-47e8-420a-8f2a-6329c303dc2b",
                                                "sense_id": "db82a329-dc84-3572-9b50-7815bcdd73f8",
                                                "text": "Shepard: Why were they threatening you? Who do they work for?\nDr. Chloe Michel: They work for Fist. They wanted to shut me up, keep me from telling Garrus about the quarian."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shut up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2de720f-ac25-3b93-a297-86c20fab57a8",
                                        "entry_id": "129e76b2-440e-3d13-b892-e9af6670e391",
                                        "glosses": [
                                            "Closed up or off, as in a building that no one is to enter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d2cd0c8-511d-4278-ac63-e45f60d80efb",
                                                "sense_id": "e2de720f-ac25-3b93-a297-86c20fab57a8",
                                                "text": "2010. Jem (And Sam). Ferdinand Mount.\nShe did not come to Court, but she must have been taken to Montagu's house, for the Clerkenwell house was all shut up and was to be sold."
                                            },
                                            {
                                                "example_id": "587dc751-8d1f-44b6-a1fb-8b3aa7bd93db",
                                                "sense_id": "e2de720f-ac25-3b93-a297-86c20fab57a8",
                                                "text": "1865. The Wisconsin Farmer, and Northwestern Cultivator, Volume 17. Pg. 75.\nOpen sheds are too much exposed to drifting snow, and they cannot be shut up and made warm enough for early lambing."
                                            },
                                            {
                                                "example_id": "20b85dbb-d250-406c-b506-7f3cb29c23e8",
                                                "sense_id": "e2de720f-ac25-3b93-a297-86c20fab57a8",
                                                "text": "1880. An Earnest Trifler. Mary Aplin Sprague. Pg. 166.\nBeaudeck is a very shut-up place."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shut up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9683586-fb23-3b25-8f95-2f8bb773d833",
                                        "entry_id": "711aa9cd-4b2c-3046-93e2-ad4f5804a08c",
                                        "glosses": [
                                            "Stop talking (usually in the form of making annoying, irrelevant, or false comments, during a period of peace and quiet, or when one is not allowed to talk), arguing, crying, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de92b65-4790-42f9-86de-8f7b87a6fe6b",
                                                "sense_id": "e9683586-fb23-3b25-8f95-2f8bb773d833",
                                                "text": "Shut up! We're sick of your whining!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cc88546-b589-39d8-9eb0-b8a26ea1d6a8",
                                        "entry_id": "711aa9cd-4b2c-3046-93e2-ad4f5804a08c",
                                        "glosses": [
                                            "I don't believe it!, no way!"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03b53a78-dd72-4fb2-a96e-defd1107102a",
                                                "sense_id": "6cc88546-b589-39d8-9eb0-b8a26ea1d6a8",
                                                "text": "I got accepted to Yale! —Shut up, really? That's awesome!"
                                            },
                                            {
                                                "example_id": "a1c15f40-73a7-43f0-84a9-be53da98a2b9",
                                                "sense_id": "6cc88546-b589-39d8-9eb0-b8a26ea1d6a8",
                                                "text": "No, I know what home-school is, I'm not retarded! So you've actually never been to a real school before? Shut up! Shut up!"
                                            },
                                            {
                                                "example_id": "7ed344d7-b890-4d4c-9922-d836b4a34b5b",
                                                "sense_id": "6cc88546-b589-39d8-9eb0-b8a26ea1d6a8",
                                                "text": "Jen: Douglas has asked me to be his PA.\nMoss: Oh. My. God! Well, that is something and a half. His PA? How... Whoa! His PA... Shut up! His PA!\nJen: It means \"personal assistant\".\nMoss: Thank you. Right, OK. What does that actually involve?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
