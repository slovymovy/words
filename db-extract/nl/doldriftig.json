                "senses": [
                    {
                        "sense_id": "7ae2ce48-6223-3484-b8db-bb162f8dd1bc",
                        "entry_id": "97da77cc-c4eb-3a39-a657-be07880957ff",
                        "glosses": [
                            "te woest, te opgewonden, te verhit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c65c7de-3e2a-41c7-9e72-ab973ad89f38",
                                "sense_id": "7ae2ce48-6223-3484-b8db-bb162f8dd1bc",
                                "text": "De seculiere media hebben zich recent doldriftig geworpen op de ontwikkelingen bij de EO. Dan werden voorhoede en ”achterban” tegen elkaar uitgespeeld. Het is geen goed teken als de voorhoede in een goed blaadje komt te staan bij die media en de achterhoede zo ongeveer als achterlijk wordt aangemerkt."
                            },
                            {
                                "example_id": "30da5708-15c8-45e7-9f89-da33d143974e",
                                "sense_id": "7ae2ce48-6223-3484-b8db-bb162f8dd1bc",
                                "text": "Wie Psalm 59 gaat zingen, moet misschien even wennen aan de ‘sprongen’ in de eerste en de laatste regel. Verder is deze dorische melodie niet bijzonder moeilijk; vergelijkbaar met bijvoorbeeld die van Psalm 5 of 96. De onbekendheid van deze psalm zal veroorzaakt worden door de thematiek van de vervolging door „dwingelanden”, die met „wreed geweld” David „bloeddorstig” naar het leven staan en „doldriftig op de been” zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08d1c132-cce8-4220-a387-295e80be9d00",
                        "source_entry_id": "97da77cc-c4eb-3a39-a657-be07880957ff",
