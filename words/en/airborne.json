{
    "word_family": [
        "air",
        "seaborne",
        "waterborne"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b124a5f7-59ae-35d5-9b95-ddd707e737a6",
                    "sense_definition": "Moving through the air; in flight.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "flight_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy plane struggled to get <w>airborne</w> on the short runway.",
                            "target_lang_translations": {
                                "ru": "Тяжелому самолету было трудно <w>подняться в воздух</w> на короткой взлетно-посадочной полосе.",
                                "de": "Das schwere Flugzeug hatte Mühe, auf der kurzen Startbahn <w>abzuheben</w>."
                            }
                        },
                        {
                            "text": "Once the bird is <w>airborne</w>, it glides effortlessly.",
                            "target_lang_translations": {
                                "ru": "Как только птица оказывается <w>в воздухе</w>, она парит без усилий.",
                                "de": "Sobald der Vogel <w>in der Luft</w> ist, gleitet er mühelos dahin."
                            }
                        }
                    ],
                    "synonyms": [
                        "aloft",
                        "flying"
                    ],
                    "antonyms": [
                        "grounded"
                    ],
                    "common_phrases": [
                        "get airborne",
                        "become airborne",
                        "stay airborne"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в полете или движущийся по воздуху.",
                        "de": "Sich in der Luft befindend oder durch die Luft bewegend; im Flug."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "находящийся в воздухе",
                                "target_lang_sense_clarification": "общее значение состояния полета"
                            },
                            {
                                "target_lang_word": "оторвавшийся от земли",
                                "target_lang_sense_clarification": "о моменте взлета"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "in der Luft",
                                "target_lang_sense_clarification": "allgemeiner Zustand des Fliegens"
                            },
                            {
                                "target_lang_word": "abgehoben",
                                "target_lang_sense_clarification": "nach dem Startvorgang"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9fc71ee-6368-34e8-9ce7-e8899eddf0fb",
                    "sense_definition": "Carried by or spread through the air, often referring to small particles, viruses, or pollution.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "carried_by_air",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Masks are effective against many <w>airborne</w> viruses.",
                            "target_lang_translations": {
                                "ru": "Маски эффективны против многих вирусов, <w>передающихся воздушно-капельным путем</w>.",
                                "de": "Masken sind wirksam gegen viele <w>über die Luft übertragbare</w> Viren."
                            }
                        },
                        {
                            "text": "Strong winds made the desert sand <w>airborne</w>.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер поднял песок пустыни <w>в воздух</w>.",
                                "de": "Starke Winde wirbelten den Wüstensand <w>in die Luft</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "airborne virus",
                        "airborne disease",
                        "airborne particles",
                        "airborne dust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переносимый по воздуху (о частицах, вирусах или загрязнениях).",
                        "de": "Durch die Luft übertragen oder verbreitet, oft in Bezug auf kleine Partikel, Viren oder Schadstoffe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передающийся воздушно-капельным путем",
                                "target_lang_sense_clarification": "о болезнях и вирусах"
                            },
                            {
                                "target_lang_word": "переносимый по воздуху",
                                "target_lang_sense_clarification": "о пыли, пыльце или частицах"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "über die Luft übertragen",
                                "target_lang_sense_clarification": "allgemeine Übertragung durch die Luft"
                            },
                            {
                                "target_lang_word": "luftgetragen",
                                "target_lang_sense_clarification": "technischer Begriff für Partikel in der Luft"
                            },
                            {
                                "target_lang_word": "tröpfchenübertragbar",
                                "target_lang_sense_clarification": "speziell für Viren und Krankheiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b5459f0-eff5-335c-a7a1-bd7143652479",
                    "sense_definition": "Transported by aircraft, especially referring to military soldiers or units.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "military_transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>airborne</w> troops were deployed behind enemy lines.",
                            "target_lang_translations": {
                                "ru": "<w>Воздушно-десантные</w> войска были переброшены в тыл врага.",
                                "de": "Die <w>Luftlandetruppen</w> wurden hinter den feindlichen Linien abgesetzt."
                            }
                        },
                        {
                            "text": "They planned a large <w>airborne</w> operation for the morning.",
                            "target_lang_translations": {
                                "ru": "Они запланировали крупную <w>воздушно-десантную</w> операцию на утро.",
                                "de": "Sie planten eine große <w>Luftlandeoperation</w> für den Morgen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "airborne troops",
                        "airborne division",
                        "airborne assault",
                        "airborne unit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in military contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевозимый авиацией (о военных подразделениях).",
                        "de": "Durch Flugzeuge transportiert, insbesondere in Bezug auf militärische Einheiten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздушно-десантный",
                                "target_lang_sense_clarification": "военный термин"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "luftgelandet",
                                "target_lang_sense_clarification": "militärischer Fachbegriff für Truppen"
                            },
                            {
                                "target_lang_word": "luftbeweglich",
                                "target_lang_sense_clarification": "militärische Transportfähigkeit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "142a3427-ab49-37fa-9993-2a990525def8",
                    "sense_definition": "Fitted to, carried on, or operating from an aircraft.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "aircraft_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jet uses <w>airborne</w> radar to track weather patterns.",
                            "target_lang_translations": {
                                "ru": "Самолет использует <w>бортовой</w> радар для отслеживания погодных условий.",
                                "de": "Der Jet nutzt ein <w>bordgestütztes</w> Radar, um Wetterverläufe zu verfolgen."
                            }
                        },
                        {
                            "text": "Engineers tested the new <w>airborne</w> surveillance system.",
                            "target_lang_translations": {
                                "ru": "Инженеры протестировали новую <w>авиационную</w> систему наблюдения.",
                                "de": "Ingenieure testeten das neue <w>luftgestützte</w> Überwachungssystem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "airborne radar",
                        "airborne sensors"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Установленный на летательном аппарате или работающий с него.",
                        "de": "An einem Flugzeug montiert oder von einem Flugzeug aus operierend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бортовой",
                                "target_lang_sense_clarification": "об оборудовании на борту"
                            },
                            {
                                "target_lang_word": "авиационный",
                                "target_lang_sense_clarification": "относящийся к авиационной технике"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bordgestützt",
                                "target_lang_sense_clarification": "für Ausrüstung an Bord eines Flugzeugs"
                            },
                            {
                                "target_lang_word": "luftgestützt",
                                "target_lang_sense_clarification": "für Systeme, die aus der Luft operieren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fcf322a7-5c84-33b0-920f-69ceba02d196",
                    "sense_definition": "Military infantry trained to be transported by air and delivered to the battlefield by parachute or helicopter.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "military_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He served in the <w>airborne</w> for several years.",
                            "target_lang_translations": {
                                "ru": "Он прослужил в <w>воздушно-десантных войсках</w> несколько лет.",
                                "de": "Er diente mehrere Jahre bei den <w>Fallschirmjägern</w>."
                            }
                        },
                        {
                            "text": "The <w>airborne</w> landed at dawn to secure the bridge.",
                            "target_lang_translations": {
                                "ru": "<w>Десант</w> высадился на рассвете, чтобы захватить мост.",
                                "de": "Die <w>Luftlandetruppen</w> landeten im Morgengrauen, um die Brücke zu sichern."
                            }
                        }
                    ],
                    "common_phrases": [
                        "join the airborne",
                        "101st Airborne"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "military"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Воздушно-десантные войска (пехота).",
                        "de": "Militärische Infanterie, die für den Lufttransport und den Einsatz per Fallschirm oder Hubschrauber ausgebildet ist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздушно-десантные войска",
                                "target_lang_sense_clarification": "род войск"
                            },
                            {
                                "target_lang_word": "десант",
                                "target_lang_sense_clarification": "группа военных"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Fallschirmjäger",
                                "target_lang_sense_clarification": "spezifische Truppengattung"
                            },
                            {
                                "target_lang_word": "Luftlandetruppen",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung für die Einheit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}