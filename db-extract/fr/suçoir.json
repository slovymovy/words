                "senses": [
                    {
                        "sense_id": "c201a7bd-302a-30b2-9c03-5534c0bf97b7",
                        "entry_id": "84336810-df44-3ea7-b5bc-a21909af14bf",
                        "glosses": [
                            "Organe qui sert à sucer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6298b9f-783e-4495-bd1e-0767fd5c409a",
                                "sense_id": "c201a7bd-302a-30b2-9c03-5534c0bf97b7",
                                "text": "N'ayant ni aiguillon ni suçoir, il est aussi parfaitement inoffensif, sauf toutefois les légères grafignures qu'il peut produire, comme la plupart des autres coléoptères."
                            },
                            {
                                "example_id": "29dfec3b-8504-4b5f-a4ef-2814dd7df4fe",
                                "sense_id": "c201a7bd-302a-30b2-9c03-5534c0bf97b7",
                                "text": "La cigale, la punaise ont un suçoir."
                            },
                            {
                                "example_id": "01a036e3-d521-4d6a-b1f0-ca4014938109",
                                "sense_id": "c201a7bd-302a-30b2-9c03-5534c0bf97b7",
                                "text": "Les racines pompent par leurs suçoirs les sucs nourriciers dans la terre."
                            },
                            {
                                "example_id": "71247752-ce61-436a-bc92-5eaea148ae63",
                                "sense_id": "c201a7bd-302a-30b2-9c03-5534c0bf97b7",
                                "text": "Les plantes parasites comme le gui ont un suçoir ou haustorium pour absorber l'eau et les nutriments dans les vaisseaux de l'hôte."
                            }
                        ]
                    }
                ],
