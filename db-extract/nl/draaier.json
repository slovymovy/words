                    {
                        "translation_id": "6578a179-c3fe-4d85-9042-93cd35c40f31",
                        "source_entry_id": "d444c274-f50a-383b-a84e-81ed1c8599d6",
                        "source_sense_id": "72213db9-e390-3944-b299-d2e686961a9a",
                        "source_sense_description": "iemand die met een draaibank werkt",
                        "target_lang_word": "tourneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tourneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6daa19bf-1e7d-323f-a22a-a60cac721d00",
                                        "entry_id": "fef25c2c-dedf-39ae-adbf-f55f2159971b",
                                        "glosses": [
                                            "Qui tourne, tournant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a599730-6b2f-4b8c-8ab4-875dd85f711a",
                                                "sense_id": "6daa19bf-1e7d-323f-a22a-a60cac721d00",
                                                "text": "Il y a des derviches qu’on appelle derviches tourneurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tourneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed4b5766-0781-35a5-8246-ba166b9d4b10",
                                        "entry_id": "8c759cbe-ce92-30a5-b301-484a5bb57650",
                                        "glosses": [
                                            "Celui qui fait des ouvrages au tour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b386d84e-7dbd-40ca-9b1a-6254e97d25fc",
                                                "sense_id": "ed4b5766-0781-35a5-8246-ba166b9d4b10",
                                                "text": "Dans telles villes comme Orléans, Caen, Paris, la plupart des corps de métiers (boulangers, chapeliers, chaudronniers, charrons, tourneurs, vinaigriers, moutardiers, etc.) sont ouverts aux femmes."
                                            },
                                            {
                                                "example_id": "ceb85379-0804-437a-80fc-b7de1fbbf875",
                                                "sense_id": "ed4b5766-0781-35a5-8246-ba166b9d4b10",
                                                "text": "Tourneur en bois, en ivoire, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b8fb895-6475-33a8-8012-466706e52750",
                                        "entry_id": "8c759cbe-ce92-30a5-b301-484a5bb57650",
                                        "glosses": [
                                            "Il est vrai qu’un tourneur de rouet, bien enclos dans sa chaumine, qu’un rempailleur de chaises, à l’étroit dans sa cabane de roseaux, lui inspiraient la même envie : « Est il heureux, celui-là !… Voilà ce qui s’appelle un homme heureux ! » — (Alphonse de Châteaubriant, Monsieur des Lourdines, chap. 2, 1910)"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c582393e-4e11-398a-9c36-0def3d1275ee",
                                        "entry_id": "8c759cbe-ce92-30a5-b301-484a5bb57650",
                                        "glosses": [
                                            "Dans la course camarguaise, celui qui amène le taureau au raseteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdde3441-dd54-477a-b8d7-0a2df5f6d578",
                                                "sense_id": "c582393e-4e11-398a-9c36-0def3d1275ee",
                                                "text": "Dépourvu de crochet mais revêtu de la tenue blanche consacrée, chaque tourneur assiste plusieurs raseteurs qui affrontent le cocardier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d0856ac-061b-3c7b-8cb7-2e72de230845",
                                        "entry_id": "8c759cbe-ce92-30a5-b301-484a5bb57650",
                                        "glosses": [
                                            "Personne qui organise des tournées de spectacle (de musique ou de théâtre)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd083641-bba7-4ba6-b966-a2dd3a6d4480",
                                                "sense_id": "8d0856ac-061b-3c7b-8cb7-2e72de230845",
                                                "text": "Le tourneur s’adresse souvent aux promoteurs locaux pour vendre le spectacle quʼil a produit."
                                            },
                                            {
                                                "example_id": "4a75d49b-26eb-4864-ac70-7ec67e7e3d6f",
                                                "sense_id": "8d0856ac-061b-3c7b-8cb7-2e72de230845",
                                                "text": "Un regard en arrière permet de mesurer le chemin parcouru : les tourneurs français n’ont pas cessé d’importer des pièces de boulevard (...)"
                                            },
                                            {
                                                "example_id": "ff248f87-c53c-4601-ac19-bbef13d4a82d",
                                                "sense_id": "8d0856ac-061b-3c7b-8cb7-2e72de230845",
                                                "text": "Jusque-là, j’avais fait pas mal de tournées de théâtre : une courte avec Bériza, plusieurs avec le théâtre de l’Œuvre pour jouer du Crommelynck, de nombreuses et assez extravagantes avec Jean Ledrazal, tourneur plein de témérité et d’imprévu (entre autres, il achetait des pneus d’occasion au marché aux Puces et nous crevions tout le temps)."
                                            },
                                            {
                                                "example_id": "d9fdc4c6-7610-4266-b732-b299ea16877b",
                                                "sense_id": "8d0856ac-061b-3c7b-8cb7-2e72de230845",
                                                "text": "Le jour de la gloire venue, j’aurais compris qu’ils disent à leur tourneur, si ça t’ennuie pas, vieux, je préférerais ne pas jouer à Paris, c’est tous des crétins là-bas. Mais non. C’est la qualité des gens butés : ils ne sont pas rancuniers. Ou en tout cas ils ont dépassé la rancune, ils n’en sont plus là."
                                            },
                                            {
                                                "example_id": "0e7be261-71a3-4e39-bc47-e44958831ae8",
                                                "sense_id": "8d0856ac-061b-3c7b-8cb7-2e72de230845",
                                                "text": "Oh ! mais ça, tourneur, cʼest un métier. Faut avoir ça dans le sang."
                                            },
                                            {
                                                "example_id": "52f60317-7453-45ae-9cf3-0d0f8eaabc79",
                                                "sense_id": "8d0856ac-061b-3c7b-8cb7-2e72de230845",
                                                "text": "En tout cas, jʼavais tout donné, envoyé au diable notre manager et notre tourneur, franchi une étape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6e6c425-5c90-33f0-83fd-e0aeb9814386",
                                        "entry_id": "8c759cbe-ce92-30a5-b301-484a5bb57650",
                                        "glosses": [
                                            "Personne qui tournait la manivelle de la caméra."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d97583c2-9a85-35ed-ae63-a98a73599cec",
                                        "entry_id": "8c759cbe-ce92-30a5-b301-484a5bb57650",
                                        "glosses": [
                                            "Personne qui tournait, réalisait des films."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09ce5e2c-3dc0-3a2f-ba24-cc77cb8ad9a0",
                                        "entry_id": "8c759cbe-ce92-30a5-b301-484a5bb57650",
                                        "glosses": [
                                            "Poète médiocre qui tourne des vers."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cea12db1-45e6-4df4-b5b2-030d9e8a0dbc",
                                                "sense_id": "09ce5e2c-3dc0-3a2f-ba24-cc77cb8ad9a0",
                                                "text": "Loti répète au sujet d’Aicard, qu’il croit son ami : « C’est un sentimental. » Or je sais, et pertinemment, qu’il n’y eut jamais plus sec et dur, en son privé, que ce tourneur de vers de mirliton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
