                ],
                "senses": [
                    {
                        "sense_id": "6bb699e7-a115-3141-83e3-05fa4b94411d",
                        "entry_id": "e882f1fb-9ed3-3f75-ab0a-7d03a633a72e",
                        "glosses": [
                            "Alternative letter-case form of unitarian: any Christian who denies the doctrine of the Trinity."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "719b1b62-b25e-4304-90af-a29dc4e0c057",
                                "sense_id": "6bb699e7-a115-3141-83e3-05fa4b94411d",
                                "text": "But since Smith's ( of Norwich ) Bill passed , in 1813 , relieving Unitarians, as a religious sect, from the operation of the old law"
                            }
                        ]
                    },
                    {
                        "sense_id": "39125c34-890b-3b60-b4ba-a44edb46cafb",
                        "entry_id": "e882f1fb-9ed3-3f75-ab0a-7d03a633a72e",
                        "glosses": [
                            "A follower of Unitarian Universalism or a similar non-credal religion that originated historically from Christian Unitarianism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3006005d-a5bf-4da0-8b45-f189435274f3",
                                "sense_id": "39125c34-890b-3b60-b4ba-a44edb46cafb",
                                "text": "The Unitarians never kneel. But I want to kneel."
                            }
                        ]
                    },
                    {
                        "sense_id": "27a4c02f-d4e6-3e87-86cf-dbd67cb108ab",
                        "entry_id": "e882f1fb-9ed3-3f75-ab0a-7d03a633a72e",
                        "glosses": [
                            "Alternative letter-case form of unitarian: any monotheist, particularly non-Christian monotheists (Muslims, Jews, etc.) as discussed from a Christian perspective."
