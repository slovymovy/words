                ],
                "senses": [
                    {
                        "sense_id": "d2564ae1-2f93-3bd6-abe1-7cd5dad1d244",
                        "entry_id": "786546d7-c257-3450-b1d1-b0e8a1c33aa4",
                        "glosses": [
                            "unter der Erdoberfläche versteckte Mine, die meist durch Berührung ausgelöst wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "858e1fbe-17ab-4b62-b8c0-e67f2331a6cf",
                                "sense_id": "d2564ae1-2f93-3bd6-abe1-7cd5dad1d244",
                                "text": "„Es ist möglich Landminen zu entdecken, indem man Schallwellen auf das Minengebiet richtet, welche die Landminen zum Vibrieren bringen.“"
                            },
                            {
                                "example_id": "068e6f48-ea5e-4a99-bc3b-89d8b67ad1fa",
                                "sense_id": "d2564ae1-2f93-3bd6-abe1-7cd5dad1d244",
                                "text": "„Obwohl kurz nach ihrer Ankunft der Waffenstillstand unterzeichnet wurde, lagen überall noch Landminen, und der Hass auf beiden Seiten loderte weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e5d15c7-e643-462e-b063-6e256884364a",
                        "source_entry_id": "786546d7-c257-3450-b1d1-b0e8a1c33aa4",
                        "source_sense_id": "d2564ae1-2f93-3bd6-abe1-7cd5dad1d244",
                        "source_sense_description": "unter der Erdoberfläche versteckte Mine, die meist durch Berührung ausgelöst wird",
                        "target_lang_word": "land mine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "land mine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "631cbf53-0c2a-39aa-a66c-f6fc9e76e55e",
                                        "entry_id": "00b32a4f-1744-3734-91b1-5226181069eb",
                                        "glosses": [
                                            "A mine that is placed on land and designed to explode when stepped upon or touched."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f599e3c5-cc7c-4711-a9b6-a636f8c7540f",
                                                "sense_id": "631cbf53-0c2a-39aa-a66c-f6fc9e76e55e",
                                                "text": "With the cessation of hostilities, the military traffic declined considerably, although at least two years will be required to remove the many thousands of tons of explosives still stored at the depot. The supplies of mustard gas have already been despatched to Stranraer to be dumped in the sea, and the disposal of ¾-million land mines has called for the provision of 17 special trains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dce11a3-5837-3615-a0e6-a8804cc48c39",
                                        "entry_id": "00b32a4f-1744-3734-91b1-5226181069eb",
                                        "glosses": [
                                            "A critical subject or situation with concealed or unpredictable implications."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afc5249d-d778-4934-bf78-17a537d221c8",
                                                "sense_id": "6dce11a3-5837-3615-a0e6-a8804cc48c39",
                                                "text": "Johnson is expected to make a decision within weeks on the future of the 250mph Y-shaped rail network, which would link Birmingham, Manchester and Leeds but has grown into a vexed political issue since it was floated in 2009. He postponed a decision in November, a move widely viewed as a means of avoiding a political landmine in the run-up to the election."
                                            },
                                            {
                                                "example_id": "5dea9e0e-0936-486e-ac48-dd072230738e",
                                                "sense_id": "6dce11a3-5837-3615-a0e6-a8804cc48c39",
                                                "text": "He said conversations are dressed up in language about the educational value or inherent beauty of the remains — what he called a clear ploy to divert attention from the ethical land mine that is owning a piece of a deceased person."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "853ce7ff-dfeb-3fbc-99b0-c509a43f29ad",
                                        "entry_id": "00b32a4f-1744-3734-91b1-5226181069eb",
                                        "glosses": [
                                            "A piece of exercise device consisting of a pivoting tube attached to the ground to which a barbell can be fitted to lift it off the ground."
                                        ],
                                        "tags": [
                                            "from a Landmine™ developed in 1999 by a US company called Sorinex"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
