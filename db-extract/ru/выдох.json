                "senses": [
                    {
                        "sense_id": "276fb22a-fb48-3c98-b312-6c997b105799",
                        "entry_id": "b663e5c1-0871-3529-a418-18cf93106c3f",
                        "glosses": [
                            "одно отдельное выталкивание воздуха из лёгких при дыхании"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc0e8dba-6de5-4596-a32b-9fb9ccd15032",
                                "sense_id": "276fb22a-fb48-3c98-b312-6c997b105799",
                                "text": "Хотелось вздохнуть громко, всей грудью, а приходилось цедить выдох, как сквозь сито, и сердце от этого никак не хотело успокаиваться."
                            },
                            {
                                "example_id": "b7745bfa-d3ff-4774-9252-67cdd4de5e0b",
                                "sense_id": "276fb22a-fb48-3c98-b312-6c997b105799",
                                "text": "Сказав последние слова, он смолк, опустил незрячие очи, наслаждаясь горькими и счастливыми выдохами своих слушательниц."
                            },
                            {
                                "example_id": "259b6156-cf43-49a7-b543-b1feb2700d55",
                                "sense_id": "276fb22a-fb48-3c98-b312-6c997b105799",
                                "text": "В организме будет недостаток кислорода и одновременно большое накопление углекислоты, которая перестанет выделяться при выдохе."
                            }
                        ]
                    }
                ],
