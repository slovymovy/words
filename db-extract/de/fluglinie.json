                "senses": [
                    {
                        "sense_id": "0013a6a1-5817-3343-87f8-cda70a89dbe2",
                        "entry_id": "975881d1-1d2a-3752-ba97-212117beeae2",
                        "glosses": [
                            "Unternehmen, das Flugverkehr betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92cc2401-9c30-4bf4-9dfb-3224fe9b0341",
                                "sense_id": "0013a6a1-5817-3343-87f8-cda70a89dbe2",
                                "text": "„Die Fluglinie Finnair führte 2012 die Liste der sichersten Fluglinien an.“"
                            },
                            {
                                "example_id": "73e99d48-7525-49ce-befb-239073dac95e",
                                "sense_id": "0013a6a1-5817-3343-87f8-cda70a89dbe2",
                                "text": "„Das Hotel, in dem uns die Fluglinie unterbrachte, war schäbig.“"
                            },
                            {
                                "example_id": "588681bd-9bdd-4642-8699-431e93054fb1",
                                "sense_id": "0013a6a1-5817-3343-87f8-cda70a89dbe2",
                                "text": "„Nur die Reichen und Mächtigen unter den Flüchtlingen hatten einen legalen oder illegalen Zugang zu dieser Fluglinie, was zugleich bedeutete, dass sie mit ihrer Anreise aus der Luft ihre Asylchancen erhöhten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c322e827-569f-3b40-9c98-5f458f3e44a5",
                        "entry_id": "975881d1-1d2a-3752-ba97-212117beeae2",
                        "glosses": [
                            "Strecke, die regelmäßig beflogen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3968ec1c-74d0-4d4c-aca4-b769ed2890ff",
                                "sense_id": "c322e827-569f-3b40-9c98-5f458f3e44a5",
                                "text": "Heute wird die neue Fluglinie nach New York endlich eröffnet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0aca24d4-8584-4f73-b35e-cce6116bd97e",
                        "source_entry_id": "975881d1-1d2a-3752-ba97-212117beeae2",
                        "source_sense_id": "0013a6a1-5817-3343-87f8-cda70a89dbe2",
                        "source_sense_description": "Unternehmen, das Flugverkehr betreibt",
                        "target_lang_word": "airline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d232287-544e-36d6-9496-b29d625f21ba",
                                        "entry_id": "04eba686-609d-3239-8257-3f5909dd4d62",
                                        "glosses": [
                                            "A company that flies airplanes to transport people and goods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eefad38-d99e-4f75-ae56-1272f1b5f356",
                                                "sense_id": "9d232287-544e-36d6-9496-b29d625f21ba",
                                                "text": "But already there are some commercial air­lines in the United States which use airplanes cap­able of more than 200 miles an hour."
                                            },
                                            {
                                                "example_id": "e70ea5cb-89f1-4c82-b29a-6b72478702af",
                                                "sense_id": "9d232287-544e-36d6-9496-b29d625f21ba",
                                                "text": "They and the airline itself described an internal process that requires multiple departments to manually redesign the airline’s schedule – a system that works “the vast majority of the time,” Southwest said in a statement. […] Other airlines managed to recover by early this week; at Southwest, the cancellations only increased."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1200fbf1-12ef-4c06-8019-b48e424d5772",
                        "source_entry_id": "975881d1-1d2a-3752-ba97-212117beeae2",
                        "source_sense_id": "0013a6a1-5817-3343-87f8-cda70a89dbe2",
                        "source_sense_description": "Unternehmen, das Flugverkehr betreibt",
                        "target_lang_word": "compagnie aérienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compagnie aérienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "792a2fe4-d826-3684-acc6-8f63b42b564c",
                                        "entry_id": "a12a3f9a-9b3f-3286-b5ae-0d3d1563fc8a",
                                        "glosses": [
                                            "Entreprise de transport aérien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e575b0-9f78-47b4-bdf7-253b6ce29a7e",
                                                "sense_id": "792a2fe4-d826-3684-acc6-8f63b42b564c",
                                                "text": "La direction générale de l’aviation civile (DGAC) a demandé mardi aux compagnies aériennes de renoncer à la moitié de leur programme de vols vendredi, en raison d’un appel à la grève du SNCTA, principal syndicat des contrôleurs aériens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
