                        ],
                        "form": "galangals"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fda03512-4078-37f2-928f-d15003e05de9",
                        "entry_id": "e9c786a6-38e3-3949-a3b5-da6b9c84a1d2",
                        "glosses": [
                            "Any of several east Asian plants of genera Alpinia and Kaempferia in the ginger family, used as a spice, but principally Alpinia galanga."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2d306bf5-8dc2-4d1e-83d3-5cf1d736af5e",
                                "sense_id": "fda03512-4078-37f2-928f-d15003e05de9",
                                "text": "The refreshing aroma of galangal acts in combination with and as a contrast to lemongrass in many recipes in this book."
                            },
                            {
                                "example_id": "1fdd9bf2-9df2-466e-8be2-f1edeb92cc85",
                                "sense_id": "fda03512-4078-37f2-928f-d15003e05de9",
                                "text": "Another time, she dined in Hampstead, where she was fed a version of stargazy pie with a whole squid where the eel should have been. It was flavoured, for the full medieval effect, with galangal, which her hostess described as “kind of like frankincense”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0820ca36-9a6a-46df-8e8f-44829f19190f",
                        "source_entry_id": "e9c786a6-38e3-3949-a3b5-da6b9c84a1d2",
