{
    "word_family": [
        "swabbing",
        "swabber"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1952cbe7-4d0c-3097-8b85-1179c4dfdf3d",
                    "sense_definition": "To clean, wipe, or collect a specimen from something using a swab or mop.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse will <w>swab</w> your throat to test for strep throat.",
                            "target_lang_translations": {
                                "ru": "Медсестра <w>возьмет мазок</w> из вашего горла, чтобы сделать тест на стрептококк."
                            }
                        },
                        {
                            "text": "The sailors were ordered to <w>swab</w> the deck before the captain arrived.",
                            "target_lang_translations": {
                                "ru": "Матросам приказали <w>драить</w> палубу до прибытия капитана."
                            }
                        }
                    ],
                    "common_phrases": [
                        "swab the deck",
                        "swab the throat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очищать, протирать или брать образец (мазок) с помощью тампона, швабры или зонда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брать мазок",
                                "target_lang_sense_clarification": "медицинская процедура"
                            },
                            {
                                "target_lang_word": "протирать",
                                "target_lang_sense_clarification": "очищать поверхность тампоном"
                            },
                            {
                                "target_lang_word": "драить",
                                "target_lang_sense_clarification": "мыть палубу шваброй"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "589c7f57-7c03-36af-9f21-abd0c4de2036",
                    "sense_definition": "A small piece of soft, absorbent material, such as cotton or gauze, often attached to a small stick, used for cleaning, applying medicine, or taking medical samples.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cleaning_and_sampling_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a cotton <w>swab</w> to gently clean the makeup from around her eyes.",
                            "target_lang_translations": {
                                "ru": "Она использовала ватную <w>палочку</w>, чтобы аккуратно стереть макияж вокруг глаз."
                            }
                        },
                        {
                            "text": "The doctor opened a sterile cotton <w>swab</w> to collect a sample from the wound.",
                            "target_lang_translations": {
                                "ru": "Врач открыл стерильный ватный <w>тампон</w>, чтобы взять образец из раны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cotton swab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой кусочек мягкого впитывающего материала (например, ваты или марли), часто на палочке, используемый для очистки, нанесения лекарств или взятия медицинских проб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ватный тампон",
                                "target_lang_sense_clarification": "для гигиены или медицины"
                            },
                            {
                                "target_lang_word": "ватная палочка",
                                "target_lang_sense_clarification": "косметическая или гигиеническая"
                            },
                            {
                                "target_lang_word": "зонд-тампон",
                                "target_lang_sense_clarification": "медицинский инструмент для взятия проб"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae161950-991b-301b-960d-576086b69ca9",
                    "sense_definition": "A medical specimen or sample collected using a swab.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_samples",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory analyzed the nasal <w>swab</w> to check for viral infections.",
                            "target_lang_translations": {
                                "ru": "Лаборатория проанализировала назальный <w>мазок</w> на наличие вирусных инфекций."
                            }
                        },
                        {
                            "text": "We are waiting for the results of the throat <w>swab</w> before prescribing antibiotics.",
                            "target_lang_translations": {
                                "ru": "Мы ждем результатов <w>мазка</w> из горла, прежде чем назначать антибиотики."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nasal swab",
                        "throat swab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинский образец или проба, взятая с помощью тампона."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мазок",
                                "target_lang_sense_clarification": "медицинский анализ"
                            },
                            {
                                "target_lang_word": "проба",
                                "target_lang_sense_clarification": "образец биоматериала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "205771ba-64ba-3bb6-90ba-84bd33c945d2",
                    "sense_definition": "A piece of material used for cleaning or maintaining items like musical instruments or firearms.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cleaning_and_sampling_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Always use a clean <w>swab</w> to remove moisture from the inside of your clarinet after playing.",
                            "target_lang_translations": {
                                "ru": "Всегда используйте чистую <w>протирку</w>, чтобы удалить влагу изнутри кларнета после игры."
                            }
                        },
                        {
                            "text": "He ran a cleaning <w>swab</w> through the barrel of the rifle to remove residue.",
                            "target_lang_translations": {
                                "ru": "Он прогнал чистящий <w>ершик</w> через ствол винтовки, чтобы удалить нагар."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cleaning swab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок материала, используемый для чистки или обслуживания таких предметов, как музыкальные инструменты или огнестрельное оружие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протирка",
                                "target_lang_sense_clarification": "для чистки оружия или инструментов"
                            },
                            {
                                "target_lang_word": "ершик",
                                "target_lang_sense_clarification": "для чистки каналов ствола или трубок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23ca066b-c35e-337c-b075-ea34a949a563",
                    "sense_definition": "A mop, especially one used on board a ship.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cleaning_and_sampling_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grab the <w>swab</w> and clean up the water that spilled on the galley floor.",
                            "target_lang_translations": {
                                "ru": "Возьми <w>швабру</w> и убери воду, пролившуюся на пол камбуза."
                            }
                        },
                        {
                            "text": "The deck was scrubbed clean using a heavy marine <w>swab</w>.",
                            "target_lang_translations": {
                                "ru": "Палубу дочиста отмыли с помощью тяжелой судовой <w>швабры</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Швабра, особенно используемая на борту судна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "швабра",
                                "target_lang_sense_clarification": "судовая или обычная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "038a1a80-99de-3151-8a80-d4f149338ef0",
                    "sense_definition": "A sailor; a swabby.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old pirate yelled at the lazy <w>swab</w> to get back to work.",
                            "target_lang_translations": {
                                "ru": "Старый пират прикрикнул на ленивого <w>салагу</w>, чтобы тот возвращался к работе."
                            }
                        },
                        {
                            "text": "As for that <w>swab</w>, he's good and dead, he is.",
                            "target_lang_translations": {
                                "ru": "Что касается этого <w>матроса</w>, он мертв и закопан, это уж точно."
                            }
                        }
                    ],
                    "synonyms": [
                        "swabby"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "nautical slang, often derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Матрос, палубный матрос (часто в пренебрежительном или жаргонном значении)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матрос",
                                "target_lang_sense_clarification": "жаргонное, пренебрежительное"
                            },
                            {
                                "target_lang_word": "салага",
                                "target_lang_sense_clarification": "морской жаргон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b3453d7-1b34-3110-92f4-b231583e47c7",
                    "sense_definition": "An epaulet worn by a naval officer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain's dress uniform was adorned with a gold <w>swab</w> on each shoulder.",
                            "target_lang_translations": {
                                "ru": "Парадный мундир капитана был украшен золотым <w>эполетом</w> на каждом плече."
                            }
                        },
                        {
                            "text": "He polished the brass on his <w>swab</w> before the formal inspection.",
                            "target_lang_translations": {
                                "ru": "Он начистил медь на своем <w>эполете</w> перед официальным смотром."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "historical naval slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эполет, носимый военно-морским офицером."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эполет",
                                "target_lang_sense_clarification": "морской исторический жаргон"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7893a0d2-070a-3639-9246-fe36fc7f8e2d",
                    "sense_definition": "A <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Swab</w> to speak at the local historical society meeting.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили господина <w>Сваба</w> выступить на заседании местного исторического общества."
                            }
                        },
                        {
                            "text": "The genealogy report traced the <w>Swab</w> family lineage back to the early settlers.",
                            "target_lang_translations": {
                                "ru": "Генеалогический отчет проследил родословную семьи <w>Сваб</w> до первых поселенцев."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сваб",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}