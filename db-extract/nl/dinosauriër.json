                    },
                    {
                        "translation_id": "b1d682cd-fba7-42b6-b7bd-b628daa1c8dc",
                        "source_entry_id": "045df505-d32d-365e-b2eb-9e9c6f2ab58e",
                        "source_sense_id": "8d6d68f9-b52b-3aa3-84a4-5e1ad34854ff",
                        "source_sense_description": "een lid van een uitgestorven groep van reptielen, waartoe de grootste landdieren behoren die ooit bestaan hebben",
                        "target_lang_word": "dinosaur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dinosaur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e112674e-28a0-3cdb-b892-ed81b5a52c55",
                                        "entry_id": "9d68115b-1cec-3462-8cdc-bae5e86ab22d",
                                        "glosses": [
                                            "Any of the animals belonging to the clade Dinosauria, especially those that existed during the Triassic, Jurassic and Cretaceous periods and are now extinct."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80d0157a-10e3-369c-9a21-4e890544c5c4",
                                        "entry_id": "9d68115b-1cec-3462-8cdc-bae5e86ab22d",
                                        "glosses": [
                                            "Any member of the clade Dinosauria other than birds."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e677224d-89ff-3f04-976e-c7ac6db11e6a",
                                        "entry_id": "9d68115b-1cec-3462-8cdc-bae5e86ab22d",
                                        "glosses": [
                                            "Any extinct reptile, not necessarily belonging to Dinosauria, that existed between about 230 million and 65 million years ago, as well as the stem-mammal Dimetrodon."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ebeca6c-74c0-437d-a378-e3cb0da89b00",
                                                "sense_id": "e677224d-89ff-3f04-976e-c7ac6db11e6a",
                                                "text": "\"Not a bird, my dear Roxton - not a bird.\" \"A beast?\" \"No; a reptile - a dinosaur.\""
                                            },
                                            {
                                                "example_id": "8a79f5cf-62b9-4e88-9524-213990ce376a",
                                                "sense_id": "e677224d-89ff-3f04-976e-c7ac6db11e6a",
                                                "text": "‘Dinosaur!’ Denham exploded. ‘By the Power! A dinosaur!’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85bb38b0-834d-3aec-8e7e-5a4e0f8d718c",
                                        "entry_id": "9d68115b-1cec-3462-8cdc-bae5e86ab22d",
                                        "glosses": [
                                            "Something or someone that is very old or old-fashioned, or is not willing to change and adapt."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed323845-8ffc-47de-8f9c-4b09c2b1c106",
                                                "sense_id": "85bb38b0-834d-3aec-8e7e-5a4e0f8d718c",
                                                "text": "[The OS/360 linkage editor] is the culmination of years of development of static overlay technique. Yet it is also the last and finest of the dinosaurs, for it belongs to a system in which multiprogramming is the normal mode and dynamic core allocation the basic assumption."
                                            },
                                            {
                                                "example_id": "be9a4e7f-0e2c-4ea0-99cd-225c0775560b",
                                                "sense_id": "85bb38b0-834d-3aec-8e7e-5a4e0f8d718c",
                                                "text": "The sign in the window said for sale or trade on the last remaining dinosaur Detroit made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53b8a8a6-7aa7-31a9-941e-3e0441a3b020",
                                        "entry_id": "9d68115b-1cec-3462-8cdc-bae5e86ab22d",
                                        "glosses": [
                                            "Anything no longer in common use or practice."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
