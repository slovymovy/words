                ],
                "senses": [
                    {
                        "sense_id": "48cb3502-384a-3414-9461-f57f5ceeeb35",
                        "entry_id": "0afe412f-8139-3fad-9b96-81d0012586d2",
                        "glosses": [
                            "Ort, der über einen Hafen verfügt, an einem solchen liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b4b4d15-b9f6-455e-9140-b4e1d6f34c16",
                                "sense_id": "48cb3502-384a-3414-9461-f57f5ceeeb35",
                                "text": "„Le Pouldu ist […] ein kleiner Hafenort mit einer Straße, in der alles zu finden ist, was man so braucht, vom Bäcker bis zum Zahnarzt, direkt am Meer, am Atlantik, hinter dem Amerika liegt.“"
                            },
                            {
                                "example_id": "2be012d7-a2c4-40ea-945b-769e7836d546",
                                "sense_id": "48cb3502-384a-3414-9461-f57f5ceeeb35",
                                "text": "„Die Gleisverbindung zwischen der sizilianischen Hauptstadt [Palermo] und dem Hafenort Porto Empedocle ist die älteste Bahnstrecke Siziliens und noch immer in Betrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "854b0b4a-1cdb-4f28-a250-4a728f26386d",
                        "source_entry_id": "0afe412f-8139-3fad-9b96-81d0012586d2",
                        "source_sense_id": "48cb3502-384a-3414-9461-f57f5ceeeb35",
                        "source_sense_description": "Ort, der über einen Hafen verfügt, an einem solchen liegt",
                        "target_lang_word": "port",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "port",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8b922b1-ce04-37ef-8acd-64cc8fbc496c",
                                        "entry_id": "ed101267-143a-3ba9-b082-de5919ba626d",
                                        "glosses": [
                                            "Havre côtier, refuge ou abri pour les bateaux les protégeant des vents et des tempêtes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f43d83-5b9f-4b4c-a96a-82faacb3f219",
                                                "sense_id": "b8b922b1-ce04-37ef-8acd-64cc8fbc496c",
                                                "text": "Des phares éloignent les navires des dangers ou les conduisent dans les ports abrités par des digues construites en luttant contre les tempêtes."
                                            },
                                            {
                                                "example_id": "6d8f0748-b480-4981-ba3f-bb99a8a2f230",
                                                "sense_id": "b8b922b1-ce04-37ef-8acd-64cc8fbc496c",
                                                "text": "Vers 4 heures, j’aperçois de nouveau la terre après avoir barré toute la nuit ; je passe au petit jour près d’un destroyer américain et entre dans le port Saint-Georges."
                                            },
                                            {
                                                "example_id": "f29e5e5a-6379-48f6-904b-9330cfbab7d3",
                                                "sense_id": "b8b922b1-ce04-37ef-8acd-64cc8fbc496c",
                                                "text": "La Chiffonne en longea la côte occidentale, doubla la pointe Nord et, suivant les falaises de l’Est, moins anfractueuses, pénétra dans un grand port naturel, protégé par un alignement de gros rochers et de petits îlots."
                                            },
                                            {
                                                "example_id": "592174d4-aa54-40e4-b605-06f5f3e07bd8",
                                                "sense_id": "b8b922b1-ce04-37ef-8acd-64cc8fbc496c",
                                                "text": "Azemmour, la ville maure remontant à l’antiquité, en plein déclin aujourd'hui par suite de l’ensablement de son port et l’indolence de sa population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ce7da3f-509f-3bc7-ab70-a7f4fc2faa33",
                                        "entry_id": "ed101267-143a-3ba9-b082-de5919ba626d",
                                        "glosses": [
                                            "Havre côtier, refuge ou abri pour les bateaux les protégeant des vents et des tempêtes.",
                                            "Port en eau profonde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2a5a874-974f-4414-9658-71e602283672",
                                                "sense_id": "3ce7da3f-509f-3bc7-ab70-a7f4fc2faa33",
                                                "text": "Ce voisin embarrassant risque de torpiller un projet à plusieurs milliards de dollars du gouvernement géorgien (prorusse): la construction d'un port moderne en eau profonde à Anaklia, 30 kilomètres au sud d'Otchamtchiré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0b4bc1d-64ee-3914-8b64-f5de68057897",
                                        "entry_id": "ed101267-143a-3ba9-b082-de5919ba626d",
                                        "glosses": [
                                            "Ensemble des installations, en bord de mer, destinées à l’entretien des navires, à l’embarquement et au débarquement des marchandises ou des passagers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec51246c-f697-42d1-ad60-f8a49be30833",
                                                "sense_id": "f0b4bc1d-64ee-3914-8b64-f5de68057897",
                                                "text": "C’était un tohu-bohu ethnique. Dans le port flottaient les pavillons de toutes les nations, et plus de deux millions d’êtres humains s’y embarquaient annuellement."
                                            },
                                            {
                                                "example_id": "42587d8a-f540-4ba9-ac7b-fe4fc96d1ed2",
                                                "sense_id": "f0b4bc1d-64ee-3914-8b64-f5de68057897",
                                                "text": "Ça me rappelle le vieux port marseillais, les marchandes de coquillages, les pieds-paquets et le vin de Cassis, doré comme du soleil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4671a16-cc63-3359-97ad-c62882f553ad",
                                        "entry_id": "ed101267-143a-3ba9-b082-de5919ba626d",
                                        "glosses": [
                                            "Point de la rive d’un cours d’eau où les navires abordent, chargent et déchargent les marchandises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f8a28a8-4dad-403c-9526-028932ffde21",
                                                "sense_id": "d4671a16-cc63-3359-97ad-c62882f553ad",
                                                "text": "Le mythique port de Bercy."
                                            },
                                            {
                                                "example_id": "9f560d71-a15b-4e76-b6fc-08c952bd86ef",
                                                "sense_id": "d4671a16-cc63-3359-97ad-c62882f553ad",
                                                "text": "Le port céréalier de Givet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "391fb234-4b70-3af9-9027-a2fce1cdbda0",
                                        "entry_id": "ed101267-143a-3ba9-b082-de5919ba626d",
                                        "glosses": [
                                            "Ville bâtie auprès d’un port, autour d’un port."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6db697f3-c4be-429d-9702-7b2ae6fcfec1",
                                                "sense_id": "391fb234-4b70-3af9-9027-a2fce1cdbda0",
                                                "text": "Marseille est un agréable port de mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4175befb-7481-38c6-ac72-731769ca0450",
                                        "entry_id": "ed101267-143a-3ba9-b082-de5919ba626d",
                                        "glosses": [
                                            "Lieu de repos, de refuge, d’une situation tranquille."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f82e2f4-9488-4fc2-b425-491cc1c08a9f",
                                                "sense_id": "4175befb-7481-38c6-ac72-731769ca0450",
                                                "text": "Il est dans le port en se retirant du monde et de l’embarras des affaires."
                                            },
                                            {
                                                "example_id": "d836df1e-376f-462a-8fb5-6b00d8361033",
                                                "sense_id": "4175befb-7481-38c6-ac72-731769ca0450",
                                                "text": "Il s’est assuré un port dans la tempête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55df0cbc-95e4-39da-91fd-17a5c84d7acd",
                                        "entry_id": "ed101267-143a-3ba9-b082-de5919ba626d",
                                        "glosses": [
                                            "Lieu où l’on se retire loin des embarras du monde, où l’on cherche à se mettre à couvert de quelque danger."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a66a58b-69f3-440f-bb15-30ccc204b8bb",
                                                "sense_id": "55df0cbc-95e4-39da-91fd-17a5c84d7acd",
                                                "text": "La maison de l’ambassadeur a été un port de salut pour lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e658ff14-9604-3910-9c43-5879d80ec895",
                                        "entry_id": "ed101267-143a-3ba9-b082-de5919ba626d",
                                        "glosses": [
                                            "Col des Pyrénées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6262ea4e-1c38-4aa9-a8f1-c320a9d55310",
                                                "sense_id": "e658ff14-9604-3910-9c43-5879d80ec895",
                                                "text": "Le port d’Envalira est le plus haut col routier de la chaîne pyrénéenne."
                                            },
                                            {
                                                "example_id": "143d0463-f388-4c07-b5b4-5fc97d52b797",
                                                "sense_id": "e658ff14-9604-3910-9c43-5879d80ec895",
                                                "text": "— Viva ! viva ! jaleo ! s’écria Houmain ; nous autres braves, nous sommes bons à tout. Ah çà ! mais… tu as donc toujours passé par les autres ports ? car je ne t’ai pas revu depuis que j’ai repris le métier."
                                            },
                                            {
                                                "example_id": "24f1e84a-e566-48ed-bce6-17e9276eaa52",
                                                "sense_id": "e658ff14-9604-3910-9c43-5879d80ec895",
                                                "text": "De l’autre côté, c’est l’Espagne, dominée par des falaises identiques aux nôtres […]. On peut passer en Espagne sans suivre le sentier qui franchit le port, mais il y faut beaucoup d’acrobatie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b84fa3c-0d82-3010-9760-e21a2798269f",
                                        "entry_id": "ed101267-143a-3ba9-b082-de5919ba626d",
                                        "glosses": [
                                            "Arrivée, destination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05167b7e-64a2-4c33-a03b-973f85f091f8",
                                                "sense_id": "0b84fa3c-0d82-3010-9760-e21a2798269f",
                                                "text": "Elle recommença ses doléances, elle se mit à geindre de plus belle sur le manque de fortune qui la faisait échouer au port."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "port",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a31603f9-3573-3f11-bf53-dd88e68957b4",
                                        "entry_id": "a15e8cfa-1be9-3500-9cad-0493848ca072",
                                        "glosses": [
                                            "Action de porter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e706866d-430c-461a-a508-c66df7f43981",
                                                "sense_id": "a31603f9-3573-3f11-bf53-dd88e68957b4",
                                                "text": "La vidéo a été diffusée par la police américaine pour sensibiliser sur le port de la ceinture et la conduite sous la neige."
                                            },
                                            {
                                                "example_id": "8821c9a3-3156-4730-91fd-cea8545e8ed3",
                                                "sense_id": "a31603f9-3573-3f11-bf53-dd88e68957b4",
                                                "text": "Simon Cohen, se conformant en ceci à l’usage du pays qui interdit le port des armes à ses coreligionnaires marocains, est inerme; les chameliers ont des gourdins et de mauvais poignards."
                                            },
                                            {
                                                "example_id": "6311c2f8-43f1-41e1-b823-4edeaf96f336",
                                                "sense_id": "a31603f9-3573-3f11-bf53-dd88e68957b4",
                                                "text": "Il n’y a non plus aucun pittoresque dans les costumes, car le port du pareu ou pagne indigène est interdit dans les rues de Papeete."
                                            },
                                            {
                                                "example_id": "ee8fd2b2-5e1e-4664-9c9e-9f5aa382b61e",
                                                "sense_id": "a31603f9-3573-3f11-bf53-dd88e68957b4",
                                                "text": "Bien qu’il ait déjà été question dès 1208, […], d’imposer aux juifs un signe en forme de roue, la rouelle ne fut officiellement imposée en France qu’en 1227 par le Concile de Narbonne. […]. La roue devait, ordinairement, se porter sur la poitrine. […]. Le défaut du port de la roue était passible d’amende et même de châtiments corporels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d81dafc1-b9c1-3f4e-8364-f9affd49c07f",
                                        "entry_id": "a15e8cfa-1be9-3500-9cad-0493848ca072",
                                        "glosses": [
                                            "Façon de se porter, maintien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c30d224-5c99-4b2d-8917-e71f35810675",
                                                "sense_id": "d81dafc1-b9c1-3f4e-8364-f9affd49c07f",
                                                "text": "C’était la supérieure, suivie des sœurs Agnès et Claire. Toutes deux pleuraient ; la supérieure était fort pâle, mais son port était assuré et ses yeux fixes et hardis."
                                            },
                                            {
                                                "example_id": "725216b2-65ef-4ed3-bfa4-2f72e6a9b2c0",
                                                "sense_id": "d81dafc1-b9c1-3f4e-8364-f9affd49c07f",
                                                "text": "Il avait la cambrure des petits, le port de l’avorton, gardait le ventre rentré et poussait chaque centimètre au-delà de ses limites."
                                            },
                                            {
                                                "example_id": "60ce1405-e851-417b-83c2-3f9d8042c983",
                                                "sense_id": "d81dafc1-b9c1-3f4e-8364-f9affd49c07f",
                                                "text": "Tout le monde les connaît. Avec leur costume sombre, leurs tatouages et leur port altier, ils sont reconnaissables entre tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96135e5-17fa-3081-8ba0-44871848cd00",
                                        "entry_id": "a15e8cfa-1be9-3500-9cad-0493848ca072",
                                        "glosses": [
                                            "Apparence naturelle d’une plante (→ voir habitus)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17608539-8304-4187-9534-5963494b8bce",
                                                "sense_id": "c96135e5-17fa-3081-8ba0-44871848cd00",
                                                "text": "Parmi les Pandanées, il est aussi des formes dépourvues de tronc ; sur le sol marécageux littoral de quelques Moluques, ces formes correspondent à la physionomie des Nipas (Pandanus caricosus), et un genre très-répandu dans les îles de la mer des Indes et de la mer Pacifique (Freycinetia) reproduit également le port volubile du Palmier Rotang."
                                            },
                                            {
                                                "example_id": "06686b77-dcf9-4da2-be66-e429ff2234c4",
                                                "sense_id": "c96135e5-17fa-3081-8ba0-44871848cd00",
                                                "text": "Nous avons pu définir huit variétés d’arachides cultivées par les indigènes au Sénégal; les plus intéressantes sont la Ngori du Cayor, la Baol et la Saloum. Ces variétés sont à port rampant, mais au milieu des populations de chaque variété, on trouve de loin en loin des individus dressés avec tous les fruits groupés près du collet."
                                            },
                                            {
                                                "example_id": "2cc3c7ba-3811-4cd8-bb77-db6704786d26",
                                                "sense_id": "c96135e5-17fa-3081-8ba0-44871848cd00",
                                                "text": "Dans de nombreuses familles, le port de la plante est le même chez tous les végétaux qui la composent, à très peu d’exceptions près. Ainsi, les Renonculacées, les Composées et les Lamiacées ne comprennent, en règle générale, que des plantes herbacées."
                                            },
                                            {
                                                "example_id": "fab3f407-4d9d-433f-b13d-adf908e3f8be",
                                                "sense_id": "c96135e5-17fa-3081-8ba0-44871848cd00",
                                                "text": "Arbuste, une essence ligneuse dont le port n’excède pas sept mètres de haut"
                                            },
                                            {
                                                "example_id": "2e17451a-d16c-45de-be48-482fcc453258",
                                                "sense_id": "c96135e5-17fa-3081-8ba0-44871848cd00",
                                                "text": "Par contre, la plante non vernalisée, maintenue en serre chaude, conserve le port en rosette."
                                            },
                                            {
                                                "example_id": "92e56730-2dc9-4e38-a75b-d7d98ef747d4",
                                                "sense_id": "c96135e5-17fa-3081-8ba0-44871848cd00",
                                                "text": "Ces trois euphorbes, toutes originaires d’Amérique du Nord, affectionnent tout particulièrement les zones ouvertes anthropiques et thermophiles (cimetières, pieds de murs, ballast sablo-graveleux des voies ferrées, rues des villages) et se caractérisent notamment par leur port prostré, des limbes longs de moins de 15 mm, leurs feuilles opposées et stipulées et leur capsule de taille toujours inférieure à 6 mm de diamètre (Jauzein, 1995)."
                                            },
                                            {
                                                "example_id": "591d33b7-b92a-41bf-9c16-a3cc21f34370",
                                                "sense_id": "c96135e5-17fa-3081-8ba0-44871848cd00",
                                                "text": "Greewood et Atkinson ont proposé que le port divariqué soit une défense contre les moas, ces grands oiseaux herbivores apparentés aux autruches et maintenant exterminés par les Maoris ; mais quelques années plus tard l’examen du contenu des gésiers de moas fossiles montrait que les arbustes divariqués étaient leur nourriture favorite. Il fallait trouver une autre idée !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b20caf01-af2d-3088-8b62-91e797066c66",
                                        "entry_id": "a15e8cfa-1be9-3500-9cad-0493848ca072",
                                        "glosses": [
                                            "Dispositif permettant de connecter des périphériques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d479c951-8ef4-4bba-afda-24f9be9e56b9",
                                                "sense_id": "b20caf01-af2d-3088-8b62-91e797066c66",
                                                "text": "Le port USB (Universal Serial Bus) est apparu en 1995 pour pallier les carences du port série créé en 1960 et supportant le standard RS-232. Ce sont des connecteurs qui permettent de raccorder des périphériques…"
                                            },
                                            {
                                                "example_id": "b5cf5458-2709-4133-8feb-b563d43ab9ca",
                                                "sense_id": "b20caf01-af2d-3088-8b62-91e797066c66",
                                                "text": "De son côté, Bloomberg maintient ses informations et a même ajouté récemment que des ports Ethernet avaient été bidouillés pour écouter aux serveurs."
                                            },
                                            {
                                                "example_id": "89686937-c3e9-48f2-8573-72b72a56c63b",
                                                "sense_id": "b20caf01-af2d-3088-8b62-91e797066c66",
                                                "text": "D’ailleurs c’est toute la technologie USB qui est mise à mal puisque les nouveaux ordinateurs n’intègrent même plus de port correspondant…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f2fa2fa-68ab-3a12-9f18-8de83972807b",
                                        "entry_id": "a15e8cfa-1be9-3500-9cad-0493848ca072",
                                        "glosses": [
                                            "Prix du transport, affranchissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a220e729-e418-4473-a081-af0012c51490",
                                                "sense_id": "4f2fa2fa-68ab-3a12-9f18-8de83972807b",
                                                "text": "Franco de port."
                                            },
                                            {
                                                "example_id": "7bfb83a2-4cb7-4b6f-83b5-eebe6bfefbf0",
                                                "sense_id": "4f2fa2fa-68ab-3a12-9f18-8de83972807b",
                                                "text": "Les ports de lettres ne sont pas très-chers, et malgré les innombrables dangers auxquels sont exposés les courriers sur les routes, presque toujours infestées de factieux et de bandits, le service se fait aussi régulièrement que possible."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "port",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6057210-7e2d-3083-b90d-0a405ea8018c",
                                        "entry_id": "a39c4559-1a24-3600-95fd-68bc79205552",
                                        "glosses": [
                                            "Téléphone portable."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56d5ef80-0930-497b-9ec3-9ec2e2298f80",
                                                "sense_id": "a6057210-7e2d-3083-b90d-0a405ea8018c",
                                                "text": "J'ai oublié le code de verrouillage qu'on me demande quand j'allume mon port."
                                            },
                                            {
                                                "example_id": "8580caba-ff37-4a67-b99d-f302af4a8432",
                                                "sense_id": "a6057210-7e2d-3083-b90d-0a405ea8018c",
                                                "text": "J’aurais bien éteint mon port mais j’attendais des coups de fil donc je pouvais pas vraiment."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "port",
                                "target_lang_code": "fr",
                                "target_senses": [
