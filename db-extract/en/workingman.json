                "senses": [
                    {
                        "sense_id": "6ebc0086-070e-3086-9c7e-e77ebe51c628",
                        "entry_id": "749fe373-c681-3c9a-98f8-8149c627d6ae",
                        "glosses": [
                            "A man who works in exchange for payment, especially a labourer who does manual labour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b53616d-5b48-43fb-92c5-fadb70f5038b",
                                "sense_id": "6ebc0086-070e-3086-9c7e-e77ebe51c628",
                                "text": "The workingman, through the invention of many time and labor saving devices, has been freed from much drudgery and now finds his day portionable into eight hours for rest, eight hours for work and eight hours for recreation."
                            },
                            {
                                "example_id": "c783034c-7556-4965-96f2-a2c1f77ea3e7",
                                "sense_id": "6ebc0086-070e-3086-9c7e-e77ebe51c628",
                                "text": "To her it seemed indecent that a pregnant woman of her standing (Government Service) should have to board the steamer without a husband to go with her and dispute about her accommodation and whisper anxiously to the doctor and stewardess—almost as indecent as a Government Service woman's having her baby in the hospital in Port Zodiac with the wives of workingmen and Greeks."
                            },
                            {
                                "example_id": "e4875bd1-ac41-4a25-9488-c3d4432b0cfb",
                                "sense_id": "6ebc0086-070e-3086-9c7e-e77ebe51c628",
                                "text": "Every workingman can have his own house."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
