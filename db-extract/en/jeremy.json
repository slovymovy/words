                "senses": [
                    {
                        "sense_id": "d3ba3060-206e-3e0b-a20e-573992d44e4f",
                        "entry_id": "dd19012d-ba0a-3a1b-8d1b-820827a0fa47",
                        "glosses": [
                            "A male given name from Hebrew, English form of Jeremiah. Also used to anglicize Irish Diarmaid (Dermot)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b71684fb-8ec0-40ef-919a-8aea75a227b6",
                                "sense_id": "d3ba3060-206e-3e0b-a20e-573992d44e4f",
                                "text": "Then was fulfilled that which was spoken by Jeremy the prophet."
                            },
                            {
                                "example_id": "f6ca12a3-4326-4f81-a3ef-3765edb56758",
                                "sense_id": "d3ba3060-206e-3e0b-a20e-573992d44e4f",
                                "text": "He had the name of Jeremy given to him, because Jeremiah, as his father said, was a family name; and there was an advantage in curtailing a syllable, and in showing a preference towards the names of the New Testament over those of the old."
                            },
                            {
                                "example_id": "50e4314d-628f-4858-bd6a-fd35bc355cb4",
                                "sense_id": "d3ba3060-206e-3e0b-a20e-573992d44e4f",
                                "text": "Fry: You don't meet many American Jeremies, do you? Have you ever met an American Jeremy?\nClarkson: No, it's too complicated. There's three syllables."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
