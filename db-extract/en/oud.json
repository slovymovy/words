                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cdf696a-3333-4c77-9dff-dd8fe90e9ab4",
                                                "sense_id": "ce9ee8ed-dda7-3c72-9c20-6bb0e1a48361",
                                                "text": "Presbyterium skládá se z farářů a ostatních údů zvolených."
                                            },
                                            {
                                                "example_id": "469fa1e5-c1ab-4dd9-9e5b-71c76420b58d",
                                                "sense_id": "ce9ee8ed-dda7-3c72-9c20-6bb0e1a48361",
                                                "text": "Znamenitější duchové jak z Čech, tak z Moravy, tak i ze Slovenska od jakživa směřovali k úplnému spojení těchto zemi jednoho národu, a považovali sebe vždy za údy jednoho kmene, na co svědčí jména a spisy nejznamenitějších mužů ze všech těch krajin."
                                            },
                                            {
                                                "example_id": "9eb95e24-1a7b-4633-b9c9-5b23a5e89cf9",
                                                "sense_id": "ce9ee8ed-dda7-3c72-9c20-6bb0e1a48361",
                                                "text": "Seznam údů Svatojanského Dědictví v Praze, kteří během roku 1895 zemřeli, aneb již dříve zemřevše, Ředitelství teprv letošního roku oznámeni byli."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
