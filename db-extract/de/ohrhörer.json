                "senses": [
                    {
                        "sense_id": "df926107-8407-30c7-894b-c456de0d0ddd",
                        "entry_id": "47bf0635-4d95-31ec-88c7-74f2ca8b7a03",
                        "glosses": [
                            "Écouteur, oreillette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae83ab76-c828-441c-b982-91220308aca4",
                                "sense_id": "df926107-8407-30c7-894b-c456de0d0ddd",
                                "text": "Ohrhörer tragen — porter des écouteurs, porter des oreillettes"
                            },
                            {
                                "example_id": "047a7184-4767-49d0-8229-a222e293cd7d",
                                "sense_id": "df926107-8407-30c7-894b-c456de0d0ddd",
                                "text": "Ergonomisch geformte, leichte Ohrhörer mit Geräuschisolierung bieten hohen Komfort.",
                                "translation": "Les écouteurs ergonomiques et légers avec isolation sonore offrent un grand confort."
                            },
                            {
                                "example_id": "91ebfab8-5862-4ced-8452-70448617a8f9",
                                "sense_id": "df926107-8407-30c7-894b-c456de0d0ddd",
                                "text": "»Bitte sehr, Mikrofone und Ohrhörer. Damit können wir die ganze Zeit miteinander in Kontakt bleiben.«",
                                "translation": "« Tenez, des microphones et des oreillettes. Nous pourrons ainsi rester en contact permanent les uns avec les autres. »"
                            }
                        ]
                    }
                ],
