    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d75e7036-de58-3b07-990f-bf7a3e2477fd",
                    "sense_definition": "The human body part below the ankle, used for standing and walking.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I hurt my left <w>foot</w> while playing soccer yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера во время игры в футбол я повредил левую <w>ступню</w>."
                            }
                        },
                        {
                            "text": "She stood on one <w>foot</w> to put on her shoe.",
                            "target_lang_translations": {
                                "ru": "Она стояла на одной <w>ноге</w>, чтобы надеть туфлю."
                            }
                        }
                    ],
                    "synonyms": [
                        "pes"
                    ],
                    "common_phrases": [
                        "left foot",
                        "right foot",
                        "bare foot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть тела человека ниже щиколотки, используемая для опоры и ходьбы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ступня",
                                "target_lang_sense_clarification": "анатомическая часть ноги"
                            },
                            {
                                "target_lang_word": "стопа",
                                "target_lang_sense_clarification": "медицинский или формальный термин"
                            },
                            {
                                "target_lang_word": "нога",
                                "target_lang_sense_clarification": "в разговорной речи часто заменяет ступню"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60e66c44-c1c7-3003-883a-e06e99b49fd1",
                    "sense_definition": "A unit of length equal to twelve inches (30.48 centimeters).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flag pole is twenty <w>feet</w> high and visible from the road.",
                            "target_lang_translations": {
                                "ru": "Флагшток высотой двадцать <w>футов</w> виден с дороги."
                            }
                        },
                        {
                            "text": "He is a six <w>foot</w> tall man with a very deep voice.",
                            "target_lang_translations": {
                                "ru": "Он мужчина ростом в шесть <w>футов</w> с очень низким голосом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "six foot tall",
                        "square foot",
                        "cubic foot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица длины, равная двенадцати дюймам (30,48 сантиметра)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фут",
                                "target_lang_sense_clarification": "единица измерения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "baeac199-31d0-3a6e-8faa-39f94d9e48fb",
                    "sense_definition": "The base or bottom part of an object or structure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bottom_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will meet you at the <w>foot</w> of the stairs in ten minutes.",
                            "target_lang_translations": {
                                "ru": "Я встречу тебя у <w>подножия</w> лестницы через десять минут."
                            }
                        },
                        {
                            "text": "The village is located at the <w>foot</w> of the mountain.",
                            "target_lang_translations": {
                                "ru": "Деревня расположена у <w>подножия</w> горы."
                            }
                        }
                    ],
                    "synonyms": [
                        "foot",
                        "pes"
                    ],
                    "antonyms": [
                        "head",
                        "top"
                    ],
                    "common_phrases": [
                        "foot of the stairs",
                        "foot of the bed",
                        "foot of the mountain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основание или нижняя часть объекта или структуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подножие",
                                "target_lang_sense_clarification": "горы или холма"
                            },
                            {
                                "target_lang_word": "основание",
                                "target_lang_sense_clarification": "нижняя часть чего-либо"
                            },
                            {
                                "target_lang_word": "низ",
                                "target_lang_sense_clarification": "нижняя область"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43c01be2-861e-3c95-9dbf-be6cd55aeefd",
                    "sense_definition": "The act of traveling by walking rather than using a vehicle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went there by <w>foot</w> because we could not afford a taxi.",
                            "target_lang_translations": {
                                "ru": "Мы отправились туда <w>пешком</w>, так как не могли позволить себе такси."
                            }
                        },
                        {
                            "text": "There is a lot of <w>foot</w> traffic on this busy shopping street.",
                            "target_lang_translations": {
                                "ru": "На этой оживленной торговой улице очень интенсивное <w>пешеходное</w> движение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "by foot",
                        "on foot",
                        "foot traffic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ передвижения пешком, а не на транспорте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пешком",
                                "target_lang_sense_clarification": "способ передвижения"
                            },
                            {
                                "target_lang_word": "пеший",
                                "target_lang_sense_clarification": "относящийся к ходьбе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45a5f5d8-3ae5-3c3d-a1e4-8ce5ff474582",
                    "sense_definition": "The terminal part of a leg in animals, used for movement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A spider has eight <w>feet</w> that help it move quickly across its web.",
                            "target_lang_translations": {
                                "ru": "У паука восемь <w>лапок</w>, которые помогают ему быстро передвигаться по паутине."
                            }
                        },
                        {
                            "text": "The vet examined the dog's injured <w>foot</w> carefully.",
                            "target_lang_translations": {
                                "ru": "Ветеринар внимательно осмотрел поврежденную <w>лапу</w> собаки."
                            }
                        }
                    ],
                    "synonyms": [
                        "pes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конечная часть ноги животного, используемая для передвижения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапа",
                                "target_lang_sense_clarification": "конечность животного"
                            },
                            {
                                "target_lang_word": "нога",
                                "target_lang_sense_clarification": "конечность крупного животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adb2322c-235b-3f83-b798-8e9197b3723b",
                    "sense_definition": "The basic unit of rhythm or meter in a line of poetry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "poetry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An iambic <w>foot</w> consists of an unstressed syllable followed by a stressed one.",
                            "target_lang_translations": {
                                "ru": "Ямбическая <w>стопа</w> состоит из безударного слога, за которым следует ударный."
                            }
                        },
                        {
                            "text": "The poet carefully counted every <w>foot</w> in the sonnet.",
                            "target_lang_translations": {
                                "ru": "Поэт тщательно подсчитывал каждую <w>стопу</w> в сонете."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iambic foot",
                        "poetic foot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная единица ритма или метра в стихотворной строке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стопа",
                                "target_lang_sense_clarification": "в поэзии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ac0962e-5ea3-361d-b191-06c6e84a1629",
                    "sense_definition": "Soldiers who fight on foot; the infantry.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general led ten thousand <w>foot</w> and one thousand horse into the battle.",
                            "target_lang_translations": {
                                "ru": "Генерал повел в бой десять тысяч <w>пехотинцев</w> и тысячу всадников."
                            }
                        },
                        {
                            "text": "The army consisted mainly of <w>foot</w> soldiers armed with spears.",
                            "target_lang_translations": {
                                "ru": "Армия состояла в основном из <w>пеших</w> воинов, вооруженных копьями."
                            }
                        }
                    ],
                    "antonyms": [
                        "horse"
                    ],
                    "common_phrases": [
                        "foot soldiers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Солдаты, сражающиеся в пешем строю; пехота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пехота",
                                "target_lang_sense_clarification": "род войск"
                            },
                            {
                                "target_lang_word": "пеший",
                                "target_lang_sense_clarification": "о воинах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ea22804-49e3-3b1d-bdfb-70780b43560e",
                    "sense_definition": "The bottom edge of a sail on a boat.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To make the mainsail fuller, the sailor eased the tension on the <w>foot</w> of the sail.",
                            "target_lang_translations": {
                                "ru": "Чтобы сделать грот более полным, матрос ослабил натяжение по <w>нижней шкаторине</w> паруса."
                            }
                        },
                        {
                            "text": "The <w>foot</w> of the sail was flapping violently in the strong wind.",
                            "target_lang_translations": {
                                "ru": "<w>Нижняя кромка</w> паруса сильно хлопала на сильном ветру."
                            }
                        }
                    ],
                    "antonyms": [
                        "head"
                    ],
                    "common_phrases": [
                        "foot of the sail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя кромка паруса на судне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нижняя шкаторина",
                                "target_lang_sense_clarification": "морской термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3513b690-8523-3177-8695-e3b4f1c6fd79",
                    "sense_definition": "To pay the cost of something, especially a bill or expense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My parents agreed to <w>foot</w> the bill for my university tuition.",
                            "target_lang_translations": {
                                "ru": "Мои родители согласились <w>оплатить</w> мое обучение в университете."
                            }
                        },
                        {
                            "text": "The company will <w>foot</w> the bill for all travel expenses.",
                            "target_lang_translations": {
                                "ru": "Компания <w>возьмет на себя</w> все транспортные расходы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "foot the bill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оплатить стоимость чего-либо, особенно счет или расходы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оплатить",
                                "target_lang_sense_clarification": "покрыть расходы"
                            },
                            {
                                "target_lang_word": "взять на себя расходы",
                                "target_lang_sense_clarification": "оплатить счет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9589373e-d24f-3a11-b1be-5cb21666a32b",
                    "sense_definition": "To kick something, typically a ball, using the foot.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>foot</w> the ball into the goal at the last second.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>забить</w> мяч в ворота ногой на последней секунде."
                            }
                        },
                        {
                            "text": "The player tried to <w>foot</w> the ball away from the defender.",
                            "target_lang_translations": {
                                "ru": "Игрок попытался <w>отбить</w> мяч ногой подальше от защитника."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить по чему-либо (обычно по мячу) ногой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пнуть",
                                "target_lang_sense_clarification": "ударить ногой"
                            },
                            {
                                "target_lang_word": "пинать",
                                "target_lang_sense_clarification": "наносить удары ногой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2c4d358-19ba-39e3-8684-742f3a8b321c",
                    "sense_definition": "To add up a column of numbers to find the total.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calculation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant had to <w>foot</w> the account to ensure the totals were correct.",
                            "target_lang_translations": {
                                "ru": "Бухгалтеру пришлось <w>подсчитать</w> счет, чтобы убедиться в правильности итогов."
                            }
                        },
                        {
                            "text": "Please <w>foot</w> up these figures before the meeting starts.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>подбей</w> эти цифры до начала собрания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "foot up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложить столбец чисел, чтобы найти общую сумму."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсчитывать",
                                "target_lang_sense_clarification": "подводить итог"
                            },
                            {
                                "target_lang_word": "подбивать",
                                "target_lang_sense_clarification": "суммировать итог"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7838080c-aaba-3d21-b94d-16a3b379e438",
                    "sense_definition": "To dance or move rhythmically to music.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests began to <w>foot</w> a measure with the happy bride.",
                            "target_lang_translations": {
                                "ru": "Гости начали <w>танцевать</w> со счастливой невестой."
                            }
                        },
                        {
                            "text": "They spent the evening <w>footing</w> it across the dance floor.",
                            "target_lang_translations": {
                                "ru": "Они провели вечер, <w>отплясывая</w> на танцполе."
                            }
                        }
                    ],
                    "synonyms": [
                        "foot",
                        "pes"
                    ],
                    "common_phrases": [
                        "foot a measure"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in literary or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Танцевать или ритмично двигаться под музыку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плясать",
                                "target_lang_sense_clarification": "двигаться под музыку"
                            },
                            {
                                "target_lang_word": "отплясывать",
                                "target_lang_sense_clarification": "энергично танцевать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c2985fe3-d3f0-36a1-b0bd-8e59caf7e573",
                    "sense_definition": "A common English surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Michael <w>Foot</w> was a prominent British politician in the twentieth century.",
                            "target_lang_translations": {
                                "ru": "Майкл <w>Фут</w> был выдающимся британским политиком в двадцатом веке."
                            }
                        },
                        {
                            "text": "The library was named after the local benefactor, Mr. <w>Foot</w>.",
                            "target_lang_translations": {
                                "ru": "Библиотека была названа в честь местного благотворителя, мистера <w>Фута</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фут",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}