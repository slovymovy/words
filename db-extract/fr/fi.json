        "fr-extract.jsonl": [
            {
                "entry_id": "8d305370-37c8-358e-8548-3a3ecc4d94b5",
                "word": "fi",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2147cf15-e572-3649-9dfd-682387085905",
                        "entry_id": "8d305370-37c8-358e-8548-3a3ecc4d94b5",
                        "glosses": [
                            "Pour exprimer le mépris, la répugnance, le dégoût qu’inspire quelqu’un ou quelque chose."
                        ],
                        "tags": [
                            "familiar",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "64495251-c84c-48c9-9ba6-a3ba466406dc",
                                "sense_id": "2147cf15-e572-3649-9dfd-682387085905",
                                "text": "Fi donc ! illustre Athelsthane, poursuivit Cédric ; oubliez de pareils misérables …."
                            },
                            {
                                "example_id": "9278ada3-38fa-4ce6-9810-92742a55aef0",
                                "sense_id": "2147cf15-e572-3649-9dfd-682387085905",
                                "text": "« Comme vous prodiguez votre antipathie ! un poète ! un philosophe ! ah fi ! »"
                            },
                            {
                                "example_id": "a133829a-1fa0-4f64-8694-67275829d2a2",
                                "sense_id": "2147cf15-e572-3649-9dfd-682387085905",
                                "text": "— Fi donc ! fi donc ! monseigneur, des gens d’honneur comme nous ! une conjuration ! ah ! du tout ! une ligue, tout au plus, un petit accord pour donner la direction au vœu unanime de la nation et de la cour : voilà tout !"
                            },
                            {
                                "example_id": "0ae1b888-3e59-46dd-8194-29267593028e",
                                "sense_id": "2147cf15-e572-3649-9dfd-682387085905",
                                "text": "Cinquante-sept minutes de retard… Fi ! fi !"
                            },
                            {
                                "example_id": "44b781e7-7a95-46a9-8488-d8e86bfe22e5",
                                "sense_id": "2147cf15-e572-3649-9dfd-682387085905",
                                "text": "J’eus un sursaut si brusque que ma vareuse se déchira ; le visage en feu, et tandis qu’elle s’écriait : « Fi ! le grand sot ! » je m’enfuis."
                            },
                            {
                                "example_id": "efd04ab8-89a8-47c8-b99d-d4d46af6b76d",
                                "sense_id": "2147cf15-e572-3649-9dfd-682387085905",
                                "text": "Arrière l'honnêteté ! fi de la probité ! vautrons-nous dans toutes les jouissances d'abord…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a28efb0-8d8d-4357-ab42-e717e5452af9",
                        "source_entry_id": "8d305370-37c8-358e-8548-3a3ecc4d94b5",
                        "source_sense_id": "2147cf15-e572-3649-9dfd-682387085905",
                        "target_lang_word": "fie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "790a5e2f-1bc2-34de-a3ee-fb95a5fcb40f",
                                        "entry_id": "f3133fd4-5570-36a8-b260-bbd54e7c3de6",
                                        "glosses": [
                                            "Sometimes followed by on or upon: used to express distaste, disgust, or outrage."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2480d3fa-8774-4b3e-a03c-d9d218b5dced",
                                                "sense_id": "790a5e2f-1bc2-34de-a3ee-fb95a5fcb40f",
                                                "text": "Fie, fie, vnknit that thretaning vnkinde brovv, / And dart not ſcornefull glances from thoſe eies, / To vvound thy Lord, thy King, thy Gouernour."
                                            },
                                            {
                                                "example_id": "0c7541cf-83a9-4b53-a7f6-ddd127e81d5a",
                                                "sense_id": "790a5e2f-1bc2-34de-a3ee-fb95a5fcb40f",
                                                "text": "Bian[ca]. I am no ſtrumpet, but of life as honeſt, / As you, that thus abuſe me. / Em[ilia]. As I: fough, fie vpon thee."
                                            },
                                            {
                                                "example_id": "2d29f5f7-e729-4380-b97f-8079f135537c",
                                                "sense_id": "790a5e2f-1bc2-34de-a3ee-fb95a5fcb40f",
                                                "text": "\"Fie upon them, forgetting their philosophy!\""
                                            },
                                            {
                                                "example_id": "e8ec49c6-7068-4113-aa78-f0de3e2a77c8",
                                                "sense_id": "790a5e2f-1bc2-34de-a3ee-fb95a5fcb40f",
                                                "text": "I pleaded with my companions to spare his life, and they said, ‘Fie! shame upon you! You have a Chinese heart.’ Then they turned upon me to kill me as well, so I withdrew my petition. After that they cut off the woodsman's head, and we returned home."
                                            },
                                            {
                                                "example_id": "69116a1c-9bf5-43bd-87b2-0c5ec1255b5d",
                                                "sense_id": "790a5e2f-1bc2-34de-a3ee-fb95a5fcb40f",
                                                "text": "But the orthodox scientific world says fie! to the religious impulse. The scientist wants to discover a cause for everything."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cef0a106-cd64-473d-a603-d6aed535c7f3",
                        "source_entry_id": "8d305370-37c8-358e-8548-3a3ecc4d94b5",
