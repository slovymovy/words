{
    "word_family": [
        "такой",
        "также",
        "итак",
        "этак",
        "таковой",
        "затак"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "65c85f96-00bf-3b5e-99dc-d246b0b56841",
                    "sense_definition": "Указывает на способ действия или обстоятельство; таким образом, подобным способом.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Почему ты <так> себя ведёшь?",
                            "target_lang_translations": {
                                "en": "Why are you behaving <so>?"
                            }
                        },
                        {
                            "text": "Мы всегда делаем это именно <так>.",
                            "target_lang_translations": {
                                "en": "We always do it exactly <so>."
                            }
                        },
                        {
                            "text": "Комнаты в доме расположены <так>, что всем удобно.",
                            "target_lang_translations": {
                                "en": "The rooms in the house are arranged <so> that it is convenient for everyone."
                            }
                        }
                    ],
                    "synonyms": [
                        "таким образом",
                        "эдак"
                    ],
                    "antonyms": [
                        "иначе",
                        "по-другому"
                    ],
                    "common_phrases": [
                        "именно так",
                        "не так",
                        "всё так",
                        "сделай так"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates a manner of action or circumstance; in this way, in such a manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "Used to indicate manner or way of doing something."
                            },
                            {
                                "target_lang_word": "thus",
                                "target_lang_sense_clarification": "Formal way to indicate manner or way of doing something."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48352c25-9b8e-397f-9994-649bb66db1c8",
                    "sense_definition": "Указывает на высокую степень проявления признака или действия; очень, настолько.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <так> устал после работы.",
                            "target_lang_translations": {
                                "en": "I am <so> tired after work."
                            }
                        },
                        {
                            "text": "Это не <так> сложно, как кажется на первый взгляд.",
                            "target_lang_translations": {
                                "en": "It is not <so> difficult as it seems at first glance."
                            }
                        },
                        {
                            "text": "Он <так> быстро бежал, что никто не мог его догнать.",
                            "target_lang_translations": {
                                "en": "He ran <so> fast that no one could catch him."
                            }
                        }
                    ],
                    "synonyms": [
                        "очень",
                        "настолько",
                        "столь",
                        "сильно"
                    ],
                    "common_phrases": [
                        "так много",
                        "так быстро",
                        "так сильно",
                        "так долго"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates a high degree of a quality or action; very, to such an extent."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "Used to emphasize the degree of an adjective or adverb."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5975d21b-1e94-3879-a675-b3e3dab5c883",
                    "sense_definition": "Указывает на сходство степени или образа действия при сравнении (обычно в конструкции «так ..., как ...»).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Никто не знает этот город <так>, как я.",
                            "target_lang_translations": {
                                "en": "No one knows this city <as> I do."
                            }
                        },
                        {
                            "text": "Она выглядит <так> же красиво, как на фотографиях.",
                            "target_lang_translations": {
                                "en": "She looks <as> beautiful as in the photos."
                            }
                        }
                    ],
                    "synonyms": [
                        "столь же",
                        "одинаково",
                        "настолько"
                    ],
                    "common_phrases": [
                        "так же как",
                        "не так как"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates similarity in degree or manner when comparing (usually in the construction 'as ... as ...')."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "Used in comparisons to indicate equality."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "166ae943-a4d2-338e-a20a-6516df68e55f",
                    "sense_definition": "Без особой цели, причины или последствий; просто, даром.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gratuitous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я зашёл к тебе не по делу, а просто <так>.",
                            "target_lang_translations": {
                                "en": "I didn't come to see you for any reason, just <so>."
                            }
                        },
                        {
                            "text": "Это тебе <так> не сойдёт с рук.",
                            "target_lang_translations": {
                                "en": "You won't get away with it <just like that>."
                            }
                        }
                    ],
                    "synonyms": [
                        "просто",
                        "даром"
                    ],
                    "common_phrases": [
                        "просто так"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Without a specific purpose, reason, or consequence; just, for nothing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "Used to indicate lack of specific purpose."
                            },
                            {
                                "target_lang_word": "for no reason",
                                "target_lang_sense_clarification": "Used to indicate lack of cause."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "fe834afd-bb69-3b26-a003-d65563b82a1f",
                    "sense_definition": "Выражает согласие, подтверждение или готовность слушать дальше.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Так>, я вас внимательно слушаю.",
                            "target_lang_translations": {
                                "en": "<Right>, I am listening to you carefully."
                            }
                        },
                        {
                            "text": "Всё <так>, вы абсолютно правы.",
                            "target_lang_translations": {
                                "en": "That is <so>, you are absolutely right."
                            }
                        }
                    ],
                    "synonyms": [
                        "хорошо",
                        "ладно",
                        "да",
                        "верно",
                        "именно",
                        "точно\"",
                        "точно"
                    ],
                    "antonyms": [
                        "нет"
                    ],
                    "common_phrases": [
                        "так точно",
                        "всё так"
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses agreement, confirmation, or readiness to listen further."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "Used to signal readiness or agreement."
                            },
                            {
                                "target_lang_word": "exactly",
                                "target_lang_sense_clarification": "Used to confirm agreement."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21dd7feb-5716-3abf-a83e-c0c96b6c3176",
                    "sense_definition": "Вводное слово, употребляется в начале фразы для перехода к объяснению, перечислению или выводу.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "introductory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Так>, с этим вопросом мы разобрались.",
                            "target_lang_translations": {
                                "en": "<So>, we have dealt with this issue."
                            }
                        },
                        {
                            "text": "<Так>, например, многие птицы улетают на юг.",
                            "target_lang_translations": {
                                "en": "<So>, for example, many birds fly south."
                            }
                        }
                    ],
                    "synonyms": [
                        "итак",
                        "например"
                    ],
                    "common_phrases": [
                        "так вот",
                        "так например"
                    ],
                    "target_lang_definitions": {
                        "en": "Introductory word used at the beginning of a phrase to transition to an explanation, list, or conclusion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "Used to introduce a new topic or transition."
                            },
                            {
                                "target_lang_word": "now",
                                "target_lang_sense_clarification": "Used to signal a shift in discourse."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07e72c42-aaaf-3dd0-8ca3-6d975ea2d79c",
                    "sense_definition": "Указывает на приблизительное количество, время или меру (обычно ставится между существительным и числительным).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "approximation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От вокзала до дома идти километров <так> пять.",
                            "target_lang_translations": {
                                "en": "It is <about> five kilometers from the station to the house."
                            }
                        },
                        {
                            "text": "Это случилось лет <так> десять назад.",
                            "target_lang_translations": {
                                "en": "It happened <about> ten years ago."
                            }
                        }
                    ],
                    "synonyms": [
                        "примерно",
                        "около",
                        "приблизительно"
                    ],
                    "antonyms": [
                        "ровно",
                        "точно"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates an approximate quantity, time, or measure (usually placed between a noun and a numeral)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "about",
                                "target_lang_sense_clarification": "Used to indicate approximation."
                            },
                            {
                                "target_lang_word": "around",
                                "target_lang_sense_clarification": "Used to indicate approximation."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca7c0cee-a7bd-3293-b72b-48de0c401173",
                    "sense_definition": "Употребляется как уклончивый ответ, означающий «ничего особенного» или «неважно».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dismissive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Что ты ищешь? — Да <так>, ерунду какую-то.",
                            "target_lang_translations": {
                                "en": "— What are you looking for? — Oh, <nothing much>, just some nonsense."
                            }
                        },
                        {
                            "text": "— О чём вы говорили? — <Так>, о погоде.",
                            "target_lang_translations": {
                                "en": "— What were you talking about? — <Just>, about the weather."
                            }
                        }
                    ],
                    "synonyms": [
                        "ничего"
                    ],
                    "common_phrases": [
                        "да так"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used as an evasive answer meaning 'nothing special' or 'it doesn't matter'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nothing much",
                                "target_lang_sense_clarification": "Used to dismiss a question."
                            },
                            {
                                "target_lang_word": "just something",
                                "target_lang_sense_clarification": "Used to provide a vague answer."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "591c4c98-2144-35f9-82b2-ec5d0785f266",
                    "sense_definition": "В таком случае, тогда (выражает следствие или условие).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Раз обещал, <так> сделай.",
                            "target_lang_translations": {
                                "en": "Since you promised, <then> do it."
                            }
                        },
                        {
                            "text": "Хочешь помочь, <так> помоги делом, а не словами.",
                            "target_lang_translations": {
                                "en": "If you want to help, <then> help with actions, not words."
                            }
                        }
                    ],
                    "synonyms": [
                        "тогда",
                        "в таком случае",
                        "значит"
                    ],
                    "common_phrases": [
                        "раз так",
                        "коли так"
                    ],
                    "target_lang_definitions": {
                        "en": "In that case, then (expresses a consequence or condition)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "Used to express a logical consequence."
                            },
                            {
                                "target_lang_word": "in that case",
                                "target_lang_sense_clarification": "Used to express a conditional consequence."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70f969f8-4f83-37f1-8428-83694783cc82",
                    "sense_definition": "Употребляется как вторая часть двойного союза «как..., так и...» для соединения однородных членов.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "correlation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это полезно как молодым, <так> и старым.",
                            "target_lang_translations": {
                                "en": "It is useful to both the young <as well as> the old."
                            }
                        },
                        {
                            "text": "В магазине продаются как овощи, <так> и фрукты.",
                            "target_lang_translations": {
                                "en": "The store sells both vegetables <as well as> fruits."
                            }
                        }
                    ],
                    "common_phrases": [
                        "как ... так и"
                    ],
                    "target_lang_definitions": {
                        "en": "Used as the second part of the double conjunction 'both... and...' to connect homogeneous members."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as well as",
                                "target_lang_sense_clarification": "Used to connect two items."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1846267-c947-312f-9022-7ff862d87441",
                    "sense_definition": "Но, однако (выражает противопоставление).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я бы поехал, <так> денег нет.",
                            "target_lang_translations": {
                                "en": "I would go, <but> I have no money."
                            }
                        },
                        {
                            "text": "Хотел купить хлеба, <так> магазин был закрыт.",
                            "target_lang_translations": {
                                "en": "I wanted to buy bread, <but> the store was closed."
                            }
                        }
                    ],
                    "synonyms": [
                        "но",
                        "однако"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "But, however (expresses contrast)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "but",
                                "target_lang_sense_clarification": "Used to express contrast."
                            },
                            {
                                "target_lang_word": "however",
                                "target_lang_sense_clarification": "Used to express contrast."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c563b9c1-ab36-3fb9-bcf4-ba649c376583",
                    "sense_definition": "Не очень хороший, посредственный, среднего качества.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mediocre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Фильм оказался <так>, на один раз.",
                            "target_lang_translations": {
                                "en": "The movie was <so-so>, good for one viewing."
                            }
                        },
                        {
                            "text": "По вкусу этот суп... ну <так>, средненько.",
                            "target_lang_translations": {
                                "en": "The taste of this soup is... well <so-so>, average."
                            }
                        }
                    ],
                    "synonyms": [
                        "так себе",
                        "посредственный",
                        "средний"
                    ],
                    "antonyms": [
                        "отличный",
                        "превосходный"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Not very good, mediocre, of average quality."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so-so",
                                "target_lang_sense_clarification": "Used to describe mediocre quality."
                            },
                            {
                                "target_lang_word": "mediocre",
                                "target_lang_sense_clarification": "Used to describe average or poor quality."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}