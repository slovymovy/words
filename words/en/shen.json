                    "sense_id": "326346fe-4c58-32f4-a65b-2722f8c151e7",
                    "sense_definition": "A surname of Chinese origin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Shen</w> published a groundbreaking study on ancient history last year.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Шэнь</w> опубликовал в прошлом году новаторское исследование по древней истории."
                            }
                        },
                        {
                            "text": "The <w>Shen</w> family has lived in this neighborhood for three generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Шэнь</w> живет в этом районе уже три поколения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Chinese origin"
                        }
                    ],
                    "target_lang_definitions": {
