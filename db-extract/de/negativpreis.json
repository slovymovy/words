                "senses": [
                    {
                        "sense_id": "2e7dc052-6935-3e58-a287-360caee3c72b",
                        "entry_id": "96995ea7-7dc4-399b-b653-a70c0d4ca4b0",
                        "glosses": [
                            "eine Art Auszeichnung, die eine Person oder Institution verleiht und damit den Preisträger öffentlich kritisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e3ecfc-e517-411b-9368-51c9cf7499a0",
                                "sense_id": "2e7dc052-6935-3e58-a287-360caee3c72b",
                                "text": "Nicht jeder Preisträger des bekannten Negativpreises Goldene Himbeere nimmt die vermeintliche Ehrung auch entgegen."
                            },
                            {
                                "example_id": "5f10f011-898a-4c16-892f-af393cb11a06",
                                "sense_id": "2e7dc052-6935-3e58-a287-360caee3c72b",
                                "text": "„Der Konzern war deswegen sogar ein Favorit für den Public Eye Award 2012. Greenpeace und die Gruppe Erklärung von Bern vergeben den Negativpreis jedes Jahr für krasse Missachtungen von Umweltschutz und Menschenrechten durch Unternehmen.“"
                            },
                            {
                                "example_id": "ab3f11c1-49b6-4ada-afb4-235dd2ba928f",
                                "sense_id": "2e7dc052-6935-3e58-a287-360caee3c72b",
                                "text": "Helfen Negativpreise wirklich Missstände zu verbessern?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
