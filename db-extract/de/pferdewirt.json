                "senses": [
                    {
                        "sense_id": "047d1f57-9fe3-3943-81fd-5f841def43c2",
                        "entry_id": "5e961f83-b7dd-3c99-aeb0-b979a0d5f8eb",
                        "glosses": [
                            "jemand, der für Pferdehaltung, Pferdezucht, Pferdeausbildung und Pferdesport ausgebildet wurde und diese Tätigkeiten als Beruf ausübt"
                        ],
                        "tags": [
                            "Berufsbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "ea800d2c-f5a8-4f3b-a1eb-e2f134736b79",
                                "sense_id": "047d1f57-9fe3-3943-81fd-5f841def43c2",
                                "text": "Der Beruf des Pferdewirtes / der Pferdewirtin ist vielseitig und abwechslungsreich."
                            },
                            {
                                "example_id": "bd2e5d8b-2331-490a-af91-3e0bc49588c3",
                                "sense_id": "047d1f57-9fe3-3943-81fd-5f841def43c2",
                                "text": "Pferdewirte und Pferdewirtinnen der Fachrichtung Pferdezucht züchten z.B. Renn-, Reit- oder Arbeitspferde, betreuen Pferde, bilden sie aus und stellen sie bei Zuchtschauen und Prüfungen vor."
                            },
                            {
                                "example_id": "1f705604-4e1f-419d-b97a-2ef523d497a5",
                                "sense_id": "047d1f57-9fe3-3943-81fd-5f841def43c2",
                                "text": "Das ist aber noch lange nicht alles: Einen Großteil der Arbeit von Pferdewirten machen Aufgaben wie Ausmisten und Fegen aus."
                            },
                            {
                                "example_id": "06272b8d-805b-4947-a46c-6fa32a8cf435",
                                "sense_id": "047d1f57-9fe3-3943-81fd-5f841def43c2",
                                "text": "Pferdewirt ist ein Job mit Zukunft."
                            },
                            {
                                "example_id": "bc069575-035c-4e77-b262-a5118f177c7a",
                                "sense_id": "047d1f57-9fe3-3943-81fd-5f841def43c2",
                                "text": "In Kooperation mit der landwirtschaftlichen Fachschule Grottenhof-Hardt bieten wir zeitgleich eine AHS-Matura und eine Ausbildung zur Facharbeiterin/ zum Facharbeiter für Pferdewirtschaft (Pferdewirt) an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
