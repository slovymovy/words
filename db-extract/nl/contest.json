                        "sense_id": "371a8e4f-d98b-314f-8a81-d4f5bddcd5d1",
                        "entry_id": "94cd5409-9760-3284-998d-05eb05a8e9f2",
                        "glosses": [
                            "wedstrijd in de vorm van een show waarin mensen laten zien wat ze kunnen en een jury beslist wie de beste prestatie heeft geleverd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b8cace4-fedb-4b44-a313-fbe3adfa73d2",
                                "sense_id": "371a8e4f-d98b-314f-8a81-d4f5bddcd5d1",
                                "text": "Tijdens de Marching & Music contest en Showconcours in Schiedam heeft Show- en Marchingband EVC Enschede dit weekeinde een eerste prijs behaald."
                            },
                            {
                                "example_id": "c1ae8904-259e-4163-a253-0168fcd87d5a",
                                "sense_id": "371a8e4f-d98b-314f-8a81-d4f5bddcd5d1",
                                "text": "Tientallen toeschouwers zien om 16.00 uur de eerste band het podium betreden in de bosrijke omgeving van het Forest Hill Festival. De veelal jonge talenten doen mee aan de Twenterand Contest, een nieuw onderdeel tijdens de derde editie van het Vroomshoopse evenement."
                            },
                            {
                                "example_id": "3da4d750-48f3-4867-8556-60d76fbbcd13",
                                "sense_id": "371a8e4f-d98b-314f-8a81-d4f5bddcd5d1",
                                "text": "Studenten hadden voldoende te doen. Zij konden bijvoorbeeld kiezen om deel te nemen aan een dj-contest of workshops in zelfverdediging volgen. Ook leefden studenten zich uit op de grootste stormbaan van Nederland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
