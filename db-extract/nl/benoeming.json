                "senses": [
                    {
                        "sense_id": "ac6311f5-12bb-375e-b7cc-c2cbceade122",
                        "entry_id": "7c536a3a-8ace-324a-b17b-2995825f6506",
                        "glosses": [
                            "het toewijzen van een ambt aan iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6c38b66-f84b-4dcb-a76d-97b79d70aa9e",
                                "sense_id": "ac6311f5-12bb-375e-b7cc-c2cbceade122",
                                "text": "Er volgden nog een aantal benoemingen van ministers en staatssecretarissen."
                            },
                            {
                                "example_id": "45de7f30-da0b-489f-8ca1-2b4b96622d7b",
                                "sense_id": "ac6311f5-12bb-375e-b7cc-c2cbceade122",
                                "text": "Reuvens was tegelijk met zijn benoeming tot directeur ook bijzonder hoogleraar archeologie in Leiden geworden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e8647a5-e177-4fcb-aec7-42259e0f58d8",
                        "source_entry_id": "7c536a3a-8ace-324a-b17b-2995825f6506",
                        "source_sense_id": "ac6311f5-12bb-375e-b7cc-c2cbceade122",
                        "source_sense_description": "het toewijzen van een ambt aan iemand",
                        "target_lang_word": "Berufung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berufung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11902957-38e2-3017-a3c8-f38e0fefb814",
                                        "entry_id": "c678b771-df47-374e-91f0-a040e30e5ccd",
                                        "glosses": [
                                            "besondere Befähigung, die jemand als Auftrag empfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d84cd1b4-f8d0-4de2-88f6-d7b6ebff5785",
                                                "sense_id": "11902957-38e2-3017-a3c8-f38e0fefb814",
                                                "text": "„Aber unter den bösen, häßlichen Worten wachte etwas in mir auf, froh und stark; und das war der Glaube an mich, an mein Können, meine innere Berufung und an meinen endlichen Sieg über alle Hindernisse.“"
                                            },
                                            {
                                                "example_id": "c1e47b89-c832-417f-95a3-ab73a4d25b26",
                                                "sense_id": "11902957-38e2-3017-a3c8-f38e0fefb814",
                                                "text": "„Denn ich hielt mich für verpflichtet, ihn davon zu überzeugen, daß ich die Laufbahn eines Gottesdieners nicht aus Berufung gewählt hatte.“"
                                            },
                                            {
                                                "example_id": "b9690a99-d2ae-40b4-bd4d-af09bd5401fa",
                                                "sense_id": "11902957-38e2-3017-a3c8-f38e0fefb814",
                                                "text": "„Um in ein Amt berufen zu werden, reicht für Calvin – wie für Luther und die anderen Reformatoren im Unterschied zu manchen \"Schwärmern\" – die \"innere Berufung\" (vocatio interna vel arcana) durch den Heiligen Geist und das Gewissen nicht aus. Damit alles ordnungsgemäß zugehe, muß die \"äußere Berufung\" (vocatio externa) durch die Gemeinde hinzukommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fe11df9f-5bea-39c8-83a5-76cfe1c68906",
                                        "entry_id": "c678b771-df47-374e-91f0-a040e30e5ccd",
                                        "glosses": [
                                            "Verweis auf jemanden oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e0344b8-21c8-4369-878a-4776f72cba0b",
                                                "sense_id": "fe11df9f-5bea-39c8-83a5-76cfe1c68906",
                                                "text": "„Als er wieder zu sich kam, war er gebunden und mußte, trotz seines Passes und seiner Berufung auf Theopompus, den Häschern folgen.“"
                                            },
                                            {
                                                "example_id": "8833add9-a8a8-4356-be2a-065922a9a95f",
                                                "sense_id": "fe11df9f-5bea-39c8-83a5-76cfe1c68906",
                                                "text": "„Der behutsamste Tadel der Maßregeln des Hofes, der kleinste Seufzer, den das Mitleiden mit sich selbst einem Unrecht leidenden Scheschianer auspreßte, die leiseste Berufung auf die Rechte der Menschheit, war ein Majestätsverbrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ff20f6b9-1950-3af7-a902-7eba43819c3e",
                                        "entry_id": "c678b771-df47-374e-91f0-a040e30e5ccd",
                                        "glosses": [
                                            "Rechtsmittel gegen einen Bescheid oder ein Gerichtsurteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64dedab6-b744-417f-bff5-98e92b6b77b4",
                                                "sense_id": "ff20f6b9-1950-3af7-a902-7eba43819c3e",
                                                "text": "„Jeder einzelne Deputierte bestieg die Rednertribüne und sprach eines der vier Urteile: Gefängnis; Deportation; Todesstrafe mit Aufschub oder Berufung an das Volk; Todesstrafe ohne Aufschub, ohne Berufung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cd103d2a-9f84-3b27-9bd7-26afba933f72",
                                        "entry_id": "c678b771-df47-374e-91f0-a040e30e5ccd",
                                        "glosses": [
                                            "Ernennung in ein öffentliches Amt von Kirche oder Staat (zum Beispiel Höchstrichter, Priester, Universitätsprofessor) oder Anstellung eines Künstlers (zum Beispiel Dirigent, Theaterdirektor, Schauspieler, Musiker)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f566b787-8590-4bb4-9e98-4386bf33ae41",
                                                "sense_id": "cd103d2a-9f84-3b27-9bd7-26afba933f72",
                                                "text": "„Um in ein Amt berufen zu werden, reicht für Calvin – wie für Luther und die anderen Reformatoren im Unterschied zu manchen \"Schwärmern\" – die \"innere Berufung\" (vocatio interna vel arcana) durch den Heiligen Geist und das Gewissen nicht aus. Damit alles ordnungsgemäß zugehe, muß die \"äußere Berufung\" (vocatio externa) durch die Gemeinde hinzukommen.“"
                                            },
                                            {
                                                "example_id": "6e7de19f-50e4-4fd2-a7ee-c5994e703d85",
                                                "sense_id": "cd103d2a-9f84-3b27-9bd7-26afba933f72",
                                                "text": "„Zu den Höhepunkten seiner Karriere zählt die Berufung durch Max Reinhardt als Regisseur an das Deutsche Theater in Berlin (1906/07) sowie die Leitung des Burgtheaters in Salzburg (1918).“"
                                            },
                                            {
                                                "example_id": "f76d3221-1612-4c2d-ba49-2472aab3e44e",
                                                "sense_id": "cd103d2a-9f84-3b27-9bd7-26afba933f72",
                                                "text": "„Der hochwürdige Herr Prälat wollte ihm durch diese Berufung zum Lehrer sein Vertrauen erweisen, wollte ihn dadurch auszeichnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5ff9cae-6ff6-4413-af43-f131b5c9f930",
                        "source_entry_id": "7c536a3a-8ace-324a-b17b-2995825f6506",
                        "source_sense_id": "ac6311f5-12bb-375e-b7cc-c2cbceade122",
                        "source_sense_description": "het toewijzen van een ambt aan iemand",
                        "target_lang_word": "Ernennung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ernennung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6885ef02-1f8c-3314-aea2-848d29985729",
                                        "entry_id": "1774ba87-c939-3730-87ae-af13a5ba1ed2",
                                        "glosses": [
                                            "Verleihung eines Titels oder Status"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e0236b-39bf-41ee-a756-116f2058149b",
                                                "sense_id": "6885ef02-1f8c-3314-aea2-848d29985729",
                                                "text": "Noch am Tag seiner Ernennung beschloss er grundlegende Maßnahmen."
                                            },
                                            {
                                                "example_id": "6eb12aa9-e686-402d-96b4-00e5ddbcd8ff",
                                                "sense_id": "6885ef02-1f8c-3314-aea2-848d29985729",
                                                "text": "„Im Vorjahr hatte er durch die Ernennung des konservativen Juristen Neil Gorsuch das zuvor bestehende Patt zwischen vier liberalen und vier konservativen Höchstrichtern aufgehoben.“"
                                            },
                                            {
                                                "example_id": "6c8edce8-29b7-4aae-b9fe-0b48d2130845",
                                                "sense_id": "6885ef02-1f8c-3314-aea2-848d29985729",
                                                "text": "„Lai-bau zog darauf die aus zwei Bogen bestehende bedruckte Anstellungsurkunde und die von den Ministerien des Innern und des Krieges ausgefertigten Bestätigungen der Ernennungen hervor und legte sie auf den Tisch.“"
                                            },
                                            {
                                                "example_id": "7ed91cd5-0c55-46a5-adfa-ad01f91b2438",
                                                "sense_id": "6885ef02-1f8c-3314-aea2-848d29985729",
                                                "text": "„Tatsächlich führte die Ernennung der neuen Professoren zunächst zu einem Aufschwung des Vorlesungswesens, auch die Zahl der Studierenden stieg an.“"
                                            },
                                            {
                                                "example_id": "077b0071-0080-4a96-b481-a42a99e7484f",
                                                "sense_id": "6885ef02-1f8c-3314-aea2-848d29985729",
                                                "text": "„Die Ernennung Hitlers zum Reichskanzler scheint er kaum bemerkt zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
