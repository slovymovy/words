    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "85898991-2e45-3c8c-b7d5-8a921935dcc6",
                    "sense_definition": "met feiten of argumenten aantonen dat iets waar is",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aantonen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De advocaat probeerde de onschuld van zijn cliënt te <w>bewijzen</w>.",
                            "target_lang_translations": {
                                "en": "The lawyer tried to <w>prove</w> his client's innocence."
                            }
                        },
                        {
                            "text": "Je moet je <w>stelling</w> <w>bewijzen</w> met duidelijke cijfers en feiten.",
                            "target_lang_translations": {
                                "en": "You must <w>prove</w> your thesis with clear figures and facts."
                            }
                        }
                    ],
                    "synonyms": [
                        "aantonen"
                    ],
                    "common_phrases": [
                        "stelling bewijzen",
                        "onschuld bewijzen",
                        "tegendeel bewijzen"
                    ],
                    "target_lang_definitions": {
                        "en": "To demonstrate that something is true or valid using facts or arguments"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prove",
                                "target_lang_sense_clarification": "to demonstrate truth with evidence"
                            },
                            {
                                "target_lang_word": "demonstrate",
                                "target_lang_sense_clarification": "to show clearly by giving proof"
                            },
                            {
                                "target_lang_word": "substantiate",
                                "target_lang_sense_clarification": "to provide evidence to support a claim"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d7914f8-6700-395e-aa35-c58f69774993",
                    "sense_definition": "laten zien dat men over bepaalde kwaliteiten of vaardigheden beschikt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tonen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe werknemer heeft <w>zich</w> in zijn proefperiode voldoende <w>bewezen</w>.",
                            "target_lang_translations": {
                                "en": "The new employee has sufficiently <w>proven</w> himself during his trial period."
                            }
                        },
                        {
                            "text": "Hij wilde <w>zichzelf</w> <w>bewijzen</w> door de moeilijkste opdracht aan te nemen.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>prove</w> himself by taking on the most difficult task."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich bewijzen"
                    ],
                    "target_lang_definitions": {
                        "en": "To show that one possesses certain qualities or skills through actions"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prove oneself",
                                "target_lang_sense_clarification": "to show one's worth or ability"
                            },
                            {
                                "target_lang_word": "show one's mettle",
                                "target_lang_sense_clarification": "to demonstrate ability in a difficult situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e2f47e6-7370-306d-b86b-493c1cf742be",
                    "sense_definition": "iemand een gunst of eer betonen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verlenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zou je mij een <w>dienst</w> kunnen <w>bewijzen</w> door dit pakketje te posten?",
                            "target_lang_translations": {
                                "en": "Could you <w>do</w> me a favor by posting this package?"
                            }
                        },
                        {
                            "text": "Zij wilden de overleden koning de laatste <w>eer</w> <w>bewijzen</w>.",
                            "target_lang_translations": {
                                "en": "They wanted to <w>pay</w> their last respects to the deceased king."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dienst bewijzen",
                        "eer bewijzen",
                        "gunst bewijzen"
                    ],
                    "target_lang_definitions": {
