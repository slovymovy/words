{
    "word": "beslotenheid",
    "lang_code": "nl",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "cd7180a1-a103-3797-b644-3fe6c7071350",
                "word": "beslotenheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "9dc9c13a-1688-4065-825d-46ba0fbf4da1",
                        "entry_id": "cd7180a1-a103-3797-b644-3fe6c7071350",
                        "tags": [
                            "plural"
                        ],
                        "form": "beslotenheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5101fae-5b82-3b1b-b26f-a4374cd58912",
                        "entry_id": "cd7180a1-a103-3797-b644-3fe6c7071350",
                        "glosses": [
                            "de niet-openbare privésfeer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcc42d5b-2eae-44a3-93ad-080177f5904b",
                                "sense_id": "f5101fae-5b82-3b1b-b26f-a4374cd58912",
                                "text": "Zij doodde de tijd met het huishouden — hun huis was zelfs onder haar onervaren handen al snel aan kant — en ze breide en haakte aan de babyuitzet. In de beslotenheid van haar woning bleef ze met Dymphna praten."
                            },
                            {
                                "example_id": "6be59928-1ae8-4447-9831-0617702302af",
                                "sense_id": "f5101fae-5b82-3b1b-b26f-a4374cd58912",
                                "text": "Khalid Kasem reageert namens de familie Nouri: \"We betreuren het zeer dat we elkaar niet kunnen vinden. Want de familie had de voorkeur om in beslotenheid van partijen tot een vergelijk te komen.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "34693a73-220b-34a9-9719-33fd70dfd6f5",
                        "entry_id": "cd7180a1-a103-3797-b644-3fe6c7071350",
                        "glosses": [
                            "het afgesloten zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9835a3c-cd0a-4f89-90f9-e07727bcff48",
                                "sense_id": "34693a73-220b-34a9-9719-33fd70dfd6f5",
                                "text": "Het incident gaf volgens de rechter andere passagiers en bemanningsleden een onveilig gevoel. \"De beslotenheid van het luchtvaartuig in vlucht waarin men zich op dat moment bevindt, maakt immers dat men zich niet aan de ontstane situatie kan onttrekken.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "4f799456-884b-330c-8edc-2985f0032f25",
                        "entry_id": "cd7180a1-a103-3797-b644-3fe6c7071350",
                        "glosses": [
                            "de mate waarin men weet wat men wil"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89cfb29f-1987-411f-bc15-590212ed57a3",
                        "source_entry_id": "cd7180a1-a103-3797-b644-3fe6c7071350",
                        "source_sense_id": "f5101fae-5b82-3b1b-b26f-a4374cd58912",
                        "source_sense_description": "de niet-openbare privésfeer",
                        "target_lang_word": "privacy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "privacy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "313cc9f4-6e3c-3059-a2be-2984bcb244ec",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "The state of being secluded from the presence, sight, or knowledge of others."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd1d6ce4-ca51-4123-8a45-9fae37123fa1",
                                                "sense_id": "313cc9f4-6e3c-3059-a2be-2984bcb244ec",
                                                "text": "I need my privacy, so please stay out of my room."
                                            },
                                            {
                                                "example_id": "50bd5f3e-387c-48c9-90c3-8098210a7627",
                                                "sense_id": "313cc9f4-6e3c-3059-a2be-2984bcb244ec",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers,[…]. Even such a boat as the Mount Vernon offered a total deck space so cramped as to leave secrecy or privacy well out of the question, even had the motley and democratic assemblage of passengers been disposed to accord either."
                                            },
                                            {
                                                "example_id": "8bc80b0a-7be9-49ac-8c84-f77766e18e67",
                                                "sense_id": "313cc9f4-6e3c-3059-a2be-2984bcb244ec",
                                                "text": "It is realised that the old Pullman standard sleeper, with its convertible \"sections\", each containing upper and lower berths, and with no greater privacy at night than the curtains drawn along both sides of a middle aisle, has had its day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbe917e7-32b9-325c-9247-c788a9e161ea",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "Freedom from unwanted or undue disturbance of one's private life."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd3b0435-5799-4054-b2e9-0a9949127153",
                                                "sense_id": "cbe917e7-32b9-325c-9247-c788a9e161ea",
                                                "text": "It takes a village to rob one of a sense of privacy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c986a82-281d-351f-937c-f6d05000e999",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "Freedom from damaging publicity, public scrutiny, surveillance, and disclosure of personal information, usually by a government or a private organization."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "260e5727-05ad-49c4-8a02-e620fa324413",
                                                "sense_id": "0c986a82-281d-351f-937c-f6d05000e999",
                                                "text": "Privacy is assumed by many to be among common-law rights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f62a2e7-f7bf-3e23-a402-52a5f71843f8",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "A place of seclusion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92c6d585-71d4-3b89-84b7-ae7f8f0eba71",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "A relationship between parties seen as being a result of their mutual interest or participation in a given transaction, contract etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86afa88f-e1a6-3d3b-8025-116fc5582700",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "Secrecy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2f90340-0085-3325-a80e-e127bcd94a02",
                                        "entry_id": "77a77e17-50f3-384b-b27f-d7f5ba772147",
                                        "glosses": [
                                            "A private matter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b792e945-96d9-4af2-be69-3a580fa154ec",
                                                "sense_id": "d2f90340-0085-3325-a80e-e127bcd94a02",
                                                "text": "It ſeems more probable that Ovid vvas either the Confident of ſome other paſſion, or that he had ſtumbled by ſome inadvertency, upon the privacies of Livia, and ſeen her in a Bath: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "968ccb1b-ad81-4ec6-87fb-dd60c908e67b",
                        "source_entry_id": "cd7180a1-a103-3797-b644-3fe6c7071350",
                        "source_sense_id": "34693a73-220b-34a9-9719-33fd70dfd6f5",
                        "source_sense_description": "het afgesloten zijn",
                        "target_lang_word": "enclosure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enclosure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "151f9826-bb69-368f-8625-c20ccb31d047",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "Something that is enclosed, i.e. inserted into a letter or similar package."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d23d2daa-46a9-49c8-85fe-b378594dc69d",
                                                "sense_id": "151f9826-bb69-368f-8625-c20ccb31d047",
                                                "text": "There was an enclosure with the letter — a photo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b20a430-e32e-3eb1-b490-e34894f09cb3",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "The act of enclosing, i.e. the insertion or inclusion of an item in a letter or package."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1513f58d-c82a-49fd-a21e-1aa8a937dff3",
                                                "sense_id": "1b20a430-e32e-3eb1-b490-e34894f09cb3",
                                                "text": "The enclosure of a photo with your letter is appreciated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7768611b-4b0c-3d08-8a18-72e60da4fc5b",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "An area, domain, or amount of something partially or entirely enclosed by barriers."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b2648ca-241d-4c2f-a659-acc3925b2807",
                                                "sense_id": "7768611b-4b0c-3d08-8a18-72e60da4fc5b",
                                                "text": "He faced punishment for creating the fenced enclosure in a public park."
                                            },
                                            {
                                                "example_id": "3d122d0c-5725-491f-968a-24e9fc6f7923",
                                                "sense_id": "7768611b-4b0c-3d08-8a18-72e60da4fc5b",
                                                "text": "The glass enclosure holds the mercury vapor."
                                            },
                                            {
                                                "example_id": "5485671a-f98d-421e-b265-a284ba6b2fbf",
                                                "sense_id": "7768611b-4b0c-3d08-8a18-72e60da4fc5b",
                                                "text": "The winning horse was first into the unsaddling enclosure."
                                            },
                                            {
                                                "example_id": "50237a83-5589-46c1-af3e-7bfa9941cdd6",
                                                "sense_id": "7768611b-4b0c-3d08-8a18-72e60da4fc5b",
                                                "text": "And the village was deserted, the huts gaped black, rotting, all askew within the fallen enclosures."
                                            },
                                            {
                                                "example_id": "1ce39b6e-af1d-4e41-8b59-678e385aa01c",
                                                "sense_id": "7768611b-4b0c-3d08-8a18-72e60da4fc5b",
                                                "text": "Away from the village, there was an enclosure containing several large animals of a kind I had not seen before—shaggy, long-necked, small-headed creatures who stood or lay at ease around their pen. Alpacas?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6a8ed05-3c46-30c0-9902-cef07c4a4801",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "The act of separating and surrounding an area, domain, or amount of something with a barrier."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20dfc6b4-32c6-41e7-9de1-9ae9a0c849e9",
                                                "sense_id": "a6a8ed05-3c46-30c0-9902-cef07c4a4801",
                                                "text": "The enclosure of public land is against the law."
                                            },
                                            {
                                                "example_id": "183272bd-fc9e-43ea-ada8-c137f3126034",
                                                "sense_id": "a6a8ed05-3c46-30c0-9902-cef07c4a4801",
                                                "text": "The experiment requires the enclosure of mercury vapor in a glass tube."
                                            },
                                            {
                                                "example_id": "608b35bd-7acf-42cf-a6fa-9ddcb943c00a",
                                                "sense_id": "a6a8ed05-3c46-30c0-9902-cef07c4a4801",
                                                "text": "At first, untrained horses resist enclosure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b09b7577-2a30-3b88-9b4e-fed2961b775c",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "The act of restricting access to ideas, works of art or technologies using patents or intellectual property laws."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d8c1a2b-094f-4edf-846d-b8686417df8a",
                                                "sense_id": "b09b7577-2a30-3b88-9b4e-fed2961b775c",
                                                "text": "Copyright, from day one, was designed to be both an impediment and an incentive, a mechanism of enclosure (one that prevented the unlicensed printing of texts, thereby limiting access) and a catalyst of sorts, a structure to stimulate the production of literary goods by rewarding writers and publishers for their labor."
                                            },
                                            {
                                                "example_id": "ca7ed2ba-bf8e-4ddd-9fbf-6356214c9967",
                                                "sense_id": "b09b7577-2a30-3b88-9b4e-fed2961b775c",
                                                "text": "The commons evokes resistance to “enclosure” in all its forms, whether in its early proto-capitalist form of fencing in commonly shared land, or in its contemporary forms of marshalling judicial restraints such as “patent” and “intellectual property” to police the ownership of ideas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca555879-8ea0-3538-8264-fedaa0632e0d",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "The post-feudal process of subdivision of common lands for individual ownership."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a15fb7c5-60ac-4e77-acbe-4d82117b64c0",
                                                "sense_id": "ca555879-8ea0-3538-8264-fedaa0632e0d",
                                                "text": "Strip-farming disappeared after enclosure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f045d811-99de-343e-889e-a20adcc1b6f4",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "The area of a convent, monastery, etc where access is restricted to community members."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
