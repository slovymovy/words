                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95545c3a-239d-41e8-89f4-e02d8a519ae3",
                                "sense_id": "3c484169-f307-3e4a-a0cf-3a1103c4e73d",
                                "text": "„Jeder geht bei der Mittags- und/oder Nachmittagspause – wenn möglich – in seinen Raum und auf Zeichen treffen sich alle wieder und besprechen den Rest des Tages.“"
                            },
                            {
                                "example_id": "665357ef-72cd-4f37-a085-798fd80bccb7",
                                "sense_id": "3c484169-f307-3e4a-a0cf-3a1103c4e73d",
                                "text": "„Auch in anderen Werkgruppen werden Beschäftigte mit derartigen Aufgaben betreut, vor allem für die Nachmittagspause, in der Getränke von der Großküche für alle Werkgruppen zur Verfügung gestellt werden.“"
                            }
                        ],
