                ],
                "senses": [
                    {
                        "sense_id": "02cab275-296d-3cf9-85d1-db147e3a2396",
                        "entry_id": "000f5e7b-350f-3b5f-9c4c-003c95579c37",
                        "glosses": [
                            "Horn am Kopf eines Teufels/Dämons"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96cfd9cb-4af7-4d7f-98c2-e2bfef7da689",
                                "sense_id": "02cab275-296d-3cf9-85d1-db147e3a2396",
                                "text": "„Sein kaputtes blondes Haar steht ihm steif und rot wie Teufelshörner von der Stirn ab.“"
                            },
                            {
                                "example_id": "0c24b16f-260f-48e9-af2b-7f0493ed49b6",
                                "sense_id": "02cab275-296d-3cf9-85d1-db147e3a2396",
                                "text": "„Im Gegenlicht sahen die langen spitzen Ohren der Kreatur wie Teufelshörner aus.“"
                            },
                            {
                                "example_id": "dd611740-5cf9-49cb-939e-3364d2a52cea",
                                "sense_id": "02cab275-296d-3cf9-85d1-db147e3a2396",
                                "text": "„Das Haar des Mannes ist an den Schläfen weit zurückgewichen, die nackte Kopfhaut vom kalten Wind gerötet, und das Ganze sieht aus, als hätte er Teufelshörner.“"
                            },
                            {
                                "example_id": "17b1636f-1e52-49cf-b01a-2950e03353bc",
                                "sense_id": "02cab275-296d-3cf9-85d1-db147e3a2396",
                                "text": "„Ein Esel mit Teufelshörnern aus rotem Samt, die ihm über die Ohren gestreift waren, stand daneben und fraß friedlich Heu aus einem Korb auf dem Fußboden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
