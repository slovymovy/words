                {
                    "sense_id": "4b126f33-61dd-3684-9f17-b5f979546fc9",
                    "sense_definition": "Of a reddish-brown colour, typically used to describe hair.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to dye her hair a deep <w>auburn</w> shade for the autumn season.",
