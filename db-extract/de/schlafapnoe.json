                "senses": [
                    {
                        "sense_id": "52501473-dac5-3eff-a02c-cf0af07a3095",
                        "entry_id": "73633c9d-c7e5-3499-b150-af165d6bbe71",
                        "glosses": [
                            "Atemschwierigkeiten während des Schlafs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c755d74-601e-4f93-b7eb-3ca851578d0c",
                                "sense_id": "52501473-dac5-3eff-a02c-cf0af07a3095",
                                "text": "„Es ist wie Schlafapnoe, nur mitten am Tag, und du must dich selbst daran erinnern, den nächsten Atemzug zu nehmen... und den nächsten... während die Supermodels auf ihren funkelnden High Heels dem Publikum eine Mikrowelle anzudrehen versuchen, ein Fitnesslaufband, während du sie anstarrst und zu entscheiden versuchst, ob sie wirklich gut aussehen.“"
                            },
                            {
                                "example_id": "705ae8db-fda0-4a91-b96b-f9ffde19529f",
                                "sense_id": "52501473-dac5-3eff-a02c-cf0af07a3095",
                                "text": "„10 Prozent der Erwachsenen leiden an einer Schlafapnoe – einer Erkrankung, bei der die Atmung während des Schlafs wiederholt aussetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
