                                "example_id": "42883593-d50e-49e6-b685-af2dd23243e5",
                                "sense_id": "efc8c87c-c937-31ef-b4d0-69572c2171c2",
                                "text": "L’imprimeur a recouvert début avril les marches de 210 mètres carrés d’un adhésif conformable (flexible) qui épouse la forme de la pierre et limite l’infiltration d’eau."
                            },
                            {
                                "example_id": "11fad08b-07ae-403a-bd7f-3dc47e12706e",
                                "sense_id": "efc8c87c-c937-31ef-b4d0-69572c2171c2",
                                "text": "Nous conseillons toujours à nos clients un type de vinyle conformable, et donc facile à enlever afin de ne pas endommager la peinture."
                            },
                            {
                                "example_id": "411383f1-e6e8-43a4-9590-8285add13250",
                                "sense_id": "efc8c87c-c937-31ef-b4d0-69572c2171c2",
                                "text": "L’équipe NTU a développé son dispositif de communication végétale en fixant une électrode conformable sur la surface d’une Dionée attrape-mouche à l’aide d’un adhésif doux (de l’hydrogel)."
                            }
                        ]
                    }
