                "entry_id": "9d77e58f-f2e5-3266-b242-b32b3f1ac87e",
                "word": "hybridation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7bc1fef1-9523-4401-9035-5e9705ef5ed8",
                        "entry_id": "9d77e58f-f2e5-3266-b242-b32b3f1ac87e",
