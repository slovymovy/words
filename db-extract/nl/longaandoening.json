                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a63812b-7454-4ccd-b2ec-b0aee94a4d72",
                                "sense_id": "7a40a52e-5c97-309b-8e71-cd8ccc544088",
                                "text": "Het gaat vooral om ouderen en mensen met longaandoeningen, die met benauwdheidsverschijnselen worden opgenomen, meldt de beroepsvereniging. Omdat ziekenhuizen niet op piekdrukte zijn toegerust, lopen ze vol en moeten ze een opnamestop afkondigen."
                            },
                            {
                                "example_id": "a4d6381a-5a0a-419e-9a30-cb387d5a7fda",
                                "sense_id": "7a40a52e-5c97-309b-8e71-cd8ccc544088",
                                "text": "Het poeder bevat volgens het RIVM een hoge concentratie van kleine stofdeeltjes, die voor luchtwegklachten kunnen zorgen, helemaal bij mensen met longaandoeningen als astma. Ook kunnen er door de kleurstoffen in het poeder oog- of huidklachten ontstaan."
                            }
                        ]
                    }
