                "senses": [
                    {
                        "sense_id": "5218ba22-0579-3cdb-ad09-1da2a47200c2",
                        "entry_id": "616ecd57-7d52-3e87-a7c5-b7d3f6b62d18",
                        "glosses": [
                            "Saldo in Bezug auf Abgaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96da42cf-be8d-4ff2-97f6-aaa8f3b8f8f5",
                                "sense_id": "5218ba22-0579-3cdb-ad09-1da2a47200c2",
                                "text": "„Der Abgabensaldo wurde durch Ratenzahlungen des Bf. in der Höhe von jeweils 125 €, der Gutschrift aus der Einkommensteuer 2017 in der Höhe von 78 € (siehe Beschwerdevorentscheidung vom 04.07.2019) und der Zahlung eines Betrages von 234 € am 13.09.2019 zur Gänze abgedeckt (Saldo Null).“"
                            },
                            {
                                "example_id": "bc7c47c0-0076-482f-bf08-15ef5a7a8716",
                                "sense_id": "5218ba22-0579-3cdb-ad09-1da2a47200c2",
                                "text": "„Die Republik hatte nach der Prüfungstagsatzung mit ihrer angemeldeten und zu diesem Zeitpunkt bereits festgestellten Insolvenzforderung gegen den zugunsten der Schuldnerin aushaftenden Abgabensaldo aufgerechnet, wodurch die festgestellte Forderung erlosch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
