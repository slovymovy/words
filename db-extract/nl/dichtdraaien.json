                        "sense_id": "2b0b18ce-8bb4-3ec1-b9d0-a6f30d369b2b",
                        "entry_id": "910c1da1-9f1e-3320-a7c5-98acfaf8a73a",
                        "glosses": [
                            "van een kraan dat er geen of minder vloeistof of gas door kan stromen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e981369d-7c9e-49cc-8aa7-35ab41fcf196",
                                "sense_id": "2b0b18ce-8bb4-3ec1-b9d0-a6f30d369b2b",
                                "text": "Als je de kraan met de wijzers van de klok mee draait, draai je de kraan dicht"
                            },
                            {
                                "example_id": "d997ef3b-16b7-42f5-a6b4-02f3f72e951c",
                                "sense_id": "2b0b18ce-8bb4-3ec1-b9d0-a6f30d369b2b",
                                "text": "Van die geopolitieke strijd is bij de opslag in Jemgum weinig te merken. Hier bepalen de Europese vrijemarktregels wie er wint en wie er verliest. Mocht Gazprom de kraan om politieke redenen ooit dichtdraaien, dan moet ‘kleindochter’ Astora op zoek naar andere klanten om te overleven."
                            }
                        ]
                    }
