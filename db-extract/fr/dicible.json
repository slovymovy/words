                "senses": [
                    {
                        "sense_id": "b6851951-5a34-3298-952b-aa2400ecaa55",
                        "entry_id": "0c909467-4dd2-3468-9f63-3e77111efb27",
                        "glosses": [
                            "Qui peut être dit ; qui est exprimable par des mots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56c62247-c5bf-45cf-80c6-b929b6fe7805",
                                "sense_id": "b6851951-5a34-3298-952b-aa2400ecaa55",
                                "text": "Comme toute voie est viable, toute parole est dicible."
                            },
                            {
                                "example_id": "375344fe-9001-4a5e-b019-d50059c1afb7",
                                "sense_id": "b6851951-5a34-3298-952b-aa2400ecaa55",
                                "text": "Et ce quelque chose est dicible d'une certaine façon, d'où les affres que je vous fais partager au séminaire."
                            },
                            {
                                "example_id": "f796b6b1-773a-4d94-a533-b71144ac1cfa",
                                "sense_id": "b6851951-5a34-3298-952b-aa2400ecaa55",
                                "text": "Passer par un acte de mutation de ce qui dans la pensée se déclare dicible à ce qui, à un moment donné, devient chose dite est ce dont la parole est chargée. Cette mutation constitue un acte d'expression, […]."
                            },
                            {
                                "example_id": "3f243979-6636-42a7-aa45-589f85453f67",
                                "sense_id": "b6851951-5a34-3298-952b-aa2400ecaa55",
                                "text": "Le conscient élémentaire non verbal n'est évidemment pas toujours directement dicible."
                            }
                        ]
                    }
                ],
