                ],
                "senses": [
                    {
                        "sense_id": "c4d37fb0-3ddd-33fd-b1f1-213932ded916",
                        "entry_id": "00e765bc-431d-31e5-b13e-d075fab9d44b",
                        "glosses": [
                            "Entzündung der Schleimhäute im Hals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "027802a7-1049-44ca-82f6-b0c0a525e605",
                                "sense_id": "c4d37fb0-3ddd-33fd-b1f1-213932ded916",
                                "text": "„Eine Halsentzündung ist oft das erste Anzeichen eines viralen Infekts.“"
                            },
                            {
                                "example_id": "c147a7db-4229-47df-917b-fb8b49cf4d16",
                                "sense_id": "c4d37fb0-3ddd-33fd-b1f1-213932ded916",
                                "text": "„Jeder, der bereits einmal eine schlimme Halsentzündung hatte, weiß, wie schlimm Schmerzen im Hals sind, ganz gleich, ob man sie immer oder nur beim Schlucken hat.“"
                            },
                            {
                                "example_id": "821789dd-4b4e-4d21-b56d-db838706e920",
                                "sense_id": "c4d37fb0-3ddd-33fd-b1f1-213932ded916",
                                "text": "„Ein Hauptsymptom von Scharlach ist bekanntlich die Halsentzündung.“"
                            },
                            {
                                "example_id": "6f52fff0-1387-4844-8841-a136b49d22bd",
                                "sense_id": "c4d37fb0-3ddd-33fd-b1f1-213932ded916",
                                "text": "„Diese Form der Halsentzündung muss vom Arzt mit Antibiotika behandelt werden, da sie sonst schwerwiegende Organschäden nach sich ziehen kann, beispielsweise einen Herzklappenfehler oder eine Nierenschädigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
