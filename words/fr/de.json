                {
                    "sense_id": "d3555d03-616a-3d7c-863d-69033b37e0ac",
                    "sense_definition": "Forme prise par l'article indéfini pluriel <w>des</w> lorsqu'il précède immédiatement un adjectif qualificatif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "indefini_adjectif",
                    "name_type": "no",
                    "examples": [
