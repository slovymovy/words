                        "entry_id": "3a89b874-e440-3855-94a0-9a60207ba759",
                        "glosses": [
                            "een ketting als sieraad voor om de hals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81da1fbc-e7de-40c6-a7aa-3428dd34ae1e",
                                "sense_id": "6305561c-ae1d-3fb5-945f-61b65947567d",
                                "text": "Hij gaf zijn vriendin een halsketting."
                            },
                            {
                                "example_id": "9f5f58db-c153-485a-9daf-202155af1a9d",
                                "sense_id": "6305561c-ae1d-3fb5-945f-61b65947567d",
                                "text": "Het was een halsketting met afwisselend grote smaragden en kleine sterrenformaties van briljanten, allemaal fonkelend alsof ze nieuw waren, hoewel het sieraad uit de vroege negentiende eeuw moest komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "387c0a22-dd50-3043-9bd8-b5e3029b29c1",
                        "entry_id": "3a89b874-e440-3855-94a0-9a60207ba759",
                        "glosses": [
                            "een ketting voor om de hals van het vee om het vast te binden als het op stal staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43352967-3ea0-4bbf-a058-4833333c2635",
                                "sense_id": "387c0a22-dd50-3043-9bd8-b5e3029b29c1",
                                "text": "De halskettingen voor het vee waren zoek."
                            }
                        ]
                    }
