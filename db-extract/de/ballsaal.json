                        "form": "die Ballsäle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                        "entry_id": "a17a06ba-9d47-38c9-a6cd-d91fda4cc9a7",
                        "glosses": [
                            "großer und geschmückter Raum in einem Schloss oder anderem (öffentlichen) Gebäude, in dem Tanzveranstaltungen stattfinden oder -fanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1a217dd-562b-4a76-ae93-ea5f302ed32d",
                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                "text": "Gekleidet in eleganten Ballkleidern und Smokings betraten die Debütantinnen mit ihren Tanzpartnern den Ballsaal."
                            },
                            {
                                "example_id": "34d92370-af6d-4691-960f-3938671b8095",
                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                "text": "Wegen der vielen Kerzen herrschte in mittelalterlichen Ballsälen eine erhöhte Brandgefahr."
                            },
                            {
                                "example_id": "627540fc-009d-4794-a6b0-0d193e48b425",
                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                "text": "Im Ballsaal feierte das Brautpaar ihre Hochzeit."
                            },
                            {
                                "example_id": "b446b129-d499-46a3-ad4e-8b225c200628",
                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                "text": "„Unpassend gekleidete Gäste werden aus dem Ballsaal verwiesen!“"
                            },
                            {
                                "example_id": "4754ff15-a19f-493e-91aa-6ab99a650bfb",
                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                "text": "Als Show-Event wurde im Ballsaal eine Balletteinlage getanzt."
                            },
                            {
                                "example_id": "9413f11f-fb2f-41a5-838a-73d39bdd97fe",
                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                "text": "„Niemand hat es je gewagt, die bemalten Kassettendecken und die riesigen Lüster im Ballsaal anzurühren.“"
                            },
                            {
                                "example_id": "aacd824d-7711-44cd-a0ef-191e068a1b7b",
                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                "text": "„Mehr als 600 Genossen hocken unter dem Holzdach des Ballsaals an langen Tischen, trinken Bier (2,90 Euro), schneiden Schweineschnitzel (13,50 Euro).“"
                            },
                            {
                                "example_id": "04d78a48-e599-4b08-8dc3-8b4ab5c19090",
                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                "text": "„Als wir in den Ballsaal traten, öffnete sich die große Schar der Gäste zu einem Korridor.“"
                            },
                            {
                                "example_id": "3fbf6a25-705d-405b-9b32-7596b32180e3",
                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                "text": "„Natascha hatte kaum den Ballsaal betreten, als sie auch schon verliebt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
