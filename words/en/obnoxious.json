{
    "word_family": [
        "obnoxiously",
        "obnoxiousness",
        "noxious",
        "noxiously",
        "noxiousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "706f5679-23bc-36f3-97c7-db086bbe0cce",
                    "sense_definition": "Extremely unpleasant, offensive, or very annoying in a rude or disagreeable way.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "annoying_offensive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone avoided the <w>obnoxious</w> customer at the counter.",
                            "target_lang_translations": {
                                "zh": "每个人都避开了柜台前那个<w>讨厌的</w>顾客。",
                                "ru": "Все избегали <w>отвратительного</w> покупателя у прилавка."
                            }
                        },
                        {
                            "text": "His <w>obnoxious</w> behavior at dinner made the whole table uncomfortable.",
                            "target_lang_translations": {
                                "zh": "他在晚餐时<w>令人反感的</w>行为让整桌人都感到不自在。",
                                "ru": "Его <w>противное</w> поведение за ужином заставило всех за столом чувствовать себя неловко."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoying",
                        "offensive",
                        "unpleasant",
                        "irritating",
                        "distasteful"
                    ],
                    "antonyms": [
                        "unobnoxious"
                    ],
                    "common_phrases": [
                        "obnoxious behavior",
                        "obnoxious customer",
                        "obnoxious person"
                    ],
                    "target_lang_definitions": {
                        "zh": "指人或行为极其令人不快、冒犯他人或非常讨厌，通常带有粗鲁或令人反感的意味。",
                        "ru": "Крайне неприятный, оскорбительный или очень раздражающий, часто в грубой или вызывающей неприязнь манере."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "讨厌的",
                                "target_lang_sense_clarification": "形容人或事物令人反感、厌烦。"
                            },
                            {
                                "target_lang_word": "令人作呕的",
                                "target_lang_sense_clarification": "形容行为极其令人不快，程度较深。"
                            },
                            {
                                "target_lang_word": "冒犯的",
                                "target_lang_sense_clarification": "形容言行举止粗鲁，冒犯他人。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "вызывающий сильное неприятие или отвращение"
                            },
                            {
                                "target_lang_word": "противный",
                                "target_lang_sense_clarification": "крайне неприятный, раздражающий"
                            },
                            {
                                "target_lang_word": "омерзительный",
                                "target_lang_sense_clarification": "вызывающий крайнее возмущение или брезгливость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bec75d7-57e4-32a1-9342-4d1004bdff1b",
                    "sense_definition": "Exposed or vulnerable to something, especially harm, danger, or attack.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "liable_vulnerable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In older texts, a town could be described as <w>obnoxious</w> to attack.",
                            "target_lang_translations": {
                                "zh": "在古籍中，城镇常被描述为<w>易受</w>攻击的。",
                                "ru": "В старых текстах город могли описывать как <w>уязвимый</w> для нападения."
                            }
                        },
                        {
                            "text": "The writer used <w>obnoxious</w> to mean vulnerable to danger, not annoying.",
                            "target_lang_translations": {
                                "zh": "作者使用这个词意指<w>容易遭受危险</w>，而非讨厌。",
                                "ru": "Автор использовал слово <w>obnoxious</w> в значении 'уязвимый перед опасностью', а не 'раздражающий'."
                            }
                        }
                    ],
                    "synonyms": [
                        "vulnerable"
                    ],
                    "common_phrases": [
                        "obnoxious to danger",
                        "obnoxious to attack"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古语）易受伤害、危险或攻击的；脆弱的。",
                        "ru": "(Устар.) Подверженный чему-либо, особенно вреду, опасности или нападению; уязвимый."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "易受……伤害的",
                                "target_lang_sense_clarification": "指处于容易遭受攻击或危险的状态。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "уязвимый",
                                "target_lang_sense_clarification": "подверженный опасности или нападению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58ade344-b22f-3eb2-98bd-6aa5972ee430",
                    "sense_definition": "Causing harm or injury; harmful or injurious.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "harmful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some old writers called poisonous animals <w>obnoxious</w> to humans.",
                            "target_lang_translations": {
                                "zh": "一些古老的作家称有毒动物对人类是<w>有害的</w>。",
                                "ru": "Некоторые старые авторы называли ядовитых животных <w>вредными</w> для человека."
                            }
                        },
                        {
                            "text": "In that archaic sense, the plant was considered <w>obnoxious</w> to health.",
                            "target_lang_translations": {
                                "zh": "在那种古语用法中，这种植物被认为对健康<w>有害</w>。",
                                "ru": "В том архаичном смысле растение считалось <w>вредным</w> для здоровья."
                            }
                        }
                    ],
                    "synonyms": [
                        "harmful"
                    ],
                    "common_phrases": [
                        "obnoxious to health"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古语）造成伤害或损害的；有害的。",
                        "ru": "(Устар.) Причиняющий вред или ущерб; вредоносный."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有害的",
                                "target_lang_sense_clarification": "指对健康或生命有损害的。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вредный",
                                "target_lang_sense_clarification": "причиняющий ущерб здоровью или благополучию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3516c063-9185-3fdc-a4be-92df4e107b9d",
                    "sense_definition": "Deserving blame or punishment; guilty or blameworthy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "blame_punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In legal history, the most <w>obnoxious</w> offender could face punishment first.",
                            "target_lang_translations": {
                                "zh": "在法律史上，最<w>应受惩罚的</w>罪犯可能会最先面临制裁。",
                                "ru": "В истории права самый <w>подлежащий наказанию</w> преступник мог первым столкнуться с возмездием."
                            }
                        },
                        {
                            "text": "The old text calls him <w>obnoxious</w> to punishment for his crimes.",
                            "target_lang_translations": {
                                "zh": "古籍称他是<w>应受惩罚的</w>，因为他犯下了那些罪行。",
                                "ru": "Старый текст называет его <w>подлежащим наказанию</w> за свои преступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "reprehensible"
                    ],
                    "common_phrases": [
                        "obnoxious to punishment"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古语）应受责备或惩罚的；有罪的。",
                        "ru": "(Устар.) Заслуживающий порицания или наказания; виновный."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "应受惩罚的",
                                "target_lang_sense_clarification": "指行为过失导致必须承担后果。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "подлежащий наказанию",
                                "target_lang_sense_clarification": "тот, кто должен понести ответственность за проступок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d973c32-c630-3f11-997f-e2a411b95475",
                    "sense_definition": "Under the authority or power of someone; subordinate or submissive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "authority_subjection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In obsolete usage, a servant might be called <w>obnoxious</w> to a master.",
                            "target_lang_translations": {
                                "zh": "在过时的用法中，仆人可能被称为<w>从属于</w>主人的。",
                                "ru": "В устаревшем употреблении слугу могли называть <w>подчинённым</w> хозяину."
                            }
                        },
                        {
                            "text": "The passage describes weaker members as <w>obnoxious</w> to authority.",
                            "target_lang_translations": {
                                "zh": "这段文字描述弱势成员是<w>从属于</w>权威的。",
                                "ru": "В отрывке слабые члены общества описываются как <w>подчинённые</w> власти."
                            }
                        }
                    ],
                    "synonyms": [
                        "subordinate",
                        "subservient"
                    ],
                    "common_phrases": [
                        "obnoxious to authority"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（废语）处于某人的权威或权力之下；从属的或顺从的。",
                        "ru": "(Устар.) Находящийся под чьей-либо властью или контролем; подчинённый или зависимый."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "从属的",
                                "target_lang_sense_clarification": "指处于他人的管辖或控制之下。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "подчинённый",
                                "target_lang_sense_clarification": "находящийся в зависимости от кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c84a12c-7c85-3e3e-82b4-68a235f2d929",
                    "sense_definition": "Followed by to: likely or liable to do something or experience something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "liable_vulnerable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Older religious writing says youth is <w>obnoxious</w> to forgetfulness.",
                            "target_lang_translations": {
                                "zh": "较早的宗教著作称年轻人<w>易于</w>健忘。",
                                "ru": "Старые религиозные писания говорят, что юность <w>склонна к</w> забывчивости."
                            }
                        },
                        {
                            "text": "The author thought people were <w>obnoxious</w> to error in difficult times.",
                            "target_lang_translations": {
                                "zh": "作者认为人们在困难时期<w>易于</w>犯错。",
                                "ru": "Автор считал, что люди <w>склонны к</w> ошибкам в трудные времена."
                            }
                        }
                    ],
                    "synonyms": [
                        "liable",
                        "prone"
                    ],
                    "common_phrases": [
                        "obnoxious to error",
                        "obnoxious to forgetfulness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古语）后接to，指容易做某事或容易经历某事；倾向于。",
                        "ru": "(Устар.) С предлогом 'to', означает склонность к чему-либо или подверженность какому-либо состоянию."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "易于……的",
                                "target_lang_sense_clarification": "指容易发生某种情况或倾向于某种状态。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "склонный к",
                                "target_lang_sense_clarification": "имеющий предрасположенность к чему-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}