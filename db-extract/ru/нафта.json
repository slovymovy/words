                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad00dd6-c849-4404-89bd-0ecb4b91515d",
                                                "sense_id": "3e451e4c-6883-3f95-b5d6-bc33d3a2f869",
                                                "text": "\"Do you need a drink?\" oils Robert Ryan to the disinterested Stanwyck in Clash By Night; \"Let's say that's what I need,\" she sneers back."
                                            }
                                        ]
                                    }
                                ]
                            }
