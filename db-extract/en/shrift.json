                    {
                        "translation_id": "75697ed7-a3bc-4263-bd61-5f4ee0c23ddb",
                        "source_entry_id": "4dc06dd9-86dd-3234-a1a1-79c167334c65",
                        "source_sense_description": "act of going to or hearing a religious confession",
                        "target_lang_word": "Beichte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beichte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37a232ea-1d11-37a5-b37a-7c61bb03307d",
                                        "entry_id": "f547ddf4-c109-30b9-a0c5-d654d6f39d35",
                                        "glosses": [
                                            "Sündenbekenntnis (und anschließende Sündenvergebung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f52fa3f2-1c57-4542-a2e4-3834c58a5864",
                                                "sense_id": "37a232ea-1d11-37a5-b37a-7c61bb03307d",
                                                "text": "Sie sah jetzt aus wie eine alte Frau, ihr Haar wurde ganz grau, und sie ward fromm und ging jeden Sonntag zur Beichte."
                                            },
                                            {
                                                "example_id": "9f70a2d3-a9ed-4fad-be1e-320baf25c81f",
                                                "sense_id": "37a232ea-1d11-37a5-b37a-7c61bb03307d",
                                                "text": "Die Beichte hat zwei Wesens Bestandteile: das Sündenbekenntnis des Mensche und - das wichtigste an ihr - die Absolution durch Gott."
                                            },
                                            {
                                                "example_id": "a6cd0aac-da52-441e-b903-b2c878b67453",
                                                "sense_id": "37a232ea-1d11-37a5-b37a-7c61bb03307d",
                                                "text": "„Er sehnte sich danach, wieder zur Beichte zu gehen.“"
                                            },
                                            {
                                                "example_id": "0c94f06c-1feb-459e-9308-6e03f29ab04b",
                                                "sense_id": "37a232ea-1d11-37a5-b37a-7c61bb03307d",
                                                "text": "„Horst musste auch regelmäßig zur Beichte gehen, was für ihn eine Höllenqual war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0dd5a031-33b0-3581-8211-0acec60d10fa",
                                        "entry_id": "f547ddf4-c109-30b9-a0c5-d654d6f39d35",
                                        "glosses": [
                                            "Schuldbekenntnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3960404-9784-4519-9cec-365b23ac4c00",
                                                "sense_id": "0dd5a031-33b0-3581-8211-0acec60d10fa",
                                                "text": "Doch der Spuk ist keineswegs vorbei. Die jüngste Serie von Epo-Geständnissen deutscher Radprofis und Betreuer, zuletzt die Beichte von Jörg Jaksche im Spiegel, lässt das Ausmaß des Dopingsystems ahnen."
                                            },
                                            {
                                                "example_id": "c543c213-5b74-4d3b-9e4e-b53699c05632",
                                                "sense_id": "0dd5a031-33b0-3581-8211-0acec60d10fa",
                                                "text": "Es wird keine Beichte sein, die ich hier ablege, mit Reue und Vorsatz und sonstigen Zutaten. Ich will ein wenig plaudern. Das ist alles. Trotzdem werde ich bisweilen annähernd das sagen, was ich denke: ohne Schamgefühl eingestehen, was ich tat"
                                            },
                                            {
                                                "example_id": "a37c7387-6368-4b60-88fd-045a295cb3c4",
                                                "sense_id": "0dd5a031-33b0-3581-8211-0acec60d10fa",
                                                "text": "„Svanas Mann hörte sich ihre Beichte schweigend an, starrte dann lange vor sich zu Boden, bevor er aufstand, ohne sie anzusehen, seine Schrotflinte holte und in die Berge fuhr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
