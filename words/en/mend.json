{
    "word_family": [
        "mender",
        "mending",
        "unmended",
        "amend",
        "emend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c0ac20f-ef83-33d0-b60e-3727f418dd92",
                    "sense_definition": "To physically repair something that is broken, torn, or damaged.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "repair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My favorite trousers have a big rip in them and need <w>mending</w>.",
                            "target_lang_translations": {
                                "ru": "На моих любимых брюках большая дыра, и их нужно <w>заштопать</w>."
                            }
                        },
                        {
                            "text": "When your car breaks down, you can take it to the garage to have it <w>mended</w>.",
                            "target_lang_translations": {
                                "ru": "Когда ваша машина ломается, вы можете отвезти её в сервис, чтобы её <w>починили</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fix",
                        "patch",
                        "restore",
                        "fix up"
                    ],
                    "antonyms": [
                        "break",
                        "damage",
                        "tear"
                    ],
                    "common_phrases": [
                        "mend clothes",
                        "mend a fence",
                        "mend a net"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически ремонтировать что-либо сломанное, порванное или поврежденное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чинить",
                                "target_lang_sense_clarification": "исправлять поломку"
                            },
                            {
                                "target_lang_word": "починить",
                                "target_lang_sense_clarification": "завершить ремонт"
                            },
                            {
                                "target_lang_word": "штопать",
                                "target_lang_sense_clarification": "чинить одежду нитками"
                            },
                            {
                                "target_lang_word": "ремонтировать",
                                "target_lang_sense_clarification": "восстанавливать исправность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45c5c9d9-fcbf-323d-95f1-1ca9abb95d1e",
                    "sense_definition": "To correct or put right an error, a fault, or a difficult situation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager promised to <w>mend</w> the error in the billing system immediately.",
                            "target_lang_translations": {
                                "ru": "Менеджер пообещал немедленно <w>исправить</w> ошибку в системе выставления счетов."
                            }
                        },
                        {
                            "text": "It is important to <w>mend</w> the fault in the joint before the structure collapses.",
                            "target_lang_translations": {
                                "ru": "Важно <w>устранить</w> дефект в стыке до того, как конструкция рухнет."
                            }
                        }
                    ],
                    "synonyms": [
                        "correct",
                        "rectify",
                        "remedy",
                        "set straight"
                    ],
                    "antonyms": [
                        "worsen",
                        "exacerbate"
                    ],
                    "common_phrases": [
                        "mend a fault",
                        "mend an error"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исправлять ошибку, недостаток или сложную ситуацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправлять",
                                "target_lang_sense_clarification": "устранять ошибки"
                            },
                            {
                                "target_lang_word": "исправить",
                                "target_lang_sense_clarification": "сделать лучше, устранить дефект"
                            },
                            {
                                "target_lang_word": "устранять",
                                "target_lang_sense_clarification": "ликвидировать проблему"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ea2c2fb-edb0-3f6b-9e1a-2d6706e07244",
                    "sense_definition": "To improve a situation, relationship, or state of mind.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After their long argument, they finally decided to <w>mend</w> their relationship.",
                            "target_lang_translations": {
                                "ru": "После долгой ссоры они наконец решили <w>наладить</w> свои отношения."
                            }
                        },
                        {
                            "text": "She hoped that a quiet holiday would help <w>mend</w> her broken heart.",
                            "target_lang_translations": {
                                "ru": "Она надеялась, что спокойный отпуск поможет <w>исцелить</w> её разбитое сердце."
                            }
                        }
                    ],
                    "synonyms": [
                        "amend",
                        "reform",
                        "revamp",
                        "remediate"
                    ],
                    "antonyms": [
                        "spoil",
                        "ruin"
                    ],
                    "common_phrases": [
                        "mend fences",
                        "mend a relationship",
                        "mend a broken heart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшать ситуацию, отношения или душевное состояние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "налаживать",
                                "target_lang_sense_clarification": "восстанавливать отношения"
                            },
                            {
                                "target_lang_word": "исцелять",
                                "target_lang_sense_clarification": "о душевных ранах"
                            },
                            {
                                "target_lang_word": "улучшать",
                                "target_lang_sense_clarification": "делать ситуацию лучше"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e026fa6-40aa-374c-99c7-3a59ce6f01e1",
                    "sense_definition": "To recover from an illness or injury; to become healthy again.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor says the patient is <w>mending</w> well after the surgery.",
                            "target_lang_translations": {
                                "ru": "Врач говорит, что пациент хорошо <w>поправляется</w> после операции."
                            }
                        },
                        {
                            "text": "His broken arm has <w>mended</w> quickly because he followed the doctor's advice.",
                            "target_lang_translations": {
                                "ru": "Его сломанная рука быстро <w>срослась</w>, потому что он следовал советам врача."
                            }
                        }
                    ],
                    "synonyms": [
                        "restore",
                        "renew"
                    ],
                    "antonyms": [
                        "sicken",
                        "deteriorate"
                    ],
                    "common_phrases": [
                        "mend quickly",
                        "soon mend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выздоравливать после болезни или травмы; восстанавливать здоровье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заживать",
                                "target_lang_sense_clarification": "о ранах или переломах"
                            },
                            {
                                "target_lang_word": "поправляться",
                                "target_lang_sense_clarification": "идти на поправку"
                            },
                            {
                                "target_lang_word": "срастаться",
                                "target_lang_sense_clarification": "о костях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83718b88-c819-33de-b742-e6645f3c5c2c",
                    "sense_definition": "To improve one's behavior or character; to reform morally.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher hoped the boy would <w>mend</w> his ways after the warning.",
                            "target_lang_translations": {
                                "ru": "Учитель надеялся, что мальчик <w>исправится</w> после предупреждения."
                            }
                        },
                        {
                            "text": "It is never too late to <w>mend</w> your character and start doing good.",
                            "target_lang_translations": {
                                "ru": "Никогда не поздно <w>исправить</w> свой характер и начать делать добро."
                            }
                        }
                    ],
                    "synonyms": [
                        "reform",
                        "amend"
                    ],
                    "common_phrases": [
                        "mend one's ways",
                        "mend one's manners"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшать свое поведение или характер; исправляться морально."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправляться",
                                "target_lang_sense_clarification": "о поведении или характере"
                            },
                            {
                                "target_lang_word": "исправить",
                                "target_lang_sense_clarification": "изменить привычки к лучшему"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49d85449-cfbf-3148-976f-6a9b7ed0dece",
                    "sense_definition": "To quicken or speed up a pace.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the rain began to fall, he <w>mended</w> his pace to reach home sooner.",
                            "target_lang_translations": {
                                "ru": "Когда пошёл дождь, он <w>ускорил</w> шаг, чтобы поскорее добраться до дома."
                            }
                        },
                        {
                            "text": "The hikers had to <w>mend</w> their pace to reach the camp before sunset.",
                            "target_lang_translations": {
                                "ru": "Туристам пришлось <w>прибавить</w> шагу, чтобы добраться до лагеря до захода солнца."
                            }
                        }
                    ],
                    "antonyms": [
                        "slow down"
                    ],
                    "common_phrases": [
                        "mend one's pace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ускорять шаг или темп движения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускорять",
                                "target_lang_sense_clarification": "прибавлять шаг"
                            },
                            {
                                "target_lang_word": "прибавить",
                                "target_lang_sense_clarification": "увеличить скорость ходьбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1186d764-3b8e-33c0-a9bd-2e3eaec826e0",
                    "sense_definition": "To add fuel to a fire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>mended</w> the fire by adding several large logs to the hearth.",
                            "target_lang_translations": {
                                "ru": "Он <w>поддержал</w> огонь, подбросив в очаг несколько больших поленьев."
                            }
                        },
                        {
                            "text": "Please <w>mend</w> the fire so it does not go out during the night.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>подправь</w> огонь, чтобы он не погас ночью."
                            }
                        }
                    ],
                    "antonyms": [
                        "extinguish"
                    ],
                    "common_phrases": [
                        "mend the fire"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in older literature or specific regional contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживать огонь, подкладывая топливо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "не давать огню погаснуть"
                            },
                            {
                                "target_lang_word": "подправлять",
                                "target_lang_sense_clarification": "поправлять дрова в костре"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bb1ea279-edaa-3614-ac4c-2f3db3781883",
                    "sense_definition": "The act of repairing something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "repair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old coat is still in good condition but needs a quick <w>mend</w>.",
                            "target_lang_translations": {
                                "ru": "Старое пальто всё ещё в хорошем состоянии, но требует небольшой <w>починки</w>."
                            }
                        },
                        {
                            "text": "After the storm, the roof required a significant <w>mend</w> to stop the leaks.",
                            "target_lang_translations": {
                                "ru": "После шторма крыше потребовался серьезный <w>ремонт</w>, чтобы устранить протечки."
                            }
                        }
                    ],
                    "synonyms": [
                        "fix",
                        "patch"
                    ],
                    "common_phrases": [
                        "need a mend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по ремонту или починке чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "починка",
                                "target_lang_sense_clarification": "процесс исправления вещи"
                            },
                            {
                                "target_lang_word": "штопка",
                                "target_lang_sense_clarification": "ремонт одежды"
                            },
                            {
                                "target_lang_word": "латание",
                                "target_lang_sense_clarification": "наложение заплат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4da7f4c9-cffb-380f-bfa8-a1800fe65db2",
                    "sense_definition": "An improvement in health or recovery from illness, especially in the phrase 'on the <w>mend</w>'.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was very sick last week, but I am finally on the <w>mend</w> now.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе я сильно болел, но сейчас наконец-то иду на <w>поправку</w>."
                            }
                        },
                        {
                            "text": "The doctor was pleased to see that the patient's health was on the <w>mend</w>.",
                            "target_lang_translations": {
                                "ru": "Врач был рад видеть, что здоровье пациента идет на <w>выздоровление</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mends",
                        "remedy"
                    ],
                    "common_phrases": [
                        "on the mend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшение здоровья или выздоровление после болезни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поправка",
                                "target_lang_sense_clarification": "улучшение состояния здоровья"
                            },
                            {
                                "target_lang_word": "выздоровление",
                                "target_lang_sense_clarification": "процесс восстановления сил"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}