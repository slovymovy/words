                                "example_id": "240618b5-781b-4a3d-8ef1-ba2b88dd21c4",
                                "sense_id": "84743cb8-4085-36f8-a529-994756699f3d",
                                "text": "„Er kann einfach gereinigt werden und erspart ständiges Nachkaufen von Papierfiltern.“"
                            },
                            {
