                                "target_senses": [
                                    {
                                        "sense_id": "c0f1532e-9c68-329d-8da3-26b454a7e1d3",
                                        "entry_id": "7ff66b70-960e-39c6-b195-33853fd20fb4",
                                        "glosses": [
                                            "The daily fluctuation in the level of the sea caused by the gravitational influence of the moon and the sun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0925e60-ebe5-4aa4-8e8b-a0bd9e680753",
                                                "sense_id": "c0f1532e-9c68-329d-8da3-26b454a7e1d3",
                                                "text": "The Bristol Channel has some of the world's largest tides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bf957c7-dcff-39d6-ae87-475d21a04697",
                                        "entry_id": "7ff66b70-960e-39c6-b195-33853fd20fb4",
                                        "glosses": [
                                            "The associated flow of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cac13ec-3f7b-4274-8f37-6f98f8aa0f3f",
                                                "sense_id": "5bf957c7-dcff-39d6-ae87-475d21a04697",
                                                "text": "A lot of driftwood was brought in on the tide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc81c3a7-2706-3f4f-8e3c-675ecf154103",
                                        "entry_id": "7ff66b70-960e-39c6-b195-33853fd20fb4",
                                        "glosses": [
                                            "Any similar gravitational effect on Earth or other body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c86e1f-eb7e-4e59-ab99-14ea6dd1ec8e",
                                                "sense_id": "fc81c3a7-2706-3f4f-8e3c-675ecf154103",
                                                "text": "As well as sea tides, there are much smaller land tides."
                                            },
                                            {
                                                "example_id": "e2e6b921-fe00-437a-b494-4b851d0432ff",
                                                "sense_id": "fc81c3a7-2706-3f4f-8e3c-675ecf154103",
                                                "text": "By far the largest tides on Europa are those caused by the gravitational attraction of Jupiter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27408a9f-b3bc-3c14-8b61-a533b5e6953f",
                                        "entry_id": "7ff66b70-960e-39c6-b195-33853fd20fb4",
                                        "glosses": [
                                            "A high-volume flow, literal or figurative; a current or flood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ac38d20-9ad2-4abc-9ab1-1f30a7987431",
                                                "sense_id": "27408a9f-b3bc-3c14-8b61-a533b5e6953f",
                                                "text": "The sewer burst, and a tide of sewage poured into nearby properties."
                                            },
                                            {
                                                "example_id": "7ae4810e-90d6-489d-b472-2c8670eedb2a",
                                                "sense_id": "27408a9f-b3bc-3c14-8b61-a533b5e6953f",
                                                "text": "A tide of people crossed over the border."
                                            },
                                            {
                                                "example_id": "a41c0932-c00b-4f8a-8e1f-21a19af35a3a",
                                                "sense_id": "27408a9f-b3bc-3c14-8b61-a533b5e6953f",
                                                "text": "We've encountered a tide of problems."
                                            },
                                            {
                                                "example_id": "8e9bbe30-10c1-458a-9865-ce91559a0d20",
                                                "sense_id": "27408a9f-b3bc-3c14-8b61-a533b5e6953f",
                                                "text": "Go I charge thee, inuite them all, let in the tide / Of Knaues once more: my Cook and Ile provide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28e84653-32ec-393d-a88f-6e5f7d172435",
                                        "entry_id": "7ff66b70-960e-39c6-b195-33853fd20fb4",
                                        "glosses": [
                                            "The tendency or direction of causes, influences, or events; course; current."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "334cbf8f-37e5-4d6a-9a37-b6b75eb13235",
                                                "sense_id": "28e84653-32ec-393d-a88f-6e5f7d172435",
                                                "text": "The tide of public opinion has turned."
                                            },
                                            {
                                                "example_id": "da89720d-17ee-4f2a-b8a4-23f66f5cb02c",
                                                "sense_id": "28e84653-32ec-393d-a88f-6e5f7d172435",
                                                "text": "There is a tide in the affairs of men, / Which, taken at the flood, leads on to fortune [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05a023be-dbd4-340a-9764-8243d0e715aa",
                                        "entry_id": "7ff66b70-960e-39c6-b195-33853fd20fb4",
                                        "glosses": [
                                            "Time, notably anniversary, period or season linked to an ecclesiastical feast."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "513caf9a-6aa1-4ed1-8db5-4adc849616a1",
                                                "sense_id": "05a023be-dbd4-340a-9764-8243d0e715aa",
                                                "text": "[...] and rest their weary limbs a tide."
                                            },
                                            {
                                                "example_id": "19c0eb4d-d630-4592-8e88-524ccdcf8e71",
                                                "sense_id": "05a023be-dbd4-340a-9764-8243d0e715aa",
                                                "text": "Which, at th'appointed tyde, / Each one did make his Bryde"
                                            },
                                            {
                                                "example_id": "42e4f6f3-6f57-4d96-b49d-ac777a730843",
                                                "sense_id": "05a023be-dbd4-340a-9764-8243d0e715aa",
                                                "text": "at the tide / Of Christ his birth"
                                            },
                                            {
                                                "example_id": "0f818b0c-c84c-4375-be0b-bbf5192a12bc",
                                                "sense_id": "05a023be-dbd4-340a-9764-8243d0e715aa",
                                                "text": "What is singular too, the spademen seem to work lazily; they will not work double-tides, even for offer of more wages, though their tide is but seven hours[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddc16bc0-cbce-3ba9-a926-53104a0049e6",
                                        "entry_id": "7ff66b70-960e-39c6-b195-33853fd20fb4",
                                        "glosses": [
                                            "A time."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4651dea-95a4-431f-9da5-e3a6acbefd9d",
                                                "sense_id": "ddc16bc0-cbce-3ba9-a926-53104a0049e6",
                                                "text": "The doctor's no good this tide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d05ca57e-1def-3be0-9158-9b41c27d30a8",
                                        "entry_id": "7ff66b70-960e-39c6-b195-33853fd20fb4",
                                        "glosses": [
                                            "A point or period of time identified or described by a qualifier."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "in-compounds",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48b2cef1-d164-4d12-83a0-8b731b78ff18",
                                                "sense_id": "d05ca57e-1def-3be0-9158-9b41c27d30a8",
                                                "text": "Eventide, noontide, morrowtide, nighttide, moontide, harvesttide, wintertide, summertide, springtide, autumntide etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ef2166c-86a0-3d31-816b-e34fc07ce4fa",
                                        "entry_id": "7ff66b70-960e-39c6-b195-33853fd20fb4",
                                        "glosses": [
                                            "The period of twelve hours."
                                        ],
