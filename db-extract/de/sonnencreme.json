                        "entry_id": "6d96e27c-3e24-3a38-a6fc-ace4da6f1e0f",
                        "glosses": [
                            "eine Creme, die auf die menschliche Haut aufgetragen wird, um sie vor Sonnenbrand und gefährlicher UV-Strahlungen zu schützen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dee5754-24c1-4e5a-91fb-afbf50fa9717",
                                "sense_id": "5b243ecb-6195-35cc-8048-a7c4cacbaf9f",
                                "text": "Du brauchst Sonnencreme, um deine Haut zu schützen."
                            },
                            {
                                "example_id": "ab3d95e4-ee58-4367-8c60-ca8abd6b3a44",
                                "sense_id": "5b243ecb-6195-35cc-8048-a7c4cacbaf9f",
                                "text": "„Die Zeit davor ist ein bisschen verschwommen, der endlose Sommer bei den Pfadfindern im Nachhinein eine ausgeblichene Erinnerung an den Geruch nach Hitze und Sonnencreme, dunkles Seewasser und Eulenrufe in der Nacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
