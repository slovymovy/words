                    },
                    {
                        "translation_id": "c3bcbbfd-d35b-4633-b877-4d253758f62a",
                        "source_entry_id": "88056894-7ade-304a-87ca-7a849b8c0d39",
                        "source_sense_id": "d73a067d-1125-30d3-800a-4258c8bc7c0f",
                        "source_sense_description": "glass-paneled cabinet or case",
                        "target_lang_word": "Vitrine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vitrine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe8878ac-dd6f-3571-bf46-876e97ee6fe5",
                                        "entry_id": "0824e789-2b2f-3942-983e-f14fe41264da",
                                        "glosses": [
                                            "gläserner Schrank"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c99cf6a-c9e8-4f2a-8150-0ba2af5ffbf9",
                                                "sense_id": "fe8878ac-dd6f-3571-bf46-876e97ee6fe5",
                                                "text": "Stelle bitte das Geschirr in die Vitrine."
                                            },
                                            {
                                                "example_id": "31cd9b2f-ec3a-46e7-ab61-ec942b343f22",
                                                "sense_id": "fe8878ac-dd6f-3571-bf46-876e97ee6fe5",
                                                "text": "„So kommt ein Heiratskandidat in das Elternhaus der jungen Dame, und während sie im Wohnzimmer auf den Eintritt der Familie warten, deutet der Vermittler auf eine Vitrine mit teuren Silbergeräten, um den Reichtum der Herrschaften herauszustreichen.“"
                                            },
                                            {
                                                "example_id": "fbfa0f87-8d38-435c-b913-7323f058a169",
                                                "sense_id": "fe8878ac-dd6f-3571-bf46-876e97ee6fe5",
                                                "text": "„Auf dem Weg in die gute Stube inspiziert Lampe die Zimmer und entdeckt Liederlichkeiten: einen schräg stehenden Stuhl, eine in der Vitrine umgefallene Tasse, eine unordentlich gearbeitete Spitzendecke auf einem Tisch, der dringend gefettet werden müßte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e07b5eb-0482-3b6c-8320-3cfce63c74ec",
                                        "entry_id": "0824e789-2b2f-3942-983e-f14fe41264da",
                                        "glosses": [
                                            "Schaukasten, Kasten, um Ausstellungsstücke aufzubewahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04677592-687a-4678-a788-26a1d3df0d4f",
                                                "sense_id": "7e07b5eb-0482-3b6c-8320-3cfce63c74ec",
                                                "text": "Alle Auszeichnungen bewahrt er in einer Vitrine auf."
                                            },
                                            {
                                                "example_id": "82a68f46-946e-4cbe-a0cb-ab4fe91670a3",
                                                "sense_id": "7e07b5eb-0482-3b6c-8320-3cfce63c74ec",
                                                "text": "„Die Tischgäste können die Sammlung in Vitrinen bewundern.“"
                                            },
                                            {
                                                "example_id": "b209d53e-4dd4-4264-96b1-e1ca51018675",
                                                "sense_id": "7e07b5eb-0482-3b6c-8320-3cfce63c74ec",
                                                "text": "„Minni stand noch immer vor der Vitrine.“"
                                            },
                                            {
                                                "example_id": "f5c688e4-0680-4226-906e-e247238cfbe9",
                                                "sense_id": "7e07b5eb-0482-3b6c-8320-3cfce63c74ec",
                                                "text": "„An der Wand stand auf einem weißen Podest eine mannshohe Vitrine aus dickem Sicherheitsglas, dahinter ein einfacher Holzstuhl.“"
                                            },
                                            {
                                                "example_id": "b613c285-2190-4d34-9b48-8a15840a88c0",
                                                "sense_id": "7e07b5eb-0482-3b6c-8320-3cfce63c74ec",
                                                "text": "„Er führte mich durch den schwach beleuchteten Raum, vorbei an den Büsten berühmter historischer Persönlichkeiten, an Touristen und Studierenden, von Glaskasten zu Glaskasten, von der Vitrine mit Elton Johns handgeschriebenen Liedtexten bis zu dem Originalnotizbuch von Leonardo da Vinci.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
