                    },
                    {
                        "translation_id": "d2f81f0d-8ca7-487e-9446-26d6282a7f7a",
                        "source_entry_id": "c60967a5-5d4c-3467-b1b4-2c3f4dec5567",
                        "source_sense_id": "db763993-b74f-3f9e-80e3-1989d89e96c2",
                        "target_lang_word": "tweenager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tweenager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d83626d-fa58-3104-86fa-290472d099bd",
                                        "entry_id": "e3ba4210-fe30-36b2-acf0-eb1c657d4109",
                                        "glosses": [
                                            "A young person who is not yet a teenager (being less than thirteen years old), but starting to act like one: generally ten to twelve years old."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab958bb5-884a-4bc1-b9f1-a3fb34ca1c9e",
                                                "sense_id": "3d83626d-fa58-3104-86fa-290472d099bd",
                                                "text": "Your eight to twelve year old is in the gray area between early childhood and the teen years. He is a child in the middle—a “tweenager.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb51576e-e99b-4ff9-8362-6348d4000770",
                        "source_entry_id": "c60967a5-5d4c-3467-b1b4-2c3f4dec5567",
                        "source_sense_id": "db763993-b74f-3f9e-80e3-1989d89e96c2",
                        "target_lang_word": "tween",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tween",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b80f1076-1faf-35f6-a186-4e616ffc99e9",
                                        "entry_id": "0bf0d92a-fc54-38f9-af7c-2a97a8d43571",
                                        "glosses": [
                                            "Alternative spelling of 'tween."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6ed436d-2a4f-459b-b6a4-486062bfa15e",
                                                "sense_id": "b80f1076-1faf-35f6-a186-4e616ffc99e9",
                                                "text": "“Skunks first colonized this land in 1794. With the arrival of European settlers, an uneasy truce was established tween man and skunk. Gifts were exchanged. Treaties were struck... and broken. A feud ignited, resulting in the Battle of Skunktown.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tween",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "488edc94-27ab-3611-b19b-da058c135940",
                                        "entry_id": "1cbda496-6a0d-3df6-ad55-e9eb8eb8b5b0",
                                        "glosses": [
                                            "An action of tweening (inserting frames for continuity); a sequence of frames generated by tweening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e538f9c5-ef26-41e0-bc24-c5bbb4b4ab4e",
                                                "sense_id": "488edc94-27ab-3611-b19b-da058c135940",
                                                "text": "Because the results of a shape tween can be unpredictable, you can set shape hints to let Flash know how to proceed with the tween."
                                            },
                                            {
                                                "example_id": "67288ea3-b888-49a9-bf43-7b0493a1d05e",
                                                "sense_id": "488edc94-27ab-3611-b19b-da058c135940",
                                                "text": "A tween is a method of creating animation, where you tell Flash where to start and where to end, and Flash does all the work in the middle. There are three types of tweens: Classic, Shape, and Motion."
                                            },
                                            {
                                                "example_id": "1f6ee179-0708-4185-a1f1-a54d4e578986",
                                                "sense_id": "488edc94-27ab-3611-b19b-da058c135940",
                                                "text": "If you select the frames first, they will be replaced by the copied tween."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tween",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bbedc38-e76a-3237-a302-33e5174d222c",
                                        "entry_id": "56d4ce0d-3cbf-366a-af32-eb0e58bfa67e",
                                        "glosses": [
                                            "To generate intermediate frames in an animated sequence so as to give the appearance of smooth movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a31fad7-29c3-4d02-b2e1-42beca29f533",
                                                "sense_id": "9bbedc38-e76a-3237-a302-33e5174d222c",
                                                "text": "The two most important and advanced ingredients of today's animation are tweening and morphing."
                                            },
                                            {
                                                "example_id": "11f4dd77-d1c3-4007-93fc-383958573ba7",
                                                "sense_id": "9bbedc38-e76a-3237-a302-33e5174d222c",
                                                "text": "Simple motion tweening moves your objects in a straight line from here to there.[…]You can also combine frame-by-frame animation with tweened animation."
                                            },
                                            {
                                                "example_id": "b88eba12-f797-49bd-88bc-249bf90713c2",
                                                "sense_id": "9bbedc38-e76a-3237-a302-33e5174d222c",
                                                "text": "The first parameter is the object that you want to tween, and the second parameter is the amount of time you want it to take in seconds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tween",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f13351c-1dc4-3897-96d2-393caa6ab435",
                                        "entry_id": "eb980dd3-0b11-3758-a69b-31d1cf381bbe",
                                        "glosses": [
                                            "A child, especially a girl, in the age range between middle childhood and adolescence, normally between eight and thirteen years of age."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37546ac2-15a5-40d9-b230-80f477712291",
                                                "sense_id": "0f13351c-1dc4-3897-96d2-393caa6ab435",
                                                "text": "When Play Along — the holder of the Care Bears master toy license — placed Care Bears plushes in Spencer Gifts last year, tweens and teenage girls bought the toys."
                                            },
                                            {
                                                "example_id": "6894ec82-3463-4402-a09a-d8da4b8f2f5b",
                                                "sense_id": "0f13351c-1dc4-3897-96d2-393caa6ab435",
                                                "text": "This grade school thinking forgets that tweens are one of the most sophisticated groups of consumers in the marketplace, and that kids this age have zero tolerance for being treated like children."
                                            },
                                            {
                                                "example_id": "b504878c-93ee-4abd-b095-df2ab98c3d49",
                                                "sense_id": "0f13351c-1dc4-3897-96d2-393caa6ab435",
                                                "text": "Next stop on the worthless train is the tweens who range from ages ten to thirteen years old. The tweens are so damn annoying, they make me want to jump off a cliff."
                                            },
                                            {
                                                "example_id": "e57515d3-2fb0-4b0e-ad40-766038093759",
                                                "sense_id": "0f13351c-1dc4-3897-96d2-393caa6ab435",
                                                "text": "However, if we worry too much about feeding our tweens, and if we show them we're worried, we could be passing on some unhealthy messages."
                                            },
                                            {
                                                "example_id": "1492d340-b963-484e-95c2-562aec78005e",
                                                "sense_id": "0f13351c-1dc4-3897-96d2-393caa6ab435",
                                                "text": "America's tweens (ages eight to twelve) are a population of more than twenty million."
                                            },
                                            {
                                                "example_id": "0902794b-6a90-4e9d-95e3-85a9957c34e6",
                                                "sense_id": "0f13351c-1dc4-3897-96d2-393caa6ab435",
                                                "text": "But in this variation on Superbad’s wild night of transgression, downshifting the age of the protagonists from teen to tween actually only enhances the stealth, wide-eyed innocence that secretly drives this genre of pre-college hedonism."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tween",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3eadc3da-2612-3785-ac02-15939b642994",
                                        "entry_id": "a89b6b54-140c-34f7-8185-66935251d0bd",
                                        "glosses": [
                                            "Of or having to do with tweenagers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa1db9f5-849b-4f7b-b534-1703e94ffdc7",
                                                "sense_id": "3eadc3da-2612-3785-ac02-15939b642994",
                                                "text": "I am going to describe a video that threw me into a pit of despair. It begins with a woman running into the aisle of a big-box store and telling a tween boy that she needs phone chargers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tween",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b5fa1c2-db77-3636-9fa6-b6444af97cfc",
                                        "entry_id": "0cf2f7b6-c88f-39ad-b94a-b34569b1189d",
                                        "glosses": [
                                            "A number or age in the twenties (plural only), or a person of that age."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08c17d68-fa89-4975-86ec-88aeea0e3a22",
                                                "sense_id": "8b5fa1c2-db77-3636-9fa6-b6444af97cfc",
                                                "text": "At that time Frodo was still in his tweens, as the hobbits called the irresponsible twenties between childhood and coming of age at thirty-three."
                                            },
                                            {
                                                "example_id": "b578b4c4-8cdf-4d0b-95ac-1502be73ca00",
                                                "sense_id": "8b5fa1c2-db77-3636-9fa6-b6444af97cfc",
                                                "text": "And although Mums don't always control the purse strings of the tweens (the younger set in their twenties), they are not entirely a forgotten influence."
                                            }
                                        ]
                                    }
                                ]
                            }
