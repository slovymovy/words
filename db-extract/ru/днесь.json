        "ru-extract.jsonl": [
            {
                "entry_id": "651f2bfd-9793-3f59-a622-638ae88a1ca3",
                "word": "днесь",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5dc66db9-0b2f-3107-bcf7-5cbd4abcbba0",
                        "entry_id": "651f2bfd-9793-3f59-a622-638ae88a1ca3",
                        "glosses": [
                            "устар., церк.-слав. поэт. теперь, сегодня"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "435f84bf-e179-48c7-bea6-4038c5c6e1d2",
                                "sense_id": "5dc66db9-0b2f-3107-bcf7-5cbd4abcbba0",
                                "text": "Ибо все днесь мне её добро́ты // Мыслить умом есть много охоты."
                            },
                            {
                                "example_id": "03bf734b-250a-4ab3-a668-fb83874560e7",
                                "sense_id": "5dc66db9-0b2f-3107-bcf7-5cbd4abcbba0",
                                "text": "Всегда казалась облачна, а теперь ясна, всегда взволнованна, а теперь спокойна, всегда в тревоге, днесь почиет с миром."
                            },
                            {
                                "example_id": "a86514f5-547b-4316-94ac-de3fd9f7cc40",
                                "sense_id": "5dc66db9-0b2f-3107-bcf7-5cbd4abcbba0",
                                "text": "Он открыл мне днесь всю истинную цену сокровища, которым, по безмерным щедротам его, я владею, и велел мне ещё преобразиться в наидовольнейшего судьбою своею человека."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06cf8fc4-2cea-498b-b2b0-d17c4895c69b",
                        "source_entry_id": "651f2bfd-9793-3f59-a622-638ae88a1ca3",
                        "source_sense_id": "5dc66db9-0b2f-3107-bcf7-5cbd4abcbba0",
                        "target_lang_word": "nowadays",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nowadays",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d4ef1eb-2598-3dd4-8051-fc61b91219bf",
                                        "entry_id": "a7bbf089-906c-38f3-b0ac-a254c96bca47",
                                        "glosses": [
                                            "At the present time; in the current era."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3332f7b9-97ca-4e5c-b7e4-149c883342a0",
                                                "sense_id": "7d4ef1eb-2598-3dd4-8051-fc61b91219bf",
                                                "text": "Cars nowadays are more efficient."
                                            },
                                            {
                                                "example_id": "293e6f75-5d94-4743-8ce6-65e69761bc9c",
                                                "sense_id": "7d4ef1eb-2598-3dd4-8051-fc61b91219bf",
                                                "text": "Me-thinkes miſtreſſe, you ſhould haue little reaſon for that: and yet to ſay the truth, reaſon and loue keepe little company together, now-adayes."
                                            },
                                            {
                                                "example_id": "54ddc396-c1fc-46dd-875b-e37c1b37e74a",
                                                "sense_id": "7d4ef1eb-2598-3dd4-8051-fc61b91219bf",
                                                "text": "What is it that now adayes makes all our quarrells mortall?"
                                            },
                                            {
                                                "example_id": "1be6d1bf-4833-4ad3-b81e-daf19d50ee4e",
                                                "sense_id": "7d4ef1eb-2598-3dd4-8051-fc61b91219bf",
                                                "text": "The appellation of Germany, is ſeldom uſed now-a-days any where but in the title of the Emperor and Elector of Mentz."
                                            },
                                            {
                                                "example_id": "1e2ae3ff-db47-4b8f-bc63-155f42bb7e80",
                                                "sense_id": "7d4ef1eb-2598-3dd4-8051-fc61b91219bf",
                                                "text": "And in his spare moments, of which there were not many nowadays, he would go alone to the quarry, collect a load of broken stone, and drag it down to the site of the windmill unassisted."
                                            },
                                            {
                                                "example_id": "90d109d5-231a-4b2d-adce-0156c65fd3b0",
                                                "sense_id": "7d4ef1eb-2598-3dd4-8051-fc61b91219bf",
                                                "text": "My favourite reading nowadays is Pulse, one of the house magazines for GPs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "799b6747-f01b-4d2d-a7cf-c3633e882042",
                        "source_entry_id": "651f2bfd-9793-3f59-a622-638ae88a1ca3",
                        "source_sense_id": "5dc66db9-0b2f-3107-bcf7-5cbd4abcbba0",
                        "target_lang_word": "today",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "today",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd24ade3-326d-308b-a2ea-802565abb904",
                                        "entry_id": "bcfd3a9e-6652-392c-a10b-eccb06efff7d",
                                        "glosses": [
                                            "On the current day or date."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40617082-939e-4ac0-bf72-222dbc9047b1",
                                                "sense_id": "fd24ade3-326d-308b-a2ea-802565abb904",
                                                "text": "I want this done today."
                                            },
                                            {
                                                "example_id": "e72d75e0-1883-4748-842c-dcb552da0d4e",
                                                "sense_id": "fd24ade3-326d-308b-a2ea-802565abb904",
                                                "text": "Today, my brother went to the shops."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e9a284c-eaf6-3fc9-b05e-2b034f6a6c64",
                                        "entry_id": "bcfd3a9e-6652-392c-a10b-eccb06efff7d",
                                        "glosses": [
                                            "In the current era; nowadays; these days."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23563bd0-fb29-441e-a8f9-b28b4d28aa3a",
                                                "sense_id": "2e9a284c-eaf6-3fc9-b05e-2b034f6a6c64",
                                                "text": "In the 1500s, people had to do things by hand, but today we have electric can openers."
                                            },
                                            {
                                                "example_id": "4192410f-0e85-4d8c-8f9f-c87a332dd3b3",
                                                "sense_id": "2e9a284c-eaf6-3fc9-b05e-2b034f6a6c64",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d158437-6d1f-3ed4-bf1f-3ce28b4133d7",
                                        "entry_id": "bcfd3a9e-6652-392c-a10b-eccb06efff7d",
                                        "glosses": [
                                            "The day of a recurring cycle or event which is currently happening."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7413e10c-c55c-4f26-99e0-f72a5c0cadad",
                                                "sense_id": "4d158437-6d1f-3ed4-bf1f-3ce28b4133d7",
                                                "text": "We used to prepare everything today, but now we split it over two days."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "today",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1a978c5-d573-33d0-a5a1-db11b10132e4",
                                        "entry_id": "2c3f2fee-07ad-3412-86de-6412a52309b2",
                                        "glosses": [
                                            "The current day or date."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2386476e-f054-4637-a15b-7c4ea9b1fd27",
                                                "sense_id": "d1a978c5-d573-33d0-a5a1-db11b10132e4",
                                                "text": "Today is the day we'll fix this once and for all."
                                            },
                                            {
                                                "example_id": "4d6487c4-c819-4d67-97f8-a03939671c02",
                                                "sense_id": "d1a978c5-d573-33d0-a5a1-db11b10132e4",
                                                "text": "We could've spent today at the seaside if it weren't gusty."
                                            },
                                            {
                                                "example_id": "60bd9d3d-7109-4f39-9aa6-7865d4488869",
                                                "sense_id": "d1a978c5-d573-33d0-a5a1-db11b10132e4",
                                                "text": "Yesterday, upon the stair / I met a man who wasn’t there / He wasn’t there again today / I wish, I wish he’d go away …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89541087-4d94-35a4-b512-dae0a3edd03c",
                                        "entry_id": "2c3f2fee-07ad-3412-86de-6412a52309b2",
                                        "glosses": [
                                            "The 24-hour period beginning at 5am or 6am or sunrise of the current day."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25db4366-92e3-3c24-99ae-5cabd29cd9e5",
                                        "entry_id": "2c3f2fee-07ad-3412-86de-6412a52309b2",
                                        "glosses": [
                                            "The present era; nowadays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eabfbc5e-2c9d-464a-b45c-fb125f34357d",
                                                "sense_id": "25db4366-92e3-3c24-99ae-5cabd29cd9e5",
                                                "text": "This is the sporty jacket for today's modern man on the go."
                                            },
                                            {
                                                "example_id": "87172600-ed07-45d9-845f-3cdd91bb905d",
                                                "sense_id": "25db4366-92e3-3c24-99ae-5cabd29cd9e5",
                                                "text": "The youth of today have never known what life is like without a cell phone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "today",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f5b7750-e1be-3295-ae83-d161681e6432",
                                        "entry_id": "f84b6c06-73c6-38fe-94b2-e592f3ba9a99",
                                        "glosses": [
                                            "Current; up to date."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f8a7800-770f-4125-81db-fdc6200f080d",
                                                "sense_id": "9f5b7750-e1be-3295-ae83-d161681e6432",
                                                "text": "Actually, it's more like the blues. It's pop blues. I feel it's very American. It's very today. It's what people respond to today."
                                            },
                                            {
                                                "example_id": "e65e6a0a-a246-4942-bb3a-27912eabb4ee",
                                                "sense_id": "9f5b7750-e1be-3295-ae83-d161681e6432",
                                                "text": "[…] she (Françoise Hardy) is so today, so white boots and yé-yé, that she can make anyone over 25 (me) feel prehistoric, raccoon coat and rah-rah."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
