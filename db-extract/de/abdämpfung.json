                "senses": [
                    {
                        "sense_id": "ef68e0ef-4898-36eb-9bb1-c63e5f328917",
                        "entry_id": "f0926595-a30c-3903-a06a-536a2f3707cd",
                        "glosses": [
                            "Vorgang, bei dem etwas in seiner (Aus-)Wirkung gemildert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89c138cc-1102-4ec3-9e18-2ad3048df8ab",
                                "sense_id": "ef68e0ef-4898-36eb-9bb1-c63e5f328917",
                                "text": "„RF-Lecks durch benachbarte Radiostationen können in abgeschirmten Räumen gemildert werden, mit denen über einen Frequenzbereich von 50 kHz bis 1 GHz Abdämpfungen von 120 dB erzielt werden können.“"
                            },
                            {
                                "example_id": "92485c89-8aa7-4ec2-9216-f3e570f394a4",
                                "sense_id": "ef68e0ef-4898-36eb-9bb1-c63e5f328917",
                                "text": "„Zur Abdämpfung dieser Wirkungen, die bei Dampfbetrieb zufolge Elastizität des Getriebes nicht in Erscheinung treten, ist es nötig, die Elektromotoren mit sog. Rutschkupplungen zu versehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
