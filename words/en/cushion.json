{
    "word_family": [
        "cushioning",
        "cushiony",
        "pincushion"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a752f43-3e5e-3dda-a8a7-3948789a68aa",
                    "sense_definition": "A soft mass of material stuffed into a cloth bag, used for comfort or support.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "soft-support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She placed a soft <w>cushion</w> behind her back to make the wooden chair more comfortable.",
                            "target_lang_translations": {
                                "ru": "Она подложила под спину мягкую <w>подушку</w>, чтобы на деревянном стуле было удобнее сидеть."
                            }
                        },
                        {
                            "text": "The cat was sleeping peacefully on a <w>velvet</w> <w>cushion</w> in the corner of the room.",
                            "target_lang_translations": {
                                "ru": "Кот мирно спал на бархатной <w>подушке</w> в углу комнаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "pad"
                    ],
                    "common_phrases": [
                        "velvet cushion",
                        "seat cushion",
                        "soft cushion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий предмет, наполненный каким-либо материалом и зашитый в чехол, используемый для комфорта или поддержки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подушка",
                                "target_lang_sense_clarification": "декоративная или диванная"
                            },
                            {
                                "target_lang_word": "диванная подушка",
                                "target_lang_sense_clarification": "специально для мебели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb231e57-713d-3027-b7b6-91c353e36cd2",
                    "sense_definition": "An amount of something, such as money or points, kept in reserve to protect against a loss or difficulty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reserve-protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team had a ten-point <w>cushion</w> going into the final minutes of the game.",
                            "target_lang_translations": {
                                "ru": "У команды был <w>запас</w> в десять очков перед последними минутами игры."
                            }
                        },
                        {
                            "text": "It is wise to keep a <w>financial</w> <w>cushion</w> in your savings account for unexpected emergencies.",
                            "target_lang_translations": {
                                "ru": "Разумно иметь финансовую <w>подушку</w> на сберегательном счете на случай непредвиденных обстоятельств."
                            }
                        }
                    ],
                    "common_phrases": [
                        "financial cushion",
                        "safety cushion",
                        "points cushion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запас чего-либо (денег, очков), предназначенный для защиты от потерь или трудностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подушка",
                                "target_lang_sense_clarification": "в значении запаса, например, финансовая"
                            },
                            {
                                "target_lang_word": "буфер",
                                "target_lang_sense_clarification": "защитный запас или промежуточное звено"
                            },
                            {
                                "target_lang_word": "запас",
                                "target_lang_sense_clarification": "резерв для безопасности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19445876-f724-3b4d-82f7-e55ee45a7bf2",
                    "sense_definition": "The elastic lip around the edge of a billiard or pool table that causes the balls to bounce back.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports-equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball hit the <w>cushion</w> at a sharp angle and rolled into the corner pocket.",
                            "target_lang_translations": {
                                "ru": "Шар ударился о <w>борт</w> под острым углом и закатился в угловую лузу."
                            }
                        },
                        {
                            "text": "Professional players know exactly how much the <w>cushion</w> will affect the speed of the ball.",
                            "target_lang_translations": {
                                "ru": "Профессиональные игроки точно знают, как <w>борт</w> повлияет на скорость шара."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hit the cushion",
                        "billiard cushion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упругий край бильярдного стола, от которого отскакивают шары."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борт",
                                "target_lang_sense_clarification": "бильярдного стола"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d1c937d-7d91-340c-b894-807a8ca84450",
                    "sense_definition": "To soften the effect of a physical impact or a negative situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soften-impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick grass helped to <w>cushion</w> his fall when he tripped.",
                            "target_lang_translations": {
                                "ru": "Густая трава помогла <w>смягчить</w> его падение, когда он споткнулся."
                            }
                        },
                        {
                            "text": "The government introduced new measures to <w>cushion</w> the <w>blow</w> of the economic recession.",
                            "target_lang_translations": {
                                "ru": "Правительство ввело новые меры, чтобы <w>смягчить</w> удар экономического спада."
                            }
                        }
                    ],
                    "synonyms": [
                        "pad"
                    ],
                    "common_phrases": [
                        "cushion the blow",
                        "cushion the impact",
                        "cushion the fall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смягчать воздействие физического удара или негативной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смягчать",
                                "target_lang_sense_clarification": "удар или последствия"
                            },
                            {
                                "target_lang_word": "амортизировать",
                                "target_lang_sense_clarification": "физический удар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22f7404b-6230-31b5-af6e-0329ca686303",
                    "sense_definition": "To provide or furnish a piece of furniture with soft pads.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "furnish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter decided to <w>cushion</w> the bench to make it more inviting for guests.",
                            "target_lang_translations": {
                                "ru": "Плотник решил <w>сделать мягкой</w> скамью, чтобы она выглядела более уютной для гостей."
                            }
                        },
                        {
                            "text": "They spent the afternoon learning how to <w>cushion</w> a chair with new fabric and foam.",
                            "target_lang_translations": {
                                "ru": "Они провели весь день, учась тому, как <w>обить</w> стул новой тканью и поролоном."
                            }
                        }
                    ],
                    "synonyms": [
                        "pad"
                    ],
                    "common_phrases": [
                        "cushion a chair",
                        "cushion a sofa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснащать мебель мягкими подкладками или подушками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обивать",
                                "target_lang_sense_clarification": "делать мягким, используя наполнитель"
                            },
                            {
                                "target_lang_word": "подкладывать подушки",
                                "target_lang_sense_clarification": "для мягкости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}