                                "example_id": "95fb5bf9-4be8-4f20-9193-9ffb16402a69",
                                "sense_id": "c4aef5a4-0ccc-3738-a683-5c105922e828",
                                "text": "„In der Bibliographie von Max D. Dippold sind zur Anthropologie Kameruns in der deutschen Kolonialpresse 314 Zeitungs- und Zeitschriftenartikel aufgelistet.“"
                            },
                            {
                                "example_id": "f02acd1b-6061-40c1-9790-d37f562c0d6c",
                                "sense_id": "c4aef5a4-0ccc-3738-a683-5c105922e828",
                                "text": "„Die Entwicklung der Kolonialpresse stimmt mit einem Zeitraum überein, der häufig als eng provinziell in der amerikanischen Literatur angesehen wird und dessen geistiges Klima von verschiedenen Faktoren bestimmt wurde.“"
                            }
