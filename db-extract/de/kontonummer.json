                ],
                "senses": [
                    {
                        "sense_id": "ad8db786-70c2-3624-a60f-781abf0f2705",
                        "entry_id": "57aa82a2-2ef3-3f54-9465-181353728224",
                        "glosses": [
                            "aus Ziffern bestehende Bezeichnung eines Kontos, meist bei einem Geldinstitut, zum Beispiel bei einer Bank, Sparkasse, aber auch bei einem Dienstleister oder innerhalb des Betrieblichen Rechnungswesens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4494f058-a42d-43ec-838a-adac5388ac57",
                                "sense_id": "ad8db786-70c2-3624-a60f-781abf0f2705",
                                "text": "Die neuen, 22-stelligen Kontonummern kann man sich nur schwer merken."
                            },
                            {
                                "example_id": "5f5e3da8-6406-4b58-9de8-31c9a64b51c5",
                                "sense_id": "ad8db786-70c2-3624-a60f-781abf0f2705",
                                "text": "Geben Sie bitte hier Ihre Kontonummer und Ihre PIN-Nummer ein."
                            },
                            {
                                "example_id": "d34ddd74-865b-441e-bb09-5c798797ae0d",
                                "sense_id": "ad8db786-70c2-3624-a60f-781abf0f2705",
                                "text": "Neukunden müssen ein Konto registrieren lassen und erhalten ihre persönliche Kontonummer per E-Mail zugeschickt."
                            },
                            {
                                "example_id": "f41d58bf-a7c4-4c06-8728-2b2b9c3a4068",
                                "sense_id": "ad8db786-70c2-3624-a60f-781abf0f2705",
                                "text": "Jedes Buchhaltungskonto hat eine vierstellige Kontonummer. Die vierstelligen Kontonummern können jedoch um weitere Ziffern ergänzt werden."
                            },
                            {
                                "example_id": "43a112aa-6057-4cb2-8d35-b664e0d85735",
                                "sense_id": "ad8db786-70c2-3624-a60f-781abf0f2705",
                                "text": "Im Anlagenstamm des Buchungssystems kann jetzt auch neben der Kontonummer ein Buchungskreis zugeordnet werden."
                            },
                            {
                                "example_id": "0644df4c-b8f2-4237-96f4-7f7b784a326a",
                                "sense_id": "ad8db786-70c2-3624-a60f-781abf0f2705",
                                "text": "„Stian reichte mir einen kleinen Notizblock, und darauf notierte ich meine Kontonummer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
