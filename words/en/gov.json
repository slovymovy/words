                },
                {
                    "sense_id": "c33584b2-5344-398c-ae70-9284da435f8f",
                    "sense_definition": "A shortened form of <w>governor</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "titles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The staff often referred to the prison warden as the <w>gov</w> during their shifts.",
                            "target_lang_translations": {
                                "ru": "Сотрудники во время смен часто называли начальника тюрьмы <w>шефом</w>."
                            }
                        },
                        {
                            "text": "I need to check with the <w>gov</w> before we make any changes to the schedule.",
                            "target_lang_translations": {
                                "ru": "Мне нужно посоветоваться с <w>начальником</w>, прежде чем мы внесем какие-либо изменения в график."
                            }
                        }
                    ],
                    "synonyms": [
                        "guv"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal shortening"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма слова governor (губернатор, начальник тюрьмы)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "губер",
                                "target_lang_sense_clarification": "сленговое сокращение от губернатор"
                            },
                            {
                                "target_lang_word": "начальник",
                                "target_lang_sense_clarification": "в контексте руководства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c78a9f67-0d8d-3692-9b5b-8061e1e35240",
                    "sense_definition": "An informal term of address used for a man, typically a stranger or someone in a position of authority.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Excuse me <w>gov</w>, do you happen to have the time?",
                            "target_lang_translations": {
                                "ru": "Простите, <w>шеф</w>, у вас не найдется времени?"
                            }
                        },
                        {
                            "text": "The taxi driver said thanks <w>gov</w> after receiving a generous tip from the passenger.",
                            "target_lang_translations": {
                                "ru": "Таксист сказал: «Спасибо, <w>командир</w>», получив щедрые чаевые от пассажира."
                            }
                        }
                    ],
                    "synonyms": [
                        "guv"
                    ],
                    "common_phrases": [
                        "thanks gov",
                        "sorry gov"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal address"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное обращение к мужчине, обычно к незнакомцу или лицу, наделенному властью (британский сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
