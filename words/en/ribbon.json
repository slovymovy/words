{
    "word_family": [
        "beribbon",
        "ribbonlike"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39307008-9b7d-3bb8-bc61-b7802e92475f",
                    "sense_definition": "A long, narrow strip of material (such as silk or satin) used for tying things, decoration, or gift wrapping.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material_strip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tied a red <w>ribbon</w> around the birthday present.",
                            "target_lang_translations": {
                                "ru": "Она повязала красную <w>ленту</w> вокруг подарка на день рождения.",
                                "zh": "她在生日礼物上系了一根红色的<w>丝带</w>。"
                            }
                        },
                        {
                            "text": "The little girl wore a blue <w>ribbon</w> in her hair to match her dress.",
                            "target_lang_translations": {
                                "ru": "Маленькая девочка носила голубую <w>ленту</w> в волосах под цвет своего платья.",
                                "zh": "小女孩在头发上戴了一根蓝色的<w>丝带</w>，以搭配她的裙子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blue ribbon",
                        "red ribbon",
                        "silk ribbon",
                        "tie a ribbon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная узкая полоска материала (например, шелка или атласа), используемая для завязывания, украшения или упаковки подарков.",
                        "zh": "一种长而窄的材料条（如丝绸或缎子），用于捆绑、装饰或包装礼物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ле́нта",
                                "target_lang_sense_clarification": "полоска ткани"
                            },
                            {
                                "target_lang_word": "бант",
                                "target_lang_sense_clarification": "украшение из ленты, завязанное узлом"
                            },
                            {
                                "target_lang_word": "тесьма́",
                                "target_lang_sense_clarification": "узкая тканая полоска"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丝带",
                                "target_lang_sense_clarification": "用于装饰或包装的织物带"
                            },
                            {
                                "target_lang_word": "缎带",
                                "target_lang_sense_clarification": "丝绸或缎子材质的带子"
                            },
                            {
                                "target_lang_word": "蝴蝶结",
                                "target_lang_sense_clarification": "用丝带打成的装饰性结"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdc3d121-83ee-3704-b942-8c1ec6a25e03",
                    "sense_definition": "A small loop of colored ribbon worn pinned to clothing to show support for a specific cause or charity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "material_strip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people wore a pink <w>ribbon</w> during the month of October.",
                            "target_lang_translations": {
                                "ru": "Многие люди носили розовую <w>ленту</w> в течение октября.",
                                "zh": "十月期间，许多人佩戴着粉红色的<w>丝带</w>。"
                            }
                        },
                        {
                            "text": "He pinned a black <w>ribbon</w> to his lapel as a sign of mourning.",
                            "target_lang_translations": {
                                "ru": "Он прикрепил черную <w>ленту</w> к лацкану в знак траура.",
                                "zh": "他把一根黑色的<w>丝带</w>别在翻领上，以示哀悼。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pink ribbon",
                        "awareness ribbon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая петля из цветной ленты, которую прикрепляют к одежде в знак поддержки определенного дела или благотворительности.",
                        "zh": "一种别在衣服上的彩色小丝带环，用以表示对特定事业或慈善活动的支持。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ле́нта",
                                "target_lang_sense_clarification": "символ поддержки"
                            },
                            {
                                "target_lang_word": "ле́нточка",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丝带",
                                "target_lang_sense_clarification": "作为支持象征的丝带"
                            },
                            {
                                "target_lang_word": "纪念丝带",
                                "target_lang_sense_clarification": "用于表达支持或纪念的丝带"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c275c66-f4c0-3e64-b502-7bca4eccbe64",
                    "sense_definition": "A long, narrow strip or shred of something, often resulting from tearing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shred",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wind tore the sails of the old boat to <w>ribbons</w>.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер разорвал паруса старой лодки в <w>клочья</w>.",
                                "zh": "强风把旧船的帆撕成了<w>条状</w>。"
                            }
                        },
                        {
                            "text": "He cut the paper into long <w>ribbons</w> to use for the art project.",
                            "target_lang_translations": {
                                "ru": "Он нарезал бумагу на длинные <w>полоски</w> для художественного проекта.",
                                "zh": "他把纸剪成长<w>条</w>，用于艺术项目。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "torn to ribbons",
                        "cut into ribbons"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная узкая полоска или лоскут чего-либо, часто образующийся в результате разрыва или разрезания.",
                        "zh": "长而窄的条状物或碎片，通常因撕裂而产生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поло́ска",
                                "target_lang_sense_clarification": "узкий кусок бумаги или ткани"
                            },
                            {
                                "target_lang_word": "кло́чья",
                                "target_lang_sense_clarification": "в идиоме \"torn to ribbons\" (разорвать в клочья)"
                            },
                            {
                                "target_lang_word": "ле́нта",
                                "target_lang_sense_clarification": "длинная полоса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "条",
                                "target_lang_sense_clarification": "长条状的碎片"
                            },
                            {
                                "target_lang_word": "碎片",
                                "target_lang_sense_clarification": "撕裂后的细长部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54b9c1a5-5028-3003-88ff-50c253e96efc",
                    "sense_definition": "A graphical control element in a computer interface that displays toolbars and options within a set of tabs.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "computing_interface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can find the font settings in the <w>ribbon</w> at the top of the document.",
                            "target_lang_translations": {
                                "ru": "Вы можете найти настройки шрифта на <w>ленте</w> в верхней части документа.",
                                "zh": "你可以在文档顶部的<w>功能区</w>找到字体设置。"
                            }
                        },
                        {
                            "text": "The new software update changed the layout of the <w>ribbon</w> slightly.",
                            "target_lang_translations": {
                                "ru": "Новое обновление программного обеспечения немного изменило макет <w>ленты</w>.",
                                "zh": "新的软件更新稍微改变了<w>功能区</w>的布局。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ribbon interface",
                        "menu ribbon"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Графический элемент управления в компьютерном интерфейсе, отображающий панели инструментов и опции на наборе вкладок.",
                        "zh": "计算机界面中的一种图形控制元素，在选项卡集合中显示工具栏和选项。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ле́нта",
                                "target_lang_sense_clarification": "элемент интерфейса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "功能区",
                                "target_lang_sense_clarification": "软件界面顶部的工具栏区域"
                            },
                            {
                                "target_lang_word": "带状工具栏",
                                "target_lang_sense_clarification": "计算机界面术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42e9ba90-bbdc-3873-8153-68855d3205c8",
                    "sense_definition": "An inked strip of cloth or plastic used in typewriters and some printers to transfer ink onto paper.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material_strip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The letters were faint because the typewriter <w>ribbon</w> needed to be replaced.",
                            "target_lang_translations": {
                                "ru": "Буквы были бледными, так как <w>ленту</w> пишущей машинки нужно было заменить.",
                                "zh": "字迹很淡，因为打字机的<w>色带</w>需要更换了。"
                            }
                        },
                        {
                            "text": "He struggled to find a replacement <w>ribbon</w> for the antique machine.",
                            "target_lang_translations": {
                                "ru": "Ему было трудно найти сменную <w>ленту</w> для старинной машинки.",
                                "zh": "他费了好大劲才为那台古董机器找到替换的<w>色带</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "typewriter ribbon",
                        "ink ribbon"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пропитанная чернилами полоска ткани или пластика, используемая в пишущих машинках и некоторых принтерах для переноса чернил на бумагу.",
                        "zh": "打字机和某些打印机中使用的浸墨布条或塑料条，用于将墨水转移到纸上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ле́нта",
                                "target_lang_sense_clarification": "для пишущей машинки"
                            },
                            {
                                "target_lang_word": "кра́сящая ле́нта",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "色带",
                                "target_lang_sense_clarification": "打印机或打字机用的墨带"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f4772e6-3822-3fa2-bef1-5b563cdad5a6",
                    "sense_definition": "To decorate or adorn something with ribbons.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_decorate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hall was <w>ribboned</w> with colorful streamers for the celebration.",
                            "target_lang_translations": {
                                "ru": "Зал был <w>украшен лентами</w> и разноцветным серпантином для праздника.",
                                "zh": "为了庆祝活动，大厅里<w>装饰</w>着彩色的丝带和飘带。"
                            }
                        },
                        {
                            "text": "She <w>ribboned</w> the gift box beautifully before handing it to him.",
                            "target_lang_translations": {
                                "ru": "Она красиво <w>перевязала лентой</w> подарочную коробку, прежде чем вручить ее ему.",
                                "zh": "她在把礼盒交给他之前，漂亮地给它<w>系上</w>了丝带。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beribbon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать или декорировать что-либо лентами.",
                        "zh": "用丝带装饰或点缀某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украша́ть ле́нтами",
                                "target_lang_sense_clarification": "декорировать"
                            },
                            {
                                "target_lang_word": "перевя́зывать ле́нтой",
                                "target_lang_sense_clarification": "обвязывать для украшения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用丝带装饰",
                                "target_lang_sense_clarification": "装饰动作"
                            },
                            {
                                "target_lang_word": "系上丝带",
                                "target_lang_sense_clarification": "捆绑装饰动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}