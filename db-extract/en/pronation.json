                "translations": [
                    {
                        "translation_id": "7900ede5-5f62-45a2-9f21-29f49d9019c1",
                        "source_entry_id": "4a0fb8b0-6294-3ad3-8fb7-56e1446c2ac5",
                        "source_sense_description": "action of rotating the forearm",
                        "target_lang_word": "pronation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pronation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49b5a3ce-941c-301c-8c15-3b5c88dbdbc8",
                                        "entry_id": "c8661d91-df92-33ee-99fe-51740923419d",
                                        "glosses": [
                                            "Inclinaison, principalement usité dans cette expression : Mouvement de pronation : celui par lequel on tourne la main, de manière que la paume regarde la terre ; celui par lequel on tourne le pied de sorte que la plante regarde vers l’intérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f07f5c49-795b-4beb-a62d-e1292b10c637",
                                                "sense_id": "49b5a3ce-941c-301c-8c15-3b5c88dbdbc8",
                                                "text": "D’un autre côté, une forte pression sur l’avant-bras peut endolorer les parties, les priver pour le moment de la pronation et de la supination, quoiqu’il n'y ait pas fracture."
                                            },
                                            {
                                                "example_id": "92836d05-a5c7-4361-9eb6-64637880f45f",
                                                "sense_id": "49b5a3ce-941c-301c-8c15-3b5c88dbdbc8",
                                                "text": "Mes mains sont faites pour porter, justement, pour soulever, pour emporter. Des deux positions classiques —supination et pronation— seule la supination leur convient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4059f0f-4801-42dc-b358-681e25a2984b",
                        "source_entry_id": "4a0fb8b0-6294-3ad3-8fb7-56e1446c2ac5",
                        "source_sense_description": "action of rotating the forearm",
                        "target_lang_word": "Pronation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pronation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfa84035-0647-3d51-bd8b-896ab8c3cf2c",
                                        "entry_id": "06adbcdb-e2ae-3964-b564-0903ca6acd7c",
                                        "glosses": [
                                            "Drehung eines Gelenkes nach innen; Einwärtsdrehung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "431444c1-77a9-49a0-9792-c277bcbe33cb",
                                                "sense_id": "dfa84035-0647-3d51-bd8b-896ab8c3cf2c",
                                                "text": "„Bei Pronation und Supination rotiert der Unterarm um seine Längenachse, die durch das Zentrum des Radiuskopfs und dem Mittelpunkt der distalen ulnaren Gelenkfläche verläuft.“"
                                            },
                                            {
                                                "example_id": "f3b9f8d3-41fd-458c-bc43-3b1c839492aa",
                                                "sense_id": "dfa84035-0647-3d51-bd8b-896ab8c3cf2c",
                                                "text": "„Der Läufer soll sich dabei fragen, ob er zur Pronation oder Supination neigt - ob sein Sprunggelenk also beim Aufsetzen nach innen oder nach außen dreht.“"
                                            },
                                            {
                                                "example_id": "b4816e52-00e0-45e8-ad87-17d3cf77237c",
                                                "sense_id": "dfa84035-0647-3d51-bd8b-896ab8c3cf2c",
                                                "text": "„Seine Arme werden festgeschnallt, mit den Händen umklammert er zwei Griffe, die er nach innen und außen drehen muss; die eine Bewegung nennt man Pronation, die andere Supination.“"
                                            },
                                            {
                                                "example_id": "7b04349b-3972-419d-980a-5afcf859d78b",
                                                "sense_id": "dfa84035-0647-3d51-bd8b-896ab8c3cf2c",
                                                "text": "„Knickt die Ferse zum Beispiel nur wenig nach innen an, nennt sich das eine normale Pronation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
