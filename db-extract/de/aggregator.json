                    {
                        "sense_id": "05033f18-148b-31c4-839c-e3c6e82acc34",
                        "entry_id": "415e7e25-4079-3716-a325-3c23360499c4",
                        "glosses": [
                            "Dienstleister, der Medieninhalte, sammelt, aufbereitet und kategorisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78993480-d9e0-4b1d-becc-c02380175662",
                                "sense_id": "05033f18-148b-31c4-839c-e3c6e82acc34",
                                "text": "„Als Dienstleister fungiert der Aggregator als Schnittstelle zwischen Rechteinhabern und Kunden, indem er Inhalte lizenziert und (kostenpflichtig) weitergibt oder bestehende Angebote von Plattformbetreibern paketiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4884b487-4b5c-3ed3-9523-abd412453274",
                        "entry_id": "415e7e25-4079-3716-a325-3c23360499c4",
                        "glosses": [
                            "Computerprogramm, das digitale Inhalte sammelt, aufbereitet und verfügbar macht"
                        ],
                        "tags": [
                            "IT"
                        ],
                        "examples": [
                            {
                                "example_id": "9b7cd019-7d68-452f-84f2-5317ab2af27c",
                                "sense_id": "4884b487-4b5c-3ed3-9523-abd412453274",
                                "text": "„‚Auch Lego selbst hat schon lange mit dem Internet geflirtet‘, sagt der unabhängige Lego-Blogger Glen Bricker aus Texas. ReBrick.com zum Beispiel gehört dazu, ein Aggregator für Links zu Fanprojekten aus dem gesamten Web. Die eigentlich naheliegende Idee kam dem dänischen Unternehmen im Jahr 2008.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
