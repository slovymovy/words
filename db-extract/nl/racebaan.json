                "senses": [
                    {
                        "sense_id": "d4ccd096-b8ba-34d2-a491-e3d763d8b9d2",
                        "entry_id": "cf301ac4-9739-3eda-995d-e90ee62fddbb",
                        "glosses": [
                            "een baan om snelheidswedstrijden op te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8c59a67-51c0-40dd-83fe-afd160ff825a",
                                "sense_id": "d4ccd096-b8ba-34d2-a491-e3d763d8b9d2",
                                "text": "De weg wordt door velen nu gezien als een racebaan."
                            },
                            {
                                "example_id": "82357e60-1055-4db8-9e70-e98046035c3e",
                                "sense_id": "d4ccd096-b8ba-34d2-a491-e3d763d8b9d2",
                                "text": "Een cirkelvormige racebaan van 100 kilometer waarbinnen deeltjes zo onder het meer van Genève doorschieten. Dat is het plan dat Cern onthulde in een nieuwe ontwerpstudie voor de zogeheten Future Circular Collider (FCC)."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdee0aab-2b29-3537-8591-0ce3d0a6b8bd",
                        "entry_id": "cf301ac4-9739-3eda-995d-e90ee62fddbb",
                        "glosses": [
                            "een stuk speelgoed waarop met miniatuurvoertuigen snel gereden kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c713501f-ae25-4a7f-8bcb-f612955e5185",
                                "sense_id": "fdee0aab-2b29-3537-8591-0ce3d0a6b8bd",
                                "text": "Zijn racebaan is z'n lust en z'n leven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a80a5a5-de01-498f-a43a-db7446965c32",
                        "source_entry_id": "cf301ac4-9739-3eda-995d-e90ee62fddbb",
                        "source_sense_id": "d4ccd096-b8ba-34d2-a491-e3d763d8b9d2",
                        "source_sense_description": "een baan om snelheidswedstrijden op te houden",
                        "target_lang_word": "Rennbahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rennbahn",
