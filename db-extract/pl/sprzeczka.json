                                "example_id": "bcc64af3-98db-49de-8084-54139990888d",
                                "sense_id": "bacef894-4117-3641-99f1-4ab1b94c9f17",
                                "text": "Nigdy nie mieliśmy sprzeczki, którą wygrałem.",
                                "translation": "We've never had an argument that I won.",
