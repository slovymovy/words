                "forms": [],
                "senses": [
                    {
                        "sense_id": "88888257-89c4-3dc3-8a9c-d973cb8ca7cf",
                        "entry_id": "09045cfe-a095-30b9-85c3-feab180c653c",
                        "glosses": [
                            "Alternative form of amygdalin."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e76ab8bc-b8ee-4ac6-a27e-02a59fc8d0b0",
                                "sense_id": "88888257-89c4-3dc3-8a9c-d973cb8ca7cf",
                                "text": "It is known that emulsine and amygdaline are two innocent substances when they are administered by themselves, but that they develope hydrocyanic acid and become a violent poison when placed in contact."
                            },
                            {
                                "example_id": "6ef4e374-3d1b-4f6e-a9a2-19e5c6e90488",
                                "sense_id": "88888257-89c4-3dc3-8a9c-d973cb8ca7cf",
                                "text": "Not finding any key to this enigma, he (as is hat too frequently done) ascribed the formation of amygdaline, or the transformation of its elements into hydrocyanic acid and oil of bitter almonds, to the co-operation of an intangible and invisible something, which, from its nature, must be beyond the reach of our understanding."
                            },
                            {
                                "example_id": "5ebf94fc-89e4-4af9-9615-f7d8df0d6ccc",
                                "sense_id": "88888257-89c4-3dc3-8a9c-d973cb8ca7cf",
                                "text": "This insoluble residue, even when completely washed with distilled water so as to remove all soluble matter, still furnishes the characteristic reaction of emulsine with amygdaline."
                            }
                        ]
                    }
                ],
