                    {
                        "sense_id": "c190c012-518f-376a-a130-6f8dd374ecfa",
                        "entry_id": "e51dd9da-e5ae-3196-aa62-bdd55044feb0",
                        "glosses": [
                            "der Wärmegrad der Luft in einem bestimmten Wohnraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e02e825f-8bdb-4864-8d90-a3df83d522ed",
                                "sense_id": "c190c012-518f-376a-a130-6f8dd374ecfa",
                                "text": "Unsere Heizung ist defekt und die Zimmertemperatur beträgt nur noch 12 Grad."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aba219e5-8217-3e34-b563-ffd2c73ecde9",
                        "entry_id": "e51dd9da-e5ae-3196-aa62-bdd55044feb0",
                        "glosses": [
                            "der übliche Wärmegrad der Luft in einem Wohnraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a43677fd-a592-4a16-8e8c-ae88007daa7c",
                                "sense_id": "aba219e5-8217-3e34-b563-ffd2c73ecde9",
                                "text": "„Wichtig bei der Zubereitung von Fleisch ist, dass es Zimmertemperatur hat, also nicht direkt aus dem Kühlschrank kommt, damit es gleichmäßig gart.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a10e328-016e-46e6-a8cf-8bd61b013e91",
