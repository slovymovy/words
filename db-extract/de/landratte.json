                                "example_id": "07013964-5338-4d0e-8691-4cefd1bf7fdc",
                                "sense_id": "ad18a917-0662-3a28-a83a-b842180746c7",
                                "text": "Die Landratten haben ja keine Ahnung von Sturm und Orkan."
                            },
                            {
                                "example_id": "38b404a2-a554-4bbd-83d5-c420d39f7cad",
                                "sense_id": "ad18a917-0662-3a28-a83a-b842180746c7",
                                "text": "„Aber sein Bruder Lýdar segelte auch nicht mehr auf dem Schiff, er hatte eine Frau aus Nólsoy geheiratet und war eine Landratte geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
