                "translations": [
                    {
                        "translation_id": "117a9e1c-64fb-4de0-aaf0-ef4ff93b983e",
                        "source_entry_id": "dfa853d4-af11-31b8-a36a-892d09843db4",
                        "source_sense_id": "2a03dadd-fc5e-3474-b58a-04911c1be7ef",
