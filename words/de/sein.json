                    "frequency": "Low",
                    "semantic_group_id": "approximation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dieses alte Fahrrad hat damals bestimmt so <w>seine</w> dreihundert Mark gekostet."
                        },
                        {
                            "text": "Die Renovierung der Wohnung wird sicher so <w>ihre</w> oder <w>seine</w> fünf Wochen dauern."
                        }
                    ],
                    "common_phrases": [
