                "senses": [
                    {
                        "sense_id": "d773aa3e-458e-3786-8057-bd6634aba125",
                        "entry_id": "66ccac75-0534-3ee6-aeef-86ca7dbbdafb",
                        "glosses": [
                            "exemplaar van de Bijbel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08939af3-4196-4c39-835c-121019d710fb",
                                "sense_id": "d773aa3e-458e-3786-8057-bd6634aba125",
                                "text": "Ik heb een in leer gebonden bijbelboek gekocht."
                            },
                            {
                                "example_id": "1adb9b00-b2db-4f86-b75b-c3395552efdf",
                                "sense_id": "d773aa3e-458e-3786-8057-bd6634aba125",
                                "text": "O ja, het onderste plaatje heb ik wel zelf gezien in mijn bijbelboek met uitleg."
                            },
                            {
                                "example_id": "69402a95-3ec7-4c14-aabd-6f9530d44501",
                                "sense_id": "d773aa3e-458e-3786-8057-bd6634aba125",
                                "text": "„Abraham!” slikt zij tot haar moeder en ziet bevend in haar bijbelboek, terwijl haar vader dankt."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e6c06cb-4491-33b2-bd50-6706db574dcd",
                        "entry_id": "66ccac75-0534-3ee6-aeef-86ca7dbbdafb",
                        "glosses": [
                            "verouderde spelling of vorm van Bijbelboek vanaf 1955 tot 2006"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "b4e2ecd2-b309-41a8-9ed0-9675bcb48daf",
                                "sense_id": "4e6c06cb-4491-33b2-bd50-6706db574dcd",
                                "text": "Op de vertaling van het Bijbelgenootschap rust een embargo tot die 27ste, maar gedeelten uit die vertaling, waaronder het bijbelboek Prediker, zijn reeds gepubliceerd, en dat bijbelboek kun je bovendien van internet plukken."
                            }
                        ]
                    }
