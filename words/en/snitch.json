                },
                {
                    "sense_id": "203ec683-9e7c-3878-a3e7-0a4e1e107522",
                    "sense_definition": "A small flying ball used in the fictional sport of Quidditch.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "fictional_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seeker finally caught the golden <w>snitch</w> to win the game.",
                            "target_lang_translations": {
                                "fr": "L'attrapeur a finalement attrapé le <w>vif d'or</w> pour gagner le match."
                            }
                        },
                        {
                            "text": "Players chase the <w>snitch</w> across the field during the match.",
                            "target_lang_translations": {
