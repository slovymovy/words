                        "sense_id": "1d12555a-3516-3a96-9e51-8958e22541c0",
                        "entry_id": "8b01856b-fde5-3a45-b87a-d618352c9c79",
                        "glosses": [
                            "Preisverzeichnis der in einem gastronomischen Betrieb angebotenen Weine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e965329e-c725-41d8-8b88-70d77b537edc",
                                "sense_id": "1d12555a-3516-3a96-9e51-8958e22541c0",
                                "text": "Können Sie mir bitte die Weinkarte bringen?"
                            },
                            {
                                "example_id": "7a7c7fa7-490f-4e0e-a2c4-3461870e10e6",
                                "sense_id": "1d12555a-3516-3a96-9e51-8958e22541c0",
                                "text": "„Die Weinkarte kann sich sehen lassen - 140 Weine aus allen deutschen Anbaugebieten - aber deswegen kommen die Leute eigentlich nicht nach Meißen, denn wenn schon, dann soll es ein »echter« Meißner sein.“"
                            }
                        ],
