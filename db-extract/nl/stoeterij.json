                        "form": "stoeterijtje"
                    },
                    {
                        "form_id": "5ddcaf9b-b7d9-499a-987d-6dba3b8f30ef",
                        "entry_id": "8c0e6d83-a845-3135-ab13-19b6d23720c4",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "stoeterijtjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc725f0d-686a-3cf3-9675-220d10f5c018",
                        "entry_id": "8c0e6d83-a845-3135-ab13-19b6d23720c4",
                        "glosses": [
                            "het bedrijfsmatig telen van paarden"
                        ],
                        "tags": [
                            "veeteelt"
                        ],
                        "examples": [
                            {
                                "example_id": "d83dc4f3-2921-4d63-a9f9-6525796acf0e",
                                "sense_id": "fc725f0d-686a-3cf3-9675-220d10f5c018",
                                "text": "De koningin, die bekendstaat als groot paardenliefhebber, genoot zichtbaar van het evenement, zeker toen er op het hoogtepunt van de show dieren uit haar eigen stoeterij voorbij werden geleid. Met een deken over haar benen en een sjaal om volgde ze de show aandachtig en knikte ze soms instemmend bij alle lof."
                            }
                        ]
                    },
                    {
                        "sense_id": "82aea672-d285-35dd-8f83-60eb765578e4",
                        "entry_id": "8c0e6d83-a845-3135-ab13-19b6d23720c4",
                        "glosses": [
                            "de bedrijfslocatie waar paarden worden geteeld"
                        ],
                        "tags": [
                            "veeteelt"
                        ],
                        "examples": [
                            {
                                "example_id": "5afadedd-93ac-46b2-874b-30bb184a4494",
                                "sense_id": "82aea672-d285-35dd-8f83-60eb765578e4",
                                "text": "Volgens de aanklagers betaalde Wildenstein jarenlang geen belasting over zijn kapitale schilderijenverzameling en vastgoedportefeuille. De miljardair bezit veel werken van rococo-schilder Jean-Honoré Fragonard en van post-impressionist Pierre Bonnard. Ook heeft hij onder meer een stoeterij met racepaarden en een landgoed in Kenia waar de film Out of Africa werd opgenomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ddc55db-26e2-45c0-8572-e085925317f8",
                        "source_entry_id": "8c0e6d83-a845-3135-ab13-19b6d23720c4",
                        "source_sense_id": "fc725f0d-686a-3cf3-9675-220d10f5c018",
                        "source_sense_description": "het telen van paarden",
                        "target_lang_word": "Pferdenzucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e4536c3d-710e-48d2-a610-6fce0e3f73a2",
                        "source_entry_id": "8c0e6d83-a845-3135-ab13-19b6d23720c4",
                        "source_sense_id": "fc725f0d-686a-3cf3-9675-220d10f5c018",
                        "source_sense_description": "het telen van paarden",
                        "target_lang_word": "hors-breeding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "add21a85-e04c-4a23-9318-0f14bb6fa3b0",
                        "source_entry_id": "8c0e6d83-a845-3135-ab13-19b6d23720c4",
                        "source_sense_id": "fc725f0d-686a-3cf3-9675-220d10f5c018",
                        "source_sense_description": "het telen van paarden",
                        "target_lang_word": "haras",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haras",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd61bd7f-0bfa-30e5-8757-3b5d5a5f790f",
                                        "entry_id": "0c647369-512e-3c8a-9bf9-486202b77090",
                                        "glosses": [
                                            "Écurie où logent étalons, juments et poulains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cc5d136-e9e0-4402-8e49-99ec4f91f542",
                                                "sense_id": "bd61bd7f-0bfa-30e5-8757-3b5d5a5f790f",
                                                "text": "Il y avait plusieurs haras en Perse et en Médie ; mais dans cette dernière province ceux du lieu nommé Nisée étaient les plus renommés, et c’était de là qu’était fournie l’écurie du roi."
                                            },
                                            {
                                                "example_id": "d5316e60-9855-447d-83c2-c56497518446",
                                                "sense_id": "bd61bd7f-0bfa-30e5-8757-3b5d5a5f790f",
                                                "text": "Les chevaux arabes ont peuplé l’Égypte, la Turquie et peut-être la Perse, où il y avait autrefois des haras très considérables."
                                            },
                                            {
                                                "example_id": "91f46362-6ed7-45e3-a5dc-af72ff328041",
                                                "sense_id": "bd61bd7f-0bfa-30e5-8757-3b5d5a5f790f",
                                                "text": "Avant d’atteindre l’hôtellerie perchée près de l’église, il faut […] dormir la nuit dans les haras de puces des auberges ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a939ebbe-ec4e-3d94-97c2-92d0ab0a9a19",
                                        "entry_id": "0c647369-512e-3c8a-9bf9-486202b77090",
                                        "glosses": [
                                            "Établissement dans lequel sont entretenus les reproducteurs de l’espèce chevaline pour la multiplication et l’amélioration."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce2f45dd-adab-4246-99f2-a7475271154d",
                                                "sense_id": "a939ebbe-ec4e-3d94-97c2-92d0ab0a9a19",
                                                "text": "Après une lutte soutenue entre le gros bon sens du paysan et la folle impulsion donnée par l’administration des haras, celle-ci a été forcée de céder le pas, et s’est vue obligée en 1860 de supprimer les dépôts d’étalons d’Abbeville et de Charleville, […]."
                                            },
                                            {
                                                "example_id": "39c16bd1-f03f-47ee-a359-1584655d87a8",
                                                "sense_id": "a939ebbe-ec4e-3d94-97c2-92d0ab0a9a19",
                                                "text": "Dernièrement les élèves de la promotion sortante de l’école d’agriculture de Rethel, […], sont venus visiter le haras d’Ecordal, où M. Bandeloche, professeur de Zootechnie, a fait un cours très intéressant sur la différence des étalons qui composent l’établissement. Il a fait ressortir tout le bien que le pays récoltera des sacrifices que fait le département pour l’amélioration du cheval de trait et dont le haras possède de très beaux modèles."
                                            },
                                            {
                                                "example_id": "937d1ac8-9890-4c1b-9754-ee4d7f711efe",
                                                "sense_id": "a939ebbe-ec4e-3d94-97c2-92d0ab0a9a19",
                                                "text": "Le haras s’étend sur plusieurs hectares d’une herbe de contes de fées. J’emprunte une allée bordée de fusains et débouche sur la cour centrale où un palefrenier et un maître de manège s’engueulent virilement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f32bd14c-f46c-30be-8977-1d0b73c926c9",
                                        "entry_id": "0c647369-512e-3c8a-9bf9-486202b77090",
                                        "glosses": [
                                            "Les étalons et les cavales qui demeurent dans cet endroit."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e0634a3-4527-4d74-ad66-e3a728d1918b",
                                                "sense_id": "f32bd14c-f46c-30be-8977-1d0b73c926c9",
                                                "text": "Tout le haras prit peur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66fc71cf-214f-33c4-8ce6-2ce347802452",
                                        "entry_id": "0c647369-512e-3c8a-9bf9-486202b77090",
                                        "glosses": [
                                            "Les haras nationaux."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b88c6c34-e8b0-4aa9-bc01-a57f117fbf75",
                                                "sense_id": "66fc71cf-214f-33c4-8ce6-2ce347802452",
                                                "text": "Il ne faut pas oublier l’établissement des haras en 1667 ; ils étaient absolument abandonnés auparavant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c54d3b6-dde3-40d2-a97f-4714ca0650ff",
                        "source_entry_id": "8c0e6d83-a845-3135-ab13-19b6d23720c4",
                        "source_sense_id": "82aea672-d285-35dd-8f83-60eb765578e4",
                        "source_sense_description": "de locatie",
                        "target_lang_word": "Gestüt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gestüt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c30dca0-103e-3e85-b41f-af68ef76a31d",
                                        "entry_id": "ea116545-f516-346d-a9cf-b1a4aa96934d",
                                        "glosses": [
                                            "Einrichtung, in der Pferde gezüchtet werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2f2224f-d400-4a62-998e-177b316461a2",
                                                "sense_id": "8c30dca0-103e-3e85-b41f-af68ef76a31d",
                                                "text": "Das traditionsreiche Gestüt züchtet seit drei Jahren die edelsten Araber."
                                            },
                                            {
                                                "example_id": "593b60c1-83e5-40a9-b8e2-29f159d9b99f",
                                                "sense_id": "8c30dca0-103e-3e85-b41f-af68ef76a31d",
                                                "text": "„Das Gestüt versorgte die britische Armee in Indien mit Pferden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
