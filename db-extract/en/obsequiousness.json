                    {
                        "translation_id": "6861c236-83fd-4cbb-8988-b97b875e254e",
                        "source_entry_id": "c2016f93-d3c9-3e48-97bc-8bb2b7dfa00a",
                        "source_sense_id": "7a8681e0-c09b-3593-a558-1ed501d0f3c3",
                        "source_sense_description": "quality of being obsequious",
                        "target_lang_word": "obséquiosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obséquiosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7db8a397-1bbf-3c7e-a0e6-da8213bf78b0",
                                        "entry_id": "124666fe-f9a0-3141-b961-0fe1e099e5e7",
                                        "glosses": [
                                            "Défaut consistant à être exagérément ou artificiellement poli."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0afcba40-ea54-4b55-a1b2-c5b5b668d561",
                                                "sense_id": "7db8a397-1bbf-3c7e-a0e6-da8213bf78b0",
                                                "text": "— Aurais-je l’honneur de vous coiffer ? reprit Vital avec une joyeuse obséquiosité."
                                            },
                                            {
                                                "example_id": "2ef1c30c-f8c1-4036-a3e3-ff282e11f6eb",
                                                "sense_id": "7db8a397-1bbf-3c7e-a0e6-da8213bf78b0",
                                                "text": "Elle se montrait même bonne princesse envers ses compagnes, et la duègne, symptôme grave, se rapprochait d’elle avec des obséquiosités patelines qu’elle ne lui avait jamais montrées."
                                            },
                                            {
                                                "example_id": "c620f9a8-bad6-42e7-827f-a8f2ac4ead5d",
                                                "sense_id": "7db8a397-1bbf-3c7e-a0e6-da8213bf78b0",
                                                "text": "En fait ce n’était pas de la bonté, rien qu’un manque de virilité, et si c’en était vraiment, ce n’était guère plus sympathique, car Mihály ne se faisait pas une haute idée de la bonté. et cette obséquiosité ! Il n’y avait rien à faire, Pataki resterait toujours un commis de boutique, même s’il s’était enrichi."
                                            },
                                            {
                                                "example_id": "b45cf9a3-7ca7-4d65-b6c6-777899a07086",
                                                "sense_id": "7db8a397-1bbf-3c7e-a0e6-da8213bf78b0",
                                                "text": "Mes démêlés avec la police et l’attitude suspicieuse de mon voisinage m’avaient rendu craintif, avide de sympathie et sociable jusqu’à l’obséquiosité."
                                            },
                                            {
                                                "example_id": "6932cca3-e12e-4fa1-ba26-f2efad9544a1",
                                                "sense_id": "7db8a397-1bbf-3c7e-a0e6-da8213bf78b0",
                                                "text": "Ce qui chanstiquait le plus Vladi, c’était de rester assis, devant un glasse connement vide, tandis que Kader se tenait debout près de la table, avec toute l’obséquiosité d’un loufiat venant prendre une commande, mais en bien meilleure position en cas de castagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "558c70ba-cd56-3b7e-a8a0-ad68483866ff",
                                        "entry_id": "124666fe-f9a0-3141-b961-0fe1e099e5e7",
                                        "glosses": [
                                            "Ensemble des paroles et des actes qui dénotent ce défaut."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f4f9cab-0a82-4701-bee9-17da975f40b6",
                                                "sense_id": "558c70ba-cd56-3b7e-a8a0-ad68483866ff",
                                                "text": "Je suis las de ses obséquiosités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f905903c-3fab-4fd7-9ad8-14e90e3ed085",
                        "source_entry_id": "c2016f93-d3c9-3e48-97bc-8bb2b7dfa00a",
                        "source_sense_id": "7a8681e0-c09b-3593-a558-1ed501d0f3c3",
                        "source_sense_description": "quality of being obsequious",
                        "target_lang_word": "Unterwürfigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterwürfigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2186a6b-d34e-3989-8315-de1cca061304",
                                        "entry_id": "90b0d3e1-6360-352f-8a06-4c7591012df6",
                                        "glosses": [
                                            "Verhalten oder Einstellung, das eigene Handeln dem Willen einer anderen Person oder Institution unterzuordnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4501fcf-9384-4db2-b355-3e563029d2e6",
                                                "sense_id": "b2186a6b-d34e-3989-8315-de1cca061304",
                                                "text": "„Von einer Weichenstellung im deutsch-polnischen Verhältnis ist ebenfalls die Rede – der jetzigen Regierung wird Unterwürfigkeit vorgeworfen.“"
                                            },
                                            {
                                                "example_id": "736bb738-bf4d-407b-a544-be3061895d31",
                                                "sense_id": "b2186a6b-d34e-3989-8315-de1cca061304",
                                                "text": "„Seine Unterwürfigkeit lullte einen ein, während er Material für weitere Satiren sammelte.“"
                                            },
                                            {
                                                "example_id": "e1369e15-bbb0-4072-82c5-f64615907f24",
                                                "sense_id": "b2186a6b-d34e-3989-8315-de1cca061304",
                                                "text": "„Er war kein so großer Mann, daß er von mir eine solche Unterwürfigkeit hätte verlangen können; auch ich selbst durfte, nachdem ich eine so niedrige Handlung begangen hatte, keine zweite folgen lassen, die mich nicht nur zum verächtlichsten aller Menschen gestempelt, sondern auch außerstande gesetzt hätte, ihm Genugtuung in irgendeiner Form zu geben.“"
                                            },
                                            {
                                                "example_id": "e30eca33-8622-4025-947b-4c3a933d23a2",
                                                "sense_id": "b2186a6b-d34e-3989-8315-de1cca061304",
                                                "text": "„Franzens bestürzte Unterwürfigkeit war nicht gerade dazu angetan, mich mit der Vorstellung eines durch die Frau vermittelten Glücks zu versöhnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
