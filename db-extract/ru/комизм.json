                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04212aed-c103-3f45-ab0e-b5b75fab2455",
                                        "entry_id": "f9d604f4-45db-3db3-8450-8fb356d7532e",
                                        "glosses": [
                                            "Qui a rapport à la comédie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38e68b32-c72d-46bf-b04d-ec83670b3852",
                                                "sense_id": "04212aed-c103-3f45-ab0e-b5b75fab2455",
                                                "text": "Le genre comique."
                                            },
                                            {
                                                "example_id": "2b71bc24-d220-490d-9464-c9cc50398cbb",
                                                "sense_id": "04212aed-c103-3f45-ab0e-b5b75fab2455",
                                                "text": "Troupe comique : Troupe de comédiens."
                                            },
                                            {
                                                "example_id": "05941c2a-6f8c-4354-8c37-378fa91216e4",
                                                "sense_id": "04212aed-c103-3f45-ab0e-b5b75fab2455",
                                                "text": "Molière est notre premier comique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9adb746-96f8-30cd-920e-5cb672569874",
                                        "entry_id": "f9d604f4-45db-3db3-8450-8fb356d7532e",
                                        "glosses": [
                                            "Qui est propre à faire rire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd9778f2-c562-4379-879f-3b9040da21bc",
                                                "sense_id": "f9adb746-96f8-30cd-920e-5cb672569874",
                                                "text": "Visage, air comique."
                                            },
                                            {
                                                "example_id": "f9bfb1dd-9861-4fda-9e4a-d9b596911b01",
                                                "sense_id": "f9adb746-96f8-30cd-920e-5cb672569874",
                                                "text": "Aventure comique."
                                            },
                                            {
                                                "example_id": "7cd3c170-c1b1-4783-a930-8584aa82ba63",
                                                "sense_id": "f9adb746-96f8-30cd-920e-5cb672569874",
                                                "text": "Un chanteur comique."
                                            },
                                            {
                                                "example_id": "dbfecfab-c8c3-458b-8227-26777bd32e0e",
                                                "sense_id": "f9adb746-96f8-30cd-920e-5cb672569874",
                                                "text": "Cette intrigue est tout à fait comique."
                                            },
                                            {
                                                "example_id": "9984fcf5-c826-4041-b9f1-c5beb0459a65",
                                                "sense_id": "f9adb746-96f8-30cd-920e-5cb672569874",
                                                "text": "Un goût comique du noctambulisme anime toutes sorte de fêtards départementaux qui rêvent de Montmartre..."
                                            },
                                            {
                                                "example_id": "0914c22e-5e24-49e6-82ca-51963f4c186d",
                                                "sense_id": "f9adb746-96f8-30cd-920e-5cb672569874",
                                                "text": "Avoir le masque comique, avoir un visage qui se prête à tous les mouvements de physionomie nécessaires pour bien exprimer le caractère d’un rôle plaisant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f936bfab-ab49-39d4-b4a1-a0c9ed97ecbf",
                                        "entry_id": "7177ca90-9fab-3e28-b2e7-e901669b7832",
                                        "glosses": [
                                            "Comédien qui est habituellement chargé de représenter les personnages plaisants ou bouffons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d28c9f4-5a4a-41b7-b2be-82c28453bb65",
                                                "sense_id": "f936bfab-ab49-39d4-b4a1-a0c9ed97ecbf",
                                                "text": "C’est un bon comique."
                                            },
                                            {
                                                "example_id": "36a8dbd5-0968-4f8c-874e-72b8e8c229c2",
                                                "sense_id": "f936bfab-ab49-39d4-b4a1-a0c9ed97ecbf",
                                                "text": "Il tient l’emploi de comique."
                                            },
                                            {
                                                "example_id": "105ced33-3da0-4296-8f37-f67f0dece549",
                                                "sense_id": "f936bfab-ab49-39d4-b4a1-a0c9ed97ecbf",
                                                "text": "Jouer les comiques."
                                            },
                                            {
                                                "example_id": "eba7776d-a59f-4809-bcff-09e214be77f7",
                                                "sense_id": "f936bfab-ab49-39d4-b4a1-a0c9ed97ecbf",
                                                "text": "Certains s'étonnent qu'un comique se soit enlevé la vie. Un comique n'est pas plus à l'abri du foutu désespoir qu'un soldat ou qu'un plombier. Être drôle, ce n'est pas être heureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff6730d8-9bf1-3e12-bbd7-6f5fd021840d",
                                        "entry_id": "7177ca90-9fab-3e28-b2e7-e901669b7832",
                                        "glosses": [
                                            "Artiste qui fait profession d'humour. → voir humoriste"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc540915-475f-40b3-9a11-d44d8a04fec2",
                                                "sense_id": "ff6730d8-9bf1-3e12-bbd7-6f5fd021840d",
                                                "text": "Personnellement, j'ai commencé comme comique dans les années 1980, aujourd'hui, il m'est interdit de prononcer le mot « comique », terme trop dégradant. Seuls existent les humoristes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba6f27c7-11f7-36bc-b550-a1f7e439fb8e",
                                        "entry_id": "7177ca90-9fab-3e28-b2e7-e901669b7832",
                                        "glosses": [
                                            "Personnage qui aime à faire rire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "071a278e-31d3-4653-aca4-60c34bb0a793",
                                                "sense_id": "ba6f27c7-11f7-36bc-b550-a1f7e439fb8e",
                                                "text": "À cet instant, la porte de la rue s'ouvrit et un homme encore jeune, visiblement saoul, entra. C'était le comique du quartier, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e94315af-8fce-3385-9015-acbb7e4ce124",
                                        "entry_id": "7177ca90-9fab-3e28-b2e7-e901669b7832",
                                        "glosses": [
                                            "Le genre comique, la comédie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2591327-b47f-4350-9198-a9b56445fa93",
                                                "sense_id": "e94315af-8fce-3385-9015-acbb7e4ce124",
                                                "text": "Cet auteur entend bien le comique."
                                            },
                                            {
                                                "example_id": "f0f9b10c-c513-4b63-a6d3-e0f3c87a2227",
                                                "sense_id": "e94315af-8fce-3385-9015-acbb7e4ce124",
                                                "text": "Cet acteur n’est bon que dans le comique."
                                            },
                                            {
                                                "example_id": "021391ce-d749-4ed6-89d8-cc875a27bb51",
                                                "sense_id": "e94315af-8fce-3385-9015-acbb7e4ce124",
                                                "text": "Le comique de caractère."
                                            },
                                            {
                                                "example_id": "b1c4941e-23be-44c3-bf95-5054ad480704",
                                                "sense_id": "e94315af-8fce-3385-9015-acbb7e4ce124",
                                                "text": "Le comique de situation."
                                            },
                                            {
                                                "example_id": "5068ef44-f33d-4e7f-ab16-3ab4b2531ba5",
                                                "sense_id": "e94315af-8fce-3385-9015-acbb7e4ce124",
                                                "text": "Être drôle, c'est regarder dans les yeux le malheur et lui tirer la langue. Peut venir un jour où il prend sa revanche. Le comique est une tragédie en accéléré. Comme les vues de Chaplin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2869d438-ad72-328a-8ef1-f05ab827398f",
                                        "entry_id": "7177ca90-9fab-3e28-b2e7-e901669b7832",
                                        "glosses": [
                                            "Ce qui fait rire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc4076f9-824d-4074-9c52-36b7085c8878",
                                                "sense_id": "2869d438-ad72-328a-8ef1-f05ab827398f",
                                                "text": "Avoir du comique dans la figure, avoir une physionomie plaisante."
                                            },
                                            {
                                                "example_id": "735c773d-bae0-4853-9d23-7e9af062cdba",
                                                "sense_id": "2869d438-ad72-328a-8ef1-f05ab827398f",
                                                "text": "Avoir du comique dans l’esprit, avoir une disposition à saisir et à rendre le ridicule."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comique",
                                "target_lang_code": "fr",
                                "target_senses": [
