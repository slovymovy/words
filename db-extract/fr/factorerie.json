                ],
                "senses": [
                    {
                        "sense_id": "e7c1d270-7af4-376e-a462-374c001dd56d",
                        "entry_id": "0fe91d6e-85a4-3b42-9630-8824aca26577",
                        "glosses": [
                            "Le lieu, le bureau où les facteurs ou agents font les affaires d’une compagnie de commerce en pays étranger, surtout aux colonies."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3705ba0f-e6a3-4d17-89cc-d95162d37021",
                                "sense_id": "e7c1d270-7af4-376e-a462-374c001dd56d",
                                "text": "Ces indigènes, en rapports constants avec les factoreries, fournissaient en grande partie et par voie d’échange les fourrures dont la Compagnie faisait le trafic."
                            },
                            {
                                "example_id": "b6ccac20-233f-4c76-a3e8-2d648c20367a",
                                "sense_id": "e7c1d270-7af4-376e-a462-374c001dd56d",
                                "text": "L’ancienne factorerie de tabac devint un grand jardin planté de toutes sortes de roses auxquelles Florentino Ariza en personne consacrait ses loisirs matinaux."
                            },
                            {
                                "example_id": "f07a3b6a-50f4-4913-9607-c7ae567cf08f",
                                "sense_id": "e7c1d270-7af4-376e-a462-374c001dd56d",
                                "text": "De factorerie en factorerie passaient les funèbres messagers de mort. — (James Oliver Curwood, Kazan, 1914, traduit de l’anglais par P. Gruyer et L. Postif, Hachette, 1937, page 127)"
                            }
                        ]
                    }
                ],
