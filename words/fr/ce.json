    "entries": [
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "1cfe563a-5635-3b40-b9cd-99ca4a32220a",
                    "sense_definition": "Indique et met en valeur un être animé ou une chose que l'on montre ou qui est présente dans la situation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "demonstratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regarde <w>ce</w> magnifique oiseau perché sur la plus haute branche."
                        },
                        {
                            "text": "Je vais acheter <w>ce</w> pantalon bleu pour la fête de demain."
                        }
                    ],
                    "common_phrases": [
                        "ce genre de",
                        "ce livre"
                    ]
                },
                {
                    "sense_id": "0c472bb6-ec5d-3554-8eaf-4f21f575af89",
                    "sense_definition": "Place un moment dans le présent immédiat ou dans une période temporelle proche.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous irons nous promener dans le parc <w>ce</w> matin après le petit-déjeuner."
                        },
                        {
                            "text": "Il doit passer me voir <w>ce</w> soir avant de partir en voyage."
                        }
                    ],
                    "common_phrases": [
                        "ce matin",
                        "ce soir",
                        "ce week-end",
                        "en ce moment"
                    ]
                }
            ]
        },
        {
