    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "872a2820-b544-3457-897b-c9fd4280e7cd",
                    "sense_definition": "zoetwaterroofvis met een groenige kleur, donkere dwarsstrepen en rode vinnen (Perca fluviatilis)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens het vissen ving hij een mooie <w>baars</w> in de plaatselijke rivier.",
                            "target_lang_translations": {
                                "ru": "На рыбалке он поймал красивого <w>окуня</w> в местной реке."
                            }
                        },
                        {
                            "text": "De <w>baars</w> zwemt vaak tussen het riet op zoek naar kleine prooidieren.",
                            "target_lang_translations": {
                                "ru": "<w>Окунь</w> часто плавает среди камышей в поисках мелкой добычи."
                            }
                        }
                    ],
                    "synonyms": [
                        "rivierbaars"
                    ],
                    "common_phrases": [
                        "op baars vissen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пресноводная хищная рыба с зеленоватой чешуёй, тёмными поперечными полосами и красными плавниками (Perca fluviatilis)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окунь",
                                "target_lang_sense_clarification": "речной окунь"
                            },
                            {
                                "target_lang_word": "речной окунь",
                                "target_lang_sense_clarification": "вид рыбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a44f226-aedb-32d1-ade2-736b643e21cf",
                    "sense_definition": "vis behorend tot het geslacht Perca of een verwante soort uit de familie van de echte baarzen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De biologe onderzoekt het dieet van verschillende soorten <w>baarzen</w> in Europese meren.",
                            "target_lang_translations": {
                                "ru": "Биолог исследует рацион различных видов <w>окуней</w> в европейских озёрах."
                            }
                        },
                        {
                            "text": "In dit waterlevenonderzoek worden de populaties van de inheemse <w>baars</w> nauwkeurig gevolgd.",
                            "target_lang_translations": {
                                "ru": "В этом исследовании водной фауны тщательно отслеживаются популяции местного <w>окуня</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рыба из рода Perca или родственного вида семейства окунёвых"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окунь",
                                "target_lang_sense_clarification": "в биологическом смысле, окунёвые"
                            },
                            {
                                "target_lang_word": "окунёвая рыба",
                                "target_lang_sense_clarification": "представитель семейства окунёвых"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4c05c95-d361-304d-ba28-a5b4eb63a543",
                    "sense_definition": "bijl die van oudsher door kuipers wordt gebruikt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kuiper bewerkte het houten vat vakkundig met een scherpe <w>baars</w>.",
                            "target_lang_translations": {
                                "ru": "Бондарь умело обрабатывал деревянную бочку острым <w>бондарным топором</w>."
                            }
                        },
                        {
                            "text": "In het museum voor oude ambachten lag een antieke <w>baars</w> tentoongesteld.",
                            "target_lang_translations": {
                                "ru": "В музее старинных ремёсел был выставлен старинный <w>бондарный топор</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kuipersbijl"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historisch vakgereedschap"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Топор, традиционно использовавшийся бондарями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бондарный топор",
                                "target_lang_sense_clarification": "инструмент бондаря"
                            },
                            {
                                "target_lang_word": "тесло",
                                "target_lang_sense_clarification": "деревообрабатывающий инструмент"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "94fe9dc1-63a5-3662-98cd-0098cd1d5849",
                    "sense_definition": "partitief van de stellende trap van <w>baar</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat verhaal bevat weinig <w>baars</w> en lijkt vooral op pure fantasie.",
                            "target_lang_translations": {
                                "ru": "В этой истории мало <w>правдоподобного</w>, и она больше похожа на чистую фантазию."
                            }
                        },
                        {
                            "text": "Er is niets <w>baars</w> aan deze situatie; het is volstrekt begrijpelijk.",
                            "target_lang_translations": {
                                "ru": "В этой ситуации нет ничего <w>необычного</w>; всё совершенно понятно."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "partitieve vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Партитивная форма прилагательного baar (явный, сущий, очевидный)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "явного",
                                "target_lang_sense_clarification": "партитивная форма от явный"
                            },
                            {
                                "target_lang_word": "чистого",
                                "target_lang_sense_clarification": "в значении 'чистой воды', 'сущего'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47765b08-4f70-387d-a187-0133c263ff8e",
                    "sense_definition": "zonder ervaring; nog niet ingewerkt of geoefend",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe matroos was nog erg <w>baars</w> op het schip en maakte beginnersfouten.",
                            "target_lang_translations": {
                                "ru": "Новый матрос на корабле был ещё очень <w>неопытен</w> и совершал ошибки новичка."
                            }
                        },
                        {
                            "text": "Omdat hij nog zo <w>baars</w> was, kreeg hij intensieve begeleiding van zijn mentor.",
                            "target_lang_translations": {
                                "ru": "Поскольку он был ещё совсем <w>зелёным</w>, наставник оказывал ему усиленную поддержку."
                            }
                        }
                    ],
                    "synonyms": [
                        "onervaren"
                    ],
                    "antonyms": [
                        "ervaren"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "weinig frequent en verouderd"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Без опыта; неопытный, необученный, зелёный (устаревшее)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неопытный",
                                "target_lang_sense_clarification": "без профессионального опыта"
                            },
                            {
                                "target_lang_word": "зелёный",
                                "target_lang_sense_clarification": "неопытный, начинающий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8c2bd2b1-61ab-3902-86f8-bfa463036d33",
                    "sense_definition": "buurtschap in de gemeente Steenwijkerland in de Nederlandse provincie Overijssel",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Zij fietsten op een zonnige zondagmiddag door de rustige buurtschap <w>Baars</w>.",
                            "target_lang_translations": {
                                "ru": "В солнечный воскресный день они катались на велосипедах по тихой деревушке <w>Барс</w>."
                            }
                        },
                        {
                            "text": "Het kleine gehucht <w>Baars</w> ligt niet ver van de grens met Friesland.",
                            "target_lang_translations": {
                                "ru": "Небольшой хутор <w>Барс</w> находится недалеко от границы с Фрисландией."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревушка (хутор) в общине Стенвейкерланд в нидерландской провинции Оверэйссел"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Барс",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
