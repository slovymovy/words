                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8028e76f-5680-357d-986c-893cb9812c2e",
                                        "entry_id": "4f3bed77-8a27-342b-bf66-3953c466f0fe",
                                        "glosses": [
                                            "ein Mitglied dieser Gattung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fae80b2-79f4-42ef-8407-a88a31fb5728",
                                                "sense_id": "8028e76f-5680-357d-986c-893cb9812c2e",
                                                "text": "Manche Rhododendren sind giftig und können schlimme Krankheiten verursachen."
