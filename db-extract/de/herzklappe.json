                        "entry_id": "e60d9b50-49dd-3cf1-916d-d98aa4f06008",
                        "glosses": [
                            "Bestandteil des Herzens, der verhindert, dass Blut in die falsche Richtung zurückfließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d95c0bc-e95d-4560-a0b4-f3da9b97a383",
                                "sense_id": "7a65fd8c-ded2-30d6-9703-c61b7575d91c",
                                "text": "„Vor zwei Jahren wurde sie am Herzen operiert, sie benötigte aufgrund eines rheumatischen Fiebers zwei neue Herzklappen.“"
                            },
                            {
                                "example_id": "c9f1527f-bc04-456f-a31c-c33e76332f10",
                                "sense_id": "7a65fd8c-ded2-30d6-9703-c61b7575d91c",
                                "text": "„Sie hatte erst vor Kurzem eine neue Herzklappe bekommen, ich wollte sie unter keinen Umständen belasten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
