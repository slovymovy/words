                "senses": [
                    {
                        "sense_id": "fb9cfbca-57c2-3bbc-8ec6-330ea2f4e107",
                        "entry_id": "c9756a40-fd44-35fa-818a-0666c79ba131",
                        "glosses": [
                            "фин., разг. сокр. от центральный банк"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf549555-4630-4cd4-84a4-14821446bf99",
                                "sense_id": "fb9cfbca-57c2-3bbc-8ec6-330ea2f4e107",
                                "text": "Решительные действия центробанков позволили избежать тотального краха финансовой системы, но поставили их самих в рискованное положение."
                            },
                            {
                                "example_id": "c7c0c9ae-b5c4-4cc9-bad9-a1eb49ccae18",
                                "sense_id": "fb9cfbca-57c2-3bbc-8ec6-330ea2f4e107",
                                "text": "По данным Центробанка России, в сентябре кредиты на покупку квартир выдавались в среднем под 11,6 % годовых."
                            },
                            {
                                "example_id": "7b0ea2e4-9e10-4d09-bfef-350d9eaf84a2",
                                "sense_id": "fb9cfbca-57c2-3bbc-8ec6-330ea2f4e107",
                                "text": "Подпись Касьянова была необходимым условием любых транзакций такого рода, в том числе проводимых Центробанком."
                            }
                        ]
                    }
