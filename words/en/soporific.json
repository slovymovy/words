{
    "word_family": [
        "sopor",
        "soporiferous"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4ec4d045-e7ee-3c53-b763-8f7abff84bb9",
                    "sense_definition": "Tending to induce sleep",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sleep-inducing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warm milk had a <w>soporific</w> effect on the tired child.",
                            "target_lang_translations": {
                                "ru": "Тёплое молоко оказало <w>снотворное</w> действие на уставшего ребёнка."
                            }
                        },
                        {
                            "text": "The gentle sound of rain against the window was quite <w>soporific</w>.",
                            "target_lang_translations": {
                                "ru": "Тихий шум дождя за окном действовал очень <w>убаюкивающе</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "drowsy",
                        "slumberous",
                        "somniferous"
                    ],
                    "antonyms": [
                        "arousing",
                        "enlivening",
                        "invigorating",
                        "rousing",
                        "stimulating"
                    ],
                    "common_phrases": [
                        "soporific effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий сон или способствующий засыпанию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снотворный",
                                "target_lang_sense_clarification": "о действии веществ или факторов"
                            },
                            {
                                "target_lang_word": "усыпляющий",
                                "target_lang_sense_clarification": "вызывающий сонливость"
                            },
                            {
                                "target_lang_word": "убаюкивающий",
                                "target_lang_sense_clarification": "успокаивающий, погружающий в сон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8462dbf5-ad40-3d1f-a730-46238f60db9a",
                    "sense_definition": "Boring or dull",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "boring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor delivered a <w>soporific</w> lecture that lasted for three hours.",
                            "target_lang_translations": {
                                "ru": "Профессор прочитал <w>усыпляющую</w> лекцию, которая длилась три часа."
                            }
                        },
                        {
                            "text": "The meeting was so <w>soporific</w> that several people fell asleep in their chairs.",
                            "target_lang_translations": {
                                "ru": "Собрание было настолько <w>занудным</w>, что несколько человек уснули прямо на стульях."
                            }
                        }
                    ],
                    "synonyms": [
                        "boring",
                        "dull",
                        "monotonous",
                        "tedious"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скучный, нудный, наводящий сон своим однообразием"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наводящий тоску",
                                "target_lang_sense_clarification": "крайне скучный"
                            },
                            {
                                "target_lang_word": "усыпляющий",
                                "target_lang_sense_clarification": "монотонный и утомительный"
                            },
                            {
                                "target_lang_word": "занудный",
                                "target_lang_sense_clarification": "скучный и усыпляющий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "34ba98c8-afb3-3c13-bd2a-3b8a2c2438e7",
                    "sense_definition": "Something that induces sleep, especially a drug",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sleep-inducing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed a <w>soporific</w> to help the patient get some rest.",
                            "target_lang_translations": {
                                "ru": "Врач выписал <w>снотворное</w>, чтобы помочь пациенту отдохнуть."
                            }
                        },
                        {
                            "text": "Ancient herbal <w>soporifics</w> were often used to treat insomnia.",
                            "target_lang_translations": {
                                "ru": "Древние травяные <w>усыпляющие средства</w> часто использовались для лечения бессонницы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Средство или вещество, вызывающее сон"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снотворное",
                                "target_lang_sense_clarification": "лекарственное вещество или средство"
                            },
                            {
                                "target_lang_word": "усыпляющее средство",
                                "target_lang_sense_clarification": "любое средство, способствующее засыпанию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acfeaeca-5326-349d-a7e0-b6d9100eeed7",
                    "sense_definition": "Something boring or dull",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "boring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long, repetitive report was a total <w>soporific</w>.",
                            "target_lang_translations": {
                                "ru": "Длинный и однообразный отчёт оказался сущей <w>скучищей</w>."
                            }
                        },
                        {
                            "text": "The play was such a <w>soporific</w> that the audience left during the intermission.",
                            "target_lang_translations": {
                                "ru": "Спектакль был настоящим <w>снотворным</w>, так что зрители ушли в антракте."
                            }
                        }
                    ],
                    "synonyms": [
                        "bore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то невыносимо скучное или монотонное, от чего клонит в сон"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скучища",
                                "target_lang_sense_clarification": "что-то невыносимо скучное"
                            },
                            {
                                "target_lang_word": "снотворное",
                                "target_lang_sense_clarification": "в переносном смысле о чем-то нудном"
                            },
                            {
                                "target_lang_word": "тоска зеленая",
                                "target_lang_sense_clarification": "крайне унылое зрелище или занятие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}