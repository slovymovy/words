                    },
                    {
                        "sense_id": "201aae05-cafa-3597-aa80-81aefa2481ff",
                        "entry_id": "724c6c4e-2f2d-33b7-949a-a00e42a145e0",
                        "glosses": [
                            "Branche des protozoaires, flagellés d'origine animale."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3f8f643f-0877-4c21-99f8-58cf58dec4d5",
                                "sense_id": "201aae05-cafa-3597-aa80-81aefa2481ff",
                                "text": "Les flagellés constituent une superclasse de protozoaires pourvus de flagelles qui sont des organes filiformes et contractiles qui assurent la locomotion. On trouve dans cette classe les phytoflagellés (végétaux chlorophylliens), et les zooflagellés, animaux dont certains peuvent être de dangereux parasites comme le Trypanosome qui cause la « maladie du sommeil »."
                            }
                        ]
                    }
