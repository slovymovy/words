                "senses": [
                    {
                        "sense_id": "a5367d8a-ae6d-330e-80f2-ff6141893215",
                        "entry_id": "61d013d9-dabe-3aa2-b084-25775272799b",
                        "glosses": [
                            "een geslacht Gentiana uit de gentiaanfamilie (Gentianaceae). Het geslacht kent ongeveer vierhonderd soorten veelal met diepblauwe bloemen, die voornamelijk in gematigde bergstreken van het noordelijk halfrond en de Andes voorkomen. In Europa komen 35 soorten voor, vooral in de Alpen. Het geslacht baardgentiaan (Gentianella) werd met onder meer de soort veldgentiaan (Gentianella campestris) voorheen ook ingedeeld bij de gentianen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2058f90a-71c2-4e63-87e0-18198a8df44d",
                                "sense_id": "a5367d8a-ae6d-330e-80f2-ff6141893215",
                                "text": "Het plukken van een gentiaan is verboden om de kwetsbare flora van het hooggebergte te beschermen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c7453be-7633-4f17-ad4f-536ddf1ac57e",
                        "source_entry_id": "61d013d9-dabe-3aa2-b084-25775272799b",
                        "source_sense_id": "a5367d8a-ae6d-330e-80f2-ff6141893215",
                        "target_lang_word": "Enzian",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Enzian",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e206d0f6-5fff-3575-9770-4160f9d8faad",
                                        "entry_id": "57c25f39-a3aa-30c9-8151-e527740ead73",
                                        "glosses": [
                                            "Gebirgspflanze der Gattung Gentiana aus der Familie der Enziangewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd0bd27-6966-48a6-a717-7b0a8971a42e",
                                                "sense_id": "e206d0f6-5fff-3575-9770-4160f9d8faad",
                                                "text": "Die meisten Enziane blühen blau."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3cdad8d0-be8d-35ad-9967-df8e40afb870",
                                        "entry_id": "57c25f39-a3aa-30c9-8151-e527740ead73",
                                        "glosses": [
                                            "Spirituose, die aus den Wurzeln des gelben Enzians gebrannt wird"
                                        ],
                                        "tags": [
                                            "Plural nur für Sorten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0289937f-7a29-412a-ba1d-a97d35deb904",
                                                "sense_id": "3cdad8d0-be8d-35ad-9967-df8e40afb870",
                                                "text": "Enzian schmeckt ziemlich bitter."
                                            },
                                            {
                                                "example_id": "4dcc4bee-5911-46e8-8fe3-47baa0a4e48e",
                                                "sense_id": "3cdad8d0-be8d-35ad-9967-df8e40afb870",
                                                "text": "„Es gab auch anderes zu trinken, wunderbaren Kirsch, der im Tal hergestellt wurde, und Enzian, der aus Gebirgsenzian gebrannt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
