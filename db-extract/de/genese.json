                ],
                "senses": [
                    {
                        "sense_id": "140f455c-895a-3a25-836e-54cbc9c8553c",
                        "entry_id": "9152a26f-3b59-3585-adff-ad26f0369476",
                        "glosses": [
                            "die Entstehung, Entwicklung, Herkunft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03e24964-03be-4fe9-9fb5-5fb57dcf9001",
                                "sense_id": "140f455c-895a-3a25-836e-54cbc9c8553c",
                                "text": "Hier „wird die Genese des Plankalküls rekapituliert.“ (Internet-Beleg)"
                            },
                            {
                                "example_id": "f0161352-83dd-44fb-bde7-b695308340b8",
                                "sense_id": "140f455c-895a-3a25-836e-54cbc9c8553c",
                                "text": "„[…]; Kafkas hermetische Protokolle enthalten die soziale Genese der Schizophrenie.“"
                            },
                            {
                                "example_id": "0baec456-e6d1-4b41-b198-2552c08df5b2",
                                "sense_id": "140f455c-895a-3a25-836e-54cbc9c8553c",
                                "text": "„Statt nach Anfang und Genese der Welt fragte man nun nach Struktur und Bauplan der Welt.“"
                            },
                            {
                                "example_id": "ab9bc4b5-761e-4dfa-97de-e3dd7ec6f8f1",
                                "sense_id": "140f455c-895a-3a25-836e-54cbc9c8553c",
                                "text": "„Tatsächlich ist die Genese der westafrikanischen Kunst von vielen Geheimnissen umgeben.“"
                            },
                            {
                                "example_id": "9ac4202e-d9ab-4973-8f9b-45c74c67328c",
                                "sense_id": "140f455c-895a-3a25-836e-54cbc9c8553c",
                                "text": "„Die Curriculum-Reformen waren ein fester Bestandteil des Islamisierungsprogramms während Zia-ul-Haqs Regierungszeit und betrafen noch gar nicht die klassischen Koranschulen. Insbesondere Fächer wie Pakistankunde (Pakistaniat) und Islamkunde (Islamiat) propagierten höchst unausgewogen die Genese Pakistans als islamischen Staat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6391efd9-74a3-3e1b-914f-e3e3b0291009",
                        "entry_id": "9152a26f-3b59-3585-adff-ad26f0369476",
                        "glosses": [
                            "Ursache einer Krankheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2b869c9-7b73-4671-962b-1eaaa65635cc",
                                "sense_id": "6391efd9-74a3-3e1b-914f-e3e3b0291009",
                                "text": "Die Genese der Rosazea ist unklar."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "feac4e9c-798c-402a-8c05-769144bd00dd",
                        "source_entry_id": "9152a26f-3b59-3585-adff-ad26f0369476",
                        "source_sense_id": "140f455c-895a-3a25-836e-54cbc9c8553c",
