                {
                    "sense_id": "d9037733-fecc-34c1-b2be-064d47737f43",
                    "sense_definition": "Niet door menselijk toedoen veranderd of beschadigd; in de oorspronkelijke, natuurlijke staat gelaten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Brazilië is nog veel <w>ongerept</w> oerwoud, ook al wordt er dagelijks veel van gekapt.",
                            "target_lang_translations": {
                                "en": "In Brazil there is still a lot of <w>pristine</w> rainforest, even though a lot of it is cut down daily."
                            }
                        },
                        {
                            "text": "De wandelaars genoten van de rust in de <w>ongerepte</w> natuur van het nationale park.",
                            "target_lang_translations": {
                                "en": "The hikers enjoyed the peace in the <w>untouched</w> nature of the national park."
                            }
                        }
                    ],
                    "synonyms": [
                        "onaangetast",
                        "onaangeroerd"
                    ],
                    "antonyms": [
                        "aangetast",
                        "bedorven"
                    ],
                    "common_phrases": [
                        "ongerepte natuur",
                        "ongerept landschap"
                    ],
                    "target_lang_definitions": {
                        "en": "Not altered or damaged by human intervention; left in its original, natural state."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pristine",
                                "target_lang_sense_clarification": "unspoiled, in its original condition"
                            },
                            {
                                "target_lang_word": "untouched",
                                "target_lang_sense_clarification": "not affected or changed by humans"
                            },
                            {
