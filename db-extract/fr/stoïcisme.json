                                        "sense_id": "72f927d8-e1ec-379c-980a-54265cd5fef9",
                                        "entry_id": "aba96368-d207-3d3e-a307-4cfcec8cd34f",
                                        "glosses": [
                                            "Befestigung, Halterung für etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3387161f-2abe-4373-b47b-f7b6b23da657",
                                                "sense_id": "72f927d8-e1ec-379c-980a-54265cd5fef9",
                                                "text": "Die Glühbirne passt nicht in diese Fassung."
                                            },
                                            {
                                                "example_id": "e3ce4c8e-f632-458c-b69c-313845c0b0a9",
                                                "sense_id": "72f927d8-e1ec-379c-980a-54265cd5fef9",
                                                "text": "„Aber ich hatte ihn zugeben müssen; draußen auf dem Hof vor der Werkstatt, die schon im Dunkeln lag, unter der jämmerlichen Fünfzehn-Watt-Birne, die lose in einer Fassung hing und im Novemberwind schaukelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e4ae495-ad9a-37db-81e1-c9e824fdad07",
                                        "entry_id": "aba96368-d207-3d3e-a307-4cfcec8cd34f",
                                        "glosses": [
                                            "der aktuell gültige Text eines Gesetzes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d91039f-89c0-4fa1-8e3b-0eebafdc47aa",
                                                "sense_id": "1e4ae495-ad9a-37db-81e1-c9e824fdad07",
                                                "text": "Das Urheberrechtsgesetz in der Fassung vom November 2002 kann einmal überarbeitet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "475de8a3-d636-36ed-ae87-f99b17b59391",
                                        "entry_id": "aba96368-d207-3d3e-a307-4cfcec8cd34f",
                                        "glosses": [
                                            "Selbstbeherrschung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55e5b2eb-a966-413c-b491-0efb8d1ca6ed",
                                                "sense_id": "475de8a3-d636-36ed-ae87-f99b17b59391",
                                                "text": "Er verlor die Fassung."
                                            },
                                            {
                                                "example_id": "97521343-5d46-4ec6-aaa8-f6554c0901a4",
                                                "sense_id": "475de8a3-d636-36ed-ae87-f99b17b59391",
                                                "text": "„Fabiola rang nach Fassung und bemühte sich klar zu denken.“"
                                            },
                                            {
                                                "example_id": "7c4536e3-705a-4afd-b9fd-76aa97c5b049",
                                                "sense_id": "475de8a3-d636-36ed-ae87-f99b17b59391",
                                                "text": "„Nun sassen sie noch eine Weile unten in der Stube neben dem Krankenzimmer, um erst ihre Tränen zu trocknen und ihre Fassung wieder zu gewinnen, bevor sie zu ihm gingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "839d1565-52fb-391f-9d6c-b88f38174835",
                                        "entry_id": "aba96368-d207-3d3e-a307-4cfcec8cd34f",
                                        "glosses": [
                                            "Befestigung eines Schmucksteins oder einer Perle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27adc40e-17d1-4e34-870a-48ee4ecb837f",
                                                "sense_id": "839d1565-52fb-391f-9d6c-b88f38174835",
                                                "text": "Dieser Stein gerät leicht aus der Fassung."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "14decb2c-d400-3c7e-8974-c1f88a077ffc",
                                        "entry_id": "aba96368-d207-3d3e-a307-4cfcec8cd34f",
                                        "glosses": [
                                            "farbige Bemalung oder Auflage mit Edelmetall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "048e4c18-100f-471e-a6ef-b900c30f65bd",
                                                "sense_id": "14decb2c-d400-3c7e-8974-c1f88a077ffc",
                                                "text": "Eine Skulptur mit gotischer Fassung."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "166f348e-360c-332b-8017-0984a904e606",
                                        "entry_id": "aba96368-d207-3d3e-a307-4cfcec8cd34f",
                                        "glosses": [
                                            "Variante eines Kunstwerkes/Textes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32b6669a-3976-4230-aaf7-06efadd2f1d1",
                                                "sense_id": "166f348e-360c-332b-8017-0984a904e606",
                                                "text": "Eine frühere Fassung des Stücks hatte einen anderen Schluss."
                                            },
                                            {
                                                "example_id": "8a50d608-7284-4374-adad-f81aff239e4b",
                                                "sense_id": "166f348e-360c-332b-8017-0984a904e606",
                                                "text": "„In späteren Fassungen finden sich 1500 Ortsnamen und mehr als 3500 Personennamen.“"
                                            },
                                            {
                                                "example_id": "a1a3268c-ad67-434b-98ea-c16510f88e44",
                                                "sense_id": "166f348e-360c-332b-8017-0984a904e606",
                                                "text": "„Sechs Jahre hat Woolf mit diesem Roman gerungen, sieben Fassungen erarbeitet, um nach der Fertigstellung einen psychischen Zusammenbruch zu erleiden.“"
                                            },
                                            {
                                                "example_id": "082378fd-d3c6-494c-8a73-3820a8ed7356",
                                                "sense_id": "166f348e-360c-332b-8017-0984a904e606",
                                                "text": "„Der zeitgeschichtliche Hintergrund der endgültigen Fassung zeigt bereits den Aufmarsch des Nationalsozialismus, der schließlich zum Untergang der Republik führt.“"
                                            },
                                            {
                                                "example_id": "2e173b2b-25aa-45e2-9b63-0ee233083cd8",
                                                "sense_id": "166f348e-360c-332b-8017-0984a904e606",
                                                "text": "„Die neue Bildergeschichte wurde dann doch wieder ein großer Erfolg, denn sie enthielt in der endgültigen Fassung genug, was nicht nur Kinder, sondern auch Ewachsene belustigen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
