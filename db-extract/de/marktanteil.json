                    {
                        "sense_id": "f117cf7b-ea93-37e4-a958-de1b74dab40f",
                        "entry_id": "afaa2137-5499-35c4-ad81-4e78c9b44c78",
                        "glosses": [
                            "Absatz- oder Umsatzanteil eines Unternehmens am Absatz beziehungsweise Umsatz der Branche (Marktvolumen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd8d4c9-3e7a-4e10-8db9-1196ac3f5870",
                                "sense_id": "f117cf7b-ea93-37e4-a958-de1b74dab40f",
                                "text": "Der Marktanteil unseres Produkts wurde im letzten Jahr um fünf Prozent gesteigert."
                            },
                            {
                                "example_id": "483e5d87-ae7f-45a6-8732-4d7e2ec47afd",
                                "sense_id": "f117cf7b-ea93-37e4-a958-de1b74dab40f",
                                "text": "„Damit erreichten sie erstmals einen zweistelligen Marktanteil.“"
                            },
                            {
                                "example_id": "d71da23f-23d9-400a-82c5-6596b4162839",
                                "sense_id": "f117cf7b-ea93-37e4-a958-de1b74dab40f",
                                "text": "„Seit Jahren kämpfen chinesische Unternehmen weltweit mit harten Bandagen um Marktanteile.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
