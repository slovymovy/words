                        "examples": [
                            {
                                "example_id": "5a9b3068-8bc3-494f-bce5-cd4c297f5a54",
                                "sense_id": "a0b60d9b-40d9-3c0a-a3ef-ba7df1b79bfd",
                                "text": "„Die Volkshochschulen sind derzeit noch eifrig auf der Suche nach passenden Nachhilfelehrern.“"
                            },
                            {
                                "example_id": "4a41d58a-83d6-4788-b6a1-a403d91af482",
                                "sense_id": "a0b60d9b-40d9-3c0a-a3ef-ba7df1b79bfd",
                                "text": "„Der Erfolg des aufgepeppten Sudokus gibt dem Nachhilfelehrer recht.“"
                            }
                        ],
