                            },
                            {
                                "target_lang_word": "dispendieux",
                                "target_lang_sense_clarification": "cher, qui coûte beaucoup"
                            },
                            {
                                "target_lang_word": "onéreux",
                                "target_lang_sense_clarification": "cher"
                            }
                        ]
                    }
