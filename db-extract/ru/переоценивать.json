                ],
                "translations": [
                    {
                        "translation_id": "7b12b431-b410-4ad0-a69c-e8de67ef3293",
                        "source_entry_id": "d384a699-0b32-3240-a369-0ea514ba31de",
                        "source_sense_description": "оценивать слишком высоко, выше, чем следует",
                        "target_lang_word": "overrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "806de141-5e1d-3a79-8515-d6fd99ec9238",
                                        "entry_id": "45720e42-c704-37a3-b88d-505fb1600d66",
                                        "glosses": [
                                            "To esteem too highly; to give greater praise than due."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a79d18a-fbce-3cdd-8eeb-9201b3badb2a",
                                        "entry_id": "45720e42-c704-37a3-b88d-505fb1600d66",
                                        "glosses": [
                                            "To overstate or overestimate in amount, extent, degree, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e373ed6-f6a7-43d4-bc0d-ee51a2d01842",
                                                "sense_id": "0a79d18a-fbce-3cdd-8eeb-9201b3badb2a",
                                                "text": "The vicissitudes of the weather may be responsible for more suffering among the lower animals than in the case of man, but we who live in England are perhaps inclined to overrate the amount of inconvenience occasioned to the world at large by this cause."
                                            },
                                            {
                                                "example_id": "cb8b3b38-b861-4588-a4fe-dfd50280b5f2",
                                                "sense_id": "0a79d18a-fbce-3cdd-8eeb-9201b3badb2a",
                                                "text": "Vance and Martin note another problem with retrospective analysis of sexual patterns in a case in which a person has been diagnosed with AIDS or ARC. There may be a tendency for diagnosed people to overrate their sexual encounters in the belief that promiscuity is the cause of AIDS, thereby explaining or rationalizing their illness."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overrate",
                                "target_lang_code": "en",
