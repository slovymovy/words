                "senses": [
                    {
                        "sense_id": "fc37a711-fa6a-3659-8f8f-504cb56b996c",
                        "entry_id": "f096bbe9-5479-3de4-80a2-eba59597e0a6",
                        "glosses": [
                            "En rapport avec le mouvement völkisch; mouvement ethnonationaliste allemand apparu au XIXᵉ siècle. Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f540980-8515-44fd-bfb9-3c7ac0d9c550",
                                "sense_id": "fc37a711-fa6a-3659-8f8f-504cb56b996c",
                                "text": "Dans les milieux ultranationalistes allemands de l'époque comme le mouvement völkisch –toujours difficile à traduire, mais qui sous-tend raciste, populiste et ethnonationaliste–, il y a donc un rejet de la modernité et la défense d'une Allemagne plus archaïque, voire païenne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39c36db9-b967-4ff2-8007-34e82b26a7d1",
                        "source_entry_id": "f096bbe9-5479-3de4-80a2-eba59597e0a6",
                        "source_sense_id": "fc37a711-fa6a-3659-8f8f-504cb56b996c",
                        "target_lang_word": "völkisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "völkisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae72ada-708d-3a13-9b36-71ed8aa67b0d",
                                        "entry_id": "e7bf169b-be38-3216-b040-5130b786bfed",
                                        "glosses": [
                                            "Zum Volke gehörig, das Volk betreffend, national"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eedb759c-d8d2-44cd-84aa-2090e7116590",
                                                "sense_id": "4ae72ada-708d-3a13-9b36-71ed8aa67b0d",
                                                "text": "Einen „völkisch-germanischen“ Ursprung, in einem sorbischen Siedlungsgebiet zu besitzen, war zu damaliger Zeit enorm wichtig."
                                            },
                                            {
                                                "example_id": "c450ed0a-c772-4ee8-a26e-ab038c2b0cc2",
                                                "sense_id": "4ae72ada-708d-3a13-9b36-71ed8aa67b0d",
                                                "text": "Das sonderbarste aber ist wohl, daß unser Wort deutsch selbst sich fast Laut für Laut mit tuticus, dem Ausdruck für ‚völkisch‘ deckt, der vielleicht manchem Leser noch aus der bei Livius sich findenden samnitischen Amtsbezeichnung meddix tuticus erinnerlich ist."
                                            },
                                            {
                                                "example_id": "0ecebb86-b57b-491d-9153-05b502e59893",
                                                "sense_id": "4ae72ada-708d-3a13-9b36-71ed8aa67b0d",
                                                "text": "„Bekanntlich hat sich während des letzten Menschenalters die völkische Zusammensetzung der Einwanderermassen von Grund aus verschoben: den Hauptstamm bilden jetzt nicht mehr Großbritannier und Deutsche, sondern Italiener, Slawen und Juden.“"
                                            },
                                            {
                                                "example_id": "d3c5b2ce-8ea0-4af4-a963-bdf15f73dde5",
                                                "sense_id": "4ae72ada-708d-3a13-9b36-71ed8aa67b0d",
                                                "text": "„Florian-Geyer-Festspiele, als völkisches Schauspiel aufgeführt von 1925-1938, danach wieder als örtliches Laienspiel seit 1980, ab 1983 mit Überarbeitungen an den völkischsten Textstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd3713e7-b0a0-3033-993c-7c19e3d614f0",
                                        "entry_id": "e7bf169b-be38-3216-b040-5130b786bfed",
                                        "glosses": [
                                            "sich programmatisch auf das eigene Volk stützend bzw. auf das eigene Volk gerichtet"
                                        ],
                                        "tags": [
                                            "nationalsozialistisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a262f082-859e-4ef6-8e3f-40cbf2971d78",
                                                "sense_id": "dd3713e7-b0a0-3033-993c-7c19e3d614f0",
                                                "text": "„Florian-Geyer-Festspiele, als völkisches Schauspiel aufgeführt von 1925-1938, danach wieder als örtliches Laienspiel seit 1980, ab 1983 mit Überarbeitungen an den völkischsten Textstellen.“"
                                            },
                                            {
                                                "example_id": "f0663fda-5834-4ffc-a958-1fd8685e52d4",
                                                "sense_id": "dd3713e7-b0a0-3033-993c-7c19e3d614f0",
                                                "text": "„Franz handelt nun völkische Zeitungen.“"
                                            },
                                            {
                                                "example_id": "22aa7005-e407-4689-bdf8-b439c27d0ecc",
                                                "sense_id": "dd3713e7-b0a0-3033-993c-7c19e3d614f0",
                                                "text": "„Wesentlicher Bestandteil der völkischen Ideologie sei das Rassendogma der Nationalsozialisten gewesen.“"
                                            },
                                            {
                                                "example_id": "2bfe9d4f-5e00-4169-8a86-c4fc13a06e5c",
                                                "sense_id": "dd3713e7-b0a0-3033-993c-7c19e3d614f0",
                                                "text": "„Aber auch hier im Dorf gab es einige, denen das nicht völkisch genug war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "297ebf30-a1b1-4d90-8bd9-8b4827448a7c",
