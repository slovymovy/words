                "senses": [
                    {
                        "sense_id": "f1e6ee31-03d2-3e7e-a09e-d21e22c06d64",
                        "entry_id": "9cc24cb7-d3fa-3788-8ec9-b8e621621b09",
                        "glosses": [
                            "Fähigkeit einer bestimmten Substanz oder eines Stoffstroms, die biologische Vielfalt und das ökologische Gleichgewicht durch eine übermäßige Nährstoffanreicherung zu beeinträchtigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db5880d3-44c5-49b4-803b-9711061c081d",
                                "sense_id": "f1e6ee31-03d2-3e7e-a09e-d21e22c06d64",
                                "text": "„Für die Wirkungskategorien Versauerungspotential (AP) und Überdüngungspotential (EP) dreht sich das Verhältnis um, so dass das Gesamtergebnis zu ca. 30% von Schadstoffemissionen und zu 70% von Kraftstoffbereitstellung bestimmt wird.“"
                            },
                            {
                                "example_id": "ed27f9a1-f7bb-47da-b0e6-0e3737821ec5",
                                "sense_id": "f1e6ee31-03d2-3e7e-a09e-d21e22c06d64",
                                "text": "„NOx- Emissionen, die mit Abstand wichtigste Umwelteinwirkung mit Überdüngungspotential, werden allerdings aufgrund ihres Einflusses auf die Ozonbildung berücksichtigt.“"
                            },
                            {
                                "example_id": "36d04b20-7d10-45b9-8344-9335a20d972c",
                                "sense_id": "f1e6ee31-03d2-3e7e-a09e-d21e22c06d64",
                                "text": "„Es werden die Umweltparameter Treibhauspotenzial (GWP), Versauerungspotenzial (AP), Überdüngungspotenzial (NP) sowie Primärenergieverbrauch und Flächenbedarf betrachtet.“"
                            },
                            {
                                "example_id": "ddc1c2e3-4e17-46b0-8a8a-d5b526f0b0b5",
                                "sense_id": "f1e6ee31-03d2-3e7e-a09e-d21e22c06d64",
                                "text": "„[Eutrophierungspotenzial (Überdüngungspotenzial)] Gelangen bei der Herstellung von Bauprodukten oder durch Auswaschung von Verbrennungsemissionen Phosphor- und Stickoxidverbindungen in die Umwelt, führt dies zu einer Eutrophierung von […]“"
                            },
                            {
                                "example_id": "0e1f22e8-aa1a-4981-915d-3e73ebdb7a38",
                                "sense_id": "f1e6ee31-03d2-3e7e-a09e-d21e22c06d64",
                                "text": "„[3.2.3.3 Überdüngungspotenzial] Unter Überdüngung oder auch Eutrophierung wird eine Anreicherung von Nährstoffen an einem bestimmten Standort verstanden. Das Überdüngungspotenzial, aus dem Englischen eutrophication potential (EP) […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
