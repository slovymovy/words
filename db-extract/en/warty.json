                                    {
                                        "sense_id": "5efa8a5f-291e-35d2-80ee-2591e91fdf4d",
                                        "entry_id": "3a586ae5-7115-3f6d-b190-025b4d4be53a",
                                        "glosses": [
                                            "Qui a la forme d’une verrue."
                                        ],
                                        "tags": [
                                            "Histoire naturelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afe25b4d-181b-477c-8600-443c603e10cc",
                                                "sense_id": "5efa8a5f-291e-35d2-80ee-2591e91fdf4d",
                                                "text": "Tumeur verruqueuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a97f44-d046-34fb-97df-55895d421807",
                                        "entry_id": "3a586ae5-7115-3f6d-b190-025b4d4be53a",
                                        "glosses": [
                                            "Qui est parsemé de verrues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6fbacd9-a898-4327-a870-e4a66e27f97b",
                                                "sense_id": "16a97f44-d046-34fb-97df-55895d421807",
                                                "text": "Épaisse et ridée dans les régions dorsales, elle s’y montre surtout chez la femelle, irrégulièrement semée de tubercules verruqueux, ou pustules, plus ou moins larges et saillants, parfois confluents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45e6ba0c-653d-4918-b858-0207f49bbb1d",
                        "source_entry_id": "ef3eeb68-0ee1-3283-b129-38406cc2adbc",
                        "source_sense_description": "having warts",
                        "target_lang_word": "warzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d2a1e5f-408d-3495-98ab-86c23400b349",
                                        "entry_id": "f80889ef-eb5b-3a94-b93c-722eb3af66fc",
                                        "glosses": [
                                            "mit festen, knubbeligen Erhebungen (= Warzen) versehen, Warzen habend/tragend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea7555c8-83a7-475c-b738-a54e2e4e8e71",
                                                "sense_id": "0d2a1e5f-408d-3495-98ab-86c23400b349",
                                                "text": "„Manche halten sie für die hässlichsten Tiere der Schöpfung: Kröten. Doch ihre warzige Haut verfügt über außergewöhnliche Fähigkeiten.“"
                                            },
                                            {
                                                "example_id": "067c3d29-5b94-4dbe-8c14-7a9baf54b04d",
                                                "sense_id": "0d2a1e5f-408d-3495-98ab-86c23400b349",
                                                "text": "„Man kann also spekulieren, dass für die Kröte die warzige Haut zumindest eine analoge Empfindung hervorruft, wie für uns die reine Haut bei einem Geschlechtspartner.“"
                                            },
                                            {
                                                "example_id": "61b8abe5-884e-453b-90b5-3f8ced90bcac",
                                                "sense_id": "0d2a1e5f-408d-3495-98ab-86c23400b349",
                                                "text": "„Die Zygoten haben eine glatte, seltener eine warzige Oberfläche.“"
                                            },
                                            {
                                                "example_id": "c967e6b7-1652-4d06-9724-05db934f37bb",
                                                "sense_id": "0d2a1e5f-408d-3495-98ab-86c23400b349",
                                                "text": "„Die Oxalate haben zumeist eine rauhe, warzige Oberfläche (maulbeerartig).“"
                                            },
                                            {
                                                "example_id": "9cef8500-ac9c-49b8-af80-539b702867bc",
                                                "sense_id": "0d2a1e5f-408d-3495-98ab-86c23400b349",
                                                "text": "„Seine Nase sah aus wie eine warzige Gurke,“ […]."
                                            },
                                            {
                                                "example_id": "1f79e8ac-8bbe-485e-b964-396ae9b24254",
                                                "sense_id": "0d2a1e5f-408d-3495-98ab-86c23400b349",
                                                "text": "„Die dunkelgraue oder schwärzlich-graue, warzige Borke besitzt im Gegensatz zur Gewöhnlichen Esche kein deutliches Furchen- und Leistenmuster.“"
                                            },
                                            {
                                                "example_id": "73a3b1b0-cac5-4acb-b4a1-d8e6d3903139",
                                                "sense_id": "0d2a1e5f-408d-3495-98ab-86c23400b349",
                                                "text": "[Fischschuppenkrankheit] „Die Haut zeigt keinerlei Rötung, ist trocken und rauh; in sehr intensiven Fällen finden sich warzige und stachlige, hornartige Hervorragungen.“"
                                            },
                                            {
                                                "example_id": "6020b850-1791-4602-a61a-e2f51e79136a",
                                                "sense_id": "0d2a1e5f-408d-3495-98ab-86c23400b349",
                                                "text": "[…] „im Badezimmer humpelt eine große, warzige Kröte aus der Abflußrinne, als ich mich zeige.“"
                                            },
                                            {
                                                "example_id": "84850ca3-3f62-4fa1-aa7e-72b85c770af6",
                                                "sense_id": "0d2a1e5f-408d-3495-98ab-86c23400b349",
                                                "text": "„Bei der Aga-Kröte dagegen ist die Haut ledrig und warzig.“"
                                            },
                                            {
                                                "example_id": "ce210da7-6713-49e3-8de5-f2e593798115",
                                                "sense_id": "0d2a1e5f-408d-3495-98ab-86c23400b349",
                                                "text": "[Guatemaltekischen Avocado:] „Ihre Schale ist dick, hart und warzig.“"
                                            },
                                            {
                                                "example_id": "cd59d99b-97c4-4ac3-b42d-7ea7c9c331af",
                                                "sense_id": "0d2a1e5f-408d-3495-98ab-86c23400b349",
                                                "text": "„Trolle dagegen sind nicht so niedlich: Sie hausen in Höhlen, haben riesige Trampelfüße, sind oft bucklig und warzig und fressen rohes Fleisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
