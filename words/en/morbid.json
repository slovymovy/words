{
    "word_family": [
        "morbidity",
        "morbidly",
        "morbidness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1fd536e4-d9ac-3c39-b4b6-b8883b1ea499",
                    "sense_definition": "Taking an interest in, or fixating on, unhealthy or unwholesome subjects such as death, decay, or disease.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychological_morbidness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a <w>morbid</w> obsession with true crime stories and reads about them every night.",
                            "target_lang_translations": {
                                "ru": "У неё <w>болезненная</w> одержимость историями о реальных преступлениях, и она читает о них каждый вечер."
                            }
                        },
                        {
                            "text": "His <w>morbid</w> curiosity led him to research the history of medieval torture methods.",
                            "target_lang_translations": {
                                "ru": "Его <w>нездоровое</w> любопытство побудило его изучить историю средневековых пыток."
                            }
                        }
                    ],
                    "synonyms": [
                        "sick",
                        "twisted",
                        "unhealthy",
                        "unwholesome",
                        "warped"
                    ],
                    "common_phrases": [
                        "morbid curiosity",
                        "morbid obsession",
                        "morbid fascination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий нездоровый, неестественный интерес к мрачным темам, таким как смерть, болезни или насилие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нездоровый",
                                "target_lang_sense_clarification": "об интересе, любопытстве или фиксации"
                            },
                            {
                                "target_lang_word": "болезненный",
                                "target_lang_sense_clarification": "об увлечении или влечении к мрачному"
                            },
                            {
                                "target_lang_word": "ненормальный",
                                "target_lang_sense_clarification": "выходящий за рамки обычного интереса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b868431b-96c1-307b-a78f-208402dd864a",
                    "sense_definition": "Suggesting the horror of death; macabre or ghoulish.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "macabre_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gothic novel was filled with <w>morbid</w> details about haunted crypts and decaying spirits.",
                            "target_lang_translations": {
                                "ru": "Готический роман был полон <w>мрачных</w> подробностей о склепах с привидениями и увядающих духах."
                            }
                        },
                        {
                            "text": "He wrote a <w>morbid</w> poem that captured the grim atmosphere of the abandoned cemetery.",
                            "target_lang_translations": {
                                "ru": "Он написал <w>жуткое</w> стихотворение, передающее мрачную атмосферу заброшенного кладбища."
                            }
                        }
                    ],
                    "synonyms": [
                        "black",
                        "ghoulish",
                        "grim",
                        "macabre"
                    ],
                    "common_phrases": [
                        "morbid humor",
                        "morbid poem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий о смерти или ужасе; мрачный, жуткий или макабрический."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "навевающий мысли о смерти"
                            },
                            {
                                "target_lang_word": "жуткий",
                                "target_lang_sense_clarification": "пугающий, зловещий"
                            },
                            {
                                "target_lang_word": "загробный",
                                "target_lang_sense_clarification": "макабрический, связанный со смертью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "967c7797-97db-370e-874a-4be1264f82c9",
                    "sense_definition": "Grisly, gruesome, or sickening.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "macabre_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news broadcast warned viewers before showing the <w>morbid</w> details of the accident.",
                            "target_lang_translations": {
                                "ru": "В выпуске новостей зрителей предупредили перед показом <w>жутких</w> подробностей аварии."
                            }
                        },
                        {
                            "text": "I had to look away from the screen during that <w>morbid</w> scene in the horror movie.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось отвести взгляд от экрана во время этой <w>омерзительной</w> сцены в фильме ужасов."
                            }
                        }
                    ],
                    "synonyms": [
                        "bloody",
                        "disgusting",
                        "gory",
                        "grisly",
                        "gruesome",
                        "sickening"
                    ],
                    "common_phrases": [
                        "morbid details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ужасающий, отталкивающий или тошнотворный; вызывающий содрогание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жуткий",
                                "target_lang_sense_clarification": "вызывающий ужас или отвращение"
                            },
                            {
                                "target_lang_word": "омерзительный",
                                "target_lang_sense_clarification": "крайне неприятный, отталкивающий"
                            },
                            {
                                "target_lang_word": "чудовищный",
                                "target_lang_sense_clarification": "шокирующий своей жестокостью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce469969-402e-381b-b08d-e4255084f533",
                    "sense_definition": "Of, relating to, or afflicted by disease.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_morbidness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon examined the <w>morbid</w> tissue under a microscope to determine the stage of the illness.",
                            "target_lang_translations": {
                                "ru": "Хирург исследовал <w>поражённую</w> ткань под микроскопом, чтобы определить стадию заболевания."
                            }
                        },
                        {
                            "text": "The autopsy report detailed the <w>morbid</w> anatomy of the patient's damaged heart.",
                            "target_lang_translations": {
                                "ru": "В отчёте о вскрытии подробно описывалась <w>патологическая</w> анатомия повреждённого сердца пациента."
                            }
                        }
                    ],
                    "synonyms": [
                        "pathological"
                    ],
                    "common_phrases": [
                        "morbid anatomy",
                        "morbid growth"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Often used in medical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к болезни, вызванный заболеванием или поражённый патологическим процессом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болезненный",
                                "target_lang_sense_clarification": "вызванный болезнью"
                            },
                            {
                                "target_lang_word": "патологический",
                                "target_lang_sense_clarification": "в медицинском контексте"
                            },
                            {
                                "target_lang_word": "поражённый",
                                "target_lang_sense_clarification": "о тканях или органах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}