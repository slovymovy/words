                "senses": [
                    {
                        "sense_id": "2e2aa009-b2a4-371c-a380-e4393df4d4b8",
                        "entry_id": "241199f3-a5cc-34f2-ab5b-9aad3b894758",
                        "glosses": [
                            "Kind oder Jugendlicher ohne Geschwister"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2135e530-df40-4c01-a25e-33cb2e6a3e0e",
                                "sense_id": "2e2aa009-b2a4-371c-a380-e4393df4d4b8",
                                "text": "„Hast ihnen wehgetan, hast selber gelitten, bist so recht Alleinkind gewesen, und so ein Alleinkind hat es immer schwer im Leben.“"
                            },
                            {
                                "example_id": "a08a952f-92cf-4968-805b-39b5e9bcbbe5",
                                "sense_id": "2e2aa009-b2a4-371c-a380-e4393df4d4b8",
                                "text": "„Ein Alleinkind läuft finanziell leicht mit und kann sogar erfahrungsgemäß besser versorgt werden, als es bei mehreren Kindern möglich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
