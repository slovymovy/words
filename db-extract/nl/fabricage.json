                    },
                    {
                        "translation_id": "8fca5675-a82f-45ab-ab3b-3d26bf55ce67",
                        "source_entry_id": "fafcec0c-3802-35f7-8512-7c6d9cf32417",
                        "source_sense_id": "38e4b1e0-f684-3596-bcc4-715da6fdce66",
