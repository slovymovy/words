                        "entry_id": "c89790f4-dbe1-336e-9a96-0d625b83dc57",
                        "glosses": [
                            "Open (especially to something), unconcealed and/or unprotected (and therefore vulnerable, susceptible)."
                        ],
                        "tags": [
                            "usually",
                            "with-to"
                        ],
                        "examples": [
                            {
                                "example_id": "82025749-49e0-4bbf-b7ce-ed5417696744",
                                "sense_id": "16feeb80-348d-32a7-8bea-a615016b0d56",
                                "text": "exposed to light; exposed to water; exposed to abuse; exposed to danger"
                            },
                            {
                                "example_id": "738ddf87-b160-4a95-a221-7388ae328110",
                                "sense_id": "16feeb80-348d-32a7-8bea-a615016b0d56",
                                "text": "an exposed path (trail, etc) up the mountain (one with a drop-off on one or both sides)"
                            },
                            {
                                "example_id": "090fdd94-df6d-4b2d-bddd-dcff471359bb",
                                "sense_id": "16feeb80-348d-32a7-8bea-a615016b0d56",
                                "text": "The monastery perched on an exposed cliff."
                            },
                            {
                                "example_id": "cdf4dc5e-063e-41df-9112-fc15989cc0aa",
                                "sense_id": "16feeb80-348d-32a7-8bea-a615016b0d56",
                                "text": "The soldiers needed to find cover fast. Their current position was very exposed."
                            },
                            {
                                "example_id": "9c519ae3-f104-47ad-b211-bf34b409ae02",
                                "sense_id": "16feeb80-348d-32a7-8bea-a615016b0d56",
                                "text": "The bike chain is open and exposed to tough environmental conditions such as temperature changes, humidity, rain, dirt and road salt."
                            },
                            {
                                "example_id": "3cce291c-9fff-4a0e-b1df-43d81782f593",
                                "sense_id": "16feeb80-348d-32a7-8bea-a615016b0d56",
                                "text": "exposed beam"
                            },
                            {
                                "example_id": "42640af0-234d-4110-abea-9ba08225a852",
                                "sense_id": "16feeb80-348d-32a7-8bea-a615016b0d56",
                                "text": "exposed brick"
                            }
                        ]
