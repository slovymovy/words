{
    "word_family": [
        "wsiadanie",
        "wsiadka",
        "wsiad"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd2d793a-786e-3d1d-90d6-0d3c1d965c4f",
                    "sense_definition": "wchodzić do środka pojazdu lub innego środka transportu",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pasażerowie <w>wsiadają</w> do pociągu na peronie trzecim.",
                            "target_lang_translations": {
                                "en": "Passengers are <w>getting on</w> the train at platform three."
                            }
                        },
                        {
                            "text": "Codziennie rano <w>wsiadam</w> do autobusu jadącego do centrum.",
                            "target_lang_translations": {
                                "en": "Every morning I <w>get on</w> the bus going to the city center."
                            }
                        }
                    ],
                    "antonyms": [
                        "wysiadać"
                    ],
                    "common_phrases": [
                        "wsiadać do autobusu",
                        "wsiadać do samochodu"
                    ],
                    "target_lang_definitions": {
                        "en": "To enter or get inside a vehicle or other means of transport."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get on",
                                "target_lang_sense_clarification": "To board a vehicle, especially a bus, train, or plane."
                            },
                            {
                                "target_lang_word": "get in",
                                "target_lang_sense_clarification": "To enter a smaller vehicle like a car."
                            },
                            {
                                "target_lang_word": "board",
                                "target_lang_sense_clarification": "A more formal term for entering a ship, aircraft, or train."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d673caf-c0d6-3d50-9817-a2f79cc96e8a",
                    "sense_definition": "zajmować miejsce na czymś, na przykład na koniu lub rowerze",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko uczy się, jak bezpiecznie <w>wsiadać</w> na rower.",
                            "target_lang_translations": {
                                "en": "The child is learning how to <w>get on</w> a bike safely."
                            }
                        },
                        {
                            "text": "Jeździec pewnie <w>wsiada</w> na konia przed rozpoczęciem treningu.",
                            "target_lang_translations": {
                                "en": "The rider confidently <w>mounts</w> the horse before starting the training."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wsiadać na rower",
                        "wsiadać na konia"
                    ],
                    "target_lang_definitions": {
                        "en": "To take a position on top of something, such as a horse or a bicycle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get on",
                                "target_lang_sense_clarification": "To mount a bicycle, horse, or motorcycle."
                            },
                            {
                                "target_lang_word": "mount",
                                "target_lang_sense_clarification": "To climb up onto something, particularly a horse or a bicycle."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b99c13f-1418-3dd3-af3b-e726c801f359",
                    "sense_definition": "agresywnie lub usilnie kogoś krytykować, atakować słownie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "krytyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szef znowu <w>wsiada</w> na pracowników za drobne błędy w raporcie.",
                            "target_lang_translations": {
                                "en": "The boss is <w>getting on</w> the employees again for minor mistakes in the report."
                            }
                        },
                        {
                            "text": "Nie <w>wsiadaj</w> na niego, on naprawdę starał się pomóc.",
                            "target_lang_translations": {
                                "en": "Don't <w>get on</w> him; he really tried to help."
                            }
                        }
                    ],
                    "synonyms": [
                        "atakować",
                        "krytykować"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To aggressively or persistently criticize or attack someone verbally."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get on someone",
                                "target_lang_sense_clarification": "To nag, criticize, or pressure someone."
                            },
                            {
                                "target_lang_word": "attack",
                                "target_lang_sense_clarification": "To criticize someone harshly."
                            },
                            {
                                "target_lang_word": "criticize",
                                "target_lang_sense_clarification": "To express disapproval of someone."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}