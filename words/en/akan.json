                                "target_lang_sense_clarification": "язык"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿坎语",
                                "target_lang_sense_clarification": "语言名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba5ce19b-1233-345f-ad79-b69e96daa2a4",
                    "sense_definition": "A volcano located in Hokkaido, Japan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Hikers traveled to Japan to climb the slopes of <w>Akan</w>.",
