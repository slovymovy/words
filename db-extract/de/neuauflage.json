                ],
                "senses": [
                    {
                        "sense_id": "12cbb78d-cd5d-3b7a-b85d-6f4da99eb1af",
                        "entry_id": "a6d6f026-56f8-37fd-a7e4-0de79f1af96b",
                        "glosses": [
                            "nochmalige Auflage eines bereits hergestellten Druckwerkes"
                        ],
                        "tags": [
                            "Verlagswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "3191dbd1-669c-4d98-aa5d-1d9be9262c64",
                                "sense_id": "12cbb78d-cd5d-3b7a-b85d-6f4da99eb1af",
                                "text": "Aufgrund der großen Nachfrage erfolgt die Neuauflage des Buches."
                            },
                            {
                                "example_id": "cf7b961d-7d80-41f6-bee4-f64f349adb04",
                                "sense_id": "12cbb78d-cd5d-3b7a-b85d-6f4da99eb1af",
                                "text": "„Dass seine Arbeit bis heute als grundlegend gelten darf, zeigt die Haltbarkeit seiner Forschungen, die in der Neuauflage mit zwei neuen Unterkapiteln ergänzt wurden, und die weit über die Mechanismen der Machtübernahme hinaus reichen: Was sich in Österreich ereignete, trug zu einer Radikalisierung bei, die Terror und Unterdrückung forcierte und geradewegs in den Krieg mündete.“"
                            },
                            {
                                "example_id": "40fccb59-9331-440b-9a6f-77465a48382f",
                                "sense_id": "12cbb78d-cd5d-3b7a-b85d-6f4da99eb1af",
                                "text": "„Im Rahmen dieser Neuauflage wurde außerdem eine Online-Umfrage zur Akzeptanz von Aussprachevarianten durchgeführt, aus der ausgewählte relevante Ergebnisse im Wörterbuchteil publiziert werden.“"
                            },
                            {
                                "example_id": "3a311198-e4cc-490c-862b-6bfc6f4de1f5",
                                "sense_id": "12cbb78d-cd5d-3b7a-b85d-6f4da99eb1af",
                                "text": "„Diese Neuauflage des Rechtschreibdudens leistet dazu einen wichtigen Beitrag.“"
                            },
                            {
                                "example_id": "2ec3dcec-674a-4277-a0f6-ea3cb35d1995",
                                "sense_id": "12cbb78d-cd5d-3b7a-b85d-6f4da99eb1af",
                                "text": "„Autoren und Redaktion haben sich auch bei der Erarbeitung dieser Neuauflage besonders darum bemüht, schwierige Gegenstände allgemein verständlich darzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
