                "translations": [
                    {
                        "translation_id": "206d13a4-d88f-41b1-a75b-7574e3060ac9",
                        "source_entry_id": "e70ff0b2-3259-32d0-a1b3-8bfa429bedf4",
                        "source_sense_id": "517f8dcc-f6f6-391a-a86e-f55084c6be55",
                        "target_lang_word": "handicap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handicap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ede2d4a1-c95a-38e1-8068-be261bfad25a",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "Something that prevents, hampers, or hinders."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbaea73d-8a1d-48ae-af1e-aff6170090a5",
                                                "sense_id": "ede2d4a1-c95a-38e1-8068-be261bfad25a",
                                                "text": "Age is often a handicap."
                                            },
                                            {
                                                "example_id": "2ad4a5a7-5db0-422c-ae84-985eb873fee7",
                                                "sense_id": "ede2d4a1-c95a-38e1-8068-be261bfad25a",
                                                "text": "Captain Edward Carlisle[…]felt a curious sensation of helplessness seize upon him as he met her steady gaze,[…]; he could not tell what this prisoner might do. He cursed the fate which had assigned such a duty, cursed especially that fate which forced a gallant soldier to meet so superb a woman as this under handicap so hard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad6a714c-1d7e-3e74-8440-0f179cb85491",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "An allowance of a certain amount of time or distance in starting, granted in a race (or other contest of skill) to the competitor possessing disadvantages; or an additional weight or other hindrance imposed upon the one possessing advantages, in order to equalize, as much as possible, the chances of success."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eab7bf2c-4383-4205-b54b-c10184cade4a",
                                                "sense_id": "ad6a714c-1d7e-3e74-8440-0f179cb85491",
                                                "text": "The older boy won, even though his opponent had been granted a handicap of five meters."
                                            },
                                            {
                                                "example_id": "ff2e065f-920c-4ec7-8f76-eb4544b82c55",
                                                "sense_id": "ad6a714c-1d7e-3e74-8440-0f179cb85491",
                                                "text": "A handicap in chess often involves removal of the queen's rook."
                                            },
                                            {
                                                "example_id": "05245edf-16e8-488d-9f58-49e815f1de16",
                                                "sense_id": "ad6a714c-1d7e-3e74-8440-0f179cb85491",
                                                "text": "Eventually the elephant and camel were depatched by themselves with two laps start of the bicyclist and horse, the motor car being scratch. It was a sensational race owing to the conduct of the field, but on the handicap the elephant won, bicycle second, motor car third."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baa05bf8-d42f-382b-8f62-79b17724b471",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "The disadvantage itself, in particular physical or mental disadvantages of people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "403de27e-71b0-3d19-9e07-0308d1f4be11",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "A race or similar contest in which there is an allowance of time, distance, weight, or other advantage, to equalize the chances of the competitors."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0edd0c94-d43d-346e-981a-a7d6b626a6bb",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "An old card game, similar to lanterloo."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bb76d35-0873-41cc-877b-6eba6e9eb4db",
                                                "sense_id": "0edd0c94-d43d-346e-981a-a7d6b626a6bb",
                                                "text": "Here some of us fell to handicap, a sport that I never knew before, which was very good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f462b6b-f912-3bbb-a6b0-a8d8825e0a96",
                                        "entry_id": "7198487f-15a7-3b8a-976d-04401ac2ddff",
                                        "glosses": [
                                            "Synonym of hand-in-cap (“old English trading game”)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "handicap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4b5bd25-2df1-31aa-975d-035590315424",
                                        "entry_id": "1458f102-4848-3147-9a64-c7ebf5c0ab6c",
                                        "glosses": [
                                            "To encumber with a handicap in any contest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4511a661-f13d-3339-a7a1-b451791572a1",
                                        "entry_id": "1458f102-4848-3147-9a64-c7ebf5c0ab6c",
                                        "glosses": [
                                            "To place at disadvantage."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bc317a3-d8b5-4fa7-a397-2f603b409da4",
                                                "sense_id": "4511a661-f13d-3339-a7a1-b451791572a1",
                                                "text": "The candidate was handicapped by her lack of experience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "689fa9a9-4d7e-3e7b-9a2c-60a307d1877a",
                                        "entry_id": "1458f102-4848-3147-9a64-c7ebf5c0ab6c",
                                        "glosses": [
                                            "To estimate betting odds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "729de6cd-5d9b-40c0-8209-a5d65f443a77",
                                                "sense_id": "689fa9a9-4d7e-3e7b-9a2c-60a307d1877a",
                                                "text": "Grandpa Andy would buy the racing form the day ahead of time so he could handicap the race before he even arrived at the track."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c666ddc6-91bf-4793-a633-a1410aed30c5",
                        "source_entry_id": "e70ff0b2-3259-32d0-a1b3-8bfa429bedf4",
                        "source_sense_id": "517f8dcc-f6f6-391a-a86e-f55084c6be55",
                        "target_lang_word": "lameness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lameness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4810336-d11c-3da6-a045-604d07a2ad54",
                                        "entry_id": "e54d2099-22f6-35ed-a0e2-a490c4a314d4",
                                        "glosses": [
                                            "An impediment to walking due to the feet or legs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c264e488-db82-4e89-8260-e19dc74086a0",
                                                "sense_id": "c4810336-d11c-3da6-a045-604d07a2ad54",
                                                "text": "His lameness may have prevented him from walking but it didn't stop him from running for public office."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dd8bbf8-01af-330d-9cfa-45efb84b0695",
                                        "entry_id": "e54d2099-22f6-35ed-a0e2-a490c4a314d4",
                                        "glosses": [
                                            "The quality of being lame, pathetic or uncool."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d53c3a8-b252-4426-aa6f-7131063e3027",
                                                "sense_id": "7dd8bbf8-01af-330d-9cfa-45efb84b0695",
                                                "text": "I can't believe the lameness of the special effects in that movie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a86da105-1cb4-4a15-81c0-e25d39d4b379",
                        "source_entry_id": "e70ff0b2-3259-32d0-a1b3-8bfa429bedf4",
                        "source_sense_id": "517f8dcc-f6f6-391a-a86e-f55084c6be55",
                        "target_lang_word": "Gebrechen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebrechen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e429f94-c55f-32d7-8081-926bd7a12c37",
                                        "entry_id": "55074267-9949-3cf1-b5c0-364b3fc0f664",
                                        "glosses": [
                                            "andauernde (körperliche, gesundheitliche) Beeinträchtigung"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e39d50d3-c9bf-4cbe-9560-d5c579b54839",
                                                "sense_id": "1e429f94-c55f-32d7-8081-926bd7a12c37",
                                                "text": "In letzter Zeit litt er sehr stark an seinen Gebrechen."
                                            },
                                            {
                                                "example_id": "8b70d098-1bae-42d1-b2f2-c1fd06e6a0aa",
                                                "sense_id": "1e429f94-c55f-32d7-8081-926bd7a12c37",
                                                "text": "„Zunehmende Gebrechen und der Kummer um ihren Sohn hatten Charlene ihres Witzes und ihrer lebhaften Art beraubt, und dieselben zwei Dämonen hatten ihren Vater zu einem verbitterten Mann gemacht.“"
                                            },
                                            {
                                                "example_id": "890f1063-530d-4da2-bc5f-8b5020c5eccd",
                                                "sense_id": "1e429f94-c55f-32d7-8081-926bd7a12c37",
                                                "text": "„In den Jahren, in denen sich die Gebrechen des Alters zu zeigen begannen, versuchte Hjartward, noch vor seinem Hinscheiden Vergebung zu erlangen.“"
                                            },
                                            {
                                                "example_id": "9e6c6dc3-11c4-496c-8692-97a957c0ce52",
                                                "sense_id": "1e429f94-c55f-32d7-8081-926bd7a12c37",
                                                "text": "„Mein Vater war zeit seines Lebens ein Hypochonder, der täglich ein anderes Gebrechen hatte, einen neuen Schmerz verspürte.“"
                                            },
                                            {
                                                "example_id": "5c027fda-9f4a-4277-bb8a-acf22fa0fc86",
                                                "sense_id": "1e429f94-c55f-32d7-8081-926bd7a12c37",
                                                "text": "„Insbesondere dort, wo es um Situationskomik geht, machen Schwank und Lustspiel von Gebrechen reichen Gebrauch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                        "entry_id": "55074267-9949-3cf1-b5c0-364b3fc0f664",
                                        "glosses": [
                                            "Beschädigung, technische Störung"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1723b85c-48bf-4aaf-9f83-766f81e4a5f3",
                                                "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                                "text": "Das Gebrechen an der Wasserleitung wurde binnen einer Stunde repariert."
                                            },
                                            {
                                                "example_id": "6ec49349-fa96-4bb3-8dba-a04185d5bee4",
                                                "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                                "text": "„Technische Gebrechen am Flugzeug sind nicht bekannt.“"
                                            },
                                            {
                                                "example_id": "390b14f4-5a3d-40a3-9fa5-bee534c712ff",
                                                "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                                "text": "„Wahrscheinliche Unfallursachen seien ein technisches Gebrechen durch Blockierung der Steuerung durch eine Schraube, durch Blockierung zufolge eines nicht ordnungsgemäß verwahrten Fotoapparats sowie ein Flugfehler des Piloten der abgestürzten Maschine.“"
                                            },
                                            {
                                                "example_id": "072e9658-c21d-406b-9472-9d5233913b4e",
                                                "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                                "text": "„Verspäteter Abflug: Fluglinie haftet bei technischem Gebrechen“"
                                            },
                                            {
                                                "example_id": "9103c4b2-1ec7-4511-9d91-73fc9a4a6c60",
                                                "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                                "text": "„Dies könne nur darin seinen Grund haben, dass die Zustellung aufgrund technischer Gebrechen nicht möglich gewesen sei.“"
                                            },
                                            {
                                                "example_id": "5302b479-fb62-4258-96e9-06f2f64a0241",
                                                "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                                "text": "„Die Liste umfasst eine Einschränkung der technischen Probleme, Vogelschlag, die unvorhergesehene Schließung des Luftraums und unvorhergesehene Streiks. »Technisches Gebrechen« als (kostenlose) Erklärung für Verspätungen werden nicht mehr reichen: Sie sollen nur noch in Einzelfällen als »Ausrede« für die Fluglinien gelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2fe180e-7507-4f95-a4bd-e7b0db37006e",
                        "source_entry_id": "e70ff0b2-3259-32d0-a1b3-8bfa429bedf4",
                        "source_sense_id": "517f8dcc-f6f6-391a-a86e-f55084c6be55",
                        "target_lang_word": "увечье",
