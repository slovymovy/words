                    {
                        "translation_id": "c3518798-3816-4fcd-b4c8-84ce0788c8aa",
                        "source_entry_id": "f1d4f002-6b47-34f7-b557-78c92dde00fe",
                        "source_sense_description": "не связанный с половыми клетками или с оплодотворением",
                        "target_lang_word": "ungeschlechtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungeschlechtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85e990a8-e645-353c-8fc7-c4315ec21bcc",
                                        "entry_id": "c04a8d47-075f-3231-b17e-126896641deb",
                                        "glosses": [
                                            "sich anders als durch die Verschmelzung von Eizelle und Samen vermehrend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a47b638-95bd-40c5-8e1c-ac047476b00c",
                                                "sense_id": "85e990a8-e645-353c-8fc7-c4315ec21bcc",
                                                "text": "Sie vermehren sich ungeschlechtlich auf dem Wege der Zellteilung."
                                            },
                                            {
                                                "example_id": "f00fcf0a-8251-4ea3-8aa4-b56c277adbe3",
                                                "sense_id": "85e990a8-e645-353c-8fc7-c4315ec21bcc",
                                                "text": "„Einige Pilze können sich auch ungeschlechtlich fortpflanzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65207509-ab3c-34b1-b58d-d1ee82c75900",
                                        "entry_id": "c04a8d47-075f-3231-b17e-126896641deb",
                                        "glosses": [
                                            "eine Geschlechtsidentität ohne Bezug zu den (binären) Geschlechtern „weiblich“ und „männlich“ aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8ec1d78-a613-43dd-85a3-c8c4d7e51391",
                                                "sense_id": "65207509-ab3c-34b1-b58d-d1ee82c75900",
                                                "text": "„Heute kann bei uns ein Mensch unbehelligt und unbehandelt asexuell leben, nicht aber ungeschlechtlich, ohne eine äußerlich zugeordnete Geschlechtlichkeit.“"
                                            },
                                            {
                                                "example_id": "bb32d68f-4cc8-42fa-8c34-22184dbda4d1",
                                                "sense_id": "65207509-ab3c-34b1-b58d-d1ee82c75900",
                                                "text": "„Als agender oder ungeschlechtlich bezeichnen sich jene, die sich gar keinem Geschlecht zugehörig fühlen.“"
                                            },
                                            {
                                                "example_id": "39823b8b-d140-40a2-ab77-a685dde46cb4",
                                                "sense_id": "65207509-ab3c-34b1-b58d-d1ee82c75900",
                                                "text": "„Wenn man dann natürlich mal so ein bisschen weitergesponnen hat, dann fragt man sich natürlich, wenn man so ein Kind ungeschlechtlich beurkundet, was passiert mit dem in 18 Jahren […]“"
                                            },
                                            {
                                                "example_id": "6139d0df-a5fd-4b34-9c5f-f908c7833e2a",
                                                "sense_id": "65207509-ab3c-34b1-b58d-d1ee82c75900",
                                                "text": "„Agender – Dieser Begriff wird von Menschen genutzt, welche eine ungeschlechtliche Geschlechtsidentität haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
