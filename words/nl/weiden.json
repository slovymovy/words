                            {
                                "target_lang_word": "meadows",
                                "target_lang_sense_clarification": "plural of meadow, grassy fields"
                            },
                            {
                                "target_lang_word": "pastures",
                                "target_lang_sense_clarification": "plural of pasture, grazing lands"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b1b9813e-2433-3dcd-9f34-554cb0ad672d",
                    "sense_definition": "vee op een stuk grond laten grazen, of zelf grazen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "grazen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De herder <w>weidde</w> zijn kudde schapen op de heide.",
                            "target_lang_translations": {
                                "en": "The shepherd <w>grazed</w> his flock of sheep on the heath."
                            }
                        },
                        {
                            "text": "De boer liet zijn paarden de hele zomer in het dal <w>weiden</w>.",
                            "target_lang_translations": {
                                "en": "The farmer let his horses <w>graze</w> in the valley all summer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vee weiden"
                    ],
                    "target_lang_definitions": {
                        "en": "to graze, or to put livestock out to pasture to feed on grass"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "graze",
                                "target_lang_sense_clarification": "of livestock eating grass, or causing them to feed on grass"
                            },
                            {
                                "target_lang_word": "pasture",
                                "target_lang_sense_clarification": "put animals out to feed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ae5ba32-8756-3a72-992c-84656261a0e9",
                    "sense_definition": "zich vrij over een omgeving bewegen, meestal gezegd van de blik of ogen",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hun blikken <w>weidden</w> over het uitgestrekte berglandschap voor hen.",
                            "target_lang_translations": {
                                "en": "Their gazes <w>wandered</w> over the vast mountain landscape before them."
                            }
                        },
                        {
                            "text": "Zij liet haar ogen over de aanwezige gasten in de zaal <w>weiden</w>.",
                            "target_lang_translations": {
                                "en": "She let her eyes <w>roam</w> over the guests present in the hall."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de ogen laten weiden"
                    ],
                    "traits": [
