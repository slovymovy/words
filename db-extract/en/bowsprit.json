                        "target_lang_word": "beaupré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beaupré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a9c1d0-57cb-31ae-9e54-4342c86927fa",
                                        "entry_id": "67fef891-6de4-39d6-90cc-20a2e57ba59a",
                                        "glosses": [
                                            "Mât placé à l’avant du navire, plus ou moins obliquement, sous un angle qui va jusqu'à 20 et 25° à bord d’un grand navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0067341e-c94b-4768-8983-c2c26eac0532",
                                                "sense_id": "c3a9c1d0-57cb-31ae-9e54-4342c86927fa",
                                                "text": "Seulement à l’avant, sur la proue, penché sur le mât de beaupré, dormait ou rêvait une figure noire."
                                            },
                                            {
                                                "example_id": "452f26a2-15ea-4f6b-8b05-f127e278bb9a",
                                                "sense_id": "c3a9c1d0-57cb-31ae-9e54-4342c86927fa",
                                                "text": "Un nouveau beaupré, en pin d’Orégon lui aussi, remplace celui qui fut brisé dans un ouragan."
                                            },
                                            {
                                                "example_id": "01711988-a9d5-43f1-a8d1-fb3c4d04f1d4",
                                                "sense_id": "c3a9c1d0-57cb-31ae-9e54-4342c86927fa",
                                                "text": "Le vieil homme et le fiancé ont attaché la voile au beaupré, et le vent violent qui vient de la passe fait basculer la pirogue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efbd993b-1ee2-4b06-82f2-969a4444e839",
                        "source_entry_id": "78f216cb-443f-37d4-b8e1-164d9127de60",
                        "source_sense_id": "d9848ee8-813f-39fd-a77e-6830ab2dc4e7",
                        "source_sense_description": "spar projecting over the prow of a sailing vessel",
                        "target_lang_word": "Bugspriet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bugspriet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f59ed8f-db13-328b-8d2c-c0ef9beb3286",
                                        "entry_id": "61415336-f674-35d9-b830-77e27edaef93",
                                        "glosses": [
                                            "über den Bug hinausragende Segelstange"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c73cbbc-0fed-4498-a56b-e1a70bae6db1",
                                                "sense_id": "4f59ed8f-db13-328b-8d2c-c0ef9beb3286",
                                                "text": "Am Bugspriet stehen viele Personen."
                                            },
                                            {
                                                "example_id": "bf54e3a4-b85c-4cc5-b8c7-333d8e7c241f",
                                                "sense_id": "4f59ed8f-db13-328b-8d2c-c0ef9beb3286",
                                                "text": "„An zwischen Fock- und Großmast gespannten Leinen und an den Seilen, die den Fockmast mit dem stummelartigen Bugspriet verbanden, hingen Kleider zum Trocknen.“"
                                            },
                                            {
                                                "example_id": "29e71d0e-3ae7-4921-9ebd-2ace098ad671",
                                                "sense_id": "4f59ed8f-db13-328b-8d2c-c0ef9beb3286",
                                                "text": "„Im selben Moment fiel aus Richtung Bugspriet ein Schuß.“"
                                            },
                                            {
                                                "example_id": "33c41c9d-5c92-493d-b1a3-d4e6e4c8d2f6",
                                                "sense_id": "4f59ed8f-db13-328b-8d2c-c0ef9beb3286",
                                                "text": "„Vorgestern hockten die Offiziere und Arbeiter an den Davits der Rettungsboote, gestern am Bugspriet, heute morgen wurden die Sirenen ausprobiert.“"
                                            },
                                            {
                                                "example_id": "404d7f0e-d7b6-4bf5-8b48-9d9a16504996",
                                                "sense_id": "4f59ed8f-db13-328b-8d2c-c0ef9beb3286",
                                                "text": "„Am Bugspriet standen die Kapitäne und strichen sich besorgt die Bärte, denn die Jahreszeit der Meeresstürme stand bevor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
