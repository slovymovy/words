                                        "glosses": [
                                            "The language spoken by these people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20edf02d-4ff0-446e-bab4-4a9cbccb645f",
                                                "sense_id": "14a82d6e-6d0e-374d-8e5c-955dad4d8202",
                                                "text": "If the idea of “exotic” and complex languages with features you’ve never imagined thrills you, I guarantee you’ll get more out of studying Navajo, American Sign Language, Kikuyu, Vietnamese, Cree, Cantonese, Quechua, or Nuuchahnnulth than Quenya, Klingon, or attempting to make your own."
                                            }
                                        ]
