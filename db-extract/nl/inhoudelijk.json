                "senses": [
                    {
                        "sense_id": "216585e8-cf4d-3792-b078-822157c3859f",
                        "entry_id": "73036657-7bef-3a0f-8477-367133ff5693",
                        "glosses": [
                            "meer de inhoud betreffende dan de vorm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38c99c91-3d38-4100-bd05-ec8a4a42bb5a",
                                "sense_id": "216585e8-cf4d-3792-b078-822157c3859f",
                                "text": "Hij gaf niet om allerlei formele regels, het ging hem om de inhoudelijke kant van de zaak"
                            },
                            {
                                "example_id": "64ba4625-ad4f-463a-8151-edd561cfbd21",
                                "sense_id": "216585e8-cf4d-3792-b078-822157c3859f",
                                "text": "Ook inhoudelijk verschilden ze: Van Mierlo vond dat de ideologieën hun tijd hadden gehad, Terlouw meende dat D66 bestaansrecht had als sociaalliberale partij."
                            },
                            {
                                "example_id": "656723aa-5846-404c-93e7-9f56a8a69887",
                                "sense_id": "216585e8-cf4d-3792-b078-822157c3859f",
                                "text": "De fabrikant van het kunsthart heeft bij de Inspectie Gezondheidszorg en Jeugd een melding gemaakt van het overlijden van de patiënt, zo bevestigt de inspectie na berichtgeving van het EO-programma Dit is de Kwestie. De ontwikkelaar van het kunsthart is het Franse biomedische bedrijf Carmat. Het gaat om een verplichte melding, aldus de inspectie. Over de inhoudelijke behandeling wil een woordvoerder niets zeggen."
                            }
                        ]
                    }
