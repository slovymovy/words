                        "glosses": [
                            "iemand die uit het gewone dagelijkse leven wil ontsnappen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a424ca91-119f-4353-ae01-adb4cf98c9ee",
                                "sense_id": "6251c7da-ffe3-3a7c-accd-b77fe3a951d9",
                                "text": "'Ik zie de man die ik niet wil zijn: een vluchter, een escapist, een gewonde ziel die weg, weg, weg wil. Weg van de dagelijkse realiteit, weg van de politiek. Ik vlucht naar andere taalgebieden, ik verschuil me in zeven talen, omdat ik niet weet wat ik eigenlijk te zeggen heb."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d0ca2c8-e493-3520-9a95-ccae2343b831",
                        "entry_id": "bf66839c-9dd3-39c8-a8a5-99719e255f28",
                        "glosses": [
                            "iemand die uit een afgesloten ruimte ontsnapt"
                        ],
                        "tags": [],
                        "examples": [
                            {
