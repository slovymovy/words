                "senses": [
                    {
                        "sense_id": "f437385a-04dc-398a-ab1b-d5f526967076",
                        "entry_id": "9c107948-e5a6-3c2c-af7a-4a4e01fb3cc5",
                        "glosses": [
                            "Personne, concept ou entité générant une évolution."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "33f9a763-b301-4bf8-9da5-82a253ddf146",
                                "sense_id": "f437385a-04dc-398a-ab1b-d5f526967076",
                                "text": "Ce sont les femmes qui ont été les motrices de toute cette révolte qui divise toute la cour, tout le royaume et toutes les familles."
                            }
                        ]
                    },
                    {
                        "sense_id": "37b4dcfd-b846-30bb-a913-af38e3e4ad68",
                        "entry_id": "9c107948-e5a6-3c2c-af7a-4a4e01fb3cc5",
                        "glosses": [
                            "Personne qui constitue la source de motivation principale d’un mouvement, d’une entreprise commune."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "76a29414-8f39-49db-a1b3-55cb57540adc",
                                "sense_id": "37b4dcfd-b846-30bb-a913-af38e3e4ad68",
                                "text": "J’ajoute, qu’en parlant d’une femme qui aurait doné le branle à une afaire, on pourrait et l’on devrait dire, qu’elle a été le moteur, et non pas la motrice de cette afaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b339444c-06a1-435a-bc71-2fe4f026733f",
                        "source_entry_id": "9c107948-e5a6-3c2c-af7a-4a4e01fb3cc5",
