                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beae9277-f273-4748-aad5-4ce2db9b2f77",
                                                "sense_id": "b099f9f8-3272-3550-8689-242fb7b523f1",
                                                "text": "As Western culture became increasingly mechanized in the 1600s, the female earth and virgin earth spirit were subdued by the machine."
                                            },
                                            {
                                                "example_id": "b76484fc-859c-48d1-93fb-232a797006da",
                                                "sense_id": "b099f9f8-3272-3550-8689-242fb7b523f1",
                                                "text": "He would be as happy with her as he would be with Jennie—almost—and he would have the satisfaction of knowing that this Western social and financial world held no more significant figure than himself."
                                            },
                                            {
                                                "example_id": "0d247567-9fa7-4c5e-bb82-e82f8a13db62",
                                                "sense_id": "b099f9f8-3272-3550-8689-242fb7b523f1",
                                                "text": "Born in Penglai, on the coast of Shandong, in 1888, Miss Pruitt grew up in an inland village where for many years hers was the only Western family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d63b7a41-f696-3705-a67c-da53a1153dbe",
                                        "entry_id": "4fed36f8-3013-33a3-8168-94095fc1c0b2",
                                        "glosses": [
                                            "Of, situated in, or related to the West.",
                                            "Of or pertaining to a certain genre of fiction dealing with the American Old West."
