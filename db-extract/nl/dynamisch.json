                    },
                    {
                        "sense_id": "9f3b57c3-c2b8-3590-8779-5ab706d355ae",
                        "entry_id": "6ca37996-2dfc-34a7-88aa-5d113171445a",
                        "glosses": [
                            "de dynamiek betreffend"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2e2b8e3f-73f4-3dae-9796-05048dbef416",
                        "entry_id": "6ca37996-2dfc-34a7-88aa-5d113171445a",
                        "glosses": [
                            "waarin (innerlijke) beweging of bewogenheid overheerst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e440779-b4c4-4d79-a3e9-1fa067471d65",
                                "sense_id": "2e2b8e3f-73f4-3dae-9796-05048dbef416",
                                "text": "Amsterdam is een heel dynamische stad terwijl het leven in Almelo een stuk statischer is."
                            },
                            {
                                "example_id": "7506bb38-cd64-4cde-819c-cc424d810638",
                                "sense_id": "2e2b8e3f-73f4-3dae-9796-05048dbef416",
                                "text": "Everts woonde begin dit jaar nog in Tokio waar ze meehielp aan de watervoorzieningen rondom alle Olympische locaties. Een avontuurlijke baan in een dynamische stad die geen uit-knop lijkt te hebben."
                            }
                        ]
                    },
                    {
                        "sense_id": "d72c6de5-c69a-3829-b0c0-962a2acffc3b",
                        "entry_id": "6ca37996-2dfc-34a7-88aa-5d113171445a",
                        "glosses": [
                            "met de mogelijkheid zich aan omstandigheden aan te passen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7d781d3-e474-47ef-a65a-3fd0cb8e0e65",
                                "sense_id": "d72c6de5-c69a-3829-b0c0-962a2acffc3b",
                                "text": "Dynamische verlichting is verlichting waarmee je kleur, helderheid en kleurtemperatuur goed kunt regelen."
                            },
                            {
                                "example_id": "a548d9c5-dfac-4a97-9efb-bbbbf7acd569",
                                "sense_id": "d72c6de5-c69a-3829-b0c0-962a2acffc3b",
                                "text": "Morgan heeft haar status voornamelijk te danken aan haar killersinstinct. \"Ze is een dynamische speelster met een combinatie van snelheid, creativiteit en het vermogen om altijd haar kansen te benutten\", zegt Goff. \"Ze is een echte doelpuntenmaker en daar houden de mensen van.\""
                            }
                        ]
                    }
                ],
                "translations": [
