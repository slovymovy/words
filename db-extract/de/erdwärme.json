                "senses": [
                    {
                        "sense_id": "3e02544f-ebbe-3565-a90e-6b8dd090b060",
                        "entry_id": "ce547481-e6f1-333a-baed-fdfcfc8a3116",
                        "glosses": [
                            "die Wärme, die im zugänglichen Teil der Erdkruste gespeichert ist"
                        ],
                        "tags": [
                            "Umwelttechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "3bca6814-a10e-4cd5-a3d0-a6d66ea1959b",
                                "sense_id": "3e02544f-ebbe-3565-a90e-6b8dd090b060",
                                "text": "Schweiß rinnt ihm über die Wangen. Das ist die Erdwärme, schließlich ist man hier 750 Meter unter Tage."
                            },
                            {
                                "example_id": "1bfa3f71-05a6-4faa-b432-c4e3a5059d89",
                                "sense_id": "3e02544f-ebbe-3565-a90e-6b8dd090b060",
                                "text": "Durch die Untersuchungen zur kommerziellen Nutzung von Erdwärme waren in den vergangenen vier Wochen bereits drei weitere Beben mit Magnituden zwischen 2,5 und 3,4 ausgelöst worden."
                            },
                            {
                                "example_id": "3007fe00-2490-4a98-84ed-35b056902f84",
                                "sense_id": "3e02544f-ebbe-3565-a90e-6b8dd090b060",
                                "text": "Unsere Nachbarn wollen ein Niedrigenergiehaus bauen und auch Erdwärme für die Warmwasserbereitung nutzen."
                            },
                            {
                                "example_id": "12c4bcd1-0e95-4884-b4c3-529f9b863586",
                                "sense_id": "3e02544f-ebbe-3565-a90e-6b8dd090b060",
                                "text": "[…] „Wer mit Erdwärme heizt, braucht zwar Strom, muss aber keine Brennstoffe wie Gas oder Öl kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
