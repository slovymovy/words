                "senses": [
                    {
                        "sense_id": "16a5efbc-066d-3deb-9539-4fac51a90c05",
                        "entry_id": "e1cddce6-7b7c-310e-bafa-19f47ae1b2a7",
                        "glosses": [
                            "Bedienelement/Knopf, mit dem am Radio Sender eingestellt werden können"
                        ],
                        "tags": [
                            "Radio"
                        ],
                        "examples": [
                            {
                                "example_id": "6ff5c37a-63c3-4d5f-b9fc-1b2a871ec183",
                                "sense_id": "16a5efbc-066d-3deb-9539-4fac51a90c05",
                                "text": "„Er drehte am Suchknopf des Radios, was meine Schultern wieder nach oben wandern ließ.“"
                            },
                            {
                                "example_id": "66c7d1b1-c8f4-4420-a434-5f9baf9e5bad",
                                "sense_id": "16a5efbc-066d-3deb-9539-4fac51a90c05",
                                "text": "„Die knisterten vielversprechend wie das Radio, wenn man dessen Suchknopf auf \"Hilversum\" drehte.“"
                            },
                            {
                                "example_id": "a79a6687-70d0-4269-8b1a-ea54a9254d79",
                                "sense_id": "16a5efbc-066d-3deb-9539-4fac51a90c05",
                                "text": "„Sender findet das Radio beim Einschalten automatisch, trotzdem gibt es einen Suchknopf für die manuelle Bedienung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
