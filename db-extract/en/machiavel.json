                        "tags": [],
                        "examples": [
                            {
                                "example_id": "431ae7a5-37d7-49e4-a31f-20885ecdf870",
                                "sense_id": "abdbc300-84e3-3620-a912-5374f4724455",
                                "text": "The distinction is between the anonymous Continental Op of the detective novel, the man of honour who must nevertheless walk down mean streets, and the thoroughgoing Machiavel, the man who has learned not to be good."
                            },
                            {
                                "example_id": "26630767-dc43-42ec-8a59-743b879075ac",
                                "sense_id": "abdbc300-84e3-3620-a912-5374f4724455",
                                "text": "In pursuit of these ends, agents will find themselves in conflict with morality and we want them to be the sorts of people who can reject morality, yet we don’t want them to be Machiavels in the worst sense."
                            }
                        ]
                    }
