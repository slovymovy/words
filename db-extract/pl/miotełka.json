                                        "glosses": [
                                            "уменьш. к метла; хозяйственное приспособление в виде связки прутьев, перьев и т. п. на длинной ручке, используемое для подметания"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8393e5e-e754-3c81-85aa-f74515b594e6",
                                        "entry_id": "6ec736b5-af32-38d2-b806-3f3533fccf4b",
                                        "glosses": [
                                            "ботан. соцветие некоторых растений, напоминающее формой метлу, метёлку [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be54beb5-9ce9-4243-b173-9d359b105383",
                                                "sense_id": "c8393e5e-e754-3c81-85aa-f74515b594e6",
                                                "text": "У обыкновенного проса соцветие метелка, колоски двухцветковые однозерные."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ce417dc-a186-3e04-810d-f6ad514baf69",
                                        "entry_id": "6ec736b5-af32-38d2-b806-3f3533fccf4b",
                                        "glosses": [
                                            "жарг., пренебр. женщина, девушка"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0fbef33-0b7c-4c92-b9cd-21970df2f481",
                        "source_entry_id": "9a37ef4c-2b62-3bfc-82c2-29651e02bd48",
                        "source_sense_id": "8babfc83-f455-379a-8942-53c508c90831",
                        "target_lang_word": "ве́ник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ве́ник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1fc33a12-6c66-3f43-9ac8-54d402ea81d4",
                                        "entry_id": "e3ff9f87-4f9f-3e8e-97c0-b518d3778204",
                                        "glosses": [
                                            "связка прутьев или веток с листьями, используемая для подметания пола, либо для па́рения бане"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98ee8b4a-7452-4e69-bc7a-3454b507b5bb",
                                                "sense_id": "1fc33a12-6c66-3f43-9ac8-54d402ea81d4",
                                                "text": "Да смотри ты, ты не входи, брат, в кладовую, не то я тебя, знаешь! березовым-то веником; чтобы для вкуса-то!"
                                            },
                                            {
                                                "example_id": "5b19f0c8-932b-44b1-bc54-c858e623ae92",
                                                "sense_id": "1fc33a12-6c66-3f43-9ac8-54d402ea81d4",
                                                "text": "Затем пары отправлялись в предбанник, по дороге покупая веник и мочалку, потому что ни того, ни другого казна не давала ученикам."
                                            },
                                            {
                                                "example_id": "94417b59-44c8-4914-95de-5e4a953675eb",
                                                "sense_id": "1fc33a12-6c66-3f43-9ac8-54d402ea81d4",
                                                "text": "Веников пятьдесят на полке подымалось и опускалось разом; все хлестались до опьянения."
                                            },
                                            {
                                                "example_id": "43be694f-9bc1-4c88-b987-df5efd77ede2",
                                                "sense_id": "1fc33a12-6c66-3f43-9ac8-54d402ea81d4",
                                                "text": "Перед нею на гвоздике висел форменный вицмундир, а в руках она держала тонкий широкий веник из зелёного клоповника."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76437312-1424-3aef-a19f-ae442458a016",
                                        "entry_id": "e3ff9f87-4f9f-3e8e-97c0-b518d3778204",
                                        "glosses": [
                                            "перен. разг. плохо составленный, некрасивый букет цветов"
                                        ],
                                        "tags": [],
                                        "examples": []
