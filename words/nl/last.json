                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>last</w> een korte pauze in om even uit te rusten.",
                            "target_lang_translations": {
                                "en": "I am <w>scheduling</w> a short break to rest for a moment.",
                                "ru": "Я <w>делаю</w> небольшой перерыв, чтобы немного отдохнуть.",
                                "pl": "Robię sobie krótką <w>przerwę</w>, żeby chwilę odpocząć."
                            }
                        },
                        {
                            "text": "<w>Last</w> onmiddellijk een vergadering in om dit probleem te bespreken!",
                            "target_lang_translations": {
                                "en": "<w>Call</w> a meeting immediately to discuss this problem!",
                                "ru": "Немедленно <w>назначьте</w> собрание, чтобы обсудить эту проблему!",
                                "pl": "Natychmiast <w>zwołaj</w> spotkanie, żeby omówić ten problem!"
                            }
                        }
                    ],
                    "common_phrases": [
