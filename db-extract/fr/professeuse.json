                                "target_senses": [
                                    {
                                        "sense_id": "d0b57a77-fa24-3377-8438-7f18719ac2c1",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "The most senior rank for an academic at a university or similar institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80ea57fb-d3a8-41b4-b595-e1014c6ea998",
                                                "sense_id": "d0b57a77-fa24-3377-8438-7f18719ac2c1",
                                                "text": "Professor is what you become after teaching for twenty to thirty years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0648a193-f236-3033-a788-4dcaf0ee3e7d",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "A teacher or faculty member at a college or university regardless of formal rank."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc655b59-1612-30c2-8e44-4bb5ee3ea640",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "One who professes something, such as a religious doctrine."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea142e1e-4d80-4c01-9aa9-f3933ce438cb",
                                                "sense_id": "dc655b59-1612-30c2-8e44-4bb5ee3ea640",
                                                "text": "As for Religion, I have not said, much lesse meant irreverently of it, or of the Professors thereof."
                                            },
                                            {
                                                "example_id": "e57c59e7-843b-450b-a3df-4c1e37e6776e",
                                                "sense_id": "dc655b59-1612-30c2-8e44-4bb5ee3ea640",
                                                "text": "This period in which Abraham the Jew lived was one in which Magic was almost universally believed in, and in which its Professors were held in honour;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f62efaa3-0e29-3770-bf4d-5efed6e7d063",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "A practitioner, one who (publicly) practises or teaches an art or skill."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c450cb3-7bd8-4d6e-a247-9a1397da5f17",
                                                "sense_id": "f62efaa3-0e29-3770-bf4d-5efed6e7d063",
                                                "text": "Two young men of familiar acquaintance … were one euening at a common Inne of this town (as I haue heard) where the one of them shewed his skill on the Virginals, to the no little contentement of the hearers. Nowe as diuers guests of the house came into the room to listen, so among the rest entered an artificiall Conny-catcher, who as occasion serued, in the time of ceissing betweene the seueral toyes and fancies hee plaid: very much commended his cunning, quicke hand, and such qualities praiseworthy in such a professour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb9026d2-0d41-3d55-ac18-8dde6b60ffd1",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "A pianist in a saloon, brothel, etc."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42855727-aa29-4c32-a189-b66a89488d47",
                                                "sense_id": "cb9026d2-0d41-3d55-ac18-8dde6b60ffd1",
                                                "text": "You could hear [...] pianos under the hands of whorehouse professors sounding like they came with keys between the keys."
                                            }
                                        ]
                                    },
