                    {
                        "form_id": "9b6fff7d-8c4a-4335-8995-16335d283572",
                        "entry_id": "eaf3df73-b17e-36f8-8e59-d2a85d1a9c78",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "étésiennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a073cc77-fb06-3e0d-a6b5-677204334f23",
                        "entry_id": "eaf3df73-b17e-36f8-8e59-d2a85d1a9c78",
                        "glosses": [
                            "Qualifie le vent qui souffle du Nord en Méditerranée orientale l’été."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b15bfe0-0fb9-4b21-8ebc-06f5afceba9e",
                                "sense_id": "a073cc77-fb06-3e0d-a6b5-677204334f23",
                                "text": "Les vents étésiens, bien connus des navigateurs hellènes qui les utilisaient dès l’Antiquité pour aller commodément en Égypte …"
                            },
                            {
                                "example_id": "27678a26-4c73-42a1-ba3d-28f67945e81f",
                                "sense_id": "a073cc77-fb06-3e0d-a6b5-677204334f23",
                                "text": "On était dans la saison où les vents étésiens favorisent la navigation du fleuve ; il est facile alors de remonter en peu de temps jusqu’à l’île d’Éléphantine : on résolut de se porter successivement dans tous les lieux où les monumens sont situés, afin de reconnaître d’abord les objets que l’on aurait à décrire, et d’établir, au moyen de cette première énumération, un ordre plus exact dans les recherches."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbed3d97-67e4-3490-83b7-65c00046e106",
                        "entry_id": "eaf3df73-b17e-36f8-8e59-d2a85d1a9c78",
                        "glosses": [
                            "Qualifie un vent qui souffle du Nord l’été."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b981fa5d-5dc9-483f-aa92-a3dfcb057e75",
                                "sense_id": "bbed3d97-67e4-3490-83b7-65c00046e106",
                                "text": "Elle était présentement à quai dans le canal Saint-Jean, et elle appareillait le 28 juillet, mais à huit heures du soir pour profiter des vents étésiens qui descendent régulièrement du Rhône au coucher du soleil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90eaf3eb-5e96-4b65-9884-15005ce5c28b",
                        "source_entry_id": "eaf3df73-b17e-36f8-8e59-d2a85d1a9c78",
                        "target_lang_word": "etesian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "etesian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f81397cf-d542-3ff9-b044-ef055252df96",
                                        "entry_id": "c79653d2-8a6e-32c6-ae87-48dec98ca95f",
                                        "glosses": [
                                            "Pertaining to a dry north wind which blows in the eastern Mediterranean."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a6f1331-3e4c-4e00-9d4b-9e907414fe6b",
                                                "sense_id": "f81397cf-d542-3ff9-b044-ef055252df96",
                                                "text": "Is it from those etesian winds, or melting of snow in the mountains under the Equator […], or from those great dropping perpetual showers […]?"
                                            },
                                            {
                                                "example_id": "67bfb1c7-a3ea-42e2-bf5e-c7f0095cfe27",
                                                "sense_id": "f81397cf-d542-3ff9-b044-ef055252df96",
                                                "text": "[…] Dixon, assailed without mercy by his Sensorium, almost in a swoon, finds himself, on Nights of Cloud, less and less able to forgo emerging at dusk, cloaked against the Etesian wind, and making directly for the prohibited parts of town."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "etesian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "584001ff-5af2-3087-bdb0-f6ab30a8b70f",
                                        "entry_id": "41bec8b0-32b7-36ba-a4a3-f9fb21634951",
                                        "glosses": [
                                            "A dry north wind which blows in the eastern Mediterranean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efda4b24-a73a-41ca-9c71-5fc5a01f0e48",
                                                "sense_id": "584001ff-5af2-3087-bdb0-f6ab30a8b70f",
                                                "text": "[...] I have in England for ſome years paſt, kept by me an exact table, or Ephemeris both of the Vernall, and Summer Eteſians; but found the VVinds no leſſe Variable in thoſe Months, then at other Seaſons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d20fcbdb-bd50-4751-a819-f910ef782f8d",
                        "source_entry_id": "eaf3df73-b17e-36f8-8e59-d2a85d1a9c78",
