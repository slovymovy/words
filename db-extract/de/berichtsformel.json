                "senses": [
                    {
                        "sense_id": "d0505144-9d33-3f69-9ad5-a69760bd3e30",
                        "entry_id": "fe17c53a-3ff2-32a9-9358-c8fb02d730f4",
                        "glosses": [
                            "reportative formulation (a set phrase which is used to report something (i.e. tell of something which the speaker did not experience firsthand), e.g. a story, a quotation, etc.)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "17c95fc5-e8f7-41f4-8744-6a0c08e1f855",
                                "sense_id": "d0505144-9d33-3f69-9ad5-a69760bd3e30",
                                "text": "Die hiſtoriſche Berichtsformel: ἐὰν εἴπῃ ὁ ποὺς, wenn der Fus ſpraͤche.",
                                "translation": "The historical reporting formula: ἐὰν εἴπῃ ὁ ποὺς, when the foot would speak.",
                                "english": "The historical reporting formula: ἐὰν εἴπῃ ὁ ποὺς, when the foot would speak."
                            },
                            {
                                "example_id": "3aeb19d5-f4cb-4f38-9211-565888018114",
                                "sense_id": "d0505144-9d33-3f69-9ad5-a69760bd3e30",
                                "text": "Es folgen die Verse von den Schwestern Phaethons, Verse, bei denen, wie bereits bemerkt, jedwede Berichtsformel fehlt.",
                                "translation": "This is followed by the verses about Phaethon's sisters, verses which, as already noted, lack any reporting formula.",
                                "english": "This is followed by the verses about Phaethon's sisters, verses which, as already noted, lack any reporting formula."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6d8f9eb-fd91-3178-8f5a-fc705ae3d26b",
                        "entry_id": "fe17c53a-3ff2-32a9-9358-c8fb02d730f4",
                        "glosses": [
                            "report formula (a set phrase used in official documents)"
                        ],
                        "tags": [
                            "Switzerland",
                            "bureaucratese",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "1c6dec52-8465-4e9f-b719-ba601d81e49d",
                                "sense_id": "a6d8f9eb-fd91-3178-8f5a-fc705ae3d26b",
                                "text": "Als Probe von den Ihnen lezthin angekündigten altteutschen Denkmählern schicke ich Ihnen eine Berichtsformel aus dem XIten Iahrhunderte mit der Uebersetzung und den Anmerkungen eines ungenannten Benediktbeurischen Religiosen.",
                                "translation": "As a sample of the old German monuments which you recently announced, I am sending you a reporting formula from the XIth century with the translation and comments of an unnamed Benedictine monk.",
                                "english": "As a sample of the old German monuments which you recently announced, I am sending you a reporting formula from the XIth century with the translation and comments of an unnamed Benedictine monk."
                            },
                            {
                                "example_id": "f3cdc1f0-7cff-4348-899a-6cca529c4336",
                                "sense_id": "a6d8f9eb-fd91-3178-8f5a-fc705ae3d26b",
                                "text": "Nach Erledigung noch schwebender Nebenverhandlungen, wird es wohl gestattet sein, nähere Details zu veröffentlichen, vorläufig bedienen wir uns der Berichtsformel der Neuen freien Presse: In jüngster Zeit wurde, wie uns von betheiligter Seite berichtet wird, in Paris ein Uebereinkommen mit dortigen Capitalisten getroffen, welches die Umgestaltung der Axienda Assicuratrice auf neuer Basis und eien wesentliche Erhöhung ihrer financiellen Garantien sichert.",
                                "translation": "Once the pending side negotiations have been completed, it will probably be permissible to publish further details. For the time being, we are using the reporting formula of the Neue freie Presse: According to reports from parties involved, an agreement was recently reached in Paris with local capitalists, which will ensure the restructuring of Axienda Assicuratrice on a new basis and a significant increase in its financial guarantees.",
                                "english": "Once the pending side negotiations have been completed, it will probably be permissible to publish further details. For the time being, we are using the reporting formula of the Neue freie Presse: According to reports from parties involved, an agreement was recently reached in Paris with local capitalists, which will ensure the restructuring of Axienda Assicuratrice on a new basis and a significant increase in its financial guarantees."
                            },
                            {
                                "example_id": "55adb9c8-b246-4f8b-b27c-459f578ea766",
                                "sense_id": "a6d8f9eb-fd91-3178-8f5a-fc705ae3d26b",
                                "text": "34 derselben bedienen sich kurz und trocken ungefähr der Berichtsformel: „Wir machen Ihnen die Mittheilung, die unter die Kategorie der Verwahrlosten gezählt werden dürfen[“].",
                                "translation": "34 of them briefly and dryly use approximately the following reporting formula: “We are informing you of something that may be classified as neglected.”",
                                "english": "34 of them briefly and dryly use approximately the following reporting formula: “We are informing you of something that may be classified as neglected.”"
                            },
                            {
                                "example_id": "1c3fcd39-acf3-44e7-bb29-bb6a39558bd1",
                                "sense_id": "a6d8f9eb-fd91-3178-8f5a-fc705ae3d26b",
                                "text": "Ebenſo iſt es abzulehnen, den Gewinn zu Abſchreibungen zu verwenden, obwohl es gar keine ſo ſeltene Berichtsformel der beſchließenden Jahresverſammlung iſt.",
                                "translation": "It is also unacceptable to use profits for depreciation, even though this is not an uncommon reporting formula at the annual general meeting.",
                                "english": "It is also unacceptable to use profits for depreciation, even though this is not an uncommon reporting formula at the annual general meeting."
                            }
                        ]
                    }
