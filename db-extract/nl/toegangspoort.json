                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4783d913-afb4-4bb6-b123-4c13da253c27",
                                "sense_id": "3c18870f-b57d-35dd-a326-7c1a6cf7c0ec",
                                "text": "De toegangspoort van het kasteel werd streng bewaakt."
                            },
                            {
                                "example_id": "b2d00c8c-0ab1-4fc7-a86e-096caf72d0e5",
                                "sense_id": "3c18870f-b57d-35dd-a326-7c1a6cf7c0ec",
                                "text": "Nederland wil de 'toegangspoort' worden voor Amerikaans defensiematerieel dat naar Europese landen vervoerd moet worden."
                            },
                            {
                                "example_id": "2cd3ca82-f262-47f5-8365-93978752fb9d",
                                "sense_id": "3c18870f-b57d-35dd-a326-7c1a6cf7c0ec",
                                "text": "Fort Meade ligt vlak bij een grote snelweg in Washington en volgens Amerikaanse media nemen automobilisten af en toe per ongeluk de afslag die naar de toegangspoort leidt."
                            }
                        ]
                    }
