                                    {
                                        "sense_id": "45226d41-6ffe-3c2b-b050-393a9af58e72",
                                        "entry_id": "9b092492-2ab6-3965-ac8a-e75ec1b33993",
                                        "glosses": [
                                            "jemand, der Dateien ins Internet hochlädt"
