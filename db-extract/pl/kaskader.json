                    {
                        "sense_id": "857dfdd8-20df-3fd9-aec8-7de21f905f8c",
                        "entry_id": "ddb841b6-33b7-3c29-93d8-60828a8c6eb0",
                        "glosses": [
                            "osoba zastępująca aktora w ryzykownych albo technicznie wymagających scenach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48eb83f2-2f7b-4c44-9432-5feb2a2c11e5",
                                "sense_id": "857dfdd8-20df-3fd9-aec8-7de21f905f8c",
                                "text": "Do kręcenia scen niebezpiecznych, reżyser musiał uciec się do pomocy kaskadera."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
