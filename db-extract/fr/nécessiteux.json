                        "form": "nécessiteuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30c1f6b5-15f5-3184-8b95-2b984eb29308",
                        "entry_id": "377bdbd9-0297-340c-ac56-e90c8aefa579",
                        "glosses": [
                            "Qui est dans l’indigence, dans le dénuement, qui est réduit à la nécessité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0934e3e-c98a-476d-a2bf-9aa8cdd00273",
                                "sense_id": "30c1f6b5-15f5-3184-8b95-2b984eb29308",
                                "text": "De riche, il est devenu nécessiteux."
                            },
                            {
                                "example_id": "f7a1eecc-c2c3-4152-95c1-e9fb3e859c82",
                                "sense_id": "30c1f6b5-15f5-3184-8b95-2b984eb29308",
                                "text": "Ce sont des gens nécessiteux."
                            },
                            {
                                "example_id": "5420002b-f0e9-406e-9619-c17a9558437e",
                                "sense_id": "30c1f6b5-15f5-3184-8b95-2b984eb29308",
                                "text": "— Tu as froid, reprit Olivier en se levant pour me quitter, tu as piétiné sous la pluie, tes habits mouillés transpirent les odieuses rigueurs de la vie nécessiteuse et de l’hiver, tu reviens tout imbibé de stoïcisme, de misère et d’orgueil : attendons à demain pour causer plus raisonnablement. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e22e7cdd-c8cd-4052-9b8a-94f9282ac257",
                        "source_entry_id": "377bdbd9-0297-340c-ac56-e90c8aefa579",
                        "source_sense_id": "30c1f6b5-15f5-3184-8b95-2b984eb29308",
                        "source_sense_description": "Qui est dans l’indigence",
                        "target_lang_word": "notleidend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notleidend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e284804-c2a5-3bbb-92bf-65a3faeabbf1",
                                        "entry_id": "a96b5966-6a72-3c2f-97f4-4cec16593976",
                                        "glosses": [
                                            "direkt an wirtschaftlicher Not leidend, direkt in wirtschaftlicher Not lebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d465631-03aa-41fd-87dc-77df00a21c80",
                                                "sense_id": "8e284804-c2a5-3bbb-92bf-65a3faeabbf1",
                                                "text": "„Was wir hinter uns zurücklassen, sind Tausende und Abertausende von Toten und Krüppeln, eine notleidende Bevölkerung, verwundet an Leib und Seele, ein verwüstetes Land, eine nahezu lahmgelegte Wirtschaft und Generationen mutloser Bürger, denen das Leben praktisch keine Aussichten bietet.“"
                                            },
                                            {
                                                "example_id": "6560c616-bc85-4e0e-b8b4-fc25a6446f56",
                                                "sense_id": "8e284804-c2a5-3bbb-92bf-65a3faeabbf1",
                                                "text": "„Jeder Bauauftrag brachte der notleidenden Bevölkerung Arbeit und damit Lohn und Brot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a0140a1c-74e6-3eaa-b4b8-1e2ce714a562",
                                        "entry_id": "a96b5966-6a72-3c2f-97f4-4cec16593976",
                                        "glosses": [
                                            "eine eingegangene wirtschaftliche Verpflichtung nicht erfüllen könnend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c9927af-827b-497d-bb24-7c072764a5e7",
                                                "sense_id": "a0140a1c-74e6-3eaa-b4b8-1e2ce714a562",
                                                "text": "„Als Ende 2008 die Hypo 900 Millionen an Steuergeld erhielt, lag dem eine Einstufung der Bank durch die Oesterreichische Nationalbank zu Grunde, welche die Ertragslage des Instituts als \"distresses\", also als \"nicht notleidend\" angab."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d26da0d-0455-443e-a87a-389272cd8288",
                        "source_entry_id": "377bdbd9-0297-340c-ac56-e90c8aefa579",
