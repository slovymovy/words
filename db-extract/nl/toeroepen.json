                        "examples": [
                            {
                                "example_id": "9ed1fcaf-4bbd-477a-8970-10799ca5e241",
                                "sense_id": "8705ce4c-bdbe-33e1-a559-bf2e652e6811",
                                "text": "Kom op zeg, wil ik haar toeroepen."
                            },
                            {
                                "example_id": "1f342f57-5892-4b05-adf3-cdce742e0436",
                                "sense_id": "8705ce4c-bdbe-33e1-a559-bf2e652e6811",
                                "text": "Je zou de betreffende auteur willen toeroepen dat hij of zij beter niet voor de spiegel gaat staan en zich zo te kijk zet. Je zou hem of haar in bescherming willen nemen. Doe dat niet. Dit moet je niet willen."
                            },
                            {
                                "example_id": "6ccbc22f-e70c-40d5-884f-c3fd597f833a",
                                "sense_id": "8705ce4c-bdbe-33e1-a559-bf2e652e6811",
                                "text": "Ik zie haar twijfelen en wil haar toeroepen: \"Meisje, ga weg. Eet een bakje vanillevla.\" Om er zachtjes aan toe te voegen: \"Vertrouw erop. Ooit krijg je een huis waar je hoort.\" Maar ik rijd weg. In de nacht ben ik onzichtbaar."
                            }
                        ]
                    }
