                ],
                "senses": [
                    {
                        "sense_id": "64fb8a67-c520-3365-838d-7a07df613619",
                        "entry_id": "9b944f82-d364-30e0-a1ee-6d19bbf41a29",
                        "glosses": [
                            "Ausschusswesen zur Unterstützung der Europäischen Kommission"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc8ba3b0-68a3-4349-b55f-e96db72483f9",
                                "sense_id": "64fb8a67-c520-3365-838d-7a07df613619",
                                "text": "Die Ursprünge der Komitologie gehen bis in die frühen 1960er Jahre zurück, als der erste Komitologieausschuss für den Agrarsektor gebildet wurde."
                            },
                            {
                                "example_id": "a29339db-7eae-48ee-87ac-3fc27ef9a5ff",
                                "sense_id": "64fb8a67-c520-3365-838d-7a07df613619",
                                "text": "Ferner enthält die neue Richtlinie Bestimmungen über ein neues interinstitutionelles Verfahren (Komitologie) gemäß dem Beschluß 1999/468/EG des Rates vom 28. Juni 1999, in dem eine Befragung des Europäischen Parlaments vorgesehen ist und dem Rat die Möglichkeit gegeben wird, Vorschläge der Kommission mit qualifizierter Mehrheit anzunehmen oder abzulehnen."
                            },
                            {
                                "example_id": "c5cff259-b2cb-40dc-86a2-6c9ff3beb5ff",
                                "sense_id": "64fb8a67-c520-3365-838d-7a07df613619",
                                "text": "Die Komitologie ist das beste Beispiel für die Verzerrung des Systems: Der Rat als Legislative verwandelt sich in die Exekutive, während das Parlament als Gesetzgeber von dieser Phase ausgeschlossen ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5aeb0e49-68d9-4f6c-9f38-cca4d325a868",
                        "source_entry_id": "9b944f82-d364-30e0-a1ee-6d19bbf41a29",
                        "source_sense_id": "64fb8a67-c520-3365-838d-7a07df613619",
                        "source_sense_description": "Ausschusswesen zur Unterstützung der Europäischen Kommission",
                        "target_lang_word": "comitology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comitology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f62486dd-7c38-35ff-ad21-e92cc37c97d2",
                                        "entry_id": "cb5e7757-6be2-3f84-b492-d1bbb2372840",
                                        "glosses": [
                                            "The system of committees, composed of representatives of the member states, used to oversee European Commission implementing acts made under European Union legislation."
                                        ],
                                        "tags": [
                                            "European-Union",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e2552a5-1e2e-35c4-9ce0-6524e19dad3a",
                                        "entry_id": "cb5e7757-6be2-3f84-b492-d1bbb2372840",
                                        "glosses": [
                                            "The study of how committees could work, expand, and ramify."
                                        ],
                                        "tags": [
                                            "countable",
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edf94f01-9f39-4815-a439-f32a1772a39c",
                        "source_entry_id": "9b944f82-d364-30e0-a1ee-6d19bbf41a29",
                        "source_sense_id": "64fb8a67-c520-3365-838d-7a07df613619",
                        "source_sense_description": "Ausschusswesen zur Unterstützung der Europäischen Kommission",
                        "target_lang_word": "comitologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comitologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a89b264-23ae-36d1-8d16-0f83fc26e601",
                                        "entry_id": "ad16cef4-f8a4-32aa-9dca-9e9764f19fc2",
                                        "glosses": [
                                            "Procédure de prise de décisions normatives européenne, par des comités (consultatif, de gestion ou réglementaires) encadrant l’exercice des compétences d’exécution conférées à la Commission européenne."
                                        ],
                                        "tags": [
                                            "European-Union"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51cb60a7-5ded-4017-9eca-926e2eaffde3",
                                                "sense_id": "1a89b264-23ae-36d1-8d16-0f83fc26e601",
                                                "text": "C’est pourquoi la comitologie est encadrée par une décision du Conseil du 13 juillet 1987, modifiée le 28 juin 1999."
                                            },
                                            {
                                                "example_id": "77c663bd-0b46-429b-9e23-b141a7557fcf",
                                                "sense_id": "1a89b264-23ae-36d1-8d16-0f83fc26e601",
                                                "text": "Le terme « comitologie » aurait été utilisé la première fois par C. Northcote Parkinson, la « science de la comitologie » étant pour lui l’étude des comités et de la façon dont ils fonctionnent. Toutefois, dans le contexte de l’Union européenne, la « comitologie » […] correspond aux procédures qui font intervenir des comités composés de représentants des États membres et présidés par la Commission, via lesquelles les États membres peuvent exercer un certain droit de regard sur les pouvoirs d’exécution délégués à la Commission par le Conseil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7db2a31b-46e2-3089-87d6-e20658536559",
                                        "entry_id": "ad16cef4-f8a4-32aa-9dca-9e9764f19fc2",
                                        "glosses": [
                                            "Organisation de réunions où seront prises des décisions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e673b9d-5cc2-42a7-87a9-2e5a5d9694f1",
                                                "sense_id": "7db2a31b-46e2-3089-87d6-e20658536559",
                                                "text": "Au niveau managérial, la comitologie consiste à organiser le centre décisionnel grâce à des comités thématiques. C'est une problématique nouvelle dans les sciences de gestion, qui étudient la façon dont la gouvernance politique et opérationnelle de l'entreprise agit et se coordonne sur un ensemble de sujets définis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
