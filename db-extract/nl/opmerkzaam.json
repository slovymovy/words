                ],
                "senses": [
                    {
                        "sense_id": "e24e5124-3ee3-32cf-b5e8-55478073b4df",
                        "entry_id": "aff21da3-086c-33d5-8f9a-1085ed5937ba",
                        "glosses": [
                            "erg goed naar de omgeving kijkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd1b477-f091-46cd-a747-f43a38fc8892",
                                "sense_id": "e24e5124-3ee3-32cf-b5e8-55478073b4df",
                                "text": "De opmerkzame fietser stapte meteen af om de gevallen vrouw te helpen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04c54bda-3b76-48a2-8d22-d1d8d4524965",
                        "source_entry_id": "aff21da3-086c-33d5-8f9a-1085ed5937ba",
                        "source_sense_id": "e24e5124-3ee3-32cf-b5e8-55478073b4df",
                        "target_lang_word": "aufmerksam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufmerksam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01d0b893-18af-3d9d-a9b7-c7c56de8e587",
                                        "entry_id": "71204950-f33c-3308-9886-2802ddbdfaaa",
                                        "glosses": [
                                            "(meist bewusst) genau wahrnehmend, betrachtend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af51a162-cbd0-4940-81f0-44815402b1cb",
                                                "sense_id": "01d0b893-18af-3d9d-a9b7-c7c56de8e587",
                                                "text": "Asami hört aufmerksam zu."
                                            },
                                            {
                                                "example_id": "c5c95642-3cb6-4ef2-b26c-57dfa64f88ab",
                                                "sense_id": "01d0b893-18af-3d9d-a9b7-c7c56de8e587",
                                                "text": "„John Hammond, stets ein aufmerksamer Beobachter der Ereignisse seiner Zeit, erkennt sehr bald, welche Umwälzungen Homer Capeharts Erfindung der Jukebox für die Phono-Industrie bringen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                        "entry_id": "71204950-f33c-3308-9886-2802ddbdfaaa",
                                        "glosses": [
                                            "jemanden auf etwas/jemanden hinweisen, jemandem etwas/jemanden zeigen oder mitteilen, sodass die Person es bemerkt und darauf achtet, jemandes Interesse auf etwas/jemanden lenken"
                                        ],
                                        "tags": [
                                            "jemanden auf etwas/jemanden aufmerksam machen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1da99b8-8d4e-4989-be33-0de60d8000a5",
                                                "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                                "text": "»Ich möchte dich auf einen Fehler im Bericht aufmerksam machen.«"
                                            },
                                            {
                                                "example_id": "334a86dd-bddd-4d4c-bc15-6f3d6ae3d1c5",
                                                "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                                "text": "Im Radio gibt es eine Sendung, in der man auf spanndende Krimis aufmerksam gemacht wird."
                                            },
                                            {
                                                "example_id": "eb991b3e-626d-49c4-8f90-f3acc15346af",
                                                "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                                "text": "„Rezensionen erschienen u. a. in der Süddeutschen Zeitung und der Frankfurter Rundschau, aber auch türkischsprachige Medien machten auf das Buch aufmerksam.“"
                                            },
                                            {
                                                "example_id": "51fe9f57-d424-4ba2-9215-523eb7bf69dd",
                                                "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                                "text": "„In großen Flugblatt-Verteilaktionen machten die Zeugen Jehovas 1936/37 auf ihre Unterdrückung in Deutschland aufmerksam.“"
                                            },
                                            {
                                                "example_id": "9e7b93e4-48ae-4c57-a814-ab18678c62f0",
                                                "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                                "text": "„Dokumentationen, Reportagen, Magazinbeiträge und ein investigativer Fernsehfilm machten auf die Grundwasserknappheit in Deutschland aufmerksam.“"
                                            },
                                            {
                                                "example_id": "7bee2a4a-994a-4621-8461-8fb3f05c08cb",
                                                "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                                "text": "„Den Überlebenden war es wichtig, auf die systematische Vergewaltigung von Frauen, Mädchen und Jungen während des Völkermords aufmerksam zu machen.“"
                                            },
                                            {
                                                "example_id": "1aee77e2-ba0e-4fa7-a886-bdab75e23649",
                                                "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                                "text": "„Die Plakate machten auf das Ende der Ausstellung \"Miriams Tagebuch. Die Geschichte der Familie Feiner\" im Erinnerungsort \"Topf & Söhne\" am 12. Januar 2025 aufmerksam.“"
                                            },
                                            {
                                                "example_id": "a05bc475-e0ff-4c95-b6ba-2fecf2e79a75",
                                                "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                                "text": "„Ob eingeritzt oder wie kleine Graffiti gemalt: Sogenannte Gaunerzinken wurden jahrhundertelang von \"fahrendem Volk\" genutzt […]. Bettler, Diebinnen, Sinti und Romnja tauschten sich aus, warnten einander vor bissigen Hunden oder machten auf leichte Beute aufmerksam.“"
                                            },
                                            {
                                                "example_id": "54f99db4-e79f-4073-9107-486871287bc6",
                                                "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                                "text": "[Weltfrauentag:] „Die Demonstrantinnen, mehrheitlich Frauen, machten auf den internationalen Kampf aufmerksam, unter anderem denjenigen der Kurdinnen und den der Frauen im Iran.“"
                                            },
                                            {
                                                "example_id": "1315e9ad-6fa9-4542-a747-25cb4ab3ad79",
                                                "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                                "text": "„Kundgebung in Bern - Tausende demonstrieren für zugängliche Psychotherapie – [… – Rund 5000 Demonstranten] machten auf lange Wartefristen, fehlende Therapieplätze und die unsichere Tarifstruktur aufmerksam.“"
                                            },
                                            {
                                                "example_id": "258a5a92-bee1-4060-9b6b-a826cf1caba9",
                                                "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                                "text": "„Die Demonstrierenden machten auf ihrer Kundgebung auf mangelhafte Sicherheitsstandards und fehlende Konsequenzen aufmerksam.“"
                                            },
                                            {
                                                "example_id": "d137575d-49d9-457b-8be7-e3854a76f58e",
                                                "sense_id": "a6ff9da7-b916-37fe-ad78-84f820d5b3a9",
                                                "text": "„Die Demonstranten forderten unter den Überschriften \"Climate Justice\" und \"Unite Against Climate Failure\" das Ende der Investitionen in fossile Brennstoffe und machten auf den Klimawandel aufmerksam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "30cb46ea-fee9-3d56-a337-fc037c7100a2",
                                        "entry_id": "71204950-f33c-3308-9886-2802ddbdfaaa",
                                        "glosses": [
                                            "anderen Personen freundlich/hilfreich entgegenkommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca3bf02f-60d1-448d-b13e-061a7b216302",
                                                "sense_id": "30cb46ea-fee9-3d56-a337-fc037c7100a2",
                                                "text": "Das war aber sehr aufmerksam von dir."
                                            },
                                            {
                                                "example_id": "2dc119cd-a507-4e30-b39b-6a4734e20867",
                                                "sense_id": "30cb46ea-fee9-3d56-a337-fc037c7100a2",
                                                "text": "Ihr werdet ihn mögen; er ist ein sehr aufmerksamer, liebenswerter junger Mensch."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd03328e-b2c2-4730-a92e-5e77c87577fa",
