                        "entry_id": "46d0b66f-3ddc-367f-9a24-57acae2bc830",
                        "glosses": [
                            "Any atom, group, or radical substituted for another, or entering a molecule in place of some other part which is removed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbbfdc94-4f2e-4b96-b401-ee6e11ccd7f5",
                                "sense_id": "cb5c8a0c-1e83-39ed-90ac-f7e190228483",
                                "text": "Other highly effective heterocyclic substituents were pyrazinyl and quinoxalyl."
                            },
                            {
                                "example_id": "ef550175-dd71-4188-be13-a8794887eb14",
                                "sense_id": "cb5c8a0c-1e83-39ed-90ac-f7e190228483",
                                "text": "From ethyleneoxides or ethyleneimines carrying an acyl substituent, with hydrazine and its derivatives (Ch. 3. XV)."
                            },
                            {
                                "example_id": "55c37174-5651-4e46-b2d9-b8312dd15007",
                                "sense_id": "cb5c8a0c-1e83-39ed-90ac-f7e190228483",
                                "text": "In a recent paper on homopyrimidine decamers containing aeg-monomers and thymine monomers with a sulfomethyl substituent at the γ-position, similar triplexes has also been described [43 ]."
                            }
                        ]
