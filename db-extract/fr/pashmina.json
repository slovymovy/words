                    },
                    {
                        "translation_id": "2ca9ef49-b391-4d68-999e-53f195a71323",
                        "source_entry_id": "6905f2c1-4894-3867-8657-90281a35be8d",
                        "source_sense_id": "eb2850d4-e0e5-3114-9aac-6b12f6a8b879",
