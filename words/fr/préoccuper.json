                    "sense_definition": "Inquiéter quelqu'un, lui causer du souci ou du tourment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "souci",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La hausse soudaine des prix <w>préoccupe</w> de nombreuses familles modestes ce mois-ci."
                        },
                        {
                            "text": "Cette situation politique instable commence à <w>préoccuper</w> les dirigeants au plus haut point."
                        }
                    ],
                    "synonyms": [
                        "inquiéter",
                        "tourmenter",
                        "tracasser",
                        "alarmer"
                    ],
                    "antonyms": [
                        "rassurer",
                        "tranquilliser",
                        "apaiser"
                    ],
                    "common_phrases": [
