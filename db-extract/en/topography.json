                                        "sense_id": "30495086-aa6a-3a57-999e-1f5e47325883",
                                        "entry_id": "1a30c5dd-6d9a-3188-9c19-4f16322a8b54",
                                        "glosses": [
                                            "поверхность какой-либо страны или местности и взаимное расположение её пунктов, частей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2596cc21-1fb3-444f-b6ee-f0fd6b3cdbb0",
                                                "sense_id": "30495086-aa6a-3a57-999e-1f5e47325883",
                                                "text": "Церковь Святого Афельстайна являлась в топографии Найп-Хилла вершинным пунктом, и, если бы вас посетило желание взобраться на колокольню, вам бы открылся вид на десять миль кругом. Хотя не так уж много было того, что стоило обозревать, – обычный плоский, слегка бугристый ландшафт Восточной Англии..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ebc0401-2067-4f44-82f7-99655105e689",
                        "source_entry_id": "504e8d6d-86f2-354c-b5d5-6dbd29bb5804",
                        "source_sense_description": "the features themselves (the terrain)",
                        "target_lang_word": "релье́ф",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "релье́ф",
