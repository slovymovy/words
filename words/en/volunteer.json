{
    "word_family": [
        "voluntary",
        "voluntarily",
        "volunteerism",
        "involuntary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "117fa0bd-bbf1-3dd5-9b8a-9ad72e68abb2",
                    "sense_definition": "A person who performs a service willingly and without pay, often for a charitable cause.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital relies on a dedicated <w>volunteer</w> to run the gift shop.",
                            "target_lang_translations": {
                                "ru": "Больница полагается на преданного делу <w>волонтёра</w> в управлении сувенирным магазином.",
                                "zh": "这家医院依靠一位敬业的<w>志愿者</w>来经营礼品店。"
                            }
                        },
                        {
                            "text": "She works as a <w>volunteer</w> at the local animal shelter on weekends.",
                            "target_lang_translations": {
                                "ru": "По выходным она работает <w>волонтёром</w> в местном приюте для животных.",
                                "zh": "她周末在当地的动物收容所做<w>志愿者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "helper",
                        "unpaid worker"
                    ],
                    "antonyms": [
                        "employee"
                    ],
                    "common_phrases": [
                        "community volunteer",
                        "volunteer work",
                        "hospital volunteer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который добровольно и безвозмездно занимается общественно полезной деятельностью.",
                        "zh": "指自愿且无偿地从事社会公益活动的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волонтёр",
                                "target_lang_sense_clarification": "общественная деятельность"
                            },
                            {
                                "target_lang_word": "доброволец",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "志愿者",
                                "target_lang_sense_clarification": "从事公益活动的人"
                            },
                            {
                                "target_lang_word": "义工",
                                "target_lang_sense_clarification": "无偿服务者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38ac4b41-903c-3822-b1eb-9a9e5bcf42ac",
                    "sense_definition": "A soldier who joins the military by choice rather than being forced by law.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regiment was composed entirely of a <w>volunteer</w> force eager to defend their country.",
                            "target_lang_translations": {
                                "ru": "Полк полностью состоял из <w>добровольцев</w>, жаждущих защитить свою страну.",
                                "zh": "该团完全由渴望保家卫国的<w>志愿兵</w>组成。"
                            }
                        },
                        {
                            "text": "Unlike a conscript, a <w>volunteer</w> has chosen to enlist in the army.",
                            "target_lang_translations": {
                                "ru": "В отличие от призывника, <w>доброволец</w> сам решил вступить в армию.",
                                "zh": "与被征召的士兵不同，<w>志愿兵</w>是自愿选择入伍的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recruit",
                        "enlistee"
                    ],
                    "antonyms": [
                        "conscript",
                        "draftee"
                    ],
                    "common_phrases": [
                        "army volunteer",
                        "military volunteer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Солдат, вступивший в армию по собственному желанию, а не по призыву.",
                        "zh": "指自愿参军而非被法律强制征召的士兵。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доброволец",
                                "target_lang_sense_clarification": "военная служба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "志愿兵",
                                "target_lang_sense_clarification": "军事领域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4397e770-550c-3958-be77-27fed251fc77",
                    "sense_definition": "A plant that grows in a garden or field spontaneously without being deliberately planted by a person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tomato plant growing in the compost heap is a <w>volunteer</w> from last year's crop.",
                            "target_lang_translations": {
                                "ru": "Куст помидора, растущий в компостной куче, — это <w>самосев</w> от прошлогоднего урожая.",
                                "zh": "堆肥堆里长出的那株番茄是去年作物留下的<w>自生植物</w>。"
                            }
                        },
                        {
                            "text": "Farmers often remove every <w>volunteer</w> to prevent disease from spreading to the new harvest.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто удаляют каждое <w>растение-самосев</w>, чтобы предотвратить распространение болезней на новый урожай.",
                                "zh": "农民通常会清除所有的<w>自生植物</w>，以防止疾病传播到新一季的庄稼上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение, выросшее самосевом, которое не сажали специально.",
                        "zh": "指在花园或田野中自然生长，而非人工种植的植物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самосев",
                                "target_lang_sense_clarification": "растение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自生植物",
                                "target_lang_sense_clarification": "植物学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b29511e6-d3d9-33cf-a52c-212d369d3aee",
                    "sense_definition": "A native or resident of the US state of Tennessee.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_demonym",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a proud <w>volunteer</w>, he always supported the state university's football team.",
                            "target_lang_translations": {
                                "ru": "Как гордый <w>житель Теннесси</w>, он всегда поддерживал футбольную команду университета штата.",
                                "zh": "作为一名自豪的<w>田纳西州人</w>，他一直支持州立大学的橄榄球队。"
                            }
                        },
                        {
                            "text": "She was born in Nashville and considers herself a true <w>volunteer</w>.",
                            "target_lang_translations": {
                                "ru": "Она родилась в Нэшвилле и считает себя истинным <w>жителем Теннесси</w>.",
                                "zh": "她出生在纳什维尔，认为自己是一个地道的<w>田纳西州人</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уроженец или житель штата Теннесси (США).",
                        "zh": "美国田纳西州的居民。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "житель Теннесси",
                                "target_lang_sense_clarification": "житель штата"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "田纳西州人",
                                "target_lang_sense_clarification": "居民称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88d7b8eb-07db-3ec9-9c73-3dc0f0c6dad4",
                    "sense_definition": "To offer to do something or help with a task without being forced or paid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_offer_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to <w>volunteer</w> for the cleanup project in the park.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>вызваться</w> участвовать в проекте по уборке парка.",
                                "zh": "我决定<w>自愿</w>参加公园的清理项目。"
                            }
                        },
                        {
                            "text": "Several students <w>volunteered</w> to help organize the school festival.",
                            "target_lang_translations": {
                                "ru": "Несколько студентов <w>вызвались</w> помочь в организации школьного фестиваля.",
                                "zh": "几名学生<w>自愿</w>帮忙组织学校的节日庆典。"
                            }
                        }
                    ],
                    "synonyms": [
                        "step forward",
                        "offer"
                    ],
                    "antonyms": [
                        "refuse"
                    ],
                    "common_phrases": [
                        "volunteer to help",
                        "volunteer for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предложить свою помощь или взяться за выполнение задачи по собственной инициативе.",
                        "zh": "主动提出帮助或承担某项任务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызваться",
                                "target_lang_sense_clarification": "предложить помощь"
                            },
                            {
                                "target_lang_word": "стать волонтёром",
                                "target_lang_sense_clarification": "заняться благотворительностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自愿",
                                "target_lang_sense_clarification": "主动提出"
                            },
                            {
                                "target_lang_word": "主动请缨",
                                "target_lang_sense_clarification": "主动承担任务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13060a47-7c38-3d51-a37d-e1fb96a86d2e",
                    "sense_definition": "To give information, an explanation, or an opinion without being asked.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_offer_info",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness did not <w>volunteer</w> any extra details to the police.",
                            "target_lang_translations": {
                                "ru": "Свидетель не стал <w>сообщать</w> полиции никаких дополнительных подробностей по собственной инициативе.",
                                "zh": "证人没有向警方<w>主动提供</w>任何额外细节。"
                            }
                        },
                        {
                            "text": "He was afraid to <w>volunteer</w> an answer in case it was wrong.",
                            "target_lang_translations": {
                                "ru": "Он боялся <w>высказать</w> ответ, опасаясь, что тот окажется неверным.",
                                "zh": "他不敢<w>主动回答</w>，生怕答错了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "volunteer information",
                        "volunteer an answer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщить информацию или высказать мнение по собственной инициативе, без вопроса со стороны.",
                        "zh": "在未被询问的情况下主动提供信息、解释或发表意见。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщить добровольно",
                                "target_lang_sense_clarification": "информацию"
                            },
                            {
                                "target_lang_word": "высказать",
                                "target_lang_sense_clarification": "мнение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主动提供",
                                "target_lang_sense_clarification": "信息或意见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a07718a7-d134-3ff9-8c2f-a7d2a8468ba0",
                    "sense_definition": "To assign a task to someone else, usually without asking for their permission first.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_voluntold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My boss decided to <w>volunteer</w> me to lead the holiday committee.",
                            "target_lang_translations": {
                                "ru": "Мой начальник решил <w>записать</w> меня в руководители праздничного комитета без моего ведома.",
                                "zh": "我的老板决定<w>强行指派</w>我担任节日委员会的负责人。"
                            }
                        },
                        {
                            "text": "Don't <w>volunteer</w> your brother for the job unless you know he is free.",
                            "target_lang_translations": {
                                "ru": "Не стоит <w>подписывать</w> брата на эту работу, если не знаешь, свободен ли он.",
                                "zh": "除非你知道你弟弟有空，否则别<w>强行指派</w>他做这份工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "volunteer someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often humorous"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Назначить кого-то на выполнение задачи без его согласия (часто иронично).",
                        "zh": "在未经他人同意的情况下，擅自指派某人承担某项任务（常含戏谑意味）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "записать",
                                "target_lang_sense_clarification": "назначить без спроса"
                            },
                            {
                                "target_lang_word": "подписать",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强行指派",
                                "target_lang_sense_clarification": "未经同意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "586e7b64-a1b8-39f1-9c6f-4720528df248",
                    "sense_definition": "To grow naturally in a place without being planted by humans.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wildflowers often <w>volunteer</w> in the open fields after the rain.",
                            "target_lang_translations": {
                                "ru": "Полевые цветы часто <w>вырастают сами</w> на открытых полях после дождя.",
                                "zh": "雨后，野花经常在开阔的田野里<w>自生</w>。"
                            }
                        },
                        {
                            "text": "We let the pumpkins <w>volunteer</w> in the garden rather than planting new seeds.",
                            "target_lang_translations": {
                                "ru": "Мы позволили тыквам <w>расти самосевом</w> в саду, вместо того чтобы сажать новые семена.",
                                "zh": "我们让南瓜在花园里<w>自生</w>，而不是去种新种子。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расти естественным образом, без посадки человеком.",
                        "zh": "指植物在无人种植的情况下自然生长。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расти самосевом",
                                "target_lang_sense_clarification": "о растениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自生",
                                "target_lang_sense_clarification": "植物自然生长"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}