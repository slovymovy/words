                    {
                        "sense_id": "93068f92-13f0-367d-881e-6f298ae54035",
                        "entry_id": "e42e5d9a-e3df-3146-8732-000f6a5a2ee2",
                        "glosses": [
                            "(ursprünglich im tropischen und subtropischen Südamerika vorkommender, artenreicher) zu den Wunderblumen gehörender Strauch oder kleiner Baum, dessen rosa, gelbliche oder weiße Blütenhülle an einem roten, violetten oder weißen Hochblatt wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3467f17-7fd8-43da-90ad-e984af0ec79d",
                                "sense_id": "93068f92-13f0-367d-881e-6f298ae54035",
                                "text": "“Sometimes a little wreath of ascending smoke, curling above the purple petals of bougainvilleas, or the red cloud of oleanders, told her of his presence, in some retired thinking-place.”",
                                "translation": "„Manchmal kündete eine kleine Fahne aufsteigenden Rauches, die sich über die violetten Blütenblätter der Bougainvilleen kräuselte, oder das rote Gewölk aus Oleandern für sie, in einem Winkel ihrer Gedankenwelt, von seiner Anwesenheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c79efa4-82ce-4d6b-a3a2-e8644c309b93",
                        "source_entry_id": "e42e5d9a-e3df-3146-8732-000f6a5a2ee2",
                        "source_sense_id": "93068f92-13f0-367d-881e-6f298ae54035",
                        "source_sense_description": "siehe deutsche Übersetzung",
                        "target_lang_word": "Bougainvillea",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bougainvillea",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                        "entry_id": "fa19b702-e262-3574-98e7-87f075e6ab3c",
                                        "glosses": [
                                            "(ursprünglich im tropischen und subtropischen Südamerika vorkommender, artenreicher) zu den Wunderblumen gehörender Strauch oder kleiner Baum, dessen rosa, gelbliche oder weiße Blütenhülle an einem roten, violetten oder weißen Hochblatt wächst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2cd015a-38e4-4e8c-bdba-bbb8868eb8c7",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Sie machte ihn aufmerksam auf das, was jetzt hier blühte: Hibiskus, Bougainvillea, Fuchsien.“"
                                            },
                                            {
                                                "example_id": "9387f595-00f6-48ed-9820-6bdf7443afab",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Sie sahen die unversehrten Stadtmauern, die zugewucherten Straßen, die von den Bougainvilleen verschlungenen Festungen, die Marmorpaläste mit den Goldaltären und den Vizekönigen, die pestkrank in ihren Rüstungen verfault waren.“"
                                            },
                                            {
                                                "example_id": "590243bf-e1b9-42e5-a7df-56ac5383cfdb",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„»[…] Auch die Bougainvillea kommt aus meiner Heimat, obwohl man hierzulande glaubt, sie wachse nur im Mittelmeerraum.«“"
                                            },
                                            {
                                                "example_id": "714e8bc9-793a-4079-ba91-a1d7e071cfa9",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Pinkblühende Bougainvilleen ranken sich an den Mauern empor, sanftes Palmenrauschen über uns.“"
                                            },
                                            {
                                                "example_id": "138e7021-db33-457c-a7f5-2cdf593b8861",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Das heutige Karthago ist der wohl schönste Vorort von Tunis mit palmen- und eukalyptusgesäumten Alleen, Villen und Gärten voll roter Hibiskusblüten und lila Bougainvilleen.“"
                                            },
                                            {
                                                "example_id": "50dcebf4-9b02-43c3-b8f2-71f065a9f9c0",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Bougainvilleen bilden schrillrote Blütenkaskaden.“"
                                            },
                                            {
                                                "example_id": "3baf6041-6bed-428a-825c-8abd0a868f32",
                                                "sense_id": "f12beec2-1237-3674-9e81-1683fe6a3992",
                                                "text": "„Unter der purpurroten Bougainvillea kommt sie wieder zu Atem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
