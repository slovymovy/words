                ],
                "senses": [
                    {
                        "sense_id": "4da28eb3-1ded-3334-889c-bdad12d7f261",
                        "entry_id": "4b4a7382-5f2c-3dae-b7c4-23b652151531",
                        "glosses": [
                            "eine geschlechtsspezifische Krankheit, die ausschließlich oder vorwiegend bei der Frau auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b02d766-9416-48a7-927f-a4369e9e3031",
                                "sense_id": "4da28eb3-1ded-3334-889c-bdad12d7f261",
                                "text": "Die Wirtschaftswissenschaftlerin hält es daher für unerlässlich, die Öffentlichkeit besser über die Frauenkrankheit aufzuklären."
                            },
                            {
                                "example_id": "0244fe4a-277b-4592-b818-cc328a76a1e0",
                                "sense_id": "4da28eb3-1ded-3334-889c-bdad12d7f261",
                                "text": "„Obwohl Endometriose massive körperliche und psychische Probleme für die Betroffenen verursachen kann, gehört sie zu den unterschätzten und zu wenig untersuchten Frauenkrankheiten unserer Zeit“, sagt auch Prof. Andreas Ebert, Chef des Endometriosezentrums am Humboldt-Klinikum."
                            },
                            {
                                "example_id": "6e23e60d-1ffa-4280-ae7a-a5f34fbd033a",
                                "sense_id": "4da28eb3-1ded-3334-889c-bdad12d7f261",
                                "text": "Osteoporose, also Knochenschwund, tritt erstens viel häufiger auf als allgemein bekannt und ist zweitens keine „Frauenkrankheit“ – auch Männer sind davon betroffen, allerdings nicht so häufig wie Frauen."
                            },
                            {
                                "example_id": "f4273d4d-b139-4804-8db2-538ca21daaaa",
                                "sense_id": "4da28eb3-1ded-3334-889c-bdad12d7f261",
                                "text": "Lange Zeit glaubten Ärzte, Migräne sei eine typische Frauenkrankheit und werde allein durch die weiblichen Hormone verursacht."
                            },
                            {
                                "example_id": "9a6494fb-5351-41f3-9a25-a06bce986c04",
                                "sense_id": "4da28eb3-1ded-3334-889c-bdad12d7f261",
                                "text": "In gewisser Weise hat Borderline die klassische Hysterie als seelische Frauenkrankheit abgelöst; mindestens siebzig Prozent der Betroffenen sind weiblich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
