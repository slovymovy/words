                                                "example_id": "e5190067-4061-48b3-915b-426f19a98bee",
                                                "sense_id": "dace7bed-af3a-3581-a367-d9c1f9d36dbb",
                                                "text": "Her vivacity appeared as graceful as it was buoyant; her gay spirit seemed the musical overflowings of youth and happiness; her eye and cheek brightened together; and her sweet glad laugh was as catching as yawning."
                                            }
                                        ]
                                    }
                                ]
