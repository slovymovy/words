                            "comparative"
                        ],
                        "form": "more uncontrollable"
                    },
                    {
                        "form_id": "54da380b-1166-46f2-80bc-d75f4e3c7d9f",
                        "entry_id": "d17b6859-13cc-3f8f-a457-fe4ad7d905a8",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most uncontrollable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12a2ef84-d31f-3603-82c4-84e691c6f632",
                        "entry_id": "d17b6859-13cc-3f8f-a457-fe4ad7d905a8",
                        "glosses": [
                            "Not able to be controlled, contained or governed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e421b11f-1b27-4400-bc0d-870c954d2a85",
                                "sense_id": "12a2ef84-d31f-3603-82c4-84e691c6f632",
                                "text": "She got the uncontrollable urge for some chocolate."
                            },
                            {
                                "example_id": "9d021233-6a9b-4d03-8cfb-d2c9c6babea2",
                                "sense_id": "12a2ef84-d31f-3603-82c4-84e691c6f632",
                                "text": "\"Ethel!\" exclaimed Norbourne, his strong and uncontrollable emotion betraying the power that her name still had over him: he tried to say something more, but the words died on his lips."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb098545-c6ad-402b-a22f-d387f69db232",
                        "source_entry_id": "d17b6859-13cc-3f8f-a457-fe4ad7d905a8",
                        "source_sense_id": "12a2ef84-d31f-3603-82c4-84e691c6f632",
                        "source_sense_description": "not able to be controlled, contained or governed",
                        "target_lang_word": "onbeheersbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onbeheersbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f1480443-b26c-399e-8560-84bf283f2249",
                                        "entry_id": "e7a7f8a7-893c-3038-a5b9-8226e4391cab",
                                        "glosses": [
                                            "dat iets niet onder controle gehouden kan worden, dat je ergens niet de leiding over kunt houden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9306d9-7150-4d0d-a949-f20cc271ea5e",
                                                "sense_id": "f1480443-b26c-399e-8560-84bf283f2249",
                                                "text": "De onbeersbare menigte ging door de barricade van de politie heen."
                                            },
                                            {
                                                "example_id": "60581bbd-fbbf-47a9-9475-efa5e2c1729c",
                                                "sense_id": "f1480443-b26c-399e-8560-84bf283f2249",
                                                "text": "Het onbeheersbare conflict in de direktie veoorzaakte het failliet van het bedrijf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb4de03e-dd4e-405e-82ff-e151d47083d3",
                        "source_entry_id": "d17b6859-13cc-3f8f-a457-fe4ad7d905a8",
                        "source_sense_id": "12a2ef84-d31f-3603-82c4-84e691c6f632",
                        "source_sense_description": "not able to be controlled, contained or governed",
                        "target_lang_word": "incontrôlable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incontrôlable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75c92096-c370-33c5-ac34-028411c0acc5",
                                        "entry_id": "4e3968d5-cf22-3040-983e-417ba7257a33",
                                        "glosses": [
                                            "Qui ne peut pas être contrôlé, vérifié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9440fa2-f314-497b-9a49-2e2d2fafcb1d",
                                                "sense_id": "75c92096-c370-33c5-ac34-028411c0acc5",
                                                "text": "Il nous apportait des preuves innombrables et incontrôlables de sa bonne foi, de « son dévouement jusqu'à terre »."
                                            },
                                            {
                                                "example_id": "7f38b466-d2c3-4970-b9d1-bf5811ada57e",
                                                "sense_id": "75c92096-c370-33c5-ac34-028411c0acc5",
                                                "text": "Hélas ! en même temps que la richesse, l’habitude de la distillation du cidre à domicile s’est répandue ! L’usage du privilège des bouilleurs de cru met à la disposition directe des paysans, en quantités immenses, incontrôlables, le poison. Les alambics circulent partout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92658a14-ffe3-3d43-b72e-e4867d4af7d3",
                                        "entry_id": "4e3968d5-cf22-3040-983e-417ba7257a33",
                                        "glosses": [
                                            "Qui ne peut pas être contrôlé, maîtrisé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3efc5574-aa82-4822-8708-70fa84d73ab4",
                                                "sense_id": "92658a14-ffe3-3d43-b72e-e4867d4af7d3",
                                                "text": "Et en effet, vous sentez fort bien, mes amis, qu’un gouvernement dans lequel tous les pouvoirs seroient réunis entre les mains d’un monarque ou d’un sénat quelconque, aristocratique ou démocratique, seroit le pire de tous les gouvernemens, c’est-à-dire, un gouvernement absolument despotique par la raison qu’il seroit incontrôlable."
                                            },
                                            {
                                                "example_id": "62ee0435-ca14-458b-84be-1689426a8353",
                                                "sense_id": "92658a14-ffe3-3d43-b72e-e4867d4af7d3",
                                                "text": "Comment ces mêmes sujets réagissent-ils à l’exposition prolongée à des stress incontrôlables ? L’augmentation de l’effort pour obtenir le contrôle sur un stress incontrôlable n’est pas efficace à long terme …"
                                            },
                                            {
                                                "example_id": "ba85af41-bf40-4ba1-a46e-a328a976c7e8",
                                                "sense_id": "92658a14-ffe3-3d43-b72e-e4867d4af7d3",
                                                "text": "Sans la formation du caillot sanguin, ces lésions causeraient une perte de sang (hémorragie) incontrôlable qui mettrait rapidement notre vie en danger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43aee98d-367c-455c-b9d1-58cb41320f4d",
                        "source_entry_id": "d17b6859-13cc-3f8f-a457-fe4ad7d905a8",
                        "source_sense_id": "12a2ef84-d31f-3603-82c4-84e691c6f632",
                        "source_sense_description": "not able to be controlled, contained or governed",
                        "target_lang_word": "unkontrollierbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unkontrollierbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3648ce6b-9250-3b27-813d-d4e94b078fff",
                                        "entry_id": "35c6bc83-e1b3-3360-b196-9e17314ae856",
                                        "glosses": [
                                            "so, dass es nicht kontrolliert werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c01d159-c77d-44e0-8473-a28de2d1e6e5",
                                                "sense_id": "3648ce6b-9250-3b27-813d-d4e94b078fff",
                                                "text": "„Die Miß riß der Tante und dem Papa mit ihrem vom Schmerz unkontrollierbar gekräftigten »shake hands« fast die Arme aus, preßte Friedel an sich, daß der Hören und Sehen und der Atem dazu verging, und war in ihrem Wagen drin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
