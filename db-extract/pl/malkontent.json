                ],
                "senses": [
                    {
                        "sense_id": "daacede3-511a-3a0e-96ae-82ec53566d52",
                        "entry_id": "afbdca7c-47cc-37d8-8d7a-95255998a70e",
                        "glosses": [
                            "człowiek niezadowolony ze wszystkiego, doszukujący się wad we wszystkim i wszystkich."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a4fdea-baa7-48f3-a444-c7f2d0b57948",
                                "sense_id": "daacede3-511a-3a0e-96ae-82ec53566d52",
                                "text": "Mężu, ale z ciebie malkontent."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8e9ad51-de97-464c-b646-3483521019ec",
                        "source_entry_id": "afbdca7c-47cc-37d8-8d7a-95255998a70e",
                        "source_sense_id": "daacede3-511a-3a0e-96ae-82ec53566d52",
                        "target_lang_word": "malcontent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malcontent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a54cdb7e-f9f0-3661-9183-01e213031264",
                                        "entry_id": "fbe2f4b4-8487-3fd4-9457-7d0267005963",
                                        "glosses": [
                                            "Dissatisfied with current conditions; disaffected, discontented, rebellious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e8a6e11-07f7-4464-b959-c5ec8f857869",
                                                "sense_id": "a54cdb7e-f9f0-3661-9183-01e213031264",
                                                "text": "[Alban] Butler also commends the piety of Simon Montfort, the persecutor of the Albigenses, and the father of the famous malcontent earl of Leicester, who flourished in the reign of king Henry III."
                                            },
                                            {
                                                "example_id": "04cd8a4b-76da-4cd8-8e97-778d402c02d9",
                                                "sense_id": "a54cdb7e-f9f0-3661-9183-01e213031264",
                                                "text": "The duke of Gloucester was a sickly child […] he died of a sore throat, and rash fever, occasioned by an imprudent participation in the festivities of his birthday. The famous humourist, Dr. [John] Radcliffe, the Abernethy of his day, who was malcontent with the government, was called in too late, he declared, to save his royal patient."
                                            },
                                            {
                                                "example_id": "d3a98b71-9494-41e2-8ee2-70e71f62e585",
                                                "sense_id": "a54cdb7e-f9f0-3661-9183-01e213031264",
                                                "text": "Sir, I will stake any thing short of my salvation, that those who are malcontent now, will be more malcontent three years hence, than they are at this day. I have no favor for this Constitution."
                                            },
                                            {
                                                "example_id": "8e59e887-ee4c-4293-8953-61764e434961",
                                                "sense_id": "a54cdb7e-f9f0-3661-9183-01e213031264",
                                                "text": "To cap everything, yet another war waged by malcontent generals did further widespread damage to the railways."
                                            },
                                            {
                                                "example_id": "a78b9563-a444-4186-9298-202756c1b8f5",
                                                "sense_id": "a54cdb7e-f9f0-3661-9183-01e213031264",
                                                "text": "The stress created by all of the changes seemed to be more than she could handle. Initially, she thought her husband was malcontent on purpose and felt he was aware of the arguments he seemed to be starting."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "malcontent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "577cdd3c-32eb-3e74-bd7f-351b731bab72",
                                        "entry_id": "b1157a70-63e6-3a39-9808-818b934c0096",
                                        "glosses": [
                                            "A person who is not satisfied with current conditions; a discontented person, a rebel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be4a94b8-b8d1-4a18-8841-62a558b4e10f",
                                                "sense_id": "577cdd3c-32eb-3e74-bd7f-351b731bab72",
                                                "text": "The diſcord rather than the muſick is heard from the malcontent Malevole's chamber."
                                            },
                                            {
                                                "example_id": "bb9c5bd1-932a-423f-b050-103f88f2a8c9",
                                                "sense_id": "577cdd3c-32eb-3e74-bd7f-351b731bab72",
                                                "text": "For is it not eaſy to ſee, that a Prince made odious and contemptible, will ſoon be removed from his Throne, when it is in the Power of the Malecontents to bring about ſuch a fatal Revolution?"
                                            },
                                            {
                                                "example_id": "1bd4ebb1-ef65-4d86-b0ba-2c6df65d36eb",
                                                "sense_id": "577cdd3c-32eb-3e74-bd7f-351b731bab72",
                                                "text": "He is the victim of circumstances, and their martyr. His asseverations of the facts are so frequent and so earnest, that it is impossible to dispute it. […] Everywhere confronted by implacable circumstance, what remained for the malcontent but to flee from his enemy, and endeavour to retrieve his broken fortunes in a new world! […] So the malcontent took passage for Australia, and blessed us with his presence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0195f95f-5078-329f-9345-a888940ee8a7",
                                        "entry_id": "b1157a70-63e6-3a39-9808-818b934c0096",
                                        "glosses": [
                                            "A state of discontentment or dissatisfaction; something that causes discontent."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e52fff-9473-420c-9818-4cc056f07b1f",
                                                "sense_id": "0195f95f-5078-329f-9345-a888940ee8a7",
                                                "text": "If there was malcontent on his part, it did not spring from economic limitations alone, but also from the effect of these economic limitations upon his social and legal status as a small farmer. The state of constant indebtdness in which the contadino found himself contributed to his malcontent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "malcontent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edb381d1-8793-320a-9d74-3dcc8c1b5768",
                                        "entry_id": "4766a792-0b16-36ab-9752-69feabe217e5",
                                        "glosses": [
                                            "To cause discontent or dissatisfaction."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f9f71a7-14c8-4f3b-a9ca-1a8f9eb2d51f",
                                                "sense_id": "edb381d1-8793-320a-9d74-3dcc8c1b5768",
                                                "text": "[…] James Bond adventure with a Ward Bond delivery, reams of malcontenting and anti-literary remarks, first-class manipulation of Anglo-Saxon's juicier words, and quotations from the Great Books and from William Kite's notebook."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
