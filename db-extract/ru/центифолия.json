                "senses": [
                    {
                        "sense_id": "54492967-99cf-38a0-875f-7c18f1b4115c",
                        "entry_id": "ec490307-c175-3335-94b2-bfd4ab48161c",
                        "glosses": [
                            "ботан. вид махровой садовой розы (столепестковая)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66c5da4b-f4cb-4378-aeb8-a1eb8f20f3cc",
                                "sense_id": "54492967-99cf-38a0-875f-7c18f1b4115c",
                                "text": "С таким-то положительным и непоколебимым намерением сел за ужин рядом с Пелагеею Власьевною Петр Авдеевич, выпил большую рюмку настойки на центифолии, улегся, поужинав, на две перины, положенные, в свою очередь, на березовом диване гостиной, и пресладко и прекрепко проспал до утра."
                            },
                            {
                                "example_id": "755f7ff3-bc85-4f49-b535-8c96cc7dd1fb",
                                "sense_id": "54492967-99cf-38a0-875f-7c18f1b4115c",
                                "text": "Поймёшь, на глянце центифолий // Считая бережно мазки…"
                            }
                        ]
                    }
