                "senses": [
                    {
                        "sense_id": "5ca21ecc-c7b7-3c33-8ffd-ccf8c0968b96",
                        "entry_id": "99e9530a-ce14-3841-917e-f579747e52d8",
                        "glosses": [
                            "ein Billionstel der Maßeinheit Meter (= 0,000 000 000 001 Meter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c41d4be7-5a61-417e-870e-8ae2b15a76e2",
                                "sense_id": "5ca21ecc-c7b7-3c33-8ffd-ccf8c0968b96",
                                "text": "Hundert Pikometer entsprechen dem Längenmaß Ångström."
                            },
                            {
                                "example_id": "0a9d080b-8442-4a55-8db1-a36c77725052",
                                "sense_id": "5ca21ecc-c7b7-3c33-8ffd-ccf8c0968b96",
                                "text": "Ein Atom hat einen Durchmesser zwischen 50 und 600 Pikometer."
                            },
                            {
                                "example_id": "ac9b8814-0e73-41d3-83a0-28459178f4de",
                                "sense_id": "5ca21ecc-c7b7-3c33-8ffd-ccf8c0968b96",
                                "text": "Ein Autoreifen verliert während einer Umdrehung im Mittel 200 Pikometer an Profil."
                            },
                            {
                                "example_id": "dfdc294c-87a4-4290-91f2-3504414456f1",
                                "sense_id": "5ca21ecc-c7b7-3c33-8ffd-ccf8c0968b96",
                                "text": "Mit Geschwindigkeiten zwischen einem und 700 Pikometern (Milliardstel Millimeter) pro Sekunde ließen sie einen Mangan-Porphyrin-Komplex über einen Kunststoffstrang aus Polybutadien wandern."
                            },
                            {
                                "example_id": "d40f517e-b6d3-4130-acd8-9d54f7a079c7",
                                "sense_id": "5ca21ecc-c7b7-3c33-8ffd-ccf8c0968b96",
                                "text": "So konnten die Augsburger eine Auflösung von weniger als 100 Pikometern erzielen."
                            },
                            {
                                "example_id": "c3a4c604-7fbf-4467-acd2-15ef01ce6572",
                                "sense_id": "5ca21ecc-c7b7-3c33-8ffd-ccf8c0968b96",
                                "text": "Lara Petzinger ist die Entdeckerin der Einheit Pikometer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
