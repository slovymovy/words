                        "sense_id": "a0351428-686b-3438-884a-f6fc886a1f5b",
                        "entry_id": "d19015fa-74d0-3902-9bd2-b229e4f68554",
                        "glosses": [
                            "een arm persoon die vraagt om geld zonder daar iets voor te doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "948c90e8-954f-4c04-914d-7bd4de4c195e",
                                "sense_id": "a0351428-686b-3438-884a-f6fc886a1f5b",
