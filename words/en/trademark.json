{
    "word_family": [
        "trademarked",
        "trademarking"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "997ef521-1d6f-3e88-9fc9-a61e323e8997",
                    "sense_definition": "A word, symbol, or phrase used to identify a company's product and differentiate it from others, especially one registered for legal protection.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intellectual property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company filed an application to protect its new logo as a <w>trademark</w>.",
                            "target_lang_translations": {
                                "ru": "Компания подала заявку, чтобы защитить свой новый логотип как <w>товарный знак</w>."
                            }
                        },
                        {
                            "text": "You cannot use that name because it is a registered <w>trademark</w> of another firm.",
                            "target_lang_translations": {
                                "ru": "Вы не можете использовать это название, так как оно является зарегистрированной <w>торговой маркой</w> другой фирмы."
                            }
                        }
                    ],
                    "synonyms": [
                        "brand",
                        "logo",
                        "brand name"
                    ],
                    "antonyms": [
                        "generic name"
                    ],
                    "common_phrases": [
                        "registered trademark",
                        "trademark infringement",
                        "trademark law"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, символ или фраза, используемые для идентификации продукта компании и его отличия от других, особенно зарегистрированные для правовой защиты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "товарный знак",
                                "target_lang_sense_clarification": "официальное юридическое обозначение"
                            },
                            {
                                "target_lang_word": "торговая марка",
                                "target_lang_sense_clarification": "бренд или логотип компании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55e1cc2b-ba5a-30b5-a40d-9eb7cd5f57da",
                    "sense_definition": "A characteristic or feature for which someone or something is particularly well known.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "characteristic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef's <w>trademark</w> is adding a hint of cinnamon to every savory dish.",
                            "target_lang_translations": {
                                "ru": "<w>Визитной карточкой</w> шеф-повара является добавление щепотки корицы в каждое несладкое блюдо."
                            }
                        },
                        {
                            "text": "The director's <w>trademark</w> style includes long shots and very little dialogue.",
                            "target_lang_translations": {
                                "ru": "<w>Фирменный</w> стиль режиссера включает длинные планы и минимум диалогов."
                            }
                        }
                    ],
                    "synonyms": [
                        "hallmark",
                        "signature",
                        "feature"
                    ],
                    "common_phrases": [
                        "trademark style",
                        "personal trademark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерная черта или особенность, по которой кто-то или что-то особенно хорошо известно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "визитная карточка",
                                "target_lang_sense_clarification": "узнаваемая особенность стиля или поведения"
                            },
                            {
                                "target_lang_word": "фирменный знак",
                                "target_lang_sense_clarification": "отличительная черта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a72a809f-204a-32dd-8f9a-40fbad06a113",
                    "sense_definition": "To officially register a name, symbol, or logo so that other companies cannot use it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>trademark</w> the slogan before launching the global campaign.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>зарегистрировать</w> слоган перед запуском глобальной кампании."
                            }
                        },
                        {
                            "text": "It is important to <w>trademark</w> a brand name to prevent competitors from copying it.",
                            "target_lang_translations": {
                                "ru": "Важно <w>зарегистрировать товарный знак</w> для названия бренда, чтобы конкуренты не могли его скопировать."
                            }
                        }
                    ],
                    "synonyms": [
                        "register",
                        "brand"
                    ],
                    "common_phrases": [
                        "trademark a name",
                        "trademark a logo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально зарегистрировать название, символ или логотип, чтобы другие компании не могли их использовать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регистрировать товарный знак",
                                "target_lang_sense_clarification": "оформлять юридические права"
                            },
                            {
                                "target_lang_word": "патентовать",
                                "target_lang_sense_clarification": "защищать интеллектуальную собственность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c5e7dcef-54be-3338-b88e-f0142da85388",
                    "sense_definition": "Serving as a distinctive or characteristic feature of a particular person or thing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "characteristic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor walked onto the stage with his <w>trademark</w> smile and waved to the crowd.",
                            "target_lang_translations": {
                                "ru": "Актер вышел на сцену со своей <w>фирменной</w> улыбкой и помахал толпе."
                            }
                        },
                        {
                            "text": "She wore her <w>trademark</w> navy suit for the important business presentation.",
                            "target_lang_translations": {
                                "ru": "На важную бизнес-презентацию она надела свой <w>коронный</w> темно-синий костюм."
                            }
                        }
                    ],
                    "synonyms": [
                        "distinctive",
                        "characteristic",
                        "signature"
                    ],
                    "common_phrases": [
                        "trademark smile",
                        "trademark look"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий отличительной или характерной чертой конкретного человека или вещи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фирменный",
                                "target_lang_sense_clarification": "характерный для кого-либо"
                            },
                            {
                                "target_lang_word": "коронный",
                                "target_lang_sense_clarification": "лучший или наиболее узнаваемый"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}