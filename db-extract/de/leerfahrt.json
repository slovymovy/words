                    {
                        "sense_id": "819285fa-c173-39f1-9734-b74ee42f025b",
                        "entry_id": "c459ea96-2b00-3e4a-83a9-191ffaa1e1e1",
                        "glosses": [
                            "Fahrt, bei der aufgrund bestimmter Umstände keine Personen oder Transportgüter befördert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b43b243a-3178-4617-92bc-9bc9a5345ba4",
                                "sense_id": "819285fa-c173-39f1-9734-b74ee42f025b",
                                "text": "„Bei einer Leerfahrt wird das Schiff so hecklastig getrimmt, dass die Schraube komplett unter Wasser liegt.“"
                            },
                            {
                                "example_id": "b29abb2b-3e55-49e2-bd84-5d6b63161cef",
                                "sense_id": "819285fa-c173-39f1-9734-b74ee42f025b",
                                "text": "„Bei Fahrten von Wien zum Flughafen […] wird für die Retourfahrt des Taxis eine zusätzliche Gebühr für die Leerfahrt zum Fahrpreis verrechnet.“"
                            }
                        ],
