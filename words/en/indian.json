                    "target_lang_definitions": {
                        "ru": "Блюдо индийской кухни или ресторан, где подают такую еду.",
                        "zh": "印度菜肴或供应此类菜肴的餐厅。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индийская кухня",
                                "target_lang_sense_clarification": "еда"
                            },
                            {
                                "target_lang_word": "индийский ресторан",
                                "target_lang_sense_clarification": "заведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "印度菜",
                                "target_lang_sense_clarification": "指代印度风味的食物"
                            },
                            {
                                "target_lang_word": "印度餐厅",
                                "target_lang_sense_clarification": "指代供应印度菜的餐馆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36148f90-3d3a-3cc3-9c84-08e208c8b42a",
                    "sense_definition": "A member of any of the indigenous peoples of the Americas.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "native_american_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Indians</w> taught the settlers how to grow corn.",
                            "target_lang_translations": {
                                "ru": "<w>Индейцы</w> научили поселенцев выращивать кукурузу.",
                                "zh": "<w>印第安人</w>教会了定居者如何种植玉米。"
                            }
                        },
                        {
                            "text": "He is proud to be an <w>Indian</w> and keeps his traditions alive.",
                            "target_lang_translations": {
                                "ru": "Он гордится тем, что он <w>индеец</w>, и хранит свои традиции.",
                                "zh": "他为自己是<w>印第安人</w>感到自豪，并传承着自己的传统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Native American",
                        "American Indian",
                        "Amerindian"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель любого из коренных народов Америки.",
                        "zh": "美洲原住民的一员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индеец",
                                "target_lang_sense_clarification": "мужской род, коренной житель Америки"
                            },
                            {
                                "target_lang_word": "индианка",
                                "target_lang_sense_clarification": "женский род, коренная жительница Америки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "印第安人",
                                "target_lang_sense_clarification": "美洲原住民的统称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
