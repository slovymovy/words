                "entry_id": "7459f1bc-1bd8-3fdf-81c3-126f04a5fc13",
                "word": "leak",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5acf051b-7d94-4460-84bc-de8ae9b77b68",
                        "entry_id": "7459f1bc-1bd8-3fdf-81c3-126f04a5fc13",
                        "tags": [
                            "plural"
                        ],
                        "form": "leaks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66cb8328-a75e-3051-8dac-92a63f7b5b1b",
                        "entry_id": "7459f1bc-1bd8-3fdf-81c3-126f04a5fc13",
                        "glosses": [
                            "Fuite d’informations confidentielles."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "af673d46-2860-4100-a3bc-1bc9c0150275",
                                "sense_id": "66cb8328-a75e-3051-8dac-92a63f7b5b1b",
                                "text": "la face cachée des « leaks » serait, la plupart du temps, à rechercher dans la stratégie offensive de cabinets d'avocats prêts à défendre, par tous les moyens, les intérêts de leurs clients."
                            },
                            {
                                "example_id": "d61453ea-7b07-4ff6-be16-b580a8bfc6e2",
                                "sense_id": "66cb8328-a75e-3051-8dac-92a63f7b5b1b",
                                "text": "C’est le cauchemar des riches et des puissants qui recourent à des paradis fiscaux pour dissimuler leurs avoirs aux regards indiscrets : un leak, une fuite massive de données confidentielles, qui jette une lumière crue sur leurs secrets."
                            },
                            {
                                "example_id": "dc1bc5b8-5363-46bc-8320-834dbdf2b696",
                                "sense_id": "66cb8328-a75e-3051-8dac-92a63f7b5b1b",
                                "text": "D’après certains internautes, ce « leak » proviendrait notamment, photos à l’appui, des supermarchés E. Leclerc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4aaa4db9-4c04-410f-9e16-69a0cdcb281b",
                        "source_entry_id": "7459f1bc-1bd8-3fdf-81c3-126f04a5fc13",
                        "source_sense_id": "66cb8328-a75e-3051-8dac-92a63f7b5b1b",
                        "target_lang_word": "leak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cc2492f-8560-346e-9d1a-7ef1ac0be7c2",
                                        "entry_id": "16470095-c80f-3609-8aa5-81089585fe0b",
                                        "glosses": [
                                            "A crack, crevice, fissure, or hole which admits water or other fluid, or lets it escape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48f562f5-5639-407a-8fab-a44c3abbf0e9",
                                                "sense_id": "5cc2492f-8560-346e-9d1a-7ef1ac0be7c2",
                                                "text": "a leak in a roof"
                                            },
                                            {
                                                "example_id": "d737c7ef-d5ce-463e-bd64-2cc2f88d06b6",
                                                "sense_id": "5cc2492f-8560-346e-9d1a-7ef1ac0be7c2",
                                                "text": "a leak in a boat"
                                            },
                                            {
                                                "example_id": "8362062f-1564-4a66-b2eb-e8154fe0783a",
                                                "sense_id": "5cc2492f-8560-346e-9d1a-7ef1ac0be7c2",
                                                "text": "a leak in a gas pipe"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d666ae26-2a36-3289-bfe9-070d5cdc81db",
                                        "entry_id": "16470095-c80f-3609-8aa5-81089585fe0b",
                                        "glosses": [
                                            "The entrance or escape of a fluid through a crack, fissure, or other aperture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a272ceaf-b63c-48b2-9c43-f02ed9dc434b",
                                                "sense_id": "d666ae26-2a36-3289-bfe9-070d5cdc81db",
                                                "text": "The leak gained on the ship's pumps."
                                            },
                                            {
                                                "example_id": "3c93cfee-8a63-4c62-83ec-ae75fed2f996",
                                                "sense_id": "d666ae26-2a36-3289-bfe9-070d5cdc81db",
                                                "text": "The babies' diapers had big leaks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47f326eb-7908-3b9b-a7a2-68ef1eba5e93",
                                        "entry_id": "16470095-c80f-3609-8aa5-81089585fe0b",
                                        "glosses": [
                                            "A divulgation, or disclosure, of information previously held secret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d609cd00-00e9-4ade-b189-183a130a3921",
                                                "sense_id": "47f326eb-7908-3b9b-a7a2-68ef1eba5e93",
                                                "text": "The leaks by Chelsea Manning showed the secrets of the US military."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e8b03be-1014-3ab7-8d8e-804b6b96f9e2",
                                        "entry_id": "16470095-c80f-3609-8aa5-81089585fe0b",
                                        "glosses": [
                                            "The person through whom such divulgation, or disclosure, occurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2473f50e-dcd0-4919-9d3f-f0bfc2e89b23",
                                                "sense_id": "1e8b03be-1014-3ab7-8d8e-804b6b96f9e2",
                                                "text": "[…] so even if he was the leak, we would never know."
                                            },
                                            {
                                                "example_id": "016178f1-ff7d-4c7d-9283-32a3113ec5ce",
                                                "sense_id": "1e8b03be-1014-3ab7-8d8e-804b6b96f9e2",
                                                "text": "I was the leak. That the government didn't like our advice, and so I decided to leak it to 'bounce' them into having to follow it."
                                            },
                                            {
                                                "example_id": "d6f2def7-444e-4186-a5e0-8c8a2f156c24",
                                                "sense_id": "1e8b03be-1014-3ab7-8d8e-804b6b96f9e2",
                                                "text": "If he was the leak, it wasn't intentional. The same went for her mom, not that Cat thought her mom had any friends with top-level security clearance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8662dcbb-4366-3640-87c0-cfff75bb7a1a",
                                        "entry_id": "16470095-c80f-3609-8aa5-81089585fe0b",
                                        "glosses": [
                                            "A loss of electricity through imperfect insulation, or the point where it occurs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2724c6c-a62a-3c51-aa98-0b5e65d8f030",
                                        "entry_id": "16470095-c80f-3609-8aa5-81089585fe0b",
                                        "glosses": [
                                            "The gradual loss of a system resource caused by failure to deallocate previously reserved portions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "296e775c-d6b7-444c-af00-bb8c316428b1",
                                                "sense_id": "d2724c6c-a62a-3c51-aa98-0b5e65d8f030",
                                                "text": "resource leak"
                                            },
                                            {
                                                "example_id": "5e6a76ec-1d75-410c-a4f1-1904d986ca04",
                                                "sense_id": "d2724c6c-a62a-3c51-aa98-0b5e65d8f030",
                                                "text": "memory leak"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48d31ea1-ac0b-315e-ad82-bfe864df2f78",
                                        "entry_id": "16470095-c80f-3609-8aa5-81089585fe0b",
                                        "glosses": [
                                            "An act of urination."
                                        ],
                                        "tags": [
                                            "especially",
                                            "mildly",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29d359b8-353d-453d-859c-6187ddd7762c",
                                                "sense_id": "48d31ea1-ac0b-315e-ad82-bfe864df2f78",
                                                "text": "I have to take a leak."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "leak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57ef42ba-4b28-316a-b06e-3c51cb931d6a",
                                        "entry_id": "22e11135-b08e-3f19-9c55-8dc203e1b4d9",
                                        "glosses": [
                                            "To allow fluid or gas to pass through an opening that should be sealed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "192cdd6e-d8a9-4375-9f29-a493b10c2134",
                                                "sense_id": "57ef42ba-4b28-316a-b06e-3c51cb931d6a",
                                                "text": "The wells are believed to have been leaking oil for decades, long after the operating company ceased to exist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50c824ae-e7c1-389f-9fbf-9bf33d7c079e",
                                        "entry_id": "22e11135-b08e-3f19-9c55-8dc203e1b4d9",
                                        "glosses": [
                                            "(of a fluid or gas) To pass through an opening that should be sealed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e58ceed-14c3-4bf9-abeb-d2ee9dee94ce",
                                                "sense_id": "50c824ae-e7c1-389f-9fbf-9bf33d7c079e",
                                                "text": "The faucet has been leaking since last month."
                                            },
                                            {
                                                "example_id": "85532e1a-6f09-46d7-b1b9-096a1b50c7e6",
                                                "sense_id": "50c824ae-e7c1-389f-9fbf-9bf33d7c079e",
                                                "text": "No one realized that propane gas was leaking from a rusty tank in the concession area, slowly filling the unventilated room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d65bf839-9675-34c9-8c36-f9071a4d4000",
                                        "entry_id": "22e11135-b08e-3f19-9c55-8dc203e1b4d9",
                                        "glosses": [
                                            "To disclose secret information surreptitiously or anonymously."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da3d6998-2ee1-433c-b478-86fe0c0d08fb",
                                                "sense_id": "d65bf839-9675-34c9-8c36-f9071a4d4000",
                                                "text": "Someone must have leaked it to our competitors that the new product will be out soon."
                                            },
                                            {
                                                "example_id": "9de9fcbf-a86b-440d-8d46-d222db92139e",
                                                "sense_id": "d65bf839-9675-34c9-8c36-f9071a4d4000",
                                                "text": "That's another of those irregular verbs, isn't it? I give confidential press briefings; you leak; he's being charged under section 2(A) of the Official Secrets Act."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f79f43b-b4df-39bb-82af-88539e8ffac2",
                                        "entry_id": "22e11135-b08e-3f19-9c55-8dc203e1b4d9",
                                        "glosses": [
                                            "To pass through when it would normally or preferably be blocked."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3930d28-2989-42a1-9764-4826267ffd5e",
                                                "sense_id": "2f79f43b-b4df-39bb-82af-88539e8ffac2",
                                                "text": "A target that is not detected would not be intercepted and thus would leak through the single defensive layer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a7fe7a1-024e-388f-8a5a-8aba47a9e293",
                                        "entry_id": "22e11135-b08e-3f19-9c55-8dc203e1b4d9",
                                        "glosses": [
                                            "To allow anything through that would normally or preferably be blocked."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7967af80-ad39-474b-846c-b62bf8a0103f",
                                                "sense_id": "3a7fe7a1-024e-388f-8a5a-8aba47a9e293",
                                                "text": "England were leaking penalties as Scotland played with pace and variety. Russell was starting to find his range and when he threaded through a grubber to Sean Maitland the winger did well to gather and keep the ball in play. Unfortunately, his pass inside just eluded Russell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0e1a3a2-5c7a-3bef-9d7c-bf7619d630ee",
                                        "entry_id": "22e11135-b08e-3f19-9c55-8dc203e1b4d9",
                                        "glosses": [
                                            "To urinate."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "slang",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ac51617-3bc9-4f33-bde7-f133ca70af27",
                                                "sense_id": "a0e1a3a2-5c7a-3bef-9d7c-bf7619d630ee",
                                                "text": "I had to leak in the woods since there were no toilets around."
                                            },
                                            {
                                                "example_id": "6007e540-cfd5-41d2-a4d7-9948ae630a6f",
                                                "sense_id": "a0e1a3a2-5c7a-3bef-9d7c-bf7619d630ee",
                                                "text": "Why, you will allow vs ne're a Iourden, and then we leake in your Chimney: and your Chamber-lye breeds Fleas like a Loach."
                                            },
                                            {
                                                "example_id": "ecbcef19-1540-4a37-89af-56e3d0cd4aab",
                                                "sense_id": "a0e1a3a2-5c7a-3bef-9d7c-bf7619d630ee",
                                                "text": "Occasionally bums passed, Mexican mothers passed with children, and the prowl car came by and the cop got out to leak, but most of the time we were alone and mixing up our souls ever more and ever more till it would be terribly hard to say good-by."
                                            },
                                            {
                                                "example_id": "c76df239-8e5e-47a8-972b-8c313add47d3",
                                                "sense_id": "a0e1a3a2-5c7a-3bef-9d7c-bf7619d630ee",
                                                "text": "Go and find a tree. I just leak against a^([sic]) oak over there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bd62ea6-3a36-3cf7-9525-763967d8c5e3",
                                        "entry_id": "22e11135-b08e-3f19-9c55-8dc203e1b4d9",
                                        "glosses": [
                                            "To bleed."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66c24713-27f5-40d9-954e-993363797277",
                                                "sense_id": "5bd62ea6-3a36-3cf7-9525-763967d8c5e3",
                                                "text": "He shanked him, now he's leaking."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "leak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "804119fa-81d6-3fc0-bd18-b8d15b13a402",
                                        "entry_id": "fea29976-3009-3331-bb35-e67abded360c",
                                        "glosses": [
                                            "Leaky."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95d9ad7f-2e13-4237-a285-ad7f5ea4fd84",
                                                "sense_id": "804119fa-81d6-3fc0-bd18-b8d15b13a402",
                                                "text": "Yet is the bottle leake, and bag so torne, / That all which I put in fals out anon […]."
                                            }
                                        ]
