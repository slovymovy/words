                    {
                        "sense_id": "d1d1774b-1a0c-3a78-a9a0-c678501df55c",
                        "entry_id": "c77d7f5b-3e04-34c2-905d-20ef3d59f1ec",
                        "glosses": [
                            "Créature ou animal légendaire dont l’existence est envisagée au travers de témoignages mais non confirmée par des preuves matérielles, comme le yéti, le monstre du loch Ness ou l’okapi (avant sa description scientifique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f65d512e-7fe3-43a8-b428-b7d5bf190df1",
                                "sense_id": "d1d1774b-1a0c-3a78-a9a0-c678501df55c",
                                "text": "En réalité c’est un cryptide, c’est-à-dire un animal dont on suppose l’existence, sans posséder la moindre preuve de celle-ci."
                            },
                            {
                                "example_id": "b615248d-b1d6-403c-96f3-92012baf79c2",
                                "sense_id": "d1d1774b-1a0c-3a78-a9a0-c678501df55c",
                                "text": "Les cryptides les plus célèbres sont le monstre du loch Ness ou le yéti."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "062a862d-6689-44a6-82b1-45da7c0ea6f2",
                        "source_entry_id": "c77d7f5b-3e04-34c2-905d-20ef3d59f1ec",
