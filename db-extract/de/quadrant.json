                ],
                "senses": [
                    {
                        "sense_id": "3d55ae04-574d-3f42-9ab5-6413af836f9c",
                        "entry_id": "144431ad-d330-3ebb-935e-4c5bcb17528d",
                        "glosses": [
                            "der durch zwei Koordinatenachsen begrenzte Abschnitt einer Ebene"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "9ca065fa-711b-40ac-8b6a-0c55f1dcd6a5",
                                "sense_id": "3d55ae04-574d-3f42-9ab5-6413af836f9c",
                                "text": "„Die y-Koordinate eines Punktes im ersten Quadranten des Einheitskreises entspricht also dem Sinus des Winkels zwischen seinem Ortsvektor und der x-Achse, während die x-Koordinate dem Kosinus des Winkels entspricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1b4e2586-821e-3974-a24a-b3ace94493db",
                        "entry_id": "144431ad-d330-3ebb-935e-4c5bcb17528d",
                        "glosses": [
                            "Viertel eines Kreises"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "4e971408-e80c-3289-bd1c-53783753a94e",
                        "entry_id": "144431ad-d330-3ebb-935e-4c5bcb17528d",
                        "glosses": [
                            "Gerät zur Positionsbestimmung von Gestirnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e63b070-b50f-4254-a53f-6804ac4c0935",
                                "sense_id": "4e971408-e80c-3289-bd1c-53783753a94e",
                                "text": "„Mit dem Quadranten konnte Hainzel 1572 die geographische Breite seines Standortes auf 48 Grad und 22 Bogenminuten bestimmen, ungefähr zwei Kilometer vom tatsächlichen Wert entfernt.“"
                            },
                            {
                                "example_id": "e33bb733-6e3a-42d3-93af-17f7fae66574",
                                "sense_id": "4e971408-e80c-3289-bd1c-53783753a94e",
                                "text": "„Auf seiner Sternwarten-Insel ließ er haushohe Quadranten, Sextanten und Armillarsphären errichten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1406a377-f43f-4563-80b6-d9460d42f93d",
                        "source_entry_id": "144431ad-d330-3ebb-935e-4c5bcb17528d",
                        "source_sense_id": "3d55ae04-574d-3f42-9ab5-6413af836f9c",
