                        "examples": [
                            {
                                "example_id": "48b4f4c6-9320-4606-b78e-4c79449727e6",
                                "sense_id": "d4c16f4b-ab03-3e37-b00f-f9bf984eff97",
                                "text": "he other men were variously burthened; some carrying picks and shovels – for that had been the very first necessary they brought ashore from the Hispaniola – others laden with pork, bread, and brandy for the midday meal."
