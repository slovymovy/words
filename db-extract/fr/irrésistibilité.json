                        "glosses": [
                            "Qualité de ce qui est irrésistible, auquel on ne peut résister."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eb6805b-2a5e-4c8f-87ca-519354915d8d",
                                "sense_id": "31480a43-5c54-391f-8a3c-0fc8d886d4e1",
                                "text": "L’irrésistibilité d’une attaque."
                            },
                            {
                                "example_id": "11e754e3-69f4-4b50-8b5d-3c6b5877f3b7",
                                "sense_id": "31480a43-5c54-391f-8a3c-0fc8d886d4e1",
                                "text": "L’irrésistibilité de la grâce divine est un principe condamné par le concile de Trente."
                            },
                            {
                                "example_id": "6384286a-c294-43d7-b07f-95b671b481de",
                                "sense_id": "31480a43-5c54-391f-8a3c-0fc8d886d4e1",
                                "text": "En matière délictuelle, l’imprévisibilité et l’irrésistibilité du comportement de la victime sont fort bien démontrées."
                            }
                        ]
                    }
