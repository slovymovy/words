                                "target_senses": [
                                    {
                                        "sense_id": "8811dd0d-bcf1-35c1-9beb-fbb7830ac561",
                                        "entry_id": "339ced8e-dca6-38d3-9a74-3ed37da9a61f",
                                        "glosses": [
                                            "Human conduct relative to social norms."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5071d1fd-3044-4036-990f-701d25b7198a",
                                                "sense_id": "8811dd0d-bcf1-35c1-9beb-fbb7830ac561",
                                                "text": "Teachers will probably be on their best behaviour for your visit – but don't be upset if they don't even notice you; they've got enough going on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cc6f410-9d16-3b7a-9243-812992d65680",
                                        "entry_id": "339ced8e-dca6-38d3-9a74-3ed37da9a61f",
                                        "glosses": [
                                            "The way a living creature behaves or acts generally."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5199cf46-c0f3-3507-9647-17392380696c",
                                        "entry_id": "339ced8e-dca6-38d3-9a74-3ed37da9a61f",
                                        "glosses": [
                                            "A state of probation about one's conduct."
                                        ],
