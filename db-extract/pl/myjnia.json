                                    },
                                    {
                                        "sense_id": "f04adccc-2b91-3cf1-b90b-1a791eb4cff6",
                                        "entry_id": "e32b3d4a-517e-330c-b727-58a833bdb431",
                                        "glosses": [
                                            "επαγγελματικός χώρος που αναλαμβάνει έναντι αμοιβής το πλύσιμο των αυτοκινήτων"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79c09480-6269-3769-b761-5e76c8dd4a89",
                                        "entry_id": "e32b3d4a-517e-330c-b727-58a833bdb431",
                                        "glosses": [
                                            "η διαδικασία νομιμοποίησης χρημάτων ή αντικειμένων που αποκτήθηκαν με παράνομο τρόπο"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b892bd3-c3c9-4abf-8fb8-28b6d29f6f81",
                                                "sense_id": "79c09480-6269-3769-b761-5e76c8dd4a89",
                                                "text": "※ Αν πιστέψουμε την επίσημη έκθεση της αμερικανικής Γερουσίας για το σκάνδαλο, η βρετανική υπερτράπεζα είχε εξελιχθεί την τελευταία δεκαετία στο μεγαλύτερο πλυντήριο βρώμικου χρήματος στον κόσμο, αφού οι κατά τόπους θυγατρικές της παρείχαν σε τρομοκράτες, εμπόρους ναρκωτικών και όπλων, αλλά και σε διάφορα άλλα εγκληματικά καρτέλ, πλήρη πρόσβαση στο αμερικανικό τραπεζικό σύστημα. (* εφημερίδα Το Βήμα)"
                                            }
                                        ]
