            {
                "entry_id": "c2304dbe-cd2e-3276-a103-3286a001155f",
                "word": "chocolatière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "77b66169-7211-4799-9009-efbe0836a1a3",
                        "entry_id": "c2304dbe-cd2e-3276-a103-3286a001155f",
                        "tags": [
