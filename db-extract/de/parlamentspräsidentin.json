                        "examples": [
                            {
                                "example_id": "865f5095-3c64-4ba0-864b-bf8a19dac0d2",
                                "sense_id": "4b56b9f6-e091-3fd2-9ce9-b0a5d2a6ea10",
                                "text": "Die Parlamentspräsidentin präsentierte der Öffentlichkeit die Pläne für den Parlamentsumbau."
                            },
                            {
                                "example_id": "7d694bc4-6d7e-49ae-b021-b9a8ab6f4efe",
                                "sense_id": "4b56b9f6-e091-3fd2-9ce9-b0a5d2a6ea10",
                                "text": "„Dass die Europäische Volkspartei, der auch die ÖVP angehört, nun die Parlamentspräsidentin stellt, war Bestandteil eines komplexen Personalpakets nach der Europawahl 2019.“"
                            }
                        ],
