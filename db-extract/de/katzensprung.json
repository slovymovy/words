                ],
                "senses": [
                    {
                        "sense_id": "3ae25589-6821-3043-992e-26a421c46607",
                        "entry_id": "6a9b4398-1e86-3558-a147-2d72b66aeb12",
                        "glosses": [
                            "eine geringe Entfernung, ein kurzer Weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9188a3f4-5c94-4ca5-9a74-475c76b5e8d5",
                                "sense_id": "3ae25589-6821-3043-992e-26a421c46607",
                                "text": "Die Staatsoper ist nur einen Katzensprung von meiner Wohnung entfernt."
                            },
                            {
                                "example_id": "4e3f3d65-e793-4b44-899e-20c5e7d6b521",
                                "sense_id": "3ae25589-6821-3043-992e-26a421c46607",
                                "text": "„Von dort wäre es ein Katzensprung nach Klaksvík auf den Nordinseln, und in dieser Gegend müsste irgendeine Unterkunft zu finden sein.“"
                            },
                            {
                                "example_id": "97a51a7f-7694-489d-a7e9-9e53ca0811df",
                                "sense_id": "3ae25589-6821-3043-992e-26a421c46607",
                                "text": "„Das Ganze ist nicht mehr als ein Katzensprung für einen jungen, frischen Mann, wenn du dich ranhältst, bist du in einer knappen halben Stunde da.“"
                            },
                            {
                                "example_id": "b05a77b5-081c-4ab7-9fb5-42a1e53c5ec4",
                                "sense_id": "3ae25589-6821-3043-992e-26a421c46607",
                                "text": "Vom Marktplatz ist es nur ein Katzensprung bis zum „La Corne d´Or“."
                            },
                            {
                                "example_id": "11837a79-8a9e-45d8-8fe5-2759c81cca7d",
                                "sense_id": "3ae25589-6821-3043-992e-26a421c46607",
                                "text": "Vom Rhein-Main-Gebiet ist es nur ein Katzensprung bis ins Pfälzer Bergland."
                            },
                            {
                                "example_id": "805f790a-923e-4ce8-80b7-01e16a7dff89",
                                "sense_id": "3ae25589-6821-3043-992e-26a421c46607",
                                "text": "Der Atommeiler Beznau ist das dienstälteste Kernkraftwerk der Welt. Das AKW liegt auf einer künstlichen Insel der Aare - einen Katzensprung hinter der Grenze zu Deutschland."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86dc52cb-1bf3-45d8-a9c9-30e7f66245ce",
                        "source_entry_id": "6a9b4398-1e86-3558-a147-2d72b66aeb12",
                        "source_sense_id": "3ae25589-6821-3043-992e-26a421c46607",
                        "source_sense_description": "eine geringe Entfernung, ein kurzer Weg",
                        "target_lang_word": "stone's throw",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stone's throw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3cebbc6-d988-30f2-adf6-51d4a13755fd",
                                        "entry_id": "f6748b44-4bf0-32db-8c5b-2a74c7807cb1",
                                        "glosses": [
                                            "A short distance, roughly equivalent to how far a person can throw a stone."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89807793-3672-4d23-bb99-275ceedbac2f",
                                                "sense_id": "a3cebbc6-d988-30f2-adf6-51d4a13755fd",
                                                "text": "A couple of grown-ups was standing a couple of stone's throws away from us."
                                            },
                                            {
                                                "example_id": "5d8b7260-4820-4063-82ac-e57b42ac034e",
                                                "sense_id": "a3cebbc6-d988-30f2-adf6-51d4a13755fd",
                                                "text": "1 March 2018, Tusdiq Din on BBC Sport, Mohamed Salah: Is Liverpool striker's success improving engagement with Muslim fans?\nA stone's throw from The Hawthorns is Oldbury, home to Baggies fan Ashley Rawlins."
                                            },
                                            {
                                                "example_id": "4f80c042-c020-40d2-aecc-31b144f81cf2",
                                                "sense_id": "a3cebbc6-d988-30f2-adf6-51d4a13755fd",
                                                "text": "He came on looking upon the ground, and did not see Bathsheba till they were less than a stone's throw apart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
