                {
                    "sense_id": "cdecbd2e-51e0-3e2a-9a3e-5984b533b223",
                    "sense_definition": "Insecte nocturne et souvent nuisible qui vit dans les habitations.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "insecte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai allumé la lumière de la cuisine et j'ai vu un gros <w>cafard</w> s'enfuir sous l'évier."
                        },
                        {
                            "text": "Cet immeuble ancien doit être traité régulièrement pour empêcher les <w>cafards</w> de proliférer."
                        }
                    ],
                    "synonyms": [
                        "blatte",
                        "cancrelat",
                        "coquerelle",
                        "ravet",
                        "babarotte"
                    ]
                },
                {
                    "sense_id": "da914cf1-2b48-3386-b046-975e6482316a",
                    "sense_definition": "État de tristesse passagère, de mélancolie ou de découragement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tristesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand le temps est gris et pluvieux, elle a souvent le <w>cafard</w>."
                        },
                        {
                            "text": "Pour chasser le <w>cafard</w>, rien de tel qu'une longue promenade au bord de la mer."
                        }
                    ],
                    "synonyms": [
                        "mélancolie",
                        "spleen",
                        "bourdon",
                        "blues",
                        "noir"
                    ],
                    "common_phrases": [
