{
    "word_family": [
        "bijzetting",
        "bijzetstoel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a93296ad-db01-3587-a38e-e6d285480524",
                    "sense_definition": "iets toevoegen of naast iets anders plaatsen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toevoegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zou je nog een stoel willen <w>bijzetten</w> voor onze extra gast?",
                            "target_lang_translations": {
                                "en": "Would you like to <w>add</w> another chair for our extra guest?"
                            }
                        },
                        {
                            "text": "De ober kwam snel een extra glas <w>bijzetten</w> aan de tafel.",
                            "target_lang_translations": {
                                "en": "The waiter quickly came to <w>put out</w> an extra glass at the table."
                            }
                        }
                    ],
                    "synonyms": [
                        "toevoegen",
                        "bijplaatsen"
                    ],
                    "antonyms": [
                        "wegnemen",
                        "verwijderen"
                    ],
                    "common_phrases": [
                        "een stoel bijzetten",
                        "glazen bijzetten"
                    ],
                    "target_lang_definitions": {
                        "en": "to add something or place it next to something else"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to add",
                                "target_lang_sense_clarification": "to put something extra in a place"
                            },
                            {
                                "target_lang_word": "to put out",
                                "target_lang_sense_clarification": "to place extra items like chairs or glasses"
                            },
                            {
                                "target_lang_word": "to set out",
                                "target_lang_sense_clarification": "to arrange additional items"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bb4238d-571d-30b7-ad71-6421aabcf180",
                    "sense_definition": "een overledene een laatste rustplaats geven, vaak in een graf of crypte",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "begrafenis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd gisteren met een kleine ceremonie <w>bijgezet</w> in het familiegraf.",
                            "target_lang_translations": {
                                "en": "He was <w>interred</w> in the family grave yesterday with a small ceremony."
                            }
                        },
                        {
                            "text": "De overleden koning zal volgende week in de koninklijke crypte worden <w>bijgezet</w>.",
                            "target_lang_translations": {
                                "en": "The deceased king will be <w>entombed</w> in the royal crypt next week."
                            }
                        }
                    ],
                    "synonyms": [
                        "begraven",
                        "ter ruste leggen"
                    ],
                    "common_phrases": [
                        "in een graf bijzetten",
                        "in de crypte bijzetten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in formele of plechtige contexten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to give a deceased person a final resting place, often in a tomb or crypt"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to inter",
                                "target_lang_sense_clarification": "formal term for placing a body in a grave or tomb"
                            },
                            {
                                "target_lang_word": "to entomb",
                                "target_lang_sense_clarification": "to place in a tomb or crypt"
                            },
                            {
                                "target_lang_word": "to lay to rest",
                                "target_lang_sense_clarification": "a respectful way to describe burial"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf2b89ee-c516-3d98-83e8-08342840ae76",
                    "sense_definition": "extra zeilen ontvouwen op een schip om meer wind te vangen en sneller te varen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scheepvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Omdat de wind afzwakte, besloot de kapitein om alle zeilen te <w>bijzetten</w>.",
                            "target_lang_translations": {
                                "en": "Because the wind died down, the captain decided to <w>set</w> all sails."
                            }
                        },
                        {
                            "text": "Er werden nog een aantal zeilen <w>bijgezet</w> om de haven voor de storm te bereiken.",
                            "target_lang_translations": {
                                "en": "A few more sails were <w>unfurled</w> to reach the harbor before the storm."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontvouwen"
                    ],
                    "antonyms": [
                        "strijken"
                    ],
                    "common_phrases": [
                        "zeilen bijzetten",
                        "alle zeilen bijzetten"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specifiek voor de scheepvaart"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to unfurl extra sails on a ship to catch more wind and sail faster"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to set",
                                "target_lang_sense_clarification": "to unfurl or hoist additional sails"
                            },
                            {
                                "target_lang_word": "to crowd on",
                                "target_lang_sense_clarification": "to put up as much sail as possible"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07564c56-7cb6-3217-a3e5-a851aae5cf5d",
                    "sense_definition": "meervoud verleden tijd van <w>bijzetten</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij vertelden dat zij gisteren de extra tafels al <w>bijzetten</w>.",
                            "target_lang_translations": {
                                "en": "They said that they <w>added</w> the extra tables yesterday already."
                            }
                        },
                        {
                            "text": "Het was noodzakelijk dat wij die middag de zeilen <w>bijzetten</w>.",
                            "target_lang_translations": {
                                "en": "It was necessary that we <w>set</w> the sails that afternoon."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammaticale vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural past tense of 'bijzetten'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "added",
                                "target_lang_sense_clarification": "past tense of placing extra items"
                            },
                            {
                                "target_lang_word": "set",
                                "target_lang_sense_clarification": "past tense of unfurling sails"
                            }
                        ]
                    }
                }
            ]
        }
    ]
