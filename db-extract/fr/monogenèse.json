                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "monogenèses"
                    },
                    {
                        "form_id": "04e383e1-bd59-4d7d-9d01-97bb30592025",
                        "entry_id": "97a18ecc-f897-30db-96cc-256588c0b02e",
                        "tags": [
                            "Moins courant"
                        ],
                        "form": "monogénèse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91088df1-d765-3dc8-adbf-63d9bafe9aec",
                        "entry_id": "97a18ecc-f897-30db-96cc-256588c0b02e",
                        "glosses": [
                            "Qui n’offre qu’un seul mode de reproduction, le mode par œufs ou ovules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4609cd0e-d047-4f56-abc4-130f60a6aa9e",
                                "sense_id": "91088df1-d765-3dc8-adbf-63d9bafe9aec",
                                "text": "Les espèces monogenèses."
                            },
                            {
                                "example_id": "c0586437-d0fd-460f-bf99-d6d87a6ff69e",
                                "sense_id": "91088df1-d765-3dc8-adbf-63d9bafe9aec",
                                "text": "Certains trématodes sont monogenèses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18fb1c63-ec37-4174-853b-52f570ecad61",
                        "source_entry_id": "97a18ecc-f897-30db-96cc-256588c0b02e",
                        "source_sense_id": "91088df1-d765-3dc8-adbf-63d9bafe9aec",
                        "target_lang_word": "monogenesis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monogenesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38a65101-840b-322d-b326-e74c84f00d4a",
                                        "entry_id": "722dc9ca-0052-3dfe-b60a-ec09da5f0fa4",
                                        "glosses": [
                                            "The theory that mankind originated with a single ancestor or ancestral couple."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c3a88f1-25fc-49f6-b5c5-d404cef0bdd1",
                                                "sense_id": "38a65101-840b-322d-b326-e74c84f00d4a",
                                                "text": "Some held that negritude was a product of living under the tropical sun, a perhaps beneficial adaptation to a fierce climate – an environmentalist solution chiming with monogenesis and Lockean malleability models."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75a01d4d-0cc2-3f03-a785-7b723de8a014",
                                        "entry_id": "722dc9ca-0052-3dfe-b60a-ec09da5f0fa4",
                                        "glosses": [
                                            "The theory that all languages, or a particular set of languages, originated from a single source."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98eff06c-0ff1-3d87-bd73-dfb63305018e",
                                        "entry_id": "722dc9ca-0052-3dfe-b60a-ec09da5f0fa4",
                                        "glosses": [
                                            "Development of the ovum from a parent like itself."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1edeb9fd-8eb9-3718-b68e-a35ed83b8fb9",
                                        "entry_id": "722dc9ca-0052-3dfe-b60a-ec09da5f0fa4",
                                        "glosses": [
                                            "Development of the ovum from a parent like itself.",
                                            "Asexual/nonsexual reproduction, which involves only one parent."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7143b660-6fa9-3135-8cec-9cae3440537b",
                                        "entry_id": "722dc9ca-0052-3dfe-b60a-ec09da5f0fa4",
                                        "glosses": [
                                            "The emergence from a single cause or origin."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cae2d36-b4f8-4359-a400-e9fa024e345b",
                                                "sense_id": "7143b660-6fa9-3135-8cec-9cae3440537b",
                                                "text": "The view that one parent tale in one fixed location spawned numerous progeny the world over has come to be known as the theory of monogenesis and diffusion. The contrasting theory of polygenesis assumes that resemblances among tales can be attributed to independent invention in places unconnected by trade routes or travel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
