                    {
                        "translation_id": "16ad2fe0-9ded-4ff1-963d-0b12b716f716",
                        "source_entry_id": "04d4dbab-bd44-352d-9d2c-a409f29a0504",
                        "source_sense_id": "b2ca63bb-8347-39af-bff6-ea5d27eb6bd1",
                        "source_sense_description": "alten Schlags, rückwärtsgewandt, überholt",
                        "target_lang_word": "rückwärtsgewandt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rückwärtsgewandt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a1c175c-2fca-395c-9b9f-a5fcef97b27c",
                                        "entry_id": "7ccd6b54-c4c9-30bf-ac05-51d1930158c6",
                                        "glosses": [
                                            "die hintere Seite zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef4ff0e3-d99e-4087-9b9a-fda171ea1a0a",
                                                "sense_id": "3a1c175c-2fca-395c-9b9f-a5fcef97b27c",
                                                "text": "„Sie saß mit anderen jungen Leuten in einer auf und abwogenden Kutsche, entdeckte ihn und winkte ihm rückwärtsgewandt mit der Hand zu.“"
                                            },
                                            {
                                                "example_id": "f980f2b6-b3a2-4394-9acb-ab2c9aaac2b2",
                                                "sense_id": "3a1c175c-2fca-395c-9b9f-a5fcef97b27c",
                                                "text": "„[…] er sah, wie der Atem sich in Rauch verwandelte, dann wiederholte er den Satz, halb rückwärtsgewandt, und sah noch deutlicher den Kältedampf des Atems.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b107ebdb-1f22-3d31-89f8-c32490759248",
                                        "entry_id": "7ccd6b54-c4c9-30bf-ac05-51d1930158c6",
                                        "glosses": [
                                            "auf eine zurückliegende Zeit gerichtet, auf einen vergangenen Zustand bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9383b562-9586-4bb6-a757-2e20d55212aa",
                                                "sense_id": "b107ebdb-1f22-3d31-89f8-c32490759248",
                                                "text": "„Dieses Bild scheint sehr rückwärtsgewandt zu sein und ist tatsächlich dem mittelalterlichen Frauenbild in seinen Grundzügen nicht unähnlich.“"
                                            },
                                            {
                                                "example_id": "091ac138-ca8c-4dce-970a-a1055587418a",
                                                "sense_id": "b107ebdb-1f22-3d31-89f8-c32490759248",
                                                "text": "„Organisationen und Institutionen, die als rückwärtsgewandt und fortschrittsfeindlich wahrgenommen werden, bekommen zwangsläufig Legitimierungsprobleme.“"
                                            },
                                            {
                                                "example_id": "195c86e1-5f75-4fb9-8634-b2c163291438",
                                                "sense_id": "b107ebdb-1f22-3d31-89f8-c32490759248",
                                                "text": "„Liberale Katholiken kritisieren, dass der eher konservative Franziskus durch dieses Projekt in der Öffentlichkeit das Bild einer rückwärtsgewandten katholischen Kirche bestätigen würde.“"
                                            },
                                            {
                                                "example_id": "bcf08778-26d0-4eb3-a708-fc861efa2bb4",
                                                "sense_id": "b107ebdb-1f22-3d31-89f8-c32490759248",
                                                "text": "„In der Sozialpartnerorganisation Landwirtschaftskammer und im diese Kammer dominierenden ÖVPBauernbund – die wahrscheinlich rückwärtsgewandtesten Organisationen dieses Landes – findet man das offenbar ganz normal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57c904e2-3b50-4ac2-a7af-ed31790a7c6e",
                        "source_entry_id": "04d4dbab-bd44-352d-9d2c-a409f29a0504",
                        "source_sense_id": "b2ca63bb-8347-39af-bff6-ea5d27eb6bd1",
                        "source_sense_description": "alten Schlags, rückwärtsgewandt, überholt",
                        "target_lang_word": "überholt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überholt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d6aa86a-f7c7-3107-8aa0-aae8be3f111a",
                                        "entry_id": "ca5e8588-1d12-353e-8a36-5507b837ec25",
                                        "glosses": [
                                            "nicht den jeweiligen Bedingungen der aktuellen Zeit entsprechend, durch Änderung der Verhältnisse oder Weiterentwicklung/Zugewinn an Kenntnissen; nur in einer vergangenen Zeit gültig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f7130bc-c1a3-4698-b215-6259617826b6",
                                                "sense_id": "6d6aa86a-f7c7-3107-8aa0-aae8be3f111a",
                                                "text": "„Die Ordnungsökonomik sei wegen ihrer mangelnden mathematischen Fundierung in Verbindung mit der mangelnden Rezeption moderner mikroökonomischer Ansätze […] ein überholtes Forschungsprogramm.“"
                                            },
                                            {
                                                "example_id": "1c545698-6b03-4e5b-b160-ef29f4d1cf76",
                                                "sense_id": "6d6aa86a-f7c7-3107-8aa0-aae8be3f111a",
                                                "text": "„In den Zukunftslaboren des Silicon Valleys wirkt der Tod noch überholter und unzeitgemäßer als anderswo.“"
                                            },
                                            {
                                                "example_id": "e83e74ff-24d4-4bcd-ae3a-075c9f14785c",
                                                "sense_id": "6d6aa86a-f7c7-3107-8aa0-aae8be3f111a",
                                                "text": "„Der Vorreiter dieser Entwicklung ([Verbindung von Städten durch Ferverkehr]) waren nicht Flugzeug oder Auto, sondern das vermeintlich überholteste Transportsystem: die Bahn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc8082e9-8820-391c-a493-c3206490ee80",
                                        "entry_id": "ca5e8588-1d12-353e-8a36-5507b837ec25",
                                        "glosses": [
                                            "insgesamt kontrolliert und gepflegt/gegebenenfalls repariert/erneuert und so vollständig gebrauchsfertig gemacht"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e6befd4-161b-4d8f-97bd-9679502989d2",
                                                "sense_id": "fc8082e9-8820-391c-a493-c3206490ee80",
                                                "text": "„Für den Einlauf neuer oder überholter Motoren Erstbetriebsöl […] verwenden.“ (freier Infinitiv mit anordnender Bedeutung)"
                                            },
                                            {
                                                "example_id": "057fdb00-ac21-4c41-ac5f-19c675cd11cc",
                                                "sense_id": "fc8082e9-8820-391c-a493-c3206490ee80",
                                                "text": "„Allerdings modifizierte die UCI in der Folge wiederholt Einzelheiten der Rangliste, […]. Am 20. Februar 2024 veröffentlichte die UCI ein nochmals überholtes Ranking, in dem Russland und China die Plätze tauschten.“"
                                            },
                                            {
                                                "example_id": "b47e424d-523c-43fc-980c-d407202801cd",
                                                "sense_id": "fc8082e9-8820-391c-a493-c3206490ee80",
                                                "text": "„Gemäß § 13 Absatz 1 AKB besteht […] nur Anspruch auf den Einbau gleichwertiger (also gebrauchter und überholter) Anlagen.“"
                                            },
                                            {
                                                "example_id": "8914719f-68b3-4d3f-a69d-ef489f5e1caa",
                                                "sense_id": "fc8082e9-8820-391c-a493-c3206490ee80",
                                                "text": "„Lisa ist Veganerin und umweltbewusst. Ihr Auto ist ein kleiner, effizienter E-Wagen […] und ihr Smartphone ist ein überholtes, gebrauchtes Gerät.“"
                                            },
                                            {
                                                "example_id": "9472a4c6-1707-4c83-8e94-3284b0b3b078",
                                                "sense_id": "fc8082e9-8820-391c-a493-c3206490ee80",
                                                "text": "„Oma Finchen ist umweltbewusst und Nachhaltigkeit ist für sie kein Fremdwort. Darum soll Heinzi ein gebrauchtes und überholtes Handy mit dreijähriger Garantie by Rebuy im Internet kaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d194fd62-66ae-3830-a376-d692f6dc8eee",
                                        "entry_id": "ca5e8588-1d12-353e-8a36-5507b837ec25",
                                        "glosses": [
                                            "auf derselben Strecke von sich in gleicher Richtung bewegendem Objekt durch höhere Geschwindigkeit passiert"
                                        ],
                                        "tags": [
                                            "no-comparative",
                                            "rare",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "852984b6-4d3b-4f2f-85a3-6d93710c761f",
                                                "sense_id": "d194fd62-66ae-3830-a376-d692f6dc8eee",
                                                "text": "„Bleibt der Überholer berechtigt auf der linken Seite, ist der Überholvorgang dann als beendet anzusehen, sobald er vor dem überholten Fahrzeug einen Abstand gewonnen hat, […]“"
                                            },
                                            {
                                                "example_id": "fb228c23-87e6-4fd4-8ac6-5b05b6f09a6d",
                                                "sense_id": "d194fd62-66ae-3830-a376-d692f6dc8eee",
                                                "text": "„Wenn ein Dampfschiff einem anderen, das den gleichen Kurs hat […], vorfährt, geschieht das Vorfahren unter Ausweichen nach rechts, so daß das überholte Schiff links bleibt.“"
                                            },
                                            {
                                                "example_id": "3b3b9710-52e6-4643-9019-f1ec63686af1",
                                                "sense_id": "d194fd62-66ae-3830-a376-d692f6dc8eee",
                                                "text": "„Der überholte Mercedes-Fahrer durchlöcherte den Kleinbus mit Pistolenschüssen.“"
                                            },
                                            {
                                                "example_id": "25581f66-0a0d-4a8b-83fc-d75440eee7d9",
                                                "sense_id": "d194fd62-66ae-3830-a376-d692f6dc8eee",
                                                "text": "„Demselben ist […] beizustimmen, daß einem überholenden Schiffe nur zur Pflicht gemacht werden kann, das überholte Schiff in einer Entfernung zu passieren, welche die Gefahr einer Collision […] ausschließt.“"
                                            },
                                            {
                                                "example_id": "3be89c20-7bb8-404b-b796-ac4338311f0e",
                                                "sense_id": "d194fd62-66ae-3830-a376-d692f6dc8eee",
                                                "text": "„Beim Überholen auf AB mit 120 km/h ist Einscheren in Lücke von 200 m nicht notw., wenn überholtes Fzg mit 100 km/h fährt […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
