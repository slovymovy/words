                    {
                        "sense_id": "d292a97a-2309-3f73-969d-c02afbe939d6",
                        "entry_id": "bb9632bf-2ac9-3e68-aa78-0fbe29f95671",
                        "glosses": [
                            "Any of many needle-like crystalline structures that provide skeletal support in marine invertebrates like sponges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a6b74ed-9c5f-4800-8545-55615157d739",
                                "sense_id": "d292a97a-2309-3f73-969d-c02afbe939d6",
                                "text": "Tear it up, and put a fragment under the microscope, and, wonder of wonders! see the maze of geometric forms exhibited in the bones of the creature; for who can help regarding the spicules as bones, even though a sponge be invertebrate?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b6479c7b-be21-35bb-8beb-8454f0528c23",
                        "entry_id": "bb9632bf-2ac9-3e68-aa78-0fbe29f95671",
                        "glosses": [
                            "A needle-like mating structure found only in male nematodes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4e00bbf8-ec69-3d35-bad1-ff2e4836f93e",
                        "entry_id": "bb9632bf-2ac9-3e68-aa78-0fbe29f95671",
                        "glosses": [
                            "A jet of matter ejected from the photosphere of the sun."
