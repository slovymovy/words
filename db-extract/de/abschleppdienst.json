                "senses": [
                    {
                        "sense_id": "4d82bc4a-f9ca-364b-9d1e-b0be30a1115d",
                        "entry_id": "de767368-aaaa-33b5-b671-86555feeff39",
                        "glosses": [
                            "Betrieb, der darauf spezialisiert ist, liegengebliebene Fahrzeuge zu entfernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "704e4432-cd49-4e79-82c8-1c06b26f2332",
                                "sense_id": "4d82bc4a-f9ca-364b-9d1e-b0be30a1115d",
                                "text": "Der Abschleppdienst musste kommen und mein Auto zur Werkstatt bringen."
                            },
                            {
                                "example_id": "5e562101-1f4e-4f05-b423-3dd5ead78678",
                                "sense_id": "4d82bc4a-f9ca-364b-9d1e-b0be30a1115d",
                                "text": "„Die meisten Falschparker zahlen fürs Abschleppen, um ihr Auto schnell wiederzubekommen - ein Mann aber wehrte sich gegen die nach seiner Ansicht zu hohe Forderung eines privaten Abschleppdienstes.“"
                            },
                            {
                                "example_id": "870925bd-c627-41b0-b034-daa992f5bb8a",
                                "sense_id": "4d82bc4a-f9ca-364b-9d1e-b0be30a1115d",
                                "text": "„Zu allem Überfluss hatten wir in dem Sturm keinen Handyempfang, um einen Abschleppdienst zu rufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
