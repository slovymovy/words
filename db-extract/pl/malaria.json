                                "target_senses": [
                                    {
                                        "sense_id": "dc6a5625-8c0e-3370-af92-addb6a7b29ef",
                                        "entry_id": "ce06f448-2e4d-3288-b51e-cc4498c1a1bf",
                                        "glosses": [
                                            "Enfermedad producida por el parásito (vector de la malaria) Plasmodium. Los síntomas son muy variados, empezando con fiebre 8 a 30 días posteriores a la infección y acompañada, o no, de dolor de cabeza, musculares, diarrea, decaimiento y tos."
                                        ],
                                        "tags": [
                                            "Enfermedades",
                                            "últimamente",
                                            "especialmente por influencia del inglés",
                                            "el uso de este vocablo es más habitual que el de paludismo"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e8403c2-23c3-3291-bc6d-884f71ec7fab",
                                        "entry_id": "ce06f448-2e4d-3288-b51e-cc4498c1a1bf",
                                        "glosses": [
                                            "Pobreza, falta de lo necesario para subsistir."
                                        ],
                                        "tags": [
                                            "Río-de-la-Plata"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0d473fc8-30e9-3ad7-8715-e5ae57342b0c",
                                        "entry_id": "ce06f448-2e4d-3288-b51e-cc4498c1a1bf",
                                        "glosses": [
                                            "Mala racha, período en que suceden hechos desafortunados."
                                        ],
                                        "tags": [],
