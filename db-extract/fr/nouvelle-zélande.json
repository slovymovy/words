                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0848c07c-f52b-4c92-8fd0-7969c4186564",
                                "sense_id": "003c31dd-fd34-313a-b44b-1ce1756c7659",
                                "text": "La Nouvelle-Zélande est composée de deux îles principales : l'île du Nord et l'île du Sud.",
                                "translation": "Nowa Zelandia składa się z dwóch głównych wysp: Wyspy Północnej i Wyspy Południowej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9126f506-ae13-34e6-80a4-e8b6c7145746",
                        "entry_id": "ac4ca39f-a6f5-38d2-ba79-6b9f8687345f",
