                    },
                    {
                        "translation_id": "a12820df-52d3-4826-8b44-ad0b2fcac07f",
                        "source_entry_id": "d10fc33d-0dd1-34d5-b327-a0ce795bebff",
                        "source_sense_id": "fb9a73da-a767-3a3d-9402-51c1bdfd4645",
                        "source_sense_description": "ein Bereich in einer Stadt, der nur für Fußgänger bestimmt ist",
                        "target_lang_word": "voetgangerszone",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voetgangerszone",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1e9c06dd-82cb-3107-9851-ab6c52e38a3d",
                                        "entry_id": "1e02577a-2427-3583-b489-accd15bce3d1",
                                        "glosses": [
                                            "deel van een stad of dorp dat alleen toegankelijk is voor voetgangers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d018a7d6-a9fc-4cf7-adda-eceee7e26c58",
                                                "sense_id": "1e9c06dd-82cb-3107-9851-ab6c52e38a3d",
                                                "text": "Daarnaast is er vorig jaar in het centrum een nieuwe voetgangerszone ingesteld waardoor er volgens ondernemers veel klandizie is verdwenen. En dan zijn er ook nog enkele tunnels gesloten die cruciaal zijn voor de bereikbaarheid van het centrum. \"Daardoor blijven mensen uit buitenwijken weg, ze kunnen eenvoudigweg het centrum nauwelijks meer bereiken\", zegt Van Muylders."
                                            },
                                            {
                                                "example_id": "ea269e88-22f2-4c82-a98f-05347640a26e",
                                                "sense_id": "1e9c06dd-82cb-3107-9851-ab6c52e38a3d",
                                                "text": "Doyle zag vanuit het gemeentehuis dat de politie een man in een auto achtervolgde en dat de bestuurder een straat inreed die was afgesloten voor verkeer. \"Tot ons afgrijzen reed hij toen het voetpad op.\" De voetgangerszone was op dat moment extra druk vanwege lunchtijd, zegt hij."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
