                "senses": [
                    {
                        "sense_id": "52a169f4-1c7c-3c89-acec-d0bba74c71a9",
                        "entry_id": "ea7b64c1-a087-3d39-aeb4-775821983441",
                        "glosses": [
                            "Donner un caractère plurilingue à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17a65266-0583-4c87-96df-179eb645541f",
                                "sense_id": "52a169f4-1c7c-3c89-acec-d0bba74c71a9",
                                "text": "En déclarant cela, elle se 'plurilinguise' tout en restant fidèle aux différences stylistiques de langage tenu par chacun des sujets narratifs dans leurs textes respectifs."
                            },
                            {
                                "example_id": "393c9547-be73-48e2-af02-8cb2cc9876bf",
                                "sense_id": "52a169f4-1c7c-3c89-acec-d0bba74c71a9",
                                "text": "Espérons que la fermeté du propos portera ses fruits, et qu'on hésitera désormais à qualifier de gaddien, par un bel automatisme, tout ce qui, dans la jeune littérature de l'autre côté des Alpes, boursoufle et se « plurilinguise »."
                            },
                            {
                                "example_id": "ec1cca6e-f766-4482-9ea6-6f2bd8b200f2",
                                "sense_id": "52a169f4-1c7c-3c89-acec-d0bba74c71a9",
                                "text": "le JE s'est \"plurilinguisé\"."
                            }
                        ]
                    }
