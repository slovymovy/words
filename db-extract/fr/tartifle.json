                "senses": [
                    {
                        "sense_id": "86388d03-8971-3fed-99d2-47c4461a132b",
                        "entry_id": "ce5be29a-97c4-365b-8054-ad796b28ce47",
                        "glosses": [
                            "Pomme de terre."
                        ],
                        "tags": [
                            "Savoie"
                        ],
                        "examples": [
                            {
                                "example_id": "be86a0d4-076c-4990-8b89-0abc6cfaea6b",
                                "sense_id": "86388d03-8971-3fed-99d2-47c4461a132b",
                                "text": "Tous les paysans montagnards accommodaient en effet à peu près de la même façon ce genre de plat roboratif, puisqu’ils disposaient des mêmes ingrédients de base : fromage, lard et tartifles, autrement dit les pommes de terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "73864bdb-325d-3841-b85e-6e1b29d82f24",
                        "entry_id": "ce5be29a-97c4-365b-8054-ad796b28ce47",
                        "glosses": [
                            "Nom vernaculaire du topinambour."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "418f3e44-66be-44eb-82d5-69b601118c2a",
                        "source_entry_id": "ce5be29a-97c4-365b-8054-ad796b28ce47",
                        "target_lang_word": "Erdapfel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdapfel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cdd58390-eddf-3a57-b299-17d202d8be96",
                                        "entry_id": "d00c2697-087d-3476-82f1-9e9264522c1e",
                                        "glosses": [
                                            "Kartoffel"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad6a916b-5aac-4130-b2ff-6704b300a0fb",
                                                "sense_id": "cdd58390-eddf-3a57-b299-17d202d8be96",
                                                "text": "„So saß er denn eine Weile und ließ sich den durchzogenen Schweinespeck mit entschälten und geschwellten Erdäpfeln und einem nachfolgenden Becken voll überquellenden Schlagrahms, mit dem Sigristen und den zwei Knaben wohlschmecken.“"
                                            },
                                            {
                                                "example_id": "8a82acac-4bb4-475f-a49e-d78d7092eab2",
                                                "sense_id": "cdd58390-eddf-3a57-b299-17d202d8be96",
                                                "text": "Für die Zubereitung von Erdäpfelgulasch benötigt man Erdäpfel."
                                            },
                                            {
                                                "example_id": "4ef0bf54-9822-4776-8d7f-1d7d0123aa59",
                                                "sense_id": "cdd58390-eddf-3a57-b299-17d202d8be96",
                                                "text": "„Aber als sie die Erdäpfel mit großer Mühe und Vorsicht in ihrem Kochgeschirr gekocht hatten und anfangen wollten zu schmausen - nach Mitternacht bei einer winzigen Kerze und abgeblendeten Fenstern -, da kam ein niederträchtiger Unteroffizier, der sie überraschte (die anderen Spinner wußten alle Bescheid, aber sie drückten beide Augen zu) und die Geschichte zur Meldung brachte.“"
                                            },
                                            {
                                                "example_id": "311bedab-cbb3-48b7-8560-6805daf111c9",
                                                "sense_id": "cdd58390-eddf-3a57-b299-17d202d8be96",
                                                "text": "„Trotzdem hatte sie nicht erwartet, dass sie eines Morgens, Jänner oder Feber, in die Küche käme, dort Rüben und Erdäpfel auf dem Arbeitstisch vorfände und die ihr von hier auf jetzt unerträglich würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ff12af5-3f38-4fbb-9ec0-a9c703e90c62",
                        "source_entry_id": "ce5be29a-97c4-365b-8054-ad796b28ce47",
                        "target_lang_word": "Kartoffel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kartoffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "094f6f03-bcb2-3604-8095-f505a65a3037",
                                        "entry_id": "0540ce35-690e-3c43-8dcf-26d8c06ada06",
                                        "glosses": [
                                            "eine Nutzpflanze mit weiß-bläulichen Blüten und grünen Beeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70657541-c5f6-4eb0-a059-d198ae6125f3",
                                                "sense_id": "094f6f03-bcb2-3604-8095-f505a65a3037",
                                                "text": "Man pflanzet die Kartoffel nicht, / Damit sie Blatt und Blüten bringe / Doch ist das, was sie treibt ans Licht, / Bedingung, daß sie selbst gelinge."
                                            },
                                            {
                                                "example_id": "ed82dc13-df2c-4df0-bc16-fce168e605ba",
                                                "sense_id": "094f6f03-bcb2-3604-8095-f505a65a3037",
                                                "text": "„Auf terrassenförmig angelegten Feldern werden Kartoffeln und Gemüse angebaut sowie Heu geerntet.“"
                                            },
                                            {
                                                "example_id": "5fa405ae-e6ef-4ae8-b5e7-2060b3f264a7",
                                                "sense_id": "094f6f03-bcb2-3604-8095-f505a65a3037",
                                                "text": "„Der Anbau von Gerste, Zuckerrüben, Sonnenblumen, Faserflachs und Rotklee ist in den letzten Jahrzehnten auf Kosten von Hafer, Futterrüben und Kartoffeln erweitert worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "77791394-8665-3743-aad6-3a02ba6df757",
                                        "entry_id": "0540ce35-690e-3c43-8dcf-26d8c06ada06",
                                        "glosses": [
                                            "essbare Knolle der gleichnamigen Pflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81d917d8-e138-40d8-964d-36ed30ffea68",
                                                "sense_id": "77791394-8665-3743-aad6-3a02ba6df757",
                                                "text": "Dennoch erinnere ich mich gar wohl, daß ich erst volle vierzig Jahre später, also 1785 etwa, bei Stargard zu meiner Verwunderung die ersten Kartoffeln im freien Felde ausgesetzt gefunden habe."
                                            },
                                            {
                                                "example_id": "8355778e-50d3-46d7-a113-3db7dfec5c94",
                                                "sense_id": "77791394-8665-3743-aad6-3a02ba6df757",
                                                "text": "„Im Keller roch es nach Kartoffeln und ausgetrunkenen Weinflaschen.“"
                                            },
                                            {
                                                "example_id": "cbac93a2-3b46-4e6a-8c1b-bb66295b4de7",
                                                "sense_id": "77791394-8665-3743-aad6-3a02ba6df757",
                                                "text": "Das deutsche Wort Kartoffel klingt weniger elegant als die botanische, lateinische Bezeichnung [Solanum tuberosum]. Ähnlich verhält es sich mit dem Wort Erdapfel."
                                            },
                                            {
                                                "example_id": "7ea424ea-3e77-4181-87af-5ef9c68c5121",
                                                "sense_id": "77791394-8665-3743-aad6-3a02ba6df757",
                                                "text": "„Doch zu einem geringen Maße bauen sie auch Kartoffeln an und halten Kleinvieh wie Hühnern und Schweine, landwirtschaftliche Techniken, die sie von ihren Nachbarn, den Aymará übernommen haben“."
                                            },
                                            {
                                                "example_id": "ab6d78cd-905a-4958-a1b8-9c06b4e5ffc1",
                                                "sense_id": "77791394-8665-3743-aad6-3a02ba6df757",
                                                "text": "„Dass die Kartoffel schließlich nach Europa kam, ist vermutlich den Spaniern zu verdanken. Im Jahr 1565 wurde eine Kiste der Knollen an den spanischen König Phillip II. geschickt […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ab570f69-9a53-3df8-8f14-1d8c615c3bf4",
                                        "entry_id": "0540ce35-690e-3c43-8dcf-26d8c06ada06",
                                        "glosses": [
                                            "Knollennase"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "445cc6cb-8619-45d5-96f3-88ca70c6f79a",
                                                "sense_id": "ab570f69-9a53-3df8-8f14-1d8c615c3bf4",
                                                "text": "Er besaß auch nicht die Nase Lord Henrys, jene berühmte rötliche Kartoffel, welche nach der Versicherung eines frivolen Franzosen einzig und allein von der großen Erdäpfelseuche des Jahres 1845 verschont geblieben sein soll – nein, der Buchhalter Lenz besaß seine eigene Nase, er konnte sich bei seiner eigenen Nase ziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a8d74167-cbfe-3b1a-bf9f-c1f613b05baf",
                                        "entry_id": "0540ce35-690e-3c43-8dcf-26d8c06ada06",
                                        "glosses": [
                                            "Taschenuhr"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e640d4-242b-446c-b5bf-f653ed314633",
                                                "sense_id": "a8d74167-cbfe-3b1a-bf9f-c1f613b05baf",
                                                "text": "Wirf mal einen Blick auf deine Kartoffel!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "5b962dab-5009-3aba-b332-7757e7380ecd",
                                        "entry_id": "0540ce35-690e-3c43-8dcf-26d8c06ada06",
                                        "glosses": [
                                            "großes Loch im Strumpf"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "873b2427-0dbd-47a3-8df1-6baed6f57a97",
                                                "sense_id": "5b962dab-5009-3aba-b332-7757e7380ecd",
                                                "text": "So eine Kartoffel kann doch kein Mensch mehr stopfen!"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
