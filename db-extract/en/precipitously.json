                "senses": [
                    {
                        "sense_id": "f4753c82-d256-39ef-9815-ca127c97589a",
                        "entry_id": "e2c65a96-4cb9-3585-b6fd-201e11ef177e",
                        "glosses": [
                            "In a precipitous manner.",
                            "Abruptly; quickly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12977539-b014-4ac3-be94-97f79f711e24",
                                "sense_id": "f4753c82-d256-39ef-9815-ca127c97589a",
                                "text": "Population dropped to the lowest point in five millennia. State resources declined precipitously. In many strategic and formerly prosperous areas, there were tax revenue losses of 90 percent or more in less than a single lifetime."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9291605-f382-34ba-84e8-08fe236a6d48",
                        "entry_id": "e2c65a96-4cb9-3585-b6fd-201e11ef177e",
                        "glosses": [
                            "In a precipitous manner.",
                            "At a sharp upwards angle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98542cf8-fb92-47e2-ab7c-832de8a666c5",
                                "sense_id": "c9291605-f382-34ba-84e8-08fe236a6d48",
                                "text": "Never will I visit it again; it is a place of evil omen.' After a very brief halt for breakfast we pressed on with such good will that by two o'clock in the afternoon we were at the foot of the vast wall of rock that formed the lip of the volcano, and which at this point towered up precipitously above us for fifteen hundred or two thousand feet."
                            },
                            {
                                "example_id": "c09a386a-113b-49fa-87ab-0cb130c41d85",
                                "sense_id": "c9291605-f382-34ba-84e8-08fe236a6d48",
                                "text": "On all sides, wild mountains rise precipitously above wooded nullahs, and we have a clear view, to the right, of the famous Amah Rock, with its singular resemblance to a Chinese woman carrying her baby on her back in the traditional fashion."
                            }
                        ]
                    }
                ],
