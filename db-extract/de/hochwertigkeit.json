                                        "sense_id": "aa6a61e5-f207-3962-bb84-d94bc600ce3c",
                                        "entry_id": "572710c7-9458-326f-b7f3-ecff3fd7c8ec",
                                        "glosses": [
                                            "The degree or property of being exquisite."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9518e046-765f-42aa-8979-9339dcb3dc2e",
                                                "sense_id": "aa6a61e5-f207-3962-bb84-d94bc600ce3c",
                                                "text": "One horror of motherhood lies in the moments when she can see both the exquisiteness of her child and his utter inconsequence to others."
                                            }
