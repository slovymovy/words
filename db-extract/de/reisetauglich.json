                    {
                        "form_id": "b7351e48-5b7b-483a-87f6-0e48bddf0d40",
                        "entry_id": "2c4a3946-dd4f-354b-8066-84aed1ad4bbc",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind reisetauglich"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f0071dc3-d595-3512-95c1-5d9aac65c0b4",
                        "entry_id": "2c4a3946-dd4f-354b-8066-84aed1ad4bbc",
                        "glosses": [
                            "in der Lage, zu reisen; für die Reise bereit/geeignet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70c04774-5468-4d13-8e36-31663f30cca9",
                                "sense_id": "f0071dc3-d595-3512-95c1-5d9aac65c0b4",
                                "text": "„Barfuß tänzelte ich ins Badezimmer, wo ich mich mit Schlabberpulli und Leggings einigermaßen reisetauglich herrichtete, denn möglichst bequem musste es sein für den langen Flug.“"
                            },
                            {
                                "example_id": "a5d77bc9-bb88-4e77-a958-638194bbb982",
                                "sense_id": "f0071dc3-d595-3512-95c1-5d9aac65c0b4",
                                "text": "„Sie sollten sicherstellen, dass Ihr Haustier alle erforderlichen Impfungen hat und reisetauglich ist.“"
                            },
                            {
                                "example_id": "354b4e8a-89c6-426d-9c5c-b3996011cc75",
                                "sense_id": "f0071dc3-d595-3512-95c1-5d9aac65c0b4",
                                "text": "„Ein geländegängiges Motorrad musste gekauft und mit Koffern und sonstigem Zubehör reisetauglich aufgerüstet werden.“"
                            },
                            {
                                "example_id": "598c5f49-f328-400b-a712-6bb6c91c8540",
                                "sense_id": "f0071dc3-d595-3512-95c1-5d9aac65c0b4",
                                "text": "„Sie braucht keine Verpackung, Bananen sind handlich, reisetauglich und auch umweltfreundlich.“"
                            },
                            {
