                "senses": [
                    {
                        "sense_id": "ee19e9a2-b0c1-395a-aca2-3fd4e72030ef",
                        "entry_id": "06f1c6fc-7724-3155-af99-915f6d40d77c",
                        "glosses": [
                            "eine unvorstellbar große Zahl oder Menge"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "02c1a0f6-e6f6-43b4-a7bb-e0e03dfbbc7e",
                                "sense_id": "ee19e9a2-b0c1-395a-aca2-3fd4e72030ef",
                                "text": "„Zu diesem Zweck wird der Bund eine Fantastillion Schutzmasken und weiteres medizinisches Material einkaufen, bevorraten und frisch halten.“"
                            },
                            {
                                "example_id": "883972da-ddbf-4585-96f6-9413eb083e38",
                                "sense_id": "ee19e9a2-b0c1-395a-aca2-3fd4e72030ef",
                                "text": "„Wo hat der eigentlich sein ganzes Geld her? Onkel Dagobert ist fraglos der reichste Erpel der Welt, für sein ungeheures Vermögen wurde eigens die Zähleinheit „Fantastillion“ eingeführt.“"
                            },
                            {
                                "example_id": "2bb7c5ec-f8cd-41ee-84db-e89fe8dfc853",
                                "sense_id": "ee19e9a2-b0c1-395a-aca2-3fd4e72030ef",
                                "text": "„In Griechenland läuft schon ein Künstlerwettbewerb für die Gestaltung einer Fantastillion-Euro-Münze anlässlich des ersten Jahrestages des IWF-Schuldenerlasses.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
