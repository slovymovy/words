                ],
                "senses": [
                    {
                        "sense_id": "34033497-7722-3a55-85e2-0606c05755f4",
                        "entry_id": "781ed27c-442b-3d45-a356-6ba01bd27472",
                        "glosses": [
                            "verkrümmte Wirbelsäule bei Frauen höheren Alters, die durch den Abbau von Knochensubstanz zustande kommt"
                        ],
                        "tags": [
                            "volkstümlich"
                        ],
                        "examples": [
                            {
                                "example_id": "105be6a6-5c3a-4a0d-a0f0-735be627700a",
                                "sense_id": "34033497-7722-3a55-85e2-0606c05755f4",
                                "text": "„Im Netz kursiert gelegentlich, dass der Witwenbuckel eigentlich ein Rundrücken sei, doch diese Behauptung ist vergleichbar mit Fake News.“"
                            },
                            {
                                "example_id": "cbcf0784-5dd1-48dd-8be8-0f29f46c7338",
                                "sense_id": "34033497-7722-3a55-85e2-0606c05755f4",
                                "text": "„Diese dauerhafte Muskelanspannung sorgt nun dafür, dass sich die Wirbel in diesem Bereich verschieben und einen Buckel ausbilden, der bei fehlender Korrektur im Alter zu einem so genannten Witwenbuckel werden kann.“"
                            },
                            {
                                "example_id": "ccbe34a9-1773-4531-881f-a0eacc2bc33d",
                                "sense_id": "34033497-7722-3a55-85e2-0606c05755f4",
                                "text": "„Eine ergraute Alte mit Witwenbuckel und zotteligem Rock, mit trüber Brille auf der Nase und knochigen Fingern, die mehr drohen als locken?“"
                            },
                            {
                                "example_id": "b9a408b2-40b1-4d84-b0a7-7e43443f36a7",
                                "sense_id": "34033497-7722-3a55-85e2-0606c05755f4",
                                "text": "„Durch den ausgeprägten Witwenbuckel ragte ihr Kopf fast horizontal zwischen den Schultern hervor.“"
                            },
                            {
                                "example_id": "e7038bca-d156-4b76-bff9-23f9093f71b1",
                                "sense_id": "34033497-7722-3a55-85e2-0606c05755f4",
                                "text": "„Auf einen Stock gestützt, vom Witwenbuckel nach vorn geneigt, so hob sie den Kopf und erblickte den Mann, der mit schwerfälligen Schritten daherkam, wankend und doch das Kind fest auf den Armen tragend.“"
                            },
                            {
                                "example_id": "3c653069-a483-4512-bd47-ccaaf1ae5211",
                                "sense_id": "34033497-7722-3a55-85e2-0606c05755f4",
                                "text": "„Das Erheben von ihrem Platz bereitete ihr sichtlich Mühe, denn ein ausgeprägter Witwenbuckel machte das vollständige Aufrichten unmöglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
