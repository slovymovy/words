                                        "entry_id": "c70e4704-5134-32d1-b499-1ffe2d6f19b7",
                                        "glosses": [
                                            "In a close manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd53b06-2e83-4be3-9990-3b9552f2ab03",
                                                "sense_id": "544e8394-bdcb-3847-bc29-3f1aae2cde1a",
                                                "text": "Test large, cylindrical, early portion closely coiled and always completely involute, later and larger portion uncoiled[…]"
                                            },
                                            {
                                                "example_id": "edc4b529-5e4b-408b-b80e-c21e932f1fc6",
                                                "sense_id": "544e8394-bdcb-3847-bc29-3f1aae2cde1a",
                                                "text": "Finnish and Estonian are closely related languages."
                                            },
                                            {
                                                "example_id": "d8b7f569-46bd-483a-a726-74897bd49a9a",
                                                "sense_id": "544e8394-bdcb-3847-bc29-3f1aae2cde1a",
                                                "text": "The borderline between East and West Berlin was very closely guarded."
                                            },
                                            {
                                                "example_id": "70396121-2814-495e-aa37-1684e6aee1d2",
                                                "sense_id": "544e8394-bdcb-3847-bc29-3f1aae2cde1a",
                                                "text": "The chairs are too closely spaced; could you move them apart?"
                                            },
                                            {
                                                "example_id": "61312d73-ba7c-4ab5-b7cc-34f97ae6b795",
                                                "sense_id": "544e8394-bdcb-3847-bc29-3f1aae2cde1a",
                                                "text": "“King Homer” follows the story of King Kong closely, with Mr. Burns taking the freakishly over-sized King Homer from his native Africa, where he lives proud as a simian god, to the United States, where he is an initially impressive but ultimately rather limited Broadway attraction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fba577f-d454-3c71-b7b9-957d172fd65d",
                                        "entry_id": "c70e4704-5134-32d1-b499-1ffe2d6f19b7",
                                        "glosses": [
                                            "secretly; privately"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16a51ae5-4e42-41a0-a39f-bc19e75528e1",
                                                "sense_id": "1fba577f-d454-3c71-b7b9-957d172fd65d",
                                                "text": "That nought she did but wayle, and often steepe / Her dainty couch with tears which closely she did weepe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
