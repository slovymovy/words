                                ]
                            },
                            {
                                "target_word": "cape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f48a8c0-0769-3c83-9b22-eaf5e0b28e22",
                                        "entry_id": "af38edf3-d1c1-3029-b085-5108656b3e6a",
                                        "glosses": [
                                            "A sleeveless garment or part of a garment, hanging from the neck over the back, arms, and shoulders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe729771-a98c-44f1-b1e3-dc60e635a583",
                                                "sense_id": "8f48a8c0-0769-3c83-9b22-eaf5e0b28e22",
                                                "text": "Mind you, clothes were clothes in those days. […] Frills, ruffles, flounces, lace, complicated seams and gores: not only did they sweep the ground and have to be held up in one hand elegantly as you walked along, but they had little capes or coats or feather boas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b4bdc90-57f0-3cb8-8c37-c054ce1bf50f",
                                        "entry_id": "af38edf3-d1c1-3029-b085-5108656b3e6a",
                                        "glosses": [
                                            "A superhero."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "beb1d4d6-83c4-4d84-b1bf-5cae7fed6ede",
                                                "sense_id": "0b4bdc90-57f0-3cb8-8c37-c054ce1bf50f",
                                                "text": "Rows and rows of booths and pavilions stretch across the floor, draped with glowing holograms and shifting signs beckoning capes to try their wares. Bystander insurance. Hypertech components. Mystical ingredients. Training DVDs ..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af660051-05b3-39ce-ad76-99ed6b6d0486",
                                        "entry_id": "7256a791-0456-30cf-bbc2-c3184bb8d7fc",
                                        "glosses": [
                                            "To incite or attract (a bull) to charge a certain direction, by waving a cape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "552d5f68-2c02-432a-a007-962c92ecc512",
                                                "sense_id": "af660051-05b3-39ce-ad76-99ed6b6d0486",
                                                "text": "“I became a novillero when I was fourteen, but I had already been going to the fields and caping bulls since I was about twelve.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85d811ce-01a4-3fe3-a20c-9bc6434e98f5",
                                        "entry_id": "7256a791-0456-30cf-bbc2-c3184bb8d7fc",
                                        "glosses": [
                                            "To head or point; to keep a course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bff45ec-bf86-4112-b276-858a0137e98b",
                                                "sense_id": "85d811ce-01a4-3fe3-a20c-9bc6434e98f5",
                                                "text": "The ship capes southwest by south."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20363490-05a9-3179-9ba1-27753dfa4186",
                                        "entry_id": "7256a791-0456-30cf-bbc2-c3184bb8d7fc",
                                        "glosses": [
                                            "To skin an animal, particularly a deer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd6b8d7a-dff0-32a1-ba95-911908e5c9a8",
                                        "entry_id": "7256a791-0456-30cf-bbc2-c3184bb8d7fc",
                                        "glosses": [
                                            "To defend or praise, especially that which is unworthy."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5223bf0c-8f70-45f8-bb59-218495ce1e10",
                                                "sense_id": "cd6b8d7a-dff0-32a1-ba95-911908e5c9a8",
                                                "text": "A lot of African-Americans believe the answer is Clinton, mostly because \"she's not Trump\" and because President Barack Obama is shamelessly caping for her."
                                            },
                                            {
                                                "example_id": "093887c0-9315-4f8c-938f-45e88e61516c",
                                                "sense_id": "cd6b8d7a-dff0-32a1-ba95-911908e5c9a8",
                                                "text": "Many times, you see white supremacist groups caping for women to mask their agenda of white nationalism."
                                            },
                                            {
                                                "example_id": "ff0f80a3-babb-4c23-95ed-6fc8c46e0230",
                                                "sense_id": "cd6b8d7a-dff0-32a1-ba95-911908e5c9a8",
                                                "text": "\"I can't believe I'm out here caping for a politician.\""
                                            },
                                            {
                                                "example_id": "871aa38a-b2c8-4265-a58e-0133f8cad314",
                                                "sense_id": "cd6b8d7a-dff0-32a1-ba95-911908e5c9a8",
                                                "text": "[…] Biden is the old man who once caped for systematic racism; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a84a98b7-2473-3e4b-9305-415aa2db0d1c",
                                        "entry_id": "7256a791-0456-30cf-bbc2-c3184bb8d7fc",
                                        "glosses": [
                                            "To cover (as) with or like a cape."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfda5e98-6f38-401f-9191-f6ec4b778bb7",
                                                "sense_id": "a84a98b7-2473-3e4b-9305-415aa2db0d1c",
                                                "text": "The white fur that caped his neck and shoulders stood on end."
                                            },
                                            {
                                                "example_id": "4229dd1e-2747-4762-b7e7-6e6203559edc",
                                                "sense_id": "a84a98b7-2473-3e4b-9305-415aa2db0d1c",
                                                "text": "He shook her gently, combing his fingers through her coppery curls that caped her shoulders like filigree."
                                            },
                                            {
                                                "example_id": "33cc9392-b74a-4733-9185-e5465301e080",
                                                "sense_id": "a84a98b7-2473-3e4b-9305-415aa2db0d1c",
                                                "text": "He caped the children and draped them in long wraps, wigs, and swords, and then they all went off down the hall, around the house, and into the yard, Jack singing in his high little voice, “Let’s go off adventuring, adventuring, adventuring!”"
                                            },
                                            {
                                                "example_id": "71eb7f38-b454-4ae3-b480-3b7ce506403b",
                                                "sense_id": "a84a98b7-2473-3e4b-9305-415aa2db0d1c",
                                                "text": "Out of the corner of his eye, he saw blatant relief sketched on her face as the jacket caped her body."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
