                    {
                        "translation_id": "b607ba00-307c-424e-9cf7-d66404c5dc3c",
                        "source_entry_id": "3ee45a00-28b1-3d9f-a2d8-361558113e2a",
                        "source_sense_id": "4f52112d-9e59-32ed-810d-8216a274fc4d",
                        "source_sense_description": "item of clothing that is worn on the foot",
                        "target_lang_word": "Schuhwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuhwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57b6db9d-6f03-3d58-b305-2f779e02d71f",
                                        "entry_id": "ff986230-f771-3d3f-beac-cc8fa820048e",
                                        "glosses": [
                                            "Art oder Menge von Schuhen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cee3179-14cb-4c42-8e34-e4dd427d9e14",
                                                "sense_id": "57b6db9d-6f03-3d58-b305-2f779e02d71f",
                                                "text": "„Sie schleppt die Essvorräte, ihre guten Kleider und Mäntel, das Schuhwerk, die Kissen vom Kanapee, ja, sogar das Bild mit den beiden Jungen in die Kammer - alles vor seinen Augen.“"
                                            },
                                            {
                                                "example_id": "a70ff932-7846-44a7-bd59-c458c28c0ce6",
                                                "sense_id": "57b6db9d-6f03-3d58-b305-2f779e02d71f",
                                                "text": "„Da die Kinderfüße nicht in modischen Schuhen stecken, sondern vorwiegend in Holzpantinen, ein im Sommer durchaus angenehmes Schuhwerk, bleibt es nicht aus, dass die Holzpantinen gewollt oder ungewollt häufig ein unangenehmes Konzert bereiten.“"
                                            },
                                            {
                                                "example_id": "e41ebffa-c59d-43b4-b15d-153a4022b2dc",
                                                "sense_id": "57b6db9d-6f03-3d58-b305-2f779e02d71f",
                                                "text": "„Wir ziehen die Regenjacken an, schlüpfen in festes Schuhwerk.“"
                                            },
                                            {
                                                "example_id": "3b09d539-2549-4de4-b646-63092802d5bc",
                                                "sense_id": "57b6db9d-6f03-3d58-b305-2f779e02d71f",
                                                "text": "„Festes Schuhwerk und warme Kleidung sind nötig, da die Temperatur in der Höhle unter 0 Grad liegt.“"
                                            },
                                            {
                                                "example_id": "2bfb51a8-4373-4915-a713-fd1809df7089",
                                                "sense_id": "57b6db9d-6f03-3d58-b305-2f779e02d71f",
                                                "text": "„Und das Zeitungspapier war knapp, zumal es nicht nur fürs Tabaktrocknen oder zum Ausstopfen nassen Schuhwerks gebraucht wurde, sondern – in kleine Rechtecke zerschnitten und auf angespitzte Haken gespießt – auch das Klopapier ersetzen musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
