                        "examples": [
                            {
                                "example_id": "dd7232be-ca02-44f2-ab04-3e4b1300dddd",
                                "sense_id": "4d354b4e-015e-3855-bf37-c3d5de06cb3f",
                                "text": "„Den Glauben an die Macht der Geister identifizierte Sampson als das Haupthindernis auf dem Weg zu einer Verbesserung der Situation.“"
                            },
                            {
                                "example_id": "838c01d9-eded-47fc-a0e5-fef25e28264b",
                                "sense_id": "4d354b4e-015e-3855-bf37-c3d5de06cb3f",
                                "text": "„Sie hatten sich nie eingestanden, welche Rolle Israel bei der Tragödie der Palästinenser spielte, oder vielleicht hatten sie auch einfach nicht die Courage, es zuzugeben. Das war vermutlich das Haupthindernis.“"
                            }
                        ],
