                        "sense_id": "f9b0eb4e-d326-36ea-9828-16b847491682",
                        "entry_id": "7596fe51-2aef-3b6c-912f-d37991f415d0",
                        "glosses": [
                            "festlich gedeckter Tisch zum abendlichen Essen oder diese Abendmahlzeit selbst"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "fb75e4b6-36a5-4f80-86b0-d25bd157d5f1",
                                "sense_id": "f9b0eb4e-d326-36ea-9828-16b847491682",
                                "text": "„Gewöhnlich wurde das Vergnügen an den Abendtafeln noch durch munteren und schönen Gesang erhöht.“"
                            },
                            {
                                "example_id": "88442eb3-3889-4340-a33f-70c33fdfd8fe",
                                "sense_id": "f9b0eb4e-d326-36ea-9828-16b847491682",
                                "text": "„Anschließend wurde dann die Abendtafel aufgetragen, an der auch der junge und reife Friedrich mittat, der alte allerdings nur noch zusah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
