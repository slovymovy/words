                    "sense_id": "db9551e3-9fca-3fa6-93f5-c99adea421c7",
                    "sense_definition": "Distinguer par la vue, voir rapidement ou de loin.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À travers le brouillard matinal, nous <w>apercevons</w> la silhouette imposante du vieux château.",
                            "target_lang_translations": {
                                "en": "Through the morning fog, we <w>make out</w> the imposing silhouette of the old castle.",
                                "ru": "Сквозь утренний туман мы <w>различаем</w> внушительный силуэт старого замка.",
                                "nl": "Door de ochtendmist <w>ontwaren</w> we de indrukwekkende silhouet van het oude kasteel.",
                                "de": "Durch den morgendlichen Nebel <w>erkennen</w> wir die imposante Silhouette des alten Schlosses.",
                                "pl": "Przez poranną mgłę <w>dostrzegamy</w> imponującą sylwetkę starego zamku.",
                                "it": "Attraverso la nebbia mattutina, <w>intravediamo</w> la sagoma imponente del vecchio castello.",
                                "cs": "Skrz ranní mlhu <w>rozeznáváme</w> impozantní siluetu starého hradu.",
                                "tr": "Sabah sisinin arasından eski kalenin heybetli siluetini <w>seçiyoruz</w>.",
                                "es": "A través de la niebla matutina, <w>divisamos</w> la imponente silueta del viejo castillo.",
                                "zh": "穿过清晨的薄雾，我们<w>望见</w>了古堡那高大的轮廓。"
                            }
                        },
                        {
                            "text": "En ouvrant la fenêtre de sa chambre, il <w>aperçoit</w> son voisin dans le jardin.",
                            "target_lang_translations": {
                                "en": "Opening his bedroom window, he <w>spots</w> his neighbor in the garden.",
                                "ru": "Открыв окно своей спальни, он <w>замечает</w> соседа в саду.",
                                "nl": "Bij het openen van het raam van zijn slaapkamer <w>ziet</w> hij zijn buurman in de tuin.",
                                "de": "Als er das Fenster seines Schlafzimmers öffnet, <w>erblickt</w> er seinen Nachbarn im Garten.",
                                "pl": "Otwierając okno swojej sypialni, <w>dostrzega</w> sąsiada w ogrodzie.",
                                "it": "Aprendo la finestra della sua camera, <w>scorge</w> il vicino nel giardino.",
                                "cs": "Když otevře okno své ložnice, <w>spatří</w> na zahradě souseda.",
                                "tr": "Yatak odasının penceresini açtığında bahçede komşusunu <w>fark ediyor</w>.",
                                "es": "Al abrir la ventana de su dormitorio, <w>divisa</w> a su vecino en el jardín.",
                                "zh": "打开卧室的窗户，他<w>瞥见</w>了花园里的邻居。"
                            }
                        }
                    ],
                    "synonyms": [
                        "entrevoir"
