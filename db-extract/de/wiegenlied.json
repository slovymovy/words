                    {
                        "form_id": "c788de23-c3c4-43ce-8a47-e762e00565d4",
                        "entry_id": "19c18863-a50c-31b0-9f91-8ba69c5f5c51",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Wiegenlied"
                    },
                    {
                        "form_id": "ffe2d6e6-71a8-4782-83e0-fe84d6e004da",
                        "entry_id": "19c18863-a50c-31b0-9f91-8ba69c5f5c51",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wiegenlieder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00aed32c-747d-358c-9f34-1c2ac5adc267",
                        "entry_id": "19c18863-a50c-31b0-9f91-8ba69c5f5c51",
                        "glosses": [
                            "Lied, das einem Kind (in der Wiege) vorgesungen wird, damit es einschläft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82485c50-5f81-430a-b864-74e6a0a4c618",
                                "sense_id": "00aed32c-747d-358c-9f34-1c2ac5adc267",
                                "text": "Meine Großmutter sang mir immer ein Wiegenlied vor."
                            },
                            {
                                "example_id": "b4a526d5-2334-4922-bd77-e4c831ada152",
                                "sense_id": "00aed32c-747d-358c-9f34-1c2ac5adc267",
                                "text": "„Was lullt mir Frau Amme mein Wiegenlied gar?“"
                            },
                            {
                                "example_id": "19cfa1a2-f47f-4c37-b42e-bfc5da538fe5",
                                "sense_id": "00aed32c-747d-358c-9f34-1c2ac5adc267",
                                "text": "„Sie ſaßen dann oben in der luftigen, großen Stube, Roswitha wiegte das Kind und ſang in einem thüringiſchen Platt allerlei Wiegenlieder, die niemand recht verſtand, vielleicht ſie ſelber nicht; […].“"
                            },
                            {
                                "example_id": "fc4996d6-e451-41f4-87ab-61f804551941",
                                "sense_id": "00aed32c-747d-358c-9f34-1c2ac5adc267",
                                "text": "„Hast sogar Wiegenlieder gesummt, während sie schlief, in einer Phantasiesprache, die wie das reinste Isländisch klang, vielleicht hörte sie im Traum Trolle und Elfen.“"
                            },
                            {
                                "example_id": "805060ed-dc1c-4784-9d28-a331624bd2fd",
                                "sense_id": "00aed32c-747d-358c-9f34-1c2ac5adc267",
                                "text": "„Er stand in seinem weißen Unterzeug wie ein müdes, freundliches Gespenst im halbdunklen Zimmer und sprach die Verse des Wiegenliedes langsam, mit montoner Stimme vor sich hin, die erloschenen Augen in die Nacht vor dem Fenster gerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
