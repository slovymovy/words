                            {
                                "target_word": "potty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01911656-5a85-3279-8a89-31ce34cd312a",
                                        "entry_id": "a0eb56ba-58bc-3ab7-b1df-297952a86476",
                                        "glosses": [
                                            "Insane."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "630aaad7-0d96-455c-8b18-bbed604e92e1",
                                                "sense_id": "01911656-5a85-3279-8a89-31ce34cd312a",
                                                "text": "The noise that the neighbour's kids were making was driving Fred potty."
                                            },
                                            {
                                                "example_id": "4635c874-ca33-4946-91d3-eaa1cb01e214",
                                                "sense_id": "01911656-5a85-3279-8a89-31ce34cd312a",
                                                "text": "It’s all very well for the Warden to talk about an open mind, but we shall all feel perfectly ghastly wondering what other people are thinking about us, and whether our own conversation doesn’t sound a little potty. It’s the pottiness, you know, that’s so awful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59338279-dba4-392b-84bf-72d85587e692",
                                        "entry_id": "a0eb56ba-58bc-3ab7-b1df-297952a86476",
                                        "glosses": [
                                            "Easy to pot the ball on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5096211-b150-4cc2-af3e-99bbd92c9357",
                                                "sense_id": "59338279-dba4-392b-84bf-72d85587e692",
                                                "text": "The Eastbourne Green is by no means a \" potty \" one, and happily belies its appearance."
                                            },
                                            {
                                                "example_id": "9f0ce1f4-7360-4873-af7b-45ede4466d65",
                                                "sense_id": "59338279-dba4-392b-84bf-72d85587e692",
                                                "text": "\"A potty little nine-hole affair at a hydro in the Midlands. My cousins stay there. Always will. Not but what the fourth and the seventh holes take some doing. You could manage it, though,\" he said encouragingly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
