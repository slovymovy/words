                    }
                ],
                "senses": [
                    {
                        "sense_id": "71ef92d7-d36c-3881-8f30-5309856d751a",
                        "entry_id": "b4b25e01-8f85-36ec-8893-a0964934e3e4",
                        "glosses": [
                            "Cri étouffé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39017b3c-1c0e-43f2-8923-500d3e3fc59b",
                                "sense_id": "71ef92d7-d36c-3881-8f30-5309856d751a",
                                "text": "J'entends des geignements."
                            },
                            {
                                "example_id": "d617eeb4-2229-46ac-9a95-c6693fbe524f",
                                "sense_id": "71ef92d7-d36c-3881-8f30-5309856d751a",
                                "text": "je perçois un bruit étrange… ça ne ressemble à rien de ce que j’ai jamais entendu… c’est comme des plaintes, comme des geignements… ou peut-être des sanglots retenus… mais il y a là quelque chose de si démuni, d’innocent… c’est comme une détresse, un désespoir d’enfant qui s’échappe de lui, il ne peut pas le retenir, ça s’arrache du fond de son âme… l’entendre seulement fait mal…"
                            },
                            {
                                "example_id": "a0926e52-f1fa-491b-a98e-2beee3dd2b66",
                                "sense_id": "71ef92d7-d36c-3881-8f30-5309856d751a",
                                "text": "S’il était à ce point exaspéré, c’est qu’il se sentait incapable de prononcer la sentence, et que Roukoz, par ses geignements, le mettait au défi."
                            }
                        ]
                    },
                    {
                        "sense_id": "33d427cf-6d61-3735-b04d-be8ff2633f13",
                        "entry_id": "b4b25e01-8f85-36ec-8893-a0964934e3e4",
                        "glosses": [
                            "Plainte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d8afb46-f3b3-453b-8b4f-3d7813716e9f",
                                "sense_id": "33d427cf-6d61-3735-b04d-be8ff2633f13",
                                "text": "Les geignements d'un enfant capricieux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68e3b70b-7365-414c-b63b-64be36e7945b",
                        "source_entry_id": "b4b25e01-8f85-36ec-8893-a0964934e3e4",
                        "target_lang_word": "Stöhnen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stöhnen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fcad849-2ce8-3ea5-b339-75491cabd291",
                                        "entry_id": "3e9f374f-4c80-3a7b-a040-cf36119bd9eb",
                                        "glosses": [
                                            "stöhnendes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "898c5b08-ac55-4148-82fe-511f67506d83",
                                                "sense_id": "0fcad849-2ce8-3ea5-b339-75491cabd291",
                                                "text": "„Er hörte das Stöhnen eines Mannes, der offenbar dabei war, sich zu vergnügen, während die mütterliche Stimme einer Frau ihn anspornte.“"
                                            },
                                            {
                                                "example_id": "942f8b6d-cd46-4e9a-b870-58dafdeaae58",
                                                "sense_id": "0fcad849-2ce8-3ea5-b339-75491cabd291",
                                                "text": "„Ein Stöhnen aus dem Beiboot veranlasste ihn, sich ein, zwei Meter am Boot entlangzuhangeln und dann über den Bootsrand zu spähen, wobei er darauf achtete, das Boot zwischen sich und dem Frachtschiff in knapp 200 Metern Entfernung zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46a38581-6e05-43dc-aac3-691856cedbad",
                        "source_entry_id": "b4b25e01-8f85-36ec-8893-a0964934e3e4",
                        "target_lang_word": "Gejammer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gejammer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bdd08294-5272-3f22-9d70-5ee2d5ceb517",
                                        "entry_id": "d71eb6b2-69c5-3061-9c33-e2c0fdbb8de5",
                                        "glosses": [
                                            "anhaltendes Jammern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e83cea5c-a762-49b4-a1e7-56d5c6760e1a",
                                                "sense_id": "bdd08294-5272-3f22-9d70-5ee2d5ceb517",
                                                "text": "„Jetzt aber, in dem Erdbeben, in dem Geheul der Fliegersirenen, in dem Gejammer der flüchtenden Herden, wünsche ich mir das gewöhnliche Leben herbei wie Brot und Wasser.“"
                                            },
                                            {
                                                "example_id": "f593d4a1-7045-45bc-b667-f69051bc419f",
                                                "sense_id": "bdd08294-5272-3f22-9d70-5ee2d5ceb517",
                                                "text": "„Das 'Gejammer anderer Leute hatte ich schon mein Leben lang gehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98eaf18f-d911-4deb-b817-b9b9954cbba3",
                        "source_entry_id": "b4b25e01-8f85-36ec-8893-a0964934e3e4",
                        "target_lang_word": "Wehleidigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wehleidigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a29f949-5577-3e5b-8739-42ef0f66d507",
                                        "entry_id": "2229bf68-fd60-32e9-a409-e42452fc445f",
                                        "glosses": [
                                            "Eigenschaft einer Person, überempfindlich gegen Schmerz oder Seelenleid zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8090c487-69f1-49e5-98c9-9746dcf97149",
                                                "sense_id": "7a29f949-5577-3e5b-8739-42ef0f66d507",
                                                "text": "„So war unsere Mutter wohl, nicht nur durch ihre Erziehung, sondern aus Überzeugung dazu gewachsen, stets die Beherrschung zu wahren, um keinen Preis der Wehleidigkeit zu verfallen und Gefühle in sich einzuschließen.“"
                                            },
                                            {
                                                "example_id": "250d8480-86b4-41df-8f2c-0b247978d88b",
                                                "sense_id": "7a29f949-5577-3e5b-8739-42ef0f66d507",
                                                "text": "„Vielmehr sind die blumigen Formulierungen vor allem darauf bedacht, die gegenseitigen Wehleidigkeiten mit zahlreichen Trostpflastern zu versehen.“"
                                            },
                                            {
                                                "example_id": "23cbb3c5-4e76-4a62-a06a-534197016151",
                                                "sense_id": "7a29f949-5577-3e5b-8739-42ef0f66d507",
                                                "text": "„ Als ich 50 wurde, schenkte mir meine Tochter einen ‚Steckbrief‘, in dem sie alle meine Schwächen und Wehleidigkeiten gnadenlos beschrieb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
