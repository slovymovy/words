                "senses": [
                    {
                        "sense_id": "6a489a70-7123-3b02-9a0b-3af2c382da82",
                        "entry_id": "92168619-78bb-37b1-93a4-9c30f193fb19",
                        "glosses": [
                            "in Form einer Helix auf einer Zylinderoberfläche verlaufende Rille"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "002fe298-3dd7-44fd-973d-ea28db4846c0",
                                "sense_id": "6a489a70-7123-3b02-9a0b-3af2c382da82",
                                "text": "„Durch das Anspitzen wird der Schneidwinkel etwas verändert, und zwar um so mehr, je kürzer der Anspitzanschliff in der Drallnut verläuft.“"
                            },
                            {
                                "example_id": "0dc2314c-a5d4-465e-878f-883e3854a411",
                                "sense_id": "6a489a70-7123-3b02-9a0b-3af2c382da82",
                                "text": "„Die Steigung der Drallnut wird in Millimeter pro Umdrehung eingegeben.“"
                            },
                            {
                                "example_id": "e730340f-6670-4a9a-8581-cab06a1a1a0c",
                                "sense_id": "6a489a70-7123-3b02-9a0b-3af2c382da82",
                                "text": "„Durch den Drall der Drallnut […] wird der Spanabfluß erleichtert.“"
                            },
                            {
                                "example_id": "9313fc03-74a8-475c-9cdc-39af4839c4f0",
                                "sense_id": "6a489a70-7123-3b02-9a0b-3af2c382da82",
                                "text": "„Durch überlagerte Drehbewegung von Werkzeug oder Werkstück kann auch eine Drallnut geräumt werden.“"
                            },
                            {
                                "example_id": "45d19606-4052-436d-bfb8-6d5741556d4a",
                                "sense_id": "6a489a70-7123-3b02-9a0b-3af2c382da82",
                                "text": "„Durch Polieren der Drallnut von Bohrern, die zur Aufnahme der Späne dient, kann die Haltbarkeit verdoppelt bis verdreifacht werden, vor allem wenn tiefe Löcher gebohrt werden müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
