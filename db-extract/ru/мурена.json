                                        "entry_id": "61484969-c70c-3e9e-8fad-6e882ec9e1b5",
                                        "glosses": [
                                            "drapieżna ryba o wężowatym pokroju występująca w morzach ciepłych i gorących"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1ecc09e-5bd4-44f0-9ad4-be0a112fa44f",
                                                "sense_id": "39a1308e-001e-33f6-b3f5-39a0e09eadcf",
                                                "text": "Nurek nagrał murenę penetrującą szczeliny rafy w poszukiwaniu ośmiornicy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7946f0b-3a9e-45ca-b3bf-41e0614d810a",
                        "source_entry_id": "2f046704-9b6f-36b9-9c5b-01b32eb5843c",
                        "source_sense_id": "de1bf152-870e-3e23-b017-0bb9af0269ef",
