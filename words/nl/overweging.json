                            },
                            {
                                "target_lang_word": "проповедь",
                                "target_lang_sense_clarification": "в религиозном контексте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉思",
                                "target_lang_sense_clarification": "深思或思想感言"
                            },
                            {
                                "target_lang_word": "省思",
                                "target_lang_sense_clarification": "反思性论述或短文"
                            },
                            {
                                "target_lang_word": "默想",
