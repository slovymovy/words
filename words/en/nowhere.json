{
    "word_family": [
        "anywhere",
        "elsewhere",
        "everywhere",
        "somewhere"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1ec7bd4f-84eb-3e5d-b78b-32fdf081e6b8",
                    "sense_definition": "In or at no place; not anywhere.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "no_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The missing keys were <w>nowhere</w> to be found in the house.",
                            "target_lang_translations": {
                                "ru": "Потерянные ключи <w>нигде</w> в доме не удалось найти.",
                                "pl": "Zgubionych kluczy <w>nigdzie</w> nie można było znaleźć w domu.",
                                "de": "Die verlorenen Schlüssel waren im Haus <w>nirgendwo</w> zu finden."
                            }
                        },
                        {
                            "text": "I looked for my friend, but he was <w>nowhere</w> in the room.",
                            "target_lang_translations": {
                                "ru": "Я искал своего друга, но его <w>нигде</w> не было в комнате.",
                                "pl": "Szukałem mojego przyjaciela, ale <w>nigdzie</w> w pokoju go nie było.",
                                "de": "Ich habe nach meinem Freund gesucht, aber er war <w>nirgends</w> im Raum."
                            }
                        }
                    ],
                    "antonyms": [
                        "everywhere"
                    ],
                    "common_phrases": [
                        "nowhere to be found",
                        "nowhere near",
                        "nowhere else"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ни в каком месте; отсутствие местонахождения.",
                        "pl": "W żadnym miejscu; nigdzie.",
                        "de": "An keinem Ort; nicht irgendwo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нигде",
                                "target_lang_sense_clarification": "in no place"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "nigdzie",
                                "target_lang_sense_clarification": "w żadnym miejscu"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nirgendwo",
                                "target_lang_sense_clarification": "an keinem Ort"
                            },
                            {
                                "target_lang_word": "nirgends",
                                "target_lang_sense_clarification": "an keinem Ort, oft in verneinten Sätzen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a519134-cb7e-3a25-afcf-056cc09ebef8",
                    "sense_definition": "To no place; without a result or destination.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "no_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We drove around for hours, but the road seemed to go <w>nowhere</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ездили часами, но дорога, казалось, вела <w>никуда</w>.",
                                "pl": "Jeździliśmy godzinami, ale droga zdawała się prowadzić <w>donikąd</w>.",
                                "de": "Wir sind stundenlang herumgefahren, aber die Straße schien <w>nirgendwohin</w> zu führen."
                            }
                        },
                        {
                            "text": "This discussion is leading <w>nowhere</w>, so we should stop.",
                            "target_lang_translations": {
                                "ru": "Это обсуждение ведет <w>никуда</w>, поэтому нам следует остановиться.",
                                "pl": "Ta dyskusja prowadzi <w>donikąd</w>, więc powinniśmy przestać.",
                                "de": "Diese Diskussion führt <w>nirgendwohin</w>, also sollten wir aufhören."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go nowhere",
                        "lead nowhere",
                        "get nowhere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ни в какое место; без результата или пункта назначения.",
                        "pl": "Do żadnego miejsca; bez rezultatu lub celu.",
                        "de": "Zu keinem Ort; ohne Ergebnis oder Ziel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "никуда",
                                "target_lang_sense_clarification": "to no place"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "donikąd",
                                "target_lang_sense_clarification": "do żadnego miejsca"
                            },
                            {
                                "target_lang_word": "nigdzie",
                                "target_lang_sense_clarification": "w kierunku żadnego miejsca"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nirgendwohin",
                                "target_lang_sense_clarification": "zu keinem Ort (Richtung)"
                            },
                            {
                                "target_lang_word": "nirgendhin",
                                "target_lang_sense_clarification": "zu keinem Ort (Richtung, etwas seltener)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ba8aa3d-95ab-3b9f-bf90-1ceda0031fe5",
                    "sense_definition": "A place that is remote, unknown, or non-existent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They live on a small farm in the middle of <w>nowhere</w>.",
                            "target_lang_translations": {
                                "ru": "Они живут на маленькой ферме в полной <w>глуши</w>.",
                                "pl": "Mieszkają na małej farmie na kompletnym <w>pustkowiu</w>.",
                                "de": "Sie leben auf einer kleinen Farm mitten im <w>Nirgendwo</w>."
                            }
                        },
                        {
                            "text": "The car suddenly appeared out of <w>nowhere</w> and almost hit us.",
                            "target_lang_translations": {
                                "ru": "Машина внезапно появилась из <w>ниоткуда</w> и чуть не сбила нас.",
                                "pl": "Samochód nagle pojawił się <w>znikąd</w> i prawie w nas uderzył.",
                                "de": "Das Auto tauchte plötzlich aus dem <w>Nichts</w> auf und hätte uns fast erwischt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "middle of nowhere",
                        "out of nowhere",
                        "road to nowhere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, которое удалено, неизвестно или не существует.",
                        "pl": "Miejsce odległe, nieznane lub nieistniejące.",
                        "de": "Ein abgelegener, unbekannter oder nicht existierender Ort."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ниоткуда",
                                "target_lang_sense_clarification": "from no place (source)"
                            },
                            {
                                "target_lang_word": "глушь",
                                "target_lang_sense_clarification": "remote place"
                            },
                            {
                                "target_lang_word": "неизвестность",
                                "target_lang_sense_clarification": "unknown place"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niostąd ni zowąd",
                                "target_lang_sense_clarification": "nagle, z nieznanego miejsca"
                            },
                            {
                                "target_lang_word": "pustkowie",
                                "target_lang_sense_clarification": "miejsce oddalone od cywilizacji"
                            },
                            {
                                "target_lang_word": "znikąd",
                                "target_lang_sense_clarification": "z żadnego miejsca"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Niemandsland",
                                "target_lang_sense_clarification": "ein Ort, der abgelegen oder unbestimmt ist"
                            },
                            {
                                "target_lang_word": "Nirgendwo",
                                "target_lang_sense_clarification": "als Substantiv für einen fiktiven oder sehr abgelegenen Ort"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b880067e-53b5-34a8-a6aa-0989662c9747",
                    "sense_definition": "Having no value, importance, or prospects.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt stuck in a <w>nowhere</w> job with no chance of promotion.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что застрял на <w>бесперспективной</w> работе без шансов на повышение.",
                                "pl": "Czuł, że utknął w pracy <w>bez perspektyw</w>, bez szans na awans.",
                                "de": "Er fühlte sich in einem <w>perspektivlosen</w> Job gefangen, ohne Chance auf Beförderung."
                            }
                        },
                        {
                            "text": "She wanted to leave that <w>nowhere</w> town and see the world.",
                            "target_lang_translations": {
                                "ru": "Она хотела уехать из этого <w>захолустного</w> городка и повидать мир.",
                                "pl": "Chciała wyjechać z tego <w>beznadziejnego</w> miasteczka i zobaczyć świat.",
                                "de": "Sie wollte diese <w>bedeutungslose</w> Kleinstadt verlassen und die Welt sehen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nowhere man",
                        "nowhere job"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий ценности, важности или перспектив.",
                        "pl": "Nieposiadający wartości, znaczenia lub perspektyw.",
                        "de": "Ohne Wert, Bedeutung oder Zukunftsperspektiven."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бесперспективный",
                                "target_lang_sense_clarification": "without prospects"
                            },
                            {
                                "target_lang_word": "захолустный",
                                "target_lang_sense_clarification": "remote/insignificant (of a place)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "bez perspektyw",
                                "target_lang_sense_clarification": "o pracy lub sytuacji"
                            },
                            {
                                "target_lang_word": "beznadziejny",
                                "target_lang_sense_clarification": "o miejscu lub sytuacji"
                            },
                            {
                                "target_lang_word": "zapadły",
                                "target_lang_sense_clarification": "o miejscu, np. dziura"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "perspektivlos",
                                "target_lang_sense_clarification": "ohne Zukunftschancen (z. B. Job)"
                            },
                            {
                                "target_lang_word": "bedeutungslos",
                                "target_lang_sense_clarification": "ohne Wichtigkeit oder Wert"
                            }
                        ]
                    }
                }
            ]
        }
    ]
