{
    "word_family": [
        "mentionner",
        "mentionnable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b481bf6-8904-3b40-8066-3792b4dcab65",
                    "sense_definition": "Action de citer, de signaler quelqu'un ou quelque chose ; indication écrite ou orale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur fait une brève <w>mention</w> de ses collaborateurs dans la préface.",
                            "target_lang_translations": {
                                "en": "The author makes a brief <w>mention</w> of his collaborators in the preface.",
                                "ru": "Автор делает краткое <w>упоминание</w> о своих сотрудниках в предисловии.",
                                "de": "Der Autor macht im Vorwort eine kurze <w>Erwähnung</w> seiner Mitarbeiter.",
                                "es": "El autor hace una breve <w>mención</w> de sus colaboradores en el prólogo.",
                                "zh": "作者在前言中对他的合作者只做了一处简短的<w>提及</w>。"
                            }
                        },
                        {
                            "text": "Le contrat comporte la <w>mention</w> manuscrite obligatoire en bas de page.",
                            "target_lang_translations": {
                                "en": "The contract must include the mandatory handwritten <w>notation</w> at the bottom of the page.",
                                "ru": "Договор содержит обязательную рукописную <w>отметку</w> внизу страницы.",
                                "de": "Der Vertrag enthält den obligatorischen handschriftlichen <w>Vermerk</w> am unteren Seitenrand.",
                                "es": "El contrato incluye la <w>anotación</w> manuscrita obligatoria al pie de la página.",
                                "zh": "合同底部必须有一处手写的<w>注记</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "indication",
                        "remarque",
                        "référence",
                        "citation"
                    ],
                    "antonyms": [
                        "omission"
                    ],
                    "common_phrases": [
                        "faire mention de",
                        "sous la mention",
                        "sans mention"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of citing or noting someone or something, or a written or spoken indication of it.",
                        "ru": "Действие, при котором кого-либо или что-либо называют или отмечают; письменное или устное указание на это.",
                        "de": "Das Erwähnen oder Anführen einer Person oder Sache sowie die schriftliche oder mündliche Angabe dazu.",
                        "es": "Acción de citar o señalar a alguien o algo, y la indicación escrita u oral que se hace de ello.",
                        "zh": "指提及或注明某人或某事的行为，也指书面或口头的相关说明。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mention",
                                "target_lang_sense_clarification": "in speech or writing"
                            },
                            {
                                "target_lang_word": "reference",
                                "target_lang_sense_clarification": "brief allusion or citation"
                            },
                            {
                                "target_lang_word": "indication",
