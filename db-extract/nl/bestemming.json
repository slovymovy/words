                    {
                        "sense_id": "84fc6ed1-2216-3c37-9efd-ba22175ef203",
                        "entry_id": "36c00f9d-dc59-368e-9d54-9ea7ee6313bb",
                        "glosses": [
                            "het eindpunt van een route, het doel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "906251f7-a88e-4a92-9cbf-88efbc568612",
                                "sense_id": "84fc6ed1-2216-3c37-9efd-ba22175ef203",
                                "text": "Wat is de bestemming van je reis."
                            },
                            {
                                "example_id": "4534c46d-392c-4a63-8f98-744b74a3271b",
                                "sense_id": "84fc6ed1-2216-3c37-9efd-ba22175ef203",
                                "text": "Was is de bestemming van dit oude fabrieksterrein."
                            },
                            {
                                "example_id": "c4d60b1a-6cd1-49e3-b1f9-c1306f5edd90",
                                "sense_id": "84fc6ed1-2216-3c37-9efd-ba22175ef203",
                                "text": "Er is geen bestemming zonder duidelijkheid over de herkomst en geen toekomst zonder een leesbare versie van het verleden."
                            },
                            {
                                "example_id": "0e7270de-544e-404a-9005-163e49937afb",
                                "sense_id": "84fc6ed1-2216-3c37-9efd-ba22175ef203",
                                "text": "De avond van tevoren stippelde een van de vaders een route uit, die vaak niet over een vast bergpad, maar dwars over de bergen naar onze volgende bestemming, liep."
                            }
                        ]
                    },
