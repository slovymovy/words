                ],
                "senses": [
                    {
                        "sense_id": "fb2c1d25-3891-3b61-bb60-7e32d96037aa",
                        "entry_id": "2d12e549-9205-31ff-ac22-545fbbfd43ef",
                        "glosses": [
                            "Donner un caractère néo-classique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6de5d7b-9bce-43cf-bbf8-11af55d0191b",
                                "sense_id": "fb2c1d25-3891-3b61-bb60-7e32d96037aa",
                                "text": "Si on considère à tort ou à raison que les experts d'aujourd'hui sont passéïstes, n'est-ce pas d'une certaine façon un retour de balancier des délires des années 60 à 80 qui ont conduit au massacre de très grands instruments jugés ringards et qu'il fallait à tout prix néo-classiciser voire démolir pour ouvrir la voie à l'orgue moderne du XXème Siècle ?"
                            },
                            {
                                "example_id": "93abb177-99d6-448b-a0dd-7ee395e919fb",
                                "sense_id": "fb2c1d25-3891-3b61-bb60-7e32d96037aa",
                                "text": "Après un nettoyage en 1934 et la réparation de petits dommages après 1945, par la maison Jacquot Lavergne , l'orgue fut néo-classicisé par Christian Guerrier qui posa en 1977 une Fourniture neuve."
                            },
                            {
                                "example_id": "cbf06c1e-1e64-4785-9258-5b352a2ad0f8",
                                "sense_id": "fb2c1d25-3891-3b61-bb60-7e32d96037aa",
                                "text": "Il a été transformé (néo-classicisé) par Jean Renaud en 1976/1977."
                            }
                        ]
                    }
