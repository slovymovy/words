    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2cc0ae0-9e2e-382c-a54d-4ca8182d59d8",
                    "sense_definition": "A large wild cat native to Africa and India, usually having a golden-brown coat and, in males, a shaggy mane.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_cat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The male <w>lion</w> roared loudly to warn intruders away from his territory.",
                            "target_lang_translations": {
                                "ru": "Самец <w>льва</w> громко зарычал, чтобы предупредить чужаков держаться подальше от его территории.",
                                "zh": "雄性<w>狮子</w>大声咆哮，以警告入侵者远离它的领地。"
                            }
                        },
                        {
                            "text": "We saw a <w>lion</w> sleeping in the shade during our safari trip.",
                            "target_lang_translations": {
                                "ru": "Мы видели <w>льва</w>, спящего в тени во время нашего сафари.",
                                "zh": "在游猎旅行中，我们看到一只<w>狮子</w>正在阴凉处睡觉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "big cat"
                    ],
                    "common_phrases": [
                        "mountain lion",
                        "sea lion",
                        "lion's share",
                        "lion's den"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная дикая кошка, обитающая в Африке и Индии, обычно с золотисто-коричневой шерстью и, у самцов, с густой гривой.",
                        "zh": "一种原产于非洲和印度的体型巨大的野生猫科动物，通常有金棕色的皮毛，雄性长有浓密的鬃毛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лев",
                                "target_lang_sense_clarification": "животное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狮子",
                                "target_lang_sense_clarification": "大型猫科动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0ef383d-0720-3af5-8c29-d5f54a43be5e",
                    "sense_definition": "A person who possesses great strength, courage, or fierceness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphor_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fought like a <w>lion</w> to protect his family from danger.",
                            "target_lang_translations": {
                                "ru": "Он сражался как <w>лев</w>, чтобы защитить свою семью от опасности.",
                                "zh": "为了保护家人免受伤害，他像<w>狮子</w>一样奋勇战斗。"
                            }
                        },
                        {
                            "text": "She has the heart of a <w>lion</w> and never gives up in difficult times.",
                            "target_lang_translations": {
                                "ru": "У нее сердце <w>льва</w>, и она никогда не сдается в трудные времена.",
                                "zh": "她有着<w>狮子</w>般的心，在困难时期从不放弃。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hero",
                        "warrior"
                    ],
                    "antonyms": [
                        "coward"
                    ],
                    "common_phrases": [
                        "heart of a lion",
                        "fight like a lion"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обладающий огромной силой, храбростью или неистовостью.",
                        "zh": "指拥有巨大力量、勇气或凶猛性格的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лев",
                                "target_lang_sense_clarification": "о храбром человеке"
                            },
                            {
                                "target_lang_word": "герой",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勇士",
                                "target_lang_sense_clarification": "形容勇敢的人"
                            },
                            {
                                "target_lang_word": "猛将",
                                "target_lang_sense_clarification": "形容作战勇猛的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a9a16e7-8515-34e0-8b06-50988004b01c",
                    "sense_definition": "A famous person who is sought after socially and regarded with great interest or curiosity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphor_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After his novel became a bestseller, he became a literary <w>lion</w> in the city.",
                            "target_lang_translations": {
                                "ru": "После того как его роман стал бестселлером, он стал литературным <w>львом</w> в городе.",
                                "zh": "他的小说成为畅销书后，他成了城里的文学<w>名流</w>。"
                            }
                        },
                        {
                            "text": "She enjoyed being the social <w>lion</w> of the season, invited to every important party.",
                            "target_lang_translations": {
                                "ru": "Ей нравилось быть светской <w>львицей</w> сезона, приглашенной на каждую важную вечеринку.",
                                "zh": "她很享受成为当季的社交<w>名流</w>，受邀参加每一场重要的派对。"
                            }
                        }
                    ],
                    "synonyms": [
                        "celebrity",
                        "luminary",
                        "star",
                        "dignitary"
                    ],
                    "antonyms": [
                        "nobody"
                    ],
                    "common_phrases": [
                        "literary lion",
                        "social lion"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often found in older literature"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Известная личность, пользующаяся большим успехом в обществе и вызывающая всеобщий интерес.",
                        "zh": "指在社交场合广受欢迎、备受关注或好奇的知名人士。"
                    },
                    "translations": {
                        "ru": [
                            {
