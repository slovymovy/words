                "forms": [
                    {
                        "form_id": "1d79163a-20d8-4783-906d-6593f9d79f7d",
                        "entry_id": "b7711c8d-bbab-364f-a8e4-e9a4082e522f",
                        "tags": [
                            "plural"
                        ],
                        "form": "Marranos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13cab4fe-0a1f-363e-a028-db9ecf820998",
                        "entry_id": "b7711c8d-bbab-364f-a8e4-e9a4082e522f",
                        "glosses": [
                            "Any of the Sephardi Jews who stayed in Iberia during the Spanish Inquisition, and continued to practice Judaism in secret."
                        ],
                        "tags": [
                            "Judaism",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4bd5186b-2122-4f7c-be43-1186f8df3295",
                                "sense_id": "13cab4fe-0a1f-363e-a028-db9ecf820998",
                                "text": "In the Portuguese universities, the Marranos had studied logic, physics, medicine and mathematics, but they had no expertise in the more intuitive disciplines of Jewish practice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8812cba3-aaad-4221-a831-b6186d6b2382",
                        "source_entry_id": "b7711c8d-bbab-364f-a8e4-e9a4082e522f",
                        "source_sense_id": "13cab4fe-0a1f-363e-a028-db9ecf820998",
                        "source_sense_description": "Iberian Jew who practised Judaism in secret",
                        "target_lang_word": "marrane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marrane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3458ce64-6a59-3381-8758-1045ba8a63fb",
                                        "entry_id": "d9b60dfe-bad7-3359-abad-b8f651fd0291",
                                        "glosses": [
                                            "Juif d’Espagne ou du Portugal, converti au catholicisme, souvent de force dans le cadre de l’Inquisition, et qui continuait à pratiquer le judaïsme en secret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6df3591a-1e6f-4f44-8128-d4c90ef76a58",
                                                "sense_id": "3458ce64-6a59-3381-8758-1045ba8a63fb",
                                                "text": "Les marranes sont restés fidèles au judaïsme tout en pratiquant le catholicisme et durent prouver leur attachement à la « vraie foi » en mangeant du porc."
                                            },
                                            {
                                                "example_id": "d367a90d-2936-45c7-8c4a-93bdf2477a11",
                                                "sense_id": "3458ce64-6a59-3381-8758-1045ba8a63fb",
                                                "text": "— Vous saurez, monsieur, que mon cousin se nomme Henriquez, et qu’il est natif du Grao de Valence, marin et pêcheur de son état, honnête homme et père de famille, vieux chrétien comme toute sa race ; et je puis me vanter de l’être, tout pauvre que je suis, quand il y a tant de gens plus riches que moi qui sentent le marrane."
                                            },
                                            {
                                                "example_id": "0eb94738-d92e-41e6-8ef5-d134ceba1b13",
                                                "sense_id": "3458ce64-6a59-3381-8758-1045ba8a63fb",
                                                "text": "Savez-vous que le mot même de marrane dont, en Languedoc, nous avons fait un titre de noblesse, est à l’origine une insulte, venant d’un vieux mot ibérique qui désigne le porc ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marrane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58d33a1c-cc58-3abf-9818-048be961bb65",
                                        "entry_id": "99411559-3409-3722-92d8-ff8851d6cc0e",
                                        "glosses": [
                                            "Relatif au marranisme, aux marranes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9cc290b-3b4d-4450-b188-05874b58c840",
                                                "sense_id": "58d33a1c-cc58-3abf-9818-048be961bb65",
                                                "text": "À la fin du XVIᵉ siècle, le commerce mondial se déplace au Nord de l'Europe. Ce sont ces pays qui attirèrent désormais les marchands marranes, et c'est à cette époque que se constituent les grandes communautés séfarades d'Amsterdam, Hambourg et de Londres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
