                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a9192c3-29ca-3cc8-a7f2-7b483ce3f6f6",
                    "sense_definition": "iets riskants ondernemen of proberen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "risico",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik liep ten slotte bijna elke dag dezelfde afstand, dus dacht ik een kansje te kunnen <w>wagen</w>.",
                            "target_lang_translations": {
                                "en": "After all, I walked the same distance almost every day, so I thought I could <w>take</w> a little chance."
                            }
                        },
                        {
                            "text": "De laatste keer dat ik een poging had willen <w>wagen</w> was tijdens dat etentje.",
                            "target_lang_translations": {
                                "en": "The last time I had wanted to <w>venture</w> an attempt was during that dinner."
                            }
                        }
                    ],
                    "synonyms": [
                        "riskeren",
                        "durven",
                        "proberen"
                    ],
                    "common_phrases": [
                        "een poging wagen",
                        "een gokje wagen",
                        "een kansje wagen"
                    ],
                    "target_lang_definitions": {
                        "en": "to undertake or try something risky"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to venture",
                                "target_lang_sense_clarification": "to dare to do something or go somewhere risky"
                            },
                            {
                                "target_lang_word": "to risk",
                                "target_lang_sense_clarification": "to take a chance on something"
                            },
                            {
                                "target_lang_word": "to dare",
                                "target_lang_sense_clarification": "to have the courage to try something"
                            },
                            {
                                "target_lang_word": "to hazard",
                                "target_lang_sense_clarification": "to suggest or try something despite risk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad4da20-5510-37cb-ae8b-c74258e3a7ab",
                    "sense_definition": "iets kostbaars in gevaar brengen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "risico",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wilde zijn goede reputatie niet <w>wagen</w> voor een klein financieel gewin.",
                            "target_lang_translations": {
                                "en": "He did not want to <w>risk</w> his good reputation for a small financial gain."
                            }
                        },
                        {
                            "text": "De soldaten moesten hun leven <w>wagen</w> om de burgers in veiligheid te brengen.",
                            "target_lang_translations": {
                                "en": "The soldiers had to <w>risk</w> their lives to bring the citizens to safety."
                            }
                        }
                    ],
                    "synonyms": [
                        "riskeren"
                    ],
                    "common_phrases": [
                        "zijn leven wagen"
                    ],
                    "target_lang_definitions": {
                        "en": "to put something valuable at risk"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to risk",
                                "target_lang_sense_clarification": "to expose something to danger or loss"
                            },
                            {
                                "target_lang_word": "to stake",
                                "target_lang_sense_clarification": "to gamble or risk something important on an outcome"
                            },
                            {
                                "target_lang_word": "to endanger",
                                "target_lang_sense_clarification": "to put someone or something in a dangerous situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16949402-6e14-3ada-95f9-51e9cc04f39e",
                    "sense_definition": "zich ergens aan blootstellen of ergens mee bezig gaan ondanks het gevaar",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "risico",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Daar <w>waagde</w> hij zich niet aan omdat het te gevaarlijk was.",
                            "target_lang_translations": {
                                "en": "He did not <w>venture</w> into that because it was too dangerous."
                            }
                        },
                        {
                            "text": "Ondanks alle verboden <w>wagen</w> een paar muzikanten zich later die avond op straat.",
                            "target_lang_translations": {
                                "en": "Despite all the prohibitions, a few musicians <w>venture</w> out onto the street later that evening."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich wagen aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to expose oneself to something or engage with it despite danger"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to venture",
                                "target_lang_sense_clarification": "to cautiously engage in a risky activity"
                            },
                            {
                                "target_lang_word": "to dare",
                                "target_lang_sense_clarification": "to be brave enough to face a situation"
                            }
                        ]
                    }
                }
