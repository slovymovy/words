    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3eef7719-3c18-3232-84e9-3c45f6055255",
                    "sense_definition": "To reduce the physical strength or energy of someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weakening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat of the afternoon sun began to <w>enervate</w> the tired hikers."
                        },
                        {
                            "text": "Constant stress can <w>enervate</w> even the most resilient individuals over time."
                        }
                    ],
                    "synonyms": [
                        "debilitate",
                        "weaken"
                    ],
                    "antonyms": [
                        "strengthen",
                        "revive"
                    ]
                },
                {
                    "sense_id": "5fc203c6-5f13-3c60-8ba4-126bc3eb01e7",
                    "sense_definition": "To weaken someone morally or mentally.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weakening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant exposure to corruption began to <w>enervate</w> his once strong sense of justice."
                        },
                        {
                            "text": "Luxury and idleness can <w>enervate</w> the spirit of a nation."
                        }
                    ],
                    "antonyms": [
                        "bolster"
                    ]
                },
                {
                    "sense_id": "9055755d-d383-3314-b23a-4d5e65015233",
                    "sense_definition": "To partially or completely remove a nerve.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon had to <w>enervate</w> the damaged tissue to stop the chronic pain."
                        },
                        {
                            "text": "The procedure was designed to <w>enervate</w> the specific nerve causing the muscle spasms."
                        }
                    ],
                    "synonyms": [
                        "denervate",
                        "deinnervate"
                    ]
                }
            ]
        },
        {
