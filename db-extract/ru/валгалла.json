                ],
                "senses": [
                    {
                        "sense_id": "2278e178-bbbc-3ddd-b968-aa15093c4b9e",
                        "entry_id": "873eeb7d-71c9-3a70-a31a-1647780bb811",
                        "glosses": [
                            "мифол. дворец древнескандинавского бога Одина, где обитают души воинов, павших в бою"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2856c49f-3a18-4944-b3f2-71010dfefa83",
                                "sense_id": "2278e178-bbbc-3ddd-b968-aa15093c4b9e",
                                "text": "Валгалла богов сошла на землю, Зигфрид заволновал весь цивилизованный мир: замерещился новый человек, выкованный земными недрами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97ff74d7-9e82-407b-afd0-641f6fb26f7e",
                        "source_entry_id": "873eeb7d-71c9-3a70-a31a-1647780bb811",
                        "source_sense_id": "2278e178-bbbc-3ddd-b968-aa15093c4b9e",
                        "target_lang_word": "Valhalla",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Valhalla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8075cb3-9fc2-3b68-95e8-f04e668fcb3e",
                                        "entry_id": "bb2efdd8-4560-3282-ab95-6a24e11c1feb",
                                        "glosses": [
                                            "The home of half of all warriors who died gloriously in battle as well as many of the Æsir."
                                        ],
                                        "tags": [
                                            "Norse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e748aee8-48d9-4eeb-b9ce-de7657f391c1",
                                                "sense_id": "f8075cb3-9fc2-3b68-95e8-f04e668fcb3e",
                                                "text": "[S]uch souls as were detruded from the body by any violent method went strait to Valhalla. (Latin original: Nostratibus sane hoc erat infallibiliter persuasum, animas, non vulgares, neque senio morbove, sec cruenta morte & vi corporibus exeuntes, recta ad Vahlallam ferri)"
                                            },
                                            {
                                                "example_id": "d56934d9-d645-4d9d-a4fe-dca7fb7c2735",
                                                "sense_id": "f8075cb3-9fc2-3b68-95e8-f04e668fcb3e",
                                                "text": "In some poems they are envisaged as divine figures, women who serve mead to the dead warriors in Valhall, and who fulfil the will of Odin in overseeing battle and making sure that victory is awarded to the right man."
                                            },
                                            {
                                                "example_id": "f2bf62d1-8afe-49b9-bea8-db7349552785",
                                                "sense_id": "f8075cb3-9fc2-3b68-95e8-f04e668fcb3e",
                                                "text": "So it’s hardly a surprise that the “Call of Duty” and “Assassin’s Creed” franchises put out new releases this week. “Assassin’s Creed Valhalla,” about Vikings and Norse mythology, debuted on November 10, the same day as the Xbox Series X. Three days later, “Call of Duty: Black Ops Cold War,” set in the 1980s, was released."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082c1567-babc-3efe-92c5-a4f0333d6baf",
                                        "entry_id": "bb2efdd8-4560-3282-ab95-6a24e11c1feb",
                                        "glosses": [
                                            "A hamlet and census-designated place in Mount Pleasant, Westchester County, New York, United States."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e299571-93ab-4c9e-a7be-d68462a488c1",
                                                "sense_id": "082c1567-babc-3efe-92c5-a4f0333d6baf",
                                                "text": "Investigators are not sure why the woman’s Mercedes SUV stopped on the tracks Tuesday night in Valhalla, about 30 miles north of New York City, National Transportation Safety Board Member Robert Sumwalt said Wednesday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Valhalla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27e1bd9f-88a7-3b0e-8705-d8e4488158e1",
                                        "entry_id": "4f435f6f-30c2-3768-9060-ccf0277bba28",
                                        "glosses": [
                                            "An abode of the gods or afterlife in general."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3efcfd35-6aeb-43d6-94d5-fdd3fe32e317",
                                                "sense_id": "27e1bd9f-88a7-3b0e-8705-d8e4488158e1",
                                                "text": "“The swans are singing again,” said to one another the gods. And looking downwards, for my dreams had taken me to some fair and far Valhalla, I saw below me an iridescent bubble not greatly larger than a star shine beautifully but faintly, and up and up from it looking larger and larger came a flock of white, innumerable swans, singing and singing and singing, till it seemed as though even the gods were wild ships swimming in music."
                                            },
                                            {
                                                "example_id": "efd80a1f-5d2f-4ef4-a754-0d6aafa2797f",
                                                "sense_id": "27e1bd9f-88a7-3b0e-8705-d8e4488158e1",
                                                "text": "You will all go directly to your respective Valhallas / Go directly, do not pass 'GO', do not collect two hundred dollars"
                                            },
                                            {
                                                "example_id": "0ac27f56-88c2-4fa8-8e7e-8dd191dfce64",
                                                "sense_id": "27e1bd9f-88a7-3b0e-8705-d8e4488158e1",
                                                "text": "Like Philip's, Franco's autarchy was shrouded in religiosity—not Christianity alone, but also a sort of dim Wagnerian vision of hero-gods and Valhallas, a gloomy level of devotion on which paganism, Catholicism and the apotheosis of the State could conveniently be mingled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a6f9afd-a259-4911-90c4-305009a542a9",
                        "source_entry_id": "873eeb7d-71c9-3a70-a31a-1647780bb811",
                        "source_sense_id": "2278e178-bbbc-3ddd-b968-aa15093c4b9e",
                        "target_lang_word": "Walhalla",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Walhalla",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97dee05e-dfc6-3841-bfee-c2628a4a5c01",
                                        "entry_id": "5e56bddc-2b3e-31a5-ba8e-e820b1823abd",
                                        "glosses": [
                                            "von König Ludwig I. erbauter Tempel in Bayern, in dem heute Büsten bedeutender Persönlichkeiten aufgestellt werden"
                                        ],
                                        "tags": [
                                            "die Walhalla"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3149a3fe-1826-4801-8937-7b58ff24c93c",
                                                "sense_id": "97dee05e-dfc6-3841-bfee-c2628a4a5c01",
                                                "text": "Die Walhalla gilt als das Hauptwerk aller Kunstschöpfungen des bayerischen König Ludwig I. (1825-1848)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1be32058-f204-3458-855b-259004d8a0b2",
                                        "entry_id": "5e56bddc-2b3e-31a5-ba8e-e820b1823abd",
                                        "glosses": [
                                            "in der germanischen Mythologie der Ort, an den in der Schlacht gefallene Krieger kommen"
                                        ],
                                        "tags": [
                                            "ohne Artikel oder die/das Walhalla"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86f5ed5e-ae53-434b-9e59-bd2f0f96d1ee",
                                                "sense_id": "1be32058-f204-3458-855b-259004d8a0b2",
                                                "text": "In der altnordischen Mythologie ist Walhalla die große Halle des Gottes Odin in Asgard."
                                            },
                                            {
                                                "example_id": "f272f51f-e9e0-415c-bc6f-d9ef118ac82e",
                                                "sense_id": "1be32058-f204-3458-855b-259004d8a0b2",
                                                "text": "„In der germanischen Mythologie bezeichnet Walhalla die postmortale Wohngemeinschaft der gefallenen Krieger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
