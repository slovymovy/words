                                    {
                                        "sense_id": "0b60f884-d73e-3783-a9a9-5efbc8511877",
                                        "entry_id": "33bab1a2-ff1c-33ac-aec9-e95b4ec53f24",
                                        "glosses": [
                                            "Haltung/Handlung von jemand, die eigene Meinung/das eigene Wissen zu verschleiern"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df7595ce-f270-4786-9763-f1b1867666b2",
                                                "sense_id": "0b60f884-d73e-3783-a9a9-5efbc8511877",
                                                "text": "„Ihre eigenen Briefe an ihn konnten sie nicht trösten, sondern sie empfand sie als Erfüllung einer faden und zur Unaufrichtigkeit zwingenden Pflicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
