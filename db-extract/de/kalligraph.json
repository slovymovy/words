                "senses": [
                    {
                        "sense_id": "2117adf1-275d-3b74-872e-eecc93c92825",
                        "entry_id": "97dc79a1-85af-35fe-ba3f-0fd59dd6ec0d",
                        "glosses": [
                            "Person, die sich der Kalligraphie, der Kunst des Schönschreibens, widmet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10529fe6-5c25-4f00-99a2-a8234045a3c4",
                                "sense_id": "2117adf1-275d-3b74-872e-eecc93c92825",
                                "text": "„Die besten Kalligraphen werden mit den feinen Arbeiten, zum Beispiel mit Aufträgen von Würdenträgern des Adels oder des Klerus, betraut.“"
                            },
                            {
                                "example_id": "8d929ee3-90f3-4b1a-a3c6-1688e411ba8e",
                                "sense_id": "2117adf1-275d-3b74-872e-eecc93c92825",
                                "text": "„Darüber hinaus galt er als talentierter Kalligraph, er legte Gärten an, malte Miniaturen und philosophierte über den Sufismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
