                                            {
                                                "example_id": "ed680536-91b1-4089-a1bc-0bd0d2b13e37",
                                                "sense_id": "5cda71dd-9ebe-3f76-a3b3-b66970fa41cf",
                                                "text": "„Ihr berufliches und privates Verhältnis war herzlich, obwohl sie eine gesunde Distanz wahrten.“"
                                            },
                                            {
                                                "example_id": "0396fbc2-eb59-41ec-8a8c-d6fdca6155a9",
                                                "sense_id": "5cda71dd-9ebe-3f76-a3b3-b66970fa41cf",
                                                "text": "Was machen Sie beruflich?"
                                            },
                                            {
                                                "example_id": "5a3f0de9-f1d6-4d25-91ad-e8f9fad7457f",
                                                "sense_id": "5cda71dd-9ebe-3f76-a3b3-b66970fa41cf",
                                                "text": "Meine berufliche Tätigkeit ist derzeit Maler."
                                            },
                                            {
                                                "example_id": "d67aa1dd-0ad8-45eb-ac4e-17338d59a4d5",
                                                "sense_id": "5cda71dd-9ebe-3f76-a3b3-b66970fa41cf",
                                                "text": "Ein großer Anteil der Absolventen sind nach einigen Jahren beruflich fest etabliert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
