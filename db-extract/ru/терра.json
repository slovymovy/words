                "senses": [
                    {
                        "sense_id": "4bc271c7-2582-36ce-a356-4d562fb885a1",
                        "entry_id": "6b04b90c-cea2-3a96-afd9-5a48569a0776",
                        "glosses": [
                            "неизвестная земля"
                        ],
                        "tags": [
                            "используется в уст. сочет. терра инкогнита"
                        ],
                        "examples": [
                            {
                                "example_id": "26303efa-bf7f-4c1a-bfa8-7c38ad1e0e53",
                                "sense_id": "4bc271c7-2582-36ce-a356-4d562fb885a1",
                                "text": "Для Вельки же таким белым пятном, «терра инкогнита» — таинственной землёй, был потаённый под ватой Уругвай."
                            }
                        ]
                    },
                    {
                        "sense_id": "9085903f-3f9f-36fa-9915-018ddc5f903a",
                        "entry_id": "6b04b90c-cea2-3a96-afd9-5a48569a0776",
                        "glosses": [
                            "перен. нечто неизвестное (в любой сфере)"
                        ],
                        "tags": [
                            "используется в уст. сочет. терра инкогнита"
                        ],
                        "examples": [
                            {
                                "example_id": "1f483a46-e0f7-45da-b889-14876dc200e1",
                                "sense_id": "9085903f-3f9f-36fa-9915-018ddc5f903a",
                                "text": "Финансовый сектор ― банки, страховые и инвестиционные компании ― пока что «терра инкогнита»."
                            }
                        ]
                    }
