                ],
                "senses": [
                    {
                        "sense_id": "66433318-8aaa-33d9-baf3-b23c316a0f2e",
                        "entry_id": "65da990c-203d-3f63-9f31-fead726baec5",
                        "glosses": [
                            "perfektes, meist weiches, Aufsetzen eines Flugkörpers (beispielsweise mit einem Fallschirm, eines Flugzeugs, einer Raumfähre, einer Sonde auf einem fremden Planeten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbac754d-4d77-4857-92bc-cfbb1d962b6f",
                                "sense_id": "66433318-8aaa-33d9-baf3-b23c316a0f2e",
                                "text": "Auf Flügen mit deutschen Touristen klatschen die Passagiere regelmäßig bei einer Bilderbuchlandung."
                            },
                            {
                                "example_id": "35d6f402-3b21-46dc-81bb-ad93137a802b",
                                "sense_id": "66433318-8aaa-33d9-baf3-b23c316a0f2e",
                                "text": "Um 5.57 Ortszeit ist es dann soweit: Atlantis legt eine Bilderbuchlandung hin."
                            },
                            {
                                "example_id": "0b8b4c60-e2c4-42ea-b055-0cfb074cacb1",
                                "sense_id": "66433318-8aaa-33d9-baf3-b23c316a0f2e",
                                "text": "Der Space Shuttle setzte am Mittwoch (26.05.2010) um 14.48 Uhr MESZ mit sechs Astronauten an Bord auf dem Weltraumbahnhof Cape Canaveral in Florida auf. Das Flugkontrollzentrum sprach von einer Bilderbuchlandung […]."
                            },
                            {
                                "example_id": "29ef4dd6-8196-4c4f-a866-d6823eb27dec",
                                "sense_id": "66433318-8aaa-33d9-baf3-b23c316a0f2e",
                                "text": "[…] nach allen Verzögerungen, Problemen und Pannen beendete die Raumfähre Discovery mit einer Bilderbuchlandung auf der Luftwaffenbasis Edwards ihren zweiwöchigen Ausflug ins All."
                            },
                            {
                                "example_id": "a208bd2e-2029-4fd7-aa67-3d7f4bcf952c",
                                "sense_id": "66433318-8aaa-33d9-baf3-b23c316a0f2e",
                                "text": "[Gleitschirmfliegen:] […] Das war keine Bilderbuchlandung. Ich bin in einem Graben heruntergekommen und habe mir den Fuß umgeschlagen."
                            },
                            {
                                "example_id": "4cfd6d2f-3326-48c7-81b5-7d3de8af6015",
                                "sense_id": "66433318-8aaa-33d9-baf3-b23c316a0f2e",
                                "text": "Bereits die weiche Bilderbuchlandung der dreibeinigen, 410 Kilogramm schweren Sonde war ein Erfolg, nachdem in der Vergangenheit mehrere Sonden beim Niedergehen auf dem Mars zerschellt waren."
                            },
                            {
                                "example_id": "4a1bf53d-6fe2-4aa9-9939-df33426c383a",
                                "sense_id": "66433318-8aaa-33d9-baf3-b23c316a0f2e",
                                "text": "Und \"Mars Exploration Rover\" […] enttäuschte sein Publikum nicht: Nach einer Bilderbuchlandung thront das Landegerät auf der tellerflachen Ebene des Gusev-Kraters […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
