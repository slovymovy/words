                            {
                                "example_id": "6b6dd3e8-0179-4815-8af8-0068e9edf441",
                                "sense_id": "4e6c4bf8-d3d2-3851-bde5-351ec09bdd5c",
                                "text": "Als Kind habe ich immer von Kiribati geträumt."
                            },
                            {
                                "example_id": "7c8cf8fe-93e1-427e-9ce8-e0e9e4e5424b",
                                "sense_id": "4e6c4bf8-d3d2-3851-bde5-351ec09bdd5c",
                                "text": "South Tarawa ist die Hauptstadt von Kiribati."
                            },
                            {
                                "example_id": "d5cf4f3a-f6f9-4bc0-b339-1c4d7bcbfaec",
                                "sense_id": "4e6c4bf8-d3d2-3851-bde5-351ec09bdd5c",
                                "text": "„Im 19. Jahrhundert kamen Walfänger, Sklavenhändler und Händler in großer Zahl nach Kiribati.“"
                            },
                            {
                                "example_id": "aed7b51e-8975-4ae0-9f3e-8cb382db1ace",
                                "sense_id": "4e6c4bf8-d3d2-3851-bde5-351ec09bdd5c",
                                "text": "„Die heute 11600 Einwohner des kleinen Landes sind fast alle Polynesier, nur auf der Insel Nui leben Mikronesier aus Kiribati.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
