                                "target_senses": [
                                    {
                                        "sense_id": "174082de-dcfd-366b-8328-a4a8badea9e0",
                                        "entry_id": "fe29e3df-aba7-3be1-9fd3-27f6f2f93daa",
                                        "glosses": [
                                            "Nom de famille allemand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed358c9a-b9d5-490a-bac3-e0d43676cf56",
                                                "sense_id": "174082de-dcfd-366b-8328-a4a8badea9e0",
                                                "text": "Même s'il affirmait lui-même être croyant, Friedrich Hegel (1770-1831) est l'un des principaux précurseurs de l'athéisme philosophique contemporain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Hegel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2edf154b-2b1f-3fef-863f-4d20e6582f2f",
                                        "entry_id": "b7ba608e-4fca-38c4-9392-3455cfb12d5a",
                                        "glosses": [
                                            "Le philosophe allemand Georg Wilhelm Friedrich Hegel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f9a3ae-7851-4a98-815d-2653fe1296ec",
                                                "sense_id": "2edf154b-2b1f-3fef-863f-4d20e6582f2f",
                                                "text": "Pour le jeune Marx, Hegel n'était pas un quelconque philosophe. polissant dans une tranquille retraite une série d'idées abstraites; c'était plutôt le philosophe du monde qui avaIt su saisir en pensée les événements décisifs de son temps – et justement aussi ceux de caractère politique."
                                            }
                                        ]
                                    }
                                ]
                            }
