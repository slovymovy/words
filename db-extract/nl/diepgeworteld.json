                                        "sense_id": "878c4d88-8897-3d7b-bc65-429113eb10c9",
                                        "entry_id": "8ef6209a-2ab5-3a25-b8fb-6eeccf666c39",
                                        "glosses": [
                                            "Naturally as part or consequence of something."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7333d2d-c7e9-4e1a-a0cf-afe1ec794bdb",
                                                "sense_id": "878c4d88-8897-3d7b-bc65-429113eb10c9",
                                                "text": "There is a stern melancholy in his dark features, inherent and engrossing, which rivets the attention."
                                            },
                                            {
                                                "example_id": "f0a867ee-7c6b-4837-9c75-a2a0d0e684aa",
                                                "sense_id": "878c4d88-8897-3d7b-bc65-429113eb10c9",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains.[…]But out of sight is out of mind. And that, together with the inherent yuckiness of the subject, means that many old sewers have been neglected and are in dire need of repair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
