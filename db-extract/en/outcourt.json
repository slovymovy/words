    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "280535aa-d2b6-312f-88b0-499baabc73af",
                "word": "outcourt",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d2500b37-77cb-3a83-b5fa-3d0772424eac",
                        "entry_id": "280535aa-d2b6-312f-88b0-499baabc73af",
                        "glosses": [
                            "Playing or played on the outcourt."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6204da1c-0f92-45bc-81e2-947fc05ab3ab",
                                "sense_id": "d2500b37-77cb-3a83-b5fa-3d0772424eac",
                                "text": "Special mention is due Abadie, 03, Heyman, 04, whose outcourt playing is excellent, and Roos, '04, who has shown good judgment in placing the ball."
                            },
                            {
                                "example_id": "49e23ec9-0781-4ecc-be3b-b7d9d2d48bdc",
                                "sense_id": "d2500b37-77cb-3a83-b5fa-3d0772424eac",
                                "text": "The middle man normally will be the outcourt defensive man, away from the rebound."
                            },
                            {
                                "example_id": "03a4da04-bd30-4a7d-81c6-a9e69fca1b25",
                                "sense_id": "d2500b37-77cb-3a83-b5fa-3d0772424eac",
                                "text": "It should also be remembered that the outcourt shots are all taken from behind the screen."
                            },
                            {
                                "example_id": "85119e22-2543-4027-a465-a58942f1c7a4",
                                "sense_id": "d2500b37-77cb-3a83-b5fa-3d0772424eac",
                                "text": "Handball is a team sport in which two teams of seven players each (six outcourt players and a goalkeeper) pass a ball using their hands with the aim of throwing it into the goal of the other team."
                            }
                        ]
                    },
                    {
                        "sense_id": "43350432-2d22-3914-910e-9cda2df718d7",
                        "entry_id": "280535aa-d2b6-312f-88b0-499baabc73af",
                        "glosses": [
                            "Occurring outside the courtroom; adjudicated outside of a trial."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a0b14882-f13f-4cf8-af0f-e8aff5ee65e9",
                                "sense_id": "43350432-2d22-3914-910e-9cda2df718d7",
                                "text": "As Ash-Sharq Al-Awsat apologises for having published the claims originally published by The Sunday Telegraph regarding Mr. Rached Ghannouchi who has won a court case against the paper. It publishes this clarification in its insistance upon objective truth and the rights of readers and of Mr. Ghannouchi, after having reached an outcourt settlement with Mr. Ghannouchi, and expresses its regret for what the news item has caused him."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6c75b347-aafa-3e9d-96bc-8507d999a350",
                "word": "outcourt",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b8b13314-02b8-3ad0-a56b-12089414c72c",
                        "entry_id": "6c75b347-aafa-3e9d-96bc-8507d999a350",
                        "glosses": [
                            "On the outcourt."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3afdd32e-c733-4bb0-a682-49dbccf453b7",
                                "sense_id": "b8b13314-02b8-3ad0-a56b-12089414c72c",
                                "text": "Many coaches are of the opinion that high school teams attempt too many rebound shots but would profit by dribbling or passing the ball outcourt more often and starting their offensive attack over again."
                            },
                            {
                                "example_id": "e443f03e-bc75-4e26-82e7-3941e780a647",
                                "sense_id": "b8b13314-02b8-3ad0-a56b-12089414c72c",
                                "text": "Jack felt a warm glow of pride as he watched his brother smoothly carry the ball outcourt and then turn to drive in with flashing legs and lace the leather through the net."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d290d9c3-cb71-3719-ba88-1a5481b26bac",
                "word": "outcourt",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "81a91960-6b18-483c-8847-07ed784aff30",
                        "entry_id": "d290d9c3-cb71-3719-ba88-1a5481b26bac",
                        "tags": [
                            "plural"
                        ],
                        "form": "outcourts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "24fe86e2-e3b2-3693-9a71-51c7a97df855",
                        "entry_id": "d290d9c3-cb71-3719-ba88-1a5481b26bac",
                        "glosses": [
                            "An outer or exterior court."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abf663dc-caad-4ff6-a8c6-e96eb28435a3",
                                "sense_id": "24fe86e2-e3b2-3693-9a71-51c7a97df855",
                                "text": "the skirts and outcourts of heaven"
                            },
                            {
                                "example_id": "88c60dad-3595-4f87-b8f8-b2061a68875c",
                                "sense_id": "24fe86e2-e3b2-3693-9a71-51c7a97df855",
                                "text": "There is an outcourt or quadrant, whereof one side is a gallery to walk in, being in length six hundred feet."
                            },
                            {
                                "example_id": "99060cbe-1a6e-436d-945d-ae9ab88c8ca3",
                                "sense_id": "24fe86e2-e3b2-3693-9a71-51c7a97df855",
                                "text": "If it is made up of those who shall persevere in holiness to the end of life, and be saved with an everlasting salvation, the church on earth being, as it werre, the outcourt and emblem of the church in heaven, and the church militant composed of those who shall form the church triumphant, then infants have properly no place in it."
                            },
                            {
                                "example_id": "04c4a419-e0b7-440b-a435-88c01872a68f",
                                "sense_id": "24fe86e2-e3b2-3693-9a71-51c7a97df855",
                                "text": "About the middle of June, 1642, the Residence of the Fathers at St. Marys-on-the-Wye, its outcourt and surrounding buildings, slept in dreamy, peaceful slumber."
                            }
                        ]
                    },
                    {
                        "sense_id": "045187d7-b247-3550-a0f2-28593b320489",
                        "entry_id": "d290d9c3-cb71-3719-ba88-1a5481b26bac",
                        "glosses": [
                            "The other half of the court from the goal one is aiming for."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1de2edd0-db69-4c98-bb15-bc917c3c687a",
                                "sense_id": "045187d7-b247-3550-a0f2-28593b320489",
                                "text": "Offensive player in the middle of the outcourt receives a pass from one of his teammates."
                            },
                            {
                                "example_id": "ef3198cd-bbee-43e6-ada8-4d17f9aeac31",
                                "sense_id": "045187d7-b247-3550-a0f2-28593b320489",
                                "text": "For Calvin it was Rog Postmus with 18, mostly from outcourt, Duane Rosendahl with 16, Stu Sisco with 15, and Preston \"Butts\" Kool had 10."
                            },
                            {
                                "example_id": "1cd53068-eb97-4256-a57e-75adf87daa83",
                                "sense_id": "045187d7-b247-3550-a0f2-28593b320489",
                                "text": "[…] shows that all shots are taken from outcourt, this is not necessarily true because it is possible, by reversing direction, for the dribbler to catch his guard overplaying him and drive in for a layup."
                            }
                        ]
                    }
                ],
