                        "entry_id": "c1a1b116-5c7b-342e-870e-8f8fae0b22da",
                        "glosses": [
                            "Gerät zur Bestimmung der Staubkonzentration auf Basis der Lichtstreuung an Luftschwebeteilchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cf8e179-587f-4a61-aa92-b9fba0fe4053",
                                "sense_id": "b9d446e2-f5fd-373a-babe-9a3e019b4c83",
                                "text": "„Dann wurde Luft entweder aus dem Mund oder aus der Nase herausgesaugt und ebenfalls mit dem Tyndallometer untersucht.“"
                            },
                            {
                                "example_id": "1cf8e3b2-14cd-426b-b8e3-292e5103ff12",
                                "sense_id": "b9d446e2-f5fd-373a-babe-9a3e019b4c83",
                                "text": "„Diese Autoren maßen den Staubgehalt vor und hinter dem Filter mit dem Tyndallometer.“"
                            }
                        ],
