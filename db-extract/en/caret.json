                                    }
                                ]
                            },
                            {
                                "target_word": "Dach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df61988f-7c59-3ee4-aedc-46e70fdd8374",
                                        "entry_id": "cfff12a6-e1d1-3b89-bb96-0147e629578d",
                                        "glosses": [
