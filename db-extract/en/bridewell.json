                                "example_id": "43b19190-1fde-4eb9-a72e-00098e8bdb5a",
                                "sense_id": "a0281203-69e3-384c-bc84-43bc6b296bc4",
                                "text": "Others in the Bridewell heard him screaming. Even prison doctors could see. His injuries were not self-inflicted. Those who tipped the scales did not agree."
                            },
                            {
                                "example_id": "2a1efc7a-41ff-4795-a7b1-8ec3ecb43cb2",
                                "sense_id": "a0281203-69e3-384c-bc84-43bc6b296bc4",
                                "text": "Two Fermanagh girls who never laughed were certain that he must have served time in a bridewell, so cold was his expression and so calloused his small hands."
                            }
                        ]
