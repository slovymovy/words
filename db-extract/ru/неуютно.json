        "ru-extract.jsonl": [
            {
                "entry_id": "aabc46ac-9ffe-3885-a0d1-5db8e34cf308",
                "word": "неуютно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1cfb8aba-f66e-32a9-83a3-c5647ec60150",
                        "entry_id": "aabc46ac-9ffe-3885-a0d1-5db8e34cf308",
                        "glosses": [
                            "наречие к неуютный; без уюта, с ощущением неудобства"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "52c0bd78-3b35-40d3-8a1e-da0787ab7487",
                                "sense_id": "1cfb8aba-f66e-32a9-83a3-c5647ec60150",
                                "text": "Откровенно говоря, уезжая из Канберры, мы без документов чувствовали себя неуютно."
                            },
                            {
                                "example_id": "e05acb8a-1932-4771-9402-25447fca8c34",
                                "sense_id": "1cfb8aba-f66e-32a9-83a3-c5647ec60150",
                                "text": "Она была филармонической певицей, жила одна в комнате, расположенной крайне неуютно ― в закуте, откуда еще две двери вели в общие ванную и уборную."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4fc8d1d-5a6e-3365-b409-c0438b444707",
                        "entry_id": "aabc46ac-9ffe-3885-a0d1-5db8e34cf308",
                        "glosses": [
                            "вызывает ощущение отсутствия уюта"
                        ],
                        "tags": [
                            "в знач. сказуемого"
                        ],
                        "examples": [
                            {
                                "example_id": "2b74e1f7-49bd-485b-b2a9-1347d613659f",
                                "sense_id": "a4fc8d1d-5a6e-3365-b409-c0438b444707",
                                "text": "Пронесла свою сумку сперва на кухню, но там было грязно и неуютно, решила поесть в гостиной."
                            }
                        ]
                    }
                ],
