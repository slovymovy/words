                    },
                    {
                        "translation_id": "dc678bca-e8f2-4769-9912-0cc8d419b474",
                        "source_entry_id": "fa357448-4a64-3f1a-89ca-d1ee6a07dc01",
                        "target_lang_word": "ombre",
