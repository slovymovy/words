    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "76b8f5d2-85bb-39c9-af52-a7a9773839b5",
                    "sense_definition": "Relating to an area where people live rather than where there are commerce or industry.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "housing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to move to a quiet <w>residential</w> neighborhood away from the city center.",
                            "target_lang_translations": {
                                "ru": "Они решили переехать в тихий <w>жилой</w> район вдали от центра города."
                            }
                        },
                        {
                            "text": "The city council is planning to build a new <w>residential</w> area near the park.",
                            "target_lang_translations": {
                                "ru": "Городской совет планирует построить новый <w>жилой</w> массив рядом с парком."
                            }
                        }
                    ],
                    "synonyms": [
                        "domestic",
                        "housing"
                    ],
                    "antonyms": [
                        "commercial",
                        "industrial"
                    ],
                    "common_phrases": [
                        "residential neighborhood",
                        "residential area",
                        "residential street"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к району, где люди живут, а не к коммерческим или промышленным зонам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жилой",
                                "target_lang_sense_clarification": "о районе или квартале"
                            },
                            {
                                "target_lang_word": "спальный",
                                "target_lang_sense_clarification": "о районе города"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15eeaaaf-c569-393a-81b5-62fccddd39cf",
                    "sense_definition": "Used as a place to live or providing accommodation for people to stay.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "housing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old hotel was converted into a <w>residential</w> home for the elderly.",
                            "target_lang_translations": {
                                "ru": "Старый отель был переоборудован в <w>жилой</w> дом для престарелых."
                            }
                        },
                        {
                            "text": "Students can choose to live in <w>residential</w> halls on the university campus.",
                            "target_lang_translations": {
                                "ru": "Студенты могут выбрать проживание в <w>жилых</w> корпусах на территории университетского кампуса."
                            }
                        }
                    ],
                    "synonyms": [
                        "habitable"
                    ],
                    "common_phrases": [
                        "residential home",
                        "residential building",
                        "residential property"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используемый в качестве места для проживания или предоставляющий жилье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жилой",
                                "target_lang_sense_clarification": "о здании или помещении"
                            },
                            {
                                "target_lang_word": "жилищный",
                                "target_lang_sense_clarification": "связанный с жильем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10df7e02-00b7-3922-8729-ac7178a5eede",
                    "sense_definition": "Relating to the legal or official status of living in a particular place.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a <w>residential</w> requirement for obtaining a marriage license in this state.",
                            "target_lang_translations": {
                                "ru": "В этом штате существует требование к <w>проживанию</w> для получения разрешения на брак."
                            }
                        },
                        {
                            "text": "The lawyer explained the <w>residential</w> status needed to qualify for the local tax benefits.",
                            "target_lang_translations": {
                                "ru": "Адвокат объяснил статус <w>резидента</w>, необходимый для получения местных налоговых льгот."
                            }
                        }
                    ],
                    "common_phrases": [
                        "residential requirement",
                        "residential status",
                        "residential qualification"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к юридическому или официальному статусу проживания в определенном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связанный с проживанием",
                                "target_lang_sense_clarification": "о требованиях или статусе"
                            },
                            {
                                "target_lang_word": "резидентский",
                                "target_lang_sense_clarification": "о статусе или цензе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d3114b3-fd85-3d75-8b13-bd748f02db88",
                    "sense_definition": "A trip or course, often for students or employees, where they stay overnight at a specific location.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trips",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The youth group organizes annual <w>residentials</w> to help build teamwork skills.",
                            "target_lang_translations": {
                                "ru": "Молодежная группа организует ежегодные <w>выездные сборы</w> для развития навыков командной работы."
                            }
                        },
                        {
                            "text": "All new employees must attend a three-day <w>residential</w> at the training center.",
                            "target_lang_translations": {
                                "ru": "Все новые сотрудники должны посетить трехдневный <w>выездной тренинг</w> в учебном центре."
                            }
                        }
                    ],
                    "synonyms": [
                        "retreat"
                    ],
                    "common_phrases": [
                        "annual residential",
                        "school residential"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поездка или курс (для студентов или сотрудников), предполагающий проживание на месте проведения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выездной семинар",
                                "target_lang_sense_clarification": "с проживанием"
                            },
                            {
                                "target_lang_word": "выездное мероприятие",
                                "target_lang_sense_clarification": "с ночевкой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
