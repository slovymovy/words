                    {
                        "sense_id": "645ad11a-ba68-3ed8-a4c6-e00957c3cf7d",
                        "entry_id": "c9a8efa4-b63d-3bae-b22b-2115379c4a4e",
                        "glosses": [
                            "Portefeuille."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dff2ecae-8528-4b1a-8bd6-0e396d6fd553",
                                "sense_id": "645ad11a-ba68-3ed8-a4c6-e00957c3cf7d",
                                "text": "Après nous avoir donné son pognon, elle n’avait plus à craindre qu’on lui tire son lazingue."
                            },
                            {
                                "example_id": "6faa5492-d438-4b7e-94f2-1321d9bea5a2",
                                "sense_id": "645ad11a-ba68-3ed8-a4c6-e00957c3cf7d",
                                "text": "— Les papiers de cette voiture !… La carte grise !… votre permis de conduire !\n— Tiens ! vous êtes à la circulation maintenant, charrie Paulo, sortant son lazingue."
                            },
                            {
                                "example_id": "10f169c1-cbe5-4b38-9eb7-75c817112b6a",
                                "sense_id": "645ad11a-ba68-3ed8-a4c6-e00957c3cf7d",
                                "text": "Ce n'était pas ses noix qui excitaient Torticolis, lequel tentait tout bonnement de lui soulever son lazingue logé dans la poche arrière de son culbutant."
                            },
                            {
                                "example_id": "91c4b7b2-b486-4536-8043-4e284aa1df70",
                                "sense_id": "645ad11a-ba68-3ed8-a4c6-e00957c3cf7d",
                                "text": "C’était un porte-feuille, un lazingue… un morlingue. Le porte-monnaie c’était le crapaud, le crapotard… ne pas confondre."
                            }
                        ]
                    }
