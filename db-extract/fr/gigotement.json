                "entry_id": "8890f5ec-e9a9-3955-9dd1-d503c339d9fb",
                "word": "gigotement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8bcb2d8c-930c-453e-b6de-fe249091a231",
                        "entry_id": "8890f5ec-e9a9-3955-9dd1-d503c339d9fb",
                        "tags": [
                            "plural"
                        ],
                        "form": "gigotements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73f8150e-069f-3389-b7a9-ade345df0825",
                        "entry_id": "8890f5ec-e9a9-3955-9dd1-d503c339d9fb",
                        "glosses": [
                            "Action de gigoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c54477e-ee06-436a-aecb-4d01bcee6adc",
                                "sense_id": "73f8150e-069f-3389-b7a9-ade345df0825",
                                "text": "[…] mais en réalité une rage impuissante produisait en moi comme des trépignements, des gigotements… cette fureur aveugle, absurde que provoque un objet contre lequel on est venu se cogner durement, on a envie de le cogner à son tour, j’avais envie de taper dessus, de lui donner des coups."
                            },
                            {
                                "example_id": "bdef9c1e-35bd-4c05-98c2-a3c99b1cc6d2",
                                "sense_id": "73f8150e-069f-3389-b7a9-ade345df0825",
                                "text": "Couché là, il sentait son cœur battre la chamade, subissant la contagion des spasmes qui agitaient son corps, du gigotement de ses jambes."
                            },
                            {
                                "example_id": "57979f99-5ff1-480e-a7f3-6e378a1b1fce",
                                "sense_id": "73f8150e-069f-3389-b7a9-ade345df0825",
                                "text": "Si vous êtes à son écoute, vous reconnaîtrez ses gestes, ses cris, ses petits gigotements comme autant d'indices qu'il vous donne : il a faim, il est content, il a peur."
                            },
                            {
                                "example_id": "dab1999f-d390-4205-b61c-ff64e5237d14",
                                "sense_id": "73f8150e-069f-3389-b7a9-ade345df0825",
                                "text": "J'allais désormais pouvoir assister en spectateur aux gigotements d'une Europe de plus en plus impuissante sans me demander si je dépendais des Arabes, du shah d'Iran, de Kissinger ou d'Amin Dada."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "beea7933-58bb-44ba-b740-287acf344fb8",
                        "source_entry_id": "8890f5ec-e9a9-3955-9dd1-d503c339d9fb",
                        "source_sense_id": "73f8150e-069f-3389-b7a9-ade345df0825",
                        "target_lang_word": "getrappel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "getrappel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b75e3519-e714-3d2e-a40f-f04f928de28c",
                                        "entry_id": "2db0e0dc-50a2-380a-bf8a-65763c1c0062",
                                        "glosses": [
                                            "het ongeduldig met de hoeven op de grond stampen van paarden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4385c092-0001-4280-80d0-dce48f956d5a",
                                                "sense_id": "b75e3519-e714-3d2e-a40f-f04f928de28c",
                                                "text": "Heel de nacht hoor ik het getrappel van paarden, die mijn huis voorbijsnellen en dan terugkeren en weer wegrennen, krek alsof de staf van het leger zijn zinnen verloren heeft en niet wijs is wat met zijn eskadrons aan te vangen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97f4db87-f245-332b-ad5b-812d7e3bfc70",
                                        "entry_id": "2db0e0dc-50a2-380a-bf8a-65763c1c0062",
                                        "glosses": [
                                            "het ongedurig bewegen van de armen en benen van mensen en dieren in het water of om zich te bevrijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b981130b-45c1-4147-b4a2-1c8e1c83d58a",
                                                "sense_id": "97f4db87-f245-332b-ad5b-812d7e3bfc70",
                                                "text": "Ik werd wel dikker, maar over mijn hele lijf: mijn armen en benen net zo hard. Ik droeg de placenta naar voren en voelde daardoor geen getrappel of geschop. Een hoop kwaaltjes gooide ik maar op de overgang."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19fa98e3-189b-4a2c-b866-a51594c48ca1",
                        "source_entry_id": "8890f5ec-e9a9-3955-9dd1-d503c339d9fb",
                        "source_sense_id": "73f8150e-069f-3389-b7a9-ade345df0825",
                        "target_lang_word": "gespartel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gespartel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7b27f60c-f6a9-3e66-b48b-35bf0932d530",
                                        "entry_id": "78e11b0d-b0f6-31cc-8dbc-d90af862317e",
                                        "glosses": [
                                            "het aanhoudend spartelen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b345c8dc-7d44-41f5-8ff5-5aef81668b57",
                                                "sense_id": "7b27f60c-f6a9-3e66-b48b-35bf0932d530",
                                                "text": "Kijk hoe Rutte onze Defensie heeft uitverkocht, de zorg kapot heeft gemaakt met zijn bezuinigingen, het falende beleid met de bootvluchtelingen, de open grenzen, het machteloze gespartel van de EU."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ed47d61-f404-3bca-b2f4-13f0b44ccb1c",
                                        "entry_id": "78e11b0d-b0f6-31cc-8dbc-d90af862317e",
                                        "glosses": [
                                            "vergeefse poging om vrij te komen uit een in een net gevangen vis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc124bd7-bf0d-4c36-b0a8-e8dd317c86c4",
                                                "sense_id": "5ed47d61-f404-3bca-b2f4-13f0b44ccb1c",
                                                "text": "Het gespartel is vastgelegd met een mobiele telefoon (zie video hieronder). Internetters doopten de vis al om als ’zombievis’. Volgens Het Nieuwsblad belden sommige mensen zelfs naar dierenorganisaties om te vragen of het om dierenmishandeling gaat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34e9bf88-d8c1-35f7-9f9c-b0079bb5db9c",
                                        "entry_id": "78e11b0d-b0f6-31cc-8dbc-d90af862317e",
                                        "glosses": [
                                            "wild bewegen in het water"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4adc3cb3-ac85-4d15-ad5b-8ef68e2f8308",
                                                "sense_id": "34e9bf88-d8c1-35f7-9f9c-b0079bb5db9c",
                                                "text": "De twee jongemannen uit Westerhaar waren op zaterdag 23 november bij een vriend in Vroomshoop geweest. Toen ze het welletjes vonden en naar huis fietsten, hoorden ze gespartel in het water. „We wisten toen nog niet wat het was, het kon ook een dier zijn”, zegt Thomas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
