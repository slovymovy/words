            "senses": [
                {
                    "sense_id": "f7e9570e-4276-3e29-8afc-a1af9a25853d",
                    "sense_definition": "Qui est sur le point de se produire, d'avoir lieu incessamment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temporel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'annonce de son départ <w>imminent</w> a surpris l'ensemble de ses collègues de bureau."
                        },
                        {
                            "text": "Le personnel de la gare annonce l'arrivée <w>imminente</w> du train en provenance de Lyon."
                        }
                    ],
                    "synonyms": [
