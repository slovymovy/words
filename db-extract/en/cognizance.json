                        "cross_references": [
                            {
                                "target_word": "embleem",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b216bda1-2154-3ef2-bb7b-9ace63124bdc",
                                        "entry_id": "bee6ebe2-4c72-3e45-8989-1b7dbbdce977",
                                        "glosses": [
                                            "een concrete figuur waarmee een abstract begrip zoals een godheid, een ideaal, een gevoel enz. wordt verbeeld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b65c544-cc1b-4f51-babf-4f3cbd9f3c31",
                                                "sense_id": "b216bda1-2154-3ef2-bb7b-9ace63124bdc",
                                                "text": "Een hart is het embleem van \"de liefde\"."
                                            },
                                            {
                                                "example_id": "cd04eb3f-e783-4099-88d0-9d947a22bfe9",
                                                "sense_id": "b216bda1-2154-3ef2-bb7b-9ace63124bdc",
                                                "text": "Dat veranderde aan de zaak niets, maar voor iedereen stond vast dat de moffen niet zomaar twee Franse soldaten hadden gedood, maar twee emblemen hadden weggemaaid. Woede alom, dus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66510db9-8ee6-32dc-8a1e-f1167c2324e6",
                                        "entry_id": "bee6ebe2-4c72-3e45-8989-1b7dbbdce977",
                                        "glosses": [
                                            "figuur waarmee iets concreets wordt verbeeld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bee4dcb3-168f-47e2-8be5-0e1d78db1f9c",
                                                "sense_id": "66510db9-8ee6-32dc-8a1e-f1167c2324e6",
                                                "text": "Aan de oever lag een man in de zon die van top tot teen bedekt was met tatoeages. Thru-hike-tattoos welteverstaan. Over de lengte van zijn benen waren de routes en emblemen van verschillende Thru-hikes vereeuwigd."
                                            },
                                            {
                                                "example_id": "0ad614d1-bdd4-4c95-b00d-85d9b5593bc4",
                                                "sense_id": "66510db9-8ee6-32dc-8a1e-f1167c2324e6",
                                                "text": "Hij belandde in een coupé met een mooi meisje in een rode jurk en ontdekte tot zijn ontsteltenis dat ze een of ander sociaaldemocratisch embleem op haar kraag had, vermoedelijk het logo van de jongerenorganisatie, naar wat hij nu wist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
