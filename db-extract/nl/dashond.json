                                                "sense_id": "b3809840-0e88-329d-858c-4d4c756ac725",
                                                "text": "On chasse le blaireau avec des bassets."
                                            },
                                            {
                                                "example_id": "16a71e75-7465-4c3e-bb9c-48fb3ce98e99",
                                                "sense_id": "b3809840-0e88-329d-858c-4d4c756ac725",
                                                "text": "Basset à jambes droites. Basset à jambes torses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76389f2f-ac55-321d-b4e0-91f5977fe46b",
                                        "entry_id": "68e458ad-ddf9-3a2b-853c-dbcc142343bc",
                                        "glosses": [
                                            "Petit homme dont les jambes et les cuisses sont trop courtes pour sa taille."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "ironic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b949fbbf-9339-3daa-b087-85521a106e2a",
                                        "entry_id": "68e458ad-ddf9-3a2b-853c-dbcc142343bc",
                                        "glosses": [
                                            "Escabeau, tabouret de forme basse en usage au Moyen Âge."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
