                            },
                            {
                                "target_lang_word": "смущающий",
                                "target_lang_sense_clarification": "заставляющий смущаться"
                            },
                            {
                                "target_lang_word": "постыдный",
                                "target_lang_sense_clarification": "вызывающий стыд"
                            },
                            {
                                "target_lang_word": "затруднительный",
