                ],
                "senses": [
                    {
                        "sense_id": "35f998ef-d7b2-37cf-b43c-2b45437a7043",
                        "entry_id": "99eaa03b-8cf7-3739-8d56-82c48ea4c79a",
                        "glosses": [
                            "Plante hyperaccumulatrice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae4243b5-f874-4491-ba68-0216d4f838f1",
                                "sense_id": "35f998ef-d7b2-37cf-b43c-2b45437a7043",
                                "text": "Les métaux présents dans les feuilles de l’hyperaccumulateur \"Thlaspi caerulescens\" sont très disponibles après incorporation dans le sol."
                            },
                            {
                                "example_id": "92e0041a-f6e3-4126-aef7-3fe0d886d772",
                                "sense_id": "35f998ef-d7b2-37cf-b43c-2b45437a7043",
                                "text": "La thèse était destinée à connaître le comportement et l'aptitude à extraire les métaux d'un hyperaccumulateur de Zn/Cd, Thlaspi caerulescens, sur différents sols pollués et d'évaluer sa réponse à des pratiques agronomiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "145c428a-2154-4a42-afa1-2ef26382d7f1",
                        "source_entry_id": "99eaa03b-8cf7-3739-8d56-82c48ea4c79a",
                        "source_sense_id": "35f998ef-d7b2-37cf-b43c-2b45437a7043",
                        "target_lang_word": "Metallschlucker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
