                "senses": [
                    {
                        "sense_id": "e78851db-e466-3cf5-98e4-573e9276e659",
                        "entry_id": "3afc8191-26ed-3002-81f5-a3739b8e94ef",
                        "glosses": [
                            "Deck (auf einem Sklavenschiff), auf dem die Sklaven untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e36f76c-fc63-4a32-a47a-cf8f55ab2fe5",
                                "sense_id": "e78851db-e466-3cf5-98e4-573e9276e659",
                                "text": "„Während das Sklavendeck der Diligent sich allmählich füllte und schließlich gedrängt voll war, wurden die Männer der Besatzung immer nervöser, denn sie wussten, dass sich Sklavenrevolten meistens ereigneten, während das Land noch in Sicht war.“"
                            },
                            {
                                "example_id": "0a7fbdf1-7f36-44a4-a3f8-69111ac2356e",
                                "sense_id": "e78851db-e466-3cf5-98e4-573e9276e659",
                                "text": "„Eine Anzahl von Deckschrauben, um montierbare Sklavendecks zu fixieren, wurden zufällig in Portsmouth von einem Navigationslehrer gesehen.“"
                            },
                            {
                                "example_id": "4c99bea8-4468-41fc-a4fb-15cb8860c335",
                                "sense_id": "e78851db-e466-3cf5-98e4-573e9276e659",
                                "text": "„Es zeigte sich, daß das Sklavendeck so unerträglich war, daß sie zur Verzweiflung getrieben wurden.“"
                            },
                            {
                                "example_id": "60f6ad40-74b4-4939-a65b-55e5269a6476",
                                "sense_id": "e78851db-e466-3cf5-98e4-573e9276e659",
                                "text": "„Sie waren genauso niedrig wie das Sklavendeck und somit nur zum Schlafen gedacht. “"
                            },
                            {
                                "example_id": "4cb8bf7e-85b1-4755-873a-d7b575c09ec0",
                                "sense_id": "e78851db-e466-3cf5-98e4-573e9276e659",
                                "text": "„ Die Höhe des Sklavendecks hatte einem Gesetz zufolge mindestens fünf Fuß zu betragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
