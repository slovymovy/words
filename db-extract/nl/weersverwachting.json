                                            {
                                                "example_id": "2dc848cd-8d49-4bd5-a708-2d75f69a95ac",
                                                "sense_id": "6aa6abd3-bbab-30f5-9304-5e9e2e63bc10",
                                                "text": "Near-synonym: weather report"
                                            },
                                            {
                                                "example_id": "6bcae90d-0bf8-4dbb-bff0-d521f1a01229",
                                                "sense_id": "6aa6abd3-bbab-30f5-9304-5e9e2e63bc10",
                                                "text": "It may be sunny today, but the weather forecast is predicting rain for tomorrow."
                                            }
