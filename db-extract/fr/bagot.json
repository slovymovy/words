                "senses": [
                    {
                        "sense_id": "e348b6e8-9415-3340-818d-bd8fe6a36312",
                        "entry_id": "4957a40a-a282-383e-a18c-5a7441b967c2",
                        "glosses": [
                            "Bagage."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e878be76-c6f2-4336-975e-1c67a828828a",
                                "sense_id": "e348b6e8-9415-3340-818d-bd8fe6a36312",
                                "text": "Le père de Fatoumata a dit à Mamadou : “Prends tes bagots et quitte la ville.”"
                            },
                            {
                                "example_id": "7560366f-d413-440c-a028-d2d72f8c0e9f",
                                "sense_id": "e348b6e8-9415-3340-818d-bd8fe6a36312",
                                "text": "Bagoter , ou faire des bagots, c'était, en argot parisien, courir après les voitures pour décharger les bagages et ceux qui faisaient ce métier s'appelaient bagotiers."
                            },
                            {
                                "example_id": "ff351dba-408f-4bf8-bff1-d99b12d70006",
                                "sense_id": "e348b6e8-9415-3340-818d-bd8fe6a36312",
                                "text": "Un chauffeur vêtu d'un complet bleu, chemise blanche, cravate noire, stoppe près des bagots et descend délourder la malle."
                            }
                        ]
                    }
