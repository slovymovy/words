                                                "sense_id": "59d36008-0159-3849-b82e-d17f85ab6b59",
                                                "text": "youthful vitality"
                                            },
                                            {
                                                "example_id": "edb3d53b-74fa-416b-8dc4-32c6a5f4cfa2",
                                                "sense_id": "59d36008-0159-3849-b82e-d17f85ab6b59",
                                                "text": "full of vitality"
                                            },
                                            {
                                                "example_id": "4349517b-641e-40fb-8fd8-433c7ab18115",
                                                "sense_id": "59d36008-0159-3849-b82e-d17f85ab6b59",
                                                "text": "economic vitality"
                                            },
                                            {
                                                "example_id": "fae182f6-0975-4054-995a-5d86ec65faaa",
                                                "sense_id": "59d36008-0159-3849-b82e-d17f85ab6b59",
                                                "text": "The city’s cultural vitality impressed the visitors."
                                            },
                                            {
                                                "example_id": "63fc74f7-4dd4-4163-9d0a-1b467a9c5b17",
                                                "sense_id": "59d36008-0159-3849-b82e-d17f85ab6b59",
                                                "text": "He maintained his vitality well into old age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45904ff7-3bae-31a2-ab79-05e543b816b0",
                                        "entry_id": "c0bd8da1-2638-3dd2-be92-f7dc948b378e",
