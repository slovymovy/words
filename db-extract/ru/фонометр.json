                    {
                        "translation_id": "27579aee-e045-4c34-ade5-cb06f44c1ffb",
                        "source_entry_id": "d24aa6ab-780e-3887-a820-8897d5f56436",
                        "source_sense_id": "44d8a712-8257-3532-9597-432a830f6349",
                        "target_lang_word": "Phonometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phonometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1bf602f-6769-3ce1-976a-5d9214ab723a",
                                        "entry_id": "db230ab4-5298-3b1f-aed1-fb9eaeacda94",
                                        "glosses": [
                                            "Messgerät für den Schalldruckpegel und die Lautstärke"
                                        ],
                                        "tags": [
                                            "Akustik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba949298-7d2b-43aa-b53e-9d21acbe0e12",
                                                "sense_id": "d1bf602f-6769-3ce1-976a-5d9214ab723a",
                                                "text": "„Mein Phonometer zeigt an, daß sie Ultraschallwellen von höchster Frequenz und Intensität ausstoßen.“"
                                            },
                                            {
                                                "example_id": "3b448a91-0cc2-449e-90da-3f1eaf9f2663",
                                                "sense_id": "d1bf602f-6769-3ce1-976a-5d9214ab723a",
                                                "text": "„Es ergab sich daher die Notwendigkeit, mit einem Phonometer die angewandte Stimmstärke zu messen.“"
                                            },
                                            {
                                                "example_id": "152dde64-6f21-4a42-8a09-479029c705cb",
                                                "sense_id": "d1bf602f-6769-3ce1-976a-5d9214ab723a",
                                                "text": "„Dieses Schreien wurde mit einem Phonometer gemessen und ergab einen Durchschnittswert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "680e22c9-7521-3a97-bf43-3af323511251",
                                        "entry_id": "db230ab4-5298-3b1f-aed1-fb9eaeacda94",
                                        "glosses": [
                                            "Instrument zum Messen der Empfindlichkeit des Gehörs oder eines Mikrofons"
                                        ],
                                        "tags": [
                                            "Akustik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13d0424e-9600-4a8a-ae41-6635a6860556",
                                                "sense_id": "680e22c9-7521-3a97-bf43-3af323511251",
                                                "text": "„Am eingehendsten ist das Gehör zu prüfen, wobei neben den geläufigen Methoden auch das Phonometer von Estefanini-Gradenigo Verwendung findet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
