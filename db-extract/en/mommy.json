                "senses": [
                    {
                        "sense_id": "eea2c2e7-56dc-3ad4-ac55-ad4c4c0a6683",
                        "entry_id": "f90bb331-f7d2-313c-9b03-047cc75448c3",
                        "glosses": [
                            "Characteristic of a mother; motherly."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "informal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8d82f93b-f410-477f-a23a-884a349ba00e",
                                "sense_id": "eea2c2e7-56dc-3ad4-ac55-ad4c4c0a6683",
                                "text": "She is the mommiest of mommies."
                            },
                            {
                                "example_id": "d958b164-f7dc-48ba-b7c7-e9933457428d",
                                "sense_id": "eea2c2e7-56dc-3ad4-ac55-ad4c4c0a6683",
                                "text": "I am smack-dab in the middle of the mommiest years of my life. There are toys strewn across my once-pristine floors, goldfish crackers in my couch cushions, and empty juice boxes in my car."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "67fd024a-8aca-35d1-a797-59efbdc8543b",
                "word": "Mommy",
