                                            {
                                                "example_id": "618f8ea1-53b8-4274-b5a1-f6ec4b3b6343",
                                                "sense_id": "3037a2fd-e548-3f4e-8a98-a29cf000fa6b",
                                                "text": "Движение столу или суппорту станка передаётся через свободный конец штока."
                                            },
                                            {
                                                "example_id": "639749d7-38ba-411c-8ec6-180a41f1f606",
                                                "sense_id": "3037a2fd-e548-3f4e-8a98-a29cf000fa6b",
                                                "text": "В Туле токарь резец в руках не держит, в Туле на сурнинском станке резец держит суппорт и точит ствол точно…"
                                            }
