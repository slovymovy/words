                                        "glosses": [
                                            "ältestes, weibliches Mitglied einer Gruppe, welches diese anführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "945549f4-adb6-45fe-915c-ee6ca4c4af3c",
                                                "sense_id": "906ececd-6ee4-31dd-88db-f185f5d5b152",
                                                "text": "Als Matriarchin verfügte sie über großes Wissen, von dem das Überleben ihrer Sippe abhing."
                                            },
                                            {
                                                "example_id": "02df7072-2344-4115-8dca-e1af9f7abc53",
                                                "sense_id": "906ececd-6ee4-31dd-88db-f185f5d5b152",
                                                "text": "„Die wachsame, aber höfliche Matriarchin nickte mir zu, und ein kleiner, überrascht wirkender Junge lugte hinter einem Türrahmen hervor.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
