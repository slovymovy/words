                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f17ee146-8d2d-4663-b74e-002f3ab8f101",
                                                "sense_id": "9f2a736c-1cf4-33d2-b867-f1333994d2f4",
                                                "text": "Karawany objuczonych wielbłądów kroczyły jedwabnym szlakiem niosąc jedwab, nefryt i złoto."
                                            },
                                            {
                                                "example_id": "b520a833-d6b6-41d3-9ba1-8226922703e1",
                                                "sense_id": "9f2a736c-1cf4-33d2-b867-f1333994d2f4",
                                                "text": "Celem przyświecającym twórcom celadonu było stworzenie taniej imitacji drogiego nefrytu."
                                            }
                                        ],
