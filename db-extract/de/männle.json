                "senses": [
                    {
                        "sense_id": "1f7c7f27-aa1f-31a9-965b-dda0acddc101",
                        "entry_id": "9a6650a7-dc73-3966-b182-89c0c5d4a4bc",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bed9751-3ffe-4d26-af3d-aefab25482c1",
                                "sense_id": "1f7c7f27-aa1f-31a9-965b-dda0acddc101",
                                "text": "Frau Männle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c91767b9-8e32-498b-97d6-80e6160af5e6",
                                "sense_id": "1f7c7f27-aa1f-31a9-965b-dda0acddc101",
                                "text": "Herr Männle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "455516ff-7fb1-4fcc-beca-8505e32c0247",
                                "sense_id": "1f7c7f27-aa1f-31a9-965b-dda0acddc101",
                                "text": "Die Männles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "12ffb261-68b5-4878-bdb2-ab9b61f705d2",
                                "sense_id": "1f7c7f27-aa1f-31a9-965b-dda0acddc101",
                                "text": "Der Männle trägt nie die Pullover, die die Männle ihm strickt."
                            },
                            {
                                "example_id": "401c0934-b60c-4020-84b8-89ed74c31672",
                                "sense_id": "1f7c7f27-aa1f-31a9-965b-dda0acddc101",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Männle kommt, geht der Herr Männle.“"
                            },
                            {
                                "example_id": "2cf5705f-591f-439f-8671-81754ac81ad5",
                                "sense_id": "1f7c7f27-aa1f-31a9-965b-dda0acddc101",
                                "text": "Männle kommt und geht."
                            },
                            {
                                "example_id": "d34a01a5-497a-4780-9692-03fb67922ae6",
                                "sense_id": "1f7c7f27-aa1f-31a9-965b-dda0acddc101",
                                "text": "Männles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
