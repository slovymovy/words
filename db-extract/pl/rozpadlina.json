                        ]
                    },
                    {
                        "translation_id": "0dd4328d-4b4f-4f14-8985-1f1ebe04d881",
                        "source_entry_id": "2c3908d2-95d4-398f-8d87-29a697c3e503",
                        "source_sense_id": "f55a9ba0-d2a4-3414-8e6f-627aa168b504",
                        "target_lang_word": "разлом",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "разлом",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f165dcf8-65c9-36e5-b138-02d8ac0d13f1",
                                        "entry_id": "8fbf3a6f-e1c4-36ce-9a34-9f0589b2a96a",
                                        "glosses": [
                                            "действие по значению гл. разломить, разломать, разламывать, разломиться, разломаться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab0d0177-9226-4566-9d58-b535915d5d24",
                                                "sense_id": "f165dcf8-65c9-36e5-b138-02d8ac0d13f1",
                                                "text": "Пошлите сейчас же, сударыня, ― сказал он, ― в москательную лавку за сассапарельным корнем, да велите выбрать такой, чтобы давал пыль при разломе: сварить его надо также умеючи в закрытом и наглухо замазанном тестом горшке; парить его надо долго; велите также тотчас приготовить серную ванну…"
                                            },
                                            {
                                                "example_id": "d3d46a4f-2f56-4f45-b751-b546e99109be",
                                                "sense_id": "f165dcf8-65c9-36e5-b138-02d8ac0d13f1",
                                                "text": "Запах, издаваемый некоторыми минералами при ударе или разломе, иногда указывает на присутствие тех или иных элементов в руде."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04997e37-aabb-315c-89c3-71bc6e1366cf",
                                        "entry_id": "8fbf3a6f-e1c4-36ce-9a34-9f0589b2a96a",
                                        "glosses": [
                                            "результат такого действия; место, где произошло разрушение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "606c1ed0-54e6-4b8d-b153-8a94d754f2dc",
                                                "sense_id": "04997e37-aabb-315c-89c3-71bc6e1366cf",
                                                "text": "Миша бежал, перепрыгивая через асфальтовые разломы, через лежащие под ногами ветки, и листья, и мелкие камни, и увертывался от летящих стрел, как животное в загоне или рыба, не желающая попасть на острогу, занесенную над чистым ручьем."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f73cf42e-2461-36d0-b869-226630746883",
                                        "entry_id": "8fbf3a6f-e1c4-36ce-9a34-9f0589b2a96a",
                                        "glosses": [
                                            "геол. нарушение сплошности горных пород (обычно — в результате сдвига тектонических плит на их стыках), без смещения (трещина) или со смещением пород по поверхности разрыва"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02e110d8-7cd2-495b-9128-2b98c9883dcd",
                                                "sense_id": "f73cf42e-2461-36d0-b869-226630746883",
                                                "text": "Чаше всего землетрясения происходят на разломах и границах движущихся блоков земной коры ― прежде всего литосферных плит."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04c329a7-5096-3bd1-ace0-3476cdeed885",
                                        "entry_id": "8fbf3a6f-e1c4-36ce-9a34-9f0589b2a96a",
                                        "glosses": [
                                            "перен. отсутствие внутреннего единства, цельности в сознании человека, в общественной жизни и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7358d89-7a36-4d35-a080-957e1c7f7f3f",
                                                "sense_id": "04c329a7-5096-3bd1-ace0-3476cdeed885",
                                                "text": "Периоды исторической ломки, переходные периоды всегда трагичны для поколений, через чью жизнь прошел разлом."
                                            }
                                        ]
                                    }
                                ]
                            }
