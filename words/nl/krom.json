                {
                    "sense_id": "99d3eaef-6c54-35a4-9c0e-541ff5dec48d",
                    "sense_definition": "niet recht, maar met een bocht of hoek",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man liep met een <w>kromme</w> rug door de smalle straat.",
                            "target_lang_translations": {
                                "en": "The old man walked through the narrow street with a <w>bent</w> back.",
                                "ru": "Старик шел по узкой улице со <w>сгорбленной</w> спиной."
                            }
                        },
                        {
                            "text": "Deze banaan is zo <w>krom</w> als een banaan, precies zoals het hoort.",
                            "target_lang_translations": {
                                "en": "This banana is as <w>crooked</w> as a banana, exactly as it should be.",
                                "ru": "Этот банан такой же <w>кривой</w>, как и положено банану."
                            }
