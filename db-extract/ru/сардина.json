                ],
                "senses": [
                    {
                        "sense_id": "c0b981b0-7863-30cf-acb7-00839dff3415",
                        "entry_id": "d1ea8913-76d4-3e0b-ae67-5a109639c656",
                        "glosses": [
                            "ихтиол. название нескольких видов рыб семейства сельдевых"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0fce23a4-7b50-3ec7-90de-8ddfb04cb738",
                        "entry_id": "d1ea8913-76d4-3e0b-ae67-5a109639c656",
                        "glosses": [
                            "кулин. такая рыба, приготовленная каким-либо способом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97646147-f897-4c32-bd23-547b82aafc2d",
                                "sense_id": "0fce23a4-7b50-3ec7-90de-8ddfb04cb738",
                                "text": "После копчения сардин готовую рыбу охлаждают, укладывают в консервные банки ёмкостью от 50 до 450 мл спинкой вниз с наклоном и заливают растительным маслом, предварительно прокалённым до температуры 70–80 °C."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3b4fbc8-82cf-471f-adf2-e333c4f365ec",
                        "source_entry_id": "d1ea8913-76d4-3e0b-ae67-5a109639c656",
                        "source_sense_description": "рыба",
                        "target_lang_word": "sardine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sardine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73516380-14e2-39de-9415-08d5583a5345",
                                        "entry_id": "e3f84182-ad24-3dfd-a7bd-fd7f6554e09e",
                                        "glosses": [
                                            "Poisson de mer au corps fuselé d'une vingtaine de centimètres de long, au dos bleuté et au ventre argenté, apparenté au hareng."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2f1c43f-c615-414f-b2ef-17caae2d8ad5",
                                                "sense_id": "73516380-14e2-39de-9415-08d5583a5345",
                                                "text": "Les poissons qu’on y pêche sont d’un goût excellent ; ceux qu’on estime le plus et qu’on rencontre le plus fréquemment, sont : le rouget, le maquereau, le loup, la sole, deux espèces de sardines enfin et sur-tout le mulet (vulgairement muge), dont nos pêcheurs distinguent aussi deux variétés."
                                            },
                                            {
                                                "example_id": "147fa019-062f-41e3-b6d2-c5b86273f0c2",
                                                "sense_id": "73516380-14e2-39de-9415-08d5583a5345",
                                                "text": "C'était la saison où les gens de Concarneau pêchent la sardine et des centaines de barques forçaient de voiles pour rentrer au port avant que la tempête éclatât."
                                            },
                                            {
                                                "example_id": "76da15a5-8f74-415a-a25b-e72ea207a26d",
                                                "sense_id": "73516380-14e2-39de-9415-08d5583a5345",
                                                "text": "Cette transformation est indispensable pour assurer une bonne tenue de la sardine dans les opérations de « friterie » proprement dites, menées immédiatement après par les friteuses."
                                            },
                                            {
                                                "example_id": "6fa44e3c-0026-4408-bdb6-0b2b4e7e4c02",
                                                "sense_id": "73516380-14e2-39de-9415-08d5583a5345",
                                                "text": "À l'instar de ces menus de restaurant gastronomique où une sardine se transforme en « perle de l'océan », où une compote de pommes devient d'office un « coulis de fruits défendus » et où une nouille se métamorphose en « ruban de semoule enfarinée », vous pouvez aussi rebaptiser votre profession d'une nouvelle étiquette qui fera rêver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0566fdcb-aaf7-3f9f-a85f-0534f29bdd3c",
                                        "entry_id": "e3f84182-ad24-3dfd-a7bd-fd7f6554e09e",
                                        "glosses": [
                                            "Broche métallique servant à fixer une tente de camping au sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1431c53b-92bc-4628-8a7a-e911b278fa1b",
                                                "sense_id": "0566fdcb-aaf7-3f9f-a85f-0534f29bdd3c",
                                                "text": "Il y a aussi ce piquet de tente, une grande pointe en fer percée d’un trou, ce que les campeurs d’aujourd’hui appelleraient une « sardine »."
                                            },
                                            {
                                                "example_id": "ae733870-b1bb-4fb9-ba85-8c9ca074fc4b",
                                                "sense_id": "0566fdcb-aaf7-3f9f-a85f-0534f29bdd3c",
                                                "text": "Même devant la tente, concentrée sur des préparatifs ou la plantation des sardines, elle est bien mise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b306095-4b89-391d-8ce3-f873835fdce9",
                                        "entry_id": "e3f84182-ad24-3dfd-a7bd-fd7f6554e09e",
                                        "glosses": [
                                            "Barrette indiquant le grade sur les épaulettes ou sur les manches d’un uniforme."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b75805a4-3e11-4b24-8933-ec542a4a8938",
                                                "sense_id": "0b306095-4b89-391d-8ce3-f873835fdce9",
                                                "text": "Point satisfait cependant, il épiait le sergent-fourrier Menoux, élite en toutes choses, qui revêtait une nouvelle fois sa veste pour mieux juger du bel effet de ses sardines obliques cousues sur les deux manches, à hauteur du biceps."
                                            },
                                            {
                                                "example_id": "5b1daf23-b602-416e-a6cc-63122b1a949d",
                                                "sense_id": "0b306095-4b89-391d-8ce3-f873835fdce9",
                                                "text": "— Te frappe pas, disait Lepage à Chalumot. On te l’filera, ton galon d’première classe. Il arrive… Toi qui peux pas blairer les gradés, t’auras l’air fin avec ta sardine…"
                                            },
                                            {
                                                "example_id": "27f60add-21e6-4661-ab1f-f43eb1ef20fc",
                                                "sense_id": "0b306095-4b89-391d-8ce3-f873835fdce9",
                                                "text": "Au bout de trois ans, Gwen débarque un matin de l’autocar de Brest, quartier-maître, avec de belles sardines rouges sur la manche."
                                            },
                                            {
                                                "example_id": "c611f37c-8269-406b-94db-a7ce34229357",
                                                "sense_id": "0b306095-4b89-391d-8ce3-f873835fdce9",
                                                "text": "Depuis qu’il a gagné ses sardines il se prend au sérieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3512840e-21c4-346e-8d06-0be91a5fabd1",
                                        "entry_id": "e3f84182-ad24-3dfd-a7bd-fd7f6554e09e",
                                        "glosses": [
                                            "Traces semi-circulaires laissées par le bord d'une taloche, d'une lisseuse sur un enduit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0561133d-b18c-35b7-b09f-baa4ae112b73",
                                        "entry_id": "e3f84182-ad24-3dfd-a7bd-fd7f6554e09e",
                                        "glosses": [
                                            "Jeu dans lequel un joueur se cache et tous les autres le cherchent et le rejoignent lorsqu’ils le trouvent, jusqu’à ce que tous les joueurs aient trouvé la sardine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1056c78-3f06-3435-8019-98d35899d9c9",
                                        "entry_id": "e3f84182-ad24-3dfd-a7bd-fd7f6554e09e",
                                        "glosses": [
                                            "Personne qui se cache dans ce même jeu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
