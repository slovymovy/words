                    ]
                },
                {
                    "sense_id": "ca914e78-544e-377b-9b5d-f8e577f2f0ab",
                    "sense_definition": "A lack of moral restraint or discipline; licentiousness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "laxity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moral <w>looseness</w> in the royal court was frequently condemned by contemporary satirists."
                        },
                        {
                            "text": "The elders expressed concern over the perceived <w>looseness</w> of modern social manners."
