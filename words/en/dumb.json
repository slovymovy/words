                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That car is <w>dumb</w> fast on the highway.",
                            "target_lang_translations": {
                                "ru": "Эта машина <w>черто́вски</w> быстрая на трассе.",
                                "tr": "O araba otoyolda <w>aşırı</w> hızlı.",
                                "zh": "那辆车在高速公路上跑得<w>极</w>快。"
                            }
                        },
                        {
                            "text": "He got <w>dumb</w> lucky to win that prize without trying.",
                            "target_lang_translations": {
                                "ru": "Ему <w>ди́ко</w> повезло выиграть этот приз, не прилагая усилий.",
                                "tr": "Hakkını vermeden o ödülü kazandığı için <w>feci</w> şanslıydı.",
                                "zh": "他没怎么努力就赢得了那个奖，真是<w>太</w>走运了。"
                            }
                        }
                    ],
                    "synonyms": [
