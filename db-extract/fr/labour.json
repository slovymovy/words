        "fr-extract.jsonl": [
            {
                "entry_id": "a57e37bf-7d12-3d49-9df3-1de414acfcbc",
                "word": "labour",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5f68fe7c-fc23-445d-bc05-d8c23b2832c9",
                        "entry_id": "a57e37bf-7d12-3d49-9df3-1de414acfcbc",
                        "tags": [
                            "plural"
                        ],
                        "form": "labours"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33bc5996-e6c9-3943-b555-37754aaf4ee7",
                        "entry_id": "a57e37bf-7d12-3d49-9df3-1de414acfcbc",
                        "glosses": [
                            "Façon qu’on donne à la terre en la remuant et la retournant en formant des sillons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4762176-c27e-488d-b8c4-7a80a13e493b",
                                "sense_id": "33bc5996-e6c9-3943-b555-37754aaf4ee7",
                                "text": "À l'origine, le labour des sols a pour objectifs de limiter le développement des adventices, de faciliter la levée des semis et le développement des racines par le décompactage de la couche de surface et de favoriser la circulation de l’eau et de l’air dans le sol."
                            },
                            {
                                "example_id": "26374cd3-b221-4c8f-b4b0-be0129abcb95",
                                "sense_id": "33bc5996-e6c9-3943-b555-37754aaf4ee7",
                                "text": "L’on ne s’y servait pas déjà de mauvais coutres, comme en certaines parties de la France, et la houe suffisait au peu de labours qui s’y faisaient."
                            },
                            {
                                "example_id": "00feabb9-9aeb-49e8-b13b-7f42452d0bd9",
                                "sense_id": "33bc5996-e6c9-3943-b555-37754aaf4ee7",
                                "text": "La terre destinée à recevoir des betteraves doit être préparée par deux ou trois labours très profonds."
                            }
                        ]
                    },
                    {
                        "sense_id": "7981bcbf-2528-38bb-98dd-39510d4d0a0f",
                        "entry_id": "a57e37bf-7d12-3d49-9df3-1de414acfcbc",
                        "glosses": [
                            "Pièce de terre labourées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4292ced5-b291-42d2-bef8-47eff613aeed",
                                "sense_id": "7981bcbf-2528-38bb-98dd-39510d4d0a0f",
                                "text": "Ce sont ces conditions climatiques qui ont déterminé, au début du XIXᵉ siècle, la transformation des modes agriculturaux. En effet, jusqu’à ce moment, le village était essentiellement composé de labours ; or, il est certain que ce climat doux et humide, les terres étant périodiquement balayées par des vents de dominante ouest, n’était guère favorable au murissement des récoltes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d21e5545-e164-499c-af83-57ea83be18c4",
                        "source_entry_id": "a57e37bf-7d12-3d49-9df3-1de414acfcbc",
                        "target_lang_word": "cultivation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cultivation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a01eba4-0398-30f3-ac6b-ab9b5771b36a",
                                        "entry_id": "c3b00ada-2e7b-32d1-bb8d-0fcf79887e3b",
                                        "glosses": [
                                            "The art or act of cultivating (improvement of land for or by agriculture), as:",
                                            "Tillage: plowing, sowing and raising crops."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ac9c379-e961-48d2-bb17-ad285a26c0ba",
                                                "sense_id": "1a01eba4-0398-30f3-ac6b-ab9b5771b36a",
                                                "text": "The cultivation of these valleys dates back thousands of years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bd18407-7440-35a9-9dbc-2e7169a23a60",
                                        "entry_id": "c3b00ada-2e7b-32d1-bb8d-0fcf79887e3b",
                                        "glosses": [
                                            "The art or act of cultivating (improvement of land for or by agriculture), as:",
                                            "Light tillage: turning or stirring the soil, especially for weed control."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6edce3a7-f813-41e6-a584-ec41c4cd41cf",
                                                "sense_id": "7bd18407-7440-35a9-9dbc-2e7169a23a60",
                                                "text": "The cultivation of the hillside led to soil erosion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddde4ce4-d523-3266-b68c-c3bd25785cf6",
                                        "entry_id": "c3b00ada-2e7b-32d1-bb8d-0fcf79887e3b",
                                        "glosses": [
                                            "The state of being cultivated or used for agriculture"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eab8ee4e-f4e0-4da1-9db8-d0871ffe8e90",
                                                "sense_id": "ddde4ce4-d523-3266-b68c-c3bd25785cf6",
                                                "text": "These fields are in cultivation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e042bf23-9b9b-3e11-b09a-359a71062dab",
                                        "entry_id": "c3b00ada-2e7b-32d1-bb8d-0fcf79887e3b",
                                        "glosses": [
                                            "Devotion of time or attention to the improvement of (something)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c723cea-6c8e-4a88-a3b5-3b78d796e094",
                                                "sense_id": "e042bf23-9b9b-3e11-b09a-359a71062dab",
                                                "text": "His steadfast cultivation of their relationship finally bore fruit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f68e47-4973-3c34-a751-2138e3a387e1",
                                        "entry_id": "c3b00ada-2e7b-32d1-bb8d-0fcf79887e3b",
                                        "glosses": [
                                            "Advancement or refinement in physical, intellectual, or moral condition"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe1dd3c2-4b9b-473f-b697-838eb2cf3b4e",
                                                "sense_id": "a4f68e47-4973-3c34-a751-2138e3a387e1",
                                                "text": "She is a woman of great cultivation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
