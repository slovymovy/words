        "fr-extract.jsonl": [
            {
                "entry_id": "5d7dcedd-a2a2-3e93-9784-13a83f17f8b7",
                "word": "sortilège",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c884a2eb-e13f-40ee-863d-08716eca6de8",
                        "entry_id": "5d7dcedd-a2a2-3e93-9784-13a83f17f8b7",
                        "tags": [
                            "plural"
                        ],
                        "form": "sortilèges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55a1145b-75c7-3e73-b403-14f8cb5e5ad4",
                        "entry_id": "5d7dcedd-a2a2-3e93-9784-13a83f17f8b7",
                        "glosses": [
                            "Action de jeter un sort ; maléfice, artifice de sorcier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a3b4042-c2c3-490e-b2a9-9e2af6ad77f5",
                                "sense_id": "55a1145b-75c7-3e73-b403-14f8cb5e5ad4",
                                "text": "Quant à cette vile sorcière qui a jeté ses sortilèges sur un frère du saint Temple, assurément elle sera mise à mort."
                            },
                            {
                                "example_id": "05242b68-aeef-4420-9b40-1ae7fc82bede",
                                "sense_id": "55a1145b-75c7-3e73-b403-14f8cb5e5ad4",
                                "text": "Dés lors, il n’y eut plus moyen de douter des sortilèges malfaisants de la vieille Barbara Rolloffin ; M. Lutkens déposa sa plainte, et la vieille fut arrêtée et mise en prison."
                            },
                            {
                                "example_id": "e297a246-e429-4326-9f13-10496c6db062",
                                "sense_id": "55a1145b-75c7-3e73-b403-14f8cb5e5ad4",
                                "text": "D'ici furent dirigés ces inquisiteurs qui allèrent brûler Vaudois, cathares, fraticelles, béguins, sorciers, envoûteurs, magiciens, flagellants, ou juifs convertis, mais soupçonnés de sortilèges."
                            },
                            {
                                "example_id": "271c26a9-9c87-40ff-ad82-776f76db6869",
                                "sense_id": "55a1145b-75c7-3e73-b403-14f8cb5e5ad4",
                                "text": "C’est d’ailleurs moins le Moyen Âge lui-même qui plaît qu’une certaine ambiance conçue comme typiquement médiévale, combinant le poids des muscles, le choc des épées, la brûlure des dragons et l’envoûtement des sortilèges."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ad91ec8-b3a0-3c3e-bdb8-a5604a966e8e",
                        "entry_id": "5d7dcedd-a2a2-3e93-9784-13a83f17f8b7",
                        "glosses": [
                            "Envoûtement de l'âme ou de l'esprit."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "261a436c-c2ff-4916-acff-6b1459b30fb4",
                                "sense_id": "8ad91ec8-b3a0-3c3e-bdb8-a5604a966e8e",
                                "text": "L’inquiétude, le sortilège prenant et pesant, jusqu’à l’angoisse, des midis aveuglants, où la terre, ivre, semblait gémir sous la caresse meurtrissante de la lumière exaspérée..."
                            },
                            {
                                "example_id": "f111d02c-6f4c-4cd6-9b51-52eff82bbbf4",
                                "sense_id": "8ad91ec8-b3a0-3c3e-bdb8-a5604a966e8e",
                                "text": "Je savais au fond de moi que la seule façon de vaincre le sortilège consistait à m'y abandonner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2c9a286-412f-4c85-b11b-2510552e9da9",
                        "source_entry_id": "5d7dcedd-a2a2-3e93-9784-13a83f17f8b7",
                        "source_sense_description": "artifice de sorcier",
                        "target_lang_word": "Zauber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zauber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9adf410-13a0-3dc3-ad98-f3df0987051c",
                                        "entry_id": "55657284-855f-3271-bfa3-806b1d230cf1",
                                        "glosses": [
                                            "übernatürliche Wirkung, magische Manipulation, die nicht den Naturgesetzen unterliegt; unerklärlicher Vorgang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39cd04ff-8e10-4818-a977-40d37d3a8080",
                                                "sense_id": "e9adf410-13a0-3dc3-ad98-f3df0987051c",
                                                "text": "Es kam uns vor wie ein Zauber."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e83f4ce8-fadc-38cf-8662-e4d9eb3ee601",
                                        "entry_id": "55657284-855f-3271-bfa3-806b1d230cf1",
                                        "glosses": [
                                            "Reiz, Faszination"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60f2b2d4-8181-46ae-88b7-b63b95395d9f",
                                                "sense_id": "e83f4ce8-fadc-38cf-8662-e4d9eb3ee601",
                                                "text": "Weihnachten hat für uns seinen Zauber noch nicht verloren."
                                            },
                                            {
                                                "example_id": "107bb66a-acf8-4d31-a9aa-0471a652435a",
                                                "sense_id": "e83f4ce8-fadc-38cf-8662-e4d9eb3ee601",
                                                "text": "„Deine Zauber binden wieder, was die Mode streng geteilt.“"
                                            },
                                            {
                                                "example_id": "5d1a3578-3aae-49d2-a5c2-53654dd696cb",
                                                "sense_id": "e83f4ce8-fadc-38cf-8662-e4d9eb3ee601",
                                                "text": "„Feinzart, unmerklich ist ihr Zauber, den dennoch jeder Empfindende an sich erfährt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "34d1b391-f5e5-39ee-bc1c-2bdcb939750c",
                                        "entry_id": "55657284-855f-3271-bfa3-806b1d230cf1",
                                        "glosses": [
                                            "Unsinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49fbc094-0b78-4975-898e-5d5698162928",
                                                "sense_id": "34d1b391-f5e5-39ee-bc1c-2bdcb939750c",
                                                "text": "Lass den Zauber endlich sein! Mach keinen Zauber!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
