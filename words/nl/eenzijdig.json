{
    "word_family": [
        "eenzijdigheid",
        "veelzijdig",
        "tweezijdig"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a00a54d0-f089-306f-8238-4ebd28a583d7",
                    "sense_definition": "slechts aan één kant aanwezig of bedrukt",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het papier is <w>eenzijdig</w> bedrukt om kosten te besparen.",
                            "target_lang_translations": {
                                "en": "The paper is printed <w>one-sided</w> to save costs.",
                                "ru": "Бумага имеет <w>одностороннюю</w> печать для экономии средств."
                            }
                        },
                        {
                            "text": "Dit document heeft een <w>eenzijdige</w> bedrukking.",
                            "target_lang_translations": {
                                "en": "This document has <w>single-sided</w> printing.",
                                "ru": "У этого документа <w>односторонняя</w> печать."
                            }
                        }
                    ],
                    "antonyms": [
                        "dubbelzijdig"
                    ],
                    "common_phrases": [
                        "eenzijdig bedrukt"
                    ],
                    "target_lang_definitions": {
                        "en": "present or printed on only one side",
                        "ru": "присутствующий или напечатанный только на одной стороне"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "one-sided",
                                "target_lang_sense_clarification": "referring to a single side of an object"
                            },
                            {
                                "target_lang_word": "single-sided",
                                "target_lang_sense_clarification": "specifically for printing or media"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "односторонний",
                                "target_lang_sense_clarification": "о физической поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8440b915-3363-3b49-af40-1109944e80aa",
                    "sense_definition": "niet objectief of onpartijdig; slechts vanuit één gezichtspunt bekeken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "oordeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De krant gaf een erg <w>eenzijdig</w> beeld van de politieke situatie.",
                            "target_lang_translations": {
                                "en": "The newspaper gave a very <w>one-sided</w> picture of the political situation.",
                                "ru": "Газета дала очень <w>однобокую</w> картину политической ситуации."
                            }
                        },
                        {
                            "text": "Zijn <w>eenzijdige</w> belichting van het probleem hielp de discussie niet vooruit.",
                            "target_lang_translations": {
                                "en": "His <w>one-sided</w> highlighting of the problem did not help the discussion move forward.",
                                "ru": "Его <w>одностороннее</w> освещение проблемы не помогло продвижению дискуссии."
                            }
                        }
                    ],
                    "synonyms": [
                        "unilateraal"
                    ],
                    "antonyms": [
                        "objectief",
                        "veelzijdig"
                    ],
                    "common_phrases": [
                        "eenzijdig beeld",
                        "eenzijdige belichting"
                    ],
                    "target_lang_definitions": {
                        "en": "not objective or impartial; viewed from only one perspective",
                        "ru": "необъективный или пристрастный; рассматриваемый только с одной точки зрения"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "one-sided",
                                "target_lang_sense_clarification": "biased or partial"
                            },
                            {
                                "target_lang_word": "biased",
                                "target_lang_sense_clarification": "unfairly prejudiced for or against someone"
                            },
                            {
                                "target_lang_word": "unbalanced",
                                "target_lang_sense_clarification": "not giving equal weight to different views"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "однобокий",
                                "target_lang_sense_clarification": "предвзятый или неполный"
                            },
                            {
                                "target_lang_word": "предвзятый",
                                "target_lang_sense_clarification": "имеющий заранее сформированное мнение"
                            },
                            {
                                "target_lang_word": "односторонний",
                                "target_lang_sense_clarification": "о мнении или освещении событий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c282fd28-0b1e-3ecb-9a18-efa330ebba53",
                    "sense_definition": "door één partij beslist zonder overleg met anderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De docent was boos door de <w>eenzijdige</w> beslissing van haar superieur.",
                            "target_lang_translations": {
                                "en": "The teacher was angry because of the <w>unilateral</w> decision of her superior.",
                                "ru": "Преподаватель была рассержена <w>односторонним</w> решением своего начальника."
                            }
                        },
                        {
                            "text": "Het bedrijf kondigde een <w>eenzijdige</w> opzegging van het contract aan.",
                            "target_lang_translations": {
                                "en": "The company announced a <w>unilateral</w> termination of the contract.",
                                "ru": "Компания объявила об <w>одностороннем</w> расторжении контракта."
                            }
                        }
                    ],
                    "synonyms": [
                        "unilateraal"
                    ],
                    "antonyms": [
                        "gezamenlijk",
                        "wederzijds"
                    ],
                    "common_phrases": [
                        "eenzijdige beslissing",
                        "eenzijdige opzegging"
                    ],
                    "target_lang_definitions": {
                        "en": "decided by one party without consultation with others",
                        "ru": "принятый одной стороной без консультации с другими"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unilateral",
                                "target_lang_sense_clarification": "performed by or affecting only one person or group"
                            },
                            {
                                "target_lang_word": "one-sided",
                                "target_lang_sense_clarification": "decided by one party alone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "односторонний",
                                "target_lang_sense_clarification": "о решении или действии"
                            },
                            {
                                "target_lang_word": "унилатеральный",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd782c96-d407-37ce-aa52-517d12339a0a",
                    "sense_definition": "saai of zonder variatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn dieet is erg <w>eenzijdig</w> omdat hij elke dag hetzelfde eet.",
                            "target_lang_translations": {
                                "en": "His diet is very <w>one-sided</w> because he eats the same thing every day.",
                                "ru": "Его диета очень <w>однообразна</w>, потому что он ест одно и то же каждый день."
                            }
                        },
                        {
                            "text": "Zij heeft een <w>eenzijdige</w> belangstelling en praat alleen over postzegels.",
                            "target_lang_translations": {
                                "en": "She has a <w>limited</w> interest and only talks about stamps.",
                                "ru": "У неё <w>ограниченные</w> интересы, и она говорит только о марках."
                            }
                        }
                    ],
                    "synonyms": [
                        "unilateraal"
                    ],
                    "antonyms": [
                        "gevarieerd",
                        "veelzijdig"
                    ],
                    "common_phrases": [
                        "eenzijdig dieet",
                        "eenzijdige belangstelling"
                    ],
                    "target_lang_definitions": {
                        "en": "boring or lacking variety",
                        "ru": "скучный или лишенный разнообразия"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "one-sided",
                                "target_lang_sense_clarification": "limited in scope or variety"
                            },
                            {
                                "target_lang_word": "limited",
                                "target_lang_sense_clarification": "restricted in range or variety"
                            },
                            {
                                "target_lang_word": "monotonous",
                                "target_lang_sense_clarification": "dull and repetitive"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "однообразный",
                                "target_lang_sense_clarification": "скучный и повторяющийся"
                            },
                            {
                                "target_lang_word": "ограниченный",
                                "target_lang_sense_clarification": "узкий по охвату или интересам"
                            },
                            {
                                "target_lang_word": "скудный",
                                "target_lang_sense_clarification": "о рационе или выборе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}