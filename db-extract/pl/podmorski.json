                                                "example_id": "c2e95a19-8d87-48ff-adb3-f5f3a945ef46",
                                                "sense_id": "8c43920f-e0f6-3af9-9dff-dbb4f009694e",
                                                "text": "The Channel Tunnel is the longest undersea tunnel in the world, with this section being 38km (23.6 miles) long."
