                "senses": [
                    {
                        "sense_id": "fd8b3978-d446-3b62-924b-fd3424ab28e0",
                        "entry_id": "9d937573-3790-3417-aea0-bfa9500e4048",
                        "glosses": [
                            "Wärme, die von der Sonne erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa72b77-1daa-4c0d-a534-a48f04f220e6",
                                "sense_id": "fd8b3978-d446-3b62-924b-fd3424ab28e0",
                                "text": "„Das meiste Wasser der Erde ist flüssig. Es zirkuliert langsam, sodass sich die Sonnenwärme ausbreiten kann, und wenn es verdampft, bilden sich Wolken und Regen.“"
                            },
                            {
                                "example_id": "f0f1fcbb-0c98-4b01-975b-a6c3dfeaf12b",
                                "sense_id": "fd8b3978-d446-3b62-924b-fd3424ab28e0",
                                "text": "„Die Sonnenwärme hält das Wasser in Bewegung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
