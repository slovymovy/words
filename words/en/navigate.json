{
    "word_family": [
        "navigation",
        "navigator",
        "navigable",
        "navigational"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17a6c81e-9f4a-343b-9037-8661203f8bfe",
                    "sense_definition": "To move between different parts of a website, software program, or digital interface.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "digital_nav",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is easy to <w>navigate</w> the website using the menu at the top.",
                            "target_lang_translations": {
                                "ru": "На этом сайте легко <w>ориентироваться</w> с помощью меню вверху.",
                                "zh": "使用顶部的菜单，你可以轻松地<w>浏览</w>这个网站。"
                            }
                        },
                        {
                            "text": "You can <w>navigate</w> back to the home page by clicking this button.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>перейти</w> обратно на главную страницу, нажав эту кнопку.",
                                "zh": "点击这个按钮，你可以<w>导航</w>回主页。"
                            }
                        }
                    ],
                    "synonyms": [
                        "browse",
                        "surf"
                    ],
                    "common_phrases": [
                        "navigate the web",
                        "navigate a site",
                        "navigate a menu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещаться между различными частями веб-сайта, программы или цифрового интерфейса.",
                        "zh": "在网站、软件程序或数字界面中进行浏览或切换。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ориентироваться",
                                "target_lang_sense_clarification": "на сайте или в интерфейсе"
                            },
                            {
                                "target_lang_word": "перемещаться",
                                "target_lang_sense_clarification": "по разделам сайта или программы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浏览",
                                "target_lang_sense_clarification": "在网站或界面中查看内容"
                            },
                            {
                                "target_lang_word": "导航",
                                "target_lang_sense_clarification": "在数字界面中切换页面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7abe060e-5956-3590-a1b3-4b6d44511995",
                    "sense_definition": "To plan and direct the course of a ship, aircraft, or other vehicle.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_nav",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain had to <w>navigate</w> the ship through a violent storm.",
                            "target_lang_translations": {
                                "ru": "Капитану пришлось <w>вести</w> корабль сквозь сильный шторм.",
                                "zh": "船长必须在猛烈的风暴中<w>驾驶</w>船只。"
                            }
                        },
                        {
                            "text": "Modern pilots use computers to help them <w>navigate</w> long distances.",
                            "target_lang_translations": {
                                "ru": "Современные пилоты используют компьютеры, которые помогают им <w>ориентироваться</w> при перелетах на большие расстояния.",
                                "zh": "现代飞行员利用计算机来帮助他们进行长距离<w>导航</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steer",
                        "pilot",
                        "guide",
                        "direct"
                    ],
                    "common_phrases": [
                        "navigate a ship",
                        "navigate a route",
                        "navigate by stars"
                    ],
                    "target_lang_definitions": {
                        "ru": "Планировать и направлять курс корабля, самолета или другого транспортного средства.",
                        "zh": "规划并引导船只、飞机或其他交通工具的航线。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управлять",
                                "target_lang_sense_clarification": "судном или летательным аппаратом"
                            },
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "корабль или самолет по курсу"
                            },
                            {
                                "target_lang_word": "прокладывать курс",
                                "target_lang_sense_clarification": "определять маршрут движения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "驾驶",
                                "target_lang_sense_clarification": "操作交通工具"
                            },
                            {
                                "target_lang_word": "导航",
                                "target_lang_sense_clarification": "指引航向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08e228c9-5934-3a1d-b468-90ddb629f9bb",
                    "sense_definition": "To read a map or follow a route in order to give directions to the person driving.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_nav",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will drive the car if you sit in the passenger seat and <w>navigate</w>.",
                            "target_lang_translations": {
                                "ru": "Я поведу машину, если ты сядешь на пассажирское сиденье и будешь <w>показывать дорогу</w>.",
                                "zh": "如果你坐在副驾驶座上负责<w>指路</w>，那我就来开车。"
                            }
                        },
                        {
                            "text": "It is difficult to <w>navigate</w> when the road signs are in a foreign language.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>ориентироваться</w>, когда дорожные знаки на иностранном языке.",
                                "zh": "当路标是外语时，很难<w>辨别方向</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "direct",
                        "guide"
                    ],
                    "common_phrases": [
                        "drive and navigate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Читать карту или следовать маршруту, чтобы указывать дорогу водителю.",
                        "zh": "通过阅读地图或遵循路线来为驾驶员指引方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показывать дорогу",
                                "target_lang_sense_clarification": "указывать путь водителю"
                            },
                            {
                                "target_lang_word": "быть штурманом",
                                "target_lang_sense_clarification": "следить за маршрутом"
                            },
                            {
                                "target_lang_word": "ориентироваться",
                                "target_lang_sense_clarification": "на местности по карте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指路",
                                "target_lang_sense_clarification": "为驾驶员提供方向"
                            },
                            {
                                "target_lang_word": "领航",
                                "target_lang_sense_clarification": "负责查看路线"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2295c8ec-ac9c-3023-900d-0df0ed71fb7a",
                    "sense_definition": "To successfully deal with a difficult situation, complex system, or social environment.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "abstract_nav",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to <w>navigate</w> the complex legal system to obtain her visa.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>разобраться</w> в сложной правовой системе, чтобы получить визу.",
                                "zh": "她成功地<w>应对</w>了复杂的法律程序，最终拿到了签证。"
                            }
                        },
                        {
                            "text": "New employees often struggle to <w>navigate</w> office politics effectively.",
                            "target_lang_translations": {
                                "ru": "Новым сотрудникам часто трудно эффективно <w>лавировать</w> в офисных интригах.",
                                "zh": "新员工往往难以有效地在办公室政治中<w>周旋</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "handle",
                        "maneuver",
                        "manage"
                    ],
                    "common_phrases": [
                        "navigate a crisis",
                        "navigate challenges",
                        "navigate the system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешно справляться со сложной ситуацией, запутанной системой или социальной средой.",
                        "zh": "成功应对复杂的局面、系统或社会环境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбираться",
                                "target_lang_sense_clarification": "в сложной системе или ситуации"
                            },
                            {
                                "target_lang_word": "лавировать",
                                "target_lang_sense_clarification": "обходить препятствия в общении или делах"
                            },
                            {
                                "target_lang_word": "ориентироваться",
                                "target_lang_sense_clarification": "в обстановке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "应对",
                                "target_lang_sense_clarification": "处理复杂情况"
                            },
                            {
                                "target_lang_word": "周旋",
                                "target_lang_sense_clarification": "在复杂的人际或社会环境中应付"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae1a4927-f129-30ed-ab84-6d900a539fe0",
                    "sense_definition": "To travel across a specific area of water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_nav",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early explorers tried to <w>navigate</w> the vast oceans in small wooden boats.",
                            "target_lang_translations": {
                                "ru": "Ранние исследователи пытались <w>пересечь</w> бескрайние океаны на маленьких деревянных лодках.",
                                "zh": "早期的探险家们试图乘坐小木船<w>穿越</w>广阔的海洋。"
                            }
                        },
                        {
                            "text": "The river is too shallow for large boats to <w>navigate</w> safely.",
                            "target_lang_translations": {
                                "ru": "Река слишком мелкая, чтобы большие лодки могли безопасно <w>пройти</w> по ней.",
                                "zh": "这条河太浅，大型船只无法安全<w>航行</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sail",
                        "voyage",
                        "cruise"
                    ],
                    "common_phrases": [
                        "navigate the ocean",
                        "navigate a river"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать по определенной водной территории.",
                        "zh": "在特定的水域航行或穿过。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плавать",
                                "target_lang_sense_clarification": "по морям или рекам (о судах)"
                            },
                            {
                                "target_lang_word": "проходить",
                                "target_lang_sense_clarification": "преодолевать водный путь"
                            },
                            {
                                "target_lang_word": "пересекать",
                                "target_lang_sense_clarification": "водное пространство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "航行",
                                "target_lang_sense_clarification": "在水上行驶"
                            },
                            {
                                "target_lang_word": "穿越",
                                "target_lang_sense_clarification": "横跨水域"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}