            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3937832f-6cc9-3e9a-9801-445b74370274",
                    "sense_definition": "Déplacer une chose ou une personne en la tirant après soi sur le sol.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tirer_materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant fatigué <w>traîne</w> sa valise derrière lui jusqu'à la chambre."
                        },
                        {
                            "text": "Il est interdit de <w>traîner</w> les pieds dans les couloirs de l'école."
                        }
                    ],
                    "synonyms": [
                        "tirer"
                    ],
                    "antonyms": [
                        "pousser",
                        "porter"
                    ],
                    "common_phrases": [
                        "traîner les pieds"
                    ]
                },
                {
                    "sense_id": "9a4872b4-b379-3d3a-851a-f4c2cd665a9b",
                    "sense_definition": "Être laissé en désordre ou à un endroit inapproprié au lieu d'être rangé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "desordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne laisse pas <w>traîner</w> tes livres sur la table du salon."
                        },
                        {
                            "text": "Plusieurs feuilles de papier <w>traînaient</w> par terre devant le bureau."
                        }
                    ],
                    "common_phrases": [
                        "laisser traîner"
                    ]
                },
                {
                    "sense_id": "cbaa164a-9bc1-3126-86e0-1a78ce1164c7",
