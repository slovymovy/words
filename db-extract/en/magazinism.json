                        "glosses": [
                            "The practice of writing for magazines, or in a style suited to magazines."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5e3ddbd5-e91e-4a26-ae70-2cdb87314efb",
                                "sense_id": "c386f29b-9bf2-3d20-8ec3-783e5d02cfae",
                                "text": "The style of Brougham and Jeffrey and Sydney Smith was moulded by their oratorical pursuits; and it gave the cue to magazinism through the earlier part of the period."
                            },
                            {
                                "example_id": "8d3f7741-7ee1-4b75-8a97-ea4ed2ebe172",
                                "sense_id": "c386f29b-9bf2-3d20-8ec3-783e5d02cfae",
                                "text": "It is no wonder that the television industry has shied away from the dangers of discovery and committed itself to the ideology of demographic magazinism."
                            },
                            {
                                "example_id": "d0c99b14-62c7-42e0-958b-1171f598a11d",
                                "sense_id": "c386f29b-9bf2-3d20-8ec3-783e5d02cfae",
                                "text": "\"I have no income save what my pen brings me in the magazine and newspaper field.\" (Note that field is not plural; here he is thinking of both yellow journalism and yellow magazinism)."
                            }
                        ]
                    }
