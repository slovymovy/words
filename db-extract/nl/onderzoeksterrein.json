                "senses": [
                    {
                        "sense_id": "b527dddc-00ae-30bc-8bea-b98e20af3c1a",
                        "entry_id": "05004146-047b-3a8b-86d1-c69247584864",
                        "glosses": [
                            "verzameling van te onderzoeken zaken of mensen; vakgebied waar men onderzoek naar doet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6df66c02-a60d-44e3-861b-f2f10f3330b9",
                                "sense_id": "b527dddc-00ae-30bc-8bea-b98e20af3c1a",
                                "text": "Het is belangrijk te vermelden dat voor Febvre het gevoelsleven ook hoort tot het onderzoeksterrein van de cultuurspecialist omdat emoties immers meehelpen om nieuwe ideeën te scheppen."
                            },
                            {
                                "example_id": "67a272d8-9234-4c25-9034-dc9cab985008",
                                "sense_id": "b527dddc-00ae-30bc-8bea-b98e20af3c1a",
                                "text": "In 2001 schreven Johnson en Luczkovich samen een artikel voor het Journal of Social Structure, waarin zij wezen op allerlei overeenkomsten tussen twee schijnbaar zeer verschillende onderzoeksterreinen."
                            },
                            {
                                "example_id": "057d06f6-2fe3-495e-a8bd-ff7835c634cf",
                                "sense_id": "b527dddc-00ae-30bc-8bea-b98e20af3c1a",
                                "text": "De zuidpool geldt als een veelbelovend onderzoeksterrein, legt Ellerbroek uit. \"Er wordt gedacht dat daar heel veel water zit. Water is een grondstof die erg belangrijk is voor, in eerste instantie, mensen die daar willen zijn, maar je kunt daar ook raketbrandstof van maken zodat je eigenlijk een soort tankstation krijgt buiten de aarde. Op lange termijn is dat heel erg nuttig.\""
                            }
                        ]
                    }
