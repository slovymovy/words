                        "glosses": [
                            "That is pleasing to the sense of taste; appetizing; that makes one salivate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5451d5d5-f486-4991-b8b6-7346b97eeec5",
                                "sense_id": "4d7feacf-1779-3171-9dcc-b5b234a05488",
                                "text": "Superintendent, I hope you're ready for mouthwatering hamburgers."
                            },
                            {
                                "example_id": "5b33e9cd-39ec-4ab1-92a7-542ace08d1ec",
                                "sense_id": "4d7feacf-1779-3171-9dcc-b5b234a05488",
                                "text": "If the weather was not too rough at Norfolk Island, the Tulagi took on board some Norfolk Island fish, which arrived frozen in Vila. This fish was heavily in demand in Vila as it had a mouth-watering taste and was safe to eat."
                            }
                        ]
                    },
