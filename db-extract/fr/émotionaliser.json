                ],
                "senses": [
                    {
                        "sense_id": "48683f81-1c8f-3269-9b13-21e602992858",
                        "entry_id": "5896d094-58bd-359a-9f13-3ac526ae18ed",
                        "glosses": [
                            "Donner un caractère émotionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5182249-9323-451f-acca-c04f8a391a46",
                                "sense_id": "48683f81-1c8f-3269-9b13-21e602992858",
                                "text": "D’après Gouaffo, en insistant sur les contrastes noir-blanc, le critique tente d’émotionaliser l’altérité, en augmentant la fascination et en conférant une valeur aux deux pôles : (...)"
                            },
                            {
                                "example_id": "abba1d74-e7fd-49ed-a135-1c0705331ff6",
                                "sense_id": "48683f81-1c8f-3269-9b13-21e602992858",
                                "text": "Mais je suis convaincu que nous pouvons très fortement «émotionaliser» les lecteurs ;"
                            },
                            {
                                "example_id": "099a0803-52be-4ddd-9982-64842ea837cc",
                                "sense_id": "48683f81-1c8f-3269-9b13-21e602992858",
                                "text": "Les cosmétiques ne sont qu’une porte d’entrée de choix pour un marché masculin qui se dérationalise pour « s'émotionaliser », se sensibiliser, se sensualiser… « s'hédoniser »."
                            }
                        ]
                    }
                ],
