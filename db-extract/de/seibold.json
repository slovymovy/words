                ],
                "senses": [
                    {
                        "sense_id": "3f679450-8b56-33c4-91c4-9493ec7c2186",
                        "entry_id": "0368c9c3-a45b-3887-9f98-08ae5a6092f0",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab496e9f-2b64-45e2-9d3e-6da0f6633da1",
                                "sense_id": "3f679450-8b56-33c4-91c4-9493ec7c2186",
                                "text": "Seibolds kamen, sahen und siegten."
                            },
                            {
                                "example_id": "ef6165b9-4218-4946-90f8-0136c7e6f161",
                                "sense_id": "3f679450-8b56-33c4-91c4-9493ec7c2186",
                                "text": "Seibold kommt und geht."
                            },
                            {
                                "example_id": "58dcb61e-129b-4fc9-a0e8-03187506eff3",
                                "sense_id": "3f679450-8b56-33c4-91c4-9493ec7c2186",
                                "text": "Der Seibold trägt nie die Schals, die die Seibold ihm strickt."
                            },
                            {
                                "example_id": "d600ae9d-ff66-41f1-bd38-674bd33bb751",
                                "sense_id": "3f679450-8b56-33c4-91c4-9493ec7c2186",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Seibold kommt, geht der Herr Seibold.“"
                            },
                            {
                                "example_id": "e35e685f-db65-4709-82f8-f5bfd6754ac7",
                                "sense_id": "3f679450-8b56-33c4-91c4-9493ec7c2186",
                                "text": "Frau Seibold ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c2abf43d-b370-481b-8fe7-85c05c21e6a3",
                                "sense_id": "3f679450-8b56-33c4-91c4-9493ec7c2186",
                                "text": "Herr Seibold wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b351d22b-4e2b-4726-b4f7-7cc0435250a2",
                                "sense_id": "3f679450-8b56-33c4-91c4-9493ec7c2186",
                                "text": "Die Seibolds fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
