                "senses": [
                    {
                        "sense_id": "82fe641e-5194-3fe7-a247-ae0ac181fb55",
                        "entry_id": "b8641db8-9850-33f2-a861-92de9541ed4b",
                        "glosses": [
                            "große, dichte Menge von Qualm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb16b764-4e7d-4e0f-87f3-3c0163a3e6e9",
                                "sense_id": "82fe641e-5194-3fe7-a247-ae0ac181fb55",
                                "text": "„Die Holzbrücke an der Kolotscha brannte erneut lichterloh; von der weißen Kirche ragte nur der Turm aus den Qualmwolken.“"
                            },
                            {
                                "example_id": "2e805cbd-eee2-4fe3-8cbd-e5a1bc1e2940",
                                "sense_id": "82fe641e-5194-3fe7-a247-ae0ac181fb55",
                                "text": "„In der Luft stand eine schwarze Qualmwolke, die langsam höher stieg und sich auflöste, während er ihr verwirrt nachblickte.“"
                            },
                            {
                                "example_id": "7fafe64d-4236-4cce-b086-783cfaf655f4",
                                "sense_id": "82fe641e-5194-3fe7-a247-ae0ac181fb55",
                                "text": "„Ich nickte, und Amalia blies eine weitere Qualmwolke in den Himmel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
