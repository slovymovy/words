                "senses": [
                    {
                        "sense_id": "cf645b90-6c58-3b54-bdb0-d7df343605cb",
                        "entry_id": "f9489597-578e-3d37-a790-7cb1f79b7538",
                        "glosses": [
                            "een langwerpig stuk doek dat gedragen wordt om de hals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fecf198-b189-4e5f-875e-d5eca46c64fd",
                                "sense_id": "cf645b90-6c58-3b54-bdb0-d7df343605cb",
                                "text": "Dat artwork wordt integraal op zijde geprint. ‘Het is de bedoeling om het artwork van de shawl goed te kunnen zien, elke verfstreek, elk pigmentvlek. Dat maakt dat het drukproces heel nauwkeurig moet gebeuren. Daarom doen we voor verschillende modellen beroep op een Italiaanse drukkerij die ook voor high-endmerken werken. Maar afhankelijk van het soort zijde en het artwork produceren we ook dichter bij huis.’"
                            },
                            {
                                "example_id": "a595ea7d-7822-4cb9-af37-24ebbe6baa5b",
                                "sense_id": "cf645b90-6c58-3b54-bdb0-d7df343605cb",
                                "text": "De beroving was even na middernacht. Het slachtoffer stond even stil met haar bromfiets op de kruising van de Hofstedeweg en de Bourdonstraat. Daar zag zij dat drie mannen uit een personenauto stapten. Zij droegen allemaal een shawl voor hun gezicht. Twee van hen dreigden met een voorwerp dat leek op een vuurwapen. De mannen dwongen haar geld af te geven en gingen er vervolgens in hun auto vandoor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5527a230-5423-4377-b212-f854168493d5",
                        "source_entry_id": "f9489597-578e-3d37-a790-7cb1f79b7538",
                        "source_sense_id": "cf645b90-6c58-3b54-bdb0-d7df343605cb",
                        "source_sense_description": "sjaal",
                        "target_lang_word": "shawl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shawl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                        "entry_id": "88d70e71-5199-3fde-a7f4-dec67f2e1b1b",
                                        "glosses": [
                                            "A square or rectangular piece of cloth worn as a covering for the head, neck, and shoulders, typically by women."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fda61c3-1956-437e-894e-0ed180a6279f",
                                                "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                                "text": "She wears her shawl when it's cold outside."
                                            },
                                            {
                                                "example_id": "ab7b95ce-3ef5-4ca5-be64-ebfcd99a7f71",
                                                "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                                "text": "Just then Norbourne entered the chamber; and, fancying from her attitude that his wife was asleep, he approached softly, and drew a large shawl around her."
                                            },
                                            {
                                                "example_id": "4393a2ea-1334-4441-8a30-d03a38da1bfe",
                                                "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady. She stood for a moment holding her skirt above the grimy steps,[…], and the light of the reflector fell full upon her."
                                            },
                                            {
                                                "example_id": "4a59fcda-91e3-46b1-b879-c617d25fead9",
                                                "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                                "text": "Jessamy turned. Her uplifted candle showed a dark handsome young women in a black dress. She wore a wide shawl over her head which hung down on either side, only partially hiding a starched, white apron.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb1a5ee-d9f5-3a47-981b-a655a71467b4",
                                        "entry_id": "88d70e71-5199-3fde-a7f4-dec67f2e1b1b",
                                        "glosses": [
                                            "A fold of wrinkled flesh under the lips and neck of a bloodhound, used in scenting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shawl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff1c2fc-4076-3a06-a223-3b7a2130522d",
                                        "entry_id": "41f6566d-74f8-362d-bcb9-b13874023547",
                                        "glosses": [
                                            "To wrap in a shawl."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "299f4961-3b91-4830-b63e-6ec9153f4d97",
                                                "sense_id": "eff1c2fc-4076-3a06-a223-3b7a2130522d",
                                                "text": "Rebecca was shawling her in an upper apartment , where these two friends had an opportunity for a little of that secret talking and conspiring which forms the delight of female life"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
