                        "glosses": [
                            "to draw, to scoop, to spoon up/out, to ladle out"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10336852-b08a-41ef-88ee-01f5ee826be5",
                                "sense_id": "13896926-2267-3155-87f3-c8c75fdc4de3",
                                "text": "Жербунов открыл банку, взял со скатерти нож, зачерпнул им чудовищное количество порошка и быстро размешал его в водке.",
                                "translation": "Zherbunov opened the tin, picked up a knife from the table, scooped up a monstrous amount of the white powder and rapidly stirred it into his vodka.",
                                "english": "Zherbunov opened the tin, picked up a knife from the table, scooped up a monstrous amount of the white powder and rapidly stirred it into his vodka."
                            }
                        ]
                    },
                    {
                        "sense_id": "82549c2c-62e2-3063-b4d8-05aef572f195",
                        "entry_id": "4d62e923-6ecd-3351-a22b-b9854af02ff0",
                        "glosses": [
                            "to take in, to ship (water)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f6e3bd-a1c6-448d-99d9-2ff7c61a3341",
                                "sense_id": "82549c2c-62e2-3063-b4d8-05aef572f195",
                                "text": "ло́дка накрени́лась и зачерпну́ла воды́",
                                "translation": "the boat heeled over and shipped [took in / on] water",
                                "english": "the boat heeled over and shipped [took in / on] water"
                            }
                        ]
