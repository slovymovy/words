                    {
                        "sense_id": "93ce18ed-46c4-3f4f-adaf-430153e1e338",
                        "entry_id": "80e75a09-a1d2-38ed-b7fc-ba91adbfd6f3",
                        "glosses": [
                            "geschichteter Haufen Heu, Stroh oder Torf auf freiem Feld"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "ab996a8a-b687-4d73-b32d-5dec9db52330",
                                "sense_id": "93ce18ed-46c4-3f4f-adaf-430153e1e338",
                                "text": "„Habe heute Torf gestochen und geschichtet, Guđriđur und ich haben gestern den ganzen Tag nasses Heu gewendet, getrocknet und dann wieder zu Diemen gerecht.“"
                            },
                            {
                                "example_id": "2aef0033-4b8e-4e42-b42d-676f73d5e09e",
                                "sense_id": "93ce18ed-46c4-3f4f-adaf-430153e1e338",
                                "text": "„Er hatte sich in den Kopf gesetzt, sie auf holländische Weise nach dem System Clap-Mayer durch Gärung zu trocknen – das heißt, er ließ sie auf einmal schneiden und in Diemen aufschichten, die, sobald die Gase entwichen, der frischen Luft ausgesetzt werden sollten – worauf sich Bouvard ohne die geringste Sorge zurückzog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ee68842-5220-44f6-a3a6-9f83ac266124",
