                ],
                "senses": [
                    {
                        "sense_id": "053ed906-6715-312d-92c5-65031e69a7c4",
                        "entry_id": "c2825aae-f0ec-3c59-8c98-54f6b46c956e",
                        "glosses": [
                            "сообщить о каком-либо явлении, неприятном для собеседника"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a410f3e-040a-493d-87ff-a7be7c834fb5",
                        "source_entry_id": "c2825aae-f0ec-3c59-8c98-54f6b46c956e",
                        "source_sense_id": "053ed906-6715-312d-92c5-65031e69a7c4",
                        "target_lang_word": "sadden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sadden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1cb604b-0299-3cf9-85af-5e06bc3ba12e",
                                        "entry_id": "1972729e-d5e8-3bbe-b871-ca5051b5ac09",
                                        "glosses": [
                                            "To make sad or unhappy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e26ce4a-c806-4f64-b4cf-cc1708f97708",
                                                "sense_id": "d1cb604b-0299-3cf9-85af-5e06bc3ba12e",
                                                "text": "It saddens me to think that I might have hurt someone."
                                            },
                                            {
                                                "example_id": "13885ec4-28de-4dbd-a048-807ee8de8dcd",
                                                "sense_id": "d1cb604b-0299-3cf9-85af-5e06bc3ba12e",
                                                "text": "The turmoil went on—no rest, no peace. […] It was nearly eleven o'clock now, and he strolled out again. In the little fair created by the costers' barrows the evening only seemed beginning; and the naphtha flares made one's eyes ache, the men's voices grated harshly, and the girls' faces saddened one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2268fd6d-2002-37f4-b90e-2772c4f1e904",
                                        "entry_id": "1972729e-d5e8-3bbe-b871-ca5051b5ac09",
                                        "glosses": [
                                            "To become sad or unhappy."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3d35765-9cc2-45a4-a3db-3167e32ff682",
                                                "sense_id": "2268fd6d-2002-37f4-b90e-2772c4f1e904",
                                                "text": "He saddens, all the magic light\n⁠Dies off at once from bower and hall,\n⁠And all the place is dark, and all\nThe chambers emptied of delight: […]"
                                            },
                                            {
                                                "example_id": "028dcefb-f67b-4466-9706-82c98dd183fd",
                                                "sense_id": "2268fd6d-2002-37f4-b90e-2772c4f1e904",
                                                "text": "Hyacinth perfume tickled her senses, making her feel giddy, but she saddened when she saw how uncared for the garden was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51244f18-05d8-37ac-9e78-68e5e4fad7f1",
                                        "entry_id": "1972729e-d5e8-3bbe-b871-ca5051b5ac09",
                                        "glosses": [
                                            "To darken a color during dyeing."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05e81256-b0b1-4818-93ba-2ffdf3d75418",
                                                "sense_id": "51244f18-05d8-37ac-9e78-68e5e4fad7f1",
                                                "text": "Curve (E) is seen at a glance to represent green saddened down to its fifth shade, and reduced with white to its fourth tint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a53ae5d5-b11c-3a6c-bd96-5bfec95e4eec",
                                        "entry_id": "1972729e-d5e8-3bbe-b871-ca5051b5ac09",
                                        "glosses": [
                                            "To render heavy, hard, or cohesive; to compress or thicken."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1180c6f-d38f-44c8-a002-5d2e3b5ca7c8",
                                                "sense_id": "a53ae5d5-b11c-3a6c-bd96-5bfec95e4eec",
                                                "text": "Marle's binding and sadning of land being the great Prejudice it doth to Clay-lands."
                                            },
                                            {
                                                "example_id": "168a53a2-b000-429e-ab16-6b8fc362e4ea",
                                                "sense_id": "a53ae5d5-b11c-3a6c-bd96-5bfec95e4eec",
                                                "text": "... the soil below will, instead of being brought up, be trampled and saddened."
                                            },
                                            {
                                                "example_id": "170f36ec-faf1-4e08-9933-2a96250ab7ee",
                                                "sense_id": "a53ae5d5-b11c-3a6c-bd96-5bfec95e4eec",
                                                "text": "[…]; the reason why hee left them in the close all the day was, because that hee woulde have the water sattle away, and the growndesomewhat saddened before hee woulde goe to field with them;[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
