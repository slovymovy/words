                        "examples": [
                            {
                                "example_id": "98574b48-f713-4135-a335-9b3b27892397",
                                "sense_id": "0e66c5cf-7acc-339f-9631-913228f063e5",
                                "text": "„Pegida hat mal wieder zu einer Kundgebung aufgerufen.“"
                            },
                            {
                                "example_id": "9475e370-f8b6-424f-ac7c-fe5a2781640b",
                                "sense_id": "0e66c5cf-7acc-339f-9631-913228f063e5",
                                "text": "„Nur weil ich keine Angst vor den Konsequenzen habe wie so viele, die lieber kuschen, als unbequeme Wahrheiten auszusprechen, lasse ich mich nicht von Bewegungen wie Pegida oder Parteien wie der AfD vereinnahmen.“"
                            },
                            {
                                "example_id": "09ae9c8e-1bf9-47e0-9365-3df2f48babdf",
                                "sense_id": "0e66c5cf-7acc-339f-9631-913228f063e5",
                                "text": "„Vor zwei Jahren ist Pegida in Dresden zum ersten Mal »spaziert«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
