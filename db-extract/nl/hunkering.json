                "senses": [
                    {
                        "sense_id": "5cc16317-6a09-3ff3-b292-c9ac839edf08",
                        "entry_id": "2775112a-7ed0-318f-a2d8-31092123a333",
                        "glosses": [
                            "het heftige, pijnlijke verlangen naar iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04b2fc7b-84df-44ad-9746-e034caed090c",
                                "sense_id": "5cc16317-6a09-3ff3-b292-c9ac839edf08",
                                "text": "De inbreker realiseerde zich echter niet dat de eigenaren boven de winkel wonen. Lisa Mirrizi had een late hunkering naar thee en besloot dan ook naar beneden te gaan."
                            },
                            {
                                "example_id": "bd84c206-e51d-4b24-9fbe-3f5fcc1fcfa3",
                                "sense_id": "5cc16317-6a09-3ff3-b292-c9ac839edf08",
                                "text": "Lachgasgebruik kan leiden tot hoofdpijn, duizeligheid en tintelingen van handen en voeten. Maar ook noemen gebruikers verwardheid, misselijkheid en de hunkering om opnieuw te gebruiken."
                            },
                            {
                                "example_id": "4cbd1e15-d986-4c6d-b1a6-3c776470b4d7",
                                "sense_id": "5cc16317-6a09-3ff3-b292-c9ac839edf08",
                                "text": "„Elke ijsclubbestuurslid zal me dat nazeggen. De hunkering naar ijs houdt ons in leven. IJs is voor ons een zaak van leven en dood.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71e8b6d1-991e-4a62-85da-2e6e78c667e0",
                        "source_entry_id": "2775112a-7ed0-318f-a2d8-31092123a333",
                        "source_sense_id": "5cc16317-6a09-3ff3-b292-c9ac839edf08",
                        "source_sense_description": "het heftige, pijnlijke verlangen naar iets of iemand",
                        "target_lang_word": "Sehnsucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sehnsucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7ff46b6-dd7a-38fe-a492-f270846606ff",
                                        "entry_id": "db910cdb-c0b6-3b5b-8081-843188141c12",
                                        "glosses": [
                                            "der Drang, der Wunsch nach etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0acbb7a-8a78-4267-a927-9ad537241cb3",
                                                "sense_id": "a7ff46b6-dd7a-38fe-a492-f270846606ff",
                                                "text": "Ich habe Sehnsucht nach dir."
                                            },
                                            {
                                                "example_id": "9a4819dc-788d-4e81-a67d-55ad420e4dbb",
                                                "sense_id": "a7ff46b6-dd7a-38fe-a492-f270846606ff",
                                                "text": "„Zu diesen Miseren rein wirtschaftlicher Natur kam noch, daß ich's nur gestehe, die Sehnsucht nach der Liebe, von der ich schon allerhand Lobendes in Romanen und Zeitungsnachrichten gehört hatte.“"
                                            },
                                            {
                                                "example_id": "2a0384d6-7ef1-4562-b29a-36c519949260",
                                                "sense_id": "a7ff46b6-dd7a-38fe-a492-f270846606ff",
                                                "text": "„So erfuhr man, ob sich ein Freier in die entlegenen Landstriche verirren wird, erhielt Auskunft darüber, ob die brennende Sehnsucht nach Liebe erfüllt wird oder inwieweit sich eine traurige Jungfernschaft auf die soziale Absicherung der Sitzengebliebenen auswirkt.“"
                                            },
                                            {
                                                "example_id": "2d48c6fd-a381-453b-a38b-fb94408efb4e",
                                                "sense_id": "a7ff46b6-dd7a-38fe-a492-f270846606ff",
                                                "text": "„Ich las den Brief aber denn doch, denn Post aus Haifa ist schon rar, ich habe so eine geheime Sehnsucht nach dem Norden Afrikas, weiß nicht warum.“"
                                            },
                                            {
                                                "example_id": "a17a3f39-af50-4ce6-8deb-b8c7cfca912d",
                                                "sense_id": "a7ff46b6-dd7a-38fe-a492-f270846606ff",
                                                "text": "„Die Sehnsucht des Jungen war ihm nur zu vertraut.“"
                                            },
                                            {
                                                "example_id": "35045f78-716c-406f-b2f4-a05227ed8ddb",
                                                "sense_id": "a7ff46b6-dd7a-38fe-a492-f270846606ff",
                                                "text": "„Zwischen fremdverordneten und den eigenen Sehnsüchten erwachsenden Sinngebungen bestehen wesentliche Unterschiede: Die ersten sind vielfach mit Disstress verknüpft, der negativ empfundenen Form der Hochbelastung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "664cc5e1-4930-4a86-ab20-ff6c05af52cf",
                        "source_entry_id": "2775112a-7ed0-318f-a2d8-31092123a333",
                        "source_sense_id": "5cc16317-6a09-3ff3-b292-c9ac839edf08",
                        "source_sense_description": "het heftige, pijnlijke verlangen naar iets of iemand",
                        "target_lang_word": "Verlangen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verlangen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9530f265-23f8-3b78-951d-121392043873",
                                        "entry_id": "953516fd-c19b-30a5-ab84-ead3c561a09f",
                                        "glosses": [
                                            "stark ausgeprägter Wunsch; körperlicher, seelischer, geistiger Drang, einen empfundenen Mangel auszugleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7812b262-8ed8-4e02-96b8-64b791cc707b",
                                                "sense_id": "9530f265-23f8-3b78-951d-121392043873",
                                                "text": "Das Verlangen nach Alkohol wurde mit jeder Stunde größer."
                                            },
                                            {
                                                "example_id": "330a5dcc-a5a1-498c-b054-0da14148ad53",
                                                "sense_id": "9530f265-23f8-3b78-951d-121392043873",
                                                "text": "Das Verlangen nach sexueller Befriedigung war beim ihm so ausgeprägt wie das Verlangen nach Ruhm und Anerkennung."
                                            },
                                            {
                                                "example_id": "a6fefc8d-4bc4-465c-9f9e-351a61d73e97",
                                                "sense_id": "9530f265-23f8-3b78-951d-121392043873",
                                                "text": "Das Verlangen nach der geliebten Person raubte ihr den Atem."
                                            },
                                            {
                                                "example_id": "a6d6a27c-c08a-48a4-ad0d-340970cfb9b0",
                                                "sense_id": "9530f265-23f8-3b78-951d-121392043873",
                                                "text": "„Das Verlangen nach Anerkennung durch Mitschüler kann manchmal geradezu suchtartige Formen annehmen und manche Schüler nehmen dafür erheblichen Ärger mit dem Lehrer in Kauf.“"
                                            },
                                            {
                                                "example_id": "1c896122-9279-443f-9f76-0696c57568df",
                                                "sense_id": "9530f265-23f8-3b78-951d-121392043873",
                                                "text": "„Wir waren im gleichen Augenblick in eins verschmolzen und hatten nicht die Kraft, unser erstes Verlangen länger als eine Minute zu zügeln; es erreichte seinen Höhepunkt ohne jedes Geräusch von Küssen und ohne die geringste Bewegung unsererseits.“"
                                            },
                                            {
                                                "example_id": "8cf89ed8-93e3-4070-93ee-712300acc56c",
                                                "sense_id": "9530f265-23f8-3b78-951d-121392043873",
                                                "text": "„Dieses den jungen Goethe ergreifende Verlangen, sich in den unendlichen Luftraum zu stürzen und über den schauerlichen Abgründen zu schweben, frei zu werden wie der Adler im Äther, beflügelt und bewegt auch die heutigen Delta- und Gleitschirmpiloten, die dank des opferbereiten Wagemuts Lilienthals und anderer Flugpioniere diesen Traum heute zu realisieren vermögen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be575c94-6c6b-3df3-bf6b-b1b04aa92c3f",
                                        "entry_id": "953516fd-c19b-30a5-ab84-ead3c561a09f",
                                        "glosses": [
                                            "nachdrücklich geäußerter Wunsch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5220c82-80aa-438d-9c24-898ae7a41fe6",
                                                "sense_id": "be575c94-6c6b-3df3-bf6b-b1b04aa92c3f",
                                                "text": "„Dieses den jungen Goethe ergreifende Verlangen, sich in den unendlichen Luftraum zu stürzen und über den schauerlichen Abgründen zu schweben, frei zu werden wie der Adler im Äther, beflügelt und bewegt auch die heutigen Delta- und Gleitschirmpiloten, die dank des opferbereiten Wagemuts Lilienthals und anderer Flugpioniere diesen Traum heute zu realisieren vermögen.“"
                                            },
                                            {
                                                "example_id": "e2b4826a-ba9c-4607-b531-c59048ddb2f8",
                                                "sense_id": "be575c94-6c6b-3df3-bf6b-b1b04aa92c3f",
                                                "text": "Das Verlangen des Rechtes auf Anhörung ist jedermanns gutes Recht."
                                            },
                                            {
                                                "example_id": "3ed7d2e8-c509-4305-8591-33a3979bf005",
                                                "sense_id": "be575c94-6c6b-3df3-bf6b-b1b04aa92c3f",
                                                "text": "Seinem Verlangen nach Aufklärung wollte niemand so recht nachkommen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
