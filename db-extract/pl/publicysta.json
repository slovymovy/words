                                    {
                                        "sense_id": "b8ea7057-39e8-331f-82eb-e0d02fbbad22",
                                        "entry_id": "f74232f8-000f-3a19-b13e-cb2541f38ec0",
                                        "glosses": [
                                            "A person whose job is to publicize information or events; a publicity agent; a public relations agent or worker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c542d362-37e5-4f4a-a5ee-7b8c77bcc632",
                                                "sense_id": "b8ea7057-39e8-331f-82eb-e0d02fbbad22",
                                                "text": "Legendary soul singer Bobby Womack died Friday, Womack’s publicist said. He was 70."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbec46e8-44e1-3068-97a1-6ee0a7cf5626",
                                        "entry_id": "f74232f8-000f-3a19-b13e-cb2541f38ec0",
                                        "glosses": [
                                            "A journalist, often a commentator, who focusses on politics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98d048a8-8391-3efc-af80-eb66a141f0e3",
                                        "entry_id": "f74232f8-000f-3a19-b13e-cb2541f38ec0",
                                        "glosses": [
                                            "A scholar, of public or international law."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "027fc25b-eab4-4930-b75b-e95c168eac82",
                        "source_entry_id": "396efac0-1309-3410-9b45-4e12d267d585",
                        "source_sense_id": "8661b2d3-2864-3e0d-b105-8113a70cbefd",
