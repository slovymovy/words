                        "glosses": [
                            "eine Person, die Bücher versteckt und nicht an andere ausleiht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f28d364-d7b3-41b0-b56a-814a8550b8b5",
                                "sense_id": "770150ae-f9d8-37e3-b26d-edf3387a1fe0",
                                "text": "Ein Bibliotaph verleiht seine Bücher nicht."
                            },
                            {
                                "example_id": "de5249ac-b0f1-48d3-8634-6ddb8c16e5a0",
                                "sense_id": "770150ae-f9d8-37e3-b26d-edf3387a1fe0",
                                "text": "„Francesco Petrarca [1304 — 1374]* ist in seinen unruhigen Wanderjahren kein Bibliotaph gewesen, manches Büchergut mag ihm bei Verleihen und bei dem ständigen Wechsel seines Aufenthaltsortes verlorengegangen sein, wie jene von ihm beklagte Schrift Ciceros.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
