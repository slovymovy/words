                        "addition",
                        "infusion"
                    ],
                    "antonyms": [
                        "separation"
                    ]
                },
                {
                    "sense_id": "ed2478fa-71c8-373b-bcbb-51d6d8861cd3",
                    "sense_definition": "A mixture composed of distinct entities or elements that retain their individual properties.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monitor showed an <w>admixture</w> of different signals overlapping without merging."
                        },
                        {
                            "text": "The sample was an <w>admixture</w> of separate mineral crystals visible under magnification."
                        }
                    ],
                    "synonyms": [
