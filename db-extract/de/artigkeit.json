                "senses": [
                    {
                        "sense_id": "999871c9-14e4-3d58-8d02-69776502f7c2",
                        "entry_id": "39f21020-2585-3e70-9bf0-abb0efd6f01b",
                        "glosses": [
                            "wohlerzogenes, formales, respektvolles Verhalten"
                        ],
                        "tags": [
                            "im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "f7c26b48-644a-4032-81ee-e4640cc17c90",
                                "sense_id": "999871c9-14e4-3d58-8d02-69776502f7c2",
                                "text": "„Artigkeit ist daher eine förmliche Pflicht, und jede Pflicht ist Tugend, sobald diese Pflicht erfüllet wird.“"
                            },
                            {
                                "example_id": "5810231e-3fc7-4d67-a050-7cd6b90a8d90",
                                "sense_id": "999871c9-14e4-3d58-8d02-69776502f7c2",
                                "text": "„Die Bischöfin bat ihn gleichfalls mit Artigkeit, sie nicht so schnell zu verlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a7da68de-1adf-3ca9-940c-070bd05829de",
                        "entry_id": "39f21020-2585-3e70-9bf0-abb0efd6f01b",
                        "glosses": [
                            "wohlerzogene, formale, floskelhafte, respektvolle Worte"
                        ],
                        "tags": [
                            "im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5e23d3f7-134b-43be-9f57-4399ee083ff5",
                                "sense_id": "a7da68de-1adf-3ca9-940c-070bd05829de",
                                "text": "„Der Birmese ist ein liebenswürdiger, etwas überlegener Causeur, der den Frauen allerlei Artigkeiten zu sagen und vor allem über die kleinen Dinge der Täglichkeit anregend zu sprechen weiß.“"
                            },
                            {
                                "example_id": "4361c95d-5c7d-4598-877c-4d8619853a3f",
                                "sense_id": "a7da68de-1adf-3ca9-940c-070bd05829de",
                                "text": "„Man sagte sich wechselseitig Artigkeiten und bedankte sich überschwenglich für die Gaben.“"
                            },
                            {
                                "example_id": "c3efe333-a4ec-48dd-a2d7-b68794da3afd",
                                "sense_id": "a7da68de-1adf-3ca9-940c-070bd05829de",
                                "text": "„Aber auf solche Artigkeiten verfallen alle Regierungen, um sich selbst keine Vorwürfe machen zu müssen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f3ecc6f-8b2c-413e-8157-88c40a9c53cd",
                        "source_entry_id": "39f21020-2585-3e70-9bf0-abb0efd6f01b",
