                    "sense_id": "d8a83285-ab96-3a39-b4bf-d450eabfdde9",
                    "sense_definition": "De latere uren van de zondag, tussen de middag en de nacht.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>zondagavond</w> is mijn favoriete moment om te ontspannen.",
                            "target_lang_translations": {
                                "en": "<w>Sunday evening</w> is my favorite time to relax.",
                                "ru": "<w>Воскресный вечер</w> — мое любимое время для отдыха.",
                                "pl": "<w>Niedzielny wieczór</w> to mój ulubiony moment na relaks.",
                                "de": "Der <w>Sonntagabend</w> ist meine liebste Zeit zum Entspannen.",
                                "fr": "Le <w>dimanche soir</w> est mon moment préféré pour me détendre.",
                                "it": "La <w>domenica sera</w> è il mio momento preferito per rilassarmi.",
                                "cs": "<w>Nedělní večer</w> je můj nejoblíbenější čas na odpočinek.",
                                "tr": "<w>Pazar akşamı</w> dinlenmek için en sevdiğim zamandır.",
                                "es": "El <w>domingo por la noche</w> es mi momento favorito para relajarme.",
                                "zh": "<w>周日晚上</w>是我最喜欢的放松时刻。"
                            }
                        },
                        {
                            "text": "We hebben die hele <w>zondagavond</w> in het ziekenhuis doorgebracht.",
                            "target_lang_translations": {
                                "en": "We spent that entire <w>Sunday evening</w> in the hospital.",
                                "ru": "Мы провели весь <w>вечер воскресенья</w> в больнице.",
                                "pl": "Spędziliśmy cały <w>niedzielny wieczór</w> w szpitalu.",
                                "de": "Wir haben den ganzen <w>Sonntagabend</w> im Krankenhaus verbracht.",
                                "fr": "Nous avons passé tout ce <w>dimanche soir</w> à l'hôpital.",
                                "it": "Abbiamo passato tutta la <w>domenica sera</w> in ospedale.",
                                "cs": "Celý ten <w>nedělní večer</w> jsme strávili v nemocnici.",
                                "tr": "Tüm o <w>Pazar akşamını</w> hastanede geçirdik.",
                                "es": "Pasamos todo ese <w>domingo por la noche</w> en el hospital.",
                                "zh": "我们整个<w>周日晚上</w>都是在医院度过的。"
                            }
