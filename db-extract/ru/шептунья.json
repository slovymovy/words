                        "glosses": [
                            "разг. женск. к шептун"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d807b009-4400-4a9f-8c17-982e66b55f91",
                                "sense_id": "07e6365e-a63e-3560-ad4f-4a9e35d97959",
                                "text": "Вот та шептунья, попадья, все знает, что у ней на уме: да и та скорей умрет, а не скажет её секретов."
                            },
                            {
                                "example_id": "bdebd324-fbda-4726-bf22-e34b8b4edf9e",
                                "sense_id": "07e6365e-a63e-3560-ad4f-4a9e35d97959",
                                "text": "― Постылые, шептуньи, чтоб вас разорвало, ― бормотал он."
                            },
                            {
                                "example_id": "5be781bf-941c-4dc7-9119-6d16dc7e8016",
                                "sense_id": "07e6365e-a63e-3560-ad4f-4a9e35d97959",
                                "text": "Помните, солдатка шептунья вас с успехом заговаривала."
                            }
                        ]
                    }
                ],
