        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "40621449-2c5f-35b8-bfc4-62df069905c8",
                    "sense_definition": "Extremely hungry.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I missed breakfast this morning and now I am absolutely <w>starving</w>.",
                            "target_lang_translations": {
                                "ru": "Я пропустил завтрак сегодня утром, и теперь я просто <w>умираю от голода</w>.",
                                "de": "Ich habe heute Morgen das Frühstück verpasst und bin jetzt absolut <w>am Verhungern</w>."
                            }
                        },
                        {
                            "text": "The <w>starving</w> dog ate the bowl of food in seconds.",
                            "target_lang_translations": {
                                "ru": "<w>Изголодавшаяся</w> собака съела миску еды за секунды.",
                                "de": "Der <w>ausgehungerte</w> Hund fraß die Schüssel mit Futter in Sekunden leer."
                            }
                        }
                    ],
                    "synonyms": [
                        "ravenous",
                        "famished",
                        "hungry"
                    ],
                    "common_phrases": [
                        "absolutely starving",
                        "starving hungry",
                        "starving to death"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень сильное чувство голода.",
                        "de": "Extremer Hunger; ein Zustand, in dem man sehr dringend essen muss."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умирающий от голода",
