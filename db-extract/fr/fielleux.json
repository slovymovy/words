                    {
                        "form_id": "c507e50b-2489-48e2-9fee-37f334eb6492",
                        "entry_id": "a0736839-40a4-3107-bff6-b9dbdeaff4df",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "fielleuses"
