                "senses": [
                    {
                        "sense_id": "8727c041-f1d9-37cf-9f40-2eec79224efc",
                        "entry_id": "91a67bc8-aac2-3b7e-8ca5-ebcd295f5769",
                        "glosses": [
                            "Incinérer de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7672b5b-04cb-4c6d-aabb-5cec61bcef65",
                                "sense_id": "8727c041-f1d9-37cf-9f40-2eec79224efc",
                                "text": "Après un certain laps de temps, les femmes brûlent les défrichements au feu courant. Ensuite elles ramassent les débris et les réincinèrent en petits tas."
                            },
                            {
                                "example_id": "18fe46af-0554-45bc-9222-637b72f2b919",
                                "sense_id": "8727c041-f1d9-37cf-9f40-2eec79224efc",
                                "text": "Râcler les parois de l'incinérateur et réincinérer les résidus."
                            },
                            {
                                "example_id": "a7c4a562-8cf2-4cdd-b4e4-15fe7de83669",
                                "sense_id": "8727c041-f1d9-37cf-9f40-2eec79224efc",
                                "text": "Dans la fabrique de son poème, véritable athanor où se réincinère et se revivifie tout ce qui autrement, exposé à la mort inexorablement la propagerait, le poète devenu simple écho du poème, instaure sa continuité et se perpétue."
                            }
                        ]
                    }
