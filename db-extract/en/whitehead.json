                                "sense_id": "7beafc48-366f-3cd5-8bae-913ce4aadb84",
                                "text": "Ruth knew that the whiteheads of her teenage acne were a temporary state of affairs, but that did nothing to quell her distress when an eruption hit just before prom."
                            },
                            {
                                "example_id": "1efe6414-edd4-4f8d-a644-50b74f215625",
                                "sense_id": "7beafc48-366f-3cd5-8bae-913ce4aadb84",
                                "text": "Ma was taking a sterilized needle to a whitehead on my chin."
                            }
                        ]
