{
    "word_family": [
        "telephonic",
        "telephonist",
        "telephony",
        "telephonically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03aeabc2-2074-3a70-ba89-9ad3ce8a7e5c",
                    "sense_definition": "A telecommunication device used for two-way talking with another person.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>telephone</w> rang loudly in the middle of the night.",
                            "target_lang_translations": {
                                "ru": "Посреди ночи громко зазвонил <w>телефон</w>.",
                                "zh": "半夜里，<w>电话</w>响得很响。"
                            }
                        },
                        {
                            "text": "Please answer the <w>telephone</w> if you are near the desk.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, ответь на <w>телефон</w>, если ты рядом со столом.",
                                "zh": "如果你在桌子旁边，请接一下<w>电话</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "phone"
                    ],
                    "common_phrases": [
                        "answer the telephone",
                        "mobile telephone",
                        "public telephone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Телекоммуникационное устройство, используемое для двустороннего разговора с другим человеком.",
                        "zh": "用于与他人进行双向通话的电信设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телефон",
                                "target_lang_sense_clarification": "устройство связи"
                            },
                            {
                                "target_lang_word": "телефонный аппарат",
                                "target_lang_sense_clarification": "техническое название устройства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电话",
                                "target_lang_sense_clarification": "指代电话机这一设备"
                            },
                            {
                                "target_lang_word": "电话机",
                                "target_lang_sense_clarification": "指代具体的电话设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eee77136-9473-3cf0-b88e-1d39049e82ad",
                    "sense_definition": "The receiver or handset part of a communication device.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "communication device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He held the <w>telephone</w> to his ear and waited for a dial tone.",
                            "target_lang_translations": {
                                "ru": "Он поднес <w>трубку</w> к уху и стал ждать гудка.",
                                "zh": "他把<w>听筒</w>贴在耳边，等待拨号音。"
                            }
                        },
                        {
                            "text": "She gripped the <w>telephone</w> tightly while listening to the news.",
                            "target_lang_translations": {
                                "ru": "Она крепко сжала <w>трубку</w>, слушая новости.",
                                "zh": "她在听新闻时紧紧握着<w>听筒</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pick up the telephone",
                        "hold the telephone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приемник или трубка устройства связи.",
                        "zh": "通信设备中用于通话的听筒部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телефонная трубка",
                                "target_lang_sense_clarification": "часть аппарата"
                            },
                            {
                                "target_lang_word": "трубка",
                                "target_lang_sense_clarification": "разговорное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "听筒",
                                "target_lang_sense_clarification": "电话机上用于接听声音的部分"
                            },
                            {
                                "target_lang_word": "话筒",
                                "target_lang_sense_clarification": "指代手持通话部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "024ae73e-5909-3c0e-8510-0b7e2c2adcba",
                    "sense_definition": "A children's game where a message is whispered from person to person and often becomes distorted.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distorted communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children played a game of <w>telephone</w> during the birthday party.",
                            "target_lang_translations": {
                                "ru": "Дети играли в <w>испорченный телефон</w> во время празднования дня рождения.",
                                "zh": "孩子们在生日聚会上玩了<w>传话游戏</w>。"
                            }
                        },
                        {
                            "text": "By the time the secret reached the last person in the game of <w>telephone</w>, it was completely different.",
                            "target_lang_translations": {
                                "ru": "К тому времени, как секрет дошел до последнего человека в <w>испорченном телефоне</w>, он стал совершенно другим.",
                                "zh": "当秘密传到<w>传话游戏</w>的最后一个人时，内容已经完全变了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "game of telephone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Детская игра, в которой сообщение шепотом передается от человека к человеку и часто искажается.",
                        "zh": "一种儿童游戏，信息在人与人之间耳语传递，往往会发生扭曲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испорченный телефон",
                                "target_lang_sense_clarification": "название игры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传话游戏",
                                "target_lang_sense_clarification": "指代通过口耳相传的游戏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a94637e7-cab9-3f3d-80cb-6a1d7c8d9ffd",
                    "sense_definition": "A situation where information is distorted by being passed through many people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distorted communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office rumors turned into a game of <w>telephone</w> that confused everyone.",
                            "target_lang_translations": {
                                "ru": "Офисные слухи превратились в <w>испорченный телефон</w>, который всех запутал.",
                                "zh": "办公室的流言演变成了一场<w>以讹传讹</w>，搞得大家都很困惑。"
                            }
                        },
                        {
                            "text": "Because of the <w>telephone</w> effect, the original instructions were totally misunderstood.",
                            "target_lang_translations": {
                                "ru": "Из-за эффекта <w>испорченного телефона</w> первоначальные инструкции были поняты совершенно неправильно.",
                                "zh": "由于<w>以讹传讹</w>的效应，最初的指示被完全误解了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "game of telephone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация, когда информация искажается при передаче через многих людей.",
                        "zh": "指信息在多人传递过程中被扭曲的情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испорченный телефон",
                                "target_lang_sense_clarification": "переносное значение об искажении информации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "以讹传讹",
                                "target_lang_sense_clarification": "指信息在传递中失真"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b9259861-d74f-3a11-ba12-a9e2b0589a65",
                    "sense_definition": "To contact or attempt to contact someone using a phone.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "to call",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will <w>telephone</w> you as soon as I arrive at the station.",
                            "target_lang_translations": {
                                "ru": "Я <w>позвоню</w> тебе, как только приеду на вокзал.",
                                "zh": "我一到车站就<w>打电话</w>给你。"
                            }
                        },
                        {
                            "text": "She decided to <w>telephone</w> home to tell her parents she would be late.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>позвонить</w> домой, чтобы сказать родителям, что задержится.",
                                "zh": "她决定<w>打电话</w>回家告诉父母她会晚点到。"
                            }
                        }
                    ],
                    "synonyms": [
                        "call",
                        "phone",
                        "ring",
                        "call up",
                        "ring up"
                    ],
                    "common_phrases": [
                        "telephone home",
                        "telephone for help"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связаться или попытаться связаться с кем-либо по телефону.",
                        "zh": "使用电话与某人联系或尝试联系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звонить",
                                "target_lang_sense_clarification": "связываться по телефону"
                            },
                            {
                                "target_lang_word": "позвонить",
                                "target_lang_sense_clarification": "совершить звонок"
                            },
                            {
                                "target_lang_word": "телефонировать",
                                "target_lang_sense_clarification": "официальный или устаревший стиль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打电话",
                                "target_lang_sense_clarification": "通过电话进行联系"
                            },
                            {
                                "target_lang_word": "致电",
                                "target_lang_sense_clarification": "较为正式的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0a6404a-32f6-3b70-8735-6c7693e4274f",
                    "sense_definition": "To send or convey a specific message or information via phone.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "to call",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness <w>telephoned</w> the news to the local police station immediately.",
                            "target_lang_translations": {
                                "ru": "Свидетель немедленно <w>сообщил</w> новости в местный полицейский участок по телефону.",
                                "zh": "目击者立即<w>电话告知</w>了当地警察局这一消息。"
                            }
                        },
                        {
                            "text": "He <w>telephoned</w> his apologies because he could not attend the meeting.",
                            "target_lang_translations": {
                                "ru": "Он <w>передал</w> свои извинения по телефону, так как не смог присутствовать на встрече.",
                                "zh": "他因为无法参加会议，特意<w>电话传达</w>了他的歉意。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "telephone the news",
                        "telephone an order"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передать или сообщить конкретное сообщение или информацию по телефону.",
                        "zh": "通过电话发送或传达特定的信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщить по телефону",
                                "target_lang_sense_clarification": "передать информацию"
                            },
                            {
                                "target_lang_word": "передать по телефону",
                                "target_lang_sense_clarification": "диктовать данные или новости"
                            },
                            {
                                "target_lang_word": "телефонировать",
                                "target_lang_sense_clarification": "официально передать сведения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电话告知",
                                "target_lang_sense_clarification": "通过电话传达消息"
                            },
                            {
                                "target_lang_word": "电话传达",
                                "target_lang_sense_clarification": "通过电话转达信息"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}