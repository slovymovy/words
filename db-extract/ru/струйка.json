                ],
                "senses": [
                    {
                        "sense_id": "0b1b2ebf-1809-363e-a619-116bc4fa2372",
                        "entry_id": "effa4a1e-afd9-3327-8f87-a6c38aabf258",
                        "glosses": [
                            "уменьш. к струя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60446e0e-8ac8-479a-ad4d-b1c71e2993b5",
                                "sense_id": "0b1b2ebf-1809-363e-a619-116bc4fa2372",
                                "text": "Из разреза брызгали струйки опилок, пахнущие свежей смолою."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "757c1f65-dd7d-42aa-8205-90f9be67ea95",
                        "source_entry_id": "effa4a1e-afd9-3327-8f87-a6c38aabf258",
                        "source_sense_id": "0b1b2ebf-1809-363e-a619-116bc4fa2372",
                        "target_lang_word": "Rinnsal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rinnsal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0e5c2a7-549f-32ac-9267-f5a8bfb48df5",
                                        "entry_id": "9fcb3876-0ab3-379d-87ca-6f1f02008418",
                                        "glosses": [
                                            "sehr kleines, sacht fließendes Gewässer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12c8b2a3-e483-47c4-a53e-5ca239f2ed84",
                                                "sense_id": "d0e5c2a7-549f-32ac-9267-f5a8bfb48df5",
                                                "text": "„Die Saison ist rum und der Neckar ein Rinnsal.“"
                                            },
                                            {
                                                "example_id": "7809600a-a6d9-4cb0-a424-95902a779dd4",
                                                "sense_id": "d0e5c2a7-549f-32ac-9267-f5a8bfb48df5",
                                                "text": "„Dieses Jahr ist der Fluß, der hier Firat heißt, schon jetzt im Juni vom mächtigen Strom zum spärlichen Rinnsal geschrumpft.“"
                                            },
                                            {
                                                "example_id": "58ee0ba7-e295-4b83-800f-5b31a682c093",
                                                "sense_id": "d0e5c2a7-549f-32ac-9267-f5a8bfb48df5",
                                                "text": "[Klimakrise – Trockenheit in Südeuropa 2022:] „Der Po, eigentlich ein mächtiger Strom, hat sich in ein trauriges, schmales Rinnsal verwandelt.“"
                                            },
                                            {
                                                "example_id": "2fc3cf0e-3c5a-4d94-865d-d226059f3892",
                                                "sense_id": "d0e5c2a7-549f-32ac-9267-f5a8bfb48df5",
                                                "text": "„Der Tungufluß fließt ruhig und breit in seinen tiefen Rinnsalen und ergießt sich östlich vom Bischofssitz Skálholt in den Hvitfluß, den Jökullstrom.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "763d1474-30c5-3ac3-aae4-e3c993318d8e",
                                        "entry_id": "9fcb3876-0ab3-379d-87ca-6f1f02008418",
                                        "glosses": [
                                            "Flüssigkeit, die in einer kleineren Menge irgendwohin rinnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a38abde2-b705-41d8-a7cd-3e7c0fd43036",
                                                "sense_id": "763d1474-30c5-3ac3-aae4-e3c993318d8e",
                                                "text": "„Sie starrte hinab auf das bleiche Antlitz, über das sich jetzt ein dünnes rotes Rinnsal hinzog.“"
                                            },
                                            {
                                                "example_id": "4bbe5d13-b88e-40f2-b877-9fe9c4073d22",
                                                "sense_id": "763d1474-30c5-3ac3-aae4-e3c993318d8e",
                                                "text": "„Schwarze Rinnsale liefen die schwarzen Scheiben hinab.“"
                                            },
                                            {
                                                "example_id": "94a86628-b5cc-4adf-87e3-f69c77320fea",
                                                "sense_id": "763d1474-30c5-3ac3-aae4-e3c993318d8e",
                                                "text": "„Ganz profan gossen Männer schwungvoll Wasser über den Boden und schrubbten, während die Fahrgäste über die sich ausbreitenden Rinnsale hinwegstiegen.“"
                                            },
                                            {
                                                "example_id": "68c0a064-9ba9-421f-acb2-124930d7376a",
                                                "sense_id": "763d1474-30c5-3ac3-aae4-e3c993318d8e",
                                                "text": "„Pavel schloss die Augen und versuchte sich an das letzte Mal zu erinnern, dass er Fleisch gegessen hatte. Als er die Augen wieder öffnete, sabberte er, wie ein Rinnsal rann ihm die Spucke übers Kinn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
