                "translations": [
                    {
                        "translation_id": "7639a743-865b-4502-b1e1-f75d44c72ebf",
                        "source_entry_id": "a4afc47f-82e7-3177-b471-f40e4d574b5b",
                        "source_sense_description": "Parietaria officinalis",
                        "target_lang_word": "pariétaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pariétaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2d72da7-f16b-364a-999c-eb06263ec275",
                                        "entry_id": "e998c37c-f54e-3c8e-a15f-f102c9d551a7",
                                        "glosses": [
                                            "Plante de la famille des Urticées, ainsi appelée parce qu’elle croît ordinairement sur les murailles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0044b9a4-36e2-41a2-86a9-203338d15f32",
                                                "sense_id": "b2d72da7-f16b-364a-999c-eb06263ec275",
                                                "text": "Mais, trahi par ses forces, il s’était assis sur une marche, parmi des pariétaires grandies dans les fentes des dalles."
                                            },
                                            {
                                                "example_id": "dda2ec93-b04b-45b5-b8ec-33a29ca772a5",
                                                "sense_id": "b2d72da7-f16b-364a-999c-eb06263ec275",
                                                "text": "Des pariétaires tapissaient en grande partie les murs râpeux, masquant même par endroits les étroites fenêtres."
                                            },
                                            {
                                                "example_id": "43f50794-97cb-479e-bc92-6cd79ac1da4b",
                                                "sense_id": "b2d72da7-f16b-364a-999c-eb06263ec275",
                                                "text": "Le canal traversait le mur de clôture sous une arche basse, d’où pendaient de longues pariétaires qui traînaient au fil de l’eau."
                                            },
                                            {
                                                "example_id": "a26215d3-0a80-427c-b8ea-b1c35093661f",
                                                "sense_id": "b2d72da7-f16b-364a-999c-eb06263ec275",
                                                "text": "Ainsi de la fragilité et de la curieuse translucidité de la tige : la Pariétaire, fausse bourrue, se brise comme verre, justement, et montre, sous sa peau rougeâtre, veinée longitudinalement de plus foncé, une chair quasi incolore, grêle mais riche en suc."
                                            },
                                            {
                                                "example_id": "35248df0-2a7c-4da4-8341-336e371a25c0",
                                                "sense_id": "b2d72da7-f16b-364a-999c-eb06263ec275",
                                                "text": "Son ombre s’enfonça dans le tunnel où les pariétaires déchirés pendaient."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pariétaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c3ebbff-6527-3d9f-ae73-e5612364c670",
                                        "entry_id": "465e3799-67e7-33ad-99b7-d21f1f4298d7",
                                        "glosses": [
                                            "Qui appartient ou qui ressemble aux pariétaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbcfa18b-89fd-405f-9416-ca9f0f8bc920",
                                                "sense_id": "4c3ebbff-6527-3d9f-ae73-e5612364c670",
                                                "text": "Dans le trou des boulets ont poussé des lierres, des saxifrages et autres plantes pariétaires dont la fraîche verdure se marie admirablement aux teintes vermeilles de la pierre."
                                            },
                                            {
                                                "example_id": "00a9aea3-4f99-47f9-af42-9f600a5dd4fd",
                                                "sense_id": "4c3ebbff-6527-3d9f-ae73-e5612364c670",
                                                "text": "Les marches rompues et disjointes faisaient bascule sous le pied ou n’étaient retenues que par les filaments des mousses et des plantes pariétaires ; sur l’appui de la terrasse avaient crû des joubarbes, des ravenelles et des artichauts sauvages."
                                            },
                                            {
                                                "example_id": "1425a5bf-925e-49da-ab15-35989a06f85d",
                                                "sense_id": "4c3ebbff-6527-3d9f-ae73-e5612364c670",
                                                "text": "[…] dont la présence, pareille à celle de ces feuillages pariétaires qui ont poussé à côté des feuillages sculptés, semblait destinée à permettre, […] de juger de la vérité de l’œuvre d’art."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
