        "fr-extract.jsonl": [
            {
                "entry_id": "9ecbc73e-b98d-3ce1-97e1-1e79122a7c29",
                "word": "créance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "56d5b920-5ca2-47af-ac8c-6d9a6b155472",
                        "entry_id": "9ecbc73e-b98d-3ce1-97e1-1e79122a7c29",
                        "tags": [
                            "plural"
                        ],
                        "form": "créances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3dbdbdc-4c4f-321a-b471-a1b710ae3709",
                        "entry_id": "9ecbc73e-b98d-3ce1-97e1-1e79122a7c29",
                        "glosses": [
                            "Action de croire ou de se fier à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43c08132-2807-4b85-84b9-511db4393cae",
                                "sense_id": "c3dbdbdc-4c4f-321a-b471-a1b710ae3709",
                                "text": "Leurs résultats n’ont point obtenu créance et demeurent très-problématiques."
                            },
                            {
                                "example_id": "67e6e498-ec5b-4267-89d3-6a5edbd7e031",
                                "sense_id": "c3dbdbdc-4c4f-321a-b471-a1b710ae3709",
                                "text": "Car il faudrait accuser tous les maîtres les plus grands, et leur biographie étant connue ne nous permet pas de donner créance à de telles calomnies."
                            },
                            {
                                "example_id": "369bbb51-8c13-4ca1-a78e-bb7ed5e4ee4e",
                                "sense_id": "c3dbdbdc-4c4f-321a-b471-a1b710ae3709",
                                "text": "C’est du moins ce que raconte Arthur Pym dans son récit, et il n’y a pas lieu de lui refuser créance."
                            },
                            {
                                "example_id": "b5e9a8df-b015-42eb-9e08-b35e00b9cdb3",
                                "sense_id": "c3dbdbdc-4c4f-321a-b471-a1b710ae3709",
                                "text": "L’affaire passionnait déjà l’opinion. Elle se produisait dans des conditions si particulières, le nom d’Arsène Lupin excitait à tel point les imaginations, que les histoires les plus fantaisistes remplissaient les colonnes des journaux et trouvaient créance auprès du public."
                            },
                            {
                                "example_id": "e6dac5b1-2d7e-4b61-8470-73a975fdb694",
                                "sense_id": "c3dbdbdc-4c4f-321a-b471-a1b710ae3709",
                                "text": "Pour excuser ma manie d’écrire, je me dis toujours « ces notes peuvent rendre service ». Oui, mais à la condition que leur sincérité ne fasse aucun doute. Or, pour trouver créance, il ne faut pas être trop vrai."
                            },
                            {
                                "example_id": "47f29ff9-1821-4532-950a-a9f87174e9b8",
                                "sense_id": "c3dbdbdc-4c4f-321a-b471-a1b710ae3709",
                                "text": "Que vaut cette brochure ? Rien, me direz-vous, et nous ne devons lui accorder aucune créance."
                            },
                            {
                                "example_id": "95402060-951d-43d7-8b78-9f00949a83cc",
                                "sense_id": "c3dbdbdc-4c4f-321a-b471-a1b710ae3709",
                                "text": "C’est un fait avéré ― puisque le notaire et le curé, personnes dignes de créance, en ont témoigné ― qu’Alonzo Quijano le Bon, plus connu sous le nom de Don Quichotte, décéda naturellement dans son lit, après avoir légué ses biens, meubles et immeubles, à sa nièce Antonia."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba6ee4e0-a92b-33be-9957-47565157d799",
                        "entry_id": "9ecbc73e-b98d-3ce1-97e1-1e79122a7c29",
                        "glosses": [
                            "Dette active ; titre ou droit qui rend une personne créancière d’une autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3da7a67-6ff8-4463-a7f4-b346efef59a4",
                                "sense_id": "ba6ee4e0-a92b-33be-9957-47565157d799",
                                "text": "Madame Gabin nous avait raconté qu’il se trouvait simplement de passage à Paris, où il venait recueillir d’anciennes créances de son père, retiré en province et mort dernièrement."
                            },
                            {
                                "example_id": "98d61f23-80a8-4636-b92e-4bda29cfe83f",
                                "sense_id": "ba6ee4e0-a92b-33be-9957-47565157d799",
                                "text": "En 1234, Saint Louis accepta que les juifs fussent spoliés d'un tiers de leurs créances."
                            },
                            {
                                "example_id": "da2b7acc-d49d-4d01-a38a-b0fa14bdad29",
                                "sense_id": "ba6ee4e0-a92b-33be-9957-47565157d799",
                                "text": "Mais l’Amérique refuse d’annuler ses créances de guerre, aussi bien la créance qu'elle possède sur la Grande-Bretagne que la créance qu'elle possède sur la France."
                            },
                            {
                                "example_id": "6da47711-f4ff-4c9f-9c7e-e65b6fa73440",
                                "sense_id": "ba6ee4e0-a92b-33be-9957-47565157d799",
                                "text": "En effet, l'intimée ne peut se prévaloir de la subrogation engendrée par le paiement de la créance chirographaire appartenant à Portronik. L'intimée détenant une créance garantie et Portronik une créance chirographaire, cette compensation aurait directement pour effet de modifier le plan de répartition prévu par l'article 136 L.F.I. en améliorant le rang de la réclamation, éventualité formellement rejetée par quatre arrêts de la Cour suprême."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7f870b3-34dc-4750-8859-a5307838da95",
                        "source_entry_id": "9ecbc73e-b98d-3ce1-97e1-1e79122a7c29",
                        "source_sense_id": "ba6ee4e0-a92b-33be-9957-47565157d799",
