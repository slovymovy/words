                    "sense_id": "b5362915-59cf-38bd-9a3d-9f2c1345e583",
                    "sense_definition": "een staat van goede lichamelijke en geestelijke gezondheid en tevredenheid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gezondheidstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voldoende beweging en gezonde voeding dragen bij aan het algemeen <w>welbevinden</w> van de mens.",
                            "target_lang_translations": {
                                "en": "Sufficient exercise and healthy nutrition contribute to the general <w>well-being</w> of humans."
                            }
                        },
                        {
                            "text": "De arts stelde vast dat het psychisch <w>welbevinden</w> van de patiënt aanzienlijk was verbeterd.",
                            "target_lang_translations": {
                                "en": "The doctor determined that the patient's psychological <w>well-being</w> had improved significantly."
                            }
                        }
                    ],
                    "synonyms": [
                        "welzijn",
                        "welvaren",
                        "gezondheidstoestand"
                    ],
                    "common_phrases": [
                        "psychisch welbevinden",
                        "algemeen welbevinden",
                        "persoonlijk welbevinden"
                    ],
                    "target_lang_definitions": {
                        "en": "a state of good physical and mental health and satisfaction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "well-being",
                                "target_lang_sense_clarification": "general state of health and happiness"
                            },
                            {
                                "target_lang_word": "wellness",
                                "target_lang_sense_clarification": "the state of being in good health"
                            },
                            {
                                "target_lang_word": "welfare",
                                "target_lang_sense_clarification": "the health and happiness of a person or group"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f14606f9-320d-32c2-97f2-5eca70a0408e",
                    "sense_definition": "goedkeuring of impliciete toestemming om iets te doen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toestemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga daar, met uw <w>welbevinden</w>, nog even dieper op in tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "I will, with your <w>approval</w>, go into that in more depth during the meeting."
                            }
                        },
                        {
                            "text": "Zij verliet de kamer met het stilzwijgend <w>welbevinden</w> van haar leidinggevende.",
                            "target_lang_translations": {
                                "en": "She left the room with the tacit <w>consent</w> of her supervisor."
                            }
                        }
                    ],
                    "synonyms": [
                        "welbehagen"
                    ],
                    "common_phrases": [
                        "met uw welbevinden",
                        "stilzwijgend welbevinden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in formele of beleefde contexten"
                        }
                    ],
                    "target_lang_definitions": {
