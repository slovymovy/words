                "senses": [
                    {
                        "sense_id": "7d3ef360-956e-354e-88e3-81a9582bc0b8",
                        "entry_id": "b5bce9b7-90d3-36b6-8f59-552c1b650327",
                        "glosses": [
                            "indiscreet, loose-lipped"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bb1ea52-cae3-4e9d-8e78-ee244a3dbf98",
                                "sense_id": "7d3ef360-956e-354e-88e3-81a9582bc0b8",
                                "text": "Pas op wat je zegt, hij is nogal loslippig en vertelt snel geheimen door.",
                                "translation": "Be careful what you say, he's quite loose-lipped and quick to share secrets.",
                                "english": "Be careful what you say, he's quite loose-lipped and quick to share secrets."
                            },
                            {
                                "example_id": "54bfd436-2e49-47fc-9d2a-f3660c6cd5c3",
                                "sense_id": "7d3ef360-956e-354e-88e3-81a9582bc0b8",
                                "text": "De loslippige opmerking van de politicus zorgde voor controverse.",
                                "translation": "The indiscreet remark of the politician caused controversy.",
                                "english": "The indiscreet remark of the politician caused controversy."
                            },
                            {
                                "example_id": "e12d8369-5082-4f00-b704-6a0011998877",
                                "sense_id": "7d3ef360-956e-354e-88e3-81a9582bc0b8",
                                "text": "Ze was te loslippig over haar plannen en nu weet iedereen ervan.",
                                "translation": "She was too loose-lipped about her plans, and now everyone knows about them.",
                                "english": "She was too loose-lipped about her plans, and now everyone knows about them."
                            }
                        ]
                    }
