                        "examples": [
                            {
                                "example_id": "c2ce4d08-ceec-45ed-9877-e49a63c01bbc",
                                "sense_id": "bbb2f699-c27e-3e9a-b4a9-b481baf7bf2c",
                                "text": "But, besides the fresh strawberries, the shortcakes are the secret weapon, and people truly have their opinions on what makes the best shortcake!"
                            },
                            {
                                "example_id": "bd7d915e-9434-449e-bf4f-bf7b879405a7",
                                "sense_id": "bbb2f699-c27e-3e9a-b4a9-b481baf7bf2c",
                                "text": "And since Max did everything I did, he and I both absorbed the same process for preparing a shortcake."
                            },
                            {
                                "example_id": "0f8519d1-9ca1-4193-83f5-30e90b5885d7",
                                "sense_id": "bbb2f699-c27e-3e9a-b4a9-b481baf7bf2c",
                                "text": "Die einzelnen Bestandteile eignen sich auch gut zum Mitnehmen für ein Picknick - zusammen stellen dürfen Sie die Shortcakes erst vor Ort, sonst weichen sie durch."
                            }
                        ]
                    }
