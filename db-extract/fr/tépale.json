                                "target_senses": [
                                    {
                                        "sense_id": "2c9dc195-414b-34f9-8d04-e57cac5122e1",
                                        "entry_id": "48664db5-e1c6-319f-9bb6-6c8134e1d245",
                                        "glosses": [
                                            "Any component of the perianth (outermost whorls of flower parts, not involved in reproduction), especially when the components are not distinguished into sepals and petals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40350f1f-f624-4c24-9956-f9e801641f2f",
                                                "sense_id": "2c9dc195-414b-34f9-8d04-e57cac5122e1",
                                                "text": "1982, H. Q. Varekamp (translator and editor), Z. Botschantzeva, Tulips: Taxonomy, Morphology, cytology, phytogeography and physiology, page 27,\nIn Tulipa the pubescent tips of the tepals are quite interesting in particular those of T. fosteriana. The top of the tepal is initiated and develops before the reflexed, lateral parts."
                                            },
                                            {
                                                "example_id": "8570d0a6-ae4b-4b39-9926-e611f0163532",
                                                "sense_id": "2c9dc195-414b-34f9-8d04-e57cac5122e1",
                                                "text": "The species bears creamy white flowers with a yellow base and tepals often streaked with rose-pink."
                                            },
                                            {
                                                "example_id": "eb7f55e1-1aca-4531-83c1-ac1607f40333",
                                                "sense_id": "2c9dc195-414b-34f9-8d04-e57cac5122e1",
                                                "text": "In our material of T. bulbosa, the abaxial outer tepal was larger at its inception than the lateral ones (Fig 8.4C), whereas the primordia of the outer tepals are of nearly equal size in both T. barrelieri (Fig 8.5E) and T. palustris (not shown)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
