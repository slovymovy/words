                    {
                        "sense_id": "20c7d0aa-c6ae-348f-bcf1-8a5ed6ab1d0f",
                        "entry_id": "c2b03151-d6bf-3b03-ab6a-2c9805f7c593",
                        "glosses": [
                            "verdeckte Zusammenarbeit unter Verletzung von anerkannten Regeln oder Gesetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "710269d8-7816-4829-9b18-3c8134d5c561",
                                "sense_id": "20c7d0aa-c6ae-348f-bcf1-8a5ed6ab1d0f",
                                "text": "Ohne die Kumpanei zwischen Verwaltung und Wirtschaft wäre das neue Schwimmbad billiger geworden."
                            },
                            {
                                "example_id": "ae97f1d9-6aad-4c17-9f03-f3334223b86b",
                                "sense_id": "20c7d0aa-c6ae-348f-bcf1-8a5ed6ab1d0f",
                                "text": "[Mord an Walther Rathenau:] „Aufgrund der Kumpanei zwischen dem Polizeibeamten und dem rechtsradikalen Aktivisten klappt die Waffenübergabe reibungslos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "05c3a9ff-1402-34bf-ad8d-857eb161f4c5",
                        "entry_id": "c2b03151-d6bf-3b03-ab6a-2c9805f7c593",
                        "glosses": [
                            "stillschweigende Zusammenarbeit zwischen Personen, darauf beruhend, dass eine Schwäche des jeweils anderen nicht ausgesprochen wird, Zusammengehörigkeitsgefühl, Freundschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f703f06-fd2b-4382-8142-298de65142aa",
                                "sense_id": "05c3a9ff-1402-34bf-ad8d-857eb161f4c5",
                                "text": "Die Kumpanei zwischen den Eheleuten hat bis heute verhindert, dass ihre Diät erfolgreich war."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
