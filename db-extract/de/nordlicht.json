                    },
                    {
                        "form_id": "a3c49d7a-65b1-4875-bbda-27da6ae9f3ad",
                        "entry_id": "a6451e60-ea5b-32de-adf0-362f9644e4e0",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Nordlicht"
                    },
                    {
                        "form_id": "56c770e2-89c8-4a81-b844-78df9d1a9727",
                        "entry_id": "a6451e60-ea5b-32de-adf0-362f9644e4e0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nordlichter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21c75fef-fa29-3d72-ad0d-7026a74c1182",
                        "entry_id": "a6451e60-ea5b-32de-adf0-362f9644e4e0",
                        "glosses": [
                            "Polarlicht des nördlichen Polarkreises"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f4fd1f-7248-4458-b5a1-6dbd020133a3",
                                "sense_id": "21c75fef-fa29-3d72-ad0d-7026a74c1182",
                                "text": "Das Nordlicht entsteht wesentlich über der nördlichen Polkappe durch Fluoreszierung der Erdmagnetfelder."
                            },
                            {
                                "example_id": "2a888bb8-c09e-42f8-8fd1-8f849beacff7",
                                "sense_id": "21c75fef-fa29-3d72-ad0d-7026a74c1182",
                                "text": "„Und im Winter sieht man hier Nordlichter.“"
                            },
                            {
                                "example_id": "095a17f9-3819-4e50-baeb-0a9f4ce5cef5",
                                "sense_id": "21c75fef-fa29-3d72-ad0d-7026a74c1182",
                                "text": "„Es ist das Feuer des Nordlichts in der Weite des Eismeeres.“"
                            },
                            {
                                "example_id": "0affe5a3-5b49-4a6d-b264-860239584ab7",
                                "sense_id": "21c75fef-fa29-3d72-ad0d-7026a74c1182",
                                "text": "„Bis auf die heißen Quellen ist die Wunscherfüllung nicht immer möglich: Wale und Nordlichter sind ein saisonales Geschäft.“"
                            },
                            {
                                "example_id": "a6262280-9ba9-4ddc-9b87-72212da97be4",
                                "sense_id": "21c75fef-fa29-3d72-ad0d-7026a74c1182",
                                "text": "„Nordlichter sind in dieser Gegend nicht selten, zu bestimmten Jahrszeiten alltäglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9718d466-f509-35a1-8438-c550dace591b",
                        "entry_id": "a6451e60-ea5b-32de-adf0-362f9644e4e0",
                        "glosses": [
                            "für Bewohner Norddeutschlands"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "ea59a811-2210-47da-a4c4-33f6b3b681c4",
                                "sense_id": "9718d466-f509-35a1-8438-c550dace591b",
                                "text": "Da mein Freund aus Flensburg stammt, nennt man ihn bisweilen Nordlicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
