                    {
                        "translation_id": "f3c1b5b2-c3bd-4936-9bff-025dbbc1187f",
                        "source_entry_id": "3a1593ad-5e7b-326c-a967-e03e5bf4d002",
                        "source_sense_id": "810c8ac2-ed94-3cca-82b6-d4927818ea5c",
                        "source_sense_description": "een land in Noord-Afrika, officieel de Democratische Volksrepubliek Algerije",
                        "target_lang_word": "Algerien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Algerien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "504283fc-e75d-36e9-bb8c-c0956fae3581",
                                        "entry_id": "58d40094-9ea4-3d69-830d-fd85f79eb4cf",
                                        "glosses": [
                                            "ein Staat in Nordafrika"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e1f4f5d-4683-4b20-9b2b-4869ac5acf34",
                                                "sense_id": "504283fc-e75d-36e9-bb8c-c0956fae3581",
                                                "text": "Er fährt jeden Sommer nach Algerien."
                                            },
                                            {
                                                "example_id": "86eacde3-ef1a-442b-b8af-3217905c8a34",
                                                "sense_id": "504283fc-e75d-36e9-bb8c-c0956fae3581",
                                                "text": "Algier ist die Hauptstadt von Algerien."
                                            },
                                            {
                                                "example_id": "3c3a224e-41b3-4fe4-87a7-83e90122f7b9",
                                                "sense_id": "504283fc-e75d-36e9-bb8c-c0956fae3581",
                                                "text": "„Algerien wird im Nordteil, dem eigentlichen Lebensraum des Landes, vom Atlasgebirge, im weitaus größeren Südteil von der Wüste Sahara eingenommen.“"
                                            },
                                            {
                                                "example_id": "366ab7cc-ba5d-46dd-ac85-00d11d308064",
                                                "sense_id": "504283fc-e75d-36e9-bb8c-c0956fae3581",
                                                "text": "„Ich war so aufgeregt darüber, dass wir endlich nach Algerien einreisen durften, dass ich Jacques' unkontrollierten Fahrstil erst gar nicht bemerkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbb3a175-d653-4633-92ee-586e858cb5a3",
                        "source_entry_id": "3a1593ad-5e7b-326c-a967-e03e5bf4d002",
