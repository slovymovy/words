                    {
                        "sense_id": "83cf832d-beec-3df8-9f58-fe2324c82ef2",
                        "entry_id": "d447f1cc-2d5e-3692-9757-630c5926558f",
                        "glosses": [
                            "grote, niet-aardachtige planeet die grotendeels of volledig bestaat uit een atmosfeer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "428217bb-cc88-432d-a706-f93b6729b13b",
                                "sense_id": "83cf832d-beec-3df8-9f58-fe2324c82ef2",
                                "text": "Op het beeldmateriaal is een deel van Jupiter te zien en drie van zijn vier grootste manen, te weten: Io, Europa en Ganymedes. In augustus komt de sonde dichterbij de gasreus om betere foto's te kunnen schieten."
                            }
                        ]
                    },
                    {
                        "sense_id": "38bf29d3-c146-3377-93bc-3d3217c5360c",
                        "entry_id": "d447f1cc-2d5e-3692-9757-630c5926558f",
                        "glosses": [
                            "groot bedrijf dat (aardgas)gas produceert en verkoopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8819a1d6-95d8-4d9e-8603-21c13e77a78d",
                                "sense_id": "38bf29d3-c146-3377-93bc-3d3217c5360c",
                                "text": "Olie- en gasreus Shell heeft Canadese midstream- en upstream aardgasactiviteiten van de hand gedaan. Koper is Pieridae Energy dat 190 miljoen Canadese dollar (127 miljoen euro) betaalt voor de onderdelen in het zuiden van Alberta."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "619ef959-f269-4702-8fcc-d30bc25bbdb2",
                        "source_entry_id": "d447f1cc-2d5e-3692-9757-630c5926558f",
                        "source_sense_id": "83cf832d-beec-3df8-9f58-fe2324c82ef2",
                        "source_sense_description": "grote planeet die grotendeels of volledig bestaat uit een atmosfeer",
                        "target_lang_word": "gas giant",
