                    "sense_id": "e92b4dba-f94f-3a50-a873-946d1032e2f8",
                    "sense_definition": "The sound, quality, or symptom of breathing with an audible whistling or rattling sound.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor listened closely to the severe <w>wheezing</w> in the child's chest.",
                            "target_lang_translations": {
                                "de": "Der Arzt hörte genau auf das schwere <w>Giemen</w> in der Brust des Kindes."
                            }
                        },
                        {
                            "text": "Her persistent <w>wheezing</w> subsided after she used her prescribed inhaler.",
                            "target_lang_translations": {
                                "de": "Ihr anhaltendes <w>Pfeifen</w> ließ nach, nachdem sie ihr verschriebenes Inhaliergerät benutzt hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "stridor",
                        "wheeze"
                    ],
                    "common_phrases": [
