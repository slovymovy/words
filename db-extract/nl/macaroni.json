                "translations": [
                    {
                        "translation_id": "444b18d1-cf2d-494a-9dab-d39422cd9e27",
                        "source_entry_id": "211a462b-120e-3ede-bd64-c18d938a052b",
                        "source_sense_id": "15788991-3edd-3431-b7e4-d68ace7e2be2",
                        "source_sense_description": "gerecht op basis van gebogen pijpjes van deeg",
                        "target_lang_word": "macaroni",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macaroni",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce7ec32e-020b-305f-8db3-7590457b1d95",
                                        "entry_id": "e3d7e74d-d6cc-3fe2-8318-2280c06d8ea8",
                                        "glosses": [
                                            "A type of pasta in the form of short tubes, typically boiled and served in soup, with a sauce, or in melted cheese; a dish of this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30af8869-0ffa-4204-a930-e6cfc21e0642",
                                                "sense_id": "ce7ec32e-020b-305f-8db3-7590457b1d95",
                                                "text": "Take half a pound of small pipe-macaroni."
                                            },
                                            {
                                                "example_id": "b5480e98-5a80-4bd6-9eb9-9a56a441c5d8",
                                                "sense_id": "ce7ec32e-020b-305f-8db3-7590457b1d95",
                                                "text": "\"I can recommend this macaroni, for it is my favourite dish: I am very national. You will not take any? Ah, young ladies are, or ought to be, light eaters. Your ladyship will, I trust, set your fair companion an example.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a151fa3-6896-3ada-8042-035f5d46dd66",
                                        "entry_id": "e3d7e74d-d6cc-3fe2-8318-2280c06d8ea8",
                                        "glosses": [
                                            "Pasta, particularly thicker noodles, spaghetti."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcaa5f75-ad2d-4990-9c91-faf77f1fbd82",
                                                "sense_id": "7a151fa3-6896-3ada-8042-035f5d46dd66",
                                                "text": "Paste made into strings like pack-thread or thongs of whit-leather (which if greater they call Macaroni, if lesser Vermicelli) they cut in pieces and put in their pots as we do oat-meal to make their menestra or broth of."
                                            },
                                            {
                                                "example_id": "852bcac3-5997-4aad-8c12-2a31662f2a09",
                                                "sense_id": "7a151fa3-6896-3ada-8042-035f5d46dd66",
                                                "text": "MACARONI... is a preparation of wheat originally peculiar to Italy, in which country it is an article of food of national importance. The same substance in different forms is also known as vermicelli, pasta or Italian pastes, taglioni, fanti, &c."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fa915cf-658e-3643-a273-bc0bc040e6be",
                                        "entry_id": "e3d7e74d-d6cc-3fe2-8318-2280c06d8ea8",
                                        "glosses": [
                                            "Synonym of gnocchi (“Italian dumpling made of potato or semolina”)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3faec71-dda0-4a02-bc39-e02986f5ead3",
                                                "sense_id": "5fa915cf-658e-3643-a273-bc0bc040e6be",
                                                "text": "Maccaróni, a kind of meat made of round peeces of paste, boyled in water and put into a dish with butter, spice and grated-cheese vpon them."
                                            },
                                            {
                                                "example_id": "b8a190a2-8b4f-47e6-bdfc-d5d3fabcba55",
                                                "sense_id": "5fa915cf-658e-3643-a273-bc0bc040e6be",
                                                "text": "He doth learne to make ſtrange ſauces, to eat ænchouies, maccaroni, bouoli, fagioli, and cauiare, becauſe hee loues ’hem; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9455049c-be57-3358-982a-b85023549e36",
                                        "entry_id": "e3d7e74d-d6cc-3fe2-8318-2280c06d8ea8",
                                        "glosses": [
                                            "A dandy or fop, particularly in the 18th century a young Englishman who had travelled in Europe and subsequently dressed and spoke in an ostentatiously affected Continental manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4108d03b-7be2-4307-924a-de52013dbcb8",
                                                "sense_id": "9455049c-be57-3358-982a-b85023549e36",
                                                "text": "... the Maccaroni Club (which is composed of all the travelled young men who wear long curls and spying-glasses) ..."
                                            },
                                            {
                                                "example_id": "8546cde0-d408-43b4-b787-963c763d95a0",
                                                "sense_id": "9455049c-be57-3358-982a-b85023549e36",
                                                "text": "Lady Falkener's daughter is to be married to a young rich Mr. Crewe, a Macarone..."
                                            },
                                            {
                                                "example_id": "7e1dda5e-855c-493e-b813-2677d1e201c9",
                                                "sense_id": "9455049c-be57-3358-982a-b85023549e36",
                                                "text": "There is indeed a kind of animal, neither male nor female, a thing of the neuter gender, lately started up amongst us. It is called a Macaroni. It talks without meaning, it smiles without pleasantry, it eats without appetite, it rides without exercise, it wenches without passion."
                                            },
                                            {
                                                "example_id": "f254d2c0-017b-4140-82c0-5dd796ae3645",
                                                "sense_id": "9455049c-be57-3358-982a-b85023549e36",
                                                "text": "I wanted you to be a man of spirit; your ambition was to appear a first-rate Macaroni; you are returned fully qualified, and determined, I see, to shew the world what a contemptible creature an English-man dwindles into, when he adopts the follies and vices of other nations."
                                            },
                                            {
                                                "example_id": "b131ddce-56cc-4c5c-8962-6e4da6b2c4cb",
                                                "sense_id": "9455049c-be57-3358-982a-b85023549e36",
                                                "text": "'Sure never were seen two such beautiful Ponies;\nOther Horses are Clowns—and these macaronies"
                                            },
                                            {
                                                "example_id": "6d21cad0-f46d-4833-a557-3b74c3be7ea1",
                                                "sense_id": "9455049c-be57-3358-982a-b85023549e36",
                                                "text": "Delicate lace ruffles fell over the lean yellow hands that were so overladen with rings. He had been a macaroni of the eighteenth century, and the friend, in his youth, of Lord Ferrars."
                                            },
                                            {
                                                "example_id": "3adb6183-a982-4036-82e1-3123f73bc21d",
                                                "sense_id": "9455049c-be57-3358-982a-b85023549e36",
                                                "text": "A small, noisy party of Fops, Macaronis, or Lunarians,—it is difficult quite to distinguish which,—has been working its way up the street."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49c7bfe6-9f54-3d24-90ec-2af2ddea03ea",
                                        "entry_id": "e3d7e74d-d6cc-3fe2-8318-2280c06d8ea8",
                                        "glosses": [
                                            "A 19th-century quarter-silver dollar coin, typically a full 2-real coin or a quarter clipping of an 8-real coin from Central or South America."
                                        ],
                                        "tags": [
                                            "Caribbean",
                                            "countable",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7edcde8-876e-4f5e-9e6b-acfc7bd52208",
                                                "sense_id": "49c7bfe6-9f54-3d24-90ec-2af2ddea03ea",
                                                "text": "The silver coins are dollars (6s. 8d.), half dollars, and quarter dollars, or maccaronies as they are here popularly called."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "391fa0be-4094-3884-a009-dd17724d0378",
                                        "entry_id": "e3d7e74d-d6cc-3fe2-8318-2280c06d8ea8",
                                        "glosses": [
                                            "Ellipsis of macaroni penguin (Eudyptes chrysolophus)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fca88794-4bd3-4fbf-9f4a-9d457c0fe123",
                                                "sense_id": "391fa0be-4094-3884-a009-dd17724d0378",
                                                "text": "15 penguins were hatched and reared in the Edinburgh Zoo—seven kings, four gentoos, three maccaronis, and one ringed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d49108ab-0a2f-3c9f-8a74-4a249cce2d94",
                                        "entry_id": "e3d7e74d-d6cc-3fe2-8318-2280c06d8ea8",
                                        "glosses": [
                                            "Synonym of Italian (“a person from Italy or of Italian ethnicity”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "ethnic",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1597fde5-6946-413f-8e18-5d9af5c977ca",
                                                "sense_id": "d49108ab-0a2f-3c9f-8a74-4a249cce2d94",
                                                "text": "Surely I shall always be able, go where I will, among frogs or maccaronis, to procure sucre noir, or inchiostro nero."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94572fea-04d3-38c5-80af-0e0dc7887790",
                                        "entry_id": "e3d7e74d-d6cc-3fe2-8318-2280c06d8ea8",
                                        "glosses": [
                                            "Ellipsis of macaroni tool."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12f37812-0ca7-4bd9-8655-c85c6f596cdc",
                                                "sense_id": "94572fea-04d3-38c5-80af-0e0dc7887790",
                                                "text": "Now take the maccaroni and cut away the wood on either side of the vein..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eae2af7-c259-342a-a1ef-9f82fe06d63d",
                                        "entry_id": "e3d7e74d-d6cc-3fe2-8318-2280c06d8ea8",
                                        "glosses": [
                                            "Synonym of lizard canary."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b5a2674-d990-4fcb-804e-b280f70cf82b",
                                                "sense_id": "2eae2af7-c259-342a-a1ef-9f82fe06d63d",
                                                "text": "Lizards are known among Scotchmen as ‘macaronies’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a163326f-0fba-341c-b91e-bc8f5c9c36c3",
                                        "entry_id": "e3d7e74d-d6cc-3fe2-8318-2280c06d8ea8",
                                        "glosses": [
                                            "A mix of languages in macaronic verse."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b0bf6b5-7859-4abc-8f7a-d56aefdb6b2e",
                                                "sense_id": "a163326f-0fba-341c-b91e-bc8f5c9c36c3",
                                                "text": "... political songs in Latin or in a maccaroni of Latin and English ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9575be69-399f-3560-b18f-b8515d2a4fb9",
                                        "entry_id": "e3d7e74d-d6cc-3fe2-8318-2280c06d8ea8",
                                        "glosses": [
                                            "Nonsense; meaningless talk."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0770a6b4-988f-44ee-9818-c2ca4d0c292d",
                                                "sense_id": "9575be69-399f-3560-b18f-b8515d2a4fb9",
                                                "text": "Yes. Jam, macaroni, cockadoodle. We're plain people out hereaways, not mantle ornaments."
                                            }
                                        ]
                                    }
                                ]
                            },
