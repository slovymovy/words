                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09c4c3d8-19ca-4360-ab15-c869bd152e74",
                        "source_entry_id": "c0922544-f988-36a8-9b92-f48128909e44",
                        "source_sense_id": "fb813fff-3e13-394e-a123-ab753e8920b8",
                        "source_sense_description": "bildungssprachlich: Eigenschaft (in einem bestimmten Zusammenhang) wichtig, bedeutsam zu sein",
                        "target_lang_word": "pertinence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pertinence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c2e33f7-68ae-384e-8322-50b57d916e51",
                                        "entry_id": "ded77db7-26e3-3045-bf09-0a223222d0ab",
                                        "glosses": [
                                            "Qualité de ce qui est pertinent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d5a10b0-a034-4861-a8b4-86e35953fe09",
                                                "sense_id": "8c2e33f7-68ae-384e-8322-50b57d916e51",
                                                "text": "En cas de doute sur la pertinence de l'exorcisme, mieux vaut alors faire appel aux chérifs détenteurs d'une baraka reconnue pour sa puissance thérapeutique."
                                            },
                                            {
                                                "example_id": "7ff7ed1a-117a-4066-b121-56a5b4181a5c",
                                                "sense_id": "8c2e33f7-68ae-384e-8322-50b57d916e51",
                                                "text": "Chacun de nous put acquérir pour une modique somme une K7 contant le reportage et vingt minutes de rush qu'il eut la gentillesse de rendre intelligentes, ce qui dut lui donner beaucoup de mal, car, honnêtement, nos déplacements rugbystiques n'ont jamais vraiment brillé ni par leur originalité, ni par la pertinence de nos pensées."
                                            },
                                            {
                                                "example_id": "1c01e0e4-a66f-4146-b702-3532c102fc8e",
                                                "sense_id": "8c2e33f7-68ae-384e-8322-50b57d916e51",
                                                "text": "L'origine onomatopéique d'un lexème est une question diachronique, sans pertinence en tant que telle pour la sémantique de la parole : ainsi, il n'est pas fondamental pour nous de trancher parmi les nombreux cas qui peuvent faire débats (quid de gong, flaque, grogner, grommeler, siffler, claquer, vrombir... ?)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de10499b-f474-4312-8941-2b871d4f2397",
                        "source_entry_id": "c0922544-f988-36a8-9b92-f48128909e44",
                        "source_sense_id": "fb813fff-3e13-394e-a123-ab753e8920b8",
                        "source_sense_description": "bildungssprachlich: Eigenschaft (in einem bestimmten Zusammenhang) wichtig, bedeutsam zu sein",
                        "target_lang_word": "importance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "importance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                        "entry_id": "6697d7cd-51d8-3a22-8eb9-35b052d20bbe",
                                        "glosses": [
                                            "Ce qui fait qu’une chose est d’un grand intérêt, est considérable par elle-même, ou par les circonstances qui l’accompagnent, ou par les suites qu’elle peut avoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ec89a5-6978-4702-8610-0eb28c279b30",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Le soldat des guerres de la Liberté attachait une importance presque supersti­tieuse à l’accomplissement des moindres consignes. De là résulte qu'il n'éprouvait aucune pitié pour les généraux ou les fonctionnaires qu'il voyait guillotiner après quelque défaite, sous l'inculpation de manquement à leur devoir ; […]."
                                            },
                                            {
                                                "example_id": "df590c33-9cdc-4c3c-8ce9-898c2d6e25ae",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Le proviseur adjoint l'écoute poliment et acquiesce à ses suggestions, le valorise et lui donne de l’importance. Je ne sais pas s'il est sincère."
                                            },
                                            {
                                                "example_id": "e3234a8c-305f-4e4e-9afb-7d6d524d4dc1",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "En toutes choses, il est d’une grande importance de bien commencer."
                                            },
                                            {
                                                "example_id": "c06d4a81-e537-4cc1-b9a7-bec914fad1e5",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Mettre, attacher de l’importance à une chose, La considérer comme ayant beaucoup d’importance."
                                            },
                                            {
                                                "example_id": "25fa5f74-a8b6-41c1-b63b-c68520904943",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Il attache de l’importance aux plus petites choses."
                                            },
                                            {
                                                "example_id": "f7534012-1314-4075-8e61-1159382feb76",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Je n’attache pas d’importance à ma tenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                                        "entry_id": "6697d7cd-51d8-3a22-8eb9-35b052d20bbe",
                                        "glosses": [
                                            "Caractère de ce qui est considérable en nombre, en quantité, en volume, en dimension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813ba44c-a468-4281-945e-74c701100853",
                                                "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                                                "text": "Les mauvaises herbes sont pour l'agriculture de tous les pays un fléau dont il est malaisé de chiffrer l’importance."
                                            },
                                            {
                                                "example_id": "311e751e-8136-4933-9516-39780f60153e",
                                                "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                                                "text": "Les seuls marchés qui aient conservé quelque importance sont ceux de Formerie, de Gournay et de Songeons. Le premier dépasse de beaucoup tous les autres, même celui de Gournay."
                                            },
                                            {
                                                "example_id": "30bd58cf-f4e2-4d48-bd49-cc4b472553c1",
                                                "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                                                "text": "L’importance de la diffusion à Paris explique en partie la faiblesse des invendus, qui atteignent environ 20-22 % des exemplaires fournis aux NMPP, et par conséquent la facilité des réglages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdb1fad2-fd86-33b5-b716-60ced935fa59",
                                        "entry_id": "6697d7cd-51d8-3a22-8eb9-35b052d20bbe",
                                        "glosses": [
                                            "Autorité, crédit, influence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b618ffd-724f-4b8b-b040-269f8509888d",
                                                "sense_id": "cdb1fad2-fd86-33b5-b716-60ced935fa59",
                                                "text": "Ils pensent en effet que le luxe vestimentaire est proportionnel à l'importance et à la renommée d'un individu : […]."
                                            },
                                            {
                                                "example_id": "d396d107-54ec-4c5b-8dee-91a2166d4387",
                                                "sense_id": "cdb1fad2-fd86-33b5-b716-60ced935fa59",
                                                "text": "Cette place lui donne beaucoup d’importance dans le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67654ab0-a551-3570-8287-7e2c916ba829",
                                        "entry_id": "6697d7cd-51d8-3a22-8eb9-35b052d20bbe",
                                        "glosses": [
                                            "Caractère de ceux qui montrent de l’orgueil, de la vanité et veulent paraître plus considérables qu’ils ne le sont réellement."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0b8be5-bbbe-464f-9349-153ad65fda25",
                                                "sense_id": "67654ab0-a551-3570-8287-7e2c916ba829",
                                                "text": "Prendre un ton d’importance."
                                            },
                                            {
                                                "example_id": "a6a00c1b-d426-4262-8f7a-5000f5e2cb1f",
                                                "sense_id": "67654ab0-a551-3570-8287-7e2c916ba829",
                                                "text": "Il se donne des airs d’importance qui choquent tout le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
