    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "09e4f03a-de45-32f8-9cab-5ae466348e03",
                    "sense_definition": "Having sufficient skill, knowledge, ability, or qualifications to do something well.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>competent</w> skier and an expert snowboarder. ",
                            "target_lang_translations": {
                                "ru": "Он <w>умелый</w> лыжник и опытный сноубордист.",
                                "tr": "O <w>yetenekli</w> bir kayakçı ve uzman bir snowboardcudur."
                            }
                        },
                        {
                            "text": "The company is looking for a <w>competent</w> professional to manage the new project.",
                            "target_lang_translations": {
                                "ru": "Компания ищет <w>компетентного</w> специалиста для управления новым проектом.",
                                "tr": "Şirket, yeni projeyi yönetmek için <w>yetkin</w> bir profesyonel arıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "capable",
                        "skilled",
                        "proficient",
                        "able"
                    ],
                    "antonyms": [
                        "incompetent"
                    ],
                    "common_phrases": [
                        "highly competent",
                        "competent professional",
                        "competent authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий достаточными навыками, знаниями или квалификацией для качественного выполнения работы.",
                        "tr": "Bir işi iyi yapmak için yeterli beceriye, bilgiye, yeteneğe veya niteliklere sahip olma durumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компетентный",
                                "target_lang_sense_clarification": "обладающий знаниями и опытом"
                            },
                            {
                                "target_lang_word": "квалифицированный",
                                "target_lang_sense_clarification": "имеющий профессиональную подготовку"
                            },
                            {
                                "target_lang_word": "умелый",
                                "target_lang_sense_clarification": "хорошо владеющий навыком"
                            }
                        ],
                        "tr": [
