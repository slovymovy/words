                "senses": [
                    {
                        "sense_id": "fb3d775b-02f7-3b88-b4d8-7d47c95be72b",
                        "entry_id": "8a82d045-3b7f-316d-8818-b4ec307667b7",
                        "glosses": [
                            "weibliche Person, die eine berufliche Anstellung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1830741f-a451-4205-8b51-721c3013331f",
                                "sense_id": "fb3d775b-02f7-3b88-b4d8-7d47c95be72b",
                                "text": "Erika ist mit 87 Jahren unsere älteste Arbeitnehmerin."
                            },
                            {
                                "example_id": "c1aca845-1211-4f67-8851-26fc6735c8fd",
                                "sense_id": "fb3d775b-02f7-3b88-b4d8-7d47c95be72b",
                                "text": "Die Arbeitnehmerinnen des Betriebes beklagten sich über den schlechten Zustand der Damentoilette."
                            },
                            {
                                "example_id": "f5e08f9d-8bf8-4533-9bc9-50a73b15da1a",
                                "sense_id": "fb3d775b-02f7-3b88-b4d8-7d47c95be72b",
                                "text": "Eine insgesamt etwa dreieinhalb Monate in einem Betriebe beschäftigte Arbeitnehmerin weigerte sich trotz wiederholter Aufforderungen des Betriebsratsvorsitzenden, sich gewerkschaftlich zu organisieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd7f192c-2516-43e9-8a2a-5674c3a5e095",
                        "source_entry_id": "8a82d045-3b7f-316d-8818-b4ec307667b7",
                        "source_sense_id": "fb3d775b-02f7-3b88-b4d8-7d47c95be72b",
                        "source_sense_description": "weibliche Person, die eine berufliche Anstellung hat",
                        "target_lang_word": "employee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "employee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a9fa2bd-77ad-388a-beea-16ca7ca64cf3",
                                        "entry_id": "b463ade8-0224-30a8-a80e-753fe0036991",
                                        "glosses": [
                                            "A person who provides labor to a company or another person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953aab94-605b-4798-9965-e6470b33a466",
                                                "sense_id": "2a9fa2bd-77ad-388a-beea-16ca7ca64cf3",
                                                "text": "One way to encourage your employees to work harder is by giving them incentives."
                                            },
                                            {
                                                "example_id": "8401a7de-df37-4940-876c-4fa3ecf70a42",
                                                "sense_id": "2a9fa2bd-77ad-388a-beea-16ca7ca64cf3",
                                                "text": "No one, however, would have anything to do with him, as Mr. Keeson's orders in those respects were very strict ; he had often threatened any one of his employés with instant dismissal if he found him in company with one of these touts."
                                            },
                                            {
                                                "example_id": "7ef149b2-b638-4ac6-ba2d-583911ba2b24",
                                                "sense_id": "2a9fa2bd-77ad-388a-beea-16ca7ca64cf3",
                                                "text": "The concepts of emotional intelligence (EI), self-worth, authenticity and employee meditation rooms might conjure up thoughts of new age healing centers. […] Now, Nielsen is sending all hotel employees through EI training to help them become more open and confident, understand their own limitations and fears, and to boost their self-worth and comfort in dealing with other people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
