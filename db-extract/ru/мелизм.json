                    },
                    {
                        "translation_id": "95333ed5-133b-4f7d-9124-60b4c311ff6f",
                        "source_entry_id": "98858641-9341-3cb6-8d9e-2fc4d6c4cc86",
                        "source_sense_id": "8d975349-4d34-31fe-833c-601a4219e6f2",
                        "target_lang_word": "ornement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "beb14d1c-a9b1-3180-9755-2a8a14ba7c7c",
                                        "entry_id": "584c77e5-c154-347d-86fd-8951772e34ad",
                                        "glosses": [
                                            "Ce qui sert à orner, à embellir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeee01a9-15c3-4270-9624-9ff09779cced",
                                                "sense_id": "beb14d1c-a9b1-3180-9755-2a8a14ba7c7c",
                                                "text": "L’Inde autrefois nous donna l’anémone,\nDe nos jardins ornement printanier."
                                            },
                                            {
                                                "example_id": "beef7e4c-6c87-455b-bd8e-23ec77124585",
                                                "sense_id": "beb14d1c-a9b1-3180-9755-2a8a14ba7c7c",
                                                "text": "L’armoire en noyer, le lit à colonnes et à bonnes-grâces, ornements de la chambre à coucher, furent sans doute le fruit de quelque risette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22c758b1-4c93-3c55-9487-6e7e844cb4cb",
                                        "entry_id": "584c77e5-c154-347d-86fd-8951772e34ad",
                                        "glosses": [
                                            "Parure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "920c05a7-9f15-41d5-a24c-ec8a9ba9afe3",
                                                "sense_id": "22c758b1-4c93-3c55-9487-6e7e844cb4cb",
                                                "text": "[…], M. B. sortit de sa tente coiffé d'un superbe bicorne à plumes blanches. Il y avait là, paraît-il, une infraction flagrante au protocole, qui réserve cet ornement aux seuls chefs de mission."
                                            },
                                            {
                                                "example_id": "766066dd-dcd6-4b0b-9635-7fe8aba21c49",
                                                "sense_id": "22c758b1-4c93-3c55-9487-6e7e844cb4cb",
                                                "text": "Cette femme était parée de ses plus beaux ornements. — Une élégance sobre, qui se passe d’ornements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be8eae62-afc9-393e-89d7-6641cee05474",
                                        "entry_id": "584c77e5-c154-347d-86fd-8951772e34ad",
                                        "glosses": [
                                            "Figure, forme de style dont on se sert pour embellir le discours."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69e68c96-4de2-452e-bd5e-5ee9ace90f05",
                                                "sense_id": "be8eae62-afc9-393e-89d7-6641cee05474",
                                                "text": "La simplicité tient lieu d’ornement."
                                            },
                                            {
                                                "example_id": "d45c6f57-139f-46c2-9886-8f90c1c9dec4",
                                                "sense_id": "be8eae62-afc9-393e-89d7-6641cee05474",
                                                "text": "Les ornements du style."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b9e3352-3db5-3d45-998d-3f9275f67c77",
                                        "entry_id": "584c77e5-c154-347d-86fd-8951772e34ad",
                                        "glosses": [
                                            "Figure de fantaisie, comme fleuron, rosace, feston, que différents arts ou métiers emploient comme embellissements."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eedb69a8-c631-4770-926e-792d38e128e4",
                                                "sense_id": "2b9e3352-3db5-3d45-998d-3f9275f67c77",
                                                "text": "Elle honnit le carton-pâte et l'ornement en staff, l'orviétan des charlatans littéraires, le tarabiscotage des épithètes, qui sont trop souvent l'essentiel d'un livre consacré aux splendeurs factices d\"un climat africain."
                                            },
                                            {
                                                "example_id": "85605e4a-f96b-4493-86cd-832130e13b45",
                                                "sense_id": "2b9e3352-3db5-3d45-998d-3f9275f67c77",
                                                "text": "La peinture, la sculpture d’ornement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e0b955f-4ab7-3317-add9-52d397292d17",
                                        "entry_id": "584c77e5-c154-347d-86fd-8951772e34ad",
                                        "glosses": [
                                            "Sculpture, moulure, qui sert à décorer les différentes parties d’un bâtiment ou d’une boiserie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d64fa52c-6b53-46ae-8a10-64726be8aed1",
                                                "sense_id": "2e0b955f-4ab7-3317-add9-52d397292d17",
                                                "text": "À première vue, on attribuerait au gothique flamboyant cette maîtresse œuvre où l'on découvre bientôt les volutes, les ornements, toutes les riches imaginations de la Renaissance."
                                            },
                                            {
                                                "example_id": "fbaa79d1-34b8-4180-be35-27273fecbcea",
                                                "sense_id": "2e0b955f-4ab7-3317-add9-52d397292d17",
                                                "text": "Ornement courant, décoration qui se continue, qui se répète dans une frise ou une moulure. Les entrelacs, les rinceaux, les oves sont des ornements courants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "921f47a8-647e-3af9-acb5-e4fd134db537",
                                        "entry_id": "584c77e5-c154-347d-86fd-8951772e34ad",
                                        "glosses": [
                                            "Peintures faites, dans une galerie, pour servir d’accompagnement au sujet principal et qui n’en font point partie."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d619df02-42ea-4b59-9b4d-5c7896227dd0",
                                                "sense_id": "921f47a8-647e-3af9-acb5-e4fd134db537",
                                                "text": "Un peintre d’ornements."
                                            },
                                            {
                                                "example_id": "a4125669-39d0-45bf-a14d-23a9ca6bca5d",
                                                "sense_id": "921f47a8-647e-3af9-acb5-e4fd134db537",
                                                "text": "Un pigeon d’agrément, d’ornement ou de fantaisie.  ^([2])"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "173f1658-5818-3ce8-81e5-72dee776fdd6",
                                        "entry_id": "584c77e5-c154-347d-86fd-8951772e34ad",
                                        "glosses": [
                                            "Ce qui sert à faire honneur, à donner du lustre à un pays, à un siècle, à une famille, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca010dca-adab-410b-a8c0-c73e9d59e019",
                                                "sense_id": "173f1658-5818-3ce8-81e5-72dee776fdd6",
                                                "text": "Sans se trop charger la conscience, les juges pouvaient le rendre à la société, dont il devait faire l’ornement (style d’avocat). Mais les juges n’ont guère de ces considérations poétiques et élevées : ils l’ont condamné à mort à l’unanimité."
                                            },
                                            {
                                                "example_id": "6c828fe3-a7d7-492c-8f08-9c3613e45e1b",
                                                "sense_id": "173f1658-5818-3ce8-81e5-72dee776fdd6",
                                                "text": "Il est l’ornement de son pays, de sa nation, de son siècle, de sa famille."
                                            },
                                            {
                                                "example_id": "3de8b47c-1687-4fdd-9430-71248814a1ea",
                                                "sense_id": "173f1658-5818-3ce8-81e5-72dee776fdd6",
                                                "text": "La modestie est le plus bel ornement du mérite."
                                            },
                                            {
                                                "example_id": "0a3341ec-56ed-4e7a-ab37-44adb7a45a75",
                                                "sense_id": "173f1658-5818-3ce8-81e5-72dee776fdd6",
                                                "text": "― Douleur naturelle, dit Guise… Une fille si charmante !\n ― Elle eût été l’ornement de votre cour, sire ! fit Condé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce3cd5e-d3f6-3cac-be30-2745a451336a",
                                        "entry_id": "584c77e5-c154-347d-86fd-8951772e34ad",
                                        "glosses": [
                                            "Pièce d’une même couleur ou d’une même parure, faisant un assortiment entier, dans lequel les habits sacerdotaux et les devants d’autel sont compris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d17ed9-0e94-49e7-82d5-f1c04e38791d",
                                                "sense_id": "bce3cd5e-d3f6-3cac-be30-2745a451336a",
                                                "text": "Un ornement blanc, rouge."
                                            },
                                            {
                                                "example_id": "d35fa1f4-420a-4b9a-9577-793e87c9324c",
                                                "sense_id": "bce3cd5e-d3f6-3cac-be30-2745a451336a",
                                                "text": "Cette sacristie renferme de très beaux ornements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bf7a215-1c7b-386b-a5a6-e92523610d83",
                                        "entry_id": "584c77e5-c154-347d-86fd-8951772e34ad",
                                        "glosses": [
                                            "Ensemble des habits sacerdotaux, comme la chasuble, l’étole, etc., dont les prêtres se servent pour les offices dans le culte catholique."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce382d41-e118-4f60-99fc-cb2bb3521ea5",
                                                "sense_id": "8bf7a215-1c7b-386b-a5a6-e92523610d83",
                                                "text": "Dans le tohu-bohu de la sacristie m’échoyai l'honneur d'aider le prêtre à se vêtir des ornements. Je présentais l'amict, l'aube, l'étole. Je veillais à la pose de la chasuble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77843150-d888-3867-b759-1c6277b10c1b",
                                        "entry_id": "584c77e5-c154-347d-86fd-8951772e34ad",
                                        "glosses": [
                                            "Notes secondaires utilisées pour embellir une ligne mélodique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ad77961-a94e-4607-9dd0-a75e6585415b",
                        "source_entry_id": "98858641-9341-3cb6-8d9e-2fc4d6c4cc86",
                        "source_sense_id": "8d975349-4d34-31fe-833c-601a4219e6f2",
                        "target_lang_word": "agréments",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agréments",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bf5b3e9-5679-30d3-8f69-896fb21cf09c",
                                        "entry_id": "7ddf707e-7198-3477-8b6d-8137a5c55f3a",
                                        "glosses": [
                                            "Pluriel de agrément."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b145d9c-2177-4ad5-be6f-5f6628df92cf",
                                                "sense_id": "7bf5b3e9-5679-30d3-8f69-896fb21cf09c",
                                                "text": "Émile Blondet nous a fait une peinture des agréments d’une femme d’aujourd'hui ; mais au besoin cette femme qui minaude, qui parade, qui gazouille les idées de messieurs tels et tels, serait héroïque !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
