                        "source_sense_id": "7f2ccf66-26dc-3393-bd8e-a30b1a606f49",
                        "source_sense_description": "umgangssprachlich: eine sehr große und als unangenehm empfundene Hitze",
                        "target_lang_word": "пекло",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пекло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0e707cfc-c288-334a-af81-522ff02322f2",
                                        "entry_id": "0303db43-af43-30ff-9329-68a1e8de1c89",
                                        "glosses": [
                                            "место, где сосредоточен сильный огонь, пламя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a9e6a6c-8d5a-4e6f-8f77-61f47299b389",
                                                "sense_id": "0e707cfc-c288-334a-af81-522ff02322f2",
                                                "text": "Но на настоящем пожаре этим ребятам придётся лезть и не в такое пекло."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85063a0e-aa0e-3ea4-83ff-d8f033eeb797",
                                        "entry_id": "0303db43-af43-30ff-9329-68a1e8de1c89",
                                        "glosses": [
                                            "неисч., разг. сильный зной, жар"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "801f632e-eba9-413f-a66c-c9227c0a6173",
                                                "sense_id": "85063a0e-aa0e-3ea4-83ff-d8f033eeb797",
                                                "text": "Оступились на спусках опенённые кони: ведь целый день, гонкою, вверх, вниз по камню, по пеклу, не кормя, не расседлывали…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1634f8cb-2611-3b54-a238-df3abc8fdd23",
                                        "entry_id": "0303db43-af43-30ff-9329-68a1e8de1c89",
                                        "glosses": [
                                            "неисч., перен., разг. ад; адский огонь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a40e8bf2-cde3-41ca-a2b8-21225fbaa599",
                                                "sense_id": "1634f8cb-2611-3b54-a238-df3abc8fdd23",
                                                "text": "Странствуя вдоль необъятной родины нашей, издали ты увидишь красной крови пятно, вставшее в темноцветную ночь; ты испуганно скажешь: «Не есть ли там местонахождение гееннского пекла?»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0720fe0-c17b-3e40-b1a5-6ce53929520a",
                                        "entry_id": "0303db43-af43-30ff-9329-68a1e8de1c89",
                                        "glosses": [
                                            "перен., разг. место, где происходит жаркий бой, где происходящее грозит опасностью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "412cf9f0-aa12-43cc-8ba9-10e60adca63b",
                                                "sense_id": "a0720fe0-c17b-3e40-b1a5-6ce53929520a",
                                                "text": "Откровенно признаться, стало жутко при мысли, что следующим потребуют в пекло наш полк."
                                            }
                                        ]
                                    }
                                ]
                            },
