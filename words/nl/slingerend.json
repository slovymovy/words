{
    "word_family": [
        "slingeren",
        "slinger",
        "slingering"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8480ce6a-20ed-36f6-9069-507097088eb4",
                    "sense_definition": "Niet recht vooruit bewegend of lopend, maar met veel bochten en kronkels.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie zette de <w>slingerende</w> auto aan de kant omdat de bestuurder dronken leek.",
                            "target_lang_translations": {
                                "pl": "Policja zatrzymała <w>jadący wężykiem</w> samochód, ponieważ kierowca wyglądał na pijanego."
                            }
                        },
                        {
                            "text": "We fietsten over een smalle, <w>slingerende</w> weg dwars door de groene heuvels.",
                            "target_lang_translations": {
                                "pl": "Jechaliśmy rowerami wąską, <w>krętą</w> drogą wprost przez zielone wzgórza."
                            }
                        }
                    ],
                    "synonyms": [
                        "bochtig",
                        "gekronkeld",
                        "waggelend"
                    ],
                    "antonyms": [
                        "kaarsrecht"
                    ],
                    "common_phrases": [
                        "slingerende weg",
                        "slingerende auto",
                        "slingerende beweging"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nieporuszający się lub niebiegnący prosto przed siebie, lecz z licznymi zakrętami, łukami i zygzakami."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kręty",
                                "target_lang_sense_clarification": "o drodze, rzece itp."
                            },
                            {
                                "target_lang_word": "zygzakujący",
                                "target_lang_sense_clarification": "o pojeździe, ruchu na boki"
                            },
                            {
                                "target_lang_word": "meandrujący",
                                "target_lang_sense_clarification": "wężowaty, falujący"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6525202e-984c-3cb1-b35f-ecd414385b06",
                    "sense_definition": "Onvoltooid deelwoord van <w>slingeren</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Al <w>slingerend</w> tussen de bomen probeerde de fietser zijn evenwicht te bewaren.",
                            "target_lang_translations": {
                                "pl": "<w>Lawirując</w> między drzewami, rowerzysta próbował utrzymać równowagę."
                            }
                        },
                        {
                            "text": "De rivier stroomt rustig <w>slingerend</w> door het uitgestrekte landschap.",
                            "target_lang_translations": {
                                "pl": "Rzeka płynie spokojnie, <w>wijąc się</w> przez rozległy krajobraz."
                            }
                        }
                    ],
                    "common_phrases": [
                        "al slingerend"
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów przysłówkowy współczesny od czasownika slingeren (kołysać się, wić się, zataczać się)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zataczając się",
                                "target_lang_sense_clarification": "o chwiejnym poruszaniu się"
                            },
                            {
                                "target_lang_word": "wijąc się",
                                "target_lang_sense_clarification": "o rzece lub drodze"
                            },
                            {
                                "target_lang_word": "lawirując",
                                "target_lang_sense_clarification": "zygzakując, omijając przeszkody"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}