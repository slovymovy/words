{
    "word_family": [
        "disgusting",
        "disgusted",
        "disgustingly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7f1f533-596c-3c76-b3cd-57e066e5eafc",
                    "sense_definition": "An intense feeling of strong dislike, revulsion, or loathing caused by something unpleasant or offensive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked at the spoiled milk with an expression of deep <w>disgust</w>. ",
                            "target_lang_translations": {
                                "ru": "Она посмотрела на испорченное молоко с выражением глубокого <w>отвращения</w>."
                            }
                        },
                        {
                            "text": "With an air of <w>disgust</w>, she stormed out of the room after the argument.",
                            "target_lang_translations": {
                                "ru": "С видом <w>отвращения</w> она выбежала из комнаты после ссоры."
                            }
                        }
                    ],
                    "synonyms": [
                        "abhorrence",
                        "aversion",
                        "distaste",
                        "loathing",
                        "repugnance"
                    ],
                    "antonyms": [
                        "attraction",
                        "allure"
                    ],
                    "common_phrases": [
                        "air of disgust",
                        "deep disgust",
                        "in disgust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное чувство неприязни, отвращения или омерзения, вызванное чем-то неприятным или оскорбительным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвращение",
                                "target_lang_sense_clarification": "чувство сильной неприязни"
                            },
                            {
                                "target_lang_word": "омерзение",
                                "target_lang_sense_clarification": "крайняя степень отвращения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "954a3684-0fee-3374-86e3-5412d73f36fc",
                    "sense_definition": "To cause someone to feel intense dislike, strong revulsion, or indignation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>disgusts</w> me to see people treating animals so poorly.",
                            "target_lang_translations": {
                                "ru": "У меня <w>вызывает отвращение</w>, когда люди так плохо относятся к животным."
                            }
                        },
                        {
                            "text": "The terrible smell of garbage completely <w>disgusts</w> everyone who walks past.",
                            "target_lang_translations": {
                                "ru": "Ужасный запах мусора <w>вызывает отвращение</w> у каждого, кто проходит мимо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "disgusts me"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо сильную неприязнь, отвращение или негодование."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать отвращение",
                                "target_lang_sense_clarification": "быть неприятным, тошнотворным"
                            },
                            {
                                "target_lang_word": "быть противным",
                                "target_lang_sense_clarification": "вызывать неприязнь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}