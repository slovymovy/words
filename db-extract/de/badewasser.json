                "senses": [
                    {
                        "sense_id": "d5ea333a-495c-39fb-b26c-039533eca400",
                        "entry_id": "708bba05-25f9-35b6-88d4-33db78fee294",
                        "glosses": [
                            "Wasser, das zum Baden in einer Badewanne verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5dccc3b-af4b-4cee-8b2d-a9928302b3fd",
                                "sense_id": "d5ea333a-495c-39fb-b26c-039533eca400",
                                "text": "Sie ließ das Badewasser ein."
                            },
                            {
                                "example_id": "eb6db878-acbe-430a-9b5a-e2d8d49c4b98",
                                "sense_id": "d5ea333a-495c-39fb-b26c-039533eca400",
                                "text": "Er beschwerte sich, dass das Badewasser zu kalt sei."
                            },
                            {
                                "example_id": "e141ec16-28be-4548-8db6-89650bb820dc",
                                "sense_id": "d5ea333a-495c-39fb-b26c-039533eca400",
                                "text": "„Während das Badewasser einlief, fiel mir Blothert ein, ein wichtiges Mitglied des Kreises, das ich nur zweimal gesehen hatte.“"
                            },
                            {
                                "example_id": "f23d7023-f1da-49fb-9da7-110efb30d900",
                                "sense_id": "d5ea333a-495c-39fb-b26c-039533eca400",
                                "text": "„Er packte aus, ließ das Badewasser einlaufen, wusch sich und zog sich an.“"
                            },
                            {
                                "example_id": "abee938c-f96d-4223-86bc-adfd4e311353",
                                "sense_id": "d5ea333a-495c-39fb-b26c-039533eca400",
                                "text": "„Zu Hause zog ich mich sofort aus und ließ das Badewasser einlaufen.“"
                            },
                            {
                                "example_id": "f65ede4c-ee49-450e-8ac9-405dce04d670",
                                "sense_id": "d5ea333a-495c-39fb-b26c-039533eca400",
                                "text": "„Langsam glitt sie ins heiße Badewasser und entspannte sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
