                            {
                                "example_id": "4e846c1a-1fb3-4116-b4a1-1f1f5f08a072",
                                "sense_id": "5a1d5079-2150-39b0-8e83-202b51a7e541",
                                "text": "„Als Präsident der Europaabgeordneten besaß er zwar viel Einfluss, Regieren durfte er aber nicht.“"
                            },
                            {
                                "example_id": "8b71b525-c83a-4d26-ba28-3b5c1adeb7af",
                                "sense_id": "5a1d5079-2150-39b0-8e83-202b51a7e541",
                                "text": "„Die Europaabgeordneten sind vollauf damit beschäftigt, die letzten EU-Gesetze dieser Legislaturperiode zu verabschieden“"
                            }
                        ],
                        "sense_index_json": "\"1\""
