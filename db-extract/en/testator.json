                    {
                        "translation_id": "fd0e24a9-7061-493d-9ebc-901010e4eee0",
                        "source_entry_id": "4ace505d-3851-3319-9b80-cabe15c65ae1",
                        "source_sense_id": "2db95eca-d9d1-3087-ac8e-e102f8405c29",
                        "source_sense_description": "One who makes or has made a legally valid will",
                        "target_lang_word": "testateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "testateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f14a702b-30ec-3247-9c82-a5471b287b67",
                                        "entry_id": "a32fcbc5-f2cd-3a54-84cc-325a2eac6591",
                                        "glosses": [
                                            "Celui qui fait ou a fait un testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4928a02e-d594-4a61-9884-17e20922d376",
                                                "sense_id": "f14a702b-30ec-3247-9c82-a5471b287b67",
                                                "text": "Pour être capable de recevoir par testament, il suffit d’être conçu à l'époque du décès du testateur."
                                            },
                                            {
                                                "example_id": "35c68020-5d12-4c89-9e37-b94205908ad9",
                                                "sense_id": "f14a702b-30ec-3247-9c82-a5471b287b67",
                                                "text": "La volonté du testateur doit être sacrée et inviolable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef7a63d0-05f6-4c3f-9661-2201e6a884b9",
                        "source_entry_id": "4ace505d-3851-3319-9b80-cabe15c65ae1",
                        "source_sense_id": "2db95eca-d9d1-3087-ac8e-e102f8405c29",
                        "source_sense_description": "One who makes or has made a legally valid will",
                        "target_lang_word": "testatrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "testatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fadf564-11bc-33b8-97e9-a8caee516b91",
                                        "entry_id": "df0114bf-2fa7-3d01-9db5-72747989209e",
                                        "glosses": [
                                            "Celle qui fait un testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f666d68-f69d-4e96-b4ac-5074948acd00",
                                                "sense_id": "4fadf564-11bc-33b8-97e9-a8caee516b91",
                                                "text": "Il n’est pas moins essentiel d’observer que, par la clause qui contient le legs de garde-robe à Mᵐᵉ de l’Aubepin, la testatrice se sert des mêmes expressions que dans la clause postérieure, relative à l’institution d’héritiers."
                                            },
                                            {
                                                "example_id": "3957ab35-7a9b-4bf7-8ef4-c488428238ca",
                                                "sense_id": "4fadf564-11bc-33b8-97e9-a8caee516b91",
                                                "text": "Le notaire certifiant que les testatrices ont voulu faire une disposition en sa faveur, il n'y a de prouvé que sa faute ; et sa responsabilité en est la conséquence. Si les testatrices devaient savoir qu'elles étaient ses créancières, devait-il ignorer qu'il était leur débiteur ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f738695-aa04-4902-9f59-907692b8613a",
                        "source_entry_id": "4ace505d-3851-3319-9b80-cabe15c65ae1",
                        "source_sense_id": "2db95eca-d9d1-3087-ac8e-e102f8405c29",
                        "source_sense_description": "One who makes or has made a legally valid will",
                        "target_lang_word": "Erblasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erblasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                        "entry_id": "0c3c765f-2c46-300b-94c0-f8cca7a4faa4",
                                        "glosses": [
                                            "natürliche Person, die nach ihrem Tod ein Vermögen hinterlässt, das den gesetzlichen und testamentarisch bestimmten Erben zusteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c203631e-d42a-48fa-9bc1-1b8f6ef0746b",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Das Erbrecht tritt erst nach dem Tode des Erblassers ein. Stirbt ein vermeintlicher Erbe vor dem Erblasser; so hat er das noch nicht erlangte Erbrecht auch nicht auf seine Erben übertragen können.“"
                                            },
                                            {
                                                "example_id": "9aef8c25-f756-4b3d-b5ec-8d23336a105b",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Eine letztwillige Verfügung, durch die der Erblasser seinen Ehegatten bedacht hat, ist unwirksam, wenn die Ehe vor dem Tod des Erblassers aufgelöst worden ist.“"
                                            },
                                            {
                                                "example_id": "df78cb5a-a8a4-4130-bb65-2ac052a36b83",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Der Erblasser kann einem Abkömmling den Pflichtteil entziehen: 1. wenn der Abkömmling dem Erblasser, dem Ehegatten oder einem anderen Abkömmling des Erblassers nach dem Leben trachtet, …“"
                                            },
                                            {
                                                "example_id": "6b8b3ce3-9057-4189-8e53-8bd1fee4820a",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Sie sollen sie alle sehen und prüfen; jetzt aber lesen Sie zunächst einmal dieses Schreiben, welches der verwüstliche Erblasser damals aus Plauen erhalten hat!“"
                                            },
                                            {
                                                "example_id": "677a4d47-169f-4f7c-961d-ee8de496573d",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Man sagt, dass seitdem in Danzig in mannigfachen Fällen, insofern der Erblasser dem Genusse des Goldwassers ergeben war, von den Erben seine Sektion dringend gefordert wurde.“"
                                            },
                                            {
                                                "example_id": "5a6d08f2-fb97-43bf-9512-b1947793e998",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Dann verlas er einige persönliche Zeilen des Erblassers: […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01b17174-387c-41f9-8a5a-bfdddb7e16af",
                        "source_entry_id": "4ace505d-3851-3319-9b80-cabe15c65ae1",
                        "source_sense_id": "2db95eca-d9d1-3087-ac8e-e102f8405c29",
                        "source_sense_description": "One who makes or has made a legally valid will",
                        "target_lang_word": "Erblasserin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erblasserin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f63d054e-4e2e-3ae9-a9af-d87c382d75ba",
                                        "entry_id": "32ed369c-b44c-3b7c-9e4f-69b890e1bf29",
                                        "glosses": [
                                            "Eine natürliche weibliche Person, die nach ihrem Tod ein Vermögen hinterlässt, das den gesetzlichen und testamentarisch bestimmten Erben zusteht."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6936601d-a826-4e53-9f1f-984583992058",
                                                "sense_id": "f63d054e-4e2e-3ae9-a9af-d87c382d75ba",
                                                "text": "In dem verhandelten Fall hatte die Erblasserin mit ihrem Mann ein Adoptivkind angenommen. Sie setzte ein Testament auf, wonach ihre Schwestern Alleinerbin sein sollte. Diese starb jedoch vor der Erblasserin."
                                            },
                                            {
                                                "example_id": "6dd1c498-b10c-46cf-ae73-dc9f33597e54",
                                                "sense_id": "f63d054e-4e2e-3ae9-a9af-d87c382d75ba",
                                                "text": "Nach dem Tod der Erblasserin beantragte nun das Adoptivkind einen Alleinerbschein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
