                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "203179e3-011a-4214-828b-ae946c63d44b",
                                "sense_id": "d969385e-c006-37f9-a8f2-558d2d5e0fd9",
                                "text": "Aber es ärgert mich, wenn die Leute mir während meiner Aktionen auf die Schulter klopfen, sich dann aber einen neuen SUV bestellen oder das Fleisch auf den Grill hauen. […] Es ist einfach viel verlogenes Wischiwaschi dabei."
                            },
                            {
                                "example_id": "ec9ad180-dd73-4ef2-82ab-10d0ae5f9436",
                                "sense_id": "d969385e-c006-37f9-a8f2-558d2d5e0fd9",
                                "text": "2010 setzte der damalige Focus-Chef Wolfram Weimer eine Tirade über einen „linksliberalen, feministischen, sozialstaatsfixierten Multikulti-Wischiwaschi-Mainstream“ in sein Blatt."
                            }
                        ]
                    }
                ],
