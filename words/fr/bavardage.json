                {
                    "sense_id": "24cf57d4-989b-3676-964e-80a3818dc8e9",
                    "sense_definition": "Propos futiles, commérages ou discours inutilement long sans intérêt réel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne prête pas attention à ces remarques, ce ne sont que de futiles <w>bavardages</w> de voisins."
                        },
                        {
                            "text": "Le rapport officiel se concentre sur les faits vérifiables et évite tout <w>bavardage</w> inutile."
