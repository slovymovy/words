                        "entry_id": "8f7b9b06-a8d9-32bf-9abf-30e184ca6e10",
                        "glosses": [
                            "pogląd, według którego wola jest głównym czynnikiem w codziennym działaniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "707fb44b-ce4c-43ef-b6a1-c2fe517bc263",
                                "sense_id": "d5db41ec-8bda-361c-9bbf-c3d42d907530",
                                "text": "Augustyńska idea filozoficznego woluntaryzmu, akcentowanie przede wszystkim zagadnienia woli ludzkiej i działania zapoczątkowuje w myśli chrześcijańskiej na długie stulecia aktualny nurt myślowy, niejako konkurencyjny w stosunku do późniejszego filozoficznego intelektualizmu tomistycznego"
                            },
                            {
                                "example_id": "7cee9cea-9a4b-4d38-8e21-bc0babe8d3c3",
                                "sense_id": "d5db41ec-8bda-361c-9bbf-c3d42d907530",
                                "text": "Ktoś powinien skończyć z tym woluntaryzmem interpretacyjnym Ministerstwa Finansów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e01688ee-94b6-38ed-8257-4a8f86c2131f",
                        "entry_id": "8f7b9b06-a8d9-32bf-9abf-30e184ca6e10",
                        "glosses": [
                            "stawianie własnej woli i zachcianek nad inne czynniki przy podejmowaniu decyzji"
                        ],
                        "tags": [
                            "publ."
                        ],
                        "examples": [
                            {
                                "example_id": "9a7fab36-196b-4434-9046-fcc695e4456c",
                                "sense_id": "e01688ee-94b6-38ed-8257-4a8f86c2131f",
                                "text": "To klasyczny woluntaryzm ekonomiczny, czyli po polsku chciejstwo"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
