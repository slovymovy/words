            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e9ce40c5-427c-3fb6-8593-d0e993632bba",
                    "sense_definition": "Feeling very interested or attracted by something or someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience was <w>captivated</w> by the singer's beautiful voice.",
                            "target_lang_translations": {
                                "nl": "Het publiek werd <w>geboeid</w> door de prachtige stem van de zangeres."
                            }
                        },
                        {
                            "text": "She was completely <w>captivated</w> by the story he told.",
                            "target_lang_translations": {
                                "nl": "Ze was volledig <w>betoverd</w> door het verhaal dat hij vertelde."
                            }
                        }
                    ],
                    "synonyms": [
                        "mesmerized",
                        "enchanted",
                        "fascinated",
                        "enthralled"
                    ],
                    "antonyms": [
                        "bored",
                        "uninterested"
                    ],
                    "common_phrases": [
                        "totally captivated",
                        "completely captivated"
                    ],
                    "target_lang_definitions": {
