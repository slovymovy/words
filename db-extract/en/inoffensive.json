                                "target_senses": [
                                    {
                                        "sense_id": "331d18d0-8c77-3e74-9493-e73dcbfc2eb0",
                                        "entry_id": "7f227283-bed8-32ee-a2c2-3f7d4987af31",
                                        "glosses": [
                                            "Qui n'est pas dangereux, qui ne fait pas de mal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "976462c7-a910-4cf4-b376-ead123eb01c6",
                                                "sense_id": "331d18d0-8c77-3e74-9493-e73dcbfc2eb0",
                                                "text": "Bientôt le torrent d’événements qui passa sur Paris fit oublier deux amants inoffensifs."
                                            },
                                            {
                                                "example_id": "4f022c8e-aa0e-45b3-83cf-12f9c591ae6c",
                                                "sense_id": "331d18d0-8c77-3e74-9493-e73dcbfc2eb0",
                                                "text": "Deux heures plus tard, le yawl regagnait son mouillage, nous laissant l'inoffensive distraction d'imaginer d'extraordinaires romans dignes du cinématographe."
                                            },
                                            {
                                                "example_id": "2f6881d3-6193-41a2-8999-deaed99a821a",
                                                "sense_id": "331d18d0-8c77-3e74-9493-e73dcbfc2eb0",
                                                "text": "Quelques galopiaux à Aix s'amusaient à cribler de boules de neige des passants inoffensifs. J'étais de ceux-ci et ne savais que faire."
                                            }
                                        ]
                                    }
