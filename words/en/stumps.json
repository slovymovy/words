{
    "word_family": [
        "stump",
        "stumpy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "956f156a-cc89-3ed8-998c-bacbffc24e3d",
                    "sense_definition": "The plural of <w>stump</w>, referring to the base parts of trees remaining in the ground after the rest has been cut down.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tree_remains",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The field was full of old tree <w>stumps</w> that made it difficult to plow.",
                            "target_lang_translations": {
                                "ru": "Поле было полно старых древесных <w>пней</w>, которые мешали пахать."
                            }
                        },
                        {
                            "text": "We cleared the garden and removed all the rotting <w>stumps</w>.",
                            "target_lang_translations": {
                                "ru": "Мы расчистили сад и удалили все гниющие <w>пни</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя часть дерева, оставшаяся в земле после того, как дерево было срублено."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пни",
                                "target_lang_sense_clarification": "множественное число от слова пень"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdd18765-b15f-39ed-9023-c8a3e6bfed58",
                    "sense_definition": "The end of a day's play in a game of cricket.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cricket_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team was in a strong position when the umpire called <w>stumps</w>.",
                            "target_lang_translations": {
                                "ru": "Команда была в сильной позиции, когда судья объявил <w>окончание игры</w>."
                            }
                        },
                        {
                            "text": "Australia were 488-6 at <w>stumps</w> against India.",
                            "target_lang_translations": {
                                "ru": "Австралия имела счет 488-6 на момент <w>окончания игры</w> против Индии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "at stumps"
                    ],
                    "target_lang_definitions": {
                        "ru": "Окончание игрового дня в крикете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окончание игры",
                                "target_lang_sense_clarification": "в контексте крикета"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1479913-1171-3941-b294-68e075967a3b",
                    "sense_definition": "Third-person singular simple present indicative of <w>stump</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This difficult math problem often <w>stumps</w> even the best students.",
                            "target_lang_translations": {
                                "ru": "Эта сложная математическая задача часто <w>ставит в тупик</w> даже лучших учеников."
                            }
                        },
                        {
                            "text": "The complex question clearly <w>stumps</w> the candidate during the interview.",
                            "target_lang_translations": {
                                "ru": "Сложный вопрос явно <w>озадачивает</w> кандидата во время собеседования."
                            }
                        }
                    ],
                    "synonyms": [
                        "baffles",
                        "perplexes",
                        "confuses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставить в тупик, озадачивать (форма глагола в 3-м лице ед. ч.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставит в тупик",
                                "target_lang_sense_clarification": "озадачивает кого-либо"
                            },
                            {
                                "target_lang_word": "озадачивает",
                                "target_lang_sense_clarification": "вызывает недоумение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d0a8f482-cc9c-3dee-a3e5-b98e1f20fbf4",
                    "sense_definition": "The plural of <w>Stump</w> (a surname).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Stumps</w> family moved into the neighborhood last month.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Стампов</w> переехала в наш район в прошлом месяце."
                            }
                        },
                        {
                            "text": "I met both Mr. and Mrs. <w>Stumps</w> at the community meeting.",
                            "target_lang_translations": {
                                "ru": "Я встретил мистера и миссис <w>Стамп</w> на собрании общественности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число фамилии Стамп."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Стампы",
                                "target_lang_sense_clarification": "семья по фамилии Стамп"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}