    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "71fa29e4-03a2-313c-9cb4-4891215348d9",
                "word": "thusly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "38ce0589-6d10-3932-98d7-25afe32a437e",
                        "entry_id": "71fa29e4-03a2-313c-9cb4-4891215348d9",
                        "glosses": [
                            "thus (in this way)."
                        ],
                        "tags": [
                            "not-comparable",
                            "proscribed"
                        ],
                        "examples": [
                            {
                                "example_id": "aa386fd4-f514-45d5-86a3-8d46898f64af",
                                "sense_id": "38ce0589-6d10-3932-98d7-25afe32a437e",
                                "text": "Ar, tell me it is not so thusly as this thusness wouldst seem!"
                            },
                            {
                                "example_id": "8d234fff-d1fb-4461-97f7-f95fce1e0a88",
                                "sense_id": "38ce0589-6d10-3932-98d7-25afe32a437e",
                                "text": "His course can only be akkounted for thusly:"
                            },
                            {
                                "example_id": "a6547d6a-ecec-47f7-9e15-9b4823f7c024",
                                "sense_id": "38ce0589-6d10-3932-98d7-25afe32a437e",
                                "text": "He had an attack of catarrh not long ago, and it happened, as J. Billings would say, \"thusly:\""
                            },
                            {
                                "example_id": "e63b8e3b-0d88-4b54-a9b0-aa944bbba242",
                                "sense_id": "38ce0589-6d10-3932-98d7-25afe32a437e",
                                "text": "Stories never lose anything in the recital, and consequently this one grew thusly."
                            },
                            {
                                "example_id": "01035e4b-719b-44ec-8cda-593e6d75b34f",
                                "sense_id": "38ce0589-6d10-3932-98d7-25afe32a437e",
                                "text": "The history of the Universe has been summed up thusly: \"Hydrogen is a light, odorless gas, which, given enough time, turns into people.\""
                            },
                            {
                                "example_id": "1adc6fd5-00c4-47b2-aa22-f07183ea1246",
                                "sense_id": "38ce0589-6d10-3932-98d7-25afe32a437e",
                                "text": "Going thusly, unwillingly at the bell,\nAnswering the call to recycle my time."
                            }
                        ]
                    },
                    {
                        "sense_id": "09a9b5f8-3c08-3f54-bafd-6a9665686c68",
                        "entry_id": "71fa29e4-03a2-313c-9cb4-4891215348d9",
                        "glosses": [
                            "thus (therefore)"
                        ],
                        "tags": [
                            "not-comparable",
                            "proscribed"
                        ],
                        "examples": [
                            {
                                "example_id": "010d50af-1779-426a-a20d-7a6ebb3e4f00",
                                "sense_id": "09a9b5f8-3c08-3f54-bafd-6a9665686c68",
                                "text": "Lately, they [the prison authorities] came up with a new excuse. Seems like they consider owning a Gay publication is an expression of a person's sexuality and would thusly identify the person as a homosexual which would then subject him to assault or pressures."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
