                        "glosses": [
                            "Faire perdre son caractère émerveillé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59cec8dd-51af-4e5a-846f-e069ac03311e",
                                "sense_id": "a3618a1f-c54a-3815-a219-b7a79f307038",
                                "text": "Toute notre vie se désémerveille. Tout se ressemble mais rien n’est pareil."
                            },
                            {
                                "example_id": "641e3a7a-e04e-46df-a481-b797f0fa2a81",
                                "sense_id": "a3618a1f-c54a-3815-a219-b7a79f307038",
                                "text": "Celle qui la « désémerveille »"
                            },
                            {
                                "example_id": "062ab9e2-87dc-47d7-9f84-0ef8adc9618e",
                                "sense_id": "a3618a1f-c54a-3815-a219-b7a79f307038",
                                "text": "Nous sommes dans un monde désémerveillé où l’homme s’aventure plus à médire qu’à dire."
                            },
                            {
                                "example_id": "ca4d5810-08af-4933-83df-2590ef695fae",
                                "sense_id": "a3618a1f-c54a-3815-a219-b7a79f307038",
                                "text": "Leur matière et leur patine profonde quasi laquée témoignent d’une extrême ancienneté (plusieurs siècles pour certains) et nous renvoient à une interrogation sur nous-mêmes à travers la quête du sens et de nos origines, à une époque pas si lointaine pour certains et encore vivante (mais pour combien de temps encore…) pour d’autres où l’homme se pensait en harmonie avec le cosmos et la nature et ne souhaitait pas encore lui imposer son dictat en «désémerveillant» le monde."
                            }
                        ]
                    }
