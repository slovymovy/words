                                        "examples": [
                                            {
                                                "example_id": "ce4831e0-9d43-4c6b-9b9f-7a7d8ac559cd",
                                                "sense_id": "2069e0c5-d982-340b-94cf-a5eeb312b99f",
                                                "text": "Heat some oil in a cast-iron skillet and add the onions."
                                            },
                                            {
                                                "example_id": "da21a63d-c366-4a93-b72c-c422611735f6",
                                                "sense_id": "2069e0c5-d982-340b-94cf-a5eeb312b99f",
                                                "text": "Inside this paper plane\nNote my words are Navy sealed\nSo here and I quote\nTaboo and I are in the same boat\nWhat's said from Pennywise\nI guess we all float\nSky is the limit, I could die in a minute\nGot my mind in a skillet\nSuicide not a mission\nSee the vibe very timid\nI'm timid and very sad\nTranslated my thoughts and feelings\nI pivot into the pad"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b144fb6-770d-311c-b8ad-47b587ea3a4d",
                                        "entry_id": "212a98a2-3fe8-3ea2-91ab-612256696f16",
                                        "glosses": [
                                            "A dish or meal cooked in such a pan."
