                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomy",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "Sonda kosmiczna przesłała nowe zdjęcia <w>Pana</w>.",
                            "target_lang_translations": {
                                "ru": "Космический зонд прислал новые фотографии <w>Пана</w>.",
                                "en": "The space probe sent back new photos of <w>Pan</w>."
                            }
                        },
                        {
                            "text": "<w>Pan</w> krąży wewnątrz jednego z pierścieni Saturna.",
                            "target_lang_translations": {
                                "ru": "<w>Пан</w> вращается внутри одного из колец Сатурна.",
                                "en": "<w>Pan</w> orbits inside one of Saturn's rings."
