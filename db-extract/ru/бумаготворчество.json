                ],
                "senses": [
                    {
                        "sense_id": "37abbec7-f6ed-3c37-833c-5c188974f948",
                        "entry_id": "0842a30b-0cc5-3d21-a9d6-84abd8973fe8",
                        "glosses": [
                            "неодобр. составление ненужных официальных бумаг"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0561fbc0-8b15-4f9a-8e00-bf2721478df3",
                                "sense_id": "37abbec7-f6ed-3c37-833c-5c188974f948",
                                "text": "Функциональная система является одной из причин, порождающих канцелярско-бюрократические методы работы и бумаготворчество, заслоняющее живых людей."
                            },
                            {
                                "example_id": "dd3c00f0-a9bc-4ed6-82a2-19b621add796",
                                "sense_id": "37abbec7-f6ed-3c37-833c-5c188974f948",
                                "text": "Вес ежедневной почты министерства равнялся 23 пудам. В то же время известно, что работа этого министерства далека от совершенства. В этом во многом повинно бумаготворчество, подменяющее действенное, живое руководство."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bbe32a2-ffbf-4a47-afd8-34704a2bb900",
                        "source_entry_id": "0842a30b-0cc5-3d21-a9d6-84abd8973fe8",
                        "source_sense_id": "37abbec7-f6ed-3c37-833c-5c188974f948",
                        "target_lang_word": "paperwork",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paperwork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20739365-f41c-343d-95a8-a641bff76129",
                                        "entry_id": "249230ab-b03e-3b3e-8f29-fffc52d30ade",
                                        "glosses": [
                                            "Routine work involving written documents."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb70a8a4-1ebe-438d-b315-3dc0b69294ae",
                                                "sense_id": "20739365-f41c-343d-95a8-a641bff76129",
                                                "text": "do paperwork"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ff9dbd4-354f-367b-8211-bea6d72f4fbc",
                                        "entry_id": "249230ab-b03e-3b3e-8f29-fffc52d30ade",
                                        "glosses": [
                                            "Written documents."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c4fc2f7-b2db-47e1-afb5-4a0a04ef6418",
                                                "sense_id": "4ff9dbd4-354f-367b-8211-bea6d72f4fbc",
                                                "text": "The source stated that the alleged victims wanted the paperwork released after the settlement, but with names and identifiers removed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e958bbea-8fb6-3470-a917-cc65bd178814",
                                        "entry_id": "249230ab-b03e-3b3e-8f29-fffc52d30ade",
                                        "glosses": [
                                            "Excessive paperwork, busy work, red tape."
                                        ],
                                        "tags": [
                                            "also",
                                            "excessive",
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "275a0b72-710e-3493-81f4-877ad043aedc",
                                        "entry_id": "249230ab-b03e-3b3e-8f29-fffc52d30ade",
                                        "glosses": [
                                            "Court documents or pre-sentencing investigation reports detailing the prisoner's criminal history (usually in the context of discerning whether an inmate has been charged for sex-related offenses or is likely to be an informant)."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1e4b0b4-3d82-4c8f-8858-db498ee60af0",
                                                "sense_id": "275a0b72-710e-3493-81f4-877ad043aedc",
                                                "text": "to have bad paperwork",
                                                "translation": "to be charged with sex-related offenses or to likely be an informant",
                                                "english": "to be charged with sex-related offenses or to likely be an informant"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe625075-a468-35c9-8a6d-5a0a4ad20343",
                                        "entry_id": "249230ab-b03e-3b3e-8f29-fffc52d30ade",
                                        "glosses": [
                                            "A work in paper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86dafe75-33b3-4aed-81c7-93b88ab8fc3c",
                                                "sense_id": "fe625075-a468-35c9-8a6d-5a0a4ad20343",
                                                "text": "Greatly you haue boaſted of, and much threatned theſe two places, (for euery later paperwork of yours is but a Tautology of the former) […]"
                                            },
                                            {
                                                "example_id": "f26d2336-d30b-425e-86b4-09fe31d27852",
                                                "sense_id": "fe625075-a468-35c9-8a6d-5a0a4ad20343",
                                                "text": "However, except for few experimental paperworks by Jackson Pollock on paper made by Douglass Howell and occasional prints, usually woodcuts or wood engravings on Japanese paper, it is only in the late 1950s and early 1960s that editions of prints on beautiful handmade papers began appearing, published by Tatyana Grosman at the Universal Limited Art Editions on Long Island."
                                            },
                                            {
                                                "example_id": "505de0d1-ead3-43a5-9a79-128daa66723c",
                                                "sense_id": "fe625075-a468-35c9-8a6d-5a0a4ad20343",
                                                "text": "In listing dimensions for the paperworks, height precedes width, followed by depth; and dimensions for multi-unit pieces are for the entire work."
                                            },
                                            {
                                                "example_id": "ec0c321b-b4d4-48ca-a469-45dcfeab3f62",
                                                "sense_id": "fe625075-a468-35c9-8a6d-5a0a4ad20343",
                                                "text": "Rob Moore is nationally and internationally known for his painting and for his paperworks."
                                            },
                                            {
                                                "example_id": "e75d8272-a688-4b70-ada9-621b349a1b6a",
                                                "sense_id": "fe625075-a468-35c9-8a6d-5a0a4ad20343",
                                                "text": "His [Joseph Roberson’s] cast sculptural paperworks have been exhibited extensively in the United States, as well as in Thailand and Vietnam."
                                            },
                                            {
                                                "example_id": "f67bf124-7236-4098-bc6f-8ed9b541264a",
                                                "sense_id": "fe625075-a468-35c9-8a6d-5a0a4ad20343",
                                                "text": "Having practised as a sculptor and ceramicist for many years, I became more and more interested in paperworks and artist’s books."
                                            },
                                            {
                                                "example_id": "73187064-8756-482b-89ba-d75da38bba88",
                                                "sense_id": "fe625075-a468-35c9-8a6d-5a0a4ad20343",
                                                "text": "Please wait for me outside, I’ll need to carry all these paperworks to my house."
                                            },
                                            {
                                                "example_id": "3b4e9c6d-d2e9-45cf-8637-50e142ad621f",
                                                "sense_id": "fe625075-a468-35c9-8a6d-5a0a4ad20343",
                                                "text": "I opened the drawers, and there were all these paper maquettes for larger folded paperworks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
