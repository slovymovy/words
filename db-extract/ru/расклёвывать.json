                "senses": [
                    {
                        "sense_id": "f94fd9f7-9301-3f2f-9436-7d11e84e0404",
                        "entry_id": "b11236b6-0987-376c-b249-fee522f412b2",
                        "glosses": [
                            "клюя, поедать, растаскивать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f4f579e-11d0-49e3-8607-55f694a24016",
                                "sense_id": "f94fd9f7-9301-3f2f-9436-7d11e84e0404",
                                "text": "Посреди улицы, на подтаявшей дороге, воробьи расклевывали навоз."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c8befd0-ce56-3626-98b7-b209cc1d6e14",
                        "entry_id": "b11236b6-0987-376c-b249-fee522f412b2",
                        "glosses": [
                            "разбивать, повреждать клювом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "436e9e0f-c2cf-4f7b-917f-aac2339d3662",
                                "sense_id": "9c8befd0-ce56-3626-98b7-b209cc1d6e14",
                                "text": "Потом мы пили водку, бросая в стаканы ледяные кубики арбуза, и смотрели, как ворона на отмели расклевывает ракушку."
                            }
                        ]
                    },
                    {
                        "sense_id": "d958b23b-71e1-382b-835e-781e519876af",
                        "entry_id": "b11236b6-0987-376c-b249-fee522f412b2",
                        "glosses": [
                            "перен., разг. растаскивая, присваивать; расхищать"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
