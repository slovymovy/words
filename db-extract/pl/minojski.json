                "senses": [
                    {
                        "sense_id": "12e01d22-9587-34e3-b4d9-8d0cc8846d21",
                        "entry_id": "20f60cf3-5cdb-33be-ae76-0694525d061a",
                        "glosses": [
                            "dotyczący, odnoszący się do cywilizacji powstałej w rejonie Morza Egejskiego w okresie od 2600 do 1100 r. p.n.e."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7dd75f5-6712-49b2-a9ad-1c86bcb0d872",
                                "sense_id": "12e01d22-9587-34e3-b4d9-8d0cc8846d21",
                                "text": "Otworzyłam i przez kilka stron kultury mykeńskiej i minojskiej, przez Wieki Ciemne dotarłam do wojen perskich"
                            },
                            {
                                "example_id": "4c2b29ec-5f1e-4fa6-a1e0-b74b226c1e36",
                                "sense_id": "12e01d22-9587-34e3-b4d9-8d0cc8846d21",
                                "text": "W roku 1400 p.n.e. zdobywają Kretę i niszczą kwitnącą kulturę minojską, zwaną tak od legendarnego króla Minosa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
