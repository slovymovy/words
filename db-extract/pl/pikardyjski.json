                "senses": [
                    {
                        "sense_id": "b69132a6-7667-32ca-80e0-61f4a19fda7f",
                        "entry_id": "4f924841-16c9-3dbf-916a-505154d06518",
                        "glosses": [
                            "dotyczący Pikardii lub Pikardyjczyków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbc2e483-068f-4c2d-9f57-f42f9397b56d",
                                "sense_id": "b69132a6-7667-32ca-80e0-61f4a19fda7f",
                                "text": "Wyzionął ducha na pikardyjskiej ziemi w bitwie pod Crécy. Albo może nawet jeszcze wcześniej, wtedy, gdy ujrzał swą siostrę, Eudeline, hańbioną przez ojca"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6121ce03-2ace-3c30-b689-5bd07ae65332",
                        "entry_id": "4f924841-16c9-3dbf-916a-505154d06518",
                        "glosses": [
                            "pochodzący z Pikardii lub wytworzony na tamtejszy sposób"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88424136-66d5-451a-a18c-5c67489dea80",
                        "source_entry_id": "4f924841-16c9-3dbf-916a-505154d06518",
                        "source_sense_id": "b69132a6-7667-32ca-80e0-61f4a19fda7f",
                        "target_lang_word": "picard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "picard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "561f3249-881d-3bd0-a09d-1186d6568a37",
                                        "entry_id": "842c3a73-b1dd-371d-9549-e7dc2e67c667",
                                        "glosses": [
                                            "Qui se rapporte à la Picardie ou aux Picards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38d90c48-f848-4a97-85e2-beff0497df24",
                                                "sense_id": "561f3249-881d-3bd0-a09d-1186d6568a37",
                                                "text": "Prosper Magnan fit venir quelques larmes dans les yeux du négociant fugitif, quand, avec cette franchise picarde et la naïveté d’une nature bonne et tendre, il supposa ce que devait faire sa mère au moment où il se trouvait, lui, sur les bords du Rhin."
                                            },
                                            {
                                                "example_id": "c2a11306-d503-4d96-a6a8-b49dcf20c927",
                                                "sense_id": "561f3249-881d-3bd0-a09d-1186d6568a37",
                                                "text": "Les deux familles dont je procède, l’une picarde et l’autre ardennaise, étaient originairement des familles de paysans."
                                            },
                                            {
                                                "example_id": "e80c9f81-94bd-4074-8bf6-07c6d8088eed",
                                                "sense_id": "561f3249-881d-3bd0-a09d-1186d6568a37",
                                                "text": "Quand elle passa devant l’église on sortait de la grand’messe, et en écoutant les propos des gens qu’elle croisait, elle reconnut encore le lent parler picard aux mots traînés et chantés que son père imitait pour l’amuser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ff0a79-d6ce-3199-900e-1af59b643de0",
                                        "entry_id": "842c3a73-b1dd-371d-9549-e7dc2e67c667",
                                        "glosses": [
                                            "Relatif à une secte hussite installée jadis en Picardie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "picard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16d87af4-3c9f-3cf2-8481-6169883198f7",
                                        "entry_id": "0bae024e-b422-360b-a98f-4e10fdc48cf0",
                                        "glosses": [
                                            "Langue romane rattachée à la langue d’oïl parlée en Picardie et dans le Nord-Pas-de-Calais."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "picard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4119a0e-a2f4-3e3b-8a23-8d37fd932d6a",
                                        "entry_id": "b819af76-f9ca-3284-b042-2f38d4d629c8",
                                        "glosses": [
                                            "Membre d’une secte hussite installée en Picardie après l’assassinat de Jean Hus et par extension, ces sectateurs de Bohême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfe69fee-27c0-4b7f-9adc-40587b3deac2",
                                                "sense_id": "d4119a0e-a2f4-3e3b-8a23-8d37fd932d6a",
                                                "text": "Les dogmes des picards & des Vaudois sont les mêmes nous l’avons déja vu par le détail que Schlecta a fait des opinions des picards de Bohême. Ils soutenoient qu’il ne faut point adorer l’eucharistie parce que le corps de Jesus-Christ n’y est point, le Seigneur ayant été élevé au ciel en corps & en ame."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "picard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "590816a3-054c-366c-9dbd-d7e33e99bf34",
                                        "entry_id": "85614d64-52fc-3c51-9c1d-7b26657c37fc",
                                        "glosses": [
                                            "Berger de Picardie."
                                        ],
                                        "tags": [
                                            "Cynologie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
