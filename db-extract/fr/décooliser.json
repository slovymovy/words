                "senses": [
                    {
                        "sense_id": "93423743-b0b6-3088-b8e9-d952a911e5b5",
                        "entry_id": "75d28712-779a-3ef9-915c-bfb92e9e8e12",
                        "glosses": [
                            "Faire perdre son caractère cool à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90fd2852-4862-491e-8a2b-656926810bdb",
                                "sense_id": "93423743-b0b6-3088-b8e9-d952a911e5b5",
                                "text": "Pour \"décooliser\" ce look, j’ai opté pour des sandales à talons."
                            },
                            {
                                "example_id": "ed236cb9-e099-4ef5-b556-d775a7cdd5c7",
                                "sense_id": "93423743-b0b6-3088-b8e9-d952a911e5b5",
                                "text": "Au contraire, dans le monde actuel il y a beaucoup trop de paramètres qui nous « décoolisent » en nous imposant des délais et plein d’autres choses."
                            },
                            {
                                "example_id": "f9a134ed-55cf-42f4-9c55-742c380b5b1c",
                                "sense_id": "93423743-b0b6-3088-b8e9-d952a911e5b5",
                                "text": "Il lui arrive de prononcer des expressions cool (comme « J’ai le seum », qui exprime ordinairement le mécontentement), qui, aux yeux des collégiens, se « décoolisent » illico à l’instant où elles s’échappent de ses lèvres."
                            }
                        ]
                    }
                ],
