                "senses": [
                    {
                        "sense_id": "c0ce0629-5c65-3b3a-a72f-52b907c40fa5",
                        "entry_id": "fed0b6d9-2ebb-39ee-80ca-09184d5298c2",
                        "glosses": [
                            "Gerät zur Zählung der gemachten Schritte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62007a8f-1e11-4559-a42f-d525c72ace7b",
                                "sense_id": "c0ce0629-5c65-3b3a-a72f-52b907c40fa5",
                                "text": "„Er beschäftigte sich am Tage eifrig mit seinen Privatinteressen und hielt sich viel in Bewegung, indem er dem Zeiger am Podometer zufolge nicht weniger als 3–4000 Schritte täglich im Durchschnitt machte.“"
                            },
                            {
                                "example_id": "2226ad84-5225-49a4-a40d-dd29def71dc3",
                                "sense_id": "c0ce0629-5c65-3b3a-a72f-52b907c40fa5",
                                "text": "„Zur Messung der zurückgelegten Distanzen benützte ich eine Zeitlang Podometer (Schrittzähler); da ich zwei mit mir trug und sie täglich wiederholt kontrollierte, erkannte ich bald, dass diese Instrumente ganz unzuverlässig sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
