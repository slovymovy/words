                        "target_lang_word": "Sardelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sardelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b8f3093-5d5c-3d14-a4df-c2723ae25ba2",
                                        "entry_id": "5eda75f1-2e93-36c2-add7-b8a6498b25e0",
                                        "glosses": [
                                            "heringsartiger Fisch aus der Familie Engraulidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c6a4537-c2e6-42d3-ba44-e31c71508c3b",
                                                "sense_id": "4b8f3093-5d5c-3d14-a4df-c2723ae25ba2",
                                                "text": "Die meisten Sardellen erreichen Körperlängen um 20 cm."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30e128df-2086-31be-9f79-8f64b889fa14",
                                        "entry_id": "5eda75f1-2e93-36c2-add7-b8a6498b25e0",
                                        "glosses": [
                                            "die in vielen europäischen Meeren vorkommende Europäische Sardelle"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba347e0c-959e-4b8c-802a-e91c696ccfc1",
                                                "sense_id": "30e128df-2086-31be-9f79-8f64b889fa14",
                                                "text": "Sardellen werden unter anderem zu Anchovis verarbeitet."
                                            },
                                            {
                                                "example_id": "dc091d23-21fb-40c2-99e1-732f2030ad91",
                                                "sense_id": "30e128df-2086-31be-9f79-8f64b889fa14",
                                                "text": "„Ich wunderte mich damals noch, daß eine Pizza nicht süß schmeckt, sondern nach Pfeffer, Oliven und Sardellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b652d4d2-aee4-3189-bb2a-f23329626a5b",
                                        "entry_id": "5eda75f1-2e93-36c2-add7-b8a6498b25e0",
                                        "glosses": [
                                            "überkämmte Glatze"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65315f34-e99d-4384-9ac8-74bfd9e7018c",
                                                "sense_id": "b652d4d2-aee4-3189-bb2a-f23329626a5b",
                                                "text": "Ein rosig geschminkter Oberst, das Haar in Sardellen wie auf ein belegtes Brot über die Glatze geringelt, spielt eine große Rolle."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22f8fab6-470c-435e-b96c-f36c0ad3033e",
                        "source_entry_id": "c862951b-d721-32ca-b980-d3650359242b",
                        "source_sense_id": "e0f34a4c-214b-3cb2-af96-785fdcdf9a2b",
                        "target_lang_word": "анчо́ус",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "анчо́ус",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c1e5271d-9159-3376-b895-560b4afe3810",
                                        "entry_id": "cc2f5e0e-8954-393c-9a82-7c09369398d3",
                                        "glosses": [
                                            "мелкая морская рыба отряда сельдеобразных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b866578-8d9d-42c7-976e-d1920d30076a",
                                                "sense_id": "c1e5271d-9159-3376-b895-560b4afe3810",
                                                "text": "Молодой ученый установил, что, догнав добычу — косяк скумбрии или анчоуса (он это наблюдал в зоне течений Калифорнийского и Куросиво), — стая дельфинов-белобочек ведет себя точно так же, как волчья."
                                            },
                                            {
                                                "example_id": "7c0a63db-edff-4b3b-a8ca-4358c84769fc",
                                                "sense_id": "c1e5271d-9159-3376-b895-560b4afe3810",
                                                "text": "Ночью вода здесь фосфоресцирует от несметного множества крошечных живых существ — диатомей. То тут, то там ее прочерчивают сотни зеленых полосок. Это проносятся стайки перуанского анчоуса — мелкой рыбешки, брюшные полости которой набиты светящимся фитопланктоном."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67bc12c9-9e6d-3613-ac45-71b6930d918a",
                                        "entry_id": "cc2f5e0e-8954-393c-9a82-7c09369398d3",
                                        "glosses": [
                                            "мясо такой рыбы, употребляемое в пищу; также кушанье, приготовленное из такого мяса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b6a0ac-a2c2-4984-ac82-3a2994d90a0c",
                                                "sense_id": "67bc12c9-9e6d-3613-ac45-71b6930d918a",
                                                "text": "Мы сами выбрали себе павильйон, велели подать цыпленка, анчоусов, сыру, масла, бутылку кларету и заплатили рублей шесть."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
