                                "target_senses": [
                                    {
                                        "sense_id": "90bb4480-5573-326f-82d3-39c6765e11de",
                                        "entry_id": "c68c4465-e669-3494-929a-bb9e828a3c32",
                                        "glosses": [
                                            "The mathematics of numbers (integers, rational numbers, real numbers, or complex numbers) under the operations of addition, subtraction, multiplication, and division."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e6f7014-89fe-45f9-b335-88db6c9462b5",
                                                "sense_id": "90bb4480-5573-326f-82d3-39c6765e11de",
                                                "text": "Note that all correctly rounding arithmetics satisfy property A1, as do those with properly truncating addition. All faithful binary arithmetics and all arithmetics with either properly truncating or correctly chopping addition satisfy property A2."
                                            },
                                            {
                                                "example_id": "012aa134-8e92-4dee-b966-6027eedfad87",
                                                "sense_id": "90bb4480-5573-326f-82d3-39c6765e11de",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across.[…]Closer examination showed that some of these pits did, indeed, contain bacteria, and that in several cases these bacteria were dividing and thus, by the perverse arithmetic of biological terminology, multiplying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cec554e-215b-35f5-a2fd-aa9e8a3ca12c",
                                        "entry_id": "c68c4465-e669-3494-929a-bb9e828a3c32",
                                        "glosses": [
                                            "Number theory"
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "arithmetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62c47d61-72df-349d-87f6-d7ad42c78e92",
                                        "entry_id": "e9d41b7e-ada6-39c6-929f-430fcef13937",
                                        "glosses": [
                                            "Increasing or decreasing by an arithmetic progression."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85dbbc0b-5ae6-4d81-9a9d-42ea451563fe",
                                                "sense_id": "62c47d61-72df-349d-87f6-d7ad42c78e92",
                                                "text": "Near-synonym: linear"
                                            },
                                            {
                                                "example_id": "582f61b1-eb9f-49ca-9780-f9e0515efba9",
                                                "sense_id": "62c47d61-72df-349d-87f6-d7ad42c78e92",
                                                "text": "Growth in the most mature markets is likely to be arithmetic; on what rational basis could one hope for exponential growth there?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arithmetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f33d540c-6a9e-3c6b-8418-5b85dd0d91bd",
                                        "entry_id": "c48c3152-e13b-3c08-af15-2e569f066bc5",
                                        "glosses": [
                                            "Of, relating to, or using arithmetic; arithmetical."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c16dd7b-75b2-4855-994e-8945fd640523",
                                                "sense_id": "f33d540c-6a9e-3c6b-8418-5b85dd0d91bd",
                                                "text": "arithmetic geometry"
                                            },
                                            {
                                                "example_id": "b10577ba-f8e7-4466-91fa-a23ba077c7c1",
                                                "sense_id": "f33d540c-6a9e-3c6b-8418-5b85dd0d91bd",
                                                "text": "Moreover, the latest work of Katz, involving the so-called 'Larsen alternative', provides new criteria, of a very arithmetic nature, to (almost) determine the rational monodromy group"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdb4b4e2-8ebb-3721-8f22-8bd8b3bf8544",
                                        "entry_id": "c48c3152-e13b-3c08-af15-2e569f066bc5",
                                        "glosses": [
                                            "Of a progression, mean, etc, computed solely using addition."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
