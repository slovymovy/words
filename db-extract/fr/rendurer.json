                ],
                "senses": [
                    {
                        "sense_id": "b5a3d260-b7c1-3727-9e6e-d2cc26dda40a",
                        "entry_id": "9948791e-2fbe-3cc6-a3bf-9e2eb7f0373c",
                        "glosses": [
                            "Endurer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b431d76-1ee3-40fc-8282-96ddbeed4803",
                                "sense_id": "b5a3d260-b7c1-3727-9e6e-d2cc26dda40a",
                                "text": "J'ai dû rendurer 3 mois de cauchemars, après m'être blessé à la cheville lors d'un entraînement avec l'équipe de Coupe Davis."
                            },
                            {
                                "example_id": "1f5b12a6-d1f1-4b2d-8818-544c8b2e1a07",
                                "sense_id": "b5a3d260-b7c1-3727-9e6e-d2cc26dda40a",
                                "text": "et je crois pas qu'au fond de toi t'as vrm envie de rendurer ce que t'as vecu avec moi !"
                            },
                            {
                                "example_id": "f42511c7-c125-4d43-8163-c04c4c9d2ffb",
                                "sense_id": "b5a3d260-b7c1-3727-9e6e-d2cc26dda40a",
                                "text": "Je ne voulais pas re-vivre cela , autant me tuer que de rendurer tout cela."
                            },
                            {
                                "example_id": "644c2df1-a372-434f-9666-c929f157c403",
                                "sense_id": "b5a3d260-b7c1-3727-9e6e-d2cc26dda40a",
                                "text": "Après tout ce qu'il a renduré, il est tout à fait légitime que Fitz veulent épargner ça à sa fille, bien que certains des arguments de Devoir soient valables."
                            }
                        ]
                    }
