{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01cea1c4-0c47-32fb-b1f3-d9ccfbb449cc",
                    "sense_definition": "A person from the Tyneside region of England.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Geordie</w> was very proud of his hometown.",
                            "target_lang_translations": {
                                "ru": "<w>Джорди</w> очень гордился своим родным городом."
                            }
                        },
                        {
                            "text": "Many a <w>Geordie</w> enjoys watching football in Newcastle.",
                            "target_lang_translations": {
                                "ru": "Многие <w>джорди</w> любят смотреть футбол в Ньюкасле."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Refers to people from Tyneside."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Житель региона Тайнсайд в Англии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джорди",
                                "target_lang_sense_clarification": "житель Ньюкасла и окрестностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b342666-d691-39f0-8eb3-84e11d4066d6",
                    "sense_definition": "The regional dialect of English spoken in Tyneside.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "language",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It can be difficult to understand the <w>Geordie</w> accent if you are not from the area.",
                            "target_lang_translations": {
                                "ru": "Бывает трудно понять <w>акцент джорди</w>, если вы не из этих мест."
                            }
                        },
                        {
                            "text": "He spoke with a thick <w>Geordie</w> dialect.",
                            "target_lang_translations": {
                                "ru": "Он говорил с сильным <w>диалектом джорди</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Refers to the dialect of Tyneside."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Региональный диалект английского языка, на котором говорят в Тайнсайде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диалект джорди",
                                "target_lang_sense_clarification": "региональный говор Тайнсайда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09204bfb-88a9-3c70-8616-efac980dc27d",
                    "sense_definition": "A coal miner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>Geordie</w> spent his entire life working in the deep mines.",
                            "target_lang_translations": {
                                "ru": "Старый <w>шахтер</w> всю свою жизнь проработал в глубоких шахтах."
                            }
                        },
                        {
                            "text": "Life was hard for a <w>Geordie</w> in the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Жизнь <w>шахтера</w> в девятнадцатом веке была тяжелой."
                            }
                        }
                    ],
                    "synonyms": [
                        "miner",
                        "pitman"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical term for a coal miner."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Угольщик, шахтер (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шахтер",
                                "target_lang_sense_clarification": "устаревшее обозначение горняка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b33c6f4b-dfb1-3217-bec7-622eea774b0d",
                    "sense_definition": "A gold coin formerly used in Britain, worth one pound and one shilling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He paid for the goods with a single <w>Geordie</w>.",
                            "target_lang_translations": {
                                "ru": "Он расплатился за товары одной <w>гинеей</w>."
                            }
                        },
                        {
                            "text": "The antique shop owner accepted the <w>Geordie</w> as payment.",
                            "target_lang_translations": {
                                "ru": "Владелец антикварного магазина принял <w>гинею</w> в качестве оплаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "guinea"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Refers to a historical coin."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Золотая монета, использовавшаяся в Британии, достоинством в один фунт и один шиллинг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гинея",
                                "target_lang_sense_clarification": "историческая британская монета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "099817bd-a20b-333d-bda0-47f3c92d65e0",
                    "sense_definition": "A safety lamp used by miners.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miner carried his <w>Geordie</w> into the dark tunnel.",
                            "target_lang_translations": {
                                "ru": "Шахтер понес свою <w>лампу</w> в темный туннель."
                            }
                        },
                        {
                            "text": "The invention of the <w>Geordie</w> helped prevent explosions in mines.",
                            "target_lang_translations": {
                                "ru": "Изобретение <w>шахтерской лампы</w> помогло предотвратить взрывы в шахтах."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical mining equipment."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Безопасная шахтерская лампа (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шахтерская лампа",
                                "target_lang_sense_clarification": "исторический тип лампы для шахт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70b4f279-f37a-32e0-8ba0-bac94eef0ac2",
                    "sense_definition": "A ship used for transporting coal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Geordie</w> sailed down the coast loaded with coal.",
                            "target_lang_translations": {
                                "ru": "<w>Углевоз</w> плыл вдоль побережья, груженный углем."
                            }
                        },
                        {
                            "text": "Many a <w>Geordie</w> was seen in the harbor during the industrial era.",
                            "target_lang_translations": {
                                "ru": "Многие <w>углевозы</w> можно было увидеть в гавани в эпоху индустриализации."
                            }
                        }
                    ],
                    "synonyms": [
                        "collier"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical term for a coal ship."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Судно для перевозки угля (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "углевоз",
                                "target_lang_sense_clarification": "судно для транспортировки угля"
                            }
                        ]
                    }
                }
            ]
        },
        {
