                                            {
                                                "example_id": "de8e25e2-1dbc-48a8-bfda-bfa8f03067a7",
                                                "sense_id": "f5d3aff1-8be5-3ffa-b4d3-3f369499546b",
                                                "text": "Dit zijn de oudst bekende overblijfselen."
