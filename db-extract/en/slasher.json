                "entry_id": "4a53f558-8207-30a1-885c-93d7c7d7f9df",
                "word": "slasher",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "135d078c-8e41-483b-a9e9-5e5ab0f94a5c",
