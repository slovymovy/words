                        "examples": [
                            {
                                "example_id": "5d0f40fc-fbc5-44b6-a751-d107c5acdff3",
                                "sense_id": "d27164d3-ce89-3104-bc39-618218e7d21d",
                                "text": ",,De spoortechniek dateert op veel plekken van net na de oorlog. Vergelijk het met de zwart-wittelevisie. We moeten met onze tijd mee, ook qua kennis. In Duitsland worden waterstoftreinen, die hun eigen elektriciteit opwekken, al getest. Nederland mag niet achterblijven."
                            },
                            {
                                "example_id": "1dace921-368f-44ea-b55b-263e2d793b79",
                                "sense_id": "d27164d3-ce89-3104-bc39-618218e7d21d",
                                "text": "In 1973 keken we nog grotendeels zwart-wittelevisie, zat een telefoon aan een draad onder de grond en vonden we macaroni al behoorlijk exotisch."
                            }
                        ]
                    }
