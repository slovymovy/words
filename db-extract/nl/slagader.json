                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2405c9c-5be0-4233-8a59-1364aafc7848",
                        "source_entry_id": "1eabf3a1-c13f-3a05-8308-0c6446d1f6e5",
                        "source_sense_id": "2b456d92-1632-350e-8fee-0a868d068d31",
                        "source_sense_description": "een ader die van het hart af stroomt",
                        "target_lang_word": "Arterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9820d0e-a487-38bf-930b-46fa463fabad",
                                        "entry_id": "3cf4e3b1-7309-3024-9478-2b278e163060",
                                        "glosses": [
                                            "Schlagader; Blutgefäß, das das Blut vom Herzen in den Körper führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e669680-fab7-431b-b5a6-ace9fac2ed28",
                                                "sense_id": "d9820d0e-a487-38bf-930b-46fa463fabad",
                                                "text": "Die Aorta ist die größte Arterie."
                                            },
                                            {
                                                "example_id": "cd461736-b16c-4c99-b673-a08770fc0e6b",
                                                "sense_id": "d9820d0e-a487-38bf-930b-46fa463fabad",
                                                "text": "„Die anderen schmieren sich bioaktives Streichfett unnötigerweise aufs Brot - und das, obwohl neuere Studien darauf hindeuten, dass zu viele der pflanzlichen Blutfettsenker die Arterien womöglich ähnlich verkalken lassen wie das Cholesterin selbst.“"
                                            },
                                            {
                                                "example_id": "d99ef9e0-8a0a-49f0-9235-61b6fece8925",
                                                "sense_id": "d9820d0e-a487-38bf-930b-46fa463fabad",
                                                "text": "„In seinem Ungeschick verletzte er eine Arterie; das führte zu einer Blutung, die er nur mit vieler Mühe stillte, und die mir ohne das Einschreiten des Bologneser Arztes Algardi, der im Dienst des Fürstbischofs von Augsburg stand, den Tod gebracht hätte.“"
                                            },
                                            {
                                                "example_id": "3c62431b-ab0c-499c-a5f4-da313a4d83e5",
                                                "sense_id": "d9820d0e-a487-38bf-930b-46fa463fabad",
                                                "text": "„Ravic drückte die Arterie ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd50360b-f1d7-44a9-b26b-38a998d42301",
                        "source_entry_id": "1eabf3a1-c13f-3a05-8308-0c6446d1f6e5",
                        "source_sense_id": "2b456d92-1632-350e-8fee-0a868d068d31",
                        "source_sense_description": "een ader die van het hart af stroomt",
                        "target_lang_word": "artery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9480dcc-9263-3033-b475-2255621be000",
                                        "entry_id": "58e5d77b-920d-3c1e-a5bd-8217bdbab731",
                                        "glosses": [
                                            "Any of the muscular- and elastic-walled blood vessels forming part of the circulation system by which blood is conveyed away from the heart regardless of its oxygenation status; see pulmonary artery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cefa7db6-229e-4b8f-87ef-8ff164e845c4",
                                                "sense_id": "e9480dcc-9263-3033-b475-2255621be000",
                                                "text": "As we age, the major arteries of our bodies frequently become thickened with plaque, a fatty material with an oatmeal-like consistency that builds up along the inner lining of blood vessels. The reason plaque forms isn’t entirely known, but it seems to be related to high levels of cholesterol inducing an inflammatory response, which can also attract and trap more cellular debris over time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a04ef63-d136-3266-bc8c-6362866a3032",
                                        "entry_id": "58e5d77b-920d-3c1e-a5bd-8217bdbab731",
                                        "glosses": [
                                            "A major transit corridor in a system of roads, rivers, or railway lines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e5a3256-a33b-4330-b4e4-083aa6dfc33e",
                                                "sense_id": "4a04ef63-d136-3266-bc8c-6362866a3032",
                                                "text": "But the importance of the railways as main arteries of the national economy remains undimmed, just as their fascination for the railway enthusiast is surely undiminished."
                                            },
                                            {
                                                "example_id": "340fc4bf-451a-48ab-8b6c-db3fe263f210",
                                                "sense_id": "4a04ef63-d136-3266-bc8c-6362866a3032",
                                                "text": "Premier Chiang Ching-kuo said October 12 that the North-South Freeway, a 373-kilometer (235-mile) artery along west Taiwan, will have to be completed on schedule by 1978.",
                                                "translation": "自由中國週報",
                                                "english": "自由中國週報"
                                            },
                                            {
                                                "example_id": "3fa8aefa-c2bf-442a-9065-1be614a4ae3b",
                                                "sense_id": "4a04ef63-d136-3266-bc8c-6362866a3032",
                                                "text": "The 98-mile Edinburgh-Carlisle 'Waverley Route' provided over a century of service as an Anglo-Scottish artery, prior to its closure by British Rail, and its loss provoked anger in the Scottish Borders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b547b59-24bc-4d63-a278-22333245715d",
                        "source_entry_id": "1eabf3a1-c13f-3a05-8308-0c6446d1f6e5",
                        "source_sense_id": "2b456d92-1632-350e-8fee-0a868d068d31",
                        "source_sense_description": "een ader die van het hart af stroomt",
                        "target_lang_word": "artère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70bb46cd-71e0-3ab3-b9fa-04c95aa821f7",
                                        "entry_id": "734989bc-60ab-33d4-8835-160470d140e4",
                                        "glosses": [
                                            "Tube musculaire, élastique et contractile dans lequel le sang, projeté par les contractions du cœur, est porté dans tous les organes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0126ec16-f87e-4fcc-a951-f50fc0a886e5",
                                                "sense_id": "70bb46cd-71e0-3ab3-b9fa-04c95aa821f7",
                                                "text": "Haro sur l’huile de palme, accusée de contribuer à la déforestation et d’être nocive pour nos artères."
                                            },
                                            {
                                                "example_id": "722f5eb2-d886-4b0d-ad82-259345c33c1d",
                                                "sense_id": "70bb46cd-71e0-3ab3-b9fa-04c95aa821f7",
                                                "text": "L’artère médiane est le principal vaisseau qui alimente en sang l’avant-bras et la main lorsque le bébé se forme dans l’utérus de la mère, mais elle fait place à deux artères au cours du développement dans l’utérus, la radiale et la cubitale."
                                            },
                                            {
                                                "example_id": "2fef1638-6eaf-4e53-8ee9-fbcf29bd7cba",
                                                "sense_id": "70bb46cd-71e0-3ab3-b9fa-04c95aa821f7",
                                                "text": "Artère pulmonaire."
                                            },
                                            {
                                                "example_id": "a2796e18-dbf4-49db-9b01-f3a2987d292c",
                                                "sense_id": "70bb46cd-71e0-3ab3-b9fa-04c95aa821f7",
                                                "text": "Il eut l’artère coupée."
                                            },
                                            {
                                                "example_id": "eda134b9-73a5-466a-b678-9268cd58fac2",
                                                "sense_id": "70bb46cd-71e0-3ab3-b9fa-04c95aa821f7",
                                                "text": "Battement d’artère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed1f02fc-7a29-318e-8da7-95107a1856d6",
                                        "entry_id": "734989bc-60ab-33d4-8835-160470d140e4",
                                        "glosses": [
                                            "Voies de communication et de circulation les plus fréquentées."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef1c78c-d911-4bc1-8af7-cf273c05c056",
                                                "sense_id": "ed1f02fc-7a29-318e-8da7-95107a1856d6",
                                                "text": "Les principales artères de la ville sont pavées de bois ou macadamisées ; […]."
                                            },
                                            {
                                                "example_id": "ca0973a5-0509-4ec3-8d11-cbfd5924e38c",
                                                "sense_id": "ed1f02fc-7a29-318e-8da7-95107a1856d6",
                                                "text": "On comprenait alors pourquoi les commerces de chapeaux et de chaussures existent en aussi grand nombre dans cette artère grouillante et relativement courte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a3f5797-bf4b-3f43-ac45-b27b77a2a34c",
                                        "entry_id": "734989bc-60ab-33d4-8835-160470d140e4",
                                        "glosses": [
                                            "Ensemble des infrastructures constitutives d'un tronçon de câbles."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e8746b-f3d5-4443-976e-6b7b9c3d4b6c",
                                                "sense_id": "8a3f5797-bf4b-3f43-ac45-b27b77a2a34c",
                                                "text": "Les éventuelles opérations d’élagage nécessaires avant toute pose de câble seront à la charge de l’Opérateur. (y.c toutes les démarches en vue d’obtenir les autorisations préalables nécessaires). L’élagage réalisé devra permettre de sécuriser l’ensemble des câbles présents sur l’artère."
                                            },
                                            {
                                                "example_id": "404a27aa-a175-431e-8b31-0e3b83b7366f",
                                                "sense_id": "8a3f5797-bf4b-3f43-ac45-b27b77a2a34c",
                                                "text": "Lorsqu’il est possible de disposer de deux câbles souterrains en parallèle pour alimenter un poste, on utilise un tableau MT similaire à celui du poste en coupure d’artère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
