                                                "sense_id": "88380e28-840a-3ded-ada6-470cc8c0cad6",
                                                "text": "Die Ackerschmalwand, ein unscheinbares Pflänzchen, ist ein wichtiger Modellorganismus für die botanische Forschung."
                                            },
                                            {
                                                "example_id": "2275688f-c9d7-46af-a003-764354bae57d",
                                                "sense_id": "88380e28-840a-3ded-ada6-470cc8c0cad6",
                                                "text": "Gabi kleidet sich meist unscheinbar und steht ungern im Mittelpunkt."
                                            },
                                            {
                                                "example_id": "72488fc1-f0d1-41fc-84cd-c9cd508d0778",
                                                "sense_id": "88380e28-840a-3ded-ada6-470cc8c0cad6",
                                                "text": "„Zwei klassische Dragster stehen rechts, Radstand um die neun Meter, ein futuristisches Motorrad daneben und ein unscheinbarer BMW E 30.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
