                            }
                        },
                        {
                            "text": "De wandelaars zagen een jonge <w>spar</w> aan de rand van het dichte bos.",
                            "target_lang_translations": {
                                "en": "The hikers saw a young <w>fir</w> at the edge of the dense forest."
                            }
                        }
                    ],
                    "common_phrases": [
