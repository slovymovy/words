                "senses": [
                    {
                        "sense_id": "d4c5c142-1027-39ff-a0e4-76581f0aae97",
                        "entry_id": "fee83954-0302-3fb8-a730-c099fafc526b",
                        "glosses": [
                            "Aufgaben-, Fach- oder Wissensgebiet"
