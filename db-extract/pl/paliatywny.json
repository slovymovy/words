                                    {
                                        "sense_id": "bd826d4c-0b80-31ba-a566-e089fc0ede98",
                                        "entry_id": "402228de-823a-368f-9816-8e59a77af593",
                                        "glosses": [
                                            "Something that palliates, particularly a palliative medicine."
