                                                "example_id": "eda24037-5cef-4721-8ed0-a14401f953ff",
                                                "sense_id": "8b14c848-ba67-36a1-83b1-56e4f4ed8c80",
                                                "text": "Bibliographien zur Keltologie sind in den Bibliographischen Handbibliotheken."
                                            },
