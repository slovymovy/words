                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "030d9f75-73fb-30d6-9d42-91211fb100f5",
                        "entry_id": "0196a17e-09a9-32c6-bbe8-08cc86cf804d",
                        "glosses": [
                            "Qui possède des propriétés de supraconduction dans les conditions considérées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aa6f30c-ab48-4f25-b7db-7a692d3f4324",
                                "sense_id": "030d9f75-73fb-30d6-9d42-91211fb100f5",
                                "text": "Le mercure est supraconducteur en dessous de 4,15K."
                            },
                            {
                                "example_id": "10e1eb5d-260c-477c-90c1-443a8e7979b5",
                                "sense_id": "030d9f75-73fb-30d6-9d42-91211fb100f5",
                                "text": "Des aimants supraconducteurs remplacent les essieux et des électroaimants sont placés sur les voies."
                            },
                            {
                                "example_id": "b02e9d0d-ba6e-4050-bbca-8800ac2f99e7",
                                "sense_id": "030d9f75-73fb-30d6-9d42-91211fb100f5",
                                "text": "Le détecteur ATLAS exploite un champ magnétique toroïdal (en forme de bouée) engendré par d’immenses aimants supraconducteurs disposés sous la forme de huit douelles et deux disques aux extrémités."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52730950-b9d4-40d6-a162-d1ff2e7212f7",
                        "source_entry_id": "0196a17e-09a9-32c6-bbe8-08cc86cf804d",
                        "target_lang_word": "supraleitend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supraleitend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a42e67f1-18ce-35ae-9ff5-c14714e95ed4",
                                        "entry_id": "c6040a8a-29ce-3d42-b930-7da3856d2288",
                                        "glosses": [
                                            "die Eigenschaft eines Supraleiters besitzend, also elektrischen Strom ab einer bestimmten (niedrigen) Temperatur völlig ohne Widerstand leitend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "affa49fe-3995-4852-819d-b574ebb98664",
                                                "sense_id": "a42e67f1-18ce-35ae-9ff5-c14714e95ed4",
                                                "text": "„Bei Wendelstein 7-X sind diese Spulen supraleitend, d. h. ein einmal eingespeister Strom kann darin ohne elektrischen Widerstand beliebig lange fließen und das Magnetfeld somit dauerhaft aufrechterhalten.“"
                                            },
                                            {
                                                "example_id": "0a3e1ff5-20eb-4353-9877-28d4049daa40",
                                                "sense_id": "a42e67f1-18ce-35ae-9ff5-c14714e95ed4",
                                                "text": "„Seit gut neunzig Jahren ist bekannt, dass bestimmte Metalle bei sehr tiefen Temperaturen von nur einigen Kelvin ihren elektrischen Widerstand verlieren: Sie werden supraleitend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
