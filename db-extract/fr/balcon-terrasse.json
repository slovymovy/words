                    {
                        "sense_id": "792845a6-9aaa-3457-93bf-86ef4ba20b7d",
                        "entry_id": "27096a94-826f-319f-9f8f-1d32b71cf659",
                        "glosses": [
                            "Balcon de grandes dimensions, sur lequel donnent parfois plusieurs ouvertures d’un appartement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3662fac8-217e-404f-8a8c-6a70b8566d04",
                                "sense_id": "792845a6-9aaa-3457-93bf-86ef4ba20b7d",
                                "text": "Le balcon-terrasse.\nAu point de vue de l’horticulture, on peut considérer comme des terrasses ces larges et longs balcons tels qu’il s’en trouve encore quelques-uns dans les quartiers anciens bien aérés, tels qu’il y en a à tous les étages des maisons modernes, dans les rues nouvellement percées."
                            },
                            {
                                "example_id": "31fd5091-b1ac-45aa-b6b7-dac784c317b6",
                                "sense_id": "792845a6-9aaa-3457-93bf-86ef4ba20b7d",
                                "text": "Camille n’aimait pas ce balcon-terrasse réservé à la chatte, limité par deux cloisons de maçonnerie, qui le gardaient du vent et de toute communication avec la terrasse de proue."
                            },
                            {
                                "example_id": "dd04390c-94c2-4579-add6-aa80148081b0",
                                "sense_id": "792845a6-9aaa-3457-93bf-86ef4ba20b7d",
                                "text": "Un balcon-terrasse donne sur la rivière où volettent les lucioles la nuit et où l’on prend son petit-déjeuner le matin."
                            }
                        ]
                    }
                ],
