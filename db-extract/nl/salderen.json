                "forms": [],
                "senses": [
                    {
                        "sense_id": "a0bcdfa0-b8bd-3b62-81f8-beddda0d8877",
                        "entry_id": "930a7220-fa94-3add-a85a-186009bf31d6",
                        "glosses": [
                            "plussen en minnen tegen elkaar wegstrepen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38068bf3-6494-480d-8593-f69939c97754",
                                "sense_id": "a0bcdfa0-b8bd-3b62-81f8-beddda0d8877",
                                "text": "Inmiddels is gebleken dat die bedrijven mogen uitgaan van de gemiddelde uitstoot van ammoniak op hun terrein, intern salderen heet dat. Dit kan betekenen dat er voor bepaalde stallen geen voorzieningen nodig zijn.\""
                            },
                            {
                                "example_id": "374fc4be-9aef-4d81-8996-bba1cd030001",
                                "sense_id": "a0bcdfa0-b8bd-3b62-81f8-beddda0d8877",
                                "text": "Het zogenaamde salderen van fouten is volgens Van Buuren in strijd met de wet, tenzij het om kleinigheden gaat. Uit zijn onderzoek blijkt echter dat ook vaak belangrijke controleverschillen, die invloed hebben op het bedrijfsresultaat, worden genegeerd door de commissarissen."
                            },
                            {
                                "example_id": "23baf222-745b-495d-bc26-40c1970f5d41",
                                "sense_id": "a0bcdfa0-b8bd-3b62-81f8-beddda0d8877",
                                "text": "'Los van de eventuele teruggave van btw op de aankoop, is het een lastig systeem voor particuliere bezitters van zonnepanelen, zeggen Niels Muller, belastingdeskundige op energiegebied en Trudy Perie, btw-specialist bij Loyens & Loeff. 'Nu heb je er met salderen geen omkijken naar."
                            }
                        ]
                    }
