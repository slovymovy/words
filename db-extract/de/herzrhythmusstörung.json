                "senses": [
                    {
                        "sense_id": "97b352a1-b26c-3359-8dda-14a8eeb308a0",
                        "entry_id": "a27bdd9e-2ebb-30da-b228-7908a52accca",
                        "glosses": [
                            "Abweichung vom normalen Herzschlagrhythmus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8942e501-89bc-4a3d-80fc-c4074226d2dc",
                                "sense_id": "97b352a1-b26c-3359-8dda-14a8eeb308a0",
                                "text": "„Der eine flüchtet in Drogen, der andere bekommt Herzrhythmusstörungen, der dritte wird fresssüchtig.“"
                            },
                            {
                                "example_id": "c12aebad-119f-48bc-ae2f-f40ccf345be4",
                                "sense_id": "97b352a1-b26c-3359-8dda-14a8eeb308a0",
                                "text": "„Die Herzrhythmusstörungen traten von Neuem auf, und sein Unterleib blähte sich von der aufgestauten Flüssigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
