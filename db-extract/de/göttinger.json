                        "sense_id": "3b7fe0c7-08ea-3a4e-94a8-46edd46aa8d7",
                        "entry_id": "be130075-a959-39d9-ad76-ab7fc2eacd80",
                        "glosses": [
                            "zu Göttingen gehörig, aus Göttingen stammend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fbd8264-e533-495d-8063-19c3ecaba9a2",
                                "sense_id": "3b7fe0c7-08ea-3a4e-94a8-46edd46aa8d7",
                                "text": "Die Göttinger Georg-August-Universität ist die älteste Universität Niedersachsens."
                            },
                            {
                                "example_id": "7d2217dc-4e26-4b11-8ada-eb53c708de7a",
                                "sense_id": "3b7fe0c7-08ea-3a4e-94a8-46edd46aa8d7",
                                "text": "„Der Göttinger Kaufmann Herbort Hagemann kaufte 1419 auf der zweimal im Jahr stattfindenden Frankfurter Messe bei den berühmten Brüdern Veckinchusen Wachs und Pelze aus dem Baltikum.“"
                            },
                            {
                                "example_id": "6e50c19f-dae2-406d-aef6-c0ea4db1aa47",
                                "sense_id": "3b7fe0c7-08ea-3a4e-94a8-46edd46aa8d7",
                                "text": "„Seine Lieblingsspeisen waren Kabeljau, dicke Erbsen, Teltower Rübchen, Göttinger Wurst und Kaviar, den ihm sein Verleger Hartknoch aus Riga schickte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
