                    "sense_id": "89ead669-ebe4-3a50-97ac-8796d57a35b9",
                    "sense_definition": "Een tijd en plaats vastleggen om iemand te ontmoeten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zullen we volgende week een keer <w>afspreken</w> om bij te praten?",
                            "target_lang_translations": {
                                "en": "Shall we <w>meet up</w> sometime next week to catch up?",
                                "ru": "Может, <w>встретимся</w> как-нибудь на следующей неделе, чтобы поболтать?",
                                "de": "Wollen wir uns nächste Woche mal <w>verabreden</w>, um uns mal wieder zu unterhalten?",
                                "it": "Ci <w>vediamo</w> la prossima settimana per fare due chiacchiere?"
                            }
                        },
                        {
                            "text": "Ik heb met mijn vrienden in het park <w>afgesproken</w>.",
                            "target_lang_translations": {
                                "en": "I <w>arranged to meet</w> my friends in the park.",
                                "ru": "Я <w>договорился встретиться</w> с друзьями в парке.",
                                "de": "Ich habe mich mit meinen Freunden im Park <w>verabredet</w>.",
                                "it": "Mi sono <w>dato appuntamento</w> con i miei amici al parco."
                            }
                        }
                    ],
                    "antonyms": [
                        "afzeggen",
                        "annuleren"
                    ],
                    "common_phrases": [
                        "met vrienden afspreken",
                        "een tijd afspreken",
                        "iets leuks afspreken"
                    ],
                    "target_lang_definitions": {
                        "en": "To set a time and place to meet someone.",
                        "ru": "Назначить время и место для встречи с кем-либо.",
                        "de": "Einen Zeitpunkt und Ort festlegen, um jemanden zu treffen.",
                        "it": "Stabilire un luogo e un orario per incontrarsi con qualcuno."
                    },
