                        "examples": [
                            {
                                "example_id": "6ae87825-13be-45fa-be1a-40f187a4a473",
                                "sense_id": "b8c6cb41-e371-30e5-b921-5fc948058c5d",
                                "text": "„Litvack selbst ging als junge Frau im Auftrag einer Menschenrechtsorganisation nach Afrika, um dort mit Aidskranken zu arbeiten, und sie engagierte sich gegen Korruption.“"
                            },
                            {
                                "example_id": "b0e5c60d-9eba-4789-a792-489e63b31ad0",
                                "sense_id": "b8c6cb41-e371-30e5-b921-5fc948058c5d",
                                "text": "„Die erste Gruppe Aidskranker, Lahmer, Blinder und vom Teufel Besessener hatte der orthodoxe Priester bereits um drei Uhr nachts abgefertigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
