                    {
                        "sense_id": "def56a5a-b367-333f-afb5-5aa6890d6cb6",
                        "entry_id": "2054566c-364a-304c-bb27-ea21470d12f0",
                        "glosses": [
                            "räumliche Stellung der Atome in einem Molekül zueinander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c680d412-c8e2-4213-a28a-e0134655a266",
                                "sense_id": "def56a5a-b367-333f-afb5-5aa6890d6cb6",
                                "text": "Cyclohexan existiert in verschiedenen Konformationen: die Sessel-, die Halbsessel-, die Twist- und die Bootkonformation."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4058c4b-60c9-4b4a-b4ea-f3f40e0008bd",
                        "source_entry_id": "2054566c-364a-304c-bb27-ea21470d12f0",
                        "source_sense_id": "def56a5a-b367-333f-afb5-5aa6890d6cb6",
                        "source_sense_description": "Chemie: räumliche Stellung der Atome in einem Molekül zueinander",
                        "target_lang_word": "conformation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conformation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc34c39-5283-3481-8902-3831a7e3ec68",
                                        "entry_id": "b30231e0-4a15-30fe-bcab-878b7d7f04bb",
                                        "glosses": [
                                            "The act of conforming; the act of producing conformity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef41008c-41b2-323c-a9c6-989253c7ae8a",
                                        "entry_id": "b30231e0-4a15-30fe-bcab-878b7d7f04bb",
                                        "glosses": [
                                            "The state of being conformed; agreement"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f46d38e1-ee90-43ab-8a87-b1a7a242e046",
                                                "sense_id": "ef41008c-41b2-323c-a9c6-989253c7ae8a",
                                                "text": "I was much struck with the gaiety of the creoles , whose exterior told a stranger that education had been doing something among them in these solitudes ; and as all the parties kissed the Bible in conformation with the law of England"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cb1dc42-95a4-3663-a1e1-51db268ff104",
                                        "entry_id": "b30231e0-4a15-30fe-bcab-878b7d7f04bb",
                                        "glosses": [
                                            "Structure, the arrangement of parts of some thing; form; arrangement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7c57d8-df78-443b-befd-3b0c5b17a743",
                                                "sense_id": "8cb1dc42-95a4-3663-a1e1-51db268ff104",
                                                "text": "One may see well the advantages of this form from the coach - box of our heavily - loaded public vehicles , where animals of different conformation are yoked together"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "953027d9-a211-3460-8fd1-c20fb4747f6f",
                                        "entry_id": "b30231e0-4a15-30fe-bcab-878b7d7f04bb",
                                        "glosses": [
                                            "The spatial arrangement of a group of atoms in a molecule as a result of rotation about a covalent bond which remains unbroken."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "973afde9-8bd1-4669-8e7e-886a78732c21",
                                                "sense_id": "953027d9-a211-3460-8fd1-c20fb4747f6f",
                                                "text": "The more stable conformation has the methyl group in an equatorial position , since this minimizes repulsions between axial substituents"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "926b30b9-e26c-4659-8e99-2eed63a8b64c",
                        "source_entry_id": "2054566c-364a-304c-bb27-ea21470d12f0",
                        "source_sense_id": "def56a5a-b367-333f-afb5-5aa6890d6cb6",
                        "source_sense_description": "Chemie: räumliche Stellung der Atome in einem Molekül zueinander",
                        "target_lang_word": "конформация",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "конформация",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6f23848e-073d-3768-ad9a-61117784a0b1",
                                        "entry_id": "75347ee7-ee91-3609-8064-98513a11632b",
                                        "glosses": [
                                            "пространственное расположение атомов в молекуле определенной конфигурации, обусловленное поворотом вокруг одной или нескольких одинарных сигма-связей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6223ecd-c0a4-4511-bd88-1889e33a7d86",
                                                "sense_id": "6f23848e-073d-3768-ad9a-61117784a0b1",
                                                "text": "Но для сложных терпеноидов, содержащих в своей структуре полизамещенные циклы, и в особенности — для среднециклических производных, стабильные конформации молекулы далеко не всегда в точности соответствуют заторможенным конформациям по всем подвижным фрагментам, и внутрициклические торсионные углы для стабильных конформаций могут принимать практически любые значения в интервале f=0-180°, в зависимости от структуры молекулы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
