                                "target_senses": [
                                    {
                                        "sense_id": "d5823509-82f6-3f61-ba03-deff3fe3b22d",
                                        "entry_id": "dddeba0a-f3a5-3cec-b2c8-238f245928dc",
                                        "glosses": [
                                            "A person suffering from a delusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
