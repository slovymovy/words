                        "cross_references": [
                            {
                                "target_word": "régalec",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fab5986a-473f-387c-9403-d78d7d8b4952",
                                        "entry_id": "eb41dead-7451-3134-a75a-618f817183bd",
                                        "glosses": [
                                            "Poisson pélagique de la famille des régalecidés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e68b165-a636-47a1-acf7-257c02e06f5f",
                                                "sense_id": "fab5986a-473f-387c-9403-d78d7d8b4952",
                                                "text": "Le régalec vivant habituellement entre 200 mètres et 1 km de profondeur, avait rarement été observé dans son milieu naturel, jusqu’à ce qu’il soit filmé à cinq reprises entre 2008 et de 2011 par un robot submersible appartenant à une plate-forme pétrolière située dans le Golfe du Mexique."
                                            },
                                            {
                                                "example_id": "a0f26b31-e7ae-4eea-9b4a-89565bc6f3f9",
                                                "sense_id": "fab5986a-473f-387c-9403-d78d7d8b4952",
                                                "text": "Je repris ma respiration pour ajouter que le fait de voir un régalec, c’était presque aussi fou que de découvrir un calmar géant, qu’ils pouvaient atteindre quinze mètres de long, qu’ils nageaient presque à la verticale et plongeaient comme des enclumes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
