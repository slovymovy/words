                ],
                "translations": [
                    {
                        "translation_id": "fe9e6e03-7e9a-400c-a4ef-ae57e3164b29",
                        "source_entry_id": "5f306cb0-8070-33f8-969a-a794873cbc69",
                        "source_sense_description": "получать знания о чём-либо; постигать, изучать что-либо",
                        "target_lang_word": "cognize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cognize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b6d0660-abdd-33ee-95ce-c1f3e955facd",
                                        "entry_id": "ddf7163f-059f-3e00-8366-d971fc94b110",
                                        "glosses": [
                                            "To know, perceive, or become aware of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebef4007-bdd3-44f2-96f7-42bcd12cf013",
                                                "sense_id": "4b6d0660-abdd-33ee-95ce-c1f3e955facd",
                                                "text": "[T]hey must possess organs of sight—some method of cognizing their environment—akin to that of vision in man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7edd26c-0e12-3980-8aa3-13e5950e9ad0",
                                        "entry_id": "ddf7163f-059f-3e00-8366-d971fc94b110",
                                        "glosses": [
                                            "To make into an object of cognition (the process of acquiring knowledge through thought); to cogitate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4a57a8f-5870-4c63-b716-89fa64c7be31",
                                                "sense_id": "c7edd26c-0e12-3980-8aa3-13e5950e9ad0",
                                                "text": "Cognizing about mind is a ubiquitous human activity; we consistently construe each other as agents undertaking intentional action based on our underlying beliefs and desires (and not as \"bags of skin stuffed into pieces of cloth\")"
                                            },
                                            {
                                                "example_id": "d22b6186-5d4a-4d4e-aa94-983343c8b125",
                                                "sense_id": "c7edd26c-0e12-3980-8aa3-13e5950e9ad0",
                                                "text": "“Thinking a lot” also involves other types of cognizing as well, such as cognizing about depressive themes such as being left by a wife for another man or being separated from relatives."
                                            },
                                            {
                                                "example_id": "89277d5d-468b-4f37-a2b8-805329f0d270",
                                                "sense_id": "c7edd26c-0e12-3980-8aa3-13e5950e9ad0",
                                                "text": "The act of consciously knowing about consciousness is the act of the brain mirroring its own organizations, cognizing about its own cognizing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7eee9c08-08c6-4e1f-a182-fcac2bb561a6",
                        "source_entry_id": "5f306cb0-8070-33f8-969a-a794873cbc69",
                        "source_sense_description": "испытывать, переживать, ощущать",
                        "target_lang_word": "experience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "experience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c301d9c6-131d-361d-bf20-ddb07c642b8f",
                                        "entry_id": "c86d4dba-067c-353e-95bc-a958fa4e0eb0",
                                        "glosses": [
                                            "The effect upon the judgment or feelings produced by any event, whether witnessed or participated in; personal and direct impressions as contrasted with description or fancies; personal acquaintance; actual enjoyment or suffering."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b29a206-1fd8-4f12-90ca-4b1d8bc51768",
                                                "sense_id": "c301d9c6-131d-361d-bf20-ddb07c642b8f",
                                                "text": "It was an experience he would not soon forget."
                                            },
                                            {
                                                "example_id": "a159c3c2-8433-44f2-a0c4-8e967efba13a",
                                                "sense_id": "c301d9c6-131d-361d-bf20-ddb07c642b8f",
                                                "text": "March 20, 1684-5, John Sharp, Sermon preached at Whitehall\nThose that undertook the religion of our Savior upon his preaching, had no experience of it."
                                            },
                                            {
                                                "example_id": "e566fde9-dade-47ec-9f1b-08aa20236dff",
                                                "sense_id": "c301d9c6-131d-361d-bf20-ddb07c642b8f",
                                                "text": "“I have tried, as I hinted, to enlist the co-operation of other capitalists, but experience has taught me that any appeal is futile that does not impinge directly upon cupidity. […]”"
                                            },
                                            {
                                                "example_id": "f90a62ab-9e34-49c4-bc43-dbf9a1809171",
                                                "sense_id": "c301d9c6-131d-361d-bf20-ddb07c642b8f",
                                                "text": "Lastly, I must mention the \"Underground,\" to travel on which was, in those days, an experience to be remembered. There were the antique looking engines, and the rather grim carriages, with the fascinating indicators in the compartments to show (not always correctly!) the next station, and above all, there was the atmosphere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a16318c0-fc31-3d4f-b31f-d06340f0b77e",
                                        "entry_id": "c86d4dba-067c-353e-95bc-a958fa4e0eb0",
                                        "glosses": [
                                            "An activity one has performed."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ccb86bf-bf65-3f42-9eb6-80c98424c62d",
                                        "entry_id": "c86d4dba-067c-353e-95bc-a958fa4e0eb0",
                                        "glosses": [
                                            "A collection of events and/or activities from which an individual or group may gather knowledge, opinions, and skills."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03f2cd92-2d6a-4d86-9af5-116eb5a5a1c0",
                                                "sense_id": "9ccb86bf-bf65-3f42-9eb6-80c98424c62d",
                                                "text": "Virtually all employers now require jobseekers to have work experience even for entry-level roles. Many believe this will hurt companies in the long run."
                                            },
                                            {
                                                "example_id": "2650eac5-7d1b-4205-9665-5da769f7c6bb",
                                                "sense_id": "9ccb86bf-bf65-3f42-9eb6-80c98424c62d",
                                                "text": "they knew soone by experience how slenderly guarded against danger, the majestie of Rulers is"
                                            },
                                            {
                                                "example_id": "e6af54a3-3711-4c8f-8f03-0bed4a3f31e8",
                                                "sense_id": "9ccb86bf-bf65-3f42-9eb6-80c98424c62d",
                                                "text": "Whence has it all the materials of reason and knowledge? To this I answer in one word, from experience."
                                            },
                                            {
                                                "example_id": "3bd7838d-cafa-4bc4-b979-035353602b4d",
                                                "sense_id": "9ccb86bf-bf65-3f42-9eb6-80c98424c62d",
                                                "text": "We determined that the car driver’s transportation of multiple teen passengers, limited driving experience, and likely impairment from effects of cannabis at the time of the crash adversely affected her judgment of the danger of entering the intersection in front of the approaching combination vehicle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "684fef36-652a-33b0-a1b4-6f55ba4150f0",
                                        "entry_id": "c86d4dba-067c-353e-95bc-a958fa4e0eb0",
                                        "glosses": [
                                            "The knowledge thus gathered."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27976dba-7db4-4c12-9622-cab52112f087",
                                                "sense_id": "684fef36-652a-33b0-a1b4-6f55ba4150f0",
                                                "text": "In his submission to the UN, [Christof] Heyns points to the experience of drones. Unmanned aerial vehicles were intended initially only for surveillance, and their use for offensive purposes was prohibited, yet once strategists realised their perceived advantages as a means of carrying out targeted killings, all objections were swept out of the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ca9439e-db29-3f34-bae3-f9672527342b",
                                        "entry_id": "c86d4dba-067c-353e-95bc-a958fa4e0eb0",
                                        "glosses": [
                                            "Synonym of experience points"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c429b2ef-e93a-45b1-9e1e-3e84ce91a3d7",
                                                "sense_id": "1ca9439e-db29-3f34-bae3-f9672527342b",
                                                "text": "As your troops conquer the enemy, they'll earn experience and gain levels. Each time they level up, their stats will increase."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54a20e8c-6cf6-3ea9-be3e-5c0b93157d82",
                                        "entry_id": "c86d4dba-067c-353e-95bc-a958fa4e0eb0",
                                        "glosses": [
                                            "Trial; a test or experiment."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f9f09ff-da66-4aae-b7e1-c9a7ac4c6fab",
                                                "sense_id": "54a20e8c-6cf6-3ea9-be3e-5c0b93157d82",
                                                "text": "She caused him to make experience / Vpon wyld beasts, which she in woods did find, / With wrongfull powre oppressing others of their kind"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "experience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3be49e-e3fd-3811-a8b0-b0d7c9e5e45c",
                                        "entry_id": "8bb72adf-2ce0-3ed7-8ba9-7a290581b599",
                                        "glosses": [
                                            "To observe certain events; undergo a certain feeling or process; or perform certain actions that may alter one or contribute to one's knowledge, opinions, or skills."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab96fa6d-b21c-4cf8-a4e3-d1154bdae744",
                                                "sense_id": "7c3be49e-e3fd-3811-a8b0-b0d7c9e5e45c",
                                                "text": "A 2022 report published by the Scottish Borders Council states: \"Hawick has been affected more by depopulation than any other Borders town, with all parts of the town experiencing population loss, and Hawick Central is currently experiencing the highest depopulation out of the 30 Intermediate Zones in Scottish Borders.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eede4514-5651-4d86-a435-ca8c1e65e80c",
                        "source_entry_id": "5f306cb0-8070-33f8-969a-a794873cbc69",
