    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ccedbb62-3581-3541-ac22-3bcfb09ab6a2",
                    "sense_definition": "korrelig en los van structuur, niet samenhangend (vaak gezegd van zand of sneeuw)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "structuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het lopen op het <w>rulle</w> zand van de duinen was erg vermoeiend.",
                            "target_lang_translations": {
                                "en": "Walking on the <w>loose</w> sand of the dunes was very tiring.",
                                "ru": "Ходьба по <w>рыхлому</w> песку дюн очень утомляла."
                            }
                        },
                        {
                            "text": "Door de harde wind lag er een dikke laag <w>rul</w> zand op het fietspad.",
                            "target_lang_translations": {
                                "en": "Due to the strong wind, there was a thick layer of <w>loose</w> sand on the bicycle path.",
                                "ru": "Из-за сильного ветра на велосипедной дорожке лежал толстый слой <w>сыпучего</w> песка."
                            }
                        }
                    ],
                    "synonyms": [
                        "korrelig",
                        "los"
                    ],
                    "antonyms": [
                        "vast",
                        "samenhangend"
                    ],
                    "common_phrases": [
                        "rul zand",
                        "rulle sneeuw"
                    ],
                    "target_lang_definitions": {
                        "en": "granular and loose in structure, not cohesive (often said of sand or snow)",
                        "ru": "зернистый и рыхлый по структуре, несвязный (часто о песке или снеге)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "loose",
                                "target_lang_sense_clarification": "not compact, like sand or gravel"
                            },
                            {
                                "target_lang_word": "coarse",
                                "target_lang_sense_clarification": "composed of large particles"
                            },
                            {
                                "target_lang_word": "granular",
                                "target_lang_sense_clarification": "having a grainy or loose texture"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рыхлый",
                                "target_lang_sense_clarification": "о песке, снеге, почве"
                            },
                            {
                                "target_lang_word": "сыпучий",
                                "target_lang_sense_clarification": "о песке"
                            },
                            {
                                "target_lang_word": "зернистый",
                                "target_lang_sense_clarification": "о структуре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49a23cf9-cac2-3a5a-922b-e1a2241c785b",
                    "sense_definition": "met een ongelijkmatig, ruw of bobbelig oppervlak",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "structuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude muur voelde erg <w>rul</w> en oneffen aan.",
                            "target_lang_translations": {
                                "en": "The old wall felt very <w>rough</w> and uneven.",
                                "ru": "Старая стена казалась очень <w>шероховатой</w> и неровной на ощупь."
                            }
                        },
                        {
                            "text": "Hij streek met zijn hand over het <w>rulle</w> oppervlak van de boomstam.",
                            "target_lang_translations": {
                                "en": "He ran his hand over the <w>rough</w> surface of the tree trunk.",
                                "ru": "Он провел рукой по <w>шероховатой</w> поверхности ствола дерева."
                            }
                        }
                    ],
                    "synonyms": [
