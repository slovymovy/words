                                "target_senses": [
                                    {
                                        "sense_id": "196563ae-a11f-36e3-b820-f0cd994adfd0",
                                        "entry_id": "7e35411b-571f-3de4-8b03-4e59f9e3f379",
                                        "glosses": [
