                    "frequency": "Low",
                    "semantic_group_id": "passenger_or_guest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conference venue can comfortably accommodate up to five hundred <w>pax</w>.",
                            "target_lang_translations": {
                                "zh": "会议场地最多可舒适容纳五百<w>人</w>。"
