{
    "word_family": [
        "withdrawal",
        "withdrawer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af95a64b-cfaf-3f3d-a7dc-429c5212202e",
                    "sense_definition": "Past participle of <w>withdraw</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The troops have <w>withdrawn</w> from the border region.",
                            "target_lang_translations": {
                                "ru": "Войска <w>отошли</w> от приграничного района.",
                                "zh": "军队已经从边境地区<w>撤离</w>了。"
                            }
                        },
                        {
                            "text": "She has <w>withdrawn</w> all the money from her savings account.",
                            "target_lang_translations": {
                                "ru": "Она <w>сняла</w> все деньги со своего сберегательного счета.",
                                "zh": "她已经把储蓄账户里的钱全部<w>取出</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "has withdrawn",
                        "have withdrawn",
                        "be withdrawn"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола withdraw (отзывать, снимать, уходить).",
                        "zh": "动词 withdraw 的过去分词形式，表示撤离、取款或撤回。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выведенный",
                                "target_lang_sense_clarification": "о войсках или технике"
                            },
                            {
                                "target_lang_word": "снятый",
                                "target_lang_sense_clarification": "о деньгах со счета"
                            },
                            {
                                "target_lang_word": "отозванный",
                                "target_lang_sense_clarification": "о заявлении, согласии или кандидатуре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撤离",
                                "target_lang_sense_clarification": "指军队或人员离开某地"
                            },
                            {
                                "target_lang_word": "取出",
                                "target_lang_sense_clarification": "指从账户中提取资金"
                            },
                            {
                                "target_lang_word": "撤回",
                                "target_lang_sense_clarification": "指收回声明、提议或候选资格"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "33fe89e1-ced1-3f37-b6b1-b2ad8aa044c7",
                    "sense_definition": "Introverted and not inclined to interact with other people.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the accident, he became quiet and <w>withdrawn</w>.",
                            "target_lang_translations": {
                                "ru": "После аварии он стал тихим и <w>замкнутым</w>.",
                                "zh": "事故发生后，他变得沉默且<w>孤僻</w>。"
                            }
                        },
                        {
                            "text": "The teacher noticed a <w>withdrawn</w> child sitting alone in the corner.",
                            "target_lang_translations": {
                                "ru": "Учитель заметил <w>замкнутого</w> ребенка, сидящего в одиночестве в углу.",
                                "zh": "老师注意到一个<w>内向</w>的孩子独自坐在角落里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "introverted",
                        "reserved",
                        "shy",
                        "unsociable"
                    ],
                    "antonyms": [
                        "outgoing",
                        "sociable",
                        "extroverted"
                    ],
                    "common_phrases": [
                        "become withdrawn",
                        "socially withdrawn",
                        "emotionally withdrawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Замкнутый, погруженный в себя, не склонный к общению с другими людьми.",
                        "zh": "形容性格内向、不愿与人交往的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замкнутый",
                                "target_lang_sense_clarification": "о характере человека"
                            },
                            {
                                "target_lang_word": "ушедший в себя",
                                "target_lang_sense_clarification": "погруженный в свои мысли"
                            },
                            {
                                "target_lang_word": "необщительный",
                                "target_lang_sense_clarification": "избегающий контактов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内向",
                                "target_lang_sense_clarification": "指性格不外向"
                            },
                            {
                                "target_lang_word": "孤僻",
                                "target_lang_sense_clarification": "指性格孤傲、不合群"
                            },
                            {
                                "target_lang_word": "沉默寡言",
                                "target_lang_sense_clarification": "指不爱说话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1876f46d-a373-396f-bf36-22e88eb41a85",
                    "sense_definition": "Removed from use or circulation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The library is selling old <w>withdrawn</w> books for a low price.",
                            "target_lang_translations": {
                                "ru": "Библиотека распродает старые <w>списанные</w> книги по низкой цене.",
                                "zh": "图书馆正在低价出售旧的<w>报废</w>书籍。"
                            }
                        },
                        {
                            "text": "These <w>withdrawn</w> banknotes are no longer accepted as legal tender.",
                            "target_lang_translations": {
                                "ru": "Эти <w>изъятые</w> из обращения банкноты больше не принимаются в качестве законного платежного средства.",
                                "zh": "这些已<w>回收</w>的纸币不再被视为法定货币。"
                            }
                        }
                    ],
                    "synonyms": [
                        "removed",
                        "recalled"
                    ],
                    "antonyms": [
                        "circulated",
                        "available"
                    ],
                    "common_phrases": [
                        "withdrawn from circulation",
                        "withdrawn product"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изъятый из употребления или обращения.",
                        "zh": "指从使用或流通中移除的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изъятый",
                                "target_lang_sense_clarification": "выведенный из оборота"
                            },
                            {
                                "target_lang_word": "списанный",
                                "target_lang_sense_clarification": "о книгах или оборудовании"
                            },
                            {
                                "target_lang_word": "отозванный",
                                "target_lang_sense_clarification": "о товарах с дефектом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下架",
                                "target_lang_sense_clarification": "指商品从市场或流通中撤出"
                            },
                            {
                                "target_lang_word": "报废",
                                "target_lang_sense_clarification": "指书籍或设备因不再使用而处理"
                            },
                            {
                                "target_lang_word": "回收",
                                "target_lang_sense_clarification": "指因缺陷或政策原因收回产品"
                            }
                        ]
                    }
                }
            ]
        }
    ]
