                ],
                "senses": [
                    {
                        "sense_id": "fdd01cb0-2e1d-3fdb-a63d-59177dbed3c7",
                        "entry_id": "16dc9f31-8449-36e1-a28e-d96373aca31b",
                        "glosses": [
                            "Teil eines Klettverschlusses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "375e79b5-17fd-44f4-84d8-5026d11c63e1",
                                "sense_id": "fdd01cb0-2e1d-3fdb-a63d-59177dbed3c7",
                                "text": "„Die Aufnahmen für Zeigefinger und Daumen bestehen aus jeweils einer ergonomisch angepassten Auflagefläche, die mit einem Hakenband für einen Klettverschluss versehen ist.“"
                            },
                            {
                                "example_id": "dc5272bd-bdd9-4933-a786-17d92fec783d",
                                "sense_id": "fdd01cb0-2e1d-3fdb-a63d-59177dbed3c7",
                                "text": "„[…],herkömmliche Verschlüsse durch Klett- und Hakenband oder durch Gummiband ersetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d771d7e5-de7a-338e-8d0d-82f557edf788",
                        "entry_id": "16dc9f31-8449-36e1-a28e-d96373aca31b",
                        "glosses": [
                            "eine bandartige Verzierung auf antiken Gebrauchs- oder Schmuckgegenständen"
                        ],
                        "tags": [
                            "Altertumswissenschaften",
                            "Kunstgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "ba3f9b53-5a83-4a1b-9b57-1f6a3749e3c2",
                                "sense_id": "d771d7e5-de7a-338e-8d0d-82f557edf788",
                                "text": "„Eine Sonderstellung nimmt das Hakenband aus Raum 38a […] ein, wo die Winkel der Haken nicht recht- sondern stumpfwinklig sind. Weil sich diese Abweichung in Piazza Armerina nur in einem Mosaik findet, muss dieses Hakenband innerhalb Piazza Armerina als Unikat und ohne Vergleich geführt werden.“"
                            },
                            {
                                "example_id": "cec51dce-ae32-495f-b7b9-af724653ce80",
                                "sense_id": "d771d7e5-de7a-338e-8d0d-82f557edf788",
                                "text": "„Über der Phiale und unter dem Kekriphalos der Frau ist je eine Rosette aufgemalt. Über den Bildfeldern läuft ein Hakenband um […]“"
                            },
                            {
                                "example_id": "321d2716-f85f-4851-86b3-3385ec684572",
                                "sense_id": "d771d7e5-de7a-338e-8d0d-82f557edf788",
                                "text": "„Wie das Rautenmuster tritt auch das Hakenband auf den Bronzen als fertige und im Grunde unveränderliche Erscheinung auf.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "835131df-6b5e-371f-9aee-f483e96b51a3",
                        "entry_id": "16dc9f31-8449-36e1-a28e-d96373aca31b",
                        "glosses": [
                            "jedes Tür- oder andere Band, das sich um einen Haken oder eine Angel bewegt und deshalb mit einem Ohr versehen ist"
                        ],
                        "tags": [
                            "Schlosserei"
                        ],
                        "examples": [
                            {
                                "example_id": "a4a8b736-cd45-4603-8a49-c2df3ede507d",
                                "sense_id": "835131df-6b5e-371f-9aee-f483e96b51a3",
                                "text": "„Hakenband nennen die Schlosser ein Band, das sich um einen Haken oder Angel bewegt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
