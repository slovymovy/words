                                        "examples": [
                                            {
                                                "example_id": "331343bc-12da-4894-ae29-df91e169533e",
                                                "sense_id": "7cbb5971-e359-377a-88ff-2692f9d26f70",
                                                "text": "Various books have been taken."
                                            },
                                            {
                                                "example_id": "2e3ece61-542c-4b2b-bf02-5f401fdccb77",
                                                "sense_id": "7cbb5971-e359-377a-88ff-2692f9d26f70",
                                                "text": "There are various ways to fix the problem."
                                            },
                                            {
                                                "example_id": "4a217a6a-89f2-428b-b3cc-9c364a83d57a",
                                                "sense_id": "7cbb5971-e359-377a-88ff-2692f9d26f70",
                                                "text": "You have broken various of the rules."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "various",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "644d8373-0155-3357-9b13-bae91e4c4b1e",
                                        "entry_id": "13bc9027-af11-342a-8c56-6f20bbbf993d",
                                        "glosses": [
                                            "Having a broad range (of different elements)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c7bcf8d-f7a7-43b7-9581-83cc18840521",
                                                "sense_id": "644d8373-0155-3357-9b13-bae91e4c4b1e",
                                                "text": "The reasons are various."
                                            },
                                            {
                                                "example_id": "d2c6ec14-2bcc-4b4c-a28a-8ca022413820",
                                                "sense_id": "644d8373-0155-3357-9b13-bae91e4c4b1e",
                                                "text": "For this scene, a large number of supers are engaged, and in order to further swell the crowd, practically all the available stage hands have to ‘walk on’ dressed in various coloured dominoes, and all wearing masks."
                                            },
                                            {
                                                "example_id": "d0fcb5a8-af9d-4ba4-9b15-52d5eeea6b35",
                                                "sense_id": "644d8373-0155-3357-9b13-bae91e4c4b1e",
                                                "text": "The penalty for the breach of various contracts is scourging with stripes[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66d0f60b-4268-3a9b-83bc-dcdff9bb9f43",
                                        "entry_id": "13bc9027-af11-342a-8c56-6f20bbbf993d",
                                        "glosses": [
                                            "That varies or differs from others; variant; different."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97210c48-303e-4665-af5b-51594507c79b",
                                                "sense_id": "66d0f60b-4268-3a9b-83bc-dcdff9bb9f43",
                                                "text": "a various reading of a Biblical text"
                                            }
                                        ]
                                    }
                                ]
                            }
