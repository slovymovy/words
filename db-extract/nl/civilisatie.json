                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "957ad95d-d6f3-4ee7-8dfb-a52e2ce4c809",
                        "entry_id": "35560fb2-6820-37e6-822b-5056e6f6ad15",
