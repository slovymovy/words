                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ce296ee-f404-3c39-bcbe-1d65e57fe3bf",
                                        "entry_id": "c41b1461-0f7d-3a75-88be-0c1c47a90894",
                                        "glosses": [
                                            "Petit pieu que l’on fiche en terre pour tendre et arrêter les cordes des tentes, des pavillons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dce40bc-5790-46fb-9c5d-ff1672a61779",
                                                "sense_id": "1ce296ee-f404-3c39-bcbe-1d65e57fe3bf",
                                                "text": "Les piquets d’une tente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "572ef9f3-72a3-34bf-9673-3ccdbc30bcab",
                                        "entry_id": "c41b1461-0f7d-3a75-88be-0c1c47a90894",
                                        "glosses": [
                                            "Pieu plus grand et plus fort, dont on se sert pour mettre des chevaux à l’attache, par le moyen des cordes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c7c29b4-dab4-439f-bb3c-57b88c2e2bb8",
                                                "sense_id": "572ef9f3-72a3-34bf-9673-3ccdbc30bcab",
                                                "text": "Mettre, tenir des chevaux au piquet."
                                            },
                                            {
                                                "example_id": "c6abdc4f-aa07-4886-8676-6497d9f26b33",
                                                "sense_id": "572ef9f3-72a3-34bf-9673-3ccdbc30bcab",
                                                "text": "Les chevaux, sellés et bridés, étaient attachés à des piquets."
                                            },
                                            {
                                                "example_id": "5370465b-abd2-4a5a-913e-dc6bee6ed19f",
                                                "sense_id": "572ef9f3-72a3-34bf-9673-3ccdbc30bcab",
                                                "text": "Il [un cheval] pointait les oreilles et fit l’œil tendre quand Angelo le mit au piquet, dans un petit pré, à côté du gros paysan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c149fe02-dcd4-3417-8c02-b9b74dc0e336",
                                        "entry_id": "c41b1461-0f7d-3a75-88be-0c1c47a90894",
                                        "glosses": [
                                            "Bâton, perche qu’on plante en terre de distance en distance, pour prendre un alignement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e75aeff3-abc4-4ee8-903a-fa9fd65c9e1b",
                                                "sense_id": "c149fe02-dcd4-3417-8c02-b9b74dc0e336",
                                                "text": "Je marquai avec des piquets le lieu de l’église, du cimetière, de la maison curiale et de son jardin, M. Joyeux nous laissant les maîtres de son terrain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5583f819-e47e-3c52-9929-78045242fe84",
                                        "entry_id": "c41b1461-0f7d-3a75-88be-0c1c47a90894",
                                        "glosses": [
                                            "Petit groupe de personnes (cavaliers, fantassins, etc.) désigné pour effectuer une surveillance dans un cadre opérationnel ou administratif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0c2120f-b7b1-49d1-9193-35ce0ca61905",
                                                "sense_id": "5583f819-e47e-3c52-9929-78045242fe84",
                                                "text": "L’autorité militaire avait à peine eu le temps d’expédier un piquet de cent hommes, commandé par le capitaine Lehongre. Ce piquet venait d’arriver devant la Sous-Préfecture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba6af7c0-ad65-348c-8be3-da62c50e9ae7",
                                        "entry_id": "c41b1461-0f7d-3a75-88be-0c1c47a90894",
                                        "glosses": [
                                            "Groupe de personnes, voire d’animaux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef8d70f3-8365-480f-b66e-96424afa48d0",
                                                "sense_id": "ba6af7c0-ad65-348c-8be3-da62c50e9ae7",
                                                "text": "Un piquet de grève."
                                            },
                                            {
                                                "example_id": "489c3787-d92b-4de1-bc38-3d42ed0938e2",
                                                "sense_id": "ba6af7c0-ad65-348c-8be3-da62c50e9ae7",
                                                "text": "Quand il voyait, sur le sable des allées un piquet de chat, il entrait aussitôt dans une colère affreuse."
                                            },
                                            {
                                                "example_id": "2b0b2562-ab0d-46d8-804c-704c61328f25",
                                                "sense_id": "ba6af7c0-ad65-348c-8be3-da62c50e9ae7",
                                                "text": "Quand, sur le sable des allées, il reconnaissait un piquet de chat, il n’avait plus de repos qu’il ne l’eût découvert et occis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377d6001-f29c-32b8-b45b-a026df9f4798",
                                        "entry_id": "c41b1461-0f7d-3a75-88be-0c1c47a90894",
                                        "glosses": [
                                            "Punition scolaire qui consiste à être mis debout, pendant un certain temps, contre un arbre ou un mur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5861c473-e75f-4396-b975-9651b4204d7a",
                                                "sense_id": "377d6001-f29c-32b8-b45b-a026df9f4798",
                                                "text": "Mettre un(e) écolier(ère) au piquet."
                                            },
                                            {
                                                "example_id": "ab28e473-f76c-435a-9907-ed89a5b6cc56",
                                                "sense_id": "377d6001-f29c-32b8-b45b-a026df9f4798",
                                                "text": "– Sucot, tu me copieras trois fois la leçon sur les assolements et tu feras une heure de piquet."
                                            },
                                            {
                                                "example_id": "35714b73-0a1e-465d-ac02-7f2dea8aae8f",
                                                "sense_id": "377d6001-f29c-32b8-b45b-a026df9f4798",
                                                "text": "« Allez vous mettre au piquet près de la porte, les bras croisés. Si vous avez cru que ma bienveillance n’était que le masque de ma faiblesse, vous vous êtes étrangement trompé, et si vous persévérez dans cette erreur, j’aurai le regret de vous déférer au Conseil de discipline. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ec50ace-78de-39b7-b057-70b2f6eeca55",
                                        "entry_id": "c41b1461-0f7d-3a75-88be-0c1c47a90894",
                                        "glosses": [
                                            "Jeu de cartes se jouant principalement à deux avec un jeu de 32 cartes."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "752e93ce-7a3f-47de-9cab-092fc170face",
                                                "sense_id": "9ec50ace-78de-39b7-b057-70b2f6eeca55",
                                                "text": "Si tu montes au cercle, demain, sur le coup de quatre heures, tu m’y trouveras et nous ferons un piquet..., un rubicon, à dix sous le point... ça ne te compromettra pas."
                                            },
                                            {
                                                "example_id": "b2429c6b-37b8-4021-98de-3cabd05a23bd",
                                                "sense_id": "9ec50ace-78de-39b7-b057-70b2f6eeca55",
                                                "text": "Sa première femme est morte l’année dernière. Je l’ai bien connue, je lui ai même appris à jouer au piquet."
                                            },
                                            {
                                                "example_id": "7f3f45ee-712f-4364-ba28-1e6748b0d522",
                                                "sense_id": "9ec50ace-78de-39b7-b057-70b2f6eeca55",
                                                "text": "La leçon finie, M. Courtois me livrait à sa femme et cette personne, ainsi nantie d’un partenaire, même indigne, s’abandonnait avec frénésie aux délices du jeu de piquet."
                                            },
                                            {
                                                "example_id": "c9d5c13e-6339-4f9f-9c4c-2dfc5e9e4c53",
                                                "sense_id": "9ec50ace-78de-39b7-b057-70b2f6eeca55",
                                                "text": "Elle ferait bien un petit piquet Mais Salomé ne sait pas jouer au piquet. Un bésigue, alors ? Mais Salomé ne sait pas jouer au bésigue et Mme Rezeau commence à croire qu'elle le fait exprès. Bertille propose une belote, mais Mme Rezeau ne sait pas jouer à la belote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "937a65a1-a357-34b8-8654-f6b37942e0d3",
                                        "entry_id": "c41b1461-0f7d-3a75-88be-0c1c47a90894",
                                        "glosses": [
                                            "Piquet de chevaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ab150d4-35a3-35cc-8ba4-935b3e6f2430",
                                        "entry_id": "c41b1461-0f7d-3a75-88be-0c1c47a90894",
                                        "glosses": [
                                            "Taxe qui avait cours sous l’Ancien Régime à Marseille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc637741-7a94-4e83-b140-0061b4f19530",
                                                "sense_id": "7ab150d4-35a3-35cc-8ba4-935b3e6f2430",
                                                "text": "Le piquet imposait les consommateurs de farine français pour le bénéfice de l’administration municipale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "128c1a14-4286-3baf-899d-0d3449b3316b",
                                        "entry_id": "c41b1461-0f7d-3a75-88be-0c1c47a90894",
                                        "glosses": [
                                            "Érection."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb3999d4-56b5-4acd-88b1-cfeffae9837e",
                                                "sense_id": "128c1a14-4286-3baf-899d-0d3449b3316b",
                                                "text": "Avoir le piquet"
                                            }
                                        ]
                                    }
                                ]
                            },
