                                    },
                                    {
                                        "sense_id": "d4397211-66b8-3bfc-b7ff-e0b2d8b2d963",
                                        "entry_id": "bfa81456-1ced-372b-9b62-ca1f3fac4b76",
                                        "glosses": [
                                            "A ball bowled so as to roll along the ground; a daisy-cutter"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ed20e99-b2ea-3669-b922-e0ce7ae38c86",
                                        "entry_id": "bfa81456-1ced-372b-9b62-ca1f3fac4b76",
                                        "glosses": [
                                            "A sneaker; a tennis shoe."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "584c0d33-a05c-4f4e-8a89-9671632eacc7",
                                                "sense_id": "6ed20e99-b2ea-3669-b922-e0ce7ae38c86",
                                                "text": "We would have been laughed off the street in Philadelphia if we were seen wearing sneaks. In the big city, the young population wore loafers or boots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b65e5d84-6140-390a-be9f-aa305d7037cf",
                                        "entry_id": "bfa81456-1ced-372b-9b62-ca1f3fac4b76",
                                        "glosses": [
                                            "A play where the quarterback receives the snap and immediately dives forward."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a37eef7-d57b-3799-94b7-9c8bcb5f9bb3",
                                        "entry_id": "bfa81456-1ced-372b-9b62-ca1f3fac4b76",
                                        "glosses": [
                                            "Ellipsis of sneak preview"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "482cc520-46a7-4505-aec3-c54d7b3df800",
                                                "sense_id": "2a37eef7-d57b-3799-94b7-9c8bcb5f9bb3",
                                                "text": "At a \"sneak preview,\" of course, the public is also on hand and can make their reactions felt much to the humiliation of the principals. At a sneak of \"The Sandpiper,\" starring Elizabeth Taylor and Richard Burton, the audience laughed so loud during one love scene that the dejected producer promptly cut the scene out of the picture. At a sneak of \"The Outrage\" in San Francisco it was decided not to give names at the outset to test public response: nearly half the audience left before the picture was 20 minutes old. […] The worst sneak, it is told, occurred one night when nearly the entire audience marched out on \"Paris When It Sizzles” leaving the producer and director alone and forlorn in the theater."
                                            },
                                            {
                                                "example_id": "a77bab1b-acb7-45d1-bbbb-136299de8a0e",
                                                "sense_id": "2a37eef7-d57b-3799-94b7-9c8bcb5f9bb3",
                                                "text": "An exciting lineup of pre-release screenings, giving audiences nationwide a chance to see the top new offerings before their official release. Films include:[…]\n▪ A sneak preview of the new Highball.TV film Mother of All Shows at the Stirling Festival Theatre in Stirling, ON, where the film was shot. With director Melissa D’Agostino.\n▪ In Vancouver, a sneak of The Great Salish Heist, Darrell Dennis’ hilarious new no-budget Indigenous caper flick."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sneak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b823ff8c-9776-3d5f-b2de-599f0f703280",
                                        "entry_id": "e2c8d9e7-1ae1-3360-aab7-62c3ffa7ce23",
                                        "glosses": [
                                            "To creep or go stealthily; to come or go while trying to avoid detection, as a person who does not wish to be seen."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fd57701-086e-4bfa-b2c5-dcabff337cdc",
                                                "sense_id": "b823ff8c-9776-3d5f-b2de-599f0f703280",
                                                "text": "He decided to sneak into the kitchen for a second cookie while his mom was on the phone."
                                            },
                                            {
                                                "example_id": "a6f978f9-c7cb-4cd5-81cb-15dd87a4d796",
                                                "sense_id": "b823ff8c-9776-3d5f-b2de-599f0f703280",
                                                "text": "Some of these were dressed most gorgeously, others becomingly, and several sneaked in with fantail bangers, calling themselves \"Gentlemen of the Nineteenth Century.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2a93d77-9f14-3880-993c-999cd429ce95",
                                        "entry_id": "e2c8d9e7-1ae1-3360-aab7-62c3ffa7ce23",
                                        "glosses": [
                                            "To take something stealthily without permission."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cb109ef-38b2-45e8-953e-d6a546fe7d10",
                                                "sense_id": "d2a93d77-9f14-3880-993c-999cd429ce95",
                                                "text": "I went to sneak a chocolate but my dad caught me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d7dffb4-5ef2-304c-b9ad-8cc3d129f335",
                                        "entry_id": "e2c8d9e7-1ae1-3360-aab7-62c3ffa7ce23",
                                        "glosses": [
                                            "To stealthily bring someone something."
                                        ],
                                        "tags": [
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0203a6d-acef-47c6-96be-4fd65d8bec65",
                                                "sense_id": "0d7dffb4-5ef2-304c-b9ad-8cc3d129f335",
                                                "text": "She asked me to sneak her a phone next month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f835f5a-b3cb-3219-ba65-5145cfa83d85",
                                        "entry_id": "e2c8d9e7-1ae1-3360-aab7-62c3ffa7ce23",
                                        "glosses": [
                                            "To hide, especially in a mean or cowardly manner."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc9dc463-a41d-4259-b458-575da7836f49",
                                                "sense_id": "6f835f5a-b3cb-3219-ba65-5145cfa83d85",
                                                "text": "[Slander] sneaks its head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1885c4c-003a-3710-b2a4-2bcbff2d206c",
                                        "entry_id": "e2c8d9e7-1ae1-3360-aab7-62c3ffa7ce23",
                                        "glosses": [
                                            "To inform an authority of another's misdemeanours."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive",
                                            "with-on"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34216679-84ee-4e0c-8eb3-9c0a05252a9e",
                                                "sense_id": "d1885c4c-003a-3710-b2a4-2bcbff2d206c",
                                                "text": "If you sneak on me I'll bash you!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sneak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "797ab428-1501-3ee6-8407-a9a613ba866c",
                                        "entry_id": "b2f53280-343b-3be6-ad02-f791de4b4347",
                                        "glosses": [
                                            "In advance; before release to the general public."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c84c8e4c-8f79-4d99-a3bd-2cb86c2889e4",
                                                "sense_id": "797ab428-1501-3ee6-8407-a9a613ba866c",
                                                "text": "The company gave us a sneak look at their new electronic devices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dc75d23-b6b5-3f49-8d73-2e331d926276",
                                        "entry_id": "b2f53280-343b-3be6-ad02-f791de4b4347",
                                        "glosses": [
                                            "In a stealthy or surreptitious manner."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4734427-29e6-45e8-91c7-1b01f0268e1d",
                                                "sense_id": "7dc75d23-b6b5-3f49-8d73-2e331d926276",
                                                "text": "I was able to get a sneak peek at the guest list."
                                            },
                                            {
                                                "example_id": "4573fb64-b9b8-47d1-a830-c3fb2dfd8efa",
                                                "sense_id": "7dc75d23-b6b5-3f49-8d73-2e331d926276",
                                                "text": "I have ordered House Atreides to occupy Arrakis to mine the spice, thus replacing their enemies the Harkonnens. House Atreides will not refuse because of the tremendous power they think they will gain. Then, at an appointed time, Baron Harkonnen will return to Arrakis and launch a sneak attack on House Atreides. I have promised the Baron five legions of my Sardaukar terror troops."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
