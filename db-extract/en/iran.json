                    {
                        "translation_id": "57099c93-1816-4902-a04c-56f6a05f8f96",
                        "source_entry_id": "79803aeb-f3f2-3049-8963-54d42ed47231",
                        "source_sense_description": "country in West Asia",
                        "target_lang_word": "Iran",
                        "target_lang_code": "fr",
