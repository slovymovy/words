                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92175bc0-2bee-426b-b9c8-eecb333e7824",
                                "sense_id": "47f979d7-76ce-3675-afc1-ce25d8659ba6",
                                "text": "Sunday Mba zette het betere Nigeria kort voor de rust op 1-0; na pover verdedigen van Burkina rondde hij een aardig staaltje balbehandeling af met een prima schot. De Burkinezen deden in de tweede helft dappere pogingen om het tij te keren, maar Nigeria zorgde bij counters voor meer gevaar."
                            },
                            {
                                "example_id": "85f66137-0c16-4bfc-828c-c8369cc74183",
                                "sense_id": "47f979d7-76ce-3675-afc1-ce25d8659ba6",
                                "text": "Lazio leidde halverwege de eerste helft met 2-0 dankzij fraaie goals van twee nieuwelingen. Miroslav Klose scoorde na een knap staaltje balbehandeling en Djibril Cissé maakte met een harde kopbal de 2-0. Zlatan Ibrahimovic bracht de spanning terug met een inzet van dichtbij op aangeven van Antonio Cassano, die zelf nog voor rust de 2-2 inkopte."
                            }
                        ]
                    }
