                        "sense_id": "7faf8355-83fe-3469-9131-17e18073cf17",
                        "entry_id": "8f7f7344-1ba9-3204-a8f9-55845d64e457",
                        "glosses": [
                            "A quantity of rocks that has fallen from a cliff etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "969e0c00-3a1e-46c1-bc45-e5104c38b53e",
                                "sense_id": "7faf8355-83fe-3469-9131-17e18073cf17",
                                "text": "A 200-ton rockfall recently blocked the Machynlleth sidings, trapping several locomotives; a rock-slip on the approach embankment to Talerddig required expensive revetting last year; and on the coastal section to Barmouth an 80 foot-high stone revetment was completed some time ago at Friog; [...]."
                            },
                            {
                                "example_id": "7ef8daa8-a5f7-47d6-aa45-a394fd2b0bf6",
                                "sense_id": "7faf8355-83fe-3469-9131-17e18073cf17",
                                "text": "Design work is now complete on the Parsons Tunnel North programme, which envisages a 209-metre rockfall shelter built from a jack-up barge as there is no road access."
                            }
                        ]
                    }
                ],
