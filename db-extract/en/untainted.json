                        "glosses": [
                            "Not tainted; free of contamination; pure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3641f6d9-3850-48c5-b347-603e51f70e8f",
                                "sense_id": "4073b20a-f25a-3c8a-92b0-cc1a2dd97a41",
                                "text": "The master of [the Bell public house] is brother to the great preacher Whitefield; but is absolutely untainted with the pernicious principles of Methodism, or of any other heretical sect."
                            },
                            {
                                "example_id": "759b00b4-40a2-4d9d-9a6d-7b0933c0e8d4",
                                "sense_id": "4073b20a-f25a-3c8a-92b0-cc1a2dd97a41",
                                "text": "Time was when Love and I were well acquainted.\nTime was when we walked ever hand in hand.\nA saintly youth, with worldly thought untainted,\nNone better loved than I in all the land!"
                            }
                        ]
                    }
                ],
