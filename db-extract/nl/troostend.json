                                                "sense_id": "5b19cd4c-4076-319a-985c-39d8a2d8bcdf",
                                                "text": "Your comforting words help ease my mind."
                                            },
                                            {
                                                "example_id": "e43759c9-db21-4407-9be2-18c69e982acf",
                                                "sense_id": "5b19cd4c-4076-319a-985c-39d8a2d8bcdf",
                                                "text": "It's comforting to know that I've always got my Mum when things go wrong."
                                            }
