                "senses": [
                    {
                        "sense_id": "91a033e3-95eb-391e-a352-1185bb5f1d28",
                        "entry_id": "db944266-e308-3d6a-a815-b8c99f03ec55",
                        "glosses": [
                            "Fahrzeugklasse in der Klassifizierung für Personenkraftwagen, üblicherweise mit eingeschränktem Angebot für Passagieranzahl, sowie Gepäckvolumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e61e8a40-e64f-48d3-9a2e-fa1d8028ac74",
                                "sense_id": "91a033e3-95eb-391e-a352-1185bb5f1d28",
                                "text": "„Den Haupterfolg konnten die Klein- und Kleinstwagen buchen, was sich einmal aus dem grossen Fortschritt des deutschen Kleinwagenbaues, dann aber auch aus den geringen Anschaffungskosten dieser Typen erklärt.“"
                            },
                            {
                                "example_id": "73baa9db-831f-4aab-aaee-5e79a7445baa",
                                "sense_id": "91a033e3-95eb-391e-a352-1185bb5f1d28",
                                "text": "„Und wer das Besondere sucht: Auf der Plattform des iQ entwickelte Aston Martin seinen ersten Kleinstwagen, den Cygnet.“"
                            },
                            {
                                "example_id": "81ba88bf-d29d-4301-94de-c441588f5532",
                                "sense_id": "91a033e3-95eb-391e-a352-1185bb5f1d28",
                                "text": "„Der Kleinstwagen soll deutlich unter 10 000 Euro kosten und Dacia und Co. angreifen.“"
                            },
                            {
                                "example_id": "9d7bc372-e1bf-4ba9-aa78-3f7a59dec0a9",
                                "sense_id": "91a033e3-95eb-391e-a352-1185bb5f1d28",
                                "text": "„Die Daimler-Kleinstwagentochter Smart setzt auf der IAA voll auf Elektromobilität.“"
                            },
                            {
                                "example_id": "cfa37020-2db5-4ebc-aba6-28980f6ace79",
                                "sense_id": "91a033e3-95eb-391e-a352-1185bb5f1d28",
                                "text": "„Eine Polizeistreife verfolgt einen Kleinstwagen, der die Verkehrsordnung durch kaninchenartiges Gehoppel stört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
