                                                "sense_id": "44afe99e-6f0d-349f-8c51-d75cf5457768",
                                                "text": "So, ich lege mich jetzt filzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1561538c-a116-36c1-bfd8-b4743ca3c971",
