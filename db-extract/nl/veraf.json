        "nl-extract.jsonl": [
            {
                "entry_id": "b1c5d3a4-cf96-3a85-b5ae-9c441a61b693",
                "word": "veraf",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b067d5fe-8e7b-3313-80b2-4690cd37b56f",
                        "entry_id": "b1c5d3a4-cf96-3a85-b5ae-9c441a61b693",
                        "glosses": [
                            "ver weg; op een grote afstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "683f9d81-a110-4bbf-89f3-bcf8d0fc590a",
                                "sense_id": "b067d5fe-8e7b-3313-80b2-4690cd37b56f",
                                "text": "De geschrokken Fransoos is nog altijd herstellende. „Ik ga niet meer op dezelfde manier naar de wc. Ik open eerst de deur en doe het licht aan om de kom van veraf te scannen om te controleren of er niets in zit. Ik was ook even bang dat mijn partner niet terug wilde naar ons appartement.”"
                            },
                            {
                                "example_id": "ffcb7fe0-8938-4e66-b0b8-cc31f9a1874a",
                                "sense_id": "b067d5fe-8e7b-3313-80b2-4690cd37b56f",
                                "text": "Die vijanden bestook je dikwijls met het arsenaal aan wapens dat Aloy bij zich draagt. Primair zijn de pijl en boog waarvan er verschillende soorten in de game zitten. Zo is de ene boog handiger voor aanvallen van veraf dankzij het betere bereik, terwijl een vechtersboog je veel sneller pijlen achter elkaar laat schieten en de voorkeur geniet in frontale aanvallen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb951e4f-8e28-4328-a376-ca05b153eddb",
                        "source_entry_id": "b1c5d3a4-cf96-3a85-b5ae-9c441a61b693",
                        "source_sense_id": "b067d5fe-8e7b-3313-80b2-4690cd37b56f",
                        "target_lang_word": "distant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "480309b0-a78c-3691-82b2-873478753d27",
                                        "entry_id": "6226afc4-7c8e-3a7a-ab88-0c1e8b6a28e6",
                                        "glosses": [
                                            "Far off (physically, logically or mentally)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c55943a9-c058-498c-b1eb-037c4117dec2",
                                                "sense_id": "480309b0-a78c-3691-82b2-873478753d27",
                                                "text": "We heard a distant rumbling but didn't pay any more attention to it. She was surprised to find that her fiancé was a distant relative of hers. His distant look showed that he was not listening to me."
                                            },
                                            {
                                                "example_id": "67bb4652-017e-4710-a80a-8380c9c3e734",
                                                "sense_id": "480309b0-a78c-3691-82b2-873478753d27",
                                                "text": "Judge Short had gone to town, and Farrar was off for a three days' cruise up the lake. I was bitterly regretting I had not gone with him when the distant notes of a coach horn reached my ear, and I descried a four-in-hand winding its way up the inn road from the direction of Mohair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4dd26d9-18eb-3b96-995c-4552659ead05",
                                        "entry_id": "6226afc4-7c8e-3a7a-ab88-0c1e8b6a28e6",
                                        "glosses": [
                                            "Emotionally unresponsive or unwilling to express genuine feelings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8194b4b-b9bc-4a06-b31e-165a7eacbb62",
                                                "sense_id": "e4dd26d9-18eb-3b96-995c-4552659ead05",
                                                "text": "Ever since our argument, she has been totally distant toward me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3895f29-d287-3303-911d-f8da3d95b3c1",
                                        "entry_id": "6226afc4-7c8e-3a7a-ab88-0c1e8b6a28e6",
                                        "glosses": [
                                            "Imported into a cable television system from a different market (and thus possibly incurring a copyright royalty)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1b04063-8a84-427b-a862-5efc20e297f6",
                                                "sense_id": "d3895f29-d287-3303-911d-f8da3d95b3c1",
                                                "text": "Any determination that a particular television signal is \"distant\" must, of course, be made with respect to its proximity to a specific local area, which we have termed the CATV community, […]"
                                            },
                                            {
                                                "example_id": "31f41927-d9c7-46aa-ae24-883eb4473da4",
                                                "sense_id": "d3895f29-d287-3303-911d-f8da3d95b3c1",
                                                "text": "Finally, there will be those unusual situations where a signal is distant to part of a CATV system and local to the rest of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cbc70f3-f8ee-4341-a54d-b52f692cb520",
                        "source_entry_id": "b1c5d3a4-cf96-3a85-b5ae-9c441a61b693",
                        "source_sense_id": "b067d5fe-8e7b-3313-80b2-4690cd37b56f",
                        "target_lang_word": "remote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "835de2df-19d8-335e-9064-f718b3e32dbc",
                                        "entry_id": "fbcc191b-4e8d-31ef-93eb-7b31f5b949c2",
                                        "glosses": [
                                            "At a distance; disconnected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09a4c7c7-8a44-44b3-a750-3df847ffeb87",
                                                "sense_id": "835de2df-19d8-335e-9064-f718b3e32dbc",
                                                "text": "A remote operator may control the vehicle with a wireless handset."
                                            },
                                            {
                                                "example_id": "b038081c-d906-4a1b-95ca-ad07d71ecf21",
                                                "sense_id": "835de2df-19d8-335e-9064-f718b3e32dbc",
                                                "text": "remote workers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "529c9e44-f8d9-3dae-9239-e99a96fbd2af",
                                        "entry_id": "fbcc191b-4e8d-31ef-93eb-7b31f5b949c2",
                                        "glosses": [
                                            "Distant or otherwise inaccessible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b4c1f76-92f0-4686-bffe-c542e65fa68f",
                                                "sense_id": "529c9e44-f8d9-3dae-9239-e99a96fbd2af",
                                                "text": "After his fall from the emperor's favor, the general was posted to a remote outpost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00bb2e37-1b3b-34de-8d85-9e02aa869225",
                                        "entry_id": "fbcc191b-4e8d-31ef-93eb-7b31f5b949c2",
                                        "glosses": [
                                            "Slight."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55afaba6-3194-4b53-a826-d157e1dc7fff",
                                                "sense_id": "00bb2e37-1b3b-34de-8d85-9e02aa869225",
                                                "text": "There was only a remote possibility that we would be rescued as we were far outside of the regular shipping lanes."
                                            },
                                            {
                                                "example_id": "bdd4013d-7b3e-4f71-bb6b-8116f27392d7",
                                                "sense_id": "00bb2e37-1b3b-34de-8d85-9e02aa869225",
                                                "text": "They have a very remote chance of winning."
                                            },
                                            {
                                                "example_id": "bbce5742-b672-41a8-b92b-8a8684381fce",
                                                "sense_id": "00bb2e37-1b3b-34de-8d85-9e02aa869225",
                                                "text": "You have a remote resemblance to my grandmother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee28b2a1-403c-3683-beca-03828c38179c",
                                        "entry_id": "fbcc191b-4e8d-31ef-93eb-7b31f5b949c2",
                                        "glosses": [
                                            "Emotionally detached."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c679a69-f83c-4764-8ec3-eb8f21991fca",
                                                "sense_id": "ee28b2a1-403c-3683-beca-03828c38179c",
                                                "text": "After her mother's death, my friend grew remote for a time while she dealt with her grief."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "remote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "176354fd-e124-341b-9cac-e3e5713e2c18",
                                        "entry_id": "c927b246-bf31-3e10-a459-9ce37c19686c",
                                        "glosses": [
                                            "Ellipsis of remote control."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4836c80-a2d8-4c1d-9a4f-9704b1cc8fa2",
                                                "sense_id": "176354fd-e124-341b-9cac-e3e5713e2c18",
                                                "text": "I hate it when my uncle comes over to visit; he always sits in the best chair and hogs the remote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c431573-a0b7-3137-a658-e9babdd6ca38",
                                        "entry_id": "c927b246-bf31-3e10-a459-9ce37c19686c",
                                        "glosses": [
                                            "An element of broadcast programming originating away from the station's or show's control room."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90de128d-898d-3c87-8ebd-e6eb491d4984",
                                        "entry_id": "c927b246-bf31-3e10-a459-9ce37c19686c",
                                        "glosses": [
                                            "A source control repository hosted on a remote machine, rather than locally."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "remote",
