                        ],
                        "examples": [
                            {
                                "example_id": "1a46cd5b-2876-4f4f-8e09-b0c3b49f45f8",
                                "sense_id": "de905947-76ec-3f5b-98f1-0450f118d120",
                                "text": "In Basel hat ein Fahrgast einen Busunfall verhindert. Als die Chauffeuse die Herrschaft über ihr Fahrzeug verlor, brachte der 32-Jährige das Gefährt zum Stillstand.",
