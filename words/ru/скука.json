                    "sense_id": "456e4ab2-d0f9-3f8a-a5e0-994441db91cf",
                    "sense_definition": "Тягостное душевное состояние, уныние и тоска от безделья или отсутствия интереса к чему-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state_of_mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От <скуки> он начал читать старый журнал.",
                            "target_lang_translations": {
                                "en": "Out of <w>boredom</w>, he started reading an old magazine.",
                                "nl": "Uit <w>verveling</w> begon hij een oud tijdschrift te lezen.",
                                "pl": "Z <w>nudów</w> zaczął czytać stary magazyn.",
                                "fr": "Par <w>ennui</w>, il a commencé à lire un vieux magazine.",
                                "de": "Aus <w>Langeweile</w> fing er an, eine alte Zeitschrift zu lesen.",
                                "es": "Por <w>aburrimiento</w>, empezó a leer una revista vieja.",
                                "it": "Per <w>noia</w> ha iniziato a leggere una vecchia rivista.",
                                "tr": "Can <w>sıkıntısından</w> eski bir dergiyi okumaya başladı.",
                                "cs": "Z <w>nudy</w> začal číst starý časopis."
                            }
                        },
                        {
                            "text": "Её лицо выражало усталость и <скуку>.",
                            "target_lang_translations": {
                                "en": "Her face expressed fatigue and <w>boredom</w>.",
                                "nl": "Haar gezicht drukte vermoeidheid en <w>verveling</w> uit.",
                                "pl": "Jej twarz wyrażała zmęczenie i <w>nudę</w>.",
                                "fr": "Son visage exprimait la fatigue et l'<w>ennui</w>.",
                                "de": "Ihr Gesicht drückte Müdigkeit und <w>Langeweile</w> aus.",
                                "es": "Su rostro expresaba cansancio y <w>aburrimiento</w>.",
                                "it": "Il suo viso esprimeva stanchezza e <w>noia</w>.",
                                "tr": "Yüzü yorgunluk ve can <w>sıkıntısı</w> ifade ediyordu.",
                                "cs": "Její tvář vyjadřovala únavu a <w>nudu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "томление",
                        "тоска",
                        "уныние"
                    ],
                    "antonyms": [
                        "интерес",
                        "веселье",
                        "энтузиазм"
                    ],
                    "common_phrases": [
                        "умирать от скуки",
                        "развеять скуку",
                        "зеленая скука"
                    ],
                    "target_lang_definitions": {
                        "en": "A painful mental state, dejection, or melancholy resulting from idleness or lack of interest.",
                        "nl": "Een pijnlijk mentaal gevoel, neerslachtigheid of melancholie die voortkomt uit luiheid of gebrek aan interesse.",
                        "pl": "Uciążliwy stan ducha, przygnębienie i tęsknota wynikające z bezczynności lub braku zainteresowania czymkolwiek.",
                        "fr": "Un état d'esprit pénible, de découragement ou de mélancolie résultant de l'oisiveté ou du manque d'intérêt pour quelque chose.",
                        "de": "Ein quälender seelischer Zustand, Niedergeschlagenheit oder Melancholie, die aus Untätigkeit oder mangelndem Interesse resultiert.",
                        "es": "Estado mental doloroso, abatimiento o melancolía resultante de la ociosidad o la falta de interés.",
                        "it": "Uno stato d'animo doloroso, abbattimento o malinconia derivante dall'ozio o dalla mancanza di interesse.",
                        "tr": "Boş durmaktan veya bir şeye ilgi duymamaktan kaynaklanan sıkıntı, can sıkıntısı ve kasvet durumu.",
                        "cs": "Tíživý duševní stav, sklíčenost a smutek z nečinnosti nebo nedostatku zájmu o cokoli."
                    },
