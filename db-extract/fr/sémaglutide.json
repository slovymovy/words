                "word": "sémaglutide",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6e0d40e6-2faf-4607-8f9d-b4245e6d3dcc",
                        "entry_id": "02e05e51-c68c-3fff-b5a5-f21d6d0ba6b4",
                        "tags": [
                            "plural"
