                },
                {
                    "sense_id": "4a19e209-d389-35ad-bafc-119229f7ad0d",
                    "sense_definition": "Forme normalisée ou notice servant de point d'accès univoque dans un catalogue ou une base de données.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "documentaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bibliothécaire a vérifié la notice d'<w>autorité</w> avant de valider l'indexation de l'ouvrage."
                        },
                        {
                            "text": "Les fichiers d'<w>autorité</w> permettent d'éviter les confusions entre auteurs portant le même patronyme."
