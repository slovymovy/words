                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "burst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers prepared to <w>rive</w> their artillery against the castle walls.",
                            "target_lang_translations": {
                                "ru": "Солдаты приготовились <w>палить</w> из своей артиллерии по стенам замка."
                            }
