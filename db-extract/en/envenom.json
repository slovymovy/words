                ],
                "senses": [
                    {
                        "sense_id": "2b106e4d-0a77-3bb6-9af7-9a5cb6cccb5d",
                        "entry_id": "c3df2534-7998-332a-bf4d-ffee7575c449",
                        "glosses": [
                            "To inject or put venom onto or into (someone or something)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9af589f4-8e08-49cd-9247-46f1f23566a7",
                                "sense_id": "2b106e4d-0a77-3bb6-9af7-9a5cb6cccb5d",
                                "text": "As when Alcides from Oealia Crown’d\nWith conqueſt, felt th’ envenom’d robe, and tore\nThrough pain up by the roots Theſſalian Pines […]"
                            },
                            {
                                "example_id": "e9cee06d-7220-4b4c-9b20-fceaa4e53958",
                                "sense_id": "2b106e4d-0a77-3bb6-9af7-9a5cb6cccb5d",
                                "text": "Nay, was it I who wooed thee to this breast, / Which like a serpent thou envenomest / As in repayment of the warmth it lent?"
                            },
                            {
                                "example_id": "4168bbf8-6837-452f-a5bb-ca3debb4ae02",
                                "sense_id": "2b106e4d-0a77-3bb6-9af7-9a5cb6cccb5d",
                                "text": "Ah dearest, whoso sucks a poisoned wound\nEnvenoms his own veins!"
                            },
                            {
                                "example_id": "d16cedb0-6df9-4c65-9a44-9033dd6e8f09",
                                "sense_id": "2b106e4d-0a77-3bb6-9af7-9a5cb6cccb5d",
                                "text": "The Kayans of Central Borneo ascribe souls to the trees which yield the poison they use to envenom their arrows."
                            }
                        ]
                    },
                    {
                        "sense_id": "a583972a-0844-375c-b28c-2ffb994ee7dc",
                        "entry_id": "c3df2534-7998-332a-bf4d-ffee7575c449",
                        "glosses": [
                            "To acerbate, make bitter."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a4dde6eb-353f-4780-8ed5-e250d23afc7d",
                                "sense_id": "a583972a-0844-375c-b28c-2ffb994ee7dc",
                                "text": "Oh what a world is this, when what is comely\nEnuenoms him that beares it?"
                            }
                        ]
                    }
                ],
