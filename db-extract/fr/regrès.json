                        "glosses": [
                            "Recul, passage d’une situation à une situation moins favorable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69ec34ef-e182-4e37-8f7a-cb964bafc2b6",
                                "sense_id": "4c411e95-3b9d-3fcc-8dcd-c7f9ab07cb4d",
                                "text": "Chez le damné maximal, cette rétroversion de l’humanité lui fait parcourir en marche arrière toutes les étapes d’un ancestral progrès qui devient un regrès : allongé sur le sol…."
                            },
                            {
                                "example_id": "e722c7e5-2a5c-4cd3-a9ae-28e9393e8954",
                                "sense_id": "4c411e95-3b9d-3fcc-8dcd-c7f9ab07cb4d",
                                "text": "Le fait général est que toute modification, si importante qu’elle soit, s’accomplit par adjonction au progrès de régrès correspondants."
                            }
                        ]
                    },
                    {
                        "sense_id": "51a1a4f1-5eba-344e-9a9d-9baa5bc1b3d0",
                        "entry_id": "31ec2555-834c-3c20-ae13-f1fef717af68",
                        "glosses": [
                            "Droit de rentrer dans un bénéfice résigné ou permuté, lorsque le résignataire n’observe pas les conditions stipulées."
                        ],
                        "tags": [
                            "Jurisprudence bénéficiale"
                        ],
                        "examples": []
                    },
