                            {
                                "example_id": "b6bb61bd-222e-4371-8c87-05a37b582210",
                                "sense_id": "dcd5fd68-e4a4-3d1b-8516-7ecd6b9a6de5",
                                "text": "The speech might have been electrifying close up, Mr. Conley said, but people near him drifted away before it finished."
                            },
                            {
                                "example_id": "93bc87dc-0b55-47a7-be89-22e8c380d19c",
                                "sense_id": "dcd5fd68-e4a4-3d1b-8516-7ecd6b9a6de5",
                                "text": "In an electrifying atmosphere on Court Philippe Chatrier, Alcaraz produced the finest performance of his career to claim a fifth major title."
                            },
                            {
                                "example_id": "b8426358-e545-4ffb-b136-601f0df29321",
                                "sense_id": "dcd5fd68-e4a4-3d1b-8516-7ecd6b9a6de5",
                                "text": "The singer had an electrifying and unpredictable onstage presence and a dry sense of humor that endeared him to hordes of adoring fans."
                            }
                        ]
                    }
