                                        "glosses": [
                                            "A kind of airbrush."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a14f7fa3-799f-4a36-85b4-89c339ae3dbd",
                        "source_entry_id": "0f209701-60ef-3e60-a51e-5651e0e4eac1",
                        "target_lang_word": "airbrush",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airbrush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89725721-1aa2-347f-bb49-c14fa47fe339",
                                        "entry_id": "608d633b-0968-34df-b5a9-dc525e9ae255",
                                        "glosses": [
                                            "A miniature, handheld paint sprayer, powered by compressed air or other gas, used for delicate, artistic painting, or sometimes retouching of photographs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "airbrush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dad2b097-0b51-38b3-b2b4-2a9ce9b140e7",
                                        "entry_id": "a1bfa155-ef66-3fdd-93f4-a44982c8e51a",
                                        "glosses": [
                                            "To paint using an airbrush."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f531b691-2b3a-3f09-91f0-c8e1474c47b0",
                                        "entry_id": "a1bfa155-ef66-3fdd-93f4-a44982c8e51a",
                                        "glosses": [
                                            "To touch up or enhance a photograph or person, often with intent to mislead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a92dfc5-414d-4552-b0cb-0cbe7c3cd5f3",
                                                "sense_id": "f531b691-2b3a-3f09-91f0-c8e1474c47b0",
                                                "text": "This photo has definitely been airbrushed; no one has skin this smooth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d970a922-d17b-376f-8d0b-c025434a59fe",
                                        "entry_id": "a1bfa155-ef66-3fdd-93f4-a44982c8e51a",
                                        "glosses": [
                                            "To edit or alter something in order to make it appear better."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5006c573-bf23-4d80-8ed0-39f2e91c64cf",
                                                "sense_id": "d970a922-d17b-376f-8d0b-c025434a59fe",
                                                "text": "They'd spent one evening together sixteen months ago, and Falk was acutely aware that he'd probably airbrushed and edited at least some of it without meaning to."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
