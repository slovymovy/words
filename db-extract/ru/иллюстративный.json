                        ]
                    },
                    {
                        "translation_id": "9bee71f7-e957-4d0f-86ea-466636014b23",
                        "source_entry_id": "b5998bca-4ab4-3ede-8d7e-854e6fc051eb",
                        "target_lang_word": "illustrativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5247aaa8-fdb0-4416-8b7e-c19e0c578f4b",
                        "source_entry_id": "b5998bca-4ab4-3ede-8d7e-854e6fc051eb",
                        "target_lang_word": "anschaulich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anschaulich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea33e078-3d8b-337c-8835-caf1f1daf71c",
                                        "entry_id": "f3f2fd58-a52f-3413-a9aa-cd0eed04cccb",
                                        "glosses": [
                                            "in bildlicher, plastischer Art und Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53b04760-a3b4-4ca3-b011-8247b11ae83d",
                                                "sense_id": "ea33e078-3d8b-337c-8835-caf1f1daf71c",
                                                "text": "Aber Sie verstehen Ihre Erlebnisse schlicht, natürlich, lebhaft und anschaulich wiederzugeben."
                                            },
                                            {
                                                "example_id": "555f8744-0e6c-4d9f-97ad-281063d936fc",
                                                "sense_id": "ea33e078-3d8b-337c-8835-caf1f1daf71c",
                                                "text": "In der anschaulich geschriebenen und glänzend übersetzten Biografie von John Stape lässt sich dieses dramatische Auf und Ab im Leben und Schaffen Joseph Conrads geradezu atemlos mitverfolgen."
                                            },
                                            {
                                                "example_id": "663ed3e6-5666-4d08-975e-f35300550767",
                                                "sense_id": "ea33e078-3d8b-337c-8835-caf1f1daf71c",
                                                "text": "Wie sehr Kreativität in der Wirtschaftswelt punktet, das zeigen sehr anschaulich die Design Weeks, die gerade in Wien mit großem Erfolg über die Bühne gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa0def09-5c42-3908-a1c1-9029340be2fa",
                                        "entry_id": "f3f2fd58-a52f-3413-a9aa-cd0eed04cccb",
                                        "glosses": [
                                            "allgemein verständlich (zum Beispiel bei Weitergabe von Informationen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68f74c41-052b-459c-b39b-e7cbe775e1b6",
                                                "sense_id": "aa0def09-5c42-3908-a1c1-9029340be2fa",
                                                "text": "Die Schwierigkeiten der Zollverbindung zwischen unsern beiden Gebietstheilen und die Haltung Hanovers im letzten Kriege hatten das Bedürfniß eines unbeschränkt in einer Hand befindlichen territorialen Zusammenhangs im Norden von Neuem anschaulich gemacht."
                                            },
                                            {
                                                "example_id": "9b728e13-f31c-49e1-b1c8-f8da78c86129",
                                                "sense_id": "aa0def09-5c42-3908-a1c1-9029340be2fa",
                                                "text": "In bei weitem erhöhtem Maße des Ausdruckes vermag nun die musikalische Modulation solch eine Verbindung dem Gefühle anschaulich zu machen."
                                            },
                                            {
                                                "example_id": "a4ad5c50-738a-4e04-a6f5-d8ad8b26e1cf",
                                                "sense_id": "aa0def09-5c42-3908-a1c1-9029340be2fa",
                                                "text": "Auch bei ihm ist, um mit Ernst Mach zu sprechen, „das Ich nicht zu retten“, vielmehr liefert er anschauliche, in packende Narration gefasste Antworten auf verschiedenste Aspekte des schwerfälligen Begriffs „Identität“."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b96432bc-dc59-463e-a4fb-a10aea62f5ec",
