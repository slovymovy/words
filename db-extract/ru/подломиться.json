                        "glosses": [
                            "надломиться, сломаться снизу под кем-чем-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2537bc5-3e35-4e17-9fae-155394e014b1",
                                "sense_id": "7f636b41-c0d4-3dc1-bebc-63ee349211cc",
                                "text": "Лёд подломился под лошадью."
                            },
                            {
                                "example_id": "c5424a8d-7f6f-49f0-ae4e-fc7e992a0c0e",
                                "sense_id": "7f636b41-c0d4-3dc1-bebc-63ee349211cc",
                                "text": "Сук подломился под тяжестью влезшего на него охотника."
                            }
                        ]
                    }
                ],
