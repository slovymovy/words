                                        "glosses": [
                                            "Assemblage de petits cordons, de fils, de cheveux, etc. entrelacés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca02f2b5-c398-36a9-b82a-6cfc70452b74",
