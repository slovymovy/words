                ],
                "senses": [
                    {
                        "sense_id": "87344ea6-072f-3e67-b293-7d504cc8d74c",
                        "entry_id": "31c89ec9-847d-32b9-8b7d-9c2518b1d05e",
                        "glosses": [
                            "Espèce de petit chat sauvage vivant en Asie, spécialement en Mongolie et en Sibérie, seule espèce du genre Otocolobus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "074a7ff7-1125-4f1b-afd9-2d05de232508",
                                "sense_id": "87344ea6-072f-3e67-b293-7d504cc8d74c",
                                "text": "Parmi les proies des chasseurs on trouvait également les prédateurs des marmottes, ce qui multipliait encore les contacts avec des animaux potentiellement porteurs. Loups, renards, putois et manuls ou chat des steppes – pouvant eux-mêmes transmettre la maladie : autant de prédateurs des marmottes particulièrement recherchés pour leur précieuse fourrure."
                            },
                            {
                                "example_id": "6f832bfb-f312-4011-9320-ed09a3a73ebb",
                                "sense_id": "87344ea6-072f-3e67-b293-7d504cc8d74c",
                                "text": "Deux chats de Pallas, aussi appelés manuls, ont élu domicile sur le toit du monde."
                            },
                            {
                                "example_id": "4a855811-4853-4953-85b0-67258af8d0a7",
                                "sense_id": "87344ea6-072f-3e67-b293-7d504cc8d74c",
                                "text": "Terminons cette galerie de portraits de famille par la bonne petite bouille du manul, qui ne ressemble qu’à lui-même, avec ses très chouettes yeux cernés de blanc, sa bouille de clown et sa fourrure de fée des frimas."
                            },
                            {
                                "example_id": "346ed104-169f-4fdb-a9d1-fef6bcc34390",
                                "sense_id": "87344ea6-072f-3e67-b293-7d504cc8d74c",
                                "text": "Par sa petite taille, le manul est la proie de nombreux prédateurs, rapaces, renards, etc."
                            }
                        ]
                    }
                ],
