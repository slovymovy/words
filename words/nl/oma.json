                    "semantic_group_id": "family_members",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn <w>oma</w> bakt de lekkerste taarten van de hele wereld.",
                            "target_lang_translations": {
                                "en": "My <w>grandma</w> bakes the tastiest cakes in the whole world.",
                                "ru": "Моя <w>бабушка</w> печет самые вкусные торты во всем мире.",
                                "pl": "Moja <w>babcia</w> piecze najpyszniejsze ciasta na całym świecie.",
                                "de": "Meine <w>Oma</w> backt die leckersten Kuchen der ganzen Welt.",
                                "fr": "Ma <w>mamie</w> fait les meilleurs gâteaux du monde entier.",
                                "it": "Mia <w>nonna</w> prepara le torte più buone di tutto il mondo.",
                                "cs": "Moje <w>babička</w> peče ty nejlepší dorty na celém světě.",
                                "tr": "Benim <w>büyükannem</w> dünyanın en lezzetli pastalarını pişirir.",
                                "es": "Mi <w>abuela</w> hornea los pasteles más ricos del mundo entero."
                            }
                        },
                        {
                            "text": "In het weekend gaan we vaak op bezoek bij opa en <w>oma</w>.",
                            "target_lang_translations": {
                                "en": "On weekends we often visit grandpa and <w>grandma</w>.",
                                "ru": "В выходные мы часто ходим в гости к дедушке и <w>бабушке</w>.",
                                "pl": "W weekendy często odwiedzamy dziadka i <w>babcię</w>.",
                                "de": "Am Wochenende besuchen wir oft Opa und <w>Oma</w>.",
                                "fr": "Le week-end, nous allons souvent rendre visite à papi et <w>mamie</w>.",
                                "it": "Nel fine settimana andiamo spesso a trovare il nonno e la <w>nonna</w>.",
                                "cs": "O víkendu často chodíme na návštěvu k dědečkovi a <w>babičce</w>.",
                                "tr": "Hafta sonları sık sık dedemi ve <w>büyükannemi</w> ziyarete gideriz.",
                                "es": "Los fines de semana solemos ir a visitar al abuelo y a la <w>abuela</w>."
                            }
                        }
