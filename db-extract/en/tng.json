                "senses": [
                    {
                        "sense_id": "d0559e1e-d400-303d-9b86-72a1971fa431",
                        "entry_id": "f1682dbd-8ab6-336a-a917-d701c3a8595f",
                        "glosses": [
                            "A social club for younger BDSM practitioners, typically for those under the age of approximately 35 years."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e034a8-ad1b-46ba-a5f2-70ff2457697e",
                                "sense_id": "d0559e1e-d400-303d-9b86-72a1971fa431",
                                "text": "Many cities including Madison (Wisconsin), San Francisco, Boston, Vancouver, Columbus (Ohio), Albuquerque, Glendale (Arizona), Tucson, and Austin (TX) also have a TNG."
                            },
                            {
                                "example_id": "7080909a-d1c2-4902-a752-89183cb0d8c7",
                                "sense_id": "d0559e1e-d400-303d-9b86-72a1971fa431",
                                "text": "TNG was the brainchild of some young adult kinksters entering the BDSM scene in New York and the first one formed there in 1999. Since then TNGs have sprung up nationwide in many major cities."
                            },
                            {
                                "example_id": "ae27ff09-6eb9-4974-81be-c36a2e79513e",
                                "sense_id": "d0559e1e-d400-303d-9b86-72a1971fa431",
                                "text": "TESTNG was one of the first two TNGs to ever exist, which was a sort of, TES is an extremely hierarchical organization and there are all these little sub-organizations within it, so there’s all these branches, you know, and there’s one specifically for women tops or femme tops who have submissive bottoms, there’s one specifically for people who are into master and slave relationships."
                            }
                        ]
                    }
