            "senses": [
                {
                    "sense_id": "2b9eb70d-4b5c-315a-98fa-3422e31c71a8",
                    "sense_definition": "Espace géographique délimité placé sous l'autorité d'un État, d'une collectivité ou d'une juridiction.",
