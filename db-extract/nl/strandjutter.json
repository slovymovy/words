                "senses": [
                    {
                        "sense_id": "daf58c68-6622-3855-b82f-6acb388de469",
                        "entry_id": "da8739ac-3a5a-3c47-9137-6546dbf6f8cd",
                        "glosses": [
                            "iemand die aangespoelde voorwerpen van het stand haalt (/steelt)"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "530c2f4c-0ea8-4e27-b35b-41cd1902f005",
                                "sense_id": "daf58c68-6622-3855-b82f-6acb388de469",
                                "text": "Perry’s talenten zijn talrijk: ze doet geweldige dingen met haar alwetende verteller, ze heeft een vurig kloppend hart voor de natuur in Essex en schrijft met bezieling over het water, de mist, de strandjutters. Het verhaal heeft vaart, maar tegelijk neemt Perry de tijd om te vertellen."
                            },
                            {
                                "example_id": "8ff857d1-79e0-4872-a688-8b25edbc3a29",
                                "sense_id": "daf58c68-6622-3855-b82f-6acb388de469",
                                "text": "Norman MacDonald, een strandjutter uit West Mabou, aan de Oostkust van Canada, vond de fles met de opmerkelijke inhoud: de as van een overleden man, 25 Canadese dollar en een briefje dat door een van zijn kinderen is geschreven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3fa95ce-75ba-465a-99bf-f46325711e10",
                        "source_entry_id": "da8739ac-3a5a-3c47-9137-6546dbf6f8cd",
                        "source_sense_id": "daf58c68-6622-3855-b82f-6acb388de469",
                        "source_sense_description": "iemand die aangespoelde voorwerpen van het strand haalt",
                        "target_lang_word": "beachcomber",
