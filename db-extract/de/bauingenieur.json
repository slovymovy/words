                "senses": [
                    {
                        "sense_id": "3a04375c-0f64-3afa-a990-a5ad44df99a8",
                        "entry_id": "469789c2-83bd-3fce-a148-2667ff6a20a0",
                        "glosses": [
                            "Ingenieur der Fachrichtung Bauwesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cacb1f95-1b79-45f2-adbe-f51be37cdc41",
                                "sense_id": "3a04375c-0f64-3afa-a990-a5ad44df99a8",
                                "text": "„Der Bauingenieur begleitet ein Bauvorhaben von der Planung, Projektierung, Bauausführung bis hin zur Bauabnahme und Abrechnung der Bauleistungen.“"
                            },
                            {
                                "example_id": "7e7f47f9-d114-42c8-a061-1ca1796a198a",
                                "sense_id": "3a04375c-0f64-3afa-a990-a5ad44df99a8",
                                "text": "„Der Student zum Bauingenieur machte zunächst eine Ausbildung zum Zimmerer.“"
                            },
                            {
                                "example_id": "e55d5cf9-12c9-4167-964e-eaa50062bf1a",
                                "sense_id": "3a04375c-0f64-3afa-a990-a5ad44df99a8",
                                "text": "„Ein italienischer Bauingenieur, der sich zum Zeitpunkt des Ereignisses in unmittelbarer Nähe auf der Staumauer befunden hatte, wurde zitiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
