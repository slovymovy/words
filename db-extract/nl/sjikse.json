                                        "examples": [
                                            {
                                                "example_id": "b18b3cb3-1466-457a-97b1-85c9b1187376",
                                                "sense_id": "fa98e646-7b1d-35a6-adb4-93e9db810712",
                                                "text": "My father…and a shikse? Can’t be. Was beyond his ken. My own father – fucked shikses? I’ll admit under duress that he fucked my mother…but shikses? I can no more imagine him knocking over a gas station."
                                            },
                                            {
                                                "example_id": "6dff9c11-28f2-444c-a515-a78b20655b0f",
                                                "sense_id": "fa98e646-7b1d-35a6-adb4-93e9db810712",
                                                "text": "So that's your task when your mother releases you into the world: to warm back into life the chilly universe of shiksehs."
                                            }
                                        ]
                                    }
