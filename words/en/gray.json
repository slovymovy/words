                                "target_lang_word": "грей",
                                "target_lang_sense_clarification": "единица измерения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戈瑞",
                                "target_lang_sense_clarification": "辐射剂量单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
