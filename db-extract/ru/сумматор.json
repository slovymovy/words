                                "target_senses": [
                                    {
                                        "sense_id": "f2e21bf4-9fa0-3ef4-8bf3-cbb0cf015a34",
                                        "entry_id": "4091e655-896d-3879-a3ba-9b2da7dc61ee",
                                        "glosses": [
                                            "One of four seasons, traditionally the second, marked by the longest and typically hottest days of the year due to the inclination of the Earth and thermal lag. Typically regarded as spanning the months of June, July, and August in the Northern Hemisphere and the months of December, January and February in the Southern Hemisphere."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b2ffaad-a9e3-4e55-89b3-c236923b13fc",
                                                "sense_id": "f2e21bf4-9fa0-3ef4-8bf3-cbb0cf015a34",
                                                "text": "the heat of summer"
                                            },
                                            {
                                                "example_id": "c15b0b4f-3c65-4cb3-8462-a6c7e58a56e6",
                                                "sense_id": "f2e21bf4-9fa0-3ef4-8bf3-cbb0cf015a34",
                                                "text": "At twilight in the summer there is never anybody to fear—man, woman, or cat—in the chambers and at that hour the mice come out. They do not eat parchment or foolscap or red tape, but they eat the luncheon crumbs."
                                            },
                                            {
                                                "example_id": "aed5da30-f85f-44ea-bead-28cf2ac453db",
                                                "sense_id": "f2e21bf4-9fa0-3ef4-8bf3-cbb0cf015a34",
                                                "text": "A chap named Eleazir Kendrick and I had chummed in together the summer afore and built a fish-weir and shanty at Setuckit Point, down Orham way. For a spell we done pretty well."
                                            },
                                            {
                                                "example_id": "aa65fe08-5363-4f03-a3df-96c3dc561dd0",
                                                "sense_id": "f2e21bf4-9fa0-3ef4-8bf3-cbb0cf015a34",
                                                "text": "A waiter brought his aperitif, which was a small scotch and soda, and as he sipped it gratefully he sighed. ¶ ‘Civilized,’ he said to Mr. Campion. ‘Humanizing.’[…]‘Cigars and summer days and women in big hats with swansdown face-powder, that's what it reminds me of.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca36db46-f530-3314-9e7b-38894c3c8ece",
                                        "entry_id": "4091e655-896d-3879-a3ba-9b2da7dc61ee",
                                        "glosses": [
                                            "year; used to give the age of a person, usually a young one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "humorous",
                                            "poetic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecf808e0-df03-4d01-a464-d1163b0a9322",
                                                "sense_id": "ca36db46-f530-3314-9e7b-38894c3c8ece",
                                                "text": "He was barely eighteen summers old."
                                            },
                                            {
                                                "example_id": "f2eb5fa6-5a4d-4428-999b-e99bcdb2cddb",
                                                "sense_id": "ca36db46-f530-3314-9e7b-38894c3c8ece",
                                                "text": "She had seen not more than twenty summers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7aae8aba-9ae8-3069-b863-dd6d84dd1d67",
                                        "entry_id": "4091e655-896d-3879-a3ba-9b2da7dc61ee",
                                        "glosses": [
                                            "Most flourishing, happy, or beautiful period; golden age, prime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b75d83dc-9060-47e2-9258-20c2577aa8d8",
                                                "sense_id": "7aae8aba-9ae8-3069-b863-dd6d84dd1d67",
                                                "text": "O! craving heart, for the lost flowers\nAnd sunshine of my summer hours!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dac811af-1b51-3d18-9ddc-d0954ac91642",
                                        "entry_id": "4091e655-896d-3879-a3ba-9b2da7dc61ee",
                                        "glosses": [
                                            "Someone with light, pinkish skin that has a blue undertone, light hair and eyes, seen as best suited to certain colors of clothing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
