                "senses": [
                    {
                        "sense_id": "a18188b1-5507-35f3-a185-f81d024cb152",
                        "entry_id": "a3bf6b3b-d717-39a5-8e05-62d0594e7d9e",
                        "glosses": [
                            "aus Wachs gestalteter Gegenstand des Votanten bei der Votation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba593fbc-cc4c-4b74-a48d-8cbd7e8fed0e",
                                "sense_id": "a18188b1-5507-35f3-a185-f81d024cb152",
                                "text": "„Die Wallfahrtskirche Tierberg (Thierberg) bei Kufstein im Tiroler Unterland beherbergt sehr viele, alte Wachsvotive.“"
                            },
                            {
                                "example_id": "17cf4895-e2d2-4558-ba3a-b991d85a50e1",
                                "sense_id": "a18188b1-5507-35f3-a185-f81d024cb152",
                                "text": "„Wer zuhause selbst ein Wachsvotiv oder Wachsobjekt besitzt und mehr darüber erfahren möchte, kann sie am Mittwoch zur Veranstaltung mitbringen.“"
                            },
                            {
                                "example_id": "1b27c89b-fd6b-4a2d-87e0-adce3d4a99f2",
                                "sense_id": "a18188b1-5507-35f3-a185-f81d024cb152",
                                "text": "„Das bekannteste Wachsvotiv und Motiv der Ophthalmologie war das Augenpaar aus rotem Wachs (siehe Abbildung).“"
                            },
                            {
                                "example_id": "74672b74-565e-4a98-97a2-db2c21e4e06b",
                                "sense_id": "a18188b1-5507-35f3-a185-f81d024cb152",
                                "text": "„In der Kapelle wurden damals 288 Votivtafeln, 200 Wachsvotive, 48 Bruchbinden, 15 Krücken und 15 hölzerne Herzen, Lebern und Lungen sichergestellt.“"
                            },
                            {
                                "example_id": "cba3d17a-360c-4b6e-b3f9-f4663173f80e",
                                "sense_id": "a18188b1-5507-35f3-a185-f81d024cb152",
                                "text": "„Den Buchdeckel bildete das Ausstellungsplakat, das neben einer Darstellung der Maria Hilf auch ein rotes Wachsvotiv zeigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
