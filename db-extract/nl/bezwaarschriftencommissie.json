                        "examples": [
                            {
                                "example_id": "9eb8a68b-3ca4-4fa2-aeaa-71392f47fe1b",
                                "sense_id": "c95f4b17-d76b-3a3e-bab4-02561a75f240",
                                "text": "De bezwaarschriftencommissie van de gemeente waarschuwde al dat de burgemeester niet bevoegd is om zo'n verbod in te stellen, maar Kats legde het advies naast zich neer. Volgens de twee uitbaters kon de burgemeester zich ook niet beroepen op het belang van de openbare orde, omdat van verstoring daarvan door het gebruik van lachgas geen sprake was."
                            },
                            {
                                "example_id": "2c0623c0-5338-47be-8ec9-81a343c960bd",
                                "sense_id": "c95f4b17-d76b-3a3e-bab4-02561a75f240",
                                "text": "Juriste Alice van Hest maakte in 2016 een ambtenaar uit voor pias tijdens een zitting van de bezwaarschriftencommissie. Hij wilde volgens Van Hest geen reactie geven op een ingediend bezwaar. \"Hij zat daar maar met z'n handen omhoog. Ik wilde hem eigenlijk uit de tent lokken,\" vertelt Van Hest. \"Hij deed me aan een trekpop denken. Vandaar dat ik op het woord pias kwam.\""
                            }
                        ]
                    }
