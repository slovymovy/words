                        "entry_id": "7b4e67e4-c121-34c4-b623-b355e47780c0",
                        "glosses": [
                            "Village du District central au Botswana, situé le long de la rivière Nata."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
