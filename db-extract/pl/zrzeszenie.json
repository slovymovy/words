                        "entry_id": "7235c629-40d5-3100-b1a3-ff31c5f651b3",
                        "glosses": [
                            "organizacja skupiająca osoby zajmujące się tą samą sprawą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97e52808-9200-45f8-8280-10996963a0f4",
                                "sense_id": "805dd8af-b847-37d4-a2c0-693bf61d8c06",
                                "text": "Może założylibyśmy polskie zrzeszenie fanów Wikisłownika, co?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a086432-e87c-41da-8ab8-dcfc6bb797ca",
                        "source_entry_id": "7235c629-40d5-3100-b1a3-ff31c5f651b3",
                        "source_sense_id": "805dd8af-b847-37d4-a2c0-693bf61d8c06",
                        "target_lang_word": "association",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "association",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db6b77d1-479b-300e-b7f4-6ca6b74681d5",
                                        "entry_id": "34c63a95-4d8c-3ecf-ad5c-5635dd588e32",
                                        "glosses": [
                                            "The act of associating."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c4fe721-cbe6-4e46-aae5-25ef1bb5847c",
                                                "sense_id": "db6b77d1-479b-300e-b7f4-6ca6b74681d5",
                                                "text": "And it is a characteristic of man that he alone has any sense of good and evil, of just and unjust, and the like, and the association of living beings who have this sense makes a family and a state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "627f9ec7-56ae-303c-af6f-ce40252bf7fc",
                                        "entry_id": "34c63a95-4d8c-3ecf-ad5c-5635dd588e32",
                                        "glosses": [
                                            "The state of being associated; a connection to or an affiliation with something."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5ee7de8-ded2-404c-ba8c-622b23257049",
                                                "sense_id": "627f9ec7-56ae-303c-af6f-ce40252bf7fc",
                                                "text": "\"Well,\" exclaimed Lady Marchmont, breathing the perfume with which a honeysuckle, wound around an old ash, filled the air, \"I do confess that I like common flowers better than any. The hothouse plant has no associations.\""
                                            },
                                            {
                                                "example_id": "f1a4e798-d512-4384-aae1-40e2e3b76e17",
                                                "sense_id": "627f9ec7-56ae-303c-af6f-ce40252bf7fc",
                                                "text": "Few concepts are as emotionally charged as that of race. The word conjures up a mixture of associations—culture, ethnicity, genetics, subjugation, exclusion and persecution. But is the tragic history of efforts to define groups of people by race really a matter of the misuse of science, the abuse of a valid biological concept?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07d6e28d-577b-3287-9d68-880e08e82bee",
                                        "entry_id": "34c63a95-4d8c-3ecf-ad5c-5635dd588e32",
                                        "glosses": [
                                            "Any relationship between two measured quantities that renders them statistically dependent (but not necessarily causal or a correlation)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16b6f5cb-3fff-3559-98ab-63fbf6d08cd1",
                                        "entry_id": "34c63a95-4d8c-3ecf-ad5c-5635dd588e32",
                                        "glosses": [
                                            "A group of persons associated for a common purpose; an organization; society."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc519a21-29a0-38e1-99a5-7703eeba5ea9",
                                        "entry_id": "34c63a95-4d8c-3ecf-ad5c-5635dd588e32",
                                        "glosses": [
                                            "Relationship between classes of objects that allows one object instance to cause another to perform an action on its behalf."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "346e2750-55ea-3ee0-83d2-437c16182f65",
                                        "entry_id": "34c63a95-4d8c-3ecf-ad5c-5635dd588e32",
                                        "glosses": [
                                            "A benevolent overseas Chinese organization of popular origin for overseas Chinese individuals with the same surname, geographical origin, location, trade or business."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14287322-b4f8-4d0d-8d08-4cb404e80ce6",
                        "source_entry_id": "7235c629-40d5-3100-b1a3-ff31c5f651b3",
                        "source_sense_id": "805dd8af-b847-37d4-a2c0-693bf61d8c06",
                        "target_lang_word": "organisation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organisation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1f8702e-689a-3f45-8914-25e41c8d1c06",
                                        "entry_id": "d853a0b0-071e-3aee-b9b4-78cc54af856b",
                                        "glosses": [
                                            "Non-Oxford British English and Australian standard spelling of organization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb813777-afc6-447f-b2d2-741b020e7e36",
                                                "sense_id": "f1f8702e-689a-3f45-8914-25e41c8d1c06",
                                                "text": "[…] a number of commentators have noted how, during meetings and in committees, for example, organisation members often experience an attack of the sillies by playing the fool and horsing around."
                                            },
                                            {
                                                "example_id": "980ed528-153b-406c-815c-7f2acfb67fcd",
                                                "sense_id": "f1f8702e-689a-3f45-8914-25e41c8d1c06",
                                                "text": "We know that many male City employees still go to lapdancing clubs for a fun night out. We know City organisations have struggled in their vaunted attempts to get more women on boards."
                                            },
                                            {
                                                "example_id": "8d43121b-0670-4b34-8997-406196e032c8",
                                                "sense_id": "f1f8702e-689a-3f45-8914-25e41c8d1c06",
                                                "text": "Although excessive organisation began as a hobby of the ultra-wealthy (Shearer and Teplin once sorted Reese Witherspoon’s closet, and charge more than £200 an hour for their services), storage-stuffed homes are increasingly commonplace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7dc9a588-7c35-4814-b84f-f12eb4da512e",
                        "source_entry_id": "7235c629-40d5-3100-b1a3-ff31c5f651b3",
                        "source_sense_id": "805dd8af-b847-37d4-a2c0-693bf61d8c06",
                        "target_lang_word": "organization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9d7b4ab-71f2-3b85-a768-3eeb28301f1a",
                                        "entry_id": "c673ecd0-8e60-3de2-a440-e5ba3977dd90",
                                        "glosses": [
                                            "The quality of being organized."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6caaa434-6507-4c0b-9df6-fa7875112421",
                                                "sense_id": "b9d7b4ab-71f2-3b85-a768-3eeb28301f1a",
                                                "text": "This painting shows little organization at first glance, but little by little the structure becomes clear."
                                            },
                                            {
                                                "example_id": "6b00ac3d-f938-4fcd-8113-ca043f404d4a",
                                                "sense_id": "b9d7b4ab-71f2-3b85-a768-3eeb28301f1a",
                                                "text": "The yawning gap in neuroscientists’ understanding of their topic is in the intermediate scale of the brain’s anatomy. Science has a passable knowledge of how individual nerve cells, known as neurons, work. It also knows which visible lobes and ganglia of the brain do what. But how the neurons are organised in these lobes and ganglia remains obscure. Yet this is the level of organisation that does the actual thinking—and is, presumably, the seat of consciousness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40f31498-edc3-38b7-aaf8-58e5f6307af4",
                                        "entry_id": "c673ecd0-8e60-3de2-a440-e5ba3977dd90",
                                        "glosses": [
                                            "The way in which something is organized, such as a book or an article."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d172a98a-0356-4b00-8a17-6173a1a45847",
                                                "sense_id": "40f31498-edc3-38b7-aaf8-58e5f6307af4",
                                                "text": "The organization of the book is as follows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50264c26-8500-305a-920a-f0b8b692ca98",
                                        "entry_id": "c673ecd0-8e60-3de2-a440-e5ba3977dd90",
                                        "glosses": [
                                            "A group of people or other legal entities with an explicit purpose and written rules."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abaf9d55-706f-47bd-bb3d-16fa3981176f",
                                                "sense_id": "50264c26-8500-305a-920a-f0b8b692ca98",
                                                "text": "In response to the crisis, the nations in the region formed an organization. If you want to be part of this organization, you have to follow its rules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e199ea86-717b-31fa-8fc9-1e8ba74e1467",
                                        "entry_id": "c673ecd0-8e60-3de2-a440-e5ba3977dd90",
                                        "glosses": [
                                            "A group of people consciously cooperating."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2aeec8d-981c-434f-8626-35c66240d896",
                                                "sense_id": "e199ea86-717b-31fa-8fc9-1e8ba74e1467",
                                                "text": "Over time, the spontaneous movement had become an organization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6297d581-d15a-32b1-a0ce-1ebcad9097ea",
                                        "entry_id": "c673ecd0-8e60-3de2-a440-e5ba3977dd90",
                                        "glosses": [
                                            "A major league club and all its farm teams."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51d200e8-28ca-4580-89b3-8007b65c7ce9",
                                                "sense_id": "6297d581-d15a-32b1-a0ce-1ebcad9097ea",
                                                "text": "He's been in the Dodgers' organization since 2003."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
