                ],
                "senses": [
                    {
                        "sense_id": "a6714257-44fc-3157-bbc2-600582f35cd6",
                        "entry_id": "ca35c93b-09e2-35f5-aca2-1c56d7176373",
                        "glosses": [
                            "Membre d’un peuple amérindien qui constitue la plus grande ethnie autochtone d’Amazonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcd3814d-2473-46dc-b859-48365e428d28",
                                "sense_id": "a6714257-44fc-3157-bbc2-600582f35cd6",
                                "text": "Dans cette lutte contre des pratiques destructrices pour une espèce en danger, l’ONG a trouvé un soutien auprès de la population indigène locale, les Tikuna."
                            },
                            {
                                "example_id": "4b597366-7562-4129-856a-c9604a0a1cca",
                                "sense_id": "a6714257-44fc-3157-bbc2-600582f35cd6",
                                "text": "Chez les Tikuna, des Indiens vivant en Amazonie, les humains étaient à l’origine immortels."
                            },
                            {
                                "example_id": "929d1fc0-d21e-4aa4-bad6-34d30e671bca",
                                "sense_id": "a6714257-44fc-3157-bbc2-600582f35cd6",
                                "text": "Entre 1630 et 1640, les Tikuna étaient considérés comme un peuple semi-nomade. Peuple semi-nomade, mais négociateurs et commerçants, puisqu’ils entretenaient des relations avec les missionnaires et les marchands dès l’époque coloniale."
                            }
                        ]
                    }
