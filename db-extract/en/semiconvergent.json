                "senses": [
                    {
                        "sense_id": "def9b56e-6e5f-32b5-bed2-d23bae2fe0d4",
                        "entry_id": "12f4d8c3-7e98-3462-aaf9-759412344287",
                        "glosses": [
                            "A kind of fraction. If (h_n-1)/(k_n-1), (h_n)/(k_n) are successive convergents, then any fraction of the form (h_n-1+ah_n)/(k_n-1+ak_n), where a is a nonnegative integer and the numerators and denominators are between the n and n+1 terms inclusive, is a semiconvergent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acca19fb-2beb-4bc7-b305-e69ec0201108",
                                "sense_id": "def9b56e-6e5f-32b5-bed2-d23bae2fe0d4",
                                "text": "The semiconvergents to the continued fraction expansion of a real number include all the rational approximations which are better than any approximation with a smaller denominator."
                            }
                        ]
                    }
                ],
