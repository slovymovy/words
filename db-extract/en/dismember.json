                                                "example_id": "270d3388-eaac-4393-ac85-2904c0301f5c",
                                                "sense_id": "58e166dc-0240-3163-8c53-c7987e52290f",
                                                "text": "„Ein berühmter Anatom zergliederte den Leichnam eines syphilitischen Weibes und verletzte sich am Finger.“ (1837)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fad513c3-9aaa-3c6a-953f-24f32eaf04ef",
                                        "entry_id": "0ce389c9-d8c1-350c-9108-5b802ccdc1d7",
                                        "glosses": [
                                            "in seine Bestandteile auflösen, um etwas näher zu untersuchen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbce8d30-4b57-4762-ac6f-9d3e3b118418",
                                                "sense_id": "fad513c3-9aaa-3c6a-953f-24f32eaf04ef",
                                                "text": "Wenn wir die Fragestellung zergliedern, kommen wir zum Kern des Problems. Es geht um Eifersucht."
                                            },
                                            {
                                                "example_id": "a0436dac-8457-4cd2-b7b2-f92892a7304a",
                                                "sense_id": "fad513c3-9aaa-3c6a-953f-24f32eaf04ef",
                                                "text": "„Besser ist es, diese Aufgabe als Ziel zu definieren und dieses Ziel in Unterziele zu zergliedern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
