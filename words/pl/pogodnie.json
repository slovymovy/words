                        {
                            "text": "Na zewnątrz zrobiło się <w>pogodnie</w>, więc poszliśmy na spacer do parku.",
                            "target_lang_translations": {
                                "ru": "На улице стало <w>солнечно</w>, поэтому мы пошли гулять в парк."
                            }
