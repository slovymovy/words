    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "29f1a94d-795a-3f6b-b1b2-ade120a7e41e",
                    "sense_definition": "Dirty, shabby, or in a state of disrepair.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to throw away his <w>grungy</w> old sneakers after they started falling apart.",
                            "target_lang_translations": {
                                "ru": "Он решил выбросить свои <w>грязные</w> старые кроссовки после того, как они начали разваливаться."
                            }
                        },
                        {
                            "text": "The walls of the <w>grungy</w> basement were covered in dust and peeling paint.",
                            "target_lang_translations": {
                                "ru": "Стены <w>обшарпанного</w> подвала были покрыты пылью и облупившейся краской."
                            }
                        }
                    ],
                    "antonyms": [
                        "clean",
                        "pristine",
                        "tidy"
                    ],
                    "common_phrases": [
                        "grungy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe messy or unkempt appearances"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грязный, поношенный или находящийся в плохом состоянии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязный",
                                "target_lang_sense_clarification": "запачканный или неопрятный"
                            },
                            {
                                "target_lang_word": "зачуханный",
                                "target_lang_sense_clarification": "разговорное, о поношенном или неухоженном виде"
                            },
                            {
                                "target_lang_word": "обшарпанный",
                                "target_lang_sense_clarification": "о вещах или помещениях в плохом состоянии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30563a2f-831c-30b0-9340-2b8a3c8e2d26",
                    "sense_definition": "Relating to or characteristic of grunge music or its associated fashion style.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music and style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played a <w>grungy</w> guitar riff that reminded everyone of the early nineties.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла <w>гранжевый</w> гитарный рифф, который напомнил всем о начале девяностых."
                            }
                        },
                        {
                            "text": "She loves the <w>grungy</w> look of oversized flannel shirts and ripped jeans.",
                            "target_lang_translations": {
                                "ru": "Ей нравится <w>гранжевый</w> образ с безразмерными фланелевыми рубашками и рваными джинсами."
                            }
                        }
                    ],
                    "synonyms": [
                        "grungelike"
                    ],
                    "common_phrases": [
                        "grungy guitar sound",
                        "grungy fashion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к музыке в стиле гранж или соответствующему стилю моды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гранжевый",
                                "target_lang_sense_clarification": "в стиле гранж"
                            },
                            {
                                "target_lang_word": "грязный",
                                "target_lang_sense_clarification": "о специфическом звучании гитар в стиле гранж"
                            }
                        ]
                    }
                }
            ]
        }
    ]
