                    "sense_definition": "A male given name from Latin of American usage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My uncle <w>Oral</w> has lived in the United States for fifty years.",
                            "target_lang_translations": {
                                "ru": "Мой дядя <w>Орал</w> живет в Соединенных Штатах уже пятьдесят лет.",
                                "zh": "我的叔叔<w>奥勒尔</w>已经在美国生活五十年了。"
                            }
                        },
                        {
                            "text": "We met a man named <w>Oral</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на конференции мы встретили мужчину по имени <w>Орал</w>.",
                                "zh": "昨天我们在会议上遇到了一位名叫<w>奥勒尔</w>的男子。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя",
                        "zh": "一个男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Орал",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奥勒尔",
                                "target_lang_sense_clarification": "男性名字音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "257b88e9-882b-31cc-8384-18d09916a7d5",
                    "sense_definition": "A city in Kazakhstan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The city of <w>Oral</w> is located in the northwestern part of Kazakhstan.",
                            "target_lang_translations": {
                                "ru": "Город <w>Уральск</w> расположен в северо-западной части Казахстана.",
                                "zh": "<w>奥拉尔</w>市位于哈萨克斯坦西北部。"
                            }
                        },
                        {
                            "text": "Travelers can take a train to <w>Oral</w> to explore the Ural River region.",
                            "target_lang_translations": {
                                "ru": "Путешественники могут сесть на поезд до <w>Уральска</w>, чтобы исследовать регион реки Урал.",
                                "zh": "游客可以乘火车前往<w>奥拉尔</w>，探索乌拉尔河流域。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в Казахстане",
                        "zh": "哈萨克斯坦的一座城市。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уральск",
                                "target_lang_sense_clarification": "традиционное русское название"
                            },
                            {
                                "target_lang_word": "Орал",
                                "target_lang_sense_clarification": "казахское название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奥拉尔",
                                "target_lang_sense_clarification": "哈萨克斯坦该城市按当地名称的常见音译"
                            },
                            {
                                "target_lang_word": "乌拉尔斯克",
                                "target_lang_sense_clarification": "该城市传统上更常见的俄语名称译法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}