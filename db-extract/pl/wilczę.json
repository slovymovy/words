                ],
                "translations": [
                    {
                        "translation_id": "edec7df4-632c-4adf-a3d5-60cadfc2b5ec",
                        "source_entry_id": "0b3ed3c0-ed51-35f8-a088-c45f58750bfa",
                        "source_sense_id": "c716b5eb-cf54-3315-8ccf-be03b23cbf0f",
                        "target_lang_word": "louveteau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "louveteau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9719562-d126-372d-8975-50508f010172",
                                        "entry_id": "28b1af4b-228d-3438-a91e-22e5683f45b8",
                                        "glosses": [
                                            "Petit du loup et de la louve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffd348c3-a176-49d1-918c-1802182a795b",
                                                "sense_id": "e9719562-d126-372d-8975-50508f010172",
                                                "text": "À la naissance, le louveteau pèse entre 300 et 500 grammes, tandis que le lionceau oscille entre 1,5 et 2 kilos."
                                            },
                                            {
                                                "example_id": "e7d3c12a-0974-4864-9006-262392e0b45e",
                                                "sense_id": "e9719562-d126-372d-8975-50508f010172",
                                                "text": "En fin d'année dernière, un autre loup avait été tué dans une collision avec un véhicule, toujours dans ce même secteur de la Forêt-Noire, un louveteau de 8 mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d02ce5a6-540b-33b3-8a65-c5c40bd7cf05",
                                        "entry_id": "28b1af4b-228d-3438-a91e-22e5683f45b8",
                                        "glosses": [
                                            "Enfant sauvage, livré à lui-même."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c97650c-d2ac-46c4-a3ef-57f0cf7fffdf",
                                                "sense_id": "d02ce5a6-540b-33b3-8a65-c5c40bd7cf05",
                                                "text": "Pierre ne connaissait ni les emportements ni les rêveries maladives des louveteaux de Macquart."
                                            },
                                            {
                                                "example_id": "92dad034-4ef2-495e-b002-cef6e2b9a1c2",
                                                "sense_id": "d02ce5a6-540b-33b3-8a65-c5c40bd7cf05",
                                                "text": "À cette époque, trois filles et un garçon formaient déjà la fratrie. Dix ans plus tard, cinq garçons de plus ont rejoint la meute. Nous étions donc, au total, neuf louveteaux soit trois filles et six garçons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd6d6be4-3807-3079-89dc-50ec71181d81",
                                        "entry_id": "28b1af4b-228d-3438-a91e-22e5683f45b8",
                                        "glosses": [
                                            "Scout âgé de 8 à 12 ans. Les filles du même âge sont nommées louvettes ou louvetelles."
                                        ],
                                        "tags": [
                                            "Scoutisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "140cc621-d600-4ed5-bba9-162074a51b59",
                                                "sense_id": "dd6d6be4-3807-3079-89dc-50ec71181d81",
                                                "text": "— Les levers des couleurs ne sont pas obligatoires aux cantonnements louveteaux."
                                            },
                                            {
                                                "example_id": "bfc27e53-de3b-49db-b653-d32d2a0ccb6a",
                                                "sense_id": "dd6d6be4-3807-3079-89dc-50ec71181d81",
                                                "text": "Les louveteaux composent la meute dans une unité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b6054e1-2c70-3960-b76e-115926e09d3f",
                                        "entry_id": "28b1af4b-228d-3438-a91e-22e5683f45b8",
                                        "glosses": [
                                            "Coin de fer utilisé pour bloquer la louve (instrument de levage)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
