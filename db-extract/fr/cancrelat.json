        "fr-extract.jsonl": [
            {
                "entry_id": "1931ab46-2c6c-33fc-aee5-11ccc9264857",
                "word": "cancrelat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "958c9f72-1374-43c0-abe6-97f7f40ddf49",
                        "entry_id": "1931ab46-2c6c-33fc-aee5-11ccc9264857",
                        "tags": [
                            "plural"
                        ],
                        "form": "cancrelats"
                    },
                    {
                        "form_id": "ece26f67-bb31-4147-ab8f-a20175782730",
                        "entry_id": "1931ab46-2c6c-33fc-aee5-11ccc9264857",
                        "tags": [],
                        "form": "cancrelas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3298c07c-fd66-372e-b886-6f2285c408a8",
                        "entry_id": "1931ab46-2c6c-33fc-aee5-11ccc9264857",
                        "glosses": [
                            "Nom usuel d’une espèce de blatte d’Amérique, de nom scientifique Periplaneta americana, qui a été introduite dans les ports d’Europe où elle infeste les magasins de denrées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c968c03-1507-4369-a5fa-ca5bb8aade34",
                                "sense_id": "3298c07c-fd66-372e-b886-6f2285c408a8",
                                "text": "Le vieux grand-père de Jeanne, ancien marin lui aussi, était à côté de moi, surveillant du coin de l’œil ce déballage, et tout à coup, d’entre des planches que l’on séparait à coups de masse, nous vîmes s’échapper de vilaines petites bêtes brunes, empressées, sur lesquelles les deux matelots sautèrent à pieds joints pour les tuer :\n — Des cancrelats, n’est-ce pas, commandant ? demandai-je au grand-père."
                            },
                            {
                                "example_id": "2f6620b6-3ead-48ca-b77e-3c607e2f9be2",
                                "sense_id": "3298c07c-fd66-372e-b886-6f2285c408a8",
                                "text": "Ce n’est pas des pauvres cancrelats parisiens qui feront reculer un homme qui vient de Batavia."
                            },
                            {
                                "example_id": "df933553-8d42-40b7-b8c0-c0d61666b3bf",
                                "sense_id": "3298c07c-fd66-372e-b886-6f2285c408a8",
                                "text": "La dernière fois, j’ai eu un cancrelat qui est tombé dans mon pippermint."
                            },
                            {
                                "example_id": "f95be495-4fd7-42bc-a820-33ed3c49ccbb",
                                "sense_id": "3298c07c-fd66-372e-b886-6f2285c408a8",
                                "text": "Il attrapa un énorme cancrelat, le mit dans sa besace avec des chikwangues et partit."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f9f20c0-5f06-39e2-8714-29efc161f23b",
                        "entry_id": "1931ab46-2c6c-33fc-aee5-11ccc9264857",
                        "glosses": [
                            "Personne sournoise et envahissante, un peu répugnante."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d83c8205-f1d0-4da8-a685-b359ff3bf665",
                                "sense_id": "9f9f20c0-5f06-39e2-8714-29efc161f23b",
                                "text": "Ma plus grande joie, c’est de siffler un taxi et de monter dedans. Le cancrelat au volant, il en revient pas."
                            }
                        ]
                    }
                ],
