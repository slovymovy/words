                "senses": [
                    {
                        "sense_id": "f8d89432-4d48-346f-86f6-44cf2dab66c0",
                        "entry_id": "99fa50ea-cb01-3858-96f3-997b7d01c7d3",
                        "glosses": [
                            "Action de tondre ; résultat de cette opération."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "170a29ca-2116-476a-ae36-cbe4d40c104b",
                                "sense_id": "f8d89432-4d48-346f-86f6-44cf2dab66c0",
                                "text": "Indépendamment de la dextérité & de la sûreté de la main qu'il faut avoir pour ne pas couper la chair en tondant le poil, selon que le Tondeur a plus ou moins de goût, il tond les chiens plus ou moins élégamment & donne plus de grâce à sa tonture."
                            },
                            {
                                "example_id": "a64ae014-a05c-4760-b2a0-2adb5c2a001a",
                                "sense_id": "f8d89432-4d48-346f-86f6-44cf2dab66c0",
                                "text": "Serpe à tontures, […]. Cependant, cette serpe n'est convenable que pour la tonture des côtés ; il faut toujours se servir de ciseaux pour le dessus, ce qui, du reste, est plus facile, lorsque la taille latérale a diminué la largeur de la bordure."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c9e7a5f-26ba-3ea8-af88-0ef45b20d516",
                        "entry_id": "99fa50ea-cb01-3858-96f3-997b7d01c7d3",
                        "glosses": [
                            "Action de tondre ; résultat de cette opération.",
                            "Poil que l’on tond sur les draps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c8d89a-a94c-45cf-9fe2-924f3cc40e71",
                                "sense_id": "4c9e7a5f-26ba-3ea8-af88-0ef45b20d516",
                                "text": "Seront lesdits draps tondus de bien près, et les tondeurs et apprêteurs leur donneront tous les apprêts et toutes les tontures nécessaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "776513f0-8abc-36e7-91d0-c0bffe064ba9",
                        "entry_id": "99fa50ea-cb01-3858-96f3-997b7d01c7d3",
                        "glosses": [
                            "Branches et feuilles que l’on coupe aux palissades, aux bordures."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "77a7cc3e-5218-3ed6-b544-2c59eaddd157",
                        "entry_id": "99fa50ea-cb01-3858-96f3-997b7d01c7d3",
                        "glosses": [
                            "(Vieilli) Sur un navire, action consistant à relever les préceintes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a366e066-773b-4999-b79e-8abb91706de1",
                                "sense_id": "77a7cc3e-5218-3ed6-b544-2c59eaddd157",
                                "text": "Comme \"L’Étoile\" tirait beaucoup plus d'eau de l’arrière que de l'avant, nous la mîmes rapidement en tonture."
                            }
                        ]
                    },
                    {
                        "sense_id": "2180b28a-cc7e-3505-952b-9784c69dfa2b",
                        "entry_id": "99fa50ea-cb01-3858-96f3-997b7d01c7d3",
                        "glosses": [
                            "Courbure des ponts d’un navire et de son bordage extérieur, dans le sens de la longueur, les extrémités se relevant plus ou moins, relativement au milieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9a4c66c-f8a4-4be1-be76-db086c35dfcb",
                                "sense_id": "2180b28a-cc7e-3505-952b-9784c69dfa2b",
                                "text": "… le pont, qui présente en général une courbure transversale appelée bouge et, au livet en abord, une courbure longitudinale appelée tonture."
                            }
                        ]
                    }
