                                                "example_id": "dfebad08-a43a-4394-832c-07cbf7a0f369",
                                                "sense_id": "dd36a68f-f029-37c3-b43c-241b06a90e8c",
                                                "text": "Here things are getting better and better for women and people of color, and gay men and lesbians, more and more integrated and open, and all you can think about is some stupid, lame problem with signifiers and signifieds."
                                            },
                                            {
                                                "example_id": "5eb9b32f-f056-4517-9922-c13969193b24",
                                                "sense_id": "dd36a68f-f029-37c3-b43c-241b06a90e8c",
                                                "text": "In Peircean terms, topics are interpretants: signifieds that become new signifiers in the endless semiotic chain of interpretations."
                                            }
                                        ]
                                    }
                                ]
                            },
