                            {
                                "example_id": "168afa18-5323-42e2-8418-e1e7977126de",
                                "sense_id": "88ab5d52-6ba6-3f22-afa7-54b4b29b0140",
                                "text": "De Belgische politie heeft onzorgvuldig gehandeld met het toezicht op de jihadkampen in de Ardennen. Dat concludeert het controleorgaan Comité P."
                            },
                            {
                                "example_id": "cd2abc87-d62f-46cf-9be5-0739cdba59bb",
                                "sense_id": "88ab5d52-6ba6-3f22-afa7-54b4b29b0140",
                                "text": "Marokko is de grootste cannabisproducent ter wereld. Volgens een controleorgaan van de Verenigde Naties komt 42 procent van de cannabis wereldwijd uit Marokko. Een groot deel daarvan wordt naar Europa gesmokkeld, onder meer naar Nederland."
                            },
                            {
                                "example_id": "39358e41-1ca8-4478-a7d4-2d4da5b34d57",
                                "sense_id": "88ab5d52-6ba6-3f22-afa7-54b4b29b0140",
                                "text": "De onthullingen van vandaag worden deze week onderzocht door het PKG, het controleorgaan van de Duitse geheime diensten. Dat gaat onderzoeken of de lijst nieuw is, of dat het een onderdeel is van wat al eerder bekend was over de BND."
                            }
                        ]
