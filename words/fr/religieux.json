                    "frequency": "Low",
                    "semantic_group_id": "scrupuleux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il nettoie les tableaux anciens avec un soin <w>religieux</w> pour ne pas les abîmer."
                        },
                        {
                            "text": "L'archiviste classe les documents historiques avec une exactitude <w>religieuse</w> depuis des années."
                        }
                    ],
                    "common_phrases": [
                        "soin religieux",
                        "exactitude religieuse"
                    ]
                }
            ]
        },
