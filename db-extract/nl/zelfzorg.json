                    {
                        "sense_id": "45276f12-f10f-3735-8d0a-22d93e242b74",
                        "entry_id": "933de463-8e7d-366f-9f01-ddce62318729",
                        "glosses": [
                            "alle zorg die een persoon besteedt aan het opheffen van eigen noden en het voldoen aan eigen behoeften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92532574-83ba-4ba0-93e0-7c6ca6bf3b81",
                                "sense_id": "45276f12-f10f-3735-8d0a-22d93e242b74",
                                "text": "Het Rathenau Instituut probeert maatschappelijke discussies op gang te brengen op het gebied van wetenschap en technologie. Volgens het instituut zijn producten voor medische zelfzorg, zoals bloeddrukmeters en zelftests populair. Maar wie de apparaten of testjes op een onjuiste manier gebruikt of meetgegevens verkeerd interpreteert, loopt kans zich onnodig zorgen te maken of juist iets belangrijks over het hoofd te zien."
                            },
                            {
                                "example_id": "36b3c0be-04f6-4c19-9f52-2693d8ce99d3",
                                "sense_id": "45276f12-f10f-3735-8d0a-22d93e242b74",
                                "text": "En wat uitvindingen betreft heeft Twente een naam hoog te houden. Er zijn hier veel instellingen en bedrijven bezig met innovaties in de zorg. Denk aan nano-technologie voor diagnoses en medicijntoediening bij de UT, nieuwe revalidatietechnieken bij het Roessingh en handige zelfzorg-apps door regionale softwarebedrijven."
                            }
                        ]
                    }
