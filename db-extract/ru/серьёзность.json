                    {
                        "translation_id": "9c5babc9-5e14-43de-be4c-e01ec0e77df3",
                        "source_entry_id": "9ec4d9f9-ade0-35e4-8dbb-2ae8c5b03ab3",
                        "target_lang_word": "formalidad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formalidad",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e3f69382-f53f-37f9-b125-d4bf38fd0f2a",
                                        "entry_id": "27ade5a3-747b-33d0-809d-ef9561c754af",
                                        "glosses": [
                                            "Precisión, concreción y puntualidad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b023692f-9554-460d-877a-aec468cf82ef",
                                                "sense_id": "e3f69382-f53f-37f9-b125-d4bf38fd0f2a",
                                                "text": "A pesar de la precisión y la formalidad del Sol, los relojes solares tienen dos problemas: la noche y los días nublados"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e301116f-9137-32b9-b42d-e64645946a58",
                                        "entry_id": "27ade5a3-747b-33d0-809d-ef9561c754af",
                                        "glosses": [
                                            "Trámite o exigencia necesaria para la ejecución de algo."
                                        ],
                                        "tags": [
                                            "generalmente en plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3b0e98b-3593-43de-9484-e963010cce69",
                                                "sense_id": "e301116f-9137-32b9-b42d-e64645946a58",
                                                "text": "La definición de la función, considerada a menudo como una formalidad administrativa, debe servir de ocasión para establecer por escrito un \"contrato de confianza\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7f708bd6-e111-3104-be65-d103035604f5",
                                        "entry_id": "27ade5a3-747b-33d0-809d-ef9561c754af",
                                        "glosses": [
                                            "Procedimiento concreto de ejecución de un acto público."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d44d14c-acff-49e8-ac9f-51dcbd61c0b6",
                                                "sense_id": "7f708bd6-e111-3104-be65-d103035604f5",
                                                "text": "La formalidad del acontecimiento se completó con el embanderamiento de la ciudad, y una impecable formación militar frente al Palacio"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "763d2869-05ba-3453-83b0-c949fa8c0967",
                                        "entry_id": "27ade5a3-747b-33d0-809d-ef9561c754af",
                                        "glosses": [
                                            "Solemnidad, gravedad, buen comportamiento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2b6494c-e151-4dd3-9c6b-9183a0b9d139",
                                                "sense_id": "763d2869-05ba-3453-83b0-c949fa8c0967",
                                                "text": "Es característico del pésame el saludo no verbal, entre hombres con una palmada en el hombro y un beso en la mejilla entre las mujeres o entre mujeres y hombres: el darse la mano es señal de mucha formalidad, lo que es corriente en Alemania, pero no en Venezuela"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27f3700d-169c-4b13-b032-71fc37020792",
                        "source_entry_id": "9ec4d9f9-ade0-35e4-8dbb-2ae8c5b03ab3",
                        "target_lang_word": "Ernst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ernst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0409cb81-8efa-3c9e-8a39-72c1d7ec0982",
                                        "entry_id": "0d53a48a-84b9-3827-a8a6-ae5fa8f0db88",
                                        "glosses": [
                                            "scherzlose, überlegte und entschiedene Gesinnung; sachlich, aufrichtige Haltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd3569b4-9cc6-433f-8deb-3c47b2f2702d",
                                                "sense_id": "0409cb81-8efa-3c9e-8a39-72c1d7ec0982",
                                                "text": "Er war mit tiefem Ernst bei der Sache."
                                            },
                                            {
                                                "example_id": "7c9c557d-c77e-44f5-bebb-5bd467df8566",
                                                "sense_id": "0409cb81-8efa-3c9e-8a39-72c1d7ec0982",
                                                "text": "Ich möchte jetzt mit meinen Plänen Ernst machen."
                                            },
                                            {
                                                "example_id": "1e8fe973-0026-4770-b9ac-996647e895ec",
                                                "sense_id": "0409cb81-8efa-3c9e-8a39-72c1d7ec0982",
                                                "text": "Er sagte im Ernst, dass er sich von mir trennen wollte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65ff12b0-fb7d-399d-97c8-7b6efc74cf16",
                                        "entry_id": "0d53a48a-84b9-3827-a8a6-ae5fa8f0db88",
                                        "glosses": [
                                            "Gewichtigkeit bis hin zur Bedrohlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7152826e-c20e-4bc7-ab6f-c58eb61e594a",
                                                "sense_id": "65ff12b0-fb7d-399d-97c8-7b6efc74cf16",
                                                "text": "Der Ernst der Stunde ließ sich auf den Gesichtern der Anwesenden ablesen."
                                            },
                                            {
                                                "example_id": "b288cea9-59e7-4a44-a691-be756b8e0310",
                                                "sense_id": "65ff12b0-fb7d-399d-97c8-7b6efc74cf16",
                                                "text": "Der Ernst der Lage ist unübersehbar."
                                            },
                                            {
                                                "example_id": "10037527-5ca8-4dff-a8b3-a3ba3c7efc37",
                                                "sense_id": "65ff12b0-fb7d-399d-97c8-7b6efc74cf16",
                                                "text": "Zum Ernst seines Zustandes gibt es die widersprüchlichsten Angaben."
                                            },
                                            {
                                                "example_id": "9af6ae1a-f3fe-4ed2-ab81-ebd7f79fe9a8",
                                                "sense_id": "65ff12b0-fb7d-399d-97c8-7b6efc74cf16",
                                                "text": "„Die Herren seien ihr auch gleich recht ernst vorgekommen, wo doch die Kunstmaler meistens ein lockeres, sorgloses Völkchen seien ohne viel Sinn für den Ernst des Lebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
