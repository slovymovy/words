                    {
                        "translation_id": "c0aaca40-e880-4f3c-b471-87d306d80c8f",
                        "source_entry_id": "c246baa9-299b-3f60-8bad-0a2dfb8abf20",
                        "source_sense_id": "778e310c-059f-34df-8651-b3276855dd19",
                        "target_lang_word": "krebsen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krebsen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6014c45b-84a1-3063-85ff-29ffe23fd9ab",
                                        "entry_id": "d567721d-6dcf-34e4-8d65-42e68a86188e",
                                        "glosses": [
                                            "Krebse fangen (fischen)"
                                        ],
                                        "tags": [
                                            "Perfektbildung mit „haben“"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91814ce8-7628-478c-a9f0-245533743c27",
                                                "sense_id": "6014c45b-84a1-3063-85ff-29ffe23fd9ab",
                                                "text": "„Wir krebsten im Mühlbache und trachteten selbst der hurtigen Forelle nach.“"
                                            },
                                            {
                                                "example_id": "813a611e-b61b-4811-9dc0-42e19d9b440e",
                                                "sense_id": "6014c45b-84a1-3063-85ff-29ffe23fd9ab",
                                                "text": "„Eben so wenig darf auf gleiche Entfernung bei oder in dem Walde, in den Flüssen und Seen, bei Kiehn oder anderm Feuer gefischt oder gekrebst werden.“ (1824)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "150bf6e1-d3a9-3b05-8a0b-5e5cb78d59e1",
                                        "entry_id": "d567721d-6dcf-34e4-8d65-42e68a86188e",
                                        "glosses": [
                                            "sich nur langsam und tastend-kriechend fortbewegen; sehr langsam vorankommen"
                                        ],
                                        "tags": [
                                            "von der Fortbewegung; Perfektbildung mit „sein“"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00bbcb87-a2f8-4e8d-a183-419366042b51",
                                                "sense_id": "150bf6e1-d3a9-3b05-8a0b-5e5cb78d59e1",
                                                "text": "„Wir krebsten – (denn ein ordentliches Laviren konnte man's nicht nennen! –) erbärmlich auf der Nordsee herum, bis wir endlich in den Kanal gelangten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cb158dec-5208-39ca-96dc-c5ed9f5e9291",
                                        "entry_id": "d567721d-6dcf-34e4-8d65-42e68a86188e",
                                        "glosses": [
                                            "viel und hart arbeiten, sich abmühen, und dennoch keinen oder nur kaum Erfolg haben"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fdd4535-c76f-447a-9a04-fb08248ad53e",
                                                "sense_id": "cb158dec-5208-39ca-96dc-c5ed9f5e9291",
                                                "text": "„Viele Väter krebsen am Existenzminimum – das bedeutet, dass viele den Unterhalt nicht zahlen können, obwohl sie wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
