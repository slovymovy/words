                        "examples": [
                            {
                                "example_id": "80431a44-5f86-4f2c-a553-7bd92e51cdea",
                                "sense_id": "ecf9c298-5182-31cb-87e8-344b37f4475b",
                                "text": "Het is weer de zesendertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "fe788081-0554-42c5-8fdd-1dc98a5b60ee",
                                "sense_id": "ecf9c298-5182-31cb-87e8-344b37f4475b",
                                "text": "Haar zevenendertigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de zesendertig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "063baf46-7da7-3ab8-a561-ca02d19601ca",
                        "entry_id": "7af33667-247d-3283-98fd-939765570425",
                        "glosses": [
