            {
                "entry_id": "20180a94-cf02-3ecf-98cf-22649f2db5f3",
                "word": "Deense",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2194d630-b9a4-3ab6-9b51-8ca703847f82",
                        "entry_id": "20180a94-cf02-3ecf-98cf-22649f2db5f3",
                        "glosses": [
                            "verbogen vorm van de stellende trap van Deens"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "15d27b1b-3400-466d-b032-0f28ef94f89b",
                                "sense_id": "2194d630-b9a4-3ab6-9b51-8ca703847f82",
                                "text": "Denemarken ook nauwelijks, in de pers hadden ze het uitgebreid gehad over de gemoedelijke verhouding tussen de Deense bevolking en de Duitse gasten. De koning en de regering van Denemarken zaten nog op hun plaats en de samenwerking leek uitstekend te functioneren binnen de Germaanse verbroedering."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ce3a8e09-0fa2-395f-b76e-1acdc557bcd7",
                "word": "Deense",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d17abdbc-5734-4ac5-ae8c-dc2b9f2066bd",
                        "entry_id": "ce3a8e09-0fa2-395f-b76e-1acdc557bcd7",
                        "tags": [
