                "senses": [
                    {
                        "sense_id": "d1ebee90-0eb4-3a31-856b-1420a0ea7d13",
                        "entry_id": "71ecc4a7-1534-3743-a822-efced2489d00",
                        "glosses": [
                            "A wooded area with sugar maples or other trees tapped for sugaring."
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "83adb652-9d42-40f6-a250-33ff1d91b818",
                                "sense_id": "d1ebee90-0eb4-3a31-856b-1420a0ea7d13",
                                "text": "Meronyms: sugarhouse, sugar shack"
                            },
                            {
                                "example_id": "6b5b1ef2-f9fe-496f-805d-4ba75938d0e6",
                                "sense_id": "d1ebee90-0eb4-3a31-856b-1420a0ea7d13",
                                "text": "Many a small family farm in Vermont had a sugarbush back in the day."
                            },
                            {
                                "example_id": "10d696bd-075a-454b-99c5-ac6a53598479",
                                "sense_id": "d1ebee90-0eb4-3a31-856b-1420a0ea7d13",
                                "text": "In some 21st-century sugarbushes, plastic tubing conveys the sap to the sugarhouse."
                            },
                            {
                                "example_id": "17d035a8-b999-4f6e-afd5-34c2b45132f5",
                                "sense_id": "d1ebee90-0eb4-3a31-856b-1420a0ea7d13",
                                "text": "Indeed, acid rain has long been pointed to as the culprit in the diminished productivity and value of northern Maine and Vermont sugarbush (maple syrup producing trees)."
                            },
                            {
                                "example_id": "31661f4a-6f1b-4550-b4a8-e81f6ac1e94a",
                                "sense_id": "d1ebee90-0eb4-3a31-856b-1420a0ea7d13",
                                "text": "2001, Howard Paap, Northern Land: Life with the Ojibwe http://books.google.com/books?vid=ISBN1878569783&id=E49tv0IUbzwC&pg=PA23&lpg=PA23&ots=NgTARD3OW6&dq=sugarbush+maple&sig=Jd72oibGUPlSUo6EOGJfaOvspgM\nThe labor I offer in my friends' sugarbush is strenuous, but it brings a welcome fatigue."
                            },
                            {
                                "example_id": "a0fa2b38-9a71-40af-834a-81fe2d424d69",
                                "sense_id": "d1ebee90-0eb4-3a31-856b-1420a0ea7d13",
                                "text": "Then rough lean-tos and later huts were constructed near the sugarbush to offer some protection to the syrup and the boiler."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e99bad2-8844-3c4f-a962-3601b1417553",
