                        },
                        {
                            "text": "Bij de <w>huur</w> van een auto moet je vaak een borgsom betalen.",
                            "target_lang_translations": {
                                "ru": "При <w>аренде</w> автомобиля часто нужно вносить залог.",
                                "en": "With the <w>rental</w> of a car, you often have to pay a deposit.",
                                "pl": "Przy <w>wynajmie</w> samochodu często trzeba wpłacić kaucję.",
                                "de": "Bei der <w>Anmietung</w> eines Autos muss man oft eine Kaution hinterlegen.",
                                "fr": "Lors de la <w>location</w> d'une voiture, il faut souvent payer une caution.",
                                "it": "Per il <w>noleggio</w> di un'auto spesso si deve pagare un deposito cauzionale.",
                                "cs": "Při <w>pronájmu</w> auta musíte často zaplatit kauci.",
                                "tr": "Araba <w>kiralamada</w> genellikle depozito ödemeniz gerekir.",
                                "es": "Al <w>alquilar</w> un coche, a menudo hay que pagar una fianza."
                            }
