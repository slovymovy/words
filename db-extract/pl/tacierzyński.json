                "senses": [
                    {
                        "sense_id": "cf869086-9737-3b11-9ef7-ec46935c5d9b",
                        "entry_id": "66ba53b0-837b-3b45-b765-7cb4b58e06c1",
                        "glosses": [
                            "paternal"
                        ],
                        "tags": [
                            "nonce-word",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c5ba2b45-d29d-4425-b980-0e141c1f24da",
                                "sense_id": "cf869086-9737-3b11-9ef7-ec46935c5d9b",
                                "text": "Sam się sobie dziwi, że pomaga. Chyba wcześniej tak nie miał, tylko: - albo jakoś podświadomie wyczuł, kim jest Markus / - albo Markus wyglądał tak nieszczęśliwie, że obudził w nim instynkt tacierzyński",
                                "translation": "He's equally surprised that he's helping. He's probably never experienced anything like that, either he subconsciously intuited who Markus was, or Markus looked so unhappy that it awoke a paternal instinct in him.",
                                "english": "He's equally surprised that he's helping. He's probably never experienced anything like that, either he subconsciously intuited who Markus was, or Markus looked so unhappy that it awoke a paternal instinct in him."
                            },
                            {
                                "example_id": "faf69be6-9ef3-450f-a936-02f06b7c18f8",
                                "sense_id": "cf869086-9737-3b11-9ef7-ec46935c5d9b",
                                "text": "Dlaczego macierzyński od razu? A może tacierzyński (he, brzmi jak jakieś nazwisko :-).",
                                "translation": "Why maternal off the bat? And maybe paternal (heh, that sounds like a last name :-)",
                                "english": "Why maternal off the bat? And maybe paternal (heh, that sounds like a last name :-)"
                            },
                            {
                                "example_id": "ed430c4f-ec91-4d51-b742-f41f0ceac356",
                                "sense_id": "cf869086-9737-3b11-9ef7-ec46935c5d9b",
                                "text": "Albo więc dzieci Jarosława nie są dość wyrosłe, albo opóźniony instynkt \"tacierzyński\" atakuje złe cele.",
                                "translation": "So either Jarosław's children are not grown up enough, or the delayed paternal instinct is attacking the wrong targets.",
                                "english": "So either Jarosław's children are not grown up enough, or the delayed paternal instinct is attacking the wrong targets."
                            },
                            {
                                "example_id": "5cb4cc8c-27cf-431a-b9b4-8a6ef6922a4c",
                                "sense_id": "cf869086-9737-3b11-9ef7-ec46935c5d9b",
                                "text": "Mój mąż był bardzo tacierzyński.",
                                "translation": "My husband was very paternal.",
                                "english": "My husband was very paternal."
                            }
                        ]
                    }
