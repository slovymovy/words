                                "example_id": "7a77a386-9615-4310-a295-c3057d2a090a",
                                "sense_id": "1c2f81f5-c257-323a-a582-3842012fff4c",
                                "text": "„Das Stalagmometer wird senkrecht in ein Stativ eingespannt und am oberen Ende ein Schlauchstück, das mit einer Schlauchklemme versehen ist, aufgesetzt.“"
                            },
                            {
                                "example_id": "86100c88-d3a8-4633-86e5-3de3added06a",
                                "sense_id": "1c2f81f5-c257-323a-a582-3842012fff4c",
                                "text": "„Zur Messung der Oberflächenspannung dient das Stalagmometer nach Traube.“"
                            }
                        ],
