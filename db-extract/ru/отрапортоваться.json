                "senses": [
                    {
                        "sense_id": "0a728ce2-f672-3734-ad27-73f7d787d3e8",
                        "entry_id": "1f2cee91-605b-39fa-8980-ca4d303ad3e4",
                        "glosses": [
                            "отчитаться, доложиться, представиться"
