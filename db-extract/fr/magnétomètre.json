            {
                "entry_id": "38ab6448-a15f-3829-bb8b-8c3f29a4d497",
                "word": "magnétomètre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "45c48724-9394-4536-9cca-e66240c72fcf",
                        "entry_id": "38ab6448-a15f-3829-bb8b-8c3f29a4d497",
                        "tags": [
                            "plural"
                        ],
                        "form": "magnétomètres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c69ccd01-34e5-3eaf-9cf2-853fb8e37e9d",
                        "entry_id": "38ab6448-a15f-3829-bb8b-8c3f29a4d497",
                        "glosses": [
                            "Instrument de mesure employé dans les observations ou expériences magnétiques."
                        ],
                        "tags": [
                            "Magnétisme"
                        ],
                        "examples": [
                            {
                                "example_id": "0321627e-1162-4748-aa9d-5f1afc9b6811",
                                "sense_id": "c69ccd01-34e5-3eaf-9cf2-853fb8e37e9d",
                                "text": "Il comprit et approuva immédiatement et se lança avec un enthousiasme incroyable dans la réalisation de ce qui devait se révéler pendant plusieurs années le meilleur magnétomètre à champ terrestre existant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b28f09c-fed2-480a-9bc8-402ece15bd1e",
                        "source_entry_id": "38ab6448-a15f-3829-bb8b-8c3f29a4d497",
                        "source_sense_id": "c69ccd01-34e5-3eaf-9cf2-853fb8e37e9d",
                        "target_lang_word": "Magnetometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magnetometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a7c0a3e-6105-3ae9-ac5b-4fce3ed7e8cd",
                                        "entry_id": "d4286b95-b7b9-3b8a-873e-86e781f0ab93",
                                        "glosses": [
                                            "Messinstrument zur Ermittlung magnetischer Feldstärke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "829078e2-9362-427c-b887-682b51dc5742",
                                                "sense_id": "3a7c0a3e-6105-3ae9-ac5b-4fce3ed7e8cd",
                                                "text": "„Magnetometer dienen der Messung von Magnetfeldern, ihrer Stärke und auch ihrer Richtung.“"
                                            },
                                            {
                                                "example_id": "d99751a3-e694-400c-bd40-e9255dde7040",
                                                "sense_id": "3a7c0a3e-6105-3ae9-ac5b-4fce3ed7e8cd",
                                                "text": "„Das im Rahmen des SAM-Projektes entstandene Magnetometer mißt die Veränderungen der horizontalen Komponenten des Erdmagnetfeldes.“"
                                            },
                                            {
                                                "example_id": "541e0ada-7d2f-4706-afe7-805c83a204a8",
                                                "sense_id": "3a7c0a3e-6105-3ae9-ac5b-4fce3ed7e8cd",
                                                "text": "„Magnetometer messen das aktuelle Erdmagnetfeld und zeigen Störungen, wie sie von Magnetstürmen ausgehen, direkt an.“"
                                            },
                                            {
                                                "example_id": "342b5de4-a045-47a4-877e-12b5c9a8f771",
                                                "sense_id": "3a7c0a3e-6105-3ae9-ac5b-4fce3ed7e8cd",
                                                "text": "„SQUID Magnetometer zur Messung kleinster magnetischer Momente von Proben mit einer maximalen Größe von 5mm.“"
                                            },
                                            {
                                                "example_id": "9924a54e-368d-4077-935c-e52aa68c98c7",
                                                "sense_id": "3a7c0a3e-6105-3ae9-ac5b-4fce3ed7e8cd",
                                                "text": "„Das Magnetometer besteht aus einem zweigeteilten magnetischen Kern.“"
                                            },
                                            {
                                                "example_id": "e1787bda-83fa-4d81-abe6-0a1ff54e9001",
                                                "sense_id": "3a7c0a3e-6105-3ae9-ac5b-4fce3ed7e8cd",
                                                "text": "„Es gibt es eine Reihe von Magnetometern unterschiedlicher Bauart.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
