                    {
                        "translation_id": "daf93f99-8f75-4fe2-b114-f236e3977036",
                        "source_entry_id": "8227c0c8-bb33-35a2-a694-1d85ecbc5a14",
                        "source_sense_id": "851045f5-d08a-3a12-8342-e6dcf76ee2d4",
                        "target_lang_word": "Subdiakon",
                        "target_lang_code": "de",
