                        ]
                    },
                    {
                        "translation_id": "d4a6e41a-28ad-48ff-ba19-1821b0d277c1",
                        "source_entry_id": "a6e7fb92-feab-3cca-a0b2-10e69c43d54a",
                        "source_sense_id": "556c8ce1-67c3-3000-9a73-442a70ad9b47",
                        "target_lang_word": "antirévolutionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antirévolutionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa9c7a7d-41b4-37ad-b06f-c4613a4452cc",
                                        "entry_id": "6f624c4e-9eed-3dc6-84f5-a88a9ba998bd",
                                        "glosses": [
                                            "Qui est contraire à toute révolution politique ou sociale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc4e4d3-a54f-4c96-9d26-bb6ab13a0a67",
                                                "sense_id": "aa9c7a7d-41b4-37ad-b06f-c4613a4452cc",
                                                "text": "Ils ont, en outre, le tort dʼemployer dans leurs Congrès politiques un langage antiparlementaire et révolutionnaire, tandis quʼau Reichstag leur conduite est antirévolutionnaire, parlementaire."
                                            },
                                            {
                                                "example_id": "6b52eab2-396c-479f-8d19-7a2d3f0b7d50",
                                                "sense_id": "aa9c7a7d-41b4-37ad-b06f-c4613a4452cc",
                                                "text": "Les conventionnels Barère et Grégoire partent en guerre contre les langues autres que le français, les dialectes et la patois, censés véhiculer les idées « antirévolutionnaires » (adjectif neuf, apparu juste avant « révolutionnaire », signe de combats)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antirévolutionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0e0d2a8-f9ad-3b4c-ad94-57158794db09",
                                        "entry_id": "e55b5270-9e71-3d3b-bc5f-9b495840f940",
                                        "glosses": [
                                            "Qui est contraire à toute révolution politique ou sociale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64770cd3-4e44-4d11-8e0e-7acda5d4598c",
                                                "sense_id": "a0e0d2a8-f9ad-3b4c-ad94-57158794db09",
                                                "text": "Un antirévolutionnaire."
                                            },
                                            {
                                                "example_id": "8d4e0165-a25b-4437-b7e5-d8f166414a51",
                                                "sense_id": "a0e0d2a8-f9ad-3b4c-ad94-57158794db09",
                                                "text": "Un antirévolutionnaire juge que la monarchie reviendra du dehors ; un contre-révolutionnaire parie sur la Révolution pour ramener la monarchie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
