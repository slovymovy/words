                            {
                                "example_id": "db5ea37f-4bf3-4bf3-b1cf-c8e75b359942",
                                "sense_id": "e38c59d6-3933-3128-ac34-b39ab0a466d2",
                                "text": "Przed przyjęciem do pracy przeszedł badania lekarskie, w tym próby wątrobowe, których wynik był ujemny"
