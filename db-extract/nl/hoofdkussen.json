                    {
                        "translation_id": "68326217-862e-4eb1-b9ed-1505abb20568",
                        "source_entry_id": "26e7b9ed-c1df-343b-af8e-4ebbe65e06a6",
                        "source_sense_id": "15ef9755-a8f2-31fa-9b58-459c00e61264",
                        "target_lang_word": "Kopfkissen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kopfkissen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b13e8a40-43fa-3ebc-9036-e4da07fdafe3",
                                        "entry_id": "4354ff23-78bf-35a8-b77a-8cb6060c3200",
                                        "glosses": [
                                            "Kissen zur Ablage des Kopfes im Bett"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f33fcad8-1d50-4a72-af1b-35234b726886",
                                                "sense_id": "b13e8a40-43fa-3ebc-9036-e4da07fdafe3",
                                                "text": "Das ist ein Kopfkissen."
                                            },
                                            {
                                                "example_id": "d7e3ba60-8351-464f-a372-fae2c05edd9e",
                                                "sense_id": "b13e8a40-43fa-3ebc-9036-e4da07fdafe3",
                                                "text": "Zum Schlafen brauche ich immer mindestens zwei Kopfkissen."
                                            },
                                            {
                                                "example_id": "fb01737a-830a-4531-a5da-5ff041a1692a",
                                                "sense_id": "b13e8a40-43fa-3ebc-9036-e4da07fdafe3",
                                                "text": "„Er drehte sich um und streckte seine Hand zwischen das Kopfkissen und das Laken.“"
                                            },
                                            {
                                                "example_id": "cda90c6d-491a-4724-bbd3-38b483ef0952",
                                                "sense_id": "b13e8a40-43fa-3ebc-9036-e4da07fdafe3",
                                                "text": "„Ihre Haut war hell, und dunkle Locken breiteten sich auf dem Kopfkissen aus.“"
                                            },
                                            {
                                                "example_id": "71c5222b-b3d7-472c-93fc-88c92cff1e81",
                                                "sense_id": "b13e8a40-43fa-3ebc-9036-e4da07fdafe3",
                                                "text": "„Auf ihrem Kopfkissen war ein Mandarinenentenpaar eingestickt.“"
                                            },
                                            {
                                                "example_id": "a30a82d7-82e3-47bd-b348-a8310fc2e42e",
                                                "sense_id": "b13e8a40-43fa-3ebc-9036-e4da07fdafe3",
                                                "text": "„Rostow steckte die Börse unter das Kopfkissen und drückte die kleine, feuchte Hand, die der andere ihm hinhielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5665c4bc-753e-44fa-86f1-c07086f942e8",
                        "source_entry_id": "26e7b9ed-c1df-343b-af8e-4ebbe65e06a6",
