    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "639ff4a8-f053-333b-b28a-f5baf50c7c59",
                    "sense_definition": "Точно установленный, твёрдо обозначенный или конкретный.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fixed_or_specific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ребёнку надо ложиться спать и вставать по утрам в <w>определённые</w> часы.",
                            "target_lang_translations": {
                                "tr": "Çocuğun sabahları <w>belirli</w> saatlerde yatıp kalkması gerekir."
                            }
                        },
                        {
                            "text": "Каждое лекарство нужно принимать в <w>определённое</w> время суток.",
                            "target_lang_translations": {
                                "tr": "Her ilacın günün <w>belirli</w> bir vaktinde alınması gerekir."
                            }
                        }
                    ],
                    "synonyms": [
                        "установленный",
                        "конкретный"
                    ],
                    "antonyms": [
                        "неопределённый"
                    ],
                    "common_phrases": [
                        "в определённое время",
                        "определённый порядок"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tam olarak belirlenmiş, kesin veya somut."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "belirli",
                                "target_lang_sense_clarification": "kesinleşmiş, saptanmış"
                            },
                            {
                                "target_lang_word": "belirlenmiş",
                                "target_lang_sense_clarification": "kararlaştırılmış"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbd53abf-26a8-364f-b0a1-13bd0eb7210b",
                    "sense_definition": "Тот или иной, некоторый (указывает на наличие признака без его точного называния).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "some_or_certain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При <w>определённых</w> условиях этот эксперимент может закончиться успешно.",
                            "target_lang_translations": {
                                "tr": "<w>Belirli</w> koşullar altında bu deney başarıyla sonuçlanabilir."
                            }
                        },
                        {
                            "text": "У меня возникли <w>определённые</w> трудности с решением этой сложной задачи.",
                            "target_lang_translations": {
                                "tr": "Bu zor problemi çözerken <w>birtakım</w> zorluklarla karşılaştım."
                            }
                        }
                    ],
                    "synonyms": [
                        "не́который"
                    ],
                    "common_phrases": [
                        "при определённых условиях",
                        "определённые трудности"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tam olarak adlandırılmadan varlığına işaret edilen, birtakım, bazı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "belirli",
                                "target_lang_sense_clarification": "bazı, birtakım"
                            },
                            {
                                "target_lang_word": "birtakım",
                                "target_lang_sense_clarification": "bazı, kimi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "127fe9e3-34aa-3ce8-8b4f-85efb478eb83",
                    "sense_definition": "Вполне сложившийся, ясный, чётко выраженный.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clear_and_distinct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У него уже составилось <w>определённое</w> мнение по этому важному вопросу.",
                            "target_lang_translations": {
                                "tr": "Bu önemli konuda kafasında şimdiden <w>net</w> bir görüş oluştu."
                            }
                        },
                        {
                            "text": "Она не дала никакого <w>определённого</w> ответа на наше предложение.",
                            "target_lang_translations": {
                                "tr": "Teklifimize hiçbir <w>kesin</w> cevap vermedi."
                            }
                        }
                    ],
                    "antonyms": [
                        "неопределённый"
                    ],
                    "common_phrases": [
                        "определённое мнение",
                        "определённый ответ"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tamamen oluşmuş, net, açıkça ifade edilmiş."
