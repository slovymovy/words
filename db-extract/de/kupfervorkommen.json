                        "examples": [
                            {
                                "example_id": "6cc67dac-f1a4-40eb-a480-422928bfff6f",
                                "sense_id": "3764f732-3680-3cac-8bbc-0ae75f540e1a",
                                "text": "„Zwar haben sich bereits Investoren vor allem aus China Konzessionen für die Erschließung großer Kupfervorkommen (in Ainaq) und von Erdgasfeldern (bei Shiberghan) gesichert, doch führen die schlechte Sicherheitslage sowie die fehlende Infrastruktur dazu, dass bislang kaum Schritte zur Erschließung der Rohstoffe in die Wege geleitet wurden.“"
                            },
                            {
                                "example_id": "cbcb6cb3-eb2a-43c2-a51e-6f1e0c9b6ca3",
                                "sense_id": "3764f732-3680-3cac-8bbc-0ae75f540e1a",
                                "text": "„Der Löwenanteil des Kupfervorkommens fand sich allerdings als konzentrierte Ansammlung irgendwo unterhalb des Tunnels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
