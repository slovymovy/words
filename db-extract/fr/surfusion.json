                                        "glosses": [
                                            "van een vloeistof dat ze hoewel kouder dan het smeltpunt toch nog vloeibaar is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66f5cd5c-d86e-4c4e-a761-3df08047a7d5",
