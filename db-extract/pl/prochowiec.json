                    {
                        "sense_id": "a2250c84-2749-38da-a50e-4ce69f4a2d7a",
                        "entry_id": "82b7a109-0566-3187-b2c3-2df4a32f071d",
                        "glosses": [
                            "letni męsko-damski płaszcz z cienkiej, gęstej bawełnianej tkaniny"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "04d093e3-8ea0-4f57-b674-be8c8fb5dd92",
                                "sense_id": "a2250c84-2749-38da-a50e-4ce69f4a2d7a",
                                "text": "Zrobiło się zimno, a on wciąż chodził w swoim wysłużonym prochowcu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee43327b-2c86-4311-8f8b-7065f2d850f8",
                        "source_entry_id": "82b7a109-0566-3187-b2c3-2df4a32f071d",
                        "source_sense_id": "a2250c84-2749-38da-a50e-4ce69f4a2d7a",
                        "target_lang_word": "cache-poussière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cache-poussière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c5bd5fc-5c10-3bc6-9edf-47cb23fd5ca6",
                                        "entry_id": "2279cfaf-9543-36af-85bc-e2f1fe0be67a",
                                        "glosses": [
                                            "Vêtement d’un tissu léger pour protéger de la poussière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc21289c-a23e-4d79-9c08-816d82bb1d3d",
                                                "sense_id": "1c5bd5fc-5c10-3bc6-9edf-47cb23fd5ca6",
                                                "text": "Des cache-poussière."
                                            },
                                            {
                                                "example_id": "1708b70a-c541-4a74-aad4-74d15c541845",
                                                "sense_id": "1c5bd5fc-5c10-3bc6-9edf-47cb23fd5ca6",
                                                "text": "Un cache-poussière détrempé, des souliers sans cirage, un pauvre petit feutre verdâtre de rien du tout, et cet aspect des êtres qui, du paquebot, ont passé au chemin de fer, sans se refaire dans une chambre d’hôtel, sans dormir."
                                            },
                                            {
                                                "example_id": "b3a2703e-1a84-4ad9-afd4-af4078fe307d",
                                                "sense_id": "1c5bd5fc-5c10-3bc6-9edf-47cb23fd5ca6",
                                                "text": "Les invités de Mme Frontenac entouraient Arthur Dussol, encore enveloppé d’un cache-poussière gris."
                                            },
                                            {
                                                "example_id": "616dcc26-c423-430a-af86-4876498fcff0",
                                                "sense_id": "1c5bd5fc-5c10-3bc6-9edf-47cb23fd5ca6",
                                                "text": "Ainsi pouvait-on, jusqu’au volant de son vieux tacot, la voir, un chapeau à plumes au sommet de sa haute coiffure d’altesse sérénissime, un cache-poussière ; cachant d’ailleurs fort mal de la poussière la majestueuse robe sur laquelle ruisselaient les perles de vingt majorats."
                                            },
                                            {
                                                "example_id": "7ca38e9d-52e2-4b24-b8f8-c090d558990d",
                                                "sense_id": "1c5bd5fc-5c10-3bc6-9edf-47cb23fd5ca6",
                                                "text": "L’auto, conduite par un chauffeur en cache-poussière blanche à col bleu, s’arrêtait en face du Grand-Hôtel."
                                            },
                                            {
                                                "example_id": "2de1e9fa-8163-4da9-a829-319ea7ad55e9",
                                                "sense_id": "1c5bd5fc-5c10-3bc6-9edf-47cb23fd5ca6",
                                                "text": "On disait qu'elle payait un homme et nous avions honte pour elle de cette âme en savates qu'elle traînait dans le quartier à dix heures du matin, enveloppée dans un cache-poussière, sa bouteille de lait à la main."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "216e4163-49a1-4f10-8516-81d5d592aaff",
                        "source_entry_id": "82b7a109-0566-3187-b2c3-2df4a32f071d",
                        "source_sense_id": "a2250c84-2749-38da-a50e-4ce69f4a2d7a",
