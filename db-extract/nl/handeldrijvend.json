                "senses": [
                    {
                        "sense_id": "40e36ea7-182f-3b16-a2d5-f871ebfd314f",
                        "entry_id": "fc134884-e8cb-3093-b531-04e05933871e",
                        "glosses": [
                            "bezig zijnd met zakendoen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e0cec48-f434-4781-99f0-ba9c57fc20a2",
                                "sense_id": "40e36ea7-182f-3b16-a2d5-f871ebfd314f",
                                "text": "Nederland wordt nogal eens gezien als een land dat vooral sterk is in dienstverlening en bloemen en zuivel. En verder wordt natuurlijk altijd onze befaamde handelsgeest geprezen. Maar we zijn toch echt meer dan een handeldrijvend landje dat tulpen en kaas exporteert. Zo zijn we bijvoorbeeld – verrassend misschien voor sommigen – ook heel sterk in machinebouw."
                            },
                            {
                                "example_id": "1b2709e9-fd7a-457a-861f-aa9becc70465",
                                "sense_id": "40e36ea7-182f-3b16-a2d5-f871ebfd314f",
                                "text": "De methode werkt voor eenvoudige vormen van vermenging (twee groepen, een 'gebeurtenis'), zoals bij de Mozabieten. Dit handeldrijvende Berbervolk uit Algerije blijkt het product van de vermenging van een West-Afrikaanse en een Noord-Afrikaanse 'brongroep'."
                            }
                        ]
                    }
