                ],
                "senses": [
                    {
                        "sense_id": "bfbb207b-3f09-3767-b19b-5484489cbe03",
                        "entry_id": "6f97af33-164a-3b6d-8f60-6e933612cffe",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e666ebf9-40b9-491c-942b-256224ab9aec",
                                "sense_id": "bfbb207b-3f09-3767-b19b-5484489cbe03",
                                "text": "Frau Wiederhold ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cb9adf86-02d0-4a67-80d7-5c03cb3431f6",
                                "sense_id": "bfbb207b-3f09-3767-b19b-5484489cbe03",
                                "text": "Herr Wiederhold wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f4c28ad0-b954-4ffa-9018-de06e245e1ef",
                                "sense_id": "bfbb207b-3f09-3767-b19b-5484489cbe03",
                                "text": "Die Wiederholds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "43e852d9-396c-4b19-b274-eb061ee73a9e",
                                "sense_id": "bfbb207b-3f09-3767-b19b-5484489cbe03",
                                "text": "Der Wiederhold trägt nie die Schals, die die Wiederhold ihm strickt."
                            },
                            {
                                "example_id": "219112b0-e514-4eaa-ab1a-6866806c3786",
                                "sense_id": "bfbb207b-3f09-3767-b19b-5484489cbe03",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wiederhold kommt, geht der Herr Wiederhold.“"
                            },
                            {
                                "example_id": "fe282ec8-dd5c-44c3-a157-5c3229949353",
                                "sense_id": "bfbb207b-3f09-3767-b19b-5484489cbe03",
                                "text": "Wiederhold kommt und geht."
                            },
                            {
                                "example_id": "6a75d8b7-3916-4264-98f3-bfb296778991",
                                "sense_id": "bfbb207b-3f09-3767-b19b-5484489cbe03",
                                "text": "Wiederholds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
