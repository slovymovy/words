                ],
                "senses": [
                    {
                        "sense_id": "84b9909f-da92-3c97-bbda-bc1e41eec34b",
                        "entry_id": "4e261738-4fe8-36c8-9bfe-c6d831cd7e1c",
                        "glosses": [
                            "externer oder interner (implantierter) elektrischer Impulsgeber für den Herzmuskel bei Patienten mit Herzrhythmusstörungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e9734e7-520b-435f-836b-66996bcf667a",
                                "sense_id": "84b9909f-da92-3c97-bbda-bc1e41eec34b",
                                "text": "„Andererseits kann ein Herz, das lange Zeit mit einem sehr langsamen Rhythmus geschlagen hat, durch die von einem Pacemaker aufgezwungene schnellere Schlagfolge insuffizient werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b2a9c0b5-5931-3f44-ab6a-4caadf980f97",
                        "entry_id": "4e261738-4fe8-36c8-9bfe-c6d831cd7e1c",
                        "glosses": [
                            "Pferd, das bei Rennen die Geschwindigkeit des Felds vorgibt"
                        ],
                        "tags": [
                            "Reiten",
                            "Wettrennen"
                        ],
                        "examples": [
                            {
                                "example_id": "fd8ab18a-1664-4286-b7b3-6deb880878a6",
                                "sense_id": "b2a9c0b5-5931-3f44-ab6a-4caadf980f97",
                                "text": "Der Pacemaker wird jetzt deutlich langsamer und fällt hinter das Feld zurück."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "742ab145-cefc-3945-a4e7-93bc84a23887",
                        "entry_id": "4e261738-4fe8-36c8-9bfe-c6d831cd7e1c",
                        "glosses": [
                            "Läufer, der für andere die Geschwindigkeit auf einem konstant hohen Niveau hält und nicht die ganze Distanz absolviert"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "50728e06-b341-4504-8f61-bcc5dfb3a556",
                                "sense_id": "742ab145-cefc-3945-a4e7-93bc84a23887",
                                "text": "„Bei Kilometer acht habe ich den Pacemaker wieder eingeholt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
