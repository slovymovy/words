    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e3ade835-a752-3fe7-937e-fb5d63a5773a",
                    "sense_definition": "Petit sac souple, généralement en papier ou en matière plastique, servant à contenir ou transporter de petits objets ou des aliments.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "contenant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le marchand a mis tous les fruits frais dans un <w>sachet</w> en papier."
                        },
                        {
                            "text": "Elle garde toujours un petit <w>sachet</w> pour ranger ses écouteurs dans son sac."
                        }
                    ],
                    "synonyms": [
                        "pochon"
                    ],
                    "common_phrases": [
                        "sachet en papier",
                        "sachet en plastique"
                    ]
                },
                {
                    "sense_id": "7d92a28d-4e49-3a35-9d66-d6c60a9b1e36",
                    "sense_definition": "Petit emballage scellé et plat contenant une dose ou une portion précise d'un produit alimentaire ou pharmaceutique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "contenant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut verser de l'eau bien chaude directement sur le <w>sachet</w> de thé."
                        },
                        {
                            "text": "N'oubliez pas d'ajouter un <w>sachet</w> de levure dans la pâte du gâteau."
                        }
                    ],
                    "common_phrases": [
                        "sachet de thé",
                        "sachet de levure"
                    ]
                },
                {
                    "sense_id": "b64bcbe7-c3f5-3a32-a809-883dc4303fb4",
                    "sense_definition": "Petit sachet ou coussinet de tissu rempli de substances aromatiques ou de fleurs séchées, servant à parfumer le linge ou une pièce.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "parfumerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma grand-mère glisse toujours un <w>sachet</w> de lavande au milieu des draps propres."
                        },
                        {
                            "text": "Ce <w>sachet</w> parfumé permet de chasser les mauvaises odeurs de la penderie."
                        }
                    ],
                    "common_phrases": [
                        "sachet de lavande",
                        "sachet parfumé"
                    ]
                }
            ]
        }
    ]
