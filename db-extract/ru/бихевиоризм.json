                                        "glosses": [
                                            "podejście do psychologii skupiające się na obserwowalnym zachowaniu, negujące poznawalność umysłu i przeważnie zakładające, że zachowanie jest określane przez środowisko"
                                        ],
                                        "tags": [
                                            "psychology"
                                        ],
                                        "examples": [
                                            {
