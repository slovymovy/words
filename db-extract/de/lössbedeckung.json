                    {
                        "sense_id": "38d1d276-4591-3f02-aa10-35fc480718ea",
                        "entry_id": "0cdf9fb6-a3f1-37ea-bb37-ffb0aa96bdaf",
                        "glosses": [
                            "der Zustand des Bedecktseins der Erdoberfläche mit Löss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7944a833-76dd-4f87-a43f-e196dbb0e9cb",
                                "sense_id": "38d1d276-4591-3f02-aa10-35fc480718ea",
                                "text": "Lössbedeckung kann meterdicke Ausmaße annehmen."
                            },
                            {
                                "example_id": "c2be3403-846c-41e4-848f-189d83ef76a5",
                                "sense_id": "38d1d276-4591-3f02-aa10-35fc480718ea",
                                "text": "Das Gelände südlich des Untermains weist keine Lößbedeckung auf."
                            },
                            {
                                "example_id": "21c51e2b-f7ef-41fe-bc2f-36c86d1448fa",
                                "sense_id": "38d1d276-4591-3f02-aa10-35fc480718ea",
                                "text": "„Lößbedeckung, geringe Reliefunterschiede und trockenwarmes Klima stempeln das Maindreieck und den Ochsenfurter Gau zu Kornkammern.“"
                            },
                            {
                                "example_id": "2592cf9b-6a67-4839-a1aa-54b4118ebe77",
                                "sense_id": "38d1d276-4591-3f02-aa10-35fc480718ea",
                                "text": "Die eiszeitliche Lößbedeckung weiter Landstriche war eine natürliche Mineraldüngung großen Ausmaßes;"
                            },
                            {
                                "example_id": "04ed87be-0e63-4db5-ba15-ff707b623b63",
                                "sense_id": "38d1d276-4591-3f02-aa10-35fc480718ea",
                                "text": "Dabei wurde die Lössbedeckung anthropogen (durch den Menschen) weitgehend entfernt und durch Anschüttungen ersetzt."
                            }
                        ],
