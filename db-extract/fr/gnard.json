                "senses": [
                    {
                        "sense_id": "0b188bfe-719c-3f94-aae6-0a9a3f673082",
                        "entry_id": "030f79f7-8e12-3b9c-97a6-0d8ff3601457",
                        "glosses": [
                            "Enfant."
                        ],
                        "tags": [
                            "familiar",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "85a5e4c9-d19d-4fb9-97e4-10ba2570b578",
                                "sense_id": "0b188bfe-719c-3f94-aae6-0a9a3f673082",
                                "text": "Au lieu de se trimbaler un gnard qui la ferait tartir et lui imposerait ses quatre volontés, elle suit seule sa petite bonne-femme de chemin."
                            },
                            {
                                "example_id": "d80501d3-b2a6-4663-9d8f-14367c7fedce",
                                "sense_id": "0b188bfe-719c-3f94-aae6-0a9a3f673082",
                                "text": "Ben… comme un enfant. Un gnard c'est un gnard. J'l'ai pas bien vu : ente quatre et six ans, un gosse ça n'a pas vraiment d'âge et ils se ressemblent tous."
                            },
                            {
                                "example_id": "477cf64f-db03-4f6c-8057-6656b604a341",
                                "sense_id": "0b188bfe-719c-3f94-aae6-0a9a3f673082",
                                "text": "Va donc faire des gnards avec une chic fille. Tu promets de m'en faire un en plus, rien que pour moi qui peux plus en avoir ?"
                            }
                        ]
                    }
                ],
