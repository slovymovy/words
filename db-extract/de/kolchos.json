                    {
                        "form_id": "3b749940-2e4f-4d6a-892e-e8235faa1dad",
                        "entry_id": "a8e0373f-c44e-33ad-936e-29f8eeb51e54",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kolchose"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7b5adb2-0e85-3c63-9935-d2ece9289e1d",
                        "entry_id": "a8e0373f-c44e-33ad-936e-29f8eeb51e54",
                        "glosses": [
                            "zu Zeiten der Sowjetunion bestehende landwirtschaftliche Produktionsgenossenschaft, deren Mitglieder formal die gemeinsamen Eigentümer der Produktionsmittel waren, während der bewirtschaftete Boden dem Staat gehörte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8834fc4c-0ad8-4194-9947-3f0f6c3d9050",
                                "sense_id": "e7b5adb2-0e85-3c63-9935-d2ece9289e1d",
                                "text": "„Früher hatte Scharofat opa von Feldarbeiten, zuerst im Kolchos, nachher auf den Feldern privater Bauern gelebt.“"
                            },
                            {
                                "example_id": "38e82d58-04aa-4565-9dbc-ebef7d28179c",
                                "sense_id": "e7b5adb2-0e85-3c63-9935-d2ece9289e1d",
                                "text": "„Die Arbeit im Kokswerk, im Kolchos oder auf der Baustelle ist außerordentlich hart, die Versorgung mit Lebensmitteln mangelhaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37922f88-25ef-49c8-8c10-44e5c72180d4",
                        "source_entry_id": "a8e0373f-c44e-33ad-936e-29f8eeb51e54",
                        "source_sense_id": "e7b5adb2-0e85-3c63-9935-d2ece9289e1d",
                        "source_sense_description": "Sowjetunion: landwirtschaftliche Produktionsgenossenschaft",
                        "target_lang_word": "kolkhoz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kolkhoz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4b1c7cf-9add-3949-9adf-1aa4125f08ef",
                                        "entry_id": "6f26bc0e-6807-304b-a222-919d6865f2c6",
                                        "glosses": [
                                            "A farming collective in the former Soviet Union."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c2d5ea4-0e82-4f09-80a4-9c03b0c0e911",
                                                "sense_id": "b4b1c7cf-9add-3949-9adf-1aa4125f08ef",
                                                "text": "And books were demanded of them, books on Russia, on sailors, on aeroplanes, on scientists, on metro-workers, on kolkhoz labourers, on women and schoolchildren and parachute heroes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52475350-c58d-4130-bde4-19efb614e5ea",
                        "source_entry_id": "a8e0373f-c44e-33ad-936e-29f8eeb51e54",
                        "source_sense_id": "e7b5adb2-0e85-3c63-9935-d2ece9289e1d",
                        "source_sense_description": "Sowjetunion: landwirtschaftliche Produktionsgenossenschaft",
                        "target_lang_word": "kolkhoze",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kolkhoze",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64608255-5b04-3d58-9484-996f0600bdd1",
                                        "entry_id": "47c07427-2f82-3949-8e48-925e8389339c",
                                        "glosses": [
                                            "Coopérative agricole en URSS et dans le bloc de l’Est."
                                        ],
                                        "tags": [
                                            "Communisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba6c705d-fd96-4f45-b342-9961b7ada2ba",
                                                "sense_id": "64608255-5b04-3d58-9484-996f0600bdd1",
                                                "text": "Nous visitons aux environs de Soukhoum, un kolkhoze modèle. Il est vieux de six ans. Après avoir péniblement végété les premiers temps, c'est aujourd'hui l'un des plus prospères. […]. Ce kolkhoze s'étend sur un très vaste espace. Le climat aidant, la végétation y est luxuriante."
                                            },
                                            {
                                                "example_id": "49aeff36-72a2-4d56-8d5a-48357ae3a031",
                                                "sense_id": "64608255-5b04-3d58-9484-996f0600bdd1",
                                                "text": "Il y a en URSS environ 50,000 grandes entreprises industrielles d'État, près de 31,500 exploitations coopératives de paysans ou kolkhozes, et 16,000 entreprises agricoles d'État ou sovkhozes."
                                            },
                                            {
                                                "example_id": "c0ad6a3b-e39a-4cac-9aa4-22b64daf2739",
                                                "sense_id": "64608255-5b04-3d58-9484-996f0600bdd1",
                                                "text": "Kolkhozes : fermes collectives d’Union soviétique. Mesure violente de suppression de la propriété privée des koulaks (qui résistèrent en vain). Épisode épouvantable. Une famine qui emporta des millions d’êtres humains."
                                            },
                                            {
                                                "example_id": "81868f36-b5f8-4322-98b6-15270b09d283",
                                                "sense_id": "64608255-5b04-3d58-9484-996f0600bdd1",
                                                "text": "– C’est du baratin ! s’exclama Michael. De la propagande défaitiste de ces foutus mencheviks planqués dans les kolkhozes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
