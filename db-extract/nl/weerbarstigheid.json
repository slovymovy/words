        "nl-extract.jsonl": [
            {
                "entry_id": "6b1565d0-346e-3fff-a628-273a5215d2c9",
                "word": "weerbarstigheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "346a0009-66e6-4795-a42d-af753a4c0c7a",
                        "entry_id": "6b1565d0-346e-3fff-a628-273a5215d2c9",
                        "tags": [
