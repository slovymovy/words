                "senses": [
                    {
                        "sense_id": "8cdc6032-478b-3049-8eaf-8ef5f7650431",
                        "entry_id": "643aee90-93f9-3023-aa1b-715d2ea9b3a2",
                        "glosses": [
                            "Se mettre au lit, se coucher."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0a86b4e9-30a9-481d-a81e-5f9d526e75a7",
                                "sense_id": "8cdc6032-478b-3049-8eaf-8ef5f7650431",
                                "text": "Lidoire, vaguement inquiet.– Ah çà, qu’éq’ tu fabriques ? C’est t’y q’ tu vas pas pagnotter ?"
                            },
                            {
                                "example_id": "c8ec93da-bf96-473f-a9aa-0ef202666b2b",
                                "sense_id": "8cdc6032-478b-3049-8eaf-8ef5f7650431",
                                "text": "Allons ! houste je me pagnotte !"
                            },
                            {
                                "example_id": "4b4a7530-84ad-45cb-bd46-f3c4b161ee95",
                                "sense_id": "8cdc6032-478b-3049-8eaf-8ef5f7650431",
                                "text": "Aussi sont-ils toujours sur le pont ; de toute façon, ils n’ont rien d’autre à foutre ; ils n’ont pas de virago ménagère pour refaire leur pucier quand, par hasard, ils se pagnottent dedans."
                            }
                        ]
                    }
