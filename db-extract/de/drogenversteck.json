                        "glosses": [
                            "Ort, der zur geheimen Aufbewahrung von Rauschmitteln dient; verborgene Stelle zum Verstecken von Rauschmitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b9a8e3c-0677-4a9e-8806-b8ad7cfe085e",
                                "sense_id": "8cea3832-4f44-325e-95ae-c668f6349f43",
                                "text": "„Anschließend rief man die Detectives zu einem Doppelmord in der Luzerne Street, bei dem ein Gangster in einem Territorialstreit in ein Drogenversteck eindrang und wild drauflosfeuerte.“"
                            },
                            {
                                "example_id": "4d6351f9-d32a-4a0e-b284-c90678068296",
                                "sense_id": "8cea3832-4f44-325e-95ae-c668f6349f43",
                                "text": "„Dies war ihr Drogenversteck, ihr Bunker, und ein Stash House war kein nett eingerichteter Kaufladen.“"
                            }
