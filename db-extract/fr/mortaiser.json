                ],
                "senses": [
                    {
                        "sense_id": "f2cee935-dabe-37de-af9f-2969ba82e2e5",
                        "entry_id": "3fd0f2e8-6943-3ffe-b70b-5635d848e427",
                        "glosses": [
                            "Entailler le bois de façon à créer un logement qui reçoit une pièce de bois généralement amincie, appelée le tenon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56e5dcde-cba6-4e21-9f7e-97e319946350",
                                "sense_id": "f2cee935-dabe-37de-af9f-2969ba82e2e5",
                                "text": "Les diverses pièces, taraudées et mortaisées sur la rive, étaient ensuite lancées isolément à la surface du petit lac, et là on les ajustait sans peine."
                            },
                            {
                                "example_id": "343c8af2-3e42-4283-8982-a0a16dba22cf",
                                "sense_id": "f2cee935-dabe-37de-af9f-2969ba82e2e5",
                                "text": "Générations après générations avaient usé leur vie à se mortaiser à leur alvéole exacte, à se calibrer aux mensurations du trou prévoyant qui s'approfondissait pour elles dans les sables."
                            },
                            {
                                "example_id": "1a36c324-3048-4f29-bfc5-46181b1b4a26",
                                "sense_id": "f2cee935-dabe-37de-af9f-2969ba82e2e5",
                                "text": "Ils atteignaient au comble de l’enthousiasme quand, dirigés par les moniteurs — deux militaires en retraite — il leur fallait, à grands coups de bédane ou de burin, dégrossir ou mortaiser des pièces."
                            }
                        ]
                    }
                ],
