                ],
                "senses": [
                    {
                        "sense_id": "5d274f7f-0944-3132-a571-f0f02b8219ea",
                        "entry_id": "510b0ca4-adee-370b-a4b7-9bf50c291db8",
                        "glosses": [
                            "Plante aromatique (Curcuma zedoaria), herbacée rhizomateuse vivace poussant dans les forêts pluvieuses tropicales et subtropicales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee9c6c9f-517d-4c44-bb70-8e4cf6c65897",
                                "sense_id": "5d274f7f-0944-3132-a571-f0f02b8219ea",
                                "text": "Autres prennent au matin, par precaution, de la racine d'enule campane, ou zedoar, ou angelique, en les maschant et tenant en la bouche"
                            },
                            {
                                "example_id": "3f798d0b-d268-45af-b2f4-c5356982ceb8",
                                "sense_id": "5d274f7f-0944-3132-a571-f0f02b8219ea",
                                "text": "Tous les arbres imaginables, chargés de fleurs […], tous ceux qui portent les épices et les parfums, poivre, cannelle, girofle, galinga et zédoaire."
                            },
                            {
                                "example_id": "4a57a403-c06e-4e1b-bd69-caefc7a9fbb7",
                                "sense_id": "5d274f7f-0944-3132-a571-f0f02b8219ea",
                                "text": "On distingue : la zédoaire ronde ou zerumbet, qui vient du Curcuma zedoaria, Roxburgh, ou Curcuma aromatica, Roscoe, Indes et Moluques ; et la zédoaire longue, qu'on attribue à l’Amomum zedoaria, W. (zingibéracées)."
                            }
                        ]
                    }
                ],
