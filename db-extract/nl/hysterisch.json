                "translations": [
                    {
                        "translation_id": "a10739b1-2020-42a1-bb4b-bc046f22506c",
                        "source_entry_id": "d930706f-44a7-3f63-aa7a-855e6657d82b",
                        "target_lang_word": "hysterical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hysterical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90ea7dea-fa10-3800-884d-3484caf23224",
                                        "entry_id": "1898edf1-26bc-37fc-9a70-1c582494045f",
                                        "glosses": [
                                            "Of, or arising from hysteria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "974ab289-4365-4b09-9a03-40d3993067c3",
                                                "sense_id": "90ea7dea-fa10-3800-884d-3484caf23224",
                                                "text": "Henrietta gasped for breath; but she swallowed down the hysterical emotion, and signed with her hand for Walter to go on."
                                            },
                                            {
                                                "example_id": "1e4ed86e-8d5b-45da-8b49-4b834bb45944",
                                                "sense_id": "90ea7dea-fa10-3800-884d-3484caf23224",
                                                "text": "An event of this nature, a marriage, or a refusal, or a proposal, thrills through a whole household of women, and sets all their hysterical sympathies at work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79c1d89e-4e19-37d6-bf0b-45120a04588e",
                                        "entry_id": "1898edf1-26bc-37fc-9a70-1c582494045f",
                                        "glosses": [
                                            "Having, or prone to having hysterics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b23839f-4e95-3211-9c44-a3e114f8b2b6",
                                        "entry_id": "1898edf1-26bc-37fc-9a70-1c582494045f",
                                        "glosses": [
                                            "Provoking uncontrollable laughter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f238115a-3b74-467e-a62e-feb70d6818d4",
                                                "sense_id": "5b23839f-4e95-3211-9c44-a3e114f8b2b6",
                                                "text": "She was a fat, round little woman, richly apparelled in velvet and lace, […]; and the way she laughed, cackling like a hen, the way she talked to the waiters and the maid,[…]—all these unexpected phenomena impelled one to hysterical mirth, and made one class her with such immortally ludicrous types as Ally Sloper, the Widow Twankey, or Miss Moucher."
                                            },
                                            {
                                                "example_id": "496d4e39-a41a-4d19-9a4e-47a8356d0e86",
                                                "sense_id": "5b23839f-4e95-3211-9c44-a3e114f8b2b6",
                                                "text": "There is a certain irony in all of this because in their hysterical use of charge of “double standard” – that Israel is being “singled out for criticism”– it is Israel’s supporters who are themselves guilty of a “double standard”, since, if they were to have their way, it is Israel that would be singled out as the only country that cannot be criticised."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bf71364-15fd-41cc-a604-9de0915b340b",
                        "source_entry_id": "d930706f-44a7-3f63-aa7a-855e6657d82b",
                        "target_lang_word": "histeryczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
