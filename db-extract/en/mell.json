                ],
                "senses": [
                    {
                        "sense_id": "083063d5-beef-38aa-824f-d2a9f5529564",
                        "entry_id": "343b9429-fbcc-39d7-9660-9170681db00f",
                        "glosses": [
                            "To deal, concern oneself; to interfere or meddle."
                        ],
                        "tags": [
                            "dialectal",
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fe63da62-8002-46fe-ab2b-b0b81177ead0",
                                "sense_id": "083063d5-beef-38aa-824f-d2a9f5529564",
                                "text": "For wher so we dwell / Deth wyll us qwell / And with us mell."
                            },
                            {
                                "example_id": "3733b8d4-502f-43dd-89f6-e5d9060e5bc4",
                                "sense_id": "083063d5-beef-38aa-824f-d2a9f5529564",
                                "text": "Here is a great deale of good matter, / loſt for lacke of telling, / Now ſicker I see, thou doeſt but clatter: / harme may come of melling."
                            },
                            {
                                "example_id": "f8236a43-daaf-446c-9d0e-2a5f3f4995cb",
                                "sense_id": "083063d5-beef-38aa-824f-d2a9f5529564",
                                "text": "And ſay a ſouldier (Dian) told thee this: / Men are to mell with, boyes are not to kis."
                            },
                            {
                                "example_id": "fedf717d-b784-43a9-bd5d-86f28fa00db0",
                                "sense_id": "083063d5-beef-38aa-824f-d2a9f5529564",
                                "text": "“By Saint Thomas of Kent,” said he, “an I buckle to my gear, I will teach thee to mell with thine own matters, maugre thine iron case there.”"
                            }
                        ]
                    }
                ],
