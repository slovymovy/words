                ],
                "senses": [
                    {
                        "sense_id": "85017a13-df94-3f7e-a4eb-b37daee4eb88",
                        "entry_id": "95fafeee-83a1-3ee0-b8a7-611b34824b36",
                        "glosses": [
                            "Art und Weise, wie man seinen Körper (aufrecht) hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05d1aaff-7426-4577-aaef-43c913cfe612",
                                "sense_id": "85017a13-df94-3f7e-a4eb-b37daee4eb88",
                                "text": "Man sagt, bei Sitzen sollte man eine gerade Körperhaltung einnehmen."
                            },
                            {
                                "example_id": "94a50f61-e95c-4744-8b3b-8f6220621ba4",
                                "sense_id": "85017a13-df94-3f7e-a4eb-b37daee4eb88",
                                "text": "Eine schlechte Körperhaltung schädigt auf Dauer den Rücken beziehungsweise die Wirbelsäule."
                            },
                            {
                                "example_id": "3399218c-3a70-44cb-b354-47a12cb326a7",
                                "sense_id": "85017a13-df94-3f7e-a4eb-b37daee4eb88",
                                "text": "„Als er seine Körperhaltung bemerkt, erschlafft sie wieder.“"
                            },
                            {
                                "example_id": "882c1fc6-5be8-4fb6-a525-9126c4ae8788",
                                "sense_id": "85017a13-df94-3f7e-a4eb-b37daee4eb88",
                                "text": "„Ihre Sprachlosigkeit wie auch ihre Körperhaltung spiegelte die lange Abwesenheit, die selbst Brief und Tonbandtexte nicht überbrückt hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7a2ae44-6078-4967-bb57-b276fa234d81",
                        "source_entry_id": "95fafeee-83a1-3ee0-b8a7-611b34824b36",
                        "source_sense_id": "85017a13-df94-3f7e-a4eb-b37daee4eb88",
                        "source_sense_description": "Art und Weise, wie man seinen Körper (aufrecht) hält",
                        "target_lang_word": "posture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "posture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "782ddbde-ffd7-3cc7-8283-1fc8a20ebe15",
                                        "entry_id": "d5588dbd-837d-3448-b6fa-a6b52f4c89ae",
                                        "glosses": [
                                            "The way a person holds and positions their body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b69c429f-215b-451e-95f1-588a64ac348b",
                                                "sense_id": "782ddbde-ffd7-3cc7-8283-1fc8a20ebe15",
                                                "text": "As if that whatsoever god who leads him\n Were slily crept into his human powers,\n And gave him graceful posture."
                                            },
                                            {
                                                "example_id": "4d1bfca6-9294-4e76-a8a3-ad9de2aa5a37",
                                                "sense_id": "782ddbde-ffd7-3cc7-8283-1fc8a20ebe15",
                                                "text": "[…] walking in a most dejected posture, without a band, unbraced, his arms a-cross his open breast, and his eyes bent to the floor;"
                                            },
                                            {
                                                "example_id": "063a2cdc-8d3b-49b2-9e23-8531f4ff5861",
                                                "sense_id": "782ddbde-ffd7-3cc7-8283-1fc8a20ebe15",
                                                "text": "Rise, sir, from this semi-recumbent posture. It is most indecorous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed3c4031-b913-316b-90e9-3a4a659f0f60",
                                        "entry_id": "d5588dbd-837d-3448-b6fa-a6b52f4c89ae",
                                        "glosses": [
                                            "A situation or condition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24c73352-45e1-43cf-b1fd-8849f7523ce4",
                                                "sense_id": "ed3c4031-b913-316b-90e9-3a4a659f0f60",
                                                "text": "Even as I was reading these fables of my millions, there lay on the desk before me a statement of the exact posture of my affairs […]"
                                            },
                                            {
                                                "example_id": "ce9528bd-28a1-445d-b295-c301dc4f1c3a",
                                                "sense_id": "ed3c4031-b913-316b-90e9-3a4a659f0f60",
                                                "text": "Uncle Jim stopped amazed. His brain did not instantly rise to the new posture of things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cab84282-c09d-3a51-ac6b-8edf84faf0a1",
                                        "entry_id": "d5588dbd-837d-3448-b6fa-a6b52f4c89ae",
                                        "glosses": [
                                            "One's attitude or the social or political position one takes towards an issue or another person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d0fd40f-3092-4e3e-a08b-411a4a3735fb",
                                                "sense_id": "cab84282-c09d-3a51-ac6b-8edf84faf0a1",
                                                "text": "1651, Thomas Hobbes, Leviathan\n...that is, their Forts, Garrisons, and Guns upon the Frontiers of their Kingdomes; and continuall Spyes upon their neighbours; which is a posture of War."
                                            },
                                            {
                                                "example_id": "eed9e8e2-40f5-4556-ac78-c5eed97752e4",
                                                "sense_id": "cab84282-c09d-3a51-ac6b-8edf84faf0a1",
                                                "text": "1912, G.K. Chesterton, A Miscellany of Men\nBut it is not true, no sane person can call it true, that man as a whole in his general attitude towards the world, in his posture towards death or green fields, towards the weather or the baby, will be wise to cultivate dissatisfaction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17b5dfb5-28eb-33a0-89be-333054511140",
                                        "entry_id": "d5588dbd-837d-3448-b6fa-a6b52f4c89ae",
                                        "glosses": [
                                            "The position of someone or something relative to another; position; situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "841fe9bd-46ee-4bd0-809c-d2ca8aad759e",
                                                "sense_id": "17b5dfb5-28eb-33a0-89be-333054511140",
                                                "text": "1661, Thomas Salusbury (translator), Galileo's Dialogue Concerning the Two Chief Systems of the World\nThe Moon beheld in any posture, in respect of the Sun and us, sheweth us its superficies ... always equally clear."
                                            },
                                            {
                                                "example_id": "5464dda9-f86c-44f1-966d-99287a7f2cd7",
                                                "sense_id": "17b5dfb5-28eb-33a0-89be-333054511140",
                                                "text": "As for the guides, they were debarred from the pleasure of discourse, the one being placed in the van, and the other obliged to bring up the rear.\n In this posture they travelled many hours, till they came into a wide and well-beaten road […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "posture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d10424d3-24b5-3dcb-b23e-5151b84373a7",
                                        "entry_id": "dc8e7621-c9e6-3537-a656-67910600517e",
                                        "glosses": [
                                            "to put one's body into a posture or series of postures, especially hoping that one will be noticed and admired"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "137b7791-a513-4cce-bb09-f7e2dfacd5c0",
                                                "sense_id": "d10424d3-24b5-3dcb-b23e-5151b84373a7",
                                                "text": "If you're finished posturing in front of the mirror, can I use the bathroom now?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2bc29fe-3098-35ff-ab1a-db20a9607814",
                                        "entry_id": "dc8e7621-c9e6-3537-a656-67910600517e",
                                        "glosses": [
                                            "to pretend to have an opinion or a conviction"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6bbe61a-ab88-47f4-90f6-5d0aecb04303",
                                                "sense_id": "f2bc29fe-3098-35ff-ab1a-db20a9607814",
                                                "text": "The politicians couldn't really care less about the issue: they're just posturing for the media."
                                            },
                                            {
                                                "example_id": "bece60c4-a0a6-4920-9b2f-50a0e0225ac4",
                                                "sense_id": "f2bc29fe-3098-35ff-ab1a-db20a9607814",
                                                "text": "But these plays allow us to look beyond the posturing, punditry and angry speechifying, to really feel the painful, inescapable hardships of daily life as it is lived by increasing numbers of Americans."
                                            },
                                            {
                                                "example_id": "c29c3a57-fee4-43d4-ab0e-c45dd0441f84",
                                                "sense_id": "f2bc29fe-3098-35ff-ab1a-db20a9607814",
                                                "text": "Belarusian officials continue to posture military strength amid the ongoing Ukrainian incursion into Kursk Oblast, Russia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84a95f36-3109-3786-947f-85296e45b6c1",
                                        "entry_id": "dc8e7621-c9e6-3537-a656-67910600517e",
                                        "glosses": [
                                            "To place in a particular position or attitude; to pose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92b47f9f-c343-4cab-9d4d-53f3bd9efd83",
                                                "sense_id": "84a95f36-3109-3786-947f-85296e45b6c1",
                                                "text": "to posture oneself; to posture a model"
                                            },
                                            {
                                                "example_id": "e0ff4fb6-56fc-4a7d-8712-24c6040ac718",
                                                "sense_id": "84a95f36-3109-3786-947f-85296e45b6c1",
                                                "text": "As pointed Diamonds being set, Cast greater lustre out of Jet, Those peeces we esteem most rare, Which in night shadows postur'd are."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d37aa51-3960-4939-a40b-b58efdf7d591",
                        "source_entry_id": "95fafeee-83a1-3ee0-b8a7-611b34824b36",
                        "source_sense_id": "85017a13-df94-3f7e-a4eb-b37daee4eb88",
                        "source_sense_description": "Art und Weise, wie man seinen Körper (aufrecht) hält",
                        "target_lang_word": "posture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "posture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89d414ef-a32c-3c41-a4a5-72776a57fc7f",
                                        "entry_id": "11c90363-0c3f-3a77-be5a-0fec4e7d6cc7",
                                        "glosses": [
                                            "Attitude, situation où se tient le corps ; manière dont on tient son corps, sa tête, ses bras, ses jambes, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07d7e992-69ed-470e-812d-5893ad6b373b",
                                                "sense_id": "89d414ef-a32c-3c41-a4a5-72776a57fc7f",
                                                "text": "Il se mit en posture d’invectiver un adversaire, les poings sur les hanches, la tête renversée."
                                            },
                                            {
                                                "example_id": "5de20ea4-bb94-4094-a0a3-a2ece9e108d3",
                                                "sense_id": "89d414ef-a32c-3c41-a4a5-72776a57fc7f",
                                                "text": "Deux minutes après, un foulard de coton au cou et son béret « Le Vengeur » planté sur la tignasse épaisse, il attendait dans une posture recueillie et digne les ultimes recommandations paternelles."
                                            },
                                            {
                                                "example_id": "2efa2a82-4b58-4189-9c19-febcd47c9029",
                                                "sense_id": "89d414ef-a32c-3c41-a4a5-72776a57fc7f",
                                                "text": "Elle était couchée auprès de moi. Elle se retourna sans aucun dessein de me proposer une posture ; […]."
                                            },
                                            {
                                                "example_id": "8eb768bc-8e10-4a65-b1fb-bba5176c36c1",
                                                "sense_id": "89d414ef-a32c-3c41-a4a5-72776a57fc7f",
                                                "text": "La posture neko ashi dachi (neko = le chat, ashi= le pied) est surtout pratiquée par les adeptes du Karaté Do.\nCette posture est ainsi nommée car elle rappelle, dans son principe, le geste qu'un chat fait lorsqu'il touche une proie qu'il vient de tuer : […]."
                                            },
                                            {
                                                "example_id": "a00fd76c-5ac5-4a2c-a89f-37fe7ad65d32",
                                                "sense_id": "89d414ef-a32c-3c41-a4a5-72776a57fc7f",
                                                "text": "Sans s’interrompre, Rochefort se leva, s’adossa au mur, croisa les bras, une posture qu’il affectionnait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7bcdf29-4869-3637-a0ac-7e8b054ea469",
                                        "entry_id": "11c90363-0c3f-3a77-be5a-0fec4e7d6cc7",
                                        "glosses": [
                                            "État où est quelqu’un par rapport à sa situation morale ou sociale, à son crédit qui peut notamment être bon ou mauvais"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db31334a-6a85-49a2-90e6-2703c1f212e8",
                                                "sense_id": "a7bcdf29-4869-3637-a0ac-7e8b054ea469",
                                                "text": "Il n'empêche, la situation est limpide, je suis en mauvaise posture pour une bonne cause. C'est une mauvaise posture franchement honorable pour un chef de mission diplomatique, puisque je suis critiqué pour avoir expliqué la ligne de mon institution sur le dossier des droits de l'homme."
                                            },
                                            {
                                                "example_id": "eaff5e15-eb61-4287-b12f-a755d40f869e",
                                                "sense_id": "a7bcdf29-4869-3637-a0ac-7e8b054ea469",
                                                "text": "Je pense que si Strauss-Kahn avait adopté une espèce d'attitude rocardienne, c'est-à-dire bien ancrée à gauche mais moderne, il se serait trouvé très haut dans les sondages, et en bonne posture pour être finalement désigné par le PS."
                                            },
                                            {
                                                "example_id": "b4493283-e44b-4569-95e8-1996acb93444",
                                                "sense_id": "a7bcdf29-4869-3637-a0ac-7e8b054ea469",
                                                "text": "— Une fois son armée en bonne posture, il s'occupe de savoir ce que fait l'ennemi pour lui dicter la loi et lui imposer la bataille sans perdre un jour, ni une heure."
                                            },
                                            {
                                                "example_id": "ebb8cd01-2072-49ff-b2e6-cc1ae8d993ce",
                                                "sense_id": "a7bcdf29-4869-3637-a0ac-7e8b054ea469",
                                                "text": "Selon les chiffres actuels, si les Verts ne rejoignent pas la coalition PPE-S&D-Renew qui voterait en sa faveur et que les 15 % de pertes devenaient réalité, Ursula von der Leyen se trouverait en mauvaise posture et n’obtiendrait pas les 361 voix de la majorité. Si les Verts rejoignent la coalition toutefois, sa reconduction semble plus certaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "321c50af-cdc8-32fb-80ff-1cb61d3b9603",
                                        "entry_id": "11c90363-0c3f-3a77-be5a-0fec4e7d6cc7",
                                        "glosses": [
                                            "Comportement ; conduite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90983f6f-a53c-4155-83ad-8d2787721828",
                                                "sense_id": "321c50af-cdc8-32fb-80ff-1cb61d3b9603",
                                                "text": "Vivier. Vieux sénateur. Vieux cochon. Bon républicain. S'est fait pincer vingt fois dans un édicule municipal en posture d'exhibitionniste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3405aa11-53c7-39cc-ac6e-6bce596ab3fe",
                                        "entry_id": "11c90363-0c3f-3a77-be5a-0fec4e7d6cc7",
                                        "glosses": [
                                            "Jeu de rôle qu'implique la vie publique et politique."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75636647-13a0-4f6f-8c1d-69fda6c623d1",
                                                "sense_id": "3405aa11-53c7-39cc-ac6e-6bce596ab3fe",
                                                "text": "Et cette identité peut fort bien se décliner de la façon la plus typée qui soit : non seulement ces jeunes refusent d’abandonner leur identité Beatles au seuil de l'établissement qu'ils fréquentent, mais ils se réclament d'une posture rebelle qui ne prédispose ni à la discrétion ni à l’invisibilité."
                                            },
                                            {
                                                "example_id": "7f9eed07-d99d-4f6d-9900-f9e41be9d694",
                                                "sense_id": "3405aa11-53c7-39cc-ac6e-6bce596ab3fe",
                                                "text": "Tout dépend de l’attitude à la fois culturelle, ecclésiale et personnelle de ceux qui adoptent une telle posture intellectuelle (nous avons personnellement cessé depuis longtemps de croire que la posture intellectuelle suffisait à rendre compte de l’attitude réelle d'un intellectuel !)."
                                            },
                                            {
                                                "example_id": "e3622b50-5b74-4dde-8699-a7ab5bced265",
                                                "sense_id": "3405aa11-53c7-39cc-ac6e-6bce596ab3fe",
                                                "text": "Ainsi la télévision publique est-elle un thème de débat, une posture obligée, une rhétorique de salon qui mériterait de figurer dans les mythologies des couches cultivées."
                                            },
                                            {
                                                "example_id": "fc6ea0f1-a534-4285-8b70-0064023b3b5b",
                                                "sense_id": "3405aa11-53c7-39cc-ac6e-6bce596ab3fe",
                                                "text": "Faut-il une refonte de l'assurance-chômage ? « Il ne doit pas y avoir de tabou ni de posture », répond Emmanuel Macron au Journal du dimanche (JDD). On comprend pourquoi le ministre de l'économie utilise le mot « tabou » : tout ce qui touche aux acquis suscite des levées de boucliers, ce qui empêche de réfléchir puis d'avancer sereinement. En revanche, le propos sur la posture est plus intrigant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14b819a0-e05f-3391-88b7-e90f30bffd86",
                                        "entry_id": "11c90363-0c3f-3a77-be5a-0fec4e7d6cc7",
                                        "glosses": [
                                            "Statue."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1aba89a-a976-4bb0-81c9-572da01f0d17",
                                                "sense_id": "14b819a0-e05f-3391-88b7-e90f30bffd86",
                                                "text": "Elle a orné sa cheminée avec une belle posture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f20a773-6d22-4a5e-8070-82caa10b6bed",
                        "source_entry_id": "95fafeee-83a1-3ee0-b8a7-611b34824b36",
                        "source_sense_id": "85017a13-df94-3f7e-a4eb-b37daee4eb88",
                        "source_sense_description": "Art und Weise, wie man seinen Körper (aufrecht) hält",
                        "target_lang_word": "осанка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "осанка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cbf04e85-16bd-3b45-bf0f-f09d625532c7",
                                        "entry_id": "9a027683-1c2b-3b4b-8293-3419ffc45b51",
                                        "glosses": [
                                            "привычное вертикальное положение тела человека, манера держать фигуру в вертикальном положении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c442e2e-6e64-475a-b5f0-fd55c33f8656",
                                                "sense_id": "cbf04e85-16bd-3b45-bf0f-f09d625532c7",
                                                "text": "Ф. Малявин изобразил Марию Самойловну сидящей — ровная гордая осанка, плечи открыты, локоть левой руки покоится на спинке стула, с колен спадает воздушная ткань платья, на скрещённых ногах летние, с ремешками, туфельки."
                                            },
                                            {
                                                "example_id": "005eba7f-a41c-44d1-a723-55bfa3f0c3d0",
                                                "sense_id": "cbf04e85-16bd-3b45-bf0f-f09d625532c7",
                                                "text": "Рядом с ним выступал его приказчик, малый молодой и подслеповатый, безо всякой представительности в осанке."
                                            },
                                            {
                                                "example_id": "ae395766-f0fc-4c37-b5a0-e35a5edc4114",
                                                "sense_id": "cbf04e85-16bd-3b45-bf0f-f09d625532c7",
                                                "text": "Если все перечисленные симптомы заметить с самого начала, есть надежда, что они будут успешно устранены и у малыша в конце концов окажутся хорошие зубы, которые вовремя вырастут, не будет кариеса, сформируется правильная осанка, достаточная мышечная масса."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
