        "fr-extract.jsonl": [
            {
                "entry_id": "ab5bd6a0-374e-34ac-a728-5afb216e77e2",
                "word": "matrimonial",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c9b3b1ff-2dca-4a9f-9445-cc164d2dd5fd",
                        "entry_id": "ab5bd6a0-374e-34ac-a728-5afb216e77e2",
                        "tags": [
