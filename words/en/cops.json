{
    "word_family": [
        "cop",
        "copper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cfc19232-ee75-303a-8f15-1b4f2b6057e0",
                    "sense_definition": "The police, considered as a group entity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "police_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you see anything suspicious, you should call the <cops> immediately.",
                            "target_lang_translations": {
                                "ru": "Если увидите что-то подозрительное, немедленно звоните <w>копам</w>.",
                                "zh": "如果你看到任何可疑情况，应该立即<w>报警</w>。"
                            }
                        },
                        {
                            "text": "The robbers tried to run, but the <cops> arrived too quickly.",
                            "target_lang_translations": {
                                "ru": "Грабители пытались бежать, но <w>копы</w> приехали слишком быстро.",
                                "zh": "劫匪试图逃跑，但<w>警察</w>来得太快了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "police",
                        "law enforcement",
                        "fuzz"
                    ],
                    "common_phrases": [
                        "call the cops",
                        "run from the cops"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common informal term for police"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полиция, рассматриваемая как группа или организация (разговорное).",
                        "zh": "指代警察这一群体，通常为口语用法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копы",
                                "target_lang_sense_clarification": "разговорное, часто используется в переводах фильмов"
                            },
                            {
                                "target_lang_word": "полиция",
                                "target_lang_sense_clarification": "нейтральное, общее значение"
                            },
                            {
                                "target_lang_word": "легавые",
                                "target_lang_sense_clarification": "грубое, жаргонное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "警察",
                                "target_lang_sense_clarification": "中性，指代警察整体"
                            },
                            {
                                "target_lang_word": "阿Sir",
                                "target_lang_sense_clarification": "粤语地区常用的口语称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1fb98e9-d267-3fe0-a6df-441d7248fc68",
                    "sense_definition": "Plural of <w>cop</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "police_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two <cops> were standing on the corner directing traffic.",
                            "target_lang_translations": {
                                "ru": "Двое <w>полицейских</w> стояли на углу и регулировали движение.",
                                "zh": "两名<w>警员</w>站在街角指挥交通。"
                            }
                        },
                        {
                            "text": "Many <cops> patrol this neighborhood at night to keep it safe.",
                            "target_lang_translations": {
                                "ru": "Многие <w>копы</w> патрулируют этот район по ночам, чтобы поддерживать безопасность.",
                                "zh": "许多<w>警察</w>晚上会在这个社区巡逻以确保安全。"
                            }
                        }
                    ],
                    "synonyms": [
                        "police officers",
                        "officers"
                    ],
                    "antonyms": [
                        "civilians",
                        "criminals"
                    ],
                    "common_phrases": [
                        "good cops",
                        "bad cops"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "refers to individual police officers"
                        },
                        {
                            "trait_type": "form",
                            "comment": "plural noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова 'cop' (полицейский).",
                        "zh": "cop的复数形式，指代多名警察。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полицейские",
                                "target_lang_sense_clarification": "нейтральное, сотрудники полиции"
                            },
                            {
                                "target_lang_word": "копы",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "警察",
                                "target_lang_sense_clarification": "指代多名警务人员"
                            },
                            {
                                "target_lang_word": "警员",
                                "target_lang_sense_clarification": "指代具体的警务人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a4b9683-86a9-3705-8e21-705594d120db",
                    "sense_definition": "The connecting crook of a harrow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer needed to repair the iron <cops> on his old harrow.",
                            "target_lang_translations": {
                                "ru": "Фермеру нужно было починить железную <w>скобу</w> на своей старой бороне.",
                                "zh": "农夫需要修理他那旧耙上的铁制<w>连接钩</w>。"
                            }
                        },
                        {
                            "text": "Ensure the <cops> is securely fastened before starting the field work.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>сцепка</w> надежно закреплена перед началом полевых работ.",
                                "zh": "在开始田间作业前，请确保<w>连接件</w>已牢固扣好。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "agricultural or dialectal term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединительная скоба или крюк бороны (сельскохозяйственный термин).",
                        "zh": "耙的连接钩或连接件（农业术语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скоба",
                                "target_lang_sense_clarification": "деталь крепления"
                            },
                            {
                                "target_lang_word": "сцепка",
                                "target_lang_sense_clarification": "соединительный элемент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "连接钩",
                                "target_lang_sense_clarification": "用于农具连接的金属部件"
                            },
                            {
                                "target_lang_word": "连接件",
                                "target_lang_sense_clarification": "通用的连接装置"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d5212534-7571-374d-97a7-57bc6736dc97",
                    "sense_definition": "Third-person singular simple present indicative of <w>cop</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He always <cops> an attitude when he is asked to do extra work.",
                            "target_lang_translations": {
                                "ru": "Он вечно <w>начинает выпендриваться</w>, когда его просят сделать дополнительную работу.",
                                "zh": "当被要求做额外工作时，他总是<w>摆出</w>一副傲慢的态度。"
                            }
                        },
                        {
                            "text": "The suspect <cops> a plea to avoid a harsher sentence in court.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый <w>идет на сделку</w> со следствием, чтобы избежать более сурового приговора в суде.",
                                "zh": "嫌疑人为了避免在法庭上受到更严厉的判决而<w>认罪</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cops a plea",
                        "cops an attitude",
                        "cops a feel"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in phrases like 'cop a plea' or 'cop an attitude'"
                        },
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма глагола 'to cop' в 3-м лице единственного числа (получать, схватывать, принимать).",
                        "zh": "动词cop的第三人称单数形式，常用于特定短语中表示“采取”或“接受”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идет на сделку",
                                "target_lang_sense_clarification": "в выражении 'cops a plea'"
                            },
                            {
                                "target_lang_word": "строит из себя",
                                "target_lang_sense_clarification": "в выражении 'cops an attitude'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "认罪",
                                "target_lang_sense_clarification": "在cop a plea短语中"
                            },
                            {
                                "target_lang_word": "摆出",
                                "target_lang_sense_clarification": "在cop an attitude短语中"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}