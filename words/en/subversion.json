                    "frequency": "Middle",
                    "semantic_group_id": "political_overthrow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government accused foreign agents of funding political <w>subversion</w> to destabilize the region."
                        },
                        {
                            "text": "Several activists were arrested and charged with acts of <w>subversion</w> against the state."
                        }
                    ],
                    "synonyms": [
