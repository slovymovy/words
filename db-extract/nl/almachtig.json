                                "example_id": "06381423-a84a-4465-bbb2-b342c82fb825",
                                "sense_id": "880b709b-07e5-35b1-acb3-7a61229c43a4",
                                "text": "Hij was almachtig in zijn kleine wereld."
                            },
                            {
                                "example_id": "02e816b0-9e48-4175-8cf1-b2a90614d99e",
                                "sense_id": "880b709b-07e5-35b1-acb3-7a61229c43a4",
                                "text": "Ik dacht dat je almachtig was."
                            }
                        ]
