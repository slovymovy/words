                    "frequency": "Low",
                    "semantic_group_id": "craft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the entire weekend working on a beautiful <w>macrame</w> wall hanging for her living room.",
                            "target_lang_translations": {
                                "zh": "她整个周末都在为客厅制作一件精美的<w>绳结编织</w>壁挂。"
                            }
                        },
                        {
                            "text": "The local craft store offers a beginner class to learn the basics of <w>macrame</w> art.",
                            "target_lang_translations": {
                                "zh": "当地的手工艺品店提供初学者课程，教授<w>绳结编织</w>艺术的基础知识。"
