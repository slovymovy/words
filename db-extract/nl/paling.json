                "translations": [
                    {
                        "translation_id": "64601859-687b-4b38-a900-a69f0931f0f7",
                        "source_entry_id": "10cac486-bca8-3a87-a842-b0fd5f534be4",
                        "source_sense_id": "9a93f199-2678-374e-98f7-60653ff58c44",
                        "source_sense_description": "bepaald soort langwerpige consumptievis, Anguilla anguilla",
                        "target_lang_word": "Aal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d2b3b73-ffa5-3fc8-a776-ec9ccea9c532",
                                        "entry_id": "5e5a56f3-f1b7-3e28-b03c-1f42e8e4eebb",
                                        "glosses": [
                                            "schlangenförmiger Süßwasser- und Meerwasserfisch aus der Ordnung der Aalartigen (Anguilliformes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f25dc566-046c-4b35-8c43-e83d3c7f7287",
                                                "sense_id": "3d2b3b73-ffa5-3fc8-a776-ec9ccea9c532",
                                                "text": "Er hatte einen sehr großen Aal gefangen."
                                            },
                                            {
                                                "example_id": "fbda3d63-407e-482d-88f8-1442ebfaba4e",
                                                "sense_id": "3d2b3b73-ffa5-3fc8-a776-ec9ccea9c532",
                                                "text": "Auf der Silberplatte lagen geräucherter Aal und Graved Lachs."
                                            },
                                            {
                                                "example_id": "96a3abf4-d905-4aec-98d7-1aa235c83cce",
                                                "sense_id": "3d2b3b73-ffa5-3fc8-a776-ec9ccea9c532",
                                                "text": "„Er begann den Aal zu putzen und schnitt ihn in Stücke.“"
                                            },
                                            {
                                                "example_id": "c727110f-6d42-4e10-bf33-38bc303fd979",
                                                "sense_id": "3d2b3b73-ffa5-3fc8-a776-ec9ccea9c532",
                                                "text": "„Der Aal bewegt sich wie eine Schlange, sein Hinterteil ist immer ganz woanders als sein Vorderteil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6f229e5-124d-35c4-ba36-69152d0d0e06",
                                        "entry_id": "5e5a56f3-f1b7-3e28-b03c-1f42e8e4eebb",
                                        "glosses": [
                                            "Fisch oder Wassertier von länglicher Gestalt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86bf41d3-9e18-474d-bd6d-99178e9a34ec",
                                                "sense_id": "e6f229e5-124d-35c4-ba36-69152d0d0e06",
                                                "text": "Meinst du, Freund der Tiere, man könnte Aal dazu sagen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "54b6ddd6-77a5-31cf-85eb-f985902f49e9",
                                        "entry_id": "5e5a56f3-f1b7-3e28-b03c-1f42e8e4eebb",
                                        "glosses": [
                                            "Torpedo"
                                        ],
                                        "tags": [
                                            "von U-Boot-Fahrern verwendete Bezeichnung für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05c09162-24f7-46cc-9e5a-162efaa241f5",
                                                "sense_id": "54b6ddd6-77a5-31cf-85eb-f985902f49e9",
                                                "text": "„Als mir der Torpedo endlich klar gemeldet wurde, gingen wir auf Gefechtskurs und nach Erreichen der Schussposition gab ich den Befehl ‚Torpedo los!‘ Der Aal verließ vorbildlich das Rohr, wurde dabei illegal vom I. Wachoffizier fotografiert und tauchte elegant ins Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "666db878-c9f7-348a-80f1-00a8dca50f38",
                                        "entry_id": "5e5a56f3-f1b7-3e28-b03c-1f42e8e4eebb",
                                        "glosses": [
                                            "neu eingezogener, unvereidigter Soldat, Soldat ohne Dienstgrad"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88534558-9080-4a6a-a05c-2e7116031766",
                                                "sense_id": "666db878-c9f7-348a-80f1-00a8dca50f38",
                                                "text": "Da zeigten es aber die Altgedienten den Aalen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f187d84b-887f-3620-9c71-fa85ec8941f6",
                                        "entry_id": "5e5a56f3-f1b7-3e28-b03c-1f42e8e4eebb",
                                        "glosses": [
                                            "junge Kalmuspflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7598c5a8-160d-4cf6-bcc0-2e0bcc68f3bb",
                                                "sense_id": "f187d84b-887f-3620-9c71-fa85ec8941f6",
                                                "text": "Zu jungen Kalmuspflanzen sagte Ehrenfried immer Aal und Herta ärgerte das."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Aal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb336fcc-172d-3b05-86f0-737cec1502fd",
                                        "entry_id": "e6228d73-c818-3807-a5ed-f8fef557ba35",
                                        "glosses": [
                                            "unterdurchschnittlich häufig auftretender, deutscher und niederländischer Nachname, Familienname häufigstes Vorkommen in Deutschland im Kreis Kleve in Nordrhein-Westfalen); auch mit Namenzusatz de"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d161ea7-8773-4c3f-b32a-95a9f5dc8188",
                                                "sense_id": "cb336fcc-172d-3b05-86f0-737cec1502fd",
                                                "text": "Herr Aal heiratete Frau Müller im Mai. Nun heißt er Aal und sie Müller-Aal."
                                            },
                                            {
                                                "example_id": "904c2c74-3120-4cb0-b6fc-ebdd3c355b96",
                                                "sense_id": "cb336fcc-172d-3b05-86f0-737cec1502fd",
                                                "text": "Heute sind wir bei Aals zu Besuch."
                                            },
                                            {
                                                "example_id": "52756425-d711-45ae-a737-e6a9da3d4f25",
                                                "sense_id": "cb336fcc-172d-3b05-86f0-737cec1502fd",
                                                "text": "„Aal?! Vortreten!“"
                                            },
                                            {
                                                "example_id": "f8f3bbf2-71ae-4170-a88b-8452a41173c8",
                                                "sense_id": "cb336fcc-172d-3b05-86f0-737cec1502fd",
                                                "text": "Der Aal ist's gewesen und die Aal hat's verpetzt."
                                            },
                                            {
                                                "example_id": "afd49612-d1c7-4cf9-956e-b754c936b4c9",
                                                "sense_id": "cb336fcc-172d-3b05-86f0-737cec1502fd",
                                                "text": "Frau Aal ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "3283b932-ea50-4c47-86be-d2569025b1fb",
                                                "sense_id": "cb336fcc-172d-3b05-86f0-737cec1502fd",
                                                "text": "Herr Aal wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "fb876f77-6fd2-40c9-9808-d8ec1b563ee4",
                                                "sense_id": "cb336fcc-172d-3b05-86f0-737cec1502fd",
                                                "text": "Die Aals kommen heute von Wangerooge."
                                            },
                                            {
                                                "example_id": "4a5dce9d-a53f-4864-8262-d69eb8444cf3",
                                                "sense_id": "cb336fcc-172d-3b05-86f0-737cec1502fd",
                                                "text": "Der Aal trägt nie die Schals, die die Aal ihm strickt."
                                            },
                                            {
                                                "example_id": "ed579a89-aa57-4180-af0f-71a30bc671ea",
                                                "sense_id": "cb336fcc-172d-3b05-86f0-737cec1502fd",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Aal kommt, geht der Herr Aal.“"
                                            },
                                            {
                                                "example_id": "b85c8c23-2ad1-491d-9162-e8bf6bee8836",
                                                "sense_id": "cb336fcc-172d-3b05-86f0-737cec1502fd",
                                                "text": "Aal kommt und geht."
                                            },
                                            {
                                                "example_id": "3ff35806-b162-4c0c-8716-e5398b0cb4c7",
                                                "sense_id": "cb336fcc-172d-3b05-86f0-737cec1502fd",
                                                "text": "Aals kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b25babe0-0777-4354-804d-615afe347e74",
