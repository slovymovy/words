                "senses": [
                    {
                        "sense_id": "40f51784-53d4-32ce-9b8a-be60ec9aae45",
                        "entry_id": "f1da9959-ed00-3dcc-8c21-367da5dad863",
                        "glosses": [
                            "устройство, определяющее местоположение объекта (по электромагнитному излучению, отражению звука и др.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c5063de-9dc0-4fff-a9e4-cb840125c3c8",
                                "sense_id": "40f51784-53d4-32ce-9b8a-be60ec9aae45",
                                "text": "Локатор на станции, управляющей полетом ракеты, изображает самолет в виде светящейся яркой точки."
                            },
                            {
                                "example_id": "5077e3b8-6a88-43d1-86d7-d613bad6ecd7",
                                "sense_id": "40f51784-53d4-32ce-9b8a-be60ec9aae45",
                                "text": "Зрительный зал — этот коллективный локатор, воспринимающий биотоки, несущиеся со сцены, — будет работать в чуть-чуть ином режиме, и тонкий нервный аппарат актера тут же перестроится на заданный залом манер."
                            }
                        ]
                    }
