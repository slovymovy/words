                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dfeb26d-ad3a-3ac7-88bc-60041226763f",
                        "entry_id": "fb45d84d-bdcc-3863-a690-3c695be4fb7e",
                        "glosses": [
                            "анат. отросток нервной клетки, проводящий импульс от этой клетки к иннервируемым органам и другим нервным клеткам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55ee23cc-1646-4c75-9269-5e206cf9ac87",
                                "sense_id": "1dfeb26d-ad3a-3ac7-88bc-60041226763f",
                                "text": "Однако исследования показали, что акcоны нейронов колонны проходят не в дорсолатеральном, а в вентролатеральном канатике."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f1ec0f2-1841-472a-b8be-52889adf4f06",
                        "source_entry_id": "fb45d84d-bdcc-3863-a690-3c695be4fb7e",
                        "source_sense_id": "1dfeb26d-ad3a-3ac7-88bc-60041226763f",
                        "target_lang_word": "axon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "axon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4e22a2f-63c4-337a-a2ba-dc6325ed3bf4",
                                        "entry_id": "0a955669-4a06-3e04-b588-74c429332469",
                                        "glosses": [
                                            "A nerve fibre which is a long slender projection of a nerve cell, and which conducts nerve impulses away from the body of the cell to a synapse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "743e0889-3500-434d-86dd-1ac0866b482b",
                        "source_entry_id": "fb45d84d-bdcc-3863-a690-3c695be4fb7e",
                        "source_sense_id": "1dfeb26d-ad3a-3ac7-88bc-60041226763f",
                        "target_lang_word": "Axon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Axon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5521aee3-014f-3878-8b81-c855dbbf3438",
                                        "entry_id": "96d6c52c-d963-3871-acc8-9e9b76f9c52f",
                                        "glosses": [
                                            "kaum verzweigter und meist mit einer speziellen Isolierschicht umgebener Fortsatz einer Nervenzelle, der elektrische Nervenimpulse von der Zelle nach außen leitet"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c278e98-30fc-4cad-960c-69cbfa9ca4b3",
                                                "sense_id": "5521aee3-014f-3878-8b81-c855dbbf3438",
                                                "text": "„Ein Neuron ist mehr als nur ein Schalter; es ist zugleich Batterie und Generator, außerdem sorgt es für die Instandhaltung seiner drei Teile; Zellkörper, Dendriten und Axon.“"
                                            },
                                            {
                                                "example_id": "2ef0555a-154d-46de-a5fa-67869762dc25",
                                                "sense_id": "5521aee3-014f-3878-8b81-c855dbbf3438",
                                                "text": "„Der Reiz läuft als elektrischer Impuls vom Körper einer Nervenzelle über einen faserigen Fortsatz, das Axon, zu den Endknöpfchen, die daraufhin chemische Botenstoffe ausschütten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f613289-ff05-4b40-84a8-bd70687427d9",
                        "source_entry_id": "fb45d84d-bdcc-3863-a690-3c695be4fb7e",
                        "source_sense_id": "1dfeb26d-ad3a-3ac7-88bc-60041226763f",
                        "target_lang_word": "axone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "axone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5813f53-f91a-340c-872e-755bfca5f853",
                                        "entry_id": "2ee48c3d-0ea7-3262-b9ee-fd0482189afc",
                                        "glosses": [
                                            "Partie allongée d’un neurone qui permet le passage de l’information sous forme d’impulsions électriques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1551ecdf-b9a9-48cb-a0b9-85068f49ce68",
                                                "sense_id": "d5813f53-f91a-340c-872e-755bfca5f853",
                                                "text": "La gaine isolante que constitue la stratification myélinique est interrompue à intervalles réguliers par des étranglements (nœuds de Ranvier) au niveau desquels l’axone est dénudé."
                                            },
                                            {
                                                "example_id": "7fc20d6d-e312-4a10-8ea5-c95fdb99e052",
                                                "sense_id": "d5813f53-f91a-340c-872e-755bfca5f853",
                                                "text": "Ainsi le neurone présente une polarisation fonctionnelle : la circulation des informations y est unidirectionnelle, cellulipète dans les dendrites et cellulifuge dans l’axone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
