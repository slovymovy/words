                                        "sense_id": "aedfbfdd-7a42-3c2a-902c-92bf9573c54a",
                                        "entry_id": "cb143be6-5b2d-37d7-8962-6bda2c1b9237",
                                        "glosses": [
                                            "fastidio arrecato malevolmente per danneggiare o per disturbare la pace e la tranquillità di una o più persone."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
