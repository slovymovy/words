    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88f94aff-1de1-3b72-aa76-a176daad62f2",
                    "sense_definition": "Sprawić, że ktoś lub coś porusza się wolniej albo że jakiś proces przebiega w mniejszym tempie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "change_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gęsta mgła i śliski asfalt znacznie <w>spowolniły</w> ruch na autostradzie.",
                            "target_lang_translations": {
                                "ru": "Густой туман и скользкий асфальт значительно <w>замедлили</w> движение на трассе."
                            }
                        },
                        {
                            "text": "Nowe, skomplikowane przepisy mogą znacznie <w>spowolnić</w> proces budowy domu.",
                            "target_lang_translations": {
                                "ru": "Новые сложные правила могут значительно <w>замедлить</w> процесс строительства дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwolnić",
                        "opóźnić",
                        "przyhamować",
                        "wyhamować"
                    ],
                    "antonyms": [
                        "przyspieszyć"
                    ],
                    "common_phrases": [
                        "spowolnić tempo",
                        "spowolnić proces",
                        "spowolnić rozwój",
                        "spowolnić akcję serca"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать так, чтобы кто-то или что-то двигалось медленнее, или снизить темп какого-либо процесса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замедлить",
                                "target_lang_sense_clarification": "снизить скорость или темп"
                            },
                            {
                                "target_lang_word": "сбавить",
                                "target_lang_sense_clarification": "уменьшить (обычно о скорости или темпе)"
                            },
                            {
                                "target_lang_word": "притормозить",
                                "target_lang_sense_clarification": "задержать развитие или движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e175c0e6-3b62-3347-874a-3ea81328b0a3",
                    "sense_definition": "Zacząć dziać się wolniej lub stracić dotychczasową prędkość (często w odniesieniu do gospodarki, funkcji życiowych lub zjawisk).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "change_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wzrost gospodarczy w tym roku wyraźnie <w>spowolnił</w> w porównaniu do lat ubiegłych.",
                            "target_lang_translations": {
                                "ru": "Экономический рост в этом году заметно <w>замедлился</w> по сравнению с прошлыми годами."
                            }
                        },
                        {
                            "text": "Pod koniec roku sprzedaż nowych mieszkań wyraźnie <w>spowolniła</w>.",
                            "target_lang_translations": {
                                "ru": "К концу года продажи новых квартир заметно <w>замедлились</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwolnić",
                        "osłabnąć"
                    ],
                    "antonyms": [
                        "przyspieszyć"
                    ],
                    "common_phrases": [
                        "gospodarka spowolniła",
                        "metabolizm spowolnił"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начать происходить медленнее или потерять прежнюю скорость (часто в отношении экономики, жизненных функций или явлений)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замедлиться",
                                "target_lang_sense_clarification": "стать более медленным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}