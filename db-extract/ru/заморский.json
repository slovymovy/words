                "senses": [
                    {
                        "sense_id": "fac7dc71-8018-3e57-a00b-5f6b5f8c36cd",
                        "entry_id": "20b4ea55-833d-3eb2-9051-d4bb34f65b53",
                        "glosses": [
                            "устар., нар.-поэт. находящийся за морем; иностранный, чужеземный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf48ca5-50d6-4a63-b1b2-36f16f8e1c0d",
                                "sense_id": "fac7dc71-8018-3e57-a00b-5f6b5f8c36cd",
                                "text": "Появился даже некий заморский принц с целой свитой…"
                            }
                        ]
                    },
                    {
                        "sense_id": "7a4b5807-df02-3458-a7e2-0e989c58cbd1",
                        "entry_id": "20b4ea55-833d-3eb2-9051-d4bb34f65b53",
                        "glosses": [
                            "устар., нар.-поэт. привезённый, прибывший и т. п. из-за моря"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb664e6-6799-4dfc-8324-3b37fc949f46",
                                "sense_id": "7a4b5807-df02-3458-a7e2-0e989c58cbd1",
                                "text": "Промысел кунгурский: кожевенный и сапожный, хлебный, разный заморский мелочной товар, но мало."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5cecb5e-f0e1-30eb-9d9d-a82b491e644f",
                        "entry_id": "20b4ea55-833d-3eb2-9051-d4bb34f65b53",
                        "glosses": [
                            "перен., устар., нар.-поэт. невиданный, необычный, удивительный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "518df942-a854-417d-9209-60f7ec4d0ace",
                                "sense_id": "e5cecb5e-f0e1-30eb-9d9d-a82b491e644f",
                                "text": "Бальмонт в русской поэзии ― заморский гость."
                            }
                        ]
                    }
                ],
