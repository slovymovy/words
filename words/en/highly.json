                                "target_lang_sense_clarification": "用于形容词前，表示程度深"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "972ec5d3-7ebc-3a4b-9e78-0d5b7281cd3f",
                    "sense_definition": "With approval or a favorable opinion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My former boss spoke <w>highly</w> of my work ethic during the reference check.",
                            "target_lang_translations": {
                                "ru": "Мой бывший начальник <w>высоко</w> отозвался о моей трудовой этике во время проверки рекомендаций.",
                                "pl": "Mój były szef <w>wysoko</w> wypowiadał się o mojej etyce pracy podczas weryfikacji referencji.",
                                "zh": "在背景调查时，我前任老板对我的职业道德给予了<w>高度</w>评价。"
                            }
                        },
                        {
                            "text": "The committee thinks <w>highly</w> of the proposed changes to the policy.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>высоко</w> ценит предложенные изменения в политике.",
                                "pl": "Komitet <w>wysoko</w> ceni proponowane zmiany w polityce.",
                                "zh": "委员会对政策的拟议变更评价<w>极高</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "favorably",
                        "approvingly",
                        "well",
                        "warmly"
                    ],
                    "antonyms": [
                        "poorly",
                        "negatively",
                        "disapprovingly"
                    ],
                    "common_phrases": [
                        "speak highly of",
                        "think highly of",
                        "regard highly",
                        "value highly"
                    ],
                    "target_lang_definitions": {
                        "ru": "С одобрением; положительно",
                        "pl": "Z uznaniem lub przychylną opinią.",
                        "zh": "带有赞许或肯定的评价"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высоко",
                                "target_lang_sense_clarification": "об оценке или мнении"
