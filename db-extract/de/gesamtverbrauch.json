                "senses": [
                    {
                        "sense_id": "1539ea3d-b21a-3a3e-b06c-d590901e702f",
                        "entry_id": "909dc3b6-4479-347e-8097-ebc6a480ce94",
                        "glosses": [
                            "komplette Menge von etwas, das verbraucht wird, meist in einer bestimmten Zeiteinheit (beispielsweise in einem Monat, Jahr) oder an einem bestimmten Ort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdcbb983-56ff-4c90-8555-c0c8db814ed2",
                                "sense_id": "1539ea3d-b21a-3a3e-b06c-d590901e702f",
                                "text": "„Der Gesamtverbrauch von Heizöl in Deutschland 2016 betrug 1279 Petajoule, der für Benzin und Diesel 2530 Petajoule.“"
                            },
                            {
                                "example_id": "898a4028-bb26-4601-8f3c-1910d8cd1ed2",
                                "sense_id": "1539ea3d-b21a-3a3e-b06c-d590901e702f",
                                "text": "„In Deutschland macht russisches Gas sogar gut die Hälfte des Gesamtverbrauchs aus.“"
                            },
                            {
                                "example_id": "f9a1485e-3411-4f53-8e3b-6bfeb988f010",
                                "sense_id": "1539ea3d-b21a-3a3e-b06c-d590901e702f",
                                "text": "„Lag der Anteil von Strom aus Erneuerbaren Energien im Jahr 2000 noch bei sieben Prozent des Gesamtverbrauchs, liegt er 2017 bei knapp einem Drittel.“"
                            },
                            {
                                "example_id": "b46fd317-7c03-4973-93bf-dd3c439237a5",
                                "sense_id": "1539ea3d-b21a-3a3e-b06c-d590901e702f",
                                "text": "„Die EU hatte vergangenes Jahr beschlossen, dass […] bis 2030 der Anteil erneuerbarer Energien am Gesamtverbrauch 32 Prozent betragen [soll].“"
                            },
                            {
                                "example_id": "1edf85d8-7dc7-4ff7-82b0-b4dc2603be82",
                                "sense_id": "1539ea3d-b21a-3a3e-b06c-d590901e702f",
                                "text": "[Schweiz:] „Soll die Energiewende bis 2050 umgesetzt werden, muss die Kapazität von vier AKW eingespart oder ersetzt werden. Heute entspräche dies einer riesigen «Lücke» von 40 % des Gesamtverbrauchs.“"
                            },
                            {
                                "example_id": "d2b69d5b-b52c-4a76-a41c-aab9a283a8d2",
                                "sense_id": "1539ea3d-b21a-3a3e-b06c-d590901e702f",
                                "text": "„Die Schweiz muss Strom sparen, wenn die Energiewende gelingen soll. Besonders wichtig sind die Unternehmen mit einem Anteil von rund 60 Prozent am Gesamtverbrauch.“"
                            },
                            {
                                "example_id": "ccf4bdbb-2752-4a78-a266-0789a121feaf",
                                "sense_id": "1539ea3d-b21a-3a3e-b06c-d590901e702f",
                                "text": "„Was war am 23. Sep. 1932? – Nach Angaben des Reichsernährungsministeriums in Berlin ist der Bierkonsum im Deutschen Reich in den letzten Jahren stark zurückgegangen. In den vergangenen zwölf Monaten betrug der Gesamtverbrauch rund 36 Millionen Hektoliter; 1913/14 wurden noch 69 Millionen Hektoliter Bier getrunken.“"
                            },
                            {
                                "example_id": "c3e7c823-c59d-478f-8a33-ca8edaff4c2d",
                                "sense_id": "1539ea3d-b21a-3a3e-b06c-d590901e702f",
                                "text": "„Der Gesamtverbrauch an alkoholischen Getränken stieg […] im Jahr 2018 um 0,3 Liter auf 131,3 Liter je Einwohner.“"
                            },
                            {
                                "example_id": "fec9e96f-9524-4ff5-b046-0606b97ede3d",
                                "sense_id": "1539ea3d-b21a-3a3e-b06c-d590901e702f",
                                "text": "„Etwa 5,5 Kilo Schmutzwäsche fallen beim Durchschnittsdeutschen pro Woche an, hat der Industrieverband Körperpflege- und Waschmittel e.V. (IKW) hochgerechnet. Das läppert sich auf einen bundesweiten Gesamtverbrauch von etwa 6 Milliarden Kilowattstunden. Nur, um schmutzige Wäsche zu waschen.“"
                            },
                            {
                                "example_id": "9401272d-c1f2-432b-9fdb-dcb34203679e",
                                "sense_id": "1539ea3d-b21a-3a3e-b06c-d590901e702f",
                                "text": "„Vorsicht vor überlasteten Mehrfachsteckdosen: Sie können überhitzen und einen Brand verursachen. Addieren Sie den Gesamtverbrauch der angesteckten Geräte und vergleichen Sie den Wert mit der Maximalleistung des Mehrfachsteckers.“"
                            },
                            {
                                "example_id": "716c8bc6-061d-4b4a-966e-2edd47ad0926",
                                "sense_id": "1539ea3d-b21a-3a3e-b06c-d590901e702f",
                                "text": "„Auf den Autobahnen und Schnellstraßen verwendet die ASFINAG großteils flüssige Salzsole […] Der Gesamtverbrauch pro Saison variiert je nach Winterverlauf stark: 56.000 Tonnen und 128.000 Tonnen waren die Extremwerte im letzten Jahrzehnt, der durchschnittliche Verbrauch lag bei 86.000 Tonnen Salz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
