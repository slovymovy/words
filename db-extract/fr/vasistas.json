                    {
                        "translation_id": "1fa93ea7-0d96-4e8a-a378-3466fa854b88",
                        "source_entry_id": "dd7cdb33-098a-36a7-9d86-734c22aedbae",
                        "source_sense_description": "Ouverture dans une fenêtre ou porte à hauteur d'yeux",
                        "target_lang_word": "фо́рточка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фо́рточка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a8ab35d1-6b16-3acf-9a7e-c6e4750a6f0e",
                                        "entry_id": "67e0cb16-7ea5-3eae-b8d0-3499f4627839",
                                        "glosses": [
                                            "стеклянная дверца в окне, а также проём в окне, закрываемый этой дверцей и служащий для проветривания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13660f80-17ca-4da6-b656-45e680249803",
                                                "sense_id": "a8ab35d1-6b16-3acf-9a7e-c6e4750a6f0e",
                                                "text": "Светлане всегда было жарко, она постоянно открывала форточки и устраивала сквозняки."
                                            },
                                            {
                                                "example_id": "0667b978-5ba7-4b0b-b62e-a45681973893",
                                                "sense_id": "a8ab35d1-6b16-3acf-9a7e-c6e4750a6f0e",
                                                "text": "В тот миг, когда Таня вошла, узкая форточка на зарешёченном окне музея захлопнулась."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2ef4b6c-06a8-3df3-b1dd-d3ff6183c08a",
                                        "entry_id": "67e0cb16-7ea5-3eae-b8d0-3499f4627839",
                                        "glosses": [
                                            "комп. жарг., пренебр., операционная система Microsoft Windows"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3cd988a-940e-4651-bdaf-f148105c66ac",
                                                "sense_id": "a2ef4b6c-06a8-3df3-b1dd-d3ff6183c08a",
                                                "text": "Ваши потрясенные коллеги увидят, что по дружественности интерфейса Linux не уступает \"кривым форточкам\"..."
                                            },
                                            {
                                                "example_id": "746a3cf5-244f-433c-bbdd-8779681ad086",
                                                "sense_id": "a2ef4b6c-06a8-3df3-b1dd-d3ff6183c08a",
                                                "text": "Оная утилита (Windows-Home) известна в глубине как \"Домашняя Форточка\" или \"Домик Билли\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b7941ea-678b-3ead-ba71-5bf6cff80957",
                                        "entry_id": "67e0cb16-7ea5-3eae-b8d0-3499f4627839",
                                        "glosses": [
                                            "шахм. свободная клетка для отступления короля, образованная продвижением на одно поле вперёд одной из пешек, защищающих короля."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd60ba6a-31ef-478b-9509-2a0808724821",
                                                "sense_id": "0b7941ea-678b-3ead-ba71-5bf6cff80957",
                                                "text": "Если король не имеет «форточки» (или же ею нельзя воспользоваться, так как поле это атаковано), отвлечение фигур, защищающих восьмую (первую) линию, может вызвать катастрофу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03dc7370-b4da-35cf-8e46-58999d7566b9",
                                        "entry_id": "67e0cb16-7ea5-3eae-b8d0-3499f4627839",
                                        "glosses": [
                                            "полигр. узкий заголовок из нескольких строк внутри текста по краям полосы"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
