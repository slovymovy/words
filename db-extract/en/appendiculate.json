                                        "examples": [
                                            {
                                                "example_id": "fbd6708f-e018-44c7-a1bd-731ee9f75b6e",
                                                "sense_id": "98b39155-7e1c-3c6c-85b9-04394cd6342a",
                                                "text": "Die unauffälligen Zystidien sind spindelförmig oder lose appendikuliert."
                                            },
                                            {
                                                "example_id": "6ac91475-83d8-4c94-a672-11d912878646",
                                                "sense_id": "98b39155-7e1c-3c6c-85b9-04394cd6342a",
                                                "text": "Die 45–70 μm langen und 8–13 μm breiten und wenig zahlreichen Cheilozystiden sind spindelförmig, an der Spitze abgerundet oder appendikuliert, das heißt mit einem kurzen Fortsatz versehen."
                                            },
                                            {
                                                "example_id": "a168b327-f858-4c94-b259-07d74ed7663d",
                                                "sense_id": "98b39155-7e1c-3c6c-85b9-04394cd6342a",
                                                "text": "„Pileocystiden … meist zylindrisch bis schmalkeulig. Endabschnittehäulig kopfig oder kurz appendikuliert oder eingeschnürt“"
                                            },
                                            {
                                                "example_id": "973f9d48-6395-4a47-8de7-3e1826cad190",
                                                "sense_id": "98b39155-7e1c-3c6c-85b9-04394cd6342a",
                                                "text": "„…, das elfte einundeinhalb mal so lang wie das zehnte, appendikuliert; …“"
                                            },
                                            {
                                                "example_id": "0f27abb8-d7b3-4334-8fd2-4d01e35ea438",
                                                "sense_id": "98b39155-7e1c-3c6c-85b9-04394cd6342a",
                                                "text": "„B. am Grunde des Randes appendikuliert.“"
                                            }
                                        ],
