                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f08be301-f9af-4153-bae3-7a0cb8cd19fa",
                                                "sense_id": "8f09eff8-53ed-348d-aba5-757902a3ff31",
                                                "text": "Mecklenburg-Vorpommern liegt im Nordosten Deutschlands."
                                            },
                                            {
                                                "example_id": "ce6ed526-3244-45c5-a590-d6cc7755ab9c",
                                                "sense_id": "8f09eff8-53ed-348d-aba5-757902a3ff31",
                                                "text": "Mecklenburg-Vorpommern liegt an der Ostseeküste."
                                            },
                                            {
                                                "example_id": "eac22b7e-d87b-49ab-9f00-24e61111d64f",
                                                "sense_id": "8f09eff8-53ed-348d-aba5-757902a3ff31",
                                                "text": "„Nordniedersachsen, Bremen, Hamburg, Schleswig-Holstein oder Mecklenburg-Vorpommern, überall sieht es ein wenig anders aus. Ostfriesische Inseln sind nicht wie Sylt oder Rügen.“"
                                            },
                                            {
                                                "example_id": "be0bd2cf-a736-47d0-be2e-98b29ed6359e",
                                                "sense_id": "8f09eff8-53ed-348d-aba5-757902a3ff31",
                                                "text": "„Das Feuer auf dem Öltanker Annika ist gelöscht. Rettungskräfte verhinderten eine Katastrophe vor der Küste von Mecklenburg-Vorpommern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
