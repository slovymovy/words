{
    "word_family": [
        "collect",
        "collection",
        "collector",
        "collectively",
        "collectivism",
        "collectivize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "41cf66c6-7ea6-3db3-8542-5bcd83cdd1b0",
                    "sense_definition": "Worthy or suitable for collecting due to historical, financial, or aesthetic value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collecting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The auction house specializes in <w>collectible</w> stamps and rare coins from the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Аукционный дом специализируется на <w>коллекционных</w> марках и редких монетах девятнадцатого века."
                            }
                        },
                        {
                            "text": "Many people consider vintage movie posters to be a highly <w>collectible</w> item for film enthusiasts.",
                            "target_lang_translations": {
                                "ru": "Многие считают винтажные киноафиши крайне <w>ценным объектом коллекционирования</w> для любителей кино."
                            }
                        }
                    ],
                    "synonyms": [
                        "collectable"
                    ],
                    "common_phrases": [
                        "collectible items",
                        "highly collectible",
                        "collectible memorabilia"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представляющий ценность для коллекционирования благодаря исторической, финансовой или эстетической значимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коллекционный",
                                "target_lang_sense_clarification": "представляющий интерес для коллекционеров"
                            },
                            {
                                "target_lang_word": "антикварный",
                                "target_lang_sense_clarification": "старинный и ценный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35683f27-af6a-397d-b07d-23617070dad2",
                    "sense_definition": "Subject to or requiring payment; able to be gathered or recovered as a debt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant marked the outstanding invoice as a <w>collectible</w> debt in the company ledger.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер отметил неоплаченный счет в книге учета компании как задолженность, <w>подлежащую взысканию</w>."
                            }
                        },
                        {
                            "text": "Legal action was taken to ensure the <w>collectible</w> taxes were paid to the local government.",
                            "target_lang_translations": {
                                "ru": "Были предприняты судебные меры, чтобы гарантировать, что <w>подлежащие сбору</w> налоги будут выплачены местному правительству."
                            }
                        }
                    ],
                    "synonyms": [
                        "payable",
                        "due"
                    ],
                    "antonyms": [
                        "uncollectible"
                    ],
                    "common_phrases": [
                        "collectible debt",
                        "collectible bill"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business and legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подлежащий оплате или взысканию; долг, который можно получить или собрать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлежащий взысканию",
                                "target_lang_sense_clarification": "о долгах или платежах"
                            },
                            {
                                "target_lang_word": "дебиторский",
                                "target_lang_sense_clarification": "относящийся к задолженности, которую можно получить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c82806e-eb49-30db-a9e3-8fc9a8618300",
                    "sense_definition": "Likely or possible to be paid or recovered.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has owed us money for months, but the debt doesn't look very <w>collectible</w> at this point.",
                            "target_lang_translations": {
                                "ru": "Он должен нам деньги уже несколько месяцев, но на данный момент долг не выглядит <w>возвратным</w>."
                            }
                        },
                        {
                            "text": "The bank assesses whether a loan is still <w>collectible</w> before deciding to write it off.",
                            "target_lang_translations": {
                                "ru": "Банк оценивает, является ли кредит все еще <w>реальным к взысканию</w>, прежде чем принять решение о его списании."
                            }
                        }
                    ],
                    "synonyms": [
                        "recoverable"
                    ],
                    "antonyms": [
                        "irrecoverable"
                    ],
                    "common_phrases": [
                        "not very collectible"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "financial context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вероятный или возможный к выплате или возврату."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвратный",
                                "target_lang_sense_clarification": "который можно вернуть или получить обратно"
                            },
                            {
                                "target_lang_word": "реальный к взысканию",
                                "target_lang_sense_clarification": "о долге, который возможно получить"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd000bb4-df4f-3682-8d75-c3aebea1ab33",
                    "sense_definition": "An object that is valued by collectors and often kept as part of a series or set.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collecting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop sells various <w>collectibles</w>, ranging from action figures to limited edition trading cards.",
                            "target_lang_translations": {
                                "ru": "В магазине продаются различные <w>предметы коллекционирования</w>, от фигурок героев до карточек ограниченного тиража."
                            }
                        },
                        {
                            "text": "She keeps her rare <w>collectible</w> in a glass case to protect it from dust and damage.",
                            "target_lang_translations": {
                                "ru": "Она хранит свою редкую <w>коллекционную вещь</w> в стеклянной витрине, чтобы защитить ее от пыли и повреждений."
                            }
                        }
                    ],
                    "synonyms": [
                        "collectable"
                    ],
                    "common_phrases": [
                        "rare collectible",
                        "vintage collectible",
                        "valuable collectible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет, представляющий ценность для коллекционеров, часто являющийся частью серии или набора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предмет коллекционирования",
                                "target_lang_sense_clarification": "объект, имеющий ценность для коллекции"
                            },
                            {
                                "target_lang_word": "коллекционная вещь",
                                "target_lang_sense_clarification": "редкий или ценный экземпляр"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}