                                        "glosses": [
                                            "unregelmäßiger Lauf eines Motors"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff0cc1dd-9698-48e7-abaa-a36e56619d21",
                                                "sense_id": "2d8fff93-f96a-3a75-8e2d-fec16a67bc8c",
                                                "text": "Seit gestern macht sich bei dem Fahrzeug ein gelegentliches Stottern bemerkbar."
