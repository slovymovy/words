                "senses": [
                    {
                        "sense_id": "6ce0e5b5-d16c-3b73-a422-4bf3a68fe0f6",
                        "entry_id": "9984b1df-cc5f-37ee-8d4d-4c7174644453",
                        "glosses": [
                            "beim Fahren das Vorderrad/die Vorderräder den Boden nicht berühren lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "340cfdc4-fbd0-443d-be09-cf2af6cc2374",
                                "sense_id": "6ce0e5b5-d16c-3b73-a422-4bf3a68fe0f6",
                                "text": "Ich kann mit dem Fahrrad einen Wheelie machen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f07fa17-f1f2-4de5-8513-0c7b8d151551",
                        "source_entry_id": "9984b1df-cc5f-37ee-8d4d-4c7174644453",
                        "source_sense_id": "6ce0e5b5-d16c-3b73-a422-4bf3a68fe0f6",
                        "source_sense_description": "beim Fahren das Vorderrad/die Vorderräder den Boden nicht berühren lassen",
                        "target_lang_word": "wheelie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wheelie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab8ddaa5-8220-36aa-aaae-f57b79dc2021",
                                        "entry_id": "c644f51d-fa9d-34a6-a32b-9280ea02c054",
                                        "glosses": [
                                            "An action or stunt where a bicycle, motorcycle, or other vehicle is ridden for a short period while it is standing only on its rear wheel or wheels."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29b583cb-e694-4262-b92e-06284fa1f6db",
                                                "sense_id": "ab8ddaa5-8220-36aa-aaae-f57b79dc2021",
                                                "text": "Jim fell off his bike when he was trying to do a wheelie."
                                            },
                                            {
                                                "example_id": "6e72814f-3113-4b12-94d8-2cd0292445e3",
                                                "sense_id": "ab8ddaa5-8220-36aa-aaae-f57b79dc2021",
                                                "text": "With them [bicycles], children can accomplish such unique and delightfully dangerous stunts as “wheelies”—that is, riding at a fast speed with the machine's front wheel raised completely above the ground."
                                            },
                                            {
                                                "example_id": "40c22e51-d7ac-4a4c-9740-a243be9be928",
                                                "sense_id": "ab8ddaa5-8220-36aa-aaae-f57b79dc2021",
                                                "text": "Bikes are pointing their noses in the air nowadays with the help of a new gadget called the Wheelie-Bar. By attaching the device to the rear of your cycle, you can tilt back on the hind wheel; wooden skate rollers at the end of the bar let you ride high, the way stock-car dragsters do."
                                            },
                                            {
                                                "example_id": "0ee49d2a-56f9-42d9-a66a-1e1054bc0e19",
                                                "sense_id": "ab8ddaa5-8220-36aa-aaae-f57b79dc2021",
                                                "text": "In keeping with his overall emphasis on skill, [Doug] Domokos says his most difficult trick is one he performs on solid ground. During the show, you'll see him pull up the front wheel of his ATV [all-terrain vehicle], then step over the handlebars and continue the wheelie while seated on the headlight."
                                            },
                                            {
                                                "example_id": "6f1e639d-8d9f-4dd2-8011-59fdfc8f662b",
                                                "sense_id": "ab8ddaa5-8220-36aa-aaae-f57b79dc2021",
                                                "text": "I learned how to let the clutch out slo-ow-ly so my tractor wouldn't pop a wheely and go hauling over backward."
                                            },
                                            {
                                                "example_id": "22117186-b584-49ee-9cd2-90ee7b8eb39e",
                                                "sense_id": "ab8ddaa5-8220-36aa-aaae-f57b79dc2021",
                                                "text": "The bikers pop wheelies and execute speedy figure eights along the busy street. Still, something more purposeful than joyriding would seem to be on their minds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "599b0174-4625-3c35-b989-b717cfb27e2e",
                                        "entry_id": "c644f51d-fa9d-34a6-a32b-9280ea02c054",
                                        "glosses": [
                                            "A wheelchair user."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "476ee62e-2a21-4b64-9354-cf4c02329bc4",
                                                "sense_id": "599b0174-4625-3c35-b989-b717cfb27e2e",
                                                "text": "It is also a nightmare for the wheelies, or wheelchair users. Not only is it hard enough to find a bloody wheelchair in the airport these days, but to push them to this back-of-beyond gate is a job in itself."
                                            },
                                            {
                                                "example_id": "758ecc57-47a4-4b63-a49b-68a0ae655cb8",
                                                "sense_id": "599b0174-4625-3c35-b989-b717cfb27e2e",
                                                "text": "Of the wheelchair users, or wheelies[…], Phil is the other group leader. He has been paraplegic for about ten years. The idea of the group leaders is that they provide support and encouragement from a position of experience."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wheelie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4298f481-a0cd-3c97-8acb-6b1cb779629e",
                                        "entry_id": "d634a46b-dbdb-3028-ac22-aea28fe94155",
                                        "glosses": [
                                            "To ride, or perform the stunt of riding, a vehicle on its rear wheel or wheels."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab775f97-42a2-4142-8dab-b91f12e6fbfb",
                                                "sense_id": "4298f481-a0cd-3c97-8acb-6b1cb779629e",
                                                "text": "Downshift while the engine is still revving well. This will prevent missed gears when you stomp the shift lever in a panic to regain power. Also, if you wait too long to shift down, you risk the possibility of wheelieing when you catch the next lower cog. A wheelie will cause you to shut off for a second … and it's all over brother. Go back down and try again."
                                            },
                                            {
                                                "example_id": "877c8248-9226-48d7-a78d-8c8fb859cfa7",
                                                "sense_id": "4298f481-a0cd-3c97-8acb-6b1cb779629e",
                                                "text": "The other possible problem with uphill, downhill and crested roads is that bikes tend to wheelie over them. This isn't really a problem unless you have to make a turn while the front wheel is still in the air. The rear brake will help to keep the front down."
                                            },
                                            {
                                                "example_id": "4b670415-3f9d-4f92-9c73-3eeebdb5aaed",
                                                "sense_id": "4298f481-a0cd-3c97-8acb-6b1cb779629e",
                                                "text": "Our faces light up for each other, and with the greatest grin he jumps his rusty banana seat off the curb and wheelies around in the space created for him."
                                            },
                                            {
                                                "example_id": "4f071181-8075-44f8-a9ce-0a13d7146f7e",
                                                "sense_id": "4298f481-a0cd-3c97-8acb-6b1cb779629e",
                                                "text": "At some point in nearly any hillclimb, you'll have to shift your weight from the rear to the front to keep the front wheel down as it gets steeper and you get more traction. You can also feather the clutch to keep from wheelying over, as well as using throttle control."
                                            },
                                            {
                                                "example_id": "6ee0c700-20ec-4567-95ad-7ada7dacf5cf",
                                                "sense_id": "4298f481-a0cd-3c97-8acb-6b1cb779629e",
                                                "text": "I guess I was starting to feel super-confident, a bit like the wheelchair basketball guy who had wheelied out of my hospital room that day. Plus, I was trying to make it so I could laugh in the face of my injuries."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wheelie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5269cb97-3250-3940-aa2e-364e2690fa0b",
                                        "entry_id": "70d93f83-70cf-3ffc-92d4-cc875417c8ae",
                                        "glosses": [
                                            "Alternative spelling of wheely (“having wheels; mounted on wheels”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6430058c-6a56-4286-9cd1-34626b3f4231",
                                                "sense_id": "5269cb97-3250-3940-aa2e-364e2690fa0b",
                                                "text": "wheelie bag  wheelie bin"
                                            },
                                            {
                                                "example_id": "1df3cd4b-9faf-4417-86da-96c54398590c",
                                                "sense_id": "5269cb97-3250-3940-aa2e-364e2690fa0b",
                                                "text": "He took the remaining fillet from the fridge and slid it off the plate, into the bin. He tied the plastic liner and brought it out to the wheelie bin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
