                    {
                        "sense_id": "8fe3141d-3f81-3b45-9de4-8bdb8135b317",
                        "entry_id": "14cbc137-e1c6-3e81-ad3e-bc37d27835e2",
                        "glosses": [
                            "die Bewunderungswürdigkeit, die Großartigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6300b217-4297-4274-82c6-551be7520d3d",
                                "sense_id": "8fe3141d-3f81-3b45-9de4-8bdb8135b317",
                                "text": "\"A mind like his is dangerous to society, dangerous to itself, but there's an admirability about it too.\""
                            },
                            {
                                "example_id": "260abb93-28e5-44ab-873e-4b2d5de3f59d",
                                "sense_id": "8fe3141d-3f81-3b45-9de4-8bdb8135b317",
                                "text": "\"In face of this, the admirability of one's high standards may seem small solace.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfc08aec-9670-45cd-aa43-3ee0419cd026",
                        "source_entry_id": "14cbc137-e1c6-3e81-ad3e-bc37d27835e2",
                        "source_sense_id": "8fe3141d-3f81-3b45-9de4-8bdb8135b317",
                        "source_sense_description": "die Bewunderungswürdigkeit, die Großartigkeit",
                        "target_lang_word": "Bewunderungswürdigkeit",
