        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c3de66f4-9fc0-337c-afa5-b7c53590f750",
                    "sense_definition": "Ventre ou estomac, en particulier lorsqu'il est rebondi ou proéminent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ce repas copieux, j'ai vraiment mal au <w>bide</w> et je dois m'allonger.",
                            "target_lang_translations": {
                                "en": "After that heavy meal, my <w>tummy</w> really hurts and I have to lie down.",
                                "ru": "После такого сытного обеда у меня очень болит <w>живот</w>, и мне нужно прилечь.",
                                "de": "Nach diesem üppigen Essen tut mir wirklich der <w>Bauch</w> weh, und ich muss mich hinlegen.",
                                "es": "Después de esa comida tan copiosa, me duele mucho la <w>barriga</w> y tengo que tumbarme.",
                                "zh": "吃完这顿丰盛的饭后，我的<w>肚子</w>疼得厉害，必须躺下。"
                            }
                        },
                        {
                            "text": "Il a pris un peu de <w>bide</w> depuis qu'il a complètement arrêté le sport.",
                            "target_lang_translations": {
                                "en": "He has put on a bit of a <w>belly</w> since he stopped doing sport altogether.",
                                "ru": "Он немного отрастил <w>живот</w> с тех пор, как совсем забросил спорт.",
                                "de": "Seit er mit dem Sport ganz aufgehört hat, hat er etwas <w>Bauch</w> angesetzt.",
                                "es": "Ha cogido un poco de <w>barriga</w> desde que dejó por completo el deporte.",
                                "zh": "自从他彻底不运动以后，就长了点<w>啤酒肚</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bedaine",
                        "brioche",
                        "panse"
                    ],
                    "common_phrases": [
                        "avoir du bide",
                        "mal au bide"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The stomach or belly, especially when round or protruding.",
                        "ru": "Живот или брюхо, особенно круглый или выступающий.",
                        "de": "Bauch oder Magen, besonders wenn er rund oder hervorstehend ist.",
                        "es": "Estómago o abdomen, sobre todo cuando está redondeado o sobresale.",
                        "zh": "人体的腹部，尤指圆鼓或凸出的部分。"
                    },
