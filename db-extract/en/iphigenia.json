    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "82531596-787e-3063-b0a9-a6c783258dc4",
                "word": "Iphigenia",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a51898b0-e2a6-35e8-b47c-cbd11de58acb",
                        "entry_id": "82531596-787e-3063-b0a9-a6c783258dc4",
                        "glosses": [
                            "The daughter of Agamemnon and Clytaemnestra, who is sacrificed by her father to ensure the safe journey of the Greeks to Troy."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "781cb472-6274-4bb6-b3c3-c80266827ef3",
                                "sense_id": "a51898b0-e2a6-35e8-b47c-cbd11de58acb",
                                "text": "If we are convinced by the way the Iphigenia myth reworks and distorts the structure of the Metis myth, then we gain a new understanding of the logic underlying Athena's refusal to acknowledge the crime against Iphigenia."
                            },
                            {
                                "example_id": "463c28d4-e8ba-493c-a7e3-be1dc1b7beb6",
                                "sense_id": "a51898b0-e2a6-35e8-b47c-cbd11de58acb",
                                "text": "The founding of the sanctuary at Braurona is related to the myths of Iphigenia and her brother, Orestes."
                            },
                            {
                                "example_id": "965b3dac-ed95-4598-941b-bdfb57e2b49e",
                                "sense_id": "a51898b0-e2a6-35e8-b47c-cbd11de58acb",
                                "text": "One such involuntary sacrifice is found in the story of Iphigenia, the daughter of Agamemnon, the famous Greek king and warrior."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3dc13f2d-e6e7-4f2e-9d69-4e000f762d07",
                        "source_entry_id": "82531596-787e-3063-b0a9-a6c783258dc4",
                        "source_sense_id": "a51898b0-e2a6-35e8-b47c-cbd11de58acb",
                        "source_sense_description": "Greek mythological figure",
                        "target_lang_word": "Iphigénie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Iphigénie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1394c45-1d1f-3924-ac7e-1eac0d785579",
                                        "entry_id": "71df37a6-151a-33ce-afb7-f5752b5338c4",
                                        "glosses": [
                                            "Atride, fille d’Agamemnon et de Clytemnestre, sœur d’Oreste, d’Électre et de Chrysothémis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de56ba27-421f-4d03-a484-e6891e9920a6",
                                                "sense_id": "c1394c45-1d1f-3924-ac7e-1eac0d785579",
                                                "text": "Agamemnon a consenti au sacrifice d’Iphigénie, ordonné par un oracle. Achille , à qui elle a été promise pour épouse, vient lui demander s’il est vrai qu’il laisse sacrifier sa propre fille."
                                            },
                                            {
                                                "example_id": "9c3e3b82-c5f5-4e6e-9b74-f212fcba353b",
                                                "sense_id": "c1394c45-1d1f-3924-ac7e-1eac0d785579",
                                                "text": "Ni Isaac mené au sacrifice, ni Iphigénie tombant sur l’autel ne prouvent autre chose que la déraison humaine."
                                            },
                                            {
                                                "example_id": "9933bbdc-5438-4d0e-8342-c48c2b297830",
                                                "sense_id": "c1394c45-1d1f-3924-ac7e-1eac0d785579",
                                                "text": "J’ai le sentiment d’avoir vu la scène mille fois, ici comme en France d’ailleurs, des histoires où « les yeux dans les yeux » et « droit dans ses bottes », un responsable politique, pourtant pris la main dans le sac, jure ses grands dieux qu’il est irréprochable, la probité faite homme, plus pur et innocent que qu’Iphigénie soi-même!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
