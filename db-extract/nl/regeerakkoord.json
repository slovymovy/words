                "senses": [
                    {
                        "sense_id": "d643fcf6-5496-377c-922a-c94b67f9ec29",
                        "entry_id": "fb2c489c-048e-3a40-832a-f4e997cba53b",
                        "glosses": [
                            "overeenkomst tussen coalitiepartijen die bij de vorming van een coalitieregering gesloten wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe8e417-a8cc-4e87-b93e-5c7e24222b6d",
                                "sense_id": "d643fcf6-5496-377c-922a-c94b67f9ec29",
                                "text": "De Eerste Kamerfracties zijn niet gebonden aan het regeerakkoord."
                            },
                            {
                                "example_id": "1dde82fc-7dba-4a81-bc0d-262545985136",
                                "sense_id": "d643fcf6-5496-377c-922a-c94b67f9ec29",
                                "text": "Staatssecretaris Harbers (VVD) liet direct weten dat hij ervan uitgaat dat het regeerakkoord voor de andere coalitiepartijen leidend is."
                            },
                            {
                                "example_id": "b40c65ac-475f-4465-83f6-64fb5f484c29",
                                "sense_id": "d643fcf6-5496-377c-922a-c94b67f9ec29",
                                "text": "Mulder wijst ook op het regeerakkoord, waarin staat dat er aandacht zou komen voor techniekonderwijs. „Dan is het niet logisch dat je dat alleen voor universiteiten regelt, maar voor hogescholen niet.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68d94f74-28ef-4502-b253-9d15d55ee2b8",
                        "source_entry_id": "fb2c489c-048e-3a40-832a-f4e997cba53b",
                        "source_sense_id": "d643fcf6-5496-377c-922a-c94b67f9ec29",
                        "source_sense_description": "overeenkomst tussen coalitiepartijen die bij de vorming van een coalitieregering gesloten wordt",
                        "target_lang_word": "Koalitionsvertrag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koalitionsvertrag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "043e400f-1735-3f91-8697-9c8675e0d5c5",
                                        "entry_id": "68bac26f-dc81-3298-8dfe-db42bdfdb91f",
                                        "glosses": [
                                            "ein Vertrag, den die Koalitionspartner abschließen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e752ce-4550-4055-9f0e-93036b4d1c68",
                                                "sense_id": "043e400f-1735-3f91-8697-9c8675e0d5c5",
                                                "text": "Im Koalitionsvertrag steht nichts von Radfahren zum Ministerium."
                                            },
                                            {
                                                "example_id": "fd5a94f3-a86a-48dd-9bb2-1ca3010c2bb9",
                                                "sense_id": "043e400f-1735-3f91-8697-9c8675e0d5c5",
                                                "text": "„Denn wenn die Regierung den Vertrag ernst nimmt, muss sie vom Koalitionsvertrag abweichen und noch in dieser Legislaturperiode die ersten Beschlüsse für einen endgültigen Ausstieg aus der Nutzung der Kohle fassen.“"
                                            },
                                            {
                                                "example_id": "5175ca1c-4914-4021-a5f8-ceaf059afbb3",
                                                "sense_id": "043e400f-1735-3f91-8697-9c8675e0d5c5",
                                                "text": "„Im Koalitionsvertrag von SPD, Grünen und FDP sind Hackbacks ausgeschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
