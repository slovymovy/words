                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to eat <w>Italian</w> tonight because everyone loves pasta.",
                            "target_lang_translations": {
                                "ru": "Мы решили поесть <w>итальянской</w> еды сегодня вечером, потому что все любят пасту.",
