                                            {
                                                "example_id": "5378a8a6-7703-4f22-9d21-4a38c4ebe2b6",
                                                "sense_id": "7e327bfa-e6af-3e79-8188-406ac1cc48c5",
                                                "text": "Des butineurs conformes aux normes."
                                            },
                                            {
                                                "example_id": "67a743af-fd34-428b-a09f-62f06bdf1617",
                                                "sense_id": "7e327bfa-e6af-3e79-8188-406ac1cc48c5",
                                                "text": "Il est bien heureusement possible de poursuivre l’installation d’un navigateur alternatif, mais cette fenêtre pop-up est un drôle de moyen de faire de la retape pour le butineur intégré au système."
                                            }
