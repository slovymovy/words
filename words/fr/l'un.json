            "senses": [
                {
                    "sense_id": "a5b6afcc-d592-3cc6-9b4b-a345b8007bed",
                    "sense_definition": "Principe suprême et cause première de toute réalité dans la philosophie néoplatonicienne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Dans sa philosophie, Plotin affirme que <w>l'Un</w> transcende toute pensée et toute existence matérielle."
                        },
                        {
                            "text": "Selon cette doctrine métaphysique, tout ce qui existe émane directement de <w>l'Un</w> primordial."
                        }
