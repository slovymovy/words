        "nl-extract.jsonl": [
            {
                "entry_id": "f2b7fc0e-d4df-3cd3-bb67-020cf9f3320d",
                "word": "uitlogen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f4e67000-a02d-3ad6-8912-fdb1443cccd3",
                        "entry_id": "f2b7fc0e-d4df-3cd3-bb67-020cf9f3320d",
                        "glosses": [
                            "een proces waarbij mineralen uit een vaste substantie worden onttrokken door middel van oplossing in een vloeistof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce4e2102-fd37-42cc-9b06-7193a0301771",
                                "sense_id": "f4e67000-a02d-3ad6-8912-fdb1443cccd3",
                                "text": ",,Er zijn twee dingen die strikt gescheiden moeten worden gezien: de risico’s voor de volksgezondheid en voor het milieu”, aldus een woordvoerder van het RIVM. ,,Van het zink in de rubberkorrels is bekend dat het kan uitlogen. Als je wilt weten wat de gevolgen hier van zijn voor het bodemleven zul je dit moeten onderzoeken. Zink is echter niet schadelijk voor de mens. Wat we nu dan ook gaan onderzoeken betreft puur de gevolgen voor het milieu, dit heeft niets met de volksgezondheid te maken.”"
                            },
                            {
                                "example_id": "572d506d-b1a7-4c45-b859-77b74040e16f",
                                "sense_id": "f4e67000-a02d-3ad6-8912-fdb1443cccd3",
                                "text": "Het uitspoelen van de vervuiling gebeurt door regenwater dat op de weg valt. Het stroomt samen met rubberdeeltjes, stof en zoutresten via putten aan de zijkant van de weg naar een drainagelaag. Van daaruit wordt het water gelijkmatig verdeeld over de daaronder liggende baggerspeciematras. Bijmengen van het bindmiddel heeft de specie alkalisch gemaakt waardoor verontreinigende stoffen sneller uitlogen uit de specie."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed417c04-d50a-3255-8a7c-544c8d5aef45",
                        "entry_id": "f2b7fc0e-d4df-3cd3-bb67-020cf9f3320d",
                        "glosses": [
                            "reinigen met een basische stof"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
