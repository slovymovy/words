                                            {
                                                "example_id": "8f116da3-ed44-4e50-bf34-23b94fffb88d",
                                                "sense_id": "63466def-2fe8-374c-b644-8c1962983950",
                                                "text": "Bij het plein van Campo dei Tolentini met de marmeren zuilen van de neoklassieke gevel van San Nicola, waar de terrasjes uitgeklapt stonden, diende ik rechtdoor mijn weg te vervolgen."
                                            },
                                            {
                                                "example_id": "113a157b-d656-43f9-a3b1-df34e489f787",
                                                "sense_id": "63466def-2fe8-374c-b644-8c1962983950",
                                                "text": "want de zuilen van de tempel staan ieder op zichzelf,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "092a76cd-4e7e-3982-9aaa-a56c5df50395",
                                        "entry_id": "633ff4f0-ad4f-3971-85ca-1582dde0d408",
                                        "glosses": [
                                            "groep mensen die binnen een samenleving verenigd zijn door hun religieuze of politieke overtuiging"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6698b577-4c43-4e38-946d-6fc9eb623256",
                                                "sense_id": "092a76cd-4e7e-3982-9aaa-a56c5df50395",
                                                "text": "De twintigste-eeuwse Nederlandse samenleving was opgedeeld in vier grote zuilen: de katholieke, de protestants-christelijke, de socialistische en de liberale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
