                ],
                "senses": [
                    {
                        "sense_id": "ef22890d-7ccc-3445-a093-974090b40074",
                        "entry_id": "ce212c99-1e91-3960-ba05-88fc66a7797c",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ab00ef-662f-46db-b462-cf07045de5e5",
                                "sense_id": "ef22890d-7ccc-3445-a093-974090b40074",
                                "text": "Frau Geppert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dcea83fe-1811-42c9-8a03-08f0642b8afc",
                                "sense_id": "ef22890d-7ccc-3445-a093-974090b40074",
                                "text": "Herr Geppert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4c8c1fa3-3ba6-4fe5-971e-30249bcc63c2",
                                "sense_id": "ef22890d-7ccc-3445-a093-974090b40074",
                                "text": "Die Gepperts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "915c41a1-52b2-4c17-bb41-3579a4de6b0e",
                                "sense_id": "ef22890d-7ccc-3445-a093-974090b40074",
                                "text": "Der Geppert trägt nie die Schals, die die Geppert ihm strickt."
                            },
                            {
                                "example_id": "e353fd8a-846e-43e8-81f7-3e0e73a6c1bf",
                                "sense_id": "ef22890d-7ccc-3445-a093-974090b40074",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Geppert kommt, geht der Herr Geppert.“"
                            },
                            {
                                "example_id": "52aafc64-9171-476f-bec5-2112fec96ed6",
                                "sense_id": "ef22890d-7ccc-3445-a093-974090b40074",
                                "text": "Geppert kommt und geht."
                            },
                            {
                                "example_id": "711e4370-c804-4fdf-a9ef-86fd2227a0ba",
                                "sense_id": "ef22890d-7ccc-3445-a093-974090b40074",
                                "text": "Gepperts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
