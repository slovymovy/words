                        "entry_id": "d3605e54-3878-3920-b281-da58065bce07",
                        "glosses": [
                            "to draw (up to, as far as), to drag (to; as far as), to haul (up to; as far as)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3066173f-25ef-31b2-aa2d-9b7d8e579f3c",
                        "entry_id": "d3605e54-3878-3920-b281-da58065bce07",
                        "glosses": [
                            "to stretch out (to; as far as), to extend (to; as far as), to bring (to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df4b00bf-2b7f-47bf-8369-9ad7434680f0",
                                "sense_id": "3066173f-25ef-31b2-aa2d-9b7d8e579f3c",
                                "text": "доро́гу дотяну́ли до дере́вни",
                                "translation": "the road has been extended as far as the village",
                                "english": "the road has been extended as far as the village"
                            }
                        ]
                    },
                    {
                        "sense_id": "c87ff4c7-f011-374c-9856-7d80378ee0dc",
                        "entry_id": "d3605e54-3878-3920-b281-da58065bce07",
                        "glosses": [
                            "to hold out (till), to last out (till)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "082a439c-012b-4d17-aeb3-2d672d48e069",
                                "sense_id": "c87ff4c7-f011-374c-9856-7d80378ee0dc",
                                "text": "маши́на едва́ дотя́нет до города",
                                "translation": "the car will just about hold out till we get to town",
                                "english": "the car will just about hold out till we get to town"
                            },
                            {
                                "example_id": "be9f762e-2a86-4814-aa30-f4c45082cbe8",
                                "sense_id": "c87ff4c7-f011-374c-9856-7d80378ee0dc",
                                "text": "самолёт не дотяну́л до аэродро́ма",
                                "translation": "the plane didn't make it to the airfield",
                                "english": "the plane didn't make it to the airfield"
                            }
                        ]
                    },
                    {
                        "sense_id": "98be0c72-dd0e-3692-964e-c817b6370681",
                        "entry_id": "d3605e54-3878-3920-b281-da58065bce07",
                        "glosses": [
                            "to while away one's time (till, until)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2e93f441-c367-40a7-81c7-58506a694940",
                                "sense_id": "98be0c72-dd0e-3692-964e-c817b6370681",
                                "text": "не зна́ю, как дотяну́ть до у́жина",
                                "translation": "I don't know how to while away my time until dinner",
                                "english": "I don't know how to while away my time until dinner"
                            }
                        ]
                    },
                    {
                        "sense_id": "5424022d-62f3-39cc-953d-7f88a03c5c26",
                        "entry_id": "d3605e54-3878-3920-b281-da58065bce07",
                        "glosses": [
                            "to live (till), to live to see, to last out"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "055d75ef-42f7-443c-8ecb-b6c0a311fd98",
                                "sense_id": "5424022d-62f3-39cc-953d-7f88a03c5c26",
                                "text": "он не дотя́нет до утра",
                                "translation": "he won't last/live out the night; he won't last till morning",
                                "english": "he won't last/live out the night; he won't last till morning"
                            },
                            {
                                "example_id": "6a9d2aee-8c58-4724-81d3-0a4573318f82",
                                "sense_id": "5424022d-62f3-39cc-953d-7f88a03c5c26",
                                "text": "не дотяну́ть до побе́ды",
                                "translation": "not to live to see the victory",
                                "english": "not to live to see the victory"
                            },
                            {
                                "example_id": "48af7479-56ff-4310-acae-7bdb3cb10486",
                                "sense_id": "5424022d-62f3-39cc-953d-7f88a03c5c26",
                                "text": "с таки́м коли́чеством еды́ мы не дотя́нем до зимы",
                                "translation": "this amount of food won't last us till winter",
                                "english": "this amount of food won't last us till winter"
                            }
                        ]
                    },
                    {
                        "sense_id": "fa24b960-b795-338a-9240-97c6d8119779",
                        "entry_id": "d3605e54-3878-3920-b281-da58065bce07",
                        "glosses": [
                            "to reach"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a46b4e6f-d226-31a4-8f18-14c9984bffa1",
                        "entry_id": "d3605e54-3878-3920-b281-da58065bce07",
                        "glosses": [
                            "to improve, to put right, to brush up, to edit, to touch up"
                        ],
