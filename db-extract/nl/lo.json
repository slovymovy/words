                    {
                        "sense_id": "907e13ab-5bc6-3cbb-b650-ffdfb42e2d98",
                        "entry_id": "4613f8b8-10ac-338f-871c-c6a22f1df3c3",
                        "glosses": [
                            "matrilineal clan within a Maroon tribe"
                        ],
                        "tags": [
                            "Suriname",
                            "feminine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "93272041-87ae-485e-9d15-de590e48237c",
                                "sense_id": "907e13ab-5bc6-3cbb-b650-ffdfb42e2d98",
                                "text": "Stefanus Poeketi, kapitein van Dawme en voorzitter van de ‘Twaalfoe Lo’, stelde dat de functie van granman niet uitsluitend door één lo zal worden uitgeoefend. Hij kondigde aan dat notarieel vastgelegd zal worden dat het ‘granmanschap’ gaat rouleren onder de twaalf lo’s van de Saramaccaanse stam.",
                                "translation": "Stefanus Poeketi, village chief of Dawme and chairman of the 'Twaalfoe Lo', stated that the position of paramount chief will not be held exclusively by one clan. He announced that it will be notarially certified that the 'paramount chieftaincy' will rotate among the twelve clans of the Saramaccan tribe.",
                                "english": "Stefanus Poeketi, village chief of Dawme and chairman of the 'Twaalfoe Lo', stated that the position of paramount chief will not be held exclusively by one clan. He announced that it will be notarially certified that the 'paramount chieftaincy' will rotate among the twelve clans of the Saramaccan tribe."
                            }
                        ]
                    }
                ],
