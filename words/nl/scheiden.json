                    "semantic_group_id": "separation_paths",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op dit punt <w>scheiden</w> onze wegen en ga ik alleen verder.",
                            "target_lang_translations": {
                                "en": "At this point our paths <w>part</w> and I continue alone.",
                                "ru": "В этом месте наши пути <w>расходятся</w>, и я пойду дальше один.",
                                "pl": "W tym miejscu nasze drogi się <w>rozchodzą</w> i idę dalej sam.",
                                "de": "An diesem Punkt <w>scheiden</w> sich unsere Wege und ich gehe alleine weiter.",
                                "fr": "À ce stade, nos chemins <w>se séparent</w> et je continue seul.",
                                "it": "A questo punto le nostre strade si <w>dividono</w> e io continuo da solo.",
                                "cs": "V tomto bodě se naše cesty <w>rozcházejí</w> a já budu pokračovat sám.",
                                "tr": "Bu noktada yollarımız <w>ayrılıyor</w> ve ben yalnız devam ediyorum.",
                                "es": "En este punto nuestros caminos se <w>separan</w> y yo continúo solo."
                            }
                        },
                        {
                            "text": "Na de middelbare school <w>scheidden</w> hun wegen zich.",
                            "target_lang_translations": {
                                "en": "After high school, their paths <w>parted</w>.",
                                "ru": "После средней школы их пути <w>разошлись</w>.",
                                "pl": "Po szkole średniej ich drogi się <w>rozeszły</w>.",
                                "de": "Nach der Highschool <w>trennten</w> sich ihre Wege.",
                                "fr": "Après le lycée, leurs chemins <w>se sont séparés</w>.",
                                "it": "Dopo la scuola superiore le loro strade si sono <w>separate</w>.",
                                "cs": "Po střední škole se jejich cesty <w>rozešly</w>.",
                                "tr": "Liseden sonra yolları <w>ayrıldı</w>.",
                                "es": "Después de la escuela secundaria, sus caminos se <w>separaron</w>."
                            }
                        }
