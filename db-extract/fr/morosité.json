                "senses": [
                    {
                        "sense_id": "890ddd0b-c8df-3fd1-9bae-d7710d9006f9",
                        "entry_id": "22efe128-44bd-3cfc-86fb-8f6f0b37a7ff",
                        "glosses": [
                            "État de celui qui est morose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ca18a36-1b62-41b7-a49e-8db3180eb909",
                                "sense_id": "890ddd0b-c8df-3fd1-9bae-d7710d9006f9",
                                "text": "Gilles Perret a réuni Lætitia Dosch, Pierre Deladonchamps, Grégory Montel et Vincent Deniard pour un grand pied de nez à la morosité, avec cette histoire d’ouvriers d’une usine de Haute-Savoie qui se font passer pour des financiers, afin de racheter leur entreprise promise à un fonds d’investissement."
                            },
                            {
                                "example_id": "e669e597-9372-4755-8cc0-c63198a4a036",
                                "sense_id": "890ddd0b-c8df-3fd1-9bae-d7710d9006f9",
                                "text": "Le monde ambiant suscite chez plusieurs intellectuels la mélancolie et la morosité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bdcde52-8045-4e4e-b0d0-6541006ed7b7",
                        "source_entry_id": "22efe128-44bd-3cfc-86fb-8f6f0b37a7ff",
                        "source_sense_id": "890ddd0b-c8df-3fd1-9bae-d7710d9006f9",
                        "target_lang_word": "Trübsinn",
                        "target_lang_code": "de",
