    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "13d9596c-ce31-37c7-9a72-e4211a7a16ed",
                    "sense_definition": "Used to express a sudden disappearance or a puff of smoke, as if by magic.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disappearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "And just like that, <w>poof</w>, all the money was gone from the table. "
                        },
                        {
                            "text": "He waved his magic wand and, <w>poof</w>, a white rabbit appeared."
                        }
                    ],
                    "common_phrases": [
                        "poof gone",
                        "like that poof"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as an exclamation for suddenness"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5fddb9e8-f6e7-367a-85b6-6c4729714a11",
                    "sense_definition": "To suddenly vanish or disappear, often leaving behind a cloud of smoke or puff.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "disappearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician <w>poofed</w> away into thin air leaving the audience shocked."
                        },
                        {
                            "text": "I turned my head for a second and the cat <w>poofed</w> away."
                        }
                    ],
                    "synonyms": [
                        "vanish",
                        "disappear"
                    ],
                    "antonyms": [
                        "appear"
                    ],
                    "common_phrases": [
                        "poof away",
                        "poof out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ]
                },
                {
                    "sense_id": "5568be83-36c7-3378-be4b-2351be319d89",
                    "sense_definition": "To pass intestinal gas silently or with a small puff sound.",
