                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "audio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The collector found a rare <w>gram</w> from the early twentieth century.",
                            "target_lang_translations": {
                                "ru": "Коллекционер нашел редкую <w>пластинку</w> начала двадцатого века."
                            }
                        },
                        {
                            "text": "He spent the evening listening to an old <w>gram</w> of classical music.",
                            "target_lang_translations": {
                                "ru": "Он провел вечер, слушая старую <w>запись</w> классической музыки."
                            }
                        }
                    ],
                    "synonyms": [
                        "record",
                        "recording"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to older technology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Граммофонная запись или пластинка."
