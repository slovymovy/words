                "senses": [
                    {
                        "sense_id": "3d1c50b4-b088-3549-8549-fa21afcca9f8",
                        "entry_id": "01aee8b9-fc9e-3da9-a775-70851764188e",
                        "glosses": [
                            "Gemeinschaftssinn innerhalb eines bestimmten Personenkreises"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "653785e8-6641-4526-b64a-81e4407bb014",
                                "sense_id": "3d1c50b4-b088-3549-8549-fa21afcca9f8",
                                "text": "„Die Eurokraten haben über Jahrzehnte echten Korpsgeist entwickelt.“"
                            },
                            {
                                "example_id": "1055f8a8-36bd-4879-a2c0-1e5513ad788e",
                                "sense_id": "3d1c50b4-b088-3549-8549-fa21afcca9f8",
                                "text": "„Insgesamt gesehen gibt es daher in der Armee einen Korpsgeist, der die üblichen Grenzen von biraderi-Zugehörigkeit durchbricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6eebb418-5f92-374c-acd9-100d046666f2",
                        "entry_id": "01aee8b9-fc9e-3da9-a775-70851764188e",
                        "glosses": [
                            "hochmütiges Gehabe innerhalb einer elitären Personengruppe gegenüber einer ihres Erachtens niedriger gestellten Personengruppe"
                        ],
                        "tags": [
                            "meist abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "f1739419-da76-4738-989f-62af4fe34201",
                                "sense_id": "6eebb418-5f92-374c-acd9-100d046666f2",
                                "text": "„Die Eurokraten haben über Jahrzehnte echten Korpsgeist entwickelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9803406-b812-49b7-a4f1-aa6786c5a127",
                        "source_entry_id": "01aee8b9-fc9e-3da9-a775-70851764188e",
                        "source_sense_id": "3d1c50b4-b088-3549-8549-fa21afcca9f8",
                        "source_sense_description": "Gemeinschaftssinn innerhalb eines bestimmten Personenkreises",
                        "target_lang_word": "esprit de corps",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esprit de corps",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "388dd505-ceb6-3120-888a-0d9dba04df48",
                                        "entry_id": "0dac4153-e3b1-3395-bdbd-b710cedeca5f",
                                        "glosses": [
                                            "A shared spirit of comradeship, enthusiasm, and devotion to a cause among the members of a group, for example of a military unit."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2a56672-0ec0-4114-91d5-84712b5b1ad3",
                                                "sense_id": "388dd505-ceb6-3120-888a-0d9dba04df48",
                                                "text": "“Well done, sister! I honour your esprit du corps^([sic]). When I am a wife, I mean to be just as staunch myself; and I wish my friends in general would be so too. It would save me many a heartache.”"
                                            },
                                            {
                                                "example_id": "4fb5df91-6555-4403-bb6a-ee2f1db166c2",
                                                "sense_id": "388dd505-ceb6-3120-888a-0d9dba04df48",
                                                "text": "Always happening like that. The very moment. Girl in Eustace street hallway Monday was it settling her garter. Her friend covering the display of. Esprit de corps. Well, what are you gaping at?"
                                            },
                                            {
                                                "example_id": "e9ed9c2a-e085-44b7-a9be-4ad7459f5da2",
                                                "sense_id": "388dd505-ceb6-3120-888a-0d9dba04df48",
                                                "text": "Also, much depended on an exceptional esprit de corps which permeated the whole staff, and achieved miracles of promptitude in such details as engine-changing and the marshalling of trains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
