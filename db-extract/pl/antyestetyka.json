                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5143e6a9-163e-4a42-8626-cef10f8a97bc",
                        "source_entry_id": "82ec5d8f-e579-36dc-8a72-9203618e6085",
                        "source_sense_id": "21225819-7dd4-35c3-b7e2-cccb1d332dfd",
                        "target_lang_word": "antiesthétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiesthétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f938e322-c481-3d25-859d-bd5e2c57f2c5",
                                        "entry_id": "0d17c2ab-5608-3251-ad18-2336b51b6e5b",
                                        "glosses": [
                                            "Qui s'oppose à l'esthétisme."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abb0ee22-daab-44c2-a836-5b6c089878b8",
                                                "sense_id": "f938e322-c481-3d25-859d-bd5e2c57f2c5",
                                                "text": "Je vois dans le naturalisme un synchronisme du suffrage universel, et le protagonisme antiesthétique de la canaille : l'écrivain fait sa cour à la rue, comme jadis au roi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c23dfc2-1117-4e59-9663-6884d3690715",
                        "source_entry_id": "82ec5d8f-e579-36dc-8a72-9203618e6085",
                        "source_sense_id": "21225819-7dd4-35c3-b7e2-cccb1d332dfd",
                        "target_lang_word": "anti-esthétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "715d0be5-fc4a-4017-a72c-3817d4819b98",
                        "source_entry_id": "82ec5d8f-e579-36dc-8a72-9203618e6085",
                        "source_sense_id": "21225819-7dd4-35c3-b7e2-cccb1d332dfd",
                        "target_lang_word": "Antiästhetik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antiästhetik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00fa4312-9107-39b1-a398-5826eb97a31c",
                                        "entry_id": "607c4da2-34a9-3fa8-8743-647239bf7c7a",
                                        "glosses": [
                                            "Eigenschaft von Dingen, insbesondere von Kunstwerken oder Symbolen, die bei Vertretern der etablierten Gesellschaft einer Epoche ein Empfinden des Hässlichen und Gefühle der Abscheu hervorrufen. Die Antiästhetik ist in Kunst und Politik oftmals ein Stilmittel der Provokation, um etablierte gesellschaftliche oder politische Strukturen aufzubrechen, verdrängte Wahrheiten aufzudecken und neue Räume für Empfindungen und Gedanken zu eröffnen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4e6e3f5-87aa-4a4f-940a-ae19e77a61cf",
                                                "sense_id": "00fa4312-9107-39b1-a398-5826eb97a31c",
                                                "text": "Die Antiästhetik dieses Kunstwerks ist nicht zu übersehen, es ist wirklich nicht schön."
                                            },
                                            {
                                                "example_id": "c123302b-6bce-4c5a-97b3-bd2075e97863",
                                                "sense_id": "00fa4312-9107-39b1-a398-5826eb97a31c",
                                                "text": "Deix zeichnet Cartoons von nie gekannter Schonungslosigkeit, erbarmungslos entlarvende Blätter und Geschichten von provozierender Antiästhetik, brutale Abbilder der Wirklichkeit… Grobheit und Häßlichkeit schattieren in schmerzlicher oder zwerchfellerschütternder Manier politische Charaktere, die Obszönitäten des bürgerlichen Alltags."
                                            },
                                            {
                                                "example_id": "41283546-6203-445c-8c0b-a22e0806f31d",
                                                "sense_id": "00fa4312-9107-39b1-a398-5826eb97a31c",
                                                "text": "Für gewöhnlich wird Butoh als \"dunkler Tanz\" übersetzt, womit auch das ästhetische Programm umrissen ist. Es geht von einer Antiästhetik aus, die sich gegen die Schönheitsideale westlicher Prägung richtet."
                                            },
                                            {
                                                "example_id": "3f15e43f-b987-493d-ba7b-98d490526b66",
                                                "sense_id": "00fa4312-9107-39b1-a398-5826eb97a31c",
                                                "text": "Das Sprechtheater hatte die traditionellen Vorgaben schon abgelegt und seine jungen Regisseure hatten sich zu Experiment, Performance und Antiästhetik bekannt."
                                            },
                                            {
                                                "example_id": "689a2e85-b542-42d2-8fd5-e1312bf28e40",
                                                "sense_id": "00fa4312-9107-39b1-a398-5826eb97a31c",
                                                "text": "Das gesamte Akustikgebilde wird von Maureen Tuckers treibenden Schlagzeug gestützt. VU machten sich auf diesem Album bewußt den kalkulierten Krach zu eigen und erhoben ihn in den Status der Antiästhetik."
                                            },
                                            {
                                                "example_id": "4d0f66b4-d004-4102-a422-f9fb14ff064f",
                                                "sense_id": "00fa4312-9107-39b1-a398-5826eb97a31c",
                                                "text": "Das Anstößige und Peinliche im Sinne von Bondy wird von Kunstmann generalisierend als das Antiästhetische erfasst und nach seiner Ansicht an der Figur der hässlichen und apathischen Yvonne und ihrem Verhalten am treffendsten exemplifiziert. Den Terminus der Antiästhetik wendet er abwechselnd mit dem des „Turpismus“ an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
