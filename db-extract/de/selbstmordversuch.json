                "senses": [
                    {
                        "sense_id": "836fa900-11ce-3368-8899-af74d7b3c0a9",
                        "entry_id": "f2c214dc-01ff-3984-9b7c-70360f1b2ea0",
                        "glosses": [
                            "der Versuch, sich selbst das Leben zu nehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "712de32c-0a01-4b0e-bc34-e1ae5d543c4c",
                                "sense_id": "836fa900-11ce-3368-8899-af74d7b3c0a9",
                                "text": "„Nach einem Selbstmordversuch des Schiedsrichters ist die Bundesligapartie zwischen dem 1. FC Köln und dem FSV Mainz 05 am Sonnabend kurzfristig abgesagt worden.“"
                            },
                            {
                                "example_id": "97beb8ca-77d7-4226-bc46-68f6df5c1adc",
                                "sense_id": "836fa900-11ce-3368-8899-af74d7b3c0a9",
                                "text": "„Das war sein erster Selbstmordversuch.“"
                            },
                            {
                                "example_id": "77c59f13-6d09-434d-bc21-9ba575354a99",
                                "sense_id": "836fa900-11ce-3368-8899-af74d7b3c0a9",
                                "text": "„Erst nach einem Selbstmordversuch und durch die Initiative einer russischen Ärztin fand das Martyrium ein Ende.“"
                            },
                            {
                                "example_id": "9cb34368-c1bb-47b7-87f3-f759287a4ab3",
                                "sense_id": "836fa900-11ce-3368-8899-af74d7b3c0a9",
                                "text": "„Sie hatte durchblicken lassen, daß er ein ungebildeter Kerl sei und daß sie ihm ihre Tochter nur deshalb gebe, weil diese nach ihrem Selbstmordversuch kein unbescholtenes Mädchen mehr sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
