                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c84c1e6-d7a0-40fb-87eb-c64138acf82f",
                                "sense_id": "3b05b83d-efdd-3e73-87a5-10c5367362f9",
                                "text": "„Besonders auffällige Seltenheiten unter den Halbkreisern sind hier die wenigen blauen Stempel, bei deren Anbringung der Postler versehentlich in das falsche Stempelkissen griff.“"
                            },
                            {
                                "example_id": "b6ba2d81-5865-4926-b8a1-387b71809b00",
                                "sense_id": "3b05b83d-efdd-3e73-87a5-10c5367362f9",
                                "text": "„[…] und sein Gesicht ist klebrig und rußgeschwärzt, als ob er auf einem Stempelkissen geschlafen hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
