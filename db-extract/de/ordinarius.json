                "senses": [
                    {
                        "sense_id": "57f5dcbf-d159-3043-a511-d9e2e7b5bcef",
                        "entry_id": "0a768592-8cf6-370b-90c9-32a161bdac13",
                        "glosses": [
                            "im katholischen Kirchenrecht ein Oberer mit ordentlicher Jurisdiktionsgewalt"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "3b2d5d97-3749-42f1-a25f-fb0e0d3bde9e",
                                "sense_id": "57f5dcbf-d159-3043-a511-d9e2e7b5bcef",
                                "text": "Die Position des Ordinarius kommt meistens dem Diözesanbischof zu."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e40923d7-4116-3493-954a-7dc96c1631bc",
                        "entry_id": "0a768592-8cf6-370b-90c9-32a161bdac13",
                        "glosses": [
                            "ordentlicher Professor mit Sitz und Stimme in seiner Fakultät"
                        ],
                        "tags": [
                            "Bildungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "b45dcdff-00ba-4998-9312-84bceafbed7f",
                                "sense_id": "e40923d7-4116-3493-954a-7dc96c1631bc",
                                "text": "„Er könnte sie in den sechziger Jahren in seiner Zeit als Ordinarius bei einem feierlichen wissenschaftlichen Kongress hinter dem Namensschildchen auf seinem Platz vorgefunden haben (…).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "aca1b5af-61e2-3981-9f11-e334fd7e7fe2",
                        "entry_id": "0a768592-8cf6-370b-90c9-32a161bdac13",
                        "glosses": [
                            "der Klassenlehrer an einer höheren Schule oder an einem Gymnasium"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "b27ba800-0638-44ae-9ec2-550b363c3f25",
                                "sense_id": "aca1b5af-61e2-3981-9f11-e334fd7e7fe2",
                                "text": "„Zwischen ihnen und Ernst Freund gingen Strömungen hin und her, wenn der Ordinarius unter Grimassen oder mit scheinbarem Bezug auf verflossene oder künftige Epochen gefährliche Bemerkungen machte- ungeachtet des Altersunterschiedes und der Stellung.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16500e23-3243-4d51-bb68-e8c91231b55f",
                        "source_entry_id": "0a768592-8cf6-370b-90c9-32a161bdac13",
                        "source_sense_id": "57f5dcbf-d159-3043-a511-d9e2e7b5bcef",
