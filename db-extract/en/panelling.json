    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "36a60e1d-c9aa-3925-a4bd-1fd135566008",
                "word": "panelling",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "22506bf9-af19-469e-b161-9db7811d2a68",
                        "entry_id": "36a60e1d-c9aa-3925-a4bd-1fd135566008",
                        "tags": [
                            "plural"
                        ],
                        "form": "panellings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c349bbc2-d9e6-31d2-926c-148e541d61dd",
                        "entry_id": "36a60e1d-c9aa-3925-a4bd-1fd135566008",
                        "glosses": [
                            "The panels with which a surface (especially an indoor wall) is covered, considered collectively."
                        ],
                        "tags": [
                            "UK",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d462ae73-5705-4f79-a43c-40f3e5f21dac",
                                "sense_id": "c349bbc2-d9e6-31d2-926c-148e541d61dd",
                                "text": "He looked round the poor room, at the distempered walls, and the bad engravings in meretricious frames, the crinkly paper and wax flowers on the chiffonier; and he thought of a room like Father Bryan's, with panelling, with cut glass, with tulips in silver pots, such a room as he had hoped to have for his own."
                            },
                            {
                                "example_id": "33871ff5-9c24-4c00-92c4-3e17a8eac494",
                                "sense_id": "c349bbc2-d9e6-31d2-926c-148e541d61dd",
                                "text": "Here the stripped panelling was warmly gold and the pictures, mostly of the English school, were mellow and gentle in the afternoon light."
                            },
                            {
                                "example_id": "a5fabc87-2b2d-4fb8-945e-788ce28bb34d",
                                "sense_id": "c349bbc2-d9e6-31d2-926c-148e541d61dd",
                                "text": "Above the concourse, the underneath of the platforms has been clad with attractive wood panelling, while the columns holding them up are surrounded with seating - for use by passengers biding their time waiting for their trains, or who have used one of the 70-or-so eateries or shops that form part of the retail developments at the station."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3320747-0461-4685-b49d-8b5a1e9d931c",
                        "source_entry_id": "36a60e1d-c9aa-3925-a4bd-1fd135566008",
                        "source_sense_id": "c349bbc2-d9e6-31d2-926c-148e541d61dd",
                        "source_sense_description": "panels with which a surface is covered",
                        "target_lang_word": "boiserie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boiserie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e569eeb2-bb3a-3fd8-aeda-569487fe9317",
                                        "entry_id": "d0994f48-9c9e-3fcb-addf-3160b55b61db",
                                        "glosses": [
                                            "Ouvrage de menuiserie dont on couvre les murs des appartements, des salles d’apparat, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef6e4dd-32ea-48f9-a2e4-7a7251b2dc62",
                                                "sense_id": "e569eeb2-bb3a-3fd8-aeda-569487fe9317",
                                                "text": "A peine une salle était-elle cloisonnée que les menuisiers s'en emparaient pour y poser les boiseries et les vitrines, les tapissiers la tendaient d'étoffe, des ouvriers spéciaux la parquetaient de linoléum."
                                            },
                                            {
                                                "example_id": "80daf3a7-d6a5-4a4d-b8b6-b1fc39eef3da",
                                                "sense_id": "e569eeb2-bb3a-3fd8-aeda-569487fe9317",
                                                "text": "Une atmosphère pesante et troublante régnait encore entre les murs aux boiseries sévères, sous le plafond à écussons."
                                            },
                                            {
                                                "example_id": "50b7aebb-48ad-4762-a040-0a14bf90be72",
                                                "sense_id": "e569eeb2-bb3a-3fd8-aeda-569487fe9317",
                                                "text": "[…] il n’est de bruit qu’un ver qui taraude incessamment les boiseries et dans le plafond, la course d’un rongeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1deab00-cdb5-4e9d-99cc-0b4555dd8e6e",
                        "source_entry_id": "36a60e1d-c9aa-3925-a4bd-1fd135566008",
                        "source_sense_id": "c349bbc2-d9e6-31d2-926c-148e541d61dd",
                        "source_sense_description": "panels with which a surface is covered",
                        "target_lang_word": "lambris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lambris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3aeaa04-6e9b-3c53-954b-8835c6e19393",
                                        "entry_id": "ae5e3cfd-6883-3afe-8d22-1b4c14661d66",
                                        "glosses": [
                                            "Revêtement de menuiserie, de marbre, de stuc, etc., sur les murailles d’une salle, d’une chambre, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30789d4b-44af-44d5-8f00-80fbb40de29d",
                                                "sense_id": "c3aeaa04-6e9b-3c53-954b-8835c6e19393",
                                                "text": "Ce lambris est de marbre de diverses couleurs."
                                            },
                                            {
                                                "example_id": "3e41a339-dfe9-454a-8589-7d647a10667e",
                                                "sense_id": "c3aeaa04-6e9b-3c53-954b-8835c6e19393",
                                                "text": "Ce lambris est peint en blanc, avec des moulures dorées. — Lambris de stuc."
                                            },
                                            {
                                                "example_id": "17b1470a-43ec-45fd-b63c-e699f9f4d018",
                                                "sense_id": "c3aeaa04-6e9b-3c53-954b-8835c6e19393",
                                                "text": "Lambris d’appui, lambris à hauteur d’appui qui règne autour d’une pièce."
                                            },
                                            {
                                                "example_id": "7d782096-df72-4308-9196-0bfe778677d5",
                                                "sense_id": "c3aeaa04-6e9b-3c53-954b-8835c6e19393",
                                                "text": "Les lambris d’appui de mon salon sont de chêne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3049ab7c-0bf9-31cb-8e66-9a18865392f3",
                                        "entry_id": "ae5e3cfd-6883-3afe-8d22-1b4c14661d66",
                                        "glosses": [
                                            "Enduit de plâtre fait au-dedans d’un grenier, d’un galetas, sur des lattes jointives clouées aux chevrons ; bacula."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ace46f3-2e98-3136-a42a-8b7e9e710126",
                                        "entry_id": "ae5e3cfd-6883-3afe-8d22-1b4c14661d66",
                                        "glosses": [
                                            "Revêtement de menuiserie appliqué aux solives d’une salle, d’une chambre, etc., et où l’on forme quelquefois des caissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8462494d-2234-4923-861f-99fb9b34197c",
                                                "sense_id": "2ace46f3-2e98-3136-a42a-8b7e9e710126",
                                                "text": "Des lambris peints et dorés."
                                            },
                                            {
                                                "example_id": "7db05b82-964f-465e-ad59-dedba1bd843f",
                                                "sense_id": "2ace46f3-2e98-3136-a42a-8b7e9e710126",
                                                "text": "Lambris de plafond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "976db884-9059-3c85-98d8-b2e1a5aee908",
                                        "entry_id": "ae5e3cfd-6883-3afe-8d22-1b4c14661d66",
                                        "glosses": [
                                            "Décoration intérieure d’une maison vaste et magnifique."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1507a191-7a2c-47ac-9aa3-45016e7653d5",
                                                "sense_id": "976db884-9059-3c85-98d8-b2e1a5aee908",
                                                "text": "De vastes lambris, des lambris dorés, de riches lambris, etc."
                                            },
                                            {
                                                "example_id": "9cc6c45b-175b-4a56-bf96-576aff56d1d8",
                                                "sense_id": "976db884-9059-3c85-98d8-b2e1a5aee908",
                                                "text": "Le bonheur se trouve rarement sous les lambris dorés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
