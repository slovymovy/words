                "translations": [
                    {
                        "translation_id": "0c2622ee-b16a-41c8-b35f-8b1333aa5394",
                        "source_entry_id": "c3150e64-fb78-37e4-a699-1a01efca1fa2",
                        "source_sense_description": "действие по значению гл. упоминать, упоминаться, упомянуть",
                        "target_lang_word": "mentioning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
