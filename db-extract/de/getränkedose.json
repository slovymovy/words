                                "sense_id": "7ed605c9-6a3b-3bd5-8adf-920bb4565de0",
                                "text": "Beim Kauf einer Getränkedose bezahlt man 25 Cent Dosenpfand."
                            },
                            {
                                "example_id": "eb70efb3-37ec-4258-bd83-ecdcd5eb0659",
                                "sense_id": "7ed605c9-6a3b-3bd5-8adf-920bb4565de0",
                                "text": "„Ein Kleinod meiner Sammlung ist eine von Seepocken bewachsene Getränkedose mit mongolischen Schriftzeichen.“"
                            }
                        ],
