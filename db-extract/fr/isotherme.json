                "senses": [
                    {
                        "sense_id": "d5ab4362-3824-3fb0-a23a-dd56bfc0e9bc",
                        "entry_id": "261f4d0c-089c-35bd-a749-b4b7f41e7638",
                        "glosses": [
                            "Ligne fictive sur laquelle l'on mesure la même température moyenne, déterminant des frontières entre différents biotopes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab6d1f7-92e4-4d15-8fca-b041772ee99a",
                                "sense_id": "d5ab4362-3824-3fb0-a23a-dd56bfc0e9bc",
                                "text": "Il est bien évident que les plantes vivent uniquement dans les milieux qui leur conviennent, […] : ainsi l’isotherme de 4°5 moyenne du mois de janvier concorde remarquablement avec la répartition de Rubia peregrina en Europe occidentale."
                            },
                            {
                                "example_id": "ced0390f-485c-4cee-87ef-ed74eba2d7cd",
                                "sense_id": "d5ab4362-3824-3fb0-a23a-dd56bfc0e9bc",
                                "text": "Le retrait de la limite des glaces vers les pôles, en latitude, et vers les sommets des montagnes, en altitude, est la manifestation visible et tangible de la migration d’une ligne invisible qui relie les lieux où la température moyenne annuelle de l’air est proche de zéro : l’isotherme 0 °C."
                            }
                        ]
                    }
                ],
