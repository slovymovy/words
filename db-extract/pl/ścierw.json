                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e82978b2-a7ab-3ae3-bc3f-21bc45bcb8ed",
                        "entry_id": "418bd013-19d6-3f4f-8019-ef1c04f59b02",
                        "glosses": [
                            "martwe ciało"
                        ],
                        "tags": [
                            "Old-Polish"
                        ],
                        "examples": [],
