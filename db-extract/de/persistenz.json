                ],
                "senses": [
                    {
                        "sense_id": "ed0bff7b-7975-37c9-adcf-d7fdee1f81f2",
                        "entry_id": "35377d80-c2fb-3dec-945f-e49299be250e",
                        "glosses": [
                            "Dauerhaftigkeit eines Zustands"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "3095eb0b-767a-4fa3-80cf-536670a36bef",
                                "sense_id": "ed0bff7b-7975-37c9-adcf-d7fdee1f81f2",
                                "text": "Die Persistenz der Arbeitslosigkeit ist ein EU-weites Problem."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "81166747-f4a3-38b8-af5a-2cddc23a0067",
                        "entry_id": "35377d80-c2fb-3dec-945f-e49299be250e",
                        "glosses": [
                            "die Fähigkeit, Daten oder Datenobjekte auf nicht-flüchtigen Speichermedien wie Dateisystemen oder Datenbanken abzulegen und wiederabrufbar zu speichern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "054b4e00-7e4e-4fd0-94c8-03d4ca4435bf",
                                "sense_id": "81166747-f4a3-38b8-af5a-2cddc23a0067",
                                "text": "Um die Persistenz des Wiktionarys sicherzustellen, werden die Daten in einer Datenbank gespeichert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d4bbec00-23a3-30d6-b270-0db91b640df3",
                        "entry_id": "35377d80-c2fb-3dec-945f-e49299be250e",
                        "glosses": [
                            "Eigenschaft bestimmter Stoffe, über lange Zeiträume hinweg in der Umwelt zu verbleiben, ohne durch physische, chemische oder biologische Vorgänge abgebaut zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f370fb82-95d4-46fb-966e-81cfbce9ff56",
                                "sense_id": "d4bbec00-23a3-30d6-b270-0db91b640df3",
                                "text": "Bei Pestiziden ist Persistenz in der Umwelt äußerst unerwünscht."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "3ac293fb-3982-37a2-b851-af5d360c2c19",
                        "entry_id": "35377d80-c2fb-3dec-945f-e49299be250e",
                        "glosses": [
                            "Dauerhaftigkeit und Beharrlichkeit bei dem Versuch, ein Ziel zu erreichen"
                        ],
                        "tags": [
                            "Motivationspsychologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ac4a547d-9e8c-4af2-91d4-a5ed292267e8",
                                "sense_id": "3ac293fb-3982-37a2-b851-af5d360c2c19",
                                "text": "Es ist bewundernswert, mit welcher Persistenz er seinen Traum vom Fliegen verfolgt."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95795c05-74e6-45d5-905f-a2b60816f1de",
                        "source_entry_id": "35377d80-c2fb-3dec-945f-e49299be250e",
                        "source_sense_id": "ed0bff7b-7975-37c9-adcf-d7fdee1f81f2",
                        "source_sense_description": "Dauerhaftigkeit eines Zustands",
                        "target_lang_word": "persistence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persistence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0dc80ac-9ffe-3f61-8338-bbb563d7b9ea",
                                        "entry_id": "2ce04a64-0b5c-36d8-98e1-f14257aabd4d",
                                        "glosses": [
                                            "The property of being persistent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e01c0134-8420-48c4-93bb-2891c496132b",
                                                "sense_id": "a0dc80ac-9ffe-3f61-8338-bbb563d7b9ea",
                                                "text": "You've got to admire her persistence. She's asked him out every day for a month even though she keeps turning him down."
                                            },
                                            {
                                                "example_id": "ce305bb9-14bb-42df-9c95-bb5f712dbf0f",
                                                "sense_id": "a0dc80ac-9ffe-3f61-8338-bbb563d7b9ea",
                                                "text": "The Thaumatrope was based on the persistence of vision. The disc of card was rotated so rapidly by means of threads attached to it that the eye saw both sides of the card simultaneously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfe1192f-4523-3655-aae6-6e5bfb3499f5",
                                        "entry_id": "2ce04a64-0b5c-36d8-98e1-f14257aabd4d",
                                        "glosses": [
                                            "Of data, the property of continuing to exist after the termination of the program."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd98977-491a-4232-84b2-e297c3b373a4",
                                                "sense_id": "cfe1192f-4523-3655-aae6-6e5bfb3499f5",
                                                "text": "Once written to a disk file, the data has persistence: it will still be there tomorrow when we run the next program."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a62cf30c-a829-3e10-9cff-e70c916a17ec",
                                        "entry_id": "2ce04a64-0b5c-36d8-98e1-f14257aabd4d",
                                        "glosses": [
                                            "Continuation of the previous day's weather (particularly temperature and precipitation statistics)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0e0d061-484b-306a-95d5-b474fd517988",
                                        "entry_id": "2ce04a64-0b5c-36d8-98e1-f14257aabd4d",
                                        "glosses": [
                                            "The number of times an operation can be iteratively applied to a number before it reaches a permanently constant state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caa17a98-c88d-451a-a7d4-7b181f03ccdb",
                                                "sense_id": "a0e0d061-484b-306a-95d5-b474fd517988",
                                                "text": "The persistence of the number 39 under the operation of multiplying the digits of the number is three, because 3x9 = 27, 2x7 = 14, and 1x4 = 4, and no further iterations will change the number again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a9ca340-608e-4f3d-9954-675871f17012",
                        "source_entry_id": "35377d80-c2fb-3dec-945f-e49299be250e",
                        "source_sense_id": "ed0bff7b-7975-37c9-adcf-d7fdee1f81f2",
                        "source_sense_description": "Dauerhaftigkeit eines Zustands",
                        "target_lang_word": "persistency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persistency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5db7368-988a-3581-bdd3-af5d30d35659",
                                        "entry_id": "ebbe012d-2bf1-36a4-893c-8a38eb86b07a",
                                        "glosses": [
                                            "The state or characteristic of being persistent."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeaa1b18-bfc7-4a2f-bff0-39308bf6562b",
                                                "sense_id": "c5db7368-988a-3581-bdd3-af5d30d35659",
                                                "text": "By this hand thou, thinkeſt me as farre in the diuels booke, as thou and Falſtaffe, for obduracie and perſiſtancie, let the end trie the man, [...]"
                                            },
                                            {
                                                "example_id": "5dca2948-0b37-4459-884d-9af34665de3a",
                                                "sense_id": "c5db7368-988a-3581-bdd3-af5d30d35659",
                                                "text": "On entering her room he had been struck by the absence of that saucy independence usually apparent in her bearing towards him, notwithstanding the persistency with which he had hovered near her for the previous month."
                                            },
                                            {
                                                "example_id": "00fb0440-a751-4b21-9555-f0fc8455a85f",
                                                "sense_id": "c5db7368-988a-3581-bdd3-af5d30d35659",
                                                "text": "However that may be, the hostility of the comic writers had evidently a general hostility behind it. Our tradition states this definitely and the persistency of the attacks proves it."
                                            },
                                            {
                                                "example_id": "5a9d11c3-3208-4826-9cd5-31e7c61468d2",
                                                "sense_id": "c5db7368-988a-3581-bdd3-af5d30d35659",
                                                "text": "\"I'm not into mood changes,\" he says. \"These ups and downs undermine consistency and persistency of purpose.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6931dd4-9f05-3424-b3e6-5d620944ffc3",
                                        "entry_id": "ebbe012d-2bf1-36a4-893c-8a38eb86b07a",
                                        "glosses": [
                                            "A measure of how much something persists."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f4f6559-abb5-4ed2-b59d-8774562127ef",
                                                "sense_id": "e6931dd4-9f05-3424-b3e6-5d620944ffc3",
                                                "text": "The table shows that three-year \"persistencies\" range from 89.6 per cent with Standard Life (this means only 10 per cent of plans have lapsed after three years) to 58.9 per cent with Sun Life (almost 40 per cent of plans lapse after three years)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
