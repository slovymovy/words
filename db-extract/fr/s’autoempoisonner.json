                ],
                "senses": [
                    {
                        "sense_id": "f050d22e-a574-3bd2-b842-3ead8b1d237d",
                        "entry_id": "d26ba85b-884d-368b-aca5-c0f944a0b655",
                        "glosses": [
                            "S’empoisonner soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39a12ee1-0d1f-4763-a97d-7ea443a3e537",
                                "sense_id": "f050d22e-a574-3bd2-b842-3ead8b1d237d",
                                "text": "Éviter ainsi de s'autoempoisonner avec l'urée que sa putréfaction génère."
                            },
                            {
                                "example_id": "6d7f8614-5809-4a52-b6b6-c376c3d6947a",
                                "sense_id": "f050d22e-a574-3bd2-b842-3ead8b1d237d",
                                "text": "Si le kyste est dû à une inflammation ou infection, il peut s'autoempoisonner et c'est pas mieux."
                            },
                            {
                                "example_id": "6bf0ac21-609e-48f3-9647-f38ebb156a85",
                                "sense_id": "f050d22e-a574-3bd2-b842-3ead8b1d237d",
                                "text": "Si une petite jeune résiste je vais pas m'autoempoisonner."
                            }
                        ]
                    }
