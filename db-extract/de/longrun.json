                "senses": [
                    {
                        "sense_id": "aa36d1e4-3eb1-3e44-8f62-5c13dce90acc",
                        "entry_id": "1eaecea8-df37-377e-bc1c-91d27b15212d",
                        "glosses": [
                            "langer Lauf, in der Regel über eine deutlich längere Distanz als die für die betreffende Person üblichen Laufstrecken"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "430af26d-24b9-4cb5-9ab1-df42b645a322",
                                "sense_id": "aa36d1e4-3eb1-3e44-8f62-5c13dce90acc",
                                "text": "„Aber das ist nicht alles, denn zu diesen Longruns setzt Greif eine Endbeschleunigung in der Marathonpace ein, die bei 3K beginnt und am Ende (also beim letzten 35er) satte 15K beträgt.“"
                            },
                            {
                                "example_id": "3a50db2b-0e0b-4444-8736-6dc7c71f44a5",
                                "sense_id": "aa36d1e4-3eb1-3e44-8f62-5c13dce90acc",
                                "text": "„Und obwohl ich wirklich im Arsch war – ganz anders als beim ersten Longrun des Jahres, bei dem ich nach 55 Kilometern noch topfit war – konnte, nein durfte das nicht sein.“"
                            },
                            {
                                "example_id": "cc42bf71-793f-4398-aa19-638e4943e50f",
                                "sense_id": "aa36d1e4-3eb1-3e44-8f62-5c13dce90acc",
                                "text": "„Doch ist sie eher die Jacke nach einem Longrun, oder eben für Wanderungen in sehr kalten Regionen oder an verdammt kalten Tagen.“"
                            },
                            {
                                "example_id": "6b330935-4180-4591-94c6-4a410cfd5211",
                                "sense_id": "aa36d1e4-3eb1-3e44-8f62-5c13dce90acc",
                                "text": "„Aber nach dem Longrun am Samstag und dem doch recht erholsamen Sonntag nutzte ich den freien Tag, um ein wenig Strecke in die Beine zu bekommen.“"
                            },
                            {
                                "example_id": "5f8d32d0-bd8e-4c90-86b3-afe662dc4103",
                                "sense_id": "aa36d1e4-3eb1-3e44-8f62-5c13dce90acc",
                                "text": "„Die Hose war nun ab drei Grad Celsius im Einsatz, bei kurzen schnellen Einheiten, langsamen Einheiten, Bergintervallen und einem Longrun und sie ist ein zuverlässiger Partner auf den Trails.“"
                            },
                            {
                                "example_id": "3fd81cd2-784e-4fdb-a2b7-c02defec0f31",
                                "sense_id": "aa36d1e4-3eb1-3e44-8f62-5c13dce90acc",
                                "text": "„Für mich eignet sich der Schuh besonders bei langsameren Läufen oder auch Longruns.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "00b13f87-e853-3b54-8ec0-67d1e4187a3c",
                        "entry_id": "1eaecea8-df37-377e-bc1c-91d27b15212d",
                        "glosses": [
                            "längere Fahrt, insbesondere im Training, um Rennbedingungen zu simulieren"
                        ],
                        "tags": [
                            "Motorsport"
                        ],
                        "examples": [
                            {
                                "example_id": "5926505f-4f73-4230-b4dd-75427adfd4e6",
                                "sense_id": "00b13f87-e853-3b54-8ec0-67d1e4187a3c",
                                "text": "„Im Moment ist unser Auto nicht gut genug und nicht konstant genug, besonders auf den Longruns.“"
                            },
                            {
                                "example_id": "ee1e30a4-6af1-4eeb-a8a3-bd8f50c2b9be",
                                "sense_id": "00b13f87-e853-3b54-8ec0-67d1e4187a3c",
                                "text": "„Von da an zeigte sich, dass der Mercedes im Longrun gegenüber der Konkurrenz keine Schnitte hatte.“"
                            },
                            {
                                "example_id": "12206f69-6e19-4538-9d6e-ff55c93434e2",
                                "sense_id": "00b13f87-e853-3b54-8ec0-67d1e4187a3c",
                                "text": "„Max Verstappen fährt Bestzeit, Lewis Hamilton legt beeindruckende Longruns hin, und Alexander Albon ist mit dem Williams die Überraschung des Tages“"
                            },
                            {
                                "example_id": "86c88246-6ea2-45dc-803d-cb5b6b18ba67",
                                "sense_id": "00b13f87-e853-3b54-8ec0-67d1e4187a3c",
                                "text": "„Denn Hamilton fuhr einen Longrun mit ein paar hohen 1:33er-Zeiten auf Soft und war damit im direkten Vergleich sogar schneller als Sainz' Longrun auf Soft.“"
                            },
                            {
                                "example_id": "5e03090a-b074-4994-bc55-3f4a90e69114",
                                "sense_id": "00b13f87-e853-3b54-8ec0-67d1e4187a3c",
                                "text": "„Es gab keine großen Unterschiede, aber wir sind keine guten Longruns mit viel Benzin gefahren, weil wir mit unseren Programmen viele andere Dinge erreichen wollten.“"
                            },
                            {
                                "example_id": "7ac46e9b-f75b-4fc4-a9d9-cae459afe41c",
                                "sense_id": "00b13f87-e853-3b54-8ec0-67d1e4187a3c",
                                "text": "„Max Verstappen konnte die Konkurrenz beim Formel-1-Freitagstraining in Monaco mit einem erstklassigen Longrun verblasen, die Qualifyingpace bleibt aber ungewiss.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
