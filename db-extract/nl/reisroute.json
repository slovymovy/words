                    {
                        "sense_id": "d0c5c442-dfd6-398f-a6dc-94aeaa44cdc3",
                        "entry_id": "984f15d9-c560-3f93-8167-8907e248ec4a",
                        "glosses": [
                            "beschrijving van de weg van een reis, de weg waarlangs men reist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "506f4870-9aad-41b3-98a1-c9299c2c0d11",
                                "sense_id": "d0c5c442-dfd6-398f-a6dc-94aeaa44cdc3",
                                "text": "De Passenger Name Records, die in het akkoord vijf jaar bewaard mogen worden, kunnen een volledige reisroute blootleggen, inzicht geven in reisgewoontes en relaties tussen twee of meer personen en inlichtingen verschaffen over de financiële situatie van passagiers, hun voedingsgewoonten of hun gezondheidstoestand, licht het hof zijn bezwaren toe."
                            },
                            {
                                "example_id": "c8978add-2ef7-4b5f-85ab-8e11d603a3e2",
                                "sense_id": "d0c5c442-dfd6-398f-a6dc-94aeaa44cdc3",
                                "text": "Met de veranderingen belooft NS kortere reistijden, meer treinen en meer rechtstreekse verbindingen. Vanmiddag om 12.00 uur gaat de nieuwe dienstregeling online, zodat reizigers kunnen zien wat er verandert op hun reisroute."
                            }
                        ]
                    }
