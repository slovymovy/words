                                "target_senses": [
                                    {
                                        "sense_id": "9d54c05d-1b92-3dfe-987b-c95a36caba21",
                                        "entry_id": "9aa111bf-587f-31af-8e02-bf8eccb7a077",
                                        "glosses": [
                                            "The outermost-but-one whorl of a flower, composed of petals, when it is not the same in appearance as the outermost whorl (the calyx); it usually comprises the petal, which may be fused."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7e10c2c-e2cf-47ba-8f2a-dda50bf764f9",
                                                "sense_id": "9d54c05d-1b92-3dfe-987b-c95a36caba21",
                                                "text": "Our wet fingers touched and we formed a circle like the corolla of a flower, floating into the silence of the desert dawn with the ancient sun on our bodies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
