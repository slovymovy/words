                "senses": [
                    {
                        "sense_id": "827ec3dc-05b8-3344-bf5b-a589daf8f976",
                        "entry_id": "11994f5a-a49c-380b-81cf-48c97b06d3ee",
                        "glosses": [
                            "aus den Werken des Fantasyautors und Philologen J. R. R. Tolkien bekannte Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50e34af6-01b8-4926-b416-e05ee60b6978",
                                "sense_id": "827ec3dc-05b8-3344-bf5b-a589daf8f976",
                                "text": "„Im Quenya und Sindarin dagegen kann man alltäglich gebräuchliche Sätze formulieren und auch das Übersetzen z.B. vom Deutschen ins Quenya bzw. Sindarin und umgekehrt ist in gewissem Umfang möglich.“"
                            },
                            {
                                "example_id": "467e6eef-dac4-4be1-8975-86f2fef56914",
                                "sense_id": "827ec3dc-05b8-3344-bf5b-a589daf8f976",
                                "text": "„Für manche Schüler dürfte das Elbische ohnehin einen eher praktischen Nutzen haben: „Einige von ihnen spielen sehr gern Rollenspiele“, so Zainab Thorp, „Sindarin zu können ist nützlich, um ihre Elben-Armeen zu kommandieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
