                "senses": [
                    {
                        "sense_id": "83eacfdf-177a-3187-b5de-0950c31569de",
                        "entry_id": "66600aef-6645-3941-9b0a-f3cfe263d2d4",
                        "glosses": [
                            "relativ flacher Kasten mit Fächern für Lettern eines Drucksatzes oder Buchstabenkärtchen als Lernbehelf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d9b7fd1-fd74-4c94-8b41-444b8668c957",
                                "sense_id": "83eacfdf-177a-3187-b5de-0950c31569de",
                                "text": "„Hier scheint der Setzer also in seinem Setzkasten schlicht haarscharf danebengegriffen zu haben.“"
                            },
                            {
                                "example_id": "c9d6f46b-b6b1-423c-9651-f5f5c2c4fb73",
                                "sense_id": "83eacfdf-177a-3187-b5de-0950c31569de",
                                "text": "„[Johann von Hermann] erfand 1835 den Setzkasten und weitere Lehrbehelfe.“"
                            },
                            {
                                "example_id": "17a4f6f9-4526-4c2a-8552-137f1f7ac87e",
                                "sense_id": "83eacfdf-177a-3187-b5de-0950c31569de",
                                "text": "„Wie zu erwarten, haben die Setzkästen im Bild seines Handbuchs keine Kästen für ! (anders als eigens für Sternzeichen geschnittene Typen, die in der Renaissance noch zum wesentlichen Bestand der Wissenschaften gehörten).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
