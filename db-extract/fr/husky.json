                "senses": [
                    {
                        "sense_id": "7b96ead4-a1dc-347f-a608-64077f976f44",
                        "entry_id": "1abe70c2-2f4d-37db-9d30-1efed2e7b258",
                        "glosses": [
                            "Une des races de chien de type spitz, à l’origine chiens de traîneau des Inuits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fead8ea-a768-4c14-81fd-5bca0fc875f9",
                                "sense_id": "7b96ead4-a1dc-347f-a608-64077f976f44",
                                "text": "Les huskies font partie du groupe 5 du classement des races de chien par la société centrale canine ou SCC."
                            },
                            {
                                "example_id": "4eea8738-cbe2-4432-8669-99fb8202dc29",
                                "sense_id": "7b96ead4-a1dc-347f-a608-64077f976f44",
                                "text": "Le soir venu, Perrault ramena encore un autre chien, un vieux husky, long, maigre, décharné, couvert de glorieuses cicatrices récoltées en maint combat, et possesseur d’un œil unique, mais cet œil brillait d’une telle vaillance qu’il inspirait aussitôt le respect."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72a66e97-45f2-4319-8680-5e1dcf43743f",
                        "source_entry_id": "1abe70c2-2f4d-37db-9d30-1efed2e7b258",
                        "source_sense_id": "7b96ead4-a1dc-347f-a608-64077f976f44",
                        "target_lang_word": "husky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "husky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2366aa08-41d0-3522-961d-024018c4a462",
                                        "entry_id": "ad87cfbb-724a-31ec-a70c-6b389222449c",
                                        "glosses": [
                                            "Hoarse and rough-sounding; throaty."
                                        ],
                                        "tags": [
                                            "of a voice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17951e20-80b0-4abe-83ab-5d9064846236",
                                                "sense_id": "2366aa08-41d0-3522-961d-024018c4a462",
                                                "text": "Mr. Hyde was pale and dwarfish, he gave an impression of deformity without any nameable malformation, he had a displeasing smile, he had borne himself to the lawyer with a sort of murderous mixture of timidity and boldness, and he spoke with a husky, whispering and somewhat broken voice; all these were points against him, but not all of these together could explain the hitherto unknown disgust, loathing and fear with which Mr. Utterson regarded him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c293d73b-eb54-325c-9e47-181c013c8e1e",
                                        "entry_id": "ad87cfbb-724a-31ec-a70c-6b389222449c",
                                        "glosses": [
                                            "Burly, stout; sometimes as a modifier for boys' clothing sizes that fit a large waist or chest."
                                        ],
                                        "tags": [
                                            "US",
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5edcc5d1-755c-4a9c-b302-5c97aec2c95c",
                                                "sense_id": "c293d73b-eb54-325c-9e47-181c013c8e1e",
                                                "text": "You look like a good, husky man to pitch in the barnyard […]"
                                            },
                                            {
                                                "example_id": "9de1cfa0-4815-4176-9e7d-1c0d00818d53",
                                                "sense_id": "c293d73b-eb54-325c-9e47-181c013c8e1e",
                                                "text": "Word got around quickly that this plane, which has been flying since January, is bigger and huskier than our proposed C-5A […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1113eef6-fbd5-3c46-9d5d-8244d9c5fab4",
                                        "entry_id": "ad87cfbb-724a-31ec-a70c-6b389222449c",
                                        "glosses": [
                                            "Abounding with husks; consisting of husks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a521071-4a3e-4645-a79d-f0aa47b6e40c",
                                                "sense_id": "1113eef6-fbd5-3c46-9d5d-8244d9c5fab4",
                                                "text": "Some swains have sown before: but most have found\nA husky harvest from the grudging ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "658a6a51-0eaa-3186-a029-6d559a5f93ff",
                                        "entry_id": "ad87cfbb-724a-31ec-a70c-6b389222449c",
                                        "glosses": [
                                            "Belligerent; hostile and uncooperative."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29295930-0ab7-4ab8-acd7-e61b4ceb7fe1",
                                                "sense_id": "658a6a51-0eaa-3186-a029-6d559a5f93ff",
                                                "text": "“Well, here it is,” said Silver. “We want that treasure, and we’ll have it — that’s our point! You would just as soon save your lives, I reckon; and that’s yours. You have a chart, haven’t you?”\n“That’s as may be,” replied the captain.\n“Oh, well, you have, I know that,” returned Long John. “You needn’t be so husky with a man; there ain’t a particle of service in that, and you may lay to it. What I mean is, we want your chart. Now, I never meant you no harm, myself.”"
                                            }
                                        ]
                                    }
                                ]
                            },
