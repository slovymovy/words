                        "source_sense_id": "427cb88f-56bf-3315-aaf3-023a831fe917",
                        "source_sense_description": "fear or hatred of Islam or Muslims",
                        "target_lang_word": "Islamfeindlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Islamfeindlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a11b84a1-d967-370d-9b87-7e2c3bcbdd1d",
                                        "entry_id": "6de8cce6-a5e0-3cd1-93f2-82f44e7458b6",
                                        "glosses": [
                                            "feindliche Haltung zum Islam, auch gegen dessen Anhängerschaft und seine Kultur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a2060e8-74c9-4a23-a96e-28e3ed23d847",
                                                "sense_id": "a11b84a1-d967-370d-9b87-7e2c3bcbdd1d",
                                                "text": "„Auch jenseits der rechtsextremistischen, vornehmlich auf Rassismus begründeten Islamfeindlichkeit gibt es Gruppierungen und Einzelpersonen, die Muslimen die im Grundgesetz verankerte Religionsfreiheit nicht zugestehen wollen.“"
                                            },
                                            {
                                                "example_id": "f04deba6-7f52-4afe-aa20-d4614e087bb9",
                                                "sense_id": "a11b84a1-d967-370d-9b87-7e2c3bcbdd1d",
                                                "text": "„Beispielsweise rekurrierte die historische Islamfeindlichkeit auf religiös begründete Weltbilder, während die moderne Form der Islamfeindlichkeit antiislamische Vorurteile und Feindbilder als Mechanismen der sozialen Ausgrenzung gegenüber den MigrantInnen [sic] nutzt, um insbesondere diejenigen, die bereits in der Mitte der Gesellschaft angekommen sind, an die randständigen Positionen innerhalb der Gesellschaft zu binden. War das historische Thema der Islamfeindlichkeit, den Fremden in der Fremde zu bekämpfen, ist das Thema der modernen Islamfeindlichkeit, den ‚Fremden‘ im Inneren zu bekämpfen.“"
                                            },
                                            {
                                                "example_id": "5505a4da-0a8e-4400-8a59-d0864c1a0ab2",
                                                "sense_id": "a11b84a1-d967-370d-9b87-7e2c3bcbdd1d",
                                                "text": "„Und die AfD ist sozusagen die Verkörperung dieser Islamfeindlichkeit und treibt sie auch noch mal voran.“"
                                            },
                                            {
                                                "example_id": "6f8f2d80-ff9c-4fc8-bb5e-59fa76481c80",
                                                "sense_id": "a11b84a1-d967-370d-9b87-7e2c3bcbdd1d",
                                                "text": "„Zu Beginn gilt es nachdrücklich zu unterstreichen, dass Muslim- und Islamfeindlichkeit keine rein aus dem Zeitgeist und der aktuellen Geschichte gewachsenen gruppenpsychologischen Phänomene sind, sondern dass es sich hierbei um eine Unterform gruppenbezogener Menschenfeindlichkeit handelt.“"
                                            },
                                            {
                                                "example_id": "218b95b8-cbb9-48cc-b76a-afe7e7ac3dc3",
                                                "sense_id": "a11b84a1-d967-370d-9b87-7e2c3bcbdd1d",
                                                "text": "„›Wenn wir also über Muslim- oder Islamfeindlichkeit sprechen, dürfen wir nicht vergessen, dass sie keine abstrakte Gruppe, sondern konkret unsere Kolleginnen, Nachbarn, Schulkameraden und Freundinnen trifft‹, so Faeser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
