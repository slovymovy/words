                        "entry_id": "b60668a8-f631-3024-8a95-97362b4c07fd",
                        "glosses": [
                            "An ongoing relationship between (usually two) rivals who compete for superiority."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7f20a866-438a-4fd9-ab30-353fc20da423",
                                "sense_id": "3137b23f-d895-3081-b499-a56e5d1eb469",
                                "text": "The Boston Bruins have a longstanding rivalry with the Montreal Canadiens."
                            },
                            {
                                "example_id": "0c564da6-fb01-4b34-b138-5c07225e9449",
                                "sense_id": "3137b23f-d895-3081-b499-a56e5d1eb469",
                                "text": "James and Polly have a bitter rivalry due to the latter's inclusion in the Tea Time Teaser."
                            }
                        ]
                    },
                    {
                        "sense_id": "afbe3e54-2a9a-3a4c-8093-0e7280c6ef2a",
                        "entry_id": "b60668a8-f631-3024-8a95-97362b4c07fd",
                        "glosses": [
                            "The characteristic of being a rivalrous good, such that it can be consumed or used by only one person at a time."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8375f248-3633-4e60-9ab9-12d577f975e5",
                                "sense_id": "afbe3e54-2a9a-3a4c-8093-0e7280c6ef2a",
                                "text": "Common goods are those which are rivalrous in consumption but non-excludable"
                            }
                        ]
                    },
                    {
                        "sense_id": "a494a167-4104-3717-8eec-c2ee1201c8af",
                        "entry_id": "b60668a8-f631-3024-8a95-97362b4c07fd",
                        "glosses": [
                            "Any competition between two or more things or factors."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fee7c768-4c36-419a-911a-115fc2c4dd27",
                                "sense_id": "a494a167-4104-3717-8eec-c2ee1201c8af",
                                "text": "Binocular rivalry is a visual phenomenon in which perception alternates between different images presented to each eye."
                            }
                        ]
                    }
