                    }
                ],
                "translations": [
                    {
                        "translation_id": "56ddf7f0-0628-4574-b8d3-b8bace00717c",
                        "source_entry_id": "8d34df65-b193-30c8-a902-28f8596d8939",
                        "source_sense_description": "отчётливо",
                        "target_lang_word": "distinctly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distinctly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                        "entry_id": "1f7f69ac-9ac5-3c15-9fe6-5b93d07b8175",
                                        "glosses": [
                                            "In a distinct manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b7c8ad-6f9a-4d63-93e4-423615b8f2d5",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "I distinctly remember the voice of my deceased grandmother."
                                            },
                                            {
                                                "example_id": "59ebcc5d-34fd-46d6-a259-95a81ece9046",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "About ten months ago a report reached my ears that a Dutchman had constructed a telescope, by the aid of which visible objects, although at a great distance from the eye of the observer, were seen distinctly as if near; […]"
                                            },
                                            {
                                                "example_id": "6b4671bb-65bf-4869-955d-5f8f218c0e36",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "Commander Birch was a trifle uneasy when he found there was more than a popple on the sea; it was, in fact, distinctly choppy."
                                            },
                                            {
                                                "example_id": "4e0abc77-efc2-4fce-8d94-fbe6beef251d",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "\"Aloud,\" he said distinctly, \"the Seven Words are spoken thus. Melenkurion abatha. Duroc minas mill. Harad khabaal.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b1910fc-43a0-4413-9d9e-34675a8990be",
                        "source_entry_id": "8d34df65-b193-30c8-a902-28f8596d8939",
                        "source_sense_description": "отчётливо",
                        "target_lang_word": "deutlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deutlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2837a437-6747-31c7-82f2-b54126d49227",
                                        "entry_id": "e05ee98e-1cea-3b26-9ce2-b23da691eb6e",
                                        "glosses": [
                                            "eindeutig erkennbar, wahrnehmbar durch die Sinne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58cf7198-6818-4905-8061-fe9737bbcc94",
                                                "sense_id": "2837a437-6747-31c7-82f2-b54126d49227",
                                                "text": "Zwischen den beiden Materialien war ein deutlicher Unterschied zu tasten"
                                            },
                                            {
                                                "example_id": "e5b9f4dc-c515-40dc-aea3-0a019c238ad1",
                                                "sense_id": "2837a437-6747-31c7-82f2-b54126d49227",
                                                "text": "Die Worte waren deutlich hinter der Tür vernehmbar."
                                            },
                                            {
                                                "example_id": "fdf99247-4bdb-4fa9-a578-4b920e76bd7e",
                                                "sense_id": "2837a437-6747-31c7-82f2-b54126d49227",
                                                "text": "Am Telephon: »Könnten sie deutlicher reden? Ich verstehe sie leider kaum.«"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                        "entry_id": "e05ee98e-1cea-3b26-9ce2-b23da691eb6e",
                                        "glosses": [
                                            "inhaltlich verständlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c277a7a2-9499-4c9b-84e9-c03b2789c1f6",
                                                "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                                "text": "Der Herr richtete deutliche Worte an den faulen Diener."
                                            },
                                            {
                                                "example_id": "18e1ebad-ef2c-4d93-a95b-a1b2a7e4b8ef",
                                                "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                                "text": "»Habe ich mich klar und deutlich ausgedrückt?«"
                                            },
                                            {
                                                "example_id": "65e5708b-6916-4eec-9c72-e79887a7c6fc",
                                                "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                                "text": "„Der Ruder-Weltmeister [Anmerkung: Torben Johannesen] findet deutliche Worte: »Die Idee zur Öffnung der Dove-Elbe ist ein absoluter Fehler«, sagt er.“"
                                            },
                                            {
                                                "example_id": "7f7927cb-5804-4afd-acbc-d7faa6787a5b",
                                                "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                                "text": "„Dieser Mangel steht in einem deutlichen Missverhältnis zu dem immer wieder von nationalen und europäischen Instanzen erklärten Einsatz für die europäische Sprachenvielfalt und die Mehrsprachigkeit der Europäer.“"
                                            },
                                            {
                                                "example_id": "fe31e5ed-5857-414f-9578-6a2642a84060",
                                                "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                                "text": "„Obergärige Hefen sind zwar empfindlicher als untergärige, aber mit ihnen verläuft die Gärung deutlich schneller und ohne moderne Kühltechnik.“"
                                            },
                                            {
                                                "example_id": "be346ed2-e357-42a6-a337-a836686ca6fa",
                                                "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                                "text": "„In Deutschland ist die Belastung mit Feinstaub sowohl im urbanen als auch im ländlichen Bereich deutlich zurückgegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05dae972-6a2e-4e24-b619-01293ffcd887",
                        "source_entry_id": "8d34df65-b193-30c8-a902-28f8596d8939",
                        "source_sense_description": "вразумительно, понятно",
                        "target_lang_word": "klar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5532fbd-e3d1-3e98-841f-571a91c65deb",
                                        "entry_id": "98cc1090-27e8-37e0-8b39-6875a091584a",
                                        "glosses": [
                                            "frei von Unreinheiten oder generell Störendem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff7bc19-fbb5-4eb9-8aaf-be3cb239fabc",
                                                "sense_id": "f5532fbd-e3d1-3e98-841f-571a91c65deb",
                                                "text": "Heute soll es klares Wetter geben."
                                            },
                                            {
                                                "example_id": "e077a3f4-6da0-4007-8a15-af2ed82202f4",
                                                "sense_id": "f5532fbd-e3d1-3e98-841f-571a91c65deb",
                                                "text": "Heute ist das Wasser ganz klar, man kann den Grund sehen."
                                            },
                                            {
                                                "example_id": "b3125141-da1f-4c2a-b0ee-1cc95ccfb159",
                                                "sense_id": "f5532fbd-e3d1-3e98-841f-571a91c65deb",
                                                "text": "Sie antwortete mit klarer Stimme."
                                            },
                                            {
                                                "example_id": "9e58f043-b3ae-491b-b7b2-4c6a218442e6",
                                                "sense_id": "f5532fbd-e3d1-3e98-841f-571a91c65deb",
                                                "text": "Dieses klare Rot gefällt mir besser als das abgetönte."
                                            },
                                            {
                                                "example_id": "7995ab28-f1a8-449c-8bd0-aac2c35d16a4",
                                                "sense_id": "f5532fbd-e3d1-3e98-841f-571a91c65deb",
                                                "text": "„In klaren Nächten kann man [die Raumstation ISS] von der Erde aus sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c18b3c7a-eaa4-3da6-89d0-a7c595eba47d",
                                        "entry_id": "98cc1090-27e8-37e0-8b39-6875a091584a",
                                        "glosses": [
                                            "leicht nachzuvollziehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b01647a3-ef74-400f-9d92-5d78213123ca",
                                                "sense_id": "c18b3c7a-eaa4-3da6-89d0-a7c595eba47d",
                                                "text": "Das Problem ist schon klar geworden."
                                            },
                                            {
                                                "example_id": "b1bf9404-ab03-43a4-8335-57e694d34ecc",
                                                "sense_id": "c18b3c7a-eaa4-3da6-89d0-a7c595eba47d",
                                                "text": "Es war eine sehr klare Botschaft, die da aus Rom kam."
                                            },
                                            {
                                                "example_id": "eb0ccd0b-4ab8-4f91-b361-e36ac237c1de",
                                                "sense_id": "c18b3c7a-eaa4-3da6-89d0-a7c595eba47d",
                                                "text": "Die Bundesregierung hat ihren Armuts- und Reichtumsbericht in einigen entscheidenden Passagen deutlich entschärft. Klare Aussagen, ob Menschen mit mehr Geld einen stärkeren Einfluss auf politische Entscheidungen haben als Einkommensschwache, sind in der überarbeiteten Fassung des Berichts gestrichen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a91dea14-dd2e-3e1f-a9f8-7c41a3fe1e59",
                                        "entry_id": "98cc1090-27e8-37e0-8b39-6875a091584a",
                                        "glosses": [
                                            "für etwas vorbereitet, bereit"
                                        ],
                                        "tags": [
                                            "Seemannssprache",
                                            "Fliegersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b71b6b3d-4e2f-492f-a4b5-8bcb72b6acae",
                                                "sense_id": "a91dea14-dd2e-3e1f-a9f8-7c41a3fe1e59",
                                                "text": "Das Beiboot ist klar zum Einsatz."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "klar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aed84400-52cf-3b34-957e-f4ef0d09a2ed",
                                        "entry_id": "6fedb33d-03c2-329f-b754-b99e9e69c0d5",
