                                        "examples": [
                                            {
                                                "example_id": "66314ad2-bb20-4f18-b237-10003e64925d",
                                                "sense_id": "a8456985-b6dd-33b1-95af-44bf595a2b10",
                                                "text": "This brought them to the fireside, where the easy-chair was drawn cosily up, and the tea things stood ready to the sitter’s elbow, the very sugar in the cup."
                                            },
                                            {
                                                "example_id": "7c77cd5b-464d-4d66-bb26-078112339553",
                                                "sense_id": "a8456985-b6dd-33b1-95af-44bf595a2b10",
                                                "text": "It's hard to put your hands into the pockets of a suit coat. Mine were tucked away cosily in the deep pockets of my zipped-up leather jacket."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
