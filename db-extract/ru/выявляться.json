                    {
                        "translation_id": "07449004-d930-4d74-9892-f245b8c13a96",
                        "source_entry_id": "228f61a2-42f6-3b71-bbe1-5a08387ef9f3",
                        "target_lang_word": "show up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "show up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4a8438c-73d9-35c1-bcdf-c15f12a2f059",
                                        "entry_id": "76b133dc-7483-3b2a-858c-85681cccd845",
                                        "glosses": [
                                            "To appear, arrive, or attend, especially suddenly or erratically."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8ee55dc-be51-4415-a2ee-00d932245647",
                                                "sense_id": "f4a8438c-73d9-35c1-bcdf-c15f12a2f059",
                                                "text": "Please come on time; don't just show up whenever you feel like it."
                                            },
                                            {
                                                "example_id": "e9f1a9ac-ce8b-4600-b0dc-5245e5a03ba5",
                                                "sense_id": "f4a8438c-73d9-35c1-bcdf-c15f12a2f059",
                                                "text": "No matter how many I throw away, more copies always show up."
                                            },
                                            {
                                                "example_id": "543e463f-19d8-4425-a95b-bd372ca88cdb",
                                                "sense_id": "f4a8438c-73d9-35c1-bcdf-c15f12a2f059",
                                                "text": "“We showed up. We showed up,” Mr. Biden said at a news conference at the United Nations summit on climate change, known as COP26, in Glasgow, Scotland. “The fact that China is trying to assert, understandably, a new role in the world as a world leader, not showing up? Huh. The single most important thing that’s gotten the attention of the world is climate.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17c42dcc-c0b0-35fd-8bb9-fbcaeb751b7f",
                                        "entry_id": "76b133dc-7483-3b2a-858c-85681cccd845",
                                        "glosses": [
                                            "To be easily visible; to be conspicuous."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53bc6477-7b24-4d1f-bd04-f781c7ff5cec",
                                                "sense_id": "17c42dcc-c0b0-35fd-8bb9-fbcaeb751b7f",
                                                "text": "Stains really show up on this white tablecloth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5362c29-a6c0-32d2-b0fa-2ba0f0a3fff9",
                                        "entry_id": "76b133dc-7483-3b2a-858c-85681cccd845",
                                        "glosses": [
                                            "To make visible; to expose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eae79f8e-de04-4c3c-9079-7025b52de91a",
                                                "sense_id": "e5362c29-a6c0-32d2-b0fa-2ba0f0a3fff9",
                                                "text": "This bright light shows up the dust in the corners of the room."
                                            },
                                            {
                                                "example_id": "00a0b8db-faf4-4d2a-81cf-c0d5c1f1bbf3",
                                                "sense_id": "e5362c29-a6c0-32d2-b0fa-2ba0f0a3fff9",
                                                "text": "I bet the Jayhawk fast break could show up the Nimrod's lack of speed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c564c04-8597-3d4d-aae5-5c02711ccb02",
                                        "entry_id": "76b133dc-7483-3b2a-858c-85681cccd845",
                                        "glosses": [
                                            "To make visible or expose faults and deficiencies in, usually by outdoing, outperforming, or outcompeting another."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23820a8a-4d0b-4085-8e84-ed3cce46085c",
                                                "sense_id": "0c564c04-8597-3d4d-aae5-5c02711ccb02",
                                                "text": "I finished in five minutes and she showed me up by finishing in three."
                                            },
                                            {
                                                "example_id": "658ef496-ca59-4797-92f3-89bfa59b66c2",
                                                "sense_id": "0c564c04-8597-3d4d-aae5-5c02711ccb02",
                                                "text": "His team were not outclassed but, once again, England have reminded us of their habit of being shown up as soon as they face half-decent opposition and one or two authentic category-A footballers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba0e3447-c78e-37b7-8746-506fc98d790c",
                                        "entry_id": "76b133dc-7483-3b2a-858c-85681cccd845",
                                        "glosses": [
                                            "To produce an impression on observers; to come off."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "527c982f-d32e-4642-9f8c-60ab2f8e79ab",
                                                "sense_id": "ba0e3447-c78e-37b7-8746-506fc98d790c",
                                                "text": "A pleasing countenance showing above a suit of clothes is attractive and makes the suit show up well, while a face with a blank expression is likely to make a man say to himself, \"Well if that man's clothes is going to make me look like that I don't want any of them.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f104553-45fe-4745-a2a5-41126e084bf4",
                        "source_entry_id": "228f61a2-42f6-3b71-bbe1-5a08387ef9f3",
                        "target_lang_word": "emerge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emerge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b42ff694-f231-34d1-a3cb-f7cfff07c94d",
                                        "entry_id": "66d53f1d-688f-371d-a501-2476a63193d6",
                                        "glosses": [
                                            "To come into view."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e3e3fcd-f30b-4317-bdc5-41dfdc7a0cfa",
                                                "sense_id": "b42ff694-f231-34d1-a3cb-f7cfff07c94d",
                                                "text": "There were many wooden chairs for the bulk of his visitors, and two wicker armchairs with red cloth cushions for superior people. From the packing-cases had emerged some Indian clubs,[…], and all these articles[…] made a scattered and untidy decoration that Mrs. Clough assiduously dusted and greatly cherished."
                                            },
                                            {
                                                "example_id": "8b134868-ca10-4ed3-a39f-ab4f6014aded",
                                                "sense_id": "b42ff694-f231-34d1-a3cb-f7cfff07c94d",
                                                "text": "The face which emerged was not reassuring. It was blunt and grey, the nose springing thick and flat from high on the frontal bone of the forehead, whilst his eyes were narrow slits of dark in a tight bandage of tissue. […]."
                                            },
                                            {
                                                "example_id": "91de0822-2bc8-4f79-9e9d-23bfb1a55be2",
                                                "sense_id": "b42ff694-f231-34d1-a3cb-f7cfff07c94d",
                                                "text": "Throughout the 1500s, the populace roiled over a constellation of grievances of which the forest emerged as a key focal point. The popular late Middle Ages fictional character Robin Hood, dressed in green to symbolize the forest, dodged fines for forest offenses and stole from the rich to give to the poor. But his appeal was painfully real and embodied the struggle over wood."
                                            },
                                            {
                                                "example_id": "d78821a2-127c-42cb-96dc-49881b7e844b",
                                                "sense_id": "b42ff694-f231-34d1-a3cb-f7cfff07c94d",
                                                "text": "With such focus from within the footballing community this week on Remembrance Sunday, there was something appropriate about Colchester being the venue for last night’s game. Troops from the garrison town formed a guard of honour for both sets of players, who emerged for the national anthem with poppies proudly stitched into their tracksuit jackets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0073dafe-4df9-3c64-a832-58a4cf62a05e",
                                        "entry_id": "66d53f1d-688f-371d-a501-2476a63193d6",
                                        "glosses": [
                                            "To come out of a situation, object, or a liquid."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "927b5446-d24e-48dd-8077-66c205122b83",
                                                "sense_id": "0073dafe-4df9-3c64-a832-58a4cf62a05e",
                                                "text": "The submarine emerged from the ocean."
                                            },
                                            {
                                                "example_id": "e540e91e-557f-463d-a2f8-776d52680908",
                                                "sense_id": "0073dafe-4df9-3c64-a832-58a4cf62a05e",
                                                "text": "He emerged unscathed from the accident."
                                            },
                                            {
                                                "example_id": "e6a71a95-1485-4ae6-a1bc-f2ea7eeef347",
                                                "sense_id": "0073dafe-4df9-3c64-a832-58a4cf62a05e",
                                                "text": "The Soviet Union emerged from the ruins of an empire."
                                            },
                                            {
                                                "example_id": "1ccf6797-5467-499f-8458-070102a4a269",
                                                "sense_id": "0073dafe-4df9-3c64-a832-58a4cf62a05e",
                                                "text": "Last spring, the periodical cicadas emerged across eastern North America. Their vast numbers and short above-ground life spans inspired awe and irritation in humans—and made for good meals for birds and small mammals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18b4f08f-8843-36a1-b47e-eeca7ebf11d2",
                                        "entry_id": "66d53f1d-688f-371d-a501-2476a63193d6",
                                        "glosses": [
                                            "To become known."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68285672-909d-41be-8412-e44fede8c483",
                                                "sense_id": "18b4f08f-8843-36a1-b47e-eeca7ebf11d2",
                                                "text": "Gradually the truth emerged."
                                            },
                                            {
                                                "example_id": "e442eb53-ba9f-40d2-83b4-1566c27be11f",
                                                "sense_id": "18b4f08f-8843-36a1-b47e-eeca7ebf11d2",
                                                "text": "The [Isaac] Newton that emerges from the [unpublished] manuscripts is far from the popular image of a rational practitioner of cold and pure reason. The architect of modern science was himself not very modern. He was obsessed with alchemy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "emerge",
                                "target_lang_code": "en",
                                "target_senses": [
