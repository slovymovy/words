                    {
                        "translation_id": "2cc5fb1b-d45e-40c7-bf7e-5a4947320cb8",
                        "source_entry_id": "a413234b-82e3-39a7-8d38-88cd5f403538",
                        "source_sense_description": "de hoofdstad van Griekenland",
                        "target_lang_word": "Athènes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Athènes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0806fbb-575e-3c6c-a9d0-291729640c6f",
                                        "entry_id": "03231a9f-d7f1-37a8-b1ca-6d638e16a0d7",
                                        "glosses": [
                                            "Ville principale et capitale de la Grèce moderne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e30d507-a816-4ce9-bb50-168662cb25a2",
                                                "sense_id": "b0806fbb-575e-3c6c-a9d0-291729640c6f",
                                                "text": "La Lune était au plus proche de la Terre dans la nuit de jeudi à vendredi et de cette statue de Poséidon érigée près d’Athènes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4975ca4-a1bb-34f1-8ad3-b009b23835d7",
                                        "entry_id": "03231a9f-d7f1-37a8-b1ca-6d638e16a0d7",
                                        "glosses": [
                                            "Le gouvernement grec."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "859cb5c9-4fa3-4973-a074-cc1ee928b7f8",
                                                "sense_id": "e4975ca4-a1bb-34f1-8ad3-b009b23835d7",
                                                "text": "Tous deux membres de l’OTAN, Athènes et Ankara entretiennent des relations tendues, notamment autour de la délimitation des eaux qui séparent les deux voisins en Méditerranée orientale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3173982c-f6bc-3064-bc40-baaf60a58424",
                                        "entry_id": "03231a9f-d7f1-37a8-b1ca-6d638e16a0d7",
                                        "glosses": [
                                            "Une des trois principales cités de la Grèce antique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c22765bb-4cb1-484a-bfbc-abc444fc535e",
                                                "sense_id": "3173982c-f6bc-3064-bc40-baaf60a58424",
                                                "text": "Hippocrate sauva Athènes de la peste en brûlant dans les rues des bois aromatiques et en faisant suspendre partout des paquets de fleurs parfumées."
                                            },
                                            {
                                                "example_id": "b3c3e5e0-fcd2-4af3-9a12-e92e5ca8caf1",
                                                "sense_id": "3173982c-f6bc-3064-bc40-baaf60a58424",
                                                "text": "Si les thètes sont citoyens d’Athènes, c’est parce que leurs parents étaient citoyens d’Athènes et ainsi de suite comme cela jusqu’à… Érichthonios."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
