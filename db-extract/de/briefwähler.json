                        "glosses": [
                            "Wähler, der seine Stimme per Brief abgibt und nicht im Wahllokal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9da89056-e873-45a9-b25e-9a49f49ddc27",
                                "sense_id": "05b61323-ae59-3b33-9ae3-3b73c38e5c6d",
                                "text": "Sein Leben lang aus Noblesse Briefwähler gewesen, stürmte er nun das Wahllokal und fragte lauthals, wo man denn für die Zentrumspartei stimmen könne."
                            },
                            {
                                "example_id": "8776b99e-19c8-4a63-918d-e45b691b7268",
                                "sense_id": "05b61323-ae59-3b33-9ae3-3b73c38e5c6d",
                                "text": "„Die Briefwähler stimmten in teils weit größerem Ausmaß als im Mai für Van der Bellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
