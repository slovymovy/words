                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daimyo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47c410b5-38a6-39c5-b014-2c3bdf4d7fb9",
                                        "entry_id": "aef99b44-6395-37f5-9949-dfa22aee74b6",
                                        "glosses": [
                                            "Variante orthographique de daïmio."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a46dbd2e-126e-43a3-a5d8-56c86f065266",
                                                "sense_id": "47c410b5-38a6-39c5-b014-2c3bdf4d7fb9",
                                                "text": "Au dix-septième siècle, les Tokugawa avaient instauré un système de « résidence alternée » obligeant les daimyo à vivre un an sur deux à Edo, où ils laissaient femmes et enfants en otage."
                                            },
                                            {
                                                "example_id": "5ee68cfd-e27b-439d-baf5-f848f7935b47",
                                                "sense_id": "47c410b5-38a6-39c5-b014-2c3bdf4d7fb9",
                                                "text": "Pour un daimyo, se constituer un fief important signifiait soumettre le maximum de villages afin de pouvoir racoler le plus grand nombre possible d’hommes et lever la plus grande quantité possible de riz dans le but d’entretenir son armée."
                                            }
                                        ]
                                    }
                                ]
                            }
