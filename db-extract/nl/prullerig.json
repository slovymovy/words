                                "target_senses": [
                                    {
                                        "sense_id": "b576619e-efdf-3292-be19-fe58fe325d85",
                                        "entry_id": "d3b0d014-75fc-32d5-aa66-c2af03197d39",
                                        "glosses": [
                                            "Low or reduced in price."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbb92580-c527-4ce9-b3a4-81db8b59d540",
                                                "sense_id": "b576619e-efdf-3292-be19-fe58fe325d85",
                                                "text": "Where there are many sellers and few purchases, land will be cheap."
                                            },
                                            {
                                                "example_id": "418e5cef-7c09-47bc-9900-4c65e7caac9f",
                                                "sense_id": "b576619e-efdf-3292-be19-fe58fe325d85",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            },
                                            {
                                                "example_id": "dfc14d42-fe9a-4907-add4-3b50224776f6",
                                                "sense_id": "b576619e-efdf-3292-be19-fe58fe325d85",
                                                "text": "Datacasting bypasses the wired, terrestrial Internet and is a cheaper way to distribute software than pressing and mailing CDs."
                                            },
                                            {
                                                "example_id": "a48b2666-4e5e-47c4-b545-2eaab0f7f0c4",
                                                "sense_id": "b576619e-efdf-3292-be19-fe58fe325d85",
                                                "text": "The cheapest antiager around: a good moisturizer."
                                            },
                                            {
                                                "example_id": "60a494b7-ac0d-4bdc-a91a-eb4932a954b7",
                                                "sense_id": "b576619e-efdf-3292-be19-fe58fe325d85",
                                                "text": "[Rural solar plant] schemes are of little help to industry or other heavy users of electricity. Nor is solar power yet as cheap as the grid. For all that, the rapid arrival of electric light to Indian villages is long overdue. When the national grid suffers its next huge outage, as it did in July 2012 when hundreds of millions were left in the dark, look for specks of light in the villages."
                                            },
                                            {
                                                "example_id": "26410ce0-02fc-49b0-b4f6-47e0f0efc00b",
                                                "sense_id": "b576619e-efdf-3292-be19-fe58fe325d85",
                                                "text": "McDonald’s has been vocal about adding more chicken to its menu, which is generally cheaper than beef."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4d8b041-4ac5-3351-9f5d-dd576cf6a463",
                                        "entry_id": "d3b0d014-75fc-32d5-aa66-c2af03197d39",
                                        "glosses": [
                                            "Of poor quality."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b09497e-c432-36e0-82ee-3b94f88a470c",
                                        "entry_id": "d3b0d014-75fc-32d5-aa66-c2af03197d39",
                                        "glosses": [
                                            "Of little worth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03274156-6691-4970-82cc-c61dcef1b8d4",
                                                "sense_id": "1b09497e-c432-36e0-82ee-3b94f88a470c",
                                                "text": "You grow cheap in every subject's eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eda27375-87d5-3475-b167-db2a6c9d777c",
                                        "entry_id": "d3b0d014-75fc-32d5-aa66-c2af03197d39",
                                        "glosses": [
                                            "Underhanded or unfair."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "048a6e65-eac0-4342-8503-c511cf5d38fe",
                                                "sense_id": "eda27375-87d5-3475-b167-db2a6c9d777c",
                                                "text": "the cheap trick of hiding deadly lava under pushable blocks"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6c6dfc3-62a9-3a15-8944-8aecae323da3",
                                        "entry_id": "d3b0d014-75fc-32d5-aa66-c2af03197d39",
                                        "glosses": [
                                            "Stingy; mean; excessively frugal."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "469b187c-ef94-45e6-b71e-486543b5cf29",
                                                "sense_id": "a6c6dfc3-62a9-3a15-8944-8aecae323da3",
                                                "text": "Insurance is expensive, but don't be so cheap that you risk losing your home because of a fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "567a7615-8302-3202-8b2e-facbb1b5b7f6",
                                        "entry_id": "d3b0d014-75fc-32d5-aa66-c2af03197d39",
                                        "glosses": [
                                            "Trading at a price level which is low relative to historical trends, a similar asset, or (for derivatives) a theoretical value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85367881-5c04-4186-8af2-320f36a4f56e",
                                                "sense_id": "567a7615-8302-3202-8b2e-facbb1b5b7f6",
                                                "text": "The ETF is trading cheap to NAV right now; we can arb this by buying the ETF and selling the underlying constituents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77eef46d-efb1-387f-b00e-b0e36b52d2c5",
                                        "entry_id": "d3b0d014-75fc-32d5-aa66-c2af03197d39",
                                        "glosses": [
                                            "Taking little of system time or resources."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0def4038-7d5d-429f-a0fb-ce81207b28a3",
