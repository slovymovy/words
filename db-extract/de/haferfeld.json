                "senses": [
                    {
                        "sense_id": "8fd1e421-60da-32c0-ac63-a2716bb5990e",
                        "entry_id": "e226d2a6-2145-36da-9ccb-556c4e4a9763",
                        "glosses": [
                            "ein Feld, auf dem Hafer angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b93ef777-6527-4657-84f1-c1a101491e84",
                                "sense_id": "8fd1e421-60da-32c0-ac63-a2716bb5990e",
                                "text": "Das Haferfeld wird demnächst gemäht."
                            },
                            {
                                "example_id": "8938dc47-2149-4da5-a8a9-7bdb92186f19",
                                "sense_id": "8fd1e421-60da-32c0-ac63-a2716bb5990e",
                                "text": "„Den grössten und befremdendsten Eindruck hatte es ihm gemacht, dass er unweit von Smolensk Soldaten ein wundervolles Haferfeld abmähen sah, offenbar um den Hafer zu verfüttern, und dass mitten auf dem gleichen Felde Truppen lagerten; dieser Umstand gab Alpatytsch zu denken, aber, da er seine eigenen Sachen im Kopf haben musste, verlor er ihn bald wieder aus dem Gedächtnis.“"
                            },
                            {
                                "example_id": "07d2acbb-6897-4cdb-a984-f8e1cadbd7e0",
                                "sense_id": "8fd1e421-60da-32c0-ac63-a2716bb5990e",
                                "text": "„Der Vagabund stürzte den Inhalt durstig herunter, dann verschwand er gestikulierend in den Haferfeldern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
