                "senses": [
                    {
                        "sense_id": "b79a6781-23d1-3c88-9398-182ff38df5e8",
                        "entry_id": "38c21463-e37b-3d45-8717-7319c3503750",
                        "glosses": [
                            "Donner à (quelque chose) un calibre supérieur à ce qui est normalement nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59df7d78-b44a-4779-abf8-5343defb2eac",
                                "sense_id": "b79a6781-23d1-3c88-9398-182ff38df5e8",
                                "text": "On ne doit jamais sous-estimer la force érosive de l'eau et toujours surcalibrer ses ouvrages."
                            },
                            {
                                "example_id": "f7f620a3-e0cf-4908-b7a7-05e93ac1e348",
                                "sense_id": "b79a6781-23d1-3c88-9398-182ff38df5e8",
                                "text": "Pour tenir compte de la forme irrégulière des fruits, il faut surcalibrer légèrement pour garantir un calibre dominant."
                            }
                        ]
                    }
