                "senses": [
                    {
                        "sense_id": "1811d25c-fd72-3681-9d24-5df0495255ea",
                        "entry_id": "5d9d6345-a9d1-3800-8878-1b6819ab5fe1",
                        "glosses": [
                            "Ausdruck, Geste der Achtung (vor einer anderen Person)"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "8f2bbfc6-3add-4c05-9b28-f484f7add650",
                                "sense_id": "1811d25c-fd72-3681-9d24-5df0495255ea",
                                "text": "„Reisende haben bemerkt, daß die Sklaven sich gegen ihre türkischen Herren mit weit mehr Aisance betragen als nordische Hofleute gegen ihre Vorgesetzten; allein wenn man es genau betrachtet, so sind diese Achtungsbezeigungen eigentlich zugunsten der Untergebenen eingeführt, die dadurch ihren Obern immer erinnern, was er ihnen schuldig ist.“ (1805)"
                            },
                            {
                                "example_id": "26daf894-c71e-4afd-978d-3e7fc32bb083",
                                "sense_id": "1811d25c-fd72-3681-9d24-5df0495255ea",
                                "text": "„Vandryk empfängt ihn mit großer Ehrfurcht, die Familiarität und Freundschaft des Barons fast abwehrend, bis dieser seine Lobeserhebungen und Achtungsbezeigungen gegen Vandryk damit beschließt, daß er, obgleich er einer der reichsten und angesehensten Edelleute im Lande ist, für seinen Sohn um Vandryk’s Tochter anhält.“ (1830)"
                            },
                            {
                                "example_id": "ac5a8245-a8a7-4794-8f60-2710e8804f79",
                                "sense_id": "1811d25c-fd72-3681-9d24-5df0495255ea",
                                "text": "„Der Bückling ist nichts als ein entschuldbarer Fauxpas, der einem Polizei-Offizier bei der Achtungsbezeigung einem Zivilisten gegenüber unterlaufen kann.“"
                            },
                            {
                                "example_id": "267dacfb-cfe0-4762-b2d2-c454d933c67a",
                                "sense_id": "1811d25c-fd72-3681-9d24-5df0495255ea",
                                "text": "„Diese Freundschaft bestand durchaus, wenngleich sie sich in gegenseitigen Achtungsbezeigungen und artigen Komplimenten erschöpfte.“"
                            },
                            {
                                "example_id": "0794a32f-81ff-4df9-8913-34b919c1e0bd",
                                "sense_id": "1811d25c-fd72-3681-9d24-5df0495255ea",
                                "text": "„In den ersten Achtungsbezeigungen nach seinem Tode wurde Montgomery, als der bedeutendste britische General seit dem Napoleon-Bezwinger Wellington gewürdigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
