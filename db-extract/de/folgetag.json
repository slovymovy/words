                "senses": [
                    {
                        "sense_id": "e5f791ff-1f08-345a-91c3-e02589f772c1",
                        "entry_id": "eab3806c-61e8-31f3-bbfe-e4b7ffdcd2cb",
                        "glosses": [
                            "der nächste, folgende Tag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c13ad43-2962-4595-a680-9de540c11fd8",
                                "sense_id": "e5f791ff-1f08-345a-91c3-e02589f772c1",
                                "text": "Der Brief kann erst am Folgetag verschickt werden."
                            },
                            {
                                "example_id": "10fedf66-f837-4c79-abfa-6a0f372ac662",
                                "sense_id": "e5f791ff-1f08-345a-91c3-e02589f772c1",
                                "text": "„Es waren Gäste im Haus und die wollten bereits am Folgetag versorgt werden.“"
                            },
                            {
                                "example_id": "6002c47a-1cae-4a89-968d-3e9adde931b8",
                                "sense_id": "e5f791ff-1f08-345a-91c3-e02589f772c1",
                                "text": "„Der lächerlich geringfügige Vorfall wurde am Folgetag sogar im Polizeibericht der Zeitung erwähnt, was für allgemeine Belustigung über die neue Ordnungsgewalt in Frankfurt sorgte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b651bac4-15b3-4333-804f-f051e3e72fb1",
                        "source_entry_id": "eab3806c-61e8-31f3-bbfe-e4b7ffdcd2cb",
                        "source_sense_id": "e5f791ff-1f08-345a-91c3-e02589f772c1",
