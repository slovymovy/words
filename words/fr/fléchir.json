            "senses": [
                {
                    "sense_id": "a682c1fa-e6a5-3eac-8c03-1d1786bc6b6f",
                    "sense_definition": "Courber ou plier une chose ou une partie du corps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "courber",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur de gymnastique nous demande de <w>fléchir</w> les genoux avant de sauter."
                        },
                        {
                            "text": "Pour ramasser cette boîte lourde, pensez à <w>fléchir</w> les jambes afin de protéger votre dos."
                        }
                    ],
                    "synonyms": [
                        "courber",
                        "plier"
                    ],
                    "antonyms": [
                        "raidir",
                        "tendre"
                    ],
                    "common_phrases": [
                        "fléchir les genoux",
                        "fléchir les jambes"
                    ]
                },
                {
                    "sense_id": "41843523-ce17-3845-a898-1ce488c53f8b",
                    "sense_definition": "Se courber ou faiblir sous l'action d'un poids ou d'un effort mécanique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "courber",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous le poids de la neige accumulée, les branches de l'arbre commencent à <w>fléchir</w> dangereusement."
                        },
                        {
                            "text": "La vieille poutre en bois a fini par <w>fléchir</w> après des années de charge excessive."
                        }
                    ],
                    "synonyms": [
                        "plier",
                        "ployer"
                    ],
                    "antonyms": [
                        "résister"
                    ]
                },
                {
                    "sense_id": "10cea72d-e67a-348c-b1ad-dd80041e7af4",
                    "sense_definition": "Céder ou se soumettre à une force, une autorité ou une contrainte supérieure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ceder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peuple courageux a toujours refusé de <w>fléchir</w> sous le joug de l'oppression."
                        },
                        {
                            "text": "Malgré les pressions politiques répétées, le ministre ne compte pas <w>fléchir</w> devant ses détracteurs."
                        }
                    ],
                    "synonyms": [
                        "capituler",
                        "céder",
                        "plier"
                    ],
                    "antonyms": [
                        "résister"
                    ],
                    "common_phrases": [
                        "fléchir sous le joug"
                    ]
                },
                {
                    "sense_id": "8960f9f3-5065-33c5-bda4-24eed51498ba",
                    "sense_definition": "Toucher quelqu'un de pitié, l'amener à des sentiments plus doux ou bienveillants.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les larmes sincères de l'accusé ont fini par <w>fléchir</w> le juge le plus sévère."
                        },
                        {
                            "text": "Aucune supplication désespérée ne semblait capable de <w>fléchir</w> la colère de son maître."
                        }
                    ],
                    "synonyms": [
                        "adoucir",
                        "attendrir",
                        "émouvoir"
                    ],
                    "antonyms": [
                        "endurcir"
                    ]
                },
                {
                    "sense_id": "23360381-f3de-3e1a-8111-1a3b2535e9c0",
                    "sense_definition": "Cesser d'être rigide ou intransigeant ; céder sur ses positions ou faiblir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ceder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs heures de négociations intenses, le représentant syndical a enfin accepté de <w>fléchir</w>."
                        },
                        {
                            "text": "Sa détermination restait totale et il refusait catégoriquement de <w>fléchir</w> d'un seul pouce."
                        }
                    ],
                    "synonyms": [
                        "céder",
                        "faiblir",
                        "mollir"
                    ],
                    "antonyms": [
                        "persister",
                        "s'obstiner"
                    ]
                }
            ]
        }
