        "fr-extract.jsonl": [
            {
                "entry_id": "fbecc4d6-c670-35e2-97fd-568235aa8471",
                "word": "iels",
                "pos": "pron",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f05a2dce-42d3-40ef-9714-c748eb9e42da",
                        "entry_id": "fbecc4d6-c670-35e2-97fd-568235aa8471",
                        "tags": [
                            "singular"
                        ],
                        "form": "iel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "883147f6-8dc7-3192-87b3-ec6bf5d5448d",
                        "entry_id": "fbecc4d6-c670-35e2-97fd-568235aa8471",
                        "glosses": [
                            "Pronom clitique sujet de la troisième personne du pluriel non-genré, désignant un groupe de référents qui ne s’inscrivent pas dans un genre défini, ou dont le(s) genres ne sont pas connus ou qui sont non-binaires. Il est aussi utilisé pour désigner un ensemble de personnes de genres connus mais variés."
                        ],
                        "tags": [
                            "LGBTQ"
                        ],
                        "examples": [
                            {
                                "example_id": "a5b38054-8cde-4576-bbd8-f73be826936d",
                                "sense_id": "883147f6-8dc7-3192-87b3-ec6bf5d5448d",
                                "text": "La falaise de laquelle iels avaient sauté ressemblait à un mur de ténèbres, face à eux. Tout là-haut, iels perçurent les aboiements du chien, à travers le rugissement des flots."
                            },
                            {
                                "example_id": "bb29803a-d697-4a2d-8b64-be85eed6650e",
                                "sense_id": "883147f6-8dc7-3192-87b3-ec6bf5d5448d",
                                "text": "Beaucoup de psychiatres, agissant à la manière d’une élite bienveillante, n’ont pas alerté le public général parce qu’iels estimaient que la théorie du déséquilibre chimique était une fiction utile pour faire en sorte que leurs patient-e-s acceptent leur maladie mentale et prennent leurs médicaments."
                            },
                            {
                                "example_id": "d2cb7870-2db7-4379-aaa1-3078b219d420",
                                "sense_id": "883147f6-8dc7-3192-87b3-ec6bf5d5448d",
                                "text": "Plus de la moitié d’entre iels se définissent comme appartenant soit à la bourgeoisie (15 %), soit à la « petite bourgeoisie intellectuelle » (24 %), soit à la classe moyenne supérieure (21 %)."
                            },
                            {
                                "example_id": "3815d3e4-9447-46d8-83a4-f7c934c2f909",
                                "sense_id": "883147f6-8dc7-3192-87b3-ec6bf5d5448d",
                                "text": "Merci à Céline, Daniel, Élodie, Florian, François, Isabelle, Séverine et Thérèse pour leurs relectures attentives de ce texte et pour les questionnements qu’iels ont soulevés."
                            },
                            {
                                "example_id": "79a6e3c4-d1f8-46c5-82b8-d53a8b7b6658",
                                "sense_id": "883147f6-8dc7-3192-87b3-ec6bf5d5448d",
                                "text": "Dans cette mesure, plus que la place de l’embyphobie et des non-binaires dans la lutte contre le patriarcat, c’est la façon dont iels organisent cette lutte qui a toute son importance il me semble."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2c9833b-0ef5-4e39-83a8-b77399a38dce",
                        "source_entry_id": "fbecc4d6-c670-35e2-97fd-568235aa8471",
                        "source_sense_id": "883147f6-8dc7-3192-87b3-ec6bf5d5448d",
                        "source_sense_description": "Pronom neutre",
                        "target_lang_word": "they",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "they",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1be15bc-3df2-3378-8667-dd0b9cfed7a4",
                                        "entry_id": "f198480c-4883-3d9c-934a-5992f4807614",
                                        "glosses": [
                                            "A group of entities previously mentioned."
                                        ],
                                        "tags": [
                                            "nominative",
                                            "plural",
                                            "singular",
                                            "sometimes",
                                            "third-person",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e4c64fe-1ea1-4314-ba9c-6bc1784c4d1e",
                                                "sense_id": "c1be15bc-3df2-3378-8667-dd0b9cfed7a4",
                                                "text": "I have a car and a truck, but they are both broken."
                                            },
                                            {
                                                "example_id": "d0c7a17e-95b2-4e35-87f3-2992383fd9d2",
                                                "sense_id": "c1be15bc-3df2-3378-8667-dd0b9cfed7a4",
                                                "text": "Fred and Jane? They just arrived."
                                            },
                                            {
                                                "example_id": "61d1aa5f-759f-4e76-bdd3-bedbd3d98ef9",
                                                "sense_id": "c1be15bc-3df2-3378-8667-dd0b9cfed7a4",
                                                "text": "Dogs may bark if they want to be fed."
                                            },
                                            {
                                                "example_id": "92efc1cc-e7cd-47e7-b706-ea592a1579e2",
                                                "sense_id": "c1be15bc-3df2-3378-8667-dd0b9cfed7a4",
                                                "text": "Plants wilt if they are not watered."
                                            },
                                            {
                                                "example_id": "a135699a-1dfb-4539-ac64-71bcaf8d6f65",
                                                "sense_id": "c1be15bc-3df2-3378-8667-dd0b9cfed7a4",
                                                "text": "But this I say, brethren, the time is short: it remaineth, that both they that have wives be as though they had none; And they that weep, as though they wept not; And they that rejoice, as though they rejoiced not; And they that buy, as though they possessed not; And they that use this world, as not abusing it: for the fashion of this world passeth away"
                                            },
                                            {
                                                "example_id": "19ae9df7-3aaf-4fc8-b580-000659ae8bc4",
                                                "sense_id": "c1be15bc-3df2-3378-8667-dd0b9cfed7a4",
                                                "text": "[…]purſued his vnneighbourly purpoſe in ſuch ſort: that hee being the ſtronger perſwader, and ſhe (belike) too credulous in beleeuing or elſe ouer-feeble in reſiſting, from priuate imparlance, they fell to action; and continued their cloſe fight a long while together, vnſeene and vvithout ſuſpition, no doubt to their equall ioy and contentment."
                                            },
                                            {
                                                "example_id": "d0241881-2ace-4621-ae00-376db5c99d5e",
                                                "sense_id": "c1be15bc-3df2-3378-8667-dd0b9cfed7a4",
                                                "text": "There is no reason to be scared of iguanas. They do not attack humans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f873bbf-b953-3733-84fa-923a01193ea8",
                                        "entry_id": "f198480c-4883-3d9c-934a-5992f4807614",
                                        "glosses": [
                                            "A single person, previously mentioned, whose gender is unknown, irrelevant, or (since 20th c.) non-binary."
                                        ],
                                        "tags": [
                                            "nominative",
                                            "plural",
                                            "singular",
                                            "sometimes",
                                            "third-person",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "055efda4-b5ae-4194-84d5-3f30d3512121",
                                                "sense_id": "8f873bbf-b953-3733-84fa-923a01193ea8",
                                                "text": "Somebody requested a seat at Friday's performance but didn't say if they preferred the balcony or the floor."
                                            },
                                            {
                                                "example_id": "126b398e-4366-4733-bb3b-8c48632b92b3",
                                                "sense_id": "8f873bbf-b953-3733-84fa-923a01193ea8",
                                                "text": "If someone enters the restricted area, they are required to present identification."
                                            },
                                            {
                                                "example_id": "a68d2e83-4ff5-46b9-a7d6-bdc2295f3c0b",
                                                "sense_id": "8f873bbf-b953-3733-84fa-923a01193ea8",
                                                "text": "I asked my friend if they wanted to come, but they said no."
                                            },
                                            {
                                                "example_id": "16863317-afc4-4392-af0c-35c8cb69f206",
                                                "sense_id": "8f873bbf-b953-3733-84fa-923a01193ea8",
                                                "text": "One of the boys tripped over, and they hit their head on the door."
                                            },
                                            {
                                                "example_id": "e5fb7aa4-41ab-4566-84de-ed5cbfe51ac3",
                                                "sense_id": "8f873bbf-b953-3733-84fa-923a01193ea8",
                                                "text": "Then shalt thou bring forth that man, or that woman (which haue committed that wicked thing) vnto thy gates, euen that man, or that woman, and shalt stone them with stones till they die."
                                            },
                                            {
                                                "example_id": "f7b227b6-da0e-4079-8193-782b078b9533",
                                                "sense_id": "8f873bbf-b953-3733-84fa-923a01193ea8",
                                                "text": "Someone knocked into Harry as they hurried past him. It was Hermione."
                                            },
                                            {
                                                "example_id": "6372d52c-b339-4f44-be4a-3b855c8e8553",
                                                "sense_id": "8f873bbf-b953-3733-84fa-923a01193ea8",
                                                "text": "One thing a nominee earns is the right to pick the vice president that they think will best reflect their vision of the country, and I am just glad I will have nothing to do with it."
                                            },
                                            {
                                                "example_id": "eb04c8c1-a44e-4e4f-a82b-bdcb280b3816",
                                                "sense_id": "8f873bbf-b953-3733-84fa-923a01193ea8",
                                                "text": "The boycott, led by Elisha Lim, of a Toronto gay and lesbian newspaper after it refused to use their preferred pronoun [\"they\"], citing grammar considerations, inspired me."
                                            },
                                            {
                                                "example_id": "d8e290a9-3ba0-41c2-af97-230bd9825e2a",
                                                "sense_id": "8f873bbf-b953-3733-84fa-923a01193ea8",
                                                "text": "I'm angry that we're here again, that we have had to tell another mother that their child is dead."
                                            },
                                            {
                                                "example_id": "703bff2b-ca36-4cad-940f-8fd4df11d81e",
                                                "sense_id": "8f873bbf-b953-3733-84fa-923a01193ea8",
                                                "text": "Ever since El Martinez started asking to be called by the gender-neutral pronouns “they/them” in the ninth grade, they have fielded skepticism in a variety of forms and from a multitude of sources about what it means to identify as nonbinary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a60c777-9a92-3b12-9c0d-ff3a4c49c69a",
                                        "entry_id": "f198480c-4883-3d9c-934a-5992f4807614",
                                        "glosses": [
                                            "People; some people; people in general; someone, excluding the speaker."
                                        ],
                                        "tags": [
                                            "indefinite",
                                            "nominative",
                                            "plural",
                                            "pronoun",
                                            "singular",
                                            "sometimes",
                                            "third-person",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e4e5627-f628-4f61-8896-d3f00bde37dc",
                                                "sense_id": "9a60c777-9a92-3b12-9c0d-ff3a4c49c69a",
                                                "text": "They say it’s a good place to live."
                                            },
                                            {
                                                "example_id": "bf7f7b5d-b2b0-4bf2-9ba5-29b4012d9e2d",
                                                "sense_id": "9a60c777-9a92-3b12-9c0d-ff3a4c49c69a",
                                                "text": "They didn’t have computers in the old days."
                                            },
                                            {
                                                "example_id": "7b83d8eb-8ecb-47f6-967f-7f2b1564695e",
                                                "sense_id": "9a60c777-9a92-3b12-9c0d-ff3a4c49c69a",
                                                "text": "They don't make 'em like they used to."
                                            },
                                            {
                                                "example_id": "994a3624-ddfa-4c75-805b-d376ebde334a",
                                                "sense_id": "9a60c777-9a92-3b12-9c0d-ff3a4c49c69a",
                                                "text": "Always get a second source, they tell us in investigative lexicography;[…]"
                                            },
                                            {
                                                "example_id": "870256a6-5944-4b13-8c24-2a7825360ebb",
                                                "sense_id": "9a60c777-9a92-3b12-9c0d-ff3a4c49c69a",
                                                "text": "I am beautiful, no matter what they say"
                                            },
                                            {
                                                "example_id": "91009c0c-bc2a-45b2-b064-d780cd9e50b7",
                                                "sense_id": "9a60c777-9a92-3b12-9c0d-ff3a4c49c69a",
                                                "text": "Hurtling through the air that evening in seat 10C, I read the US House committee’s Max investigation, a disruptor of illusions. Like many fliers, I’d long ago made my bargain with risk. I’d taken comfort in statistics, summoned faith in the engineers and assembly workers, the pilots, the system. I’d shunted away the knowledge—paralyzing, if you let it in—that stepping on an airplane is an extraordinary act of trust. Deep in the report, I reached the part about a senior manager at Boeing’s factory in Renton, a guy named Ed Pierson, who seemingly knew what we all know when we soothe ourselves by thinking, They wouldn’t let it fly if it weren’t safe. We’re all relying on someone to be the “they.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66c58c32-ebcb-3620-af54-da1568f27e15",
                                        "entry_id": "f198480c-4883-3d9c-934a-5992f4807614",
                                        "glosses": [
                                            "The authorities, the (power) elites, the powers that be, the establishment, the man, the system: government, police, employers, etc."
                                        ],
                                        "tags": [
                                            "indefinite",
                                            "nominative",
                                            "plural",
                                            "pronoun",
                                            "singular",
                                            "sometimes",
                                            "third-person",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f33bbf75-4cb1-4e3b-8a49-ea0d507f4ba5",
                                                "sense_id": "66c58c32-ebcb-3620-af54-da1568f27e15",
                                                "text": "They'll tax us for the air we breathe next."
                                            },
                                            {
                                                "example_id": "d2f1154f-fa76-4e5c-a4f5-b6b4fc34418e",
                                                "sense_id": "66c58c32-ebcb-3620-af54-da1568f27e15",
                                                "text": "They should increase our wages."
                                            },
                                            {
                                                "example_id": "a6c83199-191d-48db-b77f-670311f3435b",
                                                "sense_id": "66c58c32-ebcb-3620-af54-da1568f27e15",
                                                "text": "Ha, you believe the moon is real? That's just what they want you to think."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29df2770-934b-3f10-beae-9d1a02d46038",
                                        "entry_id": "f198480c-4883-3d9c-934a-5992f4807614",
                                        "glosses": [
                                            "The opponents of the side which is keeping score."
                                        ],
                                        "tags": [
                                            "nominative",
                                            "plural",
                                            "singular",
                                            "sometimes",
                                            "third-person",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "they",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77e82452-cf91-31f5-8a6b-9b7109c2c562",
                                        "entry_id": "9134613b-e347-3f4b-bb37-1a70629b4e3c",
                                        "glosses": [
                                            "The, those."
                                        ],
                                        "tags": [
                                            "Southern-England",
                                            "dialectal",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a6bd030-5c68-4d81-ab33-e480acded26a",
                                                "sense_id": "77e82452-cf91-31f5-8a6b-9b7109c2c562",
                                                "text": "They rooks as you see … only coom a few year agoo."
                                            },
                                            {
                                                "example_id": "8cf7b8d1-c5e5-47b8-ad49-9f60a5a8f885",
                                                "sense_id": "77e82452-cf91-31f5-8a6b-9b7109c2c562",
                                                "text": "Darn'd if they Cockney Chaps can zee there worn't nort but lie in him."
                                            },
                                            {
                                                "example_id": "e6ad1775-a92f-49a1-9125-c339ae2e9e69",
                                                "sense_id": "77e82452-cf91-31f5-8a6b-9b7109c2c562",
                                                "text": "page 21: \"But you spile [spoil] they gals - they won't be for no good, they won't.\"\npage 30: \"'Twas all about they rewks [rooks],\" he sobbed.\npage 54: \"mucking the place up with they weeds\""
                                            },
                                            {
                                                "example_id": "d320ebd0-2f2f-43c8-b2ee-c49d2be92a6d",
                                                "sense_id": "77e82452-cf91-31f5-8a6b-9b7109c2c562",
                                                "text": "\"Bodies and souls,\" she cried, \"if I didn't reckon to have hidden they boots safe from un in the stick-rick.\" \"Off wi' they tight-wasted shoes o' yours, Martha.\""
                                            },
                                            {
                                                "example_id": "b0622061-b4fb-4dcc-84dc-2601eb2c6542",
                                                "sense_id": "77e82452-cf91-31f5-8a6b-9b7109c2c562",
                                                "text": "Forty quid a fuckin ticket. No shy they British Rail cunts, ah kin fuckin tell ye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0561834a-39d9-3021-83cc-450e61976ebd",
                                        "entry_id": "9134613b-e347-3f4b-bb37-1a70629b4e3c",
                                        "glosses": [
                                            "Their."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed77a3a2-44e7-43ed-8e31-f131aba4bcf0",
                                                "sense_id": "0561834a-39d9-3021-83cc-450e61976ebd",
                                                "text": "MARY ELLEN is a different case from the others. She has five children and, she claims: \"I don't know who they father is. I ain't never kept track. They is always another one. You know, I can catch me a guy[.]\""
                                            },
                                            {
                                                "example_id": "268c999a-feb0-4ee2-9e0e-026ca9c80b98",
                                                "sense_id": "0561834a-39d9-3021-83cc-450e61976ebd",
                                                "text": "It's a shame to see someone talk so bad about the gays and lesbians in prison. She is brainwash to the fact that she think every gay and lesbian in prison is guilty of they crimes."
                                            },
                                            {
                                                "example_id": "2a595830-8954-43b2-a74d-bfb40a2b696b",
                                                "sense_id": "0561834a-39d9-3021-83cc-450e61976ebd",
                                                "text": "But all they kids be listenin' to me religiously / So I'm signin' CDs while police fingerprint me"
                                            },
                                            {
                                                "example_id": "bfc3354a-4d2e-4c3c-8d1c-a622c346d11a",
                                                "sense_id": "0561834a-39d9-3021-83cc-450e61976ebd",
                                                "text": "I got bitches askin' me about the code for the Wi-Fi / So they can talk about they timeline / And show me pictures of they friends"
                                            },
                                            {
                                                "example_id": "f01a8f3a-9520-432d-9306-749a36f0e491",
                                                "sense_id": "0561834a-39d9-3021-83cc-450e61976ebd",
                                                "text": "He guessed one of the well-off people living in these houses must have took a shine to Cody and decided how he'd look good stuck up on they roof."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "they",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62ee2df1-78a0-3f43-ae04-935609dc3ce7",
                                        "entry_id": "b3112507-00c3-3619-a1bf-4f65651d318a",
                                        "glosses": [
                                            "To refer to (someone, sometimes especially someone who does not use gender-neutral pronouns) using they/them pronouns."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52fcbe04-ec09-4e57-a916-fdde4f93cb61",
                                                "sense_id": "62ee2df1-78a0-3f43-ae04-935609dc3ce7",
                                                "text": "I have a pin that says she/her, but I still get theyed all the time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "they",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19dac952-a80e-32e2-a744-183cb84fb4dc",
                                        "entry_id": "b174378c-40a8-31ab-a00c-73f0777c7065",
                                        "glosses": [
                                            "There (especially as an expletive subject of be)."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b896ac31-7ebe-4a61-b7f8-e1034dca1fb2",
                                                "sense_id": "19dac952-a80e-32e2-a744-183cb84fb4dc",
                                                "text": "They’s music in the twitter of the bluebird and the jay."
                                            },
                                            {
                                                "example_id": "24460078-df79-4785-8045-5c1d95317a14",
                                                "sense_id": "19dac952-a80e-32e2-a744-183cb84fb4dc",
                                                "text": "MARY ELLEN is a different case from the others. She has five children and, she claims: \"I don't know who they father is. I ain't never kept track. They is always another one. You know, I can catch me a guy[.]\""
                                            },
                                            {
                                                "example_id": "8b9e694c-936b-427d-972e-da4075b19669",
                                                "sense_id": "19dac952-a80e-32e2-a744-183cb84fb4dc",
                                                "text": "They ain’t nothin’ wrong with that."
                                            },
                                            {
                                                "example_id": "ad3faaa1-391c-45ad-ad4c-291a19f95381",
                                                "sense_id": "19dac952-a80e-32e2-a744-183cb84fb4dc",
                                                "text": "But they ain’t nothin’ in there you didn’t already have."
                                            },
                                            {
                                                "example_id": "2f82a369-f10d-4292-898d-0ae2bc74b61f",
                                                "sense_id": "19dac952-a80e-32e2-a744-183cb84fb4dc",
                                                "text": "Well, they’s a lot of ‘em didn’t survive, if you believe me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
