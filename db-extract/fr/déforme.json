            {
                "entry_id": "1d26acef-a3f9-3428-90c9-5020e09826a2",
                "word": "déforme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "557cbea2-dca0-40ea-ae53-02925b433047",
                        "entry_id": "1d26acef-a3f9-3428-90c9-5020e09826a2",
                        "tags": [
                            "plural"
                        ],
                        "form": "déformes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c763ea9a-d5ff-3970-88dd-d020fc15b17e",
                        "entry_id": "1d26acef-a3f9-3428-90c9-5020e09826a2",
                        "glosses": [
                            "Baisse de forme ou de moral."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "14ca1f2e-4e96-42ee-ac70-aa85675383f2",
                                "sense_id": "c763ea9a-d5ff-3970-88dd-d020fc15b17e",
                                "text": "Avec un peu de chance, il allait tomber pile, le mec Ralph, pour choper Lulu au bar du Monastère, à l’heure où la déforme des michetons libère les entraîneuses de leurs servitudes."
                            },
                            {
                                "example_id": "12bd0287-276b-4b9f-b10d-bb728d12488b",
                                "sense_id": "c763ea9a-d5ff-3970-88dd-d020fc15b17e",
                                "text": "Courbé en deux, je m’élance. Et là, mon pote : the tuile, my birthday ! La scoumoune ! Pour une déforme, c’est une vraie déforme !"
                            }
                        ]
                    },
                    {
                        "sense_id": "666926b9-92ad-31e4-a844-cde995bbc38d",
                        "entry_id": "1d26acef-a3f9-3428-90c9-5020e09826a2",
                        "glosses": [
                            "Opération qui consiste à donner au cuir des chaussures le fini définitif par lustrage (éventuellement à chaud), ponçage, teinte des talons, etc."
                        ],
                        "tags": [
                            "Travail du cuir"
                        ],
                        "examples": [
                            {
                                "example_id": "26ad4f70-5937-45c9-9e48-6768dc4af006",
                                "sense_id": "666926b9-92ad-31e4-a844-cde995bbc38d",
                                "text": "L'une des partie les plus importante de la fabrication des chaussures est ce qu'on appelle la déforme, c'est à dire l'opération par laquelle on donne à la chaussure, lorsqu'elle est montée, la forme et le fini."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc53b14c-4e29-3adb-878b-b0e8089157f5",
                        "entry_id": "1d26acef-a3f9-3428-90c9-5020e09826a2",
                        "glosses": [
                            "Produit utiliser pour teindre la tranche des cuirs de la semelle."
                        ],
                        "tags": [
                            "Travail du cuir",
                            "Cordonnerie"
                        ],
                        "examples": []
                    }
                ],
