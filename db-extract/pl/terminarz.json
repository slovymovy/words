                "translations": [
                    {
                        "translation_id": "9340f4ed-d79e-41a4-b65b-da1e60c35b34",
                        "source_entry_id": "4829ef24-6438-3098-bb5b-c464e1532a0f",
                        "source_sense_id": "69be3afd-0eb9-35d5-8944-f081f1b231dc",
                        "target_lang_word": "agenda",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agenda",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "36c2b580-5b65-39da-a178-0fad91096791",
                                        "entry_id": "e5439415-e50e-3825-803a-7fc313bb8d03",
                                        "glosses": [
                                            "een notitieboek waarin afspraken genoteerd worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecab422c-4082-4645-b172-e3e36f1b2ae9",
                                                "sense_id": "36c2b580-5b65-39da-a178-0fad91096791",
                                                "text": "Je moet nog een nieuwe agenda kopen."
                                            },
                                            {
                                                "example_id": "f10954fc-88a5-43fc-af7d-51c070c1ee34",
                                                "sense_id": "36c2b580-5b65-39da-a178-0fad91096791",
                                                "text": "Zijn naam staat in de agenda. In jouw handschrift."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29e75147-826a-3fdc-9dc7-f435c19a42a8",
                                        "entry_id": "e5439415-e50e-3825-803a-7fc313bb8d03",
                                        "glosses": [
                                            "een lijst van te bespreken punten op een vergadering"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0fcd66d-bcda-4a6b-a640-013a10557e02",
                                                "sense_id": "29e75147-826a-3fdc-9dc7-f435c19a42a8",
                                                "text": "We hebben vandaag een volle agenda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bec8b6f0-3167-3e93-8490-2491f3f45338",
                                        "entry_id": "e5439415-e50e-3825-803a-7fc313bb8d03",
                                        "glosses": [
                                            "lijst van verplichtingen in het algemeen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1758b204-a4a7-4e14-bde1-87fb6a5a207e",
                                                "sense_id": "bec8b6f0-3167-3e93-8490-2491f3f45338",
                                                "text": "Het alleen zijn maakte me juist wakker. Wellicht was ik door mijn drukke agenda thuis wat mat en ingeslapen geraakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79f875b2-9919-4f60-aba7-9187c02646f0",
                        "source_entry_id": "4829ef24-6438-3098-bb5b-c464e1532a0f",
                        "source_sense_id": "69be3afd-0eb9-35d5-8944-f081f1b231dc",
                        "target_lang_word": "Terminkalender",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terminkalender",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                                        "entry_id": "f74f5afa-ce07-3170-976b-becef524ffd3",
                                        "glosses": [
                                            "zeitlich gegliedertes Notizheft (Kalender), wo zu Daten (Terminen) Ereignisse und Planungen festgehalten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50a444d-bf73-46b7-9cfc-479b2e79492f",
                                                "sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                                                "text": "Manche Leute haben einen übervollen Terminkalender."
                                            },
                                            {
                                                "example_id": "364a6c19-51bb-433a-b6b2-ebb114ffd813",
                                                "sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                                                "text": "„Schon als Schülerin hatte ich einen Terminkalender und Stress.“"
                                            },
                                            {
                                                "example_id": "3e42112f-c75b-4df3-808d-5e6dbd958d86",
                                                "sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                                                "text": "„Sein Terminkalender ist rappelvoll.“"
                                            },
                                            {
                                                "example_id": "4d8f7455-de5c-479b-a5b8-28669212add7",
                                                "sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                                                "text": "„Es steht nicht zu vermuten, dass Cook bei einem so vollen Terminkalender noch viel Zeit fand, auszuschlafen, sich an Frau und Kindern zu erfreuen oder in aller Ruhe vor dem Kamin seines Hauses in Mile End zu sitzen.“"
                                            },
                                            {
                                                "example_id": "922d0b29-5f1e-4ab3-9669-52e206646f42",
                                                "sense_id": "2181c543-d108-3e15-9816-d18c33ba170f",
                                                "text": "„Gudrun hatte mir für die Zeit mit Torben einen detaillierten Terminkalender gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
