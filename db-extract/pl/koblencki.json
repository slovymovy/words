                                        "sense_id": "ac78618f-cf1f-34d5-870e-91be4248c71b",
                                        "entry_id": "1a900ef4-3400-3950-922d-cc8e7d2bb865",
                                        "glosses": [
                                            "Jemand, der in Koblenz am Rhein geboren ist"
