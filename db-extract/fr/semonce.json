                    {
                        "translation_id": "a1522431-c9a5-493e-8e25-e6d225e31105",
                        "source_entry_id": "e8bf2698-df20-357a-a6cf-b6480ce6627f",
                        "source_sense_id": "0e27aa79-6237-379d-af82-f833c99587d5",
