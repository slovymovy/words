                        {
                            "text": "The <w>bass</w> drum provides the steady rhythm for the marching band.",
                            "target_lang_translations": {
                                "ru": "<w>Бас</w>-барабан задает устойчивый ритм марширующему оркестру.",
                                "zh": "<w>低音</w>大鼓为行进乐队提供了稳定的节奏。"
                            }
