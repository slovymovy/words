                                                "example_id": "b00dec79-19d1-4a8d-b019-b2bbd0d792b5",
                                                "sense_id": "cc082d7c-1f36-38d8-acb1-81d6d712eee3",
                                                "text": "übertragen: „Das Epizentrum dieses Geräusches wanderte in meinem Schädel herum, wurde lauter und leiser.“"
