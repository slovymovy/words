                        ]
                    },
                    {
                        "translation_id": "431f587d-3b88-49f5-9ad5-ce6a3df09661",
                        "source_entry_id": "de1ccbc0-8fd8-3888-a817-aeedaa2df5ab",
                        "source_sense_id": "2e88c178-b25f-35ed-a16e-98e54d8e8c1b",
                        "target_lang_word": "stigmate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stigmate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9eadf49-5425-3494-b032-795352dff78e",
                                        "entry_id": "d9a2ccda-6dc6-3d88-a87a-631b1d6e78bd",
                                        "glosses": [
                                            "Extrémité supérieure d’un style d’un pistil d’une fleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f8a0f1-9bb9-4a2a-a58c-d56b730c0099",
                                                "sense_id": "b9eadf49-5425-3494-b032-795352dff78e",
                                                "text": "Le style est long car il est nécessaire de tenir haut le stigmate de façon à ce que les abeilles puissent s'y cogner. Cela oblige le tube pollinique à se lancer dans une odyssée difficile et cette épreuve permet à la plante de jauger ses prétendants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7368ed8-a1df-3d01-8d1e-cd720cb6a6ad",
                                        "entry_id": "d9a2ccda-6dc6-3d88-a87a-631b1d6e78bd",
                                        "glosses": [
                                            "Marque, cicatrice que laisse une plaie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc63b28b-1f0d-4c4a-890f-6ce888f767bc",
                                                "sense_id": "e7368ed8-a1df-3d01-8d1e-cd720cb6a6ad",
                                                "text": "Il vient d’avoir la petite vérole, il en a encore les stigmates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "067b957d-8d7e-3386-8e2b-de9b5978388d",
                                        "entry_id": "d9a2ccda-6dc6-3d88-a87a-631b1d6e78bd",
                                        "glosses": [
                                            "Les cinq plaies de Jésus-Christ, que, par mimétisme, certains saints auraient eues aux pieds, aux mains et au côté."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8d48fe4-6140-49b5-be0c-44fc50171951",
                                                "sense_id": "067b957d-8d7e-3386-8e2b-de9b5978388d",
                                                "text": "Elle finit par avouer, que, depuis bien des années, le Christ l’a marquée des stigmates de la Passion et elle confesse que ces plaies la brûlent, jours et nuits, ainsi que des fers rouges."
                                            },
                                            {
                                                "example_id": "e857f899-06d7-4262-8fff-481477993ea5",
                                                "sense_id": "067b957d-8d7e-3386-8e2b-de9b5978388d",
                                                "text": "Marthe Robin a été déclarée « vénérable » par l’Église catholique en 2014, et les visiteurs de sa maison, à Châteauneuf-de-Galaure, dans la Drôme, sont toujours invités à un moment de recueillement dans la chambre de cette « visionnaire » arborant des « stigmates », qui n’aurait cinquante ans durant rien mangé, à part l’hostie de la communion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ca5a8a6-dca6-3a97-97bd-1bf2da187e8f",
                                        "entry_id": "d9a2ccda-6dc6-3d88-a87a-631b1d6e78bd",
                                        "glosses": [
                                            "Marque d’infamie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cb6a1c2-c60e-4482-999d-78763c856050",
                                                "sense_id": "4ca5a8a6-dca6-3a97-97bd-1bf2da187e8f",
                                                "text": "Lorenzo. – Je croyais que la corruption était un stigmate, et que les monstres seuls le portaient au front."
                                            },
                                            {
                                                "example_id": "06b79f51-b72c-453b-8091-24f130e8a450",
                                                "sense_id": "4ca5a8a6-dca6-3a97-97bd-1bf2da187e8f",
                                                "text": "Les bouches naguère délicieuses et rouges, maintenant sèches et blanches, portaient les honteux stigmates de l’ivresse."
                                            },
                                            {
                                                "example_id": "43d2df2d-c20e-433e-8d04-e30036944778",
                                                "sense_id": "4ca5a8a6-dca6-3a97-97bd-1bf2da187e8f",
                                                "text": "Mais, terrible question ! les stigmates de « l’aventurier » ne resteront-ils pas empreints dans la chair de l’homme de gouvernement ?"
                                            },
                                            {
                                                "example_id": "c05c5e41-81be-401e-bc64-402e7baedd90",
                                                "sense_id": "4ca5a8a6-dca6-3a97-97bd-1bf2da187e8f",
                                                "text": "Dans le dernier épisode de son podcast « Archetypes », Meghan Markle a abordé un stigmate que les femmes connaissent : celui d’être traitées de folles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b2cd5e4-f2b6-3662-b9a1-c9accda67e12",
                                        "entry_id": "d9a2ccda-6dc6-3d88-a87a-631b1d6e78bd",
                                        "glosses": [
                                            "Orifice des trachées, organe respiratoire placé sur les côtés du corps des insectes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e295602-ef88-4624-8b00-1fba0aa449b5",
                                                "sense_id": "9b2cd5e4-f2b6-3662-b9a1-c9accda67e12",
                                                "text": "Des ostioles uniquement respiratoires, ou, suivant l’expression consacrée, des stigmates placés symétriquement le long des côtes du corps, inhalent l’air atmosphérique et le transmettent dans des canaux […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
