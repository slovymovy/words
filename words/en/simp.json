                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "modern internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который глупо переоценивает кого-то другого и подчиняется ему, независимо от пола"
