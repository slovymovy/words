                    {
                        "translation_id": "2c4c82b6-725f-4db6-95e8-8fef00aaf638",
                        "source_entry_id": "01cc82b7-874c-3285-a481-50afed46cc50",
                        "source_sense_id": "c25a3f40-28b3-3142-8399-ee5d796c5ba7",
                        "source_sense_description": "shelf",
                        "target_lang_word": "Kaminsims",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaminsims",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5772075f-876f-3395-b72b-000f8cb1ec8c",
                                        "entry_id": "04c23e19-8672-3438-8274-100a5b43dca1",
                                        "glosses": [
                                            "waagerechter, länglicher Wandvorsprung über einem Kamin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27db0a67-2ed1-485f-a04a-a2be78f06f1a",
                                                "sense_id": "5772075f-876f-3395-b72b-000f8cb1ec8c",
                                                "text": "„Er stand auf, nahm die Sanduhr vom Kaminsims, und drehte sie um.“"
                                            },
                                            {
                                                "example_id": "300c114c-0b7c-4f7a-8891-ae7aba370ab4",
                                                "sense_id": "5772075f-876f-3395-b72b-000f8cb1ec8c",
                                                "text": "„Die Urne bewahrte sie auf, stellte sie im Vorderzimmer auf den Kaminsims und füllte sie mit den langen Rispen des Strandhafers.“"
                                            },
                                            {
                                                "example_id": "b9aff487-2a47-4947-9f57-a7a06e8cf27b",
                                                "sense_id": "5772075f-876f-3395-b72b-000f8cb1ec8c",
                                                "text": "„Marie sprang herzu, ließ die halb Ohnmächtige in den Fauteuil nieder und griff nach dem Kölnischen Wasser, das auf dem Kaminsims stand.“"
                                            },
                                            {
                                                "example_id": "a703b7b6-ba99-45d6-94fa-c69b31946187",
                                                "sense_id": "5772075f-876f-3395-b72b-000f8cb1ec8c",
                                                "text": "„Eine Anubis-Statue aus schwarzem Holz auf dem Kaminsims hat mich auf diesen abschweifenden Gedanken gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "899ea5c8-1b3d-4029-b381-22fca66ff886",
                        "source_entry_id": "01cc82b7-874c-3285-a481-50afed46cc50",
                        "source_sense_id": "c25a3f40-28b3-3142-8399-ee5d796c5ba7",
                        "source_sense_description": "shelf",
                        "target_lang_word": "ками́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ками́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "268a3cd2-e7bc-3de5-9c64-47de969b6ad0",
                                        "entry_id": "55f3e5eb-bd1d-38f9-a6c0-fd1fa8008a41",
                                        "glosses": [
                                            "комнатная печь с широкой открытой топкой и прямым дымоходом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e396be84-bc5c-4578-9043-a80859a5b1d3",
                                                "sense_id": "268a3cd2-e7bc-3de5-9c64-47de969b6ad0",
                                                "text": "В простом кирпичном камине, который был устроен в матушкиной комнате, ярко горели дрова .."
                                            },
                                            {
                                                "example_id": "ba65cf6c-7164-4643-a4e2-6109f4e291b5",
                                                "sense_id": "268a3cd2-e7bc-3de5-9c64-47de969b6ad0",
                                                "text": "Я закрывал окна .. и спрашивал: не затопить ли камин? // — Нет, бог с ним. Мне не холодно, — говорила она, вяло улыбаясь .."
                                            },
                                            {
                                                "example_id": "c309a18b-67da-49dd-8e52-8fbd5feeef91",
                                                "sense_id": "268a3cd2-e7bc-3de5-9c64-47de969b6ad0",
                                                "text": "— Ну, ну, сиди, — проворчал царь в сторону Толстого и, сев перед камином, протянул к огню красные, в жилах, руки и огромные подошвы сапог."
                                            },
                                            {
                                                "example_id": "c9b78e2a-8207-4e80-8e03-09f603e3a8b7",
                                                "sense_id": "268a3cd2-e7bc-3de5-9c64-47de969b6ad0",
                                                "text": ".. в комнате y меня сумрачно и с утра топится камин."
                                            },
                                            {
                                                "example_id": "058fde78-988b-425c-9d20-5745bd2700f0",
                                                "sense_id": "268a3cd2-e7bc-3de5-9c64-47de969b6ad0",
                                                "text": "В камине очень весело горели дрова, и на огонь приятно было смотреть .."
                                            },
                                            {
                                                "example_id": "d3306463-c4c3-4066-a474-96a50e2c6669",
                                                "sense_id": "268a3cd2-e7bc-3de5-9c64-47de969b6ad0",
                                                "text": "Маршал, не спуская глаз с поленьев, пылавших в камине, не заметил, как в зал вошёл пожилой человек с худым, птичьим лицом. ❬…❭ Незнакомец подошёл к камину и начал греть озябшие руки."
                                            },
                                            {
                                                "example_id": "f8e024f5-07a7-404d-95a9-9aedf4074c03",
                                                "sense_id": "268a3cd2-e7bc-3de5-9c64-47de969b6ad0",
                                                "text": "Она быстро собрала дрова, но не дала их нести мне. Она сама отнесла их в мою комнату и разожгла камин. Она стала на колени перед камином и, низко наклонив голову, почти лёжа щекой на полу, раздувала слабый огонь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
