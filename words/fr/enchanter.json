    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "53d1a3fa-3b77-3892-b123-b4a55eb96b8e",
                    "sense_definition": "Remplir d'un vif plaisir, charmer agréablement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plaisir_admiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa voix magnifique a su <w>enchanter</w> le public dès les premières notes."
                        },
                        {
                            "text": "Cette nouvelle proposition pourrait bien <w>enchanter</w> tous les membres de l'équipe."
                        }
                    ],
                    "synonyms": [
                        "ravir"
                    ],
                    "common_phrases": [
                        "enchanter le public",
                        "enchanter la foule"
                    ]
                },
                {
                    "sense_id": "c5c2741f-2b50-345c-9e03-1dffc5a24ee1",
                    "sense_definition": "Soumettre à une action magique, ensorceler par des sortilèges.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce conte médiéval, la sorcière cherche à <w>enchanter</w> le prince pour régner sur le royaume."
                        },
                        {
                            "text": "Selon la légende, un puissant mage aurait réussi à <w>enchanter</w> cette forêt mystérieuse."
                        }
                    ],
                    "synonyms": [
                        "ensorceler"
                    ],
                    "common_phrases": [
                        "enchanter un lieu",
                        "enchanter une arme"
                    ]
                },
                {
                    "sense_id": "4c0bdd30-2113-35ae-9e37-b171f2012200",
                    "sense_definition": "Éprouver un vif plaisir, se réjouir profondément de quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plaisir_admiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous nous <w>enchantions</w> à l'idée de voyager ensemble à travers tout le pays."
                        },
                        {
                            "text": "Le voyageur solitaire aimait s'<w>enchanter</w> de la beauté sauvage des paysages traversés."
                        }
                    ]
                }
            ]
        }
    ]
