                "senses": [
                    {
                        "sense_id": "603722d7-b7f9-3c56-a8a4-3ad56df0e56c",
                        "entry_id": "a0bcbecb-5d84-374a-bcc9-49ee85dd3612",
                        "glosses": [
                            "een gebouw waarin men goederen kan opbergen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4baf0888-49cd-434d-ba7b-cd478fa5835d",
                                "sense_id": "603722d7-b7f9-3c56-a8a4-3ad56df0e56c",
                                "text": "Voor de opening hadden alle trucks van de brouwers het terrein reeds verlaten. Voorts zijn rugzakken sinds vorig jaar niet meer toegelaten. De bezoekers moeten die achterlaten op een bewaarplaats."
                            },
                            {
                                "example_id": "0a29f038-76a9-4d11-8039-06d85895cfef",
                                "sense_id": "603722d7-b7f9-3c56-a8a4-3ad56df0e56c",
                                "text": "De nieuwe stalling is, op zijn zachtst gezegd, nogal aanwezig. Het ontwerp van architect Paul van der Ree van Movares uit Utrecht ontstijgt het niveau van een simpele bewaarplaats voor fietsen en presenteert zich nadrukkelijk als een gebouw dat qua omvang zelfs het nabijgelegen NS-station naar de kroon steekt."
                            },
                            {
                                "example_id": "ba4decef-95b3-48a0-9060-f285ec027d49",
                                "sense_id": "603722d7-b7f9-3c56-a8a4-3ad56df0e56c",
                                "text": "Menigeen kent het beeld uit de film Indiana Jones and the Last Crusade uit 1989. Het leek regisseur Steven Spielberg de ideale setting voor de geheime tempel en bewaarplaats van de Heilige Graal."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6240ab4-825d-3a9e-a086-aeca2bc041a5",
                        "entry_id": "a0bcbecb-5d84-374a-bcc9-49ee85dd3612",
                        "glosses": [
                            "een gebouw of ruimte waarin men mensen kan opbergen"
                        ],
                        "tags": [],
                        "examples": []
                    }
