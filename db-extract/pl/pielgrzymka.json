                        "examples": [
                            {
                                "example_id": "1609ea40-07de-4c5f-82bd-78e1a1415709",
                                "sense_id": "7bab547f-daa8-31bc-b499-31ea18a5a360",
                                "text": "Postanowiłem odbyć pielgrzymkę do Lichenia w intencji zdrowia dziecka."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "448190d8-15bd-3b9d-befd-cf344924cb25",
                        "entry_id": "b3ec7ecd-3658-373b-b268-aceedadaa41d",
                        "glosses": [
                            "grupa wspólnie odbywająca pielgrzymkę (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4475c77c-f369-40fc-8d20-d79009926874",
                                "sense_id": "448190d8-15bd-3b9d-befd-cf344924cb25",
                                "text": "Jadąc do Częstochowy, spotkałem dwie pielgrzymki."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85cf06b5-dcfe-4ab8-9d81-2fd8edd31d2e",
                        "source_entry_id": "b3ec7ecd-3658-373b-b268-aceedadaa41d",
                        "source_sense_id": "7bab547f-daa8-31bc-b499-31ea18a5a360",
                        "target_lang_word": "pilgrimage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pilgrimage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19702e0a-5559-3e20-9f9d-41c1c0cbe2f5",
                                        "entry_id": "bd99ec6c-e756-3096-899e-09ca5c23db68",
                                        "glosses": [
                                            "A journey made to a sacred place, or a religious journey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc43764-20ff-408c-9cb8-700786370b93",
                                                "sense_id": "19702e0a-5559-3e20-9f9d-41c1c0cbe2f5",
                                                "text": "In the Muslim faith, the pilgrimage to Mecca is known as the Hajj."
                                            },
                                            {
                                                "example_id": "6c7727a7-aa31-4e48-abf1-1722e134fcac",
                                                "sense_id": "19702e0a-5559-3e20-9f9d-41c1c0cbe2f5",
                                                "text": "Rome, the mighty mother of the Christian faith, whose amphitheatres had been red with the blood of the saints, and where the pilgrimage and the miracle still testified to the truth."
                                            },
                                            {
                                                "example_id": "d4d388a0-8dcf-453b-8dfc-a0212ded1784",
                                                "sense_id": "19702e0a-5559-3e20-9f9d-41c1c0cbe2f5",
                                                "text": "It was like a weary pilgrimage amongst hints for nightmares."
                                            },
                                            {
                                                "example_id": "d729fe3e-8490-492c-917c-c686383ddc47",
                                                "sense_id": "19702e0a-5559-3e20-9f9d-41c1c0cbe2f5",
                                                "text": "Quarians are surgically fitted with their various immunity-boosted implants in preparation for leaving on Pilgrimage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9980d971-19b8-3e3f-8071-de4206fc3637",
                                        "entry_id": "bd99ec6c-e756-3096-899e-09ca5c23db68",
                                        "glosses": [
                                            "A visit to any site revered or associated with a meaningful event."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c59809c-12d3-41d5-9c5a-68f5cfc604a1",
                                                "sense_id": "9980d971-19b8-3e3f-8071-de4206fc3637",
                                                "text": "Each year we made a pilgrimage to New York City to visit the pub where we all first met."
                                            },
                                            {
                                                "example_id": "ba349d28-62ce-4f3b-80fe-fa609a862692",
                                                "sense_id": "9980d971-19b8-3e3f-8071-de4206fc3637",
                                                "text": "The Berghof, too, was largely reduced to ash, sparing it the indignity of the tour guides Hitler so dreaded, and leaving a place of pilgrimage for future generations of Hitler worshippers—exactly how Adolf Hitler would have wanted it."
                                            },
                                            {
                                                "example_id": "9804983e-f338-4363-9c60-2cb21b9391ce",
                                                "sense_id": "9980d971-19b8-3e3f-8071-de4206fc3637",
                                                "text": "For fans, the shows are a pilgrimage, and a rediscovery of the joys of mass gatherings."
                                            },
                                            {
                                                "example_id": "cf344cd1-6fbf-4ba4-8f47-2265ee90cfa3",
                                                "sense_id": "9980d971-19b8-3e3f-8071-de4206fc3637",
                                                "text": "Earlier this year, the resident was granted permission to install a gate to deter them from making what has become a sort of pilgrimage [Carrie Bradshaw's stoop]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pilgrimage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "670e8a7d-5f88-358d-873d-0ddfc317a28a",
                                        "entry_id": "eb8c179f-9e48-308d-aaa6-2598ecece135",
                                        "glosses": [
                                            "To go on a pilgrimage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a42af377-8511-43fb-8ef2-a70bdcbfc402",
                                                "sense_id": "670e8a7d-5f88-358d-873d-0ddfc317a28a",
                                                "text": "in descent, as now, he always had a holy sense of having pilgerimaged, of returning having seen behind a veil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cd30694-a41b-4421-b122-f5e67b61849f",
                        "source_entry_id": "b3ec7ecd-3658-373b-b268-aceedadaa41d",
