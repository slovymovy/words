                                "target_senses": [
                                    {
                                        "sense_id": "54a8d771-4f82-3fba-ab3c-e1f06abcb935",
                                        "entry_id": "4cd8a7e2-291b-3494-bf96-4a616ee8436b",
                                        "glosses": [
                                            "(Lavandula spp) Cualquiera de unas 30 especies de plantas herbáceas o subarbustivas de la familia de las lamiáceas, de hojas habituallmente dentadas, pilosas, con inflorescencias en verticilastro, y capullos de color morado o violeta. Nativas de Asia, se cultivan extensamente como ornamentales y aromáticas."
                                        ],
                                        "tags": [
                                            "Plantas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cd8d34c-a93b-47c3-ad58-0f5506d11c47",
                                                "sense_id": "54a8d771-4f82-3fba-ab3c-e1f06abcb935",
                                                "text": "Mi isla está a tres días de mar con viento propicio. Los más de sus campos son de lavanda. Lo que priva allí es el negocio de perfumista."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98844cb9-7e3c-39ac-a86b-a11063de9944",
                                        "entry_id": "4cd8a7e2-291b-3494-bf96-4a616ee8436b",
                                        "glosses": [
                                            "Perfume de olor a lavanda₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f58ad258-60bc-4f0e-9c3b-89cb39a6754c",
                                                "sense_id": "98844cb9-7e3c-39ac-a86b-a11063de9944",
                                                "text": "pero me inflaman los primorosos aplausos de tanto erudito barbilampiño, peinado, empolvado, adonizado, y lleno de aguas olorosas de lavanda, sanspareille, ámbar, jazmín, bergamota, y violeta."
                                            },
                                            {
                                                "example_id": "dc348b48-c724-41e7-98d8-3b74b8a92d08",
                                                "sense_id": "98844cb9-7e3c-39ac-a86b-a11063de9944",
                                                "text": "La colocó atónito en el diván, y trayendo de su cuarto de tocador un frasco de lavanda, se lo vertió entero por sienes y pulsos, rompiéndole al mismo tiempo los ojales de la bata, en la prisa con que quería aflojarle el corsé."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0df6589d-77d7-383b-a8c3-efc347592420",
                                        "entry_id": "4cd8a7e2-291b-3494-bf96-4a616ee8436b",
                                        "glosses": [
                                            "Color que recuerda al de las flores de la lavanda₁\\n:*\\nColor:\\n."
                                        ],
                                        "tags": [
                                            "adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b57e182-ae89-41a6-8f29-fdbd6fd60abe",
                                                "sense_id": "0df6589d-77d7-383b-a8c3-efc347592420",
                                                "text": "La variedad Belle de Telham, de color lavanda, es de flor muy hermosa y goza de justa fama."
                                            },
                                            {
                                                "example_id": "e13cec1a-2b69-40f8-908c-c9428580d1c8",
                                                "sense_id": "0df6589d-77d7-383b-a8c3-efc347592420",
                                                "text": "había que ser una mujer muy segura de su belleza y muy al día y muy orgullosa de ser una belleza moderna para aventurarse por las calles de La Habana con esos peinados, aunque hasta ahora el terreno de la aventura se redujera a las calles de El Vedado, a la Rampa solamente) y antes de proseguir el peinado, un bandeau de algún terciopelo ligeramente lavanda."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
