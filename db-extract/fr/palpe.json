        "fr-extract.jsonl": [
            {
                "entry_id": "eaf58e62-3b9c-3514-8e23-5b9446379683",
                "word": "palpe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b51c4838-14ee-45ae-bcbb-76bc6a3cfd5f",
                        "entry_id": "eaf58e62-3b9c-3514-8e23-5b9446379683",
                        "tags": [
                            "plural"
                        ],
                        "form": "palpes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b5cf097-f88f-356b-9065-dfd183252bea",
                        "entry_id": "eaf58e62-3b9c-3514-8e23-5b9446379683",
                        "glosses": [
                            "Appendice articulé et mobile, situé, en nombre pair, sur les parties latérales de la bouche des insectes, soit sur les mâchoires, soit sur la lèvre inférieure et qui leur sert à tenir les aliments pendant qu’ils les mâchent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db9ef266-6add-4fd4-b163-617e1887621c",
                                "sense_id": "3b5cf097-f88f-356b-9065-dfd183252bea",
                                "text": "Les maxillules sont pourvues d’un palpe maxillaire et d’endites masticateurs foliacés, les lacinies."
                            },
                            {
                                "example_id": "e7466008-b172-465e-8e74-db8eb4eddaac",
                                "sense_id": "3b5cf097-f88f-356b-9065-dfd183252bea",
                                "text": "Les maxilles comprennent les palpes maxillaires placés latéralement, souvent nuls, et les galeae formant la trompe ou glossothèque , de dimensions très variables ; elle peut atteindre ou dépasser les premiers segments abdominaux, […]."
                            },
                            {
                                "example_id": "12cc1086-b197-4476-8112-7ec05db3e097",
                                "sense_id": "3b5cf097-f88f-356b-9065-dfd183252bea",
                                "text": "Palpes maxillaires et palpes labiales d’un hanneton."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a61f711b-4d8d-4615-8150-2a74a13878bc",
                        "source_entry_id": "eaf58e62-3b9c-3514-8e23-5b9446379683",
                        "source_sense_id": "3b5cf097-f88f-356b-9065-dfd183252bea",
                        "target_lang_word": "pedipalp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pedipalp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "987775b6-75a3-363c-b2fb-2311103f2f99",
                                        "entry_id": "25948a0e-cf87-30c7-876f-2af91c3a5341",
                                        "glosses": [
                                            "Either of a second pair of appendages near the mouth of many arachnids, variously specialized as pincers, sensory or locomotory organs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4835f7b3-a1e7-4286-a95e-fc1f72b7f0aa",
                                                "sense_id": "987775b6-75a3-363c-b2fb-2311103f2f99",
                                                "text": "The defensive movements, on the other hand, involve the whole of the pedipalp being drawn in towards the midline."
                                            },
                                            {
                                                "example_id": "ae8ef268-d0c1-4a6d-b308-da41c7885458",
                                                "sense_id": "987775b6-75a3-363c-b2fb-2311103f2f99",
                                                "text": "The pedipalp trochanter has a prominent process on its inferior surface, separated by a large area not haired nor spinulated: it serves for the allodgement of the ventral spine of the pedipalp basitarsus when the tibia closes to the femur;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
