                ],
                "senses": [
                    {
                        "sense_id": "fc54fa66-f47e-3eb5-a6c2-273b03ac64b6",
                        "entry_id": "f9845cd9-85c0-32e8-800a-e202938e1634",
                        "glosses": [
                            "witzartige Erzählung, die mindestens ein Charakteristikum des klassischen Witzes (logischer Zusammenhang, Vorhandensein einer Pointe etc.) absichtlich missachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "338f21fd-eaac-4653-8e18-53115e948faa",
                                "sense_id": "fc54fa66-f47e-3eb5-a6c2-273b03ac64b6",
                                "text": "„Brüno ist so die filmische Entsprechung zu den unter Schulkindern kursierenden Antiwitzen. Er ist ein Antifilm.“"
                            },
                            {
                                "example_id": "d96a1e87-4fe3-43cd-9c51-051f12969ed1",
                                "sense_id": "fc54fa66-f47e-3eb5-a6c2-273b03ac64b6",
                                "text": "„Die zugehörige Gattung des Witzes wird im Volksmund „Antiwitz“ genannt. Er zeichnet sich dadurch aus, dass er keine Pointe hat.“"
                            },
                            {
                                "example_id": "f296be22-bcf7-45a1-bf3b-f9c871435e7e",
                                "sense_id": "fc54fa66-f47e-3eb5-a6c2-273b03ac64b6",
                                "text": "„Auf die Spitze getrieben wird dieses Prinzip im sog. Antiwitz, der bekannte Witzstrukturen ad absurdum führt, indem er sich kurzerhand über die Gesetze der Logik hinwegsetzt“"
                            },
                            {
                                "example_id": "fb15afb4-b264-4691-886a-93d6e29f3b69",
                                "sense_id": "fc54fa66-f47e-3eb5-a6c2-273b03ac64b6",
                                "text": "„Mit der Darbietung dieser \"Antiwitze\" manifestiert sich die Verweigerung der Wiener Gruppe gegenüber Normsetzungen und die auf Konfrontation zum Publikum gerichtete Intention.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
