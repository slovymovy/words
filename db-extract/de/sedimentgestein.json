                ],
                "senses": [
                    {
                        "sense_id": "ed7c0b16-4caa-39e9-84f5-6117c71fcd02",
                        "entry_id": "e1de5e8d-93cc-329d-8c07-e83b238774e2",
                        "glosses": [
                            "eine bunte Vielfalt an gerundeten Gesteinsbruchstücken oder Mineralien in einer meist aus Sand, Kalk und/oder Ton bestehenden Grundmasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e85730e1-9ddf-441b-9a1f-3ad1b8c80b3b",
                                "sense_id": "ed7c0b16-4caa-39e9-84f5-6117c71fcd02",
                                "text": "Konglomerate aus Sedimentgestein bilden sich durch Verfestigung von abgelagertem Geröll in alten Schotterfeldern oder Schwemmfächern."
                            },
                            {
                                "example_id": "0b37ca96-6477-4dbe-b4b6-dc4f666b6d17",
                                "sense_id": "ed7c0b16-4caa-39e9-84f5-6117c71fcd02",
                                "text": "„In vielen Teilen der Welt ist die Erdkruste wie ein Sandwich, das aus Schichten von Millionen Jahre altem Sedimentgestein besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc72c923-20c1-450c-900b-46e1df1d8e5e",
                        "source_entry_id": "e1de5e8d-93cc-329d-8c07-e83b238774e2",
                        "source_sense_id": "ed7c0b16-4caa-39e9-84f5-6117c71fcd02",
                        "target_lang_word": "sedimentary rock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sedimentary rock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32eb7a21-55f2-346a-9c93-9219e476f00e",
                                        "entry_id": "cd39fc9d-a7ea-38ce-89e4-d0854f3b3682",
                                        "glosses": [
                                            "One of the major groups of rock that makes up the crust of the Earth; formed by the deposition of either the weathered remains of other rocks, the results of biological activity, or precipitation from solution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7437f609-1fb4-4e33-bccd-ba1d2b959fc2",
                                                "sense_id": "32eb7a21-55f2-346a-9c93-9219e476f00e",
                                                "text": "It's a geological wonderland, with great exposures of colorful and varied sedimentary rocks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69a7558e-25e7-4c4f-96a6-bdaf184cf40d",
                        "source_entry_id": "e1de5e8d-93cc-329d-8c07-e83b238774e2",
                        "source_sense_id": "ed7c0b16-4caa-39e9-84f5-6117c71fcd02",
                        "target_lang_word": "roche sédimentaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roche sédimentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f01e6fc-ae03-3302-95a6-88571f19a971",
                                        "entry_id": "c718044a-a284-3a00-a707-bb6c2a5ba3e7",
                                        "glosses": [
                                            "Type de roche provenant de l'accumulation de sédiments qui se déposent le plus souvent en strates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a1c467-8639-4224-92fd-66450e5ac056",
                                                "sense_id": "8f01e6fc-ae03-3302-95a6-88571f19a971",
                                                "text": "La grauwacke métamorphique est au contraire une roche sédimentaire qui comprend des brèches, des grès et plus rarement des schistes. Le métamorphisme de ses différentes couches a été très inégal; car, tandis que les grès et les brèches renferment des cristaux de feldspath qui leur donnent une structure porphyrique, le plus souvent les schistes ont seulement été soudés et changés en pétrosilex."
                                            },
                                            {
                                                "example_id": "8ebf552f-3355-47f5-9ddd-dd44b8e57afc",
                                                "sense_id": "8f01e6fc-ae03-3302-95a6-88571f19a971",
                                                "text": "Par ailleurs, les plus anciennes roches formées dans l'eau – des roches sédimentaires affleurant à Isua, dans le Sud du Groenland – datent d'il y a environ 3,8 milliards d'années, une époque où la vie était semble-t-il déjà apparue, puisque la roche d'Isua en contient des traces."
                                            },
                                            {
                                                "example_id": "a0ea434d-59e3-444d-8d80-8e1aee42f9a8",
                                                "sense_id": "8f01e6fc-ae03-3302-95a6-88571f19a971",
                                                "text": "Les roches sédimentaires sont volumétriquement peu importantes par rapport aux autres familles de roches (5 % de la lithosphère)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d24d033-b589-4f72-8569-22a946d64548",
                        "source_entry_id": "e1de5e8d-93cc-329d-8c07-e83b238774e2",
                        "source_sense_id": "ed7c0b16-4caa-39e9-84f5-6117c71fcd02",
