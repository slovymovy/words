{
    "word_family": [
        "inspection",
        "inspector",
        "inspectoral",
        "inspectorial",
        "inspectorship",
        "reinspect"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3560f4b-ec37-3cba-ba22-c2104631ad72",
                    "sense_definition": "To examine something carefully or critically, especially to find problems or check its condition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "examine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>inspect</w> the system for leaks before you turn it on.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>осмотреть</w> систему на наличие утечек, прежде чем включать её."
                            }
                        },
                        {
                            "text": "The mechanic will <w>inspect</w> the car to ensure it is safe to drive.",
                            "target_lang_translations": {
                                "ru": "Механик <w>осмотрит</w> машину, чтобы убедиться, что на ней безопасно ездить."
                            }
                        }
                    ],
                    "synonyms": [
                        "examine"
                    ],
                    "antonyms": [
                        "ignore",
                        "neglect"
                    ],
                    "common_phrases": [
                        "inspect the system",
                        "inspect for damage",
                        "inspect the property"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно или критически изучать что-либо, особенно для поиска проблем или проверки состояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осматривать",
                                "target_lang_sense_clarification": "внимательно изучать внешний вид или состояние"
                            },
                            {
                                "target_lang_word": "обследовать",
                                "target_lang_sense_clarification": "проводить детальную проверку"
                            },
                            {
                                "target_lang_word": "проверять",
                                "target_lang_sense_clarification": "убеждаться в исправности или отсутствии дефектов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12f115f3-c630-3a16-bbee-48aa61d3106d",
                    "sense_definition": "To visit and examine a place or group of people officially to ensure rules are being followed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "examine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general <w>inspected</w> the troops and their barracks during his visit.",
                            "target_lang_translations": {
                                "ru": "Во время своего визита генерал <w>проинспектировал</w> войска и их казармы."
                            }
                        },
                        {
                            "text": "Health officials will <w>inspect</w> the facility to check for safety violations.",
                            "target_lang_translations": {
                                "ru": "Представители органов здравоохранения <w>проверят</w> объект на предмет нарушений техники безопасности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inspect the troops",
                        "inspect the facility",
                        "inspect the premises"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально посещать и проверять место или группу людей для обеспечения соблюдения правил."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инспектировать",
                                "target_lang_sense_clarification": "проводить официальную проверку или надзор"
                            },
                            {
                                "target_lang_word": "проводить инспекцию",
                                "target_lang_sense_clarification": "официальный осмотр объекта или организации"
                            },
                            {
                                "target_lang_word": "проверять",
                                "target_lang_sense_clarification": "контролировать соблюдение норм и правил"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}