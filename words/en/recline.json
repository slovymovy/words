{
    "word_family": [
        "recliner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e85d41d1-5284-36e2-a21c-3769344cf83a",
                    "sense_definition": "To lean back or lie down in a relaxed, resting position.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lean_or_rest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She preferred to <w>recline</w> on the comfortable sofa while reading her favorite novel.",
                            "target_lang_translations": {
                                "ru": "Она предпочитала <w>полулежать</w> на удобном диване за чтением любимого романа."
                            }
                        },
                        {
                            "text": "During the hot afternoon, several guests chose to <w>recline</w> by the pool.",
                            "target_lang_translations": {
                                "ru": "В жаркий полдень несколько гостей решили <w>отдохнуть лежа</w> у бассейна."
                            }
                        }
                    ],
                    "synonyms": [
                        "lean back",
                        "lie back",
                        "lounge",
                        "rest"
                    ],
                    "common_phrases": [
                        "recline on a couch",
                        "recline by the pool"
                    ],
                    "target_lang_definitions": {
                        "ru": "Откинуться назад или прилечь в расслабленной, удобной позе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откидываться",
                                "target_lang_sense_clarification": "на спинку кресла или дивана"
                            },
                            {
                                "target_lang_word": "полулежать",
                                "target_lang_sense_clarification": "находиться в полулежачем положении"
                            },
                            {
                                "target_lang_word": "возлежать",
                                "target_lang_sense_clarification": "книжное или ироничное"
                            },
                            {
                                "target_lang_word": "прилечь",
                                "target_lang_sense_clarification": "лечь отдохнуть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7236b1be-0ac8-3ab3-af3b-0a943bd7c077",
                    "sense_definition": "To adjust a seat or chair so that the back leans further backwards.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lean_or_rest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please return your seat to the upright position and do not <w>recline</w> your seat during takeoff.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, верните кресло в вертикальное положение и не <w>откидывайте</w> его во время взлёта."
                            }
                        },
                        {
                            "text": "He pushed the button on the armrest to <w>recline</w> his chair and sleep.",
                            "target_lang_translations": {
                                "ru": "Он нажал кнопку на подлокотнике, чтобы <w>откинуть</w> кресло и поспать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recline your seat",
                        "recline the back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опустить или отклонить назад спинку сиденья или кресла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откидывать",
                                "target_lang_sense_clarification": "спинку сиденья назад"
                            },
                            {
                                "target_lang_word": "опускать",
                                "target_lang_sense_clarification": "спинку кресла"
                            },
                            {
                                "target_lang_word": "раскладывать",
                                "target_lang_sense_clarification": "сиденье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22a509e8-117b-34af-b513-e3c2e98c806e",
                    "sense_definition": "To place or rest a part of the body upon something for support.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lean_or_rest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tired from the long journey, she <w>reclined</w> her head against his shoulder.",
                            "target_lang_translations": {
                                "ru": "Устав от долгой дороги, она <w>прислонила</w> голову к его плечу."
                            }
                        },
                        {
                            "text": "He <w>reclined</w> his aching arms on the wooden table and let out a sigh.",
                            "target_lang_translations": {
                                "ru": "Он <w>положил</w> ноющие руки на деревянный стол и тяжело вздохнул."
                            }
                        }
                    ],
                    "synonyms": [
                        "rest",
                        "lean"
                    ],
                    "common_phrases": [
                        "recline one's head"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Положить или прислонить часть тела к чему-либо для опоры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прислонить",
                                "target_lang_sense_clarification": "голову, плечи к чему-либо"
                            },
                            {
                                "target_lang_word": "положить",
                                "target_lang_sense_clarification": "руки или голову на опору"
                            },
                            {
                                "target_lang_word": "опереть",
                                "target_lang_sense_clarification": "для отдыха или поддержки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65977c7e-bdaf-3bd5-aa98-c614d21e4d8b",
                    "sense_definition": "The ability, degree, or mechanism of a seat tilting backwards; the act of tilting back.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The budget airline reduced the seat pitch and removed the seat <w>recline</w> entirely.",
                            "target_lang_translations": {
                                "ru": "Бюджетная авиакомпания уменьшила расстояние между креслами и полностью убрала возможность <w>откидывания спинки</w>."
                            }
                        },
                        {
                            "text": "Passengers often complain about the lack of <w>recline</w> on short domestic flights.",
                            "target_lang_translations": {
                                "ru": "Пассажиры часто жалуются на то, что кресла совсем <w>не откидываются</w> на коротких внутренних рейсах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "seat recline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможность наклона, угол откидывания спинки сиденья или механизм регулировки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откидывание спинки",
                                "target_lang_sense_clarification": "наклон кресла назад"
                            },
                            {
                                "target_lang_word": "угол наклона",
                                "target_lang_sense_clarification": "спинки сиденья"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}