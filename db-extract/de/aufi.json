                "senses": [
                    {
                        "sense_id": "ae8f15d1-28e2-3c40-a8d7-13dd80d406c2",
                        "entry_id": "a9f52715-0f99-3d21-940f-82c9ad8a35a9",
                        "glosses": [
                            "nach oben"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "aabcd8c8-6c51-46a0-bd35-01739baaf871",
                                "sense_id": "ae8f15d1-28e2-3c40-a8d7-13dd80d406c2",
                                "text": "„‚Do obi und durt aufi!‘ Die Benützung der neuen Unterführungen musste manchen Passanten der Ringstraße erst erklärt werden – damals, in den 1950er- und 1960er-Jahren, als Wien daranging, seinen Verkehr neu zu organisieren.“"
                            },
                            {
                                "example_id": "8f0cc759-2fa4-4537-b607-bc75e7d0bd37",
                                "sense_id": "ae8f15d1-28e2-3c40-a8d7-13dd80d406c2",
                                "text": "„Naturbursche Fritz Walcher beäugt den Schneesturm und deutet ihn nach eigenen Kriterien als ‚G'brösl‘. Also: ‚Aufi‘. Für unsere zehnköpfige Gruppe hat er modernste Schneeschuhe, made in America, parat: aus Leichtmetall und Nylongeflecht.“"
                            },
                            {
                                "example_id": "02231b8c-a9ac-4376-9905-759b767fde9d",
                                "sense_id": "ae8f15d1-28e2-3c40-a8d7-13dd80d406c2",
                                "text": "„Ein Zuruf wie ‚Tua d'Haxn aufi‘ sei erlaubt, bestätigt ein Schlittenpilot, wenn es darum geht, ‚die größte Rennsau von Hammerfest bis Palermo‘ zu ermitteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
