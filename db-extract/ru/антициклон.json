                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2bc095a-5903-4c4b-96ef-c78266844c8c",
                                                "sense_id": "4c6ccc1b-6f0c-36ed-aef4-0d966536cee4",
                                                "text": "Le retour de l'anticyclone nous assure de beaux jours."
                                            },
                                            {
                                                "example_id": "a55fad25-6c9a-464f-b1d1-8398a25250c8",
                                                "sense_id": "4c6ccc1b-6f0c-36ed-aef4-0d966536cee4",
                                                "text": "L’anticyclone des Açores."
                                            },
                                            {
                                                "example_id": "a7e7b94c-7967-4942-8054-d34b5b74dbcf",
                                                "sense_id": "4c6ccc1b-6f0c-36ed-aef4-0d966536cee4",
                                                "text": "On distingue deux types d’anticyclones : l’anticyclone froid et l’anticyclone chaud."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anticyclone",
                                "target_lang_code": "fr",
