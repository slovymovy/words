{
    "word_family": [
        "recess",
        "recession",
        "recessive"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7113cafd-0a0a-3c7a-a84a-374f3c2874a4",
                    "sense_definition": "Set back into a wall, ceiling, or other surface; located in a hole, space, or opening.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "set-back",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was illuminated by modern <w>recessed</w> lighting installed in the ceiling.",
                            "target_lang_translations": {
                                "ru": "Комната освещалась современным <w>встроенным</w> освещением, установленным в потолке."
                            }
                        },
                        {
                            "text": "They decided to install a <w>recessed</w> shelf in the bathroom to save space.",
                            "target_lang_translations": {
                                "ru": "Они решили установить <w>встроенную</w> полку в ванной, чтобы сэкономить место."
                            }
                        }
                    ],
                    "synonyms": [
                        "indented",
                        "sunken"
                    ],
                    "antonyms": [
                        "protruding",
                        "projecting"
                    ],
                    "common_phrases": [
                        "recessed lighting",
                        "recessed shelf",
                        "recessed wall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Встроенный в стену, потолок или другую поверхность; расположенный в углублении или нише."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встроенный",
                                "target_lang_sense_clarification": "о светильниках, мебели, находящихся в нише"
                            },
                            {
                                "target_lang_word": "утопленный",
                                "target_lang_sense_clarification": "находящийся на более низком уровне, в углублении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eba3b9ca-5f3d-3a67-854b-61fe01d4a099",
                    "sense_definition": "Having a recess, alcove, or nook.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "set-back",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect designed a <w>recessed</w> entryway to protect visitors from the rain.",
                            "target_lang_translations": {
                                "ru": "Архитектор спроектировал <w>утопленный</w> вход, чтобы защитить посетителей от дождя."
                            }
                        },
                        {
                            "text": "A cozy, <w>recessed</w> corner of the library was perfect for quiet reading.",
                            "target_lang_translations": {
                                "ru": "Уютный, <w>уединенный</w> уголок библиотеки идеально подходил для спокойного чтения."
                            }
                        }
                    ],
                    "synonyms": [
                        "niched"
                    ],
                    "common_phrases": [
                        "recessed entryway",
                        "recessed area"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий углубление, нишу или альков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с нишей",
                                "target_lang_sense_clarification": "имеющий углубление в стене"
                            },
                            {
                                "target_lang_word": "утопленный",
                                "target_lang_sense_clarification": "о входе или зоне, расположенной глубже основной линии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df976364-9ffe-3b23-840b-48deede41974",
                    "sense_definition": "Withdrawn from public view; secluded or remote.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "secluded",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cottage was comfortably <w>recessed</w> from the busy main road.",
                            "target_lang_translations": {
                                "ru": "Коттедж был уютно <w>удален</w> от оживленной главной дороги."
                            }
                        },
                        {
                            "text": "He sought a <w>recessed</w> life, far away from the noise of the city.",
                            "target_lang_translations": {
                                "ru": "Он стремился к <w>уединенной</w> жизни, вдали от городского шума."
                            }
                        }
                    ],
                    "synonyms": [
                        "secluded",
                        "withdrawn",
                        "isolated"
                    ],
                    "antonyms": [
                        "exposed",
                        "prominent"
                    ],
                    "common_phrases": [
                        "comfortably recessed"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in a literary or dated sense to mean secluded"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрытый от посторонних глаз; уединенный или удаленный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уединенный",
                                "target_lang_sense_clarification": "скрытый от шума и людей"
                            },
                            {
                                "target_lang_word": "удаленный",
                                "target_lang_sense_clarification": "находящийся в отдалении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "391056af-3516-3206-860f-1cec2cff26fa",
                    "sense_definition": "Simple past tense and past participle of <w>recess</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee <w>recessed</w> for lunch and agreed to reconvene at two o'clock.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>прервал работу</w> на обед и согласился собраться вновь в два часа."
                            }
                        },
                        {
                            "text": "They <w>recessed</w> the wall to make room for a built-in bookshelf.",
                            "target_lang_translations": {
                                "ru": "Они <w>сделали углубление</w> в стене, чтобы освободить место для встроенного книжного шкафа."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола recess (объявлять перерыв; делать углубление)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прервал работу",
                                "target_lang_sense_clarification": "о комитете, суде, ушедшем на перерыв"
                            },
                            {
                                "target_lang_word": "сделал углубление",
                                "target_lang_sense_clarification": "в стене или поверхности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
