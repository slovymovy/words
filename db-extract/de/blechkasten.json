                ],
                "senses": [
                    {
                        "sense_id": "1d91fb5a-c227-3efc-9b7c-824d61690087",
                        "entry_id": "37020394-33ab-3cca-b8e4-a247b45181d3",
                        "glosses": [
                            "mittelgroßer, rechteckiger Behälter mit Deckel aus Blech"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e89833b5-7438-4e15-968f-63633e1c10b2",
                                "sense_id": "1d91fb5a-c227-3efc-9b7c-824d61690087",
                                "text": "„Sie hatte, während sie das erzählte, Brot aus einem Blechkasten geholt und auf den Tisch gelegt.“"
                            },
                            {
                                "example_id": "9c6b6b57-3621-4acf-823e-6103da514edb",
                                "sense_id": "1d91fb5a-c227-3efc-9b7c-824d61690087",
                                "text": "„Menschenscheuer denn je, verkroch sich Horst Cunert auf dem Dachboden in der Düsternstraße, zwischen Blechkästen und Dampfschiffen, wo ihn nur Cesar und Roman besuchen durften.“"
                            },
                            {
                                "example_id": "9a22b98a-ede4-41d5-9dfe-1440ca41d60f",
                                "sense_id": "1d91fb5a-c227-3efc-9b7c-824d61690087",
                                "text": "„Schon als Tom gerade das Laufen erlernt hatte, zog ihn dieser merkwürdige Blechkasten wie magisch an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
