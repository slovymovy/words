                "senses": [
                    {
                        "sense_id": "04001b46-da18-35a2-8ad4-7a0984f87eb7",
                        "entry_id": "2e069912-adaa-344d-bcb5-28054917e7cb",
                        "glosses": [
                            "psychische Verfassung, dass man von Angst beherrscht/überwältigt ist"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "69434196-67d1-40e3-8ee6-bce32f60bd69",
                                "sense_id": "04001b46-da18-35a2-8ad4-7a0984f87eb7",
                                "text": "„Zu den auf diese Weise behandelten Störungen gehören die Epilepsie, zentrale Schmerzzustände, Schlaflosigkeit, Angstzustände und Depressionen, unkontrollierbare Gewalttätigkeit und einige Abarten der Schizophrenie.“"
                            },
                            {
                                "example_id": "9210da01-a349-4c3a-bad0-0f5a9079be10",
                                "sense_id": "04001b46-da18-35a2-8ad4-7a0984f87eb7",
                                "text": "„Wegen seiner Angstzustände war er ständig beschwipst gewesen.“"
                            },
                            {
                                "example_id": "818df9ac-66d8-4844-b4fe-7c5b9f11b430",
                                "sense_id": "04001b46-da18-35a2-8ad4-7a0984f87eb7",
                                "text": "„Sie hatte einen Nervenzusammenbruch erlitten und verließ wegen Angstzuständen ihr Zimmer nicht mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
