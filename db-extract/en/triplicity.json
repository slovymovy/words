                                "target_senses": [
                                    {
                                        "sense_id": "58752045-8388-3c93-894b-5feefce0fae6",
                                        "entry_id": "10ebafd4-850c-3776-98a1-67a98bbfee6d",
                                        "glosses": [
                                            "Caractère de ce qui est triple."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9fb77e3-879c-44f3-aa27-fbc0d37b8c1f",
                                                "sense_id": "58752045-8388-3c93-894b-5feefce0fae6",
                                                "text": "Dans cette pièce de théâtre, il y a non seulement duplicité, mais triplicité d’action."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a535a0c1-2e07-3bbd-a549-f4f5d8cda892",
                                        "entry_id": "10ebafd4-850c-3776-98a1-67a98bbfee6d",
                                        "glosses": [
                                            "Caractère de ce qui est triple.",
                                            "Trinité."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26eae84e-95cb-476a-b442-0ec8699e1bc3",
                                                "sense_id": "a535a0c1-2e07-3bbd-a549-f4f5d8cda892",
                                                "text": "Dans la Trinité, il y a triplicité de personnes, mais il n’y a pas triplicité de substances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19d51f55-0a4c-435e-a9d5-c687c1c0d043",
                        "source_entry_id": "6d974643-9f27-34ea-802b-5d89d4599837",
                        "source_sense_description": "state of being threefold",
                        "target_lang_word": "Triplizität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Triplizität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f1e52ed-189d-3365-a3e3-41189b5c2497",
                                        "entry_id": "9c17d828-023a-3d69-97e5-7931677b498c",
                                        "glosses": [
                                            "Tatsache/Umstand, dass etwas dreifach (tri) auftritt"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb696054-2e5f-433f-afb9-d4a369bcbda1",
                                                "sense_id": "7f1e52ed-189d-3365-a3e3-41189b5c2497",
                                                "text": "„Allein die einzige Geisterwelt besteht in drey Triplizitäten, und begreift in sich neue Geisterwelten, wo die übrigen Welten jede nur Eine ist.“ (1795)"
                                            },
                                            {
                                                "example_id": "cb5c4a85-23e9-43e2-bd38-57b8191b8e1a",
                                                "sense_id": "7f1e52ed-189d-3365-a3e3-41189b5c2497",
                                                "text": "„‚Triplizität‘ ist also der Gegenbegriff sowohl zum Monismus, d.h. der ununterscheidbaren Einheit, wie zum ‚Dualismus‘, d.h. der Entgegensetzung von Subjektivem und Objektivem, die im Urteil zum Ausdruck kommt.“ (Hegel)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "360100f2-169d-446f-a429-dcac5946031a",
                        "source_entry_id": "6d974643-9f27-34ea-802b-5d89d4599837",
                        "source_sense_description": "state of being threefold",
                        "target_lang_word": "Dreifaltigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreifaltigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "146276df-74b9-3338-8439-af210c46a8e5",
                                        "entry_id": "ee1519eb-1aea-3119-93d0-64af36ae4c38",
                                        "glosses": [
                                            "die geschlossene Dreieinigkeit von etwas; 3 Falten (Fakten) oder auch drei gleichberechtigte Dinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4968cfa2-841e-4c23-bdce-b7d2d76dccca",
                                                "sense_id": "146276df-74b9-3338-8439-af210c46a8e5",
                                                "text": "„Dreieinigkeit drückt diesen Begriff durch Verschmelzung der Zahlen drei und eins schlechthin aus, während Dreifaltigkeit (lat. triplicitas von triplex, eig. das, was dreimal gefaltet ist) denselben Begriff zugleich durch ein Bild (das Bild einer dreifaltigen Schnur) zu malen sucht.“"
                                            },
                                            {
                                                "example_id": "eb472e18-cf68-425d-8876-6f122734da16",
                                                "sense_id": "146276df-74b9-3338-8439-af210c46a8e5",
                                                "text": "„Vater, Mutter, Kind - die traditionelle Dreifaltigkeit der deutschen Familie soll nicht angetastet werden.“"
                                            },
                                            {
                                                "example_id": "275d0dc1-5ce6-44a0-af71-b41bbe8b2346",
                                                "sense_id": "146276df-74b9-3338-8439-af210c46a8e5",
                                                "text": "„Die Trilogie scheint ohnehin ein Muss zu sein. Sie ist die Dreifaltigkeit des Fantasy-Romans, etwas heiliges.“"
                                            },
                                            {
                                                "example_id": "90baa1ab-364d-4800-bba5-405836ee7ee0",
                                                "sense_id": "146276df-74b9-3338-8439-af210c46a8e5",
                                                "text": "„Wer also nach den zukünftigen Führern, den Rettern Deutschlands Ausschau hält, der muß nach Leuten suchen, die jener Dreifaltigkeit wenigstens in einigen Wesenszügen ähnlich sind, denn nur jene Drei kannten den Schlüssel zum innersten Herzen der Deutschen.“"
                                            },
                                            {
                                                "example_id": "0c366a69-5d76-4ff9-8e82-a57a56ce2c26",
                                                "sense_id": "146276df-74b9-3338-8439-af210c46a8e5",
                                                "text": "„Die Katastrophe, die zunächst als Erdbeben von Tohoku bezeichnet wird, wird dann in drei gravierende Ereignisse aufgetrennt, die aber als eine Art Dreifaltigkeit dargestellt werden: ein Erdbeben, ein Tsunami und ein AKW-GaU.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5dc9b4df-ef7b-334a-8d25-eb818f30dbb5",
                                        "entry_id": "ee1519eb-1aea-3119-93d0-64af36ae4c38",
                                        "glosses": [
                                            "Dogma der Wesenseinheit von Gottvater, Jesus Christus und dem Heiligen Geist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c412b798-a4d9-4115-b40e-93ba339a6551",
                                                "sense_id": "5dc9b4df-ef7b-334a-8d25-eb818f30dbb5",
                                                "text": "„Bei den Schreibern des Neuen Testaments gibt es keine formale Lehre von der Dreifaltigkeit, wenn das die ausdrückliche Lehre bedeutet, dass es in einem Gott drei einander gleiche göttliche Personen gibt.“"
                                            },
                                            {
                                                "example_id": "5739c32a-54e6-4595-a16c-76d1cccf17b6",
                                                "sense_id": "5dc9b4df-ef7b-334a-8d25-eb818f30dbb5",
                                                "text": "„Wir bekennen nicht drei Götter, sondern einen einzigen Gott in drei Personen: die „wesensgleiche Dreifaltigkeit“ (2. K. v. Konstantinopel 553: DS 421).“"
                                            },
                                            {
                                                "example_id": "6e969d68-a551-4c68-aef8-b54663ca0b0d",
                                                "sense_id": "5dc9b4df-ef7b-334a-8d25-eb818f30dbb5",
                                                "text": "„Aus der Zeit des Neubaus stammt auch die Darstellung der Dreifaltigkeit im Hochaltar, die man heute aufgrund des eigentlichen Verbots durch das Konzil von Trient (1545-1563) nur noch sehr selten zu sehen bekommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Dreifaltigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90d77e71-025d-34b6-bc42-c6c7d6b7237f",
                                        "entry_id": "d7898359-a57a-3d4c-890e-ac2189864fdd",
                                        "glosses": [
                                            "Stadt in Deutschland oder Europa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c08a7918-149d-4fec-9faf-13da2fee4362",
                                                "sense_id": "90d77e71-025d-34b6-bc42-c6c7d6b7237f",
                                                "text": "„Der Ortsteil Dreifaltigkeit liegt in Aham und besteht aus 1 Postleitzahlgebieten: 84168. Das Zentrum von Dreifaltigkeit ist 3.5km westlich und 26.5km südlich von Aham Zentrum entfernt, der Gesamtabstand beträgt 26.7km.“"
                                            },
                                            {
                                                "example_id": "b495621f-175b-4af3-9a9c-c716f1642ae7",
                                                "sense_id": "90d77e71-025d-34b6-bc42-c6c7d6b7237f",
                                                "text": "„Denn auch in Dreifaltigkeit kann man durch unseren gratis DSL und Festnetz Preisvergleich herausfinden, was für Sie als Kunde der günstigste Anbieter ist und ob sich vielleicht ein Wechsel lohnt.“"
                                            },
                                            {
                                                "example_id": "9e97d2b3-163a-48f1-9557-12b46af67aa8",
                                                "sense_id": "90d77e71-025d-34b6-bc42-c6c7d6b7237f",
                                                "text": "„Seit 2001 gedeihen in Dreifaltigkeit mehr als 300 Kräuter unterschiedlichster Art, die es auf 800 m² Almwiesen zu entdecken gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e854915-34f4-4c3c-b693-14af1b8616d4",
                        "source_entry_id": "6d974643-9f27-34ea-802b-5d89d4599837",
                        "source_sense_description": "state of being threefold",
                        "target_lang_word": "Dreiergruppe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreiergruppe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e3b52e-cd2a-344f-9a15-8c5aef5f557d",
                                        "entry_id": "35a661e1-6b46-33c0-95e3-25a5b1e7c273",
                                        "glosses": [
                                            "Gruppe von drei Personen oder Objekten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16d55e52-1acb-49f3-ae96-3fa1927f9d2f",
                                                "sense_id": "e4e3b52e-cd2a-344f-9a15-8c5aef5f557d",
                                                "text": "„Zwar gab es nur noch zwei Vierergruppen, eine Dreiergruppe und eine Zweierpaarung, aber dennoch waren es immerhin 16 Spiele (statt 24) in der ersten Gruppenphase, darunter drei mit Beteiligung des Gastgebers.“"
                                            },
                                            {
                                                "example_id": "cf258697-a7d6-480b-ac16-0c0a546d08a4",
                                                "sense_id": "e4e3b52e-cd2a-344f-9a15-8c5aef5f557d",
                                                "text": "„Sie werden von links nach rechts in zwei Dreiergruppen und eine Zweiergruppe gegliedert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
