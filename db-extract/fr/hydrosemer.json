                "senses": [
                    {
                        "sense_id": "df0865b4-f28f-3532-837f-ea2382a8de88",
                        "entry_id": "d3b3f145-c9ba-325a-9c95-6b8e3fb64045",
                        "glosses": [
                            "Semer par pulvérisation d'un mélange contenant de l'eau et des semences."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573977b9-830a-46c1-b6d5-8ba222e6e489",
                                "sense_id": "df0865b4-f28f-3532-837f-ea2382a8de88",
                                "text": "Mais l'utilisateur peut aussi utiliser un milieu déjà ensemencé ou choisir de les hydrosemer après installation."
                            },
                            {
                                "example_id": "4556f459-c73d-49da-916e-f31799334e6b",
                                "sense_id": "df0865b4-f28f-3532-837f-ea2382a8de88",
                                "text": "Nous avons des estimés pour faire semer le gazon; la tourbe est très dispendieuse ici alors la meilleur facon nous dit-on est d'hydrosemer."
                            }
                        ]
                    }
