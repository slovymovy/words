        "fr-extract.jsonl": [
            {
                "entry_id": "8c1aceb2-530d-3d19-b3d8-3ae616d73092",
                "word": "désertion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b6a532bd-372b-4b35-bd9d-de15a4a09d26",
                        "entry_id": "8c1aceb2-530d-3d19-b3d8-3ae616d73092",
                        "tags": [
                            "plural"
                        ],
                        "form": "désertions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d4f0040-5f67-3762-8174-b47b4af3aa1c",
                        "entry_id": "8c1aceb2-530d-3d19-b3d8-3ae616d73092",
                        "glosses": [
                            "Action de déserter ; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "039988a4-bf49-44f6-9206-eae3be1e3526",
                                "sense_id": "5d4f0040-5f67-3762-8174-b47b4af3aa1c",
                                "text": "Son trésor est vide. Son armée, mal recrutée, mal équipée, mal disciplinée, absolument démoralisée par ses défaites récentes, est réduite à fort peu de chose par les licenciements forcés et les désertions."
                            },
                            {
                                "example_id": "0f3a0ff8-a54f-4b37-b7ec-e8d2e0681916",
                                "sense_id": "5d4f0040-5f67-3762-8174-b47b4af3aa1c",
                                "text": "Il faut donc trouver un argument-massue, un argument capable de semer le doute dans l’âme des ouvriers, d’ébranler leur confiance, d’amener des défections de plus en plus nombreuses, puis des désertions massives."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f724e96c-415d-4c81-b8e6-65992d2503d6",
                        "source_entry_id": "8c1aceb2-530d-3d19-b3d8-3ae616d73092",
                        "source_sense_id": "5d4f0040-5f67-3762-8174-b47b4af3aa1c",
                        "target_lang_word": "Desertion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Desertion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "093552b3-3ff6-3b3d-b262-a1c7e183370c",
                                        "entry_id": "a1a9f8af-312b-3005-9abe-3f9edf23ee3a",
                                        "glosses": [
                                            "unerlaubte Entfernung vom Militärdienst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ec9216f-2b6f-48d9-b12f-ade26f88c916",
                                                "sense_id": "093552b3-3ff6-3b3d-b262-a1c7e183370c",
                                                "text": "„Nach dem Scheitern der zweiten Desertion im Januar 1787 konnte Seume sich im gleichen Jahr dem preußischen Söldnerdienst doch noch entziehen.“"
                                            },
                                            {
                                                "example_id": "60854d8a-e2e9-433f-a74e-6bb8c29df6a6",
                                                "sense_id": "093552b3-3ff6-3b3d-b262-a1c7e183370c",
                                                "text": "„Schon seit einigen Tagen war in unserem Kreis die Möglichkeit seiner Desertion erwogen worden.“"
                                            },
                                            {
                                                "example_id": "33caf59b-f55e-4f11-9fce-f3c6b7e0d9dc",
                                                "sense_id": "093552b3-3ff6-3b3d-b262-a1c7e183370c",
                                                "text": "„Diese Desertion war der dritte große Fehler meines Lebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
