                    {
                        "sense_id": "3dd63ac6-c1c1-3812-8559-ba8645065359",
                        "entry_id": "707e76f8-3015-339d-b759-218bd9dfc4e9",
                        "glosses": [
                            "Dévidoir sur lequel on enroule le fil de soie provenant des cocons pour en faire un écheveau."
                        ],
                        "tags": [
                            "Soierie"
                        ],
                        "examples": [
                            {
                                "example_id": "9a8bcf92-9164-46e9-9724-0c23c6381612",
                                "sense_id": "3dd63ac6-c1c1-3812-8559-ba8645065359",
                                "text": "On donne ce nom dans les manufactures en soie de Piémont , indifféremment au dévidoir sur lequel on tire les soies des cocons , & à celui qui dans les moulins se charge de la soie organcinée : le premier s'appelle aspe de filature , & le second aspe de tors."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccb41fef-75dd-4a7a-940e-ff7fc49eb031",
                        "source_entry_id": "707e76f8-3015-339d-b759-218bd9dfc4e9",
                        "source_sense_id": "3dd63ac6-c1c1-3812-8559-ba8645065359",
                        "target_lang_word": "Haspel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haspel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b82a9aa-48c7-3f54-bb15-3f6b8cdcde4a",
                                        "entry_id": "b093b705-0f50-3bf8-8772-ffce5301b326",
                                        "glosses": [
                                            "Zylinder zum Aufwickeln von zum Beispiel Seilen oder Drähten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "939c5a24-4554-4bd8-be5a-f517ae1666b7",
                                                "sense_id": "0b82a9aa-48c7-3f54-bb15-3f6b8cdcde4a",
                                                "text": "„Allerleirauh lief nun in die Küche, kochte dem König die Brotsuppe und legte, wie der Koch fort war, den goldenen Haspel hinein. Der König, als er den Haspel auf dem Grunde fand, ließ Allerleirauh rufen.“"
                                            },
                                            {
                                                "example_id": "518d5b56-f5c4-4c6b-a5a5-59a5ab25d014",
                                                "sense_id": "0b82a9aa-48c7-3f54-bb15-3f6b8cdcde4a",
                                                "text": "Ich verwendete ein dickes Plastikrohr als Haspel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "031cfebc-b68a-3bef-8ead-10fd177998c6",
                                        "entry_id": "b093b705-0f50-3bf8-8772-ffce5301b326",
                                        "glosses": [
                                            "Maschine zum Abwickeln und Strang-Bilden"
                                        ],
                                        "tags": [
                                            "Textilindustrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afc66243-29ff-4675-abf4-aa2c7c205d1d",
                                                "sense_id": "031cfebc-b68a-3bef-8ead-10fd177998c6",
                                                "text": "Haspeln sind in der Textiltechnik ein wichtiges Hilfsmittel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "99f41aa2-f77b-3c64-b29c-e634a2bd0379",
                                        "entry_id": "b093b705-0f50-3bf8-8772-ffce5301b326",
                                        "glosses": [
                                            "Bottich mit bewegten Schaufeln"
                                        ],
                                        "tags": [
                                            "Gerberei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea8785ed-0250-4791-ae6d-8a979ea152e4",
                                                "sense_id": "99f41aa2-f77b-3c64-b29c-e634a2bd0379",
                                                "text": "In der Haspel werden auch Farben zugesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "495e157c-f8b8-3c1b-af16-8c146f8980b5",
