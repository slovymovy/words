                "forms": [],
                "senses": [
                    {
                        "sense_id": "0c8bcaa3-9acf-3da3-a849-a47ae8ba913f",
                        "entry_id": "062ccbaf-1e03-3bd1-b7e8-8001a3852337",
                        "glosses": [
                            "ruja u suki psowatych"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "881fa4e6-8e22-4efa-a97d-a9cdb8c3eedb",
                        "source_entry_id": "062ccbaf-1e03-3bd1-b7e8-8001a3852337",
                        "source_sense_id": "0c8bcaa3-9acf-3da3-a849-a47ae8ba913f",
                        "target_lang_word": "Hitze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hitze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e286c9a-dd11-34f1-8edc-cbfd4c499fbe",
                                        "entry_id": "11dc61f9-e142-3010-a131-8ed0b10f6670",
                                        "glosses": [
                                            "hohe, als unangenehm empfundene Wärme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe46f4d0-d35f-40e3-80e8-21639a6a5157",
                                                "sense_id": "6e286c9a-dd11-34f1-8edc-cbfd4c499fbe",
                                                "text": "Bei dieser Hitze kann man nicht arbeiten!"
                                            },
                                            {
                                                "example_id": "e1671658-c21d-435f-818b-c2434495ce4b",
                                                "sense_id": "6e286c9a-dd11-34f1-8edc-cbfd4c499fbe",
                                                "text": "Das Land ist von der Hitze ganz ausgetrocknet."
                                            },
                                            {
                                                "example_id": "b8073d69-9775-43a2-9696-30acaf20cf48",
                                                "sense_id": "6e286c9a-dd11-34f1-8edc-cbfd4c499fbe",
                                                "text": "Dann muss man das Fleisch bei starker Hitze anbraten."
                                            },
                                            {
                                                "example_id": "fe8077f9-e49b-411b-8fdc-4da79df965b4",
                                                "sense_id": "6e286c9a-dd11-34f1-8edc-cbfd4c499fbe",
                                                "text": "„In der Hitze legte sich der widerwärtige Geruch, der über der Gegend hing, rasch auf die Zunge.“"
                                            },
                                            {
                                                "example_id": "0f79b2f3-d5cb-4eeb-976a-c8e408a79be4",
                                                "sense_id": "6e286c9a-dd11-34f1-8edc-cbfd4c499fbe",
                                                "text": "„In der Hitze des Raums, die von dem eisernen Kochofen ausstrahlte, liefen ihre Gläser an.“"
                                            },
                                            {
                                                "example_id": "4ce457cf-b1a4-484e-975d-a7e4a9e17d9d",
                                                "sense_id": "6e286c9a-dd11-34f1-8edc-cbfd4c499fbe",
                                                "text": "„Die Hitze hatte uns schläfrig gemacht.“"
                                            },
                                            {
                                                "example_id": "3488cbf6-2840-420f-8a1d-1f599ca928be",
                                                "sense_id": "6e286c9a-dd11-34f1-8edc-cbfd4c499fbe",
                                                "text": "„Bei einer Hitze von 52 Grad Celsius können Menschen im Freien nicht überleben. So heiß wurde es Ende Mai [Anm.: 2024] in Indiens Hauptstadt Neu-Delhi.“"
                                            },
                                            {
                                                "example_id": "b5d8868e-321e-496b-a888-87513eff05c6",
                                                "sense_id": "6e286c9a-dd11-34f1-8edc-cbfd4c499fbe",
                                                "text": "„So ging der Sommer mit Blitz und Donner, großer Hitze und Hagelschlägen seinen Weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73e129eb-671f-31d6-947d-26ab222e6610",
                                        "entry_id": "11dc61f9-e142-3010-a131-8ed0b10f6670",
                                        "glosses": [
                                            "durch Gefühle oder Fieber hervorgerufene Wärme im Körper^([1]) oder in einem Körperteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "583f39b5-a307-495c-8373-3ccc49c44b4c",
                                                "sense_id": "73e129eb-671f-31d6-947d-26ab222e6610",
                                                "text": "Hast Hitzen? (Umgangssprachlich für „hast du Hitzewallungen?“)"
                                            },
                                            {
                                                "example_id": "bca18976-f250-48cb-85a1-a2e52a909129",
                                                "sense_id": "73e129eb-671f-31d6-947d-26ab222e6610",
                                                "text": "Die aufsteigende Hitze trieb ihr kleine Schweißperlen auf die Stirn."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b433b617-a51e-3f83-b911-16cb310f0277",
                                        "entry_id": "11dc61f9-e142-3010-a131-8ed0b10f6670",
                                        "glosses": [
                                            "Zeit der Empfängnisbereitschaft weiblicher Hunde und Füchse"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85806e2a-d9f5-45ef-b2d4-6f6888af2fa6",
                                                "sense_id": "b433b617-a51e-3f83-b911-16cb310f0277",
                                                "text": "Pheromone informieren die Rüden über die nahe bevorstehende Hitze der Fähe."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d9f6a6d-3c9f-483f-8404-6db3aff21d4e",
                        "source_entry_id": "062ccbaf-1e03-3bd1-b7e8-8001a3852337",
                        "source_sense_id": "0c8bcaa3-9acf-3da3-a849-a47ae8ba913f",
                        "target_lang_word": "Läufigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ef110d80-57a1-4239-89ff-ac781dab6991",
                        "source_entry_id": "062ccbaf-1e03-3bd1-b7e8-8001a3852337",
                        "source_sense_id": "0c8bcaa3-9acf-3da3-a849-a47ae8ba913f",
                        "target_lang_word": "течка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "течка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "953110b6-42c7-348d-9e4c-c2bdcdd9096e",
                                        "entry_id": "0a8f3855-fcc4-3ee1-9517-e6fc9cfd655f",
                                        "glosses": [
                                            "биол. период половой активности у самок млекопитающих"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "627a2b39-682b-4019-b3f3-bdb7ad0a98d1",
                                                "sense_id": "953110b6-42c7-348d-9e4c-c2bdcdd9096e",
                                                "text": "Периоды течки у кошек не связаны ни с каким определённым временем года, а зависят исключительно от индивидуального или породного темперамента."
                                            },
                                            {
                                                "example_id": "a6c5477f-16f2-4074-b15f-dac6826d87aa",
                                                "sense_id": "953110b6-42c7-348d-9e4c-c2bdcdd9096e",
                                                "text": "Главным оказалось, что животные спариваются только в период течки, люди же ― неутомимы."
                                            },
                                            {
                                                "example_id": "a1a07e3c-ba71-4e39-b245-7e34b0cace3f",
                                                "sense_id": "953110b6-42c7-348d-9e4c-c2bdcdd9096e",
                                                "text": "Купили домой кошку 3-х лет развязанную, сейчас у кошки течка, мой кот не обращает на неё никакого внимания, что делать?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e0ec93e-19b2-3de3-8cad-60e273fd4158",
                                        "entry_id": "0a8f3855-fcc4-3ee1-9517-e6fc9cfd655f",
                                        "glosses": [
                                            "эвф. менструация"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4800129f-8186-4a76-89d2-95f4c2c1ae0a",
                                                "sense_id": "9e0ec93e-19b2-3de3-8cad-60e273fd4158",
                                                "text": "Несмотря на бесспорную аналогию с менструацией женщины, течка обезьян отличается преобладанием припухания внешних половых органов, слизистым характером истечения и малым содержанием кровяных шариков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163e2760-bde4-3a56-a30d-57810fa24e39",
                                        "entry_id": "0a8f3855-fcc4-3ee1-9517-e6fc9cfd655f",
                                        "glosses": [
                                            "перен. разг. о сексуальном возбуждении у женщины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b8d350b-f93a-48f4-b594-96da2af02919",
                                                "sense_id": "163e2760-bde4-3a56-a30d-57810fa24e39",
                                                "text": "При одном лишь взгляде на О.О. у неё начиналась течка."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "течка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5031abfe-61fc-327a-9a17-d0324d0a634c",
                                        "entry_id": "ea104564-0e69-36b7-af28-df760069ebfe",
                                        "glosses": [
                                            "спец. устройство, предназначенное для перегрузки материала с одного конвейера на другой (в металлургии, горнодобывающей промышленности и т. д.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0dacb0-38f9-46ef-9160-c852502b537d",
                                                "sense_id": "5031abfe-61fc-327a-9a17-d0324d0a634c",
                                                "text": "С целью повышения производительности разгрузочная течка выполнена с перфорацией и снабжена на выходе регулируемой подпружиненной заслонкой."
                                            },
                                            {
                                                "example_id": "be9e34e7-6999-4b48-a7b2-23a4688e2a9e",
                                                "sense_id": "5031abfe-61fc-327a-9a17-d0324d0a634c",
                                                "text": "Измельчаемая среда также подаётся сверху, через фланцевый штуцер (при пневматической загрузке), либо через загрузочную течку (при механической загрузке)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
