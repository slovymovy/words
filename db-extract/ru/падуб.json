                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69f0bd66-49a1-31d0-87a7-0ba951cb1f5c",
                                        "entry_id": "c0ae446c-ac88-3b16-a4f8-69b2752117ac",
                                        "glosses": [
                                            "Any of various shrubs or (mostly) small trees, of the genus Ilex, either evergreen or deciduous, used as decoration especially at Christmas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08b15e55-388a-4fa5-9b76-7464043338d0",
                                                "sense_id": "69f0bd66-49a1-31d0-87a7-0ba951cb1f5c",
                                                "text": "Have a tree or two the witches particularly like, such as the alder, larch, cypress and hemlock; then, to counteract any possible evil effects, there must be a holly, yew, hazel, elder, mountain ash or juniper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3804019d-a20d-3bd6-9c31-ba3cb577d7d8",
                                        "entry_id": "c0ae446c-ac88-3b16-a4f8-69b2752117ac",
                                        "glosses": [
                                            "The wood from this tree."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6b9197f-246a-382b-baeb-a31ea97a51f8",
                                        "entry_id": "c0ae446c-ac88-3b16-a4f8-69b2752117ac",
                                        "glosses": [
                                            "Any of several not closely related plant species likened to Ilex because of their prickly, evergreen foliage and/or round, bright-red berries"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
