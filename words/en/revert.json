{
    "word_family": [
        "reversion",
        "reversionary",
        "revertible"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0581b85e-b669-3781-bca4-a9057d58151a",
                    "sense_definition": "To return to a previous state, habit, or condition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "return_to_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After trying a new routine for a week, he decided to <w>revert</w> to his old habits.",
                            "target_lang_translations": {
                                "ru": "Попробовав новый распорядок в течение недели, он решил <w>вернуться</w> к своим старым привычкам."
                            }
                        },
                        {
                            "text": "If the weather worsens, the system will <w>revert</w> to its safe settings automatically.",
                            "target_lang_translations": {
                                "ru": "Если погода ухудшится, система автоматически <w>вернется</w> к безопасным настройкам."
                            }
                        }
                    ],
                    "synonyms": [
                        "hark back"
                    ],
                    "common_phrases": [
                        "revert to normal",
                        "revert to old ways"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращаться к прежнему состоянию, привычке или условию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращаться",
                                "target_lang_sense_clarification": "к привычкам, состоянию"
                            },
                            {
                                "target_lang_word": "возвращаться к",
                                "target_lang_sense_clarification": "к прежнему состоянию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36bc2cc0-9e56-38c0-92fe-dfb9d32fb0f0",
                    "sense_definition": "To return to a previous topic or subject in conversation or writing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "return_to_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let us <w>revert</w> to our main topic after discussing these brief updates.",
                            "target_lang_translations": {
                                "ru": "Давайте <w>вернемся</w> к нашей главной теме после обсуждения этих кратких новостей."
                            }
                        },
                        {
                            "text": "During the meeting, the speaker was quick to <w>revert</w> to the previous topic.",
                            "target_lang_translations": {
                                "ru": "Во время встречи докладчик быстро <w>вернулся</w> к предыдущей теме."
                            }
                        }
                    ],
                    "synonyms": [
                        "hark back"
                    ],
                    "common_phrases": [
                        "revert to the main point",
                        "revert to the previous topic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращаться к ранее обсуждаемой теме в разговоре или письме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращаться к",
                                "target_lang_sense_clarification": "к прежней теме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e41b12c4-5137-3173-a1c2-f089decc32f4",
                    "sense_definition": "To reply or respond to an email or message.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>revert</w> to me with your feedback as soon as possible.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>ответьте</w> мне с вашим отзывом как можно скорее."
                            }
                        },
                        {
                            "text": "I will check the details and <w>revert</w> back to you by tomorrow.",
                            "target_lang_translations": {
                                "ru": "Я проверю детали и <w>дам ответ</w> к завтрашнему дню."
                            }
                        }
                    ],
                    "common_phrases": [
                        "revert back to you",
                        "revert as soon as possible"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "commonly used in Indian and South Asian English business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отвечать на письмо или сообщение (распространено в деловом английском)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвечать",
                                "target_lang_sense_clarification": "на письмо или сообщение"
                            },
                            {
                                "target_lang_word": "дать ответ",
                                "target_lang_sense_clarification": "связаться с ответом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1c67215-41e8-305c-9a80-fb4d3eb9cff3",
                    "sense_definition": "To restore software, data, or a document to a previous version.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor decided to <w>revert</w> the changes made to the article.",
                            "target_lang_translations": {
                                "ru": "Редактор решил <w>отменить</w> изменения, внесенные в статью."
                            }
                        },
                        {
                            "text": "If the update causes errors, you can easily <w>revert</w> the file.",
                            "target_lang_translations": {
                                "ru": "Если обновление вызывает ошибки, вы можете легко <w>откатить</w> файл."
                            }
                        }
                    ],
                    "common_phrases": [
                        "revert changes",
                        "revert to previous version"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстанавливать программное обеспечение, данные или документ до предыдущей версии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откатывать",
                                "target_lang_sense_clarification": "изменения, версию ПО"
                            },
                            {
                                "target_lang_word": "возвращать",
                                "target_lang_sense_clarification": "к предыдущей версии"
                            }
                        ]
