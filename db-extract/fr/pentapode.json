                                            {
                                                "example_id": "2a004b2a-1409-4bad-b67a-097d909a3d78",
                                                "sense_id": "64946b4d-ec9c-3e85-a98b-c1f4cd1f5f64",
                                                "text": "I loved you. I was a pentapod monster, but I loved you. I was despicable and brutal, and turpid, and everything, mais je t'aimais, je t'aimais!"
                                            },
