                "senses": [
                    {
                        "sense_id": "7dd8f010-44b9-302e-ab66-594e2b6eb757",
                        "entry_id": "31c8319c-5f93-37b8-b9a0-ed9ba1932eea",
                        "glosses": [
                            "smal hoog bouwwerk met bovenin een of meer lui- of slagklokken of een carillon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da0aec9a-43f0-4daf-a093-72b0cc67beae",
                                "sense_id": "7dd8f010-44b9-302e-ab66-594e2b6eb757",
                                "text": "De galmgaten in de klokkentoren hadden geen galmborden."
                            },
                            {
                                "example_id": "939c0749-ded1-43b0-af47-3b758f4c51e4",
                                "sense_id": "7dd8f010-44b9-302e-ab66-594e2b6eb757",
                                "text": "Er ontvouwde zich een geraffineerd panorama bij de bocht. Aan het einde van de kade langs de gracht, die met eenvoudige meerpalen van blank hout was gearceerd, was de slanke boog van de Ponte del Gafaro getekend voor de oudroze gevel van een laag palazzo, die was voorzien van zeven hoge puntige ramen in een witmarmeren sponning en werd bekroond met de klokkentoren van een kerk daarachter."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0788f13-5123-3f8b-a6ec-2f2c66de6231",
                        "entry_id": "31c8319c-5f93-37b8-b9a0-ed9ba1932eea",
                        "glosses": [
                            "smal hoog bouwwerk met bovenin een of meer wijzerplaten van een uurwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91f76719-859f-4730-afca-f5e2c9ce8b37",
                                "sense_id": "c0788f13-5123-3f8b-a6ec-2f2c66de6231",
                                "text": "Tot zes jaar geleden deed de klokkentoren bij het Eindhovense station ook dienst als schoorsteen."
                            }
                        ]
                    }
                ],
