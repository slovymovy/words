{
    "word_family": [
        "adjunction",
        "adjunctive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3f5c57ca-55cf-3325-befa-55fd33bda018",
                    "sense_definition": "To be next to and share a border or wall with something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were sitting in the spacious living area, which <w>adjoins</w> the modern kitchen.",
                            "target_lang_translations": {
                                "zh": "我们坐在宽敞的起居区里，这里与现代化厨房<w>紧邻</w>。"
                            }
                        },
                        {
                            "text": "A narrow garden path separates the two properties that otherwise directly <w>adjoin</w> each other.",
                            "target_lang_translations": {
                                "zh": "一条狭窄的花园小径隔开了这两处本应直接<w>毗连</w>的房产。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abut",
                        "border",
                        "neighbor"
                    ],
                    "common_phrases": [
                        "adjoin each other"
                    ],
                    "target_lang_definitions": {
                        "zh": "与……紧邻；相接；与……毗连"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "毗连",
                                "target_lang_sense_clarification": "指土地、建筑等紧密相连"
                            },
                            {
                                "target_lang_word": "紧邻",
                                "target_lang_sense_clarification": "紧挨着，作动词"
                            },
                            {
                                "target_lang_word": "相接",
                                "target_lang_sense_clarification": "边界或空间彼此挨着"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b65764ba-ef1e-30b3-8539-15f5cdf680cf",
                    "sense_definition": "To extend an algebraic structure by adding a new element and maintaining algebraic closure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "algebra",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In higher algebra, mathematicians can <w>adjoin</w> a root to a field to construct an extension.",
                            "target_lang_translations": {
                                "zh": "在高等代数中，数学家可以向数域中<w>添加</w>一个根来构造扩域。"
                            }
                        },
                        {
                            "text": "If we <w>adjoin</w> an external element to the ring, we must close it under multiplication and addition.",
                            "target_lang_translations": {
                                "zh": "如果我们向环中<w>添加</w>一个外部元素，就必须使其在乘法和加法下封闭。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "adjoin an element",
                        "adjoin a root"
                    ],
                    "target_lang_definitions": {
                        "zh": "（代数学中向数域或代数结构）添加（元素或根）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "添加",
                                "target_lang_sense_clarification": "代数中向域或环添加元素"
                            },
                            {
                                "target_lang_word": "附接",
                                "target_lang_sense_clarification": "数学术语，向代数结构添加新元素"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}