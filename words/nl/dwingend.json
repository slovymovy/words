                    "sense_id": "cfc73428-385d-33b5-99f5-75e456ee6418",
                    "sense_definition": "Met nadruk of dwang opgelegd, geen ruimte latend voor weigering of tegenspraak.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "autoritair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie gaf een <w>dwingend</w> advies om de gevaarlijke zone onmiddellijk te verlaten.",
                            "target_lang_translations": {
                                "en": "The police issued a <w>strongly worded</w> advice to leave the danger zone immediately."
                            }
                        },
                        {
                            "text": "Zijn <w>dwingende</w> toon zorgde ervoor dat iedereen meteen stilhield en luisterde.",
                            "target_lang_translations": {
                                "en": "His <w>imperious</w> tone made everyone stop and listen immediately."
                            }
                        }
                    ],
                    "synonyms": [
