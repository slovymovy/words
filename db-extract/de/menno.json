                                "sense_id": "cf563692-b9af-399a-9eec-dd5267b8725c",
                                "text": "„Menno, ich will auch!“"
                            },
                            {
                                "example_id": "490e4755-c962-4e3a-9bf5-6a0c21f66717",
                                "sense_id": "cf563692-b9af-399a-9eec-dd5267b8725c",
                                "text": "„Och menno! Ich wollte doch die Nummer finden.“"
                            },
