                                "target_lang_sense_clarification": "префикс названия корабля"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Hindistan Donanma Gemisi",
                                "target_lang_sense_clarification": "gemi unvanı"
                            },
                            {
                                "target_lang_word": "INS",
                                "target_lang_sense_clarification": "gemi ön eki"
                            }
                        ]
                    }
