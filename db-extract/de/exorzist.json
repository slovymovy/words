                ],
                "senses": [
                    {
                        "sense_id": "6d479768-11a6-31c9-a274-51524109594d",
                        "entry_id": "0d077e4b-4734-3202-a30a-e7c0c1ecf5fa",
                        "glosses": [
                            "eine (männliche) Person, die Exorzismus durchführt, d. h. Dämonen aus Gegenständen oder Personen austreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c33a36ad-7503-4a7a-961e-daa4f57580c3",
                                "sense_id": "6d479768-11a6-31c9-a274-51524109594d",
                                "text": "„Der Exorzist tritt in eine direkte Kommunikation mit dem unerwünschten Geist oder Dämon und sucht durch dessen Beseitigung eine Reintegration des ‚Besessenen‘ herbeizuführen.“"
                            },
                            {
                                "example_id": "f698db67-b81c-46bb-8c62-e46e8154b12e",
                                "sense_id": "6d479768-11a6-31c9-a274-51524109594d",
                                "text": "„Beim Fortgehen sagte Pater Prospero zum Doktor, das Mädchen sei ohne Zweifel besessen, aber man müsse einen andern Exorzisten holen, da Gott offenbar nicht ihm die Gnade zuteil werden lasse, sie zu erlösen.“"
                            },
                            {
                                "example_id": "6186d73b-9b7f-4d45-a767-81d7a711e684",
                                "sense_id": "6d479768-11a6-31c9-a274-51524109594d",
                                "text": "„Die populären Exorzisten verstanden sich letztlich eher als Heiler denn als Kirchenmänner.“"
                            },
                            {
                                "example_id": "da43a698-427f-457a-9f57-ce4a2053284a",
                                "sense_id": "6d479768-11a6-31c9-a274-51524109594d",
                                "text": "„Ben war wie ein Exorzist gewesen, der die Geister der Vergangenheit in Schach hielt mit seinen Fragen, seiner Neugier, seinem Wunsch, eine alte Karte ausfindig zu machen und ein Abenteuer mit mir zu bestreiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d6d232b3-1c2b-3745-9a17-f11d020b0068",
                        "entry_id": "0d077e4b-4734-3202-a30a-e7c0c1ecf5fa",
                        "glosses": [
                            "niedere Weihe, die die Ausführung von Exorzismen erlaubte"
                        ],
                        "tags": [
