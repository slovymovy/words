                                        "glosses": [
                                            "sowohl der/die/das eine als auch der/die/das andere; auch adverbial gebraucht"
                                        ],
                                        "tags": [
                                            "Indefinitpronomen",
                                            "zeigt an",
                                            "dass es sich nicht nur um einen der zwei in Frage kommenden Gegenstände handelt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d41b154-950e-43fe-8b0d-ca4214fe31d4",
                                                "sense_id": "42a4cf01-880b-3583-8bcc-dcc8009b7058",
                                                "text": "Wie, ich kann statt Papas auch Mamas Auto benutzen, beide Autos sind kaputt!"
                                            },
                                            {
                                                "example_id": "002ecbd5-9025-47fb-ae27-80d6a3c535af",
                                                "sense_id": "42a4cf01-880b-3583-8bcc-dcc8009b7058",
                                                "text": "Die Eltern sind nicht zu Hause. Beide müssen arbeiten."
                                            },
                                            {
                                                "example_id": "0a8f1004-1166-4559-a483-ef4bad737ecb",
                                                "sense_id": "42a4cf01-880b-3583-8bcc-dcc8009b7058",
                                                "text": "„Frauen wird [in China] vermittelt: Entweder wollt ihr heiraten oder einen PhD, beides geht nicht. Ein Mann wird keine Frau heiraten, die erfolgreicher ist als er.“"
                                            },
                                            {
                                                "example_id": "c1c143fb-0539-4f01-8e1a-6338d18131de",
                                                "sense_id": "42a4cf01-880b-3583-8bcc-dcc8009b7058",
                                                "text": "(Adverb:) Ihr habt beide recht."
                                            },
                                            {
                                                "example_id": "6782efc3-1712-4a06-9372-2316e8c171d9",
                                                "sense_id": "42a4cf01-880b-3583-8bcc-dcc8009b7058",
                                                "text": "„Dieses beide in ihm, die Unendlichkeit, und die Endlichkeit sollen vereinigt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82e19a9d-4b5c-33c0-aa29-82340bc04650",
                                        "entry_id": "e169753c-803f-3373-8119-4cb86374a6c1",
                                        "glosses": [
                                            "zwei"
                                        ],
                                        "tags": [
                                            "Numerale",
                                            "betont",
                                            "dass die Zweizahl des Gezählten allgemein oder aus dem Vorhererwähnten bekannt ist",
                                            "steht anstelle von"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "845da9f9-a833-463e-aa0b-f141e04ffa25",
                                                "sense_id": "82e19a9d-4b5c-33c0-aa29-82340bc04650",
                                                "text": "Ihr beiden habt recht."
                                            },
                                            {
                                                "example_id": "9081bacf-c6a3-42be-b7af-af0a89b391ef",
                                                "sense_id": "82e19a9d-4b5c-33c0-aa29-82340bc04650",
                                                "text": "Kennst du diese beiden?"
                                            },
                                            {
                                                "example_id": "60866636-dfde-4ae3-a213-8a4e1f9e4387",
                                                "sense_id": "82e19a9d-4b5c-33c0-aa29-82340bc04650",
                                                "text": "Ich kann mich nicht entscheiden, ob ich die beiden da möchte oder doch lieber die drei da."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
