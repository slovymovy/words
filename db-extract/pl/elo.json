                                "target_senses": [
                                    {
                                        "sense_id": "d1e6d481-a84d-3505-a8b2-f9ff95348533",
                                        "entry_id": "b336bd97-780e-3860-aa3a-2eb5b83afdd2",
                                        "glosses": [
                                            "A friendly, informal, casual greeting said upon someone's arrival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63ade0ff-68bc-4b82-8248-eb74c97c24f6",
                                                "sense_id": "d1e6d481-a84d-3505-a8b2-f9ff95348533",
                                                "text": "Hi, how are you?"
                                            },
                                            {
                                                "example_id": "7a981c8f-6d30-41e5-b922-e7ccbdf644bd",
                                                "sense_id": "d1e6d481-a84d-3505-a8b2-f9ff95348533",
                                                "text": "I just dropped by to say “hi”."
                                            },
                                            {
                                                "example_id": "6d20b2da-500d-4263-8ea3-e96fa885de0f",
                                                "sense_id": "d1e6d481-a84d-3505-a8b2-f9ff95348533",
                                                "text": "Anna: Pete, hi! Hi, we are here! — Pete: Hi, Anna! Hi, Marsha! — Anna: Hi! — Pete: How are you two? — Marsha: I am great!"
                                            },
                                            {
                                                "example_id": "0489f6ba-1f90-4f82-9d25-01202064064c",
                                                "sense_id": "d1e6d481-a84d-3505-a8b2-f9ff95348533",
                                                "text": "When out on the prairie, up galloped an Indian on his pony with his saluting \"hi!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35e5ea11-f625-38ec-b07a-d200c9eddfd4",
                                        "entry_id": "b336bd97-780e-3860-aa3a-2eb5b83afdd2",
                                        "glosses": [
                                            "An exclamation to call attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bd91f6e-c0f5-4e5d-bd4c-dfb1d8c7f784",
                                                "sense_id": "35e5ea11-f625-38ec-b07a-d200c9eddfd4",
                                                "text": "I made a speaking trumpet of my hands and commenced to whoop “Ahoy!” and “Hello!” at the top of my lungs. […] The Colonel woke up, and, after asking what in brimstone was the matter, opened his mouth and roared “Hi!” and “Hello!” like the bull of Bashan."
                                            },
                                            {
                                                "example_id": "41672de9-de5f-41c8-bd02-be37a01bcb9e",
                                                "sense_id": "35e5ea11-f625-38ec-b07a-d200c9eddfd4",
                                                "text": "'Come back now!' shouted Sam. 'Hi! Come back!' But Gollum had vanished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c44dc12-58c7-3b2f-9836-7b8152ebb5ff",
                                        "entry_id": "b336bd97-780e-3860-aa3a-2eb5b83afdd2",
                                        "glosses": [
                                            "Expressing wonder or derision."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f63150cf-39f2-32a6-a00c-4f9099925aae",
                                        "entry_id": "da26b66f-e02d-3f02-8435-9b7f1fc6dfab",
                                        "glosses": [
                                            "The word \\\"hi\\\" used as a greeting."
                                        ],
