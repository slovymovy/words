                "senses": [
                    {
                        "sense_id": "32c10405-92a6-329f-bd27-1670aa5e3e88",
                        "entry_id": "4114da32-77e6-3c9f-8417-035d29cabe0b",
                        "glosses": [
                            "To style or arrange hair."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a400483f-f878-44f2-8473-6e6b479d8d62",
                                "sense_id": "32c10405-92a6-329f-bd27-1670aa5e3e88",
                                "text": "Perfectly coiffured and seemingly imperturbable, Setsuko approaches madness as her psychological and sexual insecurities are dredged up by confrontations with her past and mind games with the suspected murderer."
                            },
                            {
                                "example_id": "7d4222d1-ead6-484f-af2e-4c9b1cd38454",
                                "sense_id": "32c10405-92a6-329f-bd27-1670aa5e3e88",
                                "text": "Her eyes seldom left for long the other end of the table, where Stephanie, at Dominey's left hand, with her crown of exquisitely coiffured red-gold hair, her marvellous jewellery, her languorous grace of manner, seemed more like one of the beauties of an ancient Venetian Court than a modern Hungarian Princess gowned in the Rue de la Paix."
                            },
                            {
                                "example_id": "bfa36460-fe60-456a-a4df-f305c5d8d27c",
                                "sense_id": "32c10405-92a6-329f-bd27-1670aa5e3e88",
                                "text": "Her hair was far less elaborately coiffured and her toilette less magnificent than the toilettes of the women by whom she was surrounded."
                            },
                            {
                                "example_id": "b1fe0714-149f-4644-83da-956a1b29fb4e",
                                "sense_id": "32c10405-92a6-329f-bd27-1670aa5e3e88",
                                "text": "Her attire is rich, she wears costly jewels, and her hair is tastefully coiffured."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
