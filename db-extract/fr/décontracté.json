                "senses": [
                    {
                        "sense_id": "e61c429b-b12f-38b1-a03a-ec325731e818",
                        "entry_id": "adb530d8-1118-3343-bad9-6c67e7a726b9",
                        "glosses": [
                            "Qui fait preuve d’aisance, d’apaisement, qui est détendu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a6823bc-b8a3-4c2f-bf11-8426e3d9caa4",
                                "sense_id": "e61c429b-b12f-38b1-a03a-ec325731e818",
                                "text": "Il n’empêche que Gus McCrae, lui, était vraiment décontracté, peut-être le type le plus décontracté que Call eût jamais connu - et il avait connu pas mal de types qui n’avaient pas froid aux yeux."
                            },
                            {
                                "example_id": "d38d2a68-bb48-4c3b-a512-b913396101b8",
                                "sense_id": "e61c429b-b12f-38b1-a03a-ec325731e818",
                                "text": "Une allure décontractée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e5c6f74-563b-4083-bd9c-a220e6541aa8",
                        "source_entry_id": "adb530d8-1118-3343-bad9-6c67e7a726b9",
                        "source_sense_id": "e61c429b-b12f-38b1-a03a-ec325731e818",
                        "target_lang_word": "easy-going",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "easy-going",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2be552f-702e-3056-a328-be2754c1c2b5",
                                        "entry_id": "50093024-7df9-3e40-93ff-0edaa4bac83e",
                                        "glosses": [
                                            "Alternative spelling of easygoing."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f958b2-fcfb-4981-8b18-95c13042d6fb",
                                                "sense_id": "a2be552f-702e-3056-a328-be2754c1c2b5",
                                                "text": "In short, the old town—the lovablest, old-timiest, easy-goingest old town that ever was—sits there by the River, hugging its traditions, and hoarding its stories, of which it has enough to make a new Thousand and One Nights."
                                            },
                                            {
                                                "example_id": "eeceef3e-35b8-4846-be6b-c59938b76d25",
                                                "sense_id": "a2be552f-702e-3056-a328-be2754c1c2b5",
                                                "text": "He dropped gradually back into his old frivolous and easy-going ways and conditions of feeling and manner of speech, and no familiar of his could have detected anything in him that differentiated him from the weak and careless Tom of other days."
                                            },
                                            {
                                                "example_id": "107b84e5-0647-45f8-83d7-1a814ea5d36a",
                                                "sense_id": "a2be552f-702e-3056-a328-be2754c1c2b5",
                                                "text": "The Eskimo is a nobler, cheerfuller and easy-goinger person than we smug civilized citizens have always imagined. Rockwell Kent, the noted Eskimophile, claims they are a polite and happy race."
                                            },
                                            {
                                                "example_id": "1ed45916-e6fa-4c00-b591-eb50d1d244c4",
                                                "sense_id": "a2be552f-702e-3056-a328-be2754c1c2b5",
                                                "text": "The easy-goingest mushroom grower I know is a remarkable Florida lady named Rachel Jackson. She lives on the Linger Longer Ranch at Barberville, Florida, and is always looking for sharecroppers who will come trailer and all and help garden her land in return for three-quarters of the produce."
                                            },
                                            {
                                                "example_id": "d0968d42-4e1c-4c46-a563-15199ac3f081",
                                                "sense_id": "a2be552f-702e-3056-a328-be2754c1c2b5",
                                                "text": "Having chatted to the guys, I am impressed with the really positive easy-going atmosphere."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
