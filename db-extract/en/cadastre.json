                    },
                    {
                        "translation_id": "6ba35e25-82a4-4cbb-9f38-10578221c5f0",
                        "source_entry_id": "b39de704-4fdb-35e9-99b8-24bb8ebf8a26",
                        "source_sense_description": "cartography: a public survey of land",
                        "target_lang_word": "Kataster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kataster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60f316fe-78b5-3c9c-b831-d37a83795859",
                                        "entry_id": "4cb9acd0-7323-3aa7-adf5-58970f501ab1",
                                        "glosses": [
                                            "Verzeichnis, in dem alle Flurstücke nach ihrer Lage, Nutzung, Größe und so weiter verzeichnet und kartographisch dargestellt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf36141-6e30-4b52-8258-17ea014e3f9a",
                                                "sense_id": "60f316fe-78b5-3c9c-b831-d37a83795859",
                                                "text": "Die dauernde Festlegung und Dokumentation der Grundstücksgrenze geschieht im Kataster."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9688f2e-e4ce-344d-adfb-759cb6937f0f",
                                        "entry_id": "4cb9acd0-7323-3aa7-adf5-58970f501ab1",
                                        "glosses": [
                                            "andere Verzeichnisse, in denen Stoffe, Objekte oder Lebewesen erfasst und kategorisiert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e433916-8a52-4a65-9aa6-628b6b4f49b3",
                                                "sense_id": "d9688f2e-e4ce-344d-adfb-759cb6937f0f",
                                                "text": "Auch jede andere systematische Erfassung und Aufstellung kann als Kataster bezeichnet werden, etwa ein Baumkataster oder Weinkataster."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c4716f8-b44b-4c59-a2f8-b749d8b25c41",
                        "source_entry_id": "b39de704-4fdb-35e9-99b8-24bb8ebf8a26",
                        "source_sense_description": "cartography: a public survey of land",
                        "target_lang_word": "када́стр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "када́стр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "acf25db5-7b33-35cc-8d30-c59c6b3887c3",
                                        "entry_id": "d3737340-bb80-3502-a5bb-8e70dcfff438",
                                        "glosses": [
                                            "книжн. опись чего-либо, свод сведений о чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4a9c66c-9989-4002-b0ef-f1caa96a5b9d",
                                                "sense_id": "acf25db5-7b33-35cc-8d30-c59c6b3887c3",
                                                "text": "Поземельный кадастр древнеперсидского царя Дария I делил всю страну на 20 частей (сатрапий) и назначал для каждой из них ежегодную поставку для царского двора и войска сельскохозяйственных продуктов, лошадей и мулов."
                                            },
                                            {
                                                "example_id": "037c47de-450f-4816-b4d8-b1455acdaa76",
                                                "sense_id": "acf25db5-7b33-35cc-8d30-c59c6b3887c3",
                                                "text": "Податные кадастры, полиптики и картулярии постоянно упоминают важнейшие праздники, служившие моментами начала или окончания сдачи оброков, пахоты и жатвы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "559025de-0cd9-3269-a5be-8d0340c28432",
                                        "entry_id": "d3737340-bb80-3502-a5bb-8e70dcfff438",
                                        "glosses": [
                                            "книжн. систематизированный перечень сведений о количественном и качественном состоянии каких-либо природных ресурсов, их экономическая, экологическая и т. п. оценка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc1b725f-523d-4be7-a446-c3496963cbe2",
                                                "sense_id": "559025de-0cd9-3269-a5be-8d0340c28432",
                                                "text": "Государственный реестр договоров должен соответствовать данным государственного водного кадастра, а также государственной регистрации лицензий на водопользование и распорядительных лицензий."
                                            },
                                            {
                                                "example_id": "a69bb886-0ee5-496a-992d-b1c1048016ef",
                                                "sense_id": "559025de-0cd9-3269-a5be-8d0340c28432",
                                                "text": "Государственный учёт животных и их использования и ведение государственного кадастра животного мира осуществляются за счёт государства по единым для Союза ССР системам."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
