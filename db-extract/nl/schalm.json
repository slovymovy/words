                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "link",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40cce546-f45a-397a-b6ce-c4c1fa8ac351",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "A connection between places, people, events, things, or ideas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4123f670-bc4e-4b42-aaa6-22e1d7852f8f",
                                                "sense_id": "40cce546-f45a-397a-b6ce-c4c1fa8ac351",
                                                "text": "The mayor’s assistant serves as the link to the media."
                                            },
                                            {
                                                "example_id": "71f45cbf-110c-43bc-84ff-1722fd56638e",
                                                "sense_id": "40cce546-f45a-397a-b6ce-c4c1fa8ac351",
                                                "text": "The link of brotherhood, by which / One common Maker bound me to the kind."
                                            },
                                            {
                                                "example_id": "9b88be50-7801-40dc-a8d4-4f6e70d086ac",
                                                "sense_id": "40cce546-f45a-397a-b6ce-c4c1fa8ac351",
                                                "text": "And so by double lynkes enchaynde themselues in louers life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe6888d-3510-39ec-89ec-59ab8c11a02f",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "One element of a chain or other connected series."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a42ee489-8c5a-4907-bae3-88dc7dc7be70",
                                                "sense_id": "ebe6888d-3510-39ec-89ec-59ab8c11a02f",
                                                "text": "The third link of the silver chain needs to be resoldered."
                                            },
                                            {
                                                "example_id": "155f7c43-e26e-4c9d-bb33-d4cc53264eae",
                                                "sense_id": "ebe6888d-3510-39ec-89ec-59ab8c11a02f",
                                                "text": "The weakest link."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "315e50fb-4c81-3bf2-96f4-3d1a44e81aa3",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "Abbreviation of hyperlink."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76c514eb-de65-419d-80bd-204dee3eab5b",
                                                "sense_id": "315e50fb-4c81-3bf2-96f4-3d1a44e81aa3",
                                                "text": "The link on the page points to the sports scores."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8e7de88-6437-3e3d-9f21-5247a0c930f2",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "The connection between buses or systems."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c577129-6498-4568-b98a-a6cd2963b852",
                                                "sense_id": "c8e7de88-6437-3e3d-9f21-5247a0c930f2",
                                                "text": "A by-N-link is composed of N lanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "999dbd95-b8e8-3fb2-989d-a30ec62b9062",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "A space comprising one or more disjoint knots."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b19615dc-030e-3b66-8db6-a55828e1c2f1",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "A thin wild bank of land splitting two cultivated patches and often linking two hills."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2b702a4-e809-4c41-b3bc-1c09a62f7cc1",
                                                "sense_id": "b19615dc-030e-3b66-8db6-a55828e1c2f1",
                                                "text": "They used formerly to live in caves or huts dug into the side of a bank or \"link,\" and lined with heath or straw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2828297-88e1-3834-a9ba-87ed780a5eed",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "An individual person or element in a system"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b33ba383-c47a-4b5e-b6ff-8d4d461fe29f",
                                                "sense_id": "d2828297-88e1-3834-a9ba-87ed780a5eed",
                                                "text": "But know that God is the strongest link."
                                            },
                                            {
                                                "example_id": "11e4d637-5a88-4d73-916b-8270c38aa2ad",
                                                "sense_id": "d2828297-88e1-3834-a9ba-87ed780a5eed",
                                                "text": "The fuse is the weakest link in the system. As such, the fuse is also the most valuable link in the system."
                                            },
                                            {
                                                "example_id": "7bf5c50e-0a0e-47c9-b5f2-e0ba12cd01e7",
                                                "sense_id": "d2828297-88e1-3834-a9ba-87ed780a5eed",
                                                "text": "“[…] This is so that nobody can change the way every link must talk about the formula that I taught to make a real Chain of Universal Love and not a Chain of Love of a group or sect.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3215a7f9-52fd-3ddf-998a-37d10088fd19",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "Anything doubled and closed like a link of a chain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d861acd-f59a-4c67-8e4b-2c1f15cca9c1",
                                                "sense_id": "3215a7f9-52fd-3ddf-998a-37d10088fd19",
                                                "text": "a link of horsehair"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e75583c4-2568-3750-9e8a-37e76db92dea",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "A sausage that is not a patty."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e03ba2c4-15bc-33a6-8618-3f84decacf37",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "Any one of the several elementary pieces of a mechanism, such as the fixed frame, or a rod, wheel, mass of confined liquid, etc., by which relative motion of other parts is produced and constrained."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39c040b1-d3e7-375e-99b6-2331cc857787",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "Any intermediate rod or piece for transmitting force or motion, especially a short connecting rod with a bearing at each end; specifically (in steam engines) the slotted bar, or connecting piece, to the opposite ends of which the eccentric rods are jointed, and by means of which the movement of the valve is varied, in a link motion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f29b956-1967-36ab-b9e6-2cf240600706",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "The length of one joint of Gunter's chain, being the hundredth part of it, or 7.92 inches, the chain being 66 feet in length."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c26a2b4f-b2e1-340f-b4a8-9c8b41bb2e09",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "A bond of affinity, or a unit of valence between atoms; applied to a unit of chemical force or attraction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e36eb72d-0163-3d86-ad25-aede2924d7e7",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "The windings of a river; the land along a winding stream."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e0f782b-3482-4b39-8033-04728fed7f0f",
                                                "sense_id": "e36eb72d-0163-3d86-ad25-aede2924d7e7",
                                                "text": "'Dame Foljambe,' said the old man, 'the march of thy tale is like the course of the Wye, seventeen miles of links and windings down a fair valley five miles long. […]'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adc4ffda-74ba-3c9b-94d0-0dcd9c2b9cf7",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "An introductory cue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "084a6a24-17a9-4bc1-afc4-c8dadc511aa5",
                                                "sense_id": "adc4ffda-74ba-3c9b-94d0-0dcd9c2b9cf7",
                                                "text": "Too much talk on a music-based station can cause listeners who tune in for the music to go elsewhere. […] 'Some people will say “your link has to be 45 seconds long” but I don't do that,' explains the programme controller of Trent FM, Dick Stone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "link",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5c4c911-674e-377b-8b6a-d269a5b6fb27",
                                        "entry_id": "098bb669-81e8-3253-acd4-4113771134fd",
                                        "glosses": [
                                            "To connect (two or more things)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5527c1cb-f964-45b4-84e8-2db96517a6ce",
                                                "sense_id": "e5c4c911-674e-377b-8b6a-d269a5b6fb27",
                                                "text": "All the tribes and nations that composed it [the Roman Empire] were linked together, not only by the same laws and the same government, but by all the facilities of commodious intercourse, and of frequent communication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a51442f4-1550-3be0-a2c3-befedc6a102f",
                                        "entry_id": "098bb669-81e8-3253-acd4-4113771134fd",
                                        "glosses": [
                                            "To contain a hyperlink to another page."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0081d66b-cc9e-4dda-b2c0-b0b9b227f202",
                                                "sense_id": "a51442f4-1550-3be0-a2c3-befedc6a102f",
                                                "text": "My homepage links to my wife's."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01b53779-fa1c-3e54-9bde-56ea5ae55a61",
                                        "entry_id": "098bb669-81e8-3253-acd4-4113771134fd",
                                        "glosses": [
                                            "To supply (someone) with a hyperlink; to direct by means of a link."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "799edc75-680c-4a09-9180-3195cc70d3d8",
                                                "sense_id": "01b53779-fa1c-3e54-9bde-56ea5ae55a61",
                                                "text": "Haven't you seen his website? I'll link you to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aa8f61e-b883-3ac7-a7cd-b639f3e4e345",
                                        "entry_id": "098bb669-81e8-3253-acd4-4113771134fd",
                                        "glosses": [
                                            "To post a hyperlink to."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f80f46af-566d-4899-a6e2-2e0e5c8d657a",
                                                "sense_id": "4aa8f61e-b883-3ac7-a7cd-b639f3e4e345",
                                                "text": "Stop linking those unfunny comics all the time!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f850cb55-bf05-3109-9c90-c670a03a82a2",
                                        "entry_id": "098bb669-81e8-3253-acd4-4113771134fd",
                                        "glosses": [
                                            "To demonstrate a correlation between (two things)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e87dadc9-68f0-3206-bcd6-9e52da5ffc8c",
                                        "entry_id": "098bb669-81e8-3253-acd4-4113771134fd",
                                        "glosses": [
                                            "To combine objects generated by a compiler into a single executable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "732c06a3-5858-3085-b1e5-535ef4f84a5c",
                                        "entry_id": "098bb669-81e8-3253-acd4-4113771134fd",
                                        "glosses": [
                                            "To meet with (someone)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9944338b-36b4-4a5c-9d74-93b7ae75a908",
                                                "sense_id": "732c06a3-5858-3085-b1e5-535ef4f84a5c",
                                                "text": "Linked us, now she don't wanna link them man again / Your ex plays in the Prem but you never see him taking a pen"
                                            },
                                            {
                                                "example_id": "1ea5a05a-a060-4bf6-acae-d4291b4a1067",
                                                "sense_id": "732c06a3-5858-3085-b1e5-535ef4f84a5c",
                                                "text": "I might link my ting from Barkin'"
                                            },
                                            {
                                                "example_id": "fe376820-e878-4a54-ad0b-c8dfdf09dabc",
                                                "sense_id": "732c06a3-5858-3085-b1e5-535ef4f84a5c",
                                                "text": "Same old questions, what's your body count?\nWho were you linkin' before me?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "link",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b27622e-f68d-3d64-8898-28b3f32de68a",
                                        "entry_id": "3f884ee1-f5fc-36fd-a0f3-e757adae0b09",
                                        "glosses": [
                                            "A torch, used to light dark streets."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aec09d89-61dc-4430-8e23-624d0e8c25fa",
                                                "sense_id": "6b27622e-f68d-3d64-8898-28b3f32de68a",
                                                "text": "Thou hast saved me a thousand marks in links and torches"
                                            },
                                            {
                                                "example_id": "e651d766-0490-4a48-a747-a4dd465706c1",
                                                "sense_id": "6b27622e-f68d-3d64-8898-28b3f32de68a",
                                                "text": "You were coming out of the Italian Opera, ma’am, in white satin and jewels, a blaze of splendour, when I hadn’t a penny to buy a link to light you.’"
                                            },
                                            {
                                                "example_id": "dff8f0a2-89dd-4c94-86f7-9310d35932e6",
                                                "sense_id": "6b27622e-f68d-3d64-8898-28b3f32de68a",
                                                "text": "Give me a loan of the link, Dick."
                                            }
                                        ]
                                    }
                                ]
                            },
