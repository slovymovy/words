{
    "word_family": [
        "personify",
        "personifier",
        "person"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                    "sense_definition": "A person or thing that perfectly represents or embodies a specific quality or idea.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "embodiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The retired general was the very <w>personification</w> of discipline and honor."
                        },
                        {
                            "text": "She seemed to be the <w>personification</w> of politeness whenever guests visited their house."
                        }
                    ],
                    "synonyms": [
                        "embodiment",
                        "epitome",
                        "incarnation"
                    ],
                    "common_phrases": [
                        "personification of evil",
                        "personification of elegance",
                        "very personification of"
                    ]
                },
                {
                    "sense_id": "b52182ef-99ae-3a33-9a59-09c0f3235d9d",
                    "sense_definition": "A literary device or figure of speech in which human qualities are attributed to an animal, object, or concept.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "literary_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet used <w>personification</w> when describing how the hungry sea swallowed the ship."
                        },
                        {
                            "text": "Describing the wind as whispering softly is an effective example of <w>personification</w>."
                        }
                    ],
                    "synonyms": [
                        "anthropomorphism"
                    ],
                    "common_phrases": [
                        "use of personification",
                        "example of personification"
                    ]
                },
                {
                    "sense_id": "6b5cf9ed-6530-3d17-9192-4dce304525c5",
                    "sense_definition": "The artistic representation of an abstract idea or concept in the form of a human figure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "embodiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Grim Reaper is widely recognized as a <w>personification</w> of death."
                        },
                        {
                            "text": "In ancient Roman art, the goddess Victoria stood as a human <w>personification</w> of victory."
                        }
                    ],
                    "common_phrases": [
                        "artistic personification",
                        "personification of death"
                    ]
                }
            ]
        }
    ]
}