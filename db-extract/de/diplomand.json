                        "glosses": [
                            "Student, der gerade dabei ist, seine Abschlussarbeit zu schreiben, wenn er zur Erlangung des akademischen Grades ‚Diplom‘ studiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b307ae3-d9c2-415c-9d58-f908196fa55c",
                                "sense_id": "5b7fd722-5ec0-3378-a57a-5f44beae6353",
                                "text": "Der Diplomand wird während des Schreibens seiner Diplomarbeit von einem Professor betreut."
                            },
                            {
                                "example_id": "f64d6c7f-856f-43c6-80a2-1fecda3c8f88",
                                "sense_id": "5b7fd722-5ec0-3378-a57a-5f44beae6353",
                                "text": "Das VW-Werk in Wolfsburg beispielsweise bietet Praktikanten, Diplomanden und Doktoranden unverändert rund 2000 Stellen im Jahr."
                            }
                        ],
