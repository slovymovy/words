                        "source_entry_id": "6153e64f-fdd1-3a58-8e38-b86ac92b0daa",
                        "source_sense_description": "a straight line which a curve approaches arbitrarily closely",
                        "target_lang_word": "asymptote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
