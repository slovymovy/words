                "senses": [
                    {
                        "sense_id": "f793410c-e075-3d18-9a8b-a92e45ccfba4",
                        "entry_id": "7a260841-dcee-33cd-a04b-03372ea1ae47",
                        "glosses": [
                            "Travail."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "960d3ee7-2ef9-4ae1-a812-164dfd1b6759",
                                "sense_id": "f793410c-e075-3d18-9a8b-a92e45ccfba4",
                                "text": "Mettre en commun l'amour le fric et le turbin"
                            },
                            {
                                "example_id": "4cf0ca61-2c1c-481a-959b-5244968cdbfc",
                                "sense_id": "f793410c-e075-3d18-9a8b-a92e45ccfba4",
                                "text": "Je suis l’plombier bier-bier-bier-bier\nJ’ai un beau métier\nJ’fais mon turbin bin-bin-bin-bin\nDans les salles de bains"
                            },
                            {
                                "example_id": "5adf2f52-467d-46f5-a705-d84ca758ff39",
                                "sense_id": "f793410c-e075-3d18-9a8b-a92e45ccfba4",
                                "text": "Je suis snob / C'est vraiment le seul défaut que je gobe / Ça demande des mois de turbin / C'est une vie de galérien …"
                            },
                            {
                                "example_id": "0c68e429-3852-471e-804c-80caa8615ffa",
                                "sense_id": "f793410c-e075-3d18-9a8b-a92e45ccfba4",
                                "text": "Le turbin c'est le turbin, non?"
                            }
                        ]
                    },
                    {
                        "sense_id": "0948e499-5467-3303-b905-04c7d9381329",
                        "entry_id": "7a260841-dcee-33cd-a04b-03372ea1ae47",
                        "glosses": [
                            "Prostitution par racolage."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "53dda133-fa0e-4f7f-b7c4-674cc3011f4e",
                                "sense_id": "0948e499-5467-3303-b905-04c7d9381329",
                                "text": "Elle est au turbin, sur le turbin."
                            },
                            {
                                "example_id": "24026746-1cfb-4cb3-978f-8c0d716a6bb8",
                                "sense_id": "0948e499-5467-3303-b905-04c7d9381329",
                                "text": "– Je t’ai toujours menti, Mado. Dès notre première rencontre je pensais qu’à te mettre au turbin. Les mots doux, les “je t’aime”, c’était pour te faire avaler le morceau. Moi, j’pensais qu’à la galette."
                            }
                        ]
                    }
