                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c46ff162-1f2e-4224-ae2d-8d9db3facce4",
                                "sense_id": "cd4dd23a-5d64-37d0-8067-5cf8b38e4717",
                                "text": "Przez ponad piętnaście lat tworzyłem soft dla maklerów."
                            }
                        ],
