                                        "glosses": [
                                            "Preventing or countering tremors."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "069ddae4-e467-431a-b02b-7355add7bdbb",
                                                "sense_id": "c1ae8b54-8958-3e20-b129-78610d435696",
                                                "text": "We have observed that treatment with bromocriptine and levodopa prolongs the antitremor effectiveness of levodopa in monkeys with unilateral VMT lesions of the brain stem."
                                            }
                                        ]
                                    }
                                ]
