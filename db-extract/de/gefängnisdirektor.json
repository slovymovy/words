                "senses": [
                    {
                        "sense_id": "61b284d6-43df-3ef0-b65b-b8d196e6d6de",
                        "entry_id": "09167b1d-b906-3668-b806-6417b1939322",
                        "glosses": [
                            "Leiter eines Gefängnisses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e9eb73c-9efc-43fa-92f5-34f2c0f8a7ea",
                                "sense_id": "61b284d6-43df-3ef0-b65b-b8d196e6d6de",
                                "text": "„Er arbeitet seit fast zwei Jahrzehnten als Gefängnisdirektor, immer im Osten, obwohl er aus dem Westen ist.“"
                            },
                            {
                                "example_id": "f7042685-f2fc-4ccf-a914-a43c6aa18147",
                                "sense_id": "61b284d6-43df-3ef0-b65b-b8d196e6d6de",
                                "text": "„Der Gefängnisdirektor fragte, was mit den Sträflingen geschehen solle.“"
                            },
                            {
                                "example_id": "d47e1a7b-47b5-4e87-896b-0d739bf3c951",
                                "sense_id": "61b284d6-43df-3ef0-b65b-b8d196e6d6de",
                                "text": "„Zum fünfzigjährigen Jubiläum will der Gefängnisdirektor ein Fest veranstalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
