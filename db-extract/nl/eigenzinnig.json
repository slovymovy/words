                                        "entry_id": "049ec7f5-8b14-3e6b-8d71-c92228fe03ab",
                                        "glosses": [
                                            "A person who is recalcitrant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
