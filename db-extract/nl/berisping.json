                                                "example_id": "51b0edde-3a95-4015-8907-db0e2e33f9a9",
                                                "sense_id": "7c61c54b-0883-37ca-b071-0fa63693349a",
                                                "text": "Die Verweise auf den Originaltext finden sie im Literaturverzeichnis."
                                            },
