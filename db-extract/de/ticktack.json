                ],
                "translations": [
                    {
                        "translation_id": "99b7aa8a-a95a-4104-921a-f2eab118dbe0",
                        "source_entry_id": "9157f8d6-3cba-32f8-812f-af9b9b998aac",
                        "source_sense_id": "9bd73da4-2162-3428-9b53-ac349e231d7f",
                        "source_sense_description": "onomatopoetische Nachahmung eines mechanischen Uhrwerks",
                        "target_lang_word": "tick-tock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tick-tock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a161887f-22e2-3279-bd81-7604198ebb4c",
                                        "entry_id": "06b5e811-51d2-3a20-8593-afa55dd36880",
                                        "glosses": [
                                            "The sound of the ticking of an analog clock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7d86d9e-106f-31f1-8aca-4dbd56e4e5f3",
                                        "entry_id": "06b5e811-51d2-3a20-8593-afa55dd36880",
                                        "glosses": [
                                            "A warning of some fateful impending event."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "800c904a-9213-4877-be51-bcbb34e40fe6",
                                                "sense_id": "f7d86d9e-106f-31f1-8aca-4dbd56e4e5f3",
                                                "text": "Near-synonym: clock is ticking"
                                            },
                                            {
                                                "example_id": "b4830091-895f-47e6-a701-0813e94af1fa",
                                                "sense_id": "f7d86d9e-106f-31f1-8aca-4dbd56e4e5f3",
                                                "text": "You may be smart enough to elude the law for five years, but your time has run out. Tick tock, motherfucker."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tick-tock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47a3442e-bfa4-3851-befe-ddcad6e1d354",
                                        "entry_id": "92ce8f30-d187-32bf-8434-6c4536c15fe0",
                                        "glosses": [
                                            "To make continual clicking sounds like those of an analog clock; to tick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a89311d5-5875-4223-b717-ed6759b1f645",
                                                "sense_id": "47a3442e-bfa4-3851-befe-ddcad6e1d354",
                                                "text": "And so as the clock tick-tocked along at MetLife Stadium on Friday night, the possibility grew into the probability that this frustrating, scoreless quarterfinal between Colombia and Peru would end up in one of those unfortunate, nearly random shootout results."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57856f8f-4b56-36b1-8fe1-649852db5b15",
                                        "entry_id": "92ce8f30-d187-32bf-8434-6c4536c15fe0",
                                        "glosses": [
                                            "When marching, to swing arms and legs on the same side at the same time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b971f3f-9600-4507-8f01-907451ae1450",
                                                "sense_id": "57856f8f-4b56-36b1-8fe1-649852db5b15",
                                                "text": "Ex-military didn't pass up the chance to harshly criticise the mediocre stepping, noting their \"tick-tocking\" technique which is a term used in the army, describing moving arm and leg on the same side in the same direction while marching."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tick-tock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5fa5cb8-accf-321f-9312-152cd0b87a8c",
                                        "entry_id": "0a2fb5bb-fde8-3475-a7cc-70c839082144",
                                        "glosses": [
                                            "The sound of a ticking clock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6721f872-a4ec-4366-ba6a-bf5f493208d7",
                                                "sense_id": "a5fa5cb8-accf-321f-9312-152cd0b87a8c",
                                                "text": "Stepping inside from the courtyard, there was silence except for the tick-tock of the antique grandfather clock in the great hall. The hulking cream-and-gray flagstones underfoot had been worn away from centuries of service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17479565-4136-3b8f-8191-80516c356571",
                                        "entry_id": "0a2fb5bb-fde8-3475-a7cc-70c839082144",
                                        "glosses": [
                                            "A step-by-step account of an event or timeline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed684920-6579-42a2-a693-52092b9fb2f4",
                                                "sense_id": "17479565-4136-3b8f-8191-80516c356571",
                                                "text": "A few days ago, the Washington Post published a long, depressing ticktock of the Trump administration’s execrable attempts to control the coronavirus and “reopen” the country for business, beginning with a shocking but not exactly surprising anecdote about how the president’s economic advisers had abetted the president’s most destructive impulses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8a9cff7-e677-40aa-b493-05504a272bf9",
                        "source_entry_id": "9157f8d6-3cba-32f8-812f-af9b9b998aac",
                        "source_sense_id": "9bd73da4-2162-3428-9b53-ac349e231d7f",
                        "source_sense_description": "onomatopoetische Nachahmung eines mechanischen Uhrwerks",
                        "target_lang_word": "tic-tac",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tic-tac",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "51a96ef0-86e8-309a-8b64-0027cd872bc1",
                                        "entry_id": "749fa49c-1957-32e7-961f-b48b36b1e049",
                                        "glosses": [
                                            "Onomatopée exprimant un mouvement réglé ou bien le temps qui passe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1354a6a-cd16-4f91-a7ed-152ee609a402",
                                                "sense_id": "51a96ef0-86e8-309a-8b64-0027cd872bc1",
                                                "text": "« […]. Comment puis-je ébranler les normes inébranlables de la société lorsque je suis confrontée au tic-tac implacable du temps? »"
                                            },
                                            {
                                                "example_id": "041443e9-a975-44a0-8bf8-5e18d84e4604",
                                                "sense_id": "51a96ef0-86e8-309a-8b64-0027cd872bc1",
                                                "text": "Tic-tac, il ne te reste plus qu'une minute avant la fin du temps imparti !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tic-tac",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e574a59-e5a7-32d4-85f3-b1404a3e68e6",
                                        "entry_id": "4799f873-174f-3303-9518-0850ce57d78c",
                                        "glosses": [
                                            "Bruit d'un mécanisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de63d521-e6d2-4a8c-9652-95dc5bc841cf",
                                                "sense_id": "2e574a59-e5a7-32d4-85f3-b1404a3e68e6",
                                                "text": "Dans ce silence, elle entendait très bien le tic-tac de l’horloge de campagne qui haletait, s’affolait, se précipitait, comme le battement d’un cœur affolé par l’angoisse."
                                            },
                                            {
                                                "example_id": "794d706e-575b-4ccd-a4a9-af2d57f6552b",
                                                "sense_id": "2e574a59-e5a7-32d4-85f3-b1404a3e68e6",
                                                "text": "Le tic-tac des horloges, on dirait des souris qui grignotent le temps."
                                            },
                                            {
                                                "example_id": "baddeb32-4253-4603-80c4-a4b33f61dc5a",
                                                "sense_id": "2e574a59-e5a7-32d4-85f3-b1404a3e68e6",
                                                "text": "Jamais aucun oncle n’astreignit aussi implacablement ses petits-neveux à écouter le tic-tac de sa grosse montre."
                                            },
                                            {
                                                "example_id": "d83c6f83-ab95-4bb3-bb52-403d4334f366",
                                                "sense_id": "2e574a59-e5a7-32d4-85f3-b1404a3e68e6",
                                                "text": "Dans le silence, tinte le lourd tic tac du balancier de l’horloge dans la salle à manger."
                                            },
                                            {
                                                "example_id": "b5b0a932-b2d1-4182-9d2f-5eb8d7a982e6",
                                                "sense_id": "2e574a59-e5a7-32d4-85f3-b1404a3e68e6",
                                                "text": "Lorsque l’on fait agir devant la cage le tic-tac d’un métronome, il interrompt toute opération et accourt au plus vite. Il sait en effet que ce bruit s’accompagne toujours du don d’un grain de raisin."
                                            },
                                            {
                                                "example_id": "a081f5d7-932f-4db6-9a49-84c84a86763b",
                                                "sense_id": "2e574a59-e5a7-32d4-85f3-b1404a3e68e6",
                                                "text": "Je la regardais — minutes silencieuses où l'on n'entendait que le tic-tac de l'horloge accrochée au mur — et j'essayais de lire dans son visage muet, mais rien d'elle ne m'était familier."
                                            },
                                            {
                                                "example_id": "3b4ec168-aee4-4e74-a4c3-f272b3070d78",
                                                "sense_id": "2e574a59-e5a7-32d4-85f3-b1404a3e68e6",
                                                "text": "Sur une crête, à sa droite, Maillat aperçut un groupe d'hommes qui badaudaient, les mains aux poches, en regardant le ciel. Ils suivaient les évolutions des bombardiers et des chasseurs canadiens, et hurlaient des encouragements, comme sur un stade, dès que le tic tac des mitrailleuses de bord leur parvenait."
                                            },
                                            {
                                                "example_id": "cd1fa2f9-cffd-4641-8fc8-dc97e48bdf7f",
                                                "sense_id": "2e574a59-e5a7-32d4-85f3-b1404a3e68e6",
                                                "text": "Malgré le vacarme de la D.C.A., il entendit nettement le tic tac des secondes. C’était un petit bruit amical et familier qui lui parvenait de très loin, une infinie petite pulsation qui lui disait que la vie du monde n’était pas morte, que les heures, quelque part, continuaient à couler, que l’espoir continuait à vivre."
                                            },
                                            {
                                                "example_id": "df3f83b7-13c7-44d3-9487-60b85c0e4599",
                                                "sense_id": "2e574a59-e5a7-32d4-85f3-b1404a3e68e6",
                                                "text": "Le Temps, c'est le tic-tac monstrueux de la montre,\nLa Mort, c'est l'infini dans son éternité, […]."
                                            },
                                            {
                                                "example_id": "70ac8961-8c42-42f1-a1b6-d42b7fb91adf",
                                                "sense_id": "2e574a59-e5a7-32d4-85f3-b1404a3e68e6",
                                                "text": "Elles se souvinrent bientôt, avec les fous rires de la jeunesse, que la pendule mise à l’abri avec leurs bijoux marchait encore, et que son tic-tac et sa sonnerie révéleraient infailliblement la cachette. Mais les patriotes cette fois-là ne pillèrent personne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tic-tac",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78d42b03-cc6e-3f02-ba5f-5ec93812908a",
                                        "entry_id": "48afd2d9-4c74-3879-a4c0-65f3e4966ab3",
                                        "glosses": [
                                            "Qualifie une liste de candidats lors d'un scrutin de liste, et qui compte alternativement un homme puis une femme, conformément à la \\\"loi nᵒ 2000-493 du 6 juin 2000 tendant à favoriser l’égal accès des femmes et des hommes aux mandats électoraux et fonctions électives\\\"."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9bed9d7-8932-4011-a21a-741d73727f0f",
                                                "sense_id": "78d42b03-cc6e-3f02-ba5f-5ec93812908a",
                                                "text": "C'est pourquoi nous tenons au maintien dans le texte des listes dites « chabada », ou « tic-tac » pour les élections européennes et sénatoriales. Contrairement aux arguments avancés par la commission des lois, qui propose de supprimer ce mécanisme qu'elle juge rigide, nous pensons que cette obligation de composition alternée des listes s'inscrit et dans la lettre et dans l'esprit de la révision constitutionnelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
