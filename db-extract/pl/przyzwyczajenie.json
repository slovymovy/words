                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62628633-b1be-4f09-bc2e-256f10586e13",
                                "sense_id": "ee771507-154a-3f93-ab34-06c690dc234f",
                                "text": "Przyzwyczajenie się do upałów jest dla mnie bardzo trudne."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "027eaf52-c54e-46ee-8cbe-d66be03279cb",
                        "source_entry_id": "aa20d19f-781b-3cbf-ae3f-637b17ed4563",
                        "source_sense_id": "19588792-dc79-37d8-ad6f-7d4e623f7d66",
                        "target_lang_word": "habit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9dee879-412a-331e-b4bd-39c237a41bc7",
                                        "entry_id": "b1f47610-2229-3655-a4a7-cb2a25b3b3a4",
                                        "glosses": [
                                            "An action performed on a regular basis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ac76a54-79df-42fe-b1a7-98d6a058e94c",
                                                "sense_id": "c9dee879-412a-331e-b4bd-39c237a41bc7",
                                                "text": "It’s become a habit of mine to have a cup of coffee after dinner."
                                            },
                                            {
                                                "example_id": "37842998-0596-493c-9fe4-58cfaaf7d158",
                                                "sense_id": "c9dee879-412a-331e-b4bd-39c237a41bc7",
                                                "text": "a man of very shy, retired habits"
                                            },
                                            {
                                                "example_id": "f8e34c93-05c1-4849-907c-70704bd2353c",
                                                "sense_id": "c9dee879-412a-331e-b4bd-39c237a41bc7",
                                                "text": "Irregular bedtimes may disrupt healthy brain development in young children, according to a study of intelligence and sleeping habits. ¶ Going to bed at a different time each night affected girls more than boys, but both fared worse on mental tasks than children who had a set bedtime, researchers found."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b5c4ade-7396-36f2-88b0-83caa970ef8f",
                                        "entry_id": "b1f47610-2229-3655-a4a7-cb2a25b3b3a4",
                                        "glosses": [
                                            "An action performed repeatedly and automatically, usually without awareness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87fe8b56-de63-4bbb-860f-8ba88bef10e7",
                                                "sense_id": "7b5c4ade-7396-36f2-88b0-83caa970ef8f",
                                                "text": "By force of habit, he dressed for work even though it was holiday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d50de8-d449-3981-bbb9-5cf518117669",
                                        "entry_id": "b1f47610-2229-3655-a4a7-cb2a25b3b3a4",
                                        "glosses": [
                                            "An addiction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd9cea7-397e-464e-af23-6a8afa2e4d49",
                                                "sense_id": "41d50de8-d449-3981-bbb9-5cf518117669",
                                                "text": "kick the habit"
                                            },
                                            {
                                                "example_id": "91080085-26bc-4e86-8f6f-309977b4f6f2",
                                                "sense_id": "41d50de8-d449-3981-bbb9-5cf518117669",
                                                "text": "He has a 10-cigar habit."
                                            },
                                            {
                                                "example_id": "055b1453-4dbc-43d8-ae28-a2bc051c91b0",
                                                "sense_id": "41d50de8-d449-3981-bbb9-5cf518117669",
                                                "text": "Another white boy band / They're happy on demand / Everything is planned / Until the singer gets a habit"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "habit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e988c6c7-c3e3-3cc8-a214-e7c686b9d1a4",
                                        "entry_id": "711ce2f0-fcc5-35a3-97d9-6553c9d0d7dd",
                                        "glosses": [
                                            "To clothe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b8842b-51ba-4eff-bf64-57ba1bfbf1ed",
                                                "sense_id": "e988c6c7-c3e3-3cc8-a214-e7c686b9d1a4",
                                                "text": "Here I began my shopping, was interviewed by dressmakers, and naturally had much to do to habit myself for civilized life again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d5b901b-1705-3d93-a93e-476cc5d22cf3",
                                        "entry_id": "711ce2f0-fcc5-35a3-97d9-6553c9d0d7dd",
                                        "glosses": [
                                            "To inhabit."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "habit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd85d95-12d9-3a7d-8846-c99bf3e746ce",
                                        "entry_id": "d09aa94b-f982-3a51-82ac-8ccad9519065",
                                        "glosses": [
                                            "A long piece of clothing worn by monks and nuns."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd560cc4-37a1-4a1c-8a3e-ee6d8e3e75ed",
                                                "sense_id": "0cd85d95-12d9-3a7d-8846-c99bf3e746ce",
                                                "text": "It’s interesting how Catholic and Buddhist monks both wear habits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "741f38d5-b904-355b-8f9c-250089814835",
                                        "entry_id": "d09aa94b-f982-3a51-82ac-8ccad9519065",
                                        "glosses": [
                                            "A piece of clothing worn for a specific activity; a uniform."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3508e53-db12-4f6d-9794-6cf950d229a2",
                                                "sense_id": "741f38d5-b904-355b-8f9c-250089814835",
                                                "text": "The new riding habits of the team looked smashing!"
                                            },
                                            {
                                                "example_id": "02915a80-8dfc-415d-8d50-6823094b47ca",
                                                "sense_id": "741f38d5-b904-355b-8f9c-250089814835",
                                                "text": "Sidesaddle riding habits were prestigious tailored sportswear appropriate for the equestrian pursuits of the truly wealthy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ae4aa7d-a60f-3630-9111-434f0496e583",
                                        "entry_id": "d09aa94b-f982-3a51-82ac-8ccad9519065",
                                        "glosses": [
                                            "Outward appearance; attire; dress."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab453e43-7bec-496a-82ba-986ec2f550d8",
                                                "sense_id": "0ae4aa7d-a60f-3630-9111-434f0496e583",
                                                "text": "Noble and milde this Perſean ſeemes to be,\nIf outward habit Iudge the inward man."
                                            },
                                            {
                                                "example_id": "47584434-3844-4f23-a598-65c14d24b9b4",
                                                "sense_id": "0ae4aa7d-a60f-3630-9111-434f0496e583",
                                                "text": "Costly thy habit as thy purse can buy."
                                            },
                                            {
                                                "example_id": "04f67b6c-cd43-4ee7-b2c4-bd40968fe317",
                                                "sense_id": "0ae4aa7d-a60f-3630-9111-434f0496e583",
                                                "text": "There are, among the statues, several of Venus, in different habits."
                                            },
                                            {
                                                "example_id": "c4f9c9de-83f9-43c8-850a-720fb994db98",
                                                "sense_id": "0ae4aa7d-a60f-3630-9111-434f0496e583",
                                                "text": "[…]it was always my fate to choose for the worse, so I did here; for having money in my pocket and good clothes upon my back, I would always go on board in the habit of a gentleman; and so I neither had any business in the ship, or learned to do any."
                                            },
                                            {
                                                "example_id": "fda96960-816e-47f3-aacd-9640bf07e986",
                                                "sense_id": "0ae4aa7d-a60f-3630-9111-434f0496e583",
                                                "text": "There were ſeveral of his Prieſts and Lawyers preſent, (as I conjectured by their habits) who were commanded to addreſs themſelves to me, and I ſpoke to them in as many Languages as I had the leaſt ſmattering of, which were High and Low Dutch, Latin, French, Spaniſh, Italian, and Lingua Franca; but all to no purpoſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49440b5d-e802-3207-8855-b9092f30d0b3",
                                        "entry_id": "d09aa94b-f982-3a51-82ac-8ccad9519065",
                                        "glosses": [
                                            "Form of growth or general appearance and structure of a plant or crystal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "form-of",
                                            "uncountable"
                                        ],
