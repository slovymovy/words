                                                "sense_id": "d11b581b-8701-3239-bebb-b72034fd99d8",
                                                "text": "The rate of fall of the surface of water ponded over the soil within the ring gives a measure of the infiltration rate for the particular enclosed area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "906b1fa7-010f-3d79-9c81-413eb6ce5e44",
