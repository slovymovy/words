    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b58fe9b-0781-30b2-a1c8-d8dd662cf6d2",
                    "sense_definition": "To cause plants or animals to multiply or reproduce.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers often <w>propagate</w> these flowers by taking cuttings from the stems."
                        },
                        {
                            "text": "It is difficult to <w>propagate</w> this rare species in a laboratory environment."
                        }
                    ],
                    "synonyms": [
                        "breed",
                        "reproduce",
                        "multiply"
                    ]
                },
                {
                    "sense_id": "b0c7bdbf-34ad-39ed-a439-24533ba4ea3e",
                    "sense_definition": "To spread ideas, beliefs, or information to many people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dissemination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group used social media to <w>propagate</w> their political message globally."
                        },
                        {
                            "text": "They were accused of trying to <w>propagate</w> false information about the election."
                        }
                    ],
                    "synonyms": [
                        "disseminate",
                        "spread",
                        "circulate",
                        "promote"
                    ]
                },
                {
                    "sense_id": "f536dcdf-6884-354d-807b-44a4b150cc50",
                    "sense_definition": "To cause waves, such as sound or light, to travel through a medium.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sound waves <w>propagate</w> more efficiently through water than through air."
                        },
                        {
                            "text": "The fiber optic cable is designed to <w>propagate</w> light signals over long distances."
                        }
                    ],
                    "synonyms": [
                        "transmit",
                        "convey"
                    ]
                },
                {
                    "sense_id": "940f3a3b-6a72-3437-acf1-7d1f00289cd1",
                    "sense_definition": "To update or sync data across all devices or servers in a network.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "network_sync",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "DNS changes can take several hours to <w>propagate</w> across the internet."
                        },
                        {
                            "text": "Wait for the new security settings to <w>propagate</w> to all connected workstations."
                        }
                    ],
                    "synonyms": [
                        "sync",
                        "update"
                    ]
                }
            ]
        }
