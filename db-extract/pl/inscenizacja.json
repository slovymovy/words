                                        "entry_id": "4c3aa317-395a-3c2d-9ae2-0e9b8ff53d69",
                                        "glosses": [
                                            "künstlerische Gestaltung einer Aufführung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7562a28b-682f-467e-a25a-2d3f26f7b27c",
                                                "sense_id": "b800e7e4-558d-3343-a3c9-42a7b8efd22f",
                                                "text": "Die Inszenierung des Stückes war gewöhnungsbedürftig."
                                            },
                                            {
                                                "example_id": "bb3ad05c-a750-4e4f-83e7-674ffe048962",
                                                "sense_id": "b800e7e4-558d-3343-a3c9-42a7b8efd22f",
                                                "text": "„Er denkt schon an eine große Inszenierung, nicht an eine kleine Gelegenheitssache.“"
                                            },
                                            {
                                                "example_id": "d08370a1-1bea-4034-89ab-3bc7134271b5",
                                                "sense_id": "b800e7e4-558d-3343-a3c9-42a7b8efd22f",
                                                "text": "„Er klatscht in die Hände, als gälte es eine gelungene Inszenierung zu bejubeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a200fd5-cab4-3b49-8103-8f3a54225496",
                                        "entry_id": "4c3aa317-395a-3c2d-9ae2-0e9b8ff53d69",
                                        "glosses": [
                                            "übertriebene Selbstdarstellung, Auslösung eines Skandals"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a0e495-b78a-46fd-804a-cd25729b9d29",
                                                "sense_id": "7a200fd5-cab4-3b49-8103-8f3a54225496",
                                                "text": "Ihre Inszenierung hat ihre wahren Absichten gezeigt."
                                            },
                                            {
                                                "example_id": "a0f8a328-899a-488e-8192-ae3586b2544d",
                                                "sense_id": "7a200fd5-cab4-3b49-8103-8f3a54225496",
                                                "text": "„Kurz kam ihm der Gedanke, dass das hier möglicherweise alles eine große Inszenierung war, dass die beiden ihm etwas verheimlichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
