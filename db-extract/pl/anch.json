                        "translation_id": "05b0af43-85eb-45fd-a348-8aad58404b29",
                        "source_entry_id": "fd52e60a-3442-3cdc-85f5-cc1dd402bd09",
                        "source_sense_id": "bca163c3-8864-3a83-84c6-fece71772963",
