                        "relever une équipe"
                    ]
                },
                {
                    "sense_id": "c5f604b0-30c1-3e91-b482-df77034a2a2b",
                    "sense_definition": "Être sous l'autorité de quelqu'un, être du ressort ou de la compétence d'une entité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision ne <w>relève</w> pas de mes responsabilités mais de la direction générale."
                        },
