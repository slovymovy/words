                ],
                "senses": [
                    {
                        "sense_id": "9234f0ef-c892-3659-9c31-427f97ef847d",
                        "entry_id": "7559aaff-ff43-38b5-ac10-a84d6562c28e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "757c4d00-a75d-4cb5-9ee3-c1175c9bfe7a",
                                "sense_id": "9234f0ef-c892-3659-9c31-427f97ef847d",
                                "text": "Frau Hirschmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d41513c3-5382-4449-abcf-eed33dda9911",
                                "sense_id": "9234f0ef-c892-3659-9c31-427f97ef847d",
                                "text": "Herr Hirschmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2d246ad7-fc40-4161-b779-1c7b92dae42f",
                                "sense_id": "9234f0ef-c892-3659-9c31-427f97ef847d",
                                "text": "Die Hirschmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b9542ea3-a0b8-4066-b05a-6e4a0da27baa",
                                "sense_id": "9234f0ef-c892-3659-9c31-427f97ef847d",
                                "text": "Der Hirschmann trägt nie die Schals, die die Hirschmann ihm strickt."
                            },
                            {
                                "example_id": "d8a4bad1-2e16-4258-8294-996132539238",
                                "sense_id": "9234f0ef-c892-3659-9c31-427f97ef847d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hirschmann kommt, geht der Herr Hirschmann.“"
                            },
                            {
                                "example_id": "7da38146-c22a-46d3-8b22-33661ee53153",
                                "sense_id": "9234f0ef-c892-3659-9c31-427f97ef847d",
                                "text": "Hirschmann kommt und geht."
                            },
                            {
                                "example_id": "da582679-e8d7-4044-adfb-b7072f66353b",
                                "sense_id": "9234f0ef-c892-3659-9c31-427f97ef847d",
                                "text": "Hirschmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
