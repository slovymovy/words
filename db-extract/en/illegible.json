                                "target_senses": [
                                    {
                                        "sense_id": "04bf96ab-4d5b-34d3-b144-82af8cf64f2b",
                                        "entry_id": "8755564d-acbe-3bef-acc2-26622ee12db2",
                                        "glosses": [
                                            "Qu’on ne peut lire ou qu’on ne lit que très difficilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a76fc8-9d02-48b5-bdbc-f1a46d8608b5",
                                                "sense_id": "04bf96ab-4d5b-34d3-b144-82af8cf64f2b",
                                                "text": "Cette écriture est illisible."
                                            },
                                            {
                                                "example_id": "4459c15c-4ed0-4384-95af-2a89b17c511a",
                                                "sense_id": "04bf96ab-4d5b-34d3-b144-82af8cf64f2b",
                                                "text": "Des caractères illisibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea06af49-1d0e-3fdc-8ff4-f325a353694a",
                                        "entry_id": "8755564d-acbe-3bef-acc2-26622ee12db2",
                                        "glosses": [
                                            "Dont la lecture n’est pas supportable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4c58264-54b2-4fd9-a342-2308e04539cc",
                                                "sense_id": "ea06af49-1d0e-3fdc-8ff4-f325a353694a",
                                                "text": "[…], il tend son livre. Dedans ses discours. Sur l'Europe, la liberté, le désordre monétaire, le dumping fiscal. Le tout, illisible. On parcourt le sommaire, on soupèse le pavé et on se demande combien l'éditeur a bien pu facturer ce pensum à l'ambassade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f1b27db-10fc-335c-88a9-12b81e655dad",
                                        "entry_id": "8755564d-acbe-3bef-acc2-26622ee12db2",
                                        "glosses": [
                                            "Qui est incompréhensible, dont on ne parvient pas à saisir la logique ou la cohérence ; confus, embrouillé."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0f413fe-26fd-4390-9d31-648c1a700421",
                                                "sense_id": "3f1b27db-10fc-335c-88a9-12b81e655dad",
                                                "text": "La politique économique du gouvernement est illisible."
                                            },
                                            {
                                                "example_id": "82a17c3a-963b-4742-b0a5-885cdafe8fea",
                                                "sense_id": "3f1b27db-10fc-335c-88a9-12b81e655dad",
                                                "text": "Ce fut, je dois le dire, un des moments de grande beauté de ma vie. Un moment rempli de tout ce qui est organique, de tout ce qui est humain, de tout ce qui blesse l’homme et la femme, de tout ce regard incompréhensible, illisible, invisible que porte le divin sur nous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f586c46-5b06-4699-9d41-a6961a2dbe30",
                        "source_entry_id": "eac56561-67d9-3875-a2b8-bde45ea1ceb7",
                        "source_sense_id": "c9d3eaa8-26a8-38f7-8f4b-8738ac365b45",
                        "source_sense_description": "not clear enough to be read",
                        "target_lang_word": "indéchiffrable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indéchiffrable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc7969e7-fdbc-3394-9c54-5965a80da01e",
                                        "entry_id": "63e5a9ef-aa7f-3963-9c67-fdcfee98293b",
                                        "glosses": [
                                            "Qui ne peut se déchiffrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df63498-ced2-4fb0-9dbb-6fae2c0b1675",
                                                "sense_id": "bc7969e7-fdbc-3394-9c54-5965a80da01e",
                                                "text": "Dans un des îlots du Morbihan, celui de Gavr’inis (île de la Chèvre), il y a une tombelle plus étrange encore : elle a 8 mètres de haut sur 100 mètres de circonférence ; à l'intérieur, elle recèle une grotte aux parois couvertes d’hiéroglyphes indéchiffrables et de sculptures impossibles à décrire."
                                            },
                                            {
                                                "example_id": "01895d76-d340-4ac4-b1a1-2771a0ff1ea3",
                                                "sense_id": "bc7969e7-fdbc-3394-9c54-5965a80da01e",
                                                "text": "Non seulement les codes d'aujourd'hui sont, de fait, indéchiffrables, mais le problème de distribution des clefs a été résolu. Selon Philip Zimmermann, nous vivons un âge d'or de la cryptographie : « Avec les moyens modernes, on peut coder en restant réellement hors de portée de toute forme connue de cryptanalyse. […]. »"
                                            },
                                            {
                                                "example_id": "e5032ace-f4d6-4892-84f1-daa537242a00",
                                                "sense_id": "bc7969e7-fdbc-3394-9c54-5965a80da01e",
                                                "text": "Le caractère de cet homme est indéchiffrable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f41b42e-2f08-3977-b26a-2302e2a640b9",
                                        "entry_id": "63e5a9ef-aa7f-3963-9c67-fdcfee98293b",
                                        "glosses": [
                                            "Qui est difficile à lire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad4a527c-63ca-402a-ac3e-2f4203845176",
                                                "sense_id": "8f41b42e-2f08-3977-b26a-2302e2a640b9",
                                                "text": "Ces illustres paperasses, dont l’écriture gothiquement indéchiffrable eût demandé des lunettes et la science d’un bénédictin, étaient enveloppées pieusement d’un morceau de taffetas cramoisi dont la couleur passée avait pris une teinte pisseuse."
                                            },
                                            {
                                                "example_id": "d50e5470-b12c-4c2f-a92d-8c49cc648917",
                                                "sense_id": "8f41b42e-2f08-3977-b26a-2302e2a640b9",
                                                "text": "Il les récita d'une haleine, sans en omettre un seul mot, tandis que Guilleragues en écrivait les parties essentielles sous sa dictée, en une forme abrégée et indéchiffrable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21609e7b-8b73-3104-842b-d83d3094c894",
                                        "entry_id": "63e5a9ef-aa7f-3963-9c67-fdcfee98293b",
                                        "glosses": [
                                            "Qui est obscur, embrouillé, qu’on ne peut expliquer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8607f33-2af2-46ef-ba1b-f62768648aff",
                                                "sense_id": "21609e7b-8b73-3104-842b-d83d3094c894",
                                                "text": "Toujours en représentation, parlant beaucoup et ne se livrant pas, lisible mais indéchiffrable !"
                                            },
                                            {
                                                "example_id": "057a4ece-8cdd-4e5d-8aa2-efdb0f22d38c",
                                                "sense_id": "21609e7b-8b73-3104-842b-d83d3094c894",
                                                "text": "L’énigme semblait indéchiffrable. Les gens de Cornabeuf, sentant peser sur eux l’horreur de ce mystère, se barricadaient le soir dans leurs maisons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccf5c99c-6a83-4c27-9093-aed197028310",
                        "source_entry_id": "eac56561-67d9-3875-a2b8-bde45ea1ceb7",
                        "source_sense_id": "c9d3eaa8-26a8-38f7-8f4b-8738ac365b45",
