{
    "word_family": [
        "grace",
        "gracefully",
        "gracefulness",
        "disgrace",
        "ungraceful"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be110a37-88f6-3787-b1d4-aa4fbd632f8e",
                    "sense_definition": "Having or showing elegance, beauty, and smooth movement or form.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>graceful</w> dancer who moves effortlessly across the stage.",
                            "target_lang_translations": {
                                "ru": "Она — <w>грациозная</w> танцовщица, которая без усилий перемещается по сцене."
                            }
                        },
                        {
                            "text": "The couple was performing a <w>graceful</w> dance together during the celebration.",
                            "target_lang_translations": {
                                "ru": "Пара исполняла <w>изящный</w> танец вместе во время празднования."
                            }
                        }
                    ],
                    "synonyms": [
                        "airy"
                    ],
                    "antonyms": [
                        "clumsy",
                        "graceless"
                    ],
                    "common_phrases": [
                        "graceful dancer",
                        "graceful movement",
                        "graceful dance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий элегантностью, красотой и плавностью движений или форм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грациозный",
                                "target_lang_sense_clarification": "о движениях, танце или фигуре"
                            },
                            {
                                "target_lang_word": "изящный",
                                "target_lang_sense_clarification": "о формах, стиле или движениях"
                            },
                            {
                                "target_lang_word": "элегантный",
                                "target_lang_sense_clarification": "о внешнем виде или манерах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da074836-c5f3-37c0-9933-ce50e91594ed",
                    "sense_definition": "Showing kindness, politeness, and dignity, especially in a difficult situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He showed a <w>graceful</w> acceptance of the decision, thanking everyone involved.",
                            "target_lang_translations": {
                                "ru": "Он продемонстрировал <w>достойное</w> принятие решения, поблагодарив всех участников."
                            }
                        },
                        {
                            "text": "The athlete gave a <w>graceful</w> defeat speech despite losing the championship match.",
                            "target_lang_translations": {
                                "ru": "Спортсмен произнёс <w>достойную</w> речь после поражения, несмотря на проигрыш в финальном матче."
                            }
                        }
                    ],
                    "common_phrases": [
                        "graceful acceptance",
                        "graceful defeat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий доброту, вежливость и достоинство, особенно в сложной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достойный",
                                "target_lang_sense_clarification": "о поведении при поражении или принятии решений"
                            },
                            {
                                "target_lang_word": "благородный",
                                "target_lang_sense_clarification": "проявляющий великодушие и достоинство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76fbaf14-6bf5-3592-af3f-57ec6ba32c06",
                    "sense_definition": "Smooth, gradual, and non-disruptive (especially regarding processes or technology).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The server requires a <w>graceful</w> exit to ensure that no data is lost during maintenance.",
                            "target_lang_translations": {
                                "ru": "Серверу требуется <w>корректное</w> завершение работы, чтобы гарантировать отсутствие потери данных во время обслуживания."
                            }
                        },
                        {
                            "text": "A <w>graceful</w> degradation of the service allowed users to continue using basic features.",
                            "target_lang_translations": {
                                "ru": "<w>Плавное</w> снижение функциональности сервиса позволило пользователям продолжать использовать базовые возможности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "graceful degradation",
                        "graceful exit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавный, постепенный и не нарушающий работу (особенно о процессах или технологиях)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корректный",
                                "target_lang_sense_clarification": "о завершении работы программ или систем"
                            },
                            {
                                "target_lang_word": "плавный",
                                "target_lang_sense_clarification": "без резких сбоев и остановки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}