                "forms": [],
                "senses": [
                    {
                        "sense_id": "2e847521-a7e0-326d-96d5-c7dd0ead08f5",
                        "entry_id": "075d06e6-bba6-37b2-b114-1714ad00bac6",
                        "glosses": [
                            "duidelijk verschillend van iets of iemand anders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "166f95ec-a3af-4f49-8817-396409d56c20",
                                "sense_id": "2e847521-a7e0-326d-96d5-c7dd0ead08f5",
                                "text": "Maar ook los van die ruitvormen is de DS 3 Crossback een opvallende verschijning. Aan de voorkant schreeuwen de grote grille en de karakteristieke dagrijlichten om aandacht, maar ook de koplampen dragen bij aan het onderscheidende uiterlijk."
                            },
                            {
                                "example_id": "5ea695bd-5b98-4759-aca5-7da714390af4",
                                "sense_id": "2e847521-a7e0-326d-96d5-c7dd0ead08f5",
                                "text": "Dijstelbloem gaat samenwerken met Wolter Odding. “Er ligt hier een prachtige opdracht om samen met ketenpartners nog meer ‘de juiste zorg op de juiste plek’ te kunnen bieden aan de Twentse patiënt. patiënt. ZGT doet dat vanuit twee onderscheidende locaties; een locatie in Hengelo en een in Almelo."
                            },
                            {
                                "example_id": "7400232a-4854-4984-bb71-2ef9dcba2e3c",
                                "sense_id": "2e847521-a7e0-326d-96d5-c7dd0ead08f5",
                                "text": "De geïntegreerde styluspen is een leuke, onderscheidende extra - die niet helemaal lekker uit de verf komt."
                            }
                        ]
                    }
                ],
                "translations": [
