                                    {
                                        "sense_id": "03f16b5b-880c-34ad-8120-b231dda32f31",
                                        "entry_id": "bcc10e33-fca8-3179-8fe8-e2679545501b",
                                        "glosses": [
                                            "To remove one's clothing."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ac47761-a6aa-43c0-bb5f-6617c6ab338c",
                                                "sense_id": "03f16b5b-880c-34ad-8120-b231dda32f31",
                                                "text": "She undressed herself before putting on her bedclothes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca4dbe1-80f8-3dca-96b0-0cd6d7bb8d4b",
                                        "entry_id": "bcc10e33-fca8-3179-8fe8-e2679545501b",
                                        "glosses": [
                                            "To remove one’s clothing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be05d0b4-9b27-4905-8272-83b4ba58632f",
                                                "sense_id": "fca4dbe1-80f8-3dca-96b0-0cd6d7bb8d4b",
                                                "text": "The doctor asked me to undress for the examination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "014ef863-f161-3b60-811f-b51f770593e3",
                                        "entry_id": "bcc10e33-fca8-3179-8fe8-e2679545501b",
                                        "glosses": [
                                            "To remove the clothing of (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40847fda-4599-49bb-9ea8-5088032d6188",
                                                "sense_id": "014ef863-f161-3b60-811f-b51f770593e3",
                                                "text": "Mary began to undress her daughter in preparation for bathtime."
                                            },
                                            {
                                                "example_id": "0fa24ebb-ec2f-4c6a-8adb-29625d59cc94",
                                                "sense_id": "014ef863-f161-3b60-811f-b51f770593e3",
                                                "text": "The young men slowly and sensually undressed each other before making passionate love."
                                            },
                                            {
                                                "example_id": "3d558929-0190-42c6-9e13-c90cd415f4cd",
                                                "sense_id": "014ef863-f161-3b60-811f-b51f770593e3",
                                                "text": "You can brush my hair, undress me everywhere / Imagination, life is your creation"
                                            }
                                        ]
                                    },
