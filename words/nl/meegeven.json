                    "sense_definition": "iemand iets geven om mee te nemen wanneer die persoon vertrekt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysiek geven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>gaf</w> zijn kinderen een knapzak met eten <w>mee</w> voor tijdens het schoolreisje.",
                            "target_lang_translations": {
                                "en": "He <w>sent</w> a knapsack with food <w>along</w> with his children for the school trip."
                            }
                        },
                        {
                            "text": "Vergeet niet om de paraplu aan je zus <w>mee te geven</w> als ze naar huis gaat.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>give</w> the umbrella <w>to</w> your sister <w>to take with her</w> when she goes home."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "een lunchpakket meegeven",
                        "iets aan iemand meegeven"
                    ],
                    "target_lang_definitions": {
