                "senses": [
                    {
                        "sense_id": "dce1cb8b-f3c3-334d-950e-e37e790e5ff2",
                        "entry_id": "249bda66-01c2-32c0-ad44-33ab84445648",
                        "glosses": [
                            "arrogant, pretentieus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e4136b-a7e7-4d33-9da9-4ca0f6400d43",
                                "sense_id": "dce1cb8b-f3c3-334d-950e-e37e790e5ff2",
                                "text": "Het aanmatigend optreden van Jan I maakte hem niet populair bij de adel."
                            },
                            {
                                "example_id": "2b24c417-89d1-4e9c-afaa-389851f31a96",
                                "sense_id": "dce1cb8b-f3c3-334d-950e-e37e790e5ff2",
                                "text": "mevrouw Sampson?' begon ze, omdat tante Patricia of zelfs oudtante haar wat aanmatigend leek."
                            },
                            {
                                "example_id": "095f655c-9daf-4a42-9307-13526788d90d",
                                "sense_id": "dce1cb8b-f3c3-334d-950e-e37e790e5ff2",
                                "text": "' 'Hij zal me ongetwijfeld spoedig gekarakteriseerd hebben: arrogant, aanmatigend, ongeduldig en eigenzinnig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a68e894-a91c-4703-b1a1-d6bbd89a5d44",
                        "source_entry_id": "249bda66-01c2-32c0-ad44-33ab84445648",
                        "source_sense_id": "dce1cb8b-f3c3-334d-950e-e37e790e5ff2",
                        "target_lang_word": "anmaßend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anmaßend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed9721ca-f895-395a-92c4-36cba1cc4189",
                                        "entry_id": "7060b6e7-ba82-3bfb-a6ee-e574eba4f62a",
                                        "glosses": [
                                            "überheblich, arrogant, übertrieben selbstbewusst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e3b947-bf5d-4ab0-8799-e1a9d097123d",
                                                "sense_id": "ed9721ca-f895-395a-92c4-36cba1cc4189",
                                                "text": "Sein anmaßendes Verhalten bringt ihm keine Freunde."
                                            },
                                            {
                                                "example_id": "2e8f2b54-bc67-4876-b03f-ed081c529778",
                                                "sense_id": "ed9721ca-f895-395a-92c4-36cba1cc4189",
                                                "text": "„Ich finde es anmaßend, wenn Sie im Namen aller Juden und Jüdinnen das jüdische Leben einfach mal so zur Disposition stellen, nur weil Ihnen der Zickzackkurs einer Debatte nicht konveniert.“"
                                            },
                                            {
                                                "example_id": "f12a81ac-81a7-4ebb-b984-80dc004e5ee5",
                                                "sense_id": "ed9721ca-f895-395a-92c4-36cba1cc4189",
                                                "text": "„Die Prohibition ist in vollem Gang, letzte Farce eines puritanischen Amerika, durch die das Entstehen illegaler Treffpunkte, eines lukrativen Schwarzhandels und einer anmaßenden Mafia gefördert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "anmaßend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05b1e875-fc22-3340-994d-092fe6b82033",
                                        "entry_id": "ada01e12-c2b6-30f9-ac69-f753748dd390",
                                        "glosses": [
                                            "Partizip Präsens des Verbs anmaßen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfa1d1e9-6c5a-4b21-92ee-1e3d7956d2e1",
                        "source_entry_id": "249bda66-01c2-32c0-ad44-33ab84445648",
                        "source_sense_id": "dce1cb8b-f3c3-334d-950e-e37e790e5ff2",
                        "target_lang_word": "presumptuous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presumptuous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88e9b87f-812d-3df8-94ca-fdedf53f9e54",
                                        "entry_id": "36b5c7e8-55fc-37af-b145-090dbc78a024",
                                        "glosses": [
                                            "Making unwarranted presumptions or assumptions, often out of arrogance or excessive self-confidence, and thus exceeding what is appropriate or right."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94fbf21-67d0-455e-bf4b-86b2c05b5f53",
                                                "sense_id": "88e9b87f-812d-3df8-94ca-fdedf53f9e54",
                                                "text": "Preſumptuous Prieſt, this place cōmands my patiēce, / Or thou ſhould'ſt finde thou haſt dis-honor'd me."
                                            },
                                            {
                                                "example_id": "91f492df-c8d7-40ca-a9f7-5a4a6adfdde0",
                                                "sense_id": "88e9b87f-812d-3df8-94ca-fdedf53f9e54",
                                                "text": "Is this the proud presumtious Esquire of the North, / That would not yeeld his prisoner to my Queen"
                                            },
                                            {
                                                "example_id": "ccd64451-4b55-480e-94da-173153760e3e",
                                                "sense_id": "88e9b87f-812d-3df8-94ca-fdedf53f9e54",
                                                "text": "Keepe back thy seruant also from presumptuous sinnes, let them not haue dominion ouer me: then shall I be vpright, and I shalbe innocent from the great transgression."
                                            },
                                            {
                                                "example_id": "d001e9d5-52b0-48db-82ea-0566040fad8e",
                                                "sense_id": "88e9b87f-812d-3df8-94ca-fdedf53f9e54",
                                                "text": "Dorothea checked herself suddenly with self-rebuke for the presumptuous way in which she was reckoning on uncertain events, but she was spared any inward effort to change the direction of her thoughts by the appearance of a cantering horseman round a turning of the road."
                                            },
                                            {
                                                "example_id": "62c79260-7487-43b9-be83-385c9fde0ff2",
                                                "sense_id": "88e9b87f-812d-3df8-94ca-fdedf53f9e54",
                                                "text": "“Of course,” said Felix, “I suggest nothing; it would be very presumptuous in me to advise you. But I think there is no doubt about the fact.”"
                                            },
                                            {
                                                "example_id": "6bdffc11-c6ba-43c0-baab-9b00ccf7d8f3",
                                                "sense_id": "88e9b87f-812d-3df8-94ca-fdedf53f9e54",
                                                "text": "The powers of the world were making ready to crush the presumptuous France of the Jacobins, and the France of King and Aristocracy would be restored."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21658633-adbe-44a7-91e9-06e9a9c14f43",
                        "source_entry_id": "249bda66-01c2-32c0-ad44-33ab84445648",
                        "source_sense_id": "dce1cb8b-f3c3-334d-950e-e37e790e5ff2",
                        "target_lang_word": "arrogant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrogant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad6ff21-ad73-3216-b08e-146b18bc1b9a",
                                        "entry_id": "ebd4659c-5835-3082-9b42-f78701068884",
                                        "glosses": [
                                            "Having excessive pride in oneself, often with contempt or disrespect for others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88bf0fb7-948a-4b90-a0be-af07b276b784",
                                                "sense_id": "8ad6ff21-ad73-3216-b08e-146b18bc1b9a",
                                                "text": "The demand to be loved is the greatest of all arrogant presumptions."
                                            },
                                            {
                                                "example_id": "f7bc0e6e-059d-4fb6-bccf-dff151a63cec",
                                                "sense_id": "8ad6ff21-ad73-3216-b08e-146b18bc1b9a",
                                                "text": "Call me a braggart, call me arrogant. People at ABC (and elsewhere) have called me worse. But when you need the job done on deadline, you’ll call me."
                                            },
                                            {
                                                "example_id": "7cfc5ab0-f747-4b34-bbc8-f336a03b0dbf",
                                                "sense_id": "8ad6ff21-ad73-3216-b08e-146b18bc1b9a",
                                                "text": "Transport Minister Marples, meanwhile, used arrogant rhetoric and showed his personal contempt for railways when confirming in Parliament that a third of the network was to be closed even before the survey results were known."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47f8c4b6-2475-4185-9865-911a44c96fac",
                        "source_entry_id": "249bda66-01c2-32c0-ad44-33ab84445648",
                        "source_sense_id": "dce1cb8b-f3c3-334d-950e-e37e790e5ff2",
                        "target_lang_word": "prétentieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prétentieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "533bcc2d-c336-3965-b12f-6d36aca3a26d",
                                        "entry_id": "32fa14a9-9ee2-34e7-b88b-5cef3a5a4b33",
                                        "glosses": [
                                            "Qui a des prétentions ; qui est désireux d’attirer l’admiration d’autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f631f81a-ae7e-470a-9c10-1b474443c64d",
                                                "sense_id": "533bcc2d-c336-3965-b12f-6d36aca3a26d",
                                                "text": "Cette gamine vicieuse et prétentieuse est la fille d’une grosse commère qui tenait, naguère, une fruiterie dans les environs du Barbès."
                                            },
                                            {
                                                "example_id": "45494c23-5f96-4ec0-849a-9be1d045b0ec",
                                                "sense_id": "533bcc2d-c336-3965-b12f-6d36aca3a26d",
                                                "text": "Grimpèrent au premier étage d'une prétentieuse babel de métal, suppositoire par quoi la civilisation parisienne avait cru enchoser Dieu"
                                            },
                                            {
                                                "example_id": "12c02c50-2eac-4620-b585-be761ffabc0b",
                                                "sense_id": "533bcc2d-c336-3965-b12f-6d36aca3a26d",
                                                "text": "Albert est un trou de balle prétentieux. Son visage estampillé cinquante ans trahit une récente plastie des bajoues, il sourit en permanence de toutes ses facettes dentaires,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6404ae73-32cf-3378-9870-bab74cbc12f2",
                                        "entry_id": "32fa14a9-9ee2-34e7-b88b-5cef3a5a4b33",
                                        "glosses": [
                                            "Où il y a de la prétention, de l’affectation, de la recherche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f02f3a23-1e9a-4714-addd-490a98231034",
                                                "sense_id": "6404ae73-32cf-3378-9870-bab74cbc12f2",
                                                "text": "Il a le ton bien prétentieux. — Il utilise un style vraiment prétentieux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prétentieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c04402b-1cdc-3471-bdc9-c75ab2ca828e",
                                        "entry_id": "50980303-1745-3c63-8a76-11dbf0f8f394",
                                        "glosses": [
                                            "Personne prétentieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a57f8806-57d3-4021-8a95-c42d5831f867",
                                                "sense_id": "9c04402b-1cdc-3471-bdc9-c75ab2ca828e",
                                                "text": "Les écrivains ne sont-ils pas des vaniteux, des prétentieux ? dit Marie-Josée."
                                            },
                                            {
                                                "example_id": "224ffcd4-0a6f-4158-b423-1b9bfe0b4e19",
                                                "sense_id": "9c04402b-1cdc-3471-bdc9-c75ab2ca828e",
                                                "text": "Mistral reprendra la formule en la transformant : « Qui a vu Paris, mais n'a pas vu Cassis, n'a rien vu. » « C'est comme ça, commente Robert Ode, que les Cassidains se sont fait une réputation de prétentieux ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dfc7812-f3e4-4987-856d-b5bfe5b58a6e",
                        "source_entry_id": "249bda66-01c2-32c0-ad44-33ab84445648",
