                "senses": [
                    {
                        "sense_id": "deece910-0767-3858-a035-9d5d97db130d",
                        "entry_id": "14bf1228-efcd-3d97-a3aa-8e57b04f3321",
                        "glosses": [
                            "die Grenze im Süden eines Gebietes oder eines Landes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08108e16-0ad8-4175-bc5c-5b7faf62c73e",
                                "sense_id": "deece910-0767-3858-a035-9d5d97db130d",
                                "text": "Der Stamm Efraïm erhielt folgendes Gebiet: Seine Südgrenze begann östlich von Atarot-Addar, lief durch das obere Bet-Horon und von dort zum Meer."
                            },
                            {
                                "example_id": "8d9b568d-93bd-4e44-b432-eff456503fb2",
                                "sense_id": "deece910-0767-3858-a035-9d5d97db130d",
                                "text": "An ihrer Südgrenze geht die Waldtundra dann fließend in die Waldzone über."
                            },
                            {
                                "example_id": "8705280a-7a6d-40fa-8c3d-24367b882c3b",
                                "sense_id": "deece910-0767-3858-a035-9d5d97db130d",
                                "text": "Pro Jahr überqueren Hunderttausende illegal die Südgrenze, darunter Zehntausende teils unbegleitete Minderjährige."
                            },
                            {
                                "example_id": "22d0b73f-fb5d-420b-95b5-5d24d89c3ed4",
                                "sense_id": "deece910-0767-3858-a035-9d5d97db130d",
                                "text": "Mit diesen Modellen bewerben sich verschiedene Baufirmen um das Mandat der Regierung Trump, eine neue Befestigung an der Südgrenze der USA zu errichten."
                            },
                            {
                                "example_id": "79791e41-c8dc-4b25-9310-af5718f3c19a",
                                "sense_id": "deece910-0767-3858-a035-9d5d97db130d",
                                "text": "Dadurch verschiebt sich auch die Südgrenze des Palmerlandes entsprechend, wodurch geographische Objekte zwischen den beiden Südgrenzen nach britischer Auffassung im Palmerland, nach US-amerikanischer – die an der konventionellen Südgrenze festhält – dagegen im Ellsworthland liegen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
