                "forms": [
                    {
                        "form_id": "95f19e12-c52d-4864-b7c3-d3c98b82545d",
                        "entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
                        "tags": [
                            "plural"
                        ],
                        "form": "dosages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1554c77c-2aca-35aa-8b08-d21a1560e6e8",
                        "entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
                        "glosses": [
                            "Action de doser."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "03cfcb26-609e-3489-99c3-451fd8d9d663",
                        "entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
                        "glosses": [
                            "Mesure d’une quantité de matière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59146c91-a129-414b-a7d4-247b7928e200",
                                "sense_id": "03cfcb26-609e-3489-99c3-451fd8d9d663",
                                "text": "Les bancs d’essai automatiques de dosage des protéines dans les céréales seront vérifiés globalement à l’aide de farines de référence."
                            },
                            {
                                "example_id": "304345d5-bc26-490a-828f-c58ad1c05860",
                                "sense_id": "03cfcb26-609e-3489-99c3-451fd8d9d663",
                                "text": "Plus exactement, la détection et le dosage des cytokines dans le sang, un biomarqueur inflammatoire, permettent de différencier les patients atteints de troubles bipolaires de ceux qui souffrent d’un trouble dépressif."
                            },
                            {
                                "example_id": "be776bb7-753f-46c4-8183-bfdb49bd2883",
                                "sense_id": "03cfcb26-609e-3489-99c3-451fd8d9d663",
                                "text": "Lucy se plongea dans ses dosages d’acide urique, de cholestérolémie et autres Numérations de Formules Sanguines avec un bonheur qui l’étonna."
                            }
                        ]
                    },
                    {
                        "sense_id": "55a01174-91cc-3f6b-aa8d-5d447d0d6bb3",
                        "entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
                        "glosses": [
                            "Détermination, calcul, de la dose d’un médicament."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "48f0df5e-e712-3b21-a9fc-712d5d9bd36d",
                        "entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
                        "glosses": [
                            "Répartition en proportions adéquates."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "73dd5f17-d5a5-3ab1-9f1b-408d3a7fa71e",
                        "entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
                        "glosses": [
                            "Modification d’un peuplement pour réduire la présence d’une essence ou éliminer des sujets indésirables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4520c34b-6748-43d4-ab95-57da84f5b2cd",
                                "sense_id": "73dd5f17-d5a5-3ab1-9f1b-408d3a7fa71e",
                                "text": "Une fois le choix des arbres objectif fait, le marteleur se consacre alors entièrement au dosage des arbres à enlever, opération qui nécessite déjà de la technicité."
                            },
                            {
                                "example_id": "5f22701d-e137-4799-9c5f-f35fbc55d965",
                                "sense_id": "73dd5f17-d5a5-3ab1-9f1b-408d3a7fa71e",
                                "text": "La gestion en futaie irrégulière permet l’installation des essences plus héliophiles comme le [c]hêne (sessile) à condition de pratiquer quelques travaux de dosages d’essences pour régler la trop forte concurrence qui leur est défavorable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5919e76b-1617-47ff-b140-f55160a9422c",
                        "source_entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
                        "source_sense_description": "action de doser",
                        "target_lang_word": "Dosierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dosierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d4ff049-3aa8-3d0d-97b5-b1b8279236f2",
                                        "entry_id": "39f58590-6137-3142-8701-90f7443a559e",
                                        "glosses": [
                                            "Festlegung der genauen Menge (Dosis) von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12d18a65-a13f-4ba1-8b3b-25326af297fd",
                                                "sense_id": "9d4ff049-3aa8-3d0d-97b5-b1b8279236f2",
                                                "text": "„Jahrelang war es mit den Medikamenten gutgegangen, wahrscheinlich stimmte einfach die Dosierung nicht mehr.“"
                                            },
                                            {
                                                "example_id": "cb45f8ae-1a18-414a-a212-03d205f6d6a4",
                                                "sense_id": "9d4ff049-3aa8-3d0d-97b5-b1b8279236f2",
                                                "text": "„Frauen bauen viele Antidepressiva langsamer ab, weil das aber bei der Dosierung nicht genug beachtet wird, leiden sie häufiger an Nebenwirkungen.“"
                                            },
                                            {
                                                "example_id": "2f2643f4-77b8-4a63-8061-1c197bcea0f0",
                                                "sense_id": "9d4ff049-3aa8-3d0d-97b5-b1b8279236f2",
                                                "text": "„Waschmittel sparsam nach Verschmutzungsgrad dosieren: Richten Sie sich nach der auf der Waschmittelpackung empfohlenen Dosierung.“"
                                            },
                                            {
                                                "example_id": "d22d2050-b361-4075-ad01-0f22ac741bed",
                                                "sense_id": "9d4ff049-3aa8-3d0d-97b5-b1b8279236f2",
                                                "text": "„Für Wäsche im Haushalt genügt meist die Dosierung für „leicht“ oder „normal“ verschmutzte Wäsche.“"
                                            },
                                            {
                                                "example_id": "36b2602a-eb67-4821-9748-e4b92c6ff6ba",
                                                "sense_id": "9d4ff049-3aa8-3d0d-97b5-b1b8279236f2",
                                                "text": "„Die Dosierung ist von der Wasserhärte abhängig. Weiches Wasser erfordert die geringste Waschmittelmenge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "134777d6-96a9-42c3-9966-90468c7878b8",
                        "source_entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
