                                    {
                                        "sense_id": "3d9cd974-9755-3c79-aaf8-022216d4a21a",
                                        "entry_id": "5d2cd490-0b44-37a5-8b50-2f4d05da3042",
                                        "glosses": [
                                            "Faire éprouver une démangeaison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ce69ca6-cafd-46c4-89fd-1e4188b48712",
                                                "sense_id": "3d9cd974-9755-3c79-aaf8-022216d4a21a",
                                                "text": "Le bras lui démange. - Quand le temps vient à changer, sa plaie lui démange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc4c6e9c-1393-3122-9eee-6d24c3b3408c",
                                        "entry_id": "5d2cd490-0b44-37a5-8b50-2f4d05da3042",
                                        "glosses": [
                                            "Donner grande envie de faire quelque chose."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5af9e5e-3b87-4e0d-913e-e1acce914c07",
                                                "sense_id": "fc4c6e9c-1393-3122-9eee-6d24c3b3408c",
                                                "text": "L'Orfèvre. – Bonsoir, voisin, le sang me démange ! il faut que j’aille au palais."
                                            },
                                            {
                                                "example_id": "8054ee71-de8a-4ef4-b668-0928f35272f5",
                                                "sense_id": "fc4c6e9c-1393-3122-9eee-6d24c3b3408c",
                                                "text": "La langue me démangea pour lui dire que mes parents le feraient bientôt sortir de prison, mais je pensai à temps qu’il ne convenait point de se vanter à l’avance des joies que l’on se proposait de faire, et je me contentai de l’assurer que bientôt il serait en liberté avec tous ses enfants autour de lui."
                                            },
                                            {
                                                "example_id": "3db423da-9b4e-426e-97e3-0c590de94b84",
                                                "sense_id": "fc4c6e9c-1393-3122-9eee-6d24c3b3408c",
                                                "text": "J'ai la guitare qui me démange,\nAlors je gratte un petit peu.\nÇa me soulage et ça s'arrange\nMais ça fait pas très sérieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49df33b9-ca72-3cec-ba9a-85b6f15e0232",
                                        "entry_id": "5d2cd490-0b44-37a5-8b50-2f4d05da3042",
                                        "glosses": [
                                            "Avoir envie de débattre, de combattre, etc."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0536ed77-b68a-47f3-ac83-8c408e195e9f",
                                                "sense_id": "49df33b9-ca72-3cec-ba9a-85b6f15e0232",
                                                "text": "Les poings, les mains, les doigts, la langue lui démangent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
