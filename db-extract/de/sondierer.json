                "senses": [
                    {
                        "sense_id": "a1006cac-914c-3df0-86b7-c76e4b3c95a9",
                        "entry_id": "7ece2514-230c-3fe7-b5e7-3e26191d54f1",
                        "glosses": [
                            "Teilnehmer an einem Vorgespräch zu einer Koalitionsverhandlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "800f70fa-71e0-44d6-a134-df221c6b8583",
                                "sense_id": "a1006cac-914c-3df0-86b7-c76e4b3c95a9",
                                "text": "„Auf den allerersten Blick, da sind sich alle Sondierer einig: Deutschland muss seine Klimaziele einhalten.“"
                            },
                            {
                                "example_id": "84554e4c-154f-4e7d-8b9b-b7483448f05e",
                                "sense_id": "a1006cac-914c-3df0-86b7-c76e4b3c95a9",
                                "text": "„Aus den Gesprächen soll jedoch nichts nach draußen dringen: Laut einem Bericht haben sich die Sondierer ein Interview-Verbot auferlegt.“"
                            },
                            {
                                "example_id": "069888af-a6a0-4096-a4fe-44a7e42a65ba",
                                "sense_id": "a1006cac-914c-3df0-86b7-c76e4b3c95a9",
                                "text": "„Die Sondierer hatten eigentlich vereinbart, dass am Ende jedes Verhandlungstages nur ein Vertreter der jeweils gastgebenden Partei eine Erklärung abgibt.“"
                            },
                            {
                                "example_id": "c074dbdb-70d8-469c-ae7a-8e1d27e054b9",
                                "sense_id": "a1006cac-914c-3df0-86b7-c76e4b3c95a9",
                                "text": "„Am Donnerstag, spätestens am Freitag wollen die Sondierer ein Ergebnispapier vorlegen, auf dessen Grundlage dann die SPD-Führung der Partei offizielle Koalitionsverhandlungen empfehlen könnte oder eben nicht.“"
                            },
                            {
                                "example_id": "423bf525-ff88-40ed-938e-0fadf0aed69e",
                                "sense_id": "a1006cac-914c-3df0-86b7-c76e4b3c95a9",
                                "text": "„Insgesamt wirkten die Sondierer optimistisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2b3d6042-45d9-36c8-8291-547f3dca8920",
                        "entry_id": "7ece2514-230c-3fe7-b5e7-3e26191d54f1",
                        "glosses": [
                            "jemand, der eine Lage erkundet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b929a42-7d1c-4ca4-99ed-033ef959f5c8",
                                "sense_id": "2b3d6042-45d9-36c8-8291-547f3dca8920",
                                "text": "„Der Sondierer ist derjenige, der in aufklärender Mission vorausfährt, um alle für die Sicherheit des Präsidenten notwendigen Vorbereitungen zu treffen.“"
                            },
                            {
                                "example_id": "420b2997-401e-4fb8-b24d-e19366e13f7b",
                                "sense_id": "2b3d6042-45d9-36c8-8291-547f3dca8920",
                                "text": "„Neben Kommentkämpfern und Beschädigungskämpfern gibt es noch Sondierer, Einschüchterer und Vergelter.“"
                            },
                            {
                                "example_id": "8db1913c-43e6-408f-be89-8c038cbd3def",
                                "sense_id": "2b3d6042-45d9-36c8-8291-547f3dca8920",
                                "text": "„Ein mönchischer Examinator mit zu genauem Blick, zwei Folterknechte, versierte Sondierer, er gab ihnen die Gesichtszüge von Faustino Genaro und Esteban Vicario, die mit einer Art Stilett den nackten Körper einer vom Betrachter abgewandten Frau nach dem Teufelszeichen untersuchten.“"
                            },
                            {
                                "example_id": "88db5cf2-a64c-4eb1-8c26-d6f3ef4ad7f7",
                                "sense_id": "2b3d6042-45d9-36c8-8291-547f3dca8920",
                                "text": "„So brauchen 20 Sondierer für die sogenannte Grobsondierung eines Hektars etwa vier Stunden, während der Hund zum raschen Absuchen desselben Raumes etwas 30 Minuten benötigt.“"
                            },
                            {
                                "example_id": "0455304f-d891-4e4e-883f-cf3d9825153a",
                                "sense_id": "2b3d6042-45d9-36c8-8291-547f3dca8920",
                                "text": "„Der Rotschenkel weist sich durch dieses Merkmal als überwiegend optisch orientiert suchender Vogel, Kampfläufer und noch deutlicher der Alpenstrandläufer als Sondierer aus […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
