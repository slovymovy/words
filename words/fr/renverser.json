{
    "word_family": [
        "renversement",
        "renversable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1426ce1f-5659-3f33-8cf1-fbf78b389f92",
                    "sense_definition": "Répandre involontairement un liquide ou un contenu hors de son récipient en le faisant basculer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "faire_tomber",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais attention à ne pas <w>renverser</w> ton café sur mes documents."
                        },
                        {
                            "text": "L'enfant a bougé le bras et a <w>renversé</w> tout son verre de lait."
                        }
                    ],
                    "synonyms": [
                        "verser"
                    ],
                    "common_phrases": [
                        "renverser son verre",
                        "renverser du café"
                    ]
                },
                {
                    "sense_id": "bc04caae-5c27-38ab-8ffe-db9ab9f7fa93",
                    "sense_definition": "Faire tomber une personne ou un objet au sol en le heurtant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "faire_tomber",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une voiture roulant à vive allure a <w>renversé</w> un cycliste hier soir."
                        },
                        {
                            "text": "En courant dans le couloir, il a <w>renversé</w> une chaise sans le faire exprès."
                        }
                    ],
                    "common_phrases": [
                        "renverser un piéton",
                        "renverser une chaise"
                    ]
                },
                {
                    "sense_id": "b6fcf4af-fcb4-3a9b-bb47-ded7c4d009cd",
                    "sense_definition": "Modifier totalement une tendance ou l'état d'une situation pour lui donner un cours opposé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inverser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe a réussi à marquer deux buts et à <w>renverser</w> la situation avant la fin du match."
                        },
                        {
                            "text": "Cette décision économique pourrait <w>renverser</w> la tendance actuelle du marché."
                        }
                    ],
                    "common_phrases": [
                        "renverser la situation",
                        "renverser la tendance"
                    ]
                },
                {
                    "sense_id": "2109aaf3-a3a1-3a5f-907e-dce652c52a77",
                    "sense_definition": "Destituer une autorité établie, faire choir un gouvernement ou un dirigeant politique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les manifestants se sont réunis pour tenter de <w>renverser</w> le gouvernement autoritaire."
                        },
                        {
                            "text": "L'armée a pris le contrôle de la capitale afin de <w>renverser</w> le président en exercice."
                        }
                    ],
                    "common_phrases": [
                        "renverser le pouvoir",
                        "renverser le gouvernement",
                        "renverser un régime"
                    ]
                },
                {
                    "sense_id": "79290e97-6db7-3ea5-baf1-4f55e0b9c70b",
                    "sense_definition": "Provoquer une vive surprise, un choc ou un grand étonnement chez quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La nouvelle de son départ soudain me <w>renverse</w> complètement."
                        },
                        {
                            "text": "Ce spectacle visuel a vraiment de quoi <w>renverser</w> le public."
                        }
                    ]
                },
                {
                    "sense_id": "f2e22966-8f80-3bb6-b4c0-cc77bcb229b4",
                    "sense_definition": "Se pencher en arrière, s'adosser lourdement dans un siège ou appuyer son dos.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fatigué par sa longue journée, il s'est <w>renversé</w> dans son fauteuil pour se reposer."
                        },
                        {
                            "text": "Elle éclata de rire et se <w>renversa</w> en arrière sur le canapé."
                        }
                    ],
                    "common_phrases": [
                        "se renverser en arrière"
                    ]
                }
            ]
        }
    ]
}