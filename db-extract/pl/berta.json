            {
                "entry_id": "f6e822ce-7bf0-32b1-89f1-2340545a8d95",
                "word": "Berta",
                "pos": "name",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "138914de-b801-39e7-b4b3-9e307f63d975",
                        "entry_id": "f6e822ce-7bf0-32b1-89f1-2340545a8d95",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b127338b-ee2a-4f0a-8ecb-9871dcc87caf",
                                "sense_id": "138914de-b801-39e7-b4b3-9e307f63d975",
                                "text": "Zaręczył się z panną Bertą."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13e6edd3-d6f2-4d17-89d2-6bbb1ea1d02e",
                        "source_entry_id": "f6e822ce-7bf0-32b1-89f1-2340545a8d95",
                        "source_sense_id": "138914de-b801-39e7-b4b3-9e307f63d975",
                        "target_lang_word": "Berthe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berthe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27d90dd6-c2fc-30f7-b87c-74163ddc94c1",
                                        "entry_id": "716daaad-215b-33f6-bf15-02ee2f8ac1ab",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a97e73-50b0-4c24-8c60-7c1619cc63a1",
                                                "sense_id": "27d90dd6-c2fc-30f7-b87c-74163ddc94c1",
                                                "text": "Au-dessus de chez la pauvre vieille grand’mère qui chantait la Marseillaise, au second étage, dans la partie de notre maison qui donnait sur des cours et des jardins, habitait ma grand’tante Berthe."
                                            },
                                            {
                                                "example_id": "ee04bf02-8eac-4d56-85aa-50bc50eab446",
                                                "sense_id": "27d90dd6-c2fc-30f7-b87c-74163ddc94c1",
                                                "text": "Ce n’est pas que mademoiselle Berthe de Manicamp soit plus mal qu’une autre… Au contraire, elle est jolie, spirituelle, riche… oui, mais elle a un défaut, elle est petite… oh ! mais petite !… tandis que ma cousine Aloïse !… une cousine de cinq pieds quatre pouces !…"
                                            },
                                            {
                                                "example_id": "b7c220cc-5c88-451f-9f0b-c7ad193e8ad7",
                                                "sense_id": "27d90dd6-c2fc-30f7-b87c-74163ddc94c1",
                                                "text": "Pour comble de malheur, le hasard voulut que Suzanne et Berthe, qui se promenaient ensemble, rencontrassent l’abbé Madeline, juste devant la porte ; et ils s’étaient arrêtés tous les trois, ils attendaient."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Berthe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "afd01766-e377-3493-842c-1cd6e9bdd718",
                                        "entry_id": "4ec7d6f3-8782-3fad-9c60-2034dfcbeb88",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80117104-f03a-4aa0-8885-610e1f4c795e",
                                                "sense_id": "afd01766-e377-3493-842c-1cd6e9bdd718",
                                                "text": "Le podium de la marche athlétique est représenté par Laurent Schneider en 1ᵉʳ (34’20), Philippe Berthe en 2ᵉ, Vanessa Roy en 3ᵉ et en 1ʳᵉ féminine aussi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f1cba81-a165-42b8-bc50-cb87bd43ccc0",
                        "source_entry_id": "f6e822ce-7bf0-32b1-89f1-2340545a8d95",
                        "source_sense_id": "138914de-b801-39e7-b4b3-9e307f63d975",
                        "target_lang_word": "Берта",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Берта",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d74b91a6-96fe-31b9-a6c5-2d2045871830",
                                        "entry_id": "a26c4a8b-c212-3f9b-96dc-c7b7c0c17078",
                                        "glosses": [
                                            "женское имя германского происхождения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8365eb71-9b4f-4a11-87c4-ee3b1e0918c2",
                                                "sense_id": "d74b91a6-96fe-31b9-a6c5-2d2045871830",
                                                "text": "Не я один любил Берту: лакей наш Яков Игнатьевич не мог пережить ее, просто умер с горя и с вина, через неделю после ее смерти."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
