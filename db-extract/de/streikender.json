                "senses": [
                    {
                        "sense_id": "e0fe64f6-6405-30bc-9eb3-41b82f605b96",
                        "entry_id": "1358b61e-9e17-31a7-9f0d-be9226e0df86",
                        "glosses": [
                            "jemand, der an einem Streik teilnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0968dd0b-9592-4530-a4a6-368ccf59ccfb",
                                "sense_id": "e0fe64f6-6405-30bc-9eb3-41b82f605b96",
                                "text": "„Ein Streikender stößt seinen Speer in das Pferd, der Reiter wird heruntergezerrt.“"
                            },
                            {
                                "example_id": "dc81a5a2-b68a-4403-b647-d2380fdb9087",
                                "sense_id": "e0fe64f6-6405-30bc-9eb3-41b82f605b96",
                                "text": "„Ab März 1917 kam es bei der Wiener Arbeiterschaft, die unter Hunger, Mangel an Kleidung und Schuhen, langer Arbeitszeit und hohem Arbeitstempo litt, immer wieder zu Streiks, darunter zu einem im Mai 1917 in Wiener Großbetrieben mit einer Zahl von rund 42.000 Streikenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b54e470-985c-4af2-97f7-141fbc1cc22c",
                        "source_entry_id": "1358b61e-9e17-31a7-9f0d-be9226e0df86",
                        "source_sense_id": "e0fe64f6-6405-30bc-9eb3-41b82f605b96",
