                        "sense_id": "54513429-8919-3c85-92a2-bb6bd0f5cc67",
                        "entry_id": "bbd507b9-5db2-332c-9756-7a72d88a81d2",
                        "glosses": [
                            "Ancien ciment riche en oxyde de fer, constitué de carbonate de calcium et d'argile. Il était aussi nommé ciment des galets de Boulogne, car il fut produit à l'aide de galets de la côte boulonnaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba97edad-b609-413f-a83d-62d9009bf403",
                                "sense_id": "54513429-8919-3c85-92a2-bb6bd0f5cc67",
                                "text": "Outre l'argile, les plâtres-ciments contiennent toujours une assez grande proportion d'oxyde de fer."
                            },
                            {
                                "example_id": "119fa8ab-d59b-4595-9776-e868dda0754b",
                                "sense_id": "54513429-8919-3c85-92a2-bb6bd0f5cc67",
                                "text": "La propriété importante du plâtre-ciment est de faire prise sous l'eau, et d'apporter une grande économie, ainsi que beaucoup de solidité dans les travaux hydrauliques."
                            }
                        ]
                    }
