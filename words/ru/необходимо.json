                                "cs": "Tato podmínka je <w>nezbytná</w> pro nabytí účinnosti zákona.",
                                "tr": "Bu koşul, yasanın yürürlüğe girmesi için <w>gerekli</w>.",
                                "es": "Esta condición es <w>necesaria</w> para que la ley entre en vigor."
                            }
                        },
                        {
                            "text": "Ваше присутствие на собрании <необходимо>.",
                            "target_lang_translations": {
                                "en": "Your presence at the meeting is <necessary>.",
                                "zh": "你出席会议是<w>必要</w>的。",
                                "nl": "Uw aanwezigheid bij de vergadering is <w>noodzakelijk</w>.",
                                "pl": "Twoja obecność na spotkaniu jest <w>niezbędna</w>.",
                                "de": "Ihre Anwesenheit bei der Versammlung ist <w>erforderlich</w>.",
                                "fr": "Votre présence à la réunion est <w>nécessaire</w>.",
                                "it": "La sua presenza alla riunione è <w>necessaria</w>.",
                                "cs": "Vaše přítomnost na schůzi je <w>nutná</w>.",
                                "tr": "Toplantıda bulunmanız <w>gerekli</w>.",
                                "es": "Su presencia en la reunión es <w>necesaria</w>."
                            }
                        }
