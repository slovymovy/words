                    {
                        "sense_id": "44462fd2-dc7b-3aec-8fab-91e2b64c9ed7",
                        "entry_id": "2d681201-7acc-3c98-8372-5f7dc64bdf4b",
                        "glosses": [
                            "Ruhephase des Wassers zwischen Ebbe und Flut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc6e49d6-97f5-4b37-9633-c7023d871360",
                                "sense_id": "44462fd2-dc7b-3aec-8fab-91e2b64c9ed7",
                                "text": "„Diese Ruhepunkte zwischen Ebbe und Flut und wiederum zwischen Flut und Ebbe, die Stauzeiten, find für die Bildung der Seemarschen, für ihre Erweiterung und Entwickelung von der allergrößten Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b2da934-0bb8-3ed4-b2d2-2adb56809745",
                        "entry_id": "2d681201-7acc-3c98-8372-5f7dc64bdf4b",
                        "glosses": [
                            "diejenigen Stunden, Tage, in denen Verkehrsstockung herrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18fa7b21-c5a7-42b0-9059-5471a684baa0",
                                "sense_id": "6b2da934-0bb8-3ed4-b2d2-2adb56809745",
                                "text": "„Doch Reisezeit bedeutet alljährlich auch Stauzeit.“"
                            },
                            {
                                "example_id": "8e022fdb-4e70-4eb4-bb8a-3b2756516393",
                                "sense_id": "6b2da934-0bb8-3ed4-b2d2-2adb56809745",
                                "text": "„Pendeln Sie täglich von Ihrem Heimatort zu Ihrem Arbeits- oder Studienort und haben bereits daran gedacht, die „Stauzeit“ besser zu nutzen und in Wien zu wohnen?“"
                            }
                        ],
