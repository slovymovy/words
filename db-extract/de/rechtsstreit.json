                                        "examples": [
                                            {
                                                "example_id": "aa683af4-8f03-4b9e-81d6-95caf64cfa03",
                                                "sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                                                "text": "There is ongoing litigation in this matter."
                                            },
                                            {
                                                "example_id": "27a0b19a-c247-45b6-a160-55c88ce1dfa0",
                                                "sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                                                "text": "This law firm is known for its litigation practice."
                                            },
                                            {
                                                "example_id": "eaee35b6-ac3f-4017-862f-16324f5272b9",
                                                "sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                                                "text": "That attorney has been chastised for his litigation behavior."
                                            },
                                            {
                                                "example_id": "8f654274-bd96-4f3e-ac5a-859b7dcb1444",
                                                "sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                                                "text": "“Google admitted that — for litigations spanning the past five years — it has never preserved all chats for relevant individuals by turning chat history on,” the DOJ filing said."
                                            },
                                            {
                                                "example_id": "d96401f4-85f0-413b-9ede-4a7963c9472a",
                                                "sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                                                "text": "The willingness to bring more marginal legal cases reflects how the amount of money being put toward election litigation has increased significantly, said Derek Muller, an election law professor at the University of Notre Dame who noted that the trend also applies to Democrats and outside groups across the ideological spectrum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
