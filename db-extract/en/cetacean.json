                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cétacé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4cc2afd-16aa-397c-84a6-5ad27d116ec9",
                                        "entry_id": "ca37b4ed-801f-3ada-a680-a5af3c493d7b",
                                        "glosses": [
                                            "Qui a la forme de poissons, en parlant de grands mammifères, tels que les baleines, les dauphins, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cb51c78-a152-49f0-ba71-32328fa6def5",
                                                "sense_id": "b4cc2afd-16aa-397c-84a6-5ad27d116ec9",
                                                "text": "Le cochon a cela de commun avec la baleine et les autres animaux cétacés, dont la graisse n'est qu'une espèce de lard à peu près de la même consistance, mais plus huileux que celui du cochon : ce lard, dans les animaux cétacés, forme aussi sous la peau une couche de plusieurs pouces d'épaisseur, qui enveloppe la chair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc3ae2c-7e26-3076-8f10-22f8b11b4db5",
                                        "entry_id": "ca37b4ed-801f-3ada-a680-a5af3c493d7b",
                                        "glosses": [
                                            "De gros animal marin."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d22f76e-85be-4fb5-8216-fd4496f76747",
                                                "sense_id": "cbc3ae2c-7e26-3076-8f10-22f8b11b4db5",
                                                "text": "Il était bien à l’abri dans le ventre cétacé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cétacé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9ab8924-ca28-3aef-9f02-2408b005e3d2",
                                        "entry_id": "558cb32d-5ad3-374f-a96b-be0c9602d422",
                                        "glosses": [
                                            "Mammifère marin de l’infra-ordre des cétacés, tel que la baleine ou le dauphin."
                                        ],
                                        "tags": [
                                            "Cétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee962459-57c8-444d-855f-e5532614ddb4",
                                                "sense_id": "e9ab8924-ca28-3aef-9f02-2408b005e3d2",
                                                "text": "Lorsqu’une bande de baleines est signalée, la nouvelle se répand aussitôt dans tout l’archipel au moyen de feux allumés sur les montagnes ; des centaines d’embarcations affluent de tous côtés, forment un immense demi-cercle autour des cétacés et les chassent vers quelque crique, où ils sont promptement massacrés."
                                            },
                                            {
                                                "example_id": "d7248824-ad08-409e-974e-71491fc0fde9",
                                                "sense_id": "e9ab8924-ca28-3aef-9f02-2408b005e3d2",
                                                "text": "En 1845, New York s’ébaudissait devant le squelette d’Hydrargos, « le grand serpent des mers », long de 34 mètres. Albert Koch, qui exhibait sous ce nom le cétacé fossile Basilosaurus, avait pris soin de l’allonger en multipliant ses vertèbres, et l’imposteur fit fortune."
                                            },
                                            {
                                                "example_id": "fd557c92-e753-457d-9fad-51bf290c3e33",
                                                "sense_id": "e9ab8924-ca28-3aef-9f02-2408b005e3d2",
                                                "text": "Si c’était un cétacé, il surpassait en volume tous ceux que la science avait classés jusqu’alors."
                                            },
                                            {
                                                "example_id": "d594cf23-ee99-4544-a05c-c68abce37cb1",
                                                "sense_id": "e9ab8924-ca28-3aef-9f02-2408b005e3d2",
                                                "text": "[Linné] entreprend de classer les mammifères en fonction de leur dentition, et classe parmi eux les cétacés, jusqu’alors mis dans la catégorie des poissons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
