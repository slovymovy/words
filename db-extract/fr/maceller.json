                "senses": [
                    {
                        "sense_id": "73f8fa57-9c67-3c43-aa91-21f93736b949",
                        "entry_id": "f4c1bcd4-54f9-3f4e-86e4-a8a2bdb08208",
                        "glosses": [
                            "Tuer, abattre."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "90e76785-a47b-478b-9aaa-6c4a1cf81ebd",
                                "sense_id": "73f8fa57-9c67-3c43-aa91-21f93736b949",
                                "text": "La Ragioneria autorise les bouchers « à maceller et vendre la viande, sous le contrôle des regardateurs et sans rien payer à la cité »."
                            },
                            {
                                "example_id": "d59eba25-9088-45cb-be35-0818ccf873d5",
                                "sense_id": "73f8fa57-9c67-3c43-aa91-21f93736b949",
                                "text": "Or voici le poignard qui te va périr, méchant ça ! que je te cloue le chef ; mais non, reprit-elle, réfléchissant soudain, prétends te maceller ainsi qu’un bœuf, et, détachant de la muraille une masse d’armes, elle la brandit sur la tête de Ripert."
                            }
                        ]
                    }
                ],
