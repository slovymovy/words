                        "glosses": [
                            "stuk grond waarop één of meer fabrieken gebouwd zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d586e8ae-2b84-4e4a-b241-4e58c69d27de",
                                "sense_id": "19348bbb-2afc-381d-b5ee-90aa06105a1b",
                                "text": "Twee dagen later reden Marten en ik naar een afgelegen fabrieksterrein waar in een loods een bedrijfsbanja was gevestigd."
                            },
                            {
                                "example_id": "639f09ed-b7c0-4a16-b93e-22026807d958",
                                "sense_id": "19348bbb-2afc-381d-b5ee-90aa06105a1b",
                                "text": "De gemeente Maastricht wilde oorspronkelijk 814 woningen op het voormalig fabrieksterrein bouwen, maar een zakenman kocht de grond onlangs op. Hij mag er een loods bouwen, omdat er geen voorbereidingsbesluit is genomen voor de woningbouw."
                            }
                        ]
                    }
