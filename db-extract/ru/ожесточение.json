                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db7a726d-0974-3ba6-a5f7-91cb338fd3d3",
                                        "entry_id": "1c2acdca-1098-3bef-a20e-53f6fda0fb4c",
                                        "glosses": [
                                            "Gefühlslage großer Enttäuschung und Ablehnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2290e54d-323b-4a1e-8e18-46d29c7622be",
                                                "sense_id": "db7a726d-0974-3ba6-a5f7-91cb338fd3d3",
                                                "text": "„Für Verbitterung sorge, kritisierte von Jagow am 22. August 1914, dass auch staatliche und sogar Militärbetriebe lieber ihre festen Mitarbeiter Überstunden machen ließen, als Arbeitssuchende einzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cced293e-e9b6-4d92-b606-4a9369d4f14d",
                        "source_entry_id": "e92c12a5-6947-3d01-b327-24baaea931fe",
                        "target_lang_word": "Erbitterung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erbitterung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57917d83-dd96-35fb-9061-be36fefab706",
                                        "entry_id": "6ff95382-fd6c-329b-ad06-28bb5ac0ea48",
                                        "glosses": [
                                            "Eigenschaft/Zustand, über etwas erbittert zu sein, einen Sachverhalt emotional heftig abzulehnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edef4a59-bdcc-4926-97e3-b5a33205215b",
                                                "sense_id": "57917d83-dd96-35fb-9061-be36fefab706",
                                                "text": "„Sie waren viel zu verspielt, um sich von oben mit Feindseligkeit und Groll und Erbitterung indoktrinieren zu lassen.“"
                                            },
                                            {
                                                "example_id": "ec8e06d4-854e-473f-a517-50ac72a676bc",
                                                "sense_id": "57917d83-dd96-35fb-9061-be36fefab706",
                                                "text": "„Es war der Gipfel der Erbitterung seitens der böhmischen Stände, dass trotz der vom Kaiser zugesagten Privilegien Maßnahmen zur Rekatholisierung stattfanden.“"
                                            },
                                            {
                                                "example_id": "000228fa-a92d-4651-b1b2-3005d5b38d76",
                                                "sense_id": "57917d83-dd96-35fb-9061-be36fefab706",
                                                "text": "„Die Erbitterung der Deutschen in dieser Situation war unermesslich.“"
                                            },
                                            {
                                                "example_id": "9bc7f916-03b2-47c6-b1ee-291af21adab0",
                                                "sense_id": "57917d83-dd96-35fb-9061-be36fefab706",
                                                "text": "„Sein Gesicht hatte plötzlich einen Ausdruck von Erbitterung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1be9b172-5763-4922-a0e6-35c0cfd9e53c",
                        "source_entry_id": "e92c12a5-6947-3d01-b327-24baaea931fe",
                        "target_lang_word": "Härte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Härte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ab898e2-ffe2-36b2-93ff-5870e98ea80d",
                                        "entry_id": "ac8d724a-80f0-35ce-90be-f19abc5e88f2",
                                        "glosses": [
                                            "Qualität oder Grad der Eigenschaft, hart zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea25c512-84d9-455e-898b-0bfd2bf7d334",
                                                "sense_id": "6ab898e2-ffe2-36b2-93ff-5870e98ea80d",
                                                "text": "Stahl besitzt eine große Härte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73ec56f5-576d-3e24-889b-d21b16aa66d5",
                                        "entry_id": "ac8d724a-80f0-35ce-90be-f19abc5e88f2",
                                        "glosses": [
                                            "Strenge"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc5fbc40-b78e-45e4-b3b1-39ea0d26e04f",
                                                "sense_id": "73ec56f5-576d-3e24-889b-d21b16aa66d5",
                                                "text": "Sie bekam die volle Härte des Gesetzes zu spüren."
                                            },
                                            {
                                                "example_id": "059673eb-501b-4dd5-8f21-d10c2871a7a1",
                                                "sense_id": "73ec56f5-576d-3e24-889b-d21b16aa66d5",
                                                "text": "„Er war vielmehr durchaus sehr beeindruckt von dem ganzen Getue um Männlichkeit und Härte.“"
                                            },
                                            {
                                                "example_id": "58231edb-a8ce-4e99-8596-8c77e440e72f",
                                                "sense_id": "73ec56f5-576d-3e24-889b-d21b16aa66d5",
                                                "text": "„Auch Licinius Crassus, Enkel des Triumvirn, bekam die Härte des Kaisers zu spüren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bf28f173-5f44-3467-ac48-90e53e4d1846",
                                        "entry_id": "ac8d724a-80f0-35ce-90be-f19abc5e88f2",
                                        "glosses": [
                                            "Stärke, Intensität, Heftigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "126f310d-9040-4b21-8a7f-4604884a219b",
                                                "sense_id": "bf28f173-5f44-3467-ac48-90e53e4d1846",
                                                "text": "Der Winter war in seiner ganzen Härte zu spüren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b309686c-7480-3a33-8b21-43c7142bdbf8",
