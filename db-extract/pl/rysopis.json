                        "cross_references": [
                            {
                                "target_word": "Beschreibung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55a5cd55-f662-3d5b-8b13-7eb56e77ff19",
                                        "entry_id": "3a113cf6-58f1-308d-96e0-f25ae30777d3",
                                        "glosses": [
                                            "Aufzählung oder Schilderung von Merkmalen und Eigenschaften von etwas/jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a16352de-784a-490f-a2d7-de19c3152425",
                                                "sense_id": "55a5cd55-f662-3d5b-8b13-7eb56e77ff19",
                                                "text": "Bitte gib mir eine genaue Beschreibung des Weges, damit ich die Tankstelle auch finde."
                                            },
                                            {
                                                "example_id": "ee89ee41-2b13-4859-82ea-401e5661a5ee",
                                                "sense_id": "55a5cd55-f662-3d5b-8b13-7eb56e77ff19",
                                                "text": "„Sprachkritik ist die Beschreibung, Analyse und Bewertung von sprachlichen Äußerungen.“"
                                            },
                                            {
                                                "example_id": "dac3763b-a35a-491e-afd3-3b7b4628178b",
                                                "sense_id": "55a5cd55-f662-3d5b-8b13-7eb56e77ff19",
                                                "text": "„Der kurzatmige Pflanzer war ganz lebendig in der Beschreibung seiner und der allegmeinen Not geworden.“"
                                            },
                                            {
                                                "example_id": "4a856496-7219-44ab-bbee-686a172a29d1",
                                                "sense_id": "55a5cd55-f662-3d5b-8b13-7eb56e77ff19",
                                                "text": "„Es ist normalerweise unbefriedigend, nur bei der Beschreibung von Sachverhalten oder gar Veränderungen stehenzubleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a397406d-744f-32fd-a3a3-3da6317387fe",
                                        "entry_id": "3a113cf6-58f1-308d-96e0-f25ae30777d3",
                                        "glosses": [
                                            "textliches Beschreiben eines Blatts Papier, einer digitalen Datei oder von Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07a697c1-dff1-48c1-bee4-9a67f6370f5b",
                                                "sense_id": "a397406d-744f-32fd-a3a3-3da6317387fe",
                                                "text": "Die Beschreibung einer Diskette dauerte verhältnismäßig lange."
                                            }
