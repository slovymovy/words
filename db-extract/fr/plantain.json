                "senses": [
                    {
                        "sense_id": "e79ff5e5-37ec-3d7e-b998-1b4612798d17",
                        "entry_id": "2dcc1096-c37b-31b9-98c9-a303cde2344f",
                        "glosses": [
                            "Nom usuel donné aux plantes du genre Plantago, dont de nombreuses espèces sont très communes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f0760dec-e78e-3c01-bb8b-04800eda3a49",
                        "entry_id": "2dcc1096-c37b-31b9-98c9-a303cde2344f",
                        "glosses": [
                            "Nom donné à diverses plantes aquatiques par ressemblance avec le \\\"véritable plantain\\\"'. → voir alisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ced0db56-4924-474c-97df-4d944d258e3b",
                                "sense_id": "f0760dec-e78e-3c01-bb8b-04800eda3a49",
                                "text": "Plantain aquatique ou plantain d’eau."
                            },
                            {
                                "example_id": "f782b4ca-1e58-49fd-abd6-9bd82ac7e2ab",
                                "sense_id": "f0760dec-e78e-3c01-bb8b-04800eda3a49",
                                "text": "Elle ne savait plus pourquoi l’idée lui était venue d’aller passer un mois chez miss Bell. Et vraiment elle ne l’avait jamais bien su. C’était comme une source d’abord cachée par quelques brins de plantain, qui, maintenant, formait le courant d’une eau profonde et rapide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c5e3e24-927a-4d22-996c-4608d8a7a333",
                        "source_entry_id": "2dcc1096-c37b-31b9-98c9-a303cde2344f",
                        "target_lang_word": "Wegerich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wegerich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "448dc237-6d43-3228-9b0e-0a5d110b5e00",
                                        "entry_id": "3f8ed6ff-4ea3-39fb-b9b7-a8459a2d0967",
                                        "glosses": [
                                            "Pflanzengattung, deren Vertreter – niedrige, unscheinbare Pflanzen – unter anderem an Wegen und auf Trampelpfaden wachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8a86f5b-4403-42a9-b924-01ad12c42d0e",
                                                "sense_id": "448dc237-6d43-3228-9b0e-0a5d110b5e00",
                                                "text": "Hier wächst Wegerich, da muss öfter mal jemand entlanggehen."
                                            },
                                            {
                                                "example_id": "e6b32b5b-563e-4bfd-9624-6474ad23629d",
                                                "sense_id": "448dc237-6d43-3228-9b0e-0a5d110b5e00",
                                                "text": "„Am Flussufer wucherte Wegerich, die Heilpflanze seiner Kinderzeit, deren Blätter auf Wunden und Geschwüre gelegt worden waren.“"
                                            },
                                            {
                                                "example_id": "9ae1dda2-1098-418d-a2f2-63f7af3ed46e",
                                                "sense_id": "448dc237-6d43-3228-9b0e-0a5d110b5e00",
                                                "text": "„Erst hatten sie mich angefaucht, wenn ich ihnen ihren Löwenzahn oder ihren Wegerich hingelegt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9231d876-fd6e-4188-a677-79121d663e1a",
                        "source_entry_id": "2dcc1096-c37b-31b9-98c9-a303cde2344f",
                        "target_lang_word": "plantain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plantain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b06f432-ae41-3d75-bf67-1696f05287d1",
                                        "entry_id": "8303f4ab-468c-3a62-8e0c-5f251f2e8fa0",
                                        "glosses": [
                                            "Any plant of the genus Plantago, with a rosette of sessile leaves about 10 cm (4\\\") long with a narrow part instead of a petiole, and with a spike inflorescence with the flower spacing varying widely among the species. See also psyllium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1144732-6bea-40da-ae19-237ec2b925a5",
                                                "sense_id": "9b06f432-ae41-3d75-bf67-1696f05287d1",
                                                "text": "The roots of Plantain and Pellitory of Spain beaten to powder and put into hollow teeth, takes away the pains of them."
                                            },
                                            {
                                                "example_id": "17a6aa9f-f557-4a03-8b83-68ec400afed5",
                                                "sense_id": "9b06f432-ae41-3d75-bf67-1696f05287d1",
                                                "text": "The paths too are overgrown, but easily identified by the presence on them of round-leaved plantains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plantain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dc3e2b4-aafc-3519-9fa2-dce79421e540",
                                        "entry_id": "3114d03a-4707-380d-a1c4-50b6df60675d",
                                        "glosses": [
                                            "A plant in the genus Musa, the genus that includes banana, but with lower sugar content than banana."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95d9dd1f-e296-32ae-8fec-f2f3d1e05849",
                                        "entry_id": "3114d03a-4707-380d-a1c4-50b6df60675d",
                                        "glosses": [
                                            "The fruit of the plant, usually cooked before eating and used like potatoes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "116af7bc-793c-4a9f-9235-60d6199b62ef",
                                                "sense_id": "95d9dd1f-e296-32ae-8fec-f2f3d1e05849",
                                                "text": "We were sitting at the tables in the port, eating an unhurried breakfast of delicious mojarra fish from the swamp and slices of fried green plantain, when my mother resumed the offensive in her personal war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
