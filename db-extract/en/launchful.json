                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f89ef68-72bc-46f1-8e9a-020dadf0b87a",
                                "sense_id": "889257a8-2288-3c22-a407-49621014f968",
                                "text": "So at one in the morning Major Harvey, with a launchful of his soldiers, paid a surprise visit to the Ruffling Harry, with the result that they picked up nothing more solid than a hempen cable floating at the moorings."
                            },
                            {
                                "example_id": "c1cffd1e-f37a-4f4a-9b3d-ab23df0daf0c",
                                "sense_id": "889257a8-2288-3c22-a407-49621014f968",
                                "text": "They eject a few dozen launchfuls of tourists, greedy-eyed for the scenery, whom the Messrs Reid gather in and prescribe for for a few hours or a few months as the case may be."
                            }
                        ]
                    }
