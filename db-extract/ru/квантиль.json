                                        "entry_id": "435a88c3-577f-3b33-8c8c-841298386de0",
                                        "glosses": [
                                            "Describing the quality of a sedimentary stone as it relates to the sediments to cohesively bond without fracturing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03d7451f-6fab-4dcb-81b4-6958ff2d1854",
                                                "sense_id": "71e7bafc-a5b5-3f9e-b057-f59ab37af897",
                                                "text": "A stone with a low fractile strength lacks tensile strength and will crack or crumble under stress or pressure."
                                            }
