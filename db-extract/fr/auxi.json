                "senses": [
                    {
                        "sense_id": "06d53cd4-f947-394e-b702-e372f35c59d8",
                        "entry_id": "cc9e8b82-2552-310c-b4fe-af0e01e5a76d",
                        "glosses": [
                            "Détenu travaillant dans le service général d’une prison française."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df762882-eabd-440f-8934-f97c235f3751",
                                "sense_id": "06d53cd4-f947-394e-b702-e372f35c59d8",
                                "text": "Ils avaient des auxis, valets pris parmi les trimeurs et qui leur vidaient leur pot de chambre."
                            },
                            {
                                "example_id": "81757bc1-6de9-4327-ab8e-73c7511e57a8",
                                "sense_id": "06d53cd4-f947-394e-b702-e372f35c59d8",
                                "text": "Fin de journée : Je raccompagne les auxis qui vont jeter leurs sacs-poubelle quand nous nous trouvons bloqués à une grille. D'autres prisonniers reviennent des ateliers et il ne faut pas les croiser. Un des auxis désigne aux deux autres un homme dépenaillé, d'une cinquantaine d'année au regard craintif. Il a l'air perdu."
                            },
                            {
                                "example_id": "c67f135f-4b48-4241-bed1-34d2fe73a047",
                                "sense_id": "06d53cd4-f947-394e-b702-e372f35c59d8",
                                "text": "En promenade, par essence, je vais systématiquement vers les voleurs. Le go-faster traîne avec les dealeurs, le trafiquant marche avec les auxis, l'assassin se promène avec ses semblables. Et le violeur se prive de sortie."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ba0aabb-6101-341b-9df4-41b9142d8c1f",
                        "entry_id": "cc9e8b82-2552-310c-b4fe-af0e01e5a76d",
                        "glosses": [
                            "Auxiliaire militaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "206fcd47-4edf-488a-a590-d14e8cda8790",
                                "sense_id": "0ba0aabb-6101-341b-9df4-41b9142d8c1f",
                                "text": "C’est un auxi, mais il va probablement passer troisième classe aujourd’hui."
                            }
                        ]
                    }
                ],
