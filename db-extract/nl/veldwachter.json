                            {
                                "example_id": "8de2b87c-8015-4076-bcad-f4b7e457b31e",
                                "sense_id": "1cd50fce-a861-3fcc-b568-a8c9aca83edb",
                                "text": "De veldwachter patrouilleerde regelmatig door de landelijke gebieden om de veiligheid te waarborgen.",
                                "translation": "The rural patrolman regularly patrolled through the rural areas to ensure safety.",
                                "english": "The rural patrolman regularly patrolled through the rural areas to ensure safety."
                            },
                            {
                                "example_id": "d0463e1b-8d83-4502-9a4f-abad41a64ca5",
                                "sense_id": "1cd50fce-a861-3fcc-b568-a8c9aca83edb",
                                "text": "De veldwachter was goed bekend met de lokale gemeenschap en hielp bij het oplossen van kleine geschillen.",
                                "translation": "The rural patrolman was well acquainted with the local community and helped to resolve minor disputes.",
                                "english": "The rural patrolman was well acquainted with the local community and helped to resolve minor disputes."
                            }
                        ]
                    }
