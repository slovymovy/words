{
    "word_family": [
        "waiver"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3199628b-3a1a-35e6-943c-74bba4b2b9d2",
                    "sense_definition": "To voluntarily give up a right, claim, or privilege.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "relinquish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect decided to <w>waive</w> his right to remain silent during the police interrogation.",
                            "target_lang_translations": {
                                "tr": "Şüpheli, polis sorgusu sırasında susma hakkından <w>feragat etmeye</w> karar verdi."
                            }
                        },
                        {
                            "text": "The university may <w>waive</w> the application fee for students who demonstrate financial need.",
                            "target_lang_translations": {
                                "tr": "Üniversite, maddi desteğe ihtiyacı olduğunu kanıtlayan öğrenciler için başvuru ücretini <w>almayabilir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "forgo",
                        "relinquish",
                        "renounce",
                        "surrender",
                        "yield"
                    ],
                    "antonyms": [
                        "accept"
                    ],
                    "common_phrases": [
                        "waive a right",
                        "waive a fee"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir haktan, iddiadan veya ayrıcalıktan gönüllü olarak vazgeçmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "feragat etmek",
                                "target_lang_sense_clarification": "Bir haktan veya iddiadan resmi olarak vazgeçmek."
                            },
                            {
                                "target_lang_word": "vazgeçmek",
                                "target_lang_sense_clarification": "Bir şeyden veya bir haktan isteyerek vazgeçmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "253dfe46-10a6-386b-afbb-8482229299e9",
                    "sense_definition": "To intentionally ignore or put aside something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ignore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee chose to <w>waive</w> the usual protocol to address the emergency immediately.",
                            "target_lang_translations": {
                                "tr": "Komite, acil durumu hemen ele almak için olağan protokolü <w>görmezden gelmeyi</w> seçti."
                            }
                        },
                        {
                            "text": "He decided to <w>waive</w> his personal preferences to reach a consensus with the team.",
                            "target_lang_translations": {
                                "tr": "Ekiple fikir birliğine varmak için kişisel tercihlerinden <w>vazgeçmeye</w> karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "disregard",
                        "put aside"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi kasten görmezden gelmek veya bir kenara bırakmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "görmezden gelmek",
                                "target_lang_sense_clarification": "Bir kuralı veya durumu kasten dikkate almamak."
                            },
                            {
                                "target_lang_word": "bir kenara bırakmak",
                                "target_lang_sense_clarification": "Bir şeyi uygulamadan veya dikkate almadan geçmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e97ecdc-94ca-3778-b87c-ae2cb30acb75",
                    "sense_definition": "To abandon or cast off someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abandon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old traditions were eventually <w>waived</w> by the younger generation as they moved to the city.",
                            "target_lang_translations": {
                                "tr": "Genç nesil şehre taşındıkça eski gelenekler zamanla <w>terk edildi</w>."
                            }
                        },
                        {
                            "text": "The damaged cargo was <w>waived</w> by the crew as it was deemed too heavy to carry.",
                            "target_lang_translations": {
                                "tr": "Hasarlı kargo, taşınamayacak kadar ağır olduğu düşünülerek mürettebat tarafından <w>atıldı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "dismiss"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini veya bir şeyi terk etmek ya da başından atmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "terk etmek",
                                "target_lang_sense_clarification": "Bir şeyi veya kişiyi bırakmak."
                            },
                            {
                                "target_lang_word": "başından atmak",
                                "target_lang_sense_clarification": "İstenmeyen bir şeyi elden çıkarmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db8aa45d-e1b6-3fc8-b410-07956e2ec66f",
                    "sense_definition": "To declare someone an outlaw or remove them from legal protection.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "outlaw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval times, the king could <w>waive</w> a criminal, stripping them of all rights.",
                            "target_lang_translations": {
                                "tr": "Orta Çağ'da kral, bir suçluyu tüm haklarından mahrum bırakarak <w>kanun dışı ilan edebilirdi</w>."
                            }
                        },
                        {
                            "text": "The court decided to <w>waive</w> the fugitive, leaving him without any legal recourse.",
                            "target_lang_translations": {
                                "tr": "Mahkeme, kaçak kişiyi <w>yasal korumadan mahrum bırakmaya</w> karar vererek onu hiçbir yasal başvuru yolu olmadan bıraktı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical legal practices."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini kanun dışı ilan etmek veya yasal korumadan mahrum bırakmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kanun dışı ilan etmek",
                                "target_lang_sense_clarification": "Birini yasal haklarından mahrum bırakmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "333b3bb9-c85e-3504-99a4-29106d43ac38",
                    "sense_definition": "To move back and forth or sway.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall grass began to <w>waive</w> in the gentle evening breeze.",
                            "target_lang_translations": {
                                "tr": "Uzun otlar hafif akşam esintisiyle <w>sallanmaya</w> başladı."
                            }
                        },
                        {
                            "text": "The branches of the willow tree <w>waive</w> slowly above the quiet pond.",
                            "target_lang_translations": {
                                "tr": "Söğüt ağacının dalları sessiz göletin üzerinde yavaşça <w>dalgalanıyor</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often confused with the verb wave."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İleri geri hareket etmek veya sallanmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sallanmak",
                                "target_lang_sense_clarification": "Rüzgar veya hareket etkisiyle yerinde gidip gelmek."
                            },
                            {
                                "target_lang_word": "dalgalanmak",
                                "target_lang_sense_clarification": "Bitki veya kumaş gibi şeylerin rüzgarda hareket etmesi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b0a5f8b-ad26-3772-830f-666781299793",
                    "sense_definition": "To wander or stray from a path.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler began to <w>waive</w> from the main road into the dense forest.",
                            "target_lang_translations": {
                                "tr": "Gezgin ana yoldan <w>saparak</w> sık ormanın içine doğru ilerlemeye başladı."
                            }
                        },
                        {
                            "text": "Do not <w>waive</w> from your original goal despite the many distractions.",
                            "target_lang_translations": {
                                "tr": "Birçok dikkat dağıtıcı şeye rağmen asıl hedefinden <w>sapma</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir yoldan sapmak veya uzaklaşmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sapmak",
                                "target_lang_sense_clarification": "Belirlenen rotadan veya yoldan ayrılmak."
                            },
                            {
                                "target_lang_word": "uzaklaşmak",
                                "target_lang_sense_clarification": "Hedeflenen yoldan sapıp uzaklaşmak."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d5c907f-deb0-352b-8e91-268c635f4601",
                    "sense_definition": "A person or thing that has been abandoned or cast away.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abandoned",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lonely child felt like a <w>waive</w> in the middle of the bustling city.",
                            "target_lang_translations": {
                                "tr": "Yalnız çocuk, hareketli şehrin ortasında <w>terk edilmiş biri</w> gibi hissediyordu."
                            }
                        },
                        {
                            "text": "He lived as a <w>waive</w>, moving from town to town without a home.",
                            "target_lang_translations": {
                                "tr": "Bir evi olmadan kasabadan kasabaya dolaşarak <w>terk edilmiş biri</w> gibi yaşadı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Terk edilmiş veya sahipsiz kalmış kişi veya şey."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "terk edilmiş kimse",
                                "target_lang_sense_clarification": "Sahipsiz veya kimsesiz kalmış kişi."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}