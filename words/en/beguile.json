{
    "word_family": [
        "guile",
        "beguilement",
        "beguiler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4aa02e14-3ac7-3dea-b466-a9af8002b878",
                    "sense_definition": "To charm, delight, or captivate someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "charm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beautiful music continued to <w>beguile</w> the audience throughout the entire evening.",
                            "target_lang_translations": {
                                "es": "La hermosa música continuó <w>cautivando</w> al público durante toda la velada."
                            }
                        },
                        {
                            "text": "She was <w>beguiled</w> by his charming smile and gentle manner.",
                            "target_lang_translations": {
                                "es": "Ella quedó <w>fascinada</w> por su encantadora sonrisa y sus modales amables."
                            }
                        }
                    ],
                    "synonyms": [
                        "charm",
                        "captivate",
                        "enchant"
                    ],
                    "common_phrases": [
                        "beguile with charm"
                    ],
                    "target_lang_definitions": {
                        "es": "Encantar, fascinar o cautivar a alguien por completo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "cautivar",
                                "target_lang_sense_clarification": "atraer fuertemente la atención o el ánimo"
                            },
                            {
                                "target_lang_word": "seducir",
                                "target_lang_sense_clarification": "atraer o encantar de forma irresistible"
                            },
                            {
                                "target_lang_word": "fascinar",
                                "target_lang_sense_clarification": "despertar gran admiración o interés"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00b31ffe-6ce9-397b-8b7c-4e3b7b72e103",
                    "sense_definition": "To help time pass pleasantly or quickly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>beguiled</w> the long afternoon by reading classic novels together.",
                            "target_lang_translations": {
                                "es": "<w>Hicieron pasar</w> la larga tarde leyendo novelas clásicas juntos."
                            }
                        },
                        {
                            "text": "We <w>beguiled</w> the hours away while waiting for the train to arrive.",
                            "target_lang_translations": {
                                "es": "<w>Entretuvimos</w> las horas mientras esperábamos a que llegara el tren."
                            }
                        }
                    ],
                    "synonyms": [
                        "pass",
                        "while away"
                    ],
                    "common_phrases": [
                        "beguile the hours"
                    ],
                    "target_lang_definitions": {
                        "es": "Hacer que el tiempo pase de manera agradable o entretenida."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "hacer pasar",
                                "target_lang_sense_clarification": "referido al tiempo, entretenerse para que transcurra"
                            },
                            {
                                "target_lang_word": "entretener",
                                "target_lang_sense_clarification": "hacer que el tiempo resulte ameno"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eeafdbfa-ee00-3951-b743-b7606c9f4b92",
                    "sense_definition": "To trick or deceive someone using cunning or dishonesty.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deceive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal used false promises to <w>beguile</w> the elderly woman out of her savings.",
                            "target_lang_translations": {
                                "es": "El delincuente utilizó falsas promesas para <w>engañar</w> a la anciana y quitarle sus ahorros."
                            }
                        },
                        {
                            "text": "He was <w>beguiled</w> by a clever salesman into buying a broken car.",
                            "target_lang_translations": {
                                "es": "Fue <w>embaucado</w> por un hábil vendedor para comprar un coche averiado."
                            }
                        }
                    ],
                    "synonyms": [
                        "deceive",
                        "trick",
                        "mislead"
                    ],
                    "common_phrases": [
                        "beguile into"
                    ],
                    "target_lang_definitions": {
                        "es": "Engañar o embaucar a alguien mediante astucia o falsedad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "engañar",
                                "target_lang_sense_clarification": "hacer creer algo falso mediante astucia"
                            },
                            {
                                "target_lang_word": "embaucar",
                                "target_lang_sense_clarification": "aprovecharse de alguien con halagos o mentiras"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}