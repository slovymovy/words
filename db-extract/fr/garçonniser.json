                "senses": [
                    {
                        "sense_id": "d5d11e8a-b7f0-3741-aac2-25f3435716a1",
                        "entry_id": "d597d272-f8ad-3d15-894e-004c3aa59dde",
                        "glosses": [
                            "Donner un caractère de garçon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8901c0a4-61af-40dd-9a50-93657eaf7229",
                                "sense_id": "d5d11e8a-b7f0-3741-aac2-25f3435716a1",
                                "text": "Mon Dieu, quelle chance que la grande Anaïs ne me voie pas ainsi garçonnisée, elle qui jalousait tant mes boucles châtaines et me les tirait sournoisement pendant la récréation !"
                            },
                            {
                                "example_id": "55f45c3f-139b-49cb-8437-f4a9acbdb980",
                                "sense_id": "d5d11e8a-b7f0-3741-aac2-25f3435716a1",
                                "text": "On n’en était encore qu’aux escarmouches, quand le Gaulois du 25 novembre insérait une chronique d’Octave Mirbeau, Fleurs et Fruits, consacrée aux lycées qu’on se proposait d’instituer, afin de déniaiser, de savantiser, de basbleuiser, de garçonniser et de viriliser les jeunes filles."
                            }
                        ]
                    }
