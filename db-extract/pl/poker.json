                                "target_senses": [
                                    {
                                        "sense_id": "5b105d64-88f9-351d-8a58-cb3181f7e421",
                                        "entry_id": "01d53fb7-a0e9-34a3-b2e3-ff03be2982fc",
                                        "glosses": [
                                            "ein Kartenspiel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6391404-0aa4-444c-b8d2-69d2149e8539",
                                                "sense_id": "5b105d64-88f9-351d-8a58-cb3181f7e421",
                                                "text": "Wir spielen gerne Poker."
                                            },
                                            {
                                                "example_id": "e14492b3-054a-4f50-b1a5-ef44c4e47579",
                                                "sense_id": "5b105d64-88f9-351d-8a58-cb3181f7e421",
                                                "text": "„Eine Zeitlang wandert er durch die Runden der trinkfreudigen Männer im Offiziersklub, spielt Poker und erlaubt sich einige wenige Seitensprünge.“"
                                            },
                                            {
                                                "example_id": "2bf83343-eef0-4fa3-8481-f4aa28be1ef4",
                                                "sense_id": "5b105d64-88f9-351d-8a58-cb3181f7e421",
                                                "text": "„Er brachte ihm Skat, Jass, Tarock und Poker bei; – Skat für Emigranten; Jass für die Schweiz; Tarock für Österreich; und Poker für alle anderen Fälle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f21ef87-1e59-3844-a2f4-c18943e2a183",
                                        "entry_id": "01d53fb7-a0e9-34a3-b2e3-ff03be2982fc",
                                        "glosses": [
                                            "ein Vierling im gleichnamigen Kartenspiel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fe56b5c-c38d-44cb-81e9-d26ae9c21114",
                                                "sense_id": "0f21ef87-1e59-3844-a2f4-c18943e2a183",
                                                "text": "In der Rangfolge über dem Poker steht nur noch der Straight Flush."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "40bf43c5-b96b-3900-abdd-5d4edcdf3c56",
                                        "entry_id": "01d53fb7-a0e9-34a3-b2e3-ff03be2982fc",
                                        "glosses": [
                                            "Vorgehensweise mit hohem Risiko, um etwas sehr Vorteilhaftes zu erreichen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d9846b3-8b30-4c81-a047-ea5a4d621b13",
                                                "sense_id": "40bf43c5-b96b-3900-abdd-5d4edcdf3c56",
                                                "text": "„Der Poker um die Finanzierungshilfe des Bundes für den Transrapid in China befindet sich in der entscheidenden Phase.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
