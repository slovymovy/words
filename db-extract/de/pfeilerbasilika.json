                        "sense_id": "72ea890b-8ee4-3970-a735-aa20f928bd06",
                        "entry_id": "779ea479-d935-3d8b-97ef-a4f07708e98f",
                        "glosses": [
                            "eine Basilika, deren Oberbau auf Pfeilern und nicht auf Säulen ruht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea661f7-6612-4e90-ad8a-d8725229bbfc",
                                "sense_id": "72ea890b-8ee4-3970-a735-aa20f928bd06",
                                "text": "Die Peterskirche ist eine dreischiffige kreuzförmige Pfeilerbasilika und entstand im 12. Jahrhundert in der Nachfolge der Hirsauer Schule mit flachem Chorabschluss."
                            },
                            {
                                "example_id": "861ab60e-e6e3-498c-ab47-adcba1d068ee",
                                "sense_id": "72ea890b-8ee4-3970-a735-aa20f928bd06",
                                "text": "„Frau Dering erklärt uns kurz und knapp, dass es sich um eine romanische Pfeilerbasilika handelt, die zudem Anbauten hat, die romanische, gotische und barocke Elemente aufweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
