                "senses": [
                    {
                        "sense_id": "aea603a7-9a63-3a58-b0ad-e2d5c5709406",
                        "entry_id": "da5ae263-ba30-32fd-afe3-3e5933e96315",
                        "glosses": [
                            "hunting ground"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "c7828eaa-f2a9-41bc-ae1d-04862cb50ab1",
                                "sense_id": "aea603a7-9a63-3a58-b0ad-e2d5c5709406",
                                "text": "Dachtest du, ich würde mich auf ewig vor deinem Herzen vor Anker legen? Weißt du nicht, daß ich unterwegs bin in den großen Jagdgründen des Lebens, heute da und morgen dort, und immer in einem leichten Zelte unter den Sternen schlafe?"
                            }
                        ]
                    },
                    {
                        "sense_id": "5665393c-e573-3afe-99ad-322bfc8f7126",
                        "entry_id": "da5ae263-ba30-32fd-afe3-3e5933e96315",
                        "glosses": [
                            "hunting ground"
                        ],
                        "tags": [
                            "figuratively",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "49c25cda-e6ea-4cc8-8a4f-27d6b4df5a39",
                                "sense_id": "5665393c-e573-3afe-99ad-322bfc8f7126",
                                "text": "Die sozialen Medien sind wahre Jagdgründe, um neue Kunden zu finden."
                            }
                        ]
                    }
