                                    {
                                        "sense_id": "c2a10fea-9290-3c19-ae6d-b4822791d18d",
                                        "entry_id": "77f4f0ec-aedd-30fe-9663-b7e8d10e9b00",
                                        "glosses": [
                                            "Prophète hébreu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea933bf-ec6a-4b62-869f-683db6b86e4c",
                                                "sense_id": "c2a10fea-9290-3c19-ae6d-b4822791d18d",
                                                "text": "Le huitième mois, la seconde année de Darius, la parole de l’Éternel fut adressée à Zacharie, fils de Bérékia, fils d’Iddo, le prophète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcd9e02e-eadb-3485-a4eb-1dd73184c83b",
                                        "entry_id": "77f4f0ec-aedd-30fe-9663-b7e8d10e9b00",
                                        "glosses": [
                                            "Quarante-cinquième et pénultième livre de l’Ancien Testament, composé de quatorze chapitres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Zacharie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "629bd63f-3380-3a55-8402-3e9fcf943c9a",
                                        "entry_id": "8cd9e75a-30f2-3bc2-985a-c36ddb44d6f5",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ea0ad6-0251-479e-aa90-0354f776ec3d",
                                                "sense_id": "629bd63f-3380-3a55-8402-3e9fcf943c9a",
                                                "text": "— Permettez que je me présente : Docteur Zacharie Regencrantz, d’Iéna."
                                            },
                                            {
                                                "example_id": "3e1fad9b-7939-4d0d-9444-e2ebc5e5c180",
                                                "sense_id": "629bd63f-3380-3a55-8402-3e9fcf943c9a",
                                                "text": "Dans cette saga, Alain Mercier nous offre les biographies simultanées du footballeur Zacharie, du tennisman Yannick et du basketteur Joakim."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2986cad-3ba5-4a75-9dc6-41cb0dac01ff",
                        "source_entry_id": "48376a59-a6d7-3a9e-8a0a-c9f94255ded6",
