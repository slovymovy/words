{
    "word_family": [
        "дрочка",
        "дрочило",
        "дрочильня"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c67bc7c8-f1f9-34a4-8d54-dd0283e73b08",
                    "sense_definition": "Заниматься мастурбацией.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sexual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он часто <w>дрочит</w> в своей комнате.",
                            "target_lang_translations": {
                                "en": "He often <w>wanks</w> in his room."
                            }
                        },
                        {
                            "text": "Подростки иногда <w>дрочат</w> от скуки.",
                            "target_lang_translations": {
                                "en": "Teenagers sometimes <w>jack off</w> out of boredom."
                            }
                        }
                    ],
                    "synonyms": [
                        "мастурби́ровать"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "вульгарное выражение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To masturbate."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wank",
                                "target_lang_sense_clarification": "Common slang in UK/Commonwealth English."
                            },
                            {
                                "target_lang_word": "jack off",
                                "target_lang_sense_clarification": "Common slang in US/Canadian English."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "832787ba-b33c-3a7f-ab1a-898234479e6a",
                    "sense_definition": "Заниматься бесцельным и безрезультатным делом, тратить силы попусту.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "useless_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы весь день <w>дрочим</w> этот отчет, хотя он никому не нужен.",
                            "target_lang_translations": {
                                "en": "We've been <w>messing around with</w> this report all day, even though nobody needs it."
                            }
                        },
                        {
                            "text": "Хватит <w>дрочить</w> этот проект, пора переходить к следующему.",
                            "target_lang_translations": {
                                "en": "Stop <w>faffing about with</w> this project, it's time to move on to the next one."
                            }
                        }
                    ],
                    "synonyms": [
                        "переливать из пустого в порожнее (разг.); хуем груши околачивать (обсц.)"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "вульгарное выражение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To engage in a pointless or unproductive task; to waste time and effort."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mess around with",
                                "target_lang_sense_clarification": "To spend time on something in an unproductive or aimless way."
                            },
                            {
                                "target_lang_word": "faff about with",
                                "target_lang_sense_clarification": "To spend time doing something in an inefficient or trivial way."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16d9dbb0-4661-3656-ac1a-35eb6cd60868",
                    "sense_definition": "Заставлять кого-либо много и тяжело работать, напрягать.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Начальник <w>дрочит</w> сотрудников бесконечными правками.",
                            "target_lang_translations": {
                                "en": "The boss is <w>riding</w> the employees with endless revisions."
                            }
                        },
                        {
                            "text": "Старослужащие <w>дрочат</w> молодых солдат физическими упражнениями.",
                            "target_lang_translations": {
                                "en": "The senior soldiers <w>haze</w> the new recruits with physical exercises."
                            }
                        }
                    ],
                    "synonyms": [
                        "долбить",
                        "долбиться"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "вульгарное выражение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To force someone to work hard or to harass them with excessive demands."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ride",
                                "target_lang_sense_clarification": "To harass or criticize someone persistently."
                            },
                            {
                                "target_lang_word": "haze",
                                "target_lang_sense_clarification": "To subject someone to difficult or humiliating tasks, often in a group context."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e24a0b6-6dbe-3111-9b32-b950ea5284fd",
                    "sense_definition": "Выполнять однообразные действия в игре для получения игровых ресурсов.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Игроку приходится <w>дрочить</w> одних и тех же монстров ради опыта.",
                            "target_lang_translations": {
                                "en": "The player has to <w>grind</w> the same monsters for experience."
                            }
                        },
                        {
                            "text": "Чтобы прокачать персонажа, нужно <w>дрочить</w> локации часами.",
                            "target_lang_translations": {
                                "en": "To level up the character, you need to <w>grind</w> locations for hours."
                            }
                        }
                    ],
                    "synonyms": [
                        "гриндить"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "вульгарное выражение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To perform repetitive actions in a game to acquire resources or experience."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grind",
                                "target_lang_sense_clarification": "Standard gaming terminology for repetitive tasks to level up."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8e2625d-a32f-3d69-9c29-eeae68548c25",
                    "sense_definition": "Дразнить, сердить или раздражать кого-либо.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "annoy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не <w>дрочи</w> собаку, она может укусить.",
                            "target_lang_translations": {
                                "en": "Don't <w>tease</w> the dog, it might bite."
                            }
                        },
                        {
                            "text": "Зачем ты <w>дрочишь</w> учителя своими глупыми вопросами?",
                            "target_lang_translations": {
                                "en": "Why are you <w>provoking</w> the teacher with your stupid questions?"
                            }
                        }
                    ],
                    "synonyms": [
                        "дразнить",
                        "сердить",
                        "раздражать"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "диалектное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To tease, provoke, or annoy someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tease",
                                "target_lang_sense_clarification": "To provoke or annoy someone in a playful or irritating way."
                            },
                            {
                                "target_lang_word": "provoke",
                                "target_lang_sense_clarification": "To deliberately make someone angry or annoyed."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}