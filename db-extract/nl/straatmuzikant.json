                "senses": [
                    {
                        "sense_id": "027425f9-b33d-348d-8220-df5706d9e579",
                        "entry_id": "8e610601-e144-317f-b44a-b05fd269c48d",
                        "glosses": [
                            "muzikant die in de openbare ruimte optreedt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb06c3e3-83dc-4135-b6e5-9b1dea502e07",
                                "sense_id": "027425f9-b33d-348d-8220-df5706d9e579",
                                "text": "Toen zijn vader hem aan een rondreizende Turk dreigde te verkopen, vluchtte hij via Oostenrijk en Hongarije naar Nederland, waar hij eerst straatmuzikant en vervolgens bedelaar werd."
                            },
                            {
                                "example_id": "ca722e09-979d-4e06-a73e-7f650eec5f8c",
                                "sense_id": "027425f9-b33d-348d-8220-df5706d9e579",
                                "text": "Blacky Boo kwam uit een achtergestelde wijk in Juárez. Ze had zich over de grens naar de Verenigde Staten gewerkt, had jaren geleefd van schoonmaken en bijklussen als straatmuzikant. In een van de restaurants waar ze schoonmaakte, mocht ze ook zingen."
                            },
                            {
                                "example_id": "e0135fae-3d2d-4744-b0cc-a13d27b1e5a9",
                                "sense_id": "027425f9-b33d-348d-8220-df5706d9e579",
                                "text": "We spitsen onze oren. In surround horen we auto’s van links naar rechts zoeven, talen die we niet kunnen definiëren en een straatmuzikant die ‘Knocking on heaven’s door’ kweelt. De stad is nooit stil, in de donkere kamer van onze hersenpan slaat onze verbeelding op hol."
                            }
                        ]
                    }
                ],
