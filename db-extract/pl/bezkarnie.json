                    {
                        "translation_id": "9f5ee71e-6b85-4e43-b278-cc66828718ec",
                        "source_entry_id": "37b37c1a-57bb-3e57-a5d5-79d8fb0721ee",
                        "source_sense_id": "bdca7dfc-58c0-3a21-bd24-2907007fedf8",
                        "target_lang_word": "ungestraft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
