                ],
                "senses": [
                    {
                        "sense_id": "477bde2a-b814-3d5e-b6cd-101edf912b5c",
                        "entry_id": "8c5b02e0-c929-386b-9926-b9a2fc096435",
                        "glosses": [
                            "ein von Winzern oder Weinbauern saisonal geöffneter Gastbetrieb, in dem die Winzer ihren selbsterzeugten Wein vermarkten"
                        ],
                        "tags": [
                            "fränkisch"
                        ],
                        "examples": [
                            {
                                "example_id": "e4d650d1-20de-495c-83d2-fd72d10779af",
                                "sense_id": "477bde2a-b814-3d5e-b6cd-101edf912b5c",
                                "text": "„Früher nannte man die fränkischen Weinbauern einfach >Häcker< - und daraus leitet sich der Name einer mainfränkischen Institution ab, die man anderswo auch unter der Bezeichnung >Straußwirtschaft< oder >Besenwirtschaft< kennt. […] In den nur zu bestimmten Zeiten geöffneten ‘‘Häckerwirtschaften‘‘ gibt es […] vor allem günstigen Rebensaft aus Eigenanbau.“"
                            },
                            {
                                "example_id": "aeb28da3-f1a5-4993-b1be-6a3841038456",
                                "sense_id": "477bde2a-b814-3d5e-b6cd-101edf912b5c",
                                "text": "Gestern Abend waren wir in einer sehr schönen Häckerwirtschaft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
