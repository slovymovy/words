                                        "entry_id": "786ae6dc-ea35-3f20-b574-133ce50d04aa",
                                        "glosses": [
                                            "Any flimsy substance unspun, such as raw silk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0cd1b97-4e23-3d10-a61e-b975447ec100",
                                        "entry_id": "786ae6dc-ea35-3f20-b574-133ce50d04aa",
                                        "glosses": [
                                            "Pluck; courage or energy."
