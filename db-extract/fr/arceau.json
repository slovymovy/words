                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ddf14290-19e0-3193-bc40-64c4de4cb553",
                "word": "arceau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "54ccd40b-9584-4c57-85b1-d09c26d58e58",
                        "entry_id": "ddf14290-19e0-3193-bc40-64c4de4cb553",
                        "tags": [
                            "plural"
                        ],
                        "form": "arceaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "313ddc61-c707-30c2-9e36-76c9b3f2f532",
                        "entry_id": "ddf14290-19e0-3193-bc40-64c4de4cb553",
                        "glosses": [
                            "Courbure d’une voûte en berceau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c86114a3-fad6-45a6-8099-11c7ec836533",
                                "sense_id": "313ddc61-c707-30c2-9e36-76c9b3f2f532",
                                "text": "La place carrée, avec sa double rangée d'arceaux, était déjà, lors du grand siège de 1621, telle que nous la voyons aujourd'hui."
                            },
                            {
                                "example_id": "f4f561ac-277b-4b46-b749-f867c4be9e57",
                                "sense_id": "313ddc61-c707-30c2-9e36-76c9b3f2f532",
                                "text": "Ce n'est pas parce qu'on a fui le cloître qu’on n'en garde pas l’idéal plus présent et plus vif parfois que ceux qui demeurent à l'ombre de ses arceaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "79d2ef16-5b51-3c48-a4f2-ab78b592d880",
                        "entry_id": "ddf14290-19e0-3193-bc40-64c4de4cb553",
                        "glosses": [
                            "Petite voûte surbaissée d’un ponceau et de certaines portes, de certaines fenêtres."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7ba3c2b3-04d1-3584-8df2-01743dc7f747",
                        "entry_id": "ddf14290-19e0-3193-bc40-64c4de4cb553",
                        "glosses": [
                            "Ornement en forme de trèfle."
                        ],
                        "tags": [
                            "Sculpture"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ced3015b-cc41-3ec3-9e54-68a910255b72",
                        "entry_id": "ddf14290-19e0-3193-bc40-64c4de4cb553",
                        "glosses": [
                            "Par analogie, il désigne toute tige de bois ou de métal recourbée en forme de petit arc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d81c9c83-10aa-42fe-86fc-c3f60cffca91",
                                "sense_id": "ced3015b-cc41-3ec3-9e54-68a910255b72",
                                "text": "Les allées du jardin sont bordées d’arceaux de bois."
                            },
                            {
                                "example_id": "f198276c-8d88-41f4-865a-95e0101cddfc",
                                "sense_id": "ced3015b-cc41-3ec3-9e54-68a910255b72",
                                "text": "On s’est assises, les pieds sur les arceaux, près de la pelouse qui borde l’étang."
                            },
                            {
                                "example_id": "13f89d9a-7561-41a9-9f5a-4ccfb64ec1e5",
                                "sense_id": "ced3015b-cc41-3ec3-9e54-68a910255b72",
                                "text": "Quelques hommes dressaient autour de la mare gluante des claies couronnées par des arceaux de branchages qui, grâce à leurs épines, s’accrochaient les unes aux autres."
                            },
                            {
                                "example_id": "bb1c77dd-03c0-4ed0-95d9-a36f5840002a",
                                "sense_id": "ced3015b-cc41-3ec3-9e54-68a910255b72",
                                "text": "Les arceaux du jeu de croquet."
                            },
                            {
                                "example_id": "7374ae01-702d-4d5b-b22d-c8bdb8727555",
                                "sense_id": "ced3015b-cc41-3ec3-9e54-68a910255b72",
                                "text": "Nous avions déposé nos maillets, nous étions assises toutes trois sur la pelouse, au bord du terrain planté d’arceaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d55cc32-84d7-3c85-9d6b-5dd092de840a",
                        "entry_id": "ddf14290-19e0-3193-bc40-64c4de4cb553",
                        "glosses": [
                            "Châssis courbés en arc qui empêchent le drap de peser sur un membre malade, archets."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "22dd51b2-3dbd-36c9-8296-9ae21bac832c",
                        "entry_id": "ddf14290-19e0-3193-bc40-64c4de4cb553",
                        "glosses": [
                            "Aménagement de stationnement afin de sécuriser un vélo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d6a5fbd-fc3c-421f-92f3-82efc79c6288",
                                "sense_id": "22dd51b2-3dbd-36c9-8296-9ae21bac832c",
                                "text": "Cette campagne d’installations de neuf nouveaux emplacements d’ arceaux vélo, et le renforcement de cinq emplacements existants, répond aux besoins aux abords des équipements publics, des commerces, cabinets médicaux, parcs et jardins (Plessis, Mandela). Les choix d’implantation répondent à des critères techniques pour ne pas gêner les autres usages du domaine public (piétons, personnes à mobilité réduite, livraisons, accès aux réseaux enterrés, etc.)."
                            }
                        ]
                    },
                    {
                        "sense_id": "592f05a4-d46e-3ec0-b2b9-9a9dfc41fa8f",
                        "entry_id": "ddf14290-19e0-3193-bc40-64c4de4cb553",
                        "glosses": [
                            "Dispositif de sécurité protégeant le pilote ou le conducteur. Se dit aussi pour d'autres véhicules \\\"mécaniques\\\"."
                        ],
                        "tags": [
                            "Sports mécaniques"
                        ],
                        "examples": [
                            {
                                "example_id": "ae2afafb-109a-4f4a-a78a-b0f0402f5006",
                                "sense_id": "592f05a4-d46e-3ec0-b2b9-9a9dfc41fa8f",
                                "text": "L’arceau fait partie intégrante de la cellule de survie (l’habitacle indestructible qui protège le corps du pilote), et doit théoriquement éviter que le casque touche la piste si la monoplace se retourne."
                            },
                            {
                                "example_id": "ac9551c5-3353-44b0-88a1-7272136644d8",
                                "sense_id": "592f05a4-d46e-3ec0-b2b9-9a9dfc41fa8f",
                                "text": "Au 1er janvier 2010, tous les tracteurs antérieurs à 1976 devront être équipés d'un arceau de sécurité contre le retournement. C'est ce que précise la loi de 2005."
                            }
                        ]
                    },
                    {
                        "sense_id": "25120ca4-58bb-3ba0-a6a9-e83c6963ba7f",
                        "entry_id": "ddf14290-19e0-3193-bc40-64c4de4cb553",
                        "glosses": [
                            "Dispositif de stationnement anti-stationnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d0fd101-2a53-4d1f-93f0-0ac66f3a4c12",
                                "sense_id": "25120ca4-58bb-3ba0-a6a9-e83c6963ba7f",
                                "text": "Ma place extérieure de parking a été détériorée: arceau et bitume arrachés. Qui doit prendre en charge le sinistre?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd6c86cd-50f2-4113-98c6-3e35a9ad5249",
                        "source_entry_id": "ddf14290-19e0-3193-bc40-64c4de4cb553",
                        "source_sense_description": "(Architecture) Courbure d’une voûte en berceau.",
                        "target_lang_word": "boog",
                        "target_lang_code": "nl",
