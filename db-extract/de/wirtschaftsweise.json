                        ],
                        "form": "die Wirtschaftsweise"
                    },
                    {
                        "form_id": "6293dc20-735c-433b-9e59-d29cf5dbfa80",
                        "entry_id": "c046a94d-1e8b-332d-bed7-4ab2dc9a23fd",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wirtschaftsweisen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "458555a3-846d-3143-98b6-1ccb9b885a77",
                        "entry_id": "c046a94d-1e8b-332d-bed7-4ab2dc9a23fd",
                        "glosses": [
                            "Art, in der Industrie und Handel in einer Gesellschaft organisiert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a0f4598-4e9f-4294-ba13-54bdbca8d75b",
                                "sense_id": "458555a3-846d-3143-98b6-1ccb9b885a77",
                                "text": "„Ein Umdenken zu einer neuen Wirtschaftsweise ist die Grundlage für Nachhaltigkeit.“"
                            },
                            {
                                "example_id": "7f237cca-b708-45b8-80c8-e1aa316a7dd5",
                                "sense_id": "458555a3-846d-3143-98b6-1ccb9b885a77",
                                "text": "„Neu ist der Zweifel an einer ausschließlich auf Wachstum ausgerichteten Wirtschaftsweise nicht.“"
                            },
                            {
                                "example_id": "7df17942-981c-47fc-b8f9-5c4cc87f6408",
                                "sense_id": "458555a3-846d-3143-98b6-1ccb9b885a77",
                                "text": "„Ökofonds zielen auf einen verstärkten Auf- und Ausbau einer nachhaltigen, sozial- und umweltverträglichen Wirtschaftsweise.“"
                            },
                            {
                                "example_id": "dd68dcbe-871e-49f1-a9b8-40a6c505ee80",
                                "sense_id": "458555a3-846d-3143-98b6-1ccb9b885a77",
                                "text": "„Die derzeitige Wirtschaftsweise untergräbt unseren Wohlstand, weil sie die natürlichen Grundlagen des Wirtschaftens zerstört.“"
                            },
                            {
                                "example_id": "67001efb-4e5c-419d-a683-a5fdf56ed75d",
                                "sense_id": "458555a3-846d-3143-98b6-1ccb9b885a77",
                                "text": "„Unsere Wirtschaftsweise ist vielerorts ein Raubbau an Mensch und Natur.“"
                            },
                            {
                                "example_id": "a08a838a-0c5b-40cd-982f-f0d680eddb82",
                                "sense_id": "458555a3-846d-3143-98b6-1ccb9b885a77",
                                "text": "[Die US-Umweltorganisation Global Footprint Network analysiert,] „was die Menschen mit ihrer Lebens- und Wirtschaftsweise verbrauchen.“"
                            },
                            {
                                "example_id": "45872f82-a5c9-43d2-bbf4-4e431addb132",
                                "sense_id": "458555a3-846d-3143-98b6-1ccb9b885a77",
                                "text": "„Für eine Weiterentwicklung der immer noch überwiegend linearen Wirtschaftsweise hin zu einer zirkulären Wirtschaftsweise sind nicht nur schrittweise weitere Verbesserungen in Bezug auf Abfallerfassung, -sortierung und -verwertung erforderlich, sondern ein Paradigmenwechsel und ein Blick auf die Stoffkreisläufe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "35755f0b-9fb8-3224-90f1-80a82448ca93",
                        "entry_id": "c046a94d-1e8b-332d-bed7-4ab2dc9a23fd",
                        "glosses": [
                            "Art des Anbaus, des Pflanzenschutzes, der Ernte und der Tierhaltung bei der Produktion landwirtschaftlicher Güter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b956ae2-1bfd-4e35-a509-0d790d306048",
                                "sense_id": "35755f0b-9fb8-3224-90f1-80a82448ca93",
                                "text": "„Industrielle Landwirtschaft ist weit von nachhaltiger Wirtschaftsweise entfernt“"
                            },
                            {
                                "example_id": "dffea6bf-c300-4fe2-9adf-ad2d78dc2599",
                                "sense_id": "35755f0b-9fb8-3224-90f1-80a82448ca93",
                                "text": "„Eine nachhaltige Wirtschaftsweise ist eine Chance und Verpflichtung für die deutsche Landwirtschaft.“"
                            },
                            {
                                "example_id": "004eb84c-59f3-47f2-84c1-349d1a9ba342",
                                "sense_id": "35755f0b-9fb8-3224-90f1-80a82448ca93",
                                "text": "[Die extensịve Wirtschaft ist] „eine Wirtschaftsweise in der Landwirtschaft, bei der im Verhältnis zur Bodenfläche wenig Arbeit und Kapital aufgewendet wird“"
                            },
                            {
                                "example_id": "659f8129-552e-4995-996f-dddfdf566a0d",
                                "sense_id": "35755f0b-9fb8-3224-90f1-80a82448ca93",
                                "text": "„Der Wandel von der aneignenden Lebensweise der Sammler und Jäger zur erzeugenden Wirtschaftsweise von Bauern und Hirten ging mit bedeutenden gesellschaftlichen und kulturellen Veränderungen einher.“"
                            },
                            {
                                "example_id": "b19be952-5390-4145-8b64-66b12f48e6b1",
                                "sense_id": "35755f0b-9fb8-3224-90f1-80a82448ca93",
                                "text": "„Bedauerlich ist jedoch, dass zwar die hohen Umsatzzuwächse in Deutschland generiert werden, jedoch in unseren Regionen kaum Bauern auf die ökologische Wirtschaftsweise umstellen.“"
                            },
                            {
                                "example_id": "3dcfe705-5a7e-4247-8765-576659bb30a2",
                                "sense_id": "35755f0b-9fb8-3224-90f1-80a82448ca93",
                                "text": "„Die biologisch-dynamische Wirtschaftsweise stieß in der Zeit des Nationalsozialismus“ […] „für längere Zeit auf hohe Akzeptanz.“"
                            },
                            {
                                "example_id": "26194341-e4bb-4cef-95ae-f78b9ef75bac",
                                "sense_id": "35755f0b-9fb8-3224-90f1-80a82448ca93",
                                "text": "„Der Strukturwandel der deutschen Landwirtschaft hat viele Facetten: Es gibt immer weniger aber dafür größere Betriebe und auch Bodennutzung, Wirtschaftsweisen und Tätigkeitsfelder verändern sich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
