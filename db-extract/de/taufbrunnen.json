                "senses": [
                    {
                        "sense_id": "e5740267-63f6-3442-a33e-a87b27259171",
                        "entry_id": "55232a8d-edaa-36ab-b310-4629415b7792",
                        "glosses": [
                            "großes Taufbecken, in das man ganz eintauchen konnte; wurde in der alten Kirche bis ins 11. Jahrhundert für die Taufe verwendet."
                        ],
                        "tags": [
                            "christliche Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "5645ac04-8532-426f-90f2-8974e74b5b4d",
                                "sense_id": "e5740267-63f6-3442-a33e-a87b27259171",
                                "text": "„Was davor gezeigt wird, ist schnell genannt. Vor einem Taufbrunnen vollzieht ein Priester die Taufe bei einem kleinen Kind mit weitem weiße , mit rosa Bändern verziertem Taufgewand. Es wird von einem alten Mann mit gesenktem Kopf gehalten, seine Frau neben ihm blickt auf den Priester.“"
                            }
                        ],
