                                    {
                                        "sense_id": "a0481dbb-b37a-3710-912e-05ac37be6e22",
                                        "entry_id": "bbb0416f-18c1-3c57-aeac-eba71eb2b395",
                                        "glosses": [
                                            "A French national high-speed train, run by the railway service of the same name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af08cc56-6b56-4efe-a17b-c172fb6557f5",
                                                "sense_id": "a0481dbb-b37a-3710-912e-05ac37be6e22",
                                                "text": "He also makes the point that in France, SNCF is currently refurbishing some TGVs built in 1988."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "TGV",
