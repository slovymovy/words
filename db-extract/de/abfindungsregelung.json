                        "sense_id": "1e2f489f-32dc-3456-a64f-70833336f9fb",
                        "entry_id": "5c546b2e-6945-33ed-b5c7-9aae74070201",
                        "glosses": [
                            "Regelung in Bezug auf die Abfindung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "745156b8-45be-4b26-9e0c-1ce3b1f2d354",
                                "sense_id": "1e2f489f-32dc-3456-a64f-70833336f9fb",
                                "text": "„Grundsätzlich könne man in Zukunft zulassen, dass Arbeitnehmer bei Abschluss eines neuen Arbeitsvertrags zu Gunsten einer festen Abfindungsregelung auf den Kündigungsschutz verzichteten.“"
                            },
                            {
                                "example_id": "e25c7a31-0325-40e9-84a2-ecee28440575",
                                "sense_id": "1e2f489f-32dc-3456-a64f-70833336f9fb",
                                "text": "„Vereinbart werden z. B. Abfindungsregelungen oder Arbeitszeitreduzierung, Versetzungen, Qualifizierungsmaßnahmen, Umschulungen, Existenzgründungshilfen, Umzugskostenhilfen.“"
                            }
                        ],
