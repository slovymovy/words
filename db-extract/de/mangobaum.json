                ],
                "senses": [
                    {
                        "sense_id": "717e3d3d-ecd3-39f8-925d-0e47cd3136b7",
                        "entry_id": "35502937-af1b-3d2b-a7ae-419ffd9747d4",
                        "glosses": [
                            "in tropischen Regionen wachsender Baum mit Mangos als Früchten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad3fd70b-9640-407b-ad42-e90341bb3b37",
                                "sense_id": "717e3d3d-ecd3-39f8-925d-0e47cd3136b7",
                                "text": "„Ein kurzer Sturzflug, und die Krähe landete auf dem obersten Ast des höchsten Mangobaumes.“"
                            },
                            {
                                "example_id": "a7a7824e-d186-4bef-a722-b670f39efee7",
                                "sense_id": "717e3d3d-ecd3-39f8-925d-0e47cd3136b7",
                                "text": "„Der Professor lag in einer Hängematte zwischen zwei gekappten Mangobäumen, und als man mich ihm vorführte, sprang er sofort herunter.“"
                            },
                            {
                                "example_id": "dab4b65c-6c5f-4985-9908-57f0f7ef06f4",
                                "sense_id": "717e3d3d-ecd3-39f8-925d-0e47cd3136b7",
                                "text": "„In der Nähe der Läden im Motor Park stehen Mangobäume und ich lege mich unter einen davon.“"
                            },
                            {
                                "example_id": "5eebe53f-8764-4581-92ba-d504f81ef5b6",
                                "sense_id": "717e3d3d-ecd3-39f8-925d-0e47cd3136b7",
                                "text": "„Dorcas wehrte sich, aber schließlich gelang es Kofi und Charles, sie unter einen Mangobaum zu zerren, von wo aus sie die Leiche nicht sehen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3943e74-b202-438c-a923-6d840bc2a08e",
                        "source_entry_id": "35502937-af1b-3d2b-a7ae-419ffd9747d4",
                        "source_sense_id": "717e3d3d-ecd3-39f8-925d-0e47cd3136b7",
