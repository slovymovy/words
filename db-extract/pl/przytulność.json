                    {
                        "translation_id": "786951f7-a1f6-407a-8a8e-c96113aee381",
                        "source_entry_id": "03867b6a-decb-3425-a032-8f8d4a1d83a2",
                        "source_sense_id": "cd4e221e-5189-320f-b69f-f01841d580ed",
                        "target_lang_word": "Gemütlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemütlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cc3f282-0ae5-38d9-8030-ac106383940a",
                                        "entry_id": "b2b99b03-83b7-3623-b744-3fc99095bcba",
                                        "glosses": [
                                            "Gefühl der Geborgenheit, Vertrautheit und Sicherheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e451dc97-c2fa-4b74-b3a3-fc239aec6171",
                                                "sense_id": "6cc3f282-0ae5-38d9-8030-ac106383940a",
                                                "text": "„Gemütlichkeit ist Ausdruck und spezifische Färbung des deutschen Rückzugs ins Private.“"
                                            },
                                            {
                                                "example_id": "aa988f12-5788-48b2-b94f-cb90b3549c19",
                                                "sense_id": "6cc3f282-0ae5-38d9-8030-ac106383940a",
                                                "text": "„Die allermeisten finden die Gemütlichkeit in ihren eigenen vier Wänden, aber sie lässt sich nicht einschließen.“"
                                            },
                                            {
                                                "example_id": "2d59d453-fff7-4113-a102-218a266a951b",
                                                "sense_id": "6cc3f282-0ae5-38d9-8030-ac106383940a",
                                                "text": "„Am nächsten Morgen ist es vorbei mit der Gemütlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "83beaeb4-079e-369d-8327-cf3b0c31a54c",
                                        "entry_id": "b2b99b03-83b7-3623-b744-3fc99095bcba",
                                        "glosses": [
                                            "ruhige, unehrgeizige Herangehensweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43ab1b50-8b43-4373-b1e3-54f10cd2ca04",
                                                "sense_id": "83beaeb4-079e-369d-8327-cf3b0c31a54c",
                                                "text": "Probier's mal mit Gemütlichkeit."
                                            },
                                            {
                                                "example_id": "b885b816-c5f8-4529-aa29-b095229b3c80",
                                                "sense_id": "83beaeb4-079e-369d-8327-cf3b0c31a54c",
                                                "text": "Wenn der Chef kommt, ist die Gemütlichkeit flöten."
                                            },
                                            {
                                                "example_id": "cd8d68cf-6254-4724-a0dd-d0da00680e9c",
                                                "sense_id": "83beaeb4-079e-369d-8327-cf3b0c31a54c",
                                                "text": "„Es gibt Deutsche, die den Kampf ums Dasein mit einem Gedrängel hinter sich bringen, das der Gemütlichkeit ins Gesicht schlägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d16b3082-ae30-3fed-bad0-767c3b308e62",
                                        "entry_id": "b2b99b03-83b7-3623-b744-3fc99095bcba",
                                        "glosses": [
                                            "Situationen und besonders Gespräche, die auf das Gemüt einwirken"
                                        ],
                                        "tags": [
                                            "laut E. T. A. Hoffmann"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bda6ee7-7199-4ea0-aa7d-b590402bf917",
                                                "sense_id": "d16b3082-ae30-3fed-bad0-767c3b308e62",
                                                "text": "„Unerachtet der strengen Ordensregel waren die Andachtsübungen dem Prior Leonardus mehr Bedürfnis des … Geistes, als asketische Buße für Sünde, und er wußte diesen Sinn der Andacht so in den Brüdern zu entzünden, dass sich über alles, was sie tun mussten, um der Regel zu genügen, eine Heiterkeit und Gemütlichkeit ergoß, die in der Tat ein höheres Sein in der irdischen Beengtheit erzeugte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
