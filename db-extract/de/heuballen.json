                ],
                "senses": [
                    {
                        "sense_id": "820e39ae-88ee-3876-b432-4c3ec88fc2d1",
                        "entry_id": "149e8d1e-ba1b-3a83-a86c-9686fd992197",
                        "glosses": [
                            "in einen runden oder rechteckigen Ballen gepresstes Heu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c16aca3d-e137-4699-ab09-bee7619f8be5",
                                "sense_id": "820e39ae-88ee-3876-b432-4c3ec88fc2d1",
                                "text": "Auf unseren Feldern liegen Heuballen."
                            },
                            {
                                "example_id": "0cb691c6-2b6e-4acb-9f4a-47352693f010",
                                "sense_id": "820e39ae-88ee-3876-b432-4c3ec88fc2d1",
                                "text": "Die Heuballen müssen noch in die Scheune geschafft werden."
                            },
                            {
                                "example_id": "87df1566-8d12-4e1f-b725-e48b1a3e04a8",
                                "sense_id": "820e39ae-88ee-3876-b432-4c3ec88fc2d1",
                                "text": "„Damals war die Scheune mit Heuballen gefüllt gewesen, jetzt war sie leer und wirkte in sich zusammengesunken, nur Reste von roter Farbe waren an dem ausgetrockneten Holz noch zu sehen.“"
                            },
                            {
                                "example_id": "f99a588c-139b-48ea-9122-68a88e8c68a3",
                                "sense_id": "820e39ae-88ee-3876-b432-4c3ec88fc2d1",
                                "text": "„Ein hoher Stapel Heuballen in weißer Plastikfolie steht an der Scheunenwand wie eine Festungsmauer, die gegen einen langen Winter errichtet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
