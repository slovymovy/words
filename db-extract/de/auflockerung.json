                ],
                "senses": [
                    {
                        "sense_id": "f3562f38-e5e1-398e-a185-3225d506eddb",
                        "entry_id": "76f28d52-06be-3b2e-9e84-c5f4e7bf3f01",
                        "glosses": [
                            "Handlung/Prozess/Zustand, in dem etwas entspannter, gelöster (weniger fest oder streng) wird"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "e9a9e854-919a-448a-9fd4-50987855e7e1",
                                "sense_id": "f3562f38-e5e1-398e-a185-3225d506eddb",
                                "text": "Die 1980er Jahre waren geprägt von einer deutlichen Auflockerung der politischen Spannungen zwischen Ost und West."
                            },
                            {
                                "example_id": "0441c47a-50b5-4038-b103-639fbd34e55a",
                                "sense_id": "f3562f38-e5e1-398e-a185-3225d506eddb",
                                "text": "Durch die Auflockerung der strengen Kleidervorschriften durften die Schüler nun legere Kleidung tragen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3eead243-32d5-39f1-b316-ec18bdc01057",
                        "entry_id": "76f28d52-06be-3b2e-9e84-c5f4e7bf3f01",
                        "glosses": [
                            "Handlung/Prozess/Zustand, in dem etwas abwechslungsreicher oder durchlässiger wird"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "7068ba59-c717-4f13-8c85-68b6c7f36949",
                                "sense_id": "3eead243-32d5-39f1-b316-ec18bdc01057",
                                "text": "Nach dem Brand im Stadtzentrum beschloss der Stadtrat, die historischen Gebäude wieder aufzubauen und für eine architektonische Auflockerung sowie Renovierung zu sorgen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "436c5570-5639-31c3-a1b1-4c829cd019fc",
                        "entry_id": "76f28d52-06be-3b2e-9e84-c5f4e7bf3f01",
                        "glosses": [
                            "Aufhellen oder Abnehmen der Wolken, wodurch der Himmel (teilweise) klarer wird"
                        ],
                        "tags": [
                            "Wetter"
                        ],
                        "examples": [
                            {
                                "example_id": "ae403603-0a4a-42f3-b1c5-d60300a292b7",
                                "sense_id": "436c5570-5639-31c3-a1b1-4c829cd019fc",
                                "text": "Heute ist es überwiegend bewölkt, aber im Laufe des Tages erwarten wir einige Auflockerungen und vereinzelte Sonnenstrahlen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7749f609-59b8-4634-9fbe-61dca6291fee",
                        "source_entry_id": "76f28d52-06be-3b2e-9e84-c5f4e7bf3f01",
                        "source_sense_id": "f3562f38-e5e1-398e-a185-3225d506eddb",
                        "source_sense_description": "Prozess der Entspannung",
                        "target_lang_word": "détente",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détente",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1b68801-8da1-3b81-a2c5-0140c9c94d20",
                                        "entry_id": "cb24f6d5-3c81-3160-90a6-f85a0d181d7d",
                                        "glosses": [
                                            "Diminution progressive de la pression d’un gaz ou d’une vapeur qui augmente de volume, ou bien de la tension d’un ressort qui revient à son équilibre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19b8757c-6929-40a0-9e1e-6b2228b9f4f3",
                                                "sense_id": "b1b68801-8da1-3b81-a2c5-0140c9c94d20",
                                                "text": "La détente d'un gaz, effectuée dans une enceinte dont la paroi serait parfaitement perméable à la chaleur, opérée avec une lenteur extrême permettant au calorique de passer en quantité suffisante à travers la paroi, peut se faire isothermiquement : …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64302443-d208-39c0-87df-468209169201",
                                        "entry_id": "cb24f6d5-3c81-3160-90a6-f85a0d181d7d",
                                        "glosses": [
                                            "Petite pièce de fer ou d’acier qui maintient un ressort bandé et qui, en s’écartant, lui permet de se détendre, en parlant spécialement des armes à feu."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de296139-09b2-47f8-97aa-bdebb595acc5",
                                                "sense_id": "64302443-d208-39c0-87df-468209169201",
                                                "text": "La pulsation archiprécipitée des artères du malheureux Durandin, plutôt que l’envie de se défaire d’un homme qui en voulait à sa vie, lui firent lâcher la détente de l’arme qui tremblait dans sa main ; mais le hasard le servit mieux que son adresse, et, le coup parti, Rouzé tomba frappé."
                                            },
                                            {
                                                "example_id": "0d851f08-0aeb-4c16-bd23-d30aa5e11896",
                                                "sense_id": "64302443-d208-39c0-87df-468209169201",
                                                "text": "Un capitaine réglait le feu : « A vous, Judin! » Le petit lignard visait soigneusement, lâchait la détente."
                                            },
                                            {
                                                "example_id": "4b041de6-0cd0-41e3-a812-8f11c55b51b4",
                                                "sense_id": "64302443-d208-39c0-87df-468209169201",
                                                "text": "Le doigt sur la détente de nos armes, tous les muscles tendus, ne respirant plus, nous attendons... et il me semble qu'il se passe une éternité..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c6f6372-e29c-3efd-bbde-ede0ba838d4f",
                                        "entry_id": "cb24f6d5-3c81-3160-90a6-f85a0d181d7d",
                                        "glosses": [
                                            "Action de lâcher la détente et de l’effort que fait cette pièce lorsqu’elle vient à se détendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "653078ec-e41e-49e1-aec4-218a840d5ebf",
                                                "sense_id": "7c6f6372-e29c-3efd-bbde-ede0ba838d4f",
                                                "text": "Un fusil qui est dur, qui est fort, qui est aisé à la détente."
                                            },
                                            {
                                                "example_id": "44375263-f789-43fd-81bf-6b4ae4eff8c5",
                                                "sense_id": "7c6f6372-e29c-3efd-bbde-ede0ba838d4f",
                                                "text": "Il est à craindre que ce ressort ne se rompe à la détente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2da1d569-abe3-32dd-9d0b-1e88744520a6",
                                        "entry_id": "cb24f6d5-3c81-3160-90a6-f85a0d181d7d",
                                        "glosses": [
                                            "Travail développé par la vapeur dans le cylindre d’une machine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b10a4c26-a9d6-3842-b1a1-024270379d99",
                                        "entry_id": "cb24f6d5-3c81-3160-90a6-f85a0d181d7d",
                                        "glosses": [
                                            "Relâchement d’une tension physique, morale ou intellectuelle et Moment de calme, de répit qui en résulte."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba6ecda1-e650-4c22-9a64-811eaca93a85",
                                                "sense_id": "b10a4c26-a9d6-3842-b1a1-024270379d99",
                                                "text": "Après cette crise, il s’est produit une détente de l’organisme, une légère détente, une sérieuse détente."
                                            },
                                            {
                                                "example_id": "d44a69ef-b84b-44c3-872d-160eaef8e47c",
                                                "sense_id": "b10a4c26-a9d6-3842-b1a1-024270379d99",
                                                "text": "Ces deux hommes se haïssaient sans se connaître : il y a dans leurs rapports une détente visible."
                                            },
                                            {
                                                "example_id": "f5a581ad-bfa8-44d6-8eb6-9df6217e16ad",
                                                "sense_id": "b10a4c26-a9d6-3842-b1a1-024270379d99",
                                                "text": "Après un long travail, il faut se donner quelques jours de détente."
                                            },
                                            {
                                                "example_id": "38bc52a2-a45c-422b-8310-d6f73d7e9b4e",
                                                "sense_id": "b10a4c26-a9d6-3842-b1a1-024270379d99",
                                                "text": "La détente s’accentue entre le gouvernement et l’opposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50cf4006-f7d8-3da9-b855-0dee2acce969",
                                        "entry_id": "cb24f6d5-3c81-3160-90a6-f85a0d181d7d",
                                        "glosses": [
                                            "Ressort, capacité à bondir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecb82e9f-5154-444d-a6bf-58ea75394d77",
                                                "sense_id": "50cf4006-f7d8-3da9-b855-0dee2acce969",
                                                "text": "Ce sportif saute haut, il a une bonne détente."
                                            },
                                            {
                                                "example_id": "fc34b577-f926-4dad-b9d8-78790cafc971",
                                                "sense_id": "50cf4006-f7d8-3da9-b855-0dee2acce969",
                                                "text": "Excusez-moi... balbutia-t-il, dressé d'une détente. Je ne voulais pas être importun..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "498a9827-4f99-37ba-920c-1445c07a1da4",
                                        "entry_id": "cb24f6d5-3c81-3160-90a6-f85a0d181d7d",
                                        "glosses": [
                                            "Coup de poing donné par un boxeur qui détend son bras."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5984543-c29c-40d2-80b1-d31f40b1d423",
                                                "sense_id": "498a9827-4f99-37ba-920c-1445c07a1da4",
                                                "text": "L'autre, sans se presser, lui plaçait crochets et directs comme s'il était à l'entraînement, devant un sparring-partner, et quand le rouquin l'atteignait d'une détente farouche, il encaissait le coup, massivement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57985841-77ba-38cb-bc7f-14d932ed344d",
                                        "entry_id": "cb24f6d5-3c81-3160-90a6-f85a0d181d7d",
                                        "glosses": [
                                            "Cale biseautée destinée à être placée par paire, tête-bêche sous le pied d'un étai pour en ajuster la hauteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b76829-8b47-4710-89c3-cb3f7a7d8d23",
                                                "sense_id": "57985841-77ba-38cb-bc7f-14d932ed344d",
                                                "text": "Ou bien ces coins sont-ils implicitement compris dans le prix complet d'étaiement, au même titre que les cales et détentes visées à l'article 22 et 39 …. — (La Construction moderne, volume 46, numéros 27 à 52, 1931)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44ddf4be-78c2-4956-a5cc-27aed5e7075b",
                        "source_entry_id": "76f28d52-06be-3b2e-9e84-c5f4e7bf3f01",
                        "source_sense_id": "436c5570-5639-31c3-a1b1-4c829cd019fc",
                        "source_sense_description": "Wetter",
                        "target_lang_word": "éclaircie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclaircie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2084f71b-a4e8-36d6-a93e-900e277fcb44",
                                        "entry_id": "7bde3765-ebd6-3d33-91e9-4e0524ccb473",
                                        "glosses": [
                                            "Endroit clair qui paraît au ciel en temps de brume ou entre des nuages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca769802-3b03-4b2d-aa8c-ec97ec1ee872",
                                                "sense_id": "2084f71b-a4e8-36d6-a93e-900e277fcb44",
                                                "text": "Le vent, qui parfois mollissait, reprenait bientôt avec plus de rage, au milieu de grains de grêle et de neige. À travers les éclaircies on ne découvrait que des sinistres."
                                            },
                                            {
                                                "example_id": "c4634734-d06b-4356-a2d8-5cb3a07ed1cf",
                                                "sense_id": "2084f71b-a4e8-36d6-a93e-900e277fcb44",
                                                "text": "Des éclaircies, en contrepoint à la marche sombre des corps."
                                            },
                                            {
                                                "example_id": "b68798e1-5536-47df-88f9-2bda8e3b9010",
                                                "sense_id": "2084f71b-a4e8-36d6-a93e-900e277fcb44",
                                                "text": "Il y a une éclaircie dans la situation politique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0005561a-cbe5-3b8c-9730-971167d3035a",
                                        "entry_id": "7bde3765-ebd6-3d33-91e9-4e0524ccb473",
                                        "glosses": [
                                            "Période ensoleillée plus ou moins longue ou dépourvue de nuage et de brume pendant la nuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73bd9c0e-6d3c-4663-b8c3-a45a3cd64aba",
                                                "sense_id": "0005561a-cbe5-3b8c-9730-971167d3035a",
                                                "text": "Le ciel était nuageux, l’humidité pénétrante. Entre des éclaircies de soleil, des averses tombaient."
                                            },
                                            {
                                                "example_id": "bf7fe5cd-ddb9-418b-bb7e-3935e28bdc7a",
                                                "sense_id": "0005561a-cbe5-3b8c-9730-971167d3035a",
                                                "text": "Vers le soir, nous commençons à distinguer des formes vagues qui se dessinent derrière le voile de brume, puis, à travers une éclaircie, nous reconnaissons des montagnes qui se découvrent une à une ; […]."
                                            },
                                            {
                                                "example_id": "9f6a835a-4038-46c4-a656-0b7711e03cb5",
                                                "sense_id": "0005561a-cbe5-3b8c-9730-971167d3035a",
                                                "text": "3. - Beau temps dans la matinée et le milieu du jour. On pêche. Dans la soirée, des nuées épaisses montent du S.-O., et la houle du large arrive jusqu'à nous. Éclaircie dans la nuit. 4. - Mer houleuse du S.-O. Brumes orageuses. Pêche difficile?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5da7299a-3a3b-329b-b79c-1f4f51cb691f",
                                        "entry_id": "7bde3765-ebd6-3d33-91e9-4e0524ccb473",
                                        "glosses": [
                                            "Action visant à réduire la densité d’un peuplement ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f31cb0-954d-4ee7-8ca5-3b00fe5e7e7c",
                                                "sense_id": "5da7299a-3a3b-329b-b79c-1f4f51cb691f",
                                                "text": "Une éclaircie se manifesta tout à coup à notre droite, - quelqu'une de ces coupes sombres qui éclaircissent singulièrement la forêt."
                                            },
                                            {
                                                "example_id": "6784b359-949a-446c-bac2-767df36de65e",
                                                "sense_id": "5da7299a-3a3b-329b-b79c-1f4f51cb691f",
                                                "text": "Je ne pouvais pénétrer dans ces bois où personne n’avait posé le pied, où j’étais probablement le premier à tenter de me frayer un chemin à l’aide de mon sabre. Il m’arrivait cependant de trouver quelques éclaircies."
                                            },
                                            {
                                                "example_id": "237b73a2-0120-4839-9795-6ce88f1d3614",
                                                "sense_id": "5da7299a-3a3b-329b-b79c-1f4f51cb691f",
                                                "text": "Par-dessous les arbres, on apperçoit la mer ; et dans les éclaircis, tout le golfe de la Napoule et les isles Sainte Marguerite. C’est un site vraiment délicieux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "éclaircie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b30e30d7-99f5-3edb-8814-8eadd731cd4d",
                                        "entry_id": "b73fc695-8534-37ec-a3c7-9230dfa8d389",
                                        "glosses": [
                                            "Féminin singulier de éclairci."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "éclaircie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfea4b0e-3cb8-36ac-8d04-1bcf6037d402",
                                        "entry_id": "6a4f5e82-6258-38cf-b134-032f370bc838",
                                        "glosses": [
                                            "Participe passé féminin singulier de éclaircir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edc8b9dd-8801-4d50-a6ca-4f1a0385fe7a",
                                                "sense_id": "cfea4b0e-3cb8-36ac-8d04-1bcf6037d402",
                                                "text": "L’une d’entre elles a déjà été éclaircie, dans une certaine mesure, celle des relations des doctrines viollet-le-duciennes avec les écrits de Ludovic Vitet et de Daniel Ramée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
