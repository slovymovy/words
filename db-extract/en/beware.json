                                    {
                                        "sense_id": "d3804191-6bc9-3bc8-96df-80e01c9dee2a",
                                        "entry_id": "d3a69395-c5c7-368c-b57c-d812fed459ca",
                                        "glosses": [
                                            "Agir avec prudence ; être attentif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09c29f4a-6abb-47e4-99ad-dd1c84e22117",
                                                "sense_id": "d3804191-6bc9-3bc8-96df-80e01c9dee2a",
                                                "text": "Ça m’abrutissait à tel point que je butai sur un gosse qui tenait un sac : « Tu peux pas faire attention, saligaude ! » hurla-t-il."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f69c31f-9d9f-3352-9d3a-274f42db4216",
                                        "entry_id": "d3a69395-c5c7-368c-b57c-d812fed459ca",
                                        "glosses": [
                                            "Être attentif (à quelque chose), remarquer (quelque chose)."
                                        ],
                                        "tags": [
                                            "Transitif avec le complément d’objet introduit par à"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e227786-5c63-478b-8ec8-86fdc101cecf",
                                                "sense_id": "2f69c31f-9d9f-3352-9d3a-274f42db4216",
                                                "text": "As-tu fait attention à la couleur de ces poissons ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef650f19-d066-3985-b908-961b1b326e31",
                                        "entry_id": "d3a69395-c5c7-368c-b57c-d812fed459ca",
                                        "glosses": [
                                            "Se méfier, prendre garde."
                                        ],
                                        "tags": [
                                            "Transitif avec le complément d’objet introduit par à"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca6899c-2f55-49c6-b272-7ffc49657fed",
                                                "sense_id": "ef650f19-d066-3985-b908-961b1b326e31",
                                                "text": "Fais attention ! Je vais te casser la gueule."
                                            },
                                            {
                                                "example_id": "05945c35-f018-440e-8857-0da26d505006",
                                                "sense_id": "ef650f19-d066-3985-b908-961b1b326e31",
                                                "text": "Fais attention à ce que tu dis !"
                                            },
                                            {
                                                "example_id": "5b3bd70c-8af1-4564-8712-997056ece34c",
                                                "sense_id": "ef650f19-d066-3985-b908-961b1b326e31",
                                                "text": "Fais attention à tes propos !"
                                            },
                                            {
                                                "example_id": "3d22c3b2-b251-4695-9ab6-094fa72e38fd",
                                                "sense_id": "ef650f19-d066-3985-b908-961b1b326e31",
                                                "text": "Fais attention à bien parler !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
