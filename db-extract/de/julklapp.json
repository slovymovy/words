                "senses": [
                    {
                        "sense_id": "eb84ed22-e1fd-3178-aa63-9d00cee590f8",
                        "entry_id": "05fbde0b-02d0-3a77-b17b-27a309450200",
                        "glosses": [
                            "der Brauch des Verschenkens von Julklapps"
                        ],
                        "tags": [
                            "meist ohne Artikel"
                        ],
                        "examples": [
                            {
                                "example_id": "c30c3c4f-af52-4655-b332-8eecd08e5a52",
                                "sense_id": "eb84ed22-e1fd-3178-aa63-9d00cee590f8",
                                "text": "Nicht schon wieder Julklapp werden sich viele Mitarbeiter von Betrieben auf der Suche nach einer Weihnachtsfeier sagen."
                            },
                            {
                                "example_id": "96a2a2d6-20e7-44b5-bf58-553f2c361403",
                                "sense_id": "eb84ed22-e1fd-3178-aa63-9d00cee590f8",
                                "text": "„Zu Beginn der Adventszeit fand auch das traditionelle Julefrokost mit Julklapp statt.“"
                            },
                            {
                                "example_id": "bc9af93b-d148-40fa-a998-f062e1fb51f8",
                                "sense_id": "eb84ed22-e1fd-3178-aa63-9d00cee590f8",
                                "text": "„Dem Weihnachtwichteln, auch als Julklapp bekannt, nähert Leserin Miriam Klemp sich mit einem Würfelspiel in drei Runden mit Eieruhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
