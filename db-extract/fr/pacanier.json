                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pecan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6f06dad-ff12-3304-926c-f0ea520350c9",
                                        "entry_id": "b7c2146a-fc3c-35e1-8901-cd5eac4b0604",
                                        "glosses": [
                                            "A deciduous tree, Carya illinoinensis, of the central and southern United States, having deeply furrowed bark, pinnately compound leaves, and edible nuts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfb14d92-9deb-4dba-b9c7-f35746b0b177",
                                                "sense_id": "a6f06dad-ff12-3304-926c-f0ea520350c9",
                                                "text": "And away on the farther bank, a motte of huge pecans, standing like giant sentinels over the dwarfed landscape, filled the eye with remote vistas in their shady, twilight aisles. It was very still."
                                            },
                                            {
                                                "example_id": "70dade26-99a9-4649-9429-230f81ea710d",
                                                "sense_id": "a6f06dad-ff12-3304-926c-f0ea520350c9",
                                                "text": "Within its ornamental fence, the 8/10-acre property includes several of the largest live oaks in the area — plus huge pecans and stately magnolias."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7601c738-f6c7-3b5a-a09f-8b50601a65b9",
                                        "entry_id": "b7c2146a-fc3c-35e1-8901-cd5eac4b0604",
                                        "glosses": [
                                            "A smooth, thin-shelled, edible oval nut of this tree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "366880b2-5ae0-4d64-a0c7-242e576ec364",
                                                "sense_id": "7601c738-f6c7-3b5a-a09f-8b50601a65b9",
                                                "text": "MEG. […] (Meg takes out two pecans and tries to open them by cracking them together.) Come on ... Crack, you demons! Crack!\nLENNY. We have a nutcracker!\nMEG. (Trying with her teeth.) Ah, where's the sport in a nutcracker? Where's the challenge?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e3b6971-247c-3881-b1cc-25e1300417fa",
                                        "entry_id": "b7c2146a-fc3c-35e1-8901-cd5eac4b0604",
                                        "glosses": [
                                            "A half of the edible portion of the inside of this nut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e185197-009b-4697-8f21-8340547eb54d",
                                                "sense_id": "6e3b6971-247c-3881-b1cc-25e1300417fa",
                                                "text": "Each shell contains two pecans, usually plump and oblong in shape, although some varieties are round or pointed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
