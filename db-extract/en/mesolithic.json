                    },
                    {
                        "translation_id": "ff85796a-6e16-48d1-8193-09c185e1b81c",
                        "source_entry_id": "085fbc87-8f68-33bd-a4a0-c464cf153399",
                        "source_sense_id": "266f930d-6e9f-3f26-a1d5-3f5fce3fe101",
                        "source_sense_description": "of or referring to the Middle Stone Age",
                        "target_lang_word": "mesolithisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mesolithisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c11ea830-a40a-31c3-8d5b-d481d0318c09",
                                        "entry_id": "107244ad-55fd-3d52-afc9-984211082919",
                                        "glosses": [
                                            "das Mesolithikum betreffend, zu ihm gehörend, in/während der Mittelsteinzeit"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ab85ba-d305-4be4-b7e9-0fdf79601bf0",
                                                "sense_id": "c11ea830-a40a-31c3-8d5b-d481d0318c09",
                                                "text": "„Vermutlich hat der neolithische Bauer mehr Zeit mit Arbeit verbracht als der noch mesolithisch geprägte Jäger für die Jagd, dafür konnte der Bauer aber auch für ungünstige Zeiten Vorräte anhäufen und so Hungerzeiten vermeiden.“"
                                            },
                                            {
                                                "example_id": "64adda1e-2868-4fcd-9743-27f16859ed5e",
                                                "sense_id": "c11ea830-a40a-31c3-8d5b-d481d0318c09",
                                                "text": "„Am Drachenberg bei Peking sind außer den Sinanthropus-Resten auch Funde aus jüngerer Zeit gemacht worden; älter als mesolithisch können sie wohl nicht sein.“"
                                            },
                                            {
                                                "example_id": "2b43f815-07a8-455a-8760-fc15edb9801b",
                                                "sense_id": "c11ea830-a40a-31c3-8d5b-d481d0318c09",
                                                "text": "„Typisch mesolithisch ist auch die Verwendung von Ulmenholz und die Benutzung der natürlichen Stammoberfläche als Bogenvorderseite.“"
                                            },
                                            {
                                                "example_id": "9a80a8d6-89fc-4266-957e-9e8699ce4997",
                                                "sense_id": "c11ea830-a40a-31c3-8d5b-d481d0318c09",
                                                "text": "„Die Gleichzeitigkeit mit den als mesolithisch bis bronzezeitlich bezeichneten Steinwerkzeugen, vorwiegend Klingen, wird sehr glaubhaft gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
