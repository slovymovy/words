                "senses": [
                    {
                        "sense_id": "4b2f4c2f-1752-370e-8a5e-011ba182ee2c",
                        "entry_id": "2747ee1f-b050-30f4-b473-9304a50042b7",
                        "glosses": [
                            "The practice of fraudulent medicine, usually in order to make money or for ego gratification and power; health fraud."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1e645195-483a-496e-b21e-5ecb80bdd6fa",
                                "sense_id": "4b2f4c2f-1752-370e-8a5e-011ba182ee2c",
                                "text": "When no certain cure exists, quack remedies tend to proliferate and the history of quackery and secret cures is full of extraordinary forms of treatment for the various arthritic disorders."
                            }
                        ]
                    },
                    {
                        "sense_id": "2844c40d-443e-394f-ba09-af1396f7d05e",
                        "entry_id": "2747ee1f-b050-30f4-b473-9304a50042b7",
                        "glosses": [
                            "An instance of practicing fraudulent medicine."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "d98ff973-5102-4023-9199-d823931543fd",
                                "sense_id": "2844c40d-443e-394f-ba09-af1396f7d05e",
                                "text": "[…] the manifold and serpentine wiles and evasions, shufflings and fencings, deceits and dissimulations, he had practised —the bunkums and the quackeries, […]"
                            }
                        ]
                    }
                ],
