                        "target_lang_word": "Brudermörder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brudermörder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "753c173c-458d-30ff-a492-74dd3f17ae4a",
                                        "entry_id": "246761f2-a57a-3426-994c-0443959dfb84",
                                        "glosses": [
                                            "Mensch, der seinen eigenen Bruder ermordet hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61be0502-b4a2-42c3-b2e5-602b186841fe",
                                                "sense_id": "753c173c-458d-30ff-a492-74dd3f17ae4a",
                                                "text": "„Figuren wie der biblische Brudermörder Kain kehren als Helden langer Erzählgedichte wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a75cec6-bda8-4510-81db-2aecd5135b54",
                        "source_entry_id": "c8c51554-a67f-3d16-8076-ce0c578ee770",
                        "source_sense_id": "7bc3399d-f71b-30b3-963a-cbb5571b7ccb",
                        "target_lang_word": "братоубийца",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "братоубийца",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "98fb3b4f-10da-3ba2-a02e-0e1160c91e33",
                                        "entry_id": "ac3ae73f-afb6-38dd-9ff3-78a88fee5967",
                                        "glosses": [
                                            "убийца своего брата или своих братьев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88fd938-dfe6-456a-96c2-f1eddd3fc35f",
                                                "sense_id": "98fb3b4f-10da-3ba2-a02e-0e1160c91e33",
                                                "text": "Августин проводит параллель между братоубийцей Каином и братоубийцей Ромулом, один из которых основал первый в мире, а второй — величайший в мире город: вот так и строятся земные города — на крови."
                                            },
                                            {
                                                "example_id": "37510622-c75c-45d1-bfdd-eeea7df9d2e7",
                                                "sense_id": "98fb3b4f-10da-3ba2-a02e-0e1160c91e33",
                                                "text": "Мне известно было беспредельное честолюбие Владимира; я знал, что тот, кто умертвил отца и братьев жены своей Рогнеды, не испугается названия братоубийцы."
                                            },
                                            {
                                                "example_id": "c0254fc6-f2d4-4ad0-9b50-f8ee43208e9f",
                                                "sense_id": "98fb3b4f-10da-3ba2-a02e-0e1160c91e33",
                                                "text": "Братоубийца Святополк, // От всех оставленный, скитался…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c5d1735-abc3-33a8-8f86-2e9dee734d81",
                                        "entry_id": "ac3ae73f-afb6-38dd-9ff3-78a88fee5967",
                                        "glosses": [
                                            "перен. убийца своего единомышленника, собрата"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f02a47f-e8a2-4a35-a53e-ab508e7a3cfa",
                                                "sense_id": "0c5d1735-abc3-33a8-8f86-2e9dee734d81",
                                                "text": "В начале января этого года Кошна встретил на Гороховой улице патруль лейб-гвардии измайловского полка и стал ему кричать: «Братоубийцы!»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
