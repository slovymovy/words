                ],
                "senses": [
                    {
                        "sense_id": "d7f0f84d-302b-3f31-9ca7-effa1c728b87",
                        "entry_id": "f33b921a-e950-32b7-af59-136cc6b386dc",
                        "glosses": [
                            "A small anchor used for warping a vessel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6464b8f6-1c41-4ed7-807d-688b77c0134e",
                                "sense_id": "d7f0f84d-302b-3f31-9ca7-effa1c728b87",
                                "text": "...and throw them into the boat, which, as there are no wharves, we usually kept anchored by a small kedge, or keelek, just outside of the surf."
                            },
                            {
                                "example_id": "71c99741-98d6-4b9d-b3e9-3677c438bc8a",
                                "sense_id": "d7f0f84d-302b-3f31-9ca7-effa1c728b87",
                                "text": "The chaps who had gone off in the cutter had been equally spry with their job, bending on a stout hemp hawser through the ring of the kedge anchor, which they dropped some half a cable's length from the brig, bringing back the other end aboard, where it was put round the capstan on the forecastle."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e24805c-7607-349d-b49e-4412c9e03b4c",
                        "entry_id": "f33b921a-e950-32b7-af59-136cc6b386dc",
                        "glosses": [
                            "A glutton."
                        ],
                        "tags": [
                            "Yorkshire"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0d5ff56-a942-4e92-b6d2-d7b641b313ca",
