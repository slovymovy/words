                "senses": [
                    {
                        "sense_id": "e9878cd9-37e3-31aa-91df-9bd66de08764",
                        "entry_id": "9af48bfa-af80-3911-b3cd-9ed70299ddd5",
                        "glosses": [
                            "Verhalten/Behauptung, wodurch ein falscher Eindruck erwecken werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5e38ab0-b021-4905-9c9a-481aecd25da0",
                                "sense_id": "e9878cd9-37e3-31aa-91df-9bd66de08764",
                                "text": "„Hysterie und Simulation sind von Existenzängsten angetriebene Vortäuschungen von Krankheiten und Hilfsbedürftigkeit.“"
                            },
                            {
                                "example_id": "1828cf80-4bd7-4788-89c3-4564639fe76e",
                                "sense_id": "e9878cd9-37e3-31aa-91df-9bd66de08764",
                                "text": "Eine Selbstbeschädigung erfolgt nicht selten zum Zweck der Vortäuschung einer Straftat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
