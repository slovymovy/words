                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58a1e030-a86a-3592-8665-56c8027490a4",
                                        "entry_id": "20c7a992-fd5e-3cd8-9952-e619d6bf6a93",
                                        "glosses": [
                                            "Money, especially when acquired or spent illegally or improperly; swag."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48fcf131-a31b-4fc4-92a1-ccea2ca082b3",
                                                "sense_id": "58a1e030-a86a-3592-8665-56c8027490a4",
                                                "text": "around 1900, O. Henry, According to Their Lights\nHe was your 'man higher up' when you were on the force. His share of the boodle passed through your hands. You must go on the stand and testify against him."
                                            },
                                            {
                                                "example_id": "3f1a860a-560b-4ce2-ab10-d3c528912023",
                                                "sense_id": "58a1e030-a86a-3592-8665-56c8027490a4",
                                                "text": "[…] marauders ready to decamp with whatever boodle they could in one fell swoop at a moment’s notice, your money or your life, leaving you there to point a moral, gagged and garotted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e5f3de8-2047-3893-8098-5877597ee0ce",
                                        "entry_id": "20c7a992-fd5e-3cd8-9952-e619d6bf6a93",
                                        "glosses": [
                                            "The whole collection or lot; caboodle."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52e0eddb-08d7-4297-a614-454b1bf9c84f",
                                                "sense_id": "7e5f3de8-2047-3893-8098-5877597ee0ce",
                                                "text": "He pulled off his coat and threw it down, and declared he'd fight the whole boodle of 'em"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42ce35d3-f99c-39d5-a3e2-e747d9e2dcf1",
                                        "entry_id": "20c7a992-fd5e-3cd8-9952-e619d6bf6a93",
                                        "glosses": [
                                            "Candy and snacks."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e49e6e0-fbd4-42b5-8979-b3466976bb42",
                                                "sense_id": "42ce35d3-f99c-39d5-a3e2-e747d9e2dcf1",
                                                "text": "Send the first boodle in an airtight container so that there is a place for the storage of future packages […] Suggestions for Boodle: cookies, candy, individual packets of drink mixes (sugar-free), raisins, nuts, gum."
                                            }
                                        ]
                                    }
                                ]
