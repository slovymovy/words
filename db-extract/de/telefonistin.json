                                "example_id": "e820068f-4ba1-4640-8b57-d77f894910e9",
                                "sense_id": "f3f57815-e956-35c9-b8c6-ebb176998bc1",
                                "text": "„Er brauchte ein paar Minuten, um sich über verschiedene Telefonistinnen an ihn heranzuarbeiten, doch am Ende wurde er zum Chef des Unternehmens durchgestellt, […].“"
                            },
                            {
                                "example_id": "e0763403-ab52-4b2d-af98-c1d74b785aee",
                                "sense_id": "f3f57815-e956-35c9-b8c6-ebb176998bc1",
                                "text": "„Die Telefonistin sagte ihm, niemand habe von da seine Nummer angerufen.“"
                            }
                        ],
