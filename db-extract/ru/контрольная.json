                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72af7699-5190-4d68-a8c8-fa42ff833606",
                                                "sense_id": "4c768e81-0d9b-384c-94b0-325b708422a7",
                                                "text": "Climbing the mountain tested our stamina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62234a89-f45a-3081-9da3-d28b588423a3",
                                        "entry_id": "502bad9a-5bf0-326b-af8e-6db442fa92bc",
                                        "glosses": [
                                            "To refine (gold, silver, etc.) in a test or cupel; to subject to cupellation."
                                        ],
