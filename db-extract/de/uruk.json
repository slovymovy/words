                "senses": [
                    {
                        "sense_id": "dee752a6-9a8b-3ea2-99e0-b7524641c26d",
                        "entry_id": "6b54de55-e319-35c5-9e43-5691b154e747",
                        "glosses": [
                            "Historische Stadt in Mesopotamien: Die wohl erste Großstadt der Menschheitsgeschichte circa 300 km südöstlich von Bagdad am Euphrat gelegen; der moderne Name des Staates Irak leitet sich von dem Städtenamen Uruk ab."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feffbf79-858a-495c-b973-f1fc6c1d39d8",
                                "sense_id": "dee752a6-9a8b-3ea2-99e0-b7524641c26d",
                                "text": "Gilgamesch war von 2652 v. Chr. bis 2602 v. Chr. der König von Uruk."
                            },
                            {
                                "example_id": "673da403-fefd-4391-ac52-464ff6828dd3",
                                "sense_id": "dee752a6-9a8b-3ea2-99e0-b7524641c26d",
                                "text": "Uruk lag zwischen Babylon und Ur am Fluss Euphrat."
                            },
                            {
                                "example_id": "112400b3-18ef-49a5-831a-9987f9f24618",
                                "sense_id": "dee752a6-9a8b-3ea2-99e0-b7524641c26d",
                                "text": "Uruk wurde erstmals von einem deutschen Team unter Julius Jordan vor dem 1. Weltkrieg ausgegraben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
