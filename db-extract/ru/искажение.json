                                    {
                                        "sense_id": "171e11ff-c006-3712-bbf8-e4cc0005ebda",
                                        "entry_id": "99b63dbc-baec-3a66-a1c0-26cf6e7f0140",
                                        "glosses": [
                                            "État d’une partie du corps qui se tourne d’un seul côté par le relâchement des muscles opposés, ou par la contraction des muscles correspondants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99f21ab4-c971-4c9d-85d2-6fa87bade7e0",
                                                "sense_id": "171e11ff-c006-3712-bbf8-e4cc0005ebda",
                                                "text": "Mourant sous les roues carnassières\nDans son crâne vague, il sentit\nUne distorsion étrangère\nAvant de connaître l’oubli"
                                            },
                                            {
                                                "example_id": "813d6f82-f19c-4ad6-a03c-5dbd40b4d9c1",
                                                "sense_id": "171e11ff-c006-3712-bbf8-e4cc0005ebda",
                                                "text": "Distorsion de la bouche, des yeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f83a6f15-4a90-3e78-b204-1a4584f47e6a",
                                        "entry_id": "99b63dbc-baec-3a66-a1c0-26cf6e7f0140",
                                        "glosses": [
                                            "Aberration des miroirs ou des lentilles, entraînant une déformation des images."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f86dd129-9ed3-32a8-9eae-302866e508e7",
                                        "entry_id": "99b63dbc-baec-3a66-a1c0-26cf6e7f0140",
                                        "glosses": [
                                            "Déformation d'un signal acoustique, électrique qui perturbe sa bonne transmission."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "450897b5-561d-3aab-844f-f09945f294a2",
                                        "entry_id": "99b63dbc-baec-3a66-a1c0-26cf6e7f0140",
                                        "glosses": [
                                            "Effet sonore, le son perd en clarté mais cela permet de garder une note sans la rejouer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ae13367-7f97-3f1c-9c2a-697ad58575cd",
                                        "entry_id": "99b63dbc-baec-3a66-a1c0-26cf6e7f0140",
                                        "glosses": [
                                            "Altération de l’espace-temps ou d’un espace virtuel."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7fdf140-bfe4-4fc8-8bcd-37678218ef37",
                                                "sense_id": "2ae13367-7f97-3f1c-9c2a-697ad58575cd",
                                                "text": "Le fichier d’iNNoKeNTi crée des distorsions dans la trame de Cyberland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6f77c24-c3ff-3d15-92e3-3e6c75f2d137",
