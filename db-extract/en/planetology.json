                    {
                        "translation_id": "cb156954-db83-4818-bd42-21621df983bd",
                        "source_entry_id": "6dcbca65-6cbb-3fb9-997a-ea13da2da124",
                        "source_sense_id": "f01cee88-656b-3a2a-9c2f-1d8a84c28715",
                        "source_sense_description": "the study of planets",
