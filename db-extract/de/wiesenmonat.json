                    }
                ],
                "translations": [
                    {
                        "translation_id": "28442c65-e0b9-4e00-b691-81d675394dc4",
                        "source_entry_id": "a003bfc3-25d8-3705-8488-4b247e932b11",
                        "source_sense_id": "bcd87f0e-08f6-311b-aa44-37de30a4a940",
                        "source_sense_description": "neunter Monat des französischen Revolutionskalenders",
                        "target_lang_word": "prairial",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prairial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a76ad817-b0d1-3860-a5f7-a72948e3430e",
                                        "entry_id": "3602051d-8945-317b-8f95-91222c6179fa",
                                        "glosses": [
                                            "Relatif aux prairies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb87958b-6f6f-43ae-a79f-e52c7cae93d3",
                                                "sense_id": "a76ad817-b0d1-3860-a5f7-a72948e3430e",
                                                "text": "Contrairement aux céréales qui n'ont qu'un seul cycle de végétation, les graminées prairiales ont plusieurs cycles de végétation."
                                            },
                                            {
                                                "example_id": "c8fce916-d236-47f1-9442-3007db301b3e",
                                                "sense_id": "a76ad817-b0d1-3860-a5f7-a72948e3430e",
                                                "text": "Leur teneur en protéines en fait un aliment de compensation quand l'accessibilité aux proies (vers, petits mollusques, petits rongeurs, etc.) des milieux prairiaux est rendue difficile par la sécheresse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prairial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a975641-2cb8-3744-b472-9519aa9e4dd9",
                                        "entry_id": "b155b772-6d6f-321f-ba2a-3965d438fc97",
                                        "glosses": [
                                            "Neuvième mois du calendrier républicain, qui commençait le 20 ou le 21 mai et finissait le 18 ou le 19 juin selon les années."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b331245d-b5be-43f2-b05f-152d4daf5b0a",
                                                "sense_id": "2a975641-2cb8-3744-b472-9519aa9e4dd9",
                                                "text": "Ainsi leurs 1,800 liv. assignats n'étaient prises qu'au taux de deux cents capitaux pour un, et encore fallait-il que ce fussent des assignats de 100 liv. et au-dessous, ceux d'un chiffre supérieur ayant cessé absolument d'avoir cours depuis le 23 prairial."
                                            },
                                            {
                                                "example_id": "08156310-a9e9-4a0f-aaa9-a789ebe043ca",
                                                "sense_id": "2a975641-2cb8-3744-b472-9519aa9e4dd9",
                                                "text": "Ils célébrèrent le 20 prairial (8 juin) le fête de l'Être suprême. Robespierre, président de la Convention, servit de pontife à cette fête; […]."
                                            },
                                            {
                                                "example_id": "6e6ab612-9193-4388-8085-6e63432f6cb8",
                                                "sense_id": "2a975641-2cb8-3744-b472-9519aa9e4dd9",
                                                "text": "La loi du 22 prairial se contente de définitions assez vagues du crime politique, de manière à ne laisser échapper aucun ennemi de la Révolution ; […]."
                                            },
                                            {
                                                "example_id": "b92cca42-2a2c-461a-b5ed-5eea79e9d823",
                                                "sense_id": "2a975641-2cb8-3744-b472-9519aa9e4dd9",
                                                "text": "Dans le calendrier républicain c'était le 11ᵉ jour dans le mois de prairial, le jour de la fraise. La fraise est le fruit (en réalité un faux-fruit) du fraisier, plante herbacée du genre « Fraga ria » de la famille des Rosacées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
