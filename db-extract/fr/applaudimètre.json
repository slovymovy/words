                "forms": [
                    {
                        "form_id": "80b9916b-5987-44fa-b9b8-84a9e476fe94",
                        "entry_id": "542d6a89-cb7e-3cf0-b64b-7f1d3b63eec3",
                        "tags": [
                            "plural"
                        ],
                        "form": "applaudimètres"
