                "senses": [
                    {
                        "sense_id": "c8d91c85-1ca9-3731-b410-c898de405346",
                        "entry_id": "fb2a9a71-3d99-3782-9ce2-d6e4a8b58ff1",
                        "glosses": [
                            "een winkel voor kruidenierswaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "315cc2ac-c1a0-46fc-b003-86f5ad0d9108",
                                "sense_id": "c8d91c85-1ca9-3731-b410-c898de405346",
                                "text": "De deur van de kruidenierszaak stond open en van verre zag ze al dat het er vol stond."
                            },
                            {
                                "example_id": "e921a5de-2375-499e-8656-97ccfc72518b",
                                "sense_id": "c8d91c85-1ca9-3731-b410-c898de405346",
                                "text": "We vervolgen onze route richting een kruidenierszaak in de Bijlmer waar we een afspraak hebben met algemeen directeur Cees van Vliet. Het beleid van deze keten die op de kleintjes let is om zo min mogelijk afval te produceren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9666577-cb77-4a32-aa61-14e316d664fb",
                        "source_entry_id": "fb2a9a71-3d99-3782-9ce2-d6e4a8b58ff1",
                        "source_sense_id": "c8d91c85-1ca9-3731-b410-c898de405346",
                        "target_lang_word": "Lebensmittelgeschäft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lebensmittelgeschäft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "446b16bf-77d4-31bc-b007-e02cca9880a4",
                                        "entry_id": "2fe64cf6-6456-3293-aecd-6134ef63af9d",
                                        "glosses": [
                                            "Geschäft, in dem hauptsächlich Lebensmittel verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "209bf1fe-5550-4e22-a2d9-616733493fba",
                                                "sense_id": "446b16bf-77d4-31bc-b007-e02cca9880a4",
                                                "text": "Er geht oft gegenüber im Lebensmittelgeschäft einkaufen."
                                            },
                                            {
                                                "example_id": "d069980f-3dd4-47f4-8248-42d13dfb91a4",
                                                "sense_id": "446b16bf-77d4-31bc-b007-e02cca9880a4",
                                                "text": "„Da gibt es ein Lebensmittelgeschäft, ein kleines Café, einen Fischladen.“"
                                            },
                                            {
                                                "example_id": "4a27afc5-3691-44df-8c9a-914bb68c2c3c",
                                                "sense_id": "446b16bf-77d4-31bc-b007-e02cca9880a4",
                                                "text": "„Wir trippelten also in der glühenden Hitze vom Bäcker zum Obst- und Gemüseladen und dann zum Lebensmittelgeschäft und kamen jedes Mal mit mehr und mehr Proviant beladen wieder heraus.“"
                                            },
                                            {
                                                "example_id": "c7253d66-79a3-405c-89ff-7afc44f9830b",
                                                "sense_id": "446b16bf-77d4-31bc-b007-e02cca9880a4",
                                                "text": "„Wir gehen weiter durch den Wald und kommen zum früheren Lebensmittelgeschäft, das ebenfalls aus Beton ist.“"
                                            },
                                            {
                                                "example_id": "be6326a8-d483-478f-8775-de9376d2ac37",
                                                "sense_id": "446b16bf-77d4-31bc-b007-e02cca9880a4",
                                                "text": "„Zu jener Zeit besaß ihr Vater ein Lebensmittelgeschäft und eine Metzgerei und war wohlhabend genug, um eine russische Einwanderin namens Anna als Hausmädchen zu beschäftigen, das unter einem Dach mit der Familie wohnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
