                                        "sense_id": "8966f3d5-4abe-305c-86ba-4d530c1a6170",
                                        "entry_id": "c0889888-b2e3-3568-8768-3fbd9c046a6e",
                                        "glosses": [
                                            "A female given name from Latin, in quiet use since the Middle Ages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c6470c0-c456-4653-8f70-acd07fdb0c71",
                                                "sense_id": "8966f3d5-4abe-305c-86ba-4d530c1a6170",
                                                "text": "If beauty, wisdom, modesty can settle\nThe heart of Antony, Octavia is\nA blessed lottery to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7ab5651-57c7-33af-8fc5-02bc210ce799",
                                        "entry_id": "c0889888-b2e3-3568-8768-3fbd9c046a6e",
                                        "glosses": [
                                            "598 Octavia, a minor planet orbiting around the Sun."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
