        "fr-extract.jsonl": [
            {
                "entry_id": "03a7f16b-3e9b-3827-bb59-4677b2a3199d",
                "word": "phytophage",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "601d9424-6544-4864-b6a8-29edc985a836",
                        "entry_id": "03a7f16b-3e9b-3827-bb59-4677b2a3199d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "phytophages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "088ef23d-f55f-383f-b359-de36db211abf",
                        "entry_id": "03a7f16b-3e9b-3827-bb59-4677b2a3199d",
                        "glosses": [
                            "Qui se nourrit d’éléments végétaux, en parlant d’un insecte, d’un poisson, d’un gastéropode."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf8ba414-e71d-41b2-aa7d-ac2d6fe5cb5b",
                                "sense_id": "088ef23d-f55f-383f-b359-de36db211abf",
                                "text": "A l’exception de quelques espèces lichénivores, fongivores ou occasionnellement voire exclusivement prédatrices, les larves sont phytophages (généralement oligophage ou monophage). Parmi les espèces nuisibles rencontrées en serres, la majorité sont polyphages."
                            },
                            {
                                "example_id": "9cf1d610-2ca0-4f97-899b-a6ffa47fe7bd",
                                "sense_id": "088ef23d-f55f-383f-b359-de36db211abf",
                                "text": "Il présente une action freinatrice sur acariens phytophages ainsi qu’une action ovicide sur les œufs de Lépidoptères."
                            },
                            {
                                "example_id": "a69ca008-b9d5-4264-bf00-0704ee2141b4",
                                "sense_id": "088ef23d-f55f-383f-b359-de36db211abf",
                                "text": "Le terme d’herbivore s’applique traditionnellement aux vertébrés ; pour les invertébrés, on parle de phytophage."
                            }
                        ]
                    }
                ],
