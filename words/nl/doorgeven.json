                                "cs": "Už jsi <w>oznámil</w> svou novou adresu?",
                                "tr": "Yeni adresini çoktan <w>bildirdin</w> mi?",
                                "es": "¿Ya has <w>comunicado</w> tu nueva dirección?",
                                "zh": "你已经把你的新地址<w>告知</w>大家了吗？"
                            }
