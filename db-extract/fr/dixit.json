        "fr-extract.jsonl": [
            {
                "entry_id": "4d4201c6-9205-377a-a3b8-1aea603719e9",
                "word": "dixit",
                "pos": "prep",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f7e45786-f372-33ab-bd13-4a0a710355e5",
                        "entry_id": "4d4201c6-9205-377a-a3b8-1aea603719e9",
                        "glosses": [
                            "Sert à introduire l’auteur d'une citation, celle-ci étant implicitement présentée comme exacte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99c66a7c-8127-4ce0-a97d-ff788468e420",
                                "sense_id": "f7e45786-f372-33ab-bd13-4a0a710355e5",
                                "text": "Tantôt attaquant, tantôt défenseur ou service-volleyeur, Alcaraz développe le concept du « joueur total », dixit Patrick Mouratoglou."
                            },
                            {
                                "example_id": "96a1707c-c159-470c-b88b-6cd77f5a5126",
                                "sense_id": "f7e45786-f372-33ab-bd13-4a0a710355e5",
                                "text": "« Ce n’est pas à la loi de définir l’histoire », dixit Jacques Chirac."
                            },
                            {
                                "example_id": "688ceb2d-223c-4a55-9f69-bd694dbf926a",
                                "sense_id": "f7e45786-f372-33ab-bd13-4a0a710355e5",
                                "text": "« L’économie ne se change pas par décret », dixit Michel Rocard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b686d35-5048-4b4d-a60f-3eb44351d237",
                        "source_entry_id": "4d4201c6-9205-377a-a3b8-1aea603719e9",
                        "source_sense_id": "f7e45786-f372-33ab-bd13-4a0a710355e5",
                        "target_lang_word": "dixit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e2017e42-80de-40eb-bc13-1c93a2eb1cc8",
                        "source_entry_id": "4d4201c6-9205-377a-a3b8-1aea603719e9",
                        "source_sense_id": "f7e45786-f372-33ab-bd13-4a0a710355e5",
                        "target_lang_word": "aldus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aldus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0d1f1bee-eb8c-39e2-93d4-1e47acd5b06a",
                                        "entry_id": "08de1e3f-7f50-38c7-9ee8-876bfff98056",
                                        "glosses": [
                                            "zo, op deze manier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a45bc131-1d51-4fbc-8cde-d7b4d672e908",
                                                "sense_id": "0d1f1bee-eb8c-39e2-93d4-1e47acd5b06a",
                                                "text": "Hij erfde het landgoed van zijn vader en werd aldus een man in goeden doen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df57720f-f2b1-3819-9845-0c34590c83df",
                                        "entry_id": "08de1e3f-7f50-38c7-9ee8-876bfff98056",
                                        "glosses": [
                                            "volgens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a6136b6-9409-4735-afcf-cfd9a68e2188",
                                                "sense_id": "df57720f-f2b1-3819-9845-0c34590c83df",
                                                "text": "U kunt gerust zijn we gaan geen oorlog voeren aldus de president."
                                            },
                                            {
                                                "example_id": "00b32f8f-9437-432c-9abf-b6544e4c0d29",
                                                "sense_id": "df57720f-f2b1-3819-9845-0c34590c83df",
                                                "text": "De herdenkingen hier zijn talrijk, aldus Gijs."
                                            },
                                            {
                                                "example_id": "b6b3e5eb-ad2a-4fdf-9ef9-63ff49f39f08",
                                                "sense_id": "df57720f-f2b1-3819-9845-0c34590c83df",
                                                "text": "‘Ons doel was om anderen te inspireren,’ aldus Orme. ’Het was fantastisch als mensen ons vertelden dat ze nu ook afval gingen opruimen."
                                            },
                                            {
                                                "example_id": "51d9c6f7-2b01-4e31-b7dd-163fdd64b0f4",
                                                "sense_id": "df57720f-f2b1-3819-9845-0c34590c83df",
                                                "text": "Wat hij 'de tirannie van de meerderheid' noemde, was in bepaalde opzichten nog erger dan de tirannie van een absolute heerser, omdat - aldus Mill - die tirannie volgens diezelfde meerderheid volkomen gerechtvaardigd was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c3472ba-2108-45b3-a989-3b5c8194efad",
                        "source_entry_id": "4d4201c6-9205-377a-a3b8-1aea603719e9",
                        "source_sense_id": "f7e45786-f372-33ab-bd13-4a0a710355e5",
                        "target_lang_word": "dixit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dixit",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ce1838c3-1b8a-3b02-95f2-ed1624cac229",
                                        "entry_id": "23815cdd-fc01-3e62-a969-2bfdd8d3a0fc",
                                        "glosses": [
                                            "volgens, aldus"
                                        ],
                                        "tags": [
                                            "geplaatst voor de aanduiding van degene die de aangehaalde uitspraak deed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c2ce40a-81c9-417d-9c81-47c51a5d4a3c",
                                                "sense_id": "ce1838c3-1b8a-3b02-95f2-ed1624cac229",
                                                "text": "De recensies over Wijnberg klinken soms vrijwel wanhopig: ‘Waarom laat hij ons aan ons lot over?’ vraagt Arjan Peters zich af. ‘Een eigenaardig boek, meer kan ik er niet over zeggen’, dixit Jacques Vogelaar."
                                            },
                                            {
                                                "example_id": "437f2654-6430-4460-a79d-df18a8018efd",
                                                "sense_id": "ce1838c3-1b8a-3b02-95f2-ed1624cac229",
                                                "text": "Maar het centrum is wel de stad die zes dagen per week wordt gezien en ervaren door de talloze tijdelijke verblijvers die thans ‘de goed uitgeruste regionale stad’ (dixit het Structuurplan Vlaanderen) maken tot wat ze is: een beetje woonstad, een beetje passantenstad."
                                            },
                                            {
                                                "example_id": "3a66aa00-1c5a-4fcd-9627-9dafd4164ffe",
                                                "sense_id": "ce1838c3-1b8a-3b02-95f2-ed1624cac229",
                                                "text": "Er werd beslist om twee toneelklassen te laten bestaan, maar de theorielessen moesten samensmelten. Zover kwam het echter niet, want eind 1996 en verschillende protestacties later kon de Studio onverwacht een sponsor verwelkomen. Daardoor werd het argument van de ‘te dure opleiding’ (voorlopig) ontkracht, hoewel het voortbestaan van de school nog steeds wordt bedreigd, dixit artistiek leider Decleir in december 1997."
                                            },
                                            {
                                                "example_id": "a46f8167-7081-4169-b94d-17c3e4ec4d83",
                                                "sense_id": "ce1838c3-1b8a-3b02-95f2-ed1624cac229",
                                                "text": "Meneer Willem uit Joab is, dixit de flaptekst, ‘het prototype van de autocratische ondernemer’."
                                            },
                                            {
                                                "example_id": "c9953335-8ebe-483b-80ed-122948043fdc",
                                                "sense_id": "ce1838c3-1b8a-3b02-95f2-ed1624cac229",
                                                "text": "De koper van het kunstboek is, dixit enkele uitgevers, prijsbewust én kritisch t.a.v. de inhoud van hetgeen hij onder ogen krijgt."
                                            },
                                            {
                                                "example_id": "a8d164f9-e614-485d-9322-d26b40f6f057",
                                                "sense_id": "ce1838c3-1b8a-3b02-95f2-ed1624cac229",
                                                "text": "Kortom: ik heb ook hier een goed sluitende en functionele structuur (dixit Piet van Aken) gebruikt om gestalte te geven aan twijfel en onzekerheid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46179409-e588-32bd-90a0-93d4433af566",
                                        "entry_id": "23815cdd-fc01-3e62-a969-2bfdd8d3a0fc",
                                        "glosses": [
                                            "citerend"
                                        ],
                                        "tags": [
                                            "als achterzetsel geplaatst na de aanduiding van degene die de aangehaalde uitspraak deed, om er extra nadruk op te vestigen dat het om een citaat gaat"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95c206d0-2fa8-4bff-93ff-0ed08795166e",
                                                "sense_id": "46179409-e588-32bd-90a0-93d4433af566",
                                                "text": "‘Het rijm is het wezen van de poëzie.’ Komrij dixit."
                                            },
                                            {
                                                "example_id": "c7f97002-25d5-411d-b1de-114b2b416688",
                                                "sense_id": "46179409-e588-32bd-90a0-93d4433af566",
                                                "text": "De naar eigen zeggen feministische auteur had eigenlijk alleen werk van vrouwelijke auteurs willen onderzoeken maar kon om Couperus' ‘De stille kracht’ en Daums ‘Nummer elf’ niet heen. Uit ‘het damescompartiment’ (Nieuwenhuys dixit) koos ze werk van Annie Foore, Melati van Java en Thérèse Hoven, schrijfsters die, zo meent zij, ‘gemarginaliseerd zijn’ door ‘bevooroordeelde’ manlijke critici als Busken Huet en Nieuwenhuys."
                                            },
                                            {
                                                "example_id": "06c9f785-f410-4cf0-a867-2e37fbd56c8d",
                                                "sense_id": "46179409-e588-32bd-90a0-93d4433af566",
                                                "text": "Men zou hierop kunnen antwoorden, dat de mens te beschouwen is als de som van zijn daden (Malraux dixit), en zo ook de dichter, de dichter-‘persoonlijkheid’, als de som van zijn gedichten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
