                                        "entry_id": "850b0036-ea84-3d0d-8909-0347d56f2f80",
                                        "glosses": [
                                            "in der griechischen, später auch römischen Sage der Fährmann, der die Toten/die Seelen der Toten über einen Fluss zum Eingang in die Unterwelt bringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92f36186-2340-4100-a547-c9ef67e409a1",
                                                "sense_id": "1d71964b-4050-3984-a719-5eddf3284c1c",
                                                "text": "„Äneas, welcher, um seinen Vater Anchises zu sehen, zu den Schatten stieg, hörte, sobald er, vom Charon über den Fluß gesetzt, am jenseitigen Ufer ausstieg, das Geschrei und Weinen der Kinder, die gleich nach ihrer Geburt gestorben waren, ohne des süßen Lebens genossen zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af52a1fc-cb54-3b0d-a11c-b1399900a94a",
                                        "entry_id": "850b0036-ea84-3d0d-8909-0347d56f2f80",
                                        "glosses": [
                                            "größter der fünf bekannten Plutomonde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146f5112-bc12-4d86-bf32-aab713c5ce6d",
                                                "sense_id": "af52a1fc-cb54-3b0d-a11c-b1399900a94a",
                                                "text": "„Die ersten Bilder, die Pluto und Charon als zwei separate Körper zeigten, gelangen in den 1990er Jahren mit dem Hubble-Weltraumteleskop.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
