                                "sense_id": "71fa51ac-a496-3165-8d49-5d0acb055453",
                                "text": "Die Cerci von ursprünglichen Insekten kann man gewissermaßen als „Fühler nach hinten“ interpretieren."
                            },
                            {
                                "example_id": "8d1bf19f-8563-4888-b730-5b2cec353447",
                                "sense_id": "71fa51ac-a496-3165-8d49-5d0acb055453",
                                "text": "„Linker Cercus medial mit Feldern oder Lappen, die mit kurzen, dicken Börstchen oder Dörnchen besetzt sind“"
                            }
                        ],
