                ],
                "senses": [
                    {
                        "sense_id": "7bb78a4b-d261-34ca-8c81-664e64a5cf73",
                        "entry_id": "7b526a58-92af-3d96-8e5a-bf7e1f772628",
                        "glosses": [
                            "niet erg ontvankelijk voor wat dan ook; ongeïnteresseerd"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a19a60cc-7eff-428a-a43f-60c34bca796a",
                                "sense_id": "7bb78a4b-d261-34ca-8c81-664e64a5cf73",
                                "text": "Wat een afgestompt stelletje is dat hier!"
                            },
                            {
                                "example_id": "1e7fce59-832b-4ae7-abf5-27d16e3812a5",
                                "sense_id": "7bb78a4b-d261-34ca-8c81-664e64a5cf73",
                                "text": "Hij bekeek de twee met de blik van een afgestompte werknemer die zich elke dag weer verheugt op het moment dat zijn dienst erop zit."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c33e31a-2556-3d5a-8ff4-5f4d495202b1",
                        "entry_id": "7b526a58-92af-3d96-8e5a-bf7e1f772628",
                        "glosses": [
                            "afgerond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "143513d0-4a3f-49b4-adf9-0a67ecd1fc7c",
                                "sense_id": "5c33e31a-2556-3d5a-8ff4-5f4d495202b1",
                                "text": "Grote omgevallen boomstammen zaten klem tussen de rotsen en waren geheel kaal en afgestompt door de sterke stroming die miljoenen liters smeltwater per dag uit de bergen moest verwerken."
                            }
                        ]
                    }
