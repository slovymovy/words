                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b04e9a17-d776-306c-993f-2ccbe2d92203",
                                        "entry_id": "9e699198-aa94-3335-bfd4-4b118b60b4f9",
                                        "glosses": [
                                            "Intoxicated as a result of excessive alcohol consumption, usually by drinking alcoholic beverages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c50b916-ec2e-4640-aa42-688e48f4bc62",
                                                "sense_id": "b04e9a17-d776-306c-993f-2ccbe2d92203",
                                                "text": "So I took a great dry gourd and, cutting open the head, scooped out the inside and cleaned it; after which I gathered grapes from a vine which grew hard by and squeezed them into the gourd, till it was full of the juice. Then I stopped up the mouth and set in the sun, where I left it for some days, until it became strong wine; and every day I used to drink of it, to comfort and sustain me under my fatigues with that from froward and obstinate fiend; and as often as I drank myself drunk, I forgot my troubles and took new heart."
                                            },
                                            {
                                                "example_id": "119dd395-a3f1-475c-a5cf-437ca289cc8b",
                                                "sense_id": "b04e9a17-d776-306c-993f-2ccbe2d92203",
                                                "text": "\"What part of 'you got drunk' did our parents misunderstand?\" \"I only drank a few shots!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40e82b44-4006-3377-a5e3-027be028e8f1",
                                        "entry_id": "9e699198-aa94-3335-bfd4-4b118b60b4f9",
                                        "glosses": [
                                            "Habitually or frequently in a state of intoxication."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dccebae-25c5-34f8-bedd-b4b49af69cf5",
                                        "entry_id": "9e699198-aa94-3335-bfd4-4b118b60b4f9",
                                        "glosses": [
                                            "Elated or emboldened."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4ad7de8-cd55-4b11-a95f-b9177f896bbb",
                                                "sense_id": "6dccebae-25c5-34f8-bedd-b4b49af69cf5",
                                                "text": "Drunk with power, he immediately ordered a management reshuffle."
                                            },
                                            {
                                                "example_id": "5c6fea08-6ff6-4be2-b08c-17172d095843",
                                                "sense_id": "6dccebae-25c5-34f8-bedd-b4b49af69cf5",
                                                "text": "drunk with recent prosperity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08cabc9b-7550-3f76-a766-ae5d14ed04e1",
                                        "entry_id": "9e699198-aa94-3335-bfd4-4b118b60b4f9",
                                        "glosses": [
                                            "Drenched or saturated with moisture or liquid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c5b8c1-3de5-4d66-9982-47d39ebe37bc",
                                                "sense_id": "08cabc9b-7550-3f76-a766-ae5d14ed04e1",
                                                "text": "I will make mine arrows drunk with blood."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0884773d-6edb-3f4e-ab1b-f6029a3021ff",
                                        "entry_id": "ca9007b4-38bf-3c2c-9fa3-a2cf7a2b5165",
                                        "glosses": [
                                            "While drunk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5311cd7-ab39-404d-a3de-73cd92b8aa9d",
                                                "sense_id": "0884773d-6edb-3f4e-ab1b-f6029a3021ff",
                                                "text": "He was arrested for driving drunk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9be96f00-2e50-3e03-be08-1dcdf4b81267",
                                        "entry_id": "35930f23-2b92-3f68-badc-87bb57c330fc",
                                        "glosses": [
                                            "One who is intoxicated with alcohol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e81f18a9-cad0-3aa7-9489-bc026fc06229",
                                        "entry_id": "35930f23-2b92-3f68-badc-87bb57c330fc",
                                        "glosses": [
                                            "A habitual drinker, especially one who is frequently intoxicated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0172e4a0-00f3-4d49-a335-65fee1705d20",
                                                "sense_id": "e81f18a9-cad0-3aa7-9489-bc026fc06229",
                                                "text": "Another drunk is sleeping in dangerous proximity to a brush fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "654972fe-d0a1-354a-acf1-6f85a9acb8ce",
                                        "entry_id": "35930f23-2b92-3f68-badc-87bb57c330fc",
                                        "glosses": [
                                            "A drinking-bout; a period of drunkenness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f96060cb-c4b3-49fa-a500-cc27bfcfebcc",
                                                "sense_id": "654972fe-d0a1-354a-acf1-6f85a9acb8ce",
                                                "text": "Gen. G. had been on a long drunk from July last until Christmas."
                                            },
                                            {
                                                "example_id": "cd5c0bd4-f24f-407b-8cde-4473a160c63f",
                                                "sense_id": "654972fe-d0a1-354a-acf1-6f85a9acb8ce",
                                                "text": "Life probably would have continued in blissful ignorance if it had not been for Vito's occasional late-night drunks. Usually he got plastered and misplaced his keys […] and bellowed obscenities into our shared hallway."
                                            },
                                            {
                                                "example_id": "ab4707a5-6558-4c45-8228-681bb8e5788f",
                                                "sense_id": "654972fe-d0a1-354a-acf1-6f85a9acb8ce",
                                                "text": "Now if you'll excuse me, I'm going to go on an overnight drunk, and in 10 days I'm going to set out to find the shark that ate my friend and destroy it. Anyone who wants to tag along is more than welcome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96c15fb9-826f-3ea8-8e3e-c6f08cef1196",
                                        "entry_id": "35930f23-2b92-3f68-badc-87bb57c330fc",
                                        "glosses": [
                                            "A drunken state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "536e210b-86cc-42cd-b993-3e21a94a7e11",
                                                "sense_id": "96c15fb9-826f-3ea8-8e3e-c6f08cef1196",
                                                "text": "Here – help yourself to another drop there, Redmond! By the time we've got a good drunk on us there'll be more crack in this valley than the night I pissed on the electric fence!"
                                            }
                                        ]
                                    }
                                ]
                            },
