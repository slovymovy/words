                "senses": [
                    {
                        "sense_id": "ef963e1c-5445-36b1-a6ee-857bc1c7a93e",
                        "entry_id": "c29a6f40-2ab7-3363-b456-309d7c48c493",
                        "glosses": [
                            "Person, die gerade mit dem Laufen beginnt oder noch wenig Erfahrung im Laufsport hat"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "a4e1bff7-6cc3-40c6-961c-f2a0783eda54",
                                "sense_id": "ef963e1c-5445-36b1-a6ee-857bc1c7a93e",
                                "text": "„Diese Sportuhr ist ideal für Laufanfänger, die viele verschiedene Outdoor-Sportarten ausüben und ein höheres Budget zur Verfügung haben.“"
                            },
                            {
                                "example_id": "569bdf5e-8246-49ac-b6c6-7de155c196cd",
                                "sense_id": "ef963e1c-5445-36b1-a6ee-857bc1c7a93e",
                                "text": "„Die Pulsfrequenz zeigt dir die aktuelle Belastungsintensität an und eignet sich deshalb besonders gut für Laufanfänger.“"
                            },
                            {
                                "example_id": "91db0740-973c-47a6-a6ec-291df5770bee",
                                "sense_id": "ef963e1c-5445-36b1-a6ee-857bc1c7a93e",
                                "text": "„Während der Halbmarathon durchaus anspruchsvoll ist, sind der zehn und der 5,2 Kilometer lange Lauf auch bestens für Laufanfänger geeignet.“"
                            },
                            {
                                "example_id": "a0c5203f-748e-478f-b134-a04737befa6a",
                                "sense_id": "ef963e1c-5445-36b1-a6ee-857bc1c7a93e",
                                "text": "„Es spielte keine Rolle, ob Lauferfahrene oder Laufanfänger, gemeinsam haben wir einen sportlichen und spaßigen Tag erlebt!“"
                            },
                            {
                                "example_id": "e5b255df-bf77-4c6f-9bd2-364cfaa18622",
                                "sense_id": "ef963e1c-5445-36b1-a6ee-857bc1c7a93e",
                                "text": "„Letztendlich ist das Wichtigste für Laufanfänger, Spaß am Laufen zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
