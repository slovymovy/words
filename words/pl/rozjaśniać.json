{
    "word_family": [
        "jasny",
        "jasność",
        "jaśnieć",
        "rozjaśnienie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "160ad520-6467-3bda-add2-ca9f0ec8dab5",
                    "sense_definition": "czynić coś jaśniejszym, nadawać jaśniejszy kolor lub zwiększać natężenie światła",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zmiana jasności",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Słońce <w>rozjaśnia</w> ciemne zakamarki pokoju.",
                            "target_lang_translations": {
                                "ru": "Солнце <w>освещает</w> темные уголки комнаты."
                            }
                        },
                        {
                            "text": "Malowanie ścian na biało <w>rozjaśnia</w> małe wnętrza.",
                            "target_lang_translations": {
                                "ru": "Окрашивание стен в белый цвет <w>осветляет</w> небольшие интерьеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozświetlać"
                    ],
                    "antonyms": [
                        "ściemniać"
                    ],
                    "common_phrases": [
                        "rozjaśniać wnętrze",
                        "rozjaśniać kolor"
                    ],
                    "target_lang_definitions": {
                        "ru": "делать что-либо более светлым, придавать более светлый оттенок или увеличивать интенсивность света"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осветлять",
                                "target_lang_sense_clarification": "делать цвет или оттенок светлее"
                            },
                            {
                                "target_lang_word": "освещать",
                                "target_lang_sense_clarification": "делать пространство более светлым с помощью света"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13a6fc3b-2a25-36cb-a2c7-76d78dde297e",
                    "sense_definition": "czynić coś bardziej zrozumiałym, wyjaśniać zawiłe kwestie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wyjaśnianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ekspert starał się <w>rozjaśniać</w> zawiłe przepisy prawne dla klientów.",
                            "target_lang_translations": {
                                "ru": "Эксперт старался <w>разъяснять</w> запутанные правовые нормы для клиентов."
                            }
                        },
                        {
                            "text": "Dodatkowe informacje pomogły <w>rozjaśniać</w> sytuację w firmie.",
                            "target_lang_translations": {
                                "ru": "Дополнительная информация помогла <w>прояснить</w> ситуацию в компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyjaśniać",
                        "tłumaczyć"
                    ],
                    "common_phrases": [
                        "rozjaśniać sytuację",
                        "rozjaśniać wątpliwości"
                    ],
                    "target_lang_definitions": {
                        "ru": "делать что-либо более понятным, прояснять сложные вопросы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прояснять",
                                "target_lang_sense_clarification": "делать ситуацию или вопрос более понятными"
                            },
                            {
                                "target_lang_word": "разъяснять",
                                "target_lang_sense_clarification": "объяснять что-то сложное или запутанное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3bfae02-b17f-3ffb-be53-a54e6166ca6f",
                    "sense_definition": "stawać się jaśniejszym, tracić ciemny odcień",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zmiana jasności",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niebo powoli <w>rozjaśnia</w> po burzowej nocy.",
                            "target_lang_translations": {
                                "ru": "Небо медленно <w>светлеет</w> после грозовой ночи."
                            }
                        },
                        {
                            "text": "Włosy <w>rozjaśnia</w> pod wpływem letniego słońca.",
                            "target_lang_translations": {
                                "ru": "Волосы <w>светлеют</w> под воздействием летнего солнца."
                            }
                        }
                    ],
                    "synonyms": [
                        "jaśnieć"
                    ],
                    "antonyms": [
                        "ciemnieć"
                    ],
                    "common_phrases": [
                        "niebo rozjaśnia",
                        "włosy rozjaśnia"
                    ],
                    "target_lang_definitions": {
                        "ru": "становиться светлее, терять темный оттенок"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светлеть",
                                "target_lang_sense_clarification": "становиться светлее (о небе, цвете)"
                            },
                            {
                                "target_lang_word": "осветляться",
                                "target_lang_sense_clarification": "становиться светлее (о волосах или под воздействием внешних факторов)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}