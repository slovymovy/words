                        "source_entry_id": "1286ddbf-75f5-349c-ba8c-bbd9ccd87154",
                        "source_sense_description": "fusion of two syllables without the formation of a diphthong",
                        "target_lang_word": "συνίζηση",
                        "target_lang_code": "el",
