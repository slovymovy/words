                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "359963c5-28f9-3c0f-8af0-95c1efff75f8",
                                        "entry_id": "b0c523cc-a6ab-37c5-9d32-cdf875e31796",
                                        "glosses": [
                                            "schienengebundene Nahverkehrssystem des Stadtverkehrs, Schnellstraßenbahn, häufig mit vom übrigen Verkehr getrennten oder unterirdischen Abschnitten. Regional (oder umgangssprachlich) auch für S-Bahn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "502b0652-40f6-490d-bc67-48c09f1e56e5",
                                                "sense_id": "359963c5-28f9-3c0f-8af0-95c1efff75f8",
                                                "text": "Weißt du, wann die Stadtbahn hier eine neue Haltestelle bekommt?"
                                            },
                                            {
                                                "example_id": "705f5bd8-e6e8-4ab8-9b3b-4615d56e64b7",
                                                "sense_id": "359963c5-28f9-3c0f-8af0-95c1efff75f8",
                                                "text": "„Am nächsten Montag aber wird die elektrische Stadtbahn eröffnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63578a38-5282-3c53-a49e-7a5557983611",
                                        "entry_id": "b0c523cc-a6ab-37c5-9d32-cdf875e31796",
                                        "glosses": [
                                            "Stadtbahnwagen, Stadtbahnzug; Fahrzeug des Verkehrsmittels [1]"
                                        ],
                                        "tags": [
                                            "umgangssprachlich,",
                                            "Kurzform"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a13bf19-6d24-47b6-9305-649fc4b0d9a6",
                                                "sense_id": "63578a38-5282-3c53-a49e-7a5557983611",
                                                "text": "Weißt du, wann die nächste Stadtbahn kommt?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b35ec668-2bd1-31de-bff7-25213bbb7979",
                                        "entry_id": "b0c523cc-a6ab-37c5-9d32-cdf875e31796",
                                        "glosses": [
                                            "Stadtbahnstrecke"
                                        ],
                                        "tags": [
                                            "Kurzform"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be3bc873-f94e-49ef-bea1-f85525203ad0",
                                                "sense_id": "b35ec668-2bd1-31de-bff7-25213bbb7979",
                                                "text": "In der Bahnhofstraße gibt es eine Stadtbahn."
                                            },
                                            {
                                                "example_id": "cd023e05-219e-4321-b234-1826d5a22367",
                                                "sense_id": "b35ec668-2bd1-31de-bff7-25213bbb7979",
                                                "text": "„Die Berliner Stadtbahn ist ein Viadukt auf zahllosen gemauerten Bögen von elf Kilometer Länge, sie durchstößt in viergleisiger Spur den Kern der Stadt von Osten nach Westen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "31d94d66-e486-37a1-be8a-8ded3c6f2cb4",
                                        "entry_id": "b0c523cc-a6ab-37c5-9d32-cdf875e31796",
                                        "glosses": [
                                            "innerstädtische Eisenbahnstrecke in Berlin (Fern-, Regional- und S-Bahn)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90e14589-5c9f-4f9a-a53b-4040af0069a3",
                                                "sense_id": "31d94d66-e486-37a1-be8a-8ded3c6f2cb4",
                                                "text": "Der Regionalexpress verkehrt über die Stadtbahn zum Hauptbahnhof."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
