{
    "word_family": [
        "annonce",
        "annonceur",
        "annonciateur",
        "annonciation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da3af77e-e2e6-3587-8162-cac3ce4723a9",
                    "sense_definition": "Faire connaître une nouvelle ou une information à une ou plusieurs personnes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur <w>annonce</w> la date du prochain examen aux élèves attentifs."
                        },
                        {
                            "text": "Elle a immédiatement téléphoné à ses parents pour leur <w>annoncer</w> une bonne nouvelle."
                        }
                    ],
                    "synonyms": [
                        "communiquer",
                        "dire",
                        "apprendre"
                    ],
                    "antonyms": [
                        "cacher",
                        "taire",
                        "dissimuler"
                    ],
                    "common_phrases": [
                        "annoncer une nouvelle",
                        "annoncer son départ"
                    ]
                },
                {
                    "sense_id": "50b72e40-a0f6-3f96-9f79-f1f185b08163",
                    "sense_definition": "Donner à prévoir par ses premiers aspects ; promettre d'être.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "presage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le temps pour ce week-end s'<w>annonce</w> particulièrement clément et ensoleillé."
                        },
                        {
                            "text": "La négociation s'<w>annonce</w> difficile entre les deux partenaires commerciaux."
                        }
                    ],
                    "synonyms": [
                        "promettre"
                    ],
                    "common_phrases": [
                        "s'annoncer bien",
                        "s'annoncer difficile"
                    ]
                },
                {
                    "sense_id": "f74819f9-8641-3703-84ef-86bae9a7f4c2",
                    "sense_definition": "Être le signe précurseur de quelque chose qui va arriver ; présager.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "presage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces gros nuages sombres à l'horizon <w>annoncent</w> un orage imminent."
                        },
                        {
                            "text": "Le chant matinal des oiseaux <w>annonce</w> enfin le retour du printemps."
                        }
                    ],
                    "synonyms": [
                        "présager",
                        "prédire"
                    ],
                    "common_phrases": [
                        "annoncer la couleur",
                        "annoncer la pluie"
                    ]
                },
                {
                    "sense_id": "2fab8179-0139-3f3b-b0db-36b361234d2d",
                    "sense_definition": "Faire connaître officiellement ou publiquement par une déclaration, une publication ou un média.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a décidé d'<w>annoncer</w> des mesures d'urgence lors du journal télévisé."
                        },
                        {
                            "text": "L'entreprise vient d'<w>annoncer</w> publiquement la création de plusieurs centaines d'emplois."
                        }
                    ],
                    "synonyms": [
                        "proclamer",
                        "publier",
                        "déclarer"
                    ],
                    "antonyms": [
                        "occulter"
                    ],
                    "common_phrases": [
                        "annoncer des mesures",
                        "annoncer un plan"
                    ]
                },
                {
                    "sense_id": "694c0b1a-6e48-3020-89fe-cc2b13736055",
                    "sense_definition": "Déclarer son identité ou faire savoir son arrivée quelque part.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas de vous <w>annoncer</w> à l'accueil dès votre entrée dans le bâtiment."
                        },
                        {
                            "text": "Le visiteur s'est <w>annoncé</w> à la réception avant de monter dans les étages."
                        }
                    ],
                    "synonyms": [
                        "se présenter"
                    ],
                    "common_phrases": [
                        "s'annoncer à l'accueil",
                        "s'annoncer à la réception"
                    ]
                }
            ]
        }
    ]
}