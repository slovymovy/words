                    },
                    {
                        "translation_id": "51684049-d936-4b2c-be99-9e6a15f3c707",
                        "source_entry_id": "28407a61-1296-3b4f-9473-6e90b2677120",
                        "source_sense_id": "75e74dad-afd2-3c30-a307-082f458c8ed2",
