                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccdeea74-49b8-4bc7-8b43-64b6a038c0e5",
                        "source_entry_id": "38548a72-00f2-327f-b1fd-32b124174a4b",
                        "source_sense_id": "60bc4f4f-c692-328b-84ad-26e202eaea47",
                        "source_sense_description": "groot bos",
                        "target_lang_word": "Wald",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "950912fc-9d51-32a0-bd2b-b7b2c2639c1b",
                                        "entry_id": "de9b0eb9-fa21-30ac-adfa-6615941391ea",
                                        "glosses": [
                                            "größere von Bäumen dicht bewachsene Fläche"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "381e2c21-6521-4b92-a60c-b7bc917b439a",
                                                "sense_id": "950912fc-9d51-32a0-bd2b-b7b2c2639c1b",
                                                "text": "Ich gehe gern im Wald spazieren."
                                            },
                                            {
                                                "example_id": "b0e780b4-6256-432a-989a-ccadaf8a94e6",
                                                "sense_id": "950912fc-9d51-32a0-bd2b-b7b2c2639c1b",
                                                "text": "„Neue Wälder liefern mehr Holz.“"
                                            },
                                            {
                                                "example_id": "1f660fdd-e6b2-4cbc-80de-0c6761f5ce44",
                                                "sense_id": "950912fc-9d51-32a0-bd2b-b7b2c2639c1b",
                                                "text": "„Aufgrund sich ändernder klimatischer Bedingungen machen tropische Wälder Buschformationen Platz und diese wiederum Wüsten.“"
                                            },
                                            {
                                                "example_id": "8e4aef80-9da0-42f6-b426-279df5c6684d",
                                                "sense_id": "950912fc-9d51-32a0-bd2b-b7b2c2639c1b",
                                                "text": "„Im Oligozän wichen die tropischen Wälder in die niederen Breiten zurück und machten grasbewachsenen Ebenen mit einzelnen Bäumen und Sträuchern Platz (Savanne).“"
                                            },
                                            {
                                                "example_id": "4ca86998-abbd-449d-9a74-1be7167ce331",
                                                "sense_id": "950912fc-9d51-32a0-bd2b-b7b2c2639c1b",
                                                "text": "„Das Wild des Waldes hatte ihnen zur Nahrung gedient, die gefrorene Erde zur Lagerstätte, ihre Wolldecken zu Betten.“"
                                            },
                                            {
                                                "example_id": "4eb12fdc-1f09-47ee-8710-ed85f928d6cf",
                                                "sense_id": "950912fc-9d51-32a0-bd2b-b7b2c2639c1b",
                                                "text": "„Die Tiere fallen über Obstplantagen, Weinberge, Wälder, Grünanlagen und Gärten her und fressen bei mehr als 300 Pflanzenarten alles kahl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1203450f-0e62-3329-a844-00d58f8825a9",
                                        "entry_id": "de9b0eb9-fa21-30ac-adfa-6615941391ea",
                                        "glosses": [
                                            "kreisfreier ungerichteter Graph"
                                        ],
                                        "tags": [
                                            "Graphentheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "450eb45d-7fa6-4e66-a75b-468f6d4cd4c8",
                                                "sense_id": "1203450f-0e62-3329-a844-00d58f8825a9",
                                                "text": "In der Graphentheorie kann ein Wald nur einen einzigen Baum (und sogar keinen Baum) haben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3352fa4c-ef1f-3d96-8e5c-cb589a17dd7c",
                                        "entry_id": "11a16c38-660c-3fe0-89ee-26aab0b59f3e",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c2bdb3e-8e20-4360-b83c-1b1aa206d239",
                                                "sense_id": "3352fa4c-ef1f-3d96-8e5c-cb589a17dd7c",
                                                "text": "Herr Wald ist Experte für Rechtsfragen."
                                            },
                                            {
                                                "example_id": "ebc71de2-0f99-4312-991d-8f271c82c443",
                                                "sense_id": "3352fa4c-ef1f-3d96-8e5c-cb589a17dd7c",
                                                "text": "Frau Wald arbeitet nachts in der Notaufnahme."
                                            },
                                            {
                                                "example_id": "98e72373-2a49-487a-995f-864cad347a89",
                                                "sense_id": "3352fa4c-ef1f-3d96-8e5c-cb589a17dd7c",
                                                "text": "Bei den Walds ist der Vorgarten mit exotischen Gewächsen bepflanzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f90ccc1-38f7-4281-b6d0-1903222e3937",
                        "source_entry_id": "38548a72-00f2-327f-b1fd-32b124174a4b",
                        "source_sense_id": "60bc4f4f-c692-328b-84ad-26e202eaea47",
                        "source_sense_description": "groot bos",
                        "target_lang_word": "forest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b341c061-7d7a-3f30-8b15-62943ee5f7b4",
                                        "entry_id": "929c106d-5a29-38db-8ab9-0b827e78973d",
                                        "glosses": [
                                            "To cover an area with trees."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83dd6ce8-408b-45b1-8b9e-29423fb19bdb",
                                                "sense_id": "b341c061-7d7a-3f30-8b15-62943ee5f7b4",
                                                "text": "From the view-point of national economy professor Fehér communicates to us most interesting facts, which he has established in an important question now of actuality : in the subject of foresting the Great Hungarian Plains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51da6f03-d50e-3464-b9a1-cf71da917cc5",
                                        "entry_id": "c0bebbe0-abf3-3264-9070-4103f4d2fe4e",
                                        "glosses": [
                                            "A dense uncultivated tract of trees and undergrowth, larger than woods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9c9a6f8-b204-4f8c-aab2-e9c71e5ad34e",
                                                "sense_id": "51da6f03-d50e-3464-b9a1-cf71da917cc5",
                                                "text": "Who after Archimagoes fowle defeat / Led her away into a foreſt wilde, / And turning wrathfull fyre to luſtfull heat, / With beaſtly ſin though her to haue defilde, / And made the vaſſal of his pleaſures vilde."
                                            },
                                            {
                                                "example_id": "f48aeb95-6b6a-4142-b13f-68821283def1",
                                                "sense_id": "51da6f03-d50e-3464-b9a1-cf71da917cc5",
                                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia. The cheapest way to clear logged woodland is to burn it, producing an acrid cloud of foul white smoke that, carried by the wind, can cover hundreds, or even thousands, of square miles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e13e10dd-c481-3b9c-b898-a103539e8178",
                                        "entry_id": "c0bebbe0-abf3-3264-9070-4103f4d2fe4e",
                                        "glosses": [
                                            "Any dense collection or amount."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "391c7bc7-ca18-4887-b79d-01f30ae88e02",
                                                "sense_id": "e13e10dd-c481-3b9c-b898-a103539e8178",
                                                "text": "a forest of criticism"
                                            },
                                            {
                                                "example_id": "8029be0c-862f-4545-ab69-df4d93599114",
                                                "sense_id": "e13e10dd-c481-3b9c-b898-a103539e8178",
                                                "text": "Squealing and still propelled by the kick, the calf scrabbled through the forest of legs and into the open."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf598e4a-8764-3d4d-9c87-cfe88e38a9af",
                                        "entry_id": "c0bebbe0-abf3-3264-9070-4103f4d2fe4e",
                                        "glosses": [
                                            "A defined area of land set aside in England as royal hunting ground or for other privileged use; all such areas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7877f65-5289-405a-acf7-13fe7f336d87",
                                                "sense_id": "bf598e4a-8764-3d4d-9c87-cfe88e38a9af",
                                                "text": "Throughout the 1500s, the populace roiled over a constellation of grievances of which the forest emerged as a key focal point. The popular late Middle Ages fictional character Robin Hood, dressed in green to symbolize the forest, dodged fines for forest offenses and stole from the rich to give to the poor. But his appeal was painfully real and embodied the struggle over wood."
                                            },
                                            {
                                                "example_id": "9e4e17e9-a044-4e4f-bb32-0756a024cf0e",
                                                "sense_id": "bf598e4a-8764-3d4d-9c87-cfe88e38a9af",
                                                "text": "[…] in places such as the Forest of Bowland there is hardly a tree in sight and much of the area is a vast tract of almost barren gritstone hills and peat moorland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28a45a81-6e77-302f-a4bd-398e909b22a7",
                                        "entry_id": "c0bebbe0-abf3-3264-9070-4103f4d2fe4e",
                                        "glosses": [
                                            "A graph with no cycles; i.e., a graph made up of trees."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf6eebaa-24bd-49ed-8bff-c9876493af12",
                                                "sense_id": "28a45a81-6e77-302f-a4bd-398e909b22a7",
                                                "text": "Let H be a traversal of an undirected graph G = (X, U). For given H, the set U can be split into set of tree edges from the forest G_H and the set of inverse edges that do not belong to this forest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31b704ee-6c91-3122-a985-8e88ab087c00",
                                        "entry_id": "c0bebbe0-abf3-3264-9070-4103f4d2fe4e",
                                        "glosses": [
                                            "A group of domains that are managed as a unit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ced2fd7-d320-4f3a-b1f3-09a14babe49b",
                                                "sense_id": "31b704ee-6c91-3122-a985-8e88ab087c00",
                                                "text": "Forests are considered the security boundary in Active Directory; by this we mean that if you need to definitively restrict access to a resource within a particular domain so that administrators from other domains do not have any access to it whatsoever, you need to implement a separate forest instead of using an additional domain within the current forest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba9ed954-cb11-30c2-9a25-11f8bcdf4116",
                                        "entry_id": "c0bebbe0-abf3-3264-9070-4103f4d2fe4e",
                                        "glosses": [
                                            "The color forest green."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35ffcdc8-ffbe-4e0f-8321-eb8d9ecc90e1",
                        "source_entry_id": "38548a72-00f2-327f-b1fd-32b124174a4b",
                        "source_sense_id": "60bc4f4f-c692-328b-84ad-26e202eaea47",
                        "source_sense_description": "groot bos",
                        "target_lang_word": "forêt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forêt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bfecc14-3c9a-363f-9057-e3ff64e6410b",
                                        "entry_id": "8176f981-37fd-34ab-8e4b-5aaa23fa82d9",
                                        "glosses": [
                                            "Vaste terrain couvert de bois, de nombreux arbres proches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58723de0-f21b-4c6e-b335-22fa7ca3d3b7",
                                                "sense_id": "2bfecc14-3c9a-363f-9057-e3ff64e6410b",
                                                "text": "J’ai tout de même obtenu un itinéraire plus païen et moins sublime : la forêt de Fontainebleau."
                                            },
                                            {
                                                "example_id": "f699ee26-f895-400c-a9d9-bb2cd9007dc0",
                                                "sense_id": "2bfecc14-3c9a-363f-9057-e3ff64e6410b",
                                                "text": "L’influence des forêts sur le climat ne peut être mise en doute, et il est bien prouvé que depuis deux ou trois siècles le régime météorologique de la France a subi de très grandes variations dues au déboisement."
                                            },
                                            {
                                                "example_id": "549849e9-fa48-45e9-8b0a-0a09b2d12417",
                                                "sense_id": "2bfecc14-3c9a-363f-9057-e3ff64e6410b",
                                                "text": "[…], on y trouve des muriers, des amandiers et, surtout, des dattiers, qui forment une véritable forêt de 10 à 12 kilomètres de longueur, au nord et à l’est de Marrakech."
                                            },
                                            {
                                                "example_id": "44412e58-338c-43c3-8904-570ce0de46bc",
                                                "sense_id": "2bfecc14-3c9a-363f-9057-e3ff64e6410b",
                                                "text": "Or il se trouve que très fréquemment de nombreux arbres sont les uns à côté des autres. Ils peuvent être d’espèces différentes, chacun luttant avec le voisin pour la lumière ; l’ensemble forme un groupement homogène appelé forêt."
                                            },
                                            {
                                                "example_id": "dea515ad-6615-44a8-9ee7-3528430c68e2",
                                                "sense_id": "2bfecc14-3c9a-363f-9057-e3ff64e6410b",
                                                "text": "La grande forêt des Ardennes est une des plus chargée de mystères. Dans sa partie orientale, elle couvre un plateau accidenté coupé de vallées et de ravins profonds."
                                            },
                                            {
                                                "example_id": "3712c6bf-5664-4fc6-9a91-ae92c21c3492",
                                                "sense_id": "2bfecc14-3c9a-363f-9057-e3ff64e6410b",
                                                "text": "On peut dire que les forêts précèdent les peuples et que les déserts les suivent."
                                            },
                                            {
                                                "example_id": "9e7b3dfc-6f0b-42ef-9826-2af45ca13371",
                                                "sense_id": "2bfecc14-3c9a-363f-9057-e3ff64e6410b",
                                                "text": "Les forêts néerlandaises sont toujours balisées, les enfants ne risquent pas de se perdre très longtemps», assure l'instituteur. «Ça n'a rien à voir avec les forêts françaises, ajoute Océane (...), qui a grandi dans les reliefs escarpés du Vercors."
                                            },
                                            {
                                                "example_id": "4cf925fd-7054-42cb-8655-935cfb3f77e7",
                                                "sense_id": "2bfecc14-3c9a-363f-9057-e3ff64e6410b",
                                                "text": "La peur est liée à la forêt, pas aux plantes. Ce sentiment est très ancien, il remonte à la civilisation romaine. Pour les Romains, la forêt était le lieu de « l’étranger » : c’est dans la forêt que se cachaient les barbares. D’ailleurs, le mot français « forêt » vient du latin foris, qui signifie « à l’extérieur »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1d1f6cd-b3e9-30fa-9118-9dbd2997d5fb",
                                        "entry_id": "8176f981-37fd-34ab-8e4b-5aaa23fa82d9",
                                        "glosses": [
                                            "Grande quantité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b10e2965-acd7-46b6-9d31-2440cf5fd59f",
                                                "sense_id": "a1d1f6cd-b3e9-30fa-9118-9dbd2997d5fb",
                                                "text": "Aussi son existence n’est-elle qu’une forêt de gaffes."
                                            },
                                            {
                                                "example_id": "5e8e08c0-98e1-4918-8718-543dacf8952a",
                                                "sense_id": "a1d1f6cd-b3e9-30fa-9118-9dbd2997d5fb",
                                                "text": "Lorsque les hommes de la Constituante se réunirent pour la première fois, ils se trouvèrent en face d’une forêt de taxes, qui avaient poussé au hasard sur le sol de France…"
                                            },
                                            {
                                                "example_id": "d7820548-3846-4d8e-84d8-20a82d38d02f",
                                                "sense_id": "a1d1f6cd-b3e9-30fa-9118-9dbd2997d5fb",
                                                "text": "Il y a encore un an, ce Syrien de 28 ans était du côté des indésirables. Qu’il semble, pourtant, loin le temps où ce professeur d’anglais tournait comme un derviche dans cette forêt de baraquements à la recherche d’un moyen pour rejoindre l’Angleterre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff69cddb-f96c-3cbc-b804-9809b5b95fbe",
                                        "entry_id": "8176f981-37fd-34ab-8e4b-5aaa23fa82d9",
                                        "glosses": [
                                            "Amas de choses longues et menues."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11e1b460-d123-47f3-b702-8ae6c8eae163",
                                                "sense_id": "ff69cddb-f96c-3cbc-b804-9809b5b95fbe",
                                                "text": "De dards, de javelots une forêt pressée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f00fe8b-04c1-36d8-9392-b63811f3ef14",
                                        "entry_id": "8176f981-37fd-34ab-8e4b-5aaa23fa82d9",
                                        "glosses": [
                                            "Grande quantité de pièces de bois qui forment le comble de quelque vaste édifice."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84cc4f85-b72f-4094-aeea-e2fb452e7b5e",
                                                "sense_id": "0f00fe8b-04c1-36d8-9392-b63811f3ef14",
                                                "text": "Commencée par le roi Robert II le Pieux, terminée en 1145, [la cathédrale de Chartres] fut restaurée par saint Louis même, qui fit achever la charpente, nommée poétiquement la forêt."
                                            },
                                            {
                                                "example_id": "11661006-5b06-4dc4-8b0e-9135f3472b91",
                                                "sense_id": "0f00fe8b-04c1-36d8-9392-b63811f3ef14",
                                                "text": "Enfin, le 4 juin 1836, un formidable incendie, […], éclate. Il persiste pendant onze heures et ruine toute la charpente, la forêt entière de la toiture ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bec0a80c-360a-310d-8f90-e8cfc921cedc",
                                        "entry_id": "8176f981-37fd-34ab-8e4b-5aaa23fa82d9",
                                        "glosses": [
                                            "Type de graphe composé de plusieurs arbres."
                                        ],
                                        "tags": [
                                            "Théorie des graphes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c6f3b1-c557-4134-80f9-b302f591dedd",
                                                "sense_id": "bec0a80c-360a-310d-8f90-e8cfc921cedc",
                                                "text": "Toute forêt finie Γ est peut être plongée dans un plan et son dessin ne possède qu’une seule face."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
