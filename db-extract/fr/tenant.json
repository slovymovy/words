                        "entry_id": "50335a71-e481-32e4-9434-8b67bbc15dce",
                        "glosses": [
                            "Chose qui se tient d’une manière continue, spécialement en parlant d’un terrain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "867a379c-e29a-413f-a458-a2184294529e",
                                "sense_id": "4157e43a-9dc9-3476-930c-a7a565c53f36",
                                "text": "Il a tant d’hectares de bois, de vignes tout d’un tenant. - Il a cinq hectares de terres labourables d’un seul tenant."
                            }
                        ]
                    },
                    {
                        "sense_id": "40cf4c9c-235f-36a5-9bef-6acd6174b6de",
                        "entry_id": "50335a71-e481-32e4-9434-8b67bbc15dce",
                        "glosses": [
                            "Chose qui se tient d’une manière continue, spécialement en parlant d’un terrain.",
                            "Terrains qui touchent une propriété sur ses grands côtés, contrairement aux aboutissants, qui sont les terrains qui touchent ses petits côtés."
                        ],
                        "tags": [
