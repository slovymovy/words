                        "examples": [
                            {
                                "example_id": "27287a84-6905-4a87-80c0-f947ce2f4a3b",
                                "sense_id": "b1a5c7e2-b99c-3311-bb81-883a153dcbf8",
                                "text": "Ook de kleurstelling is dit jaar iets anders bij Sauber. De renstal bouwde een speciale blauw-witte jubileumeditie met gouden in plaats van gele accenten, want het team rijdt dit jaar voor het 25ste seizoen in de Formule 1. De Zweed Marcus Ericsson en de Duitser Pascal Wehrlein gaan dit jaar in de jubileumauto van Sauber rijden."
                            },
                            {
                                "example_id": "c9dbf367-6c10-4c06-a451-7a5dc0909b2e",
                                "sense_id": "b1a5c7e2-b99c-3311-bb81-883a153dcbf8",
                                "text": "Het team waar Max Verstappen z’n eerste stappen in de Formule 1 zette, kreeg luid applaus in Barcelona. Bij de ‘launch’ op het circuit bleek dat het uiterlijk van de auto op de schop is gegaan. De rode stier is verschoten van kleur en de nieuwe blauw-zilver-rode kleurstelling oogt een stuk agressiever. Journalisten en fans zijn lovend: velen vinden de Toro Rosso de mooiste auto van het veld."
                            }
                        ]
                    }
