                    {
                        "sense_id": "1962311d-73c9-3e07-b815-46ea9937c3e5",
                        "entry_id": "2c780d48-9b5b-32b4-ba5f-783ab6b9214f",
                        "glosses": [
                            "An African American with light skin with red undertones."
                        ],
                        "tags": [
                            "Louisiana",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "dc9ceb2f-b13d-4142-a7dd-561784a64369",
                                "sense_id": "1962311d-73c9-3e07-b815-46ea9937c3e5",
                                "text": "Redbones are commonly supposed to represent a fusion of the Indian, Negro, and white races […]"
                            },
                            {
                                "example_id": "7bedcd81-5084-4a0a-addd-6839f7d1adc0",
                                "sense_id": "1962311d-73c9-3e07-b815-46ea9937c3e5",
                                "text": "The store attracted countless colorful characters, including Native Americans, wild-cowboy Texans, Chinese laborers, and “redbones,” the offspring of African Americans and Native Americans."
                            },
                            {
                                "example_id": "2678499c-915d-4bbc-881d-67e2afc90ffb",
                                "sense_id": "1962311d-73c9-3e07-b815-46ea9937c3e5",
                                "text": "I can joke about being a redbone, and I am that. But most folks don't make no distinction between a redbone and a colored man, unless it's to their benefit."
                            }
                        ]
                    }
                ],
