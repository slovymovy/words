                ],
                "senses": [
                    {
                        "sense_id": "8fada692-2e7d-39fc-9a28-774e377d389a",
                        "entry_id": "df922066-9e42-34b1-935b-de529d58ff31",
                        "glosses": [
                            "Blech mit Bestandteilen aus Zinn oder mit selbigem überzogen (jedoch oft Zinkblech gemeint)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d042dc8a-439b-4ce0-9c20-631c442354c1",
                                "sense_id": "8fada692-2e7d-39fc-9a28-774e377d389a",
                                "text": "„Hauptattraktion des Pariser Punk-Shops ‚Survival‘ im Hallenviertel ist ein angeschnallter toter Pilot auf einem aus Zinnblech zusammengelöteten Schleudersitz.“"
                            },
                            {
                                "example_id": "61171e27-567f-4b20-892a-17c4ecec33e6",
                                "sense_id": "8fada692-2e7d-39fc-9a28-774e377d389a",
                                "text": "„Die Feuerwehrleute hatten die Dachhaut aus Zinnblech mit Sägen geöffnet, um mit Wasser und Schaum den Brand zu ersticken.“"
                            },
                            {
                                "example_id": "e2c17c64-6f12-4991-8832-59b301767309",
                                "sense_id": "8fada692-2e7d-39fc-9a28-774e377d389a",
                                "text": "„Seit Jahrhunderten wird reines Zinnblech großflächig zur Herstellung als Orgelmetall im Sichtbereich verwendet.“"
                            },
                            {
                                "example_id": "a345cdac-a202-4ebe-b449-38532d4e238d",
                                "sense_id": "8fada692-2e7d-39fc-9a28-774e377d389a",
                                "text": "„Klais ist 48 Jahre alt, er hat vier Kinder großgezogen und Dutzende Orgeln gebaut. Aus Fichtenholz und Schafsleder hat er Blasebälge gezimmert, aus Zinnblech Pfeifen gebogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
