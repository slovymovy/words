                        "entry_id": "e54736f3-43ba-33b4-93c0-c89e9dc6e57e",
                        "glosses": [
                            "zentrale, wissenschaftliche Büchersammlung eines Staates, die die gesamte Literatur des Landes sammelt und archiviert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e237dd44-7b35-4da8-954b-4063387393d7",
                                "sense_id": "62be473b-5277-333d-b529-b2abdcf45930",
                                "text": "Die Deutsche Nationalbibliothek sitzt in Leipzig und Frankfurt am Main."
                            },
                            {
                                "example_id": "9fbdf913-cede-4e0b-8401-5339f82d4bcd",
                                "sense_id": "62be473b-5277-333d-b529-b2abdcf45930",
                                "text": "„So machten wir uns auf den Weg in die British Library, die größte Nationalbibliothek der Welt.“"
                            }
                        ],
