                                        "sense_id": "cf3f7c9e-b3d5-3cc8-80c4-5e21e4a11929",
                                        "entry_id": "51aada2e-0950-305d-8899-e35d84fee39b",
                                        "glosses": [
                                            "A species of swan, Cygnus cygnus, of the taxonomic family Anatidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7299cc41-fc91-4aec-bc4c-18446be348f4",
                                                "sense_id": "cf3f7c9e-b3d5-3cc8-80c4-5e21e4a11929",
                                                "text": "The thought of life with him filled her with exultation. She could leap up, like the whooper swan, spread her silver wings, and shout her song of rapture and of defiance, like a trumpet."
                                            },
                                            {
                                                "example_id": "a2e7b554-74bd-460a-a90d-46bd8fd1b741",
                                                "sense_id": "cf3f7c9e-b3d5-3cc8-80c4-5e21e4a11929",
                                                "text": "By mid-morning they are back with huge catches: birds with their necks twisted, slung from poles row upon row by their feet, or crammed alive into wooden cages, screaming with outrage, trampling each other, with sometimes a great silent whooper swan crouched in their midst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
