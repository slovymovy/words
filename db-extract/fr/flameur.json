                                        "entry_id": "2cd6e67c-71a4-3ade-b06e-cdab398c993c",
                                        "glosses": [
                                            "A very flamboyant (\\\"flaming\\\"), effeminate gay male."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77044ef8-a177-4f73-91a1-5f7a5a5c53cc",
                                                "sense_id": "259cd260-5e85-397f-82c1-317290ed5ec7",
                                                "text": "The thinking is Ralston's gay—lots of us Fifth Squadders think he's gay. Me, I think he is, and it don't bother me any. You's queer, you's queer. So he's a flamer—big deal. Or maybe he's a switch-hitter, a bisexual. Who knows?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "364e0b82-8287-37fe-bf96-04ac0853c3ea",
                                        "entry_id": "2cd6e67c-71a4-3ade-b06e-cdab398c993c",
                                        "glosses": [
                                            "One who flames, or posts vitriolic criticism."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "234c5179-cf9b-4803-90ad-eb2480fc5417",
                                                "sense_id": "364e0b82-8287-37fe-bf96-04ac0853c3ea",
                                                "text": "Send a note to the flamer. Tell him that his message was inappropriate. Request that he refrain from posting anything like it again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63470f0-689a-3380-9e0d-07631faf7580",
                                        "entry_id": "2cd6e67c-71a4-3ade-b06e-cdab398c993c",
                                        "glosses": [
                                            "A fireball."
