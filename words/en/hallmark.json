{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "607d973e-99c1-3a94-9675-126d95b91c24",
                    "sense_definition": "A distinguishing characteristic or feature of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "characteristic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Creativity is the <w>hallmark</w> of a great artist.",
                            "target_lang_translations": {
                                "ru": "Творчество — это <w>признак</w> великого художника."
                            }
                        },
                        {
                            "text": "The <w>hallmark</w> of his leadership style is clear communication.",
                            "target_lang_translations": {
                                "ru": "Отличительная <w>черта</w> его стиля руководства — четкая коммуникация."
                            }
                        }
                    ],
                    "synonyms": [
                        "feature",
                        "trait",
                        "signature"
                    ],
                    "common_phrases": [
                        "true hallmark",
                        "distinctive hallmark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличительная черта или характерная особенность чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "при́знак",
                                "target_lang_sense_clarification": "характерная особенность, по которой можно узнать или определить что-либо"
                            },
                            {
                                "target_lang_word": "отличи́тельная черта́",
                                "target_lang_sense_clarification": "специфическая особенность, выделяющая объект из ряда других"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fe7135f-180b-346e-bde8-9ad2e4e5db3b",
                    "sense_definition": "An official mark stamped on precious metals to certify their purity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ring had a clear <w>hallmark</w> indicating it was made of solid gold.",
                            "target_lang_translations": {
                                "ru": "На кольце было четкое <w>клеймо</w>, указывающее на то, что оно сделано из чистого золота."
                            }
                        },
                        {
                            "text": "Always check for a <w>hallmark</w> when buying expensive silver jewelry.",
                            "target_lang_translations": {
                                "ru": "Всегда проверяйте <w>пробу</w> при покупке дорогих серебряных украшений."
                            }
                        }
                    ],
                    "synonyms": [
                        "stamp",
                        "assay"
                    ],
                    "common_phrases": [
                        "silver hallmark",
                        "official hallmark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное клеймо, проставляемое на изделиях из драгоценных металлов для подтверждения их пробы и качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "про́ба",
                                "target_lang_sense_clarification": "клеймо на изделиях из драгоценных металлов, указывающее на содержание чистого металла"
                            },
                            {
                                "target_lang_word": "клеймо́",
                                "target_lang_sense_clarification": "официальный оттиск, подтверждающий подлинность или качество изделия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a621ad29-f788-3ba3-965f-476682c03baf",
                    "sense_definition": "To stamp an item with an official mark to certify its quality or purity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jeweler will <w>hallmark</w> the bracelet to prove it is genuine silver.",
                            "target_lang_translations": {
                                "ru": "Ювелир <w>заклеймит</w> браслет, чтобы доказать, что это настоящее серебро."
                            }
                        },
                        {
                            "text": "The antique spoon was <w>hallmarked</w> by the local assay office.",
                            "target_lang_translations": {
                                "ru": "На антикварной ложке было поставлено <w>клеймо</w> местной пробирной палаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "stamp",
                        "certify"
                    ],
                    "common_phrases": [
                        "properly hallmarked"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставить официальное клеймо на изделие для подтверждения его качества или чистоты металла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клейми́ть",
                                "target_lang_sense_clarification": "ставить клеймо на изделие"
                            },
                            {
                                "target_lang_word": "пробирова́ть",
                                "target_lang_sense_clarification": "определять пробу металла и ставить соответствующее клеймо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2b5e47c4-00fa-3c26-ac1f-d0a1b9b3a3e0",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The researcher <w>Hallmark</w> published a new study on linguistics.",
                            "target_lang_translations": {
                                "ru": "Исследователь <w>Холлмарк</w> опубликовал новое исследование по лингвистике."
                            }
                        },
                        {
                            "text": "Mr. <w>Hallmark</w> is visiting the office today.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Холлмарк</w> сегодня посещает офис."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Холлмарк",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c08a9ee5-34ef-3dd6-b535-13f6f606b79c",
                    "sense_definition": "A well-known company that produces greeting cards.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "She bought a beautiful card from <w>Hallmark</w> for her mother.",
                            "target_lang_translations": {
                                "ru": "Она купила маме красивую открытку от <w>Hallmark</w>."
                            }
                        },
                        {
                            "text": "The store carries a wide selection of <w>Hallmark</w> products.",
                            "target_lang_translations": {
                                "ru": "В магазине представлен широкий выбор продукции <w>Hallmark</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Hallmark card"
                    ],
                    "target_lang_definitions": {
                        "ru": "Известная компания, производящая поздравительные открытки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Hallmark",
                                "target_lang_sense_clarification": "название бренда поздравительных открыток"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}