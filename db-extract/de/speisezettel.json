                "senses": [
                    {
                        "sense_id": "964939e3-b77b-3d7b-9d0c-2307e188e41c",
                        "entry_id": "7344a194-ea46-39ea-9c07-132bdeeabe8d",
                        "glosses": [
                            "Liste für geplante Speisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0da1e8eb-40db-4269-8e82-af0df326070e",
                                "sense_id": "964939e3-b77b-3d7b-9d0c-2307e188e41c",
                                "text": "„Der übliche Speisezettel einer Berliner Familie aus der Unter- und der unteren Mittelschicht, also von mindestens zwei Dritteln der Bevölkerung, bestand in diesem Winter zum Beispiel aus Kohlrübensuppe, gebratenem Kohlrübenschnitzel und gesüßtem Kohlrübenkuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28e41171-e3e3-41e4-89ae-dc655547fd92",
                        "source_entry_id": "7344a194-ea46-39ea-9c07-132bdeeabe8d",
                        "source_sense_id": "964939e3-b77b-3d7b-9d0c-2307e188e41c",
