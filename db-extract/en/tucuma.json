                        ],
                        "examples": [
                            {
                                "example_id": "6032c15a-ec0b-4a61-b059-77b0ab827f15",
                                "sense_id": "b60c5aa3-7e01-342a-97d6-8825e0c85bb0",
                                "text": "His [Vinicius Cantuária’s] songs, written in Portuguese (some are composed with Mr. [Arto] Lindsay and Caetano Veloso, and all are translated into English), are as typically internal and love-fixated as the best bossa nova, but rich with allusions to Brazilian food, music and geography. (A Tucuma is a rare Amazonian fruit.)"
                            },
                            {
                                "example_id": "71f67e5b-9328-40c9-bc8b-f565c3ec9d6e",
                                "sense_id": "b60c5aa3-7e01-342a-97d6-8825e0c85bb0",
                                "text": "There are always seasonal treats to be gathered from our land: mangoes, oranges, guavas, mandarins, nuts, and the palm fruits tucuma and acai."
                            },
                            {
                                "example_id": "90f5eb14-ac70-4275-8777-d93fee70703c",
                                "sense_id": "b60c5aa3-7e01-342a-97d6-8825e0c85bb0",
                                "text": "After letting my hair air dry, I loved how the cupuacu, tucuma and Brazil nut oil came together to create a silky soft finish, with my ends feeling as if they had been freshly cut."
                            }
                        ]
                    }
