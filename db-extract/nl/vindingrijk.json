                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2618047-2072-4e47-a77a-7f1726b044ea",
                        "source_entry_id": "da670634-859a-33a0-a588-7bda4574eb69",
                        "source_sense_id": "2401c8f4-3dfe-3f02-ade9-f8f6cd27d14f",
                        "target_lang_word": "findig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "findig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f25112e-141e-3de7-80d7-cba5596fb502",
                                        "entry_id": "da3e65f5-164a-39de-8689-1267a805cd7f",
                                        "glosses": [
                                            "mit guten Ideen, wie man eine schwierige Situation meistern kann, und schlau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8d5f69-ab34-4461-9536-e3c364c3a033",
                                                "sense_id": "5f25112e-141e-3de7-80d7-cba5596fb502",
                                                "text": "Er war sehr findig, wenn es ums Schreiben ging."
                                            },
                                            {
                                                "example_id": "ace77a5f-d76b-47e8-81c1-bca657ddd341",
                                                "sense_id": "5f25112e-141e-3de7-80d7-cba5596fb502",
                                                "text": "„Jetzt wurde Martins von findigen Nutzern als Fälscher entlarvt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7974b3f-3be9-43ad-ba15-3255c6283c53",
                        "source_entry_id": "da670634-859a-33a0-a588-7bda4574eb69",
                        "source_sense_id": "2401c8f4-3dfe-3f02-ade9-f8f6cd27d14f",
                        "target_lang_word": "erfindungsreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erfindungsreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58baa7a8-412b-3e08-b41f-b6ebc2f16f21",
                                        "entry_id": "0a60c9c6-6b07-332c-83bf-7bbb9f17329b",
                                        "glosses": [
                                            "viele Ideen zu Lösungen von Problemen habend; reich an Erfindungsgabe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d16fb13-f47f-4ea1-94ca-6ba18e7638e5",
                                                "sense_id": "58baa7a8-412b-3e08-b41f-b6ebc2f16f21",
                                                "text": "[Tourismus in Hamburg:] „[…] sie sind erfindungsreiche Werber, die wissen, wie man Gäste neugierig macht - auf \"grüne\" Ausflüge, Shopping-Touren oder die Erkundung von Stadtteilen, in denen sich allerlei Grünes und Nachhaltiges verbirgt.“"
                                            },
                                            {
                                                "example_id": "9c35f300-b4ea-4620-93c4-f9663ab0ba3c",
                                                "sense_id": "58baa7a8-412b-3e08-b41f-b6ebc2f16f21",
                                                "text": "„Tintoretto galt als schneller, produktiver Maler, provokant und erfindungsreich. Er lockte seine Kunden nicht nur mit seinem Talent, sondern auch mit Sonderangeboten und listigen Tricks.“"
                                            },
                                            {
                                                "example_id": "993c2987-1678-4e25-843d-5d3369d39843",
                                                "sense_id": "58baa7a8-412b-3e08-b41f-b6ebc2f16f21",
                                                "text": "„Auf zwei CDs […] zeigen das französische Pulcinella Orchestra und die Cellistin Ophelié Gaillard auf Originalinstrumenten, wie erfindungsreich und originell Boccherini komponierte […].“"
                                            },
                                            {
                                                "example_id": "3c346de5-ff0b-41a4-99d4-729532ef73aa",
                                                "sense_id": "58baa7a8-412b-3e08-b41f-b6ebc2f16f21",
                                                "text": "„[…] Wer im Haushalt Verpackungsmüll vermeiden will, der muss erfindungsreich sein - und vieles, das andere einfach eingeschweißt kaufen, selbst herstellen.“"
                                            },
                                            {
                                                "example_id": "79eebeb8-c589-4f3f-a4e4-4696fa3a67e0",
                                                "sense_id": "58baa7a8-412b-3e08-b41f-b6ebc2f16f21",
                                                "text": "[Folter:] „»Die Menschen sind ziemlich erfindungsreich, was das Quälen angeht, aber irgendwie bleiben die Methoden auch über die Jahrhunderte ähnlich«, sagt Barbara Hohl, die für die Menschenrechtsorganisation Amnesty International in Berlin einen \"Folter-Shop\" eingerichtet hat.“"
                                            },
                                            {
                                                "example_id": "8bd0f76d-3762-4d4c-b18d-e342050d2c8a",
                                                "sense_id": "58baa7a8-412b-3e08-b41f-b6ebc2f16f21",
                                                "text": "[DDR:] „Der Mangel wurde zur ungeliebten Gewohnheit, er wurde von den Bürger bespöttelt […] oder erfindungsreich überwunden. […] die DDR-Bürger [waren] sehr erfindungsreich, wenn es darum ging, gegen Widerstände langfristig eigene Interessen wahrzunehmen.“"
                                            },
                                            {
                                                "example_id": "3e048621-2085-43a7-a3c5-ce4a23336524",
                                                "sense_id": "58baa7a8-412b-3e08-b41f-b6ebc2f16f21",
                                                "text": "„»Weil die Hackerangriffe immer erfindungsreicher werden, hören die Präventionsmaßnahmen nie auf«, sagt Burkhard Even, Abteilungsleiter Spionageabwehr und Geheimschutz beim Verfassungsschutz.“"
                                            },
                                            {
                                                "example_id": "34da0c33-c3f6-4003-87e2-69b2153c306b",
                                                "sense_id": "58baa7a8-412b-3e08-b41f-b6ebc2f16f21",
                                                "text": "„Die Nazis haben Egidius aus dem Schuldienst entlassen, und so lebt er von Honigverkauf und den Pflanzen in seinem Garten. Außerdem engagiert er sich als erfindungsreicher Fluchthelfer. In umgebauten Bienenkästen transportiert er Juden an die belgische Grenze, auf dass sie in dem besetzten Land untertauchen können.“"
                                            },
                                            {
                                                "example_id": "08006879-fa4a-4d6d-8bde-df6c0a0f9697",
                                                "sense_id": "58baa7a8-412b-3e08-b41f-b6ebc2f16f21",
                                                "text": "„Laurent Charbonniers Naturdokumentarfilm zeigt, wie erfindungsreich Tiere bei der Balz um Partner werben.“"
                                            },
                                            {
                                                "example_id": "d9ba6ce8-659c-4c19-821f-e71dd890df58",
                                                "sense_id": "58baa7a8-412b-3e08-b41f-b6ebc2f16f21",
                                                "text": "„Dabei ist der Spatz ein wahrer Überlebenskünstler, enorm anpassungsfähig und erfindungsreich, dennoch hat sich in den vergangenen 20 bis 30 Jahren der Bestand bundesweit fast halbiert.“"
                                            },
                                            {
                                                "example_id": "1f9f8c2f-a5f5-461a-8fc5-15b696201e68",
                                                "sense_id": "58baa7a8-412b-3e08-b41f-b6ebc2f16f21",
                                                "text": "„Wenn Antibiotika gegen Bakterien eingesetzt werden, finden diese oft einen Weg, sich dagegen zu schützen. Sie sind erfindungsreich: Sie stellen ihren Stoffwechsel um oder aktivieren verschiedene Schutzmechanismen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a79bc2e-197c-458d-9f77-86fbf13f62fa",
                        "source_entry_id": "da670634-859a-33a0-a588-7bda4574eb69",
                        "source_sense_id": "2401c8f4-3dfe-3f02-ade9-f8f6cd27d14f",
                        "target_lang_word": "erfinderisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erfinderisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a414359-7c8a-392e-9837-3079cd970507",
                                        "entry_id": "edbae109-ec7f-3182-bd3d-647bd51fee7d",
                                        "glosses": [
                                            "so, dass man viele Einfälle, neue Ideen und Lösungen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb0fa441-9d73-4b9a-a4e0-32c47af44fd4",
                                                "sense_id": "9a414359-7c8a-392e-9837-3079cd970507",
                                                "text": "„Neu und erfinderisch muss die Erfindung also hinsichtlich technischer Merkmale sein.“"
                                            },
                                            {
                                                "example_id": "06ab8073-ded7-4ced-aa33-b527ef6692c2",
                                                "sense_id": "9a414359-7c8a-392e-9837-3079cd970507",
                                                "text": "„Doch wir sind durchaus in der Lage, erfinderisch zu sein, wenn wir mit einem Problem konfrontiert sind, das so drängend ist, dass wir es lösen müssen.“"
                                            },
                                            {
                                                "example_id": "7a84912d-15ea-49dc-9295-3616d0b4a423",
                                                "sense_id": "9a414359-7c8a-392e-9837-3079cd970507",
                                                "text": "„Wer glaubt, es gebe in Deutschland keine erfinderischen Geister mehr, sollte die Halle 16 auf der Cebit besuchen.“"
                                            },
                                            {
                                                "example_id": "1cbd4db2-5295-47a7-80dd-72741709a6b2",
                                                "sense_id": "9a414359-7c8a-392e-9837-3079cd970507",
                                                "text": "„Er sieht in ihm einen Künstler, der wie wenige Vorbild ist: des erfinderischen und erfindenden Ausprobierens in allen denkbaren künstlerischen Bereichen.“"
                                            },
                                            {
                                                "example_id": "1076f346-c87b-4529-a121-0d9a7ae4be9f",
                                                "sense_id": "9a414359-7c8a-392e-9837-3079cd970507",
                                                "text": "„Die Bücher avancierten recht schnell von erfinderischen Kinderbüchern zu reißenden Romanen, deren Spannung sich ins Unerträgliche steigern konnte, nur um dann in einer ungeahnten Pointe zu münden, die oft unglaublich schien, aber von ihrer schöpferischen Kraft getragen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
