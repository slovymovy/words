                        ],
                        "form": "der Fragilität"
                    },
                    {
                        "form_id": "005984bf-5493-4b4b-bde9-021c6188c10d",
                        "entry_id": "23a050f8-ab7b-3990-94d8-4fa6b64da23c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Fragilität"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af26971d-6620-3172-93eb-0d3bd5c2e560",
                        "entry_id": "23a050f8-ab7b-3990-94d8-4fa6b64da23c",
                        "glosses": [
                            "nicht stabile, sondern leicht verletzbare Konstitution/Verfassung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a898887-9b02-4c81-a638-a385c5a0985e",
                                "sense_id": "af26971d-6620-3172-93eb-0d3bd5c2e560",
                                "text": "„Die Messung staatlicher Fragilität scheint auf den ersten Blick eine rein akademische Übung zu sein.“"
                            },
                            {
                                "example_id": "963a313a-54f8-43ef-8e9f-04a317529b60",
                                "sense_id": "af26971d-6620-3172-93eb-0d3bd5c2e560",
                                "text": "„Dieser widmet sich der Analyse zu Fragilität und Instabilität in Afrika.“"
                            },
                            {
                                "example_id": "29a40739-cad1-4b9b-b67c-3839db8adc70",
                                "sense_id": "af26971d-6620-3172-93eb-0d3bd5c2e560",
                                "text": "„Agnes spürte die Fragilität ihrer Mutter sehr genau.“"
                            },
                            {
                                "example_id": "e73a3412-8cd6-4a3d-8de8-3865ddb55f18",
                                "sense_id": "af26971d-6620-3172-93eb-0d3bd5c2e560",
                                "text": "„Der Anblick der blauen Atmosphäre wurde nicht, wie wenige Jahre zuvor, vor allem in seiner Schönheit bestaunt, sondern – vor dem Hintergrund des entdeckten Ozonlochs und der sich abzeichnenden Klimaerwärmung – als ein Zeichen der Fragilität genommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30ef6e10-61af-4090-bed1-e4addead5874",
                        "source_entry_id": "23a050f8-ab7b-3990-94d8-4fa6b64da23c",
                        "source_sense_id": "af26971d-6620-3172-93eb-0d3bd5c2e560",
                        "source_sense_description": "nicht stabile, sondern leicht verletzbare Konstitution/Verfassung",
                        "target_lang_word": "fragility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fragility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9569b587-833f-3fbb-ac26-90bf749fcffa",
                                        "entry_id": "8e53a764-5b05-3143-bb5b-2a288c4d93e7",
                                        "glosses": [
                                            "The condition or quality of being fragile; brittleness; frangibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a354caf-7e85-4ad1-b327-9d52fedb7e44",
                                                "sense_id": "9569b587-833f-3fbb-ac26-90bf749fcffa",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: […]; perhaps to moralise on the oneness or fragility of the planet, or to see humanity for the small and circumscribed thing that it is; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad0bd644-8d73-38ce-b203-efe3942b02ee",
                                        "entry_id": "8e53a764-5b05-3143-bb5b-2a288c4d93e7",
                                        "glosses": [
                                            "Weakness; feebleness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92e2bbfe-809e-3ac7-adb9-3345914b03d3",
                                        "entry_id": "8e53a764-5b05-3143-bb5b-2a288c4d93e7",
                                        "glosses": [
                                            "Liability to error and sin; frailty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb25afe4-81e0-4d81-8634-69aced99439d",
                        "source_entry_id": "23a050f8-ab7b-3990-94d8-4fa6b64da23c",
                        "source_sense_id": "af26971d-6620-3172-93eb-0d3bd5c2e560",
                        "source_sense_description": "nicht stabile, sondern leicht verletzbare Konstitution/Verfassung",
                        "target_lang_word": "fragilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fragilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a3dac63-97ce-33f5-922a-b37a3d745182",
                                        "entry_id": "2e6f44ea-f448-349d-b7d4-609e55004af1",
                                        "glosses": [
                                            "Disposition à être cassé, être brisé facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ee7d99e-2388-46ef-b275-62c51471d12b",
                                                "sense_id": "0a3dac63-97ce-33f5-922a-b37a3d745182",
                                                "text": "Cette fragilité est-elle propre aux os des cancéreux, ou tient-elle au développement des cancers multiples dans le système osseux ?"
                                            },
                                            {
                                                "example_id": "942ae39e-261d-4772-83d2-1b63d6ae6bad",
                                                "sense_id": "0a3dac63-97ce-33f5-922a-b37a3d745182",
                                                "text": "La fragilité des aciers carburés trempés, comparable à celle du verre, semble, elle aussi, une propriété caractéristique du carbure trempant du fer β plutôt que du fer β lui—même."
                                            },
                                            {
                                                "example_id": "62ccf187-cc3f-4dea-a30d-1da33f5b3814",
                                                "sense_id": "0a3dac63-97ce-33f5-922a-b37a3d745182",
                                                "text": "La connaissance de ce fait que l'inflammation aiguë augmente la fragilité ou frangibilité des tissus est féconde eu applications pratiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "402600f7-3a0c-392f-a535-626c03b2495f",
                                        "entry_id": "2e6f44ea-f448-349d-b7d4-609e55004af1",
                                        "glosses": [
                                            "Propriété d'un matériau qui lors d'une contrainte ou d'un choc se fissure facilement ; dont la fissuration ne demande que peu d'énergie."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7545a1ae-c016-4ee3-ad6a-a3194cfdad36",
                                                "sense_id": "402600f7-3a0c-392f-a535-626c03b2495f",
                                                "text": "En physique l'inverse de la fragilité est la ténacité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16ccf3e0-34d1-3b6f-bf8c-130b10d2563b",
                                        "entry_id": "2e6f44ea-f448-349d-b7d4-609e55004af1",
                                        "glosses": [
                                            "Facilité à être détérioré."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4acb33b-d303-4ef8-ae09-afb4ccca9d38",
                                                "sense_id": "16ccf3e0-34d1-3b6f-bf8c-130b10d2563b",
                                                "text": "La fragilité des choses humaines."
                                            },
                                            {
                                                "example_id": "d4dc275e-d482-47f1-a600-74587602dcbb",
                                                "sense_id": "16ccf3e0-34d1-3b6f-bf8c-130b10d2563b",
                                                "text": "La fragilité de sa fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1908ce75-838d-3c5f-b526-6ec42c0246d7",
                                        "entry_id": "2e6f44ea-f448-349d-b7d4-609e55004af1",
                                        "glosses": [
                                            "Facilité à tomber en faute."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05282391-567d-4e93-8a62-afc213e83423",
                                                "sense_id": "1908ce75-838d-3c5f-b526-6ec42c0246d7",
                                                "text": "L'occasion prochaine se divise en occasion prochaine per se, et en occasion prochaine per accidens. La première est celle qui, vu la fragilité humaine, entraîne, pour tous les hommes, un danger probable de pécher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
