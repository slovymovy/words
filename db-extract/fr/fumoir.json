                        "target_lang_word": "курилка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "курилка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "18fe5572-0323-3cb6-a35d-858769b35feb",
                                        "entry_id": "59588f98-1ce2-3090-9c46-02002b31c531",
                                        "glosses": [
                                            "разг. место для курения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "301a54fa-a3e3-4999-bfd1-c425b2c819e0",
                                                "sense_id": "18fe5572-0323-3cb6-a35d-858769b35feb",
                                                "text": "Поболтать в курилке"
                                            },
                                            {
                                                "example_id": "9a32a944-6ab3-4160-9fa5-90514a9cf85a",
                                                "sense_id": "18fe5572-0323-3cb6-a35d-858769b35feb",
                                                "text": "Андрей слюнявил одну папиросу за другой, суетился так, будто ищет билет на через минуту отходящий поезд, и курилка, этот клуб любителей истины, сочувствовала ему, гонцы прочесали ряды читального зала и нашли свердловчанина, который и поведал ему об уральском самородке."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "курилка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "efda4510-a27d-3803-be00-96aae1bb333c",
                                        "entry_id": "6cdaeec8-ab73-3e13-a61f-f03dfef2f6ba",
                                        "glosses": [
                                            "разг., шутл. любитель курения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29fac49a-6d52-4f8b-90e6-a604dd56a696",
                                                "sense_id": "efda4510-a27d-3803-be00-96aae1bb333c",
                                                "text": "Ну ты и курилка!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02a13a1-7617-3b59-bd8d-c5859cf081d4",
                                        "entry_id": "6cdaeec8-ab73-3e13-a61f-f03dfef2f6ba",
                                        "glosses": [
                                            "разг. шутл. (в выражении «жив курилка») живой вопреки трудным условиям или мнению о гибели"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d46257f-0985-43ab-b8a9-0c1c2685d34e",
                                                "sense_id": "e02a13a1-7617-3b59-bd8d-c5859cf081d4",
                                                "text": "— Ба, — жив курилка! — засмеялся губернатор. — Господа, поглядите, наша городская голова идёт."
                                            },
                                            {
                                                "example_id": "41739c86-0f5d-44d7-b138-c9aa5959866a",
                                                "sense_id": "e02a13a1-7617-3b59-bd8d-c5859cf081d4",
                                                "text": "Фу! надоел Курилка журналист! Как загасить вонючую лучинку? Как уморить курилку моего? Дай мне совет. — Да… плюнуть на него."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
