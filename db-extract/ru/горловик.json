                "senses": [
                    {
                        "sense_id": "f51ac4b1-6c58-3945-aa73-1cffad060012",
                        "entry_id": "1466a031-94c4-3653-b9f2-f4fde5b18995",
                        "glosses": [
                            "разг. врач, специализирующийся на болезнях горла"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be9fcc53-4fd8-4452-bf60-c55915d82935",
                                "sense_id": "f51ac4b1-6c58-3945-aa73-1cffad060012",
                                "text": "По понедельникам нас всех обязательно водят к врачу, к оториноларингологу, проще ― к горловику, вернее, к горповичке, ну, словом, к нашей Марии Леонтьевне."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0f5058c-614d-3de8-a2a2-90d9f2ef55e0",
                        "entry_id": "1466a031-94c4-3653-b9f2-f4fde5b18995",
                        "glosses": [
                            "разг. тот, кто страдает от болезни горла"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9a8638b-0e8c-41c1-bbec-0c334dd1bb46",
                                "sense_id": "e0f5058c-614d-3de8-a2a2-90d9f2ef55e0",
                                "text": "И полная тишина: больные горловики способны говорить только шёпотом."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5956593-f39f-3aa7-b5f2-e8f36368a78a",
                        "entry_id": "1466a031-94c4-3653-b9f2-f4fde5b18995",
                        "glosses": [
                            "разг. певец, владеющий техникой горлового пения"
                        ],
