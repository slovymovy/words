                        "cross_references": [
                            {
                                "target_word": "rustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f65910b-92f2-3c4e-9d27-2da44a013505",
                                        "entry_id": "1be8a3ea-6018-3138-a654-6c581f929481",
                                        "glosses": [
                                            "A soft crackling sound similar to the movement of dry leaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af3ee78-5880-4a76-a3d1-e7b51f4ef070",
                                                "sense_id": "2f65910b-92f2-3c4e-9d27-2da44a013505",
                                                "text": "He heard the silken rustle of a dressing-gown being drawn on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eeeac5c-9345-320e-9f70-819a801bb7bb",
                                        "entry_id": "1be8a3ea-6018-3138-a654-6c581f929481",
                                        "glosses": [
                                            "A movement producing such a sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3aff0598-2450-3b38-8563-fd6fb5f7f225",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To move (something) with a soft crackling sound."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd03a0fb-4128-4447-8a6f-9488e2ff46f5",
                                                "sense_id": "3aff0598-2450-3b38-8563-fd6fb5f7f225",
                                                "text": "The next day at three o'clock we were again at the door, and the footmen as before; we heard the silk dress rustle, and the lady came down the steps and in an imperious voice, she said, \"York, you must put those horses' heads higher, they are not fit to be seen.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d5be6e-daf2-3f3f-978e-215ab7d7a817",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To make or obtain in a lively, energetic way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "982d36d9-73ef-4d3e-9abb-6dd2ce90d938",
                                                "sense_id": "c3d5be6e-daf2-3f3f-978e-215ab7d7a817",
                                                "text": "When at last the lumber was piled again in its rightful place, and the boxes of food had been returned to the shelter from which they had been stolen, the two friends rustled a meal, and then set off on horseback […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb0de50-dfb9-3308-9d43-ff3a9af9c952",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To steal (cattle or other livestock)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d669aea-fd9e-4e97-8f18-be4367a80b3a",
                        "source_entry_id": "227f89df-97bf-3049-978b-807cf7dc7be5",
                        "source_sense_id": "192fd00c-35a0-3fa7-89ea-c2adfa34cb63",
                        "target_lang_word": "sough",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9294e3cb-7c8c-3677-93b2-ac90bfab59fb",
                                        "entry_id": "3b736a0e-b44c-3378-948b-f4b9c6705419",
                                        "glosses": [
                                            "To make a soft rustling or murmuring sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "946bbfc9-89aa-45ae-b317-31a0664022d6",
                                                "sense_id": "9294e3cb-7c8c-3677-93b2-ac90bfab59fb",
                                                "text": "I lay awake for a while that evening, listening to the soughing of the wind high in the pines, realizing sadly that we must now return to civilization."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58883697-261d-3d89-ac11-04050f5be3ee",
                                        "entry_id": "693980f5-f38c-324f-9695-963d608e5f16",
                                        "glosses": [
                                            "A murmuring sound; rushing, rustling, or whistling sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c1f480a-ccb2-4f6f-8d76-30ddd2e19cee",
                                                "sense_id": "58883697-261d-3d89-ac11-04050f5be3ee",
                                                "text": "[...] Arthur; a fearful night it was: there was a sough in the air, a sound drawing nigh like that of a host marching:- — but you're looking pale and forwrought, man; is any thing ailing ye?"
                                            },
                                            {
                                                "example_id": "6f0b1582-f079-4be6-833e-8b8ef848ba4b",
                                                "sense_id": "58883697-261d-3d89-ac11-04050f5be3ee",
                                                "text": "The whispering leaves or solemn sough of the forest."
                                            },
                                            {
                                                "example_id": "ff7fb903-5f8d-4420-9979-ae4f7ce95c30",
                                                "sense_id": "58883697-261d-3d89-ac11-04050f5be3ee",
                                                "text": "Syenite hears the distant sough of waves rolling against rocks, somewhere below the slope on which they lie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75bb988c-39be-3728-9578-f13a383f157c",
                                        "entry_id": "693980f5-f38c-324f-9695-963d608e5f16",
                                        "glosses": [
                                            "A gentle breeze; a waft; a breath."
                                        ],
