                        "glosses": [
                            "Synonym of sell, now especially to sell through a vending machine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31df0ee5-730d-47dd-a78d-a01e559c0e58",
                                "sense_id": "6020f89e-5903-3cc9-ac0a-fc3da74889ed",
                                "text": "Amazon said over 20,000 small stores have signed on to its Local Shops program over five months to vend basics like household essentials and fresh flowers."
                            },
                            {
                                "example_id": "29721031-a7ae-492a-9c99-69d35ba21f6f",
                                "sense_id": "6020f89e-5903-3cc9-ac0a-fc3da74889ed",
                                "text": "Vending has been slow to change partly because the business for years could depend on what it called the four C's: cold drinks, candy, confections and cigarettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "d06f7045-c53d-32b5-864a-1751775e5a8e",
                        "entry_id": "0b4b6d52-b911-3d42-b119-60982a4ce99c",
                        "glosses": [
                            "To provide or export functionality, especially from an API."
                        ],
                        "tags": [
                            "transitive",
                            "uncommon"
                        ],
                        "examples": [
