                                    {
                                        "sense_id": "98d2caa3-95bd-3b66-a7dd-880d1282debd",
                                        "entry_id": "089cde21-9c51-3a77-b531-191e74c01a94",
                                        "glosses": [
                                            "Angehöriger einer radikalen islamischen Bewegung vornehmlich in Afghanistan und Pakistan"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42d0d88e-559f-3cee-b810-012f5b9da2bb",
                                        "entry_id": "089cde21-9c51-3a77-b531-191e74c01a94",
                                        "glosses": [
                                            "die Talibanbewegung/-organisation"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b9641c5-5d0e-4011-a36d-e43c02364ad9",
                                                "sense_id": "42d0d88e-559f-3cee-b810-012f5b9da2bb",
                                                "text": "„Ende Dezember 2012 richteten die Taliban nahe Peschawar 21 entführte Soldaten hin.“"
                                            },
                                            {
                                                "example_id": "19be1d01-b17f-402e-93ac-73cc9bde7142",
                                                "sense_id": "42d0d88e-559f-3cee-b810-012f5b9da2bb",
                                                "text": "„Auch der radikale Islamismus im Sinne der Salafisten, der Muslimbrüder und der Taliban ist eine durchschlagende Idee, die viele Menschen anzieht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "000df7e7-1af4-4fba-9bcd-ad5649de655d",
                        "source_entry_id": "f908906b-6ad0-37c5-95a8-c6e0fb2f73c4",
                        "source_sense_id": "e170a1bf-68af-30f5-85e7-340c68a826e5",
                        "target_lang_word": "Taliban",
