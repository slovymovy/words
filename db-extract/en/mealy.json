                "senses": [
                    {
                        "sense_id": "e8aab75a-a537-35f2-bdf8-8d4154c0236a",
                        "entry_id": "9d06dab8-561a-35a3-899e-78fdd9099e0b",
                        "glosses": [
                            "A canary of a pale yellow color."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae5e4483-870f-466f-b176-9592f2c69b40",
                                "sense_id": "e8aab75a-a537-35f2-bdf8-8d4154c0236a",
                                "text": "I know not, indeed, if the artist could give the beautiful orange which distinguish ^([sic]) the jonque, or the mellowness of tint that pervades the mealy."
                            },
                            {
                                "example_id": "29184abf-9988-486c-ab48-575145ec075f",
                                "sense_id": "e8aab75a-a537-35f2-bdf8-8d4154c0236a",
                                "text": "The clear Norwich canaries, as well as the evenly marked, the crested, the ticked, the green, and the unevenly marked, are each divided into two separate classes, i.e., jonques and mealies."
