                        "glosses": [
                            "To pass (back) again, especially in the opposite direction; to return."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4491f57f-5133-42bc-8ee6-91131df2cd59",
                                "sense_id": "948b3f9b-3c5e-3a4b-9671-740af468b904",
                                "text": "Isabell Queene of England, being to repasse from Zeland into her Kingdome with an armie, […] had utterly beene cast away, had she come unto the Port intended […]."
                            },
                            {
                                "example_id": "37298707-a93e-42b6-90b2-95d03a943646",
                                "sense_id": "948b3f9b-3c5e-3a4b-9671-740af468b904",
                                "text": "the grate of brass\nThrough which they thrust me, open stood the while, […]\nThe grate, as they departed to repass,\nWith horrid clangour fell, and the far sound\nOf their retiring steps in the dense gloom was drowned."
                            }
