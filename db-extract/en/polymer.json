                    {
                        "translation_id": "aba3a2e5-0b50-4cd8-8dea-c4d8d3571b1d",
                        "source_entry_id": "992820a9-7e16-3878-8d75-579462cf3f7b",
                        "source_sense_id": "4e5ad7d7-0f80-38d1-a490-15bcc53c36de",
                        "source_sense_description": "Polymer, Kunststoff",
                        "target_lang_word": "Polymer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polymer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e425d6d6-f9d9-3d9f-b5ff-54543c31cf51",
                                        "entry_id": "05bbb5c8-780a-3f9d-beb1-1bd50211af55",
                                        "glosses": [
                                            "chemischer Stoff, der aus Makromolekülen besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad9aa57-eb90-437a-b799-0a7947431f30",
                                                "sense_id": "e425d6d6-f9d9-3d9f-b5ff-54543c31cf51",
                                                "text": "„Bislang haben die Forscher mit zwei verschiedenen Arten von Polymeren experimentiert und deren Wechselwirkung mit der Pellikel untersucht.“"
                                            },
                                            {
                                                "example_id": "f94be82e-6066-4f89-90b3-4ec3383a56a4",
                                                "sense_id": "e425d6d6-f9d9-3d9f-b5ff-54543c31cf51",
                                                "text": "Die Mikrostruktur der Polymere ist durch Kettenmoleküle gekennzeichnet, dies fordert spezielle Herstellungsverfahren und bringt besondere Eigenschaften mit sich."
                                            },
                                            {
                                                "example_id": "e7b652c6-fdb5-46a3-90d1-2db75155a02c",
                                                "sense_id": "e425d6d6-f9d9-3d9f-b5ff-54543c31cf51",
                                                "text": "Ein Polymer kann aus gleichen Monomeren bestehen, es ist jedoch genauso möglich, dass die Bestandteile eine Anzahl von verschiedenen Monomeren sind."
                                            },
                                            {
                                                "example_id": "17fe44ab-6e36-4b1b-ba3a-15a52cd9ec8e",
                                                "sense_id": "e425d6d6-f9d9-3d9f-b5ff-54543c31cf51",
                                                "text": "„Seine Dissertation hatte Polymere zum Thema, womit er sich im Laufe seiner Promotion über vier Jahre beschäftigt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0e1c9bf-308c-4c51-8e67-8b48c986e278",
                        "source_entry_id": "992820a9-7e16-3878-8d75-579462cf3f7b",
                        "source_sense_id": "4e5ad7d7-0f80-38d1-a490-15bcc53c36de",
                        "source_sense_description": "Polymer, Kunststoff",
                        "target_lang_word": "Kunststoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kunststoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                        "entry_id": "2e0f5361-b37e-3495-a571-f8d0b215e2a3",
                                        "glosses": [
                                            "Bezeichnung für einen Festkörper, dessen Grundbestandteil synthetisch oder halbsynthetisch erzeugte Polymere mit organischen Gruppen sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d98936-4982-4f7d-9cd2-0b55907f2358",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Kunststoff ist alt. Fast 500 Jahre alt ist die älteste Anleitung zur Herstellung eines Kunststoffs auf Kaseinbasis.“"
                                            },
                                            {
                                                "example_id": "d106cdd5-91c2-4723-9d88-ea7af8847e2a",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Der erste richtige Kunststoff wurde 1870 von John Wesley Hyatt erfunden, als dieser auf der Suche nach einem Ersatzmaterial für die Herstellung von Billardkugeln war.“"
                                            },
                                            {
                                                "example_id": "73c285cb-5b30-4783-8d5c-9e58e7eeffda",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Die ersten Kunststoffe entstanden, als Mitte des 19. Jahrhunderts Rohstoffe wie Holz oder Metalle immer knapper und damit teurer wurden.“"
                                            },
                                            {
                                                "example_id": "a0f2b23a-1574-48b0-85dc-6b1d7418b68e",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Als Laufradwerkstoffe kommen neben den thermoplastischen Kunststoffen, in Abhängigkeit der Druckstufen sowie weitere verfahrenstechnische Parameter, diverse Sondermaterialien zur Anwendung (GfK, CfK, Stahl und Edelstahl).“"
                                            },
                                            {
                                                "example_id": "24a0dba9-dd94-425b-9732-90c1514028a0",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Seit nun über hundert Jahren wurden Gebrauchsgegenstände aus Kunststoff selbstverständlicher Bestandteil unseres Alltags.“"
                                            },
                                            {
                                                "example_id": "7d452ebe-35b0-4cfa-88d5-7df25f97e739",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Unser renommiertes Unternehmen stellt seit mehr als 25 Jahren Lüftungsformteile aus Kunststoff her.“"
                                            },
                                            {
                                                "example_id": "4b93ce85-99cd-40d9-9eae-4532af46f720",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Medizintechnikherstellern auf der Suche nach genau dem richtigen Werkstoff für ihre Anwendung steht nun eine weitere Option offen, da Bayer MaterialScience seine bereits umfangreiche Familie an medizinischen Kunststoffen erweitert hat.“"
                                            },
                                            {
                                                "example_id": "1892a3f7-b31b-4019-ba5d-f747b26d095a",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„In diesem Kapitel geht es um die Herstellung von Kunststoffen. Ganz allgemein entstehen Kunststoffe in sogenannten \"Polyreaktionen\", das sind Reaktionen, bei denen einzelne Moleküle, genannt \"Monomere\" (von griech. monos = einzeln und meros = Teilchen), zu \"Polymeren\" (griech. polys = viel) reagieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
