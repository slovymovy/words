                                        "examples": [
                                            {
                                                "example_id": "943283d9-8adc-4051-ad05-bdb3329d2666",
                                                "sense_id": "90c68fc5-2960-3ab3-a347-35b6e9d201e4",
                                                "text": "Účastníci zájezdu byli s kvalitou ubytování vesměs spokojeni, to už se ale nedá říct o stravě."
                                            },
                                            {
                                                "example_id": "e2ee9d37-65e5-4f08-b9fe-6b69a3d789a5",
                                                "sense_id": "90c68fc5-2960-3ab3-a347-35b6e9d201e4",
                                                "text": "Z důvodu finanční krize zaznamenali vloni obchodníci vesměs pokles obratu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34849831-7ad6-3deb-a4bc-30262a857148",
                                        "entry_id": "de27a19e-6ec9-3546-98c8-67c158c1ac96",
                                        "glosses": [
                                            "ve všech případech"
                                        ],
                                        "tags": [
                                            "odborně"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d86b6bd-d670-4c1b-8992-fa860d520959",
                                                "sense_id": "34849831-7ad6-3deb-a4bc-30262a857148",
                                                "text": "Přirozená, celá, reálná a racionální čísla jsou vesměs nekonečné množiny."
                                            }
                                        ]
                                    }
                                ]
