                    "frequency": "High",
                    "semantic_group_id": "volume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est recommandé de boire au moins un <w>litre</w> d'eau par jour pour rester en bonne santé."
                        },
                        {
                            "text": "Elle a acheté deux <w>litres</w> de lait frais à l'épicerie du coin."
                        }
                    ],
                    "synonyms": [
                        "décimètre cube"
                    ],
                    "common_phrases": [
                        "litre d'eau",
                        "demi-litre"
                    ]
                },
                {
                    "sense_id": "476be566-69ba-35bf-bc71-e1481676f19d",
                    "sense_definition": "Bouteille ou récipient ayant une contenance d'un litre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a rapporté un <w>litre</w> de vin de chez le caviste pour le dîner."
                        },
                        {
                            "text": "Pensez à déposer les <w>litres</w> vides dans le bac de recyclage du verre."
