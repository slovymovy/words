                "senses": [
                    {
                        "sense_id": "154107bc-6ae7-33f2-ac6c-9b3db0e267f4",
                        "entry_id": "c455aac6-e9bc-36cc-b01f-6adcb4ec0eff",
                        "glosses": [
                            "разг. быть любопытным, проявлять любопытство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b4a7b05-7067-4fd8-b11a-9e012eb89c11",
                                "sense_id": "154107bc-6ae7-33f2-ac6c-9b3db0e267f4",
                                "text": "– Ты ведь из столицы? – продолжала любопытствовать Лисса. – Вижу, точно впервые едешь в Бонт. Зачем?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "088e8ef0-a13e-4a6d-a92d-6ad19f7d376a",
                        "source_entry_id": "c455aac6-e9bc-36cc-b01f-6adcb4ec0eff",
                        "source_sense_id": "154107bc-6ae7-33f2-ac6c-9b3db0e267f4",
                        "target_lang_word": "pry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f4ac02f-50d5-304e-9a58-b5edd2489b2d",
                                        "entry_id": "a784e098-42b3-3a53-a538-032e236dce44",
                                        "glosses": [
                                            "To peer closely and curiously, especially at something closed or not public."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abdde0a7-75d5-438d-8c0c-4c5376960e3a",
                                                "sense_id": "3f4ac02f-50d5-304e-9a58-b5edd2489b2d",
                                                "text": "[W]omen haue eagles eyes, / To prie euen to the heart, and why not you?"
                                            },
                                            {
                                                "example_id": "bc54e42f-4db6-49e8-801d-0721cfa25ee9",
                                                "sense_id": "3f4ac02f-50d5-304e-9a58-b5edd2489b2d",
                                                "text": "[…] to elude, thus wrapt in miſt / Of midnight vapor glide obſcure, and prie / In every Buſh and brake, where hap may finde / The Serpent ſleeping, […]"
                                            },
                                            {
                                                "example_id": "b4777ae1-65bd-4513-83df-52991b6076e1",
                                                "sense_id": "3f4ac02f-50d5-304e-9a58-b5edd2489b2d",
                                                "text": "And choice of studious friends had he / Of Bolton's dear fraternity: / […] / [I]n their cells with him did pry / For other lore,—through strong desire / Searching the earth with chemic fire: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4e79fd1-4a19-34fc-8d90-4c66b65ad184",
                                        "entry_id": "a784e098-42b3-3a53-a538-032e236dce44",
                                        "glosses": [
                                            "To inquire into something that does not concern one; to be nosy; to snoop."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d904fa34-c6e0-418c-bccc-9423a1dd277e",
                                                "sense_id": "b4e79fd1-4a19-34fc-8d90-4c66b65ad184",
                                                "text": "Watch thou, and wake when others be aſleepe, / To prie into the ſecrets of the State, […]"
                                            },
                                            {
                                                "example_id": "5d6c08b8-d709-4fd6-9e15-2327517d5042",
                                                "sense_id": "b4e79fd1-4a19-34fc-8d90-4c66b65ad184",
                                                "text": "We literary hacks are shameless creatures. I believe there's no secret of the human heart into which we wouldn't pry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe7c8633-af13-3707-95d7-d730b0936ed5",
                                        "entry_id": "a784e098-42b3-3a53-a538-032e236dce44",
                                        "glosses": [
                                            "To peer at (something) closely; also, to look into (a matter, etc.) thoroughly."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdb51988-722f-40d9-8948-df628379d08c",
                                                "sense_id": "fe7c8633-af13-3707-95d7-d730b0936ed5",
