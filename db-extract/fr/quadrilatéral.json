                            {
                                "example_id": "cdce93c3-5010-4ddd-8d43-d7766def38d2",
                                "sense_id": "05c67de7-c246-3850-a3c1-a0f84c6548dc",
                                "text": "Tout à côté on distinguait l’enceinte quadrilatérale de la foire Saint-Germain, où est aujourd’hui le marché."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9fe5848-13c4-3163-9029-cd7ce62a5b63",
