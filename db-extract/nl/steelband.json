                        "examples": [
                            {
                                "example_id": "6faa9ed1-b2bd-44c3-aed5-e2e7768a829e",
                                "sense_id": "59348980-42d0-3ead-997c-f355fd45dba3",
                                "text": "Hij vertelt over de steelbands en hun oorlogen, waar veel geweld bij kwam kijken, maar waar eigenlijk niet echt veel dodelijke slachtoffers vielen."
                            },
                            {
                                "example_id": "0b0b5729-3193-4c69-b31c-e9fd755dac63",
                                "sense_id": "59348980-42d0-3ead-997c-f355fd45dba3",
                                "text": "De 10.000 bezoeker konden de cellen en verhoorkamers bekijken. Kinderen mochten op de foto, wat een zodanig succes was, dat er een lange wachtrij ontstond. De Politie Steelband zorgde voor de muzikale omlijsting op deze onverwachte zonovergoten dag."
                            }
                        ]
                    }
