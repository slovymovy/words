                                "sense_id": "9f5857ca-8105-3dec-84ee-6f2ff1008b51",
                                "text": "I received an illogical reply and that left me standing there feeling confused."
                            },
                            {
                                "example_id": "d0bc1a27-a7af-4d04-b919-d6965bc6e992",
                                "sense_id": "9f5857ca-8105-3dec-84ee-6f2ff1008b51",
                                "text": "Your highly emotional reaction is most illogical."
                            },
                            {
                                "example_id": "bc73b786-cb8d-438c-8594-447f0b31b659",
                                "sense_id": "9f5857ca-8105-3dec-84ee-6f2ff1008b51",
                                "text": "'Cause I was feeling so illogical, d-d-d-igital"
                            }
                        ]
