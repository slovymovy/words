                    {
                        "translation_id": "20900014-ed53-465b-9024-d2dc30afb15e",
                        "source_entry_id": "7c84ca6d-1ffc-3b1f-b542-dd520329a788",
                        "source_sense_description": "capital of the Netherlands",
                        "target_lang_word": "Amsterdam",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amsterdam",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9ae74f33-a718-3572-a850-2c08837427b1",
                                        "entry_id": "e7785acf-22b0-359c-8423-57f05e7e3fcb",
                                        "glosses": [
                                            "de hoofdstad van Nederland, gelegen in de provincie Noord-Holland"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7ce2182-a503-4ebb-854f-7c79c8f5d8f6",
                                                "sense_id": "9ae74f33-a718-3572-a850-2c08837427b1",
                                                "text": "Amsterdam is beroemd om zijn grachten."
                                            },
                                            {
                                                "example_id": "618cd07a-d835-49b1-8e5c-fc5cf7539aa1",
                                                "sense_id": "9ae74f33-a718-3572-a850-2c08837427b1",
                                                "text": "Amsterdam heeft een eeuwenlange geschiedenis als internationaal handelscentrum en is altijd een plek geweest waar mensen van over de hele wereld samenkomen."
                                            },
                                            {
                                                "example_id": "1fe2d812-2cc8-4ab3-8305-465b9fa27efa",
                                                "sense_id": "9ae74f33-a718-3572-a850-2c08837427b1",
                                                "text": "Tentamenweek of niet, studenten, promovendi en andere medewerkers van de afdeling Aardwetenschappen aan de Vrije Universiteit in Amsterdam voeren vandaag actie. Ze proberen het voorgenomen besluit om hun studie en banen weg te bezuinigen tegen te houden. En niet alleen zij maken zich zorgen: ook het werkveld luidt de noodklok. Een petitie tegen het plan is al meer dan 8000 keer getekend."
                                            },
                                            {
                                                "example_id": "54acfd08-b3b9-434e-8449-0cc2d1b2a2d6",
                                                "sense_id": "9ae74f33-a718-3572-a850-2c08837427b1",
                                                "text": "Criminoloog Wouter Buikhuisen is afgelopen dinsdag op 91-jarige leeftijd overleden. Buikhuisen is onder meer bekend van de affaire Buikhuisen. Ook muntte hij de naam provo voor de Provobeweging in Amsterdam, een protestbeweging die in de jaren 60 werd opgericht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cb3d611-904f-49b8-ae4f-8ed8ea4e6327",
                        "source_entry_id": "7c84ca6d-1ffc-3b1f-b542-dd520329a788",
                        "source_sense_description": "capital of the Netherlands",
                        "target_lang_word": "Amsterdam",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amsterdam",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80945a9e-2baf-358c-b113-6a3a8f9d0f13",
                                        "entry_id": "83184ca5-10b5-35de-8500-f70afb26ba06",
                                        "glosses": [
                                            "Ville et commune des Pays-Bas, dont c’est la capitale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74e8d60a-14b4-4cce-b066-985361b2b643",
                                                "sense_id": "80945a9e-2baf-358c-b113-6a3a8f9d0f13",
                                                "text": "Je sais que Nick n’est qu’un tapin, mais peut-être que je vais quand même aller à Amsterdam pour le retrouver."
                                            },
                                            {
                                                "example_id": "f71fe17d-906f-418c-8ddb-d62c4750a7d4",
                                                "sense_id": "80945a9e-2baf-358c-b113-6a3a8f9d0f13",
                                                "text": "À chaque escale à Amsterdam, je filais au marché aux fleurs du Singel ou chez un vieil horticulteur de Schoorl pour lui rapporter des oignons de jonquilles, de jacinthes, de muscaris, d’amaryllis."
                                            },
                                            {
                                                "example_id": "5c192a4e-669c-487b-92f2-b7a0e8290074",
                                                "sense_id": "80945a9e-2baf-358c-b113-6a3a8f9d0f13",
                                                "text": "Dans le port d’Amsterdam\nY a des marins qui chantent\nLes rêves qui les hantent\nAu large d’Amsterdam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3da1c30-db7b-3d16-869c-6a7bbbf22bfc",
                                        "entry_id": "83184ca5-10b5-35de-8500-f70afb26ba06",
                                        "glosses": [
                                            "Ville des États-Unis, dans l’État de New York."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a8da8b4-5260-3bd8-8f63-bacebf7489e7",
                                        "entry_id": "83184ca5-10b5-35de-8500-f70afb26ba06",
                                        "glosses": [
                                            "Nom d’une île du sud de l’océan Indien (île Amsterdam, dans le district des Îles Saint-Paul et Amsterdam)."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "683cc7ac-428d-4e20-ab9a-30106ae17318",
                                                "sense_id": "4a8da8b4-5260-3bd8-8f63-bacebf7489e7",
                                                "text": "Après une exploitation intensive depuis la fin des années 1700, l’otarie à fourrure subantarctique était supposée éteinte sur l’île Amsterdam, dans les terres australes françaises."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
