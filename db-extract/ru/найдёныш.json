                    }
                ],
                "senses": [
                    {
                        "sense_id": "79cda9fe-6829-3853-b65e-f943bdf17c6c",
                        "entry_id": "ec6637fa-2026-341e-ace9-80c8967e0258",
                        "glosses": [
                            "разг. найденный ребёнок, оставленный родителями, подброшенный другим людям"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b485670e-ab18-4692-bb40-7f86129dde50",
                                "sense_id": "79cda9fe-6829-3853-b65e-f943bdf17c6c",
                                "text": "Найденыша обыкновенно несли в удельный приказ, а там сдавали на воспитанье желающему принять ребенка."
                            },
                            {
                                "example_id": "693646a8-5105-4b14-8d01-0919116f29e0",
                                "sense_id": "79cda9fe-6829-3853-b65e-f943bdf17c6c",
                                "text": "И долго еще после того Ваня навещал своего найдёныша, которому дали имя Алексей."
                            },
                            {
                                "example_id": "cc1f3c8d-7296-4fb0-8522-d165f8eb4d64",
                                "sense_id": "79cda9fe-6829-3853-b65e-f943bdf17c6c",
                                "text": "За сердце ж дочери моей // Я заплачу тебе, злодей, // Тебе, найденыш без креста, // Презренный раб и сирота!.."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a8931d0-4758-35a7-ab7b-e6b33eab16ab",
                        "entry_id": "ec6637fa-2026-341e-ace9-80c8967e0258",
                        "glosses": [
                            "разг. найденный детёныш животного"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a13f69be-a4bb-41c6-8fc9-acfb3fe86b64",
                                "sense_id": "0a8931d0-4758-35a7-ab7b-e6b33eab16ab",
                                "text": "Через год несчастный найдёныш превратился в толстого, холёного, наглого манула, разгуливающего то по всей деревне, то по Васиному столу в кабинете."
                            },
                            {
                                "example_id": "99a792a8-f3a1-479b-9102-083c71aee41d",
                                "sense_id": "0a8931d0-4758-35a7-ab7b-e6b33eab16ab",
                                "text": "Каждому хотелось чем-то помочь найденышу, дочка-дошкольница просила хоть на минуточку дать ей подержать зверька."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "323e4289-6fe1-4658-b624-13032ebb9b18",
                        "source_entry_id": "ec6637fa-2026-341e-ace9-80c8967e0258",
                        "source_sense_description": "найденный ребёнок, оставленный родителями, подброшенный другим людям",
                        "target_lang_word": "foundling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foundling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4fbf2ef-89ab-3557-a5b8-b206c6a455fc",
                                        "entry_id": "cfaa29fc-a168-3aa4-b6b1-9e93bfca5799",
                                        "glosses": [
                                            "An abandoned child, left by its parent(s), often a baby left at a convent or similar safe place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13aaac05-4e4b-4231-9184-5bef41b59ed3",
                                                "sense_id": "f4fbf2ef-89ab-3557-a5b8-b206c6a455fc",
                                                "text": "foundling hospital"
                                            },
                                            {
                                                "example_id": "06ce5bd2-8b38-4fb9-bcc0-55ace20d7608",
                                                "sense_id": "f4fbf2ef-89ab-3557-a5b8-b206c6a455fc",
                                                "text": "In foundling hospitals, and among the children brought up by parish charities, the mortality is still greater than among those of the common people."
                                            },
                                            {
                                                "example_id": "34c35c4b-b78a-4b9c-8250-4e23f4bb9bc4",
                                                "sense_id": "f4fbf2ef-89ab-3557-a5b8-b206c6a455fc",
                                                "text": "Moses was a foundling; Jesus Christ was born in a stable; and Mahomet was a mule driver."
                                            },
                                            {
                                                "example_id": "1fb6dd8e-0444-4c2f-a186-6e43a76394b1",
                                                "sense_id": "f4fbf2ef-89ab-3557-a5b8-b206c6a455fc",
                                                "text": "[Owl:] YOU HEARD THAT FREMOUNT IS REALLY A^([sic]) ANT LION, MR. CONGERSMAN?\n [Frog:] IT'S A SAD BLOW TO THE PARTY JUST AT A TIME WHEN US OWLS MUST STICK TOGETHER. WORST PART IS, MRS. WEEVIL SAYS HER SISTER-AN'-LAW FOUND THE CANDIDATE IN A BOX OF POPCORN.\n [Owl:] AIN'T IT WORSE TO BE A CANNIBAL THAN A FOUNDLING?\n [Frog:] WE CAN SAY HE'S CHANGED HIS HABITS! BUT A FAMILY TREE LOOKS BAD SPROUTIN' OUT OF POPCORN⋯"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
