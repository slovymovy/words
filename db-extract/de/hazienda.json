                                "target_senses": [
                                    {
                                        "sense_id": "4cb0fae1-a2e9-3a31-af2b-324f2bc2c031",
                                        "entry_id": "2e70cdeb-264c-3a94-ae5d-e1a4c1a07d6b",
                                        "glosses": [
                                            "A large homestead in a ranch or estate, usually in places where Colonial Spanish culture has had architectural influence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2a6f7c1-8ec8-4672-8cb4-d195dc12aab3",
                                                "sense_id": "4cb0fae1-a2e9-3a31-af2b-324f2bc2c031",
                                                "text": "The hot day was over, and the light failing rapidly, when Appleby, who had just finished comida, sat by a window of the hacienda San Cristoval with an English newspaper upon his knee."
                                            },
                                            {
                                                "example_id": "9056eafa-5ca0-4666-8831-29918b3c6213",
                                                "sense_id": "4cb0fae1-a2e9-3a31-af2b-324f2bc2c031",
                                                "text": "The writer Juan Rulfo, whose 1955 novel, “Pedro Páramo,” still stands as the central monument of modern Mexican literature, grew up in Jalisco and vividly depicted its arid, sun-blasted landscapes in his writing, while the architect Luis Barragán, who moved from Guadalajara to Mexico City in the 1930s, carried with him an appreciation for his home state’s cloisters, haciendas and humble country buildings, which he translated in his own work as austere, inscrutable volumes of stucco."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19684a26-6a10-4c92-bfd1-30af72bde67d",
                        "source_entry_id": "893faa91-d6e8-38c1-9aa6-3303bbb8ad4c",
