                "forms": [],
                "senses": [
                    {
                        "sense_id": "ad418be7-5f82-3613-98db-18af32af9dfc",
                        "entry_id": "34c0b349-722a-3463-a8b9-1f62212ef5c6",
                        "glosses": [
                            "прост. то же, что пока"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6e23f05-9300-4489-9f7d-bc1e252455f4",
                                "sense_id": "ad418be7-5f82-3613-98db-18af32af9dfc",
                                "text": "Покамест нас не погнали в класс, пойдём-ка да нарвём в саду себе каштанов"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09994fff-9a85-412e-9082-ba83f99a5cd5",
                        "source_entry_id": "34c0b349-722a-3463-a8b9-1f62212ef5c6",
                        "source_sense_id": "ad418be7-5f82-3613-98db-18af32af9dfc",
                        "target_lang_word": "for the present",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "for the present",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7603d0a7-59e7-3ed8-8836-faf427281817",
                                        "entry_id": "1911dde4-9302-348b-8400-1465dbdce01c",
