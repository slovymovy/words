                ],
                "senses": [
                    {
                        "sense_id": "fba58a0a-9123-3c27-9a93-946a9041116a",
                        "entry_id": "5dd95740-6980-38cb-863d-d604cc40da19",
                        "glosses": [
                            "(Historiographie) Celui, celle qui se consacre à l'étude du Moyen Âge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddfa2641-d255-4a48-a17b-e26d3f23b596",
                                "sense_id": "fba58a0a-9123-3c27-9a93-946a9041116a",
                                "text": "C’est le plus savant des médiévistes actuels."
                            },
                            {
                                "example_id": "f915a4e1-828c-41bc-bc51-fb90fb0d7f09",
                                "sense_id": "fba58a0a-9123-3c27-9a93-946a9041116a",
                                "text": "Pour le médiéviste, le mot d’ordre était pourtant simple : il ne s’agissait concrètement de rien d’autre que de faire une histoire de la raison réfléchissant sur la foi dans la théologie."
                            },
                            {
                                "example_id": "aa1e5dfe-35b3-4537-ad70-f5e600083060",
                                "sense_id": "fba58a0a-9123-3c27-9a93-946a9041116a",
                                "text": "Voilà ce que démontre scientifiquement un rapport historique commandé en 1988 par Jordi Pujol, l’antéprédecesseur de Puigdement, à cinq médiévistes barcelonais sur le « processus d’indépendance de la Catalogne »…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5b0e60c-c0fd-4f88-8717-17115bc62854",
                        "source_entry_id": "5dd95740-6980-38cb-863d-d604cc40da19",
                        "source_sense_id": "fba58a0a-9123-3c27-9a93-946a9041116a",
                        "target_lang_word": "Mediävist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mediävist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54d762a2-08c1-3243-a8c1-a54f529ba8df",
                                        "entry_id": "717565b6-d300-30c5-af5f-368d371a65ed",
                                        "glosses": [
                                            "Person, die wissenschaftlich in der Mediävistik, im Bereich der Erforschung des europäischen Mittelalters, tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3388759-5453-4d23-a9c6-15e8792e10a4",
                                                "sense_id": "54d762a2-08c1-3243-a8c1-a54f529ba8df",
                                                "text": "„Nun ist der universell gebildete Mediävist mit siebenundsiebzig Jahren in Berlin verstorben.“"
                                            },
                                            {
                                                "example_id": "902dd6d9-b8e4-4b73-b69a-15daa03abde7",
                                                "sense_id": "54d762a2-08c1-3243-a8c1-a54f529ba8df",
                                                "text": "„Als Kind meiner Zeit fühle ich mich auch als Mediävist großartig unterhalten – und wenn ich mit Studierenden darüber reflektiere, warum das so ist und welche Rolle das Mittelalter dabei spielt, wird es sogar aus kulturkritischer Perspektive spannend.“"
                                            },
                                            {
                                                "example_id": "b05675a1-8e14-4a73-a708-0c0574011e9e",
                                                "sense_id": "54d762a2-08c1-3243-a8c1-a54f529ba8df",
                                                "text": "„Ein Privatdozent begeisterte ihn für mittelhochdeutsche Lyrik und stellte die Weichen für seine akademische Laufbahn als Mediävist.“"
                                            },
                                            {
                                                "example_id": "e25d712e-bbb2-4ace-a0f1-ad7439bbfa72",
                                                "sense_id": "54d762a2-08c1-3243-a8c1-a54f529ba8df",
                                                "text": "„Im Gespräch erklärt der Mediävist, welchen Herausforderungen die DFG gegenübersteht, welche Rolle die Politik dabei spielt – und worüber er als Nächstes forschen wird.“"
                                            },
                                            {
                                                "example_id": "b43571a2-a303-409a-bc83-97151dfc9202",
                                                "sense_id": "54d762a2-08c1-3243-a8c1-a54f529ba8df",
                                                "text": "„Der Mediävist begreift den Kontinent als Kreuzungspunkt im Netzwerk globaler und interkultureller Beziehungen.“"
                                            },
                                            {
                                                "example_id": "708f5fde-8760-45c6-9a7f-eab97a69f28a",
                                                "sense_id": "54d762a2-08c1-3243-a8c1-a54f529ba8df",
                                                "text": "„Der Aachener Mediävist hatte zunächst ein Jurastudium aufgenommen, das immerhin den Zweck erfüllte, in den Veranstaltungen zum ‚Römischen Recht‘ und der ‚Rechtsgeschichte‘ sein historisches Interesse zu wecken.“"
                                            },
                                            {
                                                "example_id": "99958cec-9cd5-42bf-92dd-97b8012c004e",
                                                "sense_id": "54d762a2-08c1-3243-a8c1-a54f529ba8df",
                                                "text": "„Man sollte als Mediävist jedenfalls erstens schon genau wissen und sagen, was man unter Säkularisierung versteht, bevor man nach den Anfängen und Vorstufen dieses Phänomens im Mittelalter sucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
