                ],
                "senses": [
                    {
                        "sense_id": "2a02c8e7-91ac-3f93-83bc-e6ea3f6fb367",
                        "entry_id": "e8e6b6aa-86e4-338d-a8c7-e4e123609cc3",
                        "glosses": [
                            "нар.-разг., то же, что леший"
                        ],
                        "tags": [
                            "только в сочетаниях типа к ляду, какого ляда, на кой ляд"
                        ],
                        "examples": [
                            {
                                "example_id": "db739f53-2dd6-49be-8254-248435053a16",
                                "sense_id": "2a02c8e7-91ac-3f93-83bc-e6ea3f6fb367",
                                "text": "— На что мне теперь жизнь, на кой ляд моя забубённая головушка!.."
                            },
                            {
                                "example_id": "8c18cc4f-9844-4961-881c-ec03f35e81a8",
                                "sense_id": "2a02c8e7-91ac-3f93-83bc-e6ea3f6fb367",
                                "text": "Брусило вон о прошлом годе послал их к ляду, так вскорости и дом сгорел у Брусилы."
                            },
                            {
                                "example_id": "d9995441-566f-4d0a-b03a-e7b9778f47ad",
                                "sense_id": "2a02c8e7-91ac-3f93-83bc-e6ea3f6fb367",
                                "text": "— Так какого ж ляда ты тут сидишь и слушаешь всю эту хреновину, у тебя ж вечером спектакль."
                            },
                            {
                                "example_id": "d53a5426-9d23-4db0-9aca-b13d9d10cbd3",
                                "sense_id": "2a02c8e7-91ac-3f93-83bc-e6ea3f6fb367",
                                "text": "На кой ляд ему, удачливому предпринимателю, имеющему в посёлке пять магазинов, впрягаться в лямку чиновника?"
                            }
                        ]
                    }
                ],
