                        "source_sense_id": "a150d6ed-61f3-302c-b2ad-c312e082831f",
                        "target_lang_word": "hairline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hairline",
