    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b503439-8aef-3b39-a6c8-e61dcb2e6670",
                    "sense_definition": "Osoba lub rzecz stanowiąca pewne oparcie, niezawodną podporę oraz dająca poczucie bezpieczeństwa.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "podpora",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W trudnych chwilach rodzina zawsze była dla niego najważniejszą <w>ostoją</w> i źródłem spokoju.",
                            "target_lang_translations": {
                                "en": "In difficult times, his family was always his greatest <w>pillar of support</w> and a source of peace."
                            }
                        },
                        {
                            "text": "Stary profesor uchodził na uniwersytecie za prawdziwą <w>ostoję</w> tradycji akademickiej.",
                            "target_lang_translations": {
                                "en": "The old professor was considered at the university to be a true <w>bulwark</w> of academic tradition."
                            }
                        }
                    ],
                    "synonyms": [
                        "opoka",
                        "fundament",
                        "podpora"
                    ],
                    "common_phrases": [
                        "ostoja spokoju",
                        "ostoja ładu",
                        "być ostoją"
                    ],
                    "target_lang_definitions": {
                        "en": "A person or thing that provides dependable support, a pillar of strength, and a sense of security."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mainstay",
                                "target_lang_sense_clarification": "chief support"
                            },
                            {
                                "target_lang_word": "pillar",
                                "target_lang_sense_clarification": "reliable supporter or foundation"
                            },
                            {
                                "target_lang_word": "bulwark",
                                "target_lang_sense_clarification": "solid defense or support"
                            },
                            {
                                "target_lang_word": "prop",
                                "target_lang_sense_clarification": "support or backing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7995fb78-3d01-35fa-984d-76f770379081",
                    "sense_definition": "Obszar lub schronienie, w którym rzadkie zwierzęta lub rośliny znajdują dogodne warunki do przetrwania.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przyroda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dolina rzeki stanowi cenną <w>ostoję</w> wielu zagrożonych gatunków ptaków wodnych.",
                            "target_lang_translations": {
                                "en": "The river valley constitutes a valuable <w>sanctuary</w> for many endangered species of waterfowl."
                            }
                        },
                        {
                            "text": "W głębi pradawnego lasu utworzono specjalną <w>ostoję</w> dla żubrów.",
                            "target_lang_translations": {
                                "en": "In the depths of the ancient forest, a special <w>refuge</w> was established for European bisons."
                            }
                        }
                    ],
                    "synonyms": [
                        "refugium"
                    ],
                    "common_phrases": [
                        "ostoja ptaków",
                        "ostoja przyrody",
                        "ostoja zwierzyny"
                    ],
                    "target_lang_definitions": {
                        "en": "An area, habitat, or haven providing favorable conditions for rare or endangered wildlife and plants to survive."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sanctuary",
                                "target_lang_sense_clarification": "wildlife refuge"
                            },
                            {
                                "target_lang_word": "haven",
                                "target_lang_sense_clarification": "safe habitat"
                            },
                            {
                                "target_lang_word": "refugium",
                                "target_lang_sense_clarification": "ecological shelter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1a6d1eb-610a-30a3-8997-b696f9d5550f",
                    "sense_definition": "Krzew ozdobny z rodziny oczarowatych, kwitnący wiosną, o białych, puszystych kwiatach.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W ogrodzie botanicznym rośnie rzadka <w>ostoja</w>, która zachwyca swoimi białymi kwiatostanami.",
                            "target_lang_translations": {
                                "en": "A rare <w>fothergilla</w> grows in the botanical garden, delighting visitors with its white inflorescences."
                            }
                        },
                        {
                            "text": "Ogrodnik posadził nową <w>ostoję</w> w osłoniętym od silnego wiatru miejscu.",
                            "target_lang_translations": {
                                "en": "The gardener planted a new <w>witch alder</w> in a spot sheltered from strong winds."
                            }
                        }
                    ],
                    "synonyms": [
                        "fotergilla"
                    ],
                    "target_lang_definitions": {
                        "en": "An ornamental shrub of the witch-hazel family (Fothergilla) that flowers in spring with fluffy white blossoms."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fothergilla",
                                "target_lang_sense_clarification": "genus of flowering shrub"
                            },
                            {
                                "target_lang_word": "witch alder",
                                "target_lang_sense_clarification": "common name for Fothergilla"
                            }
                        ]
                    }
                }
            ]
        },
