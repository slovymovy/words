                                                "example_id": "c16824b2-dcac-4725-b8b0-3de1ee9a4fe7",
                                                "sense_id": "cd5d8d6a-e1fa-3dab-b8a2-bba8e3023996",
                                                "text": "Keiner der Männer ist jemals geflogen."
                                            },
