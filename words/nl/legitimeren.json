{
    "word_family": [
        "legitimatie",
        "legitiem",
        "legitimiteit"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8cc1f6d7-3e27-33a1-96c1-212dea496b86",
                    "sense_definition": "Zich identificeren door middel van een officieel document om te bewijzen wie men is.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "identificatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij de ingang van het overheidsgebouw moet iedereen zich verplicht <w>legitimeren</w>.",
                            "target_lang_translations": {
                                "ru": "При входе в правительственное здание каждый обязан <w>удостоверить свою личность</w>."
                            }
                        },
                        {
                            "text": "De politieagent vroeg de bestuurder om zich te <w>legitimeren</w> met een rijbewijs.",
                            "target_lang_translations": {
                                "ru": "Полицейский попросил водителя <w>предъявить удостоверение личности</w> в виде водительских прав."
                            }
                        }
                    ],
                    "synonyms": [
                        "identificeren"
                    ],
                    "common_phrases": [
                        "zich legitimeren",
                        "verplicht legitimeren"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удостоверять свою личность с помощью официального документа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удостоверять личность",
                                "target_lang_sense_clarification": "предъявлять документы"
                            },
                            {
                                "target_lang_word": "идентифицировать себя",
                                "target_lang_sense_clarification": "подтверждать кто ты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5665224f-493a-308d-9a96-1a9fa5435b3c",
                    "sense_definition": "Iets rechtvaardigen of wettig, legitiem maken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rechtvaardiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De resolutie van de Veiligheidsraad <w>legitimeert</w> een militaire aanval op het land.",
                            "target_lang_translations": {
                                "ru": "Резолюция Совета Безопасности <w>легитимирует</w> военное нападение на страну."
                            }
                        },
                        {
                            "text": "Zulke argumenten kunnen het gebruik van geweld in deze situatie niet <w>legitimeren</w>.",
                            "target_lang_translations": {
                                "ru": "Подобные аргументы не могут <w>оправдать</w> применение насилия в данной ситуации."
                            }
                        }
                    ],
                    "synonyms": [
                        "rechtvaardigen",
                        "wettigen"
                    ],
                    "common_phrases": [
                        "een besluit legitimeren",
                        "geweld legitimeren"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оправдывать что-либо или делать это законным, легитимным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легитимировать",
                                "target_lang_sense_clarification": "делать законным"
                            },
                            {
                                "target_lang_word": "узаконивать",
                                "target_lang_sense_clarification": "придавать законную силу"
                            },
                            {
                                "target_lang_word": "оправдывать",
                                "target_lang_sense_clarification": "находить объяснение или оправдание действиям"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}