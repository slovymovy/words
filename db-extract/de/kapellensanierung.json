                "senses": [
                    {
                        "sense_id": "93df9cb3-084f-31c0-823f-6780116035d0",
                        "entry_id": "070dfa11-3014-36ca-a72e-0a246518010e",
                        "glosses": [
                            "Behandlung oder auch Erneuerung der Bausubstanz eines Kapellengebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cd87833-2ec4-45b0-9e9f-8c33ebca297b",
                                "sense_id": "93df9cb3-084f-31c0-823f-6780116035d0",
                                "text": "„Eine Spendentafel lädt nun zur finanziellen Unterstützung der Kapellensanierung ein.“"
                            },
                            {
                                "example_id": "d6f964c2-c7ae-47c3-9d82-fa0dc09552e5",
                                "sense_id": "93df9cb3-084f-31c0-823f-6780116035d0",
                                "text": "„Dadurch dass wiederholte Winterrückfälle den Frühling des Jahres '97 immer wieder in Bedrängnis brachten, konnte mit der Kapellensanierung erst Ende April begonnen werden.“"
                            },
                            {
                                "example_id": "6e7f6b1a-5b44-411c-83cf-6cd1a4c13a9d",
                                "sense_id": "93df9cb3-084f-31c0-823f-6780116035d0",
                                "text": "„Der Dorferneuerungsverein Unser Tiefenbach (Gemeinde Krumau/Kamp) nahm am Projektwettbewerb der NÖ Dorf- und Stadterneuerung teil und wurde für das Projekt Kapellensanierung Tiefenbach ausgezeichnet.“"
                            },
                            {
                                "example_id": "aa9b4f23-9900-4ad1-991e-b8379e1dbf23",
                                "sense_id": "93df9cb3-084f-31c0-823f-6780116035d0",
                                "text": "„Deshalb auch sein nachdrücklicher Dank an die Oberhut, dass sie sich mit der Kapellensanierung einer Aufgabe annehme, die im Grunde Aufgabe der Stadt als Eigentümerin sei: „Aber das ist in Ahrweiler eben anders. Wir wollen lieber eine Toilette schließen als eine Kapelle.“ “"
                            },
                            {
                                "example_id": "7468796e-4530-4b7d-bd3b-4df58efabbd6",
                                "sense_id": "93df9cb3-084f-31c0-823f-6780116035d0",
                                "text": "„Ortsheimatpfleger Adolf Leitl ging bei der Feier zur Kapellensanierung auf die Geschichte des Kirchleins und der Reckenberger Bevölkerung ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
