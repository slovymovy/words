                "senses": [
                    {
                        "sense_id": "e54cf03b-9be8-3c6d-b208-6be28b0ea3b0",
                        "entry_id": "d83ef112-d9b3-3337-a3cd-5fc10416b1eb",
                        "glosses": [
                            "vooruit drijvend; met name in de combinatie stuwende kracht iemand die zorgt dat iets gebeurt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17bb4579-821e-4516-ba0b-71439b411b71",
                                "sense_id": "e54cf03b-9be8-3c6d-b208-6be28b0ea3b0",
                                "text": "Volgens curator Reinier Quint zat het faillissement er al enige tijd aan te komen. Hij heeft afgelopen dagen van de betrokkenen begrepen dat na het plotselinge overlijden van oprichter en stuwende kracht Douwe van der Kooi in oktober 2017, het bergafwaarts ging met de zorgonderneming."
                            },
                            {
                                "example_id": "a636caf1-05ec-4300-af4b-0c6b385ef7f3",
                                "sense_id": "e54cf03b-9be8-3c6d-b208-6be28b0ea3b0",
                                "text": "Renée Menschaar uit Den Haag is al bijna dertig jaar de stuwende kracht achter de grote blauwe vogel uit Sesamstraat."
                            },
                            {
                                "example_id": "bdc488fb-4b41-4292-9fd6-cd038ae8268f",
                                "sense_id": "e54cf03b-9be8-3c6d-b208-6be28b0ea3b0",
                                "text": "Ook de tweede ridder van Winterswijk, Harrie Garritsen, is actief bij RTV Slingeland. Daarnaast is hij een stuwende kracht achter de gymnastiek in het dorp."
                            }
                        ]
                    }
