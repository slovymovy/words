                                        "entry_id": "32f924c3-830e-34d4-a21c-e86299130141",
                                        "glosses": [
                                            "A dome-shaped Buddhist monument, used to house relics of the Lord Buddha."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c17d7d28-7905-430f-814d-463514b8bcd2",
                                                "sense_id": "8849ca4c-f0cb-352d-bc7c-23341045c190",
                                                "text": "He mounded so much honey on the top of the buns that they looked like miniature stupas."
                                            },
                                            {
                                                "example_id": "c1ead314-6e71-4fee-b55b-97ec35e3274c",
                                                "sense_id": "8849ca4c-f0cb-352d-bc7c-23341045c190",
                                                "text": "I cupped her cheeks and thought of the lotus flowers at the thresholds of Buddhist stupas, their pale petals resting in the palms of the faithful."
                                            }
                                        ]
                                    }
