                        "examples": [
                            {
                                "example_id": "678d73f9-b6d6-466b-be5a-cc4466595468",
                                "sense_id": "b9f66028-7656-3e6b-b2f5-5b07c9038469",
                                "text": "Op de laatste schooldag permitteerde de leraar dat de scholieren veel lawaai maakten in de klas."
                            }
                        ]
                    },
                    {
                        "sense_id": "b31b86fb-9301-3277-8e63-ba3adfeca630",
