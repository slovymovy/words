{
    "word_family": [
        "детский",
        "детство",
        "детвора",
        "деторождение"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c5c2cb69-0cd6-37d4-85e5-85569ab9a7eb",
                    "sense_definition": "Маленький мальчик или маленькая девочка; ребёнок (часто с оттенком умиления или в высоком стиле).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Малое <w>дитя</w> мирно спало в своей кроватке.",
                            "target_lang_translations": {
                                "en": "The small <w>child</w> was sleeping peacefully in its crib.",
                                "zh": "小<w>孩子</w>在摇篮里安静地睡着。"
                            }
                        },
                        {
                            "text": "Каждая мать считает, что её <w>дитя</w> самое красивое и умное.",
                            "target_lang_translations": {
                                "en": "Every mother believes that her <w>child</w> is the most beautiful and intelligent.",
                                "zh": "每个母亲都认为自己的<w>孩子</w>是最漂亮、最聪明的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ребёнок",
                        "малыш",
                        "малютка",
                        "крошка",
                        "младенец"
                    ],
                    "antonyms": [
                        "старик"
                    ],
                    "common_phrases": [
                        "малое дитя",
                        "неразумное дитя",
                        "плачущее дитя"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "В современной разговорной речи обычно используется слово «ребёнок»."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A young human being who has not yet reached puberty or adulthood.",
                        "zh": "指尚未成年的人，通常带有喜爱或文学色彩。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "child",
                                "target_lang_sense_clarification": "general term"
                            },
                            {
                                "target_lang_word": "baby",
                                "target_lang_sense_clarification": "very young child"
                            },
                            {
                                "target_lang_word": "infant",
                                "target_lang_sense_clarification": "formal or very young"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孩子",
                                "target_lang_sense_clarification": "通用词"
                            },
                            {
                                "target_lang_word": "幼儿",
                                "target_lang_sense_clarification": "指年幼的儿童"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8be3b5f7-ac69-3955-8295-0a4bc299bb61",
                    "sense_definition": "Сын или дочь по отношению к родителям (независимо от возраста).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для родителей он всегда останется любимым <w>дитятей</w>, даже когда вырастет.",
                            "target_lang_translations": {
                                "en": "To his parents, he will always remain a beloved <w>child</w>, even when he grows up.",
                                "zh": "对父母来说，即使他长大了，也永远是他们心爱的<w>孩子</w>。"
                            }
                        },
                        {
                            "text": "Это было их единственное <w>дитя</w>, и они его очень баловали.",
                            "target_lang_translations": {
                                "en": "It was their only <w>child</w>, and they spoiled him greatly.",
                                "zh": "这是他们唯一的<w>子女</w>，所以他们非常宠爱他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "чадо",
                        "отпрыск"
                    ],
                    "antonyms": [
                        "родитель"
                    ],
                    "common_phrases": [
                        "единственное дитя",
                        "родное дитя",
                        "приёмное дитя"
                    ],
                    "target_lang_definitions": {
                        "en": "A son or daughter of any age; one's offspring.",
                        "zh": "指父母的子女，不限年龄。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "child",
                                "target_lang_sense_clarification": "kinship"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "子女",
                                "target_lang_sense_clarification": "亲属关系"
                            },
                            {
                                "target_lang_word": "孩子",
                                "target_lang_sense_clarification": "口语中指代子女"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fc6570d-58f7-394b-96fa-219f118518ae",
                    "sense_definition": "Человек, чьи характер, привычки и мировоззрение сформированы определённой средой, временем или обстоятельствами.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он был настоящим <w>дитятей</w> своего времени, разделяя все его заблуждения.",
                            "target_lang_translations": {
                                "en": "He was a true <w>child</w> of his time, sharing all its delusions.",
                                "zh": "他是那个时代的<w>产物</w>，认同那个时代所有的错误观念。"
                            }
                        },
                        {
                            "text": "Маугли — это классическое <w>дитя</w> природы и джунглей.",
                            "target_lang_translations": {
                                "en": "Mowgli is a classic <w>child</w> of nature and the jungle.",
                                "zh": "毛克利是自然与丛林孕育出的典型<w>之子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "порождение",
                        "продукт",
                        "плод"
                    ],
                    "common_phrases": [
                        "дитя природы",
                        "дитя своего времени",
                        "дитя улицы",
                        "дитя порока"
                    ],
                    "target_lang_definitions": {
                        "en": "A person viewed as the product or result of a specific environment, time, or set of circumstances.",
                        "zh": "指受特定环境、时代或背景影响而形成某种性格或特征的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "child",
                                "target_lang_sense_clarification": "figurative"
                            },
                            {
                                "target_lang_word": "product",
                                "target_lang_sense_clarification": "result of influence"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "产物",
                                "target_lang_sense_clarification": "指受环境影响的结果"
                            },
                            {
                                "target_lang_word": "之子",
                                "target_lang_sense_clarification": "文学用法，如时代之子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cc3fca6-6bab-3bc1-be8a-dee6410ecd85",
                    "sense_definition": "Наивный, неопытный человек, который ведёт себя как ребёнок.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В вопросах бизнеса он просто сущее <w>дитя</w> и верит всему на слово.",
                            "target_lang_translations": {
                                "en": "In business matters, he is just a mere <w>child</w> and takes everything at face value.",
                                "zh": "在商业问题上，他简直是个<w>孩子</w>，别人说什么他都信。"
                            }
                        },
                        {
                            "text": "Ты ведёшь себя как малое <w>дитя</w>, обижаясь на такую ерунду.",
                            "target_lang_translations": {
                                "en": "You are behaving like a small <w>child</w>, getting offended by such nonsense.",
                                "zh": "你因为这点小事就生气，真是太<w>孩子气</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "младенец"
                    ],
                    "common_phrases": [
                        "сущее дитя",
                        "наивное дитя",
                        "как малое дитя"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who is naive, inexperienced, or behaves immaturely.",
                        "zh": "指天真、缺乏经验或行为幼稚的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "child",
                                "target_lang_sense_clarification": "naive person"
                            },
                            {
                                "target_lang_word": "baby",
                                "target_lang_sense_clarification": "immature person"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孩子气",
                                "target_lang_sense_clarification": "形容行为幼稚"
                            },
                            {
                                "target_lang_word": "天真",
                                "target_lang_sense_clarification": "形容缺乏经验"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b268495-b5a4-3cd4-8d8e-cce5d26baef9",
                    "sense_definition": "Ласковое обращение к кому-либо (обычно к более молодому человеку).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не плачь, <w>дитя</w> моё, всё обязательно наладится.",
                            "target_lang_translations": {
                                "en": "Do not cry, my <w>child</w>, everything will definitely work out.",
                                "zh": "别哭，我的<w>孩子</w>，一切都会好起来的。"
                            }
                        },
                        {
                            "text": "Послушай меня, <w>дитя</w>, и запомни этот важный урок.",
                            "target_lang_translations": {
                                "en": "Listen to me, <w>child</w>, and remember this important lesson.",
                                "zh": "听我说，<w>孩子</w>，记住这重要的一课。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "дитя моё",
                        "спи, дитя"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Поэтическое или устаревшее."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An affectionate term of address, typically used by an older person to a younger one.",
                        "zh": "长辈对晚辈的亲昵称呼，多见于文学或诗歌。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "child",
                                "target_lang_sense_clarification": "form of address"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孩子",
                                "target_lang_sense_clarification": "亲昵称呼"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}