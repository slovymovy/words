            {
                "entry_id": "1a7e492e-aee7-3b0e-a3e2-afd888abadb8",
                "word": "pogrome",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dc681687-b941-488d-90f4-6e4371347698",
                        "entry_id": "1a7e492e-aee7-3b0e-a3e2-afd888abadb8",
                        "tags": [
                            "plural"
                        ],
