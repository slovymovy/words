        "fr-extract.jsonl": [
            {
                "entry_id": "e4f85ce9-7b37-361b-9a84-94e294790875",
                "word": "mimique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "42e78e84-a34e-4fab-92f6-0ebd5a905a3a",
                        "entry_id": "e4f85ce9-7b37-361b-9a84-94e294790875",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "mimiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3912499-4766-3aab-9304-2b8339a43ee7",
                        "entry_id": "e4f85ce9-7b37-361b-9a84-94e294790875",
                        "glosses": [
                            "Qui concerne les mimes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69716d99-f7e2-4f1a-b1f2-6e27f11e8060",
                                "sense_id": "e3912499-4766-3aab-9304-2b8339a43ee7",
                                "text": "PHILISTION, de Magnésie, poëte mimique, ou composeur de farces, vivoit à Rome peu après Horace."
                            }
                        ]
                    },
                    {
                        "sense_id": "c41fa734-231c-3dac-b8b6-9fc7d4ebcafd",
                        "entry_id": "e4f85ce9-7b37-361b-9a84-94e294790875",
                        "glosses": [
                            "Qui imite, qui exprime par le geste."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "035da332-c309-4552-8a30-0db18de7a40f",
                                "sense_id": "c41fa734-231c-3dac-b8b6-9fc7d4ebcafd",
                                "text": "On trouve peu d’exemples de séquences dont le comique soit exclusivement visuel et mimique."
                            },
                            {
                                "example_id": "a4fb2df8-7a7b-4590-b8de-194ae57f45e4",
                                "sense_id": "c41fa734-231c-3dac-b8b6-9fc7d4ebcafd",
                                "text": "Son absence eut toutefois des avantages ; elle nous évita de nous obséder par ses mimiques et réactions, lors de la cérémonie, et de penser à la période Biden qui s’ouvrait pour les États-Unis."
                            },
                            {
                                "example_id": "14a90b46-4849-4b47-8223-018bae9991aa",
                                "sense_id": "c41fa734-231c-3dac-b8b6-9fc7d4ebcafd",
                                "text": "Signes mimiques. – Langage mimique."
                            }
                        ]
                    },
                    {
                        "sense_id": "112a2375-ea7c-31a0-9368-2102b0f4cbd2",
                        "entry_id": "e4f85ce9-7b37-361b-9a84-94e294790875",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5b3c0f5-2921-47bb-a964-6bdc8a2ce4f7",
                                "sense_id": "112a2375-ea7c-31a0-9368-2102b0f4cbd2",
                                "text": "LES VARIÉTÉS DE L’HEXAMÈTRE\nPartagé en deux hémistiches ce vers devient le priapéen; Le buccolique, quand il l’est en deux, et une dipodie, séparées par une pause. Les deux premières dipodies forment le vers alcmanien; Les deux dernières le phalisque; La dernière l’adonique; Le dernier hémistiche forme le phérécratien; Une fraction d’un spondée et de deux dactyles forme un glyconique; Et une fraction impaire forme le dactylique tétramètre catalectique. C’est un composé de trois pieds et demi ou une epthémimérie. Le miurus ou téliambe, mentionné dans le même tableau, n’est que le résultat d’un accident prosodique. Mais chacune de ces variétés a sa valeur mimique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b30e6f08-af2d-4b67-ac52-83acf011f21a",
                        "source_entry_id": "e4f85ce9-7b37-361b-9a84-94e294790875",
                        "target_lang_word": "mimic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mimic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4c000d9-fed2-3caf-bea3-05d9d7282e2f",
                                        "entry_id": "a40338ab-c50e-3533-a318-275d8fd68fc4",
                                        "glosses": [
                                            "To imitate, especially in order to ridicule."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d411e67f-6ffe-4948-9c64-c9f05a58f0d5",
                                                "sense_id": "c4c000d9-fed2-3caf-bea3-05d9d7282e2f",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc1e4511-b99d-36ea-9f80-043560eac235",
                                        "entry_id": "a40338ab-c50e-3533-a318-275d8fd68fc4",
                                        "glosses": [
                                            "To take on the appearance of another, for protection or camouflage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mimic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "711d141a-ce28-3c4f-953d-2ef37694678b",
                                        "entry_id": "9523d096-4412-3831-8acc-536619ca33ed",
                                        "glosses": [
                                            "A person who practices mimicry; especially:",
                                            "A mime."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5b594e4-212b-3469-bac2-94a5107d3eca",
                                        "entry_id": "9523d096-4412-3831-8acc-536619ca33ed",
                                        "glosses": [
                                            "A person who practices mimicry; especially:",
                                            "A comic who does impressions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1f95f44-ea75-3707-9a14-7763689f7b98",
                                        "entry_id": "9523d096-4412-3831-8acc-536619ca33ed",
                                        "glosses": [
                                            "An entity that mimics another entity, such as a disease that resembles another disease in its signs and symptoms; see the great imitator."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04c0ab0b-7bea-30b3-86d8-cbc51c78ad4d",
                                        "entry_id": "9523d096-4412-3831-8acc-536619ca33ed",
                                        "glosses": [
                                            "An imitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce1ebec5-5496-4abc-bb58-198f70bdbae3",
                                                "sense_id": "04c0ab0b-7bea-30b3-86d8-cbc51c78ad4d",
                                                "text": "Jess jumped slightly at hearing Tillyʼs extremely accurate mimic of her voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5443df12-6385-3a07-b289-4a81dcb45ce3",
                                        "entry_id": "9523d096-4412-3831-8acc-536619ca33ed",
                                        "glosses": [
                                            "A fictional monster able to disguise itself as an inanimate object, commonly a treasure chest, often with the intent of luring adventurers into a trap."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mimic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa5089b6-1612-3c3d-af12-5eb0d54fda67",
                                        "entry_id": "334e9d2c-e44d-335d-966c-358e14a3fe9c",
                                        "glosses": [
                                            "Pertaining to mimicry; imitative."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "389a2deb-129d-44f1-b17c-f7da001ddfd8",
                                                "sense_id": "fa5089b6-1612-3c3d-af12-5eb0d54fda67",
                                                "text": "I think every man is cloied and wearied, with seeing so many apish and mimicke trickes, that juglers teach their Dogges, as the dances, where they misse not one cadence of the sounds or notes they heare[…]."
                                            },
                                            {
                                                "example_id": "369b90cd-e11e-4d3d-bd6a-833a0a377d46",
                                                "sense_id": "fa5089b6-1612-3c3d-af12-5eb0d54fda67",
                                                "text": "Oft, in her absence, mimic fancy wakes / To imitate her."
                                            },
                                            {
                                                "example_id": "cec7c423-5242-4eec-aa8c-466b3f6e464d",
                                                "sense_id": "fa5089b6-1612-3c3d-af12-5eb0d54fda67",
                                                "text": "And there, with fingers interwoven, both hands\nPressed closely palm to palm and to his mouth\nUplifted, he, as through an instrument,\nBlew mimic hootings to the silent owls,\nThat they might answer him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92d5bebf-717b-3ace-a6de-0eb6d888dda1",
                                        "entry_id": "334e9d2c-e44d-335d-966c-358e14a3fe9c",
                                        "glosses": [
                                            "Mock, pretended."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "433582a5-4adc-34c9-9870-3602b134a5e9",
                                        "entry_id": "334e9d2c-e44d-335d-966c-358e14a3fe9c",
                                        "glosses": [
                                            "Imitative; characterized by resemblance to other forms; applied to crystals which by twinning resemble simple forms of a higher grade of symmetry."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bb9865f-d0da-4528-aade-fc6e4af299c5",
