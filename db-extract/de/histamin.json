                    {
                        "sense_id": "2e2a8876-524b-3a1f-9fb4-52696cb62b70",
                        "entry_id": "b5375216-853c-3d4a-92a0-c2a0ee7e5372",
                        "glosses": [
                            "Gewebshormon und biogenes Amin, das besonders häufig in den Gewebsmastzellen der Haut, Muskulatur und Lunge vorkommt"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "81216983-b0b5-4b4a-a5a9-53cb936b6de4",
                                "sense_id": "2e2a8876-524b-3a1f-9fb4-52696cb62b70",
                                "text": "Histamin wirkt gefäßerweiternd."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1e183e4-a77a-46d1-ac97-3f7ca9034b2d",
                        "source_entry_id": "b5375216-853c-3d4a-92a0-c2a0ee7e5372",
                        "source_sense_id": "2e2a8876-524b-3a1f-9fb4-52696cb62b70",
                        "target_lang_word": "組織胺",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
