        "fr-extract.jsonl": [
            {
                "entry_id": "877c6103-682f-3413-9447-57bd50ac6e86",
                "word": "besicles",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8985eb8a-d2df-42c1-9ad3-0c3806100dc1",
                        "entry_id": "877c6103-682f-3413-9447-57bd50ac6e86",
                        "tags": [],
                        "form": "bésicles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b6cf091-6bbc-3410-826a-739cf86b23a6",
                        "entry_id": "877c6103-682f-3413-9447-57bd50ac6e86",
                        "glosses": [
                            "Lunettes sans branches qui se fixent au nez."
                        ],
                        "tags": [
                            "dated",
                            "plural"
                        ],
                        "note": "le mot est rarement trouvé au singulier, sous la forme besicle",
                        "examples": [
                            {
                                "example_id": "3a86c662-f0b3-44ea-ba6d-3388c5cb6c1e",
                                "sense_id": "4b6cf091-6bbc-3410-826a-739cf86b23a6",
                                "text": "Enfin, le quatrième, celui qui a des besicles, et l’air un peu malade, c’est notre ami M. Thomas, l’auteur des \"Éloges\"."
                            },
                            {
                                "example_id": "15fe33ab-e077-4fa5-9a0c-776ef365f9b2",
                                "sense_id": "4b6cf091-6bbc-3410-826a-739cf86b23a6",
                                "text": "Le vieux Melchior, […], le nez pincé dans ses grandes besicles de corne et les lèvres serrées, ne pouvait s’empêcher de déposer sur l’établi sa loupe et son poinçon et de jeter quelquefois un regard vers l’auberge, […]."
                            },
                            {
                                "example_id": "4c6e2753-5ea2-4c0f-b96d-65d1667506da",
                                "sense_id": "4b6cf091-6bbc-3410-826a-739cf86b23a6",
                                "text": "À l'aide de ses besicles, elle vit le jeune artiste dont l'élégance mondaine annonçait plutôt quelque capitaine de cavalerie en congé qu'un négociant du quartier."
                            },
                            {
                                "example_id": "aa7fed6c-6d80-492e-9569-c9ee51216517",
                                "sense_id": "4b6cf091-6bbc-3410-826a-739cf86b23a6",
                                "text": "Dorothée se signait à tour de bras, ses grosses besicles penchées sur un antique missel à fermoir de cuivre, marmottant les paroles latines avec ferveur."
                            },
                            {
                                "example_id": "63a44099-d754-4926-b5a0-4d53cf90ffa7",
                                "sense_id": "4b6cf091-6bbc-3410-826a-739cf86b23a6",
                                "text": "Mes yeux, usés sur les vieux textes, ne distinguent pas sans besicles un melon d’une carafe, placés tous deux au bout de mon nez."
                            }
                        ]
                    },
                    {
                        "sense_id": "09a5ae3a-c370-386e-95ac-05b1b83d6c27",
                        "entry_id": "877c6103-682f-3413-9447-57bd50ac6e86",
                        "glosses": [
                            "Vision, point de vue vieux et démodé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b3fff88b-fe00-4e0e-8001-b29f6afd88a1",
                                "sense_id": "09a5ae3a-c370-386e-95ac-05b1b83d6c27",
                                "text": "Il passe cependant en France pour un ultra libéral d’extrême droite, parce qu’il décrit la réalité sans emprunter les besicles idéologiques à la mode dans le sixième arrondissement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c80f544-7e08-4c7e-9c73-e7c0adf62fc6",
                        "source_entry_id": "877c6103-682f-3413-9447-57bd50ac6e86",
                        "source_sense_id": "4b6cf091-6bbc-3410-826a-739cf86b23a6",
                        "source_sense_description": "Lunettes sans branches qui se fixent aux nez.",
                        "target_lang_word": "Zwicker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwicker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f87761c2-e024-3d73-b000-8353716cc266",
                                        "entry_id": "c16228c3-ddb7-319e-93a9-9f1b1dca5726",
                                        "glosses": [
                                            "Brille, die keine Bügel hat und nur auf die Nase geklemmt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c50b791c-728e-4200-960c-ae6556248b7c",
                                                "sense_id": "f87761c2-e024-3d73-b000-8353716cc266",
                                                "text": "Zwicker sind im 20. Jahrhundert aus der Mode gekommen."
                                            },
                                            {
                                                "example_id": "a1210667-50d7-4917-bc1a-b6c9325c7d95",
                                                "sense_id": "f87761c2-e024-3d73-b000-8353716cc266",
                                                "text": "„Frau Grünberg, eine Frau mit wirrem Haar und einem Zwicker, hörte ihn geduldig an.“"
                                            },
                                            {
                                                "example_id": "1d6eb631-ec65-4c0b-ad27-a783cab710de",
                                                "sense_id": "f87761c2-e024-3d73-b000-8353716cc266",
                                                "text": "„Dieser Herr hieß Eduardo Baixa, war ganz in Schwarz gekleidet und trug einen Zwicker an einem schwarzen Seidenband.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c907b50e-b2c5-3930-9e93-b9303b1b663b",
                                        "entry_id": "c16228c3-ddb7-319e-93a9-9f1b1dca5726",
                                        "glosses": [
                                            "eine etwas einfachere Variante des Edelzwickers, die aus einem Cuveé der einfachen Grundtrauben Gutedel und Silvaner hergestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52304fcf-e331-406d-b353-4c324a5c4a9f",
                                                "sense_id": "c907b50e-b2c5-3930-9e93-b9303b1b663b",
                                                "text": "Ein Zwicker ist vielen Weintrinkern zu sauer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "491a3517-e1ea-4b24-8521-ce68a6f8d186",
