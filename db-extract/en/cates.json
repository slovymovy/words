            {
                "entry_id": "83ead3b2-b03f-3c4f-a7d7-5992f4807bdc",
                "word": "cates",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7160751e-f162-321c-8717-6652c488f944",
                        "entry_id": "83ead3b2-b03f-3c4f-a7d7-5992f4807bdc",
                        "glosses": [
                            "Provisions; food; viands; especially, luxurious food; delicacies; dainties."
                        ],
                        "tags": [
                            "archaic",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "4674e09a-e535-4d36-b91e-f41507d1f6a9",
                                "sense_id": "7160751e-f162-321c-8717-6652c488f944",
                                "text": "I tempted his blood and his flesh, / Hid in roses my mesh, / Choicest cates and the flagon's best spilth— / Still he kept to his filth!"
                            },
                            {
                                "example_id": "b8c180fb-b9d0-4833-b615-fe223d8cd6f9",
                                "sense_id": "7160751e-f162-321c-8717-6652c488f944",
                                "text": "I had rather live / With cheese and garlic in a windmill, far, / Than feed on cates and have him talk to me / In any summer house in Christendom."
                            },
                            {
                                "example_id": "9e8ff4a2-65e6-4711-8aa1-3bc86bf123d8",
                                "sense_id": "7160751e-f162-321c-8717-6652c488f944",
                                "text": "Hath any rival glutton got the start, / And beat him in his own luxurious art; / Bought cates for which Apicius could not pay, / Or drest old dainties in a newer way?"
                            }
                        ]
                    }
                ],
