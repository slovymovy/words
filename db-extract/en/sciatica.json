                        ],
                        "form": "sciaticas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d568846b-89a8-3d36-9759-9a249ab585a4",
                        "entry_id": "1e7b8e3d-db84-35f3-856c-4aee384d199c",
                        "glosses": [
                            "Neuralgia of the sciatic nerve, characterised by pain radiating down through the buttocks and the back of the thigh."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "571fb591-0fc7-4971-ab47-0cb497c8383b",
                                "sense_id": "d568846b-89a8-3d36-9759-9a249ab585a4",
                                "text": "He picked up his own phone, shunned limos and preferred to walk if possible (sciatica later caused him to use a wheelchair) – as, for example, on the day after his election when he slipped away on foot to collect his suitcase and settle the bill at the modest pensione where he had been booked in before the conclave began."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac468e70-7e54-4090-bc84-17a66f4e0001",
                        "source_entry_id": "1e7b8e3d-db84-35f3-856c-4aee384d199c",
