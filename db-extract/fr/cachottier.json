                        "sense_id": "797f4092-2e4c-3ab4-afda-2ab6d10e7ed9",
                        "entry_id": "37cbb56c-359c-339d-ac77-2f6a7a9a005b",
                        "glosses": [
                            "Qui se plaît à faire des cachotteries."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "bf5f8edb-878c-43af-8122-3041b6d76c4d",
                                "sense_id": "797f4092-2e4c-3ab4-afda-2ab6d10e7ed9",
                                "text": "C’est un enfant cachottier."
                            },
                            {
                                "example_id": "6f492043-b229-4d6b-8038-6a99948f5f4a",
                                "sense_id": "797f4092-2e4c-3ab4-afda-2ab6d10e7ed9",
                                "text": "Ces dernières années le comte était devenu taciturne, mais il n’avait jamais été cachottier."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3fdb222b-d92b-3fc3-9972-59e9506d4082",
