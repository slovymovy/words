            "senses": [
                {
                    "sense_id": "f2b2e947-44fd-3bb7-b331-4b199564fb24",
                    "sense_definition": "iemand of iets schade, pijn of een nederlaag laten ervaren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "veroorzaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kapers konden regelmatig de blokkade omzeilen en grote schade <w>toebrengen</w> aan de scheepvaart.",
                            "target_lang_translations": {
                                "en": "The privateers were able to regularly bypass the blockade and <w>inflict</w> great damage on shipping."
                            }
                        },
                        {
                            "text": "De bokser wist zijn tegenstander een zware slag <w>toe te brengen</w> in de laatste ronde.",
                            "target_lang_translations": {
                                "en": "The boxer managed to <w>deal</w> his opponent a heavy blow in the final round."
                            }
                        }
                    ],
                    "synonyms": [
                        "veroorzaken",
                        "aandoen"
                    ],
                    "common_phrases": [
                        "schade toebrengen",
                        "een nederlaag toebrengen",
                        "letsel toebrengen",
                        "een slag toebrengen"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause someone or something to experience damage, pain, or defeat"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inflict",
                                "target_lang_sense_clarification": "to cause something unpleasant like pain or a blow"
                            },
                            {
                                "target_lang_word": "cause",
                                "target_lang_sense_clarification": "to be the reason for damage or harm"
                            },
                            {
                                "target_lang_word": "deal",
                                "target_lang_sense_clarification": "to deliver a blow or defeat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38bba330-89fc-345b-b365-efba795a4ed7",
                    "sense_definition": "het proces van iets negatiefs laten gebeuren of teweegbrengen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "veroorzaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is verboden om opzettelijk leed <w>toe te brengen</w> aan dieren in deze opvang.",
                            "target_lang_translations": {
                                "en": "It is forbidden to intentionally <w>inflict</w> suffering on animals in this shelter."
                            }
                        },
                        {
                            "text": "De storm heeft aanzienlijke verwoestingen <w>toegebracht</w> aan de kustdorpen.",
                            "target_lang_translations": {
                                "en": "The storm <w>caused</w> significant destruction to the coastal villages."
                            }
                        }
                    ],
                    "synonyms": [
                        "teweegbrengen",
                        "berokkenen"
                    ],
                    "common_phrases": [
                        "leed toebrengen",
                        "verlies toebrengen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in formele of juridische context"
                        }
                    ],
                    "target_lang_definitions": {
