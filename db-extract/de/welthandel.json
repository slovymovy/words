                        ],
                        "examples": [
                            {
                                "example_id": "8fa8a5b2-4b24-4a38-a974-c05bb4d9a476",
                                "sense_id": "9e921ca4-95f7-3cd1-b4ba-0329a454bc12",
                                "text": "Der Welthandel spielt sich über den Seeweg ab."
                            },
                            {
                                "example_id": "66e1a966-9ba8-45a9-8c3c-e3fcbf3dc4cf",
                                "sense_id": "9e921ca4-95f7-3cd1-b4ba-0329a454bc12",
                                "text": "Tatsächlich gibt es in der hochmodernen Finanzmetropole, einer Drehscheibe des Welthandels, genügend Klopapier für alle.",
                                "translation": "En effet, dans cette métropole financière ultramoderne, plaque tournante du commerce mondial, il y a suffisamment de papier toilette pour tout le monde."
                            }
                        ]
                    }
