                        "examples": [
                            {
                                "example_id": "fcd850d3-e9e5-4c6c-99f5-5bfcd9997e6d",
                                "sense_id": "be15578f-2d44-3c4e-bfe6-11f8c6a4a5c8",
                                "text": "The day, notwithstanding it was now October, was intensely hot (although a severe frost for two or three days before gave indications of approaching winter), and the streets being unmacadamized, had that arid look we read of in accounts of the plains of Arabia, the dust being quite deep, and exceeding in quantity anything of the kind I had ever seen in European cities: clouds of it impregnated the air, and rendered respiration and sight difficult."
                            },
                            {
                                "example_id": "f6ac8c64-8459-4628-8b99-d25dc3bc6551",
                                "sense_id": "be15578f-2d44-3c4e-bfe6-11f8c6a4a5c8",
                                "text": "Rare, in these days, was the carriage, or stage-coach for the traveller; / Roads, unmacadamized, making rude havoc of delicate springs."
                            }
                        ]
                    }
