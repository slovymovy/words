                "senses": [
                    {
                        "sense_id": "7dd90e4e-7c7b-3f72-ad92-8dc8326634bc",
                        "entry_id": "d13ae65a-84da-3083-88c6-da35fab04bc6",
                        "glosses": [
                            "старославянское название Константинополя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "943e850c-f4eb-4f6f-ab71-ca20a66b05c3",
                                "sense_id": "7dd90e4e-7c7b-3f72-ad92-8dc8326634bc",
                                "text": "Известно, что залив Золотой Рог, на берегу которого находится Царьград, в ожидании опасности запирался цепью, протягивающейся между двумя башнями на противоположных берегах залива."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52006b7b-4a82-406e-b49e-802738b6a229",
                        "source_entry_id": "d13ae65a-84da-3083-88c6-da35fab04bc6",
                        "source_sense_id": "7dd90e4e-7c7b-3f72-ad92-8dc8326634bc",
                        "target_lang_word": "Carogród",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5b960879-ff93-47f0-a8b5-2587dcdd3bf0",
                        "source_entry_id": "d13ae65a-84da-3083-88c6-da35fab04bc6",
                        "source_sense_id": "7dd90e4e-7c7b-3f72-ad92-8dc8326634bc",
                        "target_lang_word": "Cařihrad",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cařihrad",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "5baf4b9a-7515-3c9a-9d3a-c8f51386f51d",
                                        "entry_id": "b244093b-073b-314b-bd9d-08bced370c8b",
                                        "glosses": [
                                            "město na březích Bosporu, zejména v době své středověké historie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "127cbc5c-d9eb-4fa0-9dce-a14de6583a9c",
                                                "sense_id": "5baf4b9a-7515-3c9a-9d3a-c8f51386f51d",
                                                "text": "Berlín, Vídeň, Cařihrad hlásaly rouhavé učení, že jejich státy, ve skutečnosti dynastie jsou z boží milosti, ba přímo božím zjevením a nástrojem, stát opírající se o militarístickou armádu postaven jako ideál proti národnosti, výboj a panství nad světem staly se cílem berlínského, vídenského a cařihradského carismu — imperialismu."
                                            },
                                            {
                                                "example_id": "3143e9ad-0887-49a4-9a25-9c1d1cb1ef05",
                                                "sense_id": "5baf4b9a-7515-3c9a-9d3a-c8f51386f51d",
                                                "text": "Dále opustil milou vlast; město Soluň, kde se zrodil, veliký Cařihrad, kde byl vychován, vlast řeckou a soudruhy mladosti a odešel mezi lid cizí, do krajiny zcela neznámé: Není-li to veliká obět?"
                                            },
                                            {
                                                "example_id": "ce0b46b1-ea80-41ec-870e-09f2e38395f1",
                                                "sense_id": "5baf4b9a-7515-3c9a-9d3a-c8f51386f51d",
                                                "text": "Německo svoluje, pokud o ně jde, aby byla přenesena na vládu Jeho britského Veličenstva práva udělená Jeho císařskému Veličenstvu sultánovi smlouvou podepsanou v Cařihradě dne 29. října 1888 o volné plavbě průplavem Suezským."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
