{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e9a2dd4-8574-31ee-ba5e-bd3b6be34ff3",
                    "sense_definition": "A mechanical system of gears, cogs, and a coiled spring used to power devices such as clocks or wind-up toys.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clockwork_mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vintage toy train operates by means of internal <w>clockwork</w> that requires winding.",
                            "target_lang_translations": {
                                "tr": "Antika oyuncak tren, kurulması gereken dahili bir <w>kurmalı mekanizma</w> sayesinde çalışır."
                            }
                        },
                        {
                            "text": "He carefully opened the pocket watch to inspect the tiny brass gears inside the <w>clockwork</w>.",
                            "target_lang_translations": {
                                "tr": "<w>Saat mekanizması</w> içindeki küçük pirinç dişlileri incelemek için cep saatini dikkatlice açtı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "like clockwork"
                    ],
                    "target_lang_definitions": {
                        "tr": "Saat veya kurmalı oyuncak gibi aletleri çalıştırmak için kullanılan, çarklar, dişliler ve bir yaydan oluşan mekanik düzenek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "saat mekanizması",
                                "target_lang_sense_clarification": "saat veya benzeri aletlerdeki çarklı mekanizma"
                            },
                            {
                                "target_lang_word": "kurmalı mekanizma",
                                "target_lang_sense_clarification": "zemberekli çark sistemi"
                            },
                            {
                                "target_lang_word": "çark düzeni",
                                "target_lang_sense_clarification": "mekanik dişli sistemi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52fae208-ec2a-32d8-875c-ef48ead82693",
                    "sense_definition": "Mechanical, automatic, or rigid regularity in behavior or operation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The daily routine of the soldiers unfolded with the predictable <w>clockwork</w> of a well-drilled unit.",
                            "target_lang_translations": {
                                "tr": "Askerlerin günlük rutini, iyi eğitilmiş bir birliğin öngörülebilir <w>saat gibi işleyişi</w> ile devam etti."
                            }
                        },
                        {
                            "text": "Her thoughts returned repeatedly to the same painful memory with the relentless <w>clockwork</w> of obsession.",
                            "target_lang_translations": {
                                "tr": "Düşünceleri, bir takıntının amansız <w>mekanik düzenliliğiyle</w> defalarca aynı acı verici anıya dönüyordu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Davranış veya işleyişteki mekanik, otomatik ya da katı bir düzenlilik ve dakiklik."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "saat gibi işleyiş",
                                "target_lang_sense_clarification": "kusursuz ve dakik düzen"
                            },
                            {
                                "target_lang_word": "mekanik düzenlilik",
                                "target_lang_sense_clarification": "otomatiğe bağlanmış düzen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec6e1514-5ddb-3885-b72c-b94643f0f6b4",
                    "sense_definition": "Operated, driven, or powered by an internal spring and gear mechanism.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clockwork_mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child loved playing with a small <w>clockwork</w> mouse that hopped across the kitchen floor.",
                            "target_lang_translations": {
                                "tr": "Çocuk, mutfak zemininde zıplayan küçük bir <w>kurmalı</w> fareyle oynamayı çok seviyordu."
                            }
                        },
                        {
                            "text": "Before electric motors were common, many music boxes relied entirely on <w>clockwork</w> power.",
                            "target_lang_translations": {
                                "tr": "Elektrik motorları yaygınlaşmadan önce birçok müzik kutusu tamamen <w>zemberekli</w> güce dayanıyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "wind-up"
                    ],
                    "antonyms": [
                        "electric"
                    ],
                    "common_phrases": [
                        "clockwork mouse",
                        "clockwork toy"
                    ],
                    "target_lang_definitions": {
                        "tr": "Dahili bir yay ve çark mekanizmasıyla çalışan, kurmalı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kurmalı",
                                "target_lang_sense_clarification": "zemberekle çalışan"
                            },
                            {
                                "target_lang_word": "zemberekli",
                                "target_lang_sense_clarification": "yaylı mekanizması olan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0634bf9e-46c3-3cb4-a144-37e4c880f841",
                    "sense_definition": "Characterized by flawless regularity, smoothness, and predictability.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The logistics team handled the complicated shipment schedule with <w>clockwork</w> precision.",
                            "target_lang_translations": {
                                "tr": "Lojistik ekibi, karmaşık sevkiyat programını <w>saat gibi</w> işleyen bir hassasiyetle yürüttü."
                            }
                        },
                        {
                            "text": "Every morning began with <w>clockwork</w> regularity as she followed the exact same routine.",
                            "target_lang_translations": {
                                "tr": "Tamamen aynı rutini takip ettiği için her sabah <w>şaşmaz</w> bir düzenlilikle başlardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "precise",
                        "regular",
                        "systematic"
                    ],
                    "antonyms": [
                        "erratic",
                        "irregular"
                    ],
                    "common_phrases": [
                        "clockwork precision",
                        "clockwork efficiency",
                        "clockwork regularity"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kusursuz bir düzen, pürüzsüzlük ve öngörülebilirlikle nitelenen; saat gibi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "saat gibi",
                                "target_lang_sense_clarification": "kusursuz ve aksamayan"
                            },
                            {
                                "target_lang_word": "kusursuz",
                                "target_lang_sense_clarification": "şaşmayan ve düzenli"
                            },
                            {
                                "target_lang_word": "şaşmaz",
                                "target_lang_sense_clarification": "tam ve dakik"
                            }
                        ]
                    }
                }
            ]
        }
    ]
