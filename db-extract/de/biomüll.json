                "senses": [
                    {
                        "sense_id": "8de93a3f-1d8f-3d86-a48f-ece722a4c575",
                        "entry_id": "38c91b5a-1273-36a4-b5c4-c1e34001fd16",
                        "glosses": [
                            "Abfall, der aus organischen Produkten entstand und verrotten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a59818c-9816-4690-bdfd-5f0d50905708",
                                "sense_id": "8de93a3f-1d8f-3d86-a48f-ece722a4c575",
                                "text": "„Zum Biomüll gehören Grünabfälle in kleinen Mengen, wie Gras, Hecken- oder Strauchschnitt, Laub, Blumen; Bioabfälle, wie Obst- und Gemüseabfälle, pflanzliche Küchenabfälle, Kaffeefilter.“"
                            },
                            {
                                "example_id": "46042c74-5b4e-42fb-bc52-0c8d6cf721a5",
                                "sense_id": "8de93a3f-1d8f-3d86-a48f-ece722a4c575",
                                "text": "„Im Frühjahr, Sommer und Herbst holt die AWB Ihren Biomüll einmal pro Woche ab, immer am gleichen Tag.“"
                            },
                            {
                                "example_id": "1aa41b94-84b3-4e37-92fa-92a6629fd7ff",
                                "sense_id": "8de93a3f-1d8f-3d86-a48f-ece722a4c575",
                                "text": "„Organische Abfälle (Biomüll) werden zweiwöchentlich über die Biotonne eingesammelt.“"
                            },
                            {
                                "example_id": "178c14a6-7e95-4b70-a117-967472fe9452",
                                "sense_id": "8de93a3f-1d8f-3d86-a48f-ece722a4c575",
                                "text": "„Für Biomüll gibt es in der Stadt Ulm die Biotonne und in Ausnahmefällen die Eigenkompostierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
