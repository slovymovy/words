                            {
                                "example_id": "d8ff19ae-7287-48f8-8fb4-4a6aa7a75c5d",
                                "sense_id": "1a238b04-f67c-3640-b497-63b2beb7c969",
                                "text": "Trąba nadciągnęła od zachodu, wielka niszczycielka, pozrywała we wsi wszystkie dachy."
                            },
                            {
                                "example_id": "dd7716d8-c5ac-4645-a2fd-53500c07ae84",
                                "sense_id": "1a238b04-f67c-3640-b497-63b2beb7c969",
                                "text": "Córo Babilonu, niszczycielko, / szczęśliwy, kto ci odpłaci / za zło, jakie nam wyrządziłaś!"
                            }
                        ],
