                "senses": [
                    {
                        "sense_id": "cccae5ac-f1fe-3df5-8dd0-e0360b5a7509",
                        "entry_id": "4a7cae93-abca-3c5b-ae3f-e8bec7cf0697",
                        "glosses": [
                            "satzwertige Äußerung, die nur aus einem Wort besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61dae22f-4a6d-4016-8bf9-c99dce0ae5fd",
                                "sense_id": "cccae5ac-f1fe-3df5-8dd0-e0360b5a7509",
                                "text": "„Was die Entwicklung von der Lallperiode zur Periode des Einwortsatzes oder der Holophrase betrifft, so hat man sich hauptsächlich mit dem Lautrepertoire befaßt.“"
                            },
                            {
                                "example_id": "907281fa-c224-46a0-9293-43f86e0ddada",
                                "sense_id": "cccae5ac-f1fe-3df5-8dd0-e0360b5a7509",
                                "text": "„Das 1. Stadium ist das der Einwortäußerungen beziehungsweise Holophrasen.“"
                            },
                            {
                                "example_id": "01de7057-caae-4323-95be-962f440cfd5e",
                                "sense_id": "cccae5ac-f1fe-3df5-8dd0-e0360b5a7509",
                                "text": "„Er spricht daher von Einwortsätzen oder »Holophrasen« und meint, daß Kinder, die Einwortäußerungen hervorbringen, schon syntaktische Relationen (zum Beispiel Subjekt - Objekt) beherrschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
