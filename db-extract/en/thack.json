                        "examples": [
                            {
                                "example_id": "1acabc03-889e-48fc-b530-b4eec8be8dc8",
                                "sense_id": "c1208435-c927-3bb9-aa1d-931868ea7317",
                                "text": "1860, Albany Fonblanque, Jun., Hector Mainwaring; or, A lease for lives, Ward and Lock, page 205,\nThack ! thack ! thack ! the heavy hunting whip came down upon the head and shoulders of Charles Dudley."
                            },
                            {
                                "example_id": "e855bc3c-d300-48b3-839e-5dedb379109f",
                                "sense_id": "c1208435-c927-3bb9-aa1d-931868ea7317",
                                "text": "Whishhh—THACK! The strap is a blur as it comes to meet my outstretched hand."
                            }
                        ]
                    }
                ],
