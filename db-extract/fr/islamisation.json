                                                "sense_id": "e1156e3d-81c4-39c2-a16d-71864cf0ad9a",
                                                "text": "Unter Mohammed ging ein großer Teil der Islamisierung vonstatten."
                                            },
                                            {
                                                "example_id": "feaeb664-37d3-4451-8f6f-4a62e76fa21a",
                                                "sense_id": "e1156e3d-81c4-39c2-a16d-71864cf0ad9a",
                                                "text": "„Mehr Erfolg hatten die neuen Herren mit der Islamisierung des Landes.“"
                                            }
