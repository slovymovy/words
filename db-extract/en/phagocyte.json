                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phagozyt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3f1aa0c-aea8-3f9d-bd9a-0dc5cfabeae2",
                                        "entry_id": "fd7b46ea-4012-3cdf-b46f-bfebe68c6354",
                                        "glosses": [
                                            "weißes Blutkörperchen bzw. sogenannte „Fresszelle“, die belebte und unbelebte Gewebs- oder andere Teile aufnehmen, verdauen und unschädlich machen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "127d14f5-174f-4193-9412-2c18697d7024",
                                                "sense_id": "d3f1aa0c-aea8-3f9d-bd9a-0dc5cfabeae2",
                                                "text": "Die Phagozyten sind Zellen der allgemeinen, unspezifischen Abwehr."
                                            },
                                            {
                                                "example_id": "7fcb7c34-7119-45f9-8439-a429e48906f0",
                                                "sense_id": "d3f1aa0c-aea8-3f9d-bd9a-0dc5cfabeae2",
                                                "text": "Diese kommensalen Bakterien, die opportunistische Infektionen verursachen können, besitzen zwar nicht die Eigenschaft, nach Phagozytose weiterleben zu können, dennoch führt deren Aufnahme in einigen Fällen zum Tod der Phagozyten."
                                            },
                                            {
                                                "example_id": "14186501-9028-474d-b5c1-c172371094d1",
                                                "sense_id": "d3f1aa0c-aea8-3f9d-bd9a-0dc5cfabeae2",
                                                "text": "„Als wollte er alle gegen ihn in Stellung gebrachten Vorwürfe bestätigen, ja aufnehmen wie ein gefräßiger Phagozyt, greift er (zur Selbstverortung?) in den Hosenschritt, lässt einen Kollegen mit mannsgroßem Plastikpenis die Bühne stürmen, reicht aber den dargebotenen Tangaslip eines Groupies schnell einem Assistenten weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
