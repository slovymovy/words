                        ]
                    },
                    {
                        "translation_id": "3a53effd-b397-4186-bc1c-b7bf39e39a96",
                        "source_entry_id": "f5ebc17e-1d6d-38ff-b7a3-15e4c88ea6c4",
                        "source_sense_description": "of, or relating to the skeleton",
                        "target_lang_word": "squelettique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squelettique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c82366d-4272-3330-9b04-da9e1bfe455f",
                                        "entry_id": "67d8bfd6-7fa1-3bfb-9418-4eeaaecdbd9d",
                                        "glosses": [
                                            "Relatif aux parties du squelette ou de l'exosquelette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d16b7b2f-5165-4919-81a3-654b1c5f9df2",
                                                "sense_id": "5c82366d-4272-3330-9b04-da9e1bfe455f",
                                                "text": "Ce que nous apprennent ainsi les organes squelettiques nous est répété et confirmé par l'étude des systèmes nerveux et musculaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd8f236c-b4ac-3376-93fa-c7df3742e567",
                                        "entry_id": "67d8bfd6-7fa1-3bfb-9418-4eeaaecdbd9d",
                                        "glosses": [
                                            "Qui tient du squelette ; qui évoque l’image d’un squelette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6721f52b-90c6-4cb7-a146-2ece01a85f41",
                                                "sense_id": "fd8f236c-b4ac-3376-93fa-c7df3742e567",
                                                "text": "Pour la dernière édition de la Semaine de la mode de Sao Paulo, les corps squelettiques ont laissé la place aux silhouettes athlétiques, témoin d’un intérêt mondial pour une vie plus saine."
                                            },
                                            {
                                                "example_id": "626362e4-ec37-4342-ad48-9f781c982d8d",
                                                "sense_id": "fd8f236c-b4ac-3376-93fa-c7df3742e567",
                                                "text": "Benoît ne respire qu’avec le secours de l’oxygène à intervalles réguliers, s’agite alors qu’il devient squelettique, et fume."
                                            },
                                            {
                                                "example_id": "d0cfd525-c088-4b7e-8ee4-2b6acdc01604",
                                                "sense_id": "fd8f236c-b4ac-3376-93fa-c7df3742e567",
                                                "text": "Le malade était d’une maigreure squelettique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5237825d-7e8d-34cc-a31d-acdc16e195ed",
                                        "entry_id": "67d8bfd6-7fa1-3bfb-9418-4eeaaecdbd9d",
                                        "glosses": [
                                            "Très réduit ; peu nombreux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a6c8d22-df8e-4808-8fe4-ac0936b554cc",
                                                "sense_id": "5237825d-7e8d-34cc-a31d-acdc16e195ed",
                                                "text": "D'ailleurs, les années d’effectif squelettique, où mes solistes faisaient office de chœur, je recherchais la présence des gros enfants : ils prenaient chacun la place de deux maigrelets et donnaient de loin l’illusion d'un régiment d'infanterie."
                                            },
                                            {
                                                "example_id": "36d14abc-91a9-4b6e-9187-c4f1414f9fb2",
                                                "sense_id": "5237825d-7e8d-34cc-a31d-acdc16e195ed",
                                                "text": "Croulant sous le poids de charges trop lourdes pour son effectif squelettique, Mont-Mesly regrette de ne pouvoir multiplier à l’infini ses surveillances nocturnes."
                                            },
                                            {
                                                "example_id": "1944eb6f-1f1b-4c10-942a-128a3079bc87",
                                                "sense_id": "5237825d-7e8d-34cc-a31d-acdc16e195ed",
                                                "text": "Ce bataillon squelettique était réduit à 51 hommes valides qui tous avaient les pieds gelés et pourtant aucun n'avait accepté d'être évacué."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7b042c6-5c4c-3fcb-a797-3d1acad94af0",
                                        "entry_id": "67d8bfd6-7fa1-3bfb-9418-4eeaaecdbd9d",
                                        "glosses": [
                                            "Qualifie un sol caillouteux ou sableux, peu profond et peu fertile."
                                        ],
                                        "tags": [
                                            "Agronomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ed02779-bda2-4683-a3ed-c36c3dabbe69",
                                                "sense_id": "a7b042c6-5c4c-3fcb-a797-3d1acad94af0",
                                                "text": "Pelouses sur sol squelettique sec et oligotrophe (schiste, arène gréseuse, sable...), essentiellement sur talus routiers et en lisière forestière, mais aussi en prairies maigres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
