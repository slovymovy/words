                "senses": [
                    {
                        "sense_id": "4ccbfd69-8397-31b0-ba30-1791fae50499",
                        "entry_id": "1b2d732d-c2ff-34d7-85b0-79feda69bdbf",
                        "glosses": [
                            "Travailleur de choc, en Union soviétique et chez ses alliés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02886dce-5d8b-4801-a930-9dcc843506ed",
                                "sense_id": "4ccbfd69-8397-31b0-ba30-1791fae50499",
                                "text": "Le désir de servir la collectivité, d’augmenter le bien-être de tous, a créé le type de « l’oudarnik », de l’ouvrier de choc, qui travaille avec sa brigade, qui, par émulation, dépasse les plans établis."
                            },
                            {
                                "example_id": "c50004b3-86de-4f7d-9d04-7abd603e8aac",
                                "sense_id": "4ccbfd69-8397-31b0-ba30-1791fae50499",
                                "text": "Il est aisé de comprendre que les récits de Paul Vaillant-Couturier soient plus accueillants à l’égard des soviétismes que ceux de l’un de ses contemporains qui, ne partageant pas ses vues politiques, aurait hésité à vanter les exploits de l’oudarnik des oudarniks."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec509c1d-b213-4b85-a08f-6e802ec37f42",
                        "source_entry_id": "1b2d732d-c2ff-34d7-85b0-79feda69bdbf",
                        "source_sense_id": "4ccbfd69-8397-31b0-ba30-1791fae50499",
                        "target_lang_word": "udarnik",
