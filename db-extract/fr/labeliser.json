                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b100f0ec-eaf0-4703-a2ff-201100c967c9",
                                "sense_id": "577e609b-3005-3702-a83c-95975b2070b1",
                                "text": "Deuzio, v'là tous les bouseux du Pendjab qui rappliquent pour s'faire huiler la tronche et s'faire labeliser Sikhs purs jus."
                            },
                            {
                                "example_id": "35356182-05c9-4c6d-8310-9637e4b6d94d",
                                "sense_id": "577e609b-3005-3702-a83c-95975b2070b1",
                                "text": "Les concours à la japonaise ont pour fonction de \"labeliser\" les individus, de leur apposer une griffe certifiant une forme d'excellence qui n'est pas forcément la même que celle à laquelle nous pensons en Occident."
                            }
                        ]
                    }
