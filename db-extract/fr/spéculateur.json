                                            {
                                                "example_id": "95efa7a9-0d61-4859-9b9a-8b66273ecca6",
                                                "sense_id": "8a42721e-be46-3e82-9ddd-f61f115c43ac",
                                                "text": "a bold and paradoxical speculator"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8a1f541-c2a8-33fc-afb4-53377c80f7e9",
                                        "entry_id": "d904bffe-1187-3d2a-8370-0dc3507654df",
                                        "glosses": [
                                            "One who forms theories; a theorist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9db585a-80db-4375-93a6-6213f5fd736e",
                                                "sense_id": "e8a1f541-c2a8-33fc-afb4-53377c80f7e9",
                                                "text": "[…] in things of Fact, the People are as much to be believed, as the most subtle Philosophers and Speculators, since here sense is the Judge."
                                            },
                                            {
                                                "example_id": "e65fc3ea-f0b7-4a43-8974-2089329b9bdc",
                                                "sense_id": "e8a1f541-c2a8-33fc-afb4-53377c80f7e9",
                                                "text": "For, in the earlier part of the seventeenth century, a speculator who had dared to affirm that the human soul is by its nature mortal, and does, in the great majority of cases, actually die with the body, would have been burned alive in Smithfield."
                                            }
                                        ]
                                    },
