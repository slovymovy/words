                        "examples": [
                            {
                                "example_id": "2b5ef35b-eebf-4056-baac-22a497ac482c",
                                "sense_id": "bc5b5362-2cba-3f5b-ba0d-ebe1dd9cb266",
                                "text": "Het is weer de vierendertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "ae8fe2d2-bf01-4a6b-ba35-0f5c5bc3a3b2",
                                "sense_id": "bc5b5362-2cba-3f5b-ba0d-ebe1dd9cb266",
                                "text": "Haar vijfendertigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de vierendertig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "57234a08-0f5a-3b23-8dc2-4a733f7f29dc",
                        "entry_id": "0226164b-6268-311b-b52e-8dfebc14304c",
                        "glosses": [
