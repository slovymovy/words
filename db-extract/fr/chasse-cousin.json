                        "glosses": [
                            "Fleuret qui ne fléchit pas."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e45d8da0-0320-4df0-9657-b820efd8bae2",
                                "sense_id": "ed0c9843-76c6-3567-97f2-351f39fb6276",
                                "text": "chasse-cousin, subst. mas. (chacekouzein), fleuret fermé et qui ne plie pas, propre à bourrer ceux qui font assaut. — Mauvais vin. — Au fig., tout ce qui peut éloigner les importuns. Il est fam. — Au plur., des chasse-cousins, des gens chargés de chasser les coquins."
                            }
