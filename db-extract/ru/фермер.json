                                        "sense_id": "6ed5e9fd-31d6-3fab-a3ef-05ccf420df45",
                                        "entry_id": "bb3d9e82-beaa-3918-9085-24b0a9d1e241",
                                        "glosses": [
                                            "One who takes taxes, customs, excise, or other duties, to collect for a certain rate per cent."
                                        ],
