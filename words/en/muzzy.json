        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d8f1b40b-0f1a-3f1e-a559-fd301492de5c",
                    "sense_definition": "Confused, dazed, or unable to think clearly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unclear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waking up in the middle of the night left him feeling completely <w>muzzy</w> and disoriented.",
                            "target_lang_translations": {
                                "de": "Mitten in der Nacht aufzuwachen ließ ihn sich völlig <w>benommen</w> und desorientiert fühlen.",
                                "fr": "Le fait de se réveiller au milieu de la nuit l'a laissé complètement <w>vaseux</w> et désorienté.",
                                "ru": "Проснувшись посреди ночи, он почувствовал себя совершенно <w>ошалевшим</w> и дезориентированным."
                            }
                        },
                        {
                            "text": "Her cold medication made her head feel <w>muzzy</w> all through the morning lecture.",
                            "target_lang_translations": {
                                "de": "Ihre Erkältungsmedikamente machten ihren Kopf während der gesamten Morgenvorlesung <w>dösig</w>.",
                                "fr": "Son médicament contre le rhume lui a laissé la tête toute <w>embrumée</w> tout au long du cours magistral du matin.",
                                "ru": "Из-за лекарства от простуды у неё всю утреннюю лекцию была <w>мутная</w> голова."
                            }
                        }
                    ],
                    "synonyms": [
                        "confused",
                        "puzzled",
                        "perplexed"
                    ],
                    "common_phrases": [
                        "muzzy head",
                        "feeling muzzy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe foggy or groggy mental states"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Verwirrt, benommen oder unfähig, klar zu denken.",
                        "fr": "Confus, hébété ou incapable de réfléchir clairement.",
                        "ru": "Затуманенный, одурманенный, неспособный ясно мыслить."
                    },
                    "translations": {
