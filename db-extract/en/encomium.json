                "entry_id": "4e4d532c-e22b-3ebf-b0d3-439c43b5782e",
                "word": "encomium",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "50eb251b-395b-4ef4-a4c4-cff6a897520e",
                        "entry_id": "4e4d532c-e22b-3ebf-b0d3-439c43b5782e",
