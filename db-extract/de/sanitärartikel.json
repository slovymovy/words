                ],
                "senses": [
                    {
                        "sense_id": "9b2a3d61-0557-367e-9762-d96c34445858",
                        "entry_id": "ccd7f4c7-1061-3253-a4c8-5f8886ccba33",
                        "glosses": [
                            "Ware, die im Rahmen der persönlichen Hygiene Verwendung findet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d478ce07-cc2d-4795-9cfe-be639af3a7f8",
                                "sense_id": "9b2a3d61-0557-367e-9762-d96c34445858",
                                "text": "Meine persönlichen Sanitärartikel bewahre ich in meiner Kulturtasche auf."
                            },
                            {
                                "example_id": "ce5d582e-6f1f-407c-b15a-4455742b1bf4",
                                "sense_id": "9b2a3d61-0557-367e-9762-d96c34445858",
                                "text": "„Weitere Aufgaben waren die Kontrolle und Überwachung der Tisch- und Bettwäsche, der Handtücher, Sanitärartikel, Geschirr und Gläser. Fehlende Dinge mussten ergänzt werden.“"
                            },
                            {
                                "example_id": "1b04ee08-86db-4746-a3b9-b18b169267df",
                                "sense_id": "9b2a3d61-0557-367e-9762-d96c34445858",
                                "text": "„Parallel dazu wurde in den 80-ziger Jahren damit begonnen, das Panel auf die Warengruppen des Non-Foods auszubauen. Zu dem Bereich gehören Elektrogeräte, Bestecke und Kochgeschirre, oder alle Teilwarengruppen der Sanitärartikel.“"
                            },
                            {
                                "example_id": "2111e615-6bcf-41f0-a304-710eeca743a9",
                                "sense_id": "9b2a3d61-0557-367e-9762-d96c34445858",
                                "text": "„Auf den örtlichen Märkten gibt es vornehmlich Waren des alltäglichen Bedarfs wie Blusen und Jeans, Hemden, Taschen, Messer, Sanitärartikel und Medizin.“"
                            },
                            {
                                "example_id": "2c2097d9-e5af-4a64-abee-503f9dd5c5bb",
                                "sense_id": "9b2a3d61-0557-367e-9762-d96c34445858",
                                "text": "„Es kann als Unterglasurfarbe wie auch als Farbkörper für Glasuren auf Wandplatten und Sanitärartikeln bei Brenntemperaturen zwischen 1000 und 1350 °C verwendet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
