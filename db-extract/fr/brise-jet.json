                "senses": [
                    {
                        "sense_id": "2d5c30cd-786f-302b-aaa3-7da94de8de23",
                        "entry_id": "19080e25-88b5-3009-b43c-13032a79010d",
                        "glosses": [
                            "Accessoire ajouté à l’extrémité d’un tuyau, d’un robinet, pour réduire la violence du jet et limiter les éclaboussures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd7b588-f633-4d44-ac37-7c866af92ea8",
                                "sense_id": "2d5c30cd-786f-302b-aaa3-7da94de8de23",
                                "text": "Ajoutons que le brise-jet répand le purin sur de grandes largeurs, et qu’il n’est pas encombrant comme les divers appareils utilisés jusqu’ici: on le ferme à l’aide d’un obturateur des plus simples."
                            },
                            {
                                "example_id": "9046ebca-e927-4271-8994-c222af0a75e7",
                                "sense_id": "2d5c30cd-786f-302b-aaa3-7da94de8de23",
                                "text": "Il se haussa sur la pointe des pieds, se pencha, fit couler l’eau du robinet sur son visage, téta l’orifice du brise-jet, tordit le court tuyau de caoutchouc rayé pour faire jaillir l’eau contre le mur où des gouttelettes s’accrochèrent."
                            },
                            {
                                "example_id": "afcf87ec-e814-4799-9a03-a7e95d2d8501",
                                "sense_id": "2d5c30cd-786f-302b-aaa3-7da94de8de23",
                                "text": "La norme NF077 MM détaille les caractéristiques des mitigeurs, électroniques ou pas, destinés au milieu médical : alimentations en cuivre ou flexibles PEX ou silicone, brise-jet plutôt qu’aérateur, manette de commande d’au moins 110 mm de long, longueur de bec d’au moins 100 mm (mitigeur mural : 175 mm), hauteur de goutte d’au moins 100 mm."
                            }
                        ]
                    }
                ],
