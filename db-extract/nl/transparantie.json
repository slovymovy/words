                                "sense_id": "80427d99-b25a-3442-9bd4-865501a6cb51",
                                "text": "Dit papier heeft een grote transparantie."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3fc3086-53c7-38b9-be24-4930a4548681",
                        "entry_id": "bb433009-6174-3f5c-9fa6-50843d82032f",
                        "glosses": [
