                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "baddcdf9-e2ca-404b-93ff-a294c37575e3",
                                "sense_id": "9012e6fc-c036-3c78-9992-1c3079f84e31",
                                "text": "Politieagent op nachtbezoek: ‘De Jordaan, voor mij mogen ze vanaf het Centraal station een bulldozer d'rover en moderne huizen d'rvoor in de plaats. Allemaal vullis, moet tegen de grond.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "22ce387c-3453-31d9-abb2-d68f5ab1f535",
                        "entry_id": "cdc8d394-42b1-36c1-8aa6-85c39c526626",
                        "glosses": [
                            "walgelijk persoon of gezelschap"
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e6eee6b1-fc45-428a-afce-0dcfe9030f9f",
                                "sense_id": "22ce387c-3453-31d9-abb2-d68f5ab1f535",
                                "text": "Elke avond, elke nacht weer diezelfde optocht: Georgi, Lavrenti, Nikita, daar zijn ze weer - vullis en oplichters."
                            }
                        ]
                    }
