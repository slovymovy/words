                                "target_senses": [
                                    {
                                        "sense_id": "dde46b46-5f29-339d-9ea4-db39cb887648",
                                        "entry_id": "f9401dec-a1fe-3376-a6f9-1037eae44a49",
                                        "glosses": [
                                            "arte de preparar alimentos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d837779-18de-4058-bb61-35afe379711b",
                                                "sense_id": "dde46b46-5f29-339d-9ea4-db39cb887648",
                                                "text": "O livro de culinária está em cima da mesa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "661da6ee-44f7-4835-81c9-a0835acb8ceb",
                        "source_entry_id": "03db88a5-36b3-3a83-905f-70424ecdb75f",
                        "source_sense_id": "6d8ef790-fd6e-32cc-b738-0a9172c0f701",
                        "source_sense_description": "Kunst der kreativen oder traditionellen Zubereitung von Lebensmitteln",
                        "target_lang_word": "кухня",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кухня",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4450e8bb-2534-3c96-bdb0-bab6075bc07a",
                                        "entry_id": "27219f07-8323-3e40-83d3-70a5e96ceff0",
                                        "glosses": [
                                            "помещение для приготовления пищи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d11fc66-8562-4d59-88fa-24a33a531b23",
                                                "sense_id": "4450e8bb-2534-3c96-bdb0-bab6075bc07a",
                                                "text": "Окна были отворены настежь, слышно было, как на кухне стучали ножами, и доносился запах жареного лука."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e5d34b9-463e-307c-b13f-5102786cc5a9",
                                        "entry_id": "27219f07-8323-3e40-83d3-70a5e96ceff0",
                                        "glosses": [
                                            "перен. кухонный гарнитур, набор мебели для обстановки кухни [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51b26e45-2638-4f9b-b44b-6660d49b7461",
                                                "sense_id": "5e5d34b9-463e-307c-b13f-5102786cc5a9",
                                                "text": "В Икее появилась новая кухня."
                                            },
                                            {
                                                "example_id": "4a127bf2-65ad-4211-a734-986714703e2e",
                                                "sense_id": "5e5d34b9-463e-307c-b13f-5102786cc5a9",
                                                "text": "И если обычно дома моды осторожничают и пробуют себя в мелочах, то Чапурин решил начать с крупного ― мебели и даже, возможно, кухонь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae9dcdf9-1fc0-333d-aed1-791e87e55271",
                                        "entry_id": "27219f07-8323-3e40-83d3-70a5e96ceff0",
                                        "glosses": [
                                            "перен. совокупность блюд и кулинарных приёмов, свойственных какой-либо общности людей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5908c05-1c15-41ae-8aa5-be7a44991f13",
                                                "sense_id": "ae9dcdf9-1fc0-333d-aed1-791e87e55271",
                                                "text": "Здесь давались небольшие обеды особенно знатным иностранцам; кушанья французской кухни здесь не подавались, хотя вина шли и французские, но перелитые в старинную посуду с надписью — фряжское, фалернское, мальвазия, греческое и т. п., а для шампанского подавался огромный серебряный жбан, в ведро величиной, и черпали вино серебряным ковшом, а пили кубками."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "596df473-93a1-34ce-82e4-547a3e4e5802",
                                        "entry_id": "27219f07-8323-3e40-83d3-70a5e96ceff0",
                                        "glosses": [
                                            "перен., разг. внутренние, скрытые механизмы какого-либо явления или действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "300ed1ca-a3a6-42eb-8be5-c38bfe1808d1",
                                                "sense_id": "596df473-93a1-34ce-82e4-547a3e4e5802",
                                                "text": "Мне так и не удалось разобраться в этой политической кухне."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acd0ee0b-ae7e-3201-bcd4-da5086a34f2b",
                                        "entry_id": "27219f07-8323-3e40-83d3-70a5e96ceff0",
                                        "glosses": [
                                            "перен., разг. еда, пища, кормление, работы на кухне [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47098713-68d0-4e94-bb9e-60f27b6ef8ff",
                                                "sense_id": "acd0ee0b-ae7e-3201-bcd4-da5086a34f2b",
                                                "text": "На мне ― кухня и готовка, на нём ― уборка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9459c2b-7aa2-3f75-b8d0-82a36659a7c0",
                                        "entry_id": "27219f07-8323-3e40-83d3-70a5e96ceff0",
                                        "glosses": [
                                            "перен. оборудование для приготовления пищи вне помещения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0ffe998-e79f-470e-84a1-3e8cde3fa2ad",
                                                "sense_id": "c9459c2b-7aa2-3f75-b8d0-82a36659a7c0",
                                                "text": "Любой почитатель таланта Виктора Берковского, Александра Городницкого, Григория Гладкова или Галины Хомчик мог запросто поговорить с ними, «поймать» их рядом с полевой кухней, которую установила здесь служба МЧС."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
