                                    {
                                        "sense_id": "8e640649-edc6-3aaf-9814-add7e8cc7505",
                                        "entry_id": "a2abeef8-7101-3e77-9f8a-733aa6c70cbe",
                                        "glosses": [
                                            "The quality of being earnest; sincerity; seriousness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5feb9fb9-7726-4274-a8d9-7286110d0f37",
                                                "sense_id": "8e640649-edc6-3aaf-9814-add7e8cc7505",
                                                "text": "22 March 2012, Scott Tobias, AV Club The Hunger Gameshttp://www.avclub.com/articles/the-hunger-games,71293/\nShe’s joined, on the boys’ side, by Peeta (Josh Hutcherson), a baker’s son whose earnestness masks a gift for strategy that Katniss lacks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88ae39f8-95d4-429e-89be-41040d978a14",
