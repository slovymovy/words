                        "tags": [],
                        "examples": [
                            {
                                "example_id": "315b6b59-ec3e-4b19-806d-9371d41d5dac",
                                "sense_id": "bd9b8987-33d3-3faf-b17f-cbdf86175898",
                                "text": "Jetfighter kwam op het idee om alle dag-afstanden een naam te geven. Deze afstanden waren natuurlijk in Amerikaanse miles en de namen waren ook typisch Amerikaans. Het was een ludieke manier om de lange kilometers van de dag te verzachten."
                            },
                            {
                                "example_id": "87a68c73-0590-4843-9c52-a6f17093ec21",
                                "sense_id": "bd9b8987-33d3-3faf-b17f-cbdf86175898",
                                "text": "Wandelliefhebbers kunnen dit jaar tijdens de Nijmeegse Vierdaagse niet kiezen voor de afstand van 55 kilometer. Dat heeft het bestuur van het wandelevenement donderdag bekendgemaakt. De dagafstand werd afgelopen jaar tijdens de honderdste editie aan het keuzemenu toegevoegd maar wandelaars hebben er voor de komende editie te weinig animo voor getoond."
                            }
                        ]
                    }
