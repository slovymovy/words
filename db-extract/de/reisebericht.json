                "senses": [
                    {
                        "sense_id": "a613ad76-40e4-3890-b79a-e3c58f523557",
                        "entry_id": "8cdf9ebe-34c0-3103-b5c6-e4e27cb3ce49",
                        "glosses": [
                            "Bericht über eine Reise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "289562fd-54d8-4018-a90b-8f9efed83a12",
                                "sense_id": "a613ad76-40e4-3890-b79a-e3c58f523557",
                                "text": "„Der Wert der vorgelegten Reiseberichte lag zu Zeiten Goethes und Humboldts in der Originalität der persönlich erlebten, geschilderten und gedeuteten Landschaft.“"
                            },
                            {
                                "example_id": "9aa3aa76-19a6-4fa6-8ae6-371465c24682",
                                "sense_id": "a613ad76-40e4-3890-b79a-e3c58f523557",
                                "text": "„Sie hatte diesen 1879 erschienenen Reisebericht über Zentralfrankreich sogar in ihrem Bücherschrank stehen.“"
                            },
                            {
                                "example_id": "38ecf0a0-d1a2-4959-8401-aa8ec30700d1",
                                "sense_id": "a613ad76-40e4-3890-b79a-e3c58f523557",
                                "text": "„Das Publikumsinteresse ist so groß, dass regelmäßig illustrierte Reiseberichte erscheinen.“"
                            },
                            {
                                "example_id": "67177dfe-7b40-4a15-b208-7db6b7dd58d5",
                                "sense_id": "a613ad76-40e4-3890-b79a-e3c58f523557",
                                "text": "„Dennoch liest man jene alten Reiseberichte heute mit gemischten Gefühlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
