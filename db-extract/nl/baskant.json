                            {
                                "example_id": "2892fdd1-b310-4752-a4f2-6f6e98bb83f1",
                                "sense_id": "2f2c9970-0070-3a94-9c9a-9169d4ef0375",
                                "text": "De Principaal is 7 tot 18 sterk. Dit houdt in dat het register in de baskant 7 pijpen per toets telt, in de discant maar liefst 18."
                            },
