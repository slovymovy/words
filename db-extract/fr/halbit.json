                "senses": [
                    {
                        "sense_id": "d6c9eeaf-8b11-351c-a86e-b2f21e7ee1b2",
                        "entry_id": "50c7ea94-6f13-3ea3-95b4-63c0c66e13b6",
                        "glosses": [
                            "Boisson qui provient de la fermentation alcoolique d'un mélange de jus de pommes et de jus de poires."
                        ],
                        "tags": [
                            "Cidrologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e2228fba-9ed8-4222-9efc-b49b86951ef0",
                                "sense_id": "d6c9eeaf-8b11-351c-a86e-b2f21e7ee1b2",
                                "text": "La Revue pomologique, le Cidre et le Poiré, Argentan, 1ᵉʳ octobre 1889, contient: Le bouilleur de crû; le cidre malade ; fermentation; de la greffe; le halbit (ou halbique, mélange de jus de pommes et de poires) ; les cidres américains, […]."
                            },
                            {
                                "example_id": "78d669c9-c4b1-43b7-81ff-3e06f9fc0801",
                                "sense_id": "d6c9eeaf-8b11-351c-a86e-b2f21e7ee1b2",
                                "text": "Dans l'Orne, on boit souvent du halbit, liquide extrait d'un mélange de pommes et de poires. Ce breuvage, de goût agréable, est usité lorsque la disette ne permet pas de réunir en même temps assez de fruits de chacune de ces espèces, […]."
                            },
                            {
                                "example_id": "a41fb6f5-b066-4b39-a877-4aeb171cf947",
                                "sense_id": "d6c9eeaf-8b11-351c-a86e-b2f21e7ee1b2",
                                "text": "Il faut arriver au XIXᵉ siècle pour trouver les quatre seuls auteurs qui, parmi tous les cidrologues, parlent du mélange des pommes et des poires et désignent le produit par un nom bien spécial : « halbit » pour Louis Dubois, de Brébisson, Power, et « Cidresse » pour Hautecorne."
                            }
                        ]
                    }
