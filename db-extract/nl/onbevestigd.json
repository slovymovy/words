                "senses": [
                    {
                        "sense_id": "e0fb812e-7e7b-3adb-a723-8cb745cfa16f",
                        "entry_id": "1fb84b71-42d6-3d55-87b1-992821045b3b",
                        "glosses": [
                            "wat nog niet helemaal zeker is, wat alleen nog via onofficiële bronnen bekend is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc796b2b-ff5c-44af-8b9e-3d369e2f04f5",
                                "sense_id": "e0fb812e-7e7b-3adb-a723-8cb745cfa16f",
                                "text": "Momenteel zouden er nog zo’n 150.000 kamelen uit Qatar in Saoedi-Arabië rondlopen. Volgens onbevestigde rapporten werden tussen 12.000 en 25.000 dieren getroffen door de diplomatieke crisis in de Golfstaten. 'Maar al te vaak zijn dieren vergeten slachtoffers van oorlogen en conflicten', zegt een woordvoerder van SPANA nog, een internationale dierenwelzijnsorganisatie."
                            },
                            {
                                "example_id": "36889eae-2c5e-4679-be2d-0dd7449e3469",
                                "sense_id": "e0fb812e-7e7b-3adb-a723-8cb745cfa16f",
                                "text": "Op de websites staan slogans als 'in rock geloven we' en 'je hebt nog nooit een politicus als ik ontmoet'. De site verwijst door naar een pagina op de website van zijn record label Warner Bros, waar promotieartikelen voor de voor nu onbevestigde campagne kunnen worden gekocht."
                            }
                        ]
                    }
