                "senses": [
                    {
                        "sense_id": "0e3b0e20-f4e0-38ee-88b4-6847b425b515",
                        "entry_id": "c86fd786-5154-3dbc-aae4-74fd09efd933",
                        "glosses": [
                            "Rosine"
                        ],
                        "tags": [
                            "Austrian German",
