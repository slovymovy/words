    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "83709fd0-fe30-30f7-bc57-9549beabb788",
                    "sense_definition": "Gibt die Person oder Sache an, für die etwas bestimmt ist oder der etwas zugutekommen soll.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "zuweisung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich habe ein kleines Geschenk <w>für</w> dich aus dem Urlaub mitgebracht."
                        },
                        {
                            "text": "Diese wichtige Nachricht ist nur <w>für</w> deinen Vater bestimmt."
                        }
                    ],
                    "common_phrases": [
                        "ein Geschenk für",
                        "nur für dich"
                    ]
                },
                {
                    "sense_id": "dadf959c-6c03-3020-8969-c1701d498d36",
                    "sense_definition": "Gibt eine zeitliche Dauer oder einen festgelegten Zeitpunkt an.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "zeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir fahren im Sommer <w>für</w> zwei Wochen an die Ostsee."
                        },
                        {
                            "text": "Sie hat die Wohnung <w>für</w> immer verlassen und kehrt nicht zurück."
                        }
                    ],
                    "common_phrases": [
                        "für immer",
                        "für zwei Wochen"
                    ]
                },
                {
                    "sense_id": "d3ed27cf-74d6-31c8-a4b0-b52e17b24665",
                    "sense_definition": "Drückt die Befürwortung von oder Zustimmung zu einer Sache oder Person aus.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "befuerwortung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bei der heutigen Abstimmung bin ich eindeutig <w>für</w> den neuen Vorschlag."
                        },
                        {
                            "text": "Die meisten Mitglieder stimmen <w>für</w> die Einführung der neuen Regeln."
                        }
                    ],
                    "common_phrases": [
                        "für etwas sein",
                        "für jemanden stimmen"
                    ]
                },
                {
                    "sense_id": "027bd5dd-b796-3157-89cf-ad8095c6e8ee",
                    "sense_definition": "Gibt einen Preis, Tauschwert oder Gegenwert an.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "preis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat das alte Fahrrad auf dem Flohmarkt <w>für</w> fünf Euro erworben."
                        },
                        {
                            "text": "Niemand möchte mehr <w>für</w> so wenig Geld den ganzen Tag arbeiten."
                        }
                    ],
                    "common_phrases": [
                        "für wenig Geld",
                        "für fünf Euro"
                    ]
                },
                {
                    "sense_id": "6bf1dd32-9428-3b85-9acc-e2351a4aea7a",
                    "sense_definition": "Dient in der Fügung 'was für' der Nachfrage nach der Art, Beschaffenheit oder Eigenschaft von jemandem oder etwas.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Was <w>für</w> ein Buch liest du gerade in deiner Freizeit?"
                        },
                        {
                            "text": "Was <w>für</w> eine schöne Überraschung hast du uns da mitgebracht!"
                        }
                    ],
                    "common_phrases": [
                        "was für ein",
                        "was für eine"
                    ]
                },
                {
                    "sense_id": "4de61f26-93d6-311a-a3bf-d71976e7c2b3",
                    "sense_definition": "Verbindet Verben der Einschätzung oder Wahrnehmung mit einer Bewertung oder Meinung.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "einschaetzung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich halte diese schnelle Entscheidung durchaus <w>für</w> richtig und notwendig."
                        },
                        {
                            "text": "Alle Beteiligten halten den vorgelegten Entwurf <w>für</w> ungeeignet."
                        }
                    ],
                    "common_phrases": [
                        "halten für",
                        "halten für richtig"
                    ]
                },
                {
                    "sense_id": "25a13fad-bcc6-39a3-92c9-2ca8e2f635dd",
                    "sense_definition": "Drückt Stellvertretung aus oder gibt an, anstelle von jemandem zu handeln.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vertretung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein Anwalt wird diesen Brief morgen stellvertretend <w>für</w> mich beantworten."
                        },
                        {
                            "text": "Die Klassensprecherin möchte heute im Namen aller <w>für</w> die Schüler sprechen."
                        }
                    ],
                    "common_phrases": [
                        "stellvertretend für",
                        "sprechen für"
                    ]
                },
                {
                    "sense_id": "cbce72ad-ec71-3149-a6ee-c25a2e5fe554",
                    "sense_definition": "Drückt eine Einschränkung oder Relation im Hinblick auf einen Maßstab oder eine Erwartung aus.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vergleich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Für</w> sein junges Alter spielt dieser Junge schon meisterhaft Schach."
                        },
                        {
                            "text": "<w>Für</w> einen Anfänger beherrscht sie die schwierigen Techniken bereits sehr sicher."
                        }
                    ],
                    "common_phrases": [
                        "für sein Alter",
                        "für einen Anfänger"
                    ]
                },
                {
                    "sense_id": "dc50856f-7023-3981-81d4-24eb303eb851",
                    "sense_definition": "Gibt den Grund, die Ursache oder den Anlass für eine Handlung oder ein Gefühl an.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grund",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir danken Ihnen sehr herzlich <w>für</w> die freundliche Unterstützung."
                        },
                        {
                            "text": "Der Geschäftsführer muss die volle Verantwortung <w>für</w> den Verlust übernehmen."
                        }
                    ],
                    "common_phrases": [
                        "danken für",
                        "Verantwortung für"
                    ]
                },
                {
                    "sense_id": "fd085f7b-fdb7-3fc5-9209-64942dae89bf",
                    "sense_definition": "Verbindet zwei gleiche Substantive zur Kennzeichnung einer sukzessiven Abfolge oder Wiederholung.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abfolge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir sollten diese schwierige Aufgabe Schritt <w>für</w> Schritt gemeinsam lösen."
                        },
                        {
                            "text": "Der Zeuge las die Erklärung Wort <w>für</w> Wort vor Gericht vor."
                        }
                    ],
                    "common_phrases": [
                        "Schritt für Schritt",
                        "Wort für Wort"
                    ]
                },
                {
                    "sense_id": "afa657b1-ee94-3040-8c29-13d28bd62427",
                    "sense_definition": "Gibt den Anwendungsbereich oder das Leiden an, gegen das ein Mittel wirken soll.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zweck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Arzt verschrieb mir wirksame Tabletten <w>für</w> meine starken Halsschmerzen."
                        },
                        {
                            "text": "Haben Sie in Ihrer Apotheke ein gutes Mittel <w>für</w> trockene Haut?"
                        }
                    ],
                    "common_phrases": [
                        "Tabletten für",
                        "Mittel für"
                    ]
                },
                {
                    "sense_id": "6cbc8374-62d9-3c37-b62e-38922164eb54",
                    "sense_definition": "Gibt eine finale Absicht oder einen Zweck bei einem Infinitiv an.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zweck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Nachbar holte sein Werkzeug, <w>für</w> das kaputte Gartentor zu reparieren."
                        },
                        {
                            "text": "Sie beeilte sich sehr, <w>für</w> den pünktlichen Zug noch rechtzeitig zu erreichen."
                        }
                    ],
                    "synonyms": [
                        "um"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "regional statt 'um ... zu'"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed2f2b4b-39b5-3ca0-85ec-a6dc7c5405b0",
                    "sense_definition": "Dasjenige, was zu Gunsten einer Sache oder Entscheidung spricht; das befürwortende Argument.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor dem Kauf des Hauses wägten sie das <w>Für</w> und Wider gründlich ab."
                        },
                        {
                            "text": "Bei der Debatte wurde jedes <w>Für</w> sorgsam gegen die Gegenargumente gestellt."
                        }
                    ],
                    "synonyms": [
                        "Pro"
                    ],
                    "antonyms": [
                        "Wider"
                    ],
                    "common_phrases": [
                        "das Für und Wider"
                    ]
                }
            ]
        }
    ]
}