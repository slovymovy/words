{
    "word_family": [
        "restraint",
        "restrained"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd9f96f4-83ec-3333-81de-4337ccfaa1e9",
                    "sense_definition": "To control or keep in check.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to <w>restrain</w> one's anger when being treated unfairly.",
                            "target_lang_translations": {
                                "cs": "Je těžké <w>krotit</w> svůj hněv, když se s vámi zachází nespravedlivě."
                            }
                        },
                        {
                            "text": "The government tried to <w>restrain</w> inflation by raising interest rates.",
                            "target_lang_translations": {
                                "cs": "Vláda se pokusila <w>brzdit</w> inflaci zvýšením úrokových sazeb."
                            }
                        }
                    ],
                    "synonyms": [
                        "check"
                    ],
                    "common_phrases": [
                        "restrain anger",
                        "restrain inflation"
                    ],
                    "target_lang_definitions": {
                        "cs": "Ovládat nebo udržovat pod kontrolou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mít pod kontrolou",
                                "target_lang_sense_clarification": "udržovat emoce nebo situaci v mezích"
                            },
                            {
                                "target_lang_word": "krotit",
                                "target_lang_sense_clarification": "tlumit silné emoce nebo projevy"
                            },
                            {
                                "target_lang_word": "brzdit",
                                "target_lang_sense_clarification": "zpomalovat nebo omezovat vývoj něčeho"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f26c61d-a31f-3209-acd9-3004e3fa27c8",
                    "sense_definition": "To restrict or limit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New laws will <w>restrain</w> the power of large corporations.",
                            "target_lang_translations": {
                                "cs": "Nové zákony <w>omezí</w> moc velkých korporací."
                            }
                        },
                        {
                            "text": "The budget <w>restrain</w> spending on new projects.",
                            "target_lang_translations": {
                                "cs": "Rozpočet <w>omezuje</w> výdaje na nové projekty."
                            }
                        }
                    ],
                    "synonyms": [
                        "limit"
                    ],
                    "common_phrases": [
                        "restrain spending"
                    ],
                    "target_lang_definitions": {
                        "cs": "Omezit nebo stanovit hranice."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "omezit",
                                "target_lang_sense_clarification": "stanovit limity nebo snížit rozsah"
                            },
                            {
                                "target_lang_word": "oklešťovat",
                                "target_lang_sense_clarification": "postupně snižovat rozsah nebo moc"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41626a0b-9bfc-3024-8f7c-f6cd1c85b3e5",
                    "sense_definition": "To deprive of liberty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police had to <w>restrain</w> the suspect to prevent him from escaping.",
                            "target_lang_translations": {
                                "cs": "Policie musela podezřelého <w>znehybnit</w>, aby mu zabránila v útěku."
                            }
                        },
                        {
                            "text": "The patient was <w>restrained</w> for his own safety during the medical procedure.",
                            "target_lang_translations": {
                                "cs": "Pacient byl během lékařského zákroku <w>poután</w> pro svou vlastní bezpečnost."
                            }
                        }
                    ],
                    "synonyms": [
                        "confine",
                        "detain"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zbavit svobody pohybu nebo fyzicky znehybnit."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "znehybnit",
                                "target_lang_sense_clarification": "fyzicky zabránit v pohybu"
                            },
                            {
                                "target_lang_word": "omezit na svobodě",
                                "target_lang_sense_clarification": "právní nebo fyzické omezení pohybu"
                            },
                            {
                                "target_lang_word": "poutat",
                                "target_lang_sense_clarification": "fyzické zajištění osoby"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45718950-509a-33d2-962f-c07c70203045",
                    "sense_definition": "To strain again.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>restrain</w> the sauce to ensure it is perfectly smooth.",
                            "target_lang_translations": {
                                "cs": "Omáčku byste měli <w>přecedit</w>, aby byla dokonale hladká."
                            }
                        },
                        {
                            "text": "After the first pass, <w>restrain</w> the mixture to remove any remaining pulp.",
                            "target_lang_translations": {
                                "cs": "Po prvním průchodu směs <w>přeceďte</w>, abyste odstranili veškerou zbývající dužinu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Znovu přecedit nebo přefiltrovat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přecedit",
                                "target_lang_sense_clarification": "kulinářský proces filtrace"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}