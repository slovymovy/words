                "senses": [
                    {
                        "sense_id": "d02be319-e4ed-3309-814f-abb6caef6809",
                        "entry_id": "d1ae0ea3-f0bc-3edc-909f-56f9cf846c0c",
                        "glosses": [
                            "Streitgespräch, Diskussion im Senat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f56dc2ef-0745-482f-b7f0-a37c9322de89",
                                "sense_id": "d02be319-e4ed-3309-814f-abb6caef6809",
                                "text": "„Ein Termin für den Beginn der Senatsdebatte steht noch nicht fest.“"
                            },
                            {
                                "example_id": "04106ba3-f86c-4cdc-b4ce-44b88637ffa3",
                                "sense_id": "d02be319-e4ed-3309-814f-abb6caef6809",
                                "text": "„Der republikanische Mehrheitsführers Mitch McConnell schrieb am Mittwoch (Ortszeit) auf Twitter, er habe den Antrag zur Beendigung der Senatsdebatte über die Nominierung Kavanaughs eingereicht.“"
                            },
                            {
                                "example_id": "373e664b-acd5-4c2f-a712-b76da0f33d1b",
                                "sense_id": "d02be319-e4ed-3309-814f-abb6caef6809",
                                "text": "„Führende Vertreter beider Seiten äußerten sich aber optimistisch, dass es im Zuge der anstehenden vermutlich wochenlangen Senatsdebatte zur Annäherung bei Streitpunkten kommt.“"
                            },
                            {
                                "example_id": "bfb8838a-6a9d-4c45-8a8f-ef720180e714",
                                "sense_id": "d02be319-e4ed-3309-814f-abb6caef6809",
                                "text": "„Seit sechs Jahren ignoriert de Gaulle seinen Verfassungs-Vize bei offiziellen Empfängen und untersagte seinen Ministern, an Senatsdebatten auch nur als Zuhörer teilzunehmen.“"
                            },
                            {
                                "example_id": "e01ccdca-f14d-4e8a-992b-aef198f5f03e",
                                "sense_id": "d02be319-e4ed-3309-814f-abb6caef6809",
                                "text": "„In Senatsdebatten warnten römische Politiker davor, die Karthager könnten Italien durch Expansion gewissermaßen einkreisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
