                    {
                        "translation_id": "471a043f-bda0-4e83-b336-3183c5eb4b8f",
                        "source_entry_id": "5ad2e2ee-70a9-30d8-b7a6-f23c07e1295f",
                        "source_sense_description": "Muslim leader",
                        "target_lang_word": "imam",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imam",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ca4fc7-aa24-35f6-9635-241d50cee7fa",
                                        "entry_id": "1a94ce50-f3c0-3044-a212-18c22c161bc4",
                                        "glosses": [
                                            "voorganger bij het gebed"
                                        ],
                                        "tags": [
                                            "islam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "591ca161-5438-480c-a4e7-d7c02c1d0d2a",
                                                "sense_id": "c9ca4fc7-aa24-35f6-9635-241d50cee7fa",
                                                "text": "Een moskee is niet zoals een kerk het huis van God op aarde, maar wel een plaats waar de gemeenschap samenkomt. Vandaar dat een moskee meestal een eenvoudig rechthoekig gebouw is, georiënteerd naar Mekka, met een nis of ‘mihrab’ waar de imam voorgaat in het gebed en met een preekstoel of ‘minbar’."
                                            },
                                            {
                                                "example_id": "f83282da-824b-4749-b68f-20f725f70b1c",
                                                "sense_id": "c9ca4fc7-aa24-35f6-9635-241d50cee7fa",
                                                "text": "Vrouwen stenigen mag, zei de imam"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5288f8e4-c0f2-3835-803a-5eafd8e207cc",
                                        "entry_id": "1a94ce50-f3c0-3044-a212-18c22c161bc4",
                                        "glosses": [
                                            "hoofd van een islamitische rechtsschool"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6e3235d-be65-4164-a847-187c92905236",
                                                "sense_id": "5288f8e4-c0f2-3835-803a-5eafd8e207cc",
                                                "text": "De theologen baseren zich op de uitleg van de algemeen geachte imam Malik (c. 711-795) en imam Ahmed ibn Hanbal (780-855)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11737536-39da-30dd-b1a2-722e7407dc35",
                                        "entry_id": "1a94ce50-f3c0-3044-a212-18c22c161bc4",
                                        "glosses": [
                                            "leider van een sjiitische gemeenschap"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfbf61a2-ee0b-4c08-889c-8df3feb50933",
                                                "sense_id": "11737536-39da-30dd-b1a2-722e7407dc35",
                                                "text": "Koning Ibn Saoed en de imam van Jemen sluiten vrede."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6aec2664-ea5e-4719-b99b-8d7a293e7dcf",
                        "source_entry_id": "5ad2e2ee-70a9-30d8-b7a6-f23c07e1295f",
                        "source_sense_description": "Muslim leader",
                        "target_lang_word": "imam",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imam",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a0deb53-a7c6-3412-a2e5-2fd94d26fe9f",
                                        "entry_id": "e2ba4c88-1d24-3e6f-8af2-925ea7ea10da",
                                        "glosses": [
                                            "Guide de la communauté dans la religion musulmane."
                                        ],
                                        "tags": [
                                            "Sunnisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "791b5d1f-b94b-4ce6-a44b-b711b8a5fb6d",
                                                "sense_id": "0a0deb53-a7c6-3412-a2e5-2fd94d26fe9f",
                                                "text": "Un oratoire (msalla), simple mur en maçonnerie blanchi à la chaux, avait été construit à la hâte sur une colline voisine, toute blanche de pâquerettes. Et c’est là, hier matin, premier choûal, que le Sultan s’est rendu en grande pompe pour remplir ses fonctions d’imâm, de souverain pontife, et y faire la prière à la tête de sa cour et de son armée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3c5b156-debb-3a36-8c32-27819e517808",
                                        "entry_id": "e2ba4c88-1d24-3e6f-8af2-925ea7ea10da",
                                        "glosses": [
                                            "Guide spirituel et temporel."
                                        ],
                                        "tags": [
                                            "Chiisme"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c7dcefd-fbde-32ab-bc75-fb4ce581bee5",
                                        "entry_id": "e2ba4c88-1d24-3e6f-8af2-925ea7ea10da",
                                        "glosses": [
                                            "Religieux qui dirige la prière en commun chez les musulmans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ce8ca9-92bc-42e8-b4c6-aa24d41518f0",
                                                "sense_id": "3c7dcefd-fbde-32ab-bc75-fb4ce581bee5",
                                                "text": "Nous rentrâmes ensuite dans Athènes (…). Je fus réveillé tout à coup par le tambourin et la musette turque, dont les sons discordants partaient des combles des Propylées. En même temps un prêtre turc se mit à chanter en arabe l’heure passée à des chrétiens de la ville de Minerve. Je ne saurais peindre ce que j’éprouvai : cet iman n’avait pas besoin de me marquer ainsi la fuite des années; sa voix seule, dans ces lieux, annonçait assez que les siècles s’étaient écoulés."
                                            },
                                            {
                                                "example_id": "e2d618b8-444a-4788-8ac0-600c4dc3ca81",
                                                "sense_id": "3c7dcefd-fbde-32ab-bc75-fb4ce581bee5",
                                                "text": "[…]; le terme coranique d’« imam » ne s’applique pas à un gouvernant, mais à un guide de prière."
                                            },
                                            {
                                                "example_id": "281823da-a9b2-4571-b2fa-c17268324950",
                                                "sense_id": "3c7dcefd-fbde-32ab-bc75-fb4ce581bee5",
                                                "text": "Cette imam danoise vient d’inaugurer une mosquée exclusivement féminine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5dad30b-eb2e-4230-8cf4-1d3ce3deec7b",
                        "source_entry_id": "5ad2e2ee-70a9-30d8-b7a6-f23c07e1295f",
                        "source_sense_description": "Muslim leader",
                        "target_lang_word": "Imam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Imam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad2deca-dd2f-3d65-a76f-ce858dc8cd69",
                                        "entry_id": "b12e348e-78cc-35ed-9520-fd2f7a639bf5",
                                        "glosses": [
                                            "jemand, der ein Gebet (der Gemeinde) vorträgt oder Teile davon im Wechsel mit der Gemeinde spricht; jemand, der das rituelle Gebet in der Moschee leitet"
                                        ],
                                        "tags": [
                                            "Islam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bedeef8f-ab57-4f3e-82be-73129e6e8976",
                                                "sense_id": "5ad2deca-dd2f-3d65-a76f-ce858dc8cd69",
                                                "text": "„Laßt uns ‚unserem‘ Gott in Kirche, Synagoge und Moschee huldigen, damit wir uns um so besser im gemeinsamen Raum der Demokratie verständigen können. Und dessen Regeln bestimmen nicht Rabbi, Imam oder Pfarrer, sondern Grundgesetz und Verfassungsgericht.“"
                                            },
                                            {
                                                "example_id": "933c1969-8e4b-4584-afb7-0e027e7fd1ed",
                                                "sense_id": "5ad2deca-dd2f-3d65-a76f-ce858dc8cd69",
                                                "text": "„Der Berliner Imam Kadir Sanci, der dem geplanten Lehr- und Gebetshaus von Muslimen, Christen und Juden ‚House of One‘ angehört, begrüßte die Solidaritätskundegebungen mit der Kippa.“"
                                            },
                                            {
                                                "example_id": "c0d151b3-2775-4bf1-897f-30a269bf4882",
                                                "sense_id": "5ad2deca-dd2f-3d65-a76f-ce858dc8cd69",
                                                "text": "„Der Wunsch, ein Imam zu werden, wuchs in mir heran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "967df4a1-d50f-3c29-a0a5-f5208a968c49",
                                        "entry_id": "b12e348e-78cc-35ed-9520-fd2f7a639bf5",
                                        "glosses": [
                                            "Ehrentitel, mit dem verdiente islamische Gelehrte (vor allem Theologen und Juristen) angesprochen werden (insbesondere die Begründer der vier orthodoxen Gesetzesschulen: Abū Ḥanīfa, aš-Šāfiʿī, Aḥmad ibn Ḥanbal, Mālik ibn Anas)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5456f88-4a9d-45b2-886b-7cb39a3f584e",
                                                "sense_id": "967df4a1-d50f-3c29-a0a5-f5208a968c49",
                                                "text": "„Persien wurde neben dem Irak das Kerngebiet der Schiiten, nicht zuletzt, weil die Perser als Nicht-Araber ähnlich wie die von ihnen verehrten Imame Ali und Hussein im Ränkespiel um die Führerschaft die Verlierer waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "393cc816-f81d-3df5-9766-c37d2414b4a0",
                                        "entry_id": "b12e348e-78cc-35ed-9520-fd2f7a639bf5",
                                        "glosses": [
                                            "religiöses Oberhaupt der gesamten islamischen Gemeinde, das als Nachfahr aus der Familie des Propheten stammt"
                                        ],
                                        "tags": [
                                            "Islam",
                                            "Schiismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72b3de6-1f7a-4c7e-b38e-4309893ede02",
                                                "sense_id": "393cc816-f81d-3df5-9766-c37d2414b4a0",
                                                "text": "„Die britische Times ist ähnlicher Ansicht und schreibt zum achten Jahrestag der iranischen Morddrohung gegen Salman Rushdie: ‚Nach fünf Jahren eines »kritischen Dialogs« mit Teheran ist es an der Zeit, zu akzeptieren, daß die Fatwa wohl solange nicht aufgehoben wird, wie der Iran ein von fundamentalistischen Imams geführter Staat religiöser Ausrichtung ist…‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b577d4fe-19ec-3ee5-b7e7-eb5baf402bf2",
                                        "entry_id": "b12e348e-78cc-35ed-9520-fd2f7a639bf5",
                                        "glosses": [
                                            "Titel ehemaliger jemenitischer Herrscher"
                                        ],
                                        "tags": [
                                            "Islam",
                                            "Jemen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f222f3dc-2bf2-473e-bbff-3c49801873b5",
                                                "sense_id": "b577d4fe-19ec-3ee5-b7e7-eb5baf402bf2",
                                                "text": "„Imam Yahia, der 71jährige Herrscher von Yemen, wollte von den Amerikanern nicht viel wissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
