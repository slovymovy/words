                "senses": [
                    {
                        "sense_id": "0f6b1adf-19b7-3e47-9222-fa8426393107",
                        "entry_id": "1ac68878-c958-30f2-a6bd-9a571185ad6f",
                        "glosses": [
                            "Relatif à l’électrolyse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee167c26-ccec-458b-8048-078235d98790",
                                "sense_id": "0f6b1adf-19b7-3e47-9222-fa8426393107",
                                "text": "La valeur la plus forte pour les échantillons obtenus par voie électrolytique ne peut être attribuée à un état allotropique particulier du métal, car après fusion, le coefficient d'aimantation de ces échantillons n'a pas changé."
                            },
                            {
                                "example_id": "a5b56168-1222-47fb-9c3f-c69fb253fc07",
                                "sense_id": "0f6b1adf-19b7-3e47-9222-fa8426393107",
                                "text": "Le traitement dans les bacs électrolytiques se fait de la manière suivante : …"
                            },
                            {
                                "example_id": "d88482da-0b5c-423f-81f7-df1006e0bbc9",
                                "sense_id": "0f6b1adf-19b7-3e47-9222-fa8426393107",
                                "text": "Comme l’explique le directeur d’une nouvelle étude parue dans le journal «Environmental pollution», le professeur Patrick Drogui, le traitement par oxydation électrolytique des eaux usées ne requiert aucun ajout chimique."
                            }
                        ]
                    },
                    {
                        "sense_id": "461cb744-f209-3771-9b89-06b2872d28b5",
                        "entry_id": "1ac68878-c958-30f2-a6bd-9a571185ad6f",
                        "glosses": [
                            "Relatif aux électrolytes, qui contient des électrolytes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "984fa543-0789-45d1-b2a8-81c27d29af13",
                                "sense_id": "461cb744-f209-3771-9b89-06b2872d28b5",
                                "text": "Une solution électrolytique est obtenue par dissolution d'un soluté […] dans un solvant."
                            }
                        ]
                    }
                ],
