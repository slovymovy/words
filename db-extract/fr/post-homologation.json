                        "glosses": [
                            "Postérieur à l’homologation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46dd8949-c15b-4616-8e96-9e95e89e46c9",
                                "sense_id": "dd8abab1-7ca0-3cf5-ac70-b6596fc94003",
                                "text": "Cette mission, financée grâce à l’instauration d’une nouvelle taxe perçue sur la vente des produits phytopharmaceutiques, permet d’abord de répondre aux critiques relatives aux carences du suivi post-homologation."
                            },
                            {
                                "example_id": "ef6f1407-402a-48ee-8719-2b3ea706e3fc",
                                "sense_id": "dd8abab1-7ca0-3cf5-ac70-b6596fc94003",
                                "text": "Les études post-homologation ont mis en évidence leur rémanence dans toutes les composantes des milieux (eau, air, sol, végétation non cible…), entraînant des impacts chroniques sur l’abeille."
                            },
                            {
                                "example_id": "33599b58-8bed-413c-b033-aa833086b184",
                                "sense_id": "dd8abab1-7ca0-3cf5-ac70-b6596fc94003",
                                "text": "L’homologation reflète souvent les limites des essais d’homologation, mais la commercialisation post-homologation met souvent ces limites à l’épreuve, et la prescription n’est pas du tout réglementée en conséquence."
                            }
                        ]
                    }
