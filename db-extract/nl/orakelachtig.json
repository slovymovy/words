                        "glosses": [
                            "op een geheimzinnige manier die men op verschillende manieren kan uitleggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55b138f0-b5c4-403f-9592-6098289c14b6",
                                "sense_id": "c7631899-ee37-3713-9854-f8026322aa64",
                                "text": "Ook mama antwoordde orakelachtig op dezelfde vraag toen ze me van Long Island naar Brooklyn bracht voor mijn eerste door haar goedgekeurde overnachting bij Mischa, het weekend nadat ze me voor het eerst in Dumbo had afgeleverd."
                            },
                            {
                                "example_id": "9fccdaf2-29a2-456d-87dd-490ea87c1610",
                                "sense_id": "c7631899-ee37-3713-9854-f8026322aa64",
                                "text": "Wat regeringsleiders niet voor elkaar kregen, lukte ECB-president Mario Draghi wel. Zijn orakelachtige woorden dat de ECB er alles aan zou doen om de euro te redden (\"Geloof me, het zal genoeg zijn\") werkte als olie op de golven."
                            }
                        ]
                    }
