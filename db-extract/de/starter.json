                "senses": [
                    {
                        "sense_id": "7816b757-bdc9-39ec-ae37-6a8502e71fff",
                        "entry_id": "8174680a-d7fc-3f62-a3df-850daad4e8c1",
                        "glosses": [
                            "Person, die zu Beginn eines Rennens das Startzeichen gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb5de440-caa3-4426-a1ff-1c27689bdc58",
                                "sense_id": "7816b757-bdc9-39ec-ae37-6a8502e71fff",
                                "text": "Heute fällt der Starter aus."
                            },
                            {
                                "example_id": "5d44cd6c-3fe8-4181-bcf0-af040fb4bc61",
                                "sense_id": "7816b757-bdc9-39ec-ae37-6a8502e71fff",
                                "text": "„Der Starter winkte, und der Wagen schoß davon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ee881998-c8ee-32c5-903e-d798c5a47320",
                        "entry_id": "8174680a-d7fc-3f62-a3df-850daad4e8c1",
                        "glosses": [
                            "Anlasser"
                        ],
                        "tags": [
                            "Fahrzeugtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "cd3765eb-c53a-41aa-9251-5601363cb986",
                                "sense_id": "ee881998-c8ee-32c5-903e-d798c5a47320",
                                "text": "Der Starter ihres Fahrzeugs ist defekt und muss ausgetauscht werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "716da113-c04b-3385-93a1-571f3d157a23",
                        "entry_id": "8174680a-d7fc-3f62-a3df-850daad4e8c1",
                        "glosses": [
                            "Vorspeise, der erste Gang eines Menüs"
                        ],
                        "tags": [
                            "Kochkunst"
                        ],
                        "examples": [
                            {
                                "example_id": "e7fcccb1-34e4-482c-b316-130f015ea5a2",
                                "sense_id": "716da113-c04b-3385-93a1-571f3d157a23",
                                "text": "Als Starter gibt es heute eine einfache Gemüsesuppe."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "37334d88-9063-3289-8394-d7de1cfa620a",
                        "entry_id": "8174680a-d7fc-3f62-a3df-850daad4e8c1",
                        "glosses": [
                            "an einem Wettkampf teilnehmende Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c94fb6-2df7-44f6-aef7-91818420485e",
                                "sense_id": "37334d88-9063-3289-8394-d7de1cfa620a",
                                "text": "Es sind mehrere hundert Starter anwesend."
                            },
                            {
                                "example_id": "986d8602-e50a-44fb-9efa-f1dc5cf496c0",
                                "sense_id": "37334d88-9063-3289-8394-d7de1cfa620a",
                                "text": "„So wuchs das Feld der Starter zwar Jahr um Jahr, aber zunächst sehr langsam.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
