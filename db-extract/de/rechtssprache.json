                "senses": [
                    {
                        "sense_id": "1e7335a4-121a-378d-a612-bf7df594031c",
                        "entry_id": "affbcda0-a165-3a1d-971e-43c911447a67",
                        "glosses": [
                            "Fachsprache derjenigen, die beruflich/von Amts wegen mit der Rechtspflege befasst sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84efd7f2-b26e-4732-a400-37d4e4522b58",
                                "sense_id": "1e7335a4-121a-378d-a612-bf7df594031c",
                                "text": "Rechtssprache „soll hier als Oberbegriff für die beiden zentralen Kategorien Sprache der rechtlichen Normen (Gesetze, Verordnungen, Kommentare etc.) und Verwaltungssprache (Umsetzung der Gesetze) verwendet werden.“"
                            },
                            {
                                "example_id": "fc1b8f18-2bcf-4b3d-b1f8-fc3a67095b8d",
                                "sense_id": "1e7335a4-121a-378d-a612-bf7df594031c",
                                "text": "„Unstrittig sei, so Herr Hoberg, dass die Rechts- und Verwaltungssprache für viele Menschen unverständlich sei.“"
                            },
                            {
                                "example_id": "9ea334fe-c305-404d-a237-244677e1f34f",
                                "sense_id": "1e7335a4-121a-378d-a612-bf7df594031c",
                                "text": "„So sind ‚Ding‘ und ‚Sache‘ Fachwörter der Rechtssprache gewesen: ‚Ding‘ bedeutete die Gerichtsversammlung, ‚Sache‘ die gerichtliche Untersuchung.“"
                            },
                            {
                                "example_id": "5f686772-084b-412b-9cc0-34f5977fe712",
                                "sense_id": "1e7335a4-121a-378d-a612-bf7df594031c",
                                "text": "„Die heutige Form unserer Rechtssprache ist eine relativ junge Erscheinung der Neuzeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
