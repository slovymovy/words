                {
                    "sense_id": "505cf35f-5583-39f2-a85d-5d607c2ed22a",
                    "sense_definition": "rekening houdend met een bepaalde omstandigheid of feit",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "overweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Gezien</w> de omstandigheden hebben we besloten om het feestje binnen te vieren.",
                            "target_lang_translations": {
