                        "examples": [
                            {
                                "example_id": "b5dbd2f8-c191-47e9-908b-9b393b14d861",
                                "sense_id": "601c9543-b59e-306f-ad57-266c980d3a61",
                                "text": "Znana ukraińska piosenkarka i aktywistka Rusłana Łyżyczko przyjechała do Polski, by wczoraj wziąć udział w programie „Świat się kręci” i opowiedzieć, co tak naprawdę dzieje się w jej ojczyźnie"
