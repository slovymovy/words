                "senses": [
                    {
                        "sense_id": "f2be6135-3b66-3df2-bf51-21aaabb24dbe",
                        "entry_id": "b38b399d-514f-3688-9c69-e977ef6ba776",
                        "glosses": [
                            "mittig an Schienenfahrzeugen angebrachte Vorrichtung, die Puffer und Kupplungen in einem Bauteil vereinigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daf16af9-ade4-42fd-8d8e-e6e027f5f510",
                                "sense_id": "f2be6135-3b66-3df2-bf51-21aaabb24dbe",
                                "text": "Durch die Verwendung von Mittelpufferkupplungen verringert sich der Zeitaufwand beim Rangieren."
                            },
                            {
                                "example_id": "273b33d0-eec7-4e5e-bc9b-e2a2b7d58c60",
                                "sense_id": "f2be6135-3b66-3df2-bf51-21aaabb24dbe",
                                "text": "„Das Auto wurde von der Mittelpufferkupplung der Lokomotive auf der Beifahrerseite getroffen und in den Acker katapultiert, dabei wurde die Frau wurde aus dem Auto geschleudert.“"
                            },
                            {
                                "example_id": "59e0b501-70a2-45ab-9664-a690735c9cfb",
                                "sense_id": "f2be6135-3b66-3df2-bf51-21aaabb24dbe",
                                "text": "„Ergänzend weist die Bundesregierung darauf hin, dass vor allem die Forderung universeller Kuppelbarkeit der Fahrzeuge den Übergang von der Schraubenkupplung zur Mittelpufferkupplung erschwert.“"
                            },
                            {
                                "example_id": "0a0a535e-a05e-4d96-ae25-f4e39b281304",
                                "sense_id": "f2be6135-3b66-3df2-bf51-21aaabb24dbe",
                                "text": "„Bereits 1970 hätten die europäischen Bahnen beschlossen, die Mittelpufferkupplung 1981 einzuführen, allerdings sei die französische Staatsbahn SNCF schon 1973 aus dem Projekt ausgestiegen, weil sie ihre Mittel lieber in den Aufbau eines TGV-Netzes stecken wollte, und habe damit das gesamte Projekt zum Scheitern gebracht, sagte Kortschak im Gespräch mit dem STANDARD.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
