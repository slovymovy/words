                "senses": [
                    {
                        "sense_id": "43d8ea41-ea71-3107-a960-149bc4ca8f65",
                        "entry_id": "13b52847-fc3c-3ddc-891d-c7dc54702b43",
                        "glosses": [
                            "Former un nom étranger de lieu, de langue ou de peuple (exonyme) à partir du nom utilisé par les habitants de ce lieu, les locuteurs de cette langue ou les membres de ce peuple (endonyme)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5e7811b-30b3-485b-b082-8b847b8f8162",
                                "sense_id": "43d8ea41-ea71-3107-a960-149bc4ca8f65",
                                "text": "La particularité des toponymes présents ci-dessous est qu’ils n’ont pas été exonymisés dans la langue française, mais tout simplement repris en tant que noms français."
                            }
