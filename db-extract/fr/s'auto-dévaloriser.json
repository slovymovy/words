                                "example_id": "d374e611-a58c-4d50-8a6b-17b5bd58dd03",
                                "sense_id": "c41fa788-cc04-3396-9a32-5efc6446d44d",
                                "text": "La population bretonnante, toutefois, avait été conduite à s'auto-dévaloriser sous la pression d'un système administratif et surtout scolaire fonctionnant selon un modèle dont il n'est pas exagéré de dire qu'il s'apparentait sous de nombreux rapports à un système de totalitarisme linguistique."
                            },
                            {
                                "example_id": "319339dd-7614-4977-965a-0914702cd54a",
                                "sense_id": "c41fa788-cc04-3396-9a32-5efc6446d44d",
                                "text": "Travailler encore plus, s'interdire les plaisirs, s'auto-dévaloriser."
                            }
                        ]
                    }
