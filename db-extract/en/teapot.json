                    {
                        "translation_id": "d24e295f-ec0a-45ec-8465-69878ddf8987",
                        "source_entry_id": "8b77e253-d373-316b-a0c5-a89665a06202",
                        "source_sense_id": "b0c3f78c-b7a5-3807-89f2-64c8180cf6cb",
