                "translations": [
                    {
                        "translation_id": "2af7e7b1-409f-429f-9a5c-e1602a35fe3f",
                        "source_entry_id": "9d00604d-f47c-3b98-ad18-2fd6853a60fd",
                        "source_sense_id": "a2378db3-0df2-3bcc-a0f7-34f2272446ac",
                        "target_lang_word": "cocktail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocktail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4456edb-482c-3794-be66-10c86c93e92c",
                                        "entry_id": "b4395613-b588-3fe5-9f99-8c18ace5df9b",
                                        "glosses": [
                                            "A mixed alcoholic beverage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba13abb8-acac-4747-9bd1-8601dcbc829f",
                                                "sense_id": "a4456edb-482c-3794-be66-10c86c93e92c",
                                                "text": "They visited a bar noted for its wide range of cocktails."
                                            },
                                            {
                                                "example_id": "8fdaff35-cf33-47ef-bc48-be769d6fa970",
                                                "sense_id": "a4456edb-482c-3794-be66-10c86c93e92c",
                                                "text": "[...] a certain candidate has placed in his account of Loss and Gain, the following items:-- LOSS [...] 411 glasses bitters[,] 25 do. cock-tail"
                                            },
                                            {
                                                "example_id": "bf8c70c7-dcbe-4e41-b907-bd076a3076e1",
                                                "sense_id": "a4456edb-482c-3794-be66-10c86c93e92c",
                                                "text": "Cock tail, then, is a stimulating liquor, composed of spirits of any kind, sugar, water, and bitters — it is vulgarly called bittered sling, and is supposed to be an excellent electioneering potion, inasmuch as it renders the heart stout and bold, at the same time that it fuddles the head."
                                            },
                                            {
                                                "example_id": "7b0269aa-633a-4e0a-9159-5443f4509e44",
                                                "sense_id": "a4456edb-482c-3794-be66-10c86c93e92c",
                                                "text": "Deane opened the fray by declaring, à propos of dinners, that the only proper way to create a cocktail of the genus Martini was to add a half-spoonful of sherry after the other ingredients had been satisfactorily mixed, if at all."
                                            },
                                            {
                                                "example_id": "7eac1895-cf94-427a-ae88-1ebd470cfe92",
                                                "sense_id": "a4456edb-482c-3794-be66-10c86c93e92c",
                                                "text": "He moved majestically down to mix the cocktails. As he chipped ice, as he squeezed oranges, as he collected vast stores of bottles, glasses, and spoons at the sink in the pantry, he felt as authoritative as the bartender at Healey Hanson's saloon."
                                            },
                                            {
                                                "example_id": "66e95077-00c4-421c-92f7-a75b98d9d7dd",
                                                "sense_id": "a4456edb-482c-3794-be66-10c86c93e92c",
                                                "text": "The cocktail in Britain is a rigidly-defined social institution: each has its own particular meaning—the G & T is the alcoholic equivalent of the interview suit; Pernod and black is an alternative to glue sniffing for repentant trendies, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ded26962-b742-3c32-87ee-3d9775368356",
                                        "entry_id": "b4395613-b588-3fe5-9f99-8c18ace5df9b",
                                        "glosses": [
                                            "A mixture of other substances or things."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da267731-8209-434e-9ee2-82c5664102b0",
                                                "sense_id": "ded26962-b742-3c32-87ee-3d9775368356",
                                                "text": "Scientists found a cocktail of pollutants in the river downstream from the chemical factory."
                                            },
                                            {
                                                "example_id": "8ee166d1-1a2e-49c2-bf8e-8f492e73e51f",
                                                "sense_id": "ded26962-b742-3c32-87ee-3d9775368356",
                                                "text": "a cocktail of illegal drugs"
                                            },
                                            {
                                                "example_id": "d1c080e2-0327-4ff4-bbac-49a761834f44",
                                                "sense_id": "ded26962-b742-3c32-87ee-3d9775368356",
                                                "text": "Motor vehicles, for example, emit a cocktail of nitrogen oxides, carbon monoxide, volatile organic compounds, particulates, heavy metals and (for diesel) sulphur dioxide."
                                            },
                                            {
                                                "example_id": "0883bd85-c88f-431b-83da-adbfd92cb470",
                                                "sense_id": "ded26962-b742-3c32-87ee-3d9775368356",
                                                "text": "This chapter examines how the concurrent phenomena of an assertive monarch, persistent civil war, and economic change affected the political activities of townspeople in three ways: in the relationship between the ‘urban sector’ and the English polity, in the complexion of municipal internal politics, and in the nature of urban participation in the civil wars of 1469–71. In all three of these fields, the particular cocktail of circumstances present in the 1460s encouraged a wide variety of townspeople to become invested emotionally and materially in the course of national politics, as they had not been during much of the 1450s."
                                            },
                                            {
                                                "example_id": "572ca950-8096-437c-9f59-d2608f20c08d",
                                                "sense_id": "ded26962-b742-3c32-87ee-3d9775368356",
                                                "text": "Terry Gourvish, the lead author if the authorised commercial history of BR, described the new BTC structure thus: \"The conclusion must be that the combination of a few undynamic railwaymen, underpaid full-timers (Commission and General Staff) and poorly-paid part-time businessmen was not a very potent managerial cocktail.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "997d21c4-c3c1-3fdd-aeb9-595f3aca237a",
                                        "entry_id": "b4395613-b588-3fe5-9f99-8c18ace5df9b",
                                        "glosses": [
                                            "A horse, not of pure breed, but having only one eighth or one sixteenth impure blood in its veins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d4d788-e43c-4cde-acd6-a0e7e05e7da8",
                                                "sense_id": "997d21c4-c3c1-3fdd-aeb9-595f3aca237a",
                                                "text": "A “cock-tail” is a horse not purely bred, but with only one-eighth or one-sixteenth impure blood in his veins"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95e90e95-3a96-33de-9ada-a14a1e3e147e",
                                        "entry_id": "b4395613-b588-3fe5-9f99-8c18ace5df9b",
                                        "glosses": [
                                            "A mean, half-hearted fellow."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23957efd-ae40-491f-883c-c88f016b264d",
                                                "sense_id": "95e90e95-3a96-33de-9ada-a14a1e3e147e",
                                                "text": "It was in the second affair that poor little Barney showed he was a cocktail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bc38df4-f22b-347c-a563-90ce67f2ba1c",
                                        "entry_id": "b4395613-b588-3fe5-9f99-8c18ace5df9b",
                                        "glosses": [
                                            "A species of rove beetle, so called from its habit of elevating the tail."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cocktail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10b6e56b-2810-3fdb-8d48-2f4bd247ec1c",
                                        "entry_id": "a10fa651-da87-391f-a619-35629c4ea3c4",
                                        "glosses": [
                                            "Ostentatiously lacking in manners."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4688ff35-a09c-4dc2-adec-1b689b7c6189",
                                                "sense_id": "10b6e56b-2810-3fdb-8d48-2f4bd247ec1c",
                                                "text": "It looks very cocktail to be seen riding through the streets of London in a scarlet coat ;"
                                            },
                                            {
                                                "example_id": "85530831-9546-4d0a-a55f-3109f25dee16",
                                                "sense_id": "10b6e56b-2810-3fdb-8d48-2f4bd247ec1c",
                                                "text": "The Prince had nothing particular about him but a monstrous smart whip with a gold stag for a handle, which was pronounced a very cocktail looking instrument by the Leicestershire farmers, with whom His Serene Highness is no favorite"
                                            },
                                            {
                                                "example_id": "4a86383c-a00f-4c8d-b5ba-13d4f397c8a2",
                                                "sense_id": "10b6e56b-2810-3fdb-8d48-2f4bd247ec1c",
                                                "text": "She always goes about with a brace of loaded revolvers in her belt!! Very cocktail and no occasion for it"
                                            },
                                            {
                                                "example_id": "5191fd6a-d850-4e68-8611-826341b8935b",
                                                "sense_id": "10b6e56b-2810-3fdb-8d48-2f4bd247ec1c",
                                                "text": "Nothing looks so cocktail and muffish on a coach as to see a man learning to catch his whip, and after many futile efforts taking it upside down for this purpose, and twisting the thong round and round with the point downwards, as if he was stirring porridge for a pack of hounds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cocktail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f602d843-d7ce-3978-b9fb-ec7660bbf82c",
