                "senses": [
                    {
                        "sense_id": "926646b3-40d9-3cd4-92f2-38175489c04a",
                        "entry_id": "a19b629f-ee42-32b3-a3bc-ba5cdb215972",
                        "glosses": [
                            "russischsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fabb6fd8-b614-4c3f-aa4d-a42b744d9722",
                                "sense_id": "926646b3-40d9-3cd4-92f2-38175489c04a",
                                "text": "Frau Tretjakow ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "df48818d-7a2b-4eed-bb0c-ac4a69ec04f7",
                                "sense_id": "926646b3-40d9-3cd4-92f2-38175489c04a",
                                "text": "Herr Tretjakow wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a425c143-6096-4f7e-8921-156bacbe0542",
                                "sense_id": "926646b3-40d9-3cd4-92f2-38175489c04a",
                                "text": "Die Tretjakows fliegen heute nach Riga."
                            },
                            {
                                "example_id": "0b1e2192-a2c0-4bd1-a3cf-ddc8a97f5d87",
                                "sense_id": "926646b3-40d9-3cd4-92f2-38175489c04a",
                                "text": "Der Tretjakow trägt nie die Pullover, die die Tretjakow ihm strickt."
                            },
                            {
                                "example_id": "1b7362f2-126b-451c-8167-936c430b1ae3",
                                "sense_id": "926646b3-40d9-3cd4-92f2-38175489c04a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tretjakow kommt, geht der Herr Tretjakow.“"
                            },
                            {
                                "example_id": "abb9919e-1f5c-452b-a0e9-f12faa24e864",
                                "sense_id": "926646b3-40d9-3cd4-92f2-38175489c04a",
                                "text": "Tretjakow kommt und geht."
                            },
                            {
                                "example_id": "7d134f26-54f5-41a8-989b-649d381827ec",
                                "sense_id": "926646b3-40d9-3cd4-92f2-38175489c04a",
                                "text": "Tretjakows kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
