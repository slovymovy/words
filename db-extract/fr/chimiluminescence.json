                        "sense_id": "86b7a816-0bbd-3089-aac1-d0a9aa0d0787",
                        "entry_id": "a2d1c0b7-5071-3ae8-be37-45f555222063",
                        "glosses": [
                            "Émission de lumière résultant d’une réaction chimique comme par exemple celle du luminol avec les ions fer des globules rouges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23155ca0-b1a9-463c-8e9e-8893945d2845",
                                "sense_id": "86b7a816-0bbd-3089-aac1-d0a9aa0d0787",
                                "text": "La chimiluminescence permet à la police scientifique de mettre en évidence des traces de sang ou d’explosifs invisibles à l’œil nu."
                            },
                            {
                                "example_id": "c355d9e9-9a33-4680-83df-b6e26d338076",
                                "sense_id": "86b7a816-0bbd-3089-aac1-d0a9aa0d0787",
                                "text": "Dans ce contexte, de nombreux laboratoires équipés d’automates de chimiluminescence abandonnent progressivement les techniques radio-immunologiques."
                            }
                        ]
                    }
                ],
