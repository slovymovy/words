                "senses": [
                    {
                        "sense_id": "8590723e-8e8f-3a83-a87d-4a7216d47915",
                        "entry_id": "2faf7cde-a1d2-3564-bcd0-9177af414246",
                        "glosses": [
                            "Noyau central de la Terre, très dense car il serait formé de nickel et de fer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27b66cdd-9d19-4c2f-b19e-beabf259ee53",
                                "sense_id": "8590723e-8e8f-3a83-a87d-4a7216d47915",
                                "text": "L’hypothèse d’un noyau métallique ou barysphère, composé en grande partie de fer, est en harmonie avec ce que nous savons du magnétisme terrestre."
                            },
                            {
                                "example_id": "7c04f5f7-3e47-4aab-9265-f0982cb0cb7c",
                                "sense_id": "8590723e-8e8f-3a83-a87d-4a7216d47915",
                                "text": "La barysphère serait composée pour 9/10 de fer et pour 1/10 de nickel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a89480ee-f0ea-40ec-b602-237203703c4a",
                        "source_entry_id": "2faf7cde-a1d2-3564-bcd0-9177af414246",
                        "source_sense_id": "8590723e-8e8f-3a83-a87d-4a7216d47915",
                        "target_lang_word": "Barysphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barysphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc267be0-0da2-3c5e-a432-023afa6ce968",
                                        "entry_id": "2b579455-8402-3e26-ac7f-06c227df9f73",
                                        "glosses": [
                                            "der Bereich des Erdkerns, der innerste Teil der Erde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a12b636b-630f-44f0-81b9-dc201426275e",
                                                "sense_id": "cc267be0-0da2-3c5e-a432-023afa6ce968",
                                                "text": "„Auf der Erde behauptet sich diese Einfachheit der Elemente noch an der Peripherie, in den mehr oder weniger ionisierten Gasen der Atmosphäre und der Stratosphäre und vermutlich auch in der Tiefe, in den Metallen der Barysphäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "415d47f1-952e-4262-a45f-d3ddd8ded421",
                        "source_entry_id": "2faf7cde-a1d2-3564-bcd0-9177af414246",
                        "source_sense_id": "8590723e-8e8f-3a83-a87d-4a7216d47915",
                        "target_lang_word": "Erdkern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdkern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c8e538f-cfd9-3aaa-89c0-4d1cd29f02d4",
                                        "entry_id": "6878b818-66ca-3719-9e2b-ed865afd295e",
                                        "glosses": [
                                            "innerster, aus Metallen bestehender Kern der Erde mit einer sehr hohen Dichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b16cbe8c-17d2-4226-94a1-2fbefbf8b2ae",
                                                "sense_id": "1c8e538f-cfd9-3aaa-89c0-4d1cd29f02d4",
                                                "text": "„Das Feuer der Vulkane komme keineswegs von tief innen, es werde genährt von brennenden Kohlelagern, der Erdkern sei aus hartem Stein. Diese Lehre nannte sich Neptunismus und wurde von beiden Kirchen und Johann Wolfgang von Goethe verfochten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
