                        "sense_id": "f6610842-b964-3f77-b2b7-a1b17eb7bef0",
                        "entry_id": "711e8739-0a04-3596-9498-00ef21e3fe69",
                        "glosses": [
                            "Holiness; sanctity; sacred honour."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "223d75f2-6ff2-404e-8360-781b29143a13",
                                "sense_id": "f6610842-b964-3f77-b2b7-a1b17eb7bef0",
                                "text": "Now sure and by my hallidome ( quoth he ) / Ye a great master are in your degree"
                            },
                            {
                                "example_id": "0881a3ca-4732-44d0-9d8e-40d5abec1ede",
                                "sense_id": "f6610842-b964-3f77-b2b7-a1b17eb7bef0",
                                "text": "Now he's put the final seal on his Kingship, his halidom, by slaying a challenger in the Wood."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b74495f-c8ad-3dfc-80d7-e8cff90dfd12",
                        "entry_id": "711e8739-0a04-3596-9498-00ef21e3fe69",
                        "glosses": [
                            "A sanctuary; lands held of a religious foundation."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "96ebc41e-8bad-4f88-a5c0-a175074b083e",
                                "sense_id": "3b74495f-c8ad-3dfc-80d7-e8cff90dfd12",
                                "text": "[…] save for Wodan, who had a richly bedecked halidom nearby."
                            }
                        ]
                    },
                    {
                        "sense_id": "eac95cb2-ce82-3238-aaed-3476935a37c3",
                        "entry_id": "711e8739-0a04-3596-9498-00ef21e3fe69",
                        "glosses": [
                            "Something regarded as sacred; a holy relic."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "111cc774-4987-45bf-b75b-d7620e697d79",
                                "sense_id": "eac95cb2-ce82-3238-aaed-3476935a37c3",
                                "text": "“By my halidom,” said he, “we have forgotten, Sir Prior, to name the fair Sovereign of Love and of Beauty, by whose white hand the palm is to be distributed.”"
                            }
                        ]
                    }
