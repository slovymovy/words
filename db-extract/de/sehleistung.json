                        "sense_id": "4b8db52e-20ce-33f7-a3fd-a4a6ac23f73a",
                        "entry_id": "1d75b135-e131-3beb-aaec-cca20d2d2d3d",
                        "glosses": [
                            "Leistung im Sehen mit dem Auge; Maß dafür, wie gut man sehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5315c9f7-2809-4738-bebd-b5c08f7c51b6",
                                "sense_id": "4b8db52e-20ce-33f7-a3fd-a4a6ac23f73a",
                                "text": "„Er stellte fest, dass Marie nur noch 40 Prozent Sehleistung auf einem Auge hatte.“"
                            },
                            {
                                "example_id": "b43a1b20-bc29-4d22-986a-fbe472ce3987",
                                "sense_id": "4b8db52e-20ce-33f7-a3fd-a4a6ac23f73a",
                                "text": "„Bei 0,3 Promille vermindert sich zusätzlich deine Sehleistung, dein Reaktionsvermögen lässt nach und Du wirst risikobereiter.“"
                            },
                            {
                                "example_id": "05ab39f6-a6c1-4c9b-b9e4-426d6262c3fd",
                                "sense_id": "4b8db52e-20ce-33f7-a3fd-a4a6ac23f73a",
                                "text": "„Als physiologische Blendung wird dabei die Blendung bezeichnet, bei der eine messbare Verschlechterung der Sehleistung auftritt.“"
                            }
                        ],
