                "senses": [
                    {
                        "sense_id": "9a425667-debd-3bda-9e81-8dbc193d0444",
                        "entry_id": "0c626b6f-dcc1-3b15-a4ef-3f8ef479ac18",
                        "glosses": [
                            "тот, кто занимается проектированием и строительством городов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81870723-5143-4eec-a0c0-1d4cb48eed8a",
                                "sense_id": "9a425667-debd-3bda-9e81-8dbc193d0444",
                                "text": "Градостроители любят «укладывать» речки в гранит."
                            },
                            {
                                "example_id": "8d063b49-5691-44b8-9bcb-d047944bde76",
                                "sense_id": "9a425667-debd-3bda-9e81-8dbc193d0444",
                                "text": "Да, самой высокой оценки заслуживают результаты работы тех, кто начинал восстановление города, тем более что в отличие от современных архитекторов и градостроителей они не обладали необходимой теоретической подготовкой."
                            }
                        ]
                    }
