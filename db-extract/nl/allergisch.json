                    {
                        "translation_id": "afb9973a-9452-46fe-b2fb-d91061d9155a",
                        "source_entry_id": "c9528432-bdbf-356f-b9e8-411be2e502c1",
                        "source_sense_id": "023d029b-c27b-3f02-90c6-ed65d70d4fa8",
