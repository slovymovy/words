                "senses": [
                    {
                        "sense_id": "612e4ccb-fc05-38f8-b7f7-bcd5c7b7b42e",
                        "entry_id": "2594769f-c9da-3a06-8a93-189cb95b274f",
                        "glosses": [
                            "eine Art Besen oder Mopp zur Reinigung des Schiffsdecks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19d8d348-cb00-40fe-a57b-211e48a6d10c",
                                "sense_id": "612e4ccb-fc05-38f8-b7f7-bcd5c7b7b42e",
                                "text": "„Solcher Schwabber ist ein gar wichtiges Instrument an Bord. Er sieht einer großen, mehr als einen Meter langen Troddel ähnlich und besteht aus altem Tauwerk, das im Wasser ausgelaugt worden ist und im ausgerungenen Zustande die Fähigkeit besitzt, wie ein Feudel, sehr viel Feuchtigkeit in sich aufzunehmen. Auch wird solcher Schwabber ausgebreitet auf Deck gelegt und als Matte benutzt, namentlich vor der Kombüse (Küche), wo die Gefahr am größten ist, daß Fettflecke auf die weißgescheuerten Deckplanken spritzen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
