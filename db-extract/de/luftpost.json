                        "form": "der Luftpost"
                    },
                    {
                        "form_id": "f531aa9c-ac48-49f1-abfb-fdd173f09769",
                        "entry_id": "1f04af25-d59f-3a6b-b4fc-7a87688f3b49",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Luftpost"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75a58e41-e150-308d-aa20-0e2fca5a0c30",
                        "entry_id": "1f04af25-d59f-3a6b-b4fc-7a87688f3b49",
                        "glosses": [
                            "Beförderung der Post auf dem Luftweg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "222cafd2-4393-44c8-a4d7-d0ff54b2833f",
                                "sense_id": "75a58e41-e150-308d-aa20-0e2fca5a0c30",
                                "text": "„Bis heute ist die Luftpost in puncto Schnelligkeit unübertroffen.“"
                            },
                            {
                                "example_id": "16b8d9c5-31ba-4d38-af62-66601f73a487",
                                "sense_id": "75a58e41-e150-308d-aa20-0e2fca5a0c30",
                                "text": "„Damit begann für die Luftpost und Luftfahrt eine neue Ära, handelte es sich doch um den ersten planmäßigen, auf Dauer angelegten regelmäßigen Linienflugverkehr der Welt!“"
                            },
                            {
                                "example_id": "f8ceba71-5fe4-40d0-8efd-2b7bf59f7613",
                                "sense_id": "75a58e41-e150-308d-aa20-0e2fca5a0c30",
                                "text": "„Im Bereich Luftpost entstanden interessante Briefmarken und Belege, die zu sammeln vielen Freude macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "34e99779-3ffd-370e-b667-7594f9659b38",
                        "entry_id": "1f04af25-d59f-3a6b-b4fc-7a87688f3b49",
                        "glosses": [
                            "das auf dem Luftweg beförderte Postgut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2087058d-6873-48de-996f-f88f70b64f03",
                                "sense_id": "34e99779-3ffd-370e-b667-7594f9659b38",
                                "text": "Die Luftpost ist teurer als eine Sendung auf dem Seeweg."
                            },
                            {
                                "example_id": "bfbc8f51-2112-4e88-b264-2c60999f5160",
                                "sense_id": "34e99779-3ffd-370e-b667-7594f9659b38",
                                "text": "„Außer dem Handstempel wurde 1934 in Stuttgart für eingehende Luftpost auch ein schöner Rollstempel verwendet, von dem ich derzeit nur einen nicht ganz perfekten Abschlag (oben Briefmitte) zeigen kann.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
