    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f6c193a1-08e6-32b9-aba6-592217fa981a",
                    "sense_definition": "Qui ne s'inquiète de rien, qui est exempt de préoccupation ou de souci.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants profitaient de leurs vacances d'été, totalement <w>insouciants</w> face aux tracas des adultes."
                        },
                        {
                            "text": "Elle menait une vie heureuse et <w>insouciante</w>, sans jamais penser aux difficultés du lendemain."
                        }
                    ],
                    "synonyms": [
                        "insoucieux"
                    ],
                    "antonyms": [
                        "inquiet",
                        "soucieux",
                        "anxieux"
                    ],
                    "common_phrases": [
                        "jeunesse insouciante"
                    ]
                },
                {
                    "sense_id": "2682184f-78e9-397d-b5fa-63662f8d1d17",
                    "sense_definition": "Qui manifeste de la légèreté ou une absence visible de préoccupation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a répondu à mes questions avec un sourire <w>insouciant</w> qui m'a immédiatement rassuré."
                        },
                        {
                            "text": "D'un geste <w>insouciant</w>, le voyageur a rangé ses papiers dans sa poche avant d'embarquer."
                        }
                    ],
                    "antonyms": [
                        "grave",
                        "sérieux"
                    ],
                    "common_phrases": [
                        "air insouciant",
                        "sourire insouciant"
                    ]
                }
            ]
        }
    ]
