    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8f92cbab-7407-33bf-8c42-8c0677bfb1cb",
                    "sense_definition": "weggaan van een bepaalde plek, vaak met enige haast of om een gesprek te beëindigen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vertrek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is al laat en ik moet nu echt <w>ervandoor</w> om de laatste trein te halen.",
                            "target_lang_translations": {
                                "en": "It is already late and I really have to be <w>off</w> now to catch the last train."
                            }
                        },
                        {
                            "text": "Ik ga <w>ervandoor</w>, we spreken elkaar morgen wel weer op kantoor.",
                            "target_lang_translations": {
                                "en": "I'm <w>heading off</w>, we'll talk again tomorrow at the office."
                            }
                        }
                    ],
                    "synonyms": [
                        "ervantussen",
                        "weg",
                        "vandoor"
                    ],
                    "common_phrases": [
                        "ik ga ervandoor"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "veelgebruikt in gesproken taal bij het afscheid nemen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to leave a certain place, often in a hurry or to end a conversation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "off",
                                "target_lang_sense_clarification": "leaving a place"
                            },
                            {
                                "target_lang_word": "heading off",
                                "target_lang_sense_clarification": "leaving now"
                            },
                            {
                                "target_lang_word": "going",
                                "target_lang_sense_clarification": "departing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b66701f-2d9b-373e-97ef-32d8848ae3e4",
                    "sense_definition": "plotseling verdwenen of onvindbaar zijn, vaak na iets ongeoorloofds te hebben gedaan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verdwijning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dief ging er met de gestolen juwelen vandoor en is sindsdien <w>ervandoor</w>.",
                            "target_lang_translations": {
                                "en": "The thief made off with the stolen jewels and has been <w>gone</w> ever since."
                            }
                        },
                        {
                            "text": "Is hij <w>ervandoor</w> gegaan zonder zijn rekening in het restaurant te betalen?",
                            "target_lang_translations": {
                                "en": "Did he <w>bolt</w> without paying his bill at the restaurant?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "er met de buit vandoor"
                    ],
                    "target_lang_definitions": {
                        "en": "suddenly disappeared or untraceable, often after doing something unauthorized"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gone",
                                "target_lang_sense_clarification": "missing or fled"
                            },
                            {
                                "target_lang_word": "off",
                                "target_lang_sense_clarification": "having run away"
                            },
                            {
                                "target_lang_word": "bolted",
                                "target_lang_sense_clarification": "left suddenly"
                            }
                        ]
                    }
                }
            ]
        }
