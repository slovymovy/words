                                "target_senses": [
                                    {
                                        "sense_id": "ae843783-1bd0-34fd-b5ab-4b1180e5ea86",
                                        "entry_id": "06f850f5-69b6-3039-bf84-846c6450bcd3",
                                        "glosses": [
                                            "A person who moves slowly or takes a long time to do something."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "derogatory",
                                            "informal",
                                            "mildly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f27db630-1abc-4908-9c5f-b37618636556",
                                                "sense_id": "ae843783-1bd0-34fd-b5ab-4b1180e5ea86",
                                                "text": "Hey, you slowpokes in the back! Get a move on!"
                                            },
                                            {
                                                "example_id": "6d4c5261-bc3b-4f38-9b2b-7e172fad09ad",
                                                "sense_id": "ae843783-1bd0-34fd-b5ab-4b1180e5ea86",
                                                "text": "\"Yas'm,\" said Prissy and, turning, sauntered down the walk at snail's gait. \"Hurry, you slow poke!\""
                                            },
                                            {
                                                "example_id": "d6bde299-654f-4452-beb4-9f2db0839db8",
                                                "sense_id": "ae843783-1bd0-34fd-b5ab-4b1180e5ea86",
                                                "text": "Some cooks are diddlers and slowpokes. Some are efficient speed demons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
