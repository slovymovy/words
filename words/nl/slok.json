                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sip",
                                "target_lang_sense_clarification": "a small mouthful of drink"
                            },
                            {
                                "target_lang_word": "swig",
                                "target_lang_sense_clarification": "a large or greedy mouthful of drink"
                            },
                            {
                                "target_lang_word": "gulp",
                                "target_lang_sense_clarification": "a large amount swallowed quickly"
                            },
                            {
                                "target_lang_word": "mouthful",
                                "target_lang_sense_clarification": "the amount a mouth can hold"
                            }
                        ]
                    }
                }
            ]
        },
