                            "feminine",
                            "prepositional"
                        ],
                        "form": "аподикти́ческой"
                    },
                    {
                        "form_id": "b2cbfddb-f2b9-4ade-b195-b4e59312be27",
                        "entry_id": "9631a74a-45ac-3195-a0e4-c737be5839ce",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "аподикти́ческих"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "71430d88-78ce-34bc-be9a-bbd159f34eba",
                        "entry_id": "9631a74a-45ac-3195-a0e4-c737be5839ce",
                        "glosses": [
                            "филос. достоверный, основанный на логической необходимости, неопровержимый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17e84e5f-fdbe-4205-9610-8f332454646d",
                                "sense_id": "71430d88-78ce-34bc-be9a-bbd159f34eba",
                                "text": "В самом деле, все геометрические положения имеют аподиктический характер, т.е. связаны с сознанием их необходимости, например положение, что пространство имеет только три измерения;…"
                            },
                            {
                                "example_id": "0fcf3b5b-eba4-4024-9d62-e9e38faf303d",
                                "sense_id": "71430d88-78ce-34bc-be9a-bbd159f34eba",
                                "text": "Благодаря этой обманчивой самоочевидности положения такого рода начинают считать или совершенно незыблемыми и аподиктическими, так что их отрицание считается невозможным в силу его немыслимости или явной абсурдности, или же, что особенно распространено в специальных науках, начинают считать эти предпосылки доказанными и установленными именно в этой самой науке; в результате получается своеобразный и весьма характерный именно для нашего времени с его далеко проведенной научной специализацией догматизм специальных наук."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00870e41-770e-41ab-b3d7-4ec4a8e56f7b",
                        "source_entry_id": "9631a74a-45ac-3195-a0e4-c737be5839ce",
                        "source_sense_id": "71430d88-78ce-34bc-be9a-bbd159f34eba",
                        "target_lang_word": "apodictique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apodictique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e80aa24-abd6-3b62-9930-d4338a42f3f9",
                                        "entry_id": "67a0967d-32f9-347f-88a6-76bf0ff7b3a7",
                                        "glosses": [
                                            "Qui est démonstratif, évident."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "237f12e0-de40-49c7-84ee-2f757d979bcc",
                                                "sense_id": "7e80aa24-abd6-3b62-9930-d4338a42f3f9",
                                                "text": "Un jugement apodictique présente un caractère d’universalité et de nécessité absolue."
                                            },
                                            {
                                                "example_id": "3f64a3c5-1238-42e3-9d54-76c2867b077c",
                                                "sense_id": "7e80aa24-abd6-3b62-9930-d4338a42f3f9",
                                                "text": "Le caractère « apodictique » de la modalité du jugement consiste en ce que celui-ci est affirmé « comme lié de façon indissociable à l’entendement », et, en cela même, comme « nécessaire » et a priori."
                                            },
                                            {
                                                "example_id": "4744e442-ad05-410e-a59c-132fac0c1cd1",
                                                "sense_id": "7e80aa24-abd6-3b62-9930-d4338a42f3f9",
                                                "text": "Le caractère abstrait de la langue, les formes presque mathématiques du style ancien, sont singulièrement favorables, chez Confucius et ses disciples, à l’expression nue et tranchée de l’obligation morale, proclamée dans sa rigueur impérative ou apodictique, pour parler le langage de Kant."
                                            },
                                            {
                                                "example_id": "835676a4-48f7-4293-b98d-abab323f60b7",
                                                "sense_id": "7e80aa24-abd6-3b62-9930-d4338a42f3f9",
                                                "text": "Mes rêves devinrent une certitude, comprenez moi bien : une certitude apodictique, une certitude démontrable, réelle, et ma vie quotidienne devint un rêve."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apodictique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d4931a0-34a8-328a-807d-2aa2db471eff",
                                        "entry_id": "f2226395-6beb-3149-a07d-7d17df37a7fb",
                                        "glosses": [
                                            "Ce qui est énoncé comme une vérité de fait et comme une nécessité absolue."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3163a324-72da-44e7-935a-ec06671f6d7c",
                                                "sense_id": "4d4931a0-34a8-328a-807d-2aa2db471eff",
                                                "text": "Les sciences passent ainsi de l’assertorique (la simple constatation des faits) à l’apodictique (l’établissement des relations nécessaires)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
