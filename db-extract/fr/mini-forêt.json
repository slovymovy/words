                            {
                                "example_id": "55deb4c1-243d-4fbd-937c-064c3793c2f1",
                                "sense_id": "a9fc2c1b-8108-374b-989f-33ff14c274c4",
                                "text": "Une mini-forêt vierge plantée de grands sureaux, cachette idéale pour fumer nos élégantes."
                            },
                            {
                                "example_id": "6ca0ce69-b2b4-4134-bdab-0c92240e6572",
                                "sense_id": "a9fc2c1b-8108-374b-989f-33ff14c274c4",
                                "text": "La mini-forêt ne demande un entretien que les trois premières années suivant la plantation, à mesure que les racines des arbres s’établissent et que la canopée commence à ombrager les adventices."
                            }
                        ]
