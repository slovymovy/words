                "senses": [
                    {
                        "sense_id": "4f979236-8091-385b-8782-36b1f7bf0137",
                        "entry_id": "a1089970-6a5a-3094-ab45-1d47ca8ca152",
                        "glosses": [
                            "eine Art der Tribus Schwäne (Cygnini) in der Familie der Entenvögel (Anatidae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfa05bba-f15b-4b2f-8a7c-305cb1804dc7",
                                "sense_id": "4f979236-8091-385b-8782-36b1f7bf0137",
                                "text": "„Der natürliche Lebensraum des Singschwans ist in der Regel die karge Tundra, die mit niedriger Vegetation bewachsen ist.“"
                            },
                            {
                                "example_id": "fa4c0793-1a19-4bd1-9616-bf66fb3727e4",
                                "sense_id": "4f979236-8091-385b-8782-36b1f7bf0137",
                                "text": "„Wie der Name schon sagt, kann der Singschwan, im Vergleich zu gewöhnlichen Schwänen, ausdrucksvoll singen.“"
                            },
                            {
                                "example_id": "96aaf22b-2c71-4928-9d9b-3b8877117fcf",
                                "sense_id": "4f979236-8091-385b-8782-36b1f7bf0137",
                                "text": "„Singschwäne können ein Alter von acht Jahren erreichen, in Gefangenschaft auch deutlich mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
