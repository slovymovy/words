{
    "word": "faintness",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "19fac1ab-e1f6-310a-9ca5-692958ee0ac2",
                "word": "faintness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d1b465c7-1d24-497f-9c21-8276e9a87f58",
                        "entry_id": "19fac1ab-e1f6-310a-9ca5-692958ee0ac2",
                        "tags": [
                            "plural"
                        ],
                        "form": "faintnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7dc2b6f-5400-3f55-a95b-ac704acc594d",
                        "entry_id": "19fac1ab-e1f6-310a-9ca5-692958ee0ac2",
                        "glosses": [
                            "The property of being or feeling faint."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a91adafd-68ed-467f-ac0d-dde616c7fa10",
                                "sense_id": "c7dc2b6f-5400-3f55-a95b-ac704acc594d",
                                "text": "And he first took exceptions at this badge, / Pronouncing that the paleness of this flower / Bewray'd the faintness of my master's heart."
                            },
                            {
                                "example_id": "09186693-88c0-4811-b4e7-236a05cf62a5",
                                "sense_id": "c7dc2b6f-5400-3f55-a95b-ac704acc594d",
                                "text": "The confusion, in which impressions are sometimes involved, proceeds only from their faintness and unsteadiness, not from any capacity in the mind to receive any impression, which in its real existence has no particular degree nor proportion."
                            },
                            {
                                "example_id": "1d66ce8c-a7a6-45cc-a0f3-5335ed065c4b",
                                "sense_id": "c7dc2b6f-5400-3f55-a95b-ac704acc594d",
                                "text": "The faintness of the voice was pitiable and dreadful. It was not the faintness of physical weakness, though confinement and hard fare no doubt had their part in it. Its deplorable peculiarity was, that it was the faintness of solitude and disuse. It was like the last feeble echo of a sound made long and long ago."
                            },
                            {
                                "example_id": "b1314eee-3240-46b6-b9ce-128e18bc3cf9",
                                "sense_id": "c7dc2b6f-5400-3f55-a95b-ac704acc594d",
                                "text": "The humming sound and the unvarying white light induced a sort of faintness, an empty feeling inside his head."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "840b2a92-6953-495d-a6f3-6f756c4e891d",
                        "source_entry_id": "19fac1ab-e1f6-310a-9ca5-692958ee0ac2",
                        "source_sense_id": "c7dc2b6f-5400-3f55-a95b-ac704acc594d",
                        "source_sense_description": "property of being faint",
                        "target_lang_word": "Schwäche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwäche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "mangelnde körperliche oder geistige Kraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4057b4a-6120-4b59-895c-f424d19b1b53",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "Mich überkam plötzlich eine unerklärliche Schwäche in den Beinen."
                                            },
                                            {
                                                "example_id": "38775ebb-8556-4968-b538-df9495bfbd74",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "„Wobei ich eine klitzekleine Schwäche habe, die ich den Damen gern verschweige.“"
                                            },
                                            {
                                                "example_id": "6d99c57e-2a2d-4df2-a74c-807093a9b6a7",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "„Allgemeine Schwäche des Körpers und erhöhte Reizbarkeit des Nervensystems gesellen sich dazu.“"
                                            },
                                            {
                                                "example_id": "867dee60-c3ac-4dbb-aa75-25fae341ac8d",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "„Meine Schwäche ist wie weggeblasen.“"
                                            },
                                            {
                                                "example_id": "69ee443b-1417-461c-aed3-2dd30c8a8259",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "[Covid-19-Erkrankungen:] „Andere Genesene leiden unter einem Taubheitsgefühl, Schwäche und Gedächtniseinschränkungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5bfe74d3-0a00-3352-9c54-fc41f4caba5a",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "charakterlicher Mangel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8faae0-9017-4c24-8858-e56f63d34ea9",
                                                "sense_id": "5bfe74d3-0a00-3352-9c54-fc41f4caba5a",
                                                "text": "Mangelnder Einsatzwille ist keine Schwäche von ihm."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "45dd42d1-6602-3255-b38f-426ccae9eb59",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "besondere Neigung zu etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de28c156-b7e8-4512-b221-e7e364694eb3",
                                                "sense_id": "45dd42d1-6602-3255-b38f-426ccae9eb59",
                                                "text": "Er hat eine Schwäche für dunkle Schokolade."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "533b2f12-0f36-39c9-b0d1-4641f27f12fb",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "sachliche Unvollkommenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a97410-90d0-42ab-9170-41197bf05ba6",
                                                "sense_id": "533b2f12-0f36-39c9-b0d1-4641f27f12fb",
                                                "text": "Die Literaturkritiker versuchen, die Schwächen literarischer Werke herauszufinden."
                                            },
                                            {
                                                "example_id": "8f4b0b50-764a-4d76-bec9-c288d966b321",
                                                "sense_id": "533b2f12-0f36-39c9-b0d1-4641f27f12fb",
                                                "text": "„Die Schwäche des E-Autos liegt darin, dass es so viel mehr mineralische Rohstoffe benötigt als die Verbrenner, darunter etliche kritische Materialien, die oft unter fragwürdigen Bedingungen abgebaut werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20376ad6-9365-43bd-930a-c7c26c0db301",
                        "source_entry_id": "19fac1ab-e1f6-310a-9ca5-692958ee0ac2",
