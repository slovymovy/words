                "senses": [
                    {
                        "sense_id": "93dceb89-f31d-3877-ab0a-b8f80c23218a",
                        "entry_id": "a69f096e-0f6d-314b-9ddc-149923ddfda2",
                        "glosses": [
                            "Personne sans énergie, mollasson."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8a67966c-ed3e-46ea-a2f6-196d8ca85a22",
                                "sense_id": "93dceb89-f31d-3877-ab0a-b8f80c23218a",
                                "text": "Elle était traitée de feignasse, de molasse , elle ne disait rien et je remarquai après le cours son air de colchique mauve."
                            },
                            {
                                "example_id": "aee483b8-8abc-46fc-b7c4-a582bb1381a7",
                                "sense_id": "93dceb89-f31d-3877-ab0a-b8f80c23218a",
                                "text": "Terme de mépris signifiant paresseuse , molasse , idiote , toujours au féminin."
                            },
                            {
                                "example_id": "64d38196-e0ae-4fe9-896e-dd7820dd13b5",
                                "sense_id": "93dceb89-f31d-3877-ab0a-b8f80c23218a",
                                "text": "Donnez - moi de l'eau propre, rupins de mes fesses, que je me débarbouille, que je gratte la crasse qui me colle au paletot : un avachi qui biberonne et une molasse qui subit."
                            },
                            {
                                "example_id": "7bac2c38-bebd-4777-ac9d-a296d95912be",
                                "sense_id": "93dceb89-f31d-3877-ab0a-b8f80c23218a",
                                "text": "Le patron lui-même riait de ces facéties ; et comme Jean ne se fâchait point , on le crut un «molasse» sans énergie ."
                            }
                        ]
                    }
