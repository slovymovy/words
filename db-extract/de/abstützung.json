                ],
                "senses": [
                    {
                        "sense_id": "2e72c832-28fb-3099-8c42-e96673b1d32b",
                        "entry_id": "78284a6b-6917-36d1-837b-515b54b48d8e",
                        "glosses": [
                            "Sicherung gegen Herabfallen oder Umfallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64717dd7-abce-47b5-b936-aebbcec22750",
                                "sense_id": "2e72c832-28fb-3099-8c42-e96673b1d32b",
                                "text": "„Mittels Fußbettanpassung, Entlastungszonen, gezielter Abstützung und Polsterung wird die Druckbelastung optimal verteilt.“"
                            },
                            {
                                "example_id": "65865a83-dbcb-481b-afa7-1b0a25a96a68",
                                "sense_id": "2e72c832-28fb-3099-8c42-e96673b1d32b",
                                "text": "„Die Verkleidungsteile der Türen fahren zur besseren Abstützung heraus und die Sitze bewegen sich in eine optimale Position um einen Crash möglichst unversehrt zu überstehen.“"
                            },
                            {
                                "example_id": "35eaaaa9-6106-452a-8b23-9a3a6d865059",
                                "sense_id": "2e72c832-28fb-3099-8c42-e96673b1d32b",
                                "text": "„Damit eine Gleichgewichtslage möglich wird, muß das Becken selbst eine Abstützung erfahren.“"
                            },
                            {
                                "example_id": "2adf579a-9efa-45c0-a193-84d05e1eef18",
                                "sense_id": "2e72c832-28fb-3099-8c42-e96673b1d32b",
                                "text": "„Franz (2010) untersuchte für eine Komfortkopfstütze zur Abstützung von Kopf und Nacken Zusammenhänge zwischen Druckverteilung und Diskomfort.“"
                            },
                            {
                                "example_id": "093182fd-b206-49c3-b5ee-534278248bf7",
                                "sense_id": "2e72c832-28fb-3099-8c42-e96673b1d32b",
                                "text": "„Der Fitnessball ermöglicht Streckung, Beugung und Seitneigung der Wirbelsäule mit Abstützung des Oberkörpers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a2dfa89a-e721-39d4-b1e3-68f87b1d5e01",
                        "entry_id": "78284a6b-6917-36d1-837b-515b54b48d8e",
                        "glosses": [
                            "etwas, das zum Abstützen [1] dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00278fb3-8198-4609-a140-ab2c04eacf16",
                                "sense_id": "a2dfa89a-e721-39d4-b1e3-68f87b1d5e01",
                                "text": "„Typisch für die stationären Gasturbinen ist auch die Konstruktion mit einer inneren Abstützung für die Lagerung des Läufers im Gehäuse […].“"
                            },
                            {
                                "example_id": "be46b981-f0d7-4b3e-8057-99e2e418d536",
                                "sense_id": "a2dfa89a-e721-39d4-b1e3-68f87b1d5e01",
                                "text": "„Der Weg an den Arbeitsplatz der beiden ist beängstigend: Die Stollen sind über weite Strecken ohne Abstützung in den Fels getrieben und so niedrig, dass die Bergleute gebückt gehen müssen.“"
                            },
                            {
                                "example_id": "7d553c5e-5d73-4bab-b7dd-5434a462ee13",
                                "sense_id": "a2dfa89a-e721-39d4-b1e3-68f87b1d5e01",
                                "text": "„Bis zu einer Höhe von maximal zwei Metern kann ich eine Abstützung am Hang als Trockenmauer bauen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
