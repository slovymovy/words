                        "form": "der Heilkunde"
                    },
                    {
                        "form_id": "10fa25c9-1501-439b-855d-600e91bf382b",
                        "entry_id": "b01a39dc-7ac1-336e-b8a8-82c4a69be7da",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Heilkunde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65094950-c8b2-3367-aa6b-4fdbea8dce15",
                        "entry_id": "b01a39dc-7ac1-336e-b8a8-82c4a69be7da",
                        "glosses": [
                            "Sammelbezeichnung für die Kenntnisse, die der Überwindung körperlicher oder psychischer Beschwerden dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3170852-bbdd-461f-b782-b9f9d39c5535",
                                "sense_id": "65094950-c8b2-3367-aa6b-4fdbea8dce15",
                                "text": "„Wer die Heilkunde, ohne als Arzt bestallt zu sein, bisher berufsmäßig nicht ausgeübt hat, kann eine Erlaubnis nach § 1 in Zukunft … erhalten.“"
                            },
                            {
                                "example_id": "11a4d1a1-8467-4dde-a7f6-41403c4ee49f",
                                "sense_id": "65094950-c8b2-3367-aa6b-4fdbea8dce15",
                                "text": "„Hildegard von Bingen schrieb eine ganzheitliche Heilkunde, die sich einerseits in die sogenannten alternativen Heilverfahren einreiht, andererseits aber weit darüber hinaus geht.“"
                            },
                            {
                                "example_id": "1c5d5590-90cb-4ba6-b7bd-119edce977c6",
                                "sense_id": "65094950-c8b2-3367-aa6b-4fdbea8dce15",
                                "text": "„Die ägyptische Heilkunde macht von zahlreichen pflanzlichen und tierischen Heilmitteln Gebrauch und ist im Altertum wegen ihres Entwicklungsstandes weithin berühmt.“"
                            },
                            {
                                "example_id": "5ead7f75-260f-437c-ace8-cf02faeb9d4c",
                                "sense_id": "65094950-c8b2-3367-aa6b-4fdbea8dce15",
                                "text": "„Dennoch verfolgte er die wissenschaftliche Entwicklung der Heilkunde und Medizin genau, nicht nur aus wissenschaftlichem Interesse, sondern um stets seinen Körper unter Kontrolle zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fe3b591-1b17-44ba-bc7c-66c0a9f04d4d",
                        "source_entry_id": "b01a39dc-7ac1-336e-b8a8-82c4a69be7da",
