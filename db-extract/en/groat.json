                "senses": [
                    {
                        "sense_id": "d4486483-5e2f-3c97-b5dc-46da6dc62dbf",
                        "entry_id": "8a2cc0ba-14ee-34fe-87e9-f71608308536",
                        "glosses": [
                            "Any of various old coins of England and Scotland."
                        ],
                        "tags": [
                            "archaic",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "911f79f4-b27e-4e77-82ad-00e7e5482326",
                                "sense_id": "d4486483-5e2f-3c97-b5dc-46da6dc62dbf",
                                "text": "The Widdow that hath but a pan of braſſe,\nAnd ſcarſe a houſe to hide her head,\nSometimes no penny to buy her bread,\nMuſt pay her Landlord many a groat,\nOr twil be puld out of her throat:"
                            }
                        ]
                    },
                    {
                        "sense_id": "1ee1daf2-8908-3302-aa14-7937660ab70c",
                        "entry_id": "8a2cc0ba-14ee-34fe-87e9-f71608308536",
                        "glosses": [
                            "Any of various old coins of England and Scotland.",
                            "Any unit of currency worth four pence."
                        ],
                        "tags": [
                            "archaic",
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "34341061-acd3-325d-9c27-9dd6b3603b0d",
                        "entry_id": "8a2cc0ba-14ee-34fe-87e9-f71608308536",
                        "glosses": [
                            "Any of various old coins of England and Scotland.",
                            "A historical English coin representing such a unit: a silver coin worth four English pennies, still minted as one of the set of Maundy coins."
                        ],
                        "tags": [
                            "archaic",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "11178b06-2c0c-45e0-9030-1af02e5c6638",
                                "sense_id": "34341061-acd3-325d-9c27-9dd6b3603b0d",
                                "text": "The needy groom, that never finger'd groat,\nWould make a miracle of thus much coin …"
                            }
                        ]
                    },
