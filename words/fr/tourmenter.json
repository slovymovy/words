                {
                    "sense_id": "1aa0c22c-fee4-3234-ab38-8aff171154cc",
                    "sense_definition": "Faire subir de vives souffrances corporelles, infliger des tortures physiques.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "souffrance_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les gardes ont fini par <w>tourmenter</w> le captif pour lui arracher des aveux.",
                            "target_lang_translations": {
                                "en": "The guards eventually <w>tortured</w> the captive to extract a confession from him.",
                                "ru": "В конце концов стражники <w>пытали</w> пленника, чтобы вырвать у него признание.",
                                "de": "Die Wachen <w>folterten</w> den Gefangenen schließlich, um ihm ein Geständnis abzuringen.",
                                "es": "Los guardias acabaron por <w>torturar</w> al cautivo para arrancarle una confesión.",
                                "zh": "守卫们最终<w>拷打</w>了这名囚犯，逼他招供。"
                            }
                        },
                        {
                            "text": "Ce tyran sanguinaire aimait <w>tourmenter</w> ses opposants dans les cachots du château.",
                            "target_lang_translations": {
                                "en": "This bloodthirsty tyrant liked to <w>torture</w> his opponents in the castle dungeons.",
                                "ru": "Этот кровожадный тиран любил <w>мучить</w> своих противников в подземельях замка.",
                                "de": "Dieser blutrünstige Tyrann <w>folterte</w> seine Gegner gern in den Kerkern des Schlosses.",
                                "es": "A este tirano sanguinario le gustaba <w>torturar</w> a sus opositores en las mazmorras del castillo.",
                                "zh": "这个嗜血的暴君喜欢在城堡的地牢里<w>折磨</w>他的反对者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "supplicier",
                        "torturer"
                    ],
                    "target_lang_definitions": {
                        "en": "To inflict severe physical pain on someone, especially as torture.",
                        "ru": "Причинять кому-либо сильные телесные страдания, подвергать пыткам.",
                        "de": "Jemandem heftige körperliche Schmerzen zufügen, besonders als Folter.",
                        "es": "Infligir a alguien sufrimientos físicos intensos, especialmente como forma de tortura.",
                        "zh": "对某人施加剧烈的肉体痛苦，尤指严刑拷打。"
                    },
