                    ]
                },
                {
                    "sense_id": "90b935cf-c766-3ee3-b315-bb0af8ee16ce",
                    "sense_definition": "Plaire ou convenir à quelqu'un selon son bon vouloir ou sa fantaisie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "volonte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux venir nous rejoindre ce soir si ça te <w>chante</w>."
                        },
                        {
                            "text": "Il organise ses vacances exactement comme cela lui <w>chante</w>."
                        }
                    ],
                    "common_phrases": [
                        "si ça vous chante",
                        "comme ça lui chante"
                    ],
                    "traits": [
