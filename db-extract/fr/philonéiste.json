                "senses": [
                    {
                        "sense_id": "4e5e985e-0aec-3571-9ba8-7903f8fb33a3",
                        "entry_id": "ae9d955b-1ec3-3709-8772-86724c486334",
                        "glosses": [
                            "Personne qui aime la nouveauté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f56ead7-66d6-4581-a0a8-ed41ae8f3740",
                                "sense_id": "4e5e985e-0aec-3571-9ba8-7903f8fb33a3",
                                "text": "J’entends satisfaire en même temps le chien et le chat, je veux dire, l’abolitionniste et guillotineur, le philonéiste et le misonéiste."
                            },
                            {
                                "example_id": "4fd5cc08-c877-435d-abe4-bd1fcdc8a562",
                                "sense_id": "4e5e985e-0aec-3571-9ba8-7903f8fb33a3",
                                "text": "À l’inverse des Lacédémoniens, misonéites, les Athéniens — nous rapporte Thucydide — étaient des philonéistes."
                            },
                            {
                                "example_id": "3fff5a71-8309-45e2-a140-1477b3093573",
                                "sense_id": "4e5e985e-0aec-3571-9ba8-7903f8fb33a3",
                                "text": "Les pacifistes, au contraire, sont des philonéistes, ce ne sont pas seulement des caractères plus humains et plus raisonnables ; ils aiment aussi la paix comme une nouveauté, comme une transformation complète de l’état misérable de l’humanité."
                            }
                        ]
                    }
                ],
