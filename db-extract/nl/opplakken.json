        "nl-extract.jsonl": [
            {
                "entry_id": "7e840af3-80cc-3b23-97dd-4f8519251646",
                "word": "opplakken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fd13ea91-9a0f-390a-be2d-ba6a30617c6a",
                        "entry_id": "7e840af3-80cc-3b23-97dd-4f8519251646",
                        "glosses": [
                            "met lijm iets op iets anders bevestigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e6ff116-9c1d-4b33-99ee-b37fdea67865",
                                "sense_id": "fd13ea91-9a0f-390a-be2d-ba6a30617c6a",
                                "text": "Zorn's, in eerste instantie lokale projectje, ging wereldwijd. Mensen konden verzoekjes via zijn website indienen en als de kunstenaar de locatie geschikt vond, stuurde hij een kunstwerk op en mocht men het gratis opplakken. Inmiddels 'bewerkt'Zorn niet alleen lantaarnpalen, maar is zijn werk over de hele wereld te zien op allerlei exposities en kunstgaleries."
                            }
                        ]
                    },
                    {
                        "sense_id": "405f84b0-8ca6-3252-9a8b-29279d057e7b",
                        "entry_id": "7e840af3-80cc-3b23-97dd-4f8519251646",
                        "glosses": [
                            "iets of iemand labelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c914528d-74d7-48ae-98c9-8596bc6d677e",
                                "sense_id": "405f84b0-8ca6-3252-9a8b-29279d057e7b",
                                "text": "Amber Heard had een huwelijk met Johnny Depp en een relatie met Elon Musk, maar datete in het verleden ook met vrouwen, waaronder fotografe Tasya van Ree. Toch weigert ze zich het stempel ’biseksueel’ te laten opplakken."
                            },
                            {
                                "example_id": "54c864ff-9e81-4920-92f4-fb1d695a0afc",
                                "sense_id": "405f84b0-8ca6-3252-9a8b-29279d057e7b",
                                "text": "Toen Mike (50) vijf jaar geleden een motor kocht, waren de reacties niet van de lucht. ’Midlifecrisis zeker?’ klonk het vanuit de vriendenkring. Die term wil hij er niet opplakken; hij wilde gewoon een motor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40299423-0248-40c9-9a1e-9440897f6f9b",
                        "source_entry_id": "7e840af3-80cc-3b23-97dd-4f8519251646",
                        "source_sense_id": "fd13ea91-9a0f-390a-be2d-ba6a30617c6a",
                        "target_lang_word": "affix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5645460-aee4-3f02-aa3a-f1749abb6270",
                                        "entry_id": "3e8bf9c3-4849-3f08-a486-944a5ef225ff",
                                        "glosses": [
                                            "A bound morpheme added to a word’s stem, such as a prefix or suffix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9824140f-29d8-44f2-b272-d5f0c3f0d9bc",
                                                "sense_id": "a5645460-aee4-3f02-aa3a-f1749abb6270",
                                                "text": "A prefix is an affix that joins to the beginning of another word. Depending on the prefix, it can slightly or significantly alter the meaning of a word. For example, the English prefix “un-” changes a word into its opposite, as from “do” to “undo,” altering its meaning entirely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e1313a-716d-3371-ba0a-9534bdf36e47",
                                        "entry_id": "3e8bf9c3-4849-3f08-a486-944a5ef225ff",
                                        "glosses": [
                                            "That which is affixed; an appendage."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed57e26d-df9f-3bd7-95e0-b1f7e4612e7c",
                                        "entry_id": "3e8bf9c3-4849-3f08-a486-944a5ef225ff",
                                        "glosses": [
                                            "The complex number a+bi associated with the point in the Gauss plane with coordinates (a,b)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2103a11-3586-378a-97e8-752e85d5f325",
                                        "entry_id": "3e8bf9c3-4849-3f08-a486-944a5ef225ff",
                                        "glosses": [
                                            "Any small feature, as a figure, a flower, or the like, added for ornament to a vessel or other utensil, to an architectural feature."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "affix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c7440e8-78b8-34a0-9aaf-d6ed3b16a33b",
                                        "entry_id": "d1bc7cc4-fdf1-3558-beba-e803c92b7852",
                                        "glosses": [
                                            "To attach."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be35346b-6374-4582-9712-67d32e2e27c7",
                                                "sense_id": "3c7440e8-78b8-34a0-9aaf-d6ed3b16a33b",
                                                "text": "to affix a stigma to a person"
                                            },
                                            {
                                                "example_id": "8dfea58a-487c-4589-b33a-605d745c3e7b",
                                                "sense_id": "3c7440e8-78b8-34a0-9aaf-d6ed3b16a33b",
                                                "text": "to affix ridicule or blame to somebody"
                                            },
                                            {
                                                "example_id": "cbec5b7f-0764-4aed-a511-db9f5e26c671",
                                                "sense_id": "3c7440e8-78b8-34a0-9aaf-d6ed3b16a33b",
                                                "text": "Should they [caterpillars] affix them to the leaves of a plant improper for their food […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bab42ba-4a1f-3fc4-a754-255470b2f054",
                                        "entry_id": "d1bc7cc4-fdf1-3558-beba-e803c92b7852",
                                        "glosses": [
                                            "To subjoin, annex, or add at the close or end; to append to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36ba555c-b752-41ab-942a-3b7612337265",
                                                "sense_id": "2bab42ba-4a1f-3fc4-a754-255470b2f054",
                                                "text": "to affix a syllable to a word"
                                            },
                                            {
                                                "example_id": "483f91d4-e4d3-4539-b014-b498724ed8b8",
                                                "sense_id": "2bab42ba-4a1f-3fc4-a754-255470b2f054",
                                                "text": "to affix a seal to an instrument"
                                            },
                                            {
                                                "example_id": "f7474f98-b479-400d-a46c-dd2eeca3650d",
                                                "sense_id": "2bab42ba-4a1f-3fc4-a754-255470b2f054",
                                                "text": "to affix one’s name to a writing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2054c0b8-3496-3002-a34f-51b89b1c28f1",
                                        "entry_id": "d1bc7cc4-fdf1-3558-beba-e803c92b7852",
                                        "glosses": [
                                            "To fix or fasten figuratively; with on or upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c227c62-356e-4834-a4e2-683a224feb0d",
                                                "sense_id": "2054c0b8-3496-3002-a34f-51b89b1c28f1",
                                                "text": "eyes affixed upon the ground"
                                            },
                                            {
                                                "example_id": "1a1c5b7e-d849-4215-92d5-d741a8bc0b4a",
                                                "sense_id": "2054c0b8-3496-3002-a34f-51b89b1c28f1",
                                                "text": "Look thou no further, but affix thine eye/On that bright, shiny, round, still moving mass,/The house of blessed gods, which men call sky,/All sow'd with glist'ring stars more thick than grass..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c7a31c7-da8e-40c8-acc4-b831b9522c54",
                        "source_entry_id": "7e840af3-80cc-3b23-97dd-4f8519251646",
                        "source_sense_id": "fd13ea91-9a0f-390a-be2d-ba6a30617c6a",
                        "target_lang_word": "stick to",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stick to",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61605c81-5f31-3fdf-bfb4-2f6572b2f635",
                                        "entry_id": "11d17ce3-d4a2-34c7-a887-5d3a422a04f0",
                                        "glosses": [
                                            "To persist; to continue (to use, do, etc.)"
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c981714d-0882-43e0-9a64-13185a316e71",
                                                "sense_id": "61605c81-5f31-3fdf-bfb4-2f6572b2f635",
                                                "text": "I have seen all the fancy electric toothbrushes, but I'm going to stick to the old-fashioned kind."
                                            },
                                            {
                                                "example_id": "317e0590-6faa-4221-909b-9e3a24d487e9",
                                                "sense_id": "61605c81-5f31-3fdf-bfb4-2f6572b2f635",
                                                "text": "If you stick to your studies, you will continue to improve."
                                            },
                                            {
                                                "example_id": "6691396a-6929-4752-ad76-b3e8b2c06905",
                                                "sense_id": "61605c81-5f31-3fdf-bfb4-2f6572b2f635",
                                                "text": "When I did newspaper work in the 1950s I always found it hard to initiate criticism of a person. Now, in the late 1970s, I suddenly find it has become hard to praise a person. Take, for example, the case of Liu Jie, an inspector of the neighborhood registry in the Daxing’anling district of Heilongjiang, who was praised in the press for sticking to principles. She also had the support of the Provincial Party Committee. But it was precisely the commendation of the Party newspaper that brought calamity upon her, and the support of the provincial leadership was of no use in breaking the siege that befell her."
                                            },
                                            {
                                                "example_id": "0d773218-7c49-4c63-8da5-21f1f6fd40d8",
                                                "sense_id": "61605c81-5f31-3fdf-bfb4-2f6572b2f635",
                                                "text": "What I get from work makes me a better mother, and what I get from being a mother makes me a better journalist. At least that's my story and I'm sticking to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01278951-dac4-3a34-ad0b-89bf1e652751",
                                        "entry_id": "11d17ce3-d4a2-34c7-a887-5d3a422a04f0",
                                        "glosses": [
                                            "To follow and remain close to."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4779e5ba-e6ee-4658-8421-6bf4117416d5",
                                                "sense_id": "01278951-dac4-3a34-ad0b-89bf1e652751",
                                                "text": "The suspect doubled back through an alley, but the detective stuck to him like glue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7aaea80-8068-342c-98f5-2a1e9d562d6b",
                                        "entry_id": "11d17ce3-d4a2-34c7-a887-5d3a422a04f0",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see stick, to."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
