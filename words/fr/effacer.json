{
    "word_family": [
        "effacement",
        "effaceur",
        "ineffaçable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0133e8da-b8cd-3b68-bbfe-7c5ea7c8be89",
                    "sense_definition": "Faire disparaître ce qui est écrit ou dessiné, nettoyer une surface marquée.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "supprimer_marques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur demande à un élève d'<w>effacer</w> le tableau avant la pause."
                        },
                        {
                            "text": "Tu peux <w>effacer</w> ce mot au crayon si tu as fait une faute."
                        }
                    ],
                    "synonyms": [
                        "gommer",
                        "enlever"
                    ],
                    "common_phrases": [
                        "effacer le tableau"
                    ]
                },
                {
                    "sense_id": "067e0f56-cda5-3b39-b7be-beec4afb84a9",
                    "sense_definition": "Faire disparaître progressivement une marque, une couleur ou un souvenir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "supprimer_marques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La forte pluie a fini par <w>effacer</w> toutes les traces de pas dans la boue."
                        },
                        {
                            "text": "Le temps qui passe ne pourra jamais <w>effacer</w> les souvenirs de notre enfance."
                        }
                    ],
                    "synonyms": [
                        "enlever"
                    ],
                    "common_phrases": [
                        "effacer les traces",
                        "effacer un souvenir"
                    ]
                },
                {
                    "sense_id": "64858351-b4ba-3eca-8d88-1d1a1db199c4",
                    "sense_definition": "Faire disparaître les effets d'une situation passée ou annuler un engagement financier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annuler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette belle victoire permet enfin à l'équipe d'<w>effacer</w> le lourd échec du mois précédent."
                        },
                        {
                            "text": "L'accord signé récemment permettra à ce pays d'<w>effacer</w> une dette importante."
                        }
                    ],
                    "common_phrases": [
                        "effacer une dette"
                    ]
                },
                {
                    "sense_id": "503e0e95-8954-3e33-ae95-67462c381e72",
                    "sense_definition": "Se retirer, se tenir à l'écart pour laisser passer quelqu'un ou ne pas attirer l'attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "retrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a choisi de s'<w>effacer</w> discrètement pour laisser son collègue présenter le nouveau projet."
                        },
                        {
                            "text": "Elle s'<w>efface</w> courtoisement dans le couloir étroit afin de laisser passer la directrice."
                        }
                    ]
                },
                {
                    "sense_id": "39f25ff9-f2d1-3983-ad2e-ac268417af38",
                    "sense_definition": "Faire oublier ou reléguer au second plan par un éclat ou un mérite supérieur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surpasser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La performance remarquable de la cantatrice a complètement <w>effacé</w> celle de ses partenaires."
                        },
                        {
                            "text": "Ce roman magistral a <w>effacé</w> tous les autres succès littéraires de l'année."
                        }
                    ],
                    "synonyms": [
                        "éclipser"
                    ]
                }
            ]
        }
    ]
}