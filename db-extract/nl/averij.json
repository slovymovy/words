                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fca61af-b855-4adf-ac48-437294d05ba2",
                                                "sense_id": "ec28d2dc-6fad-3524-a05a-a50bf21e123c",
                                                "text": "Be careful not to damage any of the fragile items while unpacking them."
                                            },
                                            {
                                                "example_id": "e5636c82-9ab3-4590-b71c-889edb873e40",
                                                "sense_id": "ec28d2dc-6fad-3524-a05a-a50bf21e123c",
                                                "text": "Cold temperatures, heavy rain, falling rocks, strong winds and glacier movement can damage the equipment."
                                            },
                                            {
                                                "example_id": "6358d954-8f6f-487e-bf7b-2ff95a1fb1e4",
                                                "sense_id": "ec28d2dc-6fad-3524-a05a-a50bf21e123c",
                                                "text": "The building was erected in two years, at the parochial expence, on the foundation of the former one, which was irreparably damaged by the hurricane of Auguſt, 1712."
                                            },
                                            {
                                                "example_id": "6a40ddfd-772e-45f9-9c93-3c3e070a0b2b",
                                                "sense_id": "ec28d2dc-6fad-3524-a05a-a50bf21e123c",
                                                "text": "He […] came up to the English admiral and gave him a broadside, with which he killed many of his men and damaged the ship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a59f0165-9c5f-35a8-9f27-574ce3f84bd0",
                                        "entry_id": "431230a8-e9ca-3664-947c-416a03bcd394",
                                        "glosses": [
                                            "To undergo damage; to take damage."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33e9a3ae-38f5-3eac-bd60-5183030f85c4",
                                        "entry_id": "431230a8-e9ca-3664-947c-416a03bcd394",
                                        "glosses": [
                                            "To remove a damaged or unsalable item from the sales floor for processing."
