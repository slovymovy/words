                "forms": [],
                "senses": [
                    {
                        "sense_id": "072733c3-b551-3011-a622-2f2b126a101d",
                        "entry_id": "751beb4c-4a97-3943-8aa0-dd23db755205",
                        "glosses": [
                            "Alternative form of chi."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6d6e4be9-d905-4e16-92a0-c1e4ddbd65fa",
                                "sense_id": "072733c3-b551-3011-a622-2f2b126a101d",
                                "text": "If you are calm and relaxed it will be easier for you to accept and use his ki, helping him to reach his goal. In other words, you will redirect his ki or enhance it with your own to bring your attacker down in the direction he was directing his ki."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "764fd6be-e0da-30f9-a5ed-fe4161012429",
                "word": "ki",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "be9789eb-25dc-411d-b1ce-d91d32c3d398",
                        "entry_id": "764fd6be-e0da-30f9-a5ed-fe4161012429",
                        "tags": [
                            "plural"
                        ],
                        "form": "kis"
