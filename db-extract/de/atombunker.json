                    {
                        "sense_id": "6566181f-848b-30a6-acf9-0d5b51f1c07a",
                        "entry_id": "e61606df-1529-3fdb-90f0-3d2bcae0aeb2",
                        "glosses": [
                            "ein gesicherter Raum oder ein gesichertes Gebäude (Bunker), das vor den Folgen einer Explosion einer Atombombe schützen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12768257-bfab-4b2c-9de2-6bea25da20fe",
                                "sense_id": "6566181f-848b-30a6-acf9-0d5b51f1c07a",
                                "text": "„Neun Unterseeboote konnten hier andocken, es gab Kojen für 3000 Seeleute, das Oberkommando der 14. U-Boot-Division saß in einem extra gesicherten Atombunker.“"
                            },
                            {
                                "example_id": "e06f4b7f-b86f-44ae-842d-ecefa5e2751a",
                                "sense_id": "6566181f-848b-30a6-acf9-0d5b51f1c07a",
                                "text": "Früher halfen seine Maschinen dabei, Atombunker zu tarnen, heute kühlen sie Pizza."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
