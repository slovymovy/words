                        "entry_id": "abc81c13-dd35-3ae5-89a4-471f76132ae1",
                        "glosses": [
                            "A substance in food that is hard to digest and promotes the growth of beneficial intestinal microorganisms."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "6796f0f7-4afb-4cac-9595-ac150ab25c05",
                                "sense_id": "c7ea9203-a0c1-3d21-a78e-167fe7e98377",
                                "text": "The table below includes plant foods we consider to be prebiotic “stars” since they are the foods listed in the scientific literature as sources of prebiotics."
                            },
                            {
                                "example_id": "4c2d5224-413a-48e4-ba06-8773ef97b431",
                                "sense_id": "c7ea9203-a0c1-3d21-a78e-167fe7e98377",
                                "text": "Prebiotics are nowhere near as well researched as probiotics, although there are already some sound results pertaining to how they work."
                            }
                        ]
                    }
                ],
