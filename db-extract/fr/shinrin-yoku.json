                "senses": [
                    {
                        "sense_id": "faf9c5e4-f435-38aa-b918-d5af24da862c",
                        "entry_id": "92db5494-436e-35da-9b95-4fba0c9c7931",
                        "glosses": [
                            "Pratique consistant à fréquenter les arbres dans les forêts pour améliorer sa santé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b1532c1-e9c2-41bb-ba20-ae0328372c24",
                                "sense_id": "faf9c5e4-f435-38aa-b918-d5af24da862c",
                                "text": "Vous allez voir qu’un shinrin-yoku, ou un bain de forêt, propose bien autre chose, et heureusement !"
                            },
                            {
                                "example_id": "eca0380f-374b-4681-adb9-f28acaf06fea",
                                "sense_id": "faf9c5e4-f435-38aa-b918-d5af24da862c",
                                "text": "Ce livre vous ouvre, en plus de nombreuses suggestions et connaissances sur le thème des Bains de forêt ou Shinrin Yoku, une variété d’exercices effectifs pour le corps, l’esprit et l’âme qui vous feront beaucoup de bien."
                            },
                            {
                                "example_id": "baf16ba9-0fd7-4b88-afb8-a24e7fda5c01",
                                "sense_id": "faf9c5e4-f435-38aa-b918-d5af24da862c",
                                "text": "« En 1982, l’agence forestière du Japon forge le terme de \"shinrin-yoku\" pour inviter les Japonais à fréquenter les forêts, afin de contribuer à une bonne hygièle de vie », explique Alix Cosquer, chercheuse en psychologie environnementale et autrice de La sylvothérapie (PUF, Que sais-je ?)."
                            }
                        ]
                    }
