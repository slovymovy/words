                                "target_senses": [
                                    {
                                        "sense_id": "39e0316e-e1fc-3a84-8a9e-21baa33d170b",
                                        "entry_id": "0655bd03-9304-3f0b-b89a-90ee64950ccc",
                                        "glosses": [
                                            "Of or relating to India or its people; or (formerly) of the East Indies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33b1c000-4706-4c25-b301-e70e6fc794bf",
                                                "sense_id": "39e0316e-e1fc-3a84-8a9e-21baa33d170b",
                                                "text": "An IAF representative told an Indian parliamentary committee that due to the Ukraine war a “major delivery” from Moscow “is not going to take place.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48f60668-143d-3d62-895f-5302b6053b3f",
                                        "entry_id": "0655bd03-9304-3f0b-b89a-90ee64950ccc",
                                        "glosses": [
                                            "Eastern; Oriental."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cda294dc-fbea-442e-9053-3a8b60cd5bf5",
                                                "sense_id": "48f60668-143d-3d62-895f-5302b6053b3f",
                                                "text": "The morrow next apprear'd with purple hayre / Yet dropping fresh out of the Indian fount, / And bringing light into the heavens fayre […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ee04636-2ced-364f-9017-17dc068be914",
                                        "entry_id": "0655bd03-9304-3f0b-b89a-90ee64950ccc",
                                        "glosses": [
                                            "Of or relating to the indigenous peoples of the Americas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa6858c1-1ef4-4f68-a432-dd6b5d048cd7",
                                                "sense_id": "1ee04636-2ced-364f-9017-17dc068be914",
                                                "text": "The hardships of bark-collecting in the primeval forests of South America are of the severest kind, and undergone only by the half-civilized Indians and people of mixed race, in the pay of speculators or companies located in the towns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8cd780d-4629-3c99-81f1-495fa15d280f",
                                        "entry_id": "0655bd03-9304-3f0b-b89a-90ee64950ccc",
                                        "glosses": [
                                            "Made with Indian corn or maize."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8868f36-bd70-4ba6-8265-6bf2e078b972",
                                                "sense_id": "f8cd780d-4629-3c99-81f1-495fa15d280f",
                                                "text": "Indian bread"
                                            },
                                            {
                                                "example_id": "0c89211d-8fff-460d-8652-283c73c8393d",
                                                "sense_id": "f8cd780d-4629-3c99-81f1-495fa15d280f",
                                                "text": "Indian meal"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09fa522f-3b0c-3a01-8a44-8077c55d2357",
                                        "entry_id": "0655bd03-9304-3f0b-b89a-90ee64950ccc",
                                        "glosses": [
                                            "Designating any of various chess openings now characterised by black's attempt to control the board through knights and fianchettoed bishops rather than with a central pawn advance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Indian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f8c19a5-fdb8-3b57-8633-d7ea3f80c652",
                                        "entry_id": "925ee376-eb9d-3d39-a2cd-68d308efcdb6",
                                        "glosses": [
                                            "A person from India."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd859405-3680-4655-bf89-81af57bb3317",
                                                "sense_id": "8f8c19a5-fdb8-3b57-8633-d7ea3f80c652",
                                                "text": "Young Indians looking for work opportunities have made up a sizeable portion of undocumented migrants in the US, many after making the dangerous trek through Latin America to reach the US southern border."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36148f90-3d3a-3cc3-9c84-08e208c8b42a",
                                        "entry_id": "925ee376-eb9d-3d39-a2cd-68d308efcdb6",
                                        "glosses": [
                                            "An American Indian, a member of one of the indigenous peoples of the Americas (generally excluding the Aleut, Inuit, Metis, and Yupik)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57fa22b0-a631-4d72-8be2-20c65b8a2e24",
                                                "sense_id": "36148f90-3d3a-3cc3-9c84-08e208c8b42a",
                                                "text": "We stigmatize the Indians, also, as cowardly and treacherous, because they use stratagem in warfare in preference to open force; but in this they are fully justified by their rude code of honor."
                                            },
                                            {
                                                "example_id": "e3bfade6-47ed-4142-9027-ec155fb263b7",
                                                "sense_id": "36148f90-3d3a-3cc3-9c84-08e208c8b42a",
                                                "text": "High Jack had been drinking too much rum ever since we landed in Boca. You know how an Indian is—the palefaces fixed his clock when they introduced him to firewater."
                                            },
                                            {
                                                "example_id": "9a1f1891-e97f-4714-8429-b2ffde913d85",
                                                "sense_id": "36148f90-3d3a-3cc3-9c84-08e208c8b42a",
                                                "text": "With savage desperation the Indian lunged his horse straight at Hopalong and, knife in hand, leaped for him!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffb9e8cb-d414-3c70-806f-929532f6b727",
                                        "entry_id": "925ee376-eb9d-3d39-a2cd-68d308efcdb6",
                                        "glosses": [
                                            "An indigenous inhabitant of Australia, New Zealand or the Pacific islands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "579496b3-3336-3e6e-a2d8-906829fe2612",
                                        "entry_id": "925ee376-eb9d-3d39-a2cd-68d308efcdb6",
                                        "glosses": [
                                            "Ellipsis of Indian cuisine."
                                        ],
