                                "target_senses": [
                                    {
                                        "sense_id": "cdffe3e1-9b6b-3629-8326-8aa946e7d1a6",
                                        "entry_id": "81d77ac0-8939-3de2-b741-109f7e149da4",
                                        "glosses": [
                                            "горн., воен. способность взрывчатых веществ производить при взрыве местное дробление твердой среды, прилегающей непосредственно к заряду"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae70819-93c6-4b2f-94ca-af13ae682bca",
                                                "sense_id": "cdffe3e1-9b6b-3629-8326-8aa946e7d1a6",
                                                "text": "Бризантность тротила заметно превосходит бризантность аммотола, что объясняется большей скоростью его детонации."
                                            }
