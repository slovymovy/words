                "senses": [
                    {
                        "sense_id": "7f761cb1-2f30-3606-8e24-6bc5cae6e637",
                        "entry_id": "55d39825-2055-313f-8be4-371ee4d2df33",
                        "glosses": [
                            "in een slechtere positie dan anderen zetten of houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f0f205b-1402-4402-b759-5853c2676baf",
                                "sense_id": "7f761cb1-2f30-3606-8e24-6bc5cae6e637",
                                "text": "Mijn dochter van 7 gilt veel. Als er ook maar een mogelijkheid van denkbare achterstelling ten opzichte van haar zus (9) of broertje (3) lijkt aan te komen, zet ze het op een gillen. Het gaat vaak over wat ze oneerlijk vindt, dat we meer van haar zus en broertje houden, dat haar zus haar vriendin afpakt."
                            },
                            {
                                "example_id": "a56763d8-f5ec-452b-8e39-8f1908de6ada",
                                "sense_id": "7f761cb1-2f30-3606-8e24-6bc5cae6e637",
                                "text": "In wat grotendeels een monoloog is, bespreekt ze, met veel humor én in grote ernst, de historische dimensies en gevolgen van de bij wet geregelde achterstelling van vrouwen."
                            },
                            {
                                "example_id": "3ab6b51a-4a6e-497e-a9ae-2bacdfd46f5e",
                                "sense_id": "7f761cb1-2f30-3606-8e24-6bc5cae6e637",
                                "text": "Ik heb niet de indruk dat ik dit momenteel in psychotische toestand schrijf, maar bij de suggestie dat veel migrantenkinderen door sociale achterstellingen en tegenstrijdige verwachtingen van de maatschappij en hun familie in geestelijke crises raken, kan ik me van alles voorstellen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7dfbe9b0-a1a7-3f59-86f7-cb46e1253803",
                        "entry_id": "55d39825-2055-313f-8be4-371ee4d2df33",
                        "glosses": [
                            "pas betaling kunnen krijgen na andere vorderingen of schuldeisers"
                        ],
                        "tags": [
                            "van een vordering of schuldeiser"
                        ],
                        "examples": [
                            {
                                "example_id": "a238e57d-29d1-481e-b5b9-d9e66e6958c8",
                                "sense_id": "7dfbe9b0-a1a7-3f59-86f7-cb46e1253803",
                                "text": "Om het hogere risico te compenseren, krijgen de houders van achtergestelde obligaties meer rente dan de gewone obligatiehouders. Achterstelling van de schuld maakt er nog geen eigen vermogen van."
                            }
                        ]
                    }
