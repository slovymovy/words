            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ebad639d-f63a-3bae-a9d5-dbd0dad2293e",
                    "sense_definition": "In a way that is a natural or basic part of something and cannot be removed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nature_of_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The design of the new aircraft is <w>inherently</w> stable even in very turbulent weather conditions.",
                            "target_lang_translations": {
                                "ru": "Конструкция нового самолета <w>изначально</w> устойчива даже в условиях сильной турбулентности.",
                                "pl": "Konstrukcja nowego samolotu jest <w>z natury</w> stabilna nawet w bardzo trudnych warunkach pogodowych."
                            }
                        },
                        {
                            "text": "Many people believe that human beings are <w>inherently</w> good despite the conflicts we see in the world.",
                            "target_lang_translations": {
                                "ru": "Многие люди верят, что человеческие существа <w>по своей природе</w> добры, несмотря на конфликты, которые мы видим в мире.",
                                "pl": "Wielu ludzi wierzy, że istoty ludzkie są <w>z natury</w> dobre, pomimo konfliktów, które widzimy na świecie."
                            }
                        }
                    ],
                    "synonyms": [
                        "essentially",
                        "innately",
                        "intrinsically",
                        "naturally"
                    ],
                    "antonyms": [
                        "extrinsically",
                        "externally"
                    ],
                    "common_phrases": [
                        "inherently risky"
                    ],
                    "target_lang_definitions": {
                        "ru": "По своей природе, как неотъемлемая или основная часть чего-либо, которую невозможно отделить.",
                        "pl": "W sposób stanowiący naturalną lub podstawową część czegoś, której nie można usunąć; wewnętrznie właściwy."
                    },
