                "senses": [
                    {
                        "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                        "entry_id": "94f1b383-454c-3919-853b-c2357fe446e7",
                        "glosses": [
                            "Sachverhalt/Vorgang/Zustand, der exemplarisch/prototypisch ist auch für ähnliche Fälle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d695592-f692-4a33-8849-40bb17a97808",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "Singapur ist ein Musterfall für den Wandel von einem armen zu einem ökonomisch erfolgreichen Staat."
                            },
                            {
                                "example_id": "0e3aedab-36b4-4301-93a0-d6035f1877cf",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "Russland gilt als Musterfall einer illiberalen Demokratrie."
                            },
                            {
                                "example_id": "7245a28b-40fc-4033-b9c5-a67f5b1b7524",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "Der Prenzlauer Berg in Berlin ist zum Musterfall der Gentrifizierung geworden."
                            },
                            {
                                "example_id": "d92af6c2-956a-4359-b9f3-59fee473a517",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "„Irland galt als Musterland, jetzt wird es zum Musterfall der Krise: Nirgendwo sonst in der EU ballen sich Unternehmens-, Immobilien- und Finanzprobleme so massiv“"
                            },
                            {
                                "example_id": "d7b81c02-011b-4bf1-91f6-ec1261b797ae",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "„Die Beziehung von Taylor und Burton galt als prominenter Musterfall, der im gesellschaftlichen Diskurs, der damals rund um dieses Thema entstand, immer wieder angeführt wurde.“"
                            },
                            {
                                "example_id": "fae694ea-8378-4fe3-8270-77c7ed100b5f",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "Der 1889 erschienene dreiteilige Erzählband Papa Hamlet der beiden deutschen Schriftsteller Arno Holz und Johannes Schlaf gilt als Musterfall naturalistischer Prosa."
                            },
                            {
                                "example_id": "0d9ce142-d4c9-4456-80c8-04a831e838b6",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "König Ödipus: „So erklärt im 4. Jahrhundert v. Chr. Aristoteles in seiner Poetik das sophokleische Drama zum Musterfall der Tragödie, vor allem unter dem Gesichtspunkt der Handlungsführung, des Umschlagens von Glück in Unglück (Peripetie) sowie von Verblendung zur Selbsterkenntnis (anagnorisis).“"
                            },
                            {
                                "example_id": "34393898-7d16-4cc4-9f24-49249cd20e6a",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "„»Mich irritiert etwas, sage ich ganz offen, dass Herr Snowden als erstes nach China ging, für mich nicht der Musterfall eines Rechtsstaates, und als nächstes nach Russland ging, auch nicht der Musterfall eines Rechtsstaates.«“"
                            },
                            {
                                "example_id": "69ae027b-d5ee-4155-b496-a82db57c6f39",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "Statistisches Bundesamt: „Neuwagen kosten 4,1 Prozent mehr und Gebrauchtwagen 2,0 Prozent, wie die Preisermittler anhand von Musterfällen festgestellt haben.“"
                            },
                            {
                                "example_id": "3a991ccf-e6d3-49de-8ada-e8cd58ffcf59",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "„Viele Wähler könnten auch damit leben, wenn nicht ihr Kandidat sondern der bzw. die andere als Präsident im November antritt. Es ist der Musterfall der Demokratie: Seine Stimme abgeben, aber die Entscheidung der Mehrheit akzeptieren.“"
                            },
                            {
                                "example_id": "58e07368-f705-4a34-8d20-7ae301ba35d9",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "„In seiner Begrüßung lobt Jury Vorsitzender und NDR Hörfunkdirektor Joachim Knuth das Gewinnerbuch als »ein Musterfall dessen, was exzellente Sachbücher vermögen«.“"
                            },
                            {
                                "example_id": "4a09c5f7-2282-4389-8d0c-9c5128064b49",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "„Das Donaumoos - ein Musterfall für unvorhergesehene Spätfolgen und Langzeitwirkungen eines massiven Eingriffs in den Haushalt der Natur.“"
                            },
                            {
                                "example_id": "fae3d58a-b131-4188-b270-e70c71452d60",
                                "sense_id": "98ae7b67-4818-3ce6-9e2b-0a695e737256",
                                "text": "Der Permafrost in den Alpen schmilzt: „Der 1896 erbauten Hütte droht bald das endgültige Aus. «Es ist ein Musterfall. Weil es das erste Mal in der Geschichte des SAC ist, dass eine Hütte wegen klimabedingter Felsbewegungen aufgegeben werden muss», so der Geologe weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e8457133-9bce-3b54-a979-9e5be6f3e3bc",
                        "entry_id": "94f1b383-454c-3919-853b-c2357fe446e7",
                        "glosses": [
                            "Gerichtsverfahren, dessen Urteil wegweisend für ähnliche Fälle ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f97151c-e5b3-47aa-b51a-5e579dfd2b9e",
                                "sense_id": "e8457133-9bce-3b54-a979-9e5be6f3e3bc",
                                "text": "„In zwei Musterfällen bekräftigte hierzu nun das BSG, dass die Ungleichbehandlung zulässig ist.“"
                            },
                            {
                                "example_id": "ecefb5be-f7e3-441b-925d-99be57859d5a",
                                "sense_id": "e8457133-9bce-3b54-a979-9e5be6f3e3bc",
                                "text": "„Der Bundesverband von Haus & Grund ist dagegen bereits auf der Suche nach einem Musterfall, um die Mietpreisbremse juristisch überprüfen zu lassen.“"
                            },
                            {
                                "example_id": "5fef4865-d5e7-4b17-a922-d5f86cdef4e6",
                                "sense_id": "e8457133-9bce-3b54-a979-9e5be6f3e3bc",
                                "text": "Zweitwohnsitzsteuer: „Rund 300 Einsprachen landeten bei den drei Gemeinden. In Absprache mit der IG entschieden diese, vier Musterfälle zu behandeln. Alle wurden abgewiesen.“"
                            },
                            {
                                "example_id": "31c44605-da6a-45d9-9b7d-29d15bf31c6e",
                                "sense_id": "e8457133-9bce-3b54-a979-9e5be6f3e3bc",
                                "text": "Beiträge für das Fitnessstudio während der Coronapandemie 2021: „In einem Musterfall aus Niedersachsen hat der Bundesgerichtshof (BGH) am Mittwoch (04.05.) entschieden, dass Kunden das Recht haben, die Rückzahlung ihrer Beiträge, die in dieser Zeit gezahlt wurden, zu verlangen.“"
                            },
                            {
                                "example_id": "40702e59-f97c-4584-a51b-f2f333db6143",
                                "sense_id": "e8457133-9bce-3b54-a979-9e5be6f3e3bc",
                                "text": "Trunkenheit im Verkehr?: „In dem Musterfall hatte sich der fahruntüchtige Mann erst mal ans Steuer gesetzt und den Motor gestartet, war aber nicht losgefahren, sondern hatte sich von seiner Frau dann wohl überreden lassen, das Auto doch stehen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
