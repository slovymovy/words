{
    "word_family": [
        "projet",
        "projection",
        "projecteur",
        "projectile",
        "projectionniste",
        "rétroprojecteur",
        "rétroprojeter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2ed679fd-7709-3bfa-b140-a58a232c5928",
                    "sense_definition": "Former le dessein de faire quelque chose ; concevoir ou planifier une action future.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "planification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>projetons</w> de partir en vacances en Italie au début du mois prochain."
                        },
                        {
                            "text": "Les architectes <w>projettent</w> de rénover entièrement cet ancien bâtiment situé en plein centre-ville."
                        }
                    ],
                    "synonyms": [
                        "planifier",
                        "envisager",
                        "prévoir"
                    ],
                    "common_phrases": [
                        "projeter de faire",
                        "projeter un voyage"
                    ]
                },
                {
                    "sense_id": "7be5afee-9321-389f-966a-1977eb25a84a",
                    "sense_definition": "Diffuser ou faire apparaître une image, un film ou de la lumière sur une surface ou un écran.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "optique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cinéma de mon quartier va <w>projeter</w> un film classique restauré tout le week-end."
                        },
                        {
                            "text": "Le soleil couchant <w>projette</w> une longue ombre dorée sur la façade de la maison."
                        }
                    ],
                    "synonyms": [
                        "diffuser"
                    ],
                    "common_phrases": [
                        "projeter un film",
                        "projeter une ombre"
                    ]
                },
                {
                    "sense_id": "d237af21-2b93-3a99-9ebf-7482bd617fd7",
                    "sense_definition": "Lancer, propulser violemment quelque chose ou quelqu'un en avant ou au loin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le choc brutal a <w>projeté</w> le conducteur contre le volant de la voiture."
                        },
                        {
                            "text": "La puissance de l'explosion a <w>projeté</w> des débris métalliques à plusieurs mètres de distance."
                        }
                    ],
                    "synonyms": [
                        "propulser",
                        "éjecter",
                        "expulser"
                    ],
                    "common_phrases": [
                        "être projeté en avant",
                        "projeter au sol"
                    ]
                },
                {
                    "sense_id": "13e7c930-0592-3f90-976e-3d4ea0c3ca68",
                    "sense_definition": "Représenter sur un plan ou une surface un solide selon des règles géométriques précises.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "géométrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En cours de dessin technique, les étudiants doivent <w>projeter</w> ce cône sur un plan horizontal."
                        },
                        {
                            "text": "Le logiciel permet de <w>projeter</w> chaque point de la courbe avec une extrême précision."
                        }
                    ],
                    "synonyms": [
                        "reporter"
                    ],
                    "common_phrases": [
                        "projeter sur un plan",
                        "projeter un point"
                    ]
                },
                {
                    "sense_id": "24820d8b-14d2-3426-ac1f-b75378e0713d",
                    "sense_definition": "Former une avancée, dépasser du plan d'un alignement ou d'un ensemble architectural.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette corniche en pierre se <w>projette</w> de façon très visible au-dessus de l'entrée principale."
                        },
                        {
                            "text": "Le balcon moderne se <w>projette</w> légèrement sur la façade pour capter davantage de lumière."
                        }
                    ],
                    "synonyms": [
                        "saillir",
                        "dépasser"
                    ],
                    "common_phrases": [
                        "se projeter sur la façade"
                    ]
                }
            ]
        }
    ]
}