                ],
                "senses": [
                    {
                        "sense_id": "128717f8-ea7c-3c38-8dde-3b887d0f5e6c",
                        "entry_id": "dd9815a5-76a7-35a9-ac24-4dc7190d29ec",
                        "glosses": [
                            "Gerät, mit dem eine Person feststellen kann, ob an einem elektrischen Leiter, beispielsweise einer Stromleitung, Spannung anliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "380026e5-2dac-489f-a4cb-588ea05525ad",
                                "sense_id": "128717f8-ea7c-3c38-8dde-3b887d0f5e6c",
                                "text": "„Ist hier eine Leitung unter dem Putz?“ „Ich weiß es nicht, wir brauchen einen Spannungsprüfer.“"
                            },
                            {
                                "example_id": "d3870f4d-5b0a-4b1e-bca8-de7eb7800610",
                                "sense_id": "128717f8-ea7c-3c38-8dde-3b887d0f5e6c",
                                "text": "Wenn Sie Wochen nach dem Umzug immer noch im Dunkeln sitzen […] - dann wird es Zeit, selbst zu Kabeln und Spannungsprüfer zu greifen."
                            },
                            {
                                "example_id": "e30d2898-caf7-413d-b481-c3a33e38a744",
                                "sense_id": "128717f8-ea7c-3c38-8dde-3b887d0f5e6c",
                                "text": "Vor seinem Büro am Münchner Heinz Nixdorf-Lehrstul für medizinische Elektronik hat der Biologe und Ingenieur Bernhard Wolf eine kleine Werkstatt eingerichtet, samt Schraubzwinge, Feilen und Spannungsprüfer."
                            },
                            {
                                "example_id": "dec48a26-ccd9-47ba-b292-08055f1a209e",
                                "sense_id": "128717f8-ea7c-3c38-8dde-3b887d0f5e6c",
                                "text": "Doch sichere Messergebnisse erzielt man nur mit einem Spannungsprüfer oder einem Multimeter, da bei diesen Messgeräten der Potentialunterschied mit zwei Mess-Spitzen zuverlässig ermittelt wird."
                            },
                            {
                                "example_id": "2a1adb2f-b293-4a96-8e46-d5c19e1c5b63",
                                "sense_id": "128717f8-ea7c-3c38-8dde-3b887d0f5e6c",
                                "text": "Messen Sie nun unbedingt alle Leiter mit einem zweipoligen Spannungsprüfer nach, ehe Sie mit den Arbeiten an Netz und Verbrauchern beginnen: Halten Sie eine Spitze des Spannungsprüfers an die Phase, also die stromführende Leitung, und die zweite nacheinander an die Kontakte von Neutral- und Schutzleiter. Wenn die Lampe aufglimmt, liegt Spannung an."
                            },
                            {
                                "example_id": "b5e47791-bf41-4666-a95d-836e1858b8e1",
                                "sense_id": "128717f8-ea7c-3c38-8dde-3b887d0f5e6c",
                                "text": "Um festzustellen, ob an einer bestimmten Stelle einer Schaltung Spannung gegen Erde vorliegt, kann ein einpoliger Spannungsprüfer, ein sog. Polsucher, benutzt werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
