                                        "sense_id": "4cfe2c10-2fd9-32d2-9e16-1ad22d982371",
                                        "entry_id": "3161969d-178b-39b4-a02e-85a1f8579c87",
                                        "glosses": [
                                            "That flies or can fly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0a0897f-3b86-45e3-be9b-7df9f4ee45db",
                                                "sense_id": "4cfe2c10-2fd9-32d2-9e16-1ad22d982371",
                                                "text": "flying fox"
                                            },
                                            {
                                                "example_id": "f2406e0a-8482-4c07-a6e0-5e4cb5004f20",
                                                "sense_id": "4cfe2c10-2fd9-32d2-9e16-1ad22d982371",
                                                "text": "a flying rumour"
                                            },
                                            {
                                                "example_id": "60222875-a3b8-4890-bf73-6eb4d356a3a3",
                                                "sense_id": "4cfe2c10-2fd9-32d2-9e16-1ad22d982371",
                                                "text": "in a sudden hail of exploding flying glass"
                                            },
                                            {
                                                "example_id": "38ba46ff-d0bb-45c0-b846-e459283192ed",
                                                "sense_id": "4cfe2c10-2fd9-32d2-9e16-1ad22d982371",
                                                "text": "Matthew (26—6 to 13), Mark (14—3 to 9), and Luke (7—37 and 38) also heard of, and related, the circumstance of Mary, whom John says (11 — 2) was the sister of Lazarus, anointing the head of Jesus with ointment, yet they neither of them utter a syllable about his raising her brother from the dead. It is difficult to account for this fact, unless we suppose that John was actually dishonest, or that he took up, believed and recorded a flying story, which an occurrence of some kind had given rise to, but which was without any foundation in truth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "874eee44-19a7-3a78-9c21-dc4166058fab",
                                        "entry_id": "3161969d-178b-39b4-a02e-85a1f8579c87",
                                        "glosses": [
                                            "Brief or hurried."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d17ef969-9826-487b-8179-76e5b59db52a",
                                                "sense_id": "874eee44-19a7-3a78-9c21-dc4166058fab",
                                                "text": "flying visit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d428fab4-f506-3cd5-aa7f-20da116ef13d",
                                        "entry_id": "3161969d-178b-39b4-a02e-85a1f8579c87",
                                        "glosses": [
                                            "Capable of moving rapidly; highly mobile."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d7926ba-3566-4f47-8235-2881e04b650b",
                                                "sense_id": "d428fab4-f506-3cd5-aa7f-20da116ef13d",
                                                "text": "flying column"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "708e09d5-2f6f-33d9-a634-d424c529f346",
                                        "entry_id": "3161969d-178b-39b4-a02e-85a1f8579c87",
                                        "glosses": [
                                            "Not secured by yards."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52ba1e6c-8aba-3bff-b59f-d12254177513",
                                        "entry_id": "3161969d-178b-39b4-a02e-85a1f8579c87",
                                        "glosses": [
                                            "Capable of foiling."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a43f3d3-c2a1-451c-8df4-a9412a83ff07",
                                                "sense_id": "52ba1e6c-8aba-3bff-b59f-d12254177513",
                                                "text": "Flying ferries are the watercraft of the future!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02b95d84-e689-3e10-97de-e87efc2bbe1e",
                                        "entry_id": "3161969d-178b-39b4-a02e-85a1f8579c87",
                                        "glosses": [
                                            "Designating a cattle brand consisting of a letter extended on both sides with tilde-like curved lines."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6319585-72ca-451d-b422-a5174c38fe6f",
                                                "sense_id": "02b95d84-e689-3e10-97de-e87efc2bbe1e",
                                                "text": "He brands his cow W (flying W) or — (two-bar)."
                                            },
                                            {
                                                "example_id": "71810638-579b-47b8-92ac-613cd6bf9735",
                                                "sense_id": "02b95d84-e689-3e10-97de-e87efc2bbe1e",
                                                "text": "[…] some seventy-five cows belonging to William and Bernie with a Flying W […]"
                                            },
                                            {
                                                "example_id": "4b97d46c-e216-4bde-93d8-66fac3a2862a",
                                                "sense_id": "02b95d84-e689-3e10-97de-e87efc2bbe1e",
                                                "text": "Wyles cut the fence, keeping the Flying D cowboys occupied rounding up their cattle."
                                            }
                                        ]
                                    }
                                ]
                            },
