                "senses": [
                    {
                        "sense_id": "c69fa538-084a-34b7-b415-de185fdcf0ba",
                        "entry_id": "1255c4a6-393c-3cc7-bf68-4afdd6b3dffa",
                        "glosses": [
                            "mężczyzna odrzucający normy moralne i etyczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75fcd4f3-8e43-4f1b-8e86-3ccfa90cec8e",
                                "sense_id": "c69fa538-084a-34b7-b415-de185fdcf0ba",
                                "text": "Amoralistami społecznymi byli filozofowie, których etyka zaprzeczała obowiązującym w danym czasie normom (…). Amoraliści absolutni (…) odrzucają już samą możliwość istnienia i tworzenia zasad etycznych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1846e92b-de16-48a8-bce6-eeeb7fd1b94e",
                        "source_entry_id": "1255c4a6-393c-3cc7-bf68-4afdd6b3dffa",
                        "source_sense_id": "c69fa538-084a-34b7-b415-de185fdcf0ba",
                        "target_lang_word": "amoraliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amoraliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31e9a419-fed5-3f73-b2be-6c92c159e92e",
                                        "entry_id": "6eedbcb1-d7d3-3fce-916e-dedfd4666e42",
                                        "glosses": [
                                            "Relatif à l'amoralisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58756910-4ab1-4bb3-9bd6-a582917d7b0a",
                                                "sense_id": "31e9a419-fed5-3f73-b2be-6c92c159e92e",
                                                "text": "L’ingratitude de Fouché, au contraire, n’est que celle, beaucoup plus fréquente, de l’amoraliste absolu, qui tout naïvement ne pense qu’à lui et à son propre avantage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "734b0f89-2e02-4621-9f8f-221cf6c1a0db",
                        "source_entry_id": "1255c4a6-393c-3cc7-bf68-4afdd6b3dffa",
                        "source_sense_id": "c69fa538-084a-34b7-b415-de185fdcf0ba",
                        "target_lang_word": "аморалист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аморалист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2f1566a6-969a-39f0-8bce-76cadc984a89",
                                        "entry_id": "13a7fe33-93ad-3d64-828c-581dc12635d9",
                                        "glosses": [
                                            "тот, кто отрицает моральные устои и общепринятые нормы поведения в обществе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9305b08c-a6fb-442b-9fac-382833c7d806",
                                                "sense_id": "2f1566a6-969a-39f0-8bce-76cadc984a89",
                                                "text": "Ленин был абсолютным аморалистом в политике и потому ему было легко быть таким превосходным и успешным тактиком."
                                            }
