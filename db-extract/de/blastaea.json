                "senses": [
                    {
                        "sense_id": "190c874c-99b5-32ee-8273-c49f1f555249",
                        "entry_id": "2efc69eb-edc5-3697-9e7e-45c90e9fee59",
                        "glosses": [
                            "die hypothetische evolutionsbiologische erste Ausgangsform aller mehrzelligen Tiere, die 1872 - in Analogie zu dem ontogenetischen Stadium der Blastula – von Ernst Haeckel als einschichtige zelluläre Hohlkugel angenommen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e98f7ad-dfe5-40aa-ae9d-7277dbe9046c",
                                "sense_id": "190c874c-99b5-32ee-8273-c49f1f555249",
                                "text": "Vor dem Hintergrund seiner biogenetischen Grundregel postulierte Ernst Haeckel in Anlehnung an das ontogenetische Stadium der Blastula die Blastaea als zelluläre Hohlkugel mit intrazellulärer Verdauung. Diese Organisationsform repräsentiert den allerersten Schritt des Weges zu mehrzelligen, tierischen Organismen."
                            }
                        ],
                        "sense_index_json": "\"1\""
