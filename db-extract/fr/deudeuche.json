                "senses": [
                    {
                        "sense_id": "5375f532-49f8-3a70-83f6-d4653c6c2cff",
                        "entry_id": "4c87d9b4-d23c-39dc-87ef-514af248cc98",
                        "glosses": [
                            "Surnom populaire donné à la deux-chevaux de Citroën."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a8d7e45-0d4a-4edd-887c-e01f496fa986",
                                "sense_id": "5375f532-49f8-3a70-83f6-d4653c6c2cff",
                                "text": "La veille de mon départ Momo me propose de prendre sa deudeuche pour le retour, moi je prendrai la bétaillère pour rapatrier quelques chevaux."
                            },
                            {
                                "example_id": "dbd95244-2d53-4fac-8d32-54d9b72c9c1f",
                                "sense_id": "5375f532-49f8-3a70-83f6-d4653c6c2cff",
                                "text": "La deudeuche fit une embardée, partit brouter quelques mètres de sillon du champ labouré, se cabra, se rétablit en grognant de toute la puissance chevrotante de son moteur, reprit enfin sa danse sur le chemin."
                            },
                            {
                                "example_id": "82868aac-99e6-43f8-9a11-7420c4964f70",
                                "sense_id": "5375f532-49f8-3a70-83f6-d4653c6c2cff",
                                "text": "Tu as envie de voir les rues de Paris avec des voitures de rêve, des Cadillac, des Chambord, des Versailles, et même des deudeuches pied-de-poule ou des Ami 6 ? Elles étaient toutes belles, de toutes les façons !"
                            }
                        ]
                    },
                    {
                        "sense_id": "f2b25523-e01b-355d-b350-4faaec44d508",
                        "entry_id": "4c87d9b4-d23c-39dc-87ef-514af248cc98",
                        "glosses": [
                            "Chose rustique et bon marché."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "062aa13a-91ca-453e-902d-64b1d9c55146",
                                "sense_id": "f2b25523-e01b-355d-b350-4faaec44d508",
                                "text": "De Kourou, Soyouz, la « deudeuche » de l’espace, bénéficie désormais comme les autres fusées de « l’effet de fronde »."
                            }
                        ]
                    }
