                        "examples": [
                            {
                                "example_id": "aecde6d3-2e6f-494d-b50b-0ffd15d31037",
                                "sense_id": "4f7daeda-dfa8-3fdc-a987-8c40eb35ad3b",
                                "text": "Op de dag dat een aanslagpleger een aantal mensen neerstak op de London Bridge, stopte Dora een paar frisdrankflessen in de oudpapiermand op de werkkamer."
                            },
                            {
                                "example_id": "a15ef097-10bb-4bfe-b709-bdff0d5db39d",
                                "sense_id": "4f7daeda-dfa8-3fdc-a987-8c40eb35ad3b",
                                "text": "Het enzym verwerkt polyethyleentereftalaat (pet), bekend van de plastic frisdrankflessen. Normaal gesproken duurt het honderden jaren voordat dit plastic in de natuur is afgebroken. Het enzym zou volgens de onderzoekers een oplossing kunnen zijn voor het wereldwijde overschot aan plastic afval."
                            }
                        ]
