                                    {
                                        "sense_id": "06d6edac-bfa2-3f40-99d6-d403454751f9",
                                        "entry_id": "1c9616c5-e7ed-395f-9a11-32d7247047de",
                                        "glosses": [
                                            "Petit coffre divisé en compartiments pour porter des bouteilles ou des aliments."
                                        ],
