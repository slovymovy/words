                                    {
                                        "sense_id": "29fe25a3-a741-3dbb-9332-8cb0ba4154ae",
                                        "entry_id": "af7b8f52-c7c8-3183-901a-d9579174c3a4",
                                        "glosses": [
                                            "Eau semi gelée."
                                        ],
                                        "tags": [],
