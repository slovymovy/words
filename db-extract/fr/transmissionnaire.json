                        "glosses": [
                            "Qui transmet."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "256cacaa-df50-40a5-babb-ef1ab7b3d403",
                                "sense_id": "e2b41a5a-92c0-3aae-83f3-189e3eea9244",
                                "text": "Parce que là, — tout se trouvant déplacé, interverti, — il n'y avait plus ce mouvement vibratoire, répercuteur transmissionnaire de ce son, et puisque rien ne se perd absolument dans la nature, il en résulte que ce que j'entendais alors, n'était que le bruit d'une génération éteinte."
                            }
                        ]
                    }
                ],
