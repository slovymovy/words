            "pos": "verb",
            "senses": [
                {
                    "sense_id": "044cee68-a44d-34ec-8b76-20d457e32c3b",
                    "sense_definition": "Passer d'un côté à l'autre d'une rue, d'une voie ou d'un chemin.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut toujours regarder des deux côtés avant de <w>traverser</w> la rue."
                        },
                        {
                            "text": "Les enfants <w>traversent</w> prudemment sur le passage pour piétons devant l'école."
                        }
                    ],
                    "synonyms": [
                        "franchir"
                    ],
                    "common_phrases": [
                        "traverser la rue",
                        "traverser au feu vert"
                    ]
                },
                {
                    "sense_id": "d04f24d5-c7c1-3f61-8fdd-f2d98dac62ca",
                    "sense_definition": "Parcourir un espace d'un bout à l'autre ou aller au-delà d'une étendue.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train rapide met plusieurs heures pour <w>traverser</w> cette vaste région."
                        },
                        {
                            "text": "Nous avons pu <w>traverser</w> la forêt entière avant le coucher du soleil."
                        }
                    ],
                    "synonyms": [
                        "parcourir",
                        "sillonner"
                    ],
                    "common_phrases": [
                        "traverser la ville",
                        "traverser la frontière",
                        "traverser l'océan"
                    ]
                },
                {
                    "sense_id": "9f4735c5-29fb-36dc-b4fb-517b139f7436",
                    "sense_definition": "Passer au milieu d'un lieu ou s'étendre en coupant un espace.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un magnifique fleuve calme <w>traverse</w> la ville historique de part en part."
                        },
                        {
                            "text": "Cette ancienne route nationale <w>traverse</w> plusieurs petits villages pittoresques."
                        }
                    ],
                    "synonyms": [
                        "couper"
                    ],
                    "common_phrases": [
                        "fleuve qui traverse",
                        "route qui traverse"
                    ]
                },
                {
                    "sense_id": "c785bac6-ac49-39cd-a55a-332770d5ccb0",
                    "sense_definition": "Venir à l'esprit soudainement, ou vivre une période d'épreuves.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise familiale <w>traverse</w> actuellement une crise économique sans précédent."
                        },
                        {
                            "text": "Une pensée très étrange m'a soudainement <w>traversé</w> l'esprit pendant la réunion."
                        }
                    ],
                    "synonyms": [
                        "connaître",
                        "endurer"
                    ],
                    "common_phrases": [
                        "traverser une crise",
                        "traverser une épreuve",
                        "traverser l'esprit"
                    ]
                },
                {
                    "sense_id": "adea8fc3-2f13-3438-ae8d-d7260547151b",
                    "sense_definition": "Percer de part en part un corps solide, une matière ou un obstacle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "penetration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie battante a fini par <w>traverser</w> son manteau en laine épais."
                        },
                        {
                            "text": "La lumière matinale <w>traverse</w> facilement les rideaux fins de la chambre."
                        }
                    ],
                    "synonyms": [
                        "transpercer",
                        "percer"
                    ],
                    "common_phrases": [
                        "traverser de part en part"
                    ]
                },
                {
                    "sense_id": "3bcee04f-89cf-3305-8259-ebd3b2cac955",
                    "sense_definition": "Créer des obstacles ou s'opposer aux projets de quelqu'un pour en empêcher la réussite.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre intrigant a tout fait pour <w>traverser</w> les desseins de son rival."
                        },
                        {
                            "text": "Aucun obstacle imprévu ne semblait pouvoir <w>traverser</w> ses ambitieux projets politiques."
                        }
                    ],
                    "synonyms": [
                        "contrecarrer",
                        "entraver"
                    ],
                    "antonyms": [
                        "favoriser"
                    ],
                    "common_phrases": [
                        "traverser les desseins",
                        "traverser un projet"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "S'emploie principalement dans la langue littéraire ou classique."
                        }
                    ]
                }
            ]
        }
    ]
