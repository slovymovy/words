                            {
                                "example_id": "8b81b535-060c-43f9-8596-fd6a3566d239",
                                "sense_id": "a49ca794-1104-30da-a6b5-9296111c4d5a",
                                "text": "Eerder heeft het werk tijdelijk stil gelegen vanwege het wachten op een zogeheten aanlegvergunning van zowel gemeente Tubbergen als de provincie Overijssel. Het vervangen was nodig omdat het vorige transportriool voor al het afvalwater uit Tubbergen te klein was geworden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d17e5ecb-d74e-42ce-af1d-4c8936a3992f",
                        "source_entry_id": "d5f0db02-b0ed-3107-8881-056c30cdc2ce",
