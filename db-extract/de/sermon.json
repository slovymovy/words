                ],
                "senses": [
                    {
                        "sense_id": "e126516d-745a-3958-9cac-1d2c28f74286",
                        "entry_id": "62fd43b6-ceb1-3b00-874b-dc1f08d865c5",
                        "glosses": [
                            "weitschweifige, langweilige Rede"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "48531038-b409-4ece-a3a3-4a1978ccf657",
                                "sense_id": "e126516d-745a-3958-9cac-1d2c28f74286",
                                "text": "Alles, was für den späteren Salinger typisch ist – eine peinlich genau durchgearbeitete Prosa, ein etwas manisches Interesse am Zen-Buddhismus, ein Hang zum Sermon und ein Hass auf alles Akademische – lässt sich an „Zooey“ beobachten."
                            },
                            {
                                "example_id": "6c0c470a-82ef-4911-8e54-7114d6859791",
                                "sense_id": "e126516d-745a-3958-9cac-1d2c28f74286",
                                "text": "„Er schien mir zuzuhören, während ich meinen Sermon abspulte.“"
                            },
                            {
                                "example_id": "e533de84-b9df-4d3b-9395-e11069181760",
                                "sense_id": "e126516d-745a-3958-9cac-1d2c28f74286",
                                "text": "„Sie hörten sich seinen herausfordernden Sermon nur deshalb weiter an, weil er überraschend gut beschlagen in der Wissenschaftsgeschichte war, von der die meisten Wissenschaftler nur nebulose Vorstellungen haben.“"
                            },
                            {
                                "example_id": "441cd11b-2e17-4a85-b0ac-6b0b1fbeb526",
                                "sense_id": "e126516d-745a-3958-9cac-1d2c28f74286",
                                "text": "„Allerdings hatte Cesar sich dafür einen endlosen Sermon über die Biologie der Lüneburger Heide und ein kaum minder ausgedehntes Traktat über Horst Cunerts bübische Nichtsnutzigkeit anhören müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8aff0672-1afd-3bfa-a074-ee114b03716d",
                        "entry_id": "62fd43b6-ceb1-3b00-874b-dc1f08d865c5",
                        "glosses": [
                            "Rede, in der die biblische Botschaft verkündet wird"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e293cc12-fca4-48f3-8f3a-790fd97b000d",
                        "source_entry_id": "62fd43b6-ceb1-3b00-874b-dc1f08d865c5",
                        "source_sense_id": "8aff0672-1afd-3bfa-a074-ee114b03716d",
                        "source_sense_description": "veraltet, Religion, Christentum: Rede, in der die biblische Botschaft verkündet wird",
                        "target_lang_word": "sermon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sermon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91271d0f-a591-3369-8f04-63d6c6a7075b",
                                        "entry_id": "8740e233-50df-355c-b9bb-9b3404832d31",
                                        "glosses": [
                                            "To discourse to or of, as in a sermon."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc3bf762-d23c-4472-8894-7e4066cb51e0",
                                                "sense_id": "91271d0f-a591-3369-8f04-63d6c6a7075b",
                                                "text": "January 23 1583, Edmund Spenser, letter to Walter Raleigh\nTo some I know this methode will seem displeasaunt, which had rather have good discipline delivered plainly in way of precepts, or sermoned at large, as they use, then thus clowdily enwrapped in allegorical devises"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f0683ee-9107-366c-810b-b0d744005160",
                                        "entry_id": "8740e233-50df-355c-b9bb-9b3404832d31",
                                        "glosses": [
                                            "To tutor; to lecture."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba3368e2-c273-4024-9d00-841f3e850449",
                                                "sense_id": "2f0683ee-9107-366c-810b-b0d744005160",
                                                "text": "Come, sermon me no further."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sermon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00c8ae46-75eb-3b10-af6e-7c5cafbe6ad7",
                                        "entry_id": "f8b3324e-203f-30ab-b278-f0a872c66901",
                                        "glosses": [
                                            "Religious discourse; a written or spoken address on a religious or moral matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c313a5-8464-4bac-88f3-6db45f027d69",
                                                "sense_id": "00c8ae46-75eb-3b10-af6e-7c5cafbe6ad7",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdec74ea-8b19-36e5-8c06-7e5782a5d89a",
                                        "entry_id": "f8b3324e-203f-30ab-b278-f0a872c66901",
                                        "glosses": [
                                            "A lengthy speech of reproval."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
