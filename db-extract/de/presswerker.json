                "senses": [
                    {
                        "sense_id": "4786565c-39fc-3a64-99ea-d995ff88b4f6",
                        "entry_id": "87fa30da-5403-3271-baa6-46d0d5e10623",
                        "glosses": [
                            "eine Person, die in einem Presswerk^([1]) arbeitet"
                        ],
                        "tags": [
                            "Maschinenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "be6dfc7a-4cda-458e-be57-ae55e87b1ddf",
                                "sense_id": "4786565c-39fc-3a64-99ea-d995ff88b4f6",
                                "text": "Er fing mit 27 Jahren als Presswerker in der Automobilindustrie an zu arbeiten."
                            },
                            {
                                "example_id": "f6f0f5e0-2a58-4472-8545-6f8da653c7eb",
                                "sense_id": "4786565c-39fc-3a64-99ea-d995ff88b4f6",
                                "text": "Die Zahl der Presswerker wurde in den letzten zwei Jahren um ca. 20 % gesteigert."
                            },
                            {
                                "example_id": "7dd734d0-f73f-45e3-b478-6b948d553ccc",
                                "sense_id": "4786565c-39fc-3a64-99ea-d995ff88b4f6",
                                "text": "Drittens soll dem Kunden beziehungsweise dem Presswerker mit ausgefeilten und umfangreichen Trainingsprogrammen geholfen werden, um die Servopresse in kurzer Zeit auf Höchstleistung laufen zu lassen;"
                            },
                            {
                                "example_id": "32a57f93-1328-46e7-b151-03869038833b",
                                "sense_id": "4786565c-39fc-3a64-99ea-d995ff88b4f6",
                                "text": "Die Presswerker, die die Pressteile in Behälter laden, führen eine Kontrolle der Teile durch. Beanstandungen werden laufend im Arbeitsprozess durch eine einfach gehaltene Bedieneroberfläche erfasst […]."
                            },
                            {
                                "example_id": "038c80c2-5a22-4a5e-acb3-678d3163dfef",
                                "sense_id": "4786565c-39fc-3a64-99ea-d995ff88b4f6",
                                "text": "Innerhalb dieser Presse kommt der von Schuler konzipierte elektronische Drei-Achs-Transfer zum Einsatz. Damit ist dem Presswerker ein breites Anwendungsspektrum geboten, das mit einer einfachen und schnellen Materialzuführung einhergeht."
                            },
                            {
                                "example_id": "3219b7c9-1ce9-42cb-a905-8d7af4f7aa55",
                                "sense_id": "4786565c-39fc-3a64-99ea-d995ff88b4f6",
                                "text": "Sehr eng arbeiten die Presswerker mit den Ingenieuren zusammen, die bei Mercedes-Benz neue Anlagen und Werkstoffe entwickeln: mit der Produktions- und Werkstofftechnik."
                            },
                            {
                                "example_id": "9004dee0-e54f-4ced-bc63-46213dc041fa",
                                "sense_id": "4786565c-39fc-3a64-99ea-d995ff88b4f6",
                                "text": "Dabei wurde auch die Philosophie des Presswerkers deutlich, die unmissverständlich die Kaltumformung sowie das Tryout zum Inhalt hat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
