                        "glosses": [
                            "Contrary to intuition or common sense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e39fc9bb-c698-4382-891b-c61429a6c03d",
                                "sense_id": "3599af95-f3d3-398d-a47a-c9067614d247",
                                "text": "With the students who worked on drafts in class, a number of aspects of lexicography proved challenging and counterintuitive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35a6d148-3353-4d8f-9ad4-f1dad121b2bc",
                        "source_entry_id": "e2760c20-276f-3029-a654-658737a12531",
