                        "sense_id": "9b84fe77-35b0-340d-86f8-39d99f360d65",
                        "entry_id": "07b3c95e-eaa0-35a8-88fa-04cfdc7e816e",
                        "glosses": [
                            "związany z Majorką, dotyczący Majorki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa02c84e-0b97-425b-b754-f5eb8cb607ab",
                                "sense_id": "9b84fe77-35b0-340d-86f8-39d99f360d65",
                                "text": "W roku 1328 najmniej 20 statków majorkańskich popłynęło do środkowej Barbarii. Należy tu jednak zaznaczyć, że statki majorkańskie były raczej niewielkie i pod względem tonażu nie mogły się mierzyć z barcelońskimi, a tym bardziej z genueńskimi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
