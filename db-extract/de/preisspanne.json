                "senses": [
                    {
                        "sense_id": "d12b4660-28cb-3e06-a903-b9b35b66b5ae",
                        "entry_id": "531ea34e-7cb7-3329-ab7d-1589c4736391",
                        "glosses": [
                            "Unterschied zwischen dem niedrigsten und dem höchsten Preis; Bandbreite von Preisen, innerhalb derer ein Produkt oder eine Dienstleistung angeboten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5eb45d7-2f89-44b1-b2ab-1054bac6cebc",
                                "sense_id": "d12b4660-28cb-3e06-a903-b9b35b66b5ae",
                                "text": "„Der Strompreis für Wärmepumpentarife wird sich bis 2042 in einer Preisspanne zwischen 30 und 34 Cent pro kWh bewegen.“"
                            },
                            {
                                "example_id": "b70d7bf8-43ab-4037-b70b-6deb7379c27e",
                                "sense_id": "d12b4660-28cb-3e06-a903-b9b35b66b5ae",
                                "text": "„Die Aktie der Lintec Computer AG wird heute und morgen in einer Preisspanne von 60 bis 70 angeboten.“"
                            },
                            {
                                "example_id": "0cc1138e-144e-4fda-8eb6-b72d3e1605ea",
                                "sense_id": "d12b4660-28cb-3e06-a903-b9b35b66b5ae",
                                "text": "„Die Preisspanne reicht von rund 230 bis 1.310 Mark.“"
                            },
                            {
                                "example_id": "b9f10af2-7c2e-4b0e-a180-09317021119c",
                                "sense_id": "d12b4660-28cb-3e06-a903-b9b35b66b5ae",
                                "text": "„Unter der Preisspanne von 200 bis 300 Mark lohnt sich das Geschäft mit dieser Technologie für sie nicht mehr.“"
                            },
                            {
                                "example_id": "5adbe0dd-2410-4e01-bca1-fd2a8c03f0aa",
                                "sense_id": "d12b4660-28cb-3e06-a903-b9b35b66b5ae",
                                "text": "„In kaum einer anderen Produktgruppe geht die Preisspanne so weit auseinander wie bei den Grafikkarten.“"
                            },
                            {
                                "example_id": "51196d18-7f79-4220-b160-ad42004d9aee",
                                "sense_id": "d12b4660-28cb-3e06-a903-b9b35b66b5ae",
                                "text": "„Generell ist die Preisspanne bei Messerschärfern aber recht groß:“"
                            },
                            {
                                "example_id": "a6ebfd90-1315-4b4a-a146-0d9774bcbf3c",
                                "sense_id": "d12b4660-28cb-3e06-a903-b9b35b66b5ae",
                                "text": "„Auch hier gibt es enorme Preisspannen, einige Anbieter verlangen keinerlei Gebuehren, andere bis zu 500 Mark.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
