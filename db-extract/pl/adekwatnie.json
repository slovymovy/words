                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1b19199-5e48-4bb0-bcab-82298619f49c",
                        "source_entry_id": "a672a2ac-36e0-3adf-b10a-52e7c052600c",
                        "source_sense_id": "e5b839d2-e165-344c-b91f-beb38b2f2e97",
                        "source_sense_description": "im rechten Verhältnis zu den Anforderungen, Erwartungen, Mühen",
                        "target_lang_word": "adäquat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adäquat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c46459a-1252-3a41-9de4-90cab5da2ba6",
                                        "entry_id": "c5d0f010-a444-3931-ae73-d3fb6a541345",
                                        "glosses": [
                                            "den gestellten Bedingungen angemessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf6623a-c980-405e-8325-6f3bb3fc4961",
                                                "sense_id": "2c46459a-1252-3a41-9de4-90cab5da2ba6",
                                                "text": "„Daß niemals ein Mensch demjenigen adäquat handeln werde, was die reine Idee der Tugend enthält, beweist gar nicht etwas Chimärisches in diesem Gedanken.“"
                                            },
                                            {
                                                "example_id": "8dc67ed3-af99-4b60-9327-457418600daa",
                                                "sense_id": "2c46459a-1252-3a41-9de4-90cab5da2ba6",
                                                "text": "„Die Schrift ist nicht nur nicht die Sprache selbst, sondern sie ist derselben auch in keiner Weise adäquat.“"
                                            },
                                            {
                                                "example_id": "1a1548fd-44e8-486a-830c-e01c0417d206",
                                                "sense_id": "2c46459a-1252-3a41-9de4-90cab5da2ba6",
                                                "text": "„Es handelt sich bei dem konkreten mitgeführten Messer nicht mehr um einen Gebrauchsgegenstand des täglichen Lebens, der regelmäßig mitgeführt und durchweg in sozial adäquater Weise eingesetzt wird.“ (Urteilstext)"
                                            },
                                            {
                                                "example_id": "d9b49be2-10bb-4d15-a8f5-fe0fd4b4112c",
                                                "sense_id": "2c46459a-1252-3a41-9de4-90cab5da2ba6",
                                                "text": "„Den Neukelten beziehungsweise Neuheiden und vor allem den neuen Druiden geht es um eine Wiederbelebung keltischer Tradition, vor allem der keltischen Religion nach dem Motto: Nicht das Christentum, sondern das Heidentum ist die für Europa adäquate Religion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e46bd69d-736a-421f-bd21-eb44093f0b8c",
                        "source_entry_id": "a672a2ac-36e0-3adf-b10a-52e7c052600c",
                        "source_sense_id": "e5b839d2-e165-344c-b91f-beb38b2f2e97",
                        "source_sense_description": "im rechten Verhältnis zu den Anforderungen, Erwartungen, Mühen",
                        "target_lang_word": "angemessen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angemessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                        "entry_id": "da0ab13e-61be-3b81-b8ad-9c0cfb1bb7ae",
                                        "glosses": [
                                            "den Verhältnissen entsprechend, passend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8caf65fa-6c23-4acb-babb-c7d8b2cd6611",
                                                "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                                "text": "Der Preis ist angemessen."
                                            },
                                            {
                                                "example_id": "155ddf90-ecd5-4849-bbc6-85a7d70d47f2",
                                                "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                                "text": "„Linguistinnen und Linguisten verfügen idealerweise über vielfältige sprachliche Register und Stile, die es ihnen ermöglichen, fachliche Inhalte adressatengerecht zu kommunizieren, und sie wissen, welche Form welchem Adressatenkreis gegenüber angemessen ist.“"
                                            },
                                            {
                                                "example_id": "da14ded4-cf0e-49a9-a412-3c1218c0ebc6",
                                                "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                                "text": "Was stellen Sie sich denn genau unter einer angemessenen Vergütung vor?"
                                            },
                                            {
                                                "example_id": "c741f45c-6ea3-4b5d-88db-4cdac471f6ee",
                                                "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                                "text": "In manchen Geschäften wird Kleidung verkauft, die sehr billig ist. Sie wird von Menschen im Ausland hergestellt, die nicht angemessen dafür bezahlt werden."
                                            },
                                            {
                                                "example_id": "ff159eaf-0a44-49db-8aaa-4f928e405f3b",
                                                "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                                "text": "Der Staat muss für eine angemessene Unterbringung von Asylbewerbern sorgen, so hat es jetzt der Europäische Gerichtshof entschieden."
                                            },
                                            {
                                                "example_id": "ba4cec2d-7e30-407d-b8c5-23bb7fae065d",
                                                "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                                "text": "Bis heute wird in Deutschland äußerst kontrovers über einen angemessenen Umgang mit [Hitlers Buch] \"Mein Kampf\" diskutiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "angemessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad1f795d-d3c5-3690-b1ce-66dd6e459d35",
