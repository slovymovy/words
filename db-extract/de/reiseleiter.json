                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Reiseleiter"
                    },
                    {
                        "form_id": "b089e104-e539-49b9-b477-f17320606d8a",
                        "entry_id": "2e7f95c3-95d0-3cac-a658-9769f6b3865e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Reiseleiter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6cc5023a-470b-32f0-bd0b-d7304a1ac7d2",
                        "entry_id": "2e7f95c3-95d0-3cac-a658-9769f6b3865e",
                        "glosses": [
                            "Person, die eine Reisegesellschaft betreut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ccbff61-749b-4c87-a954-a8e3da877b8b",
                                "sense_id": "6cc5023a-470b-32f0-bd0b-d7304a1ac7d2",
                                "text": "„Der Reiseleiter, schon in Mantel und Mütze, hat seine letzte Ansprache gehalten.“"
                            },
                            {
                                "example_id": "4795b472-076b-4219-bf2a-04a02101a707",
                                "sense_id": "6cc5023a-470b-32f0-bd0b-d7304a1ac7d2",
                                "text": "„Der Reiseleiter bittet uns zu Tisch, es gibt Krabbensuppe und Lammfilet.“"
                            },
                            {
                                "example_id": "fd350a66-e9db-4511-8c54-067b3e3f0d27",
                                "sense_id": "6cc5023a-470b-32f0-bd0b-d7304a1ac7d2",
                                "text": "„Die Rettung kam in Gestalt eines rot- und weißgekleideten Reiseleiters, der in ein Megaphon rief, dass alle Gäste willkommen seien und sich zu den Bussen begeben sollten.“"
                            },
                            {
                                "example_id": "d0661ac8-d5ee-4e3b-9fab-4e6eca4b90e6",
                                "sense_id": "6cc5023a-470b-32f0-bd0b-d7304a1ac7d2",
                                "text": "„Unter den behutsamen Händen erfahrender Reiseleiter sollen sie in Mindestabständen an einsamen Stromschnellen Irlands verteilt werden, um dort zu angeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bc63510-d7f3-4614-abbc-5e9d7942115d",
                        "source_entry_id": "2e7f95c3-95d0-3cac-a658-9769f6b3865e",
                        "source_sense_id": "6cc5023a-470b-32f0-bd0b-d7304a1ac7d2",
                        "source_sense_description": "Person, die eine Reisegesellschaft betreut",
                        "target_lang_word": "tour guide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tour guide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "527de106-f152-3cdc-b09d-4d2a057c0cab",
                                        "entry_id": "3df35409-bd18-30cc-9689-d1c26daed75f",
                                        "glosses": [
                                            "One who provides assistance and information to people on organised tours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1a0b7a3-ec98-4eb7-b7c2-674562521d28",
                                                "sense_id": "527de106-f152-3cdc-b09d-4d2a057c0cab",
                                                "text": "Before he came to Stanford, Thrun had worked on robotic tour guides for museums in Germany, an interactive humanoid robot that worked in a nursing home near Pittsburgh, and a system of robots that could search out mines."
                                            },
                                            {
                                                "example_id": "187df638-c12e-4e92-b77f-df3650617b50",
                                                "sense_id": "527de106-f152-3cdc-b09d-4d2a057c0cab",
                                                "text": "Government licensed tour guides would take the groups through the site."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16b5e62a-981c-397e-8089-341f95a0229b",
                                        "entry_id": "3df35409-bd18-30cc-9689-d1c26daed75f",
                                        "glosses": [
                                            "Synonym of travel guide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b098feb2-df94-4b31-bd7c-0d201c86277f",
                                                "sense_id": "16b5e62a-981c-397e-8089-341f95a0229b",
                                                "text": "I opened my Bible at the first chapter of the Gospel according to St Mark and as I read, it was as if I were reading a tour guide of my own home district."
                                            },
                                            {
                                                "example_id": "3ae408b3-6967-4805-ae7e-c964362d669c",
                                                "sense_id": "16b5e62a-981c-397e-8089-341f95a0229b",
                                                "text": "Using a Tour Guide / Another handy feature you can try when familiarizing yourself with Internet content are the guides provided by Netscape."
                                            },
                                            {
                                                "example_id": "64210d3b-b91d-4992-9fd1-365d4427167a",
                                                "sense_id": "16b5e62a-981c-397e-8089-341f95a0229b",
                                                "text": "You can learn about the places to visit by seeing a tour presentation or by reading a tour guide. A good guide or presentation will have both pictures and text. Computer software can be used to make tour guides and presentations."
                                            },
                                            {
                                                "example_id": "256d3a87-2600-4447-86f9-83154826e25c",
                                                "sense_id": "16b5e62a-981c-397e-8089-341f95a0229b",
                                                "text": "Michelle lounged in the passenger seat reading a tour guide she’d picked up in the hotel confectionary story before they’d checked out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff855762-47e9-46be-bc97-2341a57836fd",
                        "source_entry_id": "2e7f95c3-95d0-3cac-a658-9769f6b3865e",
                        "source_sense_id": "6cc5023a-470b-32f0-bd0b-d7304a1ac7d2",
                        "source_sense_description": "Person, die eine Reisegesellschaft betreut",
                        "target_lang_word": "gids",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gids",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "23ae1677-4a15-3e98-beb1-3a423d302383",
                                        "entry_id": "4ba3b2c3-e83d-3642-ab6e-03f173d16d61",
                                        "glosses": [
                                            "persoon die een groep begeleidt en uitleg geeft"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79e79274-21e3-4ead-a1aa-b7b8783a0931",
                                                "sense_id": "23ae1677-4a15-3e98-beb1-3a423d302383",
                                                "text": "De gids kon ons veel vertellen over de historie van de kerk."
                                            },
                                            {
                                                "example_id": "7640999d-a801-4154-b285-0723c45c9c91",
                                                "sense_id": "23ae1677-4a15-3e98-beb1-3a423d302383",
                                                "text": "En zo werd het Sicilië, een achtdaagse groepsreis met een gids."
                                            },
                                            {
                                                "example_id": "bfb59b35-ec38-4f0b-a90e-ae177953b53e",
                                                "sense_id": "23ae1677-4a15-3e98-beb1-3a423d302383",
                                                "text": "`Hier links vindt u de bibliotheek; zei mijn gids, 'met daarachter de groene zaal en de Chinese kamer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b29cb17-b7cd-3062-95e1-d65f9f49b8dc",
                                        "entry_id": "4ba3b2c3-e83d-3642-ab6e-03f173d16d61",
                                        "glosses": [
                                            "boekje dat een uitleg geeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10b9ecf4-cb5c-40d9-9ca9-8451f4eeecda",
                                                "sense_id": "4b29cb17-b7cd-3062-95e1-d65f9f49b8dc",
                                                "text": "In de gids kun je lezen over de historie van de kerk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bacb991-7976-3d39-826a-de5e33c90532",
                                        "entry_id": "4ba3b2c3-e83d-3642-ab6e-03f173d16d61",
                                        "glosses": [
                                            "een tijdschrift dat uitleg geeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae9823c1-175d-475c-96f7-6766909c2e1d",
                                                "sense_id": "7bacb991-7976-3d39-826a-de5e33c90532",
                                                "text": "De gids bevatte veel zonnige afbeeldingen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b2c1391-f1b5-31e8-8f5c-d770006f08eb",
                                        "entry_id": "4ba3b2c3-e83d-3642-ab6e-03f173d16d61",
                                        "glosses": [
                                            "iets dat je de weg kan wijzen in het algemeen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "958fe5d5-d943-4ff6-8301-27f4a80a5fa6",
                                                "sense_id": "8b2c1391-f1b5-31e8-8f5c-d770006f08eb",
                                                "text": "Zie ze als suggesties, adviezen die je op verschillende momenten in je leven kunt raadplegen als een gids voor moeilijke en mooie momenten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d74e9065-a959-3ab1-94fc-e9667f282290",
                                        "entry_id": "4ba3b2c3-e83d-3642-ab6e-03f173d16d61",
                                        "glosses": [
                                            "meisje dat meedoet aan scouting"
                                        ],
