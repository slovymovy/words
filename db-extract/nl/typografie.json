                    },
                    {
                        "sense_id": "3f1142a6-1e99-3dce-b2f8-7cc87da51a8b",
                        "entry_id": "cdad69a9-72a6-3f78-974a-cf3dbcf1cd3e",
                        "glosses": [
                            "de esthetisch-technische vormgeving van een boek of ander drukwerk, waaronder o.a. de keuze van lettertypen, regelafstand en witruimte"
                        ],
                        "tags": [],
                        "examples": []
