                        "examples": [
                            {
                                "example_id": "d39f0219-f9f0-48af-a5b7-65f27bae2688",
                                "sense_id": "7851035d-ce0f-303e-b490-a88873454b7e",
                                "text": "Они всё ещё ходили взад и вперёд, не переставая кричать и аукать."
                            },
                            {
                                "example_id": "c46f5c7b-3516-439c-8735-c1b42b48804b",
                                "sense_id": "7851035d-ce0f-303e-b490-a88873454b7e",
                                "text": "В сумерки игра в прятки возобновлялась ежедневно и, хотя мы, с сестрой и Матрёшей, прятались почти всё в те же места, нас находили не сразу, приходилось «аукать»."
                            }
                        ]
                    }
