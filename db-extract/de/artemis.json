                                    {
                                        "sense_id": "5f5e3d56-6616-30a9-88cc-ba7980a8397c",
                                        "entry_id": "c0d5ec8e-fcb8-350c-a09e-17f0d3ac016b",
                                        "glosses": [
                                            "The Greek goddess of the hunt, wild animals, and wilderness; the daughter of Leto and Zeus; the sister of Apollo. (Compare Diana.)"
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4dd91c3-6332-3af8-af39-92e37e019795",
                                        "entry_id": "c0d5ec8e-fcb8-350c-a09e-17f0d3ac016b",
                                        "glosses": [
                                            "A female given name from Ancient Greek, masculine equivalent Artemios."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d81557f-69fd-3801-93cf-286a32841b41",
                                        "entry_id": "c0d5ec8e-fcb8-350c-a09e-17f0d3ac016b",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0348aa00-5786-407b-a83a-6a806498caad",
                                                "sense_id": "4d81557f-69fd-3801-93cf-286a32841b41",
                                                "text": "Mr. HISS. And is Mr. Artemis Denaxas an official of that company?\nMr. ALLARD. I believe he is.\nMr. HISS. I offer as \"Exhibit No. 307\" a letter of August 22, 1933, by Mr. Artemis Denaxas to Mr. Goulding, […]"
                                            },
                                            {
                                                "example_id": "09013acf-8909-42e3-acc6-54611fb74f27",
                                                "sense_id": "4d81557f-69fd-3801-93cf-286a32841b41",
                                                "text": "Artemis's father rested one hand on the rolling ladder, lifting his weight from the artificial limb. His expression was strange, and one that Artemis could not recall ever seeing. He realized his father was more than anxious. Artemis Fowl Senior was afraid. […] Now Artemis himself grew worried."
                                            },
                                            {
                                                "example_id": "383a6701-068c-4f3d-98a5-84ee21bc7060",
                                                "sense_id": "4d81557f-69fd-3801-93cf-286a32841b41",
                                                "text": "She must give her full attention to the man at her side, Mr. Artemis Boutwell, as she had promised her mother. The young Mr. Artemis Boutwell, as everyone referred to him, was tall like Griffin—no, Mr. Parks. She must remember to refer to him ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0829f3ed-5845-31eb-be2c-7566aa146895",
                                        "entry_id": "c0d5ec8e-fcb8-350c-a09e-17f0d3ac016b",
                                        "glosses": [
                                            "The main-belt asteroid 105 Artemis, discovered in 1868."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec243db6-c982-3d3e-b4ec-1fbd87d52438",
                                        "entry_id": "c0d5ec8e-fcb8-350c-a09e-17f0d3ac016b",
                                        "glosses": [
                                            "A United States space program, and the associated vehicles, used for human travel to the moon in the 2020s."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
