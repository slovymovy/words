{
    "word_family": [
        "purpose",
        "purposely",
        "purposeless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3fa74797-3590-339a-be02-7d8fbe68a544",
                    "sense_definition": "Having a clear goal or intention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>purposeful</w> design of the new software makes it much easier to use.",
                            "target_lang_translations": {
                                "ru": "<w>Целенаправленный</w> дизайн нового программного обеспечения делает его использование намного проще."
                            }
                        },
                        {
                            "text": "She made a <w>purposeful</w> decision to change her career path.",
                            "target_lang_translations": {
                                "ru": "Она приняла <w>целенаправленное</w> решение сменить сферу деятельности."
                            }
                        }
                    ],
                    "synonyms": [
                        "deliberate",
                        "intentional",
                        "purposive"
                    ],
                    "common_phrases": [
                        "purposeful action",
                        "purposeful decision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий четкую цель или намерение; осознанный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целенаправленный",
                                "target_lang_sense_clarification": "о действиях или решениях, имеющих конкретную цель"
                            },
                            {
                                "target_lang_word": "умышленный",
                                "target_lang_sense_clarification": "сделанный намеренно, осознанно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ed7ab45-661e-3217-919e-0c91963ee4b9",
                    "sense_definition": "Showing determination and a clear sense of direction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team took a <w>purposeful</w> stride toward their goal of winning the championship.",
                            "target_lang_translations": {
                                "ru": "Команда сделала <w>решительный</w> шаг к своей цели — победе в чемпионате."
                            }
                        },
                        {
                            "text": "He walked with a <w>purposeful</w> gait as he headed into the meeting.",
                            "target_lang_translations": {
                                "ru": "Он шел <w>целеустремленной</w> походкой, направляясь на встречу."
                            }
                        }
                    ],
                    "synonyms": [
                        "determined",
                        "focused",
                        "resolute"
                    ],
                    "common_phrases": [
                        "purposeful stride",
                        "purposeful walk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий решимость и четкое понимание направления движения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целеустремлённый",
                                "target_lang_sense_clarification": "о человеке, который настойчиво идет к своей цели"
                            },
                            {
                                "target_lang_word": "решительный",
                                "target_lang_sense_clarification": "проявляющий твердость и уверенность в своих действиях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}