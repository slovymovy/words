                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6478a68b-00b6-447c-ae9c-d7916100da3d",
                                                "sense_id": "77ed91af-d7e8-3cbe-8da1-5f4fcfbd4dab",
                                                "text": "Najbardziej interesują go dzieła poświęcone polskim powstaniom."
                                            },
                                            {
                                                "example_id": "d50e4d4f-4773-4fae-ac0e-d931acb3dc7a",
                                                "sense_id": "77ed91af-d7e8-3cbe-8da1-5f4fcfbd4dab",
                                                "text": "Według niemieckiego raportu w powstaniu w getcie warszawskim ginęła cywilna ludność getta."
