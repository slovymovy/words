                    }
                ],
                "translations": [
                    {
                        "translation_id": "2260bd2f-a316-4cff-b25e-d7d1e474c977",
                        "source_entry_id": "f2803686-cc2a-394d-9912-3a99dce8cc77",
                        "source_sense_id": "68347132-f22c-38be-8b76-7d6eb2440695",
                        "target_lang_word": "oganesson",
