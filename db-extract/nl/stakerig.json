                "senses": [
                    {
                        "sense_id": "580f7208-b96d-3da0-866a-dd5aa8db2854",
                        "entry_id": "65775e4f-f7bf-3c06-beeb-d8ef70657fde",
                        "glosses": [
                            "met veel smalle uitsteeksels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84c6a559-7b28-4a01-8712-c27e0db2841b",
                                "sense_id": "580f7208-b96d-3da0-866a-dd5aa8db2854",
                                "text": "De pijpen van de staalfabrieken vormen een stakerige skyline van een stad waaruit elke andere kleur dan grijs is weggegumd."
                            }
                        ]
                    },
                    {
                        "sense_id": "86241991-8b5a-3c32-8d47-2d87578b2455",
                        "entry_id": "65775e4f-f7bf-3c06-beeb-d8ef70657fde",
                        "glosses": [
                            "op een onhandige, onelegante, niet vloeiende manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db607526-61b4-4c2f-9277-99e5d9f9d271",
                                "sense_id": "86241991-8b5a-3c32-8d47-2d87578b2455",
                                "text": "Zomergast Annejet van der Zijl liet een fragment zien van Anton Corbijns film over de zelfmoord van Ian Curtis, zanger van Joy Division, en zo herinner ik me die jaren ook. Vooral zwartgallig. Je stond in de Amsterdamse discotheek Mazzo met een zwart lijntje onder je ogen streng en treurig te zijn. En als er al werd gedanst door de jongens dan waren het van die stakerige bewegingen.”"
                            }
                        ]
                    }
                ],
