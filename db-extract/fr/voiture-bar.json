                        "sense_id": "b6e8fbf8-6cc8-3107-880b-e185d233b8e9",
                        "entry_id": "bef433b4-bed9-38c6-9cae-2e2b47e8ddc3",
                        "glosses": [
                            "Voiture de chemin de fer qui propose des boissons et de la restauration légère de type brasserie en service continu."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "938c25e1-d707-325d-a130-afafabc406a2",
                        "entry_id": "bef433b4-bed9-38c6-9cae-2e2b47e8ddc3",
                        "glosses": [
                            "Véhicule servant à la vente de boissons au public."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb902644-d15b-4d5e-8eed-1638eca45bfc",
                                "sense_id": "938c25e1-d707-325d-a130-afafabc406a2",
                                "text": "En particulier, il se délectait de soda à l'orange, qu'il faisait mousser avec sa langue en manière de jeu, et lorsque nous partions pour quelque promenade, il ne manquait jamais de me tirer vers la voiture-bar, qu'il reconnaissait de fort loin, sans doute plus à l'odorat qu'à la vue."
                            },
                            {
                                "example_id": "c45cedb0-1d70-4ddf-acf6-b67b83c94e54",
                                "sense_id": "938c25e1-d707-325d-a130-afafabc406a2",
                                "text": "La voiture façade est partie, et la voiture-bar, et la voiture-caisse […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "546e5153-7bbc-40bf-8b7f-53cc0dcd301c",
                        "source_entry_id": "bef433b4-bed9-38c6-9cae-2e2b47e8ddc3",
                        "target_lang_word": "Speisewagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speisewagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "416f42f4-c24e-305d-bc20-4af1fe2a3235",
                                        "entry_id": "d10908ad-9c37-39ea-a08d-515ed9f37988",
                                        "glosses": [
                                            "Wagen in einem Personenzug, in dem man speisen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67933c07-a8ca-4dba-ad45-88dce7c1dd5d",
                                                "sense_id": "416f42f4-c24e-305d-bc20-4af1fe2a3235",
                                                "text": "Auf der Strecke Hamburg - Prag wird in den tschechischen Speisewagen noch richtig auf einem Herd gekocht - und nicht nur aufgewärmt, wie in den deutschen Zügen."
                                            },
                                            {
                                                "example_id": "a71b2740-aaec-4366-bdf3-d762d9e7bbb1",
                                                "sense_id": "416f42f4-c24e-305d-bc20-4af1fe2a3235",
                                                "text": "„Während ich zurück zum Speisewagen gehe, denke ich über das deutsch-polnische Ehepaar in meinem Abteil nach.“"
                                            },
                                            {
                                                "example_id": "f567acfc-6848-4856-a9e2-fe4f80efa19c",
                                                "sense_id": "416f42f4-c24e-305d-bc20-4af1fe2a3235",
                                                "text": "„Meine Mutter konnte vor Aufregung im Speisewagen gar nicht frühstücken.“"
                                            },
                                            {
                                                "example_id": "a425304b-9f78-4207-9efd-3c8316891067",
                                                "sense_id": "416f42f4-c24e-305d-bc20-4af1fe2a3235",
                                                "text": "„Daraufhin hatte sie sich im Speisewagen ein üppiges Mittagessen geleistet.“"
                                            },
                                            {
                                                "example_id": "ce7bacd8-0193-431f-b48c-304fdb1a5320",
                                                "sense_id": "416f42f4-c24e-305d-bc20-4af1fe2a3235",
                                                "text": "„Im Zug war er schließlich in den Speisewagen gegangen, um sich ein Bier zu holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
