                        "glosses": [
                            "A female given name originating as a coinage, of modern usage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e76b5f5c-5511-4519-829b-3da90988d404",
                                "sense_id": "6a64ef96-c2ab-3a5b-b974-5b131b39a03a",
                                "text": "Born just 16 minutes after the Duke and Duchess of Cambridge’s baby was born, 26-year-old Julie Walsh, of Little Walsingham, gave birth to Khaleesi Grace Walsh, who weighed 7lb and 2oz."
                            },
                            {
                                "example_id": "0abfdaa8-2c1a-43f7-b908-0d811798da85",
                                "sense_id": "6a64ef96-c2ab-3a5b-b974-5b131b39a03a",
                                "text": "Clark was seen off by his wife, Vanessa, and their 20-month-old daughter, Khaleesi."
                            },
                            {
                                "example_id": "8e00fe4a-127b-4b89-9235-6250c9cf2ff3",
                                "sense_id": "6a64ef96-c2ab-3a5b-b974-5b131b39a03a",
                                "text": "The minivan erupted in flames with Lang and her 6-month-old daughter, Khaleesi Lang, inside."
                            },
                            {
                                "example_id": "3def8f44-1c0a-444f-9682-dfcaaa1da3b8",
                                "sense_id": "6a64ef96-c2ab-3a5b-b974-5b131b39a03a",
                                "text": "But among the anger on social media, was speculation about how parents of the hundreds of Khaleesis and Danys were feeling now. The Daily Beast quoted one parent of a Khaleesi as saying she was “in shock”, while The Cut spoke to another who said “I don’t think she did anything wrong”."
                            }
                        ]
                    }
