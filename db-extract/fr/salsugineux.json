                            {
                                "example_id": "a3db0e6e-89a1-469a-aedc-bba83968b721",
                                "sense_id": "f5f2b15f-b02e-3ab3-9698-3a2df6128131",
                                "text": "Terres salsugineuses."
                            },
                            {
                                "example_id": "aa5c3921-d860-48ab-8caf-0a5276b999f5",
                                "sense_id": "f5f2b15f-b02e-3ab3-9698-3a2df6128131",
                                "text": "En sortant de ce village, on voit dans le fond de la plaine, à gauche, une montagne en forme de pain de sucre, au pied de laquelle sʼétalent de vastes marais salsugineux."
                            },
                            {
                                "example_id": "0ba1728f-aeeb-44f2-9f37-632e793763e6",
                                "sense_id": "f5f2b15f-b02e-3ab3-9698-3a2df6128131",
                                "text": "Pendant ce temps, ceux-ci plantérent leurs tentes a lʼextrémité de la Sahakha, cʼest-à-dire de la plaine salsugineuse située à lʼest de Koufa."
                            }
                        ]
                    },
