                        "examples": [
                            {
                                "example_id": "64a23c16-b2c7-46db-a308-44b578634ce7",
                                "sense_id": "4707b4c6-68cd-3f18-8dc4-305434164634",
                                "text": "„Auch wenn sich die Abenteurerliteratur einer klaren Definition entzieht kann man die Figur des Abenteurers als das Verbindende identifizieren.“"
                            },
                            {
                                "example_id": "56f4c26d-730a-42af-a9ab-5d0684ce4c98",
                                "sense_id": "4707b4c6-68cd-3f18-8dc4-305434164634",
                                "text": "„Er verknüpft in der Tradition der klassischen Abenteurerliteratur den wissenschaftlichen Bericht dieser Expedition mit Reflexionen zur Erkundung seiner selbst und beschreibt z.B. auch die schwierige Beziehung zu seiner Frau sowie die Geburt seines Sohnes.“"
                            },
                            {
                                "example_id": "6b1896f8-fc02-4f42-a2ef-f447b26ad156",
                                "sense_id": "4707b4c6-68cd-3f18-8dc4-305434164634",
                                "text": "„Zu begrüßen war der Umstand, daß ein sittlich-religiöser Zusatz sie über das Niveau der Abenteurerliteratur erhob.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
