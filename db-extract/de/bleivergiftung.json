                                    {
                                        "sense_id": "c88137be-444e-3d6e-a8fd-8189e1b926ae",
                                        "entry_id": "2dd56bf5-fdf2-3c77-b805-f38696a1c2f9",
                                        "glosses": [
                                            "Intoxication par le plomb, ses vapeurs ou ses sels, qui pénètrent dans l’organisme par voie digestive ou respiratoire et dont la toxicité est essentiellement hématologique, neurologique et rénale."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6d54b77-1a16-4062-b00e-3d232ffec782",
                                                "sense_id": "c88137be-444e-3d6e-a8fd-8189e1b926ae",
                                                "text": "— Vous serez atteint de saturnisme."
                                            },
                                            {
                                                "example_id": "6fe6bb90-53d7-4cd8-8816-f271ea3c1f04",
                                                "sense_id": "c88137be-444e-3d6e-a8fd-8189e1b926ae",
                                                "text": "Pour une suspicion de saturnisme, le médecin va effectuer une plombémie."
                                            },
                                            {
                                                "example_id": "29db120d-bf33-4ec5-b404-90132ce4a865",
                                                "sense_id": "c88137be-444e-3d6e-a8fd-8189e1b926ae",
                                                "text": "La deuxième bataille porte sur le blanc de céruse, connu lui aussi de longue date pour provoquer le saturnisme, d'abord chez les ouvriers qui le produisent à base de plomb, ensuite chez les peintres qui l'appliquent."
                                            },
                                            {
                                                "example_id": "7a9918bc-83f5-49a1-8a88-9eb22afa6d26",
                                                "sense_id": "c88137be-444e-3d6e-a8fd-8189e1b926ae",
                                                "text": "Il y a eu aussi des modifications importantes sur le type de munitions à utiliser pour les migrateurs afin d’éliminer les cas de saturnisme dû à l’intoxication avec les projectiles de plomb."
                                            }
                                        ]
                                    }
                                ]
                            }
