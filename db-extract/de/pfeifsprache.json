                ],
                "senses": [
                    {
                        "sense_id": "1976296d-c1a8-3f13-a72f-656449ce61c2",
                        "entry_id": "c05423bf-681d-31aa-8994-d6be5a8e28ba",
                        "glosses": [
                            "Art der Kommunikation, bei der die Wörter einer Sprache nicht durch Sprachlaute (Konsonanten und Vokale), sondern durch Pfeiftöne geäußert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8f5d5ee-a126-4180-9176-73f0f7d5da33",
                                "sense_id": "1976296d-c1a8-3f13-a72f-656449ce61c2",
                                "text": "„Um sich über die Schluchten ihrer gebirgigen Vulkaninseln zu verständigen, benutzten die Guantschen eine besondere Pfeifsprache (»El silbo« = der Pfiff).“"
                            },
                            {
                                "example_id": "83855df8-a333-4f8a-990a-0fd65c7cca11",
                                "sense_id": "1976296d-c1a8-3f13-a72f-656449ce61c2",
                                "text": "„Hierbei handelt es sich vor allem um die Pfeifsprachen verschiedener Landbevölkerungen in Zentral- und Südamerika, zum Teil aber auch in Europa (etwa in der Türkei und auf den Kanarischen Inseln, wo die Pfeifsprachen auf dem Türkischen bzw. Spanischen beruhen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc2c2353-c2dd-4bf0-97f3-f6fa41927757",
                        "source_entry_id": "c05423bf-681d-31aa-8994-d6be5a8e28ba",
                        "source_sense_id": "1976296d-c1a8-3f13-a72f-656449ce61c2",
