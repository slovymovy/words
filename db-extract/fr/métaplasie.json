                ],
                "senses": [
                    {
                        "sense_id": "b8fc117b-b342-3022-aded-9371f03cd682",
                        "entry_id": "6a8416c0-c670-3d2e-b61c-2ea212511d6e",
                        "glosses": [
                            "Transformation d'un tissu cellulaire différencié en un autre tissu cellulaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ed22e0e-fdb1-4b5f-9e88-83a6b41efd19",
                                "sense_id": "b8fc117b-b342-3022-aded-9371f03cd682",
                                "text": "La splénomégalie myéloïde également appelée métaplasie myéloïde avec myélofibrose primitive est un syndrome myéloprolifératif chronique."
                            },
                            {
                                "example_id": "c48f80b4-4902-43a5-8cb4-8e2de4fe36e0",
                                "sense_id": "b8fc117b-b342-3022-aded-9371f03cd682",
                                "text": "La présence d’une métaplasie intestinale de Barrett remplaçant l’épithélium pluristratifié de l’oesophage normal témoigne d’une exposition acide (et biliaire) excessive."
                            },
                            {
                                "example_id": "27cfe858-5fc2-4147-8c7a-1c062b5f6c5e",
                                "sense_id": "b8fc117b-b342-3022-aded-9371f03cd682",
                                "text": "Les métaplasies épithéliales s'observent surtout dans les tissus soumis à des irritations ou à des inflammations."
                            }
                        ]
                    }
                ],
