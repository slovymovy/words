                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b107aec7-38aa-4f7a-8a24-455162e38d4d",
                                "sense_id": "e458a875-bc41-3151-9767-dd0ea769f0e7",
                                "text": "Like essence there can bee tunfuls of it. It must come by drops, no showers of it."
                            },
                            {
