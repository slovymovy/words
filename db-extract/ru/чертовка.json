                ],
                "senses": [
                    {
                        "sense_id": "73bfce50-054d-329e-a85c-54237608ab49",
                        "entry_id": "fdd7b6bd-9a8a-3a65-8c17-443ab824d146",
                        "glosses": [
                            "бран. женск. к чёрт (перен.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10990570-8f24-43b0-a9c1-6573fcfcf499",
                                "sense_id": "73bfce50-054d-329e-a85c-54237608ab49",
                                "text": "«Это я твоя мама, а не та стерва! ― кричала Зина. ― Старая чертовка, сына отняла!» Швыряла на пол то, что ей приносили…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16bc5964-9c30-49c3-96f3-fef1afb7f855",
                        "source_entry_id": "fdd7b6bd-9a8a-3a65-8c17-443ab824d146",
                        "source_sense_id": "73bfce50-054d-329e-a85c-54237608ab49",
                        "target_lang_word": "Teufelin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teufelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd3215e0-d6a4-36c4-8fd7-3db566d5c3d4",
                                        "entry_id": "9a39ead8-d619-3b6a-946e-dba59918dfb8",
                                        "glosses": [
                                            "eine sehr böse Frau"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871e33e9-40b0-410d-8555-931a67c78148",
                                                "sense_id": "bd3215e0-d6a4-36c4-8fd7-3db566d5c3d4",
                                                "text": "Nach seinem Befund war sie moralisch unheilbar degeneriert, eine pervertierte, nymphomane, hysterische, machtbesessene Teufelin."
                                            },
                                            {
                                                "example_id": "a3605864-4bd6-4459-8559-47a483cd0266",
                                                "sense_id": "bd3215e0-d6a4-36c4-8fd7-3db566d5c3d4",
                                                "text": "Lilith war zweifellos böse von Natur, sie war eine Teufelin."
                                            },
                                            {
                                                "example_id": "4485c529-358c-4bd8-9517-1190400a7756",
                                                "sense_id": "bd3215e0-d6a4-36c4-8fd7-3db566d5c3d4",
                                                "text": "Wie eine Furie, wie eine Teufelin hatte Fiammetta in Cesares Vater gedrungen, den Tod seines Ältesten zu rächen; und zwar an dem Manne zu rächen, den sie für den Urheber des Krieges und den eigentlichen Mörder Cesares hielt und der kein andrer war als – Crispi."
                                            },
                                            {
                                                "example_id": "4235efaf-89fa-4cd7-846e-329d2af56f48",
                                                "sense_id": "bd3215e0-d6a4-36c4-8fd7-3db566d5c3d4",
                                                "text": "Anziehung ist das Böse – (Astarte ist eine Teufelin!); der Wunsch, Mittelpunkt zu sein, ist das Böse."
                                            },
                                            {
                                                "example_id": "68a6052f-2352-4bbf-8423-9e398570d343",
                                                "sense_id": "bd3215e0-d6a4-36c4-8fd7-3db566d5c3d4",
                                                "text": "Und die Teufelin Pest will unsern Planeten in ein stinkendes Aasfeld verwandeln …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
