                        "examples": [
                            {
                                "example_id": "72be0bd9-9c96-43b9-bbca-4f89876095d6",
                                "sense_id": "b8536788-93da-37e9-a059-d56c1a1c4c5e",
                                "text": "well positioned for success"
                            },
                            {
                                "example_id": "7a03c79d-5306-4e8f-a62d-1553da407186",
                                "sense_id": "b8536788-93da-37e9-a059-d56c1a1c4c5e",
                                "text": "By the time you grow into the place where you are positioned to receive the fullness of God's blessings, who you are spiritually will have been changed because you will have learned to yield and adapt to the nature of God."
                            },
                            {
                                "example_id": "c0cffcab-28f0-4356-a917-a2337c613daa",
                                "sense_id": "b8536788-93da-37e9-a059-d56c1a1c4c5e",
                                "text": "Here it is their geographical proximity rather than their relative financial advantage that makes them specially positioned to help; Samaritanism is distinguishable from distributive justice on this basis."
                            },
                            {
                                "example_id": "a5468f06-036b-4cd8-b227-d96709f7af1a",
                                "sense_id": "b8536788-93da-37e9-a059-d56c1a1c4c5e",
                                "text": "[The IMF] remains much more positioned to manage than to predict crises, never mind prevent or deter them […]"
                            }
                        ]
                    }
