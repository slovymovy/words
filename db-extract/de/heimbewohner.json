                        "tags": [],
                        "examples": [
                            {
                                "example_id": "561278d1-f3e4-44b8-89b5-cbfd1b2640aa",
                                "sense_id": "c469f1f4-7152-37ef-b29a-4adc833bb067",
                                "text": "„Die Pflegerinnen erzählen, dass sie manchmal wie ein Kind herumgeht und die anderen Heimbewohner kitzelt.“"
                            },
                            {
                                "example_id": "ee88668b-7445-4f1c-8831-abbc5960cfa6",
                                "sense_id": "c469f1f4-7152-37ef-b29a-4adc833bb067",
                                "text": "„Steckte man die Autoren dieses Buches sofort ins Altersheim, würde man das Durchschnittsalter der Heimbewohner und das Durchschnittsalter der Universität Hamburg vermindern.“"
                            }
                        ],
