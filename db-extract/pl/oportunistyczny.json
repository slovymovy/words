                                                "example_id": "fcbf2e1e-5bae-4990-94a4-07deca3033b8",
                                                "sense_id": "47a44134-03ed-3fc8-9184-9483ad7b5b51",
                                                "text": "Erreger sind dann opportunistisch, wenn sie unter bestimmten Umständen eine Erkrankung auslösen."
                                            }
