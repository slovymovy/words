                "senses": [
                    {
                        "sense_id": "e0e48d79-b9db-3f6d-8de4-49f0a064e7dd",
                        "entry_id": "c2d26a42-525e-3b8f-904c-51bc8117630c",
                        "glosses": [
                            "Donner un caractère médicinal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35a08ed7-0e2d-4b24-ba74-eb9eef569652",
                                "sense_id": "e0e48d79-b9db-3f6d-8de4-49f0a064e7dd",
                                "text": "La Vérité est que la Vérité n'appartient qu'à Dieu : qu'en vivre ne consiste pas à la discuter, mais à s'en nourrir au-dessus de toute discussion, dans l'unité de ce qu'elle apporte sans diviser ce qu'elle présente; - dans l'unité de ce qu'elle opère, sans médicinaliser ce qu'elle réalise; - dans l'unité de ce qu'elle affirme, sans falsifier ce qu'elle exprime..."
                            },
                            {
                                "example_id": "2bb69b33-7bf7-4800-9506-88f04af97c7e",
                                "sense_id": "e0e48d79-b9db-3f6d-8de4-49f0a064e7dd",
                                "text": "Ce soin est obligatoirement suivi par un massage du visage à l'huile ou au ghee médicinalisé et l'application d'une serviette chaude pour dégager les sinus."
                            },
                            {
                                "example_id": "298ab041-8063-4b8d-9825-16f7b2df0ea7",
                                "sense_id": "e0e48d79-b9db-3f6d-8de4-49f0a064e7dd",
                                "text": "Soins d'hygiène et de beauté pour êtres humains, maisons médicinalisées, salons de beauté, salons de coiffure, services de santé."
                            }
                        ]
                    }
