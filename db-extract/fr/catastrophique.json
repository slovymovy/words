                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "065f7d4a-5488-4f05-97f5-3dcf8b396215",
                        "entry_id": "745e0f30-7a80-33b1-a412-2361914cf845",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "catastrophiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d39787e-0f0e-3925-a7e8-ff4ebbf9a7a4",
                        "entry_id": "745e0f30-7a80-33b1-a412-2361914cf845",
                        "glosses": [
                            "Qui a des effets comparables à ceux d’une catastrophe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82df2ed5-c155-4e98-ad4f-c622914756c2",
                                "sense_id": "3d39787e-0f0e-3925-a7e8-ff4ebbf9a7a4",
                                "text": "Du haut en bas de l'échelle, tous les membres d'une armée vraiment solide ont leur pensée tendue vers cette issue catastrophique des conflits internationaux."
                            },
                            {
                                "example_id": "d129e93e-12c2-4c44-990f-5598a23c7940",
                                "sense_id": "3d39787e-0f0e-3925-a7e8-ff4ebbf9a7a4",
                                "text": "Si par malheur les crues de l’Ourthe coïncidaient avec celles de la Meuse, des inondations catastrophiques affectaient toute la vallée en aval de Liège."
                            },
                            {
                                "example_id": "f9968cca-b0af-4efa-9907-c49935c52f23",
                                "sense_id": "3d39787e-0f0e-3925-a7e8-ff4ebbf9a7a4",
                                "text": "COVID\n Car à moins de fermer la société une fois pour toutes, avec les conséquences économiques et sociales catastrophiques qui suivraient, on ne voit pas ce qu’il peut vraiment faire de plus."
                            },
                            {
                                "example_id": "59cc0a1c-ca15-47fe-a103-a881b26062d3",
                                "sense_id": "3d39787e-0f0e-3925-a7e8-ff4ebbf9a7a4",
                                "text": "« Une situation catastrophique pour l’avenir de la nation » : le porte-parole du Kremlin, Dmitri Peskov, n’a pas mâché ses mots, récemment, pour décrire l’effondrement démographique en Russie. « Nous vivons dans le plus grand pays du monde et nous sommes de moins en moins nombreux chaque année », a également déploré le fidèle communicant de Poutine, avant d’indiquer, sans surprise, la voie à suivre : « La seule façon d’y remédier est d’accroître la natalité. » Ce constat officiel résonne comme un aveu d’échec : les diverses politiques engagées depuis un quart de siècle n’ont pas permis d’inverser les courbes dans un pays toujours davantage en manque d’enfants."
                            }
                        ]
                    },
                    {
                        "sense_id": "991f215f-ed9f-36fc-ac31-94b3086cf82f",
                        "entry_id": "745e0f30-7a80-33b1-a412-2361914cf845",
                        "glosses": [
                            "Très mauvais."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b0e3a384-9527-40bb-a836-66609e1fc449",
                                "sense_id": "991f215f-ed9f-36fc-ac31-94b3086cf82f",
                                "text": "Les résultats de cette équipe de football sont catastrophiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64661cb6-c5d3-4a79-ab8b-f10075b34d20",
                        "source_entry_id": "745e0f30-7a80-33b1-a412-2361914cf845",
                        "source_sense_description": "Qui a des effets comparables à ceux d’une catastrophe. (Sens général).",
                        "target_lang_word": "katastrophal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "katastrophal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                        "entry_id": "7048382b-1419-3ec5-82c5-da736b146af3",
                                        "glosses": [
                                            "sehr schlimm, verhängnisvoll, entsetzlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef23ed6a-9df8-46cf-8498-3836d75009a6",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "Die katastrophale Wirtschaftslage eines Landes wirkt sich auf andere Länder aus."
                                            },
                                            {
                                                "example_id": "f0279160-73f3-493a-8674-4321e622d3e4",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Die enorme Auswanderungswelle, die Ende der 1960er, Anfang der 1970er Jahre auch Italien, vor allem den Süden des Landes, erfasst hatte, war eine Folge der katastrophalen Wirtschaftslage und der damit verbundenen Perspektivlosigkeit.“"
                                            },
                                            {
                                                "example_id": "f3ae5ed5-544a-4b7e-ad8a-c22a3e04f332",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Keltische Kriegerscharen fielen, von Gallien kommend, in Italien ein, die Römer stellten sich ihnen in der Schlacht an der Allia und erlitten eine katastrophale Niederlage.“"
                                            },
                                            {
                                                "example_id": "7755cf5f-2bfd-481c-ac03-41a5b1444feb",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Die Verkehrs- und Versorgungslage in Deutschland ist katastrophal in diesen Tagen [Anmerkung: im April 1945] […].“"
                                            },
                                            {
                                                "example_id": "df306c34-06e7-4220-a992-322c11a00c5e",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Im Gegensatz zu vielen seiner Kollegen ist es Mugabe trotz seiner katastrophalen Politik bisher gelungen, die Armee ruhig und auf seiner Seite zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc0079bb-2d42-4b5d-9dd1-753981c55771",
