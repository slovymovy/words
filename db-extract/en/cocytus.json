                                        "glosses": [
                                            "zamarznięte jezioro na dnie najniższego kręgu piekieł Dantego, które więzi na wieczność Lucyfera oraz tych potępieńców, którzy zdradzili swych dobroczyńców"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
