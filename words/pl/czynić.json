                    "sense_definition": "żądać określonej ceny za coś; wyceniać",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cena",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiec na targu długo zastanawiał się, ile właściwie <w>czynić</w> za tego konia.",
                            "target_lang_translations": {
                                "en": "The merchant at the market wondered for a long time how much to actually <w>ask</w> for that horse."
