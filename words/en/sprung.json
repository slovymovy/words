{
    "word_family": [
        "spring",
        "springy",
        "springiness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10948838-6387-3d57-8b30-a044144ed965",
                    "sense_definition": "simple past and past participle of <w>spring</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spring_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat <w>sprung</w> across the room the moment the door opened.",
                            "target_lang_translations": {
                                "es": "El gato <w>saltó</w> a través de la habitación en el momento en que se abrió la puerta."
                            }
                        },
                        {
                            "text": "Several new cafes have <w>sprung</w> up downtown over the past year.",
                            "target_lang_translations": {
                                "es": "Varias cafeterías nuevas han <w>brotado</w> en el centro durante el último año."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sprung up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense or past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pasado simple y participio pasado del verbo spring (saltar, brotar o surgir)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "saltó",
                                "target_lang_sense_clarification": "pasado de saltar"
                            },
                            {
                                "target_lang_word": "brotado",
                                "target_lang_sense_clarification": "participio de brotar o surgir"
                            },
                            {
                                "target_lang_word": "surgido",
                                "target_lang_sense_clarification": "participio de surgir repentinamente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "df20adba-e069-3f7c-a566-9681b55b0bcd",
                    "sense_definition": "Fitted, supported, or cushioned with mechanical springs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_springs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a new <w>sprung</w> mattress to help with back pain.",
                            "target_lang_translations": {
                                "es": "Compramos un colchón nuevo <w>de muelles</w> para ayudar con el dolor de espalda."
                            }
                        },
                        {
                            "text": "The vehicle was fitted with a specially designed <w>sprung</w> suspension system.",
                            "target_lang_translations": {
                                "es": "El vehículo estaba equipado con un sistema de suspensión <w>de resortes</w> especialmente diseñado."
                            }
                        }
                    ],
                    "antonyms": [
                        "unsprung"
                    ],
                    "common_phrases": [
                        "sprung mattress"
                    ],
                    "target_lang_definitions": {
                        "es": "Equipado, sostenido o acolchado con muelles o resortes mecánicos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "de muelles",
                                "target_lang_sense_clarification": "con resortes o muelles"
                            },
                            {
                                "target_lang_word": "de resortes",
                                "target_lang_sense_clarification": "provisto de resortes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6a0524b-82d1-3b6d-9c31-5724c5dd7a0f",
                    "sense_definition": "Utterly infatuated or obsessed with someone romantically or sexually.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "infatuated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got completely <w>sprung</w> after their very first date.",
                            "target_lang_translations": {
                                "es": "Se quedó completamente <w>colado</w> después de su primera cita."
                            }
                        },
                        {
                            "text": "Everyone knew she was <w>sprung</w> over her charming new coworker.",
                            "target_lang_translations": {
                                "es": "Todos sabían que ella estaba <w>enganchada</w> a su encantador compañero de trabajo nuevo."
                            }
                        }
                    ],
                    "synonyms": [
                        "smitten",
                        "in love"
                    ],
                    "common_phrases": [
                        "got sprung"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Completamente encaprichado, obsesionado o enamorado de alguien (coloquial)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "colado",
                                "target_lang_sense_clarification": "locamente enamorado o encoñado"
                            },
                            {
                                "target_lang_word": "encoñado",
                                "target_lang_sense_clarification": "obsesionado romántica o sexualmente (coloquial malsonante en España)"
                            },
                            {
                                "target_lang_word": "enganchado",
                                "target_lang_sense_clarification": "obsesionado sentimentalmente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dc6289a-4b55-3d8d-a13d-b1b61159cf37",
                    "sense_definition": "Worn out or bent such that the natural springiness or elasticity has dissipated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanical_springs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old metal money clip was <w>sprung</w> and would no longer hold bills securely.",
                            "target_lang_translations": {
                                "es": "El viejo clip metálico para billetes estaba <w>vencido</w> y ya no sujetaba los billetes firmemente."
                            }
                        },
                        {
                            "text": "The door latch became <w>sprung</w> after years of forceful slamming.",
                            "target_lang_translations": {
                                "es": "El pestillo de la puerta se <w>deformó</w> tras años de portazos fuertes."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Deformado o vencido de modo que ha perdido su elasticidad o tensión natural."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vencido",
                                "target_lang_sense_clarification": "que ha perdido la elasticidad o fuerza"
                            },
                            {
                                "target_lang_word": "deformado",
                                "target_lang_sense_clarification": "doblado perdiendo el muelle"
                            },
                            {
                                "target_lang_word": "cedido",
                                "target_lang_sense_clarification": "que ha dado de sí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39cacb42-a0f3-3c2f-b9fe-f5a84bb085e6",
                    "sense_definition": "Caught in the act of doing something illicit, illicitly concealed, or forbidden.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "caught",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenagers were totally <w>sprung</w> when their teacher walked into the empty classroom.",
                            "target_lang_translations": {
                                "es": "Los adolescentes fueron totalmente <w>pillados</w> cuando su profesor entró en el aula vacía."
                            }
                        },
                        {
                            "text": "He looked terrified the second he realised he was <w>sprung</w>.",
                            "target_lang_translations": {
                                "es": "Parecía aterrorizado en el segundo en que se dio cuenta de que estaba <w>cazado</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "red-handed"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "colloquial or regional slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pillado o atrapado cometiendo una falta o acto prohibido."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "pillado",
                                "target_lang_sense_clarification": "atrapado in fraganti"
                            },
                            {
                                "target_lang_word": "atrapado",
                                "target_lang_sense_clarification": "sorprendido en falta"
                            },
                            {
                                "target_lang_word": "cazado",
                                "target_lang_sense_clarification": "descubierto haciendo algo prohibido"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "293c253b-b606-3cde-ab12-0d038229fc21",
                    "sense_definition": "Cracked, strained, or warped from structural stress.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "damaged",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wooden mast of the boat was dangerously <w>sprung</w> by the violent storm.",
                            "target_lang_translations": {
                                "es": "El mástil de madera del barco quedó peligrosamente <w>rajado</w> por la violenta tormenta."
                            }
                        },
                        {
                            "text": "Inspect the timber carefully to make sure none of the beams are <w>sprung</w>.",
                            "target_lang_translations": {
                                "es": "Inspecciona la madera cuidadosamente para asegurarte de que ninguna de las vigas esté <w>alabeada</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "crazed",
                        "splintered"
                    ],
                    "target_lang_definitions": {
                        "es": "Agrietado, curvado o deformado debido a la tensión estructural."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "rajado",
                                "target_lang_sense_clarification": "agrietado por tensión"
                            },
                            {
                                "target_lang_word": "alabeado",
                                "target_lang_sense_clarification": "deformado o combado (madera)"
                            },
                            {
                                "target_lang_word": "abierto",
                                "target_lang_sense_clarification": "con juntas o fibras separadas por esfuerzo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f82ba24-e520-315f-b636-41d18c265dcb",
                    "sense_definition": "Intoxicated with alcoholic drink.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intoxicated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After three strong cocktails, he was visibly <w>sprung</w> and unable to walk straight.",
                            "target_lang_translations": {
                                "es": "Tras tres cócteles fuertes, estaba visiblemente <w>borracho</w> y era incapaz de caminar recto."
                            }
                        },
                        {
                            "text": "They had several beers at the pub and returned home rather <w>sprung</w>.",
                            "target_lang_translations": {
                                "es": "Se tomaron varias cervezas en el pub y volvieron a casa bastante <w>achispados</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "slang for intoxicated"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Bajo los efectos del alcohol; achispado o borracho."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "achispado",
                                "target_lang_sense_clarification": "ligeramente ebrio"
                            },
                            {
                                "target_lang_word": "borracho",
                                "target_lang_sense_clarification": "ebrio o intoxicado"
                            },
                            {
                                "target_lang_word": "entonado",
                                "target_lang_sense_clarification": "con varias copas encima"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}