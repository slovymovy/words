                        "source_sense_id": "6b455fd9-3890-3d97-bb24-94f22f5fc4e9",
                        "source_sense_description": "ein Blutgefäß, das direkt auf der linken Seite des Herzens entspringt",
                        "target_lang_word": "аорта",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
