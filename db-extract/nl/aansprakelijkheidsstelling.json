                        "source_sense_id": "c159c4ee-7445-31b5-9122-19161dc306e0",
                        "source_sense_description": "verklaring waarin staat dat men iemand verantwoordelijk acht voor een bepaalde geleden schade",
                        "target_lang_word": "claim",
