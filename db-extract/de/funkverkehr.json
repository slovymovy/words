                            {
                                "example_id": "5072017f-a246-46ee-8dd2-8cd459f0b0af",
                                "sense_id": "908d49b5-98d4-382c-99cd-51d6aa9f90b5",
                                "text": "„Es war ein ganz bestimmter Singsang, der half, den Funkverkehr zu verbessern, und Fehler minimierte.“"
                            },
                            {
                                "example_id": "d4c68eaf-db5c-47aa-8f3e-413109abca7a",
                                "sense_id": "908d49b5-98d4-382c-99cd-51d6aa9f90b5",
                                "text": "„Nach dem, was Ferris aus ihrem Funkverkehr mit der Zentrale mitbekam, hatte Hani bereits Straßensperren einrichten lassen, die sämtliche Fahrzeuge nach Alice durchsuchten.“"
                            }
                        ],
