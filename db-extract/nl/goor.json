                                        "entry_id": "ecc0d0b0-580c-37e1-baeb-24da7f040e32",
                                        "glosses": [
                                            "Showing a contemptible lack of moral standards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
