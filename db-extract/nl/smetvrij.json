                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19b7901a-3107-4332-b260-ccd12064e089",
                                                "sense_id": "8aa28ba6-8266-3268-8d6a-e7c72f06ee48",
                                                "text": "The slaughter of the innocents was a significant event in the New Testament."
                                            },
                                            {
                                                "example_id": "0e709a35-66e3-4828-befe-b5d7ccaa1856",
                                                "sense_id": "8aa28ba6-8266-3268-8d6a-e7c72f06ee48",
                                                "text": "We were asked to strike that impossible balance between being innocents and whores."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66f75a40-558a-3803-b00b-e80190360094",
                                        "entry_id": "9bdf4cd5-8f75-3e32-92c4-a61cd3c786b7",
                                        "glosses": [
                                            "A harmless simple-minded person; an idiot."
                                        ],
