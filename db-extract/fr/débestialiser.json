                "senses": [
                    {
                        "sense_id": "b92d018e-f53b-3679-b052-5864c73dae3c",
                        "entry_id": "ed6f9a45-9e04-31a8-bf30-c00009c16942",
                        "glosses": [
                            "Faire perdre son caractère bestial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "516222d2-3403-4b7a-97ec-bda2a7f8b1bb",
                                "sense_id": "b92d018e-f53b-3679-b052-5864c73dae3c",
                                "text": "L’humanisme c’est l’art d’humaniser l’homme, l’art de le « débestialiser », de le rendre humblement approprié à la terre qu’il habite."
                            },
                            {
                                "example_id": "a25d8f97-e959-4baf-8911-7e8214675112",
                                "sense_id": "b92d018e-f53b-3679-b052-5864c73dae3c",
                                "text": "Pour le « débestialiser » - pour le « discipliner », aurait dit Foucault, un autre maître à penser de Sloterdijk -, on lui ferait donc ingérer dès sa plus tendre enfance les « grands auteurs » dont la vertu principale résiderait dans les effets calmants."
                            }
                        ]
                    }
