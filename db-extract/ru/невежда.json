                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ignorant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                                        "entry_id": "3f29b2bf-f557-316d-ad90-673c9f5d98c3",
                                        "glosses": [
                                            "Qui n’est pas instruit de certaines choses, qui ignore certaines choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe0deb71-ad43-456c-bb4a-d0b8ee687e59",
                                                "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                                                "text": "Puis la gravure de cette dalle, l’inscription, sont tracées par un faussaire ignorant et inhabile."
                                            },
                                            {
                                                "example_id": "bb242436-ac89-414a-972c-cddfd1c9d178",
                                                "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                                                "text": "Il sait beaucoup de choses, mais il est fort ignorant en géographie."
                                            },
                                            {
                                                "example_id": "1c3eb748-bf06-4689-aeda-0e626c6b3d2b",
                                                "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                                                "text": "Il est ignorant sur ces matières-là, en ces matières-là, de ces matières-là."
                                            },
                                            {
                                                "example_id": "fe121f66-947a-41a4-8af0-9454a2b1d15c",
                                                "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                                                "text": "C’est un homme fort ignorant des choses du monde."
                                            },
                                            {
                                                "example_id": "b9774b61-1229-479e-9faf-7f5a8a47040e",
                                                "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                                                "text": "En termes de Palais, Être ignorant du fait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d28b98a-0d38-3276-bf1f-04e48ed078f7",
                                        "entry_id": "3f29b2bf-f557-316d-ad90-673c9f5d98c3",
                                        "glosses": [
                                            "J’en suis aussi ignorant que l’enfant qui vient de naître, se dit pour marquer qu’on ne sait rien de quelque chose qui est arrivé."
                                        ],
                                        "tags": [
                                            "Proverbial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "049343c0-f031-3522-9057-af51cbe867f8",
                                        "entry_id": "3f29b2bf-f557-316d-ad90-673c9f5d98c3",
                                        "glosses": [
                                            "Qui n’est pas instruit de ce qu’il doit savoir."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0532ffa-ea21-46cf-b516-d0e395480928",
                                                "sense_id": "049343c0-f031-3522-9057-af51cbe867f8",
                                                "text": "Élève ignorant."
                                            },
                                            {
                                                "example_id": "45167c20-d10e-47a4-854e-88a4a4da7031",
                                                "sense_id": "049343c0-f031-3522-9057-af51cbe867f8",
                                                "text": "Institutrice ignorante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b149db-03e8-37ce-be3d-5899a9b6ba0f",
                                        "entry_id": "3f29b2bf-f557-316d-ad90-673c9f5d98c3",
                                        "glosses": [
                                            "Qui n’a aucun savoir, qui est sans lettres."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0097909-aa12-47ea-a916-ddb7bd7aff9f",
                                                "sense_id": "86b149db-03e8-37ce-be3d-5899a9b6ba0f",
                                                "text": "Il est si ignorant qu’il ne sait pas lire."
                                            },
                                            {
                                                "example_id": "5f94d9e7-c7ce-474f-8e18-7ddafa2f2c7b",
                                                "sense_id": "86b149db-03e8-37ce-be3d-5899a9b6ba0f",
                                                "text": "Tous ces peuples-là sont très ignorants."
                                            },
                                            {
                                                "example_id": "57c1e5ea-7f49-49fe-9768-24f1d3f927f4",
                                                "sense_id": "86b149db-03e8-37ce-be3d-5899a9b6ba0f",
                                                "text": "Il a le sens droit, mais du reste il est fort ignorant."
                                            },
                                            {
                                                "example_id": "34438b7c-d1d3-4803-be57-fa4f8ffe8a59",
                                                "sense_id": "86b149db-03e8-37ce-be3d-5899a9b6ba0f",
                                                "text": "Il s’avoue ignorant."
                                            }
                                        ]
                                    }
                                ]
                            },
