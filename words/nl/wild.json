    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cba49091-bf2c-377e-8453-0b8583a55de8",
                    "sense_definition": "levend of groeiend in de vrije natuur, niet door mensen tam gemaakt of gekweekt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit bos kun je nog <w>wilde</w> zwijnen tegenkomen als je heel stil bent.",
                            "target_lang_translations": {
                                "en": "In this forest, you can still encounter <w>wild</w> boars if you are very quiet.",
                                "ru": "В этом лесу всё ещё можно встретить <w>диких</w> кабанов, если вести себя очень тихо."
                            }
                        },
                        {
                            "text": "De <w>wilde</w> kat is een beschermde diersoort die in de vrije natuur leeft.",
                            "target_lang_translations": {
                                "en": "The <w>wild</w> cat is a protected species that lives in the wild.",
                                "ru": "<w>Дикая</w> кошка — это охраняемый вид, обитающий в дикой природе."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongetemd",
                        "natuurlijk"
                    ],
                    "antonyms": [
                        "tam"
                    ],
                    "common_phrases": [
                        "wilde dieren",
                        "wilde bloemen",
                        "wilde planten"
                    ],
                    "target_lang_definitions": {
                        "en": "living or growing in the wild, not tamed or cultivated by humans",
                        "ru": "живущий или растущий в дикой природе, не прирученный человеком и не окультуренный"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "untamed or undomesticated"
                            },
                            {
                                "target_lang_word": "natural",
                                "target_lang_sense_clarification": "existing in nature"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "о животных и растениях в природе"
                            },
                            {
                                "target_lang_word": "дикорастущий",
                                "target_lang_sense_clarification": "о растениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28adec51-349b-3d9d-a25b-de0e535ade0b",
                    "sense_definition": "onrustig, onbeheerst of heel druk in gedrag of beweging",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen waren erg <w>wild</w> aan het spelen in de achtertuin.",
                            "target_lang_translations": {
                                "en": "The children were playing very <w>wildly</w> in the backyard.",
                                "ru": "Дети очень <w>буйно</w> играли на заднем дворе."
                            }
                        },
                        {
                            "text": "Hij probeerde het <w>wilde</w> kind tot rede te brengen door haar arm vast te houden.",
                            "target_lang_translations": {
                                "en": "He tried to reason with the <w>unruly</w> child by holding her arm.",
                                "ru": "Он пытался вразумить <w>неугомонного</w> ребенка, держа её за руку."
                            }
                        }
                    ],
                    "synonyms": [
                        "onstuimig",
                        "woest",
                        "druk"
                    ],
                    "antonyms": [
                        "tam"
                    ],
                    "common_phrases": [
                        "wild spelen",
                        "wilde haren",
                        "wilde plannen"
                    ],
                    "target_lang_definitions": {
                        "en": "restless, uncontrolled, or very active in behavior or movement",
                        "ru": "беспокойный, невоздержанный или очень активный в поведении или движении"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "unrestrained or rowdy"
                            },
                            {
                                "target_lang_word": "boisterous",
                                "target_lang_sense_clarification": "noisy, energetic, and cheerful"
                            },
                            {
                                "target_lang_word": "unruly",
                                "target_lang_sense_clarification": "disorderly and disruptive"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "буйный",
                                "target_lang_sense_clarification": "о поведении или детских играх"
                            },
                            {
                                "target_lang_word": "неугомонный",
                                "target_lang_sense_clarification": "очень активный"
                            },
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "неуправляемый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e913b470-4be3-3269-b47d-31ee8f882900",
                    "sense_definition": "onbeschaafd, ruw of zonder rekening te houden met regels en conventies",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In zijn jeugd leidde hij een <w>wild</w> leven vol feesten en muziek.",
                            "target_lang_translations": {
                                "en": "In his youth, he led a <w>wild</w> life full of parties and music.",
                                "ru": "В молодости он вёл <w>бурную</w> жизнь, полную вечеринок и музыки."
                            }
                        },
                        {
                            "text": "De posters vertellen verhalen over jong en <w>wild</w> zijn in een voorbij tijdperk.",
                            "target_lang_translations": {
                                "en": "The posters tell stories about being young and <w>wild</w> in a bygone era.",
                                "ru": "Плакаты рассказывают истории о том, каково было быть молодым и <w>безудержным</w> в ушедшую эпоху."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbeschaafd",
                        "bruusk",
                        "bandeloos"
                    ],
                    "antonyms": [
                        "tam"
                    ],
                    "common_phrases": [
                        "wild leven",
                        "wilde staking"
                    ],
                    "target_lang_definitions": {
                        "en": "uncivilized, rough, or without regard for rules and conventions",
                        "ru": "нецивилизованный, грубый или не соблюдающий правила и условности"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "licentious or unruly"
                            },
                            {
                                "target_lang_word": "savage",
                                "target_lang_sense_clarification": "brutal or uncivilized"
                            },
                            {
                                "target_lang_word": "reckless",
                                "target_lang_sense_clarification": "without care for consequences"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "бурный",
                                "target_lang_sense_clarification": "о жизни или молодости"
                            },
                            {
                                "target_lang_word": "безудержный",
                                "target_lang_sense_clarification": "не знающий границ"
                            },
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "необузданный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bdee5b0c-394e-3679-81f6-ac509efd4f8b",
                    "sense_definition": "het vlees van dieren waarop gejaagd is, bedoeld voor consumptie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de herfst serveren veel restaurants gerechten met vers <w>wild</w>.",
                            "target_lang_translations": {
                                "en": "In the autumn, many restaurants serve dishes with fresh <w>game</w>.",
                                "ru": "Осенью многие рестораны подают блюда из свежей <w>дичи</w>."
                            }
                        },
                        {
                            "text": "Zij houdt erg van de smaak van <w>wild</w> zoals hert of konijn.",
                            "target_lang_translations": {
                                "en": "She really likes the taste of <w>game</w> such as deer or rabbit.",
                                "ru": "Ей очень нравится вкус <w>дичи</w>, например, оленины или крольчатины."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wild eten",
                        "wild op de kaart"
                    ],
                    "target_lang_definitions": {
                        "en": "the meat of hunted animals intended for consumption",
                        "ru": "мясо добытых на охоте животных, предназначенное для употребления в пищу"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "game",
                                "target_lang_sense_clarification": "hunted animals used for food"
                            },
                            {
                                "target_lang_word": "venison",
                                "target_lang_sense_clarification": "specifically deer meat"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дичь",
                                "target_lang_sense_clarification": "мясо диких животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "090631ee-5420-3bc4-8f66-dabc7d7596e5",
                    "sense_definition": "de toestand van de vrije natuur, buiten de menselijke bebouwing of controle",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We kampeerden in het <w>wild</w> langs beken en zagen zelden andere mensen.",
                            "target_lang_translations": {
                                "en": "We camped in <w>the wild</w> along streams and rarely saw other people.",
                                "ru": "Мы разбивали лагерь <w>на дикой природе</w> вдоль ручьев и редко видели других людей."
                            }
                        },
                        {
                            "text": "Het is verboden om in het <w>wild</w> je afval achter te laten.",
                            "target_lang_translations": {
                                "en": "It is forbidden to leave your trash behind in <w>nature</w>.",
                                "ru": "Запрещено оставлять мусор <w>на природе</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wildernis",
                        "natuur"
                    ],
                    "common_phrases": [
                        "in het wild"
                    ],
                    "target_lang_definitions": {
                        "en": "the state of nature, outside of human development or control",
                        "ru": "состояние дикой природы, вне человеческих поселений или контроля"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the wild",
                                "target_lang_sense_clarification": "undomesticated state or wilderness"
                            },
                            {
                                "target_lang_word": "nature",
                                "target_lang_sense_clarification": "the physical world including plants and animals"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дикая природа",
                                "target_lang_sense_clarification": "естественная среда"
                            },
                            {
                                "target_lang_word": "воля",
                                "target_lang_sense_clarification": "свободная природа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c363d57d-29ea-34f3-a379-3613a8c1ac01",
                    "sense_definition": "dieren die in de vrije natuur leven en niet door mensen worden beheerd",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boswachter houdt de stand van het <w>wild</w> in dit gebied nauwkeurig bij.",
                            "target_lang_translations": {
                                "en": "The forest ranger keeps a close eye on the <w>wildlife</w> population in this area.",
                                "ru": "Лесничий внимательно следит за популяцией <w>дичи</w> в этом районе."
                            }
                        },
                        {
                            "text": "Tijdens de safari zagen we veel groot <w>wild</w> zoals olifanten en leeuwen.",
                            "target_lang_translations": {
                                "en": "During the safari, we saw a lot of big <w>game</w> such as elephants and lions.",
                                "ru": "Во время сафари мы видели много крупной <w>дичи</w>, такой как слоны и львы."
                            }
                        }
                    ],
                    "synonyms": [
                        "wildlife",
                        "fauna"
                    ],
                    "common_phrases": [
                        "groot wild",
                        "klein wild"
                    ],
                    "target_lang_definitions": {
                        "en": "animals living in the wild that are not managed by humans",
                        "ru": "животные, обитающие в дикой природе и не контролируемые человеком"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wildlife",
                                "target_lang_sense_clarification": "wild animals collectively"
                            },
                            {
                                "target_lang_word": "game",
                                "target_lang_sense_clarification": "animals hunted for sport or food"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дичь",
                                "target_lang_sense_clarification": "объекты охоты"
                            },
                            {
                                "target_lang_word": "дикие животные",
                                "target_lang_sense_clarification": "фауна"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d0e41018-6c46-3190-bcd2-c4596d6e74db",
                    "sense_definition": "op een onbeheerste, heftige of onstuimige manier",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij werd aangevallen, sloeg hij <w>wild</w> om zich heen.",
                            "target_lang_translations": {
                                "en": "When he was attacked, he struck out <w>wildly</w> around him.",
                                "ru": "Когда на него напали, он начал <w>беспорядочно</w> размахивать руками."
                            }
                        },
                        {
                            "text": "Haar hart bonsde <w>wild</w> in haar keel na de lange sprint.",
                            "target_lang_translations": {
                                "en": "Her heart pounded <w>wildly</w> in her throat after the long sprint.",
                                "ru": "Её сердце <w>бешено</w> колотилось в горле после долгого спринта."
                            }
                        }
                    ],
                    "synonyms": [
                        "onstuimig",
                        "woest"
                    ],
                    "common_phrases": [
                        "wild om zich heen slaan",
                        "wild gebaren"
                    ],
                    "target_lang_definitions": {
                        "en": "in an uncontrolled, violent, or impetuous manner",
                        "ru": "неконтролируемым, яростным или стремительным образом"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wildly",
                                "target_lang_sense_clarification": "in an uncontrolled way"
                            },
                            {
                                "target_lang_word": "frantically",
                                "target_lang_sense_clarification": "in a hurried, excited, or disorganized manner"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дико",
                                "target_lang_sense_clarification": "неистово"
                            },
                            {
                                "target_lang_word": "бешено",
                                "target_lang_sense_clarification": "очень сильно или быстро"
                            },
                            {
                                "target_lang_word": "неистово",
                                "target_lang_sense_clarification": "с большой силой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
