                        "glosses": [
                            "Qui est soumis au terrage ; qui peut être terragé."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "b0252a08-ce71-4ba1-8cb8-e839ad880b89",
                                "sense_id": "16fdc329-aad1-34d6-b144-5c0602c8bf25",
                                "text": "Les tribunaux ont autorisé le laboureur à ensemencer du grain non terrageable, une année, sur trois, dans les endroits où on ne laisse aucune jachère, et où l'on cultive constamment par des mises extraordinaires, et pour éviter les inconvénients, la dîme devrait être restreinte aux deux tiers."
                            },
                            {
                                "example_id": "96571a6f-f41f-4952-95a0-ce7825b8d692",
                                "sense_id": "16fdc329-aad1-34d6-b144-5c0602c8bf25",
                                "text": "Mais comme le fermier de ladite métairie a bénéficié de la moitié de ce terrage, il ne faut compter que 18 charries terrageables dont le terrage est perdu: ce qui se réduit à 18 charries produisant 30 gerbes de seigle."
                            }
                        ]
                    }
