                        "translation_id": "3429c072-2447-4a55-929e-31d22ecc629f",
                        "source_entry_id": "b99582d6-6b9b-3b88-8d54-c2fbec2a8266",
                        "source_sense_id": "9bd3632c-90cc-3113-a8db-7997e98ae70c",
                        "source_sense_description": "not adaptable",
                        "target_lang_word": "unanpassbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unanpassbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4099abac-0673-3728-a116-a4ea8fcf8dcb",
                                        "entry_id": "7a945df8-962b-38be-8237-b66cd757ec40",
                                        "glosses": [
                                            "so, dass es nicht angepasst werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6481adf-5b03-4553-95e3-4e288b5c5ad5",
                                                "sense_id": "4099abac-0673-3728-a116-a4ea8fcf8dcb",
                                                "text": "„Unanpassbar ist Lila schon in der Familie, obwohl sie die einzige wirklich Kreative ist: Sie entwirft die Schuhe, die Vater und Bruder in mühevoller Handwerksarbeit herstellen.“"
                                            },
                                            {
                                                "example_id": "237e0fd4-0b1c-4648-9377-4c8f885b9671",
                                                "sense_id": "4099abac-0673-3728-a116-a4ea8fcf8dcb",
                                                "text": "„Er besaß keinen Sinn für das Dramatische, und so konnte man nicht damit rechnen, dass er die ihm zugedachte Rolle spielen werde. Im Ganzen war er ihr auch mit dieser sehr widerborstigen Ader, die ihn so eigensinnig und unanpassbar machte, entschieden lieber.“"
                                            },
                                            {
                                                "example_id": "c9e266a9-6c8f-462a-b1fa-1fa4b64a4649",
                                                "sense_id": "4099abac-0673-3728-a116-a4ea8fcf8dcb",
                                                "text": "„Später in der DDR, als Schüler, Student und erst recht im Beruf, lässt dieses ewige Erinnern Maykl Trutz unanpassbar werden – was er weiß (und halt nicht vergessen kann), ist nie gefragt.“"
                                            },
                                            {
                                                "example_id": "87d596cd-e482-4a91-a07d-109c73e85999",
                                                "sense_id": "4099abac-0673-3728-a116-a4ea8fcf8dcb",
                                                "text": "„Beide [Charaktere] eher (gewollt) eindimensional, von ihrer maskulinen Überlegenheit überzeugt, unflexibel und unanpassbar. Perfekte Manipulationsobjekte also.“"
                                            },
                                            {
                                                "example_id": "7dec9ccd-db55-4bdd-ab89-1db4b2cea307",
                                                "sense_id": "4099abac-0673-3728-a116-a4ea8fcf8dcb",
                                                "text": "„Gestützt auf einem populären Roman von Raymond Queneau, der als unanpassbar galt, ist die kühne »Zazie dans le Métro«, die an der Spitze der französischen New Wave mit Flair gemacht wurde, ein bisschen stream of consciousness Slapstick, Wall-to-wall mit visuellen Gags, Schnitttricks und Effekten.“"
                                            },
                                            {
                                                "example_id": "ddd0de5c-4ad4-4a7c-969b-7711a857379b",
                                                "sense_id": "4099abac-0673-3728-a116-a4ea8fcf8dcb",
                                                "text": "„Sie versuchen zärtlich, tief verwurzelte emotionale Narben und schwächende Verhaltensprobleme zu lösen, die sie für andere unanpassbar machen würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
