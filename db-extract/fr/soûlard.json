                    },
                    {
                        "form_id": "35a05489-94b2-45c4-afc4-caad300dce39",
                        "entry_id": "97d4944d-8790-3a14-b642-55e2229a5c0b",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "soulard"
                    },
                    {
                        "form_id": "15e4f449-64ac-44b9-b70c-032b02637ce6",
                        "entry_id": "97d4944d-8790-3a14-b642-55e2229a5c0b",
                        "tags": [],
                        "form": "saoulard"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b88c5572-b773-356a-8979-43ead5f7cfa7",
                        "entry_id": "97d4944d-8790-3a14-b642-55e2229a5c0b",
                        "glosses": [
                            "Personne s’adonnant à la boisson, alcoolique, ivrogne."
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "a9770dcc-bfd2-43ea-890d-2dd6705337c0",
                                "sense_id": "b88c5572-b773-356a-8979-43ead5f7cfa7",
                                "text": "Dès le matin on peut la voir\nSur le pavé sur le trottoir\nCheminer, la mine hagarde\nLa soûlarde."
                            },
                            {
                                "example_id": "59a53bb8-b72f-4438-be1f-e9e79904b5e5",
                                "sense_id": "b88c5572-b773-356a-8979-43ead5f7cfa7",
                                "text": "D'abord la proximité des provinces petites-russiennes où, vous le savez, les eaux-de-vie se débitent librement ; quinze jours plus tard, je vous l'affirme, ce seront tous des soûlards invétérés."
                            },
                            {
                                "example_id": "c1d1ecd3-6b0e-468c-abb6-c5aebff909ef",
                                "sense_id": "b88c5572-b773-356a-8979-43ead5f7cfa7",
                                "text": "Ceux que l’on rencontrait maintenant étaient trop « bus », pour que l’on pût penser encore à discuter. Chaque chose en son lieu : les arguments de langue, d’abord, et puis les poings. On tâchait seulement de les asseoir par terre, sans trop les abîmer : un soûlard, c’est sacré !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "688e2b48-6da4-4ff3-b25d-2783f30f0a8c",
                        "source_entry_id": "97d4944d-8790-3a14-b642-55e2229a5c0b",
                        "source_sense_id": "b88c5572-b773-356a-8979-43ead5f7cfa7",
                        "target_lang_word": "Säufer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Säufer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0a4a4e7-9f81-351e-860d-0000bb2b812e",
                                        "entry_id": "65e6ca45-ab75-3f1b-9f10-2d559f1cda7f",
                                        "glosses": [
                                            "jemand, der zu viel alkoholische Getränke konsumiert"
                                        ],
                                        "tags": [
                                            "casual",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "633f5d89-59cf-4c6c-88dc-c000dd01f5c1",
                                                "sense_id": "c0a4a4e7-9f81-351e-860d-0000bb2b812e",
                                                "text": "Seit diesem Schicksalsschlag ist er zum Säufer geworden."
                                            },
                                            {
                                                "example_id": "fe6ee3ee-f7a2-43c0-a53b-a511f29c7ce4",
                                                "sense_id": "c0a4a4e7-9f81-351e-860d-0000bb2b812e",
                                                "text": "„Schiffsärzte wurden gemeinhin als Kurpfuscher und Säufer hingestellt.“"
                                            },
                                            {
                                                "example_id": "6a7bc510-538e-4eef-b371-c0bb25f29f67",
                                                "sense_id": "c0a4a4e7-9f81-351e-860d-0000bb2b812e",
                                                "text": "„Natürlich fielen nun sofort alle Mann über den alten Freischlucker und Säufer her, sie zogen ihn nach Kräften auf.“"
                                            },
                                            {
                                                "example_id": "0bf43a1c-19b9-4241-b381-1359d2552862",
                                                "sense_id": "c0a4a4e7-9f81-351e-860d-0000bb2b812e",
                                                "text": "„Der zweite machte ihr einen Sohn und wurde irgendwann ein Säufer, ein Loser (seine Arztpraxis wurde zwangsgeräumt), ein Schuldengangster und (Ehefrau-)Schläger.“"
                                            },
                                            {
                                                "example_id": "fd806291-9444-4592-a4e8-dbc94d88fec2",
                                                "sense_id": "c0a4a4e7-9f81-351e-860d-0000bb2b812e",
                                                "text": "„Die Wahrheit, die übrigens auch aus dem intimen Tagebuch hervorgeht, zwingt zu der Feststellung, daß er das war, was man unumwunden einen Säufer nennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36a626fa-84d5-406b-a3ce-911e4603befa",
                        "source_entry_id": "97d4944d-8790-3a14-b642-55e2229a5c0b",
                        "source_sense_id": "b88c5572-b773-356a-8979-43ead5f7cfa7",
                        "target_lang_word": "Trunkenbold",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trunkenbold",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcc1a3ff-eb8f-315c-ae7e-c8d1025fbd98",
                                        "entry_id": "d689c398-4b8e-38a0-baa1-50101c187ccc",
                                        "glosses": [
                                            "Person, die regelmäßig viel Alkohol konsumiert"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "426f2ae8-9a3b-4b74-af7c-3879a06b1757",
                                                "sense_id": "bcc1a3ff-eb8f-315c-ae7e-c8d1025fbd98",
                                                "text": "Mein Schwager ist ein regelrechter Trunkenbold geworden."
                                            },
                                            {
                                                "example_id": "4f6a7cb5-1e95-45bb-b56b-8d034adc4352",
                                                "sense_id": "bcc1a3ff-eb8f-315c-ae7e-c8d1025fbd98",
                                                "text": "„Ich nahm den Trunkenbold mit – bis um die Ecke – dann, nachdem er mir versichert hatte, daß auch ich ihn könnte, ließ ich ihn laufen mit herzlichen, aber aussichtslosen Ermahnungen.“"
                                            },
                                            {
                                                "example_id": "445fc9a2-3d1a-4cff-98d1-39fb56c703d3",
                                                "sense_id": "bcc1a3ff-eb8f-315c-ae7e-c8d1025fbd98",
                                                "text": "„Roth war in den Orden der Trunkenbolde eingetreten, um den Versuchungen der Nüchternheit zu entgehen.“"
                                            },
                                            {
                                                "example_id": "2a17bd6f-3c8e-4424-bb22-9e885fa01bbc",
                                                "sense_id": "bcc1a3ff-eb8f-315c-ae7e-c8d1025fbd98",
                                                "text": "„Am nächsten Tag schlenderten wir nach allen Richtungen durch die breiten, geraden, ebenen Straßen und genossen den Reiz der Fremdheit einer Stadt von fünfzehntausend Einwohnern, in der keine Herumlungerer zu sehen waren und in der es weder Trunkenbolde oder Rabauken gab.“"
                                            },
                                            {
                                                "example_id": "9ce59c38-84f4-45bd-aebc-c13ffe471790",
                                                "sense_id": "bcc1a3ff-eb8f-315c-ae7e-c8d1025fbd98",
                                                "text": "„Er ist in der ganzen Gegend als Trunkenbold bekannt.“"
                                            },
                                            {
                                                "example_id": "d6ff247a-7f60-4514-a2e9-713666d9b6ab",
                                                "sense_id": "bcc1a3ff-eb8f-315c-ae7e-c8d1025fbd98",
                                                "text": "„Dabei haftete sein Blick auf dem alten Trunkenbold, den gerade ein neuer Fieberanfall schüttelte, und ich befürchtete, ihn gleich in Tränen ausbrechen zu sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f42c8701-877b-41ea-9301-e37caf6a8081",
                        "source_entry_id": "97d4944d-8790-3a14-b642-55e2229a5c0b",
                        "source_sense_id": "b88c5572-b773-356a-8979-43ead5f7cfa7",
                        "target_lang_word": "drunk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b04e9a17-d776-306c-993f-2ccbe2d92203",
                                        "entry_id": "9e699198-aa94-3335-bfd4-4b118b60b4f9",
                                        "glosses": [
                                            "Intoxicated as a result of excessive alcohol consumption, usually by drinking alcoholic beverages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c50b916-ec2e-4640-aa42-688e48f4bc62",
                                                "sense_id": "b04e9a17-d776-306c-993f-2ccbe2d92203",
                                                "text": "So I took a great dry gourd and, cutting open the head, scooped out the inside and cleaned it; after which I gathered grapes from a vine which grew hard by and squeezed them into the gourd, till it was full of the juice. Then I stopped up the mouth and set in the sun, where I left it for some days, until it became strong wine; and every day I used to drink of it, to comfort and sustain me under my fatigues with that from froward and obstinate fiend; and as often as I drank myself drunk, I forgot my troubles and took new heart."
                                            },
                                            {
                                                "example_id": "119dd395-a3f1-475c-a5cf-437ca289cc8b",
                                                "sense_id": "b04e9a17-d776-306c-993f-2ccbe2d92203",
                                                "text": "\"What part of 'you got drunk' did our parents misunderstand?\" \"I only drank a few shots!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40e82b44-4006-3377-a5e3-027be028e8f1",
                                        "entry_id": "9e699198-aa94-3335-bfd4-4b118b60b4f9",
                                        "glosses": [
                                            "Habitually or frequently in a state of intoxication."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dccebae-25c5-34f8-bedd-b4b49af69cf5",
                                        "entry_id": "9e699198-aa94-3335-bfd4-4b118b60b4f9",
                                        "glosses": [
                                            "Elated or emboldened."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4ad7de8-cd55-4b11-a95f-b9177f896bbb",
                                                "sense_id": "6dccebae-25c5-34f8-bedd-b4b49af69cf5",
                                                "text": "Drunk with power, he immediately ordered a management reshuffle."
                                            },
                                            {
                                                "example_id": "5c6fea08-6ff6-4be2-b08c-17172d095843",
                                                "sense_id": "6dccebae-25c5-34f8-bedd-b4b49af69cf5",
                                                "text": "drunk with recent prosperity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08cabc9b-7550-3f76-a766-ae5d14ed04e1",
                                        "entry_id": "9e699198-aa94-3335-bfd4-4b118b60b4f9",
                                        "glosses": [
                                            "Drenched or saturated with moisture or liquid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c5b8c1-3de5-4d66-9982-47d39ebe37bc",
                                                "sense_id": "08cabc9b-7550-3f76-a766-ae5d14ed04e1",
                                                "text": "I will make mine arrows drunk with blood."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0884773d-6edb-3f4e-ab1b-f6029a3021ff",
                                        "entry_id": "ca9007b4-38bf-3c2c-9fa3-a2cf7a2b5165",
                                        "glosses": [
                                            "While drunk."
                                        ],
