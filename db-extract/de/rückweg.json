                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "92a4dac6-a304-357b-9ae7-91e31423cb8f",
                                        "entry_id": "56e43529-b1c8-3604-8008-7e5c7a504bc1",
                                        "glosses": [
                                            "帰り道。家に帰るために通る道。副詞や接続助詞的にも用いられる。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc350c99-2e93-49ca-81f9-cf601cdf3b9a",
                                                "sense_id": "92a4dac6-a304-357b-9ae7-91e31423cb8f",
                                                "text": "或る深夜、私は酒に酔って、ふらふらと帰路についたが、自宅の近所になって、突然、方向が分らなくなってしまった。"
                                            },
                                            {
                                                "example_id": "344d20cb-0ea2-49cb-9e63-f378d904730c",
                                                "sense_id": "92a4dac6-a304-357b-9ae7-91e31423cb8f",
                                                "text": "それから帰路、竹屋町辺まで差しかかると、昨日まで四十何年間も見馴れた小路が、すつかり歯の抜けたやうになつてゐて、兵隊は滅茶苦茶に鉈を振るつてゐる。"
                                            },
                                            {
                                                "example_id": "2377e0e6-5c31-4fb6-ab66-400f63c4e1f1",
                                                "sense_id": "92a4dac6-a304-357b-9ae7-91e31423cb8f",
                                                "text": "わたしも先年、出雲大社に参拝の帰路、津山の在に神原君の家を訪うて、その品々をみせて貰うことが出来た。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
