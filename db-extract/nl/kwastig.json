                    },
                    {
                        "translation_id": "3a9e4c4b-0750-42fb-a44c-9f30e3daf72f",
                        "source_entry_id": "dbe4e7be-a9ff-39a3-8d0c-e4c19791413f",
                        "source_sense_id": "5b24eb65-9306-3da7-bb72-4f207e15be7b",
                        "source_sense_description": "van hout dat het veel kwasten bevat",
                        "target_lang_word": "knotty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knotty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4564bf55-e60a-3675-bfca-2756f802db43",
                                        "entry_id": "fc575dd9-d57d-34ad-b81f-5440dc431b26",
                                        "glosses": [
                                            "Of string or something stringlike: full of, or tied up, in knots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc45347f-3941-497f-b6bd-60731d03e4b2",
                                                "sense_id": "4564bf55-e60a-3675-bfca-2756f802db43",
                                                "text": "I could a Tale vnfold, vvhoſe lighteſt vvord / VVould harrovv vp thy ſoule, freeze thy young blood, / Make thy tvvo eyes like Starres, ſtart from their Spheres, / Thy knotty and combined locks to part, / And each particular haire to ſtand an end, / Like Quilles vpon the fretfull Porpentine: […]"
                                            },
                                            {
                                                "example_id": "aa1ce513-c1e2-4b7f-b89f-55eba295635a",
                                                "sense_id": "4564bf55-e60a-3675-bfca-2756f802db43",
                                                "text": "Their heads are long, their haire curld, and ſeeming rather wooll, then haire; tis blacke and knotty: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "840e55d3-6931-3b38-9d94-5001fd2717f9",
                                        "entry_id": "fc575dd9-d57d-34ad-b81f-5440dc431b26",
                                        "glosses": [
                                            "Of a part of the body, a tree, etc.: full of knots (knobs or swellings); gnarled, knobbly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1146f693-ab09-4697-9078-b59a4cfae085",
                                                "sense_id": "840e55d3-6931-3b38-9d94-5001fd2717f9",
                                                "text": "a knotty pine"
                                            },
                                            {
                                                "example_id": "dafa8c63-924c-4d60-aa33-0e5f5bb80d04",
                                                "sense_id": "840e55d3-6931-3b38-9d94-5001fd2717f9",
                                                "text": "If thou murmur'ſt, I vvwill rend an Oake / And peg thee in his knotty entrailes, till / Thou haſt hovvl'd avvay tvvelve vvinters."
                                            },
                                            {
                                                "example_id": "6cb049a0-04dd-4d2a-b8c5-198a13685801",
                                                "sense_id": "840e55d3-6931-3b38-9d94-5001fd2717f9",
                                                "text": "How oft on Sundays, when I'd time to tramp, / My rambles led me to a gipsy's camp, / Where the real effigy of midnight hags, / With tawny smoked flesh and tatter'd rags, / Uncouth-brimm'd hat, and weather-beathen cloak, / 'Neath the wild shelter of a knotty oak, / Along the greensward uniformly pricks / Her pliant bending hazel's arching sticks; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "facef7e4-9a6b-3cea-9c8d-e13041d359d3",
                                        "entry_id": "fc575dd9-d57d-34ad-b81f-5440dc431b26",
                                        "glosses": [
                                            "Complicated or tricky; complex, difficult."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29281c9e-ff7b-46cb-88ae-6cc551895fcf",
                                                "sense_id": "facef7e4-9a6b-3cea-9c8d-e13041d359d3",
                                                "text": "a knotty problem"
                                            },
                                            {
                                                "example_id": "caf6f210-a261-448c-9e6a-74632941d146",
                                                "sense_id": "facef7e4-9a6b-3cea-9c8d-e13041d359d3",
                                                "text": "crop-headed, short-haired"
                                            },
                                            {
                                                "example_id": "ea781763-747c-4c4d-bca0-accb3ed33b00",
                                                "sense_id": "facef7e4-9a6b-3cea-9c8d-e13041d359d3",
                                                "text": "As for the Paſſions and Studies of the Minde, Auoid Enuie; Anxious Feares; Anger fretting invvards; Subtill and knottie Inquiſitions; Ioyes, and Exhilarations in Exceſſe; Sadneſſe not Communicated."
                                            },
                                            {
                                                "example_id": "47cf64a3-3051-40bc-9b65-c3f2f257a9da",
                                                "sense_id": "facef7e4-9a6b-3cea-9c8d-e13041d359d3",
                                                "text": "The preſent Argument is the moſt abſtracted that ever I engaged in, it ſtrains my Faculties to their higheſt Stretch; and I deſire the Reader to attend with utmoſt perpenſity; For, I now proceed to unravel this knotty Point."
                                            },
                                            {
                                                "example_id": "7a10b9ee-18b7-45c9-808d-d1fa6a4a2ca5",
                                                "sense_id": "facef7e4-9a6b-3cea-9c8d-e13041d359d3",
                                                "text": "He ſaid; the reſt in diff'rent parts divide, / The knotty point vvas urg'd on either ſide; / Marriage, the theme on vvhich they all declaim'd, / Some prais'd vvith vvit, and ſome vvith reaſon blam'd."
                                            },
                                            {
                                                "example_id": "d3016550-7119-4461-8d32-558bef6aa6da",
                                                "sense_id": "facef7e4-9a6b-3cea-9c8d-e13041d359d3",
                                                "text": "It’s the knottier questions that elicit his cleaving judgments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd578aa1-ad6c-3012-bf42-00a05a469b8d",
                                        "entry_id": "fc575dd9-d57d-34ad-b81f-5440dc431b26",
                                        "glosses": [
                                            "Of an austere or hard nature; rugged."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45cdf479-d016-4734-a06a-c084a64bf8dc",
                                                "sense_id": "bd578aa1-ad6c-3012-bf42-00a05a469b8d",
                                                "text": "[A] witte in youth, that is not ouer dulle, heauie, knottie and lumpiſhe, but hard, rough, and though ſomwhat ſtaffiſhe, […] ſuch a witte I ſay, if it be, at the firſt well handled by the mother, and rightlie ſmothed and wrought as it ſhould, not ouerwhartlie, and against the wood, by the ſcholemaſter, both for learning, and hole courſe of liuing, proueth alwaies the beſt."
                                            },
                                            {
                                                "example_id": "e75477f1-a54f-43ef-ba7c-4533605baa4e",
                                                "sense_id": "bd578aa1-ad6c-3012-bf42-00a05a469b8d",
                                                "text": "[…] I may erre perhaps in ſoothing my ſelfe that this preſent truth reviv'd, vvill deſerve on all hands to be not ſiniſterly receiv'd, […] but vvith a ſmooth and pleaſing leſſon, vvhich receiv'd hath the vertue to ſoften and diſpell rooted and knotty ſorrovves: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
