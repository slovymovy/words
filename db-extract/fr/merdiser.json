                "senses": [
                    {
                        "sense_id": "a979bda3-063a-333f-8cf0-925b7e21d753",
                        "entry_id": "c154ee7c-70d1-38c4-a69c-abb2f5f4ccd1",
                        "glosses": [
                            "Considérer comme de la merde, transformer en merde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66bd096f-b5f5-48ad-bc98-881f80425403",
                                "sense_id": "a979bda3-063a-333f-8cf0-925b7e21d753",
                                "text": "Forcément mon jugement est faussée par les voix et les sons fabriqués post-synchro. Donc Arte se merdise de plus en plus, messieurs dames."
                            },
                            {
                                "example_id": "990924d6-fbbf-4187-a268-bcc04b4142fe",
                                "sense_id": "a979bda3-063a-333f-8cf0-925b7e21d753",
                                "text": "Le monde se merdise de plus en plus"
                            },
                            {
                                "example_id": "59173df8-6970-471b-9562-7dbbf50453e2",
                                "sense_id": "a979bda3-063a-333f-8cf0-925b7e21d753",
                                "text": "Sinon ca fait bien des années que ca se merdise la F1, pour ça que je suis vraiment plus que d'un seul oeil."
                            }
                        ]
                    }
