                        "sense_id": "39699f15-8b6e-3fc3-8355-386fba304f68",
                        "entry_id": "cf7963b0-2132-300e-ba0e-88b7f9b77bef",
                        "glosses": [
                            "Publication d’informations privées de quelqu’un sur Internet sans son consentement, généralement dans le but de lui nuire."
                        ],
                        "tags": [
                            "Anglicism",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b8aab38d-7926-4bc6-8487-24ccb46a7847",
                                "sense_id": "39699f15-8b6e-3fc3-8355-386fba304f68",
                                "text": "Ça englobe le troll « classique », celui de Jessica Davey-Quantick caché derrière l’anonymat, mais aussi des menaces plus précises, racistes, sexistes, religieuses, ou des techniques de harcèlement comme le doxxing."
                            },
                            {
                                "example_id": "475db03d-d77b-4a9c-8daa-032c29c3bc71",
                                "sense_id": "39699f15-8b6e-3fc3-8355-386fba304f68",
                                "text": "Il y a du doxxing, c’est-à-dire la révélation d’informations personnelles, explique Amanda Menking, coautrice de l’étude"
                            }
                        ]
                    }
