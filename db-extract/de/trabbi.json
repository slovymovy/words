                "senses": [
                    {
                        "sense_id": "320eca3b-af72-34e0-9273-10fe60d2461c",
                        "entry_id": "d6e3901f-6477-3296-8245-ab81c4e00564",
                        "glosses": [
                            "Trabant, eine Kraftfahrzeugmarke aus der ehemaligen DDR"
                        ],
                        "tags": [
                            "umgangssprachlich kurz für"
                        ],
                        "examples": [
                            {
                                "example_id": "2bcd9951-4f9d-470d-bdfb-6760ab5bbf5c",
                                "sense_id": "320eca3b-af72-34e0-9273-10fe60d2461c",
                                "text": "„Da ich in der ehemaligen DDR aufgewachsen bin, absolvierte ich meine ersten Fahrstunden natürlich im Trabbi, der war aber nichts für meine Körpergröße.“"
                            },
                            {
                                "example_id": "8576cac9-c257-4fd9-b10f-6253d7744523",
                                "sense_id": "320eca3b-af72-34e0-9273-10fe60d2461c",
                                "text": "„Er war gerade mit seinem Trabbi über einen provisorischen Grenzübergang in den Westen gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
