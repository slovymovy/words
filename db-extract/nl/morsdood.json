                "senses": [
                    {
                        "sense_id": "0fc7707b-bba0-3b43-a975-ec70673d2496",
                        "entry_id": "23337983-be08-360f-b976-aaa485b909ab",
                        "glosses": [
                            "vollkommen tot, mausetot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1bf69c0-4775-4232-8804-ef5580ba0431",
                                "sense_id": "0fc7707b-bba0-3b43-a975-ec70673d2496",
                                "text": "Gezond en wel gaat u 's avonds slapen en morsdood staat u de volgende morgen op. (Zitat aus dem Fragment einer Kapuzinerpredigt von Gottlieb Konrad Pfeffel - 1779)",
                                "translation": "Gesund und frisch legt ihr des Nachts euch nieder, Und mausetot steht ihr des Morgens auf."
                            },
                            {
                                "example_id": "e1b1f63c-738c-499b-8a2a-df02d40c64d3",
                                "sense_id": "0fc7707b-bba0-3b43-a975-ec70673d2496",
                                "text": "Een morsdode taal waarvan nooit één woord is op papier vastgelegd.",
                                "translation": "Eine ganz und gar tote Sprache, von der niemals auch nur ein Wort zu Papier gebracht worden ist."
                            },
                            {
                                "example_id": "df47e0e5-1043-4345-a779-306b73db7f9a",
                                "sense_id": "0fc7707b-bba0-3b43-a975-ec70673d2496",
                                "text": "Morsdode talen als Gallisch en Keltiberisch.",
                                "translation": "Völlig ausgestorbene Sprachen wie Gallisch und Keltiberisch."
                            },
                            {
                                "example_id": "7ce24733-c243-4942-9ab8-cdc4d4aefc52",
                                "sense_id": "0fc7707b-bba0-3b43-a975-ec70673d2496",
                                "text": "Een morsdode papegaai speelt de hoofdrol.",
                                "translation": "Ein mausetoter Papagei spielt die Hauptrolle."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae4f4123-5945-4ba2-b56f-c6bc64f69f85",
                        "source_entry_id": "23337983-be08-360f-b976-aaa485b909ab",
                        "source_sense_id": "0fc7707b-bba0-3b43-a975-ec70673d2496",
                        "source_sense_description": "vollkommen tot, mausetot",
                        "target_lang_word": "mausetot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mausetot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6dba7c1e-e602-3cff-bd4f-95a8c7f8eb2a",
                                        "entry_id": "6bc6166b-c205-37ca-b71a-6b8c5a40df34",
                                        "glosses": [
                                            "wirklich, völlig tot"
                                        ],
                                        "tags": [
                                            "casual",
                                            "colloquial",
                                            "familiär"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9055bf10-5245-4933-86dc-d7cbee3e208a",
                                                "sense_id": "6dba7c1e-e602-3cff-bd4f-95a8c7f8eb2a",
                                                "text": "Der Soldat war bereits verstorben; mausetot geschlagen lag er da."
                                            },
                                            {
                                                "example_id": "a6719715-7b13-47e2-a1d9-33a5d46d54c3",
                                                "sense_id": "6dba7c1e-e602-3cff-bd4f-95a8c7f8eb2a",
                                                "text": "„Man hat ihn schon gestern zwischen den Mauern, die Schweickerts Weinberg von Rockers trennen, mausetot aufgefunden.“"
                                            },
                                            {
                                                "example_id": "25256c42-8d79-4c46-ad38-097d55f8daab",
                                                "sense_id": "6dba7c1e-e602-3cff-bd4f-95a8c7f8eb2a",
                                                "text": "„Dann aber klingelt plötzlich Niko, der Filius unserer Nachbarn, an der Tür und hält mir einen mausetoten Hamster vor die Nase.“"
                                            },
                                            {
                                                "example_id": "e445b8c5-c412-49ef-93f3-84ffb44dc646",
                                                "sense_id": "6dba7c1e-e602-3cff-bd4f-95a8c7f8eb2a",
                                                "text": "„Und schon gleich am ersten Tag der Bohrungen stieß man auf die Geruchsquelle: Was da so müffelte, waren drei mausetote Ratten.“"
                                            },
                                            {
                                                "example_id": "fffe011c-adc0-4974-818b-6f14eca79830",
                                                "sense_id": "6dba7c1e-e602-3cff-bd4f-95a8c7f8eb2a",
                                                "text": "„Der japanische Fotokünstler Manabu Yamanaka zeigt Ausschnitte aus seiner Bildserie ‚Fujohkan‘, was ‚Vergänglichkeit‘ meint. Anlass dazu bot ihm ein mausetoter Hund am Strand von Nippon, den er über neunundvierzig Tage zu beobachten und zu fotografieren versprach, ‚bis Gras über ihn wächst‘.“"
                                            },
                                            {
                                                "example_id": "e4d8774c-19d0-4e49-a43f-08d1b34991c1",
                                                "sense_id": "6dba7c1e-e602-3cff-bd4f-95a8c7f8eb2a",
                                                "text": "„Dort hat vor kurzem ein 48-jähriger Jäger von seinem Hochsitz aus auf ein Wildschwein gezielt, 200 Meter von ihm entfernt. Der Schütze stiefelte zu seiner Beute, die sich allerdings als mausetotes schwarzes Islandpony entpuppte, das auf einem Ponyhof graste.“"
                                            },
                                            {
                                                "example_id": "60997b2a-a527-4c2e-bc2d-01213ae753c1",
                                                "sense_id": "6dba7c1e-e602-3cff-bd4f-95a8c7f8eb2a",
                                                "text": "„Zwar spart er die verwesenden Worte nicht, um zu zeigen, daß die Literatur, die bürgerliche, toter als tot ist, daß die Kritik, die bürgerliche, ein mause-, ein scheintotes Nichtdasein führt.“"
                                            },
                                            {
                                                "example_id": "86dde9cf-c5a2-4436-a1e7-b0f450ff6ec7",
                                                "sense_id": "6dba7c1e-e602-3cff-bd4f-95a8c7f8eb2a",
                                                "text": "„Immer hat Christoph Daum recht behalten mit seinen Sprüchen und den kleinen Psychotricks, vor allem hat er einem vor Jahresfrist mausetotem Team binnen kurzem neues Leben eingehaucht.“"
                                            },
                                            {
                                                "example_id": "2f237ea1-6a5e-4899-a4c2-c562c01ff1c4",
                                                "sense_id": "6dba7c1e-e602-3cff-bd4f-95a8c7f8eb2a",
                                                "text": "„Ich bin kaputt, siehst du, Ruth hat mich kleingekriegt. So klein. Ich bin mausetot und hab’s zehn Jahre lang nicht gemerkt.“"
                                            },
                                            {
                                                "example_id": "3801a681-4f78-4dc2-9142-02492b8aa747",
                                                "sense_id": "6dba7c1e-e602-3cff-bd4f-95a8c7f8eb2a",
                                                "text": "„Die DDR ist seit 1990 mausetot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57d2e516-26f2-40e1-a299-f032e4241f7f",
                        "source_entry_id": "23337983-be08-360f-b976-aaa485b909ab",
