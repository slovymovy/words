                        {
                            "text": "An der alten Hauswand bröckelt der <w>Putz</w> bereits großflächig ab.",
                            "target_lang_translations": {
                                "en": "The <w>plaster</w> is already flaking off in large patches on the old house wall."
                            }
                        },
                        {
                            "text": "Alle elektrischen Leitungen im neuen Badezimmer wurden sorgfältig unter <w>Putz</w> verlegt.",
                            "target_lang_translations": {
