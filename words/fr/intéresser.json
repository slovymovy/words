                {
                    "sense_id": "08912a7e-d80c-31aa-ae27-85d1b8eeecbd",
                    "sense_definition": "Attirer l'attention, éveiller la curiosité de quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "curiosite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau documentaire sur la nature va sans doute <w>intéresser</w> le public."
                        },
                        {
                            "text": "Le roman est très bien écrit mais son sujet ne m'<w>intéresse</w> pas."
                        }
                    ],
                    "synonyms": [
                        "passionner",
                        "captiver"
                    ],
                    "antonyms": [
                        "ennuyer",
                        "lasser"
                    ],
                    "common_phrases": [
