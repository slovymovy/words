                    {
                        "translation_id": "e54280ad-1155-4922-92f7-fcef72a8886d",
                        "source_entry_id": "b4752d09-28d6-3ff5-878e-9abb1302b4d2",
                        "source_sense_id": "ff883f1b-44d0-31b2-b59f-bce884c330e1",
                        "source_sense_description": "An instance of something resurging",
                        "target_lang_word": "возрожде́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "возрожде́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "66696e59-ad24-3b27-b7c5-22d7134961a7",
                                        "entry_id": "6d3a47b4-e5d6-367f-9ea0-812121f588d7",
                                        "glosses": [
                                            "действие по значению гл. возрождать, возрождаться; возобновление прекратившегося существования чего-либо; подъём после периода упадка, разрушения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e990ca2d-f3ab-4f93-8d34-3a2540aba8b0",
                                                "sense_id": "66696e59-ad24-3b27-b7c5-22d7134961a7",
                                                "text": "Теперь, с другой стороны, возьмите взгляд самой церкви на преступление: разве не должен он измениться против теперешнего, почти языческого, и из механического отсечения зараженного члена, как делается ныне для охранения общества, преобразиться, и уже вполне и не ложно, в идею о возрождении вновь человека, о воскресении его и спасении его…"
                                            },
                                            {
                                                "example_id": "d30c9399-96bf-4839-93a4-aa46a9deb6f5",
                                                "sense_id": "66696e59-ad24-3b27-b7c5-22d7134961a7",
                                                "text": "Порфирий Владимирыч подвёл Анниньку к окну и указал рукой на картину весеннего возрождения."
                                            },
                                            {
                                                "example_id": "b0373879-96e9-4e07-83b2-1c0528cc4498",
                                                "sense_id": "66696e59-ad24-3b27-b7c5-22d7134961a7",
                                                "text": "После девятидневного беспамятства я очнулся тогда возрождённый, но не исправленный; возрождение мое было, впрочем, глупое, разумеется если брать в обширном смысле, и, может быть, если б это теперь, то было бы не так."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
