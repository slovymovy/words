                "senses": [
                    {
                        "sense_id": "66a6b2d4-800e-3258-900e-175050d103a3",
                        "entry_id": "8cdf676c-5f92-3c9c-a4b1-3253324b5415",
                        "glosses": [
                            "ein sumpfiges Stück Land"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "bd10c072-34f2-45b3-8960-7ff4cf4053cf",
                                "sense_id": "66a6b2d4-800e-3258-900e-175050d103a3",
                                "text": "„Ein Soll oder See hat im Gegensatz zu einem Bruch oder Fenn höchstens am Rande Gehölze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7648187a-69e1-40e6-9b7b-0b5fa0856281",
                        "source_entry_id": "8cdf676c-5f92-3c9c-a4b1-3253324b5415",
                        "source_sense_id": "66a6b2d4-800e-3258-900e-175050d103a3",
                        "source_sense_description": "niederdeutsch, norddeutsch: ein sumpfiges Stück Land",
                        "target_lang_word": "fen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d3ba139-07a8-3224-ab96-7743bb9f79e3",
                                        "entry_id": "3b80d4d6-7471-3a65-a04b-1c006aff7519",
                                        "glosses": [
                                            "A type of wetland fed by ground water and runoff, containing peat below the waterline, characteristically alkaline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02e152d5-e458-4ad2-a567-55a50e31b85e",
                                                "sense_id": "4d3ba139-07a8-3224-ab96-7743bb9f79e3",
                                                "text": "Near-synonyms: marsh, swamp, bog, mire"
                                            },
                                            {
                                                "example_id": "b326359f-7b8e-4c9d-ad6b-964024e85c0b",
                                                "sense_id": "4d3ba139-07a8-3224-ab96-7743bb9f79e3",
                                                "text": "Bogs are acidic, nutrient poor, and have a low species diversity, whereas fens are less acidic and have higher nutrient levels and species diversity."
                                            },
                                            {
                                                "example_id": "3d803765-535c-474c-9d88-e047d64e58b6",
                                                "sense_id": "4d3ba139-07a8-3224-ab96-7743bb9f79e3",
                                                "text": "Bogs are acidic peatlands, while fens are non-acidic peatlands."
                                            },
                                            {
                                                "example_id": "996369dc-ec1b-4da5-97ae-328c805b3953",
                                                "sense_id": "4d3ba139-07a8-3224-ab96-7743bb9f79e3",
                                                "text": "[...] fens are alkaline. In fact, the precise acidity of a fen depends on the soil through which in-seeping waters have percolated. Northeastern fens vary from somewhat acidic to highly basic (Johnson, 1985, p. 27)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                                        "entry_id": "3b80d4d6-7471-3a65-a04b-1c006aff7519",
                                        "glosses": [
                                            "Any swamp or mire (especially with negative connotations)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b32b222-8953-4993-b772-e56b62c19e90",
                                                "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                                                "text": "Caliban: As wicked dewe, as ere my mother bruſh'd / With Rauens feather from vnwholeſome Fen / Drop on you both : A Southweſt blow on yee, / And bliſter you all ore."
                                            },
                                            {
                                                "example_id": "42d09d2d-7366-4194-a875-4e3f0fe4d3d1",
                                                "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                                                "text": "Milton! thou shouldst be living at this hour: / England hath need of thee: she is a fen / Of stagnant waters […]"
                                            },
                                            {
                                                "example_id": "879afec5-6c81-426b-8b4e-ae380404ffc2",
                                                "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                                                "text": "In dark fens of the Dismal Swamp / The hunted Negro lay; …"
                                            },
                                            {
                                                "example_id": "c8e5fd82-5edf-421b-a7c6-f98fa4044070",
                                                "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                                                "text": "As the sob of the breeze/Sweeps over the trees/And the mists lie low on the fen..."
                                            },
                                            {
                                                "example_id": "0a8d74ac-ec2d-4279-b8b8-879578dc8cf4",
                                                "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                                                "text": "He was freezing to death in the flat mud of the Suffolk fens, too proud to go home without a catch."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afa85356-1d0a-3093-874f-4a20dffc5807",
                                        "entry_id": "28a35db1-0cb8-3a8c-88c9-a8c5f596d17b",
                                        "glosses": [
                                            "A unit of currency in China, one-hundredth of a yuan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de4cd1c5-5efc-4162-87a3-0d5f339ee0de",
                                                "sense_id": "afa85356-1d0a-3093-874f-4a20dffc5807",
                                                "text": "One poster, which appeared on the Barkhor on 20 May, ridiculed the way neighbourhood committees were recruiting participants: “We paid 30 fen for one stone, but you hire people for 30 yuan for the picnic in the Norbulingka” (“30 fen” — one hundred fen is one yuan — is a joking reference to Chinese accusations that Tibetans were paid 30 fen by splittists for each stone thrown on 1 October 1987)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78438ceb-1f5c-3dd6-b0d6-b784d7dd96df",
                                        "entry_id": "53f0e106-66f7-3cd7-b55d-1e7e95c4fa5a",
                                        "glosses": [
                                            "a plural of fan used by enthusiasts of science fiction, fantasy, and anime, partly from whimsy and partly to distinguish themselves from fans of sport, etc."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b770987-5bce-4411-9aee-4f2d86fc0c43",
                                                "sense_id": "78438ceb-1f5c-3dd6-b0d6-b784d7dd96df",
                                                "text": "Sad to relate, some of the European delegates were probably insurgents rather than true fen. […] But the Europeans could be counted on to take the long view, and many of them would probably turn out to be real fen and fenne after all."
                                            },
                                            {
                                                "example_id": "829fe3ee-aa6c-438c-8190-371d01a0d646",
                                                "sense_id": "78438ceb-1f5c-3dd6-b0d6-b784d7dd96df",
                                                "text": "So I’m glad the attached hotel block is entirely reserved for disabled fen! Traveling on mass transit is tiring even when everything’s up to code."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e0233a0-bae2-3d7c-bf9c-beeed27021a4",
                                        "entry_id": "86bdca59-f98b-3070-b505-013dc56da0be",
                                        "glosses": [
                                            "A fennec fox."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "informal",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7468cc30-42c8-47bf-b747-2a3dd0c7af3a",
                                                "sense_id": "6e0233a0-bae2-3d7c-bf9c-beeed27021a4",
                                                "text": "Your fursona holding mine while she's arguing with some random person\nLike you're cradling the little fen & she's screaming out threats"
                                            },
                                            {
                                                "example_id": "d819d425-25d7-46e1-b3c8-d7b0732dfab8",
                                                "sense_id": "6e0233a0-bae2-3d7c-bf9c-beeed27021a4",
                                                "text": "I always wondered why foxes go flat-ear mode whenever they are happy or screaming, very cute fen btw"
                                            },
                                            {
                                                "example_id": "b4441689-a055-4494-a96f-7c709f7a30fd",
                                                "sense_id": "6e0233a0-bae2-3d7c-bf9c-beeed27021a4",
                                                "text": "Just because an animal doesnt fight when you pet them doesn't mean they like it. If a fen's ears are back like that leave them the fuck alone"
                                            },
                                            {
                                                "example_id": "89d827d1-bcff-4da2-8713-8869b908e5fe",
                                                "sense_id": "6e0233a0-bae2-3d7c-bf9c-beeed27021a4",
                                                "text": "What a little tooty! BTW I really liked your post on information about fens! Thank you for getting more info out there❣️"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88d10ad6-0016-3553-8b7e-f20c49017217",
                                        "entry_id": "91494b2a-425a-3ea5-8aa4-6cff4762e5f9",
                                        "glosses": [
                                            "Used in children's games to prevent or forestall another player's action; a check or bar."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80c1e072-cc4a-3dda-8d45-b6407ab13860",
                                        "entry_id": "e76ca7fd-210b-38db-bf61-09f1882b8694",
                                        "glosses": [
                                            "A kind of mildew that grows on hops."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58575956-8bb5-47fc-b4c7-23c0cbeb383c",
                                                "sense_id": "80c1e072-cc4a-3dda-8d45-b6407ab13860",
                                                "text": "[…]whereby the ſtagnating ſap corrupts, and breeds mouldy fen, which often ſpoils whole tracts of, till then, flouriſhing hop-grounds."
                                            },
                                            {
                                                "example_id": "e1155949-f8c6-401a-b4a0-26e079d51b0b",
                                                "sense_id": "80c1e072-cc4a-3dda-8d45-b6407ab13860",
                                                "text": "Among these are reckoned the wire worm; the flea, and the fly; the fen or mould; the mildew ; and what are usually called fire blasts."
                                            },
                                            {
                                                "example_id": "374b48df-4a05-45d7-a122-d6e4dc5620b1",
                                                "sense_id": "80c1e072-cc4a-3dda-8d45-b6407ab13860",
                                                "text": "The mould, the fen, or the mouldy-fen, prevails more on hop-grounds which are low, moist, and sheltered, than on such as are high, dry, and open[…]"
                                            }
                                        ]
                                    }
