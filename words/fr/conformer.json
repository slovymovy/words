                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les employés doivent se <w>conformer</w> aux règles de sécurité de l'usine."
                        },
                        {
                            "text": "Pour éviter une sanction, l'automobiliste s'est <w>conformé</w> à la limitation de vitesse."
                        }
                    ],
                    "common_phrases": [
