                        "target_lang_word": "raide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aaaecfd7-022a-397f-8b69-a5465fc0b407",
                                        "entry_id": "31fbfecb-2056-3c89-b668-a2ab960340da",
                                        "glosses": [
                                            "Qui est très tendu et qui a de la peine à ployer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44ec85ba-eba7-41de-a470-e767cfd5bb5d",
                                                "sense_id": "aaaecfd7-022a-397f-8b69-a5465fc0b407",
                                                "text": "Tendez cette corde davantage, elle n’est pas assez raide."
                                            },
                                            {
                                                "example_id": "3af1efe5-696a-4193-a2a7-eaf512c3c54b",
                                                "sense_id": "aaaecfd7-022a-397f-8b69-a5465fc0b407",
                                                "text": "Il était tout raide de froid."
                                            },
                                            {
                                                "example_id": "d009f156-d89e-4eda-b02c-72c106b2aa90",
                                                "sense_id": "aaaecfd7-022a-397f-8b69-a5465fc0b407",
                                                "text": "Raide comme un bâton, comme une barre de fer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c745a70a-57a1-3d78-9e0a-4311b19ef580",
                                        "entry_id": "31fbfecb-2056-3c89-b668-a2ab960340da",
                                        "glosses": [
                                            "Ce qui manque ou paraît manquer de souplesse, de grâce."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "671f3dc8-0dc1-4884-b30a-085b015652be",
                                                "sense_id": "c745a70a-57a1-3d78-9e0a-4311b19ef580",
                                                "text": "Et elle glissa dans son corsage, tout raide de broderies et de diamants, cette lettre qui sortait du pourpoint du jeune homme, […]."
                                            },
                                            {
                                                "example_id": "43f0ef0d-14b2-44cc-bf2d-5ae720d33138",
                                                "sense_id": "c745a70a-57a1-3d78-9e0a-4311b19ef580",
                                                "text": "Il se tient raide comme un piquet."
                                            },
                                            {
                                                "example_id": "de14bcc4-bf40-42cb-9b99-854ad2f8f550",
                                                "sense_id": "c745a70a-57a1-3d78-9e0a-4311b19ef580",
                                                "text": "Tomber raide mort, demeurer raide mort sur la place, tomber mort, être tué tout d’un coup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37aed905-3c44-3c07-b00b-33dd3a359515",
                                        "entry_id": "31fbfecb-2056-3c89-b668-a2ab960340da",
                                        "glosses": [
                                            "Qui est inflexible, opiniâtre, dur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e6dcd1c-0f26-4d17-9bce-3e36cb1d0b90",
                                                "sense_id": "37aed905-3c44-3c07-b00b-33dd3a359515",
                                                "text": "C’est un homme raide, un esprit raide."
                                            },
                                            {
                                                "example_id": "0ba0d42a-1e01-4dca-86af-1665d8834a0d",
                                                "sense_id": "37aed905-3c44-3c07-b00b-33dd3a359515",
                                                "text": "Il a un caractère raide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eba7b56d-2725-38e0-85cc-b165329ae50e",
                                        "entry_id": "31fbfecb-2056-3c89-b668-a2ab960340da",
                                        "glosses": [
                                            "Qui a une pente difficile à monter ou à descendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa194b62-1352-4eb7-9595-e10c33e663cb",
                                                "sense_id": "eba7b56d-2725-38e0-85cc-b165329ae50e",
                                                "text": "La montée est très raide."
                                            },
                                            {
                                                "example_id": "a5966bed-0b58-4e83-b2f8-bffb060846e0",
                                                "sense_id": "eba7b56d-2725-38e0-85cc-b165329ae50e",
                                                "text": "Cet escalier est trop raide, est bien raide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02c24c51-380f-37b7-a124-bb4cfd9dbc18",
                                        "entry_id": "31fbfecb-2056-3c89-b668-a2ab960340da",
                                        "glosses": [
                                            "Qui a un mouvement rapide et violent, une trajectoire très tendue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c034d23d-65fb-4448-96b4-79f87a121608",
                                                "sense_id": "02c24c51-380f-37b7-a124-bb4cfd9dbc18",
                                                "text": "Il lance des balles très raides au tennis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f31107d5-ab41-3735-a39f-1aa572eae417",
                                        "entry_id": "31fbfecb-2056-3c89-b668-a2ab960340da",
                                        "glosses": [
                                            "Qui est difficile à admettre, dur à accepter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9630c29f-4f33-4522-9501-6f0b97f1a2c0",
                                                "sense_id": "f31107d5-ab41-3735-a39f-1aa572eae417",
                                                "text": "Vous niez un fait qui est de notoriété publique c’est un peu raide."
                                            },
                                            {
                                                "example_id": "96eeb1a1-3df2-4968-aa62-1259c46ba058",
                                                "sense_id": "f31107d5-ab41-3735-a39f-1aa572eae417",
                                                "text": "— Ce serait tout de même raide d’avoir un jour à payer des droits de succession sur la Tolose qui en fait m’appartient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ec56d7e-501d-3528-bdde-3b269ef9100a",
                                        "entry_id": "31fbfecb-2056-3c89-b668-a2ab960340da",
                                        "glosses": [
                                            "Qui est inconvenant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c777aa67-cb2a-40ca-99d8-75e055253e19",
                                                "sense_id": "6ec56d7e-501d-3528-bdde-3b269ef9100a",
                                                "text": "Il y a dans cette pièce une scène très raide."
                                            },
                                            {
                                                "example_id": "c201c46d-3db9-496a-bf93-26388582549d",
                                                "sense_id": "6ec56d7e-501d-3528-bdde-3b269ef9100a",
                                                "text": "Il tient des propos d’un raide !"
                                            },
                                            {
                                                "example_id": "fcc657c8-659a-4eb2-932f-f5ef7ce1938b",
                                                "sense_id": "6ec56d7e-501d-3528-bdde-3b269ef9100a",
                                                "text": "Bigre ! cent francs, c’est raide, dit Favier. Moi, je n’en demande que cinquante ou soixante."
                                            },
                                            {
                                                "example_id": "99a4a54b-21f0-4cdd-ac5d-d0651943c53b",
                                                "sense_id": "6ec56d7e-501d-3528-bdde-3b269ef9100a",
                                                "text": "— Elle est raide, celle-là ! Non, mais qu’est-ce que vous dites de ça ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "240554e1-08ec-3b36-a5c4-4ef77380ba3e",
                                        "entry_id": "31fbfecb-2056-3c89-b668-a2ab960340da",
                                        "glosses": [
                                            "Fauché, désargenté."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "971142c3-ea07-40ee-b0a5-2f2b6d96abf6",
                                                "sense_id": "240554e1-08ec-3b36-a5c4-4ef77380ba3e",
                                                "text": "Te prêter cent balles ? Euh, désolé, mais je suis un peu raide, en ce moment…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e377df5-9760-3de4-89af-499b96fee588",
                                        "entry_id": "31fbfecb-2056-3c89-b668-a2ab960340da",
                                        "glosses": [
                                            "Raide mort."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba035b1e-4341-4e76-b051-3c7d21de0166",
                                                "sense_id": "1e377df5-9760-3de4-89af-499b96fee588",
                                                "text": "Trois hommes tombèrent. Un avait été tué raide d'une balle dans la tête. Les deux autres n'étaient que blessés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00983ee0-2260-3b7d-9100-8178818a9644",
                                        "entry_id": "fa014771-5ea6-3dea-9168-8daa8376f03d",
                                        "glosses": [
                                            "Vite, fort, droit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef42d523-ed2a-42e0-aed6-d177b479ac5a",
                                                "sense_id": "00983ee0-2260-3b7d-9100-8178818a9644",
                                                "text": "Pour bien jouer à la paume, au tennis, il faut jouer bas et raide."
                                            },
                                            {
                                                "example_id": "bc6070c6-0a7f-49c5-8722-4650c53357e5",
                                                "sense_id": "00983ee0-2260-3b7d-9100-8178818a9644",
                                                "text": "Raide comme balle, tout droit, directement, sans hésitation."
                                            },
                                            {
                                                "example_id": "5716c6da-949d-4f61-9db7-38664358df40",
                                                "sense_id": "00983ee0-2260-3b7d-9100-8178818a9644",
                                                "text": "Cela va aussi raide qu’une flèche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73672ce4-8e0b-35bd-9d5e-0aee22dc4685",
                                        "entry_id": "b8bd9a3b-e491-3d23-b3c1-c7c2586dc649",
                                        "glosses": [
                                            "Alcool fort, eau-de-vie."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "246b85ac-936f-4441-bccd-cb87e0669545",
                                                "sense_id": "73672ce4-8e0b-35bd-9d5e-0aee22dc4685",
                                                "text": "Un petit coup de raide ? Ça vous remettra définitivement."
                                            },
                                            {
                                                "example_id": "d731e697-2eac-4268-8bc8-974582f7e669",
                                                "sense_id": "73672ce4-8e0b-35bd-9d5e-0aee22dc4685",
                                                "text": "Tu n’aurais pas un flacon de raide dans ta voiture ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40b95b6e-74e5-335b-a395-ba61b1b390bb",
                                        "entry_id": "b8bd9a3b-e491-3d23-b3c1-c7c2586dc649",
                                        "glosses": [
                                            "Somme de mille anciens francs français."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c7d64dc-6ab1-469a-892e-875e74c16278",
                                                "sense_id": "40b95b6e-74e5-335b-a395-ba61b1b390bb",
                                                "text": "En poussant vers lui un talbin de cinq raides, j’ai expliqué à Alfred ce que je voulais."
                                            },
                                            {
                                                "example_id": "ae9b5400-91a9-40a4-9ac8-7066b3ba124f",
                                                "sense_id": "40b95b6e-74e5-335b-a395-ba61b1b390bb",
                                                "text": "Pour un raide, le gars est prêt à déboucher le lavabo de votre concierge ou à se faire hara-kiri avec une pelle à gâteaux…"
                                            },
                                            {
                                                "example_id": "daaab8fb-dc6d-4819-bb14-de08155f7810",
                                                "sense_id": "40b95b6e-74e5-335b-a395-ba61b1b390bb",
                                                "text": "Cinquante billets et cinquante raides, égalent cent mille points."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f236de05-2734-3330-96df-d8d1ea83aab7",
                                        "entry_id": "b8bd9a3b-e491-3d23-b3c1-c7c2586dc649",
                                        "glosses": [
                                            "Courant très rapide (d’une rivière)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "532e3cb2-8a2b-4dd6-829f-893d8881e5e4",
                                                "sense_id": "f236de05-2734-3330-96df-d8d1ea83aab7",
                                                "text": "Je n'oublierai jamais mon premier silure pris en plein midi du mois d'août 1985 dans un raide en cherchant le sandre au poisson mort-manié. (site 1max2peche.fr)"
                                            },
                                            {
                                                "example_id": "f88bbbc9-5320-4e88-9e46-5f6bf03ef023",
                                                "sense_id": "f236de05-2734-3330-96df-d8d1ea83aab7",
                                                "text": "Le fond est constitué à peu prés partout par des rochers causant des courants bien délimités, des remous, des raides suivis de petites chutes. (site abpm-asso.fr)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
