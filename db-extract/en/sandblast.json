                                        "entry_id": "014cfa83-54d5-37ab-b548-1bec90226855",
                                        "glosses": [
                                            "Sandkörner über eine Oberfläche blasen, wodurch diese abgeschliffen/aufgeraut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebbf4b6-bab4-4364-b4e5-ed8e42970222",
                                                "sense_id": "e770977d-3222-3dba-ba9b-786e341ca0de",
                                                "text": "Für eine bessere Haftung empfiehlt es sich, die Fläche unmittelbar vor dem Beschichten sandzustrahlen."
                                            },
                                            {
                                                "example_id": "82001e4e-70f9-4844-a130-8a0ff92b6afe",
                                                "sense_id": "e770977d-3222-3dba-ba9b-786e341ca0de",
                                                "text": "„Wie sie fanden, läßt sich der Wärmeübergang an siedendes Wasser bis um den Faktor 1,3 verbessern, wenn man die Heizfläche sandstrahlt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
