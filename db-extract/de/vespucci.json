                "senses": [
                    {
                        "sense_id": "ed265b01-d8b8-3064-a05d-9e7cb8ec097e",
                        "entry_id": "3c1142c8-1052-3d54-8833-3f3d44b7abc3",
                        "glosses": [
                            "italienischsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3be4675f-bf60-4a2a-8162-1b9497198676",
                                "sense_id": "ed265b01-d8b8-3064-a05d-9e7cb8ec097e",
                                "text": "Frau Vespucci ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ca26c9fa-ca8c-483a-ba6a-816d283e51e1",
                                "sense_id": "ed265b01-d8b8-3064-a05d-9e7cb8ec097e",
                                "text": "Herr Vespucci wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3018d29e-7211-4c6f-bf2c-77fc762a40fc",
                                "sense_id": "ed265b01-d8b8-3064-a05d-9e7cb8ec097e",
                                "text": "Die Vespuccis fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "b29cec69-1161-4a61-a762-0dd0f7e22923",
                                "sense_id": "ed265b01-d8b8-3064-a05d-9e7cb8ec097e",
                                "text": "Der Vespucci trägt nie die Pullover, die die Vespucci ihm strickt."
                            },
                            {
                                "example_id": "3211d7ab-c054-49f5-8cc4-8b3a399619aa",
                                "sense_id": "ed265b01-d8b8-3064-a05d-9e7cb8ec097e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Vespucci kommt, geht der Herr Vespucci.“"
                            },
                            {
                                "example_id": "621b223a-924f-422d-a0aa-3a9849cd02d1",
                                "sense_id": "ed265b01-d8b8-3064-a05d-9e7cb8ec097e",
                                "text": "Vespucci kommt und geht."
                            },
                            {
                                "example_id": "be4b5a00-c008-4e3f-b43d-f1888f261ec5",
                                "sense_id": "ed265b01-d8b8-3064-a05d-9e7cb8ec097e",
                                "text": "Vespuccis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
