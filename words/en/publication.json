{
    "word_family": [
        "public",
        "publish",
        "publisher",
        "publicity",
        "publicist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b136755b-aa93-3319-bef6-4a7655e77700",
                    "sense_definition": "The act of making information, stories, or research available to people in printed or electronic form.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "act_of_publishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>publication</w> of the new novel is scheduled for next month.",
                            "target_lang_translations": {
                                "ru": "<w>Публикация</w> нового романа запланирована на следующий месяц.",
                                "zh": "这部新小说的<w>出版</w>定于下个月。"
                            }
                        },
                        {
                            "text": "There is often a delay between the writing of an article and its <w>publication</w>.",
                            "target_lang_translations": {
                                "ru": "Часто бывает задержка между написанием статьи и её <w>публикацией</w>.",
                                "zh": "文章从写完到<w>发表</w>之间通常会有延迟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "publishing",
                        "issuance",
                        "release",
                        "printing"
                    ],
                    "antonyms": [
                        "suppression",
                        "censorship"
                    ],
                    "common_phrases": [
                        "date of publication",
                        "ready for publication",
                        "accepted for publication",
                        "publication costs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс выпуска информации, историй или исследований для людей в печатной или электронной форме.",
                        "zh": "将信息、故事或研究成果以印刷或电子形式提供给公众的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "публикация",
                                "target_lang_sense_clarification": "процесс размещения материала"
                            },
                            {
                                "target_lang_word": "издание",
                                "target_lang_sense_clarification": "выпуск в свет книг или журналов"
                            },
                            {
                                "target_lang_word": "опубликование",
                                "target_lang_sense_clarification": "официальное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出版",
                                "target_lang_sense_clarification": "指书籍、报刊等印刷品的发行过程"
                            },
                            {
                                "target_lang_word": "发布",
                                "target_lang_sense_clarification": "指信息或内容的公开过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0dace37-734d-3042-81e2-72496c698f0a",
                    "sense_definition": "A book, magazine, newspaper, or document that has been published.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "published_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She writes articles for several medical <w>publications</w>.",
                            "target_lang_translations": {
                                "ru": "Она пишет статьи для нескольких медицинских <w>изданий</w>.",
                                "zh": "她为几家医学<w>刊物</w>撰写文章。"
                            }
                        },
                        {
                            "text": "This <w>publication</w> is available in both print and digital formats.",
                            "target_lang_translations": {
                                "ru": "Это <w>издание</w> доступно как в печатном, так и в цифровом формате.",
                                "zh": "这份<w>出版物</w>同时提供印刷版和数字版。"
                            }
                        }
                    ],
                    "synonyms": [
                        "book",
                        "magazine",
                        "journal",
                        "periodical",
                        "issue",
                        "title"
                    ],
                    "common_phrases": [
                        "scientific publication",
                        "monthly publication",
                        "recent publication",
                        "list of publications"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опубликованная книга, журнал, газета или документ.",
                        "zh": "已出版的书籍、杂志、报纸或文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "издание",
                                "target_lang_sense_clarification": "книга, журнал или газета"
                            },
                            {
                                "target_lang_word": "публикация",
                                "target_lang_sense_clarification": "статья или материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出版物",
                                "target_lang_sense_clarification": "指各类已发行的印刷品或电子读物"
                            },
                            {
                                "target_lang_word": "刊物",
                                "target_lang_sense_clarification": "特指报纸、杂志等定期出版物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "480f03dd-7246-3f59-89c0-85fa535a5609",
                    "sense_definition": "The act of communicating information to the general public.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "act_of_publishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>publication</w> of private details caused a major scandal.",
                            "target_lang_translations": {
                                "ru": "<w>Обнародование</w> частных подробностей вызвало крупный скандал.",
                                "zh": "私人细节的<w>披露</w>引发了一场重大丑闻。"
                            }
                        },
                        {
                            "text": "They tried to prevent the <w>publication</w> of the sensitive report.",
                            "target_lang_translations": {
                                "ru": "Они пытались предотвратить <w>публикацию</w> этого секретного доклада.",
                                "zh": "他们试图阻止这份敏感报告的<w>公布</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "announcement",
                        "disclosure",
                        "declaration",
                        "broadcasting",
                        "dissemination"
                    ],
                    "antonyms": [
                        "concealment",
                        "secrecy"
                    ],
                    "common_phrases": [
                        "publication of the ban",
                        "publication of details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по сообщению информации широкой общественности.",
                        "zh": "向公众传达信息或披露事实的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обнародование",
                                "target_lang_sense_clarification": "предание гласности"
                            },
                            {
                                "target_lang_word": "оглашение",
                                "target_lang_sense_clarification": "публичное объявление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公布",
                                "target_lang_sense_clarification": "指公开宣布或披露信息"
                            },
                            {
                                "target_lang_word": "披露",
                                "target_lang_sense_clarification": "指揭露或公开秘密信息"
                            }
                        ]
                    }
                }
            ]
        }
    ]
