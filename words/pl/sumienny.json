    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "571fb669-83ff-312f-8fc1-4ebdf0492885",
                    "sense_definition": "taki, który dokładnie i odpowiedzialnie wywiązuje się ze swoich obowiązków",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dokładność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To bardzo <w>sumienny</w> pracownik, na którym zawsze można polegać w trudnych sytuacjach.",
                            "target_lang_translations": {
                                "ru": "Это очень <w>добросовестный</w> работник, на которого всегда можно положиться в трудных ситуациях."
                            }
                        },
                        {
                            "text": "Nauczycielka pochwaliła go za to, że jest niezwykle <w>sumienny</w> w nauce języków obcych.",
                            "target_lang_translations": {
                                "ru": "Учительница похвалила его за то, что он необычайно <w>прилежен</w> в изучении иностранных языков."
                            }
                        }
                    ],
                    "synonyms": [
                        "obowiązkowy",
                        "pilny",
                        "rzetelny",
                        "skrupulatny"
                    ],
                    "antonyms": [
                        "nieobowiązkowy",
                        "nierzetelny"
                    ],
                    "common_phrases": [
                        "sumienny pracownik",
                        "sumienny uczeń"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто тщательно, аккуратно и ответственно выполняет свои обязанности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добросовестный",
                                "target_lang_sense_clarification": "честно и ответственно относящийся к делу"
                            },
                            {
                                "target_lang_word": "исполнительный",
                                "target_lang_sense_clarification": "старательно выполняющий поручения и обязанности"
                            },
                            {
                                "target_lang_word": "прилежный",
                                "target_lang_sense_clarification": "усердный в учебе или труде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73a183fd-52d0-37e0-834d-1458a1b3a7df",
                    "sense_definition": "wykonywany z dbałością o szczegóły, rzetelnie i dokładnie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dokładność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jej <w>sumienne</w> podejście do każdego zadania przyniosło firmie wielki sukces.",
                            "target_lang_translations": {
                                "ru": "Её <w>добросовестный</w> подход к каждой задаче принёс компании большой успех."
                            }
                        },
                        {
                            "text": "Za tak <w>sumienne</w> wypełnianie obowiązków otrzymał zasłużoną premię od zarządu.",
                            "target_lang_translations": {
                                "ru": "За столь <w>добросовестное</w> выполнение обязанностей он получил заслуженную премию от руководства."
                            }
                        }
                    ],
                    "synonyms": [
                        "pieczołowity",
                        "rzetelny",
                        "skrupulatny",
                        "solidny",
                        "staranny"
                    ],
                    "antonyms": [
                        "nierzetelny",
                        "niestaranny"
                    ],
                    "common_phrases": [
                        "sumienne wypełnianie obowiązków",
                        "sumienne podejście"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполняемый с вниманием к деталям, тщательно, качественно и аккуратно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добросовестный",
                                "target_lang_sense_clarification": "основательный, выполненный на совесть"
                            },
                            {
                                "target_lang_word": "тщательный",
                                "target_lang_sense_clarification": "выполненный со вниманием к мелочам"
                            },
                            {
                                "target_lang_word": "старательный",
                                "target_lang_sense_clarification": "сделанный с усердием и заботой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cda835cf-51f8-37c9-9d57-4bbda8ef3ee6",
                    "sense_definition": "odnoszący się do sumienia, płynący z wewnętrznego poczucia moralności",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "etyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podjął tę decyzję po długim namyśle, traktując ją jako swój <w>sumienny</w> obowiązek moralny.",
                            "target_lang_translations": {
                                "ru": "Он принял это решение после долгих раздумий, посчитав его своим <w>продиктованным совестью</w> моральным долгом."
                            }
                        },
                        {
                            "text": "W starych tekstach etycznych analizowano <w>sumienne</w> rozterki człowieka stojącego przed trudnym wyborem.",
                            "target_lang_translations": {
                                "ru": "В старинных этических трактатах анализировались <w>совестные</w> терзания человека, стоящего перед трудным выбором."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rzadkie, przestarzałe użycie bezpośrednio odnoszące się do głosu sumienia."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к совести, проистекающий из внутреннего чувства нравственности (устаревшее)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совестный",
                                "target_lang_sense_clarification": "относящийся к голосу совести, внутренний"
                            },
                            {
                                "target_lang_word": "продиктованный совестью",
                                "target_lang_sense_clarification": "исходящий из нравственных побуждений"
                            }
                        ]
                    }
                }
            ]
        }
    ]
