                                "target_senses": [
                                    {
                                        "sense_id": "40359216-65c8-324e-8aa5-44982c3749ba",
                                        "entry_id": "b63a0f94-8d69-3474-8e67-0cd3aef54593",
                                        "glosses": [
                                            "To assume a horizontal position."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68d77b48-6c48-4e08-8c74-d42937402dea",
                                                "sense_id": "40359216-65c8-324e-8aa5-44982c3749ba",
                                                "text": "Lie down on the bed until you feel better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a4b8268-4d54-3592-b113-53c1cc8e54b4",
                                        "entry_id": "b63a0f94-8d69-3474-8e67-0cd3aef54593",
                                        "glosses": [
                                            "To assume a horizontal position.",
                                            "A standard command to a herding dog to assume this position, owing to its effect on the herd's movement."
                                        ],
                                        "tags": [
                                            "imperative",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb816c6a-543d-32b9-8642-db720809f199",
                                        "entry_id": "b63a0f94-8d69-3474-8e67-0cd3aef54593",
                                        "glosses": [
                                            "To be lazy or remiss."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a207301a-4144-4e11-b657-f125e2e257bb",
                                                "sense_id": "cb816c6a-543d-32b9-8642-db720809f199",
                                                "text": "He never got promoted because he was always lying down on the job."
                                            },
                                            {
                                                "example_id": "bdf9033c-bb92-4ae6-9366-b426cbab1f34",
                                                "sense_id": "cb816c6a-543d-32b9-8642-db720809f199",
                                                "text": "They may have finished 11 points behind West Ham and lost both league games, conceding eight goals, but the Tangerine dream remains alive. Holloway said: “We won’t get a bigger test than West Ham but we’ve got one chance. If you’d asked me last summer when I lost all those players I’d have said this was a dead duck, but we don’t lie down at this club.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64941aa6-bc7a-3183-988e-99165a845780",
                                        "entry_id": "b63a0f94-8d69-3474-8e67-0cd3aef54593",
                                        "glosses": [
                                            "To submit passively."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "835debc3-3cbf-4a8b-978b-962c86d370b1",
                                                "sense_id": "64941aa6-bc7a-3183-988e-99165a845780",
                                                "text": "I'm not going to lie down and take this!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb8701fe-2839-345b-b5d7-55b0c9d09d30",
                                        "entry_id": "b63a0f94-8d69-3474-8e67-0cd3aef54593",
                                        "glosses": [
