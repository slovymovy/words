                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "tags": [
                            "participle",
                            "active",
                            "past"
                        ],
                        "form": "подве́дший"
                    },
                    {
                        "form_id": "e1539914-a8ea-460c-8d63-4986bec98886",
                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "tags": [
                            "participle",
                            "passive",
                            "past"
                        ],
                        "form": "подведённый"
                    },
                    {
                        "form_id": "188a7a21-93da-444b-b2ac-6b33c385ddf2",
                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "подведя́"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "35d5a38b-2843-3977-94af-234a11ab2adc",
                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "glosses": [
                            "ведя, приблизить, доставить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8d35937-14b5-470b-a2fc-0372d6150347",
                                "sense_id": "35d5a38b-2843-3977-94af-234a11ab2adc",
                                "text": "Он взял меня за руку, заставил сойти с дивана и подвёл к зеркалу."
                            }
                        ]
                    },
                    {
                        "sense_id": "a17c7eb6-2e30-3443-9b07-cc3db09d456c",
                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "glosses": [
                            "направить разговор, спор, мысли, сознание и т. п., имея что-либо в виду, добиваясь чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc1203aa-e074-463d-b829-85ac4336ba9e",
                                "sense_id": "a17c7eb6-2e30-3443-9b07-cc3db09d456c",
                                "text": "Я эту самую мысль прокурору в опросе моём не то что ясно сказал, а, напротив, как будто намёком подвёл-с, точно как бы сам не понимаючи, и точно как бы это они сами выдумали, а не я им подсказал-с, — так у господина прокурора от этого самого намёка моего даже слюнки потекли-с…"
                            }
                        ]
                    },
                    {
                        "sense_id": "b7f8b3b8-ee60-35c2-9cd7-8c5a189a7cd3",
                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "glosses": [
                            "проложить, протянуть"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f5e529a4-bbd1-3aa1-91ae-4e4c59fce500",
                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "glosses": [
                            "перен. подытожить, получить результат"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6c30811-5b39-49d2-9fab-948a423b86fb",
                                "sense_id": "f5e529a4-bbd1-3aa1-91ae-4e4c59fce500",
                                "text": "Пора подвести итоги."
                            }
                        ]
                    },
                    {
                        "sense_id": "99ef59a7-a208-3619-85f4-09c63a10424f",
                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "glosses": [
                            "перен. найти, представить (доводы) для обоснования чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "453f01ac-c25a-41d5-b4e0-053fb151d134",
                                "sense_id": "99ef59a7-a208-3619-85f4-09c63a10424f",
                                "text": "Он подвёл под свою теорию вполне убедительные доводы."
                            },
                            {
                                "example_id": "b831687a-e8f9-491b-8b50-70cec3aebb8c",
                                "sense_id": "99ef59a7-a208-3619-85f4-09c63a10424f",
                                "text": "Мне при этом всегда вспоминаются довольно циничные, но справедливые слова одного русского генерала, который говорил про немцев: какая беда, что они умно рассчитывают, а мы им такую глупость подведём, что они и рта разинуть не успеют, чтобы понять её."
                            }
                        ]
                    },
                    {
                        "sense_id": "07074336-6cc2-36a3-9d15-7591e4cded64",
                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "glosses": [
                            "перен. отнести к какой-либо категории"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "41072fa8-fd47-3820-b05f-179a5f10a82f",
                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "glosses": [
                            "разг. с под + вин. п. своими действиями причинить неприятность, поставить в нежелательную ситуацию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e47f637-1e38-4541-b678-ee440d79110a",
                                "sense_id": "41072fa8-fd47-3820-b05f-179a5f10a82f",
                                "text": "Ох, подведёт она тебя когда-нибудь под статью!"
                            }
                        ]
                    },
                    {
                        "sense_id": "886452c6-dbc0-330f-92b9-09c28add6713",
                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "glosses": [
                            "разг. не оправдать ожиданий или надежд, причинив таким образом неприятность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25473b9b-04fe-43ef-a3c9-230ccc1ef948",
                                "sense_id": "886452c6-dbc0-330f-92b9-09c28add6713",
                                "text": "Эти поставщики ни разу нас не подвели."
                            }
                        ]
                    },
                    {
                        "sense_id": "e77783f9-68bf-34a0-9f92-f12549610e39",
                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "glosses": [
                            "подкрасить косметическим средством, подчеркнув определённые формы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "942c72c4-17ac-4377-988c-41f52cdfe177",
                                "sense_id": "e77783f9-68bf-34a0-9f92-f12549610e39",
                                "text": "Подчеркните складку век более тёмным тоном и подведите ресницы от внутреннего уголка глаза к наружному."
                            }
                        ]
                    },
                    {
                        "sense_id": "af742f69-2c2d-3d18-af02-2925d65927cf",
                        "entry_id": "4c1313c5-184b-3550-8dc2-3ceb67a7708c",
                        "glosses": [
                            "перен., безл. сделать худым, впалым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ebe8321-7f7d-4f0f-98f6-4666082bcbfb",
                                "sense_id": "af742f69-2c2d-3d18-af02-2925d65927cf",
                                "text": "Живот подвело."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
