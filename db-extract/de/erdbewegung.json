                            {
                                "example_id": "6901340c-177c-4b39-abef-6e4115482d17",
                                "sense_id": "a557e865-ff6b-3c6b-8572-d247224df36d",
                                "text": "„Hinter Galileis Worten verbirgt sich selbstverständlich die Hoffnung, daß es jetzt an der Zeit sei, die Anerkennung der Lehre von der doppelten Erdbewegung durch die Kirche zu erlangen.“"
                            }
