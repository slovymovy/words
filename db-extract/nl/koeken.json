                                        "examples": [
                                            {
                                                "example_id": "9426f92d-2cc5-47f8-9e71-ca669b968515",
                                                "sense_id": "7c4f9e8e-e476-317d-a781-e42bc87bd4ee",
                                                "text": "„Zu ihr gehört ein auf einem Glasfuße ruhender, hölzerner oder pappener Cylinder (Conductor), welcher mit Silberpapier oder Stanniol beklebt ist, und zur Aufsaugung der Elektricität an einem Ende einige frei herausstehende metallene Spitzen trägt, die man dem Cylinder, während seiner Drehung, sehr nahe bringt.“"
                                            },
                                            {
                                                "example_id": "5e979177-381e-4b8b-bc32-5d1f786c3097",
                                                "sense_id": "7c4f9e8e-e476-317d-a781-e42bc87bd4ee",
                                                "text": "„Rechts von ihm ist eine Bar aus Bambusstäben und pappenen Palmwedeln ins Dunkel geschoben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
