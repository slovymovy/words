                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05830187-f3fd-4349-bc6b-88110645a3b3",
                                "sense_id": "311fa2c7-6401-3c71-a1c7-b7fbe444f82d",
                                "text": "„Auf der kleinen Insel befinden sich eine frühchristliche Klostersiedlung, die im 6. Jh. vom hl. Molaise gegründet wurde, drei Kirchen, Bienenkorbhütten sowie zahlreiche interessante Steine […]“"
                            },
                            {
                                "example_id": "afdc3dfa-fa0f-45d3-9eb7-e54ae8bdeb76",
                                "sense_id": "311fa2c7-6401-3c71-a1c7-b7fbe444f82d",
                                "text": "„Die Klostersiedlung in Glendalough ist die berühmteste und die wohl Schönste in ganz Irland.“"
                            },
                            {
                                "example_id": "3d7a0607-8fae-4fc8-b7b7-acefadfc12a5",
                                "sense_id": "311fa2c7-6401-3c71-a1c7-b7fbe444f82d",
                                "text": "„Um 1000 n. Chr. entstand z.B. die Klostersiedlung in Glendalough (Grafschaft Wicklow).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
