                        "glosses": [
                            "Artisan ou industriel qui produit et vend de la choucroute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f93e59e4-aeb0-49c5-bc05-108e44140e96",
                                "sense_id": "45204036-d35b-3a7f-9a3d-4600725d7cc6",
                                "text": "Déjà présent sur le marché américain, le choucroutier Le Pic veut accélérer à l'international. Son arme : l'indication géographique protégée « choucroute d'Alsace »."
                            },
                            {
                                "example_id": "a26649f3-e9bb-47e5-9c2e-462fcffe8569",
                                "sense_id": "45204036-d35b-3a7f-9a3d-4600725d7cc6",
                                "text": "C'est le cas pour le navet qui une fois «lavé, épluché, coupé en spaghetti est salé et mis à fermenter», détaille Jean-Michel Ades, choucroutier à Krautergersheim et l'un des trois derniers producteurs de navets blancs confits d'Alsace. «Avant, tous les fabricants de choucroute faisaient du navet salé», rappelle celui qui a repris en 1991 la ferme familiale créée en 1936."
                            }
                        ]
                    }
