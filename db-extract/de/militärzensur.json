                ],
                "senses": [
                    {
                        "sense_id": "5a56ea51-e9f5-3726-843c-7ea2263a836c",
                        "entry_id": "603a62e0-e980-3a0a-b008-503f2655d626",
                        "glosses": [
                            "Zensur, die vom Militär ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08dc597d-2e91-4fb9-9faf-43fb1c48baf5",
                                "sense_id": "5a56ea51-e9f5-3726-843c-7ea2263a836c",
                                "text": "„Trotz Militärzensur konnten die Zeitungen sehr wohl Kritik an den Verhältnissen üben - sofern Chefredaktion und Verlag bereit waren, den Redakteuren den nötigen Freiraum zu geben und gewisse Risiken, etwa Schreibverbote für bestimmte Autoren einzugehen.“"
                            },
                            {
                                "example_id": "b9051c3d-0f42-4bdb-b31c-dcbed0e4960f",
                                "sense_id": "5a56ea51-e9f5-3726-843c-7ea2263a836c",
                                "text": "„Als das Büchlein in Deutschland erscheint, wird es von der Militärzensur wegen fehlender Druckerlaubnis verboten und kursiert in mehreren illegalen Nachdrucken und Abschriften, sogar in Form eines Kettenbriefs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
