                                "example_id": "e67ea28c-f986-4943-84ff-9a6c07ba72da",
                                "sense_id": "8a674e3f-d19a-3333-93b8-74135bd07f12",
                                "text": "De zandstorm maakte het zicht erg slecht.",
                                "translation": "The sandstorm made visibility very poor.",
                                "english": "The sandstorm made visibility very poor."
                            },
                            {
                                "example_id": "92dcb97f-4696-4daf-a526-c105d9bb22b0",
                                "sense_id": "8a674e3f-d19a-3333-93b8-74135bd07f12",
                                "text": "Ze schuilden voor de zandstorm in een oude schuur.",
                                "translation": "They took shelter from the sandstorm in an old barn.",
                                "english": "They took shelter from the sandstorm in an old barn."
                            },
                            {
                                "example_id": "42ab41e5-64b6-4b19-ac81-60c25cd52577",
                                "sense_id": "8a674e3f-d19a-3333-93b8-74135bd07f12",
                                "text": "De zandstorm had het hele dorp bedekt met een laag zand.",
                                "translation": "The sandstorm had covered the whole village with a layer of sand.",
                                "english": "The sandstorm had covered the whole village with a layer of sand."
                            }
                        ]
