                    "sense_id": "814c2992-f123-3842-b66f-49998cb41fc4",
                    "sense_definition": "Simple past and past participle of <w>depart</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train <w>departed</w> from the station on time.",
                            "target_lang_translations": {
                                "ru": "Поезд вовремя <w>отправился</w> со станции.",
                                "pl": "Pociąg <w>odjechał</w> ze stacji punktualnie."
                            }
                        },
                        {
                            "text": "She <w>departed</w> for London early this morning.",
                            "target_lang_translations": {
                                "ru": "Она <w>отправилась</w> в Лондон рано утром.",
                                "pl": "<w>Wyruszyła</w> do Londynu wcześnie rano."
                            }
                        }
                    ],
                    "common_phrases": [
                        "departed from",
                        "departed for"
                    ],
