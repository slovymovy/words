                "senses": [
                    {
                        "sense_id": "bd65df92-76f6-3feb-95c1-0bc81a202030",
                        "entry_id": "e920e932-fcd0-3435-b657-ced149d74890",
                        "glosses": [
                            "höchster Admiralsrang, in der Bundeswehr abgeschafft"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "46c0afb6-67b9-44e3-ae33-adf5df270de2",
                                "sense_id": "bd65df92-76f6-3feb-95c1-0bc81a202030",
                                "text": "Der Großadmiral wurde 1946 abgeschafft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "567a8cfd-fc0d-30d5-a6b4-848b9b77eec7",
                        "entry_id": "e920e932-fcd0-3435-b657-ced149d74890",
                        "glosses": [
                            "Offizier im Range eines Großadmirals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ca1994-361b-4c96-a337-f1057d94fa60",
                                "sense_id": "567a8cfd-fc0d-30d5-a6b4-848b9b77eec7",
                                "text": "Der letzte Großadmiral starb 1980."
                            },
                            {
                                "example_id": "20e7e621-688b-4032-8760-adc81968a558",
                                "sense_id": "567a8cfd-fc0d-30d5-a6b4-848b9b77eec7",
                                "text": "„Seit September 1940 ist er Vizeadmiral, am 14. März 1942 wird Hitler ihn zum Admiral befördern und weitere zehn Monate später zum Großadmiral.“"
                            },
                            {
                                "example_id": "5f002b21-344e-4874-8bcd-439cd778c162",
                                "sense_id": "567a8cfd-fc0d-30d5-a6b4-848b9b77eec7",
                                "text": "„Da er Großadmiral von Frankreich ist, besichtigt er die Flotte, die nach Algier in See sticht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
