                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opener",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2849f4ed-7d73-3d9d-b135-6d793304e7e7",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "A person who opens something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca6a749-3785-45ac-b762-f540a7cec641",
                                                "sense_id": "2849f4ed-7d73-3d9d-b135-6d793304e7e7",
                                                "text": "Have you, like the opener of this debate, discovered, sapiently enough, that \"the peace party, with Lord Aberdeen at their head, were the chief cause of the war\"?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4123aca-aa5d-3a08-bcb7-6b4e83323335",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "A device that opens something; specifically a tin-opener/can-opener, or a bottle opener."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d8506a4-6508-3cbd-a627-fa766b4a3e3f",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "An establishment that opens."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66b1b61f-033b-4f22-a6de-8f580219074c",
                                                "sense_id": "9d8506a4-6508-3cbd-a627-fa766b4a3e3f",
                                                "text": "The late-night openers in the mall include two restaurants and a clothing store."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0293ebcd-1d73-3af1-8779-a588006e8010",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "The player who starts the betting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "719ef508-73b9-3222-9d66-97083431413e",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "Cards of sufficient value to enable a player to open the betting."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c73a0ced-6255-38d7-9c69-c769575a3c78",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "A person employed to separate sheets of hot metal that become stuck together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66a54db1-6551-34a1-8408-ca9a906ec5af",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "The first act in a variety show or concert."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35459d1c-7126-3348-8232-7215ed598f60",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "A batsman or bowler who normally plays in the first two positions of an innings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8006103-f78b-37de-af4e-ac385804acd5",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "The first in a series of events, items etc.; the first remark or sentence of a conversation."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a85f0b9-8d4c-3919-ae16-9069417da5f2",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "The first game played in a competition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e392aafe-7faa-44af-ab69-812c325b731b",
                                                "sense_id": "6a85f0b9-8d4c-3919-ae16-9069417da5f2",
                                                "text": "The opener came from a Jarvis ball which struck Aleksandar Kolarov en route to a lively round of pinball between City players before it was poked in by Milijas."
                                            },
                                            {
                                                "example_id": "907322d4-db22-46f0-aad6-c14fa5620e02",
                                                "sense_id": "6a85f0b9-8d4c-3919-ae16-9069417da5f2",
                                                "text": "England were on the scoreboard after only one minute, Wilkinson, who missed five penalties in his side's opener against the Pumas, knocking over a three-pointer from bang in front, despite boos from the crowd."
                                            },
                                            {
                                                "example_id": "82fe92b9-f664-4b1e-b8a9-f200adc233cb",
                                                "sense_id": "6a85f0b9-8d4c-3919-ae16-9069417da5f2",
                                                "text": "His debut was highly anticipated, but Rodgers only saw 94 seconds of game time as he suffered the significant injury in the Jets’ season opener against the Buffalo Bills when he was sacked by edge rusher Leonard Floyd, only four plays in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4742c9a-920b-34d3-9746-7487b5cc921b",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "The first goal or point scored."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9b7ca9d-b5c9-3189-98e2-9e0a4266e1d9",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "A period of time when it is legal to commercially fish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff62e6d9-505d-399e-9494-562e3b4dbbf9",
                                        "entry_id": "133e791a-bc23-3d03-b0c4-9b27d73570e2",
                                        "glosses": [
                                            "A pitcher who specializes in getting the first outs of a game before being replaced, either by a long reliever or a pitcher who would normally start."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4072e758-0ffd-41f1-89dc-660e81dead83",
                                                "sense_id": "ff62e6d9-505d-399e-9494-562e3b4dbbf9",
                                                "text": "The Rays debuted the opener—in which a reliever starts the game and throws anywhere from one to three innings, then gives way to a new pitcher, who will usually throw three to five as essentially a second starter—on May 19 against the Angels, using veteran righty Sergio Romo to pitch the first."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "opener",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a40ff4cc-b0c5-3a57-bed9-98cf73bfec40",
                                        "entry_id": "e1aa2954-ddfe-3d1b-be7f-28b3d40d50d4",
                                        "glosses": [
                                            "comparative form of open: more open"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "893fc8f4-c11e-485b-9cf0-2fec0b60d32b",
                                                "sense_id": "a40ff4cc-b0c5-3a57-bed9-98cf73bfec40",
                                                "text": "The letter y is also used for the slightly opener non-fricative sound heard in English year."
                                            },
                                            {
                                                "example_id": "ce27dc52-751b-4524-a3a4-f54249bfa63a",
                                                "sense_id": "a40ff4cc-b0c5-3a57-bed9-98cf73bfec40",
                                                "text": "Lower-middle-class speakers in New York showed a strong tendency to report themselves as using [æː] in the word pass, although as objectively observed they tended to use the pronunciation with [ɛːə]. And in the most formal style (word lists) they produced on average an opener quality than the upper-middle-class speakers – an example of Labov-hypercorrection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
