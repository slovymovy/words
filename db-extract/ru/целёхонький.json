                        "glosses": [
                            "emphatic of целый (celyj): intact, without a scratch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df7c65d8-4b50-4edd-9ac4-c2484c5d51c5",
                                "sense_id": "d617d82b-bab7-3974-a109-fa0ad0d6081a",
                                "text": "Да, бу́дто здесь ничего́ не случи́лось. Вон кио́ск стои́т стекля́нный, целёхонек.",
