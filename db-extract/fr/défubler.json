                ],
                "senses": [
                    {
                        "sense_id": "7dd0299f-fc5f-3523-bc3f-0485c7b7d6cc",
                        "entry_id": "6c826ec1-ff83-375f-9e3a-5230d3d0eeb6",
                        "glosses": [
                            "Ôter un affublement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87abc85a-271d-4d62-8a62-7cc0d2e61dcd",
                                "sense_id": "7dd0299f-fc5f-3523-bc3f-0485c7b7d6cc",
                                "text": "Défublé maintenant, c'était un touriste comme un autre, […]."
                            },
                            {
                                "example_id": "2bbf8bc8-5c08-43a2-a505-ee6984db6e24",
                                "sense_id": "7dd0299f-fc5f-3523-bc3f-0485c7b7d6cc",
                                "text": "Aucun doute, c'est une Walkyrie de Wagner qui a défublé son casque à l'hôtel et suit maintenant, d'un regard vert et rêveur, le jaillissement des fléchettes d'eau, de pulvérulence ensablée et de vent."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b9d5e62-c248-3a9f-add7-518f66b1e7a9",
                        "entry_id": "6c826ec1-ff83-375f-9e3a-5230d3d0eeb6",
                        "glosses": [
                            "Quitter son affublement."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "3cb7df17-3fdf-4be1-959b-a4b24618f92c",
                                "sense_id": "7b9d5e62-c248-3a9f-add7-518f66b1e7a9",
                                "text": "Le château, ranimé par un bain de soleil, se défublait de ses mines grognonnes, rajeunissait, s'affétait, coquettait, pour son départ."
                            }
                        ]
                    },
                    {
                        "sense_id": "cec7333c-335c-3f4c-92c6-776855560031",
                        "entry_id": "6c826ec1-ff83-375f-9e3a-5230d3d0eeb6",
                        "glosses": [
                            "Ôter ce qui enveloppe. ^([1])"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "076b856f-3cdb-3da3-ae05-a8432892e30b",
                        "entry_id": "6c826ec1-ff83-375f-9e3a-5230d3d0eeb6",
                        "glosses": [
                            "Se déshabiller. ^([2])"
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "7151d4e1-af04-4d18-baf5-dab0f24bfad7",
                                "sense_id": "076b856f-3cdb-3da3-ae05-a8432892e30b",
                                "text": "Et puis les samedi,elle avait honte devant Biniditto de se défubler en culotte dessampillée et combinaison élimée."
                            }
                        ]
                    }
                ],
