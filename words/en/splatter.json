{
    "word_family": [
        "splat"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58ff0ad9-7f63-398f-98e7-7e3b5ebb033b",
                    "sense_definition": "To splash or scatter and land in an uneven mess.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "splash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mud <w>splattered</w> across the windshield as the car drove through the puddle.",
                            "target_lang_translations": {
                                "cs": "Bláto se <w>rozstříklo</w> po čelním skle, když auto projelo kaluží.",
                                "zh": "汽车开过水坑时，泥浆<w>溅</w>满了挡风玻璃。"
                            }
                        },
                        {
                            "text": "Hot oil <w>splattered</w> onto the stove while she was cooking dinner.",
                            "target_lang_translations": {
                                "cs": "Horký olej <w>prskal</w> na sporák, zatímco vařila večeři.",
                                "zh": "她做晚饭时，热油<w>飞溅</w>到了炉台上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "splash",
                        "spatter"
                    ],
                    "common_phrases": [
                        "splattered everywhere"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rozstříknout se nebo rozptýlit se a dopadnout na povrch v podobě neuspořádaných skvrn.",
                        "zh": "（液体等）溅泼，飞溅并散落一地"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozstříknout se",
                                "target_lang_sense_clarification": "o kapalině, která dopadne na povrch a vytvoří skvrny"
                            },
                            {
                                "target_lang_word": "cákat",
                                "target_lang_sense_clarification": "obecné vyjádření pro rozstřikování kapaliny"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "溅",
                                "target_lang_sense_clarification": "液体飞落在物体上"
                            },
                            {
                                "target_lang_word": "飞溅",
                                "target_lang_sense_clarification": "向四处溅洒"
                            },
                            {
                                "target_lang_word": "溅落",
                                "target_lang_sense_clarification": "散落并落在表面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b8686d6-9936-306f-8897-11172d29b697",
                    "sense_definition": "To cause a liquid or substance to land in an uneven mess.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "splash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>splattered</w> bright blue paint across the entire canvas.",
                            "target_lang_translations": {
                                "cs": "Umělec <w>rozstříkal</w> jasně modrou barvu po celém plátně.",
                                "zh": "艺术家把鲜蓝色的颜料<w>泼洒</w>在整块画布上。"
                            }
                        },
                        {
                            "text": "Be careful not to <w>splatter</w> ink on your clean white shirt.",
                            "target_lang_translations": {
                                "cs": "Dávej pozor, ať si <w>nepocákáš</w> inkoustem svou čistou bílou košili.",
                                "zh": "小心别把墨水<w>溅</w>到你干净的白衬衫上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "splash",
                        "spatter"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, aby kapalina nebo jiná látka dopadla na povrch v podobě neuspořádaných skvrn.",
                        "zh": "使（液体或物质）溅洒在表面上"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozstříknout",
                                "target_lang_sense_clarification": "úmyslné nebo neúmyslné rozptýlení kapaliny"
                            },
                            {
                                "target_lang_word": "pocákat",
                                "target_lang_sense_clarification": "pokrýt povrch nebo osobu kapkami kapaliny"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泼洒",
                                "target_lang_sense_clarification": "有意或无意甩落液体"
                            },
                            {
                                "target_lang_word": "甩溅",
                                "target_lang_sense_clarification": "甩开使液体四溅"
                            },
                            {
                                "target_lang_word": "溅",
                                "target_lang_sense_clarification": "弄溅液体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb4e7db1-7f10-356f-8a62-ba4e0f8e128a",
                    "sense_definition": "To cover a surface or person with small drops of liquid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "splash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The passing truck <w>splattered</w> the pedestrians with dirty rainwater.",
                            "target_lang_translations": {
                                "cs": "Projíždějící náklaďák <w>pocákal</w> chodce špinavou dešťovou vodou.",
                                "zh": "驶过的卡车把脏雨水<w>溅</w>了行人一身。"
                            }
                        },
                        {
                            "text": "He accidentally <w>splattered</w> his friend with soapy water while washing the car.",
                            "target_lang_translations": {
                                "cs": "Při mytí auta nechtěně <w>pocákal</w> kamaráda mýdlovou vodou.",
                                "zh": "他洗车时不小心用肥皂水<w>溅湿</w>了朋友。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spatter",
                        "spray"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokrýt povrch nebo osobu malými kapkami kapaliny.",
                        "zh": "把液体溅在（某人或某物表面）上"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pocákat",
                                "target_lang_sense_clarification": "pokrýt někoho nebo něco kapkami"
                            },
                            {
                                "target_lang_word": "postříkat",
                                "target_lang_sense_clarification": "pokrýt povrch stříkající kapalinou"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "溅满",
                                "target_lang_sense_clarification": "溅得到处都是"
                            },
                            {
                                "target_lang_word": "溅湿",
                                "target_lang_sense_clarification": "弄湿弄脏"
                            },
                            {
                                "target_lang_word": "溅",
                                "target_lang_sense_clarification": "泼溅到人或物上"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f2ca4b4-703f-3a78-b085-4d9c4b7f46a1",
                    "sense_definition": "An uneven shape or mess created by liquid dispersing on impact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "splash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a large <w>splatter</w> of red paint on the floor.",
                            "target_lang_translations": {
                                "cs": "Na podlaze byl velký <w>stříkanec</w> červené barvy.",
                                "zh": "地板上有一大片红颜料的<w>斑迹</w>。"
                            }
                        },
                        {
                            "text": "She tried to wipe the muddy <w>splatter</w> off her boots.",
                            "target_lang_translations": {
                                "cs": "Snažila se otřít ten blátivý <w>cákanec</w> ze svých bot.",
                                "zh": "她试图擦掉靴子上的泥<w>污渍</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "splash",
                        "spatter"
                    ],
                    "common_phrases": [
                        "paint splatter"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nepravidelný tvar nebo skvrna vzniklá dopadem kapaliny na povrch.",
                        "zh": "（液体撞击散开形成的）溅斑，飞溅的水渍或污渍"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stříkanec",
                                "target_lang_sense_clarification": "skvrna vzniklá rozstříknutím barvy nebo jiné látky"
                            },
                            {
                                "target_lang_word": "cákanec",
                                "target_lang_sense_clarification": "hovorové označení pro skvrnu od kapaliny"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斑迹",
                                "target_lang_sense_clarification": "溅落后留下的痕迹"
                            },
                            {
                                "target_lang_word": "污渍",
                                "target_lang_sense_clarification": "溅落的泥或水斑"
                            },
                            {
                                "target_lang_word": "溅痕",
                                "target_lang_sense_clarification": "飞溅形成的痕迹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bba7578-a35a-3bf5-b65b-a8a1aacbc99c",
                    "sense_definition": "A genre of horror film characterized by extreme gore.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director is famous for his contribution to the <w>splatter</w> film genre.",
                            "target_lang_translations": {
                                "cs": "Režisér je známý svým přínosem k žánru <w>splatter</w> filmů.",
                                "zh": "这位导演因其对<w>血浆片</w>类型的贡献而闻名。"
                            }
                        },
                        {
                            "text": "Many critics dislike the excessive violence found in a typical <w>splatter</w> movie.",
                            "target_lang_translations": {
                                "cs": "Mnoho kritiků nemá rádo nadměrné násilí, které se vyskytuje v typickém <w>splatter</w> filmu.",
                                "zh": "许多影评人不喜欢典型<w>血浆片</w>中展现的过度暴力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "splatter film"
                    ],
                    "target_lang_definitions": {
                        "cs": "Žánr hororového filmu vyznačující se extrémním násilím a krví.",
                        "zh": "（以血腥暴力为特征的）血浆片，泼血恐怖片"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "splatter film",
                                "target_lang_sense_clarification": "přejatý termín pro subžánr hororu zaměřený na gore"
                            },
                            {
                                "target_lang_word": "gore film",
                                "target_lang_sense_clarification": "alternativní označení pro filmy s extrémními krvavými scénami"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "血浆片",
                                "target_lang_sense_clarification": "充斥大量血腥场景的恐怖电影"
                            },
                            {
                                "target_lang_word": "泼血恐怖片",
                                "target_lang_sense_clarification": "极度血腥的恐怖片类型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "577e4129-7aff-3e71-bd2a-7296ba09dc67",
                    "sense_definition": "Unwanted radio signal emissions caused by abrupt transmission changes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician adjusted the transmitter to reduce the <w>splatter</w> affecting nearby channels.",
                            "target_lang_translations": {
                                "cs": "Technik seřídil vysílač, aby omezil <w>rušení</w> ovlivňující sousední kanály.",
                                "zh": "技术人员调整了发射机，以减少影响邻近频道的<w>邻道杂散辐射</w>。"
                            }
                        },
                        {
                            "text": "Excessive <w>splatter</w> can cause significant interference for other radio users.",
                            "target_lang_translations": {
                                "cs": "Nadměrné <w>rušení</w> může způsobit značné interference ostatním uživatelům rádia.",
                                "zh": "过度的<w>频带飞溅</w>会给其他无线电使用者造成严重干扰。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nežádoucí emise rádiového signálu způsobené náhlými změnami při vysílání.",
                        "zh": "（无线电信号的）邻道杂散发射，频带飞溅"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rušení",
                                "target_lang_sense_clarification": "obecný termín pro nežádoucí signály v rádiovém přenosu"
                            },
                            {
                                "target_lang_word": "spektrální přesah",
                                "target_lang_sense_clarification": "technický termín pro nežádoucí šíření signálu mimo přidělený kanál"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "邻道杂散辐射",
                                "target_lang_sense_clarification": "无线电发射引起的邻道干扰"
                            },
                            {
                                "target_lang_word": "频带飞溅",
                                "target_lang_sense_clarification": "无线电通信术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}