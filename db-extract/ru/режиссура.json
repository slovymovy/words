                ],
                "senses": [
                    {
                        "sense_id": "600ac8d6-9173-3dc6-a2e0-e2facde86f9c",
                        "entry_id": "f54e0a5e-8c8c-3bca-b15a-2119e15ca462",
                        "glosses": [
                            "действие по значению гл. режиссировать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4d7ec7a-eeee-4f36-98d6-581d4ede3ff0",
                                "sense_id": "600ac8d6-9173-3dc6-a2e0-e2facde86f9c",
                                "text": "Такие точные образы ― результат тонкой режиссуры."
                            }
                        ]
                    },
                    {
                        "sense_id": "d24f1c61-6213-39cc-a482-4e9995cad498",
                        "entry_id": "f54e0a5e-8c8c-3bca-b15a-2119e15ca462",
                        "glosses": [
                            "деятельность режиссёра, результат работы режиссёра; режиссирование"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d801bdb6-f1f6-4bba-9084-f6cd3e5f9d44",
                                "sense_id": "d24f1c61-6213-39cc-a482-4e9995cad498",
                                "text": "Театральная режиссура XX столетия, впрочем как и все остальные виды искусства, делится на режиссуру дотелевизионную и последующую, рожденную в период новой информационной цивилизации."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c32d15f-196a-38b9-9562-4303f2673e75",
                        "entry_id": "f54e0a5e-8c8c-3bca-b15a-2119e15ca462",
                        "glosses": [
                            "собир. режиссёры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673ec55e-600b-4729-9f2e-fdd18502cdd1",
                                "sense_id": "7c32d15f-196a-38b9-9562-4303f2673e75",
                                "text": "Отсюда, кстати, и спорность тезиса про аудиторию «новой драмы», якобы ограниченную профессиональной публикой (критика, режиссура, продюсеры, актеры, студенты театральных вузов)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28f080ad-bb8a-4caf-abea-f28fe301ead0",
                        "source_entry_id": "f54e0a5e-8c8c-3bca-b15a-2119e15ca462",
                        "target_lang_word": "direction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "direction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7abeb440-3180-30d8-b660-6add155dc866",
                                        "entry_id": "83c39e75-a186-3773-a406-1d0e2cce41f2",
                                        "glosses": [
                                            "A theoretical line (physically or mentally) followed from a point of origin or towards a destination. May be relative (e.g. up, left, outbound, dorsal), geographical (e.g. north), rotational (e.g. clockwise), or with respect to an object or location (e.g. toward Boston)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bf6920f-fcb9-4bce-9bdf-972fa864638d",
                                                "sense_id": "7abeb440-3180-30d8-b660-6add155dc866",
                                                "text": "Keep going in the same direction."
                                            },
                                            {
                                                "example_id": "6c98da68-3a41-4110-86db-39e3ac7e91d8",
                                                "sense_id": "7abeb440-3180-30d8-b660-6add155dc866",
                                                "text": "Judge Short had gone to town, and Farrar was off for a three days' cruise up the lake. I was bitterly regretting I had not gone with him when the distant notes of a coach horn reached my ear, and I descried a four-in-hand winding its way up the inn road from the direction of Mohair."
                                            },
                                            {
                                                "example_id": "c2c8bbf0-0073-4770-a7c4-2131a0913a5b",
                                                "sense_id": "7abeb440-3180-30d8-b660-6add155dc866",
                                                "text": "Just before Warwick reached Liberty Point, a young woman came down Front Street from the direction of the market-house. When their paths converged, Warwick kept on down Front Street behind her, it having been already his intention to walk in this direction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0bac367-b4ff-3cd9-affd-a18559267bdf",
                                        "entry_id": "83c39e75-a186-3773-a406-1d0e2cce41f2",
                                        "glosses": [
                                            "A general trend for future action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "181c1efe-a9ba-3920-9780-acd31a7d8922",
                                        "entry_id": "83c39e75-a186-3773-a406-1d0e2cce41f2",
                                        "glosses": [
                                            "Guidance, instruction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74d84911-dda4-4676-99f6-e23844de4efc",
                                                "sense_id": "181c1efe-a9ba-3920-9780-acd31a7d8922",
                                                "text": "The trombonist looked to the bandleader for direction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f636017-d107-313c-b6af-bd33c1075dc4",
                                        "entry_id": "83c39e75-a186-3773-a406-1d0e2cce41f2",
                                        "glosses": [
                                            "The work of the director in cinema or theater; the skill of directing a film, play etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2b4eb7a-c73b-4ee5-9bc2-1a781caed368",
                                                "sense_id": "9f636017-d107-313c-b6af-bd33c1075dc4",
                                                "text": "The screenplay was good, but the direction was weak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2acba237-c46c-37d1-9582-debc1535cb6a",
                                        "entry_id": "83c39e75-a186-3773-a406-1d0e2cce41f2",
                                        "glosses": [
                                            "The body of persons who guide or manage a matter; the directorate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23a06dc3-3de0-41e6-829f-e8a58022cad5",
                                                "sense_id": "2acba237-c46c-37d1-9582-debc1535cb6a",
                                                "text": "I shall not rest satisfied with merely employing my capital in insuring ships. I shall buy up some good Life Assurance shares, and cut into the Direction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ac70e9d-efd3-3163-9df1-c3621a2e1a9e",
                                        "entry_id": "83c39e75-a186-3773-a406-1d0e2cce41f2",
                                        "glosses": [
                                            "A person's address."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd61e175-8272-4071-b941-fbe354385a3a",
                                                "sense_id": "2ac70e9d-efd3-3163-9df1-c3621a2e1a9e",
                                                "text": "Her aunt Leonella was still at Cordova, and she knew not her direction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "322a5358-3599-4738-9a76-9595c049777e",
                        "source_entry_id": "f54e0a5e-8c8c-3bca-b15a-2119e15ca462",
