                ],
                "senses": [
                    {
                        "sense_id": "f589ab9b-3718-358d-8e9b-f42e9d0d6cf3",
                        "entry_id": "6638e02c-de1e-307a-9ea3-05426b041093",
                        "glosses": [
                            "rundes Einbauteil zu einem Lüftungsrohr, zur gezielten Verminderung der Schallübertragung aus diesem, von einer Maschine oder einer Anlage, zur Telefonieschalldämpfung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ab7bd44-032d-4092-a86e-7272740e130a",
                                "sense_id": "f589ab9b-3718-358d-8e9b-f42e9d0d6cf3",
                                "text": "„Geräteschalldämpfer reduzieren die Ventilatorgeräusche im Lüftungsgerät, Telefonieschalldämpfer verhindern, dass Sprache und Geräusche über die Lüftungsanlage und Kanäle in angrenzende Räume übertragen werden.“"
                            },
                            {
                                "example_id": "c7f785e6-d540-4856-b862-6c78e8d1cff9",
                                "sense_id": "f589ab9b-3718-358d-8e9b-f42e9d0d6cf3",
                                "text": "„Telefonieschalldämpfer sind erforderlich um Schallübertragungen über die Lüftungskanäle zu vermeiden.“"
                            },
                            {
                                "example_id": "62e91a29-11af-467d-bfb3-c17cfbc9a02c",
                                "sense_id": "f589ab9b-3718-358d-8e9b-f42e9d0d6cf3",
                                "text": "„Grundsätzlich ist der Telefonieschalldämpfer die günstigere und der Rohrschalldämpfer die effizientere Variante für die Dämmung von Lüftungskanälen und Leitungen.“"
                            },
                            {
                                "example_id": "79ccb471-16c3-4d01-bfe5-f1c55ec093e5",
                                "sense_id": "f589ab9b-3718-358d-8e9b-f42e9d0d6cf3",
                                "text": "„Sind bei herkömmlichen Konzepten der freien Überströmung der Luft von Raum zu Raum Telefonieschalldämpfer zur Verhinderung von Übersprechgeräuschen erforderlich, übernehmen bei „Indusilent“ die Überströmelemente die Aufgabe der Schalldämpfung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
