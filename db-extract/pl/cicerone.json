                "senses": [
                    {
                        "sense_id": "445f8c3d-d96b-38cd-8477-efec77d2d176",
                        "entry_id": "935bff46-a62e-31fe-a483-0fadca7edefd",
                        "glosses": [
                            "przewodnik oprowadzający po zabytkach"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5c04a5b8-b851-4865-b689-34eb767a1ae7",
                                "sense_id": "445f8c3d-d96b-38cd-8477-efec77d2d176",
                                "text": "Po Rzymie oprowadzał nas radosny cicerone, którego poleciła jedna zakonnica."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f89ac7df-a1a2-4662-9a63-deb4fc68b382",
                        "source_entry_id": "935bff46-a62e-31fe-a483-0fadca7edefd",
                        "source_sense_id": "445f8c3d-d96b-38cd-8477-efec77d2d176",
                        "target_lang_word": "cicerone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cicerone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46efc6b3-b9b9-38c7-a061-6890ffd068c8",
                                        "entry_id": "f7f35630-5629-3b36-8e0c-f7a7930543c6",
                                        "glosses": [
                                            "A guide who accompanies visitors and sightseers to museums, galleries, etc., and explains matters of archaeological, antiquarian, historic or artistic interest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29ce9c68-259c-4e3e-a65e-3796a0ea8103",
                                                "sense_id": "46efc6b3-b9b9-38c7-a061-6890ffd068c8",
                                                "text": "East, still doing the cicerone, pointed out all the remarkable characters to Tom as they passed[…]"
                                            },
                                            {
                                                "example_id": "67ae97a9-3380-4906-80ad-64158c268081",
                                                "sense_id": "46efc6b3-b9b9-38c7-a061-6890ffd068c8",
                                                "text": "he was in the act of making his evening plans with the same smelly but nice cicerone in a café-au-lait suit whom he had hired already twice at the same Genoese hotel [...]."
                                            },
                                            {
                                                "example_id": "3bea5e69-1e94-484c-9aea-8aacd444aa5b",
                                                "sense_id": "46efc6b3-b9b9-38c7-a061-6890ffd068c8",
                                                "text": "Ultimately their gazes all rested on his cicerone as most powerful member of the group."
                                            },
                                            {
                                                "example_id": "2fd12c34-95ca-4baa-9b2d-65e7c0610e52",
                                                "sense_id": "46efc6b3-b9b9-38c7-a061-6890ffd068c8",
                                                "text": "“First,” advised their cicerone in the matter, Professor Svegli of the University of Pisa, “try to forget the usual picture in two dimensions.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cicerone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39929aaf-62c4-39ae-af43-b931aabfcedc",
                                        "entry_id": "ed9aa7f1-afdc-38fc-ac0f-afffe2c54c9c",
                                        "glosses": [
                                            "To show (somebody) the sights, acting as a tourist guide."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21e677c6-6b05-414b-b047-7a8ba49fb458",
                                                "sense_id": "39929aaf-62c4-39ae-af43-b931aabfcedc",
                                                "text": "Accordingly, as three o'clock struck, six dashing-looking light dragoons were seen slowly sauntering up the dining-hall, escorted by Webber, who, in full academic costume, was leisurely ciceroning his friends and expatiating upon the excellences of the very remarkable portraits which graced the walls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
