            {
                "entry_id": "9d6361b5-223c-3224-bb77-88d59223a90a",
                "word": "been",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7074af23-1a15-34d6-99e4-193705b4a7ec",
                        "entry_id": "9d6361b5-223c-3224-bb77-88d59223a90a",
                        "glosses": [
                            "plural simple present of be."
                        ],
                        "tags": [
