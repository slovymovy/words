                                "target_senses": [
                                    {
                                        "sense_id": "7a948e61-cf95-3041-a769-67ab73a3c27e",
                                        "entry_id": "fab0cb18-a3b2-3d77-87ce-9c27d60bfdb5",
                                        "glosses": [
                                            "A cyclic monoterpene alcohol; the major component of the essential oil of peppermint; used in pharmaceutical preparations as an antitussive and antipruritic agent, as a nasal decongestant, and in menthol cigarettes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82faa9f9-bbd6-3eb7-b825-49f9398170f3",
                                        "entry_id": "fab0cb18-a3b2-3d77-87ce-9c27d60bfdb5",
                                        "glosses": [
                                            "A menthol cigarette."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfb1c2dc-492a-4c2f-b493-b6decf9ac321",
                        "source_entry_id": "d617bc1a-6ba7-3f42-8fdd-56ef1dc47325",
                        "source_sense_id": "1e3e7429-d2cb-36be-95df-735384f1fd9f",
                        "target_lang_word": "menthol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menthol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f200e7df-ea27-3a10-bd2d-0f6793a40f0b",
                                        "entry_id": "415b5497-b89d-38ff-a150-83293c6c7a41",
                                        "glosses": [
                                            "Cyclohexanol monoterpénique tiré de la feuille de menthe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce870d39-e408-4aff-adc7-4b9cb2d44ab8",
                                                "sense_id": "f200e7df-ea27-3a10-bd2d-0f6793a40f0b",
                                                "text": "Recouvertes de poils sécréteurs d’huile essentielle, [les menthes] émettent une odeur très caractéristique de menthol lorsqu’elles sont froissées."
                                            },
                                            {
                                                "example_id": "0584474a-c39c-4899-a0b9-80aa2438d282",
                                                "sense_id": "f200e7df-ea27-3a10-bd2d-0f6793a40f0b",
                                                "text": "Les biochimistes ont établi que le tabac, l’alcool, l’ail, la carotte, l’ail des ours et d’autres ingrédients modifient l’odeur du lait, et ont identifié des composés responsables de ces odeurs, tels que la carvone (dans le fenugrec, le carvi), le menthol (dans la menthe), l’anéthol (dans l’anis, le fenouil…), l’eucalyptol (dans la menthe)."
                                            },
                                            {
                                                "example_id": "7c20e54f-3576-40f3-b19d-25dd45686582",
                                                "sense_id": "f200e7df-ea27-3a10-bd2d-0f6793a40f0b",
                                                "text": "Le menthol (composant de l’huile essentielle de la menthe poivrée Mentha x piperita) agit par exemple contre le transfert de plasmides chez Escherichia coli."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "menthol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16337b4e-c8b3-362d-a8bd-6b755be80056",
                                        "entry_id": "e8bc0379-fbcb-3c16-b834-ca608030bcef",
                                        "glosses": [
                                            "Cigarette aromatisée à la menthe, au menthol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e45851-258d-43cb-9877-01ed3d9d7cc7",
                                                "sense_id": "16337b4e-c8b3-362d-a8bd-6b755be80056",
                                                "text": "Lorsqu’elle sortait le soir avec Georges, elle se maquillait un peu, fumait quelques cigarettes menthol, passait sa main dans ses cheveux, riait aux éclats."
                                            },
                                            {
                                                "example_id": "e5de361e-8baa-4410-be91-c083c6a0dece",
                                                "sense_id": "16337b4e-c8b3-362d-a8bd-6b755be80056",
                                                "text": "Les publicités autour de ces futures cigarettes sans menthol gardent les mêmes éléments de langage que les menthols : “fraicheur”, “légèreté”, ”douceur”,…"
                                            },
                                            {
                                                "example_id": "ed3301a1-e69e-433a-b547-c6f63f760d72",
                                                "sense_id": "16337b4e-c8b3-362d-a8bd-6b755be80056",
                                                "text": "Puis Adami s’assit à une table et alluma tranquillement une menthol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78f4c84b-d17a-45ac-8d5d-7071b17e4991",
                        "source_entry_id": "d617bc1a-6ba7-3f42-8fdd-56ef1dc47325",
                        "source_sense_id": "1e3e7429-d2cb-36be-95df-735384f1fd9f",
                        "target_lang_word": "Menthol",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menthol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dcc183be-d56a-389f-b78d-7665bbf4331c",
                                        "entry_id": "6580a097-4932-3ef1-bd37-d6de208f7686",
                                        "glosses": [
                                            "chemischer Stoff mit starkem Minzgeschmack"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad416eb-f096-424f-b330-23bd75a627e9",
                                                "sense_id": "dcc183be-d56a-389f-b78d-7665bbf4331c",
                                                "text": "Menthol bildet bei Raumtemperatur weiße Kristalle."
                                            },
                                            {
                                                "example_id": "9c4ae314-5d46-47fa-b7b9-5791a634acae",
                                                "sense_id": "dcc183be-d56a-389f-b78d-7665bbf4331c",
                                                "text": "Keiner riecht gern nach muffigem Tabakqualm und so greifen Jugendliche – oder auch ZEIT-Herausgeber – gerne zu Zigaretten mit künstlichen Geschmacksrichtungen wie Menthol oder anderen Aromastoffen, wie Schokolade."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
