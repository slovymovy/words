                    {
                        "translation_id": "008da773-06dd-4a8b-a7f9-f84e2e9d43cb",
                        "source_entry_id": "3039da3e-cf3a-3c3e-ae4a-546a628b42f9",
                        "source_sense_id": "701ae33b-4091-3841-af6d-cb6894add672",
