                        },
                        {
                            "text": "De eenden zwommen rustig rond op de stille <w>plas</w>.",
                            "target_lang_translations": {
                                "en": "The ducks swam quietly around on the quiet <w>pond</w>.",
                                "ru": "Утки спокойно плавали по тихому <w>пруду</w>.",
                                "pl": "Kaczki spokojnie pływały po cichym <w>stawie</w>.",
                                "de": "Die Enten schwammen ruhig auf dem stillen <w>Teich</w> umher.",
                                "fr": "Les canards nageaient tranquillement sur l'<w>étang</w> calme.",
                                "it": "Le anatre nuotavano tranquille sul <w>laghetto</w> silenzioso.",
                                "cs": "Kachny klidně plavaly na tichém <w>rybníce</w>.",
                                "tr": "Ördekler sessiz <w>göletin</w> üzerinde sakince yüzüyorlardı.",
                                "es": "Los patos nadaban tranquilamente en el <w>estanque</w> silencioso.",
                                "zh": "鸭子在平静的<w>池塘</w>上悠闲地游来游去。"
                            }
