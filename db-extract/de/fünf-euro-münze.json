                "senses": [
                    {
                        "sense_id": "f8d91d90-8605-3cb3-9c1b-7e3d2c3a0ac9",
                        "entry_id": "1c38520e-8d4f-3838-bbfa-846807db751a",
                        "glosses": [
                            "Münze im Nennwert von fünf Euro"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a272296e-8b7e-4c7d-9ebc-1f5e31128111",
                                "sense_id": "f8d91d90-8605-3cb3-9c1b-7e3d2c3a0ac9",
                                "text": "„Deutschlands Automatenbetreiber fordern eine Fünf-Euro-Münze, weil das Euro-Kleingeld die Münzspeicher zu schnell fülle.“"
                            },
                            {
                                "example_id": "3519f848-7687-4df6-ab0c-1a8bc1656365",
                                "sense_id": "f8d91d90-8605-3cb3-9c1b-7e3d2c3a0ac9",
                                "text": "„Die Münze Österreich möchte die Bekanntheit der Fünf-Euro-Münze steigern und sie als Zahlungsmittel etablieren.“"
                            },
                            {
                                "example_id": "62a71fc2-1340-4b8a-9f9f-be40568dff0f",
                                "sense_id": "f8d91d90-8605-3cb3-9c1b-7e3d2c3a0ac9",
                                "text": "„Ein blauer Polymerring in der Mitte macht die neue Fünf-Euro-Münze zum echten Hingucker - und ist fälschungssicher.“"
                            },
                            {
                                "example_id": "b72975a4-b66d-4626-8277-52d2ad93200f",
                                "sense_id": "f8d91d90-8605-3cb3-9c1b-7e3d2c3a0ac9",
                                "text": "„Im Frühjahr nächsten Jahres kommt eine Fünf-Euro-Münze auf den Markt, die in der Mitte einen durchsichtigen, blau schimmernden Ring enthält.“"
                            },
                            {
                                "example_id": "be1f96b1-4c04-4263-8120-095087b73a55",
                                "sense_id": "f8d91d90-8605-3cb3-9c1b-7e3d2c3a0ac9",
                                "text": "„Das ist sie: die erste Fünf-Euro-Münze und die Antwort als mondernstes und fälschungssicheres Zahlungsmittel mit Münzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
