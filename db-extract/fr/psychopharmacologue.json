                                "target_senses": [
                                    {
                                        "sense_id": "3de6b622-9205-3703-af71-0baacd4455af",
                                        "entry_id": "2f852728-0bbd-315d-b38b-68094cdd3f99",
                                        "glosses": [
                                            "A person involved in psychopharmacology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40eff417-ed2a-4830-bba2-a5bec35ca88a",
                                                "sense_id": "3de6b622-9205-3703-af71-0baacd4455af",
                                                "text": "The psychopharmacologist (I like to call his office the Fifth Avenue Crack House, because all he really does is write prescriptions and hand out pills) told me I shouldn't."
                                            },
                                            {
                                                "example_id": "b68eddb6-8a50-4166-8d65-ec0dd676b924",
                                                "sense_id": "3de6b622-9205-3703-af71-0baacd4455af",
                                                "text": "Even medical schools seem to have submitted to psychophobia by training psychiatrists almost exclusively as psychopharmacologists instead of as psychotherapists."
                                            },
                                            {
                                                "example_id": "02586413-1637-4d2e-8c8c-3380fb36ad67",
                                                "sense_id": "3de6b622-9205-3703-af71-0baacd4455af",
                                                "text": "But a psychopharmacologist felt his physical symptoms were so extreme that unless he tamped those down, he couldn’t benefit from other coping techniques, according to Stossel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
