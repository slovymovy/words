                ],
                "senses": [
                    {
                        "sense_id": "5f9eef5b-6f42-3353-bf96-73887ab9c286",
                        "entry_id": "56b3a414-da9d-34c6-8fa2-3dc38758f096",
                        "glosses": [
                            "bestimmtes Gebiet, bestimmter Bereich in dem es riecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "472ddaec-1ea1-41a2-8e1d-ffe147ccad3b",
                                "sense_id": "5f9eef5b-6f42-3353-bf96-73887ab9c286",
                                "text": "„Die Entfernungen (300 Meter) bezüglich der Geruchszone werden eingehalten und auch bei der Anzahl der Masttiere bleibe man unter jener Grenze (1500 Schweine), über der eine Umweltverträglichkeitsprüfung notwendig wäre.“"
                            },
                            {
                                "example_id": "c62c0a77-52ed-4024-9dbe-9dce57bd25ca",
                                "sense_id": "5f9eef5b-6f42-3353-bf96-73887ab9c286",
                                "text": "„Gerechte und Ungerechte, Tolerante und Geschäftemacher, alle stehen sie mit einem Mal in der einen unsauberen Geruchszone, und selbst die Redlichen tragen den Makel der Dummheit, weil sie nichts gemerkt haben. “"
                            },
                            {
                                "example_id": "6e83ee4d-a57d-48fa-8b62-3c81f97dd1e9",
                                "sense_id": "5f9eef5b-6f42-3353-bf96-73887ab9c286",
                                "text": "„Beinahe jeder Schritt führt in eine veränderte Geruchszone, Düfte und Gestank bilden eine abwechslungsreiche Palette.“"
                            },
                            {
                                "example_id": "9a97ee07-41ee-4660-9d28-062e6673ac09",
                                "sense_id": "5f9eef5b-6f42-3353-bf96-73887ab9c286",
                                "text": "„Sensorisch hatte sich die Bühne sogar bis in die Geruchszone vorgearbeitet, wo heftigster Cannabisduft für die atmosphärisch intensivsten Eindrücke des Abends sorgte.“"
                            },
                            {
                                "example_id": "d65b67ee-a717-43c4-9556-854c17582ec9",
                                "sense_id": "5f9eef5b-6f42-3353-bf96-73887ab9c286",
                                "text": "„Eine Orientierungsfunktion kommt der Nase in der Stadt nur noch sehr bedingt zu, sieht man einmal von jenen größflächigen Geruchszonen ab, die sich aus der naturräumlichen Gliederung des Stadtgebietes ergeben, wie den Wienerwald oder die Augebiete der Donau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
