                "senses": [
                    {
                        "sense_id": "7bd666ec-2acb-3479-8672-ed12d78869ef",
                        "entry_id": "2d44668c-b646-3831-9ead-6416f6a2076e",
                        "glosses": [
                            "Stimmfärbung, in der Kommandos erteilt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c582fe-9a20-4465-be5d-fdd64411c636",
                                "sense_id": "7bd666ec-2acb-3479-8672-ed12d78869ef",
                                "text": "„Mit der Ausweitung der Armee waren immer mehr junge und unerfahrene britische Offiziere nach Indien gekommen, die ihre Autorität meist nur durch einen schneidigen Kommandoton wahren konnten.“"
                            },
                            {
                                "example_id": "711f70fe-c242-436c-b948-4f5f00f07416",
                                "sense_id": "7bd666ec-2acb-3479-8672-ed12d78869ef",
                                "text": "„Trotz ihrer glasigen Augen hatte ihre Stimme einen unverkennbaren Kommandoton.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
