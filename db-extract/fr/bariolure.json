                "senses": [
                    {
                        "sense_id": "794049b5-43ed-3a10-a07c-097855180eee",
                        "entry_id": "a689985c-364f-35cf-9046-5b10d362db49",
                        "glosses": [
                            "Tache de couleur sur un bariolage."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5d632af6-94a4-487c-8791-6308d474fa10",
                                "sense_id": "794049b5-43ed-3a10-a07c-097855180eee",
                                "text": "C’était une mer montante de teintes neutres, de tons sourds de laine, les gris fer, les gris jaunes, les gris bleus, où éclataient çà et là des bariolures écossaises."
                            },
                            {
                                "example_id": "ffd31a18-80ed-4bbb-be48-4c2103277bc6",
                                "sense_id": "794049b5-43ed-3a10-a07c-097855180eee",
                                "text": "Prés, bois, halliers, friches, landes, jachères, ravins, guérets et marais, à perte de vue, étalaient leur bariolure sous les nuages."
                            },
                            {
                                "example_id": "caf44a11-1461-41ac-9708-66c22ee8015e",
                                "sense_id": "794049b5-43ed-3a10-a07c-097855180eee",
                                "text": "Je revois aussi les charmantes bariolures de « Malborough » puis « Jean de la lune », ses drôleries, sa bonne grâce, les facilités toutes fraîches de Marcel Achard, sa partition sur deux notes pour trombone et mandoline."
                            }
                        ]
                    }
                ],
