                                                "example_id": "ea4a9b24-c014-4ecf-a088-418ced4eee18",
                                                "sense_id": "6f4c77b8-5c32-3d25-8125-511fd191a493",
                                                "text": "Les médecins de campagne pouvaient passer vingt-quatre heures sans dormir en allant accoucher les femmes chez elles dans les rangs éloignés."
                                            }
                                        ]
