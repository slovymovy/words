                "senses": [
                    {
                        "sense_id": "d06489af-7241-3d07-800b-336fcdd76796",
                        "entry_id": "4174ec3f-66f6-3df2-aeaf-3c539f1c740a",
                        "glosses": [
                            "cell phone的另一種寫法。"
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "755fd335-02df-479f-8850-cc57067b796c",
                                "sense_id": "d06489af-7241-3d07-800b-336fcdd76796",
                                "text": "Six years later, the Transportation Department advises drivers to avoid cellphones except in emergencies.",
                                "translation": "六年之后，交通部门建议司机除紧急情况外，避免使用手机。"
                            },
                            {
                                "example_id": "a4b4b0e1-01ba-4d77-b24c-e31200623c11",
                                "sense_id": "d06489af-7241-3d07-800b-336fcdd76796",
                                "text": "Nakasone added that the NSA does not purchase cellphone location data of Americans or location data generated by automotive infotainment systems in the United States.",
                                "translation": "中曾根补充说，美国国家安全局不会购买美国公民的手机位置数据，也不会购买美国汽车信息娱乐系统生成的位置数据。"
                            }
                        ]
                    }
                ],
