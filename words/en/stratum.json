{
    "word_family": [
        "stratify",
        "stratification",
        "stratigraphy",
        "stratosphere"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f55a1c3-2867-3e34-9b6c-90915f0d1420",
                    "sense_definition": "A class of society composed of people with similar social, cultural, or economic status.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This policy mainly benefits the wealthiest <w>stratum</w> of society.",
                            "target_lang_translations": {
                                "ru": "Эта политика в первую очередь приносит пользу самому богатому <w>слою</w> общества."
                            }
                        },
                        {
                            "text": "People from every social <w>stratum</w> attended the community meeting.",
                            "target_lang_translations": {
                                "ru": "На собрании общины присутствовали люди из всех социальных <w>слоев</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "layer",
                        "tier"
                    ],
                    "common_phrases": [
                        "social stratum",
                        "wealthiest stratum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Класс общества, состоящий из людей с похожим социальным, культурным или экономическим статусом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слой",
                                "target_lang_sense_clarification": "общества, населения"
                            },
                            {
                                "target_lang_word": "страта",
                                "target_lang_sense_clarification": "социологический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d8e5342-2812-31df-b56c-024140fac72d",
                    "sense_definition": "A layer of sedimentary rock having approximately the same composition throughout.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "geological_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geologists discovered a thick <w>stratum</w> of limestone beneath the clay.",
                            "target_lang_translations": {
                                "ru": "Геологи обнаружили под глиной мощный <w>пласт</w> известняка."
                            }
                        },
                        {
                            "text": "Each rock <w>stratum</w> contains fossils from a different geological era.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>слой</w> породы содержит окаменелости разных геологических эпох."
                            }
                        }
                    ],
                    "synonyms": [
                        "layer",
                        "bed"
                    ],
                    "common_phrases": [
                        "rock stratum",
                        "geological stratum"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Often used in the plural form 'strata'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пласт осадочной породы, имеющий примерно одинаковый состав по всей толщине."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пласт",
                                "target_lang_sense_clarification": "геологический слой породы"
                            },
                            {
                                "target_lang_word": "слой",
                                "target_lang_sense_clarification": "осадочных пород"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b3fb95e-9b9d-3509-91db-30e4c025f22c",
                    "sense_definition": "One of several parallel horizontal layers of material arranged one on top of another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archaeologists carefully excavated each <w>stratum</w> of soil to find ancient artifacts.",
                            "target_lang_translations": {
                                "ru": "Археологи тщательно раскапывали каждый <w>слой</w> почвы в поисках древних артефактов."
                            }
                        },
                        {
                            "text": "A thin <w>stratum</w> of dust had settled over the old books in the attic.",
                            "target_lang_translations": {
                                "ru": "Тонкий <w>слой</w> пыли осел на старых книгах на чердаке."
                            }
                        }
                    ],
                    "synonyms": [
                        "layer",
                        "tier"
                    ],
                    "common_phrases": [
                        "stratum of soil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из нескольких параллельных горизонтальных слоев материала, расположенных один поверх другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слой",
                                "target_lang_sense_clarification": "материала, почвы"
                            },
                            {
                                "target_lang_word": "пласт",
                                "target_lang_sense_clarification": "горизонтальный слой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03e6aea4-930e-3acb-be26-d8bd5a7f3260",
                    "sense_definition": "A layer of tissue.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biological_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The epidermis consists of several layers, including the outermost <w>stratum</w> corneum.",
                            "target_lang_translations": {
                                "ru": "Эпидермис состоит из нескольких слоев, включая самый внешний роговой <w>слой</w>."
                            }
                        },
                        {
                            "text": "The microscope revealed a distinct <w>stratum</w> of cells beneath the surface.",
                            "target_lang_translations": {
                                "ru": "Под микроскопом обнаружился отчетливый <w>слой</w> клеток под поверхностью."
                            }
                        }
                    ],
                    "synonyms": [
                        "layer"
                    ],
                    "common_phrases": [
                        "cellular stratum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слой биологической ткани."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слой",
                                "target_lang_sense_clarification": "эпидермиса, клеток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ac4be85-b02c-3a58-91c5-a5044c42a8bd",
                    "sense_definition": "A layer of vegetation, usually of similar height.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ecological_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The canopy forms the highest vegetation <w>stratum</w> in the rainforest.",
                            "target_lang_translations": {
                                "ru": "Полог леса образует самый верхний растительный <w>ярус</w> в тропическом лесу."
                            }
                        },
                        {
                            "text": "Different bird species nest in each <w>stratum</w> of the forest.",
                            "target_lang_translations": {
                                "ru": "Различные виды птиц гнездятся в каждом <w>ярусе</w> леса."
                            }
                        }
                    ],
                    "synonyms": [
                        "layer"
                    ],
                    "common_phrases": [
                        "vegetation stratum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ярус растительности, обычно близкой по высоте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ярус",
                                "target_lang_sense_clarification": "растительности, леса"
                            },
                            {
                                "target_lang_word": "слой",
                                "target_lang_sense_clarification": "растительного покрова"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "065582c9-4255-3f9c-870c-84da1c8d1b48",
                    "sense_definition": "Any of the regions of the atmosphere, such as the stratosphere, that occur as layers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "atmospheric_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather balloon ascended into a higher <w>stratum</w> of the atmosphere.",
                            "target_lang_translations": {
                                "ru": "Метеозонд поднялся в более высокий <w>слой</w> атмосферы."
                            }
                        },
                        {
                            "text": "Winds are much stronger in this particular atmospheric <w>stratum</w>.",
                            "target_lang_translations": {
                                "ru": "В этом конкретном атмосферном <w>слое</w> ветры гораздо сильнее."
                            }
                        }
                    ],
                    "synonyms": [
                        "layer"
                    ],
                    "common_phrases": [
                        "atmospheric stratum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая из областей атмосферы, расположенных в виде слоев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слой",
                                "target_lang_sense_clarification": "атмосферы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f532ea9d-d75b-3988-a0f4-da94e662938f",
                    "sense_definition": "A historical layer of a language.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistic_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Linguists analyzed the Celtic <w>stratum</w> in modern English place names.",
                            "target_lang_translations": {
                                "ru": "Лингвисты проанализировали кельтский <w>пласт</w> в современных английских топонимах."
                            }
                        },
                        {
                            "text": "This dialect preserves an older linguistic <w>stratum</w> that has disappeared elsewhere.",
                            "target_lang_translations": {
                                "ru": "Этот диалект сохраняет более старый языковой <w>пласт</w>, который исчез в других местах."
                            }
                        }
                    ],
                    "synonyms": [
                        "layer"
                    ],
                    "common_phrases": [
                        "linguistic stratum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исторический пласт языка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пласт",
                                "target_lang_sense_clarification": "лингвистический, исторический"
                            },
                            {
                                "target_lang_word": "субстрат",
                                "target_lang_sense_clarification": "языковой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1d828ab-109c-3481-b2a0-0730fd810055",
                    "sense_definition": "The level of accuracy of a computer's clock, relative to others on the network.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "network_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A primary time server is designated as a <w>stratum</w> 1 server.",
                            "target_lang_translations": {
                                "ru": "Первичный сервер времени обозначается как сервер первого <w>уровня</w>."
                            }
                        },
                        {
                            "text": "The client synchronized its clock with a reliable <w>stratum</w> 2 source.",
                            "target_lang_translations": {
                                "ru": "Клиент синхронизировал свои часы с надежным источником второго <w>уровня</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stratum level"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уровень точности компьютерных часов по отношению к другим часам в сети."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уровень",
                                "target_lang_sense_clarification": "точности NTP"
                            },
                            {
                                "target_lang_word": "стратум",
                                "target_lang_sense_clarification": "сетевой протокол времени"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}