                    },
                    {
                        "translation_id": "cd7b7e67-4ae8-4a10-a4e2-15bbfbd7668f",
                        "source_entry_id": "c4c87acd-50e4-3eb5-902d-77ccb3ad4234",
                        "source_sense_id": "df135637-2dd7-3607-bd46-814ae75ea5cb",
                        "target_lang_word": "nachweisbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachweisbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b4942ed-3813-3fc8-b48e-fc54a2ac931d",
                                        "entry_id": "f535162b-def4-3007-9559-a4bccd427be2",
                                        "glosses": [
                                            "sich nachweisen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd3ec782-7df3-43be-b478-89c22529fd5c",
                                                "sense_id": "4b4942ed-3813-3fc8-b48e-fc54a2ac931d",
                                                "text": "„Die im Raum der Prignitz nachweisbaren Völker scheinen wenigstens zeitweise mit den Lutizen in einem politischen oder kultischen Verband gestanden zu haben, worauf vereinzelte Nachrichten deuten.“"
                                            },
                                            {
                                                "example_id": "7dc002c5-22c5-48b3-8282-985de4c98564",
                                                "sense_id": "4b4942ed-3813-3fc8-b48e-fc54a2ac931d",
                                                "text": "„Ein weiterer hochrangiger Prokurator für besondere Aufgaben ist in dieser Zeit nachweisbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
