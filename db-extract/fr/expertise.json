                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff470ebe-bfa7-3584-9e99-8d46f5867877",
                        "entry_id": "6e5a6541-4de4-3742-83bb-9fc79997c2fe",
                        "glosses": [
                            "Examen, estimation d’un bien faits par un expert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9baa653a-63af-4599-b537-4201681f8c79",
                                "sense_id": "ff470ebe-bfa7-3584-9e99-8d46f5867877",
                                "text": "Le 27 juin 2000, au nom de l'Office, l’intimé Samson adresse à Mᵐᵉ Claire V. de la Durantaye, rectrice à l'U.Q.T.R., une lettre (pièce R-1) posant en ces termes la problématique liée aux expertises biomédicales prescrites par des chiropraticiens : […]."
                            },
                            {
                                "example_id": "f867ca31-cb85-4cce-b4fc-3262a5538a66",
                                "sense_id": "ff470ebe-bfa7-3584-9e99-8d46f5867877",
                                "text": "L’expertise a établi que ce tableau était un faux."
                            },
                            {
                                "example_id": "08bc6398-243b-4e90-9d67-be122cff7bb2",
                                "sense_id": "ff470ebe-bfa7-3584-9e99-8d46f5867877",
                                "text": "On a nommé des architectes pour faire l’expertise des réparations de ce bâtiment."
                            },
                            {
                                "example_id": "023afcc1-8ec9-436c-b73d-3810c39be8ea",
                                "sense_id": "ff470ebe-bfa7-3584-9e99-8d46f5867877",
                                "text": "Frais d’expertise."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a0bb217-8f6e-39ed-b273-5fcdae8d81a4",
                        "entry_id": "6e5a6541-4de4-3742-83bb-9fc79997c2fe",
                        "glosses": [
                            "Procès-verbal, rapport des experts."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b5d454db-a0eb-42f0-b766-14fd5ada31b2",
                                "sense_id": "6a0bb217-8f6e-39ed-b273-5fcdae8d81a4",
                                "text": "Après quatre vacations, ils ont clos, ils ont déposé leur expertise."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7da988a-e5bb-3ac1-bb64-abab349746f9",
                        "entry_id": "6e5a6541-4de4-3742-83bb-9fc79997c2fe",
                        "glosses": [
                            "Compétence, savoir-faire, qualité d’une personne experte"
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "a377493e-dee7-4241-b2f7-99ae0cd1f96c",
                                "sense_id": "b7da988a-e5bb-3ac1-bb64-abab349746f9",
                                "text": "Cet argent sera prélevé sur le compte que j'ai ouvert pour Hector afin qu'il puisse ouvrir un cabinet quand Sarah prendra les commandes du cabinet d’expertise comptable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9395936c-4fb1-40fb-8c88-6bb5f72710a1",
                        "source_entry_id": "6e5a6541-4de4-3742-83bb-9fc79997c2fe",
                        "target_lang_word": "expertise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expertise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f311914-04b3-3b6d-88e4-be2c3656583a",
                                        "entry_id": "ddf85587-62f9-3bdc-9635-1129e2bf826b",
                                        "glosses": [
                                            "Great skill or knowledge in a particular field or hobby."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb3588e1-9cb7-4066-a838-5d7a5f439856",
                                                "sense_id": "7f311914-04b3-3b6d-88e4-be2c3656583a",
                                                "text": "The scientist has expertise in the field of nuclear fusion."
                                            },
                                            {
                                                "example_id": "30102674-40bc-4984-bed0-da42f31bb88d",
                                                "sense_id": "7f311914-04b3-3b6d-88e4-be2c3656583a",
                                                "text": "He spoke of Scotland's hydroelectric projects in Africa, local expertise shared with the world's poor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e8364a-5033-37d9-992e-43e8dccfb53c",
                                        "entry_id": "ddf85587-62f9-3bdc-9635-1129e2bf826b",
                                        "glosses": [
                                            "Advice, or opinion, of an expert."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "expertise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd04e261-693d-39e6-832e-af11254c9b9d",
                                        "entry_id": "b36247dd-27aa-3a33-b204-7b32d9202072",
                                        "glosses": [
                                            "To supply with expert knowledge or advice."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efa1b9e-4425-4802-9130-3cd2d8132125",
                                                "sense_id": "dd04e261-693d-39e6-832e-af11254c9b9d",
                                                "text": "Since 1979, we have developed a method for expertising the design of the processes and improving them."
                                            },
                                            {
                                                "example_id": "194c4253-a0b4-41f6-ba81-64bf17e31296",
                                                "sense_id": "dd04e261-693d-39e6-832e-af11254c9b9d",
                                                "text": "Including a plurality of different expertise in the decision-making processes corresponds to expertising the democratic procedures."
                                            },
                                            {
                                                "example_id": "326b8146-d7c9-4040-a40e-2f4e65d14bda",
                                                "sense_id": "dd04e261-693d-39e6-832e-af11254c9b9d",
                                                "text": "If experts shall lose their expertise, wherewith shall they be expertised? The fact that only the rare economists can be entrusted with economics is not reason to discard economics, but to go and find the rare men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
