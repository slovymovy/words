                        "glosses": [
                            "река в России"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c872bc99-8889-4dc6-b9bc-de79afd646ed",
                                "sense_id": "95f89316-0629-34b6-96ed-de67b9a9a810",
                                "text": "Прорва — одна из многочисленных рек, протекающих по территории России."
                            }
                        ]
