                    },
                    {
                        "translation_id": "4cf5876b-a8d6-437f-8d88-1b914acb0929",
                        "source_entry_id": "71122db2-8fbc-3d19-a00b-73d763a88ba0",
                        "source_sense_id": "6b447b0f-b7cf-396d-864d-08e069856376",
                        "source_sense_description": "Prüfung, mit der man einen Führerschein erwirbt",
                        "target_lang_word": "permis de conduire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "permis de conduire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dda07788-fb1e-3c3e-931e-5c1b4959575d",
                                        "entry_id": "ece4d5da-9f3b-3c09-acc1-37dd3394f990",
                                        "glosses": [
                                            "Pièce d’identité qui autorise à conduire certains véhicules à moteurs."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e948c65-12a5-4980-a368-de81a4fe3bcc",
                                                "sense_id": "dda07788-fb1e-3c3e-931e-5c1b4959575d",
                                                "text": "Audrey ayant le permis de conduire et une voiture, nous allions au cinéma ou sortions en boîte à La Scala, une discothèque parisienne. C'était la belle vie."
                                            },
                                            {
                                                "example_id": "fbe2d2e4-9e86-473e-bdc8-c4b999d28007",
                                                "sense_id": "dda07788-fb1e-3c3e-931e-5c1b4959575d",
                                                "text": "Le permis de conduire n'a pas la même valeur que la carte nationale d'identité ou le passeport. En effet, la carte nationale d'identité et le passeport sont les seuls documents qui certifient à la fois l'identité et la nationalité de leur titulaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "540b61fb-d77f-3e1b-9316-9d0f8a4f209c",
                                        "entry_id": "ece4d5da-9f3b-3c09-acc1-37dd3394f990",
                                        "glosses": [
                                            "Pièce d’identité qui autorise à conduire certains véhicules à moteurs.",
                                            "Autorisation légale de conduire et système informatisé de décompte des points associé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a48bab20-8337-44ef-a18a-c4b9242c0791",
                                                "sense_id": "540b61fb-d77f-3e1b-9316-9d0f8a4f209c",
                                                "text": "Les auteurs présumés d’accident mortel ont des comportements plus infractionnistes que la moyenne des conducteurs français. Ainsi, près de la moitié des auteurs présumés d’accident mortel (47 %) n’ont plus leurs 12 points sur leur permis de conduire contre 21 % de l’ensemble des titulaires du permis de conduire."
                                            },
                                            {
                                                "example_id": "2955c134-ea88-4f30-a35b-a422eccca32d",
                                                "sense_id": "540b61fb-d77f-3e1b-9316-9d0f8a4f209c",
                                                "text": "En 2016, 13.179.802 points ont été retirés sur les permis de conduire français. Les hommes sont responsables de 8.850.556 points retirés et représentent donc plus des deux tiers des retraits de points (67,15%)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50e96240-24ea-309b-b8c4-0c6a38ce625c",
                                        "entry_id": "ece4d5da-9f3b-3c09-acc1-37dd3394f990",
                                        "glosses": [
                                            "Examen qui permet d’obtenir ce document administratif."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f5ba251-a6e0-4ab0-9dd7-5e52dae13581",
                                                "sense_id": "50e96240-24ea-309b-b8c4-0c6a38ce625c",
                                                "text": "Une prof de français passait le permis de conduire avec comme examinateur le père d'un élève qu'elle venait de faire redoubler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
