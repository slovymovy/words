        "fr-extract.jsonl": [
            {
                "entry_id": "d8c827ec-63dd-36f5-ae42-ecd8689dbe1d",
                "word": "divinement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "781afbd0-13f0-39fe-9c66-de4d95778675",
                        "entry_id": "d8c827ec-63dd-36f5-ae42-ecd8689dbe1d",
                        "glosses": [
                            "De manière divine, par la vertu de Dieu, d’un dieu ou d’une déesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c08febdf-afdd-4562-af02-14419d063c9d",
                                "sense_id": "781afbd0-13f0-39fe-9c66-de4d95778675",
                                "text": "Noé, ayant été divinement averti de ce qui devait arriver […]."
                            },
                            {
                                "example_id": "32f2dd9e-d3f0-4e6f-a99b-b7cc16189332",
                                "sense_id": "781afbd0-13f0-39fe-9c66-de4d95778675",
                                "text": "Dors, la lune bienfaisante est entrée pour voiler ton corps allongé d’un drap d’argent, et sur ton repos, sa face bénie rayonne divinement."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8e7886d-b626-3df7-be20-7079527fee77",
                        "entry_id": "d8c827ec-63dd-36f5-ae42-ecd8689dbe1d",
                        "glosses": [
                            "Excellemment, parfaitement."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f01fe1fb-fb3d-45d5-bcec-687a88fd880b",
                                "sense_id": "e8e7886d-b626-3df7-be20-7079527fee77",
                                "text": "La simplicité de cette rencontre m’a divinement troublé."
                            },
                            {
                                "example_id": "6cb4888d-6dcd-4297-80fc-0bc3c5396bfb",
                                "sense_id": "e8e7886d-b626-3df7-be20-7079527fee77",
                                "text": "Tout est meublé divinement, tout est magnifique."
                            },
                            {
                                "example_id": "91bc6db5-171e-4bfa-a8f1-24c9faa1c34f",
                                "sense_id": "e8e7886d-b626-3df7-be20-7079527fee77",
                                "text": "De sa grande cuisine désordonnée, tandis qu’elle préparait un cottage pie ou une salade de poires au Stilton, Arabella chantait divinement faux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3131d6b2-f60e-410d-a4eb-050ad77f6d4d",
                        "source_entry_id": "d8c827ec-63dd-36f5-ae42-ecd8689dbe1d",
