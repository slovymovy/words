                    },
                    {
                        "translation_id": "daa4689e-22fa-45fe-9a3c-d73b82a877e7",
                        "source_entry_id": "d956ca24-64d9-35cc-8670-38045f3eca15",
                        "source_sense_description": "the Christian world",
                        "target_lang_word": "chrétienté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chrétienté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05cd6640-ccf6-38cb-b4c5-1a4dec0a92a2",
                                        "entry_id": "0a144857-3f14-3cc8-a8d3-fc508e3dcd28",
                                        "glosses": [
                                            "Ensemble des nations chrétiennes, tous les pays où domine la religion chrétienne."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dde2e9b-b02a-4ea3-b220-96e4ee1f12e9",
                                                "sense_id": "05cd6640-ccf6-38cb-b4c5-1a4dec0a92a2",
                                                "text": "[…] et, si j’avais Ivanhoé d’un côté pour me donner de sages conseils […], et toi de l’autre pour me mener par la ruse […], je serais le roi le moins libre de la chrétienté."
                                            },
                                            {
                                                "example_id": "37b55be3-ac36-4300-bd5f-7c4748bef0d9",
                                                "sense_id": "05cd6640-ccf6-38cb-b4c5-1a4dec0a92a2",
                                                "text": "C’était un plastron en flanelle rouge, l’un de ces talismans quasi hygiéniques qui, avec les pilules et les spécialités pharmaceutiques, remplacent, chez les peuples protestants de la chrétienté, les images et les reliques miraculeuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed0fce18-d0b9-360e-a9b9-412de344f4ea",
                                        "entry_id": "0a144857-3f14-3cc8-a8d3-fc508e3dcd28",
                                        "glosses": [
                                            "Communautés chrétiennes dans les pays de l’Orient."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "109daf38-c752-4379-917e-f2ba31921109",
                                                "sense_id": "ed0fce18-d0b9-360e-a9b9-412de344f4ea",
                                                "text": "Plusieurs chrétientés furent établies dans cette province de Chine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3b1e714-eab6-4275-9b09-1131b4a39b9d",
                        "source_entry_id": "d956ca24-64d9-35cc-8670-38045f3eca15",
                        "source_sense_description": "the Christian world",
                        "target_lang_word": "Christenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbe91171-9c91-3483-80db-319098b75aa3",
                                        "entry_id": "2cecdc68-1c6f-33f9-9d64-6e23833e67bc",
                                        "glosses": [
                                            "Gesamtheit aller Christen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b178870a-ef5d-485d-8c6a-fb3d28e8780f",
                                                "sense_id": "fbe91171-9c91-3483-80db-319098b75aa3",
                                                "text": "„Auf dem Gelände der kaiserlichen Gardetruppen, deren Kaserne er abzureißen befahl, ließ Konstantin die Lateranbasilika errichten, die sich im Laufe der Jahrhunderte als Mittelpunkt der westlichen Christenheit behaupten sollte.“"
                                            },
                                            {
                                                "example_id": "e9b657b4-d715-4e0f-8b2f-7b85471ce553",
                                                "sense_id": "fbe91171-9c91-3483-80db-319098b75aa3",
                                                "text": "„Viele Männer waren zuvor schon auf den Scheiterhaufen der Christenheit ein Opfer der Flammen geworden.“"
                                            },
                                            {
                                                "example_id": "25afac09-1cbf-48e8-9d60-2dbf489a9cfc",
                                                "sense_id": "fbe91171-9c91-3483-80db-319098b75aa3",
                                                "text": "„Das Rom der Päpste, Sehnsucht und Ziel unzähliger Pilger, war unter den großen Päpsten des Hochmittelalters nicht mehr nur religiöser Mittelpunkt der abendländischen Christenheit, sondern auch geistlich-weltliche Metropole.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "572467c4-90e1-45f8-9559-9afa6dd597a6",
                        "source_entry_id": "d956ca24-64d9-35cc-8670-38045f3eca15",
                        "source_sense_description": "the Christian world",
                        "target_lang_word": "Christentum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christentum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef27450e-d060-327e-8539-0f29e67d975d",
                                        "entry_id": "8b2694b0-58e2-3e58-9bb8-d5868dad8b37",
                                        "glosses": [
                                            "größte monotheistische Weltreligion, welche auf Basis der Lehren des Jesus von Nazareth aus dem Judentum vor etwa zwei Jahrtausenden hervorgegangen ist"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78b08551-b69c-4565-be03-0e46858f06e3",
                                                "sense_id": "ef27450e-d060-327e-8539-0f29e67d975d",
                                                "text": "Mit rund 2,26 Milliarden Anhängern ist das Christentum vor dem Islam (rund 1,57 Milliarden) und dem Hinduismus (rund 900 Millionen) die am meisten verbreitete Religion der Erde."
                                            },
                                            {
                                                "example_id": "e091c9ba-ae6b-4bcf-a0b2-22b3c6ad4af3",
                                                "sense_id": "ef27450e-d060-327e-8539-0f29e67d975d",
                                                "text": "„Nur wenige Jahre nach Jesu Tod wurde der Pharisäer Paulus zum Christentum bekehrt.“"
                                            },
                                            {
                                                "example_id": "5ab04d04-605f-455e-a083-e0fb77c8b7f8",
                                                "sense_id": "ef27450e-d060-327e-8539-0f29e67d975d",
                                                "text": "„Den Neukelten beziehungsweise Neuheiden und vor allem den neuen Druiden geht es um eine Wiederbelebung keltischer Tradition, vor allem der keltischen Religion nach dem Motto: Nicht das Christentum, sondern das Heidentum ist die für Europa adäquate Religion.“"
                                            },
                                            {
                                                "example_id": "896cb30d-9bdf-4ebc-be8e-0fdaa29551ec",
                                                "sense_id": "ef27450e-d060-327e-8539-0f29e67d975d",
                                                "text": "„Bald verlieren sich die Spuren der wikingischen Kultur oder gehen in einer neuen auf: Skandinavische und slawische Elemente vermischen sich unter starkem Einfluss des Byzantinischen Reiches, von dem die Rus gegen Ende des 10. Jahrhunderts das orthodoxe Christentum übernehmen.“"
                                            },
                                            {
                                                "example_id": "0be5e888-d2ab-4727-96bb-98fb3819b3d3",
                                                "sense_id": "ef27450e-d060-327e-8539-0f29e67d975d",
                                                "text": "„In einem Interview gefragt, ob das Christentum spielfeindlich sei, bejahte der Schweizer Philosoph Hans Saner die Frage ausdrücklich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "371d8d7b-f1d6-3117-b785-bab218c569b1",
                                        "entry_id": "8b2694b0-58e2-3e58-9bb8-d5868dad8b37",
                                        "glosses": [
                                            "eine spezifische Auffassung oder Art von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c37879d-daf0-4c29-b6c3-69444329dd0b",
                                                "sense_id": "371d8d7b-f1d6-3117-b785-bab218c569b1",
                                                "text": "„Daher gestaltet sich jeder sein eigenes Christentum – Spinoza und Leibniz, Locke und Rossseau, Kant und Fichte, Hegel und Schopenhauer –, und in der Gesamtheit dieser Fassungen spiegelt sich eigentümlich die geistige Bewegung der Neuzeit.“"
                                            },
                                            {
                                                "example_id": "0abfbd39-4284-4d1b-ac9e-011d693982e2",
                                                "sense_id": "371d8d7b-f1d6-3117-b785-bab218c569b1",
                                                "text": "„Das Einheitsbewusstsein der frühen Christentümer und der Vielfalt der kanonischen und der frühchristlichen Interpretationen des christlichen Überzeugungssystems kann sowohl formal anhand ihrer Selbstdefinition und ihrer Berufung auf einen Gott, der mit dem Namen Jesu Christi verbunden ist, als auch inhaltlich anhand einer gemeinsamen theologischen Anthropologie, die die Verwandlung der Subjektivität der individuellen Person in ein selbstreflexives und verantwortliches ‚Ich‘, das Gott, sich selbst und den Anderen als ‚Du‘ unabhängig von seinen Eigenschaften anerkennt und liebt, bezeugt, vom Historiker des Frühchristentums als blosses Faktum festgestellt und wahrgenommen werden.“"
                                            },
                                            {
                                                "example_id": "1ae9389e-3b26-4b00-a69a-2aae5be52f71",
                                                "sense_id": "371d8d7b-f1d6-3117-b785-bab218c569b1",
                                                "text": "„Die kulturell verorteten Christentümer sind plurale Formulierungen, die je einen universalen Anspruch zur Sprache bringen.“"
                                            },
                                            {
                                                "example_id": "0f50b04b-ef46-4b59-b573-dbd02822ba8e",
                                                "sense_id": "371d8d7b-f1d6-3117-b785-bab218c569b1",
                                                "text": "„Zum frühen Selbstverständnis der Interkulturellen Theologie gehört – viertens –, dass primär der christliche Glaube beziehungsweise die kirchlich verfassten Christentümer den Ausgangs- und Zielpunkt ihrer Arbeit darstellen.“"
                                            },
                                            {
                                                "example_id": "0c357ff4-d1e1-4541-8db7-b187b2b0197a",
                                                "sense_id": "371d8d7b-f1d6-3117-b785-bab218c569b1",
                                                "text": "„Für einige Wissenschaftler stellt sich die Ausbreitung evangelikaler Bewegungen weltweit als die unidirektionale Verbreitung einer spezifisch amerikanischen Form gegenwärtiger Christentümer dar.“"
                                            },
                                            {
                                                "example_id": "2a4a1977-e27b-401f-88e8-a4663522923a",
                                                "sense_id": "371d8d7b-f1d6-3117-b785-bab218c569b1",
                                                "text": "„Das eine Christentum gibt es nicht, eher schon verschiedene Christentümer, auch verschiedene evangelische Christentümer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
