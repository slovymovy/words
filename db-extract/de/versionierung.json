                ],
                "senses": [
                    {
                        "sense_id": "93167700-9073-3613-9a57-9ebf109e48b8",
                        "entry_id": "6032f06c-6e4b-3f9e-b6a2-72b87d4ac91c",
                        "glosses": [
                            "Erfassen von Änderungen an Dokumenten oder Dateien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5960cf10-f331-43f3-9cb3-073fb2b06388",
                                "sense_id": "93167700-9073-3613-9a57-9ebf109e48b8",
                                "text": "„Die zugehörige Disziplin ist die Versionierung. Die Version ist eine eindeutige Information, um unterschiedliche Stände (Versionsstände) eines Konfigurationselements, das jeweils ein einzelnes Entwicklungsartefakt ist, zu unterscheiden.“"
                            },
                            {
                                "example_id": "d8bb9b27-f54d-4316-bf76-cbaf735535b5",
                                "sense_id": "93167700-9073-3613-9a57-9ebf109e48b8",
                                "text": "„Über die Grenze des abspeichernden Mediums, der Datei, hinaus geht die Objekt-basierte Versionierung\"."
                            },
                            {
                                "example_id": "5854a949-c83b-4c8e-a7b1-6bce5500a732",
                                "sense_id": "93167700-9073-3613-9a57-9ebf109e48b8",
                                "text": "„Die Versionierung in einem Data Warehouse muß sich daher unter Umständen auch mit Ableitungsregeln befassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
