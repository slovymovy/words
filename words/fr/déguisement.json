            "pos": "noun",
            "senses": [
                {
                    "sense_id": "516f36dc-e848-38f8-8647-baede335c89d",
                    "sense_definition": "Vêtements ou accessoires que l'on porte pour changer son apparence ou pour s'amuser lors d'une fête.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "costume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour la fête d'Halloween, mon fils a choisi un <w>déguisement</w> de pirate très amusant."
                        },
                        {
                            "text": "Elle a confectionné elle-même son <w>déguisement</w> pour le défilé du carnaval de l'école."
                        }
                    ],
                    "synonyms": [
                        "costume",
                        "travestissement"
                    ],
                    "common_phrases": [
                        "déguisement de carnaval",
                        "porter un déguisement"
                    ]
                },
                {
                    "sense_id": "2ba83cf4-01a8-3750-a52c-e350f2b3a42b",
                    "sense_definition": "Action de se déguiser ou de modifier son apparence habituelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>déguisement</w> est une tradition indispensable et joyeuse pendant les célébrations du carnaval."
                        },
                        {
                            "text": "Cet acteur de théâtre excelle dans l'art du <w>déguisement</w> et modifie complètement son allure."
                        }
                    ],
                    "synonyms": [
                        "travestissement"
                    ],
                    "common_phrases": [
                        "art du déguisement"
                    ]
                },
                {
                    "sense_id": "b67cdc36-3e41-3671-ba99-9ac27196c0e6",
                    "sense_definition": "Fausse apparence ou artifice utilisé pour dissimuler la vérité ou ses véritables intentions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dissimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses manières affables n'étaient qu'un habile <w>déguisement</w> pour tromper la confiance de ses associés."
                        },
                        {
                            "text": "Le ministre a fini par exposer ses projets sans aucun <w>déguisement</w> devant la commission."
                        }
                    ],
                    "synonyms": [
                        "artifice",
                        "dissimulation",
                        "faux-semblant",
                        "feinte"
                    ],
                    "antonyms": [
