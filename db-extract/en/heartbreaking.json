                "senses": [
                    {
                        "sense_id": "406f5a47-7db9-34f6-a81b-e28f8ab2b720",
                        "entry_id": "6ed4e095-1186-3390-93ce-9037a6f68aa1",
                        "glosses": [
                            "That causes great grief, anguish or distress."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637ab69f-bb27-4793-a5b9-2bc77a607b21",
                                "sense_id": "406f5a47-7db9-34f6-a81b-e28f8ab2b720",
                                "text": "Things went well with the clearing on Friday, but by Saturday, February 3, a 70 m.p.h. blizzard set in, and against such heartbreaking conditions, although an effort was made with the plough to keep open the sections cleared on the previous day, ground was gradually lost, [...]."
                            },
                            {
                                "example_id": "53196218-3eab-4c5a-8e48-9d7eee28612d",
                                "sense_id": "406f5a47-7db9-34f6-a81b-e28f8ab2b720",
                                "text": "But even with these caveats, it remains a stunning and heartbreaking piece of cinema that strikes a particular chord with LGBTQ+ viewers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d42060ba-5f8f-4714-baea-2fb9d5929e13",
                        "source_entry_id": "6ed4e095-1186-3390-93ce-9037a6f68aa1",
                        "source_sense_id": "406f5a47-7db9-34f6-a81b-e28f8ab2b720",
