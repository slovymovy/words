                "senses": [
                    {
                        "sense_id": "b494a365-24b6-3353-8f6b-efddc971c582",
                        "entry_id": "43111a0e-2e3e-3355-8741-102fb5a1c5f1",
                        "glosses": [
                            "Aufenthaltsorte für Sportler, die intensiv ihren Sport üben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cad2cb48-fa79-41ac-bf20-f68dc3e7e817",
                                "sense_id": "b494a365-24b6-3353-8f6b-efddc971c582",
                                "text": "Zur Vorbereitung auf den Saisonstart trainierten alle Fußballer im vereinseigenen Trainingslager."
                            },
                            {
                                "example_id": "db15208b-c0a8-432d-a78b-839d8d936906",
                                "sense_id": "b494a365-24b6-3353-8f6b-efddc971c582",
                                "text": "„Ein Clown wie er kann im Trainingslager zur Plage werden, wenn seine Späße ranzig werden.“"
                            },
                            {
                                "example_id": "92e53d71-327c-488b-b7fe-fa0a1cfc21db",
                                "sense_id": "b494a365-24b6-3353-8f6b-efddc971c582",
                                "text": "„Nach Saisonende im April, wenn die große Urlaubszeit für Skiprofis beginnt, legt Shiffrin noch einmal los und absolviert ein vierwöchiges Trainingslager.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
