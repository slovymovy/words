                        "sense_id": "35695879-830e-3409-899c-95eaa6dedddf",
                        "entry_id": "1c5aacb6-5711-3707-ab4b-83c427eaaf39",
                        "glosses": [
                            "zanik lub zmniejszenie się tkanek lub narządów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b3ec1b-2a59-4505-9f76-5d22c61580fc",
                                "sense_id": "35695879-830e-3409-899c-95eaa6dedddf",
                                "text": "W patomorfologii atrofia zaliczana jest do zmian wstecznych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cd3c7897-ed34-38c6-8838-62bc63d8d5f1",
                        "entry_id": "1c5aacb6-5711-3707-ab4b-83c427eaaf39",
                        "glosses": [
                            "zanik wrażliwości"
                        ],
                        "tags": [
