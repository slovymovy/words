                "senses": [
                    {
                        "sense_id": "38bd51af-24a3-3202-94ce-e5ce4ef840a2",
                        "entry_id": "6cbbdb35-cdc9-39e9-bbf4-8e8e6e75f811",
                        "glosses": [
                            "Eröffnung von Abszessen, um dem Eiter einen Ausfluss zu verschaffen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "3692a082-e51c-4673-8f27-1ac55e09688b",
                                "sense_id": "38bd51af-24a3-3202-94ce-e5ce4ef840a2",
                                "text": "„Die Onkotomie geschehe am rechten Orte, da wo die Lage des Eiters die oberflächlichste, die Fluctuation die deutlichste ist, da wo bei der gewöhnlichen Stellung oder Lage des Körpers eine angelegte Oeffnung den Eiterausfluss am meisten begünstiget.“"
                            },
                            {
                                "example_id": "57bc06a0-d2c0-4898-b3f2-f37d32f1f266",
                                "sense_id": "38bd51af-24a3-3202-94ce-e5ce4ef840a2",
                                "text": "„Nach mehrfachen Onkotomien an der Sohle, der Seite und am Rücken des Fusses und nach drei Anfällen von lange dauerndem Wunderysipel und nachdem Patien durch Schmerzen, Mangel an Nahrung und Schlaf schon bedeutend herabgekommen war und selbst die Amputation des Fusses verlangt hatte, trat endlich nach 11monatlichem Leiden Heilung ein und wurde derselbe mit einem vollkommen brauchbaren Fusse in gut erholtem Zustande entlassen.“"
                            },
                            {
                                "example_id": "928dbad7-0919-4c32-8da9-3653b639ad71",
                                "sense_id": "38bd51af-24a3-3202-94ce-e5ce4ef840a2",
                                "text": "„So ging Patient ins Lazareth nach Schwetzingen über, wo zu wiederholten Malen Onkotomien am Oberschenkel vorgenommen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
