                "senses": [
                    {
                        "sense_id": "82154475-127a-396d-8413-f4f96e5351d5",
                        "entry_id": "855df1f4-6967-34c5-8f6b-da4af1a46b2f",
                        "glosses": [
                            "Provoquer la rétroversion d’un organe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "628c7a07-0e1a-4548-ad10-366bd882f568",
                                "sense_id": "82154475-127a-396d-8413-f4f96e5351d5",
                                "text": "Après quarante cinq degrés, l’angle de flexion (fermeture) permet au bassin de se rétroverser mais le mal est fait au niveau discal."
                            }
                        ]
                    },
                    {
                        "sense_id": "391c6637-7718-3f94-9c65-8445e32ac14d",
                        "entry_id": "855df1f4-6967-34c5-8f6b-da4af1a46b2f",
                        "glosses": [
                            "Retraduire dans sa langue d’origine un texte traduit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7c77aea-9636-4ec5-83c6-9b9f1dd603d9",
                                "sense_id": "391c6637-7718-3f94-9c65-8445e32ac14d",
                                "text": "Par curiosité, il avait donc tenté de rétroverser le texte grec de l’évangile de Marc en hébreu, pensant que la difficulté de l’exercice lui ferait peut-être reconsidérer ses premières impressions"
                            }
                        ]
                    }
