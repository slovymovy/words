                            {
                                "target_lang_word": "最高",
                                "target_lang_sense_clarification": "指在质量或程度上处于顶峰"
                            },
                            {
                                "target_lang_word": "极致",
                                "target_lang_sense_clarification": "指达到极限或顶峰的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af3f20de-3614-39d1-849c-ee69179ab99f",
                    "sense_definition": "Happening at the end of a process or series; final.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "final_result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ultimate</w> decision regarding the project lies with the board of directors.",
                            "target_lang_translations": {
                                "ru": "<w>Окончательное</w> решение по проекту остается за советом директоров.",
                                "tr": "Projeyle ilgili <w>nihai</w> karar yönetim kuruluna aittir.",
                                "zh": "关于该项目的<w>最终</w>决定权在于董事会。"
                            }
                        },
                        {
                            "text": "Our <w>ultimate</w> aim is to provide high-quality education to every child.",
                            "target_lang_translations": {
                                "ru": "Наша <w>конечная</w> цель — обеспечить качественное образование каждому ребенку.",
                                "tr": "Bizim <w>nihai</w> amacımız her çocuğa yüksek kaliteli eğitim sağlamaktır.",
                                "zh": "我们的<w>根本</w>目标是为每个孩子提供高质量的教育。"
                            }
                        }
                    ],
                    "synonyms": [
                        "final"
                    ],
                    "antonyms": [
                        "initial",
                        "original"
                    ],
                    "common_phrases": [
                        "ultimate decision",
                        "ultimate aim",
                        "ultimate outcome",
                        "ultimate consequence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий в конце процесса или серии событий; окончательный.",
                        "tr": "Bir sürecin veya serinin sonunda gerçekleşen; son.",
                        "zh": "发生在过程或系列事件的最后；最终的。"
