                        "entry_id": "b30023cb-4439-3055-8d46-ee7e3f8e99ca",
                        "glosses": [
                            "A village in a German-speaking area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c0f0206-2b33-4604-ade2-a0ac5f3f9461",
                                "sense_id": "b217008c-43a6-3f5a-82d2-5faac631bc39",
                                "text": "This dorf contained some forty dwellings."
                            },
                            {
                                "example_id": "c5a17308-11a0-41e4-9075-6573c6622ff7",
                                "sense_id": "b217008c-43a6-3f5a-82d2-5faac631bc39",
                                "text": "So, all things considered, we were not very cheerful at first; but when the mist got higher and the day got brighter, and particularly after we left the first little dorf."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3e21789f-6e40-36bc-b963-2eb5068563d4",
