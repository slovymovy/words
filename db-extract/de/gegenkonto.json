                        "entry_id": "cb5732c1-9dfc-3b99-b3d5-884bf8fd63d7",
                        "glosses": [
                            "zweite Hälfte der Buchung eines Geschäftsvorfalles (die aus dem Paar Buchung/Gegenbuchung besteht)"
                        ],
                        "tags": [
                            "Buchhaltung"
                        ],
                        "examples": [
                            {
                                "example_id": "f285d8b0-6a02-4de2-b113-49b9f4cbf689",
                                "sense_id": "ad6ca5d4-fdc5-3139-a559-08d1ed30b3b9",
                                "text": "Das Gegenkonto der Buchhaltung ist immer das Konto, bei dem sich auf der rechten Habenseite ein Zahlenwert ändert."
                            },
                            {
                                "example_id": "a037eb92-d3f6-46bb-a12b-a35d60753d2f",
                                "sense_id": "ad6ca5d4-fdc5-3139-a559-08d1ed30b3b9",
                                "text": "„Auf dem Gegenkonto (Kasse, Bank, Postbank, Verbindlichkeiten aus Lieferungen und Leistungen) wird die Zahlung mit dem Ist-Wert (Ist-Preis mal Menge) gegengebucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
