                "senses": [
                    {
                        "sense_id": "2a1d5b99-b3b8-3b0b-a956-5d21caaad2e6",
                        "entry_id": "3479605b-8045-3919-af9f-222ccc027a82",
                        "glosses": [
                            "Donner un caractère alémanique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa167c90-63f4-4297-b5e8-eaf098068f6e",
                                "sense_id": "2a1d5b99-b3b8-3b0b-a956-5d21caaad2e6",
                                "text": "On peut alémaniser ou helvétiser le Hochdeutsch comme on veut, personne ne va réagir, tout le monde comprend."
                            },
                            {
                                "example_id": "4a728c62-544d-4bf3-893e-ff0f60903afd",
                                "sense_id": "2a1d5b99-b3b8-3b0b-a956-5d21caaad2e6",
                                "text": "Quel est le con, abruti, insolent, bernois, centriste, vil et suffisant personnage qui s'est permis de m'alémaniser de la sorte?"
                            },
                            {
                                "example_id": "a8ae0ff3-083e-4286-a739-fa36731727bb",
                                "sense_id": "2a1d5b99-b3b8-3b0b-a956-5d21caaad2e6",
                                "text": "L'administration est en train de s'alémaniser."
                            }
                        ]
                    }
