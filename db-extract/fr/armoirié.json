                        "entry_id": "b2f1cb20-4272-344b-bceb-84f975109d01",
                        "glosses": [
                            "Variante de armorié pour qualifier un objet (reliure, papier officiel, vitrail, monument funéraire…) ou une représentation (peinture, sculpture, emblème…), qui intègre des armoiries, à titre de référence, de symbolisme ou de propriété (commanditaires, fondateurs, financeur, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aabd7d4f-7e6e-47f9-9600-0669f6240238",
                                "sense_id": "7102a966-43ca-3e65-9aac-1320ea4fb412",
                                "text": "Monsieur, disait dans la salle à manger le domestique d’Antonin à son maître, le tilbury est armoirié…"
                            },
                            {
                                "example_id": "5baa34aa-c5b4-4876-900e-2dddd75237b9",
                                "sense_id": "7102a966-43ca-3e65-9aac-1320ea4fb412",
                                "text": "Deux encensoirs avec leurs navettes, le tout d’argent et armoirié aux armes du Roy."
                            },
                            {
                                "example_id": "e923e43f-5e4f-4e37-b323-c9a349050e96",
                                "sense_id": "7102a966-43ca-3e65-9aac-1320ea4fb412",
                                "text": "Dans les bahuts brille la vaisselle d’argent armoiriée à côté de faïences et de porcelaines rares."
                            }
                        ]
                    }
