                    "sense_definition": "Poor; scanty; without money or success.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The business had a <w>thin</w> time during the economic recession.",
                            "target_lang_translations": {
                                "ru": "Бизнес переживал <w>тяжелые</w> времена во время экономического спада.",
