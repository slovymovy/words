                        ],
                        "form": "die Silbermanns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d4ba04c-cf57-38c6-adbc-c1016fbf180d",
                        "entry_id": "3a9b7bfc-1ff1-334d-baae-f2c47f83bd67",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d49d5bce-2728-4d1b-ac7f-54a78e94c869",
                                "sense_id": "2d4ba04c-cf57-38c6-adbc-c1016fbf180d",
                                "text": "Frau Silbermann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "db56b847-4f0b-4f18-8d39-0a70622e7264",
                                "sense_id": "2d4ba04c-cf57-38c6-adbc-c1016fbf180d",
                                "text": "Herr Silbermann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e2146f02-e181-482d-8e59-7ad0a6bb0b99",
                                "sense_id": "2d4ba04c-cf57-38c6-adbc-c1016fbf180d",
                                "text": "Die Silbermanns fahren heute ins Erzgebirge."
                            },
                            {
                                "example_id": "55156c4e-6b50-43b1-8081-2f843f309338",
                                "sense_id": "2d4ba04c-cf57-38c6-adbc-c1016fbf180d",
                                "text": "Der Silbermann trägt nie die Schals, die die Silbermann ihm strickt."
                            },
                            {
                                "example_id": "40a91e4b-c6b4-450b-8032-2405bbbaa2ad",
                                "sense_id": "2d4ba04c-cf57-38c6-adbc-c1016fbf180d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Silbermann kommt, geht der Herr Silbermann.“"
                            },
                            {
                                "example_id": "f0ae4927-891b-41ae-a246-a5fed3390e62",
                                "sense_id": "2d4ba04c-cf57-38c6-adbc-c1016fbf180d",
                                "text": "Silbermann kommt und geht."
                            },
                            {
                                "example_id": "abf62ca3-ec4f-411c-81e9-2fe438c4dbf8",
                                "sense_id": "2d4ba04c-cf57-38c6-adbc-c1016fbf180d",
                                "text": "Silbermanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
