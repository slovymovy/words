                "senses": [
                    {
                        "sense_id": "031042ee-b9f9-3ca7-bf54-a1a6b27e4f63",
                        "entry_id": "4221cf62-5bd4-3f42-8ef5-defc6b0ae5b2",
                        "glosses": [
                            "Herstellung von elektrischer Energie, die in einen elektrischen Strom umgewandelt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "561f34e1-c89f-4420-909c-62480983ce0e",
                                "sense_id": "031042ee-b9f9-3ca7-bf54-a1a6b27e4f63",
                                "text": "„Der Staat engagierte sich wie in der Gas-, so auch in der Elektrizitätserzeugung zunächst nicht.“"
                            },
                            {
                                "example_id": "92c36418-d082-40f9-bdf2-bd9f24a70c5d",
                                "sense_id": "031042ee-b9f9-3ca7-bf54-a1a6b27e4f63",
                                "text": "„In ähnlichem Sinne der Ausbreitung der Elektrizitätserzeugung wirkt die neue Ausgestaltung des Rhein.“"
                            },
                            {
                                "example_id": "3590cae0-58bf-4b3b-82d1-744cc6191b2e",
                                "sense_id": "031042ee-b9f9-3ca7-bf54-a1a6b27e4f63",
                                "text": "„Die CO2-Intensität des Energiesektors wird stark vom Grad der CO2-Freiheit der Elektrizitätserzeugung beeinflusst.“"
                            },
                            {
                                "example_id": "fb23eedd-97b7-4e6e-85ab-b936a39cd1d0",
                                "sense_id": "031042ee-b9f9-3ca7-bf54-a1a6b27e4f63",
                                "text": "„Hierfür erließen sie in den Bereichen der Elektrizitätserzeugung, des Elektrizitätstransports und des Elektrizitätsvertriebs Harmonisierungsvorschriften.“"
                            },
                            {
                                "example_id": "c5d7c966-cbe3-48e9-996f-0ca10a2fdc0f",
                                "sense_id": "031042ee-b9f9-3ca7-bf54-a1a6b27e4f63",
                                "text": "„Im Zusammenhang dieser Arbeit ist das Potential zur Reduzierung von Treibhausgasemissionen in der Elektrizitätserzeugung von besonderem Interesse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
