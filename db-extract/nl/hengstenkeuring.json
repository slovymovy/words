                        ],
                        "examples": [
                            {
                                "example_id": "bd0d36f0-381b-4d6c-9439-ba9b4a3a1d8a",
                                "sense_id": "0216efd6-9040-3010-b5b4-97461bfb23ae",
                                "text": "Voor de fokkers en liefhebbers van het Friese ras is de Hengstenkeuring het hoogtepunt van het jaar. Het is de start van het selectieproces om stamboekhengst te worden. Alleen de dieren met een officieel dekbrevet mogen gebruikt worden om paarden van dit populaire ras te fokken en daar is veel geld mee gemoeid."
                            },
                            {
                                "example_id": "485e08e5-11c9-4f1b-a117-a44dff837c7d",
                                "sense_id": "0216efd6-9040-3010-b5b4-97461bfb23ae",
                                "text": "In Leeuwarden was vandaag het jaarlijkse hoogtepunt voor handelaren in Friese paarden: de hengstenkeuring voor het Het Koninklijk Friesch Paarden-Stamboek."
                            },
                            {
                                "example_id": "4c2d2d0a-42b1-4706-a1f3-da7dffe0a3cb",
                                "sense_id": "0216efd6-9040-3010-b5b4-97461bfb23ae",
                                "text": "De Belgische dressuurruiter Peter Spahn reed samen met de hengst Adel 357 mee in de internationale Grand Prix. Ook de dekhengst Goffert en zijn amazone namen deel aan een Grand Prix (in Amerika). De hengst Adel is na de hengstenkeuring in januari 2009 met pensioen gegaan."
                            }
                        ]
                    }
