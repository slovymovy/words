                        "translation_id": "bdca2df9-4966-4b8a-b25c-e0d56c0a81ef",
                        "source_entry_id": "b3710a6d-07e1-324e-98fe-93ca2a085ee8",
                        "source_sense_id": "d16c4b05-8372-30fc-a488-f8b62c2860e8",
