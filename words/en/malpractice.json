            "senses": [
                {
                    "sense_id": "f8ba8335-be6d-393d-a218-96f3bf7af0c9",
                    "sense_definition": "Improper, illegal, or unethical conduct by a professional or official person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "professional misconduct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigation uncovered evidence of financial <w>malpractice</w> within the city council.",
                            "target_lang_translations": {
                                "ru": "Расследование выявило доказательства финансовых <w>злоупотреблений</w> в городском совете."
                            }
                        },
                        {
                            "text": "The journalist was accused of professional <w>malpractice</w> for fabricating several sources in his report.",
                            "target_lang_translations": {
                                "ru": "Журналиста обвинили в <w>нарушении профессиональной этики</w> за фальсификацию нескольких источников в его репортаже."
                            }
                        }
                    ],
                    "synonyms": [
                        "misconduct",
                        "mismanagement",
                        "corruption"
                    ],
                    "common_phrases": [
                        "professional malpractice",
                        "financial malpractice",
                        "allegations of malpractice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неправомерное, незаконное или неэтичное поведение профессионала или должностного лица."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злоупотребление",
                                "target_lang_sense_clarification": "служебным положением"
                            },
                            {
                                "target_lang_word": "должностное преступление",
                                "target_lang_sense_clarification": "преступление, связанное с использованием служебного положения"
                            },
                            {
                                "target_lang_word": "нарушение профессиональной этики",
                                "target_lang_sense_clarification": "неэтичное поведение специалиста"
                            },
                            {
                                "target_lang_word": "преступная халатность",
                                "target_lang_sense_clarification": "небрежное исполнение обязанностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e000209-17a2-3239-bf21-8baf67845354",
                    "sense_definition": "The improper or negligent treatment of a patient by a physician or healthcare provider that results in injury or loss.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "professional misconduct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon faced a medical <w>malpractice</w> lawsuit after leaving a sponge inside the patient.",
                            "target_lang_translations": {
                                "ru": "Хирургу предъявили иск за <w>врачебную ошибку</w> после того, как он оставил губку внутри пациента."
                            }
                        },
                        {
                            "text": "Doctors often pay high premiums for medical <w>malpractice</w> insurance to protect themselves from legal claims.",
                            "target_lang_translations": {
                                "ru": "Врачи часто платят высокие взносы за страхование от <w>врачебных ошибок</w>, чтобы защитить себя от судебных исков."
                            }
                        }
                    ],
                    "synonyms": [
                        "negligence"
                    ],
                    "common_phrases": [
                        "medical malpractice",
                        "malpractice insurance",
                        "malpractice lawsuit"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal and medical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неправильное или халатное лечение пациента врачом или медицинским работником, приведшее к травме или ущербу."
                    },
                    "translations": {
                        "ru": [
