                    {
                        "sense_id": "7e9957a7-0217-3bdd-9649-2a1c99e8ed6e",
                        "entry_id": "746c4422-a384-30d6-bd1b-1951a2086a55",
                        "glosses": [
                            "A periodic cooling wind in Cyprus, blowing from the northwest."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "552d3acd-b8f4-48b2-8015-1a14cfdd9ab0",
                                "sense_id": "7e9957a7-0217-3bdd-9649-2a1c99e8ed6e",
                                "text": "The heats increase as the summer advances, and would be altogether intolerable, if a cooling wind called limbat did not arise."
                            },
                            {
                                "example_id": "765d4d48-f208-4f52-8aac-be066e07a129",
                                "sense_id": "7e9957a7-0217-3bdd-9649-2a1c99e8ed6e",
                                "text": "There are various other periodical winds: of these, however, that generally known by the name of limbat, which is common in the island of Cyprus, shall only be mentioned here."
                            },
                            {
                                "example_id": "f7a82f12-06e6-4fe6-9710-888fe5278eb6",
                                "sense_id": "7e9957a7-0217-3bdd-9649-2a1c99e8ed6e",
                                "text": "The intensity of the summer heat is, however, modified after a time by a cooling wind which [Giovanni] Mariti calls limbat. […] This limbat wind is said to be the cause of those fevers which attack the inhabitants, to which Europeans are even more subject."
                            }
                        ]
                    }
