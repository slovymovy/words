                        "sense_id": "dd600b7b-e88a-33dd-b5d9-9444803a4a93",
                        "entry_id": "ddce01ed-f844-3bf9-86fb-f5994a5c5fa3",
                        "glosses": [
                            "bedrijf dat het openbaar vervoer in één gemeente verzorgt"
                        ],
                        "tags": [
                            "overheids"
                        ],
                        "examples": [
                            {
                                "example_id": "17891a96-37f0-401b-a703-7c0c72fe4a40",
                                "sense_id": "dd600b7b-e88a-33dd-b5d9-9444803a4a93",
                                "text": "Gemeentevervoerbedrijf Amsterdam begint in september met het installeren van pinautomaten op alle bussen en trams in de hoofdstad. Dat bevestigt het Amsterdamse vervoerbedrijf aan de NOS. Reizigers kunnen dan met pinpas of creditcard een kaartje kopen."
                            },
                            {
                                "example_id": "6dad73ea-626c-4d8c-863c-0d8f132f0d6e",
                                "sense_id": "dd600b7b-e88a-33dd-b5d9-9444803a4a93",
                                "text": "Harry Verheij vormde met enkele anderen de Tramgroep. Hij moest collega's van het gemeentevervoerbedrijf overhalen om mee te doen aan de staking. Later had hij ook andere taken in het verzet."
                            },
                            {
                                "example_id": "04351350-ec39-4455-a1ee-4d75a0715edf",
                                "sense_id": "dd600b7b-e88a-33dd-b5d9-9444803a4a93",
                                "text": "Vanaf morgen rijdt in Amsterdam een nieuwe metro. De metro is de eerste van in totaal 28 nieuwe metrostellen die het Amsterdamse Gemeentevervoerbedrijf heeft gekocht. De metrostellen vervangen de 35 jaar oude metrotreinen in de stad."
                            }
                        ]
                    }
