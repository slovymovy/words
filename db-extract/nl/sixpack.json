                ],
                "senses": [
                    {
                        "sense_id": "3081ab83-27cd-30df-ac69-a3970d1f3b6a",
                        "entry_id": "d96fc0ac-1a64-3918-a44f-15089bbff004",
                        "glosses": [
                            "verpakking met 6 drankblikjes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "551ba240-533b-4190-a9af-b733f0cb57b8",
                                "sense_id": "3081ab83-27cd-30df-ac69-a3970d1f3b6a",
                                "text": "Bijzonder, want de productielijn van Zomerbok is nog niet opgestart. De pijpjes Zomerbok in het sixpack dat ter promotie op de bar stond bevatten gewoon water. Alvorens Janssen de naam van het nieuwe zomerbier aan zijn publiek prijs gaf, wilde hij eerst weten wat het er van vond."
                            },
                            {
                                "example_id": "9cec0e44-48e8-4dfa-b78b-6609e7200586",
                                "sense_id": "3081ab83-27cd-30df-ac69-a3970d1f3b6a",
                                "text": "Er geldt donderdag geen alcoholverbod op het Museumplein. Ajaxfans mogen eten en drinken (ook alcohol) meenemen op het terrein, mits het voor eigen gebruik is – ongeveer een sixpack per persoon - en het niet in glas is verpakt. Voor andere alcoholische versnaperingen geldt hetzelfde."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c6780bd-d4ed-381a-b2a7-432a5b551980",
                        "entry_id": "d96fc0ac-1a64-3918-a44f-15089bbff004",
                        "glosses": [
                            "een gespierde buikwand bij mensen waarbij men duidelijk de contouren van de musculus rectus abdominis kan zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13ca2b7e-ee1a-433d-b6d8-dddf38d48a62",
                                "sense_id": "9c6780bd-d4ed-381a-b2a7-432a5b551980",
                                "text": "(Bier)buik of sixpack? Na de vrouw moet nu ook de man er strak en stralend uitzien. Sommigen slaan door, maar het streven naar een fit lijf is op zich natuurlijk prima. Hoe doe je dat? Fitheidshulp anno 2018."
                            }
                        ]
                    }
