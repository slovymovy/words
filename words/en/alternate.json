{
    "word_family": [
        "alternation",
        "alternative",
        "alternator",
        "alternately"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1dd481a9-4f9b-357f-91e7-a985d5f77467",
                    "sense_definition": "To happen or follow one after another in a repeated sequence.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high and low tides <w>alternate</w> with each other throughout the day.",
                            "target_lang_translations": {
                                "ru": "Приливы и отливы <w>чередуются</w> друг с другом в течение дня.",
                                "zh": "全天涨潮和落潮不断<w>交替</w>出现。"
                            }
                        },
                        {
                            "text": "The weather will <w>alternate</w> between rain and sunshine all afternoon.",
                            "target_lang_translations": {
                                "ru": "Весь день погода будет <w>сменяться</w> то дождем, то солнцем.",
                                "zh": "整个下午天气都在下雨和晴天之间<w>交替</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seesaw",
                        "interchange"
                    ],
                    "common_phrases": [
                        "alternate between"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить или следовать друг за другом в повторяющейся последовательности.",
                        "zh": "指事物按一定顺序反复交替出现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чередоваться",
                                "target_lang_sense_clarification": "сменять друг друга"
                            },
                            {
                                "target_lang_word": "сменяться",
                                "target_lang_sense_clarification": "одно за другим"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交替",
                                "target_lang_sense_clarification": "轮流替换"
                            },
                            {
                                "target_lang_word": "轮换",
                                "target_lang_sense_clarification": "轮流更换"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07bc5686-3abd-3db9-bb0f-e37546c27e08",
                    "sense_definition": "To perform or arrange things so that they follow each other in turns.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>alternate</w> layers of pasta and sauce to make a perfect lasagna.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>чередовать</w> слои пасты и соуса, чтобы приготовить идеальную лазанью.",
                                "zh": "你应该把面片和酱汁<w>交替</w>铺开，才能做出完美的千层面。"
                            }
                        },
                        {
                            "text": "The coach decided to <w>alternate</w> players to keep the team fresh during the game.",
                            "target_lang_translations": {
                                "ru": "Тренер решил <w>чередовать</w> игроков, чтобы команда оставалась свежей во время игры.",
                                "zh": "教练决定<w>轮换</w>球员，以保持球队在比赛中的体力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interchange"
                    ],
                    "common_phrases": [
                        "alternate layers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять или располагать вещи так, чтобы они следовали друг за другом по очереди.",
                        "zh": "安排事物使其轮流出现或进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чередовать",
                                "target_lang_sense_clarification": "менять порядок"
                            },
                            {
                                "target_lang_word": "перемежать",
                                "target_lang_sense_clarification": "вставлять между чем-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交替",
                                "target_lang_sense_clarification": "轮流使用"
                            },
                            {
                                "target_lang_word": "轮流",
                                "target_lang_sense_clarification": "按次序进行"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "34cdffe5-aa74-378f-9bac-5f44f6fae44b",
                    "sense_definition": "Occurring as every second item in a series; every other.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sequence_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener planted flowers on <w>alternate</w> rows to create a striped pattern.",
                            "target_lang_translations": {
                                "ru": "Садовник посадил цветы в <w>каждом втором</w> ряду, чтобы создать полосатый узор.",
                                "zh": "园丁在<w>隔一</w>行的位置种上花，以形成条纹图案。"
                            }
                        },
                        {
                            "text": "We meet for lunch on <w>alternate</w> Saturdays when we are both free.",
                            "target_lang_translations": {
                                "ru": "Мы встречаемся за обедом <w>через субботу</w>, когда мы оба свободны.",
                                "zh": "我们都在有空的时候<w>隔周</w>周六一起吃午饭。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "alternate days",
                        "alternate rows"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий через один; каждый второй в серии.",
                        "zh": "指每隔一个的，即每两个中的一个。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каждый второй",
                                "target_lang_sense_clarification": "через один"
                            },
                            {
                                "target_lang_word": "через один",
                                "target_lang_sense_clarification": "пропуская один"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隔一",
                                "target_lang_sense_clarification": "每隔一个"
                            },
                            {
                                "target_lang_word": "每隔一个",
                                "target_lang_sense_clarification": "间隔出现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e75ef525-8217-3c7b-93a3-5908b32a710d",
                    "sense_definition": "Happening by turns, where one follows the other repeatedly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The light flashed in <w>alternate</w> bursts of red and blue.",
                            "target_lang_translations": {
                                "ru": "Свет мигал <w>чередующимися</w> вспышками красного и синего.",
                                "zh": "灯光以红色和蓝色<w>交替</w>闪烁。"
                            }
                        },
                        {
                            "text": "The couple worked <w>alternate</w> shifts so someone was always home with the kids.",
                            "target_lang_translations": {
                                "ru": "Пара работала в <w>разные</w> смены, чтобы кто-то всегда был дома с детьми.",
                                "zh": "这对夫妇上<w>轮班</w>，这样总有一个人能在家照顾孩子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "alternate shifts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий по очереди, когда одно неоднократно следует за другим.",
                        "zh": "指事物轮流发生，一个接一个地重复出现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чередующийся",
                                "target_lang_sense_clarification": "поочередный"
                            },
                            {
                                "target_lang_word": "попеременный",
                                "target_lang_sense_clarification": "сменяющий друг друга"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交替的",
                                "target_lang_sense_clarification": "轮流出现的"
                            },
                            {
                                "target_lang_word": "轮换的",
                                "target_lang_sense_clarification": "轮流替换的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8559dafd-4375-3760-81e1-3b1632b75fa9",
                    "sense_definition": "Serving as a different choice or possibility; alternative.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "choice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the main road is closed, we will have to find an <w>alternate</w> route.",
                            "target_lang_translations": {
                                "ru": "Если главная дорога закрыта, нам придется искать <w>альтернативный</w> маршрут.",
                                "zh": "如果主路封闭，我们必须寻找一条<w>替代</w>路线。"
                            }
                        },
                        {
                            "text": "The scientist proposed an <w>alternate</w> theory to explain the data.",
                            "target_lang_translations": {
                                "ru": "Ученый предложил <w>альтернативную</w> теорию для объяснения данных.",
                                "zh": "科学家提出了一个<w>替代</w>理论来解释这些数据。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "alternate route",
                        "alternate plan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий иным выбором или возможностью; альтернативный.",
                        "zh": "作为另一种选择或可能性；替代的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альтернативный",
                                "target_lang_sense_clarification": "другой вариант"
                            },
                            {
                                "target_lang_word": "запасной",
                                "target_lang_sense_clarification": "на случай замены"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "替代的",
                                "target_lang_sense_clarification": "作为另一种选择"
                            },
                            {
                                "target_lang_word": "备用的",
                                "target_lang_sense_clarification": "作为后备方案"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2316004b-cf2b-30cb-85aa-7c1256529e00",
                    "sense_definition": "A person or thing that acts as a substitute or takes the place of another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "substitute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was chosen as an <w>alternate</w> for the Olympic team in case of injury.",
                            "target_lang_translations": {
                                "ru": "Ее выбрали в качестве <w>запасной</w> в олимпийскую сборную на случай травмы.",
                                "zh": "她被选为奥运代表队的<w>替补</w>，以防有人受伤。"
                            }
                        },
                        {
                            "text": "The committee appointed an <w>alternate</w> to attend the meeting in his absence.",
                            "target_lang_translations": {
                                "ru": "Комитет назначил <w>заместителя</w> для посещения собрания в его отсутствие.",
                                "zh": "委员会指派了一名<w>代理人</w>在他缺席时参加会议。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "serve as an alternate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, который действует как заместитель или занимает место другого.",
                        "zh": "指作为替代者或接替他人位置的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заместитель",
                                "target_lang_sense_clarification": "человек на замену"
                            },
                            {
                                "target_lang_word": "дублер",
                                "target_lang_sense_clarification": "в спорте или искусстве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "替补",
                                "target_lang_sense_clarification": "顶替的人"
                            },
                            {
                                "target_lang_word": "代理人",
                                "target_lang_sense_clarification": "代行职责的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}