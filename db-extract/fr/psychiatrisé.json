                        "glosses": [
                            "Patient du secteur psychiatrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3998f38e-a653-4c2f-a1e5-f47cf97435ec",
                                "sense_id": "d1b75b80-c672-37c7-9e2b-d0356de37367",
                                "text": "Interné et devenu un psychiatrisé modèle, il entre en 1929 au parti nazi et soutient les mesures d’hygiène raciale."
                            },
                            {
                                "example_id": "7f9520a4-21c1-4143-8f13-19a1c43be2ea",
                                "sense_id": "d1b75b80-c672-37c7-9e2b-d0356de37367",
                                "text": "Un parmi ceux-ci : il s’agit de la politique du \"Secteur Psychiatrique\" visant à traiter de la santé mentale d’une population géographiquement, c’est-à-dire administrativement, déterminée, en la suivant médico-psychiatriquement à domicile afin de désenfermer les psychiatrisés de l’hôpital psychiatrique et de vider celui-ci."
                            }
                        ]
                    }
                ],
