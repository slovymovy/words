            "pos": "verb",
            "senses": [
                {
                    "sense_id": "11c6dc9d-b4b1-3e8f-b117-cdeddd70c37e",
                    "sense_definition": "Reproduire un document, un texte ou une image sur un support physique au moyen d'une imprimante.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "impression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pouvez-vous m'<w>imprimer</w> ce billet de train avant notre départ ce soir ?"
                        },
                        {
                            "text": "J'<w>imprime</w> toutes mes photos de vacances pour les coller dans un album."
                        }
                    ],
                    "common_phrases": [
                        "imprimer un document",
                        "imprimer en couleur",
                        "imprimer recto verso"
                    ]
                },
                {
                    "sense_id": "3c7c89c3-9e5b-38b0-8bf1-7cbf03d15628",
                    "sense_definition": "Faire paraître ou publier un texte, un livre en utilisant les procédés de l'imprimerie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "edition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur a décidé de faire <w>imprimer</w> son premier roman à compte d'auteur."
                        },
                        {
                            "text": "Cette célèbre maison d'édition <w>imprime</w> des milliers de livres chaque année."
                        }
                    ],
                    "synonyms": [
                        "éditer",
                        "publier"
                    ],
                    "common_phrases": [
                        "faire imprimer",
                        "imprimer un livre"
                    ]
                },
                {
                    "sense_id": "87e71ce2-dd78-315d-a071-0aa19d4697dc",
                    "sense_definition": "Laisser une trace, une marque ou une empreinte matérielle sur une surface par pression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le promeneur <w>imprimait</w> ses pas dans la neige fraîche du matin."
                        },
                        {
                            "text": "Le tampon encreur sert à <w>imprimer</w> la date sur les lettres reçues."
                        }
                    ],
                    "synonyms": [
                        "estamper",
                        "marquer"
                    ],
                    "common_phrases": [
                        "imprimer ses pas",
                        "imprimer sa marque"
                    ]
                },
                {
                    "sense_id": "aba1d876-7483-3615-a6da-c7f6bdd85e90",
                    "sense_definition": "Faire pénétrer ou graver durablement un sentiment ou un souvenir dans l'esprit ou le cœur de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce voyage extraordinaire s'est <w>imprimé</w> pour toujours dans sa mémoire."
                        },
                        {
                            "text": "Ces maîtres sévères voulaient <w>imprimer</w> la discipline dans l'esprit des élèves."
                        }
                    ],
                    "synonyms": [
                        "graver",
                        "inculquer"
                    ],
                    "common_phrases": [
                        "imprimer le respect",
                        "s'imprimer dans la mémoire"
                    ]
                },
                {
                    "sense_id": "49548a13-02c6-31d7-a8db-4b80e0697bb1",
                    "sense_definition": "Transmettre ou communiquer une force, une direction ou un mouvement à un corps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pilote donne un coup sec pour <w>imprimer</w> une nouvelle direction au véhicule."
                        },
                        {
                            "text": "Le puissant moteur <w>imprime</w> une rotation rapide à toute la machine."
                        }
                    ],
                    "synonyms": [
                        "communiquer",
                        "transmettre"
                    ],
                    "common_phrases": [
                        "imprimer une impulsion",
                        "imprimer un mouvement"
                    ]
                },
                {
                    "sense_id": "0bc7d19e-b635-34ae-9770-0a64a138ee2c",
                    "sense_definition": "Marquer durablement l'esprit du public ou susciter l'adhésion par un message fort.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré de multiples interventions médiatiques, le discours du candidat n'<w>imprime</w> pas."
                        },
                        {
                            "text": "Cette mesure forte a réussi à <w>imprimer</w> auprès d'une grande partie des électeurs."
