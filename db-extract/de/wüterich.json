                ],
                "senses": [
                    {
                        "sense_id": "dc7a3c31-d395-3c87-8822-a2042c34be8b",
                        "entry_id": "8fdba32a-6353-3076-aa08-4ff7d8daedcd",
                        "glosses": [
                            "ein Mensch, der schnell wütend wird und leicht tobt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbdb6f0e-50c1-47c6-8bf8-cde6a14a06d6",
                                "sense_id": "dc7a3c31-d395-3c87-8822-a2042c34be8b",
                                "text": "„Und nicht nur vor der Kamera gab er den Wüterich: Gegen Ende der Dreharbeiten drohte er seinem Regisseur mit Mord.“"
                            },
                            {
                                "example_id": "f932358d-756f-4ef4-bb00-385ef24e6710",
                                "sense_id": "dc7a3c31-d395-3c87-8822-a2042c34be8b",
                                "text": "„Der Friederich, der Friederich, das war ein arger Wüterich!“"
                            },
                            {
                                "example_id": "df673044-0a42-43c7-96aa-6bdb1567d6c8",
                                "sense_id": "dc7a3c31-d395-3c87-8822-a2042c34be8b",
                                "text": "„Ein Verschnittener, der eine Frau liebt, die ihn verabscheut, wird zum Wüterich.“"
                            },
                            {
                                "example_id": "259d7c6a-1a29-44c7-ba1b-ab7a0d753f9b",
                                "sense_id": "dc7a3c31-d395-3c87-8822-a2042c34be8b",
                                "text": "„Es konnte der schmerzgebeugten Witwe gar nichts Besseres passieren, als daß dieser Wüterich endlich, vom Schlag getroffen, beim Backen der Morgenbrötchen und der Hefekuchen dahinsank; trotzdem aber glaubt sie das plötzlich nicht mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0c60e5df-9dbe-37e8-97ae-01383d761ef0",
                        "entry_id": "8fdba32a-6353-3076-aa08-4ff7d8daedcd",
