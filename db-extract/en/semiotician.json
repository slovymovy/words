                        ]
                    },
                    {
                        "translation_id": "c1b7d1ff-10ca-4417-aa24-69556dca54c4",
                        "source_entry_id": "38a069e3-1324-3c8e-9684-e60c0bbbfc61",
                        "source_sense_id": "26fa034b-4ee0-3fa5-9d4f-5d1237f40efc",
                        "source_sense_description": "linguist specialized in semiotics",
                        "target_lang_word": "sémioticien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sémioticien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ac68eb2-be05-3a9e-a82e-af1734c6484b",
                                        "entry_id": "973860e7-f810-3185-b077-2ba7fc4ff694",
                                        "glosses": [
                                            "Linguiste, spécialiste de l’étude des signes, des symboles et de leur signification."
                                        ],
                                        "tags": [
                                            "Sémiotique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4932ada1-ab35-4b53-9c6f-b7b593e2babe",
                                                "sense_id": "1ac68eb2-be05-3a9e-a82e-af1734c6484b",
                                                "text": "Le sémioticien a une « utilité sociale » : il voit du sens là où les autres voient des choses"
                                            },
                                            {
                                                "example_id": "8992ffe6-edb9-4dcd-ba18-77f667496df9",
                                                "sense_id": "1ac68eb2-be05-3a9e-a82e-af1734c6484b",
                                                "text": "L'auteur [Ernst Kantorowicz], médiéviste, historien de l'État, sémioticien et philosophe de l'esthétique, est issu de la bourgeoisie juive industrielle de Prusse"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7af0e55c-78a7-42e5-8414-4eb4e5403758",
                        "source_entry_id": "38a069e3-1324-3c8e-9684-e60c0bbbfc61",
                        "source_sense_id": "26fa034b-4ee0-3fa5-9d4f-5d1237f40efc",
                        "source_sense_description": "linguist specialized in semiotics",
                        "target_lang_word": "Semiotik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Semiotik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                        "entry_id": "c8b3ad5e-826c-3212-91d9-0921fb3c0e14",
                                        "glosses": [
                                            "Wissenschaft, die sich mit Zeichensystemen aller Art (zum Beispiel: Bilderschrift, Gestik, Formeln, Sprache, Verkehrszeichen) befasst und versucht, sie zu beschreiben und zu erklären"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cf626e8-ef4f-45f3-bf78-17cb4e1c6701",
                                                "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                                "text": "Im Verkehrsunterricht lernt man die Semiotik der Straße, das heißt alle Verkehrszeichen. Im Unterschied dazu stehen die Verkehrsregeln, die nicht die Semiotik betreffen."
                                            },
                                            {
                                                "example_id": "9b0998b3-ab81-41db-b696-cd60a951417b",
                                                "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                                "text": "„Die Semiotik untersucht alle kulturellen Prozesse als Kommunikationsprozesse.“"
                                            },
                                            {
                                                "example_id": "23ce2dba-9cde-41bb-8b0b-9d1de2e8fa61",
                                                "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                                "text": "„Der Gegenstandsbereich der Semiotik - letztlich eine Art und Weise der Erweiterung unserer Wahrnehmung der Welt - ist der Austausch jedweder Nachrichten und der Zeichensysteme, die ihnen zugrunde liegen […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f21b8665-2207-3a4d-b005-fb411feb3e2f",
                                        "entry_id": "c8b3ad5e-826c-3212-91d9-0921fb3c0e14",
                                        "glosses": [
                                            "Lehre von den Anzeichen für eine Erkrankung oder Verletzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c83a899-bf74-4bc1-8893-7adbed93534b",
                                                "sense_id": "f21b8665-2207-3a4d-b005-fb411feb3e2f",
                                                "text": "„Semiotik ist die Lehre von den Zeichen des widernatürlichen Zustandes.“"
                                            },
                                            {
                                                "example_id": "d621bf6f-e018-4937-930d-55ee7a3e82bd",
                                                "sense_id": "f21b8665-2207-3a4d-b005-fb411feb3e2f",
                                                "text": "„Die Lehre, welche die einzelnen Zeichen auf ihre Ursachen, oder auf die ihnen entsprechenden Veränderungen des lebenden Körpers zurückführt, und dabei das Verhältnis der einzelnen Zeichen unter einander berücksichtigt, ist die Semiotik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4022bbb0-cfec-4985-916c-5c5d7927a02f",
                        "source_entry_id": "38a069e3-1324-3c8e-9684-e60c0bbbfc61",
                        "source_sense_id": "26fa034b-4ee0-3fa5-9d4f-5d1237f40efc",
                        "source_sense_description": "linguist specialized in semiotics",
                        "target_lang_word": "Semiotiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Semiotiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5eebcb75-3d85-328a-b0c3-7e6d58ca8cea",
                                        "entry_id": "751f60f5-8845-3afe-8fc0-b870b32a61fa",
                                        "glosses": [
                                            "Wissenschaftler, der sich mit der Semiotik beschäftigt"
                                        ],
                                        "tags": [
                                            "Semiotik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5ea1bb9-8fda-4e4d-92b1-85a30ff22de2",
                                                "sense_id": "5eebcb75-3d85-328a-b0c3-7e6d58ca8cea",
                                                "text": "Der US-amerikanische Semiotiker Charles W. Morris teilt die Semiotik grundlegend in Syntaktik, Semantik und Pragmatik ein."
                                            },
                                            {
                                                "example_id": "70312cd8-12dc-4218-a1f7-ca7976fcbcb0",
                                                "sense_id": "5eebcb75-3d85-328a-b0c3-7e6d58ca8cea",
                                                "text": "„Semiotikerinnen und Semiotiker fragen allgemein danach, was alles Zeichen sein kann, nach den Ordnungen und Strukturen von Zeichensystemen, den verschiedenen Funktionen und Gebrauchsweisen von Zeichen, nach ihrer Materialität, Medialität, Performativität und Ästhetik sowie nach den Beziehungen zwischen verschiedenen Zeichensystemen und Medien.“"
                                            },
                                            {
                                                "example_id": "dbd7476c-79a9-4067-a7c4-87358265eb12",
                                                "sense_id": "5eebcb75-3d85-328a-b0c3-7e6d58ca8cea",
                                                "text": "„Walter A. Koch (* 26. Juli 1934 in Hamm) ist ein deutscher Semiotiker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
