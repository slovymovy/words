                        "glosses": [
                            "de wateren van een haven die leiden naar de kades en waarover schepen de haven kunnen in- en uitgaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af196e0f-9d66-457f-8757-91391fe04798",
                                "sense_id": "f8fb5143-6194-3977-b7a1-f4bf6e112ee3",
                                "text": "Rechts van hem, achter de slaperdijk met daarin de oude, altijd open sluis naar de havenkom, lag de kleine stad, links, wegschietend door het Nieuwland, het bevroren kanaal dat uitliep in de Zuiderzee."
                            },
                            {
                                "example_id": "6e8f30b5-05f1-4c8f-9d6e-55ec33625989",
                                "sense_id": "f8fb5143-6194-3977-b7a1-f4bf6e112ee3",
                                "text": "Ook werden alle opvarenden ondervraagd. Het scheepvaartverkeer rond de havenkom van Grou werd stilgelegd."
                            }
                        ]
                    }
                ],
