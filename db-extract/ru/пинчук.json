                ],
                "senses": [
                    {
                        "sense_id": "78387e82-edfd-37e5-934d-2d48a361d271",
                        "entry_id": "b19fa532-7746-372e-82cc-11b3828e70d5",
                        "glosses": [
                            "украинская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f702a22f-0357-415b-87db-4ab5e8a76423",
                                "sense_id": "78387e82-edfd-37e5-934d-2d48a361d271",
                                "text": "Биолог дремлет в квартире Пинчука. Тихо, темно. Раздаётся телефонный звонок. «Пинчук» берёт трубку: – Пинчук, это ты? – А кто его спрашивает? – Мне нужен Пинчук. – Я слушаю. – Как твоё здоровье, Пинчук?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8f94bf77-61a0-38e8-8adc-039359a6cca5",
