                ],
                "senses": [
                    {
                        "sense_id": "ad6971dd-7544-321c-97c8-8d2f7dfb5608",
                        "entry_id": "cb3ffc9b-4613-393e-96f5-b741b6c86a65",
                        "glosses": [
                            "Qui empoisonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eb6a38c-5d20-48f6-b27a-643fe412543a",
                                "sense_id": "ad6971dd-7544-321c-97c8-8d2f7dfb5608",
                                "text": "Cette atmosphère de mensonge est étouffante, empoisonnante, mortelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67dbe6a4-687e-4f7e-9998-a00c19cc7b5c",
                        "source_entry_id": "cb3ffc9b-4613-393e-96f5-b741b6c86a65",
                        "source_sense_id": "ad6971dd-7544-321c-97c8-8d2f7dfb5608",
                        "target_lang_word": "giftig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "giftig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f63d03e-9ed7-3dc9-a703-88bbfef43ee3",
                                        "entry_id": "039d4cd7-27af-3af9-a52d-b485d33a9128",
                                        "glosses": [
                                            "gesundheitsschädlich, schadstoffhaltig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "961f2d27-82bc-4e9b-bef4-334f87352b06",
                                                "sense_id": "7f63d03e-9ed7-3dc9-a703-88bbfef43ee3",
                                                "text": "Viele Pilzarten sind für den Menschen giftig."
                                            },
                                            {
                                                "example_id": "29873b72-2c82-4d57-8a82-0770b47dff8e",
                                                "sense_id": "7f63d03e-9ed7-3dc9-a703-88bbfef43ee3",
                                                "text": "„Man kann beispielsweise Pflanzen mittels Gentechnik so manipulieren, dass sie gegen bestimmte Krankheiten immun oder unempfindlich gegen sonst giftige chemische Pflanzenschutzmittel werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9af3a36-5afb-33f0-9cb3-78d709e0e554",
                                        "entry_id": "039d4cd7-27af-3af9-a52d-b485d33a9128",
                                        "glosses": [
                                            "Mensch, reizbar, aufbrausend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17309065-1ec5-41e3-a0e0-74ce99ee13f4",
                                                "sense_id": "c9af3a36-5afb-33f0-9cb3-78d709e0e554",
                                                "text": "Der Hund des Nachbarn ist ein giftiger Kläffer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f7c32d8-2b1f-48f0-81e4-66ff5df24222",
                        "source_entry_id": "cb3ffc9b-4613-393e-96f5-b741b6c86a65",
                        "source_sense_id": "ad6971dd-7544-321c-97c8-8d2f7dfb5608",
                        "target_lang_word": "poisonous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poisonous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "878557e2-7373-3511-8a8b-56cfa1f28b38",
                                        "entry_id": "f8f2dc53-9a92-33b9-a265-6dd3e95e8c25",
                                        "glosses": [
                                            "Containing sufficient poison to be dangerous to touch or ingest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5b92b8f-e52a-4c7a-8af2-04cb776983a3",
                                                "sense_id": "878557e2-7373-3511-8a8b-56cfa1f28b38",
                                                "text": "While highly poisonous to dogs, this substance is completely harmless if ingested by humans."
                                            },
                                            {
                                                "example_id": "6ed9d2e6-56ac-4373-a03a-396c311c8451",
                                                "sense_id": "878557e2-7373-3511-8a8b-56cfa1f28b38",
                                                "text": "Nor taint-worm ſhall infect the yeaning herds / Nor penny-graſs, nor ſpearwort's poiſ'nous leaf."
                                            },
                                            {
                                                "example_id": "85cef071-00f0-43b7-93c5-62233dbc6c27",
                                                "sense_id": "878557e2-7373-3511-8a8b-56cfa1f28b38",
                                                "text": "I had picked a mushroom so poisonous that particles of it, stuck to my fingers and accidentally swallowed, could have made me deathly ill, and a piece the size of my thumb could have killed me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58055e40-2594-3e7f-a57a-2189fc5926d2",
                                        "entry_id": "f8f2dc53-9a92-33b9-a265-6dd3e95e8c25",
                                        "glosses": [
                                            "Of an animal such as a snake or spider, or parts of its body: producing a toxin intended for defensive or offensive use which is usually injected into an enemy or prey by biting or stinging; hence, of a bite or sting: injecting poison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "342dd974-d37e-4cbb-81e3-4a3021f3b7c8",
                                                "sense_id": "58055e40-2594-3e7f-a57a-2189fc5926d2",
                                                "text": "Poisonous snakes should only be handled by experienced professionals."
                                            },
                                            {
                                                "example_id": "047456ef-47a7-4f6d-84a5-2f6a138893dc",
                                                "sense_id": "58055e40-2594-3e7f-a57a-2189fc5926d2",
                                                "text": "SERPENT … either that which is not poiſonous: or that which is counted poiſonous, having two long, hollow, moveable teeth, …"
                                            },
                                            {
                                                "example_id": "c8df51f5-55f5-4cfa-bf20-1acc2d6ea50a",
                                                "sense_id": "58055e40-2594-3e7f-a57a-2189fc5926d2",
                                                "text": "The Cencoatl (o), which is alſo a poiſonous ſnake, is about five feet long, and eight inches round at the thickeſt part."
                                            },
                                            {
                                                "example_id": "a57ef2f4-51b7-438d-aa49-bef26a94474b",
                                                "sense_id": "58055e40-2594-3e7f-a57a-2189fc5926d2",
                                                "text": "Evidently the first thing to ascertain is whether the case is really that of a bite by a poisonous snake…"
                                            },
                                            {
                                                "example_id": "1935d60a-5dbf-4884-a10d-efce63cd21bc",
                                                "sense_id": "58055e40-2594-3e7f-a57a-2189fc5926d2",
                                                "text": "The characteristics which separate the dangerously venomous groups from their non-poisonous relatives are emphasized."
                                            },
                                            {
                                                "example_id": "0c231cd9-937c-439d-986e-16dfe93075e7",
                                                "sense_id": "58055e40-2594-3e7f-a57a-2189fc5926d2",
                                                "text": "These antivenins make living near poisonous spiders much safer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54bb90bd-2215-3067-94ca-41aca55ad6fb",
                                        "entry_id": "f8f2dc53-9a92-33b9-a265-6dd3e95e8c25",
                                        "glosses": [
                                            "Negative, harmful."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0fe9051-880a-4fdb-877e-8f77c81f8cca",
                                                "sense_id": "54bb90bd-2215-3067-94ca-41aca55ad6fb",
                                                "text": "He didn't want to end up like his grandfather, bitter and intractable, consumed in his hatred like an addict on haze — a poisonous attitude that would possess him all his remaining years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf85f36c-d135-45c3-be37-6db24e41690e",
                        "source_entry_id": "cb3ffc9b-4613-393e-96f5-b741b6c86a65",
                        "source_sense_id": "ad6971dd-7544-321c-97c8-8d2f7dfb5608",
                        "target_lang_word": "tóxico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tóxico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ef925c72-0d3c-3332-9acb-b52347988800",
                                        "entry_id": "3b4c998b-a146-301b-a7d4-7e84d29a98fb",
                                        "glosses": [
                                            "Que por contacto, ingesta o inoculación resulta dañino, destructivo o aún letal para las funciones de un organismo vivo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a69e5bd8-2119-4e47-8f58-0b929be5e5fa",
                                                "sense_id": "ef925c72-0d3c-3332-9acb-b52347988800",
                                                "text": "«Este fármaco es precisamente el benznidazole, pero administrado de otra manera y en cantidades más reducidas, con el objetivo de conseguir un medicamento menos tóxico y disminuir así los efectos secundarios y su coste»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3047a8f-a6c5-3177-88bc-d79c90fba2a7",
                                        "entry_id": "3b4c998b-a146-301b-a7d4-7e84d29a98fb",
                                        "glosses": [
                                            "Dicho de una persona, que por sus constantes quejas y lamentos o mal carácter llega a convertirse en indeseable. También aplica a las personas que se les brinda confianza y abusan de la misma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3108fdad-910c-441d-a09a-d45c525400e0",
                                                "sense_id": "f3047a8f-a6c5-3177-88bc-d79c90fba2a7",
                                                "text": "«—Cuéntame, ¿qué te pasa? ¿Por qué lloras?\n—¡Ya no lo soporto más!\n—¡Pero ¿a quién?!\n—¡A mi novio! No puedo tolerarlo más. Es una persona tóxica y posesiva que no me deja hacer nada por mi propia cuenta. Ya no puedo ni siquiera salir contigo ni con los otros chicos porque él empieza un escándalo; y después se arrodilla y dice: “Lo siento, lo siento. Perdóname, por favor. No lo volveré a hacer”, pero la situación no cambia, y no sé qué hacer para acabar con todo eso».\n—Vaya. Pero él no parecía ser esa clase de gente.\n—Tú lo has dicho: “No parecía”. Las apariencias engañan»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2e62be3-2a1b-414c-b527-7cbd414ae379",
                        "source_entry_id": "cb3ffc9b-4613-393e-96f5-b741b6c86a65",
                        "source_sense_id": "ad6971dd-7544-321c-97c8-8d2f7dfb5608",
