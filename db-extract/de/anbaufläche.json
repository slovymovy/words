                ],
                "senses": [
                    {
                        "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                        "entry_id": "d9725786-2032-3bc5-b7d1-c1fc3c817455",
                        "glosses": [
                            "für den Anbau von Pflanzen genutzte Fläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1b4b701-8d04-4061-b72b-e406c8c32970",
                                "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                "text": "„Ab Mitte der 1980er Jahre gab es jedoch gezielte staatliche Anstrengungen, die Anzahl der Olivenbäume zu steigern und die Anbaufläche zu erweitern.“"
                            },
                            {
                                "example_id": "97dbf608-e41c-4f34-8cb5-85958e97b14e",
                                "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                "text": "„Sie produzieren den größten Teil aller Lebensmittel und bewirtschaften etwa 60% der weltweiten Anbaufläche.“"
                            },
                            {
                                "example_id": "10f0c84c-d3fc-4726-886f-444b1fb13434",
                                "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                "text": "„Bis Anfang der 1980er Jahre verläuft die Änderung der Anbaufläche von Mais, Reis, Soja und Weizen relativ synchron.“"
                            },
                            {
                                "example_id": "f35ca0c2-e531-4aea-bfff-4138dd0e1f61",
                                "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                "text": "„Und diese Betriebe waren Kleinbetriebe mit einer durchschnittlichen Anbaufläche von nur 1,6 Hektar.“"
                            },
                            {
                                "example_id": "f731690f-782b-4177-a1cc-154f13108f4b",
                                "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                "text": "„Ob Reisfelder, Mais oder Tomaten – viele Anbauflächen brauchen eine kontinuierliche Bewässerung.“"
                            },
                            {
                                "example_id": "f05bf993-df1d-4f22-8868-d47704cbac30",
                                "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                "text": "„In Brasilien werden Regenwälder gerodet, um zusätzliche Anbauflächen für Zuckerrohr für die Bioethanolproduktion zu schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
