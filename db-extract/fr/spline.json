                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3ed6792-cdf0-3fa2-a857-dc0c3c93af66",
                        "entry_id": "168dad6d-1ffa-3283-99ea-a1d11e8ffa99",
                        "glosses": [
                            "Fonction polynomiale par partie particulière."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "09b4a55e-4026-3863-86cd-6c646ef59259",
                        "entry_id": "168dad6d-1ffa-3283-99ea-a1d11e8ffa99",
                        "glosses": [
                            "Règle ou latte plate, permettant aux dessinateurs de plans de tracer des courbes. Cette latte est contrainte en flexion pour adopter la forme voulue. Le terme français exacte est : cerce."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cabf5527-d392-4aa8-9f41-0155da8c8213",
                        "source_entry_id": "168dad6d-1ffa-3283-99ea-a1d11e8ffa99",
                        "target_lang_word": "spline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87716865-4fb3-3482-b246-8777331a1bc5",
                                        "entry_id": "aa4b09e9-f6bc-327c-8e56-c6ec18737524",
                                        "glosses": [
                                            "A long, thin piece of metal or wood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe7ef569-6c32-3efc-af2d-0dc40e185d2a",
                                        "entry_id": "aa4b09e9-f6bc-327c-8e56-c6ec18737524",
                                        "glosses": [
                                            "A strip of wood or other material inserted into grooves in each of two pieces of wood to provide additional surface for gluing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07a65217-7871-3c84-9cad-5586a561c210",
                                        "entry_id": "aa4b09e9-f6bc-327c-8e56-c6ec18737524",
                                        "glosses": [
                                            "A flexible strip of metal or other material, that may be bent into a curve and used in a similar manner to a ruler to draw smooth curves between points."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77dc394f-0884-3a45-8914-6980d36a81cb",
                                        "entry_id": "aa4b09e9-f6bc-327c-8e56-c6ec18737524",
                                        "glosses": [
                                            "Any of a number of smooth curves used to join points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c088c0-39c8-4a5e-b3e0-cb68b9bd40ab",
                                                "sense_id": "77dc394f-0884-3a45-8914-6980d36a81cb",
                                                "text": "However, it should be possible to give more sophisticated spherical spline curves based on the de Castaljau method that are computed using multiple slerps between pairs of points and which work well for arbitrary knot positions (indeed, knot insertion methods for spline curves should suffice for this, cf Farin [1993])"
                                            },
                                            {
                                                "example_id": "0d4c3b47-bb4a-4a89-aa61-11ff374c25fd",
                                                "sense_id": "77dc394f-0884-3a45-8914-6980d36a81cb",
                                                "text": "These conditions provide a framework which encompasses some notable approximation kernels including splines, so-called cardinal functions, and many radial basis functions such as the Gaussians and general multiquadrics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87629e09-5f24-3b29-a51f-f5e2d478a361",
                                        "entry_id": "aa4b09e9-f6bc-327c-8e56-c6ec18737524",
                                        "glosses": [
                                            "A ridge or tooth on a drive shaft that meshes with a corresponding groove in a mating piece and transfers torque to it, maintaining the angular correspondence between the pieces; either the ridge or the groove, as part of a set of both (splines); the whole set of ridges and grooves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96f19b58-8a65-3db5-b5af-b2ce7b7edcde",
                                        "entry_id": "aa4b09e9-f6bc-327c-8e56-c6ec18737524",
                                        "glosses": [
                                            "A rectangular piece that fits grooves like key seats in a hub and a shaft, so that while the one may slide endwise on the other, both must revolve together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b385752d-1b2f-41b1-9735-0e202304cd0c",
                                                "sense_id": "96f19b58-8a65-3db5-b5af-b2ce7b7edcde",
                                                "text": "Near-synonym: feather"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01898bb1-91f6-3e4c-b803-d23003d479fd",
                                        "entry_id": "9fd9eb73-8a10-386e-ae4a-93124a633c8e",
                                        "glosses": [
                                            "To smooth (a curve or surface) by means of a spline."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c15d7d41-ceb4-3ced-a537-771bfd51a5e5",
                                        "entry_id": "9fd9eb73-8a10-386e-ae4a-93124a633c8e",
                                        "glosses": [
                                            "To fit with a spline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a7128f-66c2-4162-8d49-821fd041416f",
                                                "sense_id": "c15d7d41-ceb4-3ced-a537-771bfd51a5e5",
                                                "text": "Machining a straight spline with a lathe. Sometimes the task of splining a shaft comes up during a repair. Instead of sending out the job, use this setup to mill the splines on a lathe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b6a414c-180f-3d16-8169-fbed1af9ca66",
                                        "entry_id": "9fd9eb73-8a10-386e-ae4a-93124a633c8e",
                                        "glosses": [
                                            "To fasten to or together with a spline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "725dc27a-6f54-4e1b-a2f4-02fc3f10fb08",
                                                "sense_id": "4b6a414c-180f-3d16-8169-fbed1af9ca66",
                                                "text": "Engineers did not think two crankshafts could be synchronized. Wood, by splining the shafts in each gear box, proved it could be done."
                                            },
                                            {
                                                "example_id": "72914350-b427-491f-befd-c1d1b051c0be",
                                                "sense_id": "4b6a414c-180f-3d16-8169-fbed1af9ca66",
                                                "text": "These packs can be holding or driving devices, depending on what they are splined to."
                                            },
                                            {
                                                "example_id": "f2aee222-29a2-4e44-a461-898b701f301a",
                                                "sense_id": "4b6a414c-180f-3d16-8169-fbed1af9ca66",
                                                "text": "Splined bars are a big recent trend. Originally used in racing, the idea is to have a straight torsion bar with the ends splined like an axle and separate arms that fit on each end to mount the end links"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
