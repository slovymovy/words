                ],
                "senses": [
                    {
                        "sense_id": "5aad0711-7c45-3cd0-b47c-aa2828de2d6e",
                        "entry_id": "718fa7bc-cef8-3019-820b-80106f246cde",
                        "glosses": [
                            "skóra cielęca, kozia lub owcza z licem groszkowanym, używana do wyrobu galanterii kaletniczej"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b31b7b1-1092-48f0-a65a-83079a07670f",
                        "source_entry_id": "718fa7bc-cef8-3019-820b-80106f246cde",
                        "source_sense_id": "5aad0711-7c45-3cd0-b47c-aa2828de2d6e",
                        "target_lang_word": "shagreen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shagreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e2ec98d-83ae-3d9e-a348-e661f8ac9622",
                                        "entry_id": "2ae9d273-dbe4-35f0-8174-91eb804880b7",
                                        "glosses": [
                                            "An untanned leather, often dyed green; originally made from horse skin, today mostly made from the skin of a shark or ray."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79d5ef2b-1332-4043-b174-149c324200fd",
                                                "sense_id": "3e2ec98d-83ae-3d9e-a348-e661f8ac9622",
                                                "text": "The following day the treasures of the mysterious tower came pouring in: pictures, statues, gems, shells, china, stuffed beasts and birds, tables, vases, petrifactions, arms, mandarins, &c. &c.; and among them the shagreen skin, with the injunction, \"Sell it for any thing—nothing—give it away; only, get rid of it.\""
                                            },
                                            {
                                                "example_id": "4f091c9b-b677-4060-85ac-0d7466ad58b3",
                                                "sense_id": "3e2ec98d-83ae-3d9e-a348-e661f8ac9622",
                                                "text": "On the old lecturn or reading-stand which he used for his heavier tomes, The Testaments of Carnamagos, in its covers of shagreen with hasps of human bone, lay open at the very page which had frightened him so unreasonably with its eldritch intimations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b99a07-3c12-3878-a088-f28109c0be93",
                                        "entry_id": "2ae9d273-dbe4-35f0-8174-91eb804880b7",
                                        "glosses": [
                                            "A rough or spiny surface of an insect's cuticle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7801cd88-2d05-4ca7-b4f9-6938bd556fee",
                                                "sense_id": "56b99a07-3c12-3878-a088-f28109c0be93",
                                                "text": "If the shagreen dots be carefully observed they will be found to possess an annular arrangement."
                                            },
                                            {
                                                "example_id": "58a0e3d1-11c7-42fb-9d12-4caf43e505a6",
                                                "sense_id": "56b99a07-3c12-3878-a088-f28109c0be93",
                                                "text": "The shagreen of the abdominal tergites generally consists of small spinules, singly or in caudally convex arcs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shagreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "223e80a3-415f-33d4-a509-80d4d3f7d2af",
                                        "entry_id": "c671890c-f6ea-3ac3-a2f9-dc2b5eaf98ac",
                                        "glosses": [
                                            "To give a texture resembling shagreen leather."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35b78ce6-4cf4-459a-8455-fb434ce5830b",
                        "source_entry_id": "718fa7bc-cef8-3019-820b-80106f246cde",
                        "source_sense_id": "5aad0711-7c45-3cd0-b47c-aa2828de2d6e",
                        "target_lang_word": "chagrin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chagrin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d65d69a-c60d-3778-9b64-58a39a0dac99",
                                        "entry_id": "16528953-50bd-356f-a9e0-b67f413bf55a",
                                        "glosses": [
                                            "Qui éprouve du déplaisir, de la tristesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "998e25f5-999e-40d4-b7e6-a230318c8932",
                                                "sense_id": "4d65d69a-c60d-3778-9b64-58a39a0dac99",
                                                "text": "André est chagrin de la conduite de son fils."
                                            },
                                            {
                                                "example_id": "fe1613b0-1e34-4be8-b11b-00579c4b6cef",
                                                "sense_id": "4d65d69a-c60d-3778-9b64-58a39a0dac99",
                                                "text": "inquiet, chagrin, je redoublai d’ardeur et d’efforts"
                                            },
                                            {
                                                "example_id": "b4361a25-d5bc-4ea5-b617-cb54185cbba5",
                                                "sense_id": "4d65d69a-c60d-3778-9b64-58a39a0dac99",
                                                "text": "Au milieu du lac, il y avait une bête que Julien ne connaissait pas, un castor à museau noir. Malgré la distance, une flèche l’abattit ; et il fut chagrin de ne pouvoir emporter la peau."
                                            },
                                            {
                                                "example_id": "4445bcbe-9825-4081-bf6a-f8d1880aa557",
                                                "sense_id": "4d65d69a-c60d-3778-9b64-58a39a0dac99",
                                                "text": "Dans les ténèbres qui m’enveloppaient, j’évoquais sa figure, et je le distinguais nettement, troublé, chagrin de trouver la pauvre femme dans un tel désespoir."
                                            },
                                            {
                                                "example_id": "1f6174ff-399d-497e-98a9-24acc54994f4",
                                                "sense_id": "4d65d69a-c60d-3778-9b64-58a39a0dac99",
                                                "text": "Je sais que ma composition est ratée, et maintenant que le souvenir de la face pâle est moins vif, et que les fumées de notre banquet sont évanouies, je me sens chagrin, j’éprouve comme des remords."
                                            },
                                            {
                                                "example_id": "bf48c2db-98a4-43bb-bb20-0055877b58b5",
                                                "sense_id": "4d65d69a-c60d-3778-9b64-58a39a0dac99",
                                                "text": "— Les domestiques en auront peut-être cassé.\n— Mon chéri, lui dis-je, chagrin de son irrespect, les domestiques de l’Élysée ne cassent rien. Les patrons non plus, d’ailleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c98ab959-8044-3418-89d6-cf990358c070",
                                        "entry_id": "16528953-50bd-356f-a9e0-b67f413bf55a",
                                        "glosses": [
                                            "Qui marque du déplaisir, de la tristesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73cdc62b-e241-429f-a0e8-015b0f3e9b52",
                                                "sense_id": "c98ab959-8044-3418-89d6-cf990358c070",
                                                "text": "Sa petite moue chagrine trahissait l’importance qu’elle avait mise à se trouver à cette revue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "324b1b6a-0c24-3fbe-84b6-b4555e48201a",
                                        "entry_id": "16528953-50bd-356f-a9e0-b67f413bf55a",
                                        "glosses": [
                                            "Qui est porté à l’humeur sombre et difficile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8553286-79cb-4c7e-8ff4-78f0970efe6d",
                                                "sense_id": "324b1b6a-0c24-3fbe-84b6-b4555e48201a",
                                                "text": "La vieillesse chagrine incessamment amasse ;\nGarde, non pas pour soi, les trésors qu'elle entasse ;\nMarche en tous ses desseins d'un pas lent et glacé ;\nToujours plaint le présent et vante le passé ;\nInhabile aux plaisirs dont la jeunesse abuse,\nBlâme en eux les douceurs que l'âge lui refuse."
                                            },
                                            {
                                                "example_id": "3426fa44-e292-4e71-9158-fd29371e9f0e",
                                                "sense_id": "324b1b6a-0c24-3fbe-84b6-b4555e48201a",
                                                "text": "La dame des Belles-Cousines étoit née vive & sensible, mais elle l’ignoroit encore. Un vieux époux, chagrin & grondeur, avec lequel elle n’avait vécu qu’un an, n’avoit eu ni le temps ni le don de le lui apprendre."
                                            },
                                            {
                                                "example_id": "948fea44-074f-4f8c-8c28-84a0d68e74ae",
                                                "sense_id": "324b1b6a-0c24-3fbe-84b6-b4555e48201a",
                                                "text": "Mais au milieu de tant d’exemples édifiants et touchants, on trouve quelquefois de ces personnes malcontentes et chagrines, à qui tout déplaît dans leur profession, et dont la vie, par-là même, n'est qu'amertume et dégoût."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a0a7cf5-10d3-30e5-89b5-b0b928f0e3de",
                                        "entry_id": "16528953-50bd-356f-a9e0-b67f413bf55a",
                                        "glosses": [
                                            "Qui provoque la mélancolie, l’ennui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c030df5-03f5-4005-88eb-b447780564ac",
                                                "sense_id": "5a0a7cf5-10d3-30e5-89b5-b0b928f0e3de",
                                                "text": "Un gros artilleur poitevin m’a dit : à la fin juin, brouillard du matin, midi chagrin, mais le Picard qui est devant moi au jus m’affirme : ch’t’in beau temps, n’z’aurons d’soleil !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chagrin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b3f949f-eda8-30ee-a728-61812d77ab23",
                                        "entry_id": "afe4e1bc-6665-379d-b693-8fefcebd74e0",
                                        "glosses": [
                                            "État de déplaisir, de peine, d’affliction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "355ad724-4003-44b6-99dc-3ac5b22696f0",
                                                "sense_id": "3b3f949f-eda8-30ee-a728-61812d77ab23",
                                                "text": "Le chagrin avait employé trois ans à détruire cette douce Allemande ; mais c’était un de ces chagrins semblables à des vers logés au cœur d’un bon fruit."
                                            },
                                            {
                                                "example_id": "9b0622b3-06a4-4363-aac8-1e30e3422ba0",
                                                "sense_id": "3b3f949f-eda8-30ee-a728-61812d77ab23",
                                                "text": "Voyons, ma chère Solange, ne déraisonne pas ! Tu souffres d'être trahie et le chagrin te souffle des résolutions folles."
                                            },
                                            {
                                                "example_id": "47d7caa6-ff2b-41d5-994e-f64621acbd45",
                                                "sense_id": "3b3f949f-eda8-30ee-a728-61812d77ab23",
                                                "text": "De l’état d’âme qui, cette lointaine année-là, n’avait été pour moi qu’une longue torture, rien ne subsistait. Car il y a dans ce monde où tout s’use, où tout périt, une chose qui tombe en ruines, qui se détruit encore plus complètement, en laissant encore moins de vestiges que la beauté : c’est le chagrin."
                                            },
                                            {
                                                "example_id": "35792e3c-2887-42e2-b6f1-fe7137e46116",
                                                "sense_id": "3b3f949f-eda8-30ee-a728-61812d77ab23",
                                                "text": "Oui, mon père à peine en terre, j’étais coupable, oubliant mon deuil, trahissant mon chagrin et son souvenir."
                                            },
                                            {
                                                "example_id": "34feca58-8ebc-49fc-b65a-6b89df937c8c",
                                                "sense_id": "3b3f949f-eda8-30ee-a728-61812d77ab23",
                                                "text": "Maman me disait : « On a beau dire, on ne meurt pas de chagrin. Les gens ne meurent pas de leur chagrin. Même s’ils ne se consolent pas, ils ne meurent pas ; mais moi je mourrai, je suis en train de mourir. Attends un peu, ne me quitte pas. »"
                                            },
                                            {
                                                "example_id": "6167bd2c-3ca0-4184-8e1a-80819b04dc2c",
                                                "sense_id": "3b3f949f-eda8-30ee-a728-61812d77ab23",
                                                "text": "« Vous raconterez votre premier chagrin. ‘Mon premier chagrin’ sera le titre de votre prochain devoir de français. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36d6476c-f1d0-3053-aa80-40038bd38b57",
                                        "entry_id": "afe4e1bc-6665-379d-b693-8fefcebd74e0",
                                        "glosses": [
                                            "Humeur bizarre, rude, fâcheuse."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "061fc283-3b8a-4668-acc6-6707637e2d21",
                                                "sense_id": "36d6476c-f1d0-3053-aa80-40038bd38b57",
                                                "text": "Dans vos brusques chagrins je ne puis vous comprendre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chagrin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f06bd32-b17d-3a7a-bb4f-bb011246e05b",
                                        "entry_id": "2306eb27-cf94-376d-afcf-ac8aa6df7797",
                                        "glosses": [
                                            "Cuir grenu fait de peau d’âne, de cheval, de mulet, de petite roussette, de requin, etc. servant à couvrir des boîtes, des livres ou à polir le bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e3efd64-7d07-4d41-9aac-a444faddcdd5",
                                                "sense_id": "6f06bd32-b17d-3a7a-bb4f-bb011246e05b",
                                                "text": "Comme la peau de l'âne est très-dure et très élastique, on l'emploie utilement à différents usages, on en fait des cribles, des tambours et de très bons souliers ; on en fait du gros parchemin pour les tablettes de poche que l'on enduit d'une couche légère de plâtre ; c'est aussi avec le cuir de l'âne que les Orientaux font le sagri, que nous appelons chagrin."
                                            },
                                            {
                                                "example_id": "3fb440fe-e4c4-4539-899c-77e9921a4722",
                                                "sense_id": "6f06bd32-b17d-3a7a-bb4f-bb011246e05b",
                                                "text": "Aveuglé par une sorte de délire, il ne s’aperçut même pas de l’incroyable ductilité de la Peau de chagrin, qui, devenue souple comme un gant, se roula sous ses doigts frénétiques."
                                            },
                                            {
                                                "example_id": "8e471eda-ad6f-4c78-a761-70e322e36745",
                                                "sense_id": "6f06bd32-b17d-3a7a-bb4f-bb011246e05b",
                                                "text": "Le meuble, recouvert de peaux de chagrin couleur bois, se composait de poufs, de fauteuils et d’un divan circulaire qui tenait en partie la rondeur de la pièce."
                                            },
                                            {
                                                "example_id": "5800cde9-20d7-464a-8a06-e0c97453bb78",
                                                "sense_id": "6f06bd32-b17d-3a7a-bb4f-bb011246e05b",
                                                "text": "...un stylet long de cinq à six pouces, enfermé dans un étui de chagrin noir..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3833f3cf-ebf3-36cd-b65b-304d8b816441",
                                        "entry_id": "2306eb27-cf94-376d-afcf-ac8aa6df7797",
                                        "glosses": [
                                            "Peau rugueuse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d9145f4-ae3d-348a-bab5-22c57dacc877",
                                        "entry_id": "2306eb27-cf94-376d-afcf-ac8aa6df7797",
                                        "glosses": [
                                            "Étoffe légère de taffetas moucheté, présentant quelques ressemblances avec les grains du chagrin (le cuir, sens 1)."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
