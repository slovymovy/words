                                        "glosses": [
                                            "The spleen, especially of an animal bred for food."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c04132b-6952-487b-8684-bead38b45694",
                                                "sense_id": "cc55f3d1-97e7-3a90-a012-d8a451cef45d",
                                                "text": "we see that certaine apprehensions engender a blushing-red colour, others a palenesse; that some imagination doth only worke in the milt, another in the braine[…]."
                                            },
                                            {
                                                "example_id": "25df1b18-890c-41b6-9480-a045eb791868",
                                                "sense_id": "cc55f3d1-97e7-3a90-a012-d8a451cef45d",
                                                "text": "Adam Kadmon had pneumonia. Friar Goat cured it by tying a bullock’s milt to the soles of the lad’s feet, and burying the milt afterwards. Adam Kadmon immediately contracted the thrush."
                                            }
                                        ]
                                    },
                                    {
