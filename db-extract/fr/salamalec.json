        "fr-extract.jsonl": [
            {
                "entry_id": "a3098be4-bab8-36bb-a0ec-ccfaa666bc8d",
                "word": "salamalec",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dd2c004f-8ddf-4c6e-9cfe-15f038289fa4",
                        "entry_id": "a3098be4-bab8-36bb-a0ec-ccfaa666bc8d",
                        "tags": [
                            "plural"
                        ],
                        "form": "salamalecs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64fd7534-be57-3f10-9e0b-37c294da2e72",
                        "entry_id": "a3098be4-bab8-36bb-a0ec-ccfaa666bc8d",
                        "glosses": [
                            "Marques de politesse, affectation de déférence."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "135decae-e63d-48cc-9fb5-8f00ad08f323",
                                "sense_id": "64fd7534-be57-3f10-9e0b-37c294da2e72",
                                "text": "Un salamalec, ou plus si affinités…"
                            },
                            {
                                "example_id": "2a0da475-940f-4f8f-9690-c9346e9ac652",
                                "sense_id": "64fd7534-be57-3f10-9e0b-37c294da2e72",
                                "text": "Après les salamalecs obséquieux des premières minutes, j’emmenai M. Lavallée visiter les étables où il était indispensable d’effectuer de menues réparations."
                            },
                            {
                                "example_id": "ec720eb5-c5e7-443f-a630-37a7f96d422c",
                                "sense_id": "64fd7534-be57-3f10-9e0b-37c294da2e72",
                                "text": "La porte s’ouvre. Marie et Jeanne paraissent. Nouvelles salutations ! nouveaux salamalecs !"
                            },
                            {
                                "example_id": "917a9394-26a2-4ec1-990f-e4addb414544",
                                "sense_id": "64fd7534-be57-3f10-9e0b-37c294da2e72",
                                "text": "Ils ne décèlent leur activité que par des mouvements de tête, révérences, salamalecs, demi-culbutes et autres gestes courtois qu'ils affectionnent à la rencontre des hommes terriens."
                            },
                            {
                                "example_id": "a93e860c-605a-47cd-93a5-8fef24cd5089",
                                "sense_id": "64fd7534-be57-3f10-9e0b-37c294da2e72",
                                "text": "Il y eut un dîner à mourir d’ennui tant ces gens firent de salamalecs ; ils avaient avec eux leur fils, un muscadin, un pisse-vinaigre en perruque."
                            },
                            {
                                "example_id": "91a4c7ea-5486-4ea9-bbe1-61e98f5e7a4a",
                                "sense_id": "64fd7534-be57-3f10-9e0b-37c294da2e72",
                                "text": "Il m’a fait un grand salamalec, de grands salamalecs."
                            },
                            {
                                "example_id": "d7a12a9b-cb7f-4a9a-ab78-5ba507e5cf94",
                                "sense_id": "64fd7534-be57-3f10-9e0b-37c294da2e72",
                                "text": "Arrête tes salamalecs, Bettoun."
                            },
                            {
                                "example_id": "1ea1b1e4-bf6a-485b-98b4-dc0c1457086f",
                                "sense_id": "64fd7534-be57-3f10-9e0b-37c294da2e72",
                                "text": "Honecker, selon ses bonnes habitudes, se répand en salamalecs à l’égard de l’Union Soviétique, avant de rassurer son interlocuteur […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60affa5e-1996-4536-95ea-d9e69180183f",
                        "source_entry_id": "a3098be4-bab8-36bb-a0ec-ccfaa666bc8d",
                        "source_sense_id": "64fd7534-be57-3f10-9e0b-37c294da2e72",
