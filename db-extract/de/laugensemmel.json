                ],
                "senses": [
                    {
                        "sense_id": "35550649-41ea-3f3c-9d59-aefc433ab8b4",
                        "entry_id": "59c30c9a-9412-3e06-b9c5-e0b5b9bd7f22",
                        "glosses": [
                            "Brötchen, das vor dem Backen mit Natriumhydroxidlösung (Natronlauge) benetzt wurde"
                        ],
                        "tags": [
                            "Austrian German",
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "26098f4d-1c93-4fdc-91c9-0d8ff75215d9",
                                "sense_id": "35550649-41ea-3f3c-9d59-aefc433ab8b4",
                                "text": "„Nach der kräftigen Suppe heute Mittag stand ihr nicht der Sinn nach einer weiteren warmen Mahlzeit, und so entschied Elke sich für einen Wurstsalat mit Butter und Laugensemmel.“"
                            },
                            {
                                "example_id": "bc0957b2-6cae-4f04-b447-906e1774055e",
                                "sense_id": "35550649-41ea-3f3c-9d59-aefc433ab8b4",
                                "text": "„Es gibt eine warme Laugensemmel mit eingebackener Miniweißwurst, Senf und Krautsalat, der mir verdächtig nach Kimchi aussieht, oder einen chinesischen Eintopf mit Kartoffeln.“"
                            },
                            {
                                "example_id": "89cbc09f-25fc-47c1-b28c-cadb21b7f613",
                                "sense_id": "35550649-41ea-3f3c-9d59-aefc433ab8b4",
                                "text": "„Nicht nur wegen der Zutaten, sondern auch angesichts der allgäutypischen Kreationen mit heimischen Käsesorten, Laugensemmeln statt des labbrigen Burgerbrötchens und wegen der lustigen Namen.“"
                            },
                            {
                                "example_id": "9c8c4206-6a98-4586-81d2-de681415336c",
                                "sense_id": "35550649-41ea-3f3c-9d59-aefc433ab8b4",
                                "text": "„Von jeweils zwei Scheiben Leberkäse mit süßem Senf in drei Laugensemmeln und einer Radlerhalbe gestärkt, machte er sich zwanzig Minuten später wieder an die Arbeit.“"
                            },
                            {
                                "example_id": "94df268b-8972-41f9-ab79-4d47be353724",
                                "sense_id": "35550649-41ea-3f3c-9d59-aefc433ab8b4",
                                "text": "„Es schwamm ein dicker Leberknödel darin, und obenauf waren frische Kräuter gestreut, dazu gab es eine Laugensemmel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
