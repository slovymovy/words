                {
                    "sense_id": "b6a08a7f-e765-3052-8f73-b4956c2bbf28",
                    "sense_definition": "The alignment of electron beams onto a single pixel in a cathode-ray tube display.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the <w>convergence</w> is off, the image on the old monitor will look blurry.",
                            "target_lang_translations": {
                                "ru": "Если <w>сведение</w> лучей нарушено, изображение на старом мониторе будет выглядеть размытым."
                            }
                        },
                        {
                            "text": "The technician adjusted the <w>convergence</w> to ensure the colors aligned perfectly on the screen.",
                            "target_lang_translations": {
                                "ru": "Техник отрегулировал <w>сведение</w>, чтобы цвета на экране идеально совпадали."
                            }
                        }
