                            },
                            {
                                "target_lang_word": "Rasendecke",
                                "target_lang_sense_clarification": "begrünter Boden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1877984f-ef9d-394b-852b-a2a497ed588d",
                    "sense_definition": "Variant of <w>swath</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mower left a broad <w>swart</w> of freshly cut grass behind his scythe.",
                            "target_lang_translations": {
                                "de": "Der Mäher hinterließ mit seiner Sense einen breiten <w>Schwad</w> frisch geschnittenen Grases."
                            }
                        },
                        {
                            "text": "Each stroke of the blade laid down another neat <w>swart</w> in the meadow.",
                            "target_lang_translations": {
                                "de": "Jeder Schwung der Klinge legte einen weiteren ordentlichen <w>Mahdstreifen</w> auf der Wiese ab."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional variation of swath"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Variante von swath (Schwad, Mahdstreifen)."
                    },
                    "translations": {
                        "de": [
