                        "translation_id": "2b0a8ebf-909c-4a9f-84fc-090a598fde99",
                        "source_entry_id": "3f9fc8c1-f40c-3cea-a8b4-2b2dfb90fd36",
                        "source_sense_id": "2c8174ca-abf2-3ad0-924d-7473fbffc07e",
