                                        "sense_id": "5b27d23e-bf45-3054-90b3-5b9952f01280",
                                        "entry_id": "4320abf2-9541-3e69-a097-3f6836fe9e95",
                                        "glosses": [
                                            "stumpf verletzen; eine Prellung zufügen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96619331-7622-4a74-9f0b-345e99e9e5bc",
                                                "sense_id": "5b27d23e-bf45-3054-90b3-5b9952f01280",
                                                "text": "Ich musste mit dem Turnen zwei Wochen aussetzen, da ich mich am Schienbein schmerzlich geprellt hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "565f8c57-d588-3b13-976e-300a21ba1dca",
                                        "entry_id": "4320abf2-9541-3e69-a097-3f6836fe9e95",
                                        "glosses": [
                                            "an etwas aufschlagen/von etwas zurückgeworfen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e061db2-0b60-4fc3-97c5-2987a0a050ca",
                                                "sense_id": "565f8c57-d588-3b13-976e-300a21ba1dca",
                                                "text": "Da ich die Spur verloren hatte, prellte ich mit der Stoßstange den Zaunpfahl, der in einem beinahe wieder schönen Schauspiel in tausend Teile zerbarst."
