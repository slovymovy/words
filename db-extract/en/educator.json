                        "target_lang_word": "Erzieher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzieher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25097974-e3fe-3a5f-b7e9-82ac579cabf9",
                                        "entry_id": "79b0c5e2-9e17-3b95-8eb6-8f10e5d307c1",
                                        "glosses": [
                                            "pädagogisch Berufstätiger, der Kindern und Jugendlichen soziale Verhaltensregeln und Bildungsinhalte vermittelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd5dc1dd-1bff-41c6-b209-4257b4395de6",
                                                "sense_id": "25097974-e3fe-3a5f-b7e9-82ac579cabf9",
                                                "text": "Zwei Erzieher betreuen die Ferienkinder jeden Tag und erarbeiten ein vielfältiges Programm."
                                            },
                                            {
                                                "example_id": "c0ccae00-bdd3-49de-b972-e3e22f40561d",
                                                "sense_id": "25097974-e3fe-3a5f-b7e9-82ac579cabf9",
                                                "text": "„Hermann, widerspenstig und exzentrisch, war für seine Erzieher ein Alptraum.“"
                                            },
                                            {
                                                "example_id": "351d05f7-a865-47fe-91db-e5f13a0b3d3f",
                                                "sense_id": "25097974-e3fe-3a5f-b7e9-82ac579cabf9",
                                                "text": "„Familienministerin Giffey will Erzieher finanziell besser stellen. In einem Interview forderte sie, das Gehalt deutlich anzuheben - auf das Niveau von Grundschul-Pädagogen.“"
                                            },
                                            {
                                                "example_id": "094feef9-95d3-44c9-a1b2-ae4e07c14110",
                                                "sense_id": "25097974-e3fe-3a5f-b7e9-82ac579cabf9",
                                                "text": "„Sein Bruder, der Mathematikprofessor an der Universität Padua, kam um die gleiche Zeit aus Neapel mit dem jungen Cavaliere Morosini, dessen Erzieher er war, nach Rom.“"
                                            },
                                            {
                                                "example_id": "45b946a5-279f-4910-9d05-8412b8a3beaf",
                                                "sense_id": "25097974-e3fe-3a5f-b7e9-82ac579cabf9",
                                                "text": "„Als der kleine Wilhelm seinen Heimatort verlassen mußte, konnte er nicht ahnen, daß ihm in der Person des geistlichen Onkels ein Erzieher gegeben würde, der für seinen späteren Lebenslauf die wichtigsten Impulse geben sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e92946df-baf1-44cb-8cc5-23810d77f653",
                        "source_entry_id": "f5ea0ddb-05ec-3733-92f8-75dbb0bf4b41",
                        "source_sense_id": "0ed89b99-e9a4-3ce8-a566-0f1abb351ea7",
                        "source_sense_description": "person distinguished for educational work — see also teacher",
                        "target_lang_word": "Erzieherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzieherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0109e19-0966-37db-86af-c2c6bd80a6a4",
                                        "entry_id": "0094b8a8-9e80-3319-a9fc-3ba9ce5e5ddc",
                                        "glosses": [
                                            "weibliche Person mit pädagogischen Fähigkeiten, die Kindern und Jugendlichen soziale Verhaltensregeln und Bildungsinhalte vermittelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d22e3ae3-29e9-45f4-ad31-f38b45c9063f",
                                                "sense_id": "a0109e19-0966-37db-86af-c2c6bd80a6a4",
                                                "text": "„Wie sollen sich Erzieherinnen wirksam vor dem Geräuschpegel schützen, der schon mal auf Spitzenwerte von 113 Dezibel anschwillt?“"
                                            },
                                            {
                                                "example_id": "1fde741a-1b95-4292-9135-ce914f8904ff",
                                                "sense_id": "a0109e19-0966-37db-86af-c2c6bd80a6a4",
                                                "text": "„Mickel will später für den Sohn eine Erzieherin bestellen, damit er Französisch, Rechnen und Klavierspielen lernt.“"
                                            },
                                            {
                                                "example_id": "33bfa90d-21f9-4e90-b870-14f4a3ed247f",
                                                "sense_id": "a0109e19-0966-37db-86af-c2c6bd80a6a4",
                                                "text": "„Als ich meine Laufbahn als Erzieherin begann, war ich fast noch ein Kind, und einer Gouvernante bieten sich nicht viele Gelegenheiten, Unfug zu treiben.“"
                                            },
                                            {
                                                "example_id": "a2421a1d-f692-4994-bed1-2e4199e5f57d",
                                                "sense_id": "a0109e19-0966-37db-86af-c2c6bd80a6a4",
                                                "text": "„Auch die Erzieherinnen schrien so laut, als wären die Kinder taub.“"
                                            },
                                            {
                                                "example_id": "47359b45-4bcc-4ece-a68a-0979d4bd9e13",
                                                "sense_id": "a0109e19-0966-37db-86af-c2c6bd80a6a4",
                                                "text": "„Die Spitze bildeten sechs Mädchen, die für die Erzieherinnen Aufsichts- und Kontrollaufgaben übernahmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
