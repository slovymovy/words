                "senses": [
                    {
                        "sense_id": "8820f0d1-f2f1-3e57-b06c-5042c0f5369a",
                        "entry_id": "db1da319-7396-37e7-aed2-b5fb00bbe055",
                        "glosses": [
                            "Donner un caractère collatéral à, associer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be6351d-0469-44a7-be46-781bf2c5ec6a",
                                "sense_id": "8820f0d1-f2f1-3e57-b06c-5042c0f5369a",
                                "text": "Le dispositif de Place pour collatéraliser les créances privées, discuté depuis plusieurs mois, se fonderait sur une société anonyme de titrisation (SAT) à laquelle seraient revendus, non pas directement les créances privées, mais des prêts sécurisés par ces dernières, cédés sous forme de garanties financières."
                            },
                            {
                                "example_id": "d6a46ad3-d0cb-4ada-8dc9-dbee162c32b2",
                                "sense_id": "8820f0d1-f2f1-3e57-b06c-5042c0f5369a",
                                "text": "L'usage de remettre du collatéral, ou « collatéraliser » (néologisme fréquemment utilisé) les opérations, a connu un développement constant ces dernières années, et la crise financière de 2007-2008 a bien sûr encore accru ce développement."
                            },
                            {
                                "example_id": "fe8c7038-d346-4a0a-92f7-9b32569ef13d",
                                "sense_id": "8820f0d1-f2f1-3e57-b06c-5042c0f5369a",
                                "text": "Collatéraliser les créances privées sous forme de titres."
                            }
                        ]
                    }
