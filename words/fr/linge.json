            "senses": [
                {
                    "sense_id": "f37d2c57-39b9-38a7-85b5-d44366c82230",
                    "sense_definition": "Ensemble des pièces de tissu servant à l'usage domestique ou vestimentaire, notamment le linge de maison ou les vêtements à laver.",
