                                "target_senses": [
                                    {
                                        "sense_id": "1db51741-29a5-343b-9b51-1a6c05494b2e",
                                        "entry_id": "7e3be288-5026-3164-ad4e-878d1732b277",
                                        "glosses": [
                                            "Of or pertaining to a fungus or fungi."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb9d6320-fe07-4f3e-8b13-2e98dab6d1bb",
                                                "sense_id": "1db51741-29a5-343b-9b51-1a6c05494b2e",
                                                "text": "Doctors determined that the cause of the itchy rash was fungal rather than bacterial."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fungal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "257b28b7-0ad4-3923-ae94-f52684086887",
                                        "entry_id": "27e85484-0cca-3836-9b48-4f4c281ab5a9",
                                        "glosses": [
                                            "A fungus."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "488cda03-a843-4940-bef6-0b748474c593",
                                                "sense_id": "257b28b7-0ad4-3923-ae94-f52684086887",
                                                "text": "Fungals are distinguished from Lichens by their more fugitive nature, their more succulent texture, their want of a thallus or expansion independent of the part that bears the reproductive matter, […]"
                                            },
                                            {
                                                "example_id": "37470cfc-ac60-4474-8d1e-2c9f43018ce7",
                                                "sense_id": "257b28b7-0ad4-3923-ae94-f52684086887",
                                                "text": "Fungals are, however, among the more useful friends of man as food, and among his most dangerous enemies as parasites, destroying the sources of his food."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
