                        "examples": [
                            {
                                "example_id": "63711dea-6208-4d2f-aafe-1c81859cadd8",
                                "sense_id": "a4fb6051-77e0-3dd1-b614-66e095119b24",
                                "text": "Aus den Tagebuchaufzeichnungen meiner Urgroßmutter habe ich erfahren, wie lustig und ereignisreich ihre Jugend war."
                            },
                            {
                                "example_id": "60790687-1cd8-4660-95c5-d4b2c7012f83",
                                "sense_id": "a4fb6051-77e0-3dd1-b614-66e095119b24",
                                "text": "„Es gibt aus dieser Zeit keine Tagebuchaufzeichnungen, nur wenige Briefe, und seine späteren Äußerungen sind stets von Nostalgie geprägt.“"
                            }
                        ],
