                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a81b99be-9b68-48f2-855a-6aab6d96f6ff",
                                "sense_id": "3399f43b-be6b-3b93-a0ba-27dccd0c5d36",
                                "text": "So would I (said th'enchaunter) glad and faine / Beteeme to you this sword, you to defend [...]."
