                        "source_sense_id": "d3bc65cd-17e5-33d7-9a12-494c5b2c570c",
                        "source_sense_description": "Betrieb, der aus Ton Baumaterial (zum Beispiel Ziegel) brennt",
                        "target_lang_word": "brickyard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brickyard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad981e8c-8bfa-39b0-8631-3cb1da9622cb",
                                        "entry_id": "ef298524-31ef-3b8d-a542-accdad8fd984",
                                        "glosses": [
                                            "A place where bricks are, or once were, produced or distributed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da57f949-88c2-4e41-822f-31ad8621fcb8",
                                                "sense_id": "ad981e8c-8bfa-39b0-8631-3cb1da9622cb",
                                                "text": "Since Vanita was a child, the family has roamed the country in search of work — in construction and road-building, and finally, here to this brickyard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e815745-7f0e-4f26-88ff-2e4ccb5dd0e0",
                        "source_entry_id": "3c8f2e3e-0c86-3d86-9f9d-ca97b0e888c2",
                        "source_sense_id": "d3bc65cd-17e5-33d7-9a12-494c5b2c570c",
                        "source_sense_description": "Betrieb, der aus Ton Baumaterial (zum Beispiel Ziegel) brennt",
