                "senses": [
                    {
                        "sense_id": "633ae494-ddf3-39cc-8071-3e88d1f95f34",
                        "entry_id": "f431db76-cac4-331a-a4bc-e9e7af6b0822",
                        "glosses": [
                            "(starre) Vorgabe zu Spielablauf und Spielstrategie, Programm eines Spielaufbaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d32951e8-ba42-4c06-82ff-29d2560db6fe",
                                "sense_id": "633ae494-ddf3-39cc-8071-3e88d1f95f34",
                                "text": "„Es will keine Spielrezepte liefern, die man ohne viel eigenes Nachdenken ‚abspielen’ kann, wohl aber Impulse geben, wie man zu eigenen Spielschöpfungen und kreativen Veränderungen im Spiel kommen kann.“"
                            },
                            {
                                "example_id": "22030610-15b9-44b6-b291-c8282433e70a",
                                "sense_id": "633ae494-ddf3-39cc-8071-3e88d1f95f34",
                                "text": "„Er möchte seine Figuren einfach nur aus dem ‚Stall’ holen und –sobald er seine Entwicklung abgeschlossen hat – auf ein einfaches Spielrezept zurückgreifen können.“"
                            },
                            {
                                "example_id": "544b2a9d-9004-4c9e-991f-42ac9d4b798e",
                                "sense_id": "633ae494-ddf3-39cc-8071-3e88d1f95f34",
                                "text": "„Eine solche ‚Franchise’, wie man ein erfolgreiches Spielrezept auf Englisch nennt, hat eine treue Fangemeinde und dadurch auch intakte künftige Erfolgsaussichten.“"
                            },
                            {
                                "example_id": "30743182-626b-4e30-9c56-5a9d7b86b372",
                                "sense_id": "633ae494-ddf3-39cc-8071-3e88d1f95f34",
                                "text": "„Sein Spielrezept ist höchst einfach: Er lässt uns immer wieder Blicke tun in eine Welt, worin nicht tierischer Ernst, Bosheit und Dummheit regieren, sondern der blanke, gesunde Menschenverstand, der ja stets, wenn humorlose Menschen obenauf sitzen, in den hintersten Winkel verscheucht wird.“"
                            },
                            {
                                "example_id": "3e1c01df-4a3c-4ea9-9f94-7d478d29adb2",
                                "sense_id": "633ae494-ddf3-39cc-8071-3e88d1f95f34",
                                "text": "„Dabei sind die einzelnen Modelldarstellungen nicht als situations- und adressatenbezogene Spielrezepte zu verstehen, die man unbesehen und einfach so auch für den betreffenden eigenen Tätigkeitsbereich übernehmen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
