                        "glosses": [
                            "Serving or intended to protect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a71a1ee8-6db4-4e75-b214-495a106028c1",
                                "sense_id": "541c1fd7-44b6-3669-90ff-c3c6603ab61c",
                                "text": "The fighter dropped into a protective stance."
                            },
                            {
                                "example_id": "4efd3535-6783-4ecc-9c5a-a1a908e429c1",
                                "sense_id": "541c1fd7-44b6-3669-90ff-c3c6603ab61c",
                                "text": "The castle's moat served a protective function."
                            },
                            {
                                "example_id": "0fda7f33-d663-4e64-a7c8-a12d4c7a2472",
                                "sense_id": "541c1fd7-44b6-3669-90ff-c3c6603ab61c",
                                "text": "Pour a solvent such as paint thinner, mineral spirits, or a liquid sandpaper product in a metal can or enamel bowl. Wear protective gloves."
                            }
                        ]
                    },
                    {
                        "sense_id": "951a0132-25c7-3c89-9513-84f7e4211e8f",
                        "entry_id": "eef37b15-905f-3b0d-9e65-8278ad538466",
                        "glosses": [
                            "Wishing to protect; defensive of somebody or something."
                        ],
