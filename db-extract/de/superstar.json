                "senses": [
                    {
                        "sense_id": "cfe4164d-1db7-3196-947e-9dceb8a07cbe",
                        "entry_id": "9bb640b4-93b2-34dc-ae29-e14286c5d1fd",
                        "glosses": [
                            "Person, die alle anderen Stars an Berühmtheit überragt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4e21a93-03b3-453a-b34d-0a90f4863dc8",
                                "sense_id": "cfe4164d-1db7-3196-947e-9dceb8a07cbe",
                                "text": "„Damals schien er von Chomsky Superstar fasziniert gewesen zu sein.“"
                            },
                            {
                                "example_id": "4001c977-d88c-4e8e-a4c7-1a5478284d7d",
                                "sense_id": "cfe4164d-1db7-3196-947e-9dceb8a07cbe",
                                "text": "„Aber er ist so etwas wie ein Superstar unter den Wunderheilern.“"
                            },
                            {
                                "example_id": "e5dd9061-8471-478b-8dc9-b27dc9a89d8f",
                                "sense_id": "cfe4164d-1db7-3196-947e-9dceb8a07cbe",
                                "text": "„Nur Monate nach den Dreharbeiten stieg sie zu einem der Superstars im deutschsprachigen Raum auf: Kino, TV, Theater.“"
                            },
                            {
                                "example_id": "e355aed1-8262-4057-abf6-2d9577c75340",
                                "sense_id": "cfe4164d-1db7-3196-947e-9dceb8a07cbe",
                                "text": "„Das deutsche Publikum liebt Jesse Owens, den farbigen Superstar der Spiele, wenn Hitler das anders sieht, ist das sein Problem – für kurze Zeit scheint alles möglich und die Welt ein friedlicher, großzügiger Ort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "594d6074-3cf9-4895-98db-288e7b748f41",
                        "source_entry_id": "9bb640b4-93b2-34dc-ae29-e14286c5d1fd",
                        "source_sense_id": "cfe4164d-1db7-3196-947e-9dceb8a07cbe",
                        "source_sense_description": "Person, die alle anderen Stars an Berühmtheit überragt",
                        "target_lang_word": "superstar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superstar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca01187e-834e-3350-b549-04003d431a77",
                                        "entry_id": "a5b13d45-5f9a-3a8f-b1fe-716fc896e635",
                                        "glosses": [
                                            "Someone who has accumulated a vast amount of fame; a high-level celebrity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08df2b10-e28a-3915-8709-45630c385e54",
                                        "entry_id": "a5b13d45-5f9a-3a8f-b1fe-716fc896e635",
                                        "glosses": [
                                            "An exceptionally productive employee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "006996eb-5c42-4f82-9766-cc9903de6128",
                                                "sense_id": "08df2b10-e28a-3915-8709-45630c385e54",
                                                "text": "Want to hire a coding superstar? Call the agent."
                                            },
                                            {
                                                "example_id": "70291d42-e16c-4433-b430-abeaf8534292",
                                                "sense_id": "08df2b10-e28a-3915-8709-45630c385e54",
                                                "text": "Is your organization looking for its next new hire, that superstar performer to take things to the next level? Be careful: Organizations are greater than just one individual. If you're that superstar, remember to be a good team player. You'll feel better about your job and you'll perform at an even higher level."
                                            },
                                            {
                                                "example_id": "8a643fc9-4cfc-4f34-abf2-a388aa791e04",
                                                "sense_id": "08df2b10-e28a-3915-8709-45630c385e54",
                                                "text": "\"A superstar employee that is creating that toxic work environment is probably costing that company more than he or she is bringing in,\" Martin says."
                                            },
                                            {
                                                "example_id": "9fec9462-03e4-4104-9147-14827d03d3b7",
                                                "sense_id": "08df2b10-e28a-3915-8709-45630c385e54",
                                                "text": "There's no sense in hiring a superstar developer who will quit after three months because she can't stand the management style or requires flexibility the hiring company doesn't offer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7af26103-cd96-38d4-a24b-240f69687024",
                                        "entry_id": "a5b13d45-5f9a-3a8f-b1fe-716fc896e635",
                                        "glosses": [
                                            "A giant star."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cee97210-8b3b-4e29-a165-25355991510a",
                                                "sense_id": "7af26103-cd96-38d4-a24b-240f69687024",
                                                "text": "The greater an object's mass, the greater its gravitational force. If a star could attain a certain mass --- say a million to 100 million times the mass of our own sun --- then its gravity would become 100 times as powerful as the forces generated by the strongest known nuclear reactions. Such a super superstar, in a normal course of its evolution, would contract."
                                            },
                                            {
                                                "example_id": "094c206c-729e-4f55-9823-c52c168ba8e2",
                                                "sense_id": "7af26103-cd96-38d4-a24b-240f69687024",
                                                "text": "Toward the centre of the cluster, where they were more strongly congested, the whole region glowed as though as it were a monstrous superstar."
                                            },
                                            {
                                                "example_id": "4b63ad4b-9b21-43d9-9fb4-41a00a9eed9d",
                                                "sense_id": "7af26103-cd96-38d4-a24b-240f69687024",
                                                "text": "Perhaps a supermassive cluster can coalesce to form a superstar -- a star with a mass of 1 million to 100 million solar masses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
