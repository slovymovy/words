                                    {
                                        "sense_id": "f9c8ae4f-dc6d-35df-a18b-c5918cdf2ca8",
                                        "entry_id": "8c65ea69-9286-313c-9477-4c0593a73c15",
                                        "glosses": [
                                            "Joueur de cornemuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eaa55b6-e01a-431c-9b44-413a51dadb25",
                                                "sense_id": "f9c8ae4f-dc6d-35df-a18b-c5918cdf2ca8",
                                                "text": "Elle fit entrer le vieux cornemuseur au château, et ainsi elle dansa au son de la cornemuse, même avec le vieux dragon, jusqu’à ce qu’ils fussent las."
                                            },
                                            {
                                                "example_id": "869e2726-e720-4381-a52f-637e3279052b",
                                                "sense_id": "f9c8ae4f-dc6d-35df-a18b-c5918cdf2ca8",
                                                "text": "Le bataillon anglais était précédé par deux cornemuseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfb65ddc-c2b8-3f03-a299-2e3dc98d0438",
                                        "entry_id": "8c65ea69-9286-313c-9477-4c0593a73c15",
                                        "glosses": [
                                            "Cornemuseur de l’Armée canadienne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12840d8f-2b2f-4e03-b7c6-715eb5d1ed0d",
                        "source_entry_id": "5cf2bccd-4460-33b9-8614-877a8af09f53",
                        "source_sense_id": "93c51bc3-29b6-3c73-b049-f7f0eb3ce49b",
                        "source_sense_description": "Person, die Dudelsack spielt",
                        "target_lang_word": "cornemusiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cornemusiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d86cf2dc-033b-3062-931e-3a0a1f9c0dbe",
                                        "entry_id": "8ed8533f-47f9-327c-b2a7-bd95265600c1",
                                        "glosses": [
                                            "Joueur ou joueuse de cornemuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3b6b49b-29a0-43a5-9d02-0060f5d94002",
                                                "sense_id": "d86cf2dc-033b-3062-931e-3a0a1f9c0dbe",
                                                "text": "Et voici que des guirlandes de jeunes filles, fleurs rieuses dans leurs corolles couleur de ciel, couleur d’eau, couleur de feuille, essaient la cadence des rondes dont le cornemusiste joufflu guidera aigrement les temps."
                                            },
                                            {
                                                "example_id": "6656c218-0ed7-42f6-bc46-7041a176269a",
                                                "sense_id": "d86cf2dc-033b-3062-931e-3a0a1f9c0dbe",
                                                "text": "[…] ; si l’on admet que la pénombre qui baigne le cornemusiste dépend du projecteur, comment expliquer la forte lumière qui est dardée sur le violoniste ? Pourquoi ne reçoit-il pas les ombres portées de ses voisins ?"
                                            },
                                            {
                                                "example_id": "3281c991-2a94-4348-a774-a96bfbcc5a1a",
                                                "sense_id": "d86cf2dc-033b-3062-931e-3a0a1f9c0dbe",
                                                "text": "Prenez les deux Michel, ajoutez-y le saxophoniste-clarinettiste-cornemusiste français Laurent Dehors, et vous avez le nouveau trio, toujours sans basse officielle, mais le tuba tient bien la ligne."
                                            },
                                            {
                                                "example_id": "7cd4f576-db55-4fa3-a1fb-8d1e8fc275d6",
                                                "sense_id": "d86cf2dc-033b-3062-931e-3a0a1f9c0dbe",
                                                "text": "— On dirait que rien ne s’est passé depuis l’heureux temps où les reines toisaient leurs hussards cornemusistes du centre sévère de leurs faces-à-main. C’étaient les soupapes de l'Empire, et le monde allait aussi bien que possible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
