                        ],
                        "examples": [
                            {
                                "example_id": "502967b2-b0ce-488d-8ac1-8299b24a6ee3",
                                "sense_id": "984ecd76-83b2-3ff2-8d0b-cc5e66cff0fb",
                                "text": "Il est temps d'avancer ; baissons le tapabor\nMoins nous ferons de bruit, moins il faudra d'effort."
                            },
                            {
                                "example_id": "62131d8d-7196-4ffc-8528-7c569dbd6a7c",
                                "sense_id": "984ecd76-83b2-3ff2-8d0b-cc5e66cff0fb",
                                "text": "Le large bonnet de toile ou dʼétoffe, appelé « tapabor », et des « souliers français », des galoches ou des « souliers sauvages », selon les circonstances, complétaient la tenue vestimentaire."
                            }
