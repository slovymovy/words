                "senses": [
                    {
                        "sense_id": "b1f6e050-68b6-363e-8c1f-232b9160fe7e",
                        "entry_id": "1f39761e-e630-3cf7-a04c-01b8c16ca39b",
                        "glosses": [
                            "het netjes maken van iets; het opruimen van rommel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d1df807-9ba1-4d99-b8ef-62fe3ec1e99f",
                                "sense_id": "b1f6e050-68b6-363e-8c1f-232b9160fe7e",
                                "text": "De ambulancebroeder keek naar mijn opruimwerk en sprintte naar zijn collega."
                            },
                            {
                                "example_id": "4b705abf-1701-4831-a732-c5636f617626",
                                "sense_id": "b1f6e050-68b6-363e-8c1f-232b9160fe7e",
                                "text": "Omgewaaide bomen: veel opruimwerk, maar ook een zegen voor het bos"
                            },
                            {
                                "example_id": "7e421617-d3a7-4ff2-a9a5-a59188001a43",
                                "sense_id": "b1f6e050-68b6-363e-8c1f-232b9160fe7e",
                                "text": "Terwijl de gemeenschap langzaam aan het opruimwerk begint, is het gevaar nog niet geweken. De grond is zo verzadigd dat zelfs een klein beetje regen nieuwe overstromingen kan veroorzaken. En de verwachting is dat er de komende dagen nog veel meer regen gaat vallen."
                            },
                            {
                                "example_id": "b3e31b85-8ed9-43a4-9b26-9cb6685ce724",
                                "sense_id": "b1f6e050-68b6-363e-8c1f-232b9160fe7e",
                                "text": "Aanvankelijk zei Rijkswaterstaat dat de A6 na middernacht weer open zou zijn, maar het opruimwerk duurde een paar uur langer en was pas vanochtend vroeg klaar. Rijkswaterstaat moest onder andere de grond naast de snelweg afgraven omdat daar veel olie terecht was gekomen."
                            }
                        ]
                    }
