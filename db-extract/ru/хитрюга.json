                                    {
                                        "sense_id": "6cd4a0fe-b3eb-3dc8-adc0-d4f0400f0f65",
                                        "entry_id": "e56bd57a-9a54-38ff-8710-568d13920bc3",
                                        "glosses": [
                                            "A wise man or wizard; a magician."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "990a769c-2734-417e-bb5b-552ed6e53882",
                                                "sense_id": "6cd4a0fe-b3eb-3dc8-adc0-d4f0400f0f65",
                                                "text": "Magical healing […] was the business of the cunning man, to whom the sufferer would have recourse and to whom he would normally be expected to make some form of payment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
