                    {
                        "translation_id": "d422b0f0-9590-427f-aa61-dc0cd9292086",
                        "source_entry_id": "9aabcc7b-e198-3ade-99c8-d06a22be67ef",
                        "source_sense_id": "43a82411-2470-3302-b532-4c36bb0faa71",
