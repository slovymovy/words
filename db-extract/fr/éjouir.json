                ],
                "senses": [
                    {
                        "sense_id": "47d431b7-49ed-36cd-ab90-99a02fb27aef",
                        "entry_id": "5a061c4c-e6a2-3081-aa1f-e45bdcdfe2db",
                        "glosses": [
                            "Se livrer à la joie, se réjouir."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e0b37ffa-1715-47df-9d92-a2c7831d797a",
                                "sense_id": "47d431b7-49ed-36cd-ab90-99a02fb27aef",
                                "text": "On l’emporte, on la sale, on en fait maint repas,\nDont maint voisin s’éjouit d’être."
                            },
                            {
                                "example_id": "dd9e720d-541b-4584-921a-1f85004a2e43",
                                "sense_id": "47d431b7-49ed-36cd-ab90-99a02fb27aef",
                                "text": "Ta beauté s’éjouit dans un cœur tout à toi,\nta beauté parfois frissonne\nen pensant que mon cœur sonne\ncomme d’un éternel émoi."
                            },
                            {
                                "example_id": "e21dd9b4-225b-4815-b13a-7910496aab34",
                                "sense_id": "47d431b7-49ed-36cd-ab90-99a02fb27aef",
                                "text": "Cependant, dans les crèmeries où nous passions, j’ai parfois entendu des gens de basse culture intellectuelle qui s’éjouissaient de vos facéties."
                            }
                        ]
                    },
                    {
                        "sense_id": "315fce21-bd96-338e-9b8c-eb21e8c055d5",
                        "entry_id": "5a061c4c-e6a2-3081-aa1f-e45bdcdfe2db",
                        "glosses": [
                            "Réjouir."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "427e4ce4-e649-4578-9a39-c5fa54d3002d",
                                "sense_id": "315fce21-bd96-338e-9b8c-eb21e8c055d5",
                                "text": "L’idée de causer déplaisir à Malgrison m’éjouissait beaucoup et Baduel pareillement."
                            },
                            {
                                "example_id": "ccb8b385-8a53-46b9-b873-824c9ffeb886",
                                "sense_id": "315fce21-bd96-338e-9b8c-eb21e8c055d5",
                                "text": "Chante, mon garçon, ça t’éjouira le cœur."
                            },
                            {
                                "example_id": "1f662695-cf02-4510-9514-c9cd32ff0743",
                                "sense_id": "315fce21-bd96-338e-9b8c-eb21e8c055d5",
                                "text": "– Cela m’éjouirait de voir votre nom sur la couverture d’un livre."
                            }
                        ]
                    }
                ],
