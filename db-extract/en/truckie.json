                        "examples": [
                            {
                                "example_id": "8997c975-8830-4b65-8e07-5c62623e42be",
                                "sense_id": "cf0240f0-7357-3b00-b41c-96be36ceb5a3",
                                "text": "2005, “Marcus”, quoted in Rose McCrohan, Chapter 3: I Don′t Care If I Live or Die, Keith D. Gilbert (editor), Sexuality, Sport and the Culture of Risk, Volume 6, page 45,\nI met up with a truckie and stayed on the road with him for most of the two months. I learnt how to drive the truck, even though I didn't have a truck or even a car license. I got to know other truckies and they used to ask for me on the CB radio."
                            },
                            {
                                "example_id": "f51763b2-1444-4472-85e4-85bc39b3c763",
                                "sense_id": "cf0240f0-7357-3b00-b41c-96be36ceb5a3",
                                "text": "On the day of the funeral truckies on their way to the container wharf slow down as they pass the Railway Hotel and sound their earth-shattering horns."
                            },
                            {
                                "example_id": "b632f8d5-3f06-43f2-922d-89caebe7dad9",
                                "sense_id": "cf0240f0-7357-3b00-b41c-96be36ceb5a3",
                                "text": "Look for the epitaph to a local female truckie outside the roadhouse."
                            }
                        ]
                    },
