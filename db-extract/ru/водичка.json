                        "source_entry_id": "133844cc-9095-3c96-bf27-29a1698761b1",
                        "source_sense_id": "238148aa-8098-3909-b154-2d4cd3c2eaf1",
                        "target_lang_word": "Wässerchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wässerchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50231353-123c-3bf4-b513-6a41b9f26eec",
                                        "entry_id": "be8446e3-1e29-315f-bdc3-ad512a7f0211",
                                        "glosses": [
                                            "kleines Wasser, kleines (fließendes) Gewässer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae361c5f-7850-4e78-ad69-d51eae0b41d8",
                                                "sense_id": "50231353-123c-3bf4-b513-6a41b9f26eec",
                                                "text": "„Die Löcknitz ist eines jener vielen Wässerchen in unserer Mark, die plötzlich aus einem Luch oder See tretend, auf eine kurze Strecke hin einen Parkstreifen durch unser Sand- und Heideland ziehn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "634f3970-cc19-3354-b26b-c9b10ae78e7a",
                                        "entry_id": "be8446e3-1e29-315f-bdc3-ad512a7f0211",
                                        "glosses": [
                                            "(oft hochprozentiges) alkoholisches Getränk, meist aus vergorenen Fruchtzubereitungen destilliert"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f41ea59-263f-4403-8097-1e7b3ac7a7e8",
                                                "sense_id": "634f3970-cc19-3354-b26b-c9b10ae78e7a",
                                                "text": "„Er präzisierte die Kunst des Schnapsbrennens, etwa das perfekte Abtrennen von Vor- und Nachlauf (‚Fusel-Öl‘), um jene Wässerchen zu erzeugen, mit denen sich ‚das Göschle mit Obst-Aromen tapezieren‘ lässt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
