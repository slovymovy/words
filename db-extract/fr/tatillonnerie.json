                    {
                        "sense_id": "d4e14e36-0a50-3ff5-bc52-4f13166c7b6a",
                        "entry_id": "d2d997ce-e529-3e7b-a50b-459babc5fb72",
                        "glosses": [
                            "Caractère d’une personne tatillonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f944cdf9-815f-4b85-80dd-698917f1035c",
                                "sense_id": "d4e14e36-0a50-3ff5-bc52-4f13166c7b6a",
                                "text": "Lui, naturellement, était sur des charbons ardents, vu la tournure que prenait l’affaire : car il s’agissait d’une véritable occasion ; et c’eût été péché de la voir filer comme ça, pour la tatillonnerie d’un colonel."
                            },
                            {
                                "example_id": "57c40295-8df7-46c5-8317-5103fa913215",
                                "sense_id": "d4e14e36-0a50-3ff5-bc52-4f13166c7b6a",
                                "text": "Et les garçons, qui se moquaient volontiers de la « tatillonnerie » de leur père, s’étaient montrés les rois du tatillon."
                            },
                            {
                                "example_id": "a84a2baa-d8f4-4eea-98ef-6a23f2aa1d0e",
                                "sense_id": "d4e14e36-0a50-3ff5-bc52-4f13166c7b6a",
                                "text": "Elle traquait mes manquements avec tâtillonnerie et les trouvait immanquablement."
                            }
                        ]
                    },
                    {
                        "sense_id": "acbad16f-0901-3c5a-b7fa-071a9f019616",
                        "entry_id": "d2d997ce-e529-3e7b-a50b-459babc5fb72",
                        "glosses": [
                            "Toute manifestation de ce caractère tatillon ; écrits, actes, paroles qui le traduisent."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "fb94d805-e69b-4fa4-9c18-2aad985662d5",
                                "sense_id": "acbad16f-0901-3c5a-b7fa-071a9f019616",
                                "text": "Heureuse diversion à l’ennui des tatillonneries de mon sympathique incapable."
                            },
                            {
                                "example_id": "2c2bbd54-8414-43a6-a1c3-ddd3cc626d1c",
                                "sense_id": "acbad16f-0901-3c5a-b7fa-071a9f019616",
                                "text": "Un livre ne devient vivant qu’une fois que les scribes n’ont plus eu le courage d’en recopier les développements et les tatillonneries."
                            }
                        ]
                    }
