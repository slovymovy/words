{
    "word_family": [
        "colonize",
        "colony",
        "colonial",
        "colonialism",
        "colonist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2a082f5-cabf-3666-867a-054caec642fe",
                    "sense_definition": "The process of establishing a colony in a new area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "historical_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>colonization</w> of the new territory took many years to complete.",
                            "target_lang_translations": {
                                "zh": "对这片新领土的<w>殖民</w>历经多年才完成。"
                            }
                        },
                        {
                            "text": "Historians often study the <w>colonization</w> of North America by European powers.",
                            "target_lang_translations": {
                                "zh": "历史学家经常研究欧洲列强对北美的<w>殖民化</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "settlement",
                        "colonizing"
                    ],
                    "common_phrases": [
                        "early colonization",
                        "rapid colonization"
                    ],
                    "target_lang_definitions": {
                        "zh": "在新的地区建立殖民地的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "殖民",
                                "target_lang_sense_clarification": "指建立殖民地的行为或过程。"
                            },
                            {
                                "target_lang_word": "殖民化",
                                "target_lang_sense_clarification": "指地区被殖民的过程。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af6e69f2-8385-3f07-b864-a811f93abf93",
                    "sense_definition": "The act of taking control over a region or people by a foreign power.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "historical_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>colonization</w> of the region led to significant cultural changes for the local population.",
                            "target_lang_translations": {
                                "zh": "该地区的<w>殖民统治</w>给当地居民带来了重大的文化变革。"
                            }
                        },
                        {
                            "text": "Many nations fought against the <w>colonization</w> of their lands during the nineteenth century.",
                            "target_lang_translations": {
                                "zh": "在十九世纪，许多国家奋起反抗针对其领土的<w>殖民</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "occupation",
                        "subjugation",
                        "conquest"
                    ],
                    "antonyms": [
                        "decolonization"
                    ],
                    "common_phrases": [
                        "oppose colonization",
                        "resist colonization"
                    ],
                    "target_lang_definitions": {
                        "zh": "外国势力对一个地区或人民实施控制的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "殖民统治",
                                "target_lang_sense_clarification": "指通过殖民手段进行的统治。"
                            },
                            {
                                "target_lang_word": "殖民",
                                "target_lang_sense_clarification": "指实施殖民扩张的行为。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}