                "senses": [
                    {
                        "sense_id": "5ce18353-7bec-3439-a513-0598bfabc5d4",
                        "entry_id": "2f77b779-5554-3005-b372-8cf45df88883",
                        "glosses": [
                            "mehr als einen Bereich betreffend; mehrere Bereiche umfassend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b75d3cc-bb7b-4dce-b94f-37f13aac65f2",
                                "sense_id": "5ce18353-7bec-3439-a513-0598bfabc5d4",
                                "text": "„Schließlich sei das Ziel, die Lehrlinge fachlich und praktisch nicht nur abteilungs-, sondern bereichsübergreifend auszubilden.“"
                            },
                            {
                                "example_id": "cdd80cdd-7786-47ad-918a-a597d097c3a6",
                                "sense_id": "5ce18353-7bec-3439-a513-0598bfabc5d4",
                                "text": "„Ärzte und EDV-Experten seien abteilungs- und bereichsübergreifend dabei, Abhilfe zu schaffen.“"
                            },
                            {
