                        "translation_id": "fabe199f-3298-4d74-a8f0-9f738379f11a",
                        "source_entry_id": "306984ff-d361-399f-8472-ba3c94cace3b",
                        "source_sense_id": "0ff651df-1e75-3ee7-9195-817aac285345",
                        "source_sense_description": "ehemalige Hauptstadt Kasachstans, die im Südosten des Landes liegt",
                        "target_lang_word": "Almaty",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Almaty",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9812664-57c9-3b22-96a0-b0082b5c9559",
                                        "entry_id": "cfccda0e-f3ff-385f-9e72-bcdaaaf86af1",
                                        "glosses": [
                                            "Ville et ancienne capitale du Kazakhstan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57fff1c2-8677-43f4-ac46-36a835f0b81d",
                                                "sense_id": "a9812664-57c9-3b22-96a0-b0082b5c9559",
                                                "text": "La raison officielle [du déplacement de la capitale] tient à des motifs géologiques et urbanistiques : située dans une zone sensible aux séismes, qui plus est très proche de la nouvelle frontière avec le Kirghizistan, l’ancienne capitale d’Almaty n’a plus les capacités de se développer comme elle le doit. — (Mikal Hem, Et si je devenais dictateur, traduit du norvégien par Jean-Baptiste Coursaud, Gaïa, 2017, page 174)"
                                            },
                                            {
                                                "example_id": "e9052c9d-4922-40ef-a837-17d144a5b12c",
                                                "sense_id": "a9812664-57c9-3b22-96a0-b0082b5c9559",
                                                "text": "Le mouvement de colère, qui avait éclaté dimanche dans une ville de province après une hausse des prix du gaz, s'est étendu à Almaty, capitale économique et plus grande ville du pays, dans la nuit de mardi à mercredi."
                                            },
                                            {
                                                "example_id": "2d3c4701-8d0e-4bc0-9356-631d6fd3fdeb",
                                                "sense_id": "a9812664-57c9-3b22-96a0-b0082b5c9559",
                                                "text": "Oljas Souleïmenov est né en 1936 à Alma-Ata (aujourd’hui Almaty) capitale du Kazakhstan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03fd5fe8-10e3-3003-b967-37d352fa528f",
                                        "entry_id": "cfccda0e-f3ff-385f-9e72-bcdaaaf86af1",
                                        "glosses": [
                                            "Anciennement, gouvernement kazakh."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
