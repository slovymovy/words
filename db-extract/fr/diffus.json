                                "sense_id": "2b1f3e05-4558-3e27-b6a2-b882a5ab5892",
                                "text": "Il fut pris d'un sentiment d'angoisse diffus."
                            },
                            {
                                "example_id": "7ac96abc-fd6e-47ca-99d9-a8fa09452aa1",
                                "sense_id": "2b1f3e05-4558-3e27-b6a2-b882a5ab5892",
