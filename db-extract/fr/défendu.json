                        ],
                        "examples": [
                            {
                                "example_id": "6e6deb01-9017-45db-b5c7-55f729bd252e",
                                "sense_id": "86f396dc-13d2-39f3-a141-e9aa2fca3d58",
                                "text": "— Je ne peux pas vous dire ça, mon parrain : ça m’est défendu.\n— Défendu ?\n— Oui, mon parrain ; excusez-moi si je ne réponds pas bien.\nGuillaume ne savait pas que défendu, dans l’acception berrichonne, veut dire impossible."
                            }
                        ]
