                            },
                            {
                                "target_lang_word": "eng",
                                "target_lang_sense_clarification": "allgemein für wenig Platz"
                            },
                            {
                                "target_lang_word": "begrenzt",
                                "target_lang_sense_clarification": "über räumliche Kapazitäten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e936ff48-2369-3b61-9fdd-4e880450edcd",
                    "sense_definition": "In the process of giving birth or recovering from childbirth.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the past, women were often <w>confined</w> to their rooms for weeks after delivery.",
                            "target_lang_translations": {
                                "ru": "В прошлом женщины часто были <w>прикованы</w> к своим комнатам в течение нескольких недель после родов.",
                                "de": "Früher waren Frauen nach der Entbindung oft wochenlang an ihr Zimmer <w>gebunden</w>."
                            }
                        },
                        {
                            "text": "She was <w>confined</w> with her third child during the harsh winter.",
                            "target_lang_translations": {
                                "ru": "Она <w>лежала в родах</w> с третьим ребенком во время суровой зимы.",
                                "de": "Sie lag während des strengen Winters mit ihrem dritten Kind <w>im Wochenbett</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящаяся в процессе родов или восстанавливающаяся после родов.",
                        "de": "Sich im Prozess der Entbindung befindend oder sich von der Geburt erholend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикованная к постели",
