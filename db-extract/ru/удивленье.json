                "senses": [
                    {
                        "sense_id": "ca00da24-ad34-3ad3-b9bf-fd2642d6b4da",
                        "entry_id": "05103d28-ad2b-3f90-bdee-95a18d2d33c5",
                        "glosses": [
                            "устар. удивление"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4485ff3d-8a18-4388-98cb-12600b519ec1",
                                "sense_id": "ca00da24-ad34-3ad3-b9bf-fd2642d6b4da",
                                "text": "Призывает этого Фабержея царь и говорит: так и так, надо царице к такому-то дню приготовить дорогой подарок, чтоб всем на удивленье."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9d57d0f-ac93-3784-a8f6-2d6a846df8af",
                        "entry_id": "05103d28-ad2b-3f90-bdee-95a18d2d33c5",
                        "glosses": [
                            "поэт. удивление"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9daea78f-d8f8-48f3-9127-a11b251e2b41",
                                "sense_id": "d9d57d0f-ac93-3784-a8f6-2d6a846df8af",
                                "text": "Эта нить — удивленье и горечь, — // Сколько прожито рядом годов // В гущине поэтических сборищ, // Где дурак на бессмертье готов!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59c6bd11-2f99-47a7-88ab-0f41039d1d56",
                        "source_entry_id": "05103d28-ad2b-3f90-bdee-95a18d2d33c5",
                        "target_lang_word": "surprise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surprise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                        "entry_id": "fb352ebc-f523-3c75-827e-2710312414b4",
                                        "glosses": [
                                            "Something unexpected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "664adb9f-bec1-4193-b78a-d4bc8564bc09",
                                                "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                                "text": "It was a surprise to find out I owed twice as much as I thought."
                                            },
                                            {
                                                "example_id": "e40a0c56-9f1b-484c-b45f-2f1a2f1abd1f",
                                                "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                                "text": "It came as a surprise when he succeed."
                                            },
                                            {
                                                "example_id": "99e96222-7ec0-40fb-a482-43104960340d",
                                                "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                                "text": "England were graphically illustrating the huge gulf in class between the sides and it was no surprise when Lampard added the second just before the half hour. Steven Gerrard found his Liverpool team-mate Glen Johnson and Lampard arrived in the area with perfect timing to glide a header beyond Namasco."
                                            },
                                            {
                                                "example_id": "ed1b64e4-0090-4da4-9877-8950795a2fb0",
                                                "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                                "text": "They had begun brightly but the opening goal was such a blow to their confidence it almost came as a surprise when Walcott, running through the inside-right channel, beat the offside trap and, checking back on to his left foot, turned a low shot beyond Allan McGregor in the Scotland goal."
                                            },
                                            {
                                                "example_id": "3db522ee-dc80-448d-b9e3-2abf98cf2c8e",
                                                "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                                "text": "Surprise! - A party! Awesome!"
                                            },
                                            {
                                                "example_id": "7bd90f86-c051-43f2-9e92-604fe510fdda",
                                                "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                                "text": "She bought the model as a surprise gift for a friend who is a lifelong HST fan and railwayman, and who will soon be celebrating a milestone birthday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "998456a3-a7f3-3c48-86b5-25163dfd57b0",
                                        "entry_id": "fb352ebc-f523-3c75-827e-2710312414b4",
                                        "glosses": [
                                            "Something unexpected.",
                                            "A mess of feces, left by a pet or small child in an unexpected place or at an unexpected time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2205206b-c2ea-4def-b1d7-e713bd541f7a",
                                                "sense_id": "998456a3-a7f3-3c48-86b5-25163dfd57b0",
                                                "text": "After the housecleaners drove off, the cat left a surprise for us on the carpet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36b6d41e-2651-3703-8ced-6b91fa33a147",
                                        "entry_id": "fb352ebc-f523-3c75-827e-2710312414b4",
                                        "glosses": [
                                            "The feeling that something unexpected has happened."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1e1263a-bb75-41a6-83a8-3975a273aff7",
                                                "sense_id": "36b6d41e-2651-3703-8ced-6b91fa33a147",
                                                "text": "Imagine my surprise on learning I owed twice as much as I thought I did."
                                            },
                                            {
                                                "example_id": "4b652be0-ae1a-4932-8450-df3fa03f5853",
                                                "sense_id": "36b6d41e-2651-3703-8ced-6b91fa33a147",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen.[…]The second note, the high alarum, not so familiar and always important since it indicates the paramount sin in Man’s private calendar, took most of them by surprise although they had been well prepared."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "surprise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa9464e8-236f-3bfd-b800-d2b08a899600",
                                        "entry_id": "f19b84af-debe-37a7-b62e-05a4df9ae7e1",
                                        "glosses": [
                                            "To cause (someone) to feel unusually alarmed or delighted by something unexpected."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7acfdebf-e0cf-4bd0-b7c6-4b2345fa0292",
                                                "sense_id": "aa9464e8-236f-3bfd-b800-d2b08a899600",
                                                "text": "It surprises me that I owe twice as much as I thought I did."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9462f32-8b32-3dc2-b257-c25ab65759e9",
                                        "entry_id": "f19b84af-debe-37a7-b62e-05a4df9ae7e1",
                                        "glosses": [
                                            "To do something to (a person) that they are not expecting, as a surprise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "116118db-3248-4399-b070-479b4cf51ac9",
                                                "sense_id": "a9462f32-8b32-3dc2-b257-c25ab65759e9",
                                                "text": "He doesn’t know that I’m in the country – I thought I’d turn up at his house and surprise him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e4fa1af-993e-37d5-bc56-57a6f64cd9b6",
                                        "entry_id": "f19b84af-debe-37a7-b62e-05a4df9ae7e1",
                                        "glosses": [
                                            "To undergo or witness something unexpected."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c5aeadf-0543-4d86-9ba0-dad4bbcbdfc7",
                                                "sense_id": "4e4fa1af-993e-37d5-bc56-57a6f64cd9b6",
                                                "text": "He doesn’t surprise easily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eededea1-be11-36ca-be2a-6ecc05b7abb2",
                                        "entry_id": "f19b84af-debe-37a7-b62e-05a4df9ae7e1",
                                        "glosses": [
                                            "To cause surprise."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30814010-fb1e-3c78-a702-29f3b9cdb356",
                                        "entry_id": "f19b84af-debe-37a7-b62e-05a4df9ae7e1",
                                        "glosses": [
                                            "To attack unexpectedly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39291bd9-e6ea-31cf-a039-5e57831d099c",
                                        "entry_id": "f19b84af-debe-37a7-b62e-05a4df9ae7e1",
                                        "glosses": [
                                            "To take unawares."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27f5bf4d-f004-447c-a618-9f8f2c830e7f",
                                                "sense_id": "39291bd9-e6ea-31cf-a039-5e57831d099c",
                                                "text": "\"You were right,\" replied Isabella, \"and I should not have surprised your confidence, had I not had something I wished to say. I know what you mean to do with Mr. Glentworth's gift—a marriage would scarcely be one without wedding-dresses—he has been equally generous to me, and you must keep the money till it is wanted, which, I hope, will be soon.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "surprise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b9c32cb-e337-3a63-a7a0-b7146af72a27",
                                        "entry_id": "404ba35f-be8d-36a1-b315-17f95efaf63f",
                                        "glosses": [
                                            "Drawing attention to a surprising action by oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45bd26b3-221d-4413-b387-65ecde640f9f",
                                                "sense_id": "1b9c32cb-e337-3a63-a7a0-b7146af72a27",
                                                "text": "\"Surprise!\" we shouted as we jumped out from the cupboard. \"Happy birthday!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2663fd6d-9954-3b2a-8a4c-70a8b9fc1a73",
                                        "entry_id": "404ba35f-be8d-36a1-b315-17f95efaf63f",
                                        "glosses": [
                                            "Sarcastically drawing attention to something that should have been obvious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6784f4fe-4ffc-4308-86bb-6ac65a9a3484",
                                                "sense_id": "2663fd6d-9954-3b2a-8a4c-70a8b9fc1a73",
                                                "text": "When we add code modules, we will have an additional folder called (surprise!) Modules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6c884ff-66dd-4aa2-83df-2e493439c73e",
                        "source_entry_id": "05103d28-ad2b-3f90-bdee-95a18d2d33c5",
                        "target_lang_word": "astonishment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astonishment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91100edc-68d3-350a-8e2e-14eb140258c6",
                                        "entry_id": "87e8a58c-da3b-351a-a006-a6df65a21203",
                                        "glosses": [
                                            "The feeling or experience of being astonished; great surprise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3258fafc-330c-4643-8992-c4ad354d60e4",
                                                "sense_id": "91100edc-68d3-350a-8e2e-14eb140258c6",
                                                "text": "The class looked on in astonishment as their teacher proceeded to tear the pages out of the textbook."
                                            },
                                            {
                                                "example_id": "418894e9-0d6c-413a-abaa-9927623edc75",
                                                "sense_id": "91100edc-68d3-350a-8e2e-14eb140258c6",
                                                "text": "1630, John Milton, “On Shakespear” in Poems of Mr. John Milton, London: Ruth Raworth, 1645 p. 27,\nThou in our wonder and astonishment\nHast built thy self a live-long Monument."
                                            },
                                            {
                                                "example_id": "cffc7b00-bfa5-40ea-9d99-7e54c40b4c62",
                                                "sense_id": "91100edc-68d3-350a-8e2e-14eb140258c6",
                                                "text": "[…] he dismissed all his Attendants with a turn of his Finger; at which, to my great astonishment, they vanished in an Instant, like Visions in a Dream, when we awake on a sudden."
                                            },
                                            {
                                                "example_id": "758914eb-8229-4275-a019-2865771a5bd0",
                                                "sense_id": "91100edc-68d3-350a-8e2e-14eb140258c6",
                                                "text": "At these words, Marianne’s eyes expressed the astonishment, which her lips could not utter."
                                            },
                                            {
                                                "example_id": "e96f9352-2c8b-4769-a59c-c3fb6d3782aa",
                                                "sense_id": "91100edc-68d3-350a-8e2e-14eb140258c6",
                                                "text": "Marilla’s astonishment could not have been greater if Matthew had expressed a predilection for standing on his head."
                                            },
                                            {
                                                "example_id": "88a2512a-a524-43b3-b4e5-c61aef91589f",
                                                "sense_id": "91100edc-68d3-350a-8e2e-14eb140258c6",
                                                "text": "Imagine my astonishment when, reaching the bustling street, every Englishwoman I look on is also attired in a dowdy housecoat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0e9abba-75b9-3334-b27e-d2dd0d649e36",
                                        "entry_id": "87e8a58c-da3b-351a-a006-a6df65a21203",
                                        "glosses": [
                                            "Something very surprising."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "417ce6b1-5c1d-4b10-b6d4-450e7f74d69e",
                                                "sense_id": "b0e9abba-75b9-3334-b27e-d2dd0d649e36",
                                                "text": "(colloquial)"
                                            },
                                            {
                                                "example_id": "5cf0c219-16a0-49ff-afef-ee8103a30870",
                                                "sense_id": "b0e9abba-75b9-3334-b27e-d2dd0d649e36",
                                                "text": "To find Ned Silverton among the habitual frequenters of Mrs. Hatch’s drawing-room was one of Lily’s first astonishments;"
                                            },
                                            {
                                                "example_id": "1cb85263-94f4-4c1b-ab4c-8a5e6863ce4e",
                                                "sense_id": "b0e9abba-75b9-3334-b27e-d2dd0d649e36",
                                                "text": "Everything he had seen so far — the great chocolate river, the waterfall, the huge sucking pipes, the candy meadows, the Oompa-Loompas, the beautiful pink boat, and most of all, Mr. Willy Wonka himself — had been so astonishing that he began to wonder whether there could possibly be any more astonishments left."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1abe68e9-85c1-3cd2-8b50-574e6fed3ee3",
                                        "entry_id": "87e8a58c-da3b-351a-a006-a6df65a21203",
                                        "glosses": [
                                            "Loss of physical sensation; inability to move a part of the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b95b402c-baa2-40d0-bdd3-3ab56ad28d0e",
                                                "sense_id": "1abe68e9-85c1-3cd2-8b50-574e6fed3ee3",
                                                "text": "[…] there followeth astonishment of the leg that is neere, that it can neither be stretched out right, nor he cannot go on his feet."
                                            },
                                            {
                                                "example_id": "ae579d04-669e-4702-85d5-8a523c12317c",
                                                "sense_id": "1abe68e9-85c1-3cd2-8b50-574e6fed3ee3",
                                                "text": "[…] whosoever maketh water in the same place where a dog hath newly pissed, so as both vrines be mingled together, shall immediatly find a coldnesse and astonishment in his loines,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "029d4bb3-2a6d-392f-9852-d0e6252765e8",
                                        "entry_id": "87e8a58c-da3b-351a-a006-a6df65a21203",
                                        "glosses": [
                                            "Loss of mental faculties, inability to think or use one's senses."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5d14663-6ff3-477b-b015-3cd650db0fcb",
                                                "sense_id": "029d4bb3-2a6d-392f-9852-d0e6252765e8",
                                                "text": "Thou hast shewed thy people hard things: thou hast made us to drink the wine of astonishment."
                                            },
                                            {
                                                "example_id": "78024f66-0647-4320-a695-02d48b732ec1",
                                                "sense_id": "029d4bb3-2a6d-392f-9852-d0e6252765e8",
                                                "text": "Upon the Stage he so charmed the people into astonishment with his babble, that he made them buy off amain his Drugs;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61fa4d64-9e22-3c79-a0a1-16f738813eb8",
                                        "entry_id": "87e8a58c-da3b-351a-a006-a6df65a21203",
                                        "glosses": [
                                            "Loss of composure or presence of mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c93f791a-bc28-4b45-b512-15a6679d2cb5",
                                                "sense_id": "61fa4d64-9e22-3c79-a0a1-16f738813eb8",
                                                "text": "[…] where of his cruell rage\nNigh dead with feare, and faint astonishment,\nShee found them both in darkesome corner pent;"
                                            },
                                            {
                                                "example_id": "488aa5cf-2ccd-4d10-8414-3f0dd10b8669",
                                                "sense_id": "61fa4d64-9e22-3c79-a0a1-16f738813eb8",
                                                "text": "[…] as when a man ignorant of the Ceremonies of Court, comming into the presence of a greater Person than he is used to speak to, and stumbling at his entrance, to save himselfe from falling, lets slip his Cloake; to recover his Cloake, lets fall his Hat; and with one disorder after another, discovers his astonishment and rusticity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
