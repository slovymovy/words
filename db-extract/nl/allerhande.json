                                "sense_id": "c8107e19-fa9d-3d72-b8f1-b66bbddc8101",
                                "text": "We hebben in dat park allerhande dieren gezien."
                            },
                            {
                                "example_id": "554eb1a1-4398-4b66-b2a1-54501bcae4a7",
                                "sense_id": "c8107e19-fa9d-3d72-b8f1-b66bbddc8101",
                                "text": "Het grote raam met uitzicht over het zuiden van de stad zorgde voor een uitbundige lichtinval waarin zowel azalea's, bougainvilles als allerhande palmen voortreffelijk konden gedijen."
                            },
                            {
                                "example_id": "9ac280a8-6d6f-44cc-8854-b2a957fcfeb8",
                                "sense_id": "c8107e19-fa9d-3d72-b8f1-b66bbddc8101",
                                "text": "Allerhande flauwiteiten werden beschouwd als ernstig te nemen gespreksonderwerpen."
                            }
                        ]
