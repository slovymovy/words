                        "entry_id": "f125f035-8ad5-3b8d-a733-5d989a8ebe1d",
                        "glosses": [
                            "girl, chick, girlfriend, lady friend (a woman as an object of desire or as a partner in an unmarried romantic relationship)"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "133ae3cb-f68a-4c7b-b728-b6973cb3c67a",
                                "sense_id": "9007e558-7c7f-3ddc-b501-64b95f74a955",
                                "text": "Я то́же, зна́ешь, кое-чего́ плани́ровал. А планировал я развлечься с одной классной ка́дрой — Ната́шкой.",
                                "translation": "You know, I was also planning to do something. And what I was planning was to have some fun with this cool chick called Natasha.",
                                "english": "You know, I was also planning to do something. And what I was planning was to have some fun with this cool chick called Natasha."
                            }
                        ]
                    }
