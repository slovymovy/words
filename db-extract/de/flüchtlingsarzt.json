                "senses": [
                    {
                        "sense_id": "00861c04-03d0-3689-9750-5bee96d19fff",
                        "entry_id": "99c87e96-751c-32cd-9462-f05d336c2b3f",
                        "glosses": [
                            "ein Arzt, der sich um die medizinischen Belange von Flüchtlingen kümmert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3e6b900-e1ff-462c-997d-6ee79b9fe258",
                                "sense_id": "00861c04-03d0-3689-9750-5bee96d19fff",
                                "text": "„Ein Flüchtlingsarzt ist meistens eher in der Lage, dem Flüchtlingspatienten bisher abgelehnte örtliche Kulturwerte zu vermitteln als irgendjemand. Er ist in seiner Rolle eine Randfigur zwischen der Mehrheit und der Minderheit.“"
                            },
                            {
                                "example_id": "bc604360-e386-40db-b4d2-077ac487580a",
                                "sense_id": "00861c04-03d0-3689-9750-5bee96d19fff",
                                "text": "„Lüth war ein Schulfreund von Peters, der im Krieg als Feldunterarzt eingesetzt war und nach 1945 als Flüchtlingsarzt arbeitete sowie später als Journalist bei der FAZ volontierte.“"
                            },
                            {
                                "example_id": "68594467-3356-4eb3-ba98-cdfef8a55d70",
                                "sense_id": "00861c04-03d0-3689-9750-5bee96d19fff",
                                "text": "„Spätestens seit 1947 gab es auch einen eigenen Flüchtlingsarzt, der von der Caritas fest angestellt war und für die Behandlung der Heimbewohner von ihr honoriert wurde.“"
                            },
                            {
                                "example_id": "c68ea52e-8a68-48ac-8df7-4c941a16884e",
                                "sense_id": "00861c04-03d0-3689-9750-5bee96d19fff",
                                "text": "„Schon am 25.06.1948 hatte der Flüchtlingsarzt Dr. Reichner dringend um Unterstützung bei der Zusammenführung der Familien gebeten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
