                                "tr": "<w>Zevkler</w> ve renkler tartışılmaz.",
                                "es": "Sobre <w>gustos</w> no hay nada escrito."
                            }
                        },
                        {
                            "text": "Zij heeft een uitstekende <w>smaak</w> wat betreft kleding en inrichting.",
                            "target_lang_translations": {
                                "en": "She has excellent <w>taste</w> regarding clothing and decor.",
                                "ru": "У нее отличный <w>вкус</w> в одежде и интерьере.",
                                "pl": "Ona ma doskonały <w>gust</w> jeśli chodzi o ubrania i wystrój wnętrz.",
                                "de": "Sie hat einen hervorragenden <w>Geschmack</w> in Bezug auf Kleidung und Einrichtung.",
                                "fr": "Elle a un <w>goût</w> excellent en matière de vêtements et de décoration.",
                                "it": "Lei ha un ottimo <w>gusto</w> per l'abbigliamento e l'arredamento.",
                                "cs": "Má vynikající <w>vkus</w>, pokud jde o oblečení a zařizování.",
                                "tr": "Giyim ve dekorasyon konusunda mükemmel bir <w>zevke</w> sahip.",
                                "es": "Ella tiene un <w>gusto</w> excelente en cuanto a ropa y decoración."
                            }
                        },
                        {
                            "text": "Dat schilderij is helemaal niet naar mijn <w>smaak</w>.",
                            "target_lang_translations": {
                                "en": "That painting is not to my <w>taste</w> at all.",
                                "ru": "Эта картина совсем не в моем <w>вкусе</w>.",
                                "pl": "Ten obraz zupełnie nie jest w moim <w>guście</w>.",
                                "de": "Dieses Gemälde ist überhaupt nicht nach meinem <w>Geschmack</w>.",
                                "fr": "Ce tableau n'est pas du tout à mon <w>goût</w>.",
                                "it": "Quel quadro non è affatto di mio <w>gusto</w>.",
                                "cs": "Ten obraz není vůbec podle mého <w>vkusu</w>.",
                                "tr": "O tablo hiç benim <w>zevkime</w> göre değil.",
                                "es": "Ese cuadro no es para nada de mi <w>gusto</w>."
                            }
                        }
