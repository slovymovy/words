                        "translation_id": "6c05a706-5b78-471b-b955-3e0be916a92b",
                        "source_entry_id": "8a620fa3-721a-3546-99ff-96769f80b4e8",
                        "source_sense_id": "1006f654-742e-32a5-8f86-3ac87503a67b",
                        "target_lang_word": "Glücksspiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glücksspiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50d9469a-a94f-3ba7-a310-920f5b703caf",
                                        "entry_id": "cb89f496-e888-3299-8906-fbf463ad6b83",
                                        "glosses": [
                                            "Spiel, bei dem Gewinnen und Verlieren hauptsächlich vom Glück abhängt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c501ed8d-75b5-4e1f-b367-43525353f792",
                                                "sense_id": "50d9469a-a94f-3ba7-a310-920f5b703caf",
                                                "text": "Er gewann beim Glücksspiel fünfzig Euro."
                                            },
                                            {
                                                "example_id": "9b7e361c-9093-4bbe-b06b-abb1c012bb31",
                                                "sense_id": "50d9469a-a94f-3ba7-a310-920f5b703caf",
                                                "text": "„Nach geltendem finnischen Recht – und da ist der Finne ein Pedant wie europäisch sonst höchstens noch der Deutsche und der Schweizer – darf Steuergeld nicht für Glücksspiele ausgegeben werden.“"
                                            },
                                            {
                                                "example_id": "4ed00fdc-a868-456c-9b2b-c41c16d2d6a5",
                                                "sense_id": "50d9469a-a94f-3ba7-a310-920f5b703caf",
                                                "text": "„Im Glücksspiel erwartet jeden mit der gleichen Wahrscheinlichkeit die Chance, einmal Sieger zu werden und das Gefühl des Siegers genießen zu können.“"
                                            },
                                            {
                                                "example_id": "bc3f1ca6-beee-4921-ab9c-f573db8e6630",
                                                "sense_id": "50d9469a-a94f-3ba7-a310-920f5b703caf",
                                                "text": "„Wir haben festgestellt, dass die Verbrüderung mit den Sozialwissenschaften die Werbung weniger zum Glücksspiel als vielmehr zur Kapitalanlage macht.“"
                                            },
                                            {
                                                "example_id": "f61aab79-86f3-4b88-b571-a4d8c13463ad",
                                                "sense_id": "50d9469a-a94f-3ba7-a310-920f5b703caf",
                                                "text": "„Gegen Ende des Jahres 1774 verbot ein Gesetz des Großen Rates alle Glücksspiele, und der sogenannte Ridotto mußte geschlossen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9ed3e35-f20f-456d-acc4-44a67116b2db",
