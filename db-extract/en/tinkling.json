                "forms": [],
                "senses": [
                    {
                        "sense_id": "0dcc5dd2-c6cb-3b00-987b-eb65cb021119",
                        "entry_id": "0da23134-f7c6-3414-a8da-9fe827007ac7",
                        "glosses": [
                            "That tinkles."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f1357e2e-6d48-4335-a410-023ff83df3d8",
                                "sense_id": "0dcc5dd2-c6cb-3b00-987b-eb65cb021119",
                                "text": "\"A tinkling piano in the next apartment, / Those stumbling words that told you what my heart meant, / A fairground's painted swings... / These foolish things remind me of you."
                            },
                            {
                                "example_id": "32ee8f50-6901-4d25-a655-df274082b433",
                                "sense_id": "0dcc5dd2-c6cb-3b00-987b-eb65cb021119",
                                "text": "American Christians, you may master the intricacies of the English language and you may possess the eloquence of articulate speech; but even though you speak with the tongues of men and of angels, and have not love, you are like sounding brass or a tinkling cymbal."
                            }
                        ]
                    },
                    {
                        "sense_id": "0846d541-ec27-35fb-9bf5-0b51fb7867de",
                        "entry_id": "0da23134-f7c6-3414-a8da-9fe827007ac7",
                        "glosses": [
                            "That works as a tinker"
