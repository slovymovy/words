            "senses": [
                {
                    "sense_id": "a3a05080-5c0c-3158-b140-a2737b6ab5c2",
                    "sense_definition": "Wegen fehlender Luft oder Sauerstoff sterben oder in schwere Atemnot geraten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ersticken_atemnot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bei dem Brand im Wohnhaus drohten viele Bewohner im dichten Rauch zu <w>ersticken</w>."
                        },
                        {
                            "text": "Das Kind verschluckte ein kleines Spielzeug und drohte daran zu <w>ersticken</w>."
                        }
                    ],
                    "common_phrases": [
                        "im Rauch ersticken",
                        "an einem Fremdkörper ersticken"
                    ]
                },
                {
                    "sense_id": "27123793-8bb0-3000-b95f-3e8c0cad8ae6",
                    "sense_definition": "Jemanden oder ein Lebewesen töten, indem man die Zufuhr von Atemluft gewaltsam abschnürt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ersticken_toeten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Einbrecher versuchte vergeblich, den schlafenden Mann mit einem dicken Kissen zu <w>ersticken</w>."
                        },
                        {
                            "text": "In alten Kriminalromanen liest man oft von Mördern, die ihre Opfer lautlos <w>erstickten</w>."
                        }
                    ],
                    "common_phrases": [
                        "mit einem Kissen ersticken"
                    ]
                },
                {
                    "sense_id": "3773b7a0-4a77-3fe4-889c-11809b30daa5",
                    "sense_definition": "Ein Feuer oder Flammen löschen, indem man ihnen den Sauerstoff entzieht",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ersticken_feuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Einen brennenden Topf in der Küche sollte man schnell mit einem Deckel <w>ersticken</w>."
                        },
                        {
                            "text": "Die Feuerwehrleute konnten die Flammen rechtzeitig mit einer Löschdecke <w>ersticken</w>."
                        }
                    ],
                    "common_phrases": [
                        "die Flammen ersticken",
                        "ein Feuer ersticken"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ab3e4e1-0b5d-3662-92f3-98d6b7bdd344",
                    "sense_definition": "Der Tod oder drohende Tod infolge mangelnder Sauerstoffzufuhr bei der Atmung",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ersticken_atemnot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als Todesursache stellte der Gerichtsmediziner eindeutig das <w>Ersticken</w> durch giftigen Rauch fest."
                        },
                        {
                            "text": "Die schnelle Rettung durch den Notarzt bewahrte die verletzte Person vor dem sicheren <w>Ersticken</w>."
