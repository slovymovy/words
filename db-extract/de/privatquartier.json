                "senses": [
                    {
                        "sense_id": "39d1acb3-fd4d-39ce-8171-5cef33dbeb08",
                        "entry_id": "c6f0a63f-6594-3441-bc8f-223635f4a43c",
                        "glosses": [
                            "Unterkunft bei Privatleuten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd3d47c3-213f-42ef-8331-5a09adcf2c3e",
                                "sense_id": "39d1acb3-fd4d-39ce-8171-5cef33dbeb08",
                                "text": "„Privatquartiere sind genügend vorhanden, auch kleine Gasthöfe, allerdings mit recht unterschiedlichem Komfort.“"
                            },
                            {
                                "example_id": "ef448449-87a4-4ea3-af4b-315e42d77eb4",
                                "sense_id": "39d1acb3-fd4d-39ce-8171-5cef33dbeb08",
                                "text": "„Eine Unterbringung in Privatquartieren ist grundsätzlich nur bei Bestehen eines mittels Vertrages nachgewiesenen Hauptmietverhältnisses möglich.“"
                            },
                            {
                                "example_id": "2941f9ab-6241-4eef-838a-f36a04efc024",
                                "sense_id": "39d1acb3-fd4d-39ce-8171-5cef33dbeb08",
                                "text": "„Das Privatquartier war ein helles, schönes Haus mit einem großen Garten davor, und in diesem Haus wohnte die Familie B., Herr B., Frau B. und ein kleines Kind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
