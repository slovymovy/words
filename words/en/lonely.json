{
    "word_family": [
        "loneliness",
        "lonesome",
        "loner",
        "lone"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eb06ed95-0f73-3afd-bfed-442ccd03c773",
                    "sense_definition": "Unhappy due to feeling isolated from contact with other people.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "feeling_isolated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt very <w>lonely</w> after her best friend moved to another city.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя очень <w>одинокой</w> после того, как её лучшая подруга переехала в другой город.",
                                "tr": "En iyi arkadaşı başka bir şehre taşındıktan sonra kendini çok <w>yalnız</w> hissetti."
                            }
                        },
                        {
                            "text": "It can be hard to get <w>lonely</w> when you have so many hobbies.",
                            "target_lang_translations": {
                                "ru": "Трудно чувствовать себя <w>одиноким</w>, когда у тебя так много увлечений.",
                                "tr": "Bu kadar çok hobin varken <w>yalnızlık</w> çekmek zor olabilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "lonesome"
                    ],
                    "common_phrases": [
                        "feel lonely",
                        "get lonely",
                        "lonely heart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий грусть или тоску из-за отсутствия общения с другими людьми.",
                        "tr": "Başka insanlarla iletişimden soyutlanmış hissetmekten dolayı üzgün veya mutsuz olma durumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одино́кий",
                                "target_lang_sense_clarification": "испытывающий чувство одиночества"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yalnız",
                                "target_lang_sense_clarification": "kendini yalnız ve mutsuz hisseden kişi"
                            },
                            {
                                "target_lang_word": "yapayalnız",
                                "target_lang_sense_clarification": "tamamen yalnız ve kimsesiz hisseden kişi"
                            },
                            {
                                "target_lang_word": "kimsesiz",
                                "target_lang_sense_clarification": "yakını veya destekçisi olmayan, kendisini çaresiz hisseden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b8e92fc-a432-3871-8dc2-55bba49ce7ae",
                    "sense_definition": "Unfrequented by people; desolate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "place_isolation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old cabin stood on a <w>lonely</w> hill far away from the village.",
                            "target_lang_translations": {
                                "ru": "Старая хижина стояла на <w>уединённом</w> холме вдалеке от деревни.",
                                "tr": "Eski kulübe, köyden uzakta <w>ıssız</w> bir tepede duruyordu."
                            }
                        },
                        {
                            "text": "They drove down a <w>lonely</w> road without seeing another car for miles.",
                            "target_lang_translations": {
                                "ru": "Они ехали по <w>безлюдной</w> дороге, не встречая других машин на протяжении многих миль.",
                                "tr": "Millerce başka bir araba görmeden <w>tenha</w> bir yolda ilerlediler."
                            }
                        }
                    ],
                    "synonyms": [
                        "desolate",
                        "empty",
                        "unpopulated",
                        "unpeopled"
                    ],
                    "antonyms": [
                        "crowded",
                        "busy"
                    ],
                    "common_phrases": [
                        "lonely place",
                        "lonely road",
                        "lonely street"
                    ],
                    "target_lang_definitions": {
                        "ru": "Малопосещаемый людьми; пустынный или находящийся вдали от других.",
                        "tr": "İnsanların pek uğramadığı, az kişinin bulunduğu; ıssız, tenha."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уединённый",
                                "target_lang_sense_clarification": "скрытый, тихий, вдали от людных мест"
                            },
                            {
                                "target_lang_word": "безлю́дный",
                                "target_lang_sense_clarification": "пустынный, необитаемый"
                            },
                            {
                                "target_lang_word": "одино́кий",
                                "target_lang_sense_clarification": "стоящий отдельно, изолированный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ıssız",
                                "target_lang_sense_clarification": "kimsenin bulunmadığı, terk edilmiş gibi duran yer"
                            },
                            {
                                "target_lang_word": "tenha",
                                "target_lang_sense_clarification": "az insanın bulunduğu veya boş olan yer"
                            },
                            {
                                "target_lang_word": "yalnız",
                                "target_lang_sense_clarification": "sapa, gözden uzak kalan yer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cccebcd-725a-3e87-8aa7-c75fed878f18",
                    "sense_definition": "Without companions; solitary.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "state_of_being_alone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>lonely</w> figure was seen walking along the edge of the cliff.",
                            "target_lang_translations": {
                                "ru": "<w>Одинокая</w> фигура была замечена идущей вдоль края обрыва.",
                                "tr": "Uçurumun kenarında yürüyen <w>yalnız</w> bir karaltı görüldü."
                            }
                        },
                        {
                            "text": "The <w>lonely</w> traveler set up camp before the sun went down.",
                            "target_lang_translations": {
                                "ru": "<w>Одинокий</w> путник разбил лагерь до того, как зашло солнце.",
                                "tr": "<w>Yalnız</w> gezgin güneş batmadan önce kampını kurdu."
                            }
                        }
                    ],
                    "synonyms": [
                        "solitary",
                        "alone",
                        "unaccompanied"
                    ],
                    "antonyms": [
                        "accompanied"
                    ],
                    "common_phrases": [
                        "lonely figure",
                        "lonely traveler"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся без спутников или компаньонов.",
                        "tr": "Yanında arkadaşı veya refakatçisi olmayan; tek başına."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одино́кий",
                                "target_lang_sense_clarification": "находящийся один, без компании"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yalnız",
                                "target_lang_sense_clarification": "yanında başkası olmadan tek başına bulunan kişi veya şey"
                            },
                            {
                                "target_lang_word": "tek başına",
                                "target_lang_sense_clarification": "yanında kimse olmadan"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}