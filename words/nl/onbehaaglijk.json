    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bc0511ac-ddae-3e81-a8de-e490d5838502",
                    "sense_definition": "niet prettig, fijn of aangenaam; een gevoel van ongemak gevend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gevoel van ongemak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sfeer in de kamer was erg <w>onbehaaglijk</w> nadat de ruzie was begonnen.",
                            "target_lang_translations": {
                                "en": "The atmosphere in the room was very <w>unpleasant</w> after the argument started."
                            }
                        },
                        {
                            "text": "Hij voelde zich <w>onbehaaglijk</w> dicht bij de vreemdeling staan in de drukke lift.",
                            "target_lang_translations": {
                                "en": "He felt <w>uncomfortably</w> close to the stranger in the crowded elevator."
                            }
                        }
                    ],
                    "synonyms": [
                        "onaangenaam",
                        "oncomfortabel",
                        "ongemakkelijk",
                        "vervelend"
                    ],
                    "antonyms": [
                        "behaaglijk"
                    ],
                    "common_phrases": [
                        "onbehaaglijk voelen",
                        "onbehaaglijk dicht"
                    ],
                    "target_lang_definitions": {
                        "en": "not pleasant, fine, or agreeable; giving a feeling of discomfort"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uncomfortable",
                                "target_lang_sense_clarification": "causing physical or mental unease"
                            },
                            {
                                "target_lang_word": "unpleasant",
                                "target_lang_sense_clarification": "not pleasing or enjoyable"
                            },
                            {
                                "target_lang_word": "uneasy",
                                "target_lang_sense_clarification": "feeling anxiety or discomfort"
                            },
                            {
                                "target_lang_word": "awkward",
                                "target_lang_sense_clarification": "causing embarrassment or social discomfort"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a311dfee-45aa-3697-8678-fb32a16b024c",
                    "sense_definition": "op een manier die niet prettig of comfortabel aanvoelt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gevoel van ongemak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De twee presentatoren zaten <w>onbehaaglijk</w> dicht tegen elkaar aan de tafel.",
                            "target_lang_translations": {
                                "en": "The two presenters sat <w>uncomfortably</w> close to each other at the table."
                            }
                        },
                        {
                            "text": "Zij keek hem <w>onbehaaglijk</w> aan toen hij die vreemde vraag stelde.",
                            "target_lang_translations": {
                                "en": "She looked at him <w>uneasily</w> when he asked that strange question."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongemakkelijk",
                        "onaangenaam"
                    ],
                    "antonyms": [
                        "behaaglijk"
                    ],
                    "common_phrases": [
                        "onbehaaglijk dicht"
                    ],
                    "target_lang_definitions": {
                        "en": "in a manner that does not feel pleasant or comfortable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uncomfortably",
                                "target_lang_sense_clarification": "in a way that causes physical or mental unease"
                            },
                            {
                                "target_lang_word": "uneasily",
                                "target_lang_sense_clarification": "in a way that shows anxiety or discomfort"
                            },
                            {
                                "target_lang_word": "awkwardly",
                                "target_lang_sense_clarification": "in a socially uncomfortable manner"
                            }
                        ]
                    }
                }
            ]
        }
    ]
