                    "frequency": "High",
                    "semantic_group_id": "finanzielle_absicherung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor einer langen Auslandsreise sollte man sich unbedingt gegen Krankheit und Unfälle <w>versichern</w>."
                        },
                        {
                            "text": "Mein Bruder möchte sein neues Auto gegen Diebstahl bei einer bekannten Gesellschaft <w>versichern</w>."
                        }
                    ],
                    "common_phrases": [
