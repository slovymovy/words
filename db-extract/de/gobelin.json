                        ],
                        "form": "die Gobelins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                        "entry_id": "fd2041c1-190a-3916-9474-bf95c23ba600",
                        "glosses": [
                            "Wandteppich mit kunstvollen Stickereien, die Muster oder Bildszenen darstellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34566f36-587b-40c4-9acc-afe1a9ce91d6",
                                "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                "text": "„An einer Wand hängt ein großes Landschaftsgemälde, an einer anderen ein Gobelin.“"
                            },
                            {
                                "example_id": "7da0a768-4691-4696-bef1-412eb28c669e",
                                "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                "text": "„Ruge hatte sich vorn in den Sessel mit der hohen Lehne gesetzt, dessen gestickte Polster an Gobelins erinnerten.“"
                            },
                            {
                                "example_id": "1ed4a375-2932-44f9-ace9-e4cab7a471a1",
                                "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                "text": "„Die Burgunder eilen die Ehrentreppe hinauf, vorbei an den Marmorlöwen auf den Absätzen, vorbei an den Gobelins, die die Wände schmücken.“"
                            },
                            {
                                "example_id": "26dad7a4-254a-42cc-89da-fed06e4e2017",
                                "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                "text": "„Nahrung zu requirieren sei reine Notdurft, sagte er, bei Bildern und Gobelins fange die Räuberei an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57fb3ac7-760a-4857-8ea7-c374252e0fe3",
                        "source_entry_id": "fd2041c1-190a-3916-9474-bf95c23ba600",
                        "source_sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                        "source_sense_description": "Wandteppich mit kunstvollen Stickereien, die Muster oder Bildszenen darstellen",
                        "target_lang_word": "tapestry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tapestry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ac570c5-d9d8-3b43-b9c0-ce33409e9f2d",
                                        "entry_id": "0c091ab8-47a4-3649-bfd6-7adcd99cab86",
                                        "glosses": [
                                            "A heavy woven cloth, often with decorative pictorial designs, normally hung on walls."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2f8e402-17cd-4752-917b-fa37e71a0b4e",
                                                "sense_id": "7ac570c5-d9d8-3b43-b9c0-ce33409e9f2d",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75de2674-b082-39b6-8b9f-58bc21ef1bd0",
                                        "entry_id": "0c091ab8-47a4-3649-bfd6-7adcd99cab86",
                                        "glosses": [
                                            "Anything with variegated or complex details."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03a1811e-6ed5-4cea-85e6-b822ebe44500",
                                                "sense_id": "75de2674-b082-39b6-8b9f-58bc21ef1bd0",
                                                "text": "European adventurers found themselves within a watery world, a tapestry of streams, channels, wetlands, lakes and lush riparian meadows enriched by floodwaters from the Mississippi River."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tapestry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5635b707-9ce7-3156-b094-ffcae8107f0b",
                                        "entry_id": "372ba6a4-f63e-3db1-8e6f-bd58b6af271e",
                                        "glosses": [
                                            "To decorate with tapestry, or as if with a tapestry."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9564d2f-34e9-4ba2-9dd0-460f3974aecc",
                                                "sense_id": "5635b707-9ce7-3156-b094-ffcae8107f0b",
                                                "text": "We had run above twenty miles when the sun set, carpeting the sea, and tapestrying the sky with a rare unison of delicate green and golden hues […]"
                                            },
                                            {
                                                "example_id": "1906b962-bdc2-48a4-be4e-49f3828df31f",
                                                "sense_id": "5635b707-9ce7-3156-b094-ffcae8107f0b",
                                                "text": "The banqueting-hall, all open to the sky, and with thick curtains of ivy tapestrying the walls, and grass and weeds growing on the arches that overpass it, is indescribably beautiful."
                                            },
                                            {
                                                "example_id": "6ffc314c-1242-4cef-9477-62a1c2a23da0",
                                                "sense_id": "5635b707-9ce7-3156-b094-ffcae8107f0b",
                                                "text": "I present Bosnavina to its Duchess, I kiss the hem of her Majesty's robe and will tapestry her Palace with conquered flags."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2c69c1e-5fbf-4287-9818-6366408d4049",
                        "source_entry_id": "fd2041c1-190a-3916-9474-bf95c23ba600",
                        "source_sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                        "source_sense_description": "Wandteppich mit kunstvollen Stickereien, die Muster oder Bildszenen darstellen",
                        "target_lang_word": "gobelin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gobelin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84214a70-3a92-3a4c-9474-b1d4c96f61a8",
                                        "entry_id": "6399cd30-8d07-3c24-af49-f0b0886eb55a",
                                        "glosses": [
                                            "Esprit follet, lutin."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7835ce9a-ff79-465d-8c2e-4214e828b9bb",
                                                "sense_id": "84214a70-3a92-3a4c-9474-b1d4c96f61a8",
                                                "text": "M. Mabeuf s’était mis à feuilleter et à lire, à l’aide de ses lunettes, deux livres qui le passionnaient, et même, chose plus grave à son âge, le préoccupaient […]. Le premier de ces livres était le fameux traité du président Delancre, De l’inconstance des démons, l’autre était l’in-quarto de Mutor de la Rubaudière, Sur les diables de Vauvert et les gobelins de la Bièvre. Ce dernier bouquin l’intéressait d’autant plus que son jardin avait été un des terrains anciennement hantés par les gobelins."
                                            },
                                            {
                                                "example_id": "f2b3816e-47e8-4aee-9f39-18b2fcce4282",
                                                "sense_id": "84214a70-3a92-3a4c-9474-b1d4c96f61a8",
                                                "text": "Des êtres surnaturels, répondit le magister Hermod d’une voix qui imposait. Pourquoi ne seraient-ce pas des esprits, des babeaux, des gobelins, peut-être même quelques-unes de ces dangereuses lamies, qui se présentent sous la forme de belles femmes…"
                                            },
                                            {
                                                "example_id": "5e5df12b-5d0e-40b4-a903-dc29324305ea",
                                                "sense_id": "84214a70-3a92-3a4c-9474-b1d4c96f61a8",
                                                "text": "Je suppose qu’elle avait besoin d’avoir une preuve de plus que cet endroit a été hanté, et qu’elle se l’est offerte à mes dépens. Eh bien oui, il l’est ; il est tout rempli de spectres et de gobelins. Vous avez bien raison de le tenir fermé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gobelin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86bde05c-31ba-35a0-9d59-6dd015fd082e",
                                        "entry_id": "d6c118a9-4726-39ed-aa45-5b5fc47141d4",
                                        "glosses": [
                                            "Tapisserie provenant de la manufacture des Gobelins ou tapisserie de même style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd974286-e9b3-4eeb-8d44-9e92088f9291",
                                                "sense_id": "86bde05c-31ba-35a0-9d59-6dd015fd082e",
                                                "text": "Au mur, il y a quelques Gobelins prêtés à l'occasion de la visite de l'empereur de Russie et qui sont restés."
                                            },
                                            {
                                                "example_id": "6b2c4656-a69a-42d8-a978-08025adecfd5",
                                                "sense_id": "86bde05c-31ba-35a0-9d59-6dd015fd082e",
                                                "text": "Les rideaux en faux Gobelins, écartés pour laisser apparaître le lit, venaient aggraver ce spectacle de leurs verts tirant sur le gris, leurs bordeaux délayés, leurs jeux de beige, teinte poussière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a2c9846-6b66-35d7-bcd6-66cc9dca1354",
                                        "entry_id": "d6c118a9-4726-39ed-aa45-5b5fc47141d4",
                                        "glosses": [
                                            "Technique qui permet d'obtenir cette tapisserie."
                                        ],
                                        "tags": [
                                            "Tapisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16e6c1a9-2b11-4098-b119-e87b6878a275",
                                                "sense_id": "7a2c9846-6b66-35d7-bcd6-66cc9dca1354",
                                                "text": "Le travail en gobelin est fréquemment allié [en Amérique] au nouage de la trame qui servait à fixer sur l'étoffe des plumes d'oiseaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
