                                "target_lang_sense_clarification": "领会、知晓"
                            },
                            {
                                "target_lang_word": "理解",
                                "target_lang_sense_clarification": "深刻领会、了解"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bc80406-4b11-3979-9361-5ef8831e8e7b",
                    "sense_definition": "Odczuwać empatię wobec kogoś; akceptować czyjeś powody, uczucia lub zachowanie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doskonale <w>rozumiem</w> twój smutek po stracie przyjaciela.",
                            "target_lang_translations": {
                                "ru": "Я прекрасно <w>понимаю</w> твою грусть после потери друга.",
                                "en": "I perfectly <w>understand</w> your sadness after losing a friend.",
                                "zh": "失去朋友的悲伤，我完全能<w>理解</w>。"
                            }
                        },
                        {
                            "text": "Rodzice starają się, ale nie zawsze <w>rozumieją</w> problemy swoich dzieci.",
                            "target_lang_translations": {
                                "ru": "Родители стараются, но не всегда <w>понимают</w> проблемы своих детей.",
                                "en": "Parents try, but they don't always <w>understand</w> their children's problems.",
                                "zh": "父母虽然在努力，但并不总能<w>体谅</w>孩子们的苦恼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wczuwać się",
                        "współodczuwać"
                    ],
                    "common_phrases": [
                        "w pełni rozumieć",
                        "rozumieć czyjś ból"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявлять эмпатию к кому-либо; принимать чьи-то мотивы, чувства или поведение.",
                        "en": "To feel empathy towards someone; to accept someone's motives, feelings, or behavior.",
                        "zh": "对某人产生同理心；体谅并接受某人的动机、感受或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понимать",
                                "target_lang_sense_clarification": "сочувствовать"
                            },
