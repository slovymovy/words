                ],
                "senses": [
                    {
                        "sense_id": "b1bc1174-4861-36ba-b398-84e582aa25f7",
                        "entry_id": "f05121a5-c36b-376f-8eec-0f56b39f2dc1",
                        "glosses": [
                            "Person, die den menschengemachten Klimawandel abstreitet/verneint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e4049cd-007c-4ef3-ad2b-6ae23262e654",
                                "sense_id": "b1bc1174-4861-36ba-b398-84e582aa25f7",
                                "text": "[Die Erdölfirmen] „behaupteten, die Berechnungen der Physiker seien unsicher, sie redeten Klimamodelle schlecht, verbreiteten gar Mythen über eine drohende Eiszeit. Die organisierten Klimaleugner waren mit dieser Strategie überaus erfolgreich.“"
                            },
                            {
                                "example_id": "03b5c126-15a5-4f59-89a5-8a6ca24cf243",
                                "sense_id": "b1bc1174-4861-36ba-b398-84e582aa25f7",
                                "text": "„Die Klimaleugner der Erdölindustrie erzählten das verführerischste aller Märchen, nämlich dass alles so weitergehen könne wie bisher.“"
                            },
                            {
                                "example_id": "67b50d3b-577d-4f52-ad00-27908665280e",
                                "sense_id": "b1bc1174-4861-36ba-b398-84e582aa25f7",
                                "text": "Es gibt keine Kontroverse um die globale Erwärmung, es gibt auch keine wissenschaftliche Diskussion darüber, vielmehr geht es um die bewusste Verbreitung von Falschbehauptungen durch Klimaleugner."
                            },
                            {
                                "example_id": "a66260c6-f225-477d-b4bd-a50599192902",
                                "sense_id": "b1bc1174-4861-36ba-b398-84e582aa25f7",
                                "text": "[Schlagzeile:] „Das 1-Million-Dollar-Urteil: Forscher Michael Mann siegt vor Gericht gegen Klimaleugner“"
                            },
                            {
                                "example_id": "2ee479e7-8685-4119-bf62-bbb35eb4ee15",
                                "sense_id": "b1bc1174-4861-36ba-b398-84e582aa25f7",
                                "text": "„King hat einen anderen Lösungsvorschlag: Sie hält es für wirkungsvoller, wenn Klimaleugner in sozialen Medien in Zukunft kein Geld mehr verdienen dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21cbfb50-acf0-46d2-bd19-9e723792ff09",
                        "source_entry_id": "f05121a5-c36b-376f-8eec-0f56b39f2dc1",
                        "source_sense_id": "b1bc1174-4861-36ba-b398-84e582aa25f7",
                        "source_sense_description": "Person, die den menschengemachten Klimawandel abstreitet/verneint",
                        "target_lang_word": "climate denier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "climate denier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88cfee0a-d742-350c-99da-561ca1b850d1",
                                        "entry_id": "c0b97dbd-405d-3568-9a62-96bf95c75aa7",
                                        "glosses": [
                                            "Someone who denies that global climate change is real or, if real, that it is due to human activities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19bcb7ea-64a9-4486-ad91-8f36f280806c",
                                                "sense_id": "88cfee0a-d742-350c-99da-561ca1b850d1",
                                                "text": "\"Climate deniers fall into the same camp as people who still don't believe we landed on the moon,\" Gore's spokeswoman told Politico a few days ago."
                                            },
                                            {
                                                "example_id": "4363280e-41fc-47db-94b6-7fc7b752095b",
                                                "sense_id": "88cfee0a-d742-350c-99da-561ca1b850d1",
                                                "text": "In a question and answer session following a public lecture, the prominent (and genuinely sceptical) climate scientist Chris Rapley was vociferously challenged by a climate denier in the audience."
                                            },
                                            {
                                                "example_id": "5293ff4b-bb32-4253-ab4d-834f0a859557",
                                                "sense_id": "88cfee0a-d742-350c-99da-561ca1b850d1",
                                                "text": "Money is still the main answer: Almost all prominent climate deniers are on the fossil-fuel take."
                                            },
                                            {
                                                "example_id": "a036eb18-7519-4b14-aa77-c51a6fbf4fe0",
                                                "sense_id": "88cfee0a-d742-350c-99da-561ca1b850d1",
                                                "text": "President Trump unfortunately is a climate denier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
