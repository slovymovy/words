                        "glosses": [
                            "Compositeur ou compositrice de symphonies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fd59bb2-79f8-4e6c-9aa7-5ea45ef7f7ee",
                                "sense_id": "d8b9467b-2a8c-3c5f-ae82-aa77f6877d57",
                                "text": "Le soleil déclinait et les lancinants symphonistes du soir accordaient flûtes et chachas, lorsque les policiers se rembarquèrent avec Marie-Socrate."
                            },
                            {
                                "example_id": "3a7a55a7-a431-46dd-bfa8-cc83b3896e19",
                                "sense_id": "d8b9467b-2a8c-3c5f-ae82-aa77f6877d57",
                                "text": "Aujourd’hui, à l’écoute, ce mouvement orchestral jette une lumière sur le développement de sa personnalité musicale et permet de mesurer le chemin parcouru par ce fantastique symphoniste."
                            }
                        ]
                    }
