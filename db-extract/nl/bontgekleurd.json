                                        "glosses": [
                                            "Made up of sections having different, often bright, colours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb944ea9-f7db-46e3-ae21-937863b6b401",
                                                "sense_id": "9fd7b36b-aae3-345a-b1a8-af68d689b6c9",
                                                "text": "I selected a pair of loose, dark trousers bound at the waist with a russet sash, a tunic with an open neck and large pockets, and a cloak of the true fuligin of that guild of which I am still officially a master, lined with particolored brocade."
                                            },
                                            {
                                                "example_id": "ef6143b9-a2e7-4992-8373-87fcb31211e5",
                                                "sense_id": "9fd7b36b-aae3-345a-b1a8-af68d689b6c9",
                                                "text": "O foolish one! this molded earth is naught;\n This particolored vault of heaven is naught;\n Our sojourn in this seat of life and death\n Is but one breath, and what is that but naught?"
                                            }
                                        ]
                                    }
                                ]
