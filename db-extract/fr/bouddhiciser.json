                "senses": [
                    {
                        "sense_id": "21f354ab-e2d3-310e-bae5-8dbcb9d6d7c6",
                        "entry_id": "b50499ce-cacf-359a-bb96-d14c9598045a",
                        "glosses": [
                            "Donner un caractère bouddhique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5be2aa21-acff-4f0e-b98c-021a137d55bf",
                                "sense_id": "21f354ab-e2d3-310e-bae5-8dbcb9d6d7c6",
                                "text": "En les adoptant, le chrétien les christianise-t-il vraiment ou au contraire n’est-il pas « hindouisé » ou « bouddhicisé » par elles ?"
                            },
                            {
                                "example_id": "ec957a91-1b63-4ee2-89aa-17a3a107089a",
                                "sense_id": "21f354ab-e2d3-310e-bae5-8dbcb9d6d7c6",
                                "text": "Quelques coutumes bön furent incorporées au bouddhisme et « bouddhicisées »."
                            },
                            {
                                "example_id": "b28dc942-607e-4781-b907-ecc9d2b958e2",
                                "sense_id": "21f354ab-e2d3-310e-bae5-8dbcb9d6d7c6",
                                "text": "La question de l'ataraxie, comme celle du détachement dont on nous bouddhicise les oreilles, en prend un vieux coup avec la psychanalyse."
                            }
                        ]
                    }
