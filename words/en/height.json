{
    "word_family": [
        "high",
        "heighten",
        "highly",
        "highness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9f9f5a4c-0f82-348d-acb3-d974b7306020",
                    "sense_definition": "The vertical distance from the ground to the highest part of a standing person or animal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please state your age, weight, and <w>height</w> on the form.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, укажите в анкете свой возраст, вес и <w>рост</w>.",
                                "tr": "Lütfen formda yaşınızı, kilonuzu ve <w>boyunuzu</w> belirtin.",
                                "zh": "请在表格上填写你的年龄、体重和<w>身高</w>。"
                            }
                        },
                        {
                            "text": "She is exactly the same <w>height</w> as her brother.",
                            "target_lang_translations": {
                                "ru": "Она точно такого же <w>роста</w>, как и её брат.",
                                "tr": "O, erkek kardeşiyle tam olarak aynı <w>boydadır</w>.",
                                "zh": "她和她哥哥的<w>身高</w>完全一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stature",
                        "tallness"
                    ],
                    "common_phrases": [
                        "average height",
                        "same height",
                        "medium height"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертикальное расстояние от земли до самой высокой части стоящего человека или животного.",
                        "tr": "Ayakta duran bir insanın veya hayvanın yerden en yüksek noktasına kadar olan dikey uzaklığı.",
                        "zh": "指人或动物站立时从地面到头顶的垂直距离。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рост",
                                "target_lang_sense_clarification": "человека или животного"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "boy",
                                "target_lang_sense_clarification": "insan veya hayvan boyu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "身高",
                                "target_lang_sense_clarification": "人的身高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c138b7fc-6ae2-336d-94f5-b2aafd02e6c3",
                    "sense_definition": "The measurement of how tall something is from its base to its top.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to measure the <w>height</w> of the window before buying curtains.",
                            "target_lang_translations": {
                                "ru": "Вам нужно измерить <w>высоту</w> окна перед покупкой штор.",
                                "tr": "Perde satın almadan önce pencerenin <w>yüksekliğini</w> ölçmeniz gerekir.",
                                "zh": "买窗帘前你需要测量窗户的<w>高度</w>。"
                            }
                        },
                        {
                            "text": "The <w>height</w> of the new building exceeds two hundred meters.",
                            "target_lang_translations": {
                                "ru": "<w>Высота</w> нового здания превышает двести метров.",
                                "tr": "Yeni binanın <w>yüksekliği</w> iki yüz metreyi geçiyor.",
                                "zh": "这座新建筑的<w>高度</w>超过了两百米。"
                            }
                        }
                    ],
                    "antonyms": [
                        "depth"
                    ],
                    "common_phrases": [
                        "height and width",
                        "base times height"
                    ],
                    "target_lang_definitions": {
                        "ru": "Измерение того, насколько высок предмет от основания до верха.",
                        "tr": "Bir şeyin tabanından tepe noktasına kadar olan yüksekliğinin ölçüsü.",
                        "zh": "指物体从底部到顶部的测量长度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высота",
                                "target_lang_sense_clarification": "предмета, здания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yükseklik",
                                "target_lang_sense_clarification": "nesne, bina veya yapı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高度",
                                "target_lang_sense_clarification": "物体的垂直长度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31665491-4b5d-383d-90e5-d4150c50d824",
                    "sense_definition": "The distance of something above the ground or sea level.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aircraft reached a <w>height</w> of 30,000 feet shortly after takeoff.",
                            "target_lang_translations": {
                                "ru": "Самолет набрал <w>высоту</w> 30 000 футов вскоре после взлета.",
                                "tr": "Uçak kalkıştan kısa bir süre sonra 30.000 feet <w>yüksekliğe</w> ulaştı.",
                                "zh": "飞机起飞后不久就达到了三万英尺的<w>高度</w>。"
                            }
                        },
                        {
                            "text": "He refused to climb the ladder because he has a fear of <w>heights</w>.",
                            "target_lang_translations": {
                                "ru": "Он отказался лезть на лестницу, потому что боится <w>высоты</w>.",
                                "tr": "<w>Yükseklik</w> korkusu olduğu için merdivene tırmanmayı reddetti.",
                                "zh": "他拒绝爬梯子，因为他有恐<w>高</w>症。"
                            }
                        }
                    ],
                    "synonyms": [
                        "altitude",
                        "elevation"
                    ],
                    "common_phrases": [
                        "fear of heights",
                        "great height",
                        "from a height"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расстояние от объекта до земли или уровня моря.",
                        "tr": "Bir nesnenin yerden veya deniz seviyesinden olan uzaklığı.",
                        "zh": "指某物距离地面或海平面的垂直距离。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высота",
                                "target_lang_sense_clarification": "над уровнем земли/моря"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yükseklik",
                                "target_lang_sense_clarification": "irtifa, deniz seviyesinden veya yerden uzaklık"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高度",
                                "target_lang_sense_clarification": "距离地面的距离"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28bd38f8-7d4b-367a-a31e-3fb745300112",
                    "sense_definition": "The point when something is at its best, strongest, or most active.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_peak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to retire from professional sports at the <w>height</w> of her career.",
                            "target_lang_translations": {
                                "ru": "Она решила уйти из профессионального спорта на <w>пике</w> своей карьеры.",
                                "tr": "Kariyerinin <w>zirvesindeyken</w> profesyonel spordan emekli olmaya karar verdi.",
                                "zh": "她决定在职业生涯的<w>巅峰</w>时期退役。"
                            }
                        },
                        {
                            "text": "It was the <w>height</w> of summer, and the days were long and hot.",
                            "target_lang_translations": {
                                "ru": "Был самый <w>разгар</w> лета, и дни были длинными и жаркими.",
                                "tr": "Yazın <w>ortasıydı</w> ve günler uzun ve sıcaktı.",
                                "zh": "当时<w>正当</w>盛夏，白天又长又热。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zenith",
                        "pinnacle",
                        "summit",
                        "climax",
                        "apex",
                        "high point"
                    ],
                    "common_phrases": [
                        "height of fashion",
                        "height of summer",
                        "height of success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Момент, когда что-либо находится в наилучшем, сильнейшем или наиболее активном состоянии.",
                        "tr": "Bir şeyin en iyi, en güçlü veya en aktif olduğu an, zirve noktası.",
                        "zh": "指某事物处于最佳、最强或最活跃的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгар",
                                "target_lang_sense_clarification": "сезона, события"
                            },
                            {
                                "target_lang_word": "пик",
                                "target_lang_sense_clarification": "карьеры, активности"
                            },
                            {
                                "target_lang_word": "вершина",
                                "target_lang_sense_clarification": "успеха"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zirve",
                                "target_lang_sense_clarification": "kariyer, başarı"
                            },
                            {
                                "target_lang_word": "doruk",
                                "target_lang_sense_clarification": "en üst nokta"
                            },
                            {
                                "target_lang_word": "en civcivli zamanı",
                                "target_lang_sense_clarification": "sezon veya dönemin en yoğun zamanı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巅峰",
                                "target_lang_sense_clarification": "事业或成就的最高点"
                            },
                            {
                                "target_lang_word": "正当",
                                "target_lang_sense_clarification": "处于某时期的最盛期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af1b2dcb-c7f0-37d0-982d-6e3b53ed82e6",
                    "sense_definition": "A high place or area of land, such as a hill or cliff.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The castle was built on a rocky <w>height</w> overlooking the valley.",
                            "target_lang_translations": {
                                "ru": "Замок был построен на скалистой <w>возвышенности</w>, возвышающейся над долиной.",
                                "tr": "Kale, vadiye bakan kayalık bir <w>yükseklik</w> üzerine inşa edilmişti.",
                                "zh": "城堡建在一处俯瞰山谷的岩石<w>高地</w>上。"
                            }
                        },
                        {
                            "text": "They climbed the <w>heights</w> to get a better view of the ocean.",
                            "target_lang_translations": {
                                "ru": "Они поднялись на <w>возвышенности</w>, чтобы лучше рассмотреть океан.",
                                "tr": "Okyanusu daha iyi görebilmek için <w>yüksek yerlere</w> tırmandılar.",
                                "zh": "他们爬上了<w>高地</w>，以便更好地观赏海洋。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокое место или участок земли, например, холм или утес.",
                        "tr": "Tepelik veya uçurum gibi yüksek bir yer veya arazi parçası.",
                        "zh": "指高处或高地，如山丘或悬崖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвышенность",
                                "target_lang_sense_clarification": "холм, утес"
                            },
                            {
                                "target_lang_word": "высота",
                                "target_lang_sense_clarification": "географическая точка"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yükseklik",
                                "target_lang_sense_clarification": "yüksek yer, tepe"
                            },
                            {
                                "target_lang_word": "yükselti",
                                "target_lang_sense_clarification": "coğrafi yapı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高地",
                                "target_lang_sense_clarification": "地理上的高处"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "89f96bf4-6019-303e-a553-6c28e78af493",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Heights</w> was known for his contributions to the local library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Хайтс</w> был известен своим вкладом в местную библиотеку.",
                                "tr": "Bay <w>Heights</w>, yerel kütüphaneye yaptığı katkılarla tanınıyordu.",
                                "zh": "<w>海茨</w>先生因对当地图书馆的贡献而闻名。"
                            }
                        },
                        {
                            "text": "We looked up the name <w>Heights</w> in the telephone directory.",
                            "target_lang_translations": {
                                "ru": "Мы искали фамилию <w>Хайтс</w> в телефонном справочнике.",
                                "tr": "Telefon rehberinde <w>Heights</w> ismine baktık.",
                                "zh": "我们在电话簿里查了<w>海茨</w>这个名字。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "tr": "Bir soyadı.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хайтс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Heights",
                                "target_lang_sense_clarification": "soyadı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海茨",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}