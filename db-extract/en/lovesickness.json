                                        "entry_id": "a2cf6171-f213-3168-82fe-cbe7fcd67542",
                                        "glosses": [
                                            "Gefühl der Niedergeschlagenheit wegen einer bedrohten oder gescheiterten Liebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ddbdc28-bc4e-4623-96e3-0c60c7976da1",
                                                "sense_id": "74522d4e-5153-321a-b84f-48b0fd31533b",
                                                "text": "Lass ihn lieber in Ruhe. Er hat Liebeskummer."
                                            },
                                            {
                                                "example_id": "9fa70d44-203f-4613-8286-2120eb4050f0",
                                                "sense_id": "74522d4e-5153-321a-b84f-48b0fd31533b",
                                                "text": "„Gleich am dritten Tag macht ein Josef Petrásek der an Liebeskummer leidenden Christa einen Heiratsantrag.“"
                                            },
                                            {
                                                "example_id": "1891d55e-7215-4b64-81d1-28445aecccc6",
                                                "sense_id": "74522d4e-5153-321a-b84f-48b0fd31533b",
                                                "text": "„War sie, die jetzt neben mir ging, die einzige, die ihren Liebeskummer hierhertrug?“"
                                            },
                                            {
                                                "example_id": "1ecd3ecd-95e9-4c42-896f-8cb08d4115aa",
                                                "sense_id": "74522d4e-5153-321a-b84f-48b0fd31533b",
                                                "text": "„Jetzt kapierte ich erst, was Liebeskummer war und weshalb Charlie Brown immer so unglücklich war wegen dem kleinen rothaarigen Mädchen.“"
                                            },
                                            {
                                                "example_id": "c768e33e-e600-4b03-a6cb-a5760f666e6a",
                                                "sense_id": "74522d4e-5153-321a-b84f-48b0fd31533b",
                                                "text": "„Bei Liebeskummer ist drüber reden die einzige mildernde Medizin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
