                        "examples": [
                            {
                                "example_id": "e8dc22bb-169d-48f3-8639-6fb9391437b3",
                                "sense_id": "a11e7fd4-7d85-3bca-8cda-0e4689693ca3",
                                "text": "Les applications de géolocalisation, telles Waze, décourcircuitent les usages."
                            },
                            {
                                "example_id": "d68b6c47-fabc-46ec-9774-d86b2428d09c",
                                "sense_id": "a11e7fd4-7d85-3bca-8cda-0e4689693ca3",
                                "text": "Décourcircuiter le point 10 de la masse."
                            },
                            {
                                "example_id": "b3c388f1-1303-4882-8f56-5614824088b5",
                                "sense_id": "a11e7fd4-7d85-3bca-8cda-0e4689693ca3",
                                "text": "L’attraction ainsi produite a pour effet de décourcircuiter une résistance de 200 ohms placée en série sur l’enroulement inducteur de 10 ohms ;"
                            },
                            {
                                "example_id": "592b396a-efa3-46a4-91b1-4f76e3e970a5",
                                "sense_id": "a11e7fd4-7d85-3bca-8cda-0e4689693ca3",
                                "text": "si vous branchez un cable RCA sur une entrée niveau micro, il est normal que vous captiez la radio ou d'autres parasites car l'entrée micro est normalement court-circuitée par le jack femelle lorsque rien n'est branché dessus, tandis que le fait de brancher un jack mâle dessus la \"décourcircuite\", c'est à dire que vous mettez un fil sur le point chaud qui joue le rôle d'antenne, ce qui capte la radio."
                            }
                        ]
