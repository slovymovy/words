        "fr-extract.jsonl": [
            {
                "entry_id": "6267aa85-b0d9-31b0-b955-a57c48290f2e",
                "word": "déracinement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8534c95c-73d8-45e1-8041-8f41cfa65e11",
                        "entry_id": "6267aa85-b0d9-31b0-b955-a57c48290f2e",
                        "tags": [
                            "plural"
                        ],
                        "form": "déracinements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3fdc9852-313d-3342-94a3-d747a5f776a0",
                        "entry_id": "6267aa85-b0d9-31b0-b955-a57c48290f2e",
                        "glosses": [
                            "Action de déraciner ou état de ce qui est déraciné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e2ac36b-b244-415f-b61b-c4ed46a5090f",
                                "sense_id": "3fdc9852-313d-3342-94a3-d747a5f776a0",
                                "text": "Le déracinement des souches de cette avenue a coûté beaucoup."
                            },
                            {
                                "example_id": "69bd46b5-d541-4343-9778-45d3615e1b30",
                                "sense_id": "3fdc9852-313d-3342-94a3-d747a5f776a0",
                                "text": "Le déracinement de cet arbre vous fait voir quelle a été la violence de l’orage."
                            },
                            {
                                "example_id": "f8a27807-256f-4b2a-8917-7ae647271381",
                                "sense_id": "3fdc9852-313d-3342-94a3-d747a5f776a0",
                                "text": "Le déracinement des abus, des préjugés, des superstitions, des hérésies."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b7191ee-72f7-3f87-9706-731569f15a0a",
                        "entry_id": "6267aa85-b0d9-31b0-b955-a57c48290f2e",
                        "glosses": [
                            "État de celui ou de celle qui est coupée de ses racines familiales, culturelles, etc."
                        ],
                        "tags": [
                            "especially",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3d27e4df-dcd8-469d-a9dc-9973d7de111c",
                                "sense_id": "5b7191ee-72f7-3f87-9706-731569f15a0a",
                                "text": "« … Ce que ton Barrès dénonce comme un mal, le déracinement, est le seul remède, après le coup que tu as reçu, apporte la seule chance de guérison."
                            },
                            {
                                "example_id": "c6e818a9-dcd1-4059-811a-7a747caae4a4",
                                "sense_id": "5b7191ee-72f7-3f87-9706-731569f15a0a",
                                "text": "Les populations burundaises vivent une crise identitaire majeure aggravée par le déracinement social et la perte de tous les repères constituant de la personne, repères biologiques, affectifs, cognitifs, socioculturels et géographiques."
                            },
                            {
                                "example_id": "78324fb5-8819-4c64-b530-54c4a9d210a4",
                                "sense_id": "5b7191ee-72f7-3f87-9706-731569f15a0a",
                                "text": "Notre devoir est enfin de dire aux centaines de milliers de rapatriés pour qui la guerre d’Algérie s’est conclue par le déracinement que la Nation reconnait ce qu’ils ont enduré. Pour eux non plus, la sidération et la déchirure ne se sont pas arrêtés avec les violences armées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ef0944b-b788-4843-aaa6-4631cc1bc5e2",
                        "source_entry_id": "6267aa85-b0d9-31b0-b955-a57c48290f2e",
                        "source_sense_description": "Sens propre",
                        "target_lang_word": "ξερίζωμα",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ξερίζωμα",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "d2d635f5-b9c1-3442-9bc2-4d54bfd0a494",
                                        "entry_id": "e2f5dec3-2e27-3498-9132-2196021a6a97",
                                        "glosses": [
                                            "η απόσπαση ενός φυτού από το έδαφος μαζί με τη ρίζα του"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca6496af-e388-34cd-95fc-d8d16bf988ce",
                                        "entry_id": "e2f5dec3-2e27-3498-9132-2196021a6a97",
                                        "glosses": [
                                            "η απόσπαση δια της βίας, ο διωγμός ή η αναγκαστική για οικονομικούς λόγους αποχώρηση ατόμου ή κοινότητας ή έθνους από την πατρίδα του ή από τον τόπο στον οποίο γεννήθηκε"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ffd3a5a-0b1e-422f-8d01-0fc9681dae6c",
                                                "sense_id": "ca6496af-e388-34cd-95fc-d8d16bf988ce",
                                                "text": "Το ξερίζωμα του Ελληνισμού από τη Μικρά Ασία, την Κωνσταντινούπολη, των Αρμενίων από την Μικρά Ασία."
                                            },
                                            {
                                                "example_id": "e437a608-ae90-409d-b21f-785d27d66d97",
                                                "sense_id": "ca6496af-e388-34cd-95fc-d8d16bf988ce",
                                                "text": "Το ξερίζωμα του μετανάστη που λαχταράει να γυρίσει στην πατρίδα του αλλα για οικονομικούς λόγους μένει μακριά."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70b65f5b-0e41-3150-9058-eb7c5edbeeb1",
                                        "entry_id": "e2f5dec3-2e27-3498-9132-2196021a6a97",
                                        "glosses": [
                                            "η βίαιη απόσπαση από τις πολιτιστικές ρίζες"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a379a7f-577f-4798-94b5-5393e3900e10",
                                                "sense_id": "70b65f5b-0e41-3150-9058-eb7c5edbeeb1",
                                                "text": "Το ξερίζωμα των λέξεων από τις πηγές τους."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a4d98c4-f435-451c-9ace-2432b7084e4b",
                        "source_entry_id": "6267aa85-b0d9-31b0-b955-a57c48290f2e",
