                    },
                    {
                        "translation_id": "06a67373-c94b-4276-b4b3-f748971de169",
                        "source_entry_id": "183d8df8-9c2f-39ba-bfee-ef378e8bcd24",
                        "source_sense_description": "a doctrine that the universe is within God",
