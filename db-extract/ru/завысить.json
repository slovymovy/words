                                            {
                                                "example_id": "f3cbc211-fa24-4ab2-b6b9-0238787c0889",
                                                "sense_id": "09c9fdd1-c9a3-33a5-992e-51903c0492ef",
                                                "text": "L'importance d’Hippocrate et du Corpus hippocratique ne saurait être surestimée car l’œuvre du Maître de Cos fut objet d'enseignement médical jusqu'au milieu du XIX^(ème) siècle avant de devenir objet d'histoire."
                                            },
                                            {
                                                "example_id": "a33a5a72-a4b3-4379-a5fd-7facde2d0dc7",
                                                "sense_id": "09c9fdd1-c9a3-33a5-992e-51903c0492ef",
                                                "text": "Entraînées par l’enthousiasme démesuré de l’adolescence, elles surestimèrent leurs capacités physiologiques."
                                            },
                                            {
                                                "example_id": "a34f0052-0eeb-4124-b2b8-7cc779947601",
                                                "sense_id": "09c9fdd1-c9a3-33a5-992e-51903c0492ef",
                                                "text": "Forcées de baisser leurs tarifs pour décrocher des marchés, les entreprises du déménagement ont mis en place, histoire de compenser, des combines bien rodées. La plus connue consiste à surestimer la volumétrie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a049108-264f-4024-ae8e-626d3ec557ba",
                        "source_entry_id": "9d893810-6353-3da1-b1cc-5e3e7c49caee",
                        "source_sense_id": "8c5851c1-2cd9-3290-8232-243327a53edb",
                        "target_lang_word": "gonfler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gonfler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ccdcc880-c247-3f54-9126-fab4d13ed508",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Augmenter quelque chose de volume en la remplissant de gaz ou d’un fluide ; faire saillir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eb25ee4-a292-40a4-a0d9-51e5256c8d82",
                                                "sense_id": "ccdcc880-c247-3f54-9126-fab4d13ed508",
                                                "text": "Cette chair bleue qui gonflait, cette sanie malodorante qui coulait…"
                                            },
                                            {
                                                "example_id": "62862ff4-3148-44b1-b2f6-2c8735766be1",
                                                "sense_id": "ccdcc880-c247-3f54-9126-fab4d13ed508",
                                                "text": "L'hiver dernier, ça a gelé dur, très dur, la terre a gonflé et les pavés sont remontés comme des dents qui se déchaussent."
                                            },
                                            {
                                                "example_id": "71cd2166-60fd-4512-8d27-e6cb9212f1cb",
                                                "sense_id": "ccdcc880-c247-3f54-9126-fab4d13ed508",
                                                "text": "Le vent gonfle les voiles. — La pluie gonfle les torrents. — La bière m’a gonflé l’estomac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90aacf22-5f04-3bf0-93cc-978c4b56363d",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Augmenter fortement et de manière anormale."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "317d4e4b-63b0-4277-84fd-85c936e1d8be",
                                                "sense_id": "90aacf22-5f04-3bf0-93cc-978c4b56363d",
                                                "text": "Ce tour de passe-passe mathématique n’a d’autre but que de gonfler les statistiques de fréquentation de son blogue."
                                            },
                                            {
                                                "example_id": "9cd4374c-05a2-4e38-9999-7f634dad6cbf",
                                                "sense_id": "90aacf22-5f04-3bf0-93cc-978c4b56363d",
                                                "text": "Cette mesure est accusée de gonfler encore davantage le taux de chômage."
                                            },
                                            {
                                                "example_id": "65810574-a777-4ac9-b72d-73ee64bbd876",
                                                "sense_id": "90aacf22-5f04-3bf0-93cc-978c4b56363d",
                                                "text": "Pour toute réponse, l'intrus ferma un œil, et gonfla sa joue avec le bout de sa langue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f93ff664-0c51-3198-82f3-d08ace3e5a5a",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Remplir le cœur ou la poitrine d’un sentiment."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83c1e6eb-9c8a-4a4c-a87c-43fb745b974b",
                                                "sense_id": "f93ff664-0c51-3198-82f3-d08ace3e5a5a",
                                                "text": "Les Lettres à l’Étrangère, […] malgré cette jactance énorme, qui le fait se gonfler jusqu’à la bouffonnerie, sont le plus émouvant, le plus angoissant martyrologe qui se puisse imaginer d’une vie d’artiste, […]"
                                            },
                                            {
                                                "example_id": "c233c6a4-bfb3-4ea1-be0f-3b0721e86d81",
                                                "sense_id": "f93ff664-0c51-3198-82f3-d08ace3e5a5a",
                                                "text": "Et tous de le flatter, et de l’entourer d’une cour dont il ne peut être dupe, mais dont se gonfle sa vanité."
                                            },
                                            {
                                                "example_id": "7bded2d0-fd23-49c0-b733-488bf18487b2",
                                                "sense_id": "f93ff664-0c51-3198-82f3-d08ace3e5a5a",
                                                "text": "Le départ de son fils lui a gonflé le cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3874bdcb-d6b2-3d5a-a281-29d54afa5f14",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Agacer ; exaspérer."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338291cc-93e0-4a84-9383-4c57258b943e",
                                                "sense_id": "3874bdcb-d6b2-3d5a-a281-29d54afa5f14",
                                                "text": "Épuisée par une semaine harassée, j’entrai dans une rage terrible : « Mais tu me fais chier, je vais te dire, tu me gonfles, tu m’emmerdes, comme si j’avais que ça à foutre ! »"
                                            },
                                            {
                                                "example_id": "20ae480d-6ee0-47d5-8da1-caa1714ae782",
                                                "sense_id": "3874bdcb-d6b2-3d5a-a281-29d54afa5f14",
                                                "text": "Stan, qu'est-ce qu'il a pu me gonfler avec son tajine ! Et Vince, et sa fixette sur un gros poulet-frites. Moi, toutes ces années, je suis resté québlo sur le grec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8a27bcd-5f8f-33dc-b97b-be16ddd26c99",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Transformer une image, un film pour le mettre dans un format supérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b361b024-6ec6-456f-8bb6-630337e24ba9",
                                                "sense_id": "f8a27bcd-5f8f-33dc-b97b-be16ddd26c99",
                                                "text": "On gonfle pour permettre à des films réalisés avec des technologies moins onéreuses que le 35mm d’exister au final sur un support 35mm, afin de pouvoir suivre une exploitation commerciale normale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11d8980a-11bb-3263-979d-fc197ccd4db5",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Augmenter de volume, enfler."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caff2028-ded0-49b1-9df9-8dc4eb4abd30",
                                                "sense_id": "11d8980a-11bb-3263-979d-fc197ccd4db5",
                                                "text": "J’ai le ventre qui a gonflé, c’est la bière !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53322315-07f1-338c-adb1-ce8a90bdc0df",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Augmenter de volume, enfler."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a99ec3ad-efa2-4567-8f28-5244e515a46e",
                                                "sense_id": "53322315-07f1-338c-adb1-ce8a90bdc0df",
                                                "text": "L’osséine chauffée à l’autoclave avec de l’eau donne un albumoïde de nature plus simple, la gélatine ; celle-ci se gonfle au contact de l’eau en donnant des gelées […]"
                                            },
                                            {
                                                "example_id": "4ebe5bd4-9dae-45b3-b62d-cf83d8af5f44",
                                                "sense_id": "53322315-07f1-338c-adb1-ce8a90bdc0df",
                                                "text": "J’ai vu le visage et le corps des malades s’œdématier, et le tissu cellulaire se bouffir et se gonfler par l’irritation herpétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bc50de4-252a-311e-a8ab-ac08dd824f7a",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Être envahi d’émotion."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5488c64-fa71-4d30-a56c-6c6257bcb8f4",
                                                "sense_id": "3bc50de4-252a-311e-a8ab-ac08dd824f7a",
                                                "text": "Son cœur se gonflait en pensant à elle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
