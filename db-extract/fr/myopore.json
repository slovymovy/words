                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cd3218d-6211-40ed-b468-c73b4c4ebc77",
                                "sense_id": "23d2e6ee-bc59-3d29-837a-4eeb03dd2714",
                                "text": "Les Myopores sont des arbrisseaux ou des arbustes propres à la Nouvelle-Hollande, ou aux îles de la mer du Sud."
                            },
                            {
                                "example_id": "ecd1b961-ae2d-4b0d-804e-decff88b6a74",
                                "sense_id": "23d2e6ee-bc59-3d29-837a-4eeb03dd2714",
                                "text": "L’hôpital Colombani possédait des jardins magnifiques où les bougainvillées grimpaient aux troncs de palmiers jusqu’à les rendre obèses et mauves, tandis que les lauriers-roses, les myopores et les jasmins poussaient en buissons échevelés sur le gazon cru qu’encadraient des haies d’hibiscus entre les allées de graviers."
                            }
                        ]
                    }
