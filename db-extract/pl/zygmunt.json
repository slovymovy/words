                    {
                        "translation_id": "64d3179c-f08d-4702-8a8a-5dc4e17a2c80",
                        "source_entry_id": "12b6bc98-1765-3b5b-8e06-51994cc83792",
                        "source_sense_id": "92e54819-d0b5-350b-bb80-cff4a042df3a",
                        "target_lang_word": "Sigmund",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sigmund",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "026524e2-81fc-362c-b410-9a6ba0b27546",
                                        "entry_id": "1c87d05d-45d2-3690-8c4d-a36ef812f565",
                                        "glosses": [
                                            "Term of address for a person who appears to be dispensing psychoanalysis."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1ca43fa-52a6-4317-9283-5c82996f2dbf",
                                                "sense_id": "026524e2-81fc-362c-b410-9a6ba0b27546",
                                                "text": "RUTH: OK, OK. Sigmund. Lighten up. OK. So what if it's completely neurotic and emotionally unhealthy."
                                            },
                                            {
                                                "example_id": "a23c0048-7218-49c5-9742-86d71a799d3d",
                                                "sense_id": "026524e2-81fc-362c-b410-9a6ba0b27546",
                                                "text": "Thanks, Sigmund. If I want to be psychoanalyzed, I'll throw good money away on an actual fucking therapist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d821bdcc-b378-43b1-b2b5-4d0b9d654910",
                        "source_entry_id": "12b6bc98-1765-3b5b-8e06-51994cc83792",
                        "source_sense_id": "92e54819-d0b5-350b-bb80-cff4a042df3a",
                        "target_lang_word": "Zikmund",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d65a8ece-0441-45bb-a721-e734544e7a10",
                        "source_entry_id": "12b6bc98-1765-3b5b-8e06-51994cc83792",
                        "source_sense_id": "92e54819-d0b5-350b-bb80-cff4a042df3a",
                        "target_lang_word": "Sigismond",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sigismond",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f4ddb90-7a81-3a37-95d2-cbb52ffb34bb",
                                        "entry_id": "09ab5163-79e0-3081-aefa-f0eca0d2473a",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b1c031-ef0a-42cd-b057-1a12c6da2644",
                                                "sense_id": "4f4ddb90-7a81-3a37-95d2-cbb52ffb34bb",
                                                "text": "En outre, du fait de la conversion au christianisme de l'ancien païen Clovis et de l'ancien arien Sigismond de Bourgogne, l'autorité de l'Église devenait de plus en plus forte."
                                            },
                                            {
                                                "example_id": "0751b82a-92f4-45eb-86d7-8760f8faf348",
                                                "sense_id": "4f4ddb90-7a81-3a37-95d2-cbb52ffb34bb",
                                                "text": "Vous reprendrez bien un peu d'eau saumâtre, Sigismond?"
                                            },
                                            {
                                                "example_id": "31f881b9-194a-46f0-9bab-db0c55eb84b2",
                                                "sense_id": "4f4ddb90-7a81-3a37-95d2-cbb52ffb34bb",
                                                "text": "Son règne est marqué par la lutte contre les Burgondes, dont il fait exécuter le roi Sigismond avant d’être lui-même vaincu et tué à la bataille de Vézeronce en 524."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
