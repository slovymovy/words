            {
                "entry_id": "8ce0ea4c-bf81-3f47-a3f5-2d08c738e1f4",
                "word": "droitisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2c34f62e-cf91-4320-a3fc-6835bd44cbdd",
                        "entry_id": "8ce0ea4c-bf81-3f47-a3f5-2d08c738e1f4",
                        "tags": [
