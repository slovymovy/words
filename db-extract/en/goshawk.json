                    {
                        "translation_id": "c2390021-abb4-419a-8889-6db22f25031b",
                        "source_entry_id": "c8af438d-9ee9-3be4-8fba-66669c7fbff1",
                        "source_sense_id": "d40e4446-a720-3134-bec6-de778651d1c5",
                        "source_sense_description": "bird of prey principally in the genus Accipiter",
                        "target_lang_word": "Habicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Habicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a43b9f8-13c9-31df-b9d2-c79fe7d84d2a",
                                        "entry_id": "60641fcb-308a-3c4d-9b1c-ca108fa8f3f0",
                                        "glosses": [
                                            "Name eines Greifvogels; große Vertreter der Gattung Accipiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1059ca4a-5e6a-4b54-935d-63be7bf83212",
                                                "sense_id": "0a43b9f8-13c9-31df-b9d2-c79fe7d84d2a",
                                                "text": "Und er sah einen prächtigen Habicht im Baum sitzen."
                                            },
                                            {
                                                "example_id": "5c918204-4ef4-4c24-a78b-c865db163829",
                                                "sense_id": "0a43b9f8-13c9-31df-b9d2-c79fe7d84d2a",
                                                "text": "„Der Wolf (der Wolf),",
                                                "translation": "HURZ!“"
                                            },
                                            {
                                                "example_id": "fc2b57e1-3bdc-4307-8eb7-31469082a647",
                                                "sense_id": "0a43b9f8-13c9-31df-b9d2-c79fe7d84d2a",
                                                "text": "„Hie und da wächst ein weniges von Schilf und Binsen auf, aber kein Kahn zieht seine Furchen, kein Vogel singt, und nur selten, daß ein Habicht drüber hinfliegt und seinen Schatten auf die Spiegelfläche wirft.“"
                                            },
                                            {
                                                "example_id": "016ccb8e-093e-4a18-a206-1002dc3ff1c3",
                                                "sense_id": "0a43b9f8-13c9-31df-b9d2-c79fe7d84d2a",
                                                "text": "„Und er wies auf einen Habicht, der sich am Eingange der Schlucht hoch in den Lüften wiegte.“"
                                            },
                                            {
                                                "example_id": "84728c4c-3c03-4e03-b20f-2e1d4fbbdb7c",
                                                "sense_id": "0a43b9f8-13c9-31df-b9d2-c79fe7d84d2a",
                                                "text": "„Auf seinem scharfgeschnittenen Gesicht, das an einen Habicht erinnerte, zeigte sich ein Ausdruck außergewöhnlicher Konzentration, als er sich auf seinem Stuhl vorbeugte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Habicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c72c6f0d-9267-3d93-92ed-7331a934d1b9",
                                        "entry_id": "8301ff57-5134-30a7-8c82-ab4b0339cb0a",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72cbc5ff-7673-4627-a96b-69aafdc543c1",
                                                "sense_id": "c72c6f0d-9267-3d93-92ed-7331a934d1b9",
                                                "text": "Frau Habicht ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "737ed5e3-454e-4984-b717-65628147c467",
                                                "sense_id": "c72c6f0d-9267-3d93-92ed-7331a934d1b9",
                                                "text": "Herr Habicht wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "33fb5875-c10b-4d73-a89c-6f95ee090bff",
                                                "sense_id": "c72c6f0d-9267-3d93-92ed-7331a934d1b9",
                                                "text": "Die Habichts fliegen heute nach Chicago."
                                            },
                                            {
                                                "example_id": "16a417c6-1ceb-4537-be3c-033f33357b9a",
                                                "sense_id": "c72c6f0d-9267-3d93-92ed-7331a934d1b9",
                                                "text": "Der Habicht trägt nie die Pullover, die die Habicht ihm strickt."
                                            },
                                            {
                                                "example_id": "92fe58d9-da84-43ae-b164-67f9fb69c27b",
                                                "sense_id": "c72c6f0d-9267-3d93-92ed-7331a934d1b9",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Habicht kommt, geht der Herr Habicht.“"
                                            },
                                            {
                                                "example_id": "32d08797-fb01-4bb8-9150-3067a3eca69b",
                                                "sense_id": "c72c6f0d-9267-3d93-92ed-7331a934d1b9",
                                                "text": "Habicht kommt und geht."
                                            },
                                            {
                                                "example_id": "278988ba-a373-427f-8d72-cbcff36ef8bc",
                                                "sense_id": "c72c6f0d-9267-3d93-92ed-7331a934d1b9",
                                                "text": "Habichts kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
