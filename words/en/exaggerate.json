{
    "word_family": [
        "exaggeration",
        "exaggerator",
        "exaggerative",
        "exaggeratedly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "387dda93-8642-3ade-a11b-3cbc5fbc2daa",
                    "sense_definition": "To represent something as being larger, better, or worse than it really is.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "overstate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have told you a billion times not to <w>exaggerate</w> when you tell stories.",
                            "target_lang_translations": {
                                "ru": "Я тебе миллиард раз говорил не <w>преувеличивать</w>, когда ты рассказываешь истории."
                            }
                        },
                        {
                            "text": "He tends to <w>exaggerate</w> the truth to make his life sound more exciting.",
                            "target_lang_translations": {
                                "ru": "Он склонен <w>преувеличивать</w> правду, чтобы его жизнь казалась более захватывающей."
                            }
                        },
                        {
                            "text": "It is easy to <w>exaggerate</w> the importance of this minor incident.",
                            "target_lang_translations": {
                                "ru": "Легко <w>преувеличить</w> важность этого незначительного инцидента."
                            }
                        }
                    ],
                    "synonyms": [
                        "overstate",
                        "hyperbolize",
                        "stretch"
                    ],
                    "antonyms": [
                        "understate",
                        "downplay",
                        "belittle",
                        "trivialize"
                    ],
                    "common_phrases": [
                        "exaggerate the truth",
                        "tend to exaggerate",
                        "grossly exaggerate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представлять что-либо в более крупном, лучшем или худшем виде, чем оно есть на самом деле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преувеличивать",
                                "target_lang_sense_clarification": "делать что-то более значимым или масштабным"
                            },
                            {
                                "target_lang_word": "утрировать",
                                "target_lang_sense_clarification": "намеренно подчеркивать или искажать детали"
                            },
                            {
                                "target_lang_word": "сгущать краски",
                                "target_lang_sense_clarification": "представлять ситуацию хуже, чем она есть"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b90be0fd-67c8-3fba-b524-8ba76098536b",
                    "sense_definition": "Excessive or overblown in nature; characterized by being more than what is normal or necessary.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "overstate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reactions of the crowd were very <w>exaggerate</w> given the small scale of the event.",
                            "target_lang_translations": {
                                "ru": "Реакция толпы была весьма <w>преувеличенной</w>, учитывая малый масштаб события."
                            }
                        },
                        {
                            "text": "His movements were <w>exaggerate</w> and theatrical, drawing everyone's attention in the room.",
                            "target_lang_translations": {
                                "ru": "Его движения были <w>утрированными</w> и театральными, привлекая внимание всех присутствующих в комнате."
                            }
                        }
                    ],
                    "common_phrases": [
                        "very exaggerate",
                        "too exaggerate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерный или раздутый по своему характеру; выходящий за рамки обычного или необходимого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преувеличенный",
                                "target_lang_sense_clarification": "чрезмерный, не соответствующий реальности"
                            },
                            {
                                "target_lang_word": "утрированный",
                                "target_lang_sense_clarification": "нарочито подчеркнутый"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}