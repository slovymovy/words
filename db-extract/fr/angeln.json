                                "target_senses": [
                                    {
                                        "sense_id": "6ab9d4c1-d386-3b78-9ed6-3d2d40abbf91",
                                        "entry_id": "edb203d7-bbe5-3d43-817e-88969f891be9",
                                        "glosses": [
                                            "ein germanischer Volksstamm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7e67a3-4a79-4b03-babb-d610c5aa522e",
                                                "sense_id": "6ab9d4c1-d386-3b78-9ed6-3d2d40abbf91",
                                                "text": "„Die Angeln waren wie andere germanische Stämme eine grundsätzlich Ackerbau und Viehzucht betreibende Gesellschaft, bedingt durch die maritime Lage hatte der Fischfang eine proportional höhere Bedeutung als bei binnengermanischen Stämmen.“"
                                            },
                                            {
                                                "example_id": "a42e84e4-5c59-4c24-aaa5-e8fe86baa316",
                                                "sense_id": "6ab9d4c1-d386-3b78-9ed6-3d2d40abbf91",
                                                "text": "„Die germanischen Angeln, Sachsen und Jüten intensivierten nach dem Abzug der Römer ihre Unternehmungen auf der Insel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Angeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cba215ce-9657-3887-8907-53d9e18b529a",
                                        "entry_id": "d01a8452-9412-3d48-a12d-775a366919eb",
                                        "glosses": [
                                            "Landschaft (Halbinsel) im Nordosten Schleswig-Holsteins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53ac5176-894a-4477-a49f-85648cba7055",
                                                "sense_id": "cba215ce-9657-3887-8907-53d9e18b529a",
                                                "text": "„Die Inschriften aus dem Thorsberger Moor in Angeln gehören in den zeitgleichen Horizont der Moorfunde von Jütland (Illerup) und Fünen (Vimose) und sind auf ca. 200 n. Chr. zu datieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
