                "senses": [
                    {
                        "sense_id": "50099c9a-c431-3cd6-a6bb-8d4385b4b9b0",
                        "entry_id": "0171e449-da66-3914-a5af-d1afcefbcdeb",
                        "glosses": [
                            "Person, die wenig Entgegenkommen zeigt und sich gegebenenfalls deutlich zur Wehr setzt"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "8150da08-227d-4a2d-a73e-efeb353d049b",
                                "sense_id": "50099c9a-c431-3cd6-a6bb-8d4385b4b9b0",
                                "text": "„Als wir nach dem Essen einen Spaziergang machten, ließen mich die drei Freundinnen, meine Wünsche erratend, mit der schönen Kratzbürste allein, die allen meinen zärtlichen Bemühungen widerstand und mir fast jede Hoffnung nahm, ihrer Herr zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
