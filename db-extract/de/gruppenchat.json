                    {
                        "sense_id": "9e5c7ec1-bdef-3150-ae4d-f28b7ce1ca7d",
                        "entry_id": "69b67163-d06d-31a9-b6ac-22b7a311063b",
                        "glosses": [
                            "Chat, an dem nur eine bestimmte Gruppe teilnimmt, dem man nur nach Einladung beitreten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b17975e2-43f6-465a-a1d9-f4279aca482d",
                                "sense_id": "9e5c7ec1-bdef-3150-ae4d-f28b7ce1ca7d",
                                "text": "„Ich poste einen Screenshot im Gruppenchat mit Flo und meinen Speichelleckern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfef2f50-4197-4219-a140-e375c6ff608c",
                        "source_entry_id": "69b67163-d06d-31a9-b6ac-22b7a311063b",
                        "source_sense_id": "9e5c7ec1-bdef-3150-ae4d-f28b7ce1ca7d",
                        "source_sense_description": "Chat, an dem nur eine bestimmte Gruppe teilnimmt",
                        "target_lang_word": "group chat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "group chat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64444c47-1d3e-3639-a8df-b4375780a290",
                                        "entry_id": "df07571c-e189-3536-ac99-d02d83bbdb1a",
                                        "glosses": [
                                            "A simultaneous online chat between a group of people by means of a messaging application."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aeb1c6b-207b-4934-87d4-efa03209eadd",
                                                "sense_id": "64444c47-1d3e-3639-a8df-b4375780a290",
                                                "text": "“The Lifeguards” is a polyphonic story, told in the voices of three mothers, with chapters handed over to their teenage sons, a recently widowed detective and the Barton Hills Mamas, an Austin, Texas, group chat consisting of members I thought of as that brood of vipers."
                                            },
                                            {
                                                "example_id": "aa3878cd-9e1a-4697-927c-04e80000d51e",
                                                "sense_id": "64444c47-1d3e-3639-a8df-b4375780a290",
                                                "text": "Unanswered messages—whether it's a text convo with your crush, a group chat that none of your friends responds to, or a hopeful conversation starter on Tinder—are just one more way living in this digital age can make you feel all-caps crappy."
                                            },
                                            {
                                                "example_id": "3220ded8-31ec-4951-aa6d-1455e47534db",
                                                "sense_id": "64444c47-1d3e-3639-a8df-b4375780a290",
                                                "text": "But just as the big three TV networks amassed a giant audience in the 20th century, then lost it to cable and the internet, the appeal of bringing the entire world into one big group chat might be over. This is the way a phenomenon ends — not with a sharknado but a whimper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
