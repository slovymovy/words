                    "sense_definition": "A line or vector that is perpendicular to another line, surface, or plane.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Draw a <w>normal</w> to the curve at the point of intersection.",
                            "target_lang_translations": {
                                "ru": "Проведите <w>нормаль</w> к кривой в точке пересечения.",
                                "tr": "Kesişim noktasında eğriye bir <w>dikme</w> çizin.",
                                "zh": "在交点处画一条曲线的<w>法线</w>。"
                            }
                        },
                        {
                            "text": "The reflection angle is measured relative to the surface <w>normal</w>.",
                            "target_lang_translations": {
                                "ru": "Угол отражения измеряется относительно <w>нормали</w> к поверхности.",
                                "tr": "Yansıma açısı, yüzey <w>normaline</w> göre ölçülür.",
                                "zh": "反射角是相对于表面<w>法线</w>来测量的。"
                            }
                        }
                    ],
