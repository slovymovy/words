                        "glosses": [
                            "Personne ayant adopté les doctrines d’Origène, théologien alexandrin du début du iiiᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "421f1841-9ebd-4318-8220-78af9b082734",
                                "sense_id": "bbe13376-68c3-3034-a1d3-2f89232804da",
                                "text": "Les origénistes soutenaient que Jésus-Christ n’était fils de Dieu que par adoption, que l’âme est créée avant le corps, et que les supplices des démons auront une fin."
                            },
                            {
                                "example_id": "3dc6bdae-a168-4b70-8ef0-a49fbd6185a5",
                                "sense_id": "bbe13376-68c3-3034-a1d3-2f89232804da",
                                "text": "Quant à saint Grégoire de Nysse (évêque en 371, mort v. 395), c’est proprement un philosophe et un origéniste."
                            }
                        ]
                    }
