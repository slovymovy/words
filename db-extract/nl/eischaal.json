                            {
                                "example_id": "09e3836f-8a92-410f-a750-73449c11ac0b",
                                "sense_id": "5475d1f9-d4a3-3a46-864b-6564106970a5",
                                "text": "Vul de eischaaltjes met dit mengsel, strooi er de kaas over en leg er vlokjes boter op en zet 10 minuten onder een hete grill. Wat zeg je? Jaren ’50? Klopt. Lekker, hè! Met ouderwetse waardes als: het gezin aan tafel en je best doen uit wat heel gewoons wat lekkers te maken."
                            },
                            {
                                "example_id": "bf7812b2-3822-45a2-87db-86f2094215e0",
                                "sense_id": "5475d1f9-d4a3-3a46-864b-6564106970a5",
                                "text": "In aquaria is er geen sprake van slijtage door zeebodem of slakkenslijm, waardoor de eischaal te dik is voor het jong om door te breken. Het ei wordt daarom met de hand open gepeld als de haaitjes volgroeid zijn."
                            }
                        ]
