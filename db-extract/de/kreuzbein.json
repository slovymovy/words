                        "glosses": [
                            "ein beim Menschen in etwa keilförmiger Knochen, auf dem die Wirbelsäule steht (lateinisch: Os sacrum)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aa0791e-b5f7-4f49-997d-036d9fc5beca",
                                "sense_id": "006b4351-4ac5-350e-87a4-0c23fd4c5349",
                                "text": "Beim Menschen sind die Kreuz- oder Sakralwirbel zum Kreuzbein verschmolzen."
                            },
                            {
                                "example_id": "122301a4-9fd8-4617-90ef-82eb99cba814",
                                "sense_id": "006b4351-4ac5-350e-87a4-0c23fd4c5349",
                                "text": "Das Kreuzbein ist ein Teil des menschlichen Körpers."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c39f6ce3-1dc7-4e49-8161-ec55dafae89e",
                        "source_entry_id": "538b8391-5d26-350c-b54f-aa82b74fdb2c",
