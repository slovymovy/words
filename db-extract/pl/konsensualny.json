                "translations": [
                    {
                        "translation_id": "870506fa-2605-482d-b608-b7c5d9cc340d",
                        "source_entry_id": "c2366281-2468-3853-b5f5-a73831507f70",
                        "source_sense_id": "9d1f19ea-df24-3bba-a56d-3b9e882e869b",
                        "target_lang_word": "consensual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consensual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6474e6ef-f98c-31f8-b223-fdb617d6924a",
                                        "entry_id": "c08cbfd3-cdc6-3919-8ada-77cc178ec078",
                                        "glosses": [
                                            "With permission, with consensus, without coercion; allowed without objecting or resisting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e60584f0-cf90-4b34-af9a-96b44de6047e",
                                                "sense_id": "6474e6ef-f98c-31f8-b223-fdb617d6924a",
                                                "text": "He'd operated on an almost permanent adrenaline high, a byproduct of youth and proficiency, jacked into a custom cyberspace deck that projected his disembodied consciousness into the consensual hallucination that was the matrix."
                                            },
                                            {
                                                "example_id": "67f815b2-478c-40d8-9eb1-7e498d896891",
                                                "sense_id": "6474e6ef-f98c-31f8-b223-fdb617d6924a",
                                                "text": "consensual sex"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95a0b710-ee30-35c1-acf0-8e66f1530921",
                                        "entry_id": "c08cbfd3-cdc6-3919-8ada-77cc178ec078",
                                        "glosses": [
                                            "Existing, or made, by the mutual consent of two or more parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d719542-6d5d-492c-959e-5895118c34b1",
                                                "sense_id": "95a0b710-ee30-35c1-acf0-8e66f1530921",
                                                "text": "a consensual contract"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f887d37-53ec-3a40-8ddc-0adcc821ebe9",
                                        "entry_id": "c08cbfd3-cdc6-3919-8ada-77cc178ec078",
                                        "glosses": [
                                            "Excited or caused by sensation, sympathy, or reflex action, and not by conscious volition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac6be3a-fc45-4cc4-b413-11e6d71b13ec",
                                                "sense_id": "9f887d37-53ec-3a40-8ddc-0adcc821ebe9",
                                                "text": "consensual motions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be9aa950-670d-34f8-9e01-ac31bfa9a825",
                                        "entry_id": "c08cbfd3-cdc6-3919-8ada-77cc178ec078",
                                        "glosses": [
                                            "Excited or caused by sensation, sympathy, or reflex action, and not by conscious volition.",
                                            "Contralaterally corresponding rather than ipsilaterally induced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68411be8-4d55-4437-86e4-79e16bd879ce",
                                                "sense_id": "be9aa950-670d-34f8-9e01-ac31bfa9a825",
                                                "text": "direct and consensual pupillary reflexes produce bilateral constriction from a unilateral stimulus"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bc3bd2e-bd07-4f45-8d34-5b29a05391c0",
                        "source_entry_id": "c2366281-2468-3853-b5f5-a73831507f70",
                        "source_sense_id": "9d1f19ea-df24-3bba-a56d-3b9e882e869b",
                        "target_lang_word": "consensuel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consensuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b19aacb-3135-3ff5-98b6-3406564e9283",
                                        "entry_id": "fff06901-ddbb-342e-bd6d-35675e7ad1d5",
                                        "glosses": [
                                            "Issu d’un consensus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f81a07d6-e645-4b09-94d5-25e57910b634",
                                                "sense_id": "4b19aacb-3135-3ff5-98b6-3406564e9283",
                                                "text": "Je me lève en prenant soin de traîner mes pieds enchâssés dans des chaussons si conformes que seule la coalition de la baguette de pain et du béret peut leur lancer le défi des clichés consensuels."
                                            },
                                            {
                                                "example_id": "3064b439-a706-4560-a1c2-75e60d5aae54",
                                                "sense_id": "4b19aacb-3135-3ff5-98b6-3406564e9283",
                                                "text": "C’est l’un des paradoxes de l’époque : on se plaint des interviews consensuelles et aseptisées, mais dès qu’un échange est un peu tendu, il est considéré comme un clash, dès qu’une parole surnage, ça devient l’engueulade du siècle."
                                            },
                                            {
                                                "example_id": "becec331-05eb-4320-b7b8-8f5770111014",
                                                "sense_id": "4b19aacb-3135-3ff5-98b6-3406564e9283",
                                                "text": "L’idée d’une famille nucléaire originelle est consensuelle chez les anthropologues américains : […]. Leur mérite n’est pas si grand : leurs sujets d’étude furent les Indiens de leur continent, dont la nucléarité familiale crevait les yeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d98cde8f-f76a-3771-ad1d-8b6a2e44c454",
                                        "entry_id": "fff06901-ddbb-342e-bd6d-35675e7ad1d5",
                                        "glosses": [
                                            "Qui est formé par le consentement des parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2458ea9f-07e1-40fc-b852-58aed66bbd48",
                                                "sense_id": "d98cde8f-f76a-3771-ad1d-8b6a2e44c454",
                                                "text": "Après avoir nié connaître la victime, il admet avoir entretenu « une liaison consensuelle » avec la jeune vendeuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
