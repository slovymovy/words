    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "32defe18-c284-3527-83c3-c21f5686163f",
                    "sense_definition": "nummer veertig in een rij",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "rangtelwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij viert dit weekend haar <w>veertigste</w> verjaardag met een groot feest.",
                            "target_lang_translations": {
                                "en": "She is celebrating her <w>fortieth</w> birthday with a big party this weekend.",
                                "ru": "В эти выходные она празднует свой <w>сороковой</w> день рождения с большой вечеринкой."
                            }
                        },
                        {
                            "text": "Hij eindigde op de <w>veertigste</w> plaats in de marathon.",
                            "target_lang_translations": {
                                "en": "He finished in <w>fortieth</w> place in the marathon.",
                                "ru": "Он финишировал на <w>сороковом</w> месте в марафоне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "veertigste verjaardag",
                        "de veertigste plaats"
                    ],
                    "target_lang_definitions": {
                        "en": "number forty in a sequence",
                        "ru": "сороковой по счету в ряду"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fortieth",
                                "target_lang_sense_clarification": "ordinal number 40th"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сороковой",
                                "target_lang_sense_clarification": "порядковое числительное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d891a3f-eed3-3089-af8e-10231078eb78",
                    "sense_definition": "overeenkomend met één van de veertig gelijke delen waarin iets verdeeld is",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "breuk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een <w>veertigste</w> deel van de winst gaat naar het goede doel.",
                            "target_lang_translations": {
                                "en": "A <w>fortieth</w> part of the profit goes to charity.",
                                "ru": "Одна <w>сороковая</w> часть прибыли идет на благотворительность."
                            }
                        },
                        {
                            "text": "Slechts een <w>veertigste</w> van de bevolking stemde tegen het voorstel.",
                            "target_lang_translations": {
                                "en": "Only one <w>fortieth</w> of the population voted against the proposal.",
                                "ru": "Только одна <w>сороковая</w> населения проголосовала против этого предложения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een veertigste deel"
                    ],
                    "target_lang_definitions": {
                        "en": "corresponding to one of forty equal parts into which something is divided",
                        "ru": "соответствующий одной из сорока равных частей, на которые что-либо разделено"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fortieth",
                                "target_lang_sense_clarification": "one of forty equal parts"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сороковая",
                                "target_lang_sense_clarification": "одна сороковая часть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
