                                "target_senses": [
                                    {
                                        "sense_id": "79674bff-4b9e-3094-8d0e-82b8b6ad9847",
                                        "entry_id": "f309d116-1109-37c4-84cb-825ba42cf65f",
                                        "glosses": [
                                            "účastník nebo organizátor puče"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b44933e9-c3fc-4a85-83e9-0f155339a36a",
                                                "sense_id": "79674bff-4b9e-3094-8d0e-82b8b6ad9847",
                                                "text": "Někteří pozorovatelé se divili, co všechno může pučistovi v Rusku projít, jiní (radikální nacionalisté) byli vyšuměním případu rozhořčeni."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcf6def2-9aa6-4d58-a7a9-5b90d84fb1f4",
                        "source_entry_id": "394a84dd-4a0f-3c66-97da-9d98aabd9d83",
                        "source_sense_id": "84fb0c17-42be-3586-823e-7f7207e3fdfe",
                        "source_sense_description": "one who participates in a putsch",
                        "target_lang_word": "couppleger",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couppleger",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fafe0902-cf71-30b3-bb99-b156523c4ef1",
                                        "entry_id": "898de055-682d-3a2e-a197-7c1bb0875583",
                                        "glosses": [
                                            "persoon die een staatsgreep pleegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d2db220-062e-4be0-922f-bcfe0e8d474f",
                                                "sense_id": "fafe0902-cf71-30b3-bb99-b156523c4ef1",
                                                "text": "Een jaar geleden werd Desi Bouterse beëdigd als president van Suriname. Er heerste veel scepsis over de toekomst van het land onder leiding van een veroordeelde drugsmokkelaar, couppleger en hoofdverdachte in een moordproces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "892af7db-f641-495e-8c43-0ba5e388e5a5",
                        "source_entry_id": "394a84dd-4a0f-3c66-97da-9d98aabd9d83",
                        "source_sense_id": "84fb0c17-42be-3586-823e-7f7207e3fdfe",
                        "source_sense_description": "one who participates in a putsch",
                        "target_lang_word": "putschist",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "putschist",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cd61c512-3424-3dae-bb39-a9ee106ee537",
                                        "entry_id": "fff6c776-fef1-38a3-9e93-f19e4e02f69e",
                                        "glosses": [
                                            "iemand die een staatsgreep pleegt of wil plegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0437929-e1ef-4324-8eee-61a69500626a",
                                                "sense_id": "cd61c512-3424-3dae-bb39-a9ee106ee537",
                                                "text": "Volgens officiële cijfers zijn sinds de poging tot staatsgreep tweeënhalf jaar geleden in totaal ongeveer 218.000 mensen gearresteerd wegens vermeende connecties met de putschisten. Ongeveer 31.000 van hen zijn veroordeeld of zitten nog steeds in hechtenis."
                                            },
                                            {
                                                "example_id": "df97e549-538d-49c1-be11-d54809f2948b",
                                                "sense_id": "cd61c512-3424-3dae-bb39-a9ee106ee537",
                                                "text": "‘De Bolivaarse strijdkrachten staan voor een historische taak’, verklaarde president Maduro donderdag voor duizenden soldaten in Fort Tiuna in Caracas. ‘Soldaten van het vaderland, het uur van de strijd is aangebroken. We moeten het heilige vuur van de militaire waarden ontsteken om het imperialisme, de verraders en de putschisten op de knieën te dwingen’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b192860-f320-41ed-a966-afffc1234664",
                        "source_entry_id": "394a84dd-4a0f-3c66-97da-9d98aabd9d83",
                        "source_sense_id": "84fb0c17-42be-3586-823e-7f7207e3fdfe",
                        "source_sense_description": "one who participates in a putsch",
                        "target_lang_word": "Putschist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Putschist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                                        "entry_id": "ebce70ba-687d-3126-92df-1d39bdc50de7",
                                        "glosses": [
                                            "Person, die einen Putsch plant und/oder durchführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f4fb367-fe50-492c-9312-0449815038ae",
                                                "sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                                                "text": "„Die Putschisten schlugen am 1. November los.“"
                                            },
                                            {
                                                "example_id": "06c558ad-64df-40b2-9103-895119cc4eaa",
                                                "sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                                                "text": "„Die Putschisten hatten den Flughafen geschlossen, das Telefonnetz der Stadt lahmgelegt, die Zentrale des Polizeihauptquartiers gestürmt, den Regierungssender besetzt und die Zentren der politischen Macht angegriffen.“"
                                            },
                                            {
                                                "example_id": "b0b684f2-3ac6-4c16-a309-7bdde7f920d7",
                                                "sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                                                "text": "„Nach drei Jahren auf dem Thron wird Iyasus 1916 von Putschisten abgesetzt, seine Truppen unterliegen in mehreren Schlachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
