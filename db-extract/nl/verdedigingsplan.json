                        "glosses": [
                            "voorgenomen handelingen om zich te verdedigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0f19d78-71b2-4169-94fc-6261674bf869",
                                "sense_id": "9d3328d5-ef10-37b3-96d7-a51d8180c1ff",
                                "text": "De internationale gemeenschap heeft onlangs een algemeen verdedigingsplan gepresenteerd dat zowel wat algemeen strategisch denken als de meest minutieuze technologische en militaire details betreft, compleet aan de ogen van de vijand is blootgesteld."
                            },
                            {
                                "example_id": "f77074ff-3ba3-45b9-894e-a0a476b7dc8d",
                                "sense_id": "9d3328d5-ef10-37b3-96d7-a51d8180c1ff",
                                "text": "Want al die hoge gewichtige militairen uit andere steden, hoewel ze hun eigen vesting zonder slag of stoot aan de Pruisen en Oranje overgaven, hebben niettemin een groot woord in de verdedigingsplannen van Amsterdam en met het uur wordt de stemming geprikkelder, er vallen van weerszijden bittere verwijten, heftige beledigingen, in de stad vertellen de burgers elkaar dat twee van de hoogste militairen bij het Muiderveld hebben geduelleerd."
                            }
                        ]
                    }
