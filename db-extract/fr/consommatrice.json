                                "target_senses": [
                                    {
                                        "sense_id": "53971e93-5f06-3e99-b2e7-fd97037e4149",
                                        "entry_id": "17ac4209-1eed-302f-8aea-eac25a282718",
                                        "glosses": [
                                            "weibliche Person, die Waren ersteht und verbraucht"
                                        ],
