                ],
                "senses": [
                    {
                        "sense_id": "c1fa8633-45c7-38a0-b8bd-f4a7a5faa259",
                        "entry_id": "d1141896-79f6-3ca6-a1d5-2553bc4da5c1",
                        "glosses": [
                            "das zur Kenntnis Gelangen; Veröffentlichen (von Vertraulichem)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "740ea6da-cf2d-44f0-8cc1-f081734fc8c7",
                                "sense_id": "c1fa8633-45c7-38a0-b8bd-f4a7a5faa259",
                                "text": "„[…] ([…] in der Praxis werde diese Bestimmung oftmals als rigoroser Rückforderungsanspruch des Versicherungsträgers bei sämtlichen nachträglich bekanntgewordenen Weiterleistungen von Geld- und Sachbezügen angewendet, auch wenn dem Versicherungsträger an dieser nachträglichen Bekanntwerdung ein erhebliches Verschulden treffe).“"
                            },
                            {
                                "example_id": "902bf66c-3a37-4aaf-90df-b0dfa51e4e14",
                                "sense_id": "c1fa8633-45c7-38a0-b8bd-f4a7a5faa259",
                                "text": "„Der Magistrat sucht diese Unordnungen zu verbergen, und unterdrückt möglichst ihre Bekanntwerdungen.“"
                            },
                            {
                                "example_id": "2ca6e4a6-43c7-4ce4-8f6e-de5d7143deba",
                                "sense_id": "c1fa8633-45c7-38a0-b8bd-f4a7a5faa259",
                                "text": "„Auch die wichtige Zeitung, daß der Richter einen noch lebenden Vater habe, dessen Bekanntwerdung vom Grafen abhängt, vermag ihn nicht zu verführen; er ergiebt sich dem Mangel, dem er durch den Verlust seiner Stelle sich blos setzt.“"
                            },
                            {
                                "example_id": "e0b8804d-4680-42ed-bf72-c88c2eb568ed",
                                "sense_id": "c1fa8633-45c7-38a0-b8bd-f4a7a5faa259",
                                "text": "„Die Richterin befand es als ‚merkwürdig‘, dass die Diagnose nur wenige Tage nach Bekanntwerdung der Insolvenzverschleppung erging und nicht schon in den Monaten vorher.“"
                            },
                            {
                                "example_id": "d3a5ebff-a49c-423f-83f4-e1c93c1c0706",
                                "sense_id": "c1fa8633-45c7-38a0-b8bd-f4a7a5faa259",
                                "text": "„Man weiß von Göthe selbst, mit welchen treffenden Urtheilen dieser eigne Mann, dessen Charakteristik nach der Bekanntwerdung der an ihn gerichteten Briefe und nach Vergleichung seiner literarischen Arbeiten etwas klarer als die Göthische ausfallen kann, auch früher Göthen in seiner Wirksamkeit leitete oder begleitete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6bae1b4f-f2a3-3c47-81db-165453d5e07f",
                        "entry_id": "d1141896-79f6-3ca6-a1d5-2553bc4da5c1",
                        "glosses": [
                            "das Erlangen der allgemeinen Bekanntheit; weites Verbreiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4866fc98-5b6c-4587-873d-9c75b4da74f0",
                                "sense_id": "6bae1b4f-f2a3-3c47-81db-165453d5e07f",
                                "text": "„Der Tabak hat bei seiner Bekanntwerdung und Verbreitung in Europa mancherlei Tadel und Verfolgungen erdulden müssen. “"
                            },
                            {
                                "example_id": "4e201842-110e-4220-9236-f7fb22f4f30d",
                                "sense_id": "6bae1b4f-f2a3-3c47-81db-165453d5e07f",
                                "text": "„Eben so wenig kann ein geringer Grad von Verbreitung Milderungsgrund sein, weil die mehrere oder wenigere Bekanntwerdung an und für sich in der Sache nichts ändert.“"
                            },
                            {
                                "example_id": "289bbe56-3061-4921-aa58-4945370c8959",
                                "sense_id": "6bae1b4f-f2a3-3c47-81db-165453d5e07f",
                                "text": "„Heartbleed wurde seit seiner Bekanntwerdung vor wenigen Wochen mit vielen dramatischen Beinamen bedacht.“"
                            },
                            {
                                "example_id": "b22f63f1-275b-4051-a06c-7ce303160bc6",
                                "sense_id": "6bae1b4f-f2a3-3c47-81db-165453d5e07f",
                                "text": "„Leider hat die Art der Bekanntwerdung den ersten Eindruck getrübt.“"
                            },
                            {
                                "example_id": "e448c033-591c-4988-a5c0-51977b7d85b2",
                                "sense_id": "6bae1b4f-f2a3-3c47-81db-165453d5e07f",
                                "text": "„Die Agentur ist mit der Platzierung der Marke und deren Bekanntwerdung sowie die dazu nötigen Kommunikationsaufgaben verantwortlich.“"
                            },
                            {
                                "example_id": "b8dcd444-7b5e-4bad-a035-5bf8bd8f393c",
                                "sense_id": "6bae1b4f-f2a3-3c47-81db-165453d5e07f",
                                "text": "„Es folgt hier also zuerst Hellas im Allgemeinen, und zwar habe ich im ersten Capitel von der allmähligen Bekanntwerdung Griechenlands durch die Quellenschriftsteller […] gehandelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c8d24f28-e035-34ac-b372-da55585029ae",
                        "entry_id": "d1141896-79f6-3ca6-a1d5-2553bc4da5c1",
                        "glosses": [
                            "das (gegenseitige) Kennenlernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b693f9e1-7c06-47c7-8d17-04c9162f5ff4",
                                "sense_id": "c8d24f28-e035-34ac-b372-da55585029ae",
                                "text": "„So muss die Bekanntwerdung von zwei Personen nicht in einem Beziehungsaufbau münden und eine verfestigte Beziehung muss nicht über eine Verschlechterung zu ihrer Auflösung führen.“"
                            },
                            {
                                "example_id": "64775dc3-936c-467a-b73d-ed22525148e9",
                                "sense_id": "c8d24f28-e035-34ac-b372-da55585029ae",
                                "text": "„Neben der strukturellen und persönlichen Bekanntwerdung mit dem Ablauf und Aufbau des B.A.-Studiums sind Recherche, Selbstreflexion, Planung und wissenschaftliches Schreiben Fähigkeiten, die das Tutorium zu vermitteln sucht.“"
                            },
                            {
                                "example_id": "582bd881-48fe-426e-982e-36d76850776a",
                                "sense_id": "c8d24f28-e035-34ac-b372-da55585029ae",
                                "text": "„Die Besichtigung und Bekanntwerdung mit dem Lebenswerk des Künstlers stehen mittels literarischer Interventionen im Mittelpunkt des Interesses.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
