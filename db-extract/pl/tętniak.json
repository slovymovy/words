                "senses": [
                    {
                        "sense_id": "85a30221-b0e3-37d4-ad6f-178aa14877ae",
                        "entry_id": "05b852c1-5c32-309b-899d-e082118225bb",
                        "glosses": [
                            "ograniczone poszerzenia światła tętnicy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "342c9b41-6309-4ed3-a9d2-ca61d62713a7",
                                "sense_id": "85a30221-b0e3-37d4-ad6f-178aa14877ae",
                                "text": "Tętniak jest objawem poważnej choroby."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a39dc35c-e24a-4d9f-842b-bd6c0dbac5c4",
                        "source_entry_id": "05b852c1-5c32-309b-899d-e082118225bb",
                        "source_sense_id": "85a30221-b0e3-37d4-ad6f-178aa14877ae",
                        "target_lang_word": "aneurysm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aneurysm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a92c9bb-b07a-3d45-aaa5-3ebaa3093c6d",
                                        "entry_id": "812c0c71-eefa-3da3-88de-c6ed89a27352",
                                        "glosses": [
                                            "An abnormal blood-filled swelling of an artery or vein, resulting from a localized weakness in the wall of the vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8a87df8-1946-4d3f-ac8d-f7e735b742b9",
                                                "sense_id": "8a92c9bb-b07a-3d45-aaa5-3ebaa3093c6d",
                                                "text": "About 120,000 people were helping with the two-week annual harvest and “obviously you’re going to have some accidents”, he said. Every year, “one or two people” died from heart failure or aneurysms, he added."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fede9b3-acbc-453a-ac29-b78090c73e83",
                        "source_entry_id": "05b852c1-5c32-309b-899d-e082118225bb",
                        "source_sense_id": "85a30221-b0e3-37d4-ad6f-178aa14877ae",
                        "target_lang_word": "aneurysma",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aneurysma",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e8067b87-fde5-3393-9af0-7aac28e24ee1",
                                        "entry_id": "e2baaa80-9f09-3c29-b7b7-aeb8748ed3a7",
                                        "glosses": [
                                            "rozšíření cévy nebo srdce na místě, kde byla stěna oslabena chorobou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01356491-fbc4-425c-a20c-5bf3f684d179",
                                                "sense_id": "e8067b87-fde5-3393-9af0-7aac28e24ee1",
                                                "text": "Aneurysma nehmatám."
                                            },
                                            {
                                                "example_id": "270e8e42-aa05-4860-9785-30db07748685",
                                                "sense_id": "e8067b87-fde5-3393-9af0-7aac28e24ee1",
                                                "text": "Příčinou úmrtí pravnučky posledního českého krále Karla I. Habsburského (1887–1922) bylo podle lékařů aneurysma srdce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03f18230-2575-4d8d-b54d-d5f72a9e2ab0",
                        "source_entry_id": "05b852c1-5c32-309b-899d-e082118225bb",
                        "source_sense_id": "85a30221-b0e3-37d4-ad6f-178aa14877ae",
                        "target_lang_word": "anévrisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anévrisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e591ca4-c3ca-3986-8e52-a9aa683d1e5e",
                                        "entry_id": "c6c008ec-60b5-32e6-853f-c2047d7ae000",
                                        "glosses": [
                                            "Tumeur produite sur le trajet d’une artère par la dilatation des membranes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac75394-57f2-4d11-8d11-61cb9a63207d",
                                                "sense_id": "5e591ca4-c3ca-3986-8e52-a9aa683d1e5e",
                                                "text": "L’autopsie à laquelle on a procédé sur-le-champ a démontré que cette mort était due à la rupture d’un anévrisme à son dernier période."
                                            },
                                            {
                                                "example_id": "b78dcad4-6784-4a49-a7e6-015e0717de5e",
                                                "sense_id": "5e591ca4-c3ca-3986-8e52-a9aa683d1e5e",
                                                "text": "Je me rappelle, à la Charité, un malheureux atteint d’un énorme anévrisme de l’aorte, lequel avait rongé peu à peu la cage thoracique et battait sous la peau. Nous attendions, d’une minute à l’autre, l`issue fatale."
                                            },
                                            {
                                                "example_id": "8d3da1f6-6c6f-432f-9827-ed8bb993b85e",
                                                "sense_id": "5e591ca4-c3ca-3986-8e52-a9aa683d1e5e",
                                                "text": "Le curé ne s’en effrayait pas pour les enfants, mais bien pour les vieux, qui risquaient d’être emportés par une rupture d’anévrisme ou de n’importe quoi, avec un noir péché sur la conscience."
                                            },
                                            {
                                                "example_id": "a1a291b0-d8eb-46ca-af8f-ab5ab4cdcaad",
                                                "sense_id": "5e591ca4-c3ca-3986-8e52-a9aa683d1e5e",
                                                "text": "Pépé-Salpêtre, ayant accroché sa ligne par mégarde, avait sans doute essayé de la dégager, puis, n'y réussissant pas, s’était subitement mis en colère, avait esquissé un grand geste pour tout rompre, et s’était effectivement rompu du coup son gut et son anévrisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "772927d6-f461-36b3-bdd3-d6f6c2b315cd",
                                        "entry_id": "c6c008ec-60b5-32e6-853f-c2047d7ae000",
                                        "glosses": [
                                            "Lésion des veines et des artères."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bff4c26c-97d5-3949-9bfb-884090c509ee",
                                        "entry_id": "c6c008ec-60b5-32e6-853f-c2047d7ae000",
                                        "glosses": [
                                            "Dilatation morbide du cœur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca4cfcb8-a6cb-44dc-acee-6b011608010c",
                                                "sense_id": "bff4c26c-97d5-3949-9bfb-884090c509ee",
                                                "text": "Diplomate, un anévrisme suspend dans votre cœur la mort à un fil."
                                            },
                                            {
                                                "example_id": "838fecb4-652f-4ac4-866f-11caad52be05",
                                                "sense_id": "bff4c26c-97d5-3949-9bfb-884090c509ee",
                                                "text": "Mon père venait de mourir d’un anévrisme dont il souffrait depuis longtemps, et ce fut moi qui reçus la lettre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
