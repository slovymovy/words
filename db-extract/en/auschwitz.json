                                    {
                                        "sense_id": "6ecf4ad1-ebfd-3c83-9d69-0ca8bb11972e",
                                        "entry_id": "066b0598-1d4b-3a3c-9f62-a17bc6955d1e",
                                        "glosses": [
                                            "miasto w Polsce w województwie małopolskim"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c3ec33f-ab73-47bb-bea7-83a6fedd5ba5",
                                                "sense_id": "6ecf4ad1-ebfd-3c83-9d69-0ca8bb11972e",
                                                "text": "W tym celu sprzedał niezwłocznie tereny węglowe między Krakowem i Oświęcimiem oraz wszystkie nowo otwarte i w ruch puszczone kopalnie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "c9cf5889-f002-3307-85e4-27c37bbaaad9",
                                        "entry_id": "066b0598-1d4b-3a3c-9f62-a17bc6955d1e",
                                        "glosses": [
                                            "nazwa hitlerowskiego obozu zagłady Auschwitz-Birkenau zlokalizowanego w mieście Oświęcim (1.1)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ff47c68-47ce-4d32-a7da-09d7585c1c39",
                                                "sense_id": "c9cf5889-f002-3307-85e4-27c37bbaaad9",
                                                "text": "Zapomnieć, że mkną nocami pociągi wiozące lud z kraju do Oświęcimia, polską siłę, którą daje się dobrowolnie Niemcom!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
