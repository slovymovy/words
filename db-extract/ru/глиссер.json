                "senses": [
                    {
                        "sense_id": "92e2006f-73aa-322f-bbc1-8ab0e70b4023",
                        "entry_id": "b1d96cf1-aed0-3e4a-8dc9-3cb4ec67375c",
                        "glosses": [
                            "небольшое быстроходное плоскодонное судно (катер), при движении скользящее по поверхности воды"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b37ddb1-edd7-44f6-81c0-0a8e70964150",
                                "sense_id": "92e2006f-73aa-322f-bbc1-8ab0e70b4023",
                                "text": "Вздымая волны, мчались быстрые глиссеры."
                            },
                            {
                                "example_id": "94348ba5-f028-4849-ab5c-306e22de77a5",
                                "sense_id": "92e2006f-73aa-322f-bbc1-8ab0e70b4023",
                                "text": "этот путь, / прорезаемый глиссером // в предвечерний / речной туман, ― // наш, / усыпанный водным бисером, // завершающийся / роман."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7023ee06-17a7-4742-b65c-35ea5486a1ac",
                        "source_entry_id": "b1d96cf1-aed0-3e4a-8dc9-3cb4ec67375c",
                        "source_sense_id": "92e2006f-73aa-322f-bbc1-8ab0e70b4023",
                        "target_lang_word": "glisser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aeb7ef57-a1f7-410e-a439-701645c491ab",
                        "source_entry_id": "b1d96cf1-aed0-3e4a-8dc9-3cb4ec67375c",
                        "source_sense_id": "92e2006f-73aa-322f-bbc1-8ab0e70b4023",
                        "target_lang_word": "glisseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3952c64-14f9-3503-99e0-8dd2a7f587de",
                                        "entry_id": "be2902b6-3cfb-3ffd-a628-b9d0b06d81b1",
                                        "glosses": [
                                            "Celui qui glisse sur la glace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd96c79-7f1d-49ba-808c-32bfdee20f25",
                                                "sense_id": "e3952c64-14f9-3503-99e0-8dd2a7f587de",
                                                "text": "De temps en temps, un des glisseurs perdait bien l’équilibre, culbutait et tous ceux qui suivaient prenaient la bûche derrière lui, roulant l’un sur l’autre parmi la neige fine qui vous glaçait les doigts et vous fichait l’onglée."
                                            },
                                            {
                                                "example_id": "bfd0bc8a-af57-4e35-b901-8ccb204a79a2",
                                                "sense_id": "e3952c64-14f9-3503-99e0-8dd2a7f587de",
                                                "text": "Mais après avoir remporté haut la main le chalenge des glisseurs RGP, te voilà championne WRC de rallye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76f66038-5908-30a5-a878-b8d19fcae548",
                                        "entry_id": "be2902b6-3cfb-3ffd-a628-b9d0b06d81b1",
                                        "glosses": [
                                            "Celui qui glisse sur la neige."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c927952-5551-4ebd-a987-f78b07165fc4",
                                                "sense_id": "76f66038-5908-30a5-a878-b8d19fcae548",
                                                "text": "Les critères de progression sont atteints lorsque le glisseur revient à la ligne de pente après en être sorti, et lorsque sa trace dessine des serpentins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a9c287b-d4fc-3ff2-9a45-d5e6091b11ef",
                                        "entry_id": "a12905d4-2630-3cec-aef7-abbc110992fe",
                                        "glosses": [
                                            "Torseur dont le moment s’annule sur une droite. Torseur dont la résultante est perpendiculaire au moment."
                                        ],
