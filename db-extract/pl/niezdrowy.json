        "pl-extract.jsonl": [
            {
                "entry_id": "5fc34ad7-2ca6-3144-a0d4-2115668d7e63",
                "word": "niezdrowy",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "53ddaf51-672d-3291-8ca8-cacc2f92c5eb",
                        "entry_id": "5fc34ad7-2ca6-3144-a0d4-2115668d7e63",
                        "glosses": [
                            "chory lub nie do końca zdrowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6dfabf4-bbec-4cb9-8ddb-a41f1c9e20cb",
                                "sense_id": "53ddaf51-672d-3291-8ca8-cacc2f92c5eb",
                                "text": "Spójrz na niego; wygląda, jakby był niezdrowy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f6362977-57e8-34de-b1b4-45858b32b9f2",
                        "entry_id": "5fc34ad7-2ca6-3144-a0d4-2115668d7e63",
                        "glosses": [
                            "szkodliwy dla zdrowia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ba2826-1e94-4bb8-975a-d8b6cc9caa2d",
                                "sense_id": "f6362977-57e8-34de-b1b4-45858b32b9f2",
                                "text": "Dlaczego kupujesz keczup z benzoesanem sodu?! Niektórzy mówią, że ten związek jest bardzo niezdrowy!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "de7c8dfd-7c3e-3f32-88e5-64990611f24e",
                        "entry_id": "5fc34ad7-2ca6-3144-a0d4-2115668d7e63",
                        "glosses": [
                            "niedziałający w sposób prawidłowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a812c3c-2076-47b4-8f80-69f3f74c87f4",
                                "sense_id": "de7c8dfd-7c3e-3f32-88e5-64990611f24e",
                                "text": "Od dawna twierdzą, że ten system jest niezdrowy."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "0065f13f-bf6e-3ff7-ad22-eb04c9758021",
                        "entry_id": "5fc34ad7-2ca6-3144-a0d4-2115668d7e63",
                        "glosses": [
                            "nierozsądny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6252dc60-72ff-4dd1-9bc8-315a8345054f",
                                "sense_id": "0065f13f-bf6e-3ff7-ad22-eb04c9758021",
                                "text": "Jego niezdrowe podejście do wolnego czasu już wiele razy przysporzyło mu kłopotów."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "3e1a2293-eb16-3492-9ed5-d43ecad1e233",
                        "entry_id": "5fc34ad7-2ca6-3144-a0d4-2115668d7e63",
                        "glosses": [
                            "szkodliwy ze względów moralnych"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.5\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b36e167-80f1-40ad-9409-700c7ee6b1c2",
                        "source_entry_id": "5fc34ad7-2ca6-3144-a0d4-2115668d7e63",
                        "source_sense_id": "53ddaf51-672d-3291-8ca8-cacc2f92c5eb",
                        "target_lang_word": "unhealthy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unhealthy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46da03a5-a19d-3f21-8494-fbc6884e0f87",
                                        "entry_id": "4568de68-0a18-391b-a822-e8f27c326f0c",
                                        "glosses": [
                                            "characterized by, or conducive to poor health"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c0a38d0-8e87-4ecd-a189-a9362089cc55",
                                                "sense_id": "46da03a5-a19d-3f21-8494-fbc6884e0f87",
                                                "text": "The villagers lived in unhealthy surroundings."
                                            },
                                            {
                                                "example_id": "c0d6143e-ca73-45da-b6b4-73ba78bd9c3d",
                                                "sense_id": "46da03a5-a19d-3f21-8494-fbc6884e0f87",
                                                "text": "It makes up an estimated 73 percent of the U.S. food supply, and contains stereotypically “unhealthy” products like sodas, candies and hot dogs as well as seemingly “healthy” ones like whole grain breads, breakfast cereals, flavored yogurts and plant milks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "268bb33b-49ce-3fd8-9d3a-9e1f68b1ff7b",
                                        "entry_id": "4568de68-0a18-391b-a822-e8f27c326f0c",
                                        "glosses": [
                                            "sick or ill"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a3a12e-6974-4bf3-93dc-3e8ccb7e6267",
                                                "sense_id": "268bb33b-49ce-3fd8-9d3a-9e1f68b1ff7b",
                                                "text": "He was an unhealthy child."
                                            },
                                            {
                                                "example_id": "542cde00-95fe-40e4-9bcc-42cbdca60bef",
                                                "sense_id": "268bb33b-49ce-3fd8-9d3a-9e1f68b1ff7b",
                                                "text": "‘And at once he'll be on his high-horse – he knows everything! – and he'll prove, prove, that all unhealthy children must be lethal-chambered or the world will go to pieces.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b378d1f5-3f50-3d4f-918d-7603f5a73500",
                                        "entry_id": "4568de68-0a18-391b-a822-e8f27c326f0c",
                                        "glosses": [
                                            "tending to corrupt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5f1df4b-4794-43b4-ae05-d2613709226d",
                                                "sense_id": "b378d1f5-3f50-3d4f-918d-7603f5a73500",
                                                "text": "He liked unhealthy reading material."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cedb931-d428-3169-b1ab-dde17fb3a61a",
                                        "entry_id": "4568de68-0a18-391b-a822-e8f27c326f0c",
                                        "glosses": [
                                            "characterized by disturbed mental health"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c76e21ec-9c97-496b-a2a3-26e87232e211",
                                                "sense_id": "4cedb931-d428-3169-b1ab-dde17fb3a61a",
                                                "text": "He had an unhealthy interest in fire."
                                            }
                                        ]
                                    }
                                ]
                            }
