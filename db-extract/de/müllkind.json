                "senses": [
                    {
                        "sense_id": "702be3c1-cbb8-3e8f-a3b1-2938985a6893",
                        "entry_id": "2f4b7ac2-9b5f-3d58-a501-2ac7cafbc7d6",
                        "glosses": [
                            "Kinder der 3. Welt die im Müll leben, arbeiten und versuchen darin zu überleben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cd77618-148e-42ff-ae87-c3185f2d1ea7",
                                "sense_id": "702be3c1-cbb8-3e8f-a3b1-2938985a6893",
                                "text": "„Die Müllkinder sind vielen Gefahren ausgesetzt.“"
                            },
                            {
                                "example_id": "fdb72aff-6e31-4b23-9e1f-ebd04f33b7be",
                                "sense_id": "702be3c1-cbb8-3e8f-a3b1-2938985a6893",
                                "text": "„Bereits im September berichtete EXPLOSIV über die Müllkinder aus Manila.“"
                            },
                            {
                                "example_id": "6b73affb-b9dc-4199-888c-c23e84d98a0e",
                                "sense_id": "702be3c1-cbb8-3e8f-a3b1-2938985a6893",
                                "text": "„Er begleitet den Jungen und erlebt, wie die Müllkinder von Cebu jeden Tag aufs Neue nach Brauchbarem suchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4eed82fc-f5c3-34cc-9575-ee536b53f186",
                        "entry_id": "2f4b7ac2-9b5f-3d58-a501-2ac7cafbc7d6",
                        "glosses": [
                            "abwertende Beurteilung einer Lebenssituation von Kindern in einer von Müll verunreinigten Umgebung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f1a4f35-112f-4593-88b6-2a320d865929",
                                "sense_id": "4eed82fc-f5c3-34cc-9575-ee536b53f186",
                                "text": "„Die Berliner Lokalpresse spricht schon von den Müllkindern von Neukölln.“"
                            },
                            {
                                "example_id": "696c2345-6536-4301-a136-631c0a043e83",
                                "sense_id": "4eed82fc-f5c3-34cc-9575-ee536b53f186",
                                "text": "„Alle haben Mitleid mit den Müllkindern von Kairo.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
