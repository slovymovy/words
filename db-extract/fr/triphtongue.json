                "senses": [
                    {
                        "sense_id": "d12313fd-906d-3522-b693-ef7b79189d3a",
                        "entry_id": "97cb7f96-6581-387a-b37e-a8a0a531c6ed",
                        "glosses": [
                            "Syllabe composée de trois voyelles qu’on prononce d’une seule émission de voix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f01eb37-6b48-499c-9fd8-848c879a26df",
                                "sense_id": "d12313fd-906d-3522-b693-ef7b79189d3a",
                                "text": "Ai ou la fausse triphtongue eai, en un seul son, remplace dans les terminaisons le groupe français eau, auquel correspond le bourguignon et le poitevin â, éa, ià."
                            },
                            {
                                "example_id": "e140113c-e8eb-4769-a2cb-2dda6d8fe78b",
                                "sense_id": "d12313fd-906d-3522-b693-ef7b79189d3a",
                                "text": "Eu égard à mon activité, la seule majusculisation de mes nom et prénom suffirait. DICK LAPELOUSE. Pas de chichi, pas de truc emberlificoté avec des termes en triphtongues pour définir la raison sociale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f77085a8-abc6-4b8f-af9d-a99ea6061417",
                        "source_entry_id": "97cb7f96-6581-387a-b37e-a8a0a531c6ed",
                        "source_sense_id": "d12313fd-906d-3522-b693-ef7b79189d3a",
                        "target_lang_word": "Triphthong",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Triphthong",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9944b290-ca98-3d11-84d8-38399ed9b54e",
                                        "entry_id": "b58dcdb7-9c8e-33a3-b8e8-f8fccd1de48c",
                                        "glosses": [
                                            "Kombination aus drei Vokalen hintereinander"
                                        ],
                                        "tags": [
                                            "Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ddd0172-508e-41bb-96c8-332a27d3e6b2",
                                                "sense_id": "9944b290-ca98-3d11-84d8-38399ed9b54e",
                                                "text": "„Im Hochdeutschen kommen Triphthonge fast nie vor, weil sie im Laufe der Sprachgeschichte zu Diphthongen oder einfachen Vokalen vereinfacht wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2d3c773-c275-4849-aa0e-7cdf87800a1c",
                        "source_entry_id": "97cb7f96-6581-387a-b37e-a8a0a531c6ed",
