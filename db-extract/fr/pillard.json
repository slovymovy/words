                        ],
                        "form": "pillards"
                    },
                    {
                        "form_id": "047f2eec-7b7e-4154-89fd-cb34157b0eae",
                        "entry_id": "f04a5454-ceda-324e-82a2-1b5f5f815b1c",
                        "tags": [
                            "feminine"
                        ],
                        "form": "pillarde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "867db1d1-7782-3dc3-a20a-1b1ce7df3f4a",
                        "entry_id": "f04a5454-ceda-324e-82a2-1b5f5f815b1c",
                        "glosses": [
                            "Celui qui pille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe7262c-fb3f-460e-afe0-46baebf2e31d",
                                "sense_id": "867db1d1-7782-3dc3-a20a-1b1ce7df3f4a",
                                "text": "Mais on commence à sonner le « toquesin » à l'approche des « bandes » qui passent la Meuse pour « manger aussi à leur tour » ; et, en juin, les paysans exaspérés se soulèvent à Beaumont, à la Besace, en juillet, à Cheveuges, à Vendresse, et infligent des pertes sérieuses aux pillards ennemis et aux régiments étrangers."
                            },
                            {
                                "example_id": "cbf99282-030c-4507-bb0e-ad0a5edfbcec",
                                "sense_id": "867db1d1-7782-3dc3-a20a-1b1ce7df3f4a",
                                "text": "Piu avait lancé son poignard, stoppant net la course d’un pillard, mais elle se retrouvait désarmée face au dernier."
                            },
                            {
                                "example_id": "d11a53a9-6a4b-456b-afa4-54b08e52ec98",
                                "sense_id": "867db1d1-7782-3dc3-a20a-1b1ce7df3f4a",
                                "text": "Maraudeurs effrénés ! s’écria-t-il, si jamais je deviens roi d’Angleterre, je pendrai ces pillards aux ponts-levis de leurs propres châteaux."
                            },
                            {
                                "example_id": "127b52d6-f837-4470-a338-6e1d620c705f",
                                "sense_id": "867db1d1-7782-3dc3-a20a-1b1ce7df3f4a",
                                "text": "Les patrouilles de surveillance qui, d’abord, avaient impitoyablement fusillé les maraudeurs et les pillards, étaient maintenant dispersées par l’épidémie […]."
                            },
                            {
                                "example_id": "dd85be3c-8a5d-497a-80b4-5c2ff829c160",
                                "sense_id": "867db1d1-7782-3dc3-a20a-1b1ce7df3f4a",
                                "text": "Il est expédient de bifurquer à faux pour dérouter les pillards qui braconnent les tenderies dès l'aube, avant le propriétaire."
                            },
                            {
                                "example_id": "e9a92b05-3712-445e-842c-901e646b1261",
                                "sense_id": "867db1d1-7782-3dc3-a20a-1b1ce7df3f4a",
                                "text": "Le 7 janvier 1636, un recès du Chapitre Cathédral de Liège ordonne aux habitants de Tilff et de Méry de prendre les armes pour garantir la circulation sur l'Ourthe, alors menacée par des pillards croates."
                            }
                        ]
                    },
                    {
                        "sense_id": "7525e3d1-1283-32ac-919b-9baf53d4806e",
                        "entry_id": "f04a5454-ceda-324e-82a2-1b5f5f815b1c",
                        "glosses": [
                            "Plagiaire."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e937fcf9-ddc5-4ebd-93d4-944307d41a1c",
                                "sense_id": "7525e3d1-1283-32ac-919b-9baf53d4806e",
                                "text": "C'est un travail de pillard habilement présenté, pas une recherche digne de ce nom!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "837074cf-12d5-42a6-b847-03e82c35e3f3",
                        "source_entry_id": "f04a5454-ceda-324e-82a2-1b5f5f815b1c",
                        "target_lang_word": "Plünderer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plünderer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                        "entry_id": "32b88e11-397b-3207-97e4-3e19c46c9a74",
                                        "glosses": [
                                            "Person, die Sachen entwendet und dabei Gewalt anwendet/große Zerstörung hinterlässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf08cf5c-681d-40f7-bbc7-0c957c73043e",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "Nach dem Krieg wurden Plünderer mit dem Tode bestraft."
                                            },
                                            {
                                                "example_id": "03e18353-f856-422a-b597-e688b963e296",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "„Slawische und finnische Stämme leben in dieser dünn besiedelten Region; lohnende Ziele für Plünderer wie etwa Städte oder Klöster gibt es nicht.“"
                                            },
                                            {
                                                "example_id": "e59f32e6-fc8a-4e1b-810a-e0f774597556",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "„Auf Anmarschrouten von 500 und mehr Kilometern bewegten sich die Plünderer aus der Tiefe der Wildnis heraus, um die spanischen Vorposten und Bauerndörfer anzugreifen, in denen Großgrundbesitzer Haciendas betrieben und die Felder von Mestizen und versklavten Indios bestellen ließen.“"
                                            },
                                            {
                                                "example_id": "be35b11b-364c-4d7d-a537-fc2eda823c79",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "„Ich schaffe es einfach nicht, da hineinzuklettern und sie wie ein Plünderer zu durchstöbern; ich kehre um.“"
                                            },
                                            {
                                                "example_id": "1977cf66-6282-4e56-95a8-8c1832304087",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "„Trotz der strengen Auflagen und ein oder zwei ziemlich heftiger Beispiele für Srafen, die der Kommodore verhängte, waren die Black Jokers in jener Nacht an Land nicht die einzigen Plünderer gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "067147dd-4bc2-4e9b-bf83-3009d0398fe3",
                        "source_entry_id": "f04a5454-ceda-324e-82a2-1b5f5f815b1c",
