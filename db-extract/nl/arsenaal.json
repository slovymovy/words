                        ],
                        "examples": [
                            {
                                "example_id": "9f27abde-c806-4500-8823-416901e411c3",
                                "sense_id": "0577314e-a92f-332a-af08-7ed348a476b4",
                                "text": "Bij wijze van warming-up speelden Jagger, Richards en drummer Charlie Watts een bluesje, puttend uit het enorme arsenaal dat hun ter beschikking staat sinds ze in december 1962 Howlin’ Wolfs ‘Smokestack Lighting’ instudeerden."
                            },
                            {
                                "example_id": "032101aa-4382-44e7-9fc7-6016f5b1309f",
                                "sense_id": "0577314e-a92f-332a-af08-7ed348a476b4",
                                "text": "'Ben er een slordige vier uur mee bezig geweest om die krengen binnen te halen.' Hierna toverde hij de vermoeide mimiek van een uitgeputte diepzeevisser uit zijn arsenaal van imitaties."
                            }
                        ]
                    }
