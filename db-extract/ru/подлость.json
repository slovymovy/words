                ],
                "senses": [
                    {
                        "sense_id": "95488ec0-6ac7-3388-bf95-29c1fad4ac50",
                        "entry_id": "096ae8f4-8715-37f8-b3d6-3e6904f26936",
                        "glosses": [
                            "свойство по значению прилагательного подлый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aad0c33-3169-4ec3-8ff8-b9d87054fc89",
                                "sense_id": "95488ec0-6ac7-3388-bf95-29c1fad4ac50",
                                "text": "Миллионщик имеет ту выгоду, что может видеть подлость, совершенно бескорыстную, чистую подлость, не основанную ни на каких расчётах: многие очень хорошо знают, что ничего не получат от него и не имеют никакого права получить, но непременно хоть забегут ему вперёд, хоть засмеются, хоть снимут шляпу, хоть напросятся насильно на тот обед, куда узнают, что приглашён миллионщик."
                            }
                        ]
                    },
                    {
                        "sense_id": "25d32900-7b42-3289-806d-46a13bab578c",
                        "entry_id": "096ae8f4-8715-37f8-b3d6-3e6904f26936",
                        "glosses": [
                            "подлый поступок"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58a6fb48-405f-482e-9c77-2b4f94efa94b",
                        "source_entry_id": "096ae8f4-8715-37f8-b3d6-3e6904f26936",
                        "target_lang_word": "meanness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meanness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f14b494-17a9-3162-a44d-cff056411adf",
                                        "entry_id": "1e3dc032-1779-33ef-b54e-2836e0faae4f",
                                        "glosses": [
                                            "The condition, or quality, of being mean (any of its definitions)"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d38fe5c9-0784-40d8-a2b3-739c0ee7c6e6",
                                                "sense_id": "3f14b494-17a9-3162-a44d-cff056411adf",
                                                "text": "This figure is of a later date, by the meanness of the workmanship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19733eb7-c502-3a0a-898b-f8853ca8cad7",
                                        "entry_id": "1e3dc032-1779-33ef-b54e-2836e0faae4f",
                                        "glosses": [
                                            "A mean act."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebbcd0a9-bf80-41f2-b9f2-5402df66b755",
                                                "sense_id": "19733eb7-c502-3a0a-898b-f8853ca8cad7",
                                                "text": "There are enough meannesses in everyone — ourselves included — to make for us a contemptible world, if we select the meannesses and let our minds dwell upon them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
