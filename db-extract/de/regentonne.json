                            {
                                "example_id": "0c68f064-8504-4d13-a1f7-176f2d52c44c",
                                "sense_id": "2da63708-6194-3f5f-9fb2-ce6d4211dd7f",
                                "text": "Die Regentonne sammelt das Wasser, das ich zum Gießen der Blumen benötige."
                            },
                            {
                                "example_id": "c53ad833-1ea6-4a49-8714-851403e7162d",
                                "sense_id": "2da63708-6194-3f5f-9fb2-ce6d4211dd7f",
                                "text": "„Wie klein er aussah, wenn er die Gießkanne in die Regentonne tauchte.“"
                            }
                        ],
