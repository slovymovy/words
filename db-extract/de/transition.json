                        "glosses": [
                            "Übergang von einer Ebene auf eine andere oder von einem Zustand in einen anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e66ee55-04ad-4a41-8394-8f29e5d99687",
                                "sense_id": "0304fcbc-e4ff-323f-8861-a6ade1daadad",
                                "text": "Spanien und Portugal haben die Transition zu einem demokratischen System erfolgreich absolviert."
                            },
                            {
                                "example_id": "74680e5d-f3fa-4f36-9226-b91a20185367",
                                "sense_id": "0304fcbc-e4ff-323f-8861-a6ade1daadad",
                                "text": "Transition wird in vielen Wissenschaften als Terminus mit jeweils spezifischen Bedeutungen verwendet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2d2b6633-625f-354b-a5c0-890664be260b",
                        "entry_id": "d7d4aca3-851c-3f4a-8ca8-358be817bd3c",
                        "glosses": [
                            "ein Sprung in Nullzeit über große Entfernungen, Übergang in den höherdimensionalen Raum und wieder zurück"
                        ],
                        "tags": [
                            "Science-Fiction-Literatur (Perry Rhodan",
                            "Ren Dhark)"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "49534291-e266-3c17-9fb3-a2b41337f169",
                        "entry_id": "d7d4aca3-851c-3f4a-8ca8-358be817bd3c",
                        "glosses": [
                            "Prozess des Wechselns der Geschlechtsrolle transidenter Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa7892e2-08ae-480f-b3f4-dda41ed86467",
                                "sense_id": "49534291-e266-3c17-9fb3-a2b41337f169",
                                "text": "„Aber das ist doch etwas ganz anderes als der Prozess des Übergangs oder der Transition, für den der Terminus ‚transsexuell‘ erfunden wurde.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
