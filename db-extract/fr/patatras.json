                                    {
                                        "sense_id": "e11200c6-3196-34c7-8f33-2eb933a2b8a4",
                                        "entry_id": "fd9cba6d-1a10-3390-a63f-c2e56b76cf09",
                                        "glosses": [
                                            "A sound of someone or something falling and landing heavily."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38347974-67ea-413a-8963-fcc7dca5899e",
                                                "sense_id": "e11200c6-3196-34c7-8f33-2eb933a2b8a4",
                                                "text": "If my life were a Saturday-morning cartoon, you would have heard a loud kerplunk as my stomach dropped. My poor starving stomach. It was under such stress already, and now this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81ab951c-2cae-3f7e-b301-66d65fb3cdcb",
                                        "entry_id": "fd9cba6d-1a10-3390-a63f-c2e56b76cf09",
                                        "glosses": [
                                            "A disappointment which comes as a surprise."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "kerplunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ac17a29-d2e0-3af3-a902-a977ce1f9ae5",
                                        "entry_id": "cc53b303-8bef-3fb2-80c7-2e55b1681e03",
                                        "glosses": [
                                            "Used to indicate a thudding sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40070a94-e304-4181-b704-a0c92facc94c",
                                                "sense_id": "7ac17a29-d2e0-3af3-a902-a977ce1f9ae5",
                                                "text": "We flipped to see who'd go first and I won, which meant Claudia had to dial. I called the number out loud for her, and inside me my heart was suddenly going \"kerplunk, kerplunk, kerplunk,\" heavy as an elephant's feet."
                                            }
                                        ]
                                    }
                                ]
