                    {
                        "sense_id": "d477762f-db32-3d68-a943-4fad99415daa",
                        "entry_id": "5d8f3816-592e-39ac-adb8-e6dcc3454dcb",
                        "glosses": [
                            "Schmuckgegenstand in Form eines Ostereis"
