                        "entry_id": "38ac1b6f-d2ef-31e2-9638-b0553c6de9e7",
                        "glosses": [
                            "man die in het huwelijk treedt, het is de mannelijke vorm van bruid en dat is opmerkelijk want er zijn veel meer vrouwelijke vormen van mannelijke woorden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d7cd96b-4db4-46a9-b9a8-758f7ce1e958",
                                "sense_id": "9fb530e5-2893-335d-8f8c-78e1165faa3b",
                                "text": "De traditie wil dat bruidegom en gasten de bruidsjurk pas op het allerlaatste moment zien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4671062a-2156-4845-ae09-4e7c4eb234b2",
                        "source_entry_id": "38ac1b6f-d2ef-31e2-9638-b0553c6de9e7",
                        "source_sense_id": "9fb530e5-2893-335d-8f8c-78e1165faa3b",
