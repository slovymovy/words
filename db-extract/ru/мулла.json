                                "target_senses": [
                                    {
                                        "sense_id": "f2267fb6-dde4-3800-ad6c-24bf4b7b2c70",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "An honorific title for a scholar of theology and sharia law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8a843e-2e76-4d19-bccd-cb595d46936c",
                                                "sense_id": "f2267fb6-dde4-3800-ad6c-24bf4b7b2c70",
                                                "text": "Leading Republicans do not sympathize with the mullahs, do not repeat their talking points, and do not seek to appease them when they make outrageous claims about other countries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc774c8-755d-3e39-96cd-5e7957279eae",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "An honorific title for a mosque leader."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e692f7f2-1b63-31df-8d12-c7f9534e50b8",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "A scholar and teacher of theology and sharia law, and an issuer of fatwas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88aec18-e5a2-43c3-945a-240f053db479",
                                                "sense_id": "e692f7f2-1b63-31df-8d12-c7f9534e50b8",
                                                "text": "In the first week of March 2018, the Shia mullah issues a fatwa prohibiting vengeance killing and requiring reconciliation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "629ac748-3655-352e-a37a-191b094489e3",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "A conservative Muslim leader or cleric, especially one who is hostile against other religions."
                                        ],
                                        "tags": [
                                            "India",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1750a548-64e7-3ae5-bad1-f34e714ea902",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "A Muslim."
                                        ],
                                        "tags": [
                                            "India",
                                            "broadly",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a328a4f-89c7-3f13-a11c-48d467d73913",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "A low-level cleric who specializes in telling stories of Ashura, rather than teaching or issuing fatwas."
                                        ],
