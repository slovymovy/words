                        "cross_references": [
                            {
                                "target_word": "octane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91662bbe-acec-305d-a69d-ce7c0a4fea94",
                                        "entry_id": "a7cb810d-690e-32fb-a72d-d92f36b8a8ff",
                                        "glosses": [
                                            "Hydrocarbure saturé de la famille des paraffines, aux nombreux isomères. Sa formule chimique est C₈H₁₈."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbd383e1-f29e-4289-a204-b651718f161e",
                                                "sense_id": "91662bbe-acec-305d-a69d-ce7c0a4fea94",
                                                "text": "Indice d’octane : Indication du pouvoir antidétonant d’un carburant, mesuré par comparaison avec un mélange de l’iso-octane 2,2,4-triméthylpentane et de n-heptane. Un indice d’octane de 87 signifie que l’essence a le même pouvoir antidétonant qu’un mélange de 87% d’octane et de 13% d’heptane (par volume)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "octane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a39c0297-971d-367a-bade-caae9463d734",
                                        "entry_id": "4b3260b6-1a1b-3b1f-bf9a-98e89e412a9e",
                                        "glosses": [
                                            "Féminin singulier de octan."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3658f478-0c63-40bb-b57f-a119e2e5d6fb",
                                                "sense_id": "a39c0297-971d-367a-bade-caae9463d734",
                                                "text": "J'ai bien réellement observé une fièvre octane qui revenait tous les vendredis, vers le soir, et que je guéris bientôt en donnant, à la suite d'un vomitif, l'esprit de sel ammoniac."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
