                {
                    "sense_id": "9e8fbb61-9615-3270-ae33-81f54a0ead89",
                    "sense_definition": "A blank metal block used to fill short lines of type in traditional printing; a clipping of <w>quadrat</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "printing",
                    "name_type": "no",
