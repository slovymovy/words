                        "entry_id": "3e520605-6907-3d54-9dcc-1eda8aa4d70e",
                        "glosses": [
                            "Light emitted from stars other than the Sun."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9e46a05e-c9a4-4152-b2d4-561413a1dca0",
                                "sense_id": "62023419-b17a-313c-9351-66ee92bacb4d",
                                "text": "Nor walk by moon, / Or glittering starlight, without thee is sweet."
                            },
                            {
                                "example_id": "7c60a0ff-cbc5-429c-91ff-bfb8ac64416e",
                                "sense_id": "62023419-b17a-313c-9351-66ee92bacb4d",
                                "text": "Bright starlight enabled us to see much of the country."
                            }
                        ]
                    }
                ],
