                ],
                "senses": [
                    {
                        "sense_id": "3a576321-f7d5-321c-9790-8f7d8e13967d",
                        "entry_id": "d95d9b77-0611-33b6-a619-ef4144ba8ba1",
                        "glosses": [
                            "Eigenschaft, auf vielfältige Weise genutzt oder gedeutet werden zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98b54f75-3154-43f2-bdd6-800fae6b7ea1",
                                "sense_id": "3a576321-f7d5-321c-9790-8f7d8e13967d",
                                "text": "„Die Auswahl der Inhalte sollte demnach durch Exemplarität und Polyvalenz geleitet werden.“"
                            },
                            {
                                "example_id": "8955065e-7a27-438e-80c0-ebdf10ade4eb",
                                "sense_id": "3a576321-f7d5-321c-9790-8f7d8e13967d",
                                "text": "„Eine zweite Besonderheit bei literarischen Texten im Vergleich zu nichtliterarischen Texten ist eine (genuine) potentielle Bedeutungsvielfalt, die auch als Polyvalenz bezeichnet wird […].“"
                            },
                            {
                                "example_id": "3dfb0029-cb64-45df-9e62-fc626c584271",
                                "sense_id": "3a576321-f7d5-321c-9790-8f7d8e13967d",
                                "text": "„Sie tilgen darüber hinaus häufig auch die Polyvalenz und Multiperspektivität der Ursprungstexte und nehmen diesen durch eine teilweise ins Ironische abgleitende Darstellungsweise ihre literarische Wirkung.“"
                            },
                            {
                                "example_id": "cf7b01f2-a045-4392-96f0-037a9e2c0c96",
                                "sense_id": "3a576321-f7d5-321c-9790-8f7d8e13967d",
                                "text": "„Die Forderung einer im modernen Sinne möglichst hohen Polyvalenz ist daher bei der Auswahl und Vermittlung mittelalterlicher Texte nicht sinnvoll.“"
                            },
                            {
                                "example_id": "1e7a6186-8f14-4cb3-b48a-360c2cc199e4",
                                "sense_id": "3a576321-f7d5-321c-9790-8f7d8e13967d",
                                "text": "„Literarische Texte können entsprechend der Polyvalenz-Konvention von Lesenden ganz unterschiedlich interpretiert werden […].“"
                            },
                            {
                                "example_id": "54c4cdcf-5e6e-414e-bbf0-464a4b6d7cf7",
                                "sense_id": "3a576321-f7d5-321c-9790-8f7d8e13967d",
                                "text": "„Polyvalenz des technischen Objekts ist nämlich im Gegensatz zu der kultureller Gegenstände manifest begrenzt.“"
                            },
                            {
                                "example_id": "8e4ec2f7-6537-4e0b-a178-2f5776c4369d",
                                "sense_id": "3a576321-f7d5-321c-9790-8f7d8e13967d",
                                "text": "„Diese Polyvalenz des Zeichens und die Komplexität der Szene als Ganzes lassen sich aus der Farbenperspektive heraus besonders deutlich zeigen.“"
                            },
                            {
                                "example_id": "fd54b332-91ff-412d-b7b8-2d552ce54d19",
                                "sense_id": "3a576321-f7d5-321c-9790-8f7d8e13967d",
                                "text": "„In der Konsequenz geht auch das Modell der Polyvalenzen von einer Vergrößerung des Personenkreises möglicher Träger der Volksaufklärung aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
