{
    "word_family": [
        "incrimination",
        "incriminatory",
        "incriminating"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22beefab-41f3-3c6f-86fc-f952f08fbbe9",
                    "sense_definition": "To make someone appear guilty of a crime or wrongdoing, or provide evidence against them.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "indicate_guilt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective found a bloody glove that seemed to directly <w>incriminate</w> the suspect.",
                            "target_lang_translations": {
                                "nl": "De rechercheur vond een bebloede handschoen die de verdachte rechtstreeks leek te <w>belasten</w>."
                            }
                        },
                        {
                            "text": "He refused to answer any questions that might <w>incriminate</w> himself in court.",
                            "target_lang_translations": {
                                "nl": "Hij weigerde vragen te beantwoorden die hemzelf in de rechtbank zouden kunnen <w>incrimineren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "implicate"
                    ],
                    "antonyms": [
                        "exonerate",
                        "absolve"
                    ],
                    "common_phrases": [
                        "incriminate oneself",
                        "evidence to incriminate"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand schuldig doen lijken aan een misdrijf of overtreding, of bewijsmateriaal tegen iemand leveren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "incrimineren",
                                "target_lang_sense_clarification": "formeel of juridisch belasten"
                            },
                            {
                                "target_lang_word": "belasten",
                                "target_lang_sense_clarification": "schuldig doen lijken door bewijsmateriaal of verklaringen"
                            },
                            {
                                "target_lang_word": "in opspraak brengen",
                                "target_lang_sense_clarification": "betrekken bij een misdrijf of schandaal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb146705-b1b4-3bf5-bb9b-a9b2ef4724d5",
                    "sense_definition": "To formally accuse or charge someone with a crime.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "indicate_guilt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prosecutor sought to <w>incriminate</w> the former mayor after discovering new financial records.",
                            "target_lang_translations": {
                                "nl": "De officier van justitie probeerde de voormalige burgemeester <w>aan te klagen</w> na het ontdekken van nieuwe financiële gegevens."
                            }
                        },
                        {
                            "text": "Several local newspapers chose to <w>incriminate</w> the innocent man before the trial even began.",
                            "target_lang_translations": {
                                "nl": "Verschillende lokale kranten kozen ervoor om de onschuldige man te <w>beschuldigen</w> nog voordat het proces überhaupt was begonnen."
                            }
                        }
                    ],
                    "synonyms": [
                        "accuse",
                        "charge"
                    ],
                    "antonyms": [
                        "clear",
                        "acquit"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand formeel beschuldigen of aanklagen wegens een misdrijf."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "aanklagen",
                                "target_lang_sense_clarification": "formeel beschuldigen voor de rechtbank"
                            },
                            {
                                "target_lang_word": "beschuldigen",
                                "target_lang_sense_clarification": "iemand de schuld geven van een misdrijf"
                            },
                            {
                                "target_lang_word": "in staat van beschuldiging stellen",
                                "target_lang_sense_clarification": "formeel procesrechtelijk beschuldigen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}