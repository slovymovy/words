                                "target_senses": [
                                    {
                                        "sense_id": "9c2dc758-4e37-3198-8093-26853f9cba05",
                                        "entry_id": "a6a003ae-8e11-3166-9069-a59efa6c5d52",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59950922-8818-4459-bae9-c8fbc6f54f50",
                                                "sense_id": "9c2dc758-4e37-3198-8093-26853f9cba05",
                                                "text": "Cette fois, elle n’a eu besoin que d’une heure et trois minutes de jeu pour s’adjuger cette demi-finale et rejoindre la Roumaine Ana Bogdan sur la dernière marche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bogdan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba34afed-cbfe-3430-892e-95ec967ede28",
                                        "entry_id": "7a8c6b33-bf3f-31df-90de-51e2efb2a96f",
                                        "glosses": [
                                            "Prénom masculin d’Europe de l’Est, équivalent de Dieudonné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a23e6758-bfb2-427b-afa1-93c2d6544e92",
                                                "sense_id": "ba34afed-cbfe-3430-892e-95ec967ede28",
                                                "text": "L’adjudant Bogdan Malek, chef des six miliciens composant la garnison de Zakopane, un célibataire de nature morose, regrettait le vieux temps."
                                            },
                                            {
                                                "example_id": "5f65f0f6-2be6-4575-818a-101cc17a258a",
                                                "sense_id": "ba34afed-cbfe-3430-892e-95ec967ede28",
                                                "text": "« Je suis prêt à rester autant que nécessaire », assure de son côté le lieutenant-colonel Burdulea Bogdan qui réalise sa première mission en dehors de son pays."
                                            }
                                        ]
                                    }
                                ]
