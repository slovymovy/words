                                "example_id": "b3403c28-b7c9-48ee-af76-e08e92c0fd6d",
                                "sense_id": "e63a77cd-5371-3d47-96d1-4eee1d8fa71c",
                                "text": "Prices seem to have stopped rising, having hit the psychological ceiling of just under 100 dollars."
                            }
                        ]
