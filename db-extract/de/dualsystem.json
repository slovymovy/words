                "senses": [
                    {
                        "sense_id": "d4eac2f0-edab-3689-9895-1e52210f5e5e",
                        "entry_id": "bc236365-0ff0-3c27-b857-267d434fa79a",
                        "glosses": [
                            "Stellenwertsystem zur Basis zwei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e580f9-ca87-4560-9f54-254cfbb05018",
                                "sense_id": "d4eac2f0-edab-3689-9895-1e52210f5e5e",
                                "text": "Maschinen rechnen üblicherweise im Dualsystem, um es leichter lesen zu können, wird oft das Hexadezimalsystem als Lesehilfe genutzt."
                            },
                            {
                                "example_id": "5befd934-1416-48f5-b24e-2a0f2f42bbe9",
                                "sense_id": "d4eac2f0-edab-3689-9895-1e52210f5e5e",
                                "text": "„Soll eine Zahl im Dualsystem dargestellt werden, so wird sie in eine Summe von Zweierpotenzen zerlegt, wobei die Charaktere jeweils angeben, ob eine Stelle besetzt (1) oder nicht besetzt (0) ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
