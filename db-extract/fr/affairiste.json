                "senses": [
                    {
                        "sense_id": "d07e199a-c0a1-3c4b-8ab9-7f8016f40f2e",
                        "entry_id": "e898f21b-c151-39b8-9361-98103aea097b",
                        "glosses": [
                            "Personne qui cherche à faire des affaires sans beaucoup de scrupule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7392728-4d87-4fc9-a0c9-738c021b8de2",
                                "sense_id": "d07e199a-c0a1-3c4b-8ab9-7f8016f40f2e",
                                "text": "XYZ : portrait controversé d’un affairiste mégalomane."
                            },
                            {
                                "example_id": "ad314202-c0c8-45f1-9d2e-c41647025f85",
                                "sense_id": "d07e199a-c0a1-3c4b-8ab9-7f8016f40f2e",
                                "text": "Cet avenir se préparait, se construisait tous les jours. J’ai vu au contraire, au fil des années, mes associés se joindre à la longue cohorte des affairistes pour qui seul le court terme était important."
                            },
                            {
                                "example_id": "ae6ab2e1-fbf0-428b-ba2e-123242e6f328",
                                "sense_id": "d07e199a-c0a1-3c4b-8ab9-7f8016f40f2e",
                                "text": "En 2004, deux affairistes américains rachètent pour 1 euro symbolique les ateliers Thomé-Génot, une usine métallurgique située à Nouzonville, dans les Ardennes."
                            },
                            {
                                "example_id": "989085ef-bd0c-4ae4-a705-4bde0f7bfdc0",
                                "sense_id": "d07e199a-c0a1-3c4b-8ab9-7f8016f40f2e",
                                "text": "La couche supérieur était formée d’affairistes de haut vol, généralement sino-coréens, les seuls à avoir suffisamment de réserves en devises et des connexions des deux côtés de la frontière."
                            }
                        ]
                    }
