        "fr-extract.jsonl": [
            {
                "entry_id": "9a84b365-dc57-3305-86eb-54e7a9f8b6ad",
                "word": "phytotoxicité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4cdfce32-4e4e-4108-93a9-6ea36e29f2f3",
                        "entry_id": "9a84b365-dc57-3305-86eb-54e7a9f8b6ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "phytotoxicités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c662a869-95fe-3237-b091-df9a211d2d02",
                        "entry_id": "9a84b365-dc57-3305-86eb-54e7a9f8b6ad",
                        "glosses": [
                            "Dégât physiologique que provoque une substance phytosanitaire sur la plante cultivée qu’elle est censée protéger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d97778-e7dc-4136-8082-dabd25685fce",
                                "sense_id": "c662a869-95fe-3237-b091-df9a211d2d02",
                                "text": "L’action sélective des triazines herbicides pour la lutte contre les Phalaris dans le blé a été étudiée dans quatre essais au champ. Les Phalaris furent maîtrisée par des applications, en pré et post-levée, de méthoprotryne et de terbutryne. La phytotoxicité de la méthoprotryne pour le blé fut supérieure à celle de la terbutryne."
                            },
                            {
                                "example_id": "a1317650-af65-422d-9369-66659ac037a1",
                                "sense_id": "c662a869-95fe-3237-b091-df9a211d2d02",
                                "text": "La phytotoxicité du dichlobénil à l'égard des dicotylédones aussi bien que des monocotylédones a été reconnue en 1958."
                            },
                            {
                                "example_id": "207b7860-a8d1-4399-aa42-ee97aac33b7e",
                                "sense_id": "c662a869-95fe-3237-b091-df9a211d2d02",
                                "text": "Les hormones (2,4-D; 2,4-DB; 2,4-MCPA; 2,4-MCPB, fluroxypyr, piclorame…) peuvent provoquer des phytotoxicités importantes par leurs vapeurs ou les embruns de pulvérisation. Il est déconseillé de les utiliser par forte chaleur."
                            },
                            {
                                "example_id": "620f5197-1128-4c83-9624-a762f8e8471c",
                                "sense_id": "c662a869-95fe-3237-b091-df9a211d2d02",
                                "text": "Le diméthachlore s’est montré phytotoxique pour sa première année d’expérimentation. Dans la plupart des cas, les symptômes de phytotoxicité ont disparu au printemps."
                            }
                        ]
                    }
                ],
