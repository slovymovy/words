                    {
                        "sense_id": "9fc39ad4-99a5-34a9-b3ad-a4adcb3d531e",
                        "entry_id": "e67ef0d1-95c9-381b-aedc-017a5c6970a7",
                        "glosses": [
                            "deurmat waaraan mensen hun schoenen schoonvegen voor ze het huis ingaan"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0d374de8-96c2-334e-9ad6-fdb9573a2d92",
                        "entry_id": "e67ef0d1-95c9-381b-aedc-017a5c6970a7",
                        "glosses": [
                            "iemand die helemaal onderaan de maatschappelijke ladder staat en alles van iedereen moet verdragen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "95a1dcb7-8da3-43d8-9e48-8cfb1c916af4",
                                "sense_id": "0d374de8-96c2-334e-9ad6-fdb9573a2d92",
                                "text": "Het bastaardkind (Jacob Jutte) blijft bijna elke scène in beeld. Hij kijkt toe hoe zijn vader als voetveeg wordt behandeld en hoe zijn moeder door andere vrouwen wordt uitgesloten."
                            },
                            {
                                "example_id": "13bef97b-1082-4b84-bb10-e6ef2d043fe5",
                                "sense_id": "0d374de8-96c2-334e-9ad6-fdb9573a2d92",
                                "text": "De vrouw raakt geïntrigeerd door de zwijgzame indringer en reconstrueert zijn verhaal. Ook zij heeft het nodige te verduren gehad. Haar enige zoon is in de oorlog gestorven en haar man behandelt haar als voetveeg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a06455f-e89a-4ce5-b1b7-39e091e56746",
                        "source_entry_id": "e67ef0d1-95c9-381b-aedc-017a5c6970a7",
                        "source_sense_id": "9fc39ad4-99a5-34a9-b3ad-a4adcb3d531e",
                        "source_sense_description": "deurmat",
                        "target_lang_word": "doormat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doormat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77e710eb-b257-3302-8034-1026b852513a",
                                        "entry_id": "89f51d9a-5a58-39d6-b5f2-f4fb78f6c76c",
                                        "glosses": [
                                            "A coarse mat at the entrance to a house, upon which one wipes one's shoes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b30246c-3236-41ec-94e8-28c5802a77e8",
                                                "sense_id": "77e710eb-b257-3302-8034-1026b852513a",
                                                "text": "Wipe your shoes on the doormat before you start plodding around in the house."
                                            },
                                            {
                                                "example_id": "7b697b88-609a-4860-8240-e7f6f740d9b4",
                                                "sense_id": "77e710eb-b257-3302-8034-1026b852513a",
                                                "text": "Mr. Simpson adds that the station at Stanmore appears practically unchanged from the time of its opening, even to the L.N.W.R. rubber doormat, which \"shows no signs of wearing out.\""
                                            },
                                            {
                                                "example_id": "bb62fe51-48ee-4b6c-96b8-e04d526bf2b0",
                                                "sense_id": "77e710eb-b257-3302-8034-1026b852513a",
                                                "text": "Dimple glanced at an expensive-looking doormat with the words ‘LOSE THE SHOES’ woven into it and wondered why anyone would bother spending so much money on something people were going to wipe their feet on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "969088b4-688a-3701-a350-197c50b49c00",
                                        "entry_id": "89f51d9a-5a58-39d6-b5f2-f4fb78f6c76c",
                                        "glosses": [
                                            "Someone who is overly submissive to others' wishes."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16889007-cf40-452f-a162-cefd2232b0c5",
                                                "sense_id": "969088b4-688a-3701-a350-197c50b49c00",
                                                "text": "He's such a doormat, he lets everyone walk all over him."
                                            },
                                            {
                                                "example_id": "aa2834df-cc06-4629-a98c-58e817e45622",
                                                "sense_id": "969088b4-688a-3701-a350-197c50b49c00",
                                                "text": "If you flipped through certain magazines at this time you could be forgiven for thinking that there was no right way to be a woman, only wrong ones — bimbo or frump, slut or prude, shrew or doormat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6347fb12-e5e6-45bb-9408-382efbc5bb77",
                        "source_entry_id": "e67ef0d1-95c9-381b-aedc-017a5c6970a7",
                        "source_sense_id": "9fc39ad4-99a5-34a9-b3ad-a4adcb3d531e",
