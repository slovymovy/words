                "senses": [
                    {
                        "sense_id": "7d8d4208-2ce6-367e-b483-8e1c3f8ed056",
                        "entry_id": "4b38caca-6638-3893-bf9c-457d287dbdc4",
                        "glosses": [
                            "alle Symptome einer Krankheit, die den Krankheitsverlauf kennzeichnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d4d2ceb-cf7b-4302-a307-8f5879494bb3",
                                "sense_id": "7d8d4208-2ce6-367e-b483-8e1c3f8ed056",
                                "text": "Das Krankheitsbild entsprach dem einer Hirnblutung."
                            },
                            {
                                "example_id": "e37dcd15-35d3-42f5-9d61-2e01e3595cc2",
                                "sense_id": "7d8d4208-2ce6-367e-b483-8e1c3f8ed056",
                                "text": "„Richarz war anfangs entschlossen, Schumann durch sorgfältige wissenschaftliche Betrachtung des Krankheitsbildes wie auch durch eine milde Behandlung zu heilen.“"
                            },
                            {
                                "example_id": "d9b8c0ef-b39a-453e-b5e1-0bc36e66cbed",
                                "sense_id": "7d8d4208-2ce6-367e-b483-8e1c3f8ed056",
                                "text": "„Der Daueraufenthalt in einer Klinik jedenfalls wäre bei seinem Krankheitsbild heute nicht mehr üblich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
