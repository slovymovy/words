                            {
                                "example_id": "8c3516c6-e884-4113-bc2f-4b5fbd88f583",
                                "sense_id": "44387c7b-cb6a-3e8f-84f2-7178dea28fb0",
                                "text": "„Die Udayagiri- und Khandagiri-Höhlen bei Bhubaneswar im Bundesstaat Odisha gehören zu den ältesten Höhlenklöstern Indiens.“"
                            },
                            {
                                "example_id": "37e8055d-bd6f-483c-bbbe-ba1d614dae62",
                                "sense_id": "44387c7b-cb6a-3e8f-84f2-7178dea28fb0",
                                "text": "„Aus diesen Zeiten stammen auch die Höhlenklöster und Buddha-Statuen bei Bamyan, das an der Kreuzung zweier wichtiger Karawanenwege gelegen war.“"
                            }
                        ],
