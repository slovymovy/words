                    {
                        "sense_id": "326008a4-7f0d-3f6c-b7e1-3c6938b53be7",
                        "entry_id": "e3a4bd00-00c4-342b-b55f-428d97aedd28",
                        "glosses": [
                            "Femme qui a contracté une assurance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0392a9fc-423d-43c5-a6af-7ef71997a7e0",
                                "sense_id": "326008a4-7f0d-3f6c-b7e1-3c6938b53be7",
                                "text": "Dans une affaire soumise à la Cour, il résultait des pièces versées que, par lettre recommandée, la compagnie d'assurance avait rappelé à l’assurée que celle-ci n’avait pas réglé les primes d’assurances de sa voiture."
                            }
                        ]
                    }
                ],
