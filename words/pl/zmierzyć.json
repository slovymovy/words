{
    "word_family": [
        "miara",
        "miernik",
        "wymiar",
        "przymierze",
        "przymierzać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f04ed67-5430-3290-865a-e5fd344d6b2a",
                    "sense_definition": "określić wielkość, długość lub wagę czegoś za pomocą odpowiednich narzędzi",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pomiar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Krawiec musiał dokładnie <w>zmierzyć</w> obwód talii klienta przed szyciem garnituru.",
                            "target_lang_translations": {
                                "ru": "Портной должен был точно <w>измерить</w> обхват талии клиента перед пошивом костюма."
                            }
                        },
                        {
                            "text": "Musimy <w>zmierzyć</w> pokój, aby sprawdzić, czy zmieści się w nim nowa szafa.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>измерить</w> комнату, чтобы проверить, поместится ли в ней новый шкаф."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zmierzyć temperaturę",
                        "zmierzyć długość"
                    ],
                    "target_lang_definitions": {
                        "ru": "определить размер, длину или вес чего-либо с помощью инструментов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "измерить",
                                "target_lang_sense_clarification": "определить параметры чего-либо"
                            },
                            {
                                "target_lang_word": "замерить",
                                "target_lang_sense_clarification": "произвести замер, снять мерки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eafce7d4-8c90-36fa-abc1-377918c2f7d0",
                    "sense_definition": "założyć ubranie lub obuwie, aby sprawdzić, czy pasuje",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "przymierzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poszłam do sklepu, żeby <w>zmierzyć</w> tę niebieską sukienkę.",
                            "target_lang_translations": {
                                "ru": "Я пошла в магазин, чтобы <w>примерить</w> это синее платье."
                            }
                        },
                        {
                            "text": "Warto <w>zmierzyć</w> buty przed zakupem, bo rozmiarówka bywa różna.",
                            "target_lang_translations": {
                                "ru": "Стоит <w>примерить</w> обувь перед покупкой, потому что размерные сетки бывают разными."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zmierzyć ubranie"
                    ],
                    "target_lang_definitions": {
                        "ru": "надеть одежду или обувь, чтобы проверить, подходит ли она"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "примерить",
                                "target_lang_sense_clarification": "надеть для проверки размера или фасона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9fa0a95-676b-3adb-9289-c1b23bf81597",
                    "sense_definition": "sprawdzić własne wymiary ciała",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pomiar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed rozpoczęciem diety warto <w>zmierzyć</w> się w pasie.",
                            "target_lang_translations": {
                                "ru": "Перед началом диеты стоит <w>измериться</w> в талии."
                            }
                        },
                        {
                            "text": "Dziecko chciało <w>zmierzyć</w> się przy framudze drzwi, żeby sprawdzić, ile urosło.",
                            "target_lang_translations": {
                                "ru": "Ребенок хотел <w>измерить</w> свой рост у дверного косяка, чтобы проверить, насколько он вырос."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "проверить собственные размеры тела"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "измериться",
                                "target_lang_sense_clarification": "снять с себя мерки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfcf1d78-9c37-37a4-a2d5-073e7a1543e2",
                    "sense_definition": "podjąć rywalizację z kimś w jakiejś dziedzinie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rywalizacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasz zespół chce <w>zmierzyć</w> się z mistrzami kraju w najbliższym meczu.",
                            "target_lang_translations": {
                                "ru": "Наша команда хочет <w>сразиться</w> с чемпионами страны в ближайшем матче."
                            }
                        },
                        {
                            "text": "Sportowcy będą <w>zmierzyć</w> się o złoty medal na olimpiadzie.",
                            "target_lang_translations": {
                                "ru": "Спортсмены будут <w>бороться</w> за золотую медаль на Олимпиаде."
                            }
                        }
                    ],
                    "synonyms": [
                        "popróbować się"
                    ],
                    "common_phrases": [
                        "zmierzyć się z przeciwnikiem"
                    ],
                    "target_lang_definitions": {
                        "ru": "вступить в соревнование с кем-либо в какой-то области"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сразиться",
                                "target_lang_sense_clarification": "вступить в борьбу или состязание"
                            },
                            {
                                "target_lang_word": "помериться силами",
                                "target_lang_sense_clarification": "соревноваться в мастерстве или силе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0febfcc-43f1-32f6-9c58-a219af47f158",
                    "sense_definition": "stanąć przed trudnym wyzwaniem lub problemem",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rywalizacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy <w>zmierzyć</w> się z konsekwencjami naszych błędnych decyzji.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>столкнуться</w> с последствиями наших ошибочных решений."
                            }
                        },
                        {
                            "text": "Każdy człowiek musi kiedyś <w>zmierzyć</w> się z własnymi lękami.",
                            "target_lang_translations": {
                                "ru": "Каждый человек должен когда-нибудь <w>столкнуться</w> со своими страхами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zmierzyć się z problemem"
                    ],
                    "target_lang_definitions": {
                        "ru": "столкнуться с трудным вызовом или проблемой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столкнуться",
                                "target_lang_sense_clarification": "встретиться с трудной ситуацией"
                            },
                            {
                                "target_lang_word": "справиться",
                                "target_lang_sense_clarification": "преодолеть трудность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c1cf424-bb6f-395f-943a-9c21b9ad4add",
                    "sense_definition": "dokonana forma czasownika <w>mierzyć</w> w znaczeniu patrzenia na kogoś badawczo lub oceniająco",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pomiar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ona <w>zmierzyła</w> go surowym wzrokiem, gdy tylko wszedł do pokoju.",
                            "target_lang_translations": {
                                "ru": "Она <w>омерила</w> его суровым взглядом, как только он вошел в комнату."
                            }
                        },
                        {
                            "text": "Po wejściu do sali <w>zmierzyła</w> wszystkich obecnych krytycznym spojrzeniem.",
                            "target_lang_translations": {
                                "ru": "Войдя в зал, она <w>омерила</w> всех присутствующих критическим взглядом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zmierzyć wzrokiem"
                    ],
                    "target_lang_definitions": {
                        "ru": "смотреть на кого-то пристально, оценивающе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "омерить взглядом",
                                "target_lang_sense_clarification": "посмотреть оценивающе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c01976ac-33e4-3d6d-8d98-e8942a048608",
                    "sense_definition": "dokonana forma czasownika <w>mierzyć</w> się w znaczeniu konfrontacji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rywalizacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W finale turnieju <w>zmierzy</w> się dwóch najlepszych szachistów.",
                            "target_lang_translations": {
                                "ru": "В финале турнира <w>сойдутся</w> два лучших шахматиста."
                            }
                        },
                        {
                            "text": "Drużyna <w>zmierzy</w> się z trudnym wyzwaniem w nadchodzącym sezonie.",
                            "target_lang_translations": {
                                "ru": "Команда <w>столкнется</w> с трудным испытанием в предстоящем сезоне."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенная форма глагола для обозначения конфронтации"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сойтись",
                                "target_lang_sense_clarification": "вступить в противоборство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}