                    {
                        "translation_id": "71e601d0-4228-4a70-be7e-9a62a1af49cc",
                        "source_entry_id": "218f55ff-b2da-37c2-a5cf-5a6efeb570f7",
                        "source_sense_id": "cfeb1db9-271e-3a45-b310-25f703c32dd1",
                        "target_lang_word": "Erdferkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdferkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9362422-5388-3875-94ad-401c0d39f8fd",
                                        "entry_id": "c789e703-3df1-34f5-a67c-52fe5d92c162",
                                        "glosses": [
                                            "nachtaktives Säugetier mit länglicher Schnauze, langer Zunge und hufartigen Krallen, das im südlichen Afrika lebt und sich von Insekten ernährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6da22a8c-e38c-43a8-a098-e755f644ecaf",
                                                "sense_id": "c9362422-5388-3875-94ad-401c0d39f8fd",
                                                "text": "„Des Nachts verbergen sie sich in Felslöchern, alten Termitenbauten und mit Vorliebe in den Höhlen der Erdferkel, die nachts auf Nahrungssuche gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d06310b5-6ea9-446d-8322-f214682059ef",
                        "source_entry_id": "218f55ff-b2da-37c2-a5cf-5a6efeb570f7",
