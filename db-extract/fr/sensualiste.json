                        "glosses": [
                            "Qui appartient au sensualisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5241fcde-ee57-417a-af7a-edbb8cdc2318",
                                "sense_id": "a5e2a40a-1548-3306-aac8-d3de3ca37269",
                                "text": "Il lui fit passer un après-midi entier dans les branches d’un marronnier du jardin des Rivalonde, à contempler les arbres rares et le reflet du couchant dans le bassin aux nénuphars ; lui, cependant, discourait sur les régimes monarchique et républicain, sur les variations du juste et du vrai dans les différentes religions, sur les rites chinois, le tremblement de terre de Lisbonne, la bouteille de Leyde et la doctrine sensualiste."
                            },
                            {
                                "example_id": "4b2dfb57-e09e-4211-9ee3-2b56a392d4dc",
                                "sense_id": "a5e2a40a-1548-3306-aac8-d3de3ca37269",
                                "text": "Doctrines sensualistes. — Philosophie sensualiste."
                            }
                        ]
                    }
