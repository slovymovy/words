                    {
                        "sense_id": "51d5ef56-1db4-348e-b044-8c9d698e80ae",
                        "entry_id": "7a99cbc0-3d23-3b8a-aa6b-2faeb8b44964",
                        "glosses": [
                            "A Welshman or person of Welsh descent."
                        ],
                        "tags": [
                            "British",
