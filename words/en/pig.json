                            "trait_type": "regional",
                            "comment": "agricultural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рожать поросят (о свиноматке).",
                        "zh": "生小猪（指母猪）。"
                    },
                    "translations": {
                        "ru": [
