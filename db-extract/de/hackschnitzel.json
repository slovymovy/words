                        "form": "das Hackschnitzel"
                    },
                    {
                        "form_id": "dc9f6de0-104f-4025-a5bb-eb3d9f9b1378",
                        "entry_id": "23bc7cdb-763b-3b55-b703-ef9b02c81367",
                        "tags": [
                            "accusative",
