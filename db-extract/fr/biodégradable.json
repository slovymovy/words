                    {
                        "sense_id": "d1a1cdca-5341-3128-9405-336c8c6432fc",
                        "entry_id": "4759ccf4-bdf0-3974-80b6-7f314e23aeb5",
                        "glosses": [
                            "Qualifie une substance pouvant être dégradée par des organismes vivants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b4cb5fb-2efe-4df6-80d1-7cd4d9b81202",
                                "sense_id": "d1a1cdca-5341-3128-9405-336c8c6432fc",
                                "text": "La bâche biodégradable, au contraire, se décompose dans le sol."
                            },
                            {
                                "example_id": "d40453e2-d5d6-4bd9-a608-eb8c12123267",
                                "sense_id": "d1a1cdca-5341-3128-9405-336c8c6432fc",
                                "text": "Jusqu’à cinquante ans, je me pensais inusable, inoxydable. Je ne suis que biodégradable."
                            },
                            {
                                "example_id": "ae33c0aa-3e94-4fb8-ae22-cb882c2730cd",
                                "sense_id": "d1a1cdca-5341-3128-9405-336c8c6432fc",
                                "text": "Devant l’ampleur de cette pollution, on a dû agir en favorisant la bioélimination des matériaux biodégradables, et le confinement des autres."
                            }
                        ]
                    },
                    {
                        "sense_id": "a46b463b-aa9c-3c39-b19d-6541bfe1e062",
                        "entry_id": "4759ccf4-bdf0-3974-80b6-7f314e23aeb5",
                        "glosses": [
                            "Qualifie une substance pouvant être dégradée en un temps court (par rapport à une vie humaine)."
