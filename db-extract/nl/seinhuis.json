                                    {
                                        "sense_id": "8db08613-3b7a-3d32-9e9f-85f0307c6583",
                                        "entry_id": "09090647-3a8a-35d6-96ca-b686e3d877b0",
                                        "glosses": [
                                            "A building, typically adjacent to or spanning a railway line, from where signals, points and (sometimes) level crossings are controlled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4018a70-26fb-4267-b6fb-5a513f82db4a",
                                                "sense_id": "8db08613-3b7a-3d32-9e9f-85f0307c6583",
                                                "text": "This includes plans to run earlier [Sunday] services on the Derby to Crewe and Skegness routes, which will require Network Rail to open signal boxes on these lines earlier than at present."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "978878a8-34b3-35a4-9485-f86909237eec",
                                        "entry_id": "09090647-3a8a-35d6-96ca-b686e3d877b0",
                                        "glosses": [
                                            "The alarm-box of a police or fire alarm system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88ff0868-c31c-46e5-825c-b090c9a5664a",
                        "source_entry_id": "3e0067d9-e98c-33bb-a575-1690762705d0",
                        "source_sense_id": "2b65e852-40ba-34ec-8a03-338d1c9176d9",
                        "target_lang_word": "signal cabin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "signal cabin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "223be5e6-1063-3aa6-aa02-95c293503d0e",
                                        "entry_id": "53cd0a04-1064-3290-9cce-0ee2db012540",
                                        "glosses": [
                                            "Synonym of signal box."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd07bde2-86d4-40b1-bd1b-51984639c449",
                                                "sense_id": "223be5e6-1063-3aa6-aa02-95c293503d0e",
                                                "text": "Having completed their task, Fireman Page telephoned from a lineside box to the next signal cabin, briefly reported the incident and said that, as no high explosive had dropped and the track was safe, they proposed proceeding \"at caution\"."
                                            },
                                            {
                                                "example_id": "2a3075a2-4f27-4427-9ef9-bdd14f80c5bb",
                                                "sense_id": "223be5e6-1063-3aa6-aa02-95c293503d0e",
                                                "text": "At Putney Bridge the train description transmissions for eastbound trains must be originated as there is no manned signal cabin on the London Transport system beyond this point; [...]."
                                            },
                                            {
                                                "example_id": "817ff745-798e-4743-a300-6fc086445884",
                                                "sense_id": "223be5e6-1063-3aa6-aa02-95c293503d0e",
                                                "text": "The latest 'go live' introduced the new signalling across the complex junction at Baker Street and saw the decommissioning of the signal cabin at Edgware Road, which opened in 1926."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
