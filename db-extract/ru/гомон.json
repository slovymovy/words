                ],
                "senses": [
                    {
                        "sense_id": "891b4486-7dd2-3d1a-9932-e330083ce3c8",
                        "entry_id": "729d6d41-edf0-3599-aed4-6da01b88ecc3",
                        "glosses": [
                            "нестройный шум множества голосов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dadcf55-a771-440d-b320-e1772ec801f1",
                                "sense_id": "891b4486-7dd2-3d1a-9932-e330083ce3c8",
                                "text": "В это же время в передней послышался топот и гомон."
                            },
                            {
                                "example_id": "d027093a-ab4e-482a-897c-0b5cf119bfe3",
                                "sense_id": "891b4486-7dd2-3d1a-9932-e330083ce3c8",
                                "text": "Рабочие и представители общественных организаций с гомоном стали рассаживаться по вагонам."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19ad8b97-ac2d-489f-8f91-78be863de46b",
                        "source_entry_id": "729d6d41-edf0-3599-aed4-6da01b88ecc3",
                        "source_sense_id": "891b4486-7dd2-3d1a-9932-e330083ce3c8",
                        "target_lang_word": "brouhaha",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brouhaha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f5c16d6-724a-3893-9a48-b35131be3d2a",
                                        "entry_id": "3be3004c-2f8c-3ec1-b3b7-63d37ef7be14",
                                        "glosses": [
                                            "A stir; a fuss or uproar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f2d346d-dd6d-4ae7-a86c-1679364b0455",
                                                "sense_id": "0f5c16d6-724a-3893-9a48-b35131be3d2a",
                                                "text": "It caused quite a brouhaha when the school suspended one of its top students for refusing to adhere to the dress code."
                                            },
                                            {
                                                "example_id": "c239f680-752e-4b43-b361-633e61d9967c",
                                                "sense_id": "0f5c16d6-724a-3893-9a48-b35131be3d2a",
                                                "text": "For as they were maneuvering the cylinder onto a dolly, it split and dumped one ton of chlorine trifluoride onto the floor. It chewed its way through twelve inches of concrete and dug a three-foot hole in the gravel underneath, filled the place with fumes which corroded everything in sight, and, in general, made one hell of a mess. Civil Defense turned out, and started to evacuate the neighborhood, and to put it mildly, there was quite a brouhaha before things quieted down. Miraculously, nobody was killed, but there was one casualty — the man who had been steadying the cylinder when it split. He was found some five hundred feet away, where he had reached Mach 2 and was still picking up speed when he was stopped by a heart attack."
                                            },
                                            {
                                                "example_id": "b41992e5-db45-47e0-8efc-7eb862ddbe41",
                                                "sense_id": "0f5c16d6-724a-3893-9a48-b35131be3d2a",
                                                "text": "Talk, it's only talk / Babble, burble, banter / Bicker, bicker, bicker / Brouhaha, balderdash, ballyhoo / It's only talk / Back talk"
                                            },
                                            {
                                                "example_id": "26ab57f1-ae69-4775-9f7e-9212844ebb90",
                                                "sense_id": "0f5c16d6-724a-3893-9a48-b35131be3d2a",
                                                "text": "In the brouhaha over the reappointment of Superior Court Judge Sylvia Pressler, we organized massive support - telegramming, telephoning and writing to encourage the State Senate to exercise its advise and consent function responsibly."
                                            },
                                            {
                                                "example_id": "42d1336f-2147-46de-bd97-364be5f3524d",
                                                "sense_id": "0f5c16d6-724a-3893-9a48-b35131be3d2a",
                                                "text": "What's all the fanfare, what's the to do / We're known to bring the hullabaloo / On stage or at the spa / Guaranteed we bring the brouhaha / ‘Cause it's a brouhaha"
                                            },
                                            {
                                                "example_id": "115d2e00-7029-4211-a15a-16314982da8f",
                                                "sense_id": "0f5c16d6-724a-3893-9a48-b35131be3d2a",
                                                "text": "Ms. Rousseau, a senior member of the Europe Écologie-Les Verts party, said in an interview that she was surprised by the sizzling brouhaha."
                                            },
                                            {
                                                "example_id": "9664e101-612f-4498-b918-a6b987f697f3",
                                                "sense_id": "0f5c16d6-724a-3893-9a48-b35131be3d2a",
                                                "text": "El Salvador, caught in legal brouhaha over the case of erroneously deported Kilmar Ábrego García, has received a reported $6 million from the U.S. to imprison deportees."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "728185d6-b254-44c8-9df6-2e1c51acff85",
                        "source_entry_id": "729d6d41-edf0-3599-aed4-6da01b88ecc3",
                        "source_sense_id": "891b4486-7dd2-3d1a-9932-e330083ce3c8",
                        "target_lang_word": "Gemurmel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemurmel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fefe4991-3cba-358f-b4b1-734c8b53570a",
                                        "entry_id": "4f672be2-9592-337c-ae80-0e1f32830618",
                                        "glosses": [
                                            "leises, unverständliches Sprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "332be346-ebf9-410c-be1a-b7414b16e3f8",
                                                "sense_id": "fefe4991-3cba-358f-b4b1-734c8b53570a",
                                                "text": "„Doch der Alte stellte sich ihm in den Weg und ließ ein wildes Gemurmel hören.“"
                                            },
                                            {
                                                "example_id": "fc45db79-692f-4a16-acd2-52ecc09f82fe",
                                                "sense_id": "fefe4991-3cba-358f-b4b1-734c8b53570a",
                                                "text": "„Das Gemurmel draußen verstummte augenblicklich.“"
                                            },
                                            {
                                                "example_id": "093c3584-277b-4040-ab4c-96247f1f693f",
                                                "sense_id": "fefe4991-3cba-358f-b4b1-734c8b53570a",
                                                "text": "„Durch das Fenster, vor das ein Moskitonetz gespannt war, hörte sie das Gemurmel von der nächtlichen Straße heraufdringen.“"
                                            },
                                            {
                                                "example_id": "1395d98c-df1b-484c-aa30-265df0204578",
                                                "sense_id": "fefe4991-3cba-358f-b4b1-734c8b53570a",
                                                "text": "„Es kam Frau Holle vor, als ob mit dem ersten Dämmerlicht ein Geflüster und Gemurmel durch das Ruinenviertel ging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
