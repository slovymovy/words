                        "glosses": [
                            "Fliquer en utilisant des moyens vidéo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d11eeebb-1490-4b81-962e-35359c8a69ab",
                                "sense_id": "494281de-a0f4-3aff-ad52-740f34781819",
                                "text": "Nous dénonçons souvent dans nos colonnes l'usage des caméras de vidéosurveillance financées par les Cannois pour les « vidéofliquer »."
                            },
                            {
                                "example_id": "f86313dd-001c-43a2-851b-ba1b06049667",
                                "sense_id": "494281de-a0f4-3aff-ad52-740f34781819",
                                "text": "Au lieu de vidéofliquer le consommateur, il serait peut-être de bon aloi que toutes ces grosses enseignes ETEIGNENT leurs vitrines la nuit."
                            },
                            {
                                "example_id": "fd0aaff4-7903-4c62-baec-93e90f6ea9c2",
                                "sense_id": "494281de-a0f4-3aff-ad52-740f34781819",
                                "text": "Au lieu de vidéofliquer encore et toujours plus, c'est pas mieux de remettre du personnel dans les gares et dans les trains ?"
                            }
                        ]
                    }
