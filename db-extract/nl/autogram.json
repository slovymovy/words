                                        "sense_id": "ee050c71-0dfa-35b6-b347-2db9e622ef09",
                                        "entry_id": "e8d7a1e5-57ea-3836-828b-dae7e7d6a90c",
                                        "glosses": [
                                            "selbstgefertigte Signatur eines Prominenten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36ecd2a2-311a-49f5-9ff9-bdb120bd5d63",
                                                "sense_id": "ee050c71-0dfa-35b6-b347-2db9e622ef09",
                                                "text": "Sie wollte unbedingt ein Autogramm von ihrem Star haben."
                                            },
                                            {
                                                "example_id": "03134dab-156d-4177-88fc-1d4381d5470e",
                                                "sense_id": "ee050c71-0dfa-35b6-b347-2db9e622ef09",
                                                "text": "„Autogramme sammeln wollte ich jetzt auch.“"
                                            },
                                            {
                                                "example_id": "cbde7c9f-e102-40e1-b56c-fca77a47efde",
                                                "sense_id": "ee050c71-0dfa-35b6-b347-2db9e622ef09",
                                                "text": "„Er hatte am Künstlerausgang gewartet, zusammen mit anderen, die von ihr ein Autogramm haben wollten.“"
                                            },
                                            {
                                                "example_id": "0e296389-26c2-4f2f-aa15-a953b628e047",
                                                "sense_id": "ee050c71-0dfa-35b6-b347-2db9e622ef09",
                                                "text": "„Miss Runcible und ihre Begleiter begaben sich zum Depot Nr. 13 und setzten sich dort, rauchend und Autogramme gebend, auf den Brettertisch.“"
                                            },
                                            {
                                                "example_id": "33a64d82-dfd0-4647-9139-6ba57a2f079a",
                                                "sense_id": "ee050c71-0dfa-35b6-b347-2db9e622ef09",
                                                "text": "„Als ich etwa 20 Jahre später in einer Buchhandlung in Los Angeles Autogramme gab, stellte sich auch Forry an — mit meiner Einsendung von damals in der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "942f5723-c908-3543-9bb1-b5c277669747",
                                        "entry_id": "e8d7a1e5-57ea-3836-828b-dae7e7d6a90c",
                                        "glosses": [
