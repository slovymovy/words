                        "glosses": [
                            "A handcrafted sailboat with a motor or lateen sails, resembling a dhow, that is used in the Maldives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d464f23f-6144-4c3e-8d12-1c97a4feb3c5",
                                "sense_id": "6d19842b-7379-3276-8b91-08780ee50a53",
                                "text": "The witchery of the dawn turned the grey river-reaches to purple, gold, and opal; and it was as though the lumbering dhoni crept across the splendors of a new heaven."
                            },
                            {
                                "example_id": "878ebb9f-3002-4bbf-8212-d6eacf81bb29",
                                "sense_id": "6d19842b-7379-3276-8b91-08780ee50a53",
                                "text": "Guests at the new Anantara Resort Maldives, opened in September on a five-acre island in the South Male Atoll, can shove off at sunset to fish from an indigenous dhoni sailboat, trailing local tackle — that is, a baited hook on a fishing line."
                            }
                        ]
