                "senses": [
                    {
                        "sense_id": "37ce56a5-f3f3-31a3-97ed-7be915174aa3",
                        "entry_id": "faad050c-6010-3cd2-81ef-33d38db2bf19",
                        "glosses": [
                            "bei Voll- und Neumond entstehende, besonders starke Gezeitenkräfte, wenn Sonne, Mond und Erde auf einer Geraden liegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2308fc08-69d7-4adf-b7d9-2b7b7335a5e5",
                                "sense_id": "37ce56a5-f3f3-31a3-97ed-7be915174aa3",
                                "text": "„Es war, als warte sie ohnmächtig darauf, dass eine Springflut kam und alles unter sich begrub.“"
                            },
                            {
                                "example_id": "c2dde1d0-743b-4c46-9fe9-56d18ec466e5",
                                "sense_id": "37ce56a5-f3f3-31a3-97ed-7be915174aa3",
                                "text": "„Stand eine Springflut bevor, so konnte man sicher sein, er lag trotz Sturm und Wetter weit draußen am Deiche mutterseelenallein […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9761bc26-031a-4d98-9b46-d80f3d35709a",
                        "source_entry_id": "faad050c-6010-3cd2-81ef-33d38db2bf19",
                        "source_sense_id": "37ce56a5-f3f3-31a3-97ed-7be915174aa3",
                        "source_sense_description": "bei Voll- und Neumond entstehende, besonders starke Gezeitenkräfte",
                        "target_lang_word": "spring tide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spring tide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac50f6f4-cd71-3c92-a290-688b8b900f1e",
                                        "entry_id": "4e9cf1c9-8321-34be-8e2a-52c2e0098c82",
                                        "glosses": [
                                            "The tide which occurs when the moon is new or full; the effects of the Sun and moon being reinforced so that this tide is of maximum range."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f67ce7-d994-418c-90cf-b69a9d0fca5c",
                                                "sense_id": "ac50f6f4-cd71-3c92-a290-688b8b900f1e",
                                                "text": "Spring tides at Chepstow rise 40 ft., and there is a rapid current except for a very short time."
                                            },
                                            {
                                                "example_id": "af41b5a1-27ab-42fe-a3c3-621c5ed04da8",
                                                "sense_id": "ac50f6f4-cd71-3c92-a290-688b8b900f1e",
                                                "text": "During the day conditions worsened quickly—for example, a 2-6-0 on the Uckfield line suddenly encountered flood water high enough to enter its ashpan and extinguish its fire—until lock gates up-river at Barcombe gave way and a tidal wave rolled down the valley meeting head-on a spring tide rolling up from the coast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fdb035e-2789-41b3-81be-dd9e2cb0bc20",
                        "source_entry_id": "faad050c-6010-3cd2-81ef-33d38db2bf19",
                        "source_sense_id": "37ce56a5-f3f3-31a3-97ed-7be915174aa3",
                        "source_sense_description": "bei Voll- und Neumond entstehende, besonders starke Gezeitenkräfte",
                        "target_lang_word": "springtij",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "springtij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0bb2ed0c-674f-32cb-bea4-28349ddb5a72",
                                        "entry_id": "c8bb6ce3-1360-339e-94dd-af227bd8116e",
                                        "glosses": [
                                            "extra hoge vloed (en extra laag laagwater)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73f8844b-649b-4f45-bb10-95cbbb2197bd",
                                                "sense_id": "0bb2ed0c-674f-32cb-bea4-28349ddb5a72",
                                                "text": "Het gekrakeel van die jonkies, waarvan sommigen amper een kwast konden vasthouden, was als springtij door het dorp geraasd. Subsidie was een heilig gewoonterecht! Wat moesten ze dan godverdomme? Buigen voor de commercie? Moesten ze op zoek naar sponsors, of terug naar het mecenaat dat toch werkelijk dood was en hopelijk voorgoed begraven?"
                                            },
                                            {
                                                "example_id": "3cfc458f-f153-420c-9177-5aa8bf67e5d6",
                                                "sense_id": "0bb2ed0c-674f-32cb-bea4-28349ddb5a72",
                                                "text": "In de nacht van zaterdag 31 januari op zondag 1 februari 1953, de nacht van Beatrix' vijftiende verjaardag, werd Nederland getroffen door een natuurramp van ongekende omvang. Door een samenvallen van springtij met een zware noordwesterstorm werd aan de westkust het peil van gevaarlijk hoogwater overschreden."
                                            },
                                            {
                                                "example_id": "a4cc267c-fbea-45de-a6ba-e978fa44a4d8",
                                                "sense_id": "0bb2ed0c-674f-32cb-bea4-28349ddb5a72",
                                                "text": "Rond 14 uur kwam een groep kinderen in het water zwaar in de problemen. Het was kort na springtij, de golven waren heel hoog en door de hevige stroming op het water werden ze tegen de funderingen van het Westerstaketsel geduwd. Een omstander zag de kinderen in moeilijkheden en verwittigde de hulpdiensten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
