                ],
                "translations": [
                    {
                        "translation_id": "78fcbfbd-2de0-4189-a48e-f1ac13cde0d0",
                        "source_entry_id": "af52f915-cbbc-3973-b8bc-02170c053643",
                        "source_sense_id": "ad922763-efab-3ba0-9946-4f9c053c34e5",
                        "target_lang_word": "contrarier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrarier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23da1904-0890-3d89-b0e6-5f28c28976be",
                                        "entry_id": "a55d7f1c-ed9b-3d9f-934a-5588f0be90cd",
                                        "glosses": [
                                            "Empêcher d’agir, d’aboutir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae74d9c3-a7be-4787-a0c1-80773549315d",
                                                "sense_id": "23da1904-0890-3d89-b0e6-5f28c28976be",
                                                "text": "Il portait sous le bras un objet d’assez grandes dimensions dont elles ne purent discerner la nature, et qui, en ballottant contre sa jambe, contrariait sa marche."
                                            },
                                            {
                                                "example_id": "3d701b66-9ec1-447e-965a-fe69508a1051",
                                                "sense_id": "23da1904-0890-3d89-b0e6-5f28c28976be",
                                                "text": "Ce navire nous apprit que, contrarié par le temps, il devait charbonner à Seydisfjard sur la côte Est d’Islande."
                                            },
                                            {
                                                "example_id": "6f7ab6c7-07d4-4fe3-a378-c15bd5179b3b",
                                                "sense_id": "23da1904-0890-3d89-b0e6-5f28c28976be",
                                                "text": "Il me contrarie dans tous mes desseins, dans tout ce que je veux entreprendre."
                                            },
                                            {
                                                "example_id": "915990c9-e37b-4a0f-bb7c-4907db6a48c7",
                                                "sense_id": "23da1904-0890-3d89-b0e6-5f28c28976be",
                                                "text": "Un mouvement qui en contrarie un autre."
                                            },
                                            {
                                                "example_id": "82dcc775-5d8d-4f55-ad35-7ec01c8f3859",
                                                "sense_id": "23da1904-0890-3d89-b0e6-5f28c28976be",
                                                "text": "Contrarier la nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c20bbc87-d4b0-378d-b87c-396771b20a4b",
                                        "entry_id": "a55d7f1c-ed9b-3d9f-934a-5588f0be90cd",
                                        "glosses": [
                                            "Chagriner, causer du dépit par des actions ou des paroles."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ea5577d-c994-4dcf-bd10-44fb83184075",
                                                "sense_id": "c20bbc87-d4b0-378d-b87c-396771b20a4b",
                                                "text": "Votre conduite m’a fort contrarié."
                                            },
                                            {
                                                "example_id": "234b8f85-aa3d-4339-9921-ab2a9c1c4cfd",
                                                "sense_id": "c20bbc87-d4b0-378d-b87c-396771b20a4b",
                                                "text": "Il m’a paru contrarié. Vous semblez contrarié."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0e35115-f1cc-3597-8b24-7e686ffe57c9",
                                        "entry_id": "a55d7f1c-ed9b-3d9f-934a-5588f0be90cd",
                                        "glosses": [
                                            "S’opposer à une ou plusieurs personnes par ses actions ou par ses paroles."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef68034a-07fa-46c9-b58b-cac6a025da52",
                                                "sense_id": "b0e35115-f1cc-3597-8b24-7e686ffe57c9",
                                                "text": "Il me contrarie toujours."
                                            },
                                            {
                                                "example_id": "7ba8b9d5-39ed-4950-8861-81c87502a622",
                                                "sense_id": "b0e35115-f1cc-3597-8b24-7e686ffe57c9",
                                                "text": "(Absolument) Il aime contrarier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9667bea6-c754-3d08-a2f6-f0531bb9f803",
                                        "entry_id": "a55d7f1c-ed9b-3d9f-934a-5588f0be90cd",
                                        "glosses": [
                                            "Faire passer un fil, tantôt dessus, tantôt dessous un autre fil qu’il rencontre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e7fd299-6631-48af-bd39-6b9c2f42f2fa",
                                                "sense_id": "9667bea6-c754-3d08-a2f6-f0531bb9f803",
                                                "text": "Contrarier les fils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a4be702-ec6b-3322-a502-d1ee0e1f0df7",
                                        "entry_id": "a55d7f1c-ed9b-3d9f-934a-5588f0be90cd",
                                        "glosses": [
                                            "En décoration, diversifier les couleurs en les mélangeant, opposer une couleur à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5586b6d7-b266-4841-8593-ff44e93a7c2d",
                                                "sense_id": "6a4be702-ec6b-3322-a502-d1ee0e1f0df7",
                                                "text": "Contrarier les couleurs."
                                            }
                                        ]
                                    }
                                ]
                            }
