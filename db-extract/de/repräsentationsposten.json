                "senses": [
                    {
                        "sense_id": "837f1799-9cd8-307b-acb0-45d6cfa63bd4",
                        "entry_id": "fa3674f1-c5de-3c3a-b996-9c65dc67f7ef",
                        "glosses": [
                            "Posten, der etwas repräsentiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a339553a-1c39-4842-87ae-6317751c9c9b",
                                "sense_id": "837f1799-9cd8-307b-acb0-45d6cfa63bd4",
                                "text": "„Dieses Bankhaus war 1922 von der Disconto-Gesellschaft und einigen ihrer Geschäftspartner übernommen worden, sein früherer Eigentümer Viktor Ephrussi blieb auf einem Repräsentationsposten in der Firma.“"
                            },
                            {
                                "example_id": "3d3987c0-72df-418e-9dc4-e9c075db8329",
                                "sense_id": "837f1799-9cd8-307b-acb0-45d6cfa63bd4",
                                "text": "„Und zwar vom Wagrainer ÖVP-Mann Bertl Emberger, der seit 1989 auf diesem Repräsentationsposten sitzt.“"
                            },
                            {
                                "example_id": "2a8b6099-2929-4531-9d84-ffd42cb38c49",
                                "sense_id": "837f1799-9cd8-307b-acb0-45d6cfa63bd4",
                                "text": "„Bei Kosten von 22 Millionen Euro jährlich sei der politische und wirtschaftliche Nutzen der \"gut bezahlten Repräsentationsposten\" höchst zweifelhaft.“"
                            },
                            {
                                "example_id": "da196c06-f50d-4091-af95-f76d2902fa3a",
                                "sense_id": "837f1799-9cd8-307b-acb0-45d6cfa63bd4",
                                "text": "„Das Amt gilt als Repräsentationsposten mit eingeschränktem Einfluss.“"
                            },
                            {
                                "example_id": "2f1b9e5f-72fe-4894-860f-05c3e1d7db45",
                                "sense_id": "837f1799-9cd8-307b-acb0-45d6cfa63bd4",
                                "text": "„Zu Schröders Rolle meint er: »Wenn der Exkanzler nun fröhlich sagt, er habe mit dem Jugoslawienkrieg das Völkerrecht gebrochen, dann hat er eigentlich ein Anrecht auf einen Repräsentationsposten bei der Europäischen Union.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
