                "entry_id": "1f925f9b-d880-3eb9-be5b-68a11fc34f28",
                "word": "муторно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "840a4719-31bd-3830-bff2-b384335d3e5b",
                        "entry_id": "1f925f9b-d880-3eb9-be5b-68a11fc34f28",
                        "glosses": [
                            "наречие к муторный; тоскливо, занудно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "15d83666-eb0a-40fe-b729-b5dc5f74314c",
                                "sense_id": "840a4719-31bd-3830-bff2-b384335d3e5b",
                                "text": "Рабочий день проходит медленно, муторно и депрессивно."
                            }
                        ]
                    },
                    {
                        "sense_id": "e037eec3-6ba4-305a-a66a-03de57f103ce",
                        "entry_id": "1f925f9b-d880-3eb9-be5b-68a11fc34f28",
                        "glosses": [
                            "неприятно, тревожно и тоскливо"
                        ],
                        "tags": [
                            "безл. в знач. сказ."
                        ],
                        "examples": [
                            {
                                "example_id": "8343f175-3e29-45aa-aa14-f833dd2f9a8d",
                                "sense_id": "e037eec3-6ba4-305a-a66a-03de57f103ce",
                                "text": "Муторно на душе."
                            },
                            {
                                "example_id": "2b87b764-c433-40a5-b6b6-e5c5b1d9e1ef",
                                "sense_id": "e037eec3-6ba4-305a-a66a-03de57f103ce",
                                "text": "Андрей остался один, и ему тошно было коротать минуты одиночества. — Эх, и муторно же здесь! — рассуждал он."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "133f7acf-7de2-46ac-8913-e83da72f0414",
                        "source_entry_id": "1f925f9b-d880-3eb9-be5b-68a11fc34f28",
                        "source_sense_description": "тоскливо и занудно",
                        "target_lang_word": "boringly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boringly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fc3425a-5818-3070-aadc-4a99ed8a0309",
                                        "entry_id": "0e1eb3cd-f0a3-3223-bfa1-ba8f370cb920",
                                        "glosses": [
                                            "In a boring manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "998fb746-a37f-459e-8224-7e84eeee21ee",
                                                "sense_id": "1fc3425a-5818-3070-aadc-4a99ed8a0309",
                                                "text": "The professor droned on boringly, putting his class to sleep."
                                            },
                                            {
                                                "example_id": "eb5c0541-8feb-4d5c-9825-84efafd8aa4c",
                                                "sense_id": "1fc3425a-5818-3070-aadc-4a99ed8a0309",
                                                "text": "\"I understand most of them are most boringly moral in their private lives."
                                            },
                                            {
                                                "example_id": "0f7b5651-dd60-4393-b5b4-a2b572f25c6f",
                                                "sense_id": "1fc3425a-5818-3070-aadc-4a99ed8a0309",
                                                "text": "\"Let's take another boringly democratic vote. Shall we...Consuella?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
