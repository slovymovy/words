                    {
                        "sense_id": "8981b631-f87f-371a-bc1d-4e81201878a6",
                        "entry_id": "e51fb372-5a09-3d62-a1fc-042bd690e9f8",
                        "glosses": [
                            "Plat traditionnel kanak de Nouvelle-Calédonie : sorte de ragoût de poulet, de collier blanc, de poisson ou de roussette accompagné de taros, de patates douces, de bananes poingo, de tomates et d’ignames, cuit au four traditionnel ou à la marmite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caab47de-1994-4a03-9c69-18685475aad2",
                                "sense_id": "8981b631-f87f-371a-bc1d-4e81201878a6",
                                "text": "Toutefois, sous la pression des nécessités du monde moderne certaines associations procèdent parfois à des ventes de bougnas pour alimenter leurs caisses."
                            }
                        ]
                    },
                    {
                        "sense_id": "726e978b-3689-3a94-9fee-e3e13008f0ab",
                        "entry_id": "e51fb372-5a09-3d62-a1fc-042bd690e9f8",
                        "glosses": [
                            "Repas dont le plat principal est ce plat."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "40df0926-3093-403c-bdd1-626af39a75ad",
                                "sense_id": "726e978b-3689-3a94-9fee-e3e13008f0ab",
                                "text": "Être invité à un bougna est un témoignage d’amitié à ne pas méconnaître."
                            }
                        ]
                    }
