                        "source_entry_id": "ca4f37c9-c80f-3eb6-b719-1749f2796bb7",
                        "source_sense_description": "делать что-либо раньше кого-либо, чего-либо; опережать",
                        "target_lang_word": "prevent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prevent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad994f0a-05c4-3070-a8ff-1e7c290911aa",
                                        "entry_id": "6cb0ff99-f867-3ffd-9e3d-d49306af5d86",
                                        "glosses": [
                                            "To stop (an outcome); to keep from (doing something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70e0ee6c-7298-4212-91d2-7ea858db3c8f",
                                                "sense_id": "ad994f0a-05c4-3070-a8ff-1e7c290911aa",
                                                "text": "I brush my teeth regularly to prevent tooth decay."
                                            },
                                            {
                                                "example_id": "689737c4-e5a5-429c-b4cf-44bb08da66b5",
                                                "sense_id": "ad994f0a-05c4-3070-a8ff-1e7c290911aa",
                                                "text": "Scotland must now hope Georgia produce a huge upset and beat Argentina by at least eight points in Sunday's final Pool B match to prevent them failing to make the last eight for the first time in World Cup history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67cd476e-4355-397f-9f09-e2c7a24b8c41",
                                        "entry_id": "6cb0ff99-f867-3ffd-9e3d-d49306af5d86",
                                        "glosses": [
                                            "To take preventative measures."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84cf2369-7f27-49cc-b8f8-fbfcd22c50e1",
                                                "sense_id": "67cd476e-4355-397f-9f09-e2c7a24b8c41",
                                                "text": "I think you must be mad, and she shall not have a glimpse of it while I'm here to prevent!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffc06fca-a367-3426-bd33-30ff19fefbc3",
                                        "entry_id": "6cb0ff99-f867-3ffd-9e3d-d49306af5d86",
                                        "glosses": [
                                            "To come before; to precede."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a9c523-71c3-4649-b6e0-c2a728af737e",
                                                "sense_id": "ffc06fca-a367-3426-bd33-30ff19fefbc3",
                                                "text": "We pray thee that thy grace may always prevent and follow us."
                                            },
                                            {
                                                "example_id": "fc0a278c-ac32-413b-b8fc-cb120c8398b2",
                                                "sense_id": "ffc06fca-a367-3426-bd33-30ff19fefbc3",
                                                "text": "We which are alive and remain unto the coming of the Lord shall not prevent them which are asleep."
                                            },
                                            {
                                                "example_id": "b784e75f-3b37-4a33-8cd2-eb1ae754434c",
                                                "sense_id": "ffc06fca-a367-3426-bd33-30ff19fefbc3",
                                                "text": "Then had I come, preventing Sheba's Queen, / To ſee the comelieſt of the Sons of Men; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76e598ca-7aab-379c-bc70-52689974ae9a",
                                        "entry_id": "6cb0ff99-f867-3ffd-9e3d-d49306af5d86",
                                        "glosses": [
                                            "To outdo, surpass."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cca6901d-82d1-4d94-818f-36f42e6dae2c",
                                                "sense_id": "76e598ca-7aab-379c-bc70-52689974ae9a",
                                                "text": "With that he put his spurres vnto his steed, / With speare in rest, and toward him did fare, / Like shaft out of a bow preuenting speed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5673926b-c911-310c-b675-b3e7a6a9d3cc",
                                        "entry_id": "6cb0ff99-f867-3ffd-9e3d-d49306af5d86",
                                        "glosses": [
                                            "To be beforehand with; to anticipate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "981679c2-7154-48cc-b18d-e38c03303230",
                                                "sense_id": "5673926b-c911-310c-b675-b3e7a6a9d3cc",
                                                "text": "their ready guilt preventing thy commands"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
