                        "translation_id": "9c13ead0-fe52-43b5-a875-0a4366da64ac",
                        "source_entry_id": "55f6f808-9881-3eef-84ae-8f293bee1025",
                        "source_sense_id": "36595452-06c9-3602-bae3-757683134708",
                        "source_sense_description": "to reintroduce industry to",
                        "target_lang_word": "réindustrialiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
