{
    "word_family": [
        "mountain",
        "mountaineer",
        "mountainous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa09aa23-9dd5-358a-9fb3-3e26b6880e35",
                    "sense_definition": "The highest point or peak of a mountain.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "summit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers finally reached the <w>mountaintop</w> after a long and exhausting climb.",
                            "target_lang_translations": {
                                "de": "Die Wanderer erreichten nach einem langen und anstrengenden Aufstieg endlich den <w>Berggipfel</w>."
                            }
                        },
                        {
                            "text": "Snow covered the <w>mountaintop</w> even during the warm summer months.",
                            "target_lang_translations": {
                                "de": "Schnee bedeckte den <w>Berggipfel</w> selbst während der warmen Sommermonate."
                            }
                        }
                    ],
                    "synonyms": [
                        "summit",
                        "peak",
                        "crest"
                    ],
                    "antonyms": [
                        "base",
                        "foot"
                    ],
                    "common_phrases": [
                        "snowy mountaintop",
                        "distant mountaintop"
                    ],
                    "target_lang_definitions": {
                        "de": "Der höchste Punkt oder Gipfel eines Berges."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Berggipfel",
                                "target_lang_sense_clarification": "Der allgemeinste Begriff für den höchsten Punkt eines Berges."
                            },
                            {
                                "target_lang_word": "Bergspitze",
                                "target_lang_sense_clarification": "Betont die spitze, markante Form des höchsten Punktes."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f7b1247b-1c64-328a-b847-ff2767e91432",
                    "sense_definition": "Located or happening at the very top of a mountain.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "summit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They enjoyed a <w>mountaintop</w> view of the entire valley below.",
                            "target_lang_translations": {
                                "de": "Sie genossen den Blick vom <w>Berggipfel</w> auf das gesamte Tal unter ihnen."
                            }
                        },
                        {
                            "text": "The <w>mountaintop</w> air was thin and very cold at that altitude.",
                            "target_lang_translations": {
                                "de": "Die Luft auf dem <w>Berggipfel</w> war in dieser Höhe dünn und sehr kalt."
                            }
                        }
                    ],
                    "synonyms": [
                        "alpine"
                    ],
                    "common_phrases": [
                        "mountaintop view",
                        "mountaintop village"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf dem Gipfel eines Berges gelegen oder dort stattfindend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "auf dem Berggipfel",
                                "target_lang_sense_clarification": "Adverbiale Verwendung zur Beschreibung des Ortes."
                            },
                            {
                                "target_lang_word": "hochgelegen",
                                "target_lang_sense_clarification": "Beschreibt etwas, das sich in großer Höhe befindet."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}