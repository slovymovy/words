                ],
                "senses": [
                    {
                        "sense_id": "23ae0f9b-616b-355f-8a28-4c63e4372aab",
                        "entry_id": "f48df1aa-d898-3859-af6c-e3f64cd6c674",
                        "glosses": [
                            "behorend tot of betrekking hebbend op een zeer oud tijdperk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "178a6f7b-63c4-444c-9820-642db5379e96",
                                "sense_id": "23ae0f9b-616b-355f-8a28-4c63e4372aab",
                                "text": "Dat wordt nu bestempeld als een archaïsch begrip."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0a5deea-3b72-4a0c-807b-93df5083c0b8",
                        "source_entry_id": "f48df1aa-d898-3859-af6c-e3f64cd6c674",
                        "source_sense_id": "23ae0f9b-616b-355f-8a28-4c63e4372aab",
                        "source_sense_description": "behorend tot of betrekking hebbend op een zeer oud tijdperk",
                        "target_lang_word": "archaisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archaisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d70f91e5-a236-3b6f-876e-520a2ef18e8e",
                                        "entry_id": "cfd7891a-76dc-3252-934c-7c10d63c3e1c",
                                        "glosses": [
                                            "von den frühen Anfängen; zur Frühzeit gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e40a0eb-c199-4218-8ad2-5fc0b8ae01a4",
                                                "sense_id": "d70f91e5-a236-3b6f-876e-520a2ef18e8e",
                                                "text": "„Vielleicht war der Einfluß des archaischen Althirns zu stark, als daß sich die dünne Stimme von oben durchsetzen konnte.“"
                                            },
                                            {
                                                "example_id": "036ed480-1810-4526-a345-c2d4be547754",
                                                "sense_id": "d70f91e5-a236-3b6f-876e-520a2ef18e8e",
                                                "text": "„Tatsache nun aber ist, daß wirklich Volk immer Volk bleibt, wenigstens in einer bestimmten Schicht seines Wesens, eben der archaischen, und daß Leute und Nachbarn vom Kleinen Gelbgießer-Gang, die am Wahltage einen sozialdemokratischen Stimmzettel abgaben, gleichzeitig imstande waren, in der Armut eines Mütterchens, das sich keine oberirdische Wohnung leisten konnte, etwas Dämonisches zu sehen, und bei ihrer Annäherung nach ihren Kindern zu greifen, um sie vor dem bösen Blick der Hexe zu schützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14f8004c-3a8f-3d37-a285-f84109a3f33a",
                                        "entry_id": "cfd7891a-76dc-3252-934c-7c10d63c3e1c",
                                        "glosses": [
                                            "überholt, veraltet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "979f8894-dbcb-404e-8078-1119f576f106",
                                                "sense_id": "14f8004c-3a8f-3d37-a285-f84109a3f33a",
                                                "text": "Seiner Tochter das Fernsehen zu verbieten gehört zu den archaischen Erziehungsmethoden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8f94f969-403c-376f-84db-7ba0eec246e4",
                                        "entry_id": "cfd7891a-76dc-3252-934c-7c10d63c3e1c",
                                        "glosses": [
                                            "der archaischen, vorklassischen Epoche (Archaik) angehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "452b3567-2293-4ed3-ab1a-9c535aa8c964",
                                                "sense_id": "8f94f969-403c-376f-84db-7ba0eec246e4",
                                                "text": "Die archaische Kunst gliedert sich in die früh-, hoch- und spätarchaische Epoche."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4c74651-2794-4ca6-8b15-1c8bb8a708ae",
                        "source_entry_id": "f48df1aa-d898-3859-af6c-e3f64cd6c674",
                        "source_sense_id": "23ae0f9b-616b-355f-8a28-4c63e4372aab",
                        "source_sense_description": "behorend tot of betrekking hebbend op een zeer oud tijdperk",
                        "target_lang_word": "archaic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archaic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81bd0a44-9ddc-3f22-b1d1-f13a05496261",
                                        "entry_id": "81a3c3d4-44b6-32eb-b9b6-7482bcb5e57b",
                                        "glosses": [
                                            "The prehistoric period intermediate between the earliest period (‘Paleo-Indian’, ‘Paleo-American’, ‘American‐paleolithic’, etc.) of human presence in the Western Hemisphere, and the most recent prehistoric period (‘Woodland’, etc.)."
                                        ],
                                        "tags": [
                                            "US",
                                            "capitalized",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43b8294b-43ad-4670-bf4a-4b1add8457d8",
                                                "sense_id": "81bd0a44-9ddc-3f22-b1d1-f13a05496261",
                                                "text": "… Archaic Stage … the stage of migratory hunting and gathering cultures continuing into environmental conditions approximately those of the present."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d6036fc-f014-3808-8bf1-33c80597498e",
                                        "entry_id": "81a3c3d4-44b6-32eb-b9b6-7482bcb5e57b",
                                        "glosses": [
                                            "(A member of) an archaic variety of Homo sapiens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f351f6e-dccf-4c7c-8c93-cb257e9f5c45",
                                                "sense_id": "3d6036fc-f014-3808-8bf1-33c80597498e",
                                                "text": "[...] prefer the third explanation for the advanced-looking features of Neandertals (Chapter 7) and the Ngandong hominins (Chapter 6), but they have had little to say about the post-Erectine archaics from China."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "archaic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bb9d2c0-ad4e-344e-a951-e5fcadb29672",
                                        "entry_id": "cc6382fd-aa09-33e6-988e-f8b39af94075",
                                        "glosses": [
                                            "Of or characterized by antiquity; old-fashioned, quaint, antiquated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc4f898d-a790-4db7-ac45-5a427160b0f6",
                                                "sense_id": "3bb9d2c0-ad4e-344e-a951-e5fcadb29672",
                                                "text": "A person familiar with the dialect of certain portions of Massachusetts will not fail to recognize, in ordinary discourse, many words now noted in English vocabularies as archaic, the greater part of which were in common use about the time of the King James translation of the Bible. Shakespeare stands less in need of a glossary to most New Englanders than to many a native of the Old Country."
                                            },
                                            {
                                                "example_id": "ec8f4777-94d3-4be9-a350-66a4ada66e43",
                                                "sense_id": "3bb9d2c0-ad4e-344e-a951-e5fcadb29672",
                                                "text": "There is in the best archaic coin work [of the Greeks] ... a strength and a delicacy which are often wanting in the fully developed art of a later age."
                                            },
                                            {
                                                "example_id": "8e66cd66-a0c1-4727-aada-0d6538ab087e",
                                                "sense_id": "3bb9d2c0-ad4e-344e-a951-e5fcadb29672",
                                                "text": "Brann's compass of words, idioms and phrases harks back to the archaic and reaches forward to the futuristic. Volume 1"
                                            },
                                            {
                                                "example_id": "9604e6c9-dded-4d86-98a2-3956be6a318a",
                                                "sense_id": "3bb9d2c0-ad4e-344e-a951-e5fcadb29672",
                                                "text": "But now he is reinvented; he is on the way to establishing himself as the official interpreter of an ancient, archaic institution to the generations that are already distant in both time and culture from the world that sustains his grandmother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4a0079c-d4f6-357f-a992-21dd00d7bcfb",
                                        "entry_id": "cc6382fd-aa09-33e6-988e-f8b39af94075",
                                        "glosses": [
                                            "No longer in ordinary use, though still used occasionally to give a sense of antiquity and are still likely to be understood by well-educated speakers and are found in historical texts."
                                        ],
                                        "tags": [
                                            "of words"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3eb4904-a0d2-45d1-bcae-cf1ebb9d1ab3",
                                                "sense_id": "c4a0079c-d4f6-357f-a992-21dd00d7bcfb",
                                                "text": "The language of the Faerie Queene was made archaic Language:— in order to be in keeping with the chivalry of bygone ages that formed its subject."
                                            },
                                            {
                                                "example_id": "f907263d-673f-4c96-9118-13a099449898",
                                                "sense_id": "c4a0079c-d4f6-357f-a992-21dd00d7bcfb",
                                                "text": "Almost every writer of power will occasionally use with strong effect an archaic term that he has unearthed from the treasures of the older English vocabulary. This is especially true of poets, who recognize that the unusualness of the archaic word will sometimes heighten the poetic effect."
                                            },
                                            {
                                                "example_id": "75162820-d62e-449e-8cdf-41c3d6b10e61",
                                                "sense_id": "c4a0079c-d4f6-357f-a992-21dd00d7bcfb",
                                                "text": "When generations pass and the object or institution referred to by the archaic word is no longer part of present, lived experience, though the word has been retained, its meaning is commonly altered or simply vanishes. African talking drums, as used for example among the Lokele in eastern Zaire, speak in elaborate formulas that preserve certain archaic words which the drummers can vocalize but whose meaning they no longer know."
                                            },
                                            {
                                                "example_id": "58921940-d40b-4cef-8118-62643509441b",
                                                "sense_id": "c4a0079c-d4f6-357f-a992-21dd00d7bcfb",
                                                "text": "his resistance to censorship blends nicely with his scorn for the common folk, so a limited edition, in beautiful archaic language incomprehensible to the masses, of rude or blasphemous material such as one can find in the Decameron, would simultaneously satisfy both impulses."
                                            },
                                            {
                                                "example_id": "a0f5a1f1-23d8-4b2d-9540-a465dffcff0d",
                                                "sense_id": "c4a0079c-d4f6-357f-a992-21dd00d7bcfb",
                                                "text": "Cabell also uses a kind of stylistic dissonance to reinforce his novel's thematic ironies at the sentence level. An inflated speech in archaic language might end with a modern pinprick: \"And so on, and so on!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "790323bb-affb-3817-8cd3-cedf6b076f70",
                                        "entry_id": "cc6382fd-aa09-33e6-988e-f8b39af94075",
                                        "glosses": [
                                            "Belonging to the archaic period."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
