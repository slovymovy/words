                "senses": [
                    {
                        "sense_id": "79a76493-07bf-34ac-b118-e6d4234620a9",
                        "entry_id": "40684372-f310-3ba9-85ff-24d893dce6c4",
                        "glosses": [
                            "(künstlerischer) Leiter einer Oper, eines Theaters oder eines Rundfunksenders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac60b95c-d920-4361-8082-70d041c6ced5",
                                "sense_id": "79a76493-07bf-34ac-b118-e6d4234620a9",
                                "text": "Claus Peymann ist ein deutscher Theaterregisseur und derzeit Intendant des Berliner Ensembles."
                            },
                            {
                                "example_id": "163b8fdd-7131-4f54-97f2-e7548bdc7973",
                                "sense_id": "79a76493-07bf-34ac-b118-e6d4234620a9",
                                "text": "„Doch früher oder später wird es auch die Intendanten von ARD und ZDF beschäftigen und ihnen eine neue Debatte über ihre Gebührenmilliarden bescheren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3f7032cb-70fe-3b36-99c3-a67e1239a8d9",
                        "entry_id": "40684372-f310-3ba9-85ff-24d893dce6c4",
                        "glosses": [
                            "oberster Verantwortlicher einer militärischen Verwaltungsbehörde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ccb2db4-7031-482b-8be0-13f14f6b2cd7",
                                "sense_id": "3f7032cb-70fe-3b36-99c3-a67e1239a8d9",
                                "text": "„Die im vorliegenden Repertorium erschlossenen Akten entstanden in der Korpsintendantur, die außer dem Geschäftsbereich des Intendanten, bzw. der Behördenleitung (einschließlich Innerer Dienst) in folgende Abteilungen untergliedert war:…“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "821dfc69-8798-4c6d-b501-24bf75490638",
                        "source_entry_id": "40684372-f310-3ba9-85ff-24d893dce6c4",
