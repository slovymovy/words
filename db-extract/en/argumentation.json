    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "46330b21-acd7-3a07-a112-f1af32467613",
                "word": "argumentation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "40b473aa-0fde-4fcb-9a46-4c026f51c30b",
                        "entry_id": "46330b21-acd7-3a07-a112-f1af32467613",
                        "tags": [
                            "plural"
                        ],
                        "form": "argumentations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dcec9c3f-a07f-3024-a823-ec6862157af5",
                        "entry_id": "46330b21-acd7-3a07-a112-f1af32467613",
                        "glosses": [
                            "Inference based on reasoning from given propositions."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "7a88a044-473c-42af-b6a9-a89bbeca1f44",
                                "sense_id": "dcec9c3f-a07f-3024-a823-ec6862157af5",
                                "text": "His chain of argumentation is flawed."
                            },
                            {
                                "example_id": "fcb357cd-fd06-40e5-9363-4fdf8d61336a",
                                "sense_id": "dcec9c3f-a07f-3024-a823-ec6862157af5",
                                "text": "None of the traditional proposals suffers from the weaknesses characteristic of CAW's suggestions: what CAW has to offer are mere guesses, arrived at in a totally unsystematic way and totally unsupported by rational and reasonable argumentation."
                            }
                        ]
                    },
                    {
                        "sense_id": "15e2aa02-a972-34f8-bdba-60c7f2673d1a",
                        "entry_id": "46330b21-acd7-3a07-a112-f1af32467613",
                        "glosses": [
                            "An exchange of arguments"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e9cc2bfd-b311-4343-b73a-14eb23392c4d",
                                "sense_id": "15e2aa02-a972-34f8-bdba-60c7f2673d1a",
                                "text": "Their argumentation continued long into the night."
                            }
                        ]
                    },
                    {
                        "sense_id": "07e2cde1-1ffe-3cdb-ba3e-d9feb8ff32df",
                        "entry_id": "46330b21-acd7-3a07-a112-f1af32467613",
                        "glosses": [
                            "The addition of arguments to a model; parameterization."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "4500ee93-4b50-44c4-b3e1-5540ebf17f0f",
                                "sense_id": "07e2cde1-1ffe-3cdb-ba3e-d9feb8ff32df",
                                "text": "An argumentation framework has an obvious representation as a directed graph where nodes are arguments and edges are drawn from attacking to attacked arguments."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00224fcb-91e3-4dcc-bf4d-0ea6e85fffed",
