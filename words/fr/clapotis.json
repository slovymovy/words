                {
                    "sense_id": "685b2d1d-a2d4-3873-ab1d-16dbe88e5974",
                    "sense_definition": "Bruit léger et continu de l'eau qui frappe doucement contre un obstacle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le doux <w>clapotis</w> de l'eau contre la coque du bateau l'aida à s'endormir paisiblement."
                        },
                        {
                            "text": "Assis sur la berge du lac, nous écoutions en silence le faible <w>clapotis</w> des vagues."
                        }
                    ],
                    "synonyms": [
                        "clapotement",
                        "clapotage"
                    ],
                    "common_phrases": [
                        "clapotis de l'eau"
                    ]
                },
                {
                    "sense_id": "55f17d61-3ea3-3012-9293-ee9f92bbef1c",
                    "sense_definition": "Agitation légère de l'eau causée par des vagues courtes qui se croisent et s'entrechoquent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "eau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la tombée de la nuit, le vent faiblit et la mer ne formait plus qu'un léger <w>clapotis</w>."
                        },
                        {
                            "text": "La rencontre des deux courants marins provoquait un fort <w>clapotis</w> à la surface de l'océan."
                        }
                    ],
                    "synonyms": [
                        "clapotage",
                        "clapotement"
                    ],
                    "common_phrases": [
                        "léger clapotis"
                    ]
                },
                {
                    "sense_id": "8b3ff5b9-d0a8-3b42-b129-cdc72df52bb9",
                    "sense_definition": "Bruit faible et discontinu produit par des applaudissements timides ou clairsemés.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seul un timide <w>clapotis</w> de mains accueillit la fin du discours maladroit de l'orateur."
                        },
                        {
                            "text": "La pièce de théâtre se termina dans une grande indifférence, à peine troublée par un vague <w>clapotis</w>."
