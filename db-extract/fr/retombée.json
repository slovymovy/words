                                    {
                                        "sense_id": "b6792e57-1329-3113-ac04-3473bbf49147",
                                        "entry_id": "bc0ebb37-0912-35d7-bf2c-a9ca86d90c65",
                                        "glosses": [
                                            "Folgen, Konsequenzen einer Handlung oder Unterlassung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54a02ba2-007d-445a-b60c-307911891566",
                                                "sense_id": "b6792e57-1329-3113-ac04-3473bbf49147",
                                                "text": "Die Auswirkungen der Finanzkrise sind noch nicht überschaubar."
                                            },
                                            {
                                                "example_id": "4ecfab24-3d97-4744-8953-97a2fb4cb18c",
                                                "sense_id": "b6792e57-1329-3113-ac04-3473bbf49147",
                                                "text": "„Man muss bezweifeln, ob die Lohnzurückhaltung überhaupt nennenswerte Auswirkungen auf den Export hatte.“"
                                            },
                                            {
                                                "example_id": "2a5d100d-b7e6-47a7-a608-1856be46499e",
                                                "sense_id": "b6792e57-1329-3113-ac04-3473bbf49147",
                                                "text": "„Zweitens kommen ihre Auswirkungen auf den allgemeinen Sprachgebrauch nicht in der vordergründigen Weise zustande, daß die Meinungen, Ratschläge oder Verdikte von Sprachkritik und Stillehre im Regelsinne beachtet würden, wohl aber tun sie unterschwellig ihre Wirkung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
