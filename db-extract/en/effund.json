                        ],
                        "examples": [
                            {
                                "example_id": "e5e6ae60-ce17-4b37-9152-af1ed77d07dc",
                                "sense_id": "cbaf99dd-71f5-3bbc-b997-6e9270ef6aab",
                                "text": "If he his life effund To utmost death, the high God hath design'd That we both live."
                            },
                            {
                                "example_id": "a79d9200-00bc-48da-807d-0d9f08bc99e4",
                                "sense_id": "cbaf99dd-71f5-3bbc-b997-6e9270ef6aab",
                                "text": "However, later discoveries prove, that it is not peculiar to one species only, but that several kinds, nay, different families, afford and effund this purple juice : indeed a whole family of Shells still retain the name of Purpuræ, or purples, from this property."
                            }
                        ]
