                "senses": [
                    {
                        "sense_id": "cf68a0ad-13d3-30c3-b8a7-aaeafb17548f",
                        "entry_id": "eb1d38f5-4543-3731-9620-2eb877e8bb19",
                        "glosses": [
                            "The variety of the Persian language that is chiefly used in Afghanistan, contrasted with varieties spoken elsewhere such as Iranian Persian or Tajik."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ff4477d5-7c0e-3e5b-a0a8-2a5a1cfa435b",
                        "entry_id": "eb1d38f5-4543-3731-9620-2eb877e8bb19",
                        "glosses": [
                            "A variety of Middle Persian which served as the court language of the late Sasanian Empire."
                        ],
                        "tags": [
                            "historical",
                            "uncommon"
                        ],
                        "examples": []
                    },
                    {
