                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы договорились встретиться у <w>метро</w> в пять часов.",
                            "target_lang_translations": {
                                "en": "We agreed to meet by the <w>metro</w> at five o'clock.",
                                "nl": "We hebben afgesproken om om vijf uur bij het <w>metrostation</w> af te spreken.",
                                "pl": "Umówiliśmy się na spotkanie przy <w>metrze</w> o piątej.",
                                "de": "Wir haben uns verabredet, uns um fünf Uhr an der <w>U-Bahn-Station</w> zu treffen.",
                                "fr": "Nous avons convenu de nous retrouver près du <w>métro</w> à cinq heures.",
                                "it": "Ci siamo accordati di incontrarci vicino alla <w>metropolitana</w> alle cinque.",
                                "cs": "Domluvili jsme se, že se sejdeme u <w>metra</w> v pět hodin.",
                                "tr": "Saat beşte <w>metronun</w> önünde buluşmak üzere anlaştık.",
                                "es": "Quedamos en vernos junto al <w>metro</w> a las cinco."
                            }
                        },
                        {
                            "text": "Магазин находится прямо возле <w>метро</w>.",
                            "target_lang_translations": {
                                "en": "The shop is located right next to the <w>subway</w>.",
                                "nl": "De winkel bevindt zich vlak naast het <w>metrostation</w>.",
                                "pl": "Sklep znajduje się tuż obok <w>metra</w>.",
                                "de": "Das Geschäft befindet sich direkt an der <w>U-Bahn</w>.",
                                "fr": "Le magasin se trouve juste à côté du <w>métro</w>.",
                                "it": "Il negozio si trova proprio accanto alla <w>metropolitana</w>.",
                                "cs": "Obchod se nachází přímo u <w>metra</w>.",
                                "tr": "Mağaza hemen <w>metronun</w> yanında bulunuyor.",
                                "es": "La tienda está justo al lado del <w>metro</w>."
                            }
                        }
