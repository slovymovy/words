{
    "word_family": [
        "naast",
        "daarnaast",
        "hiernaast",
        "ernaast"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fa3349a1-7d92-33c7-b0cc-df48d8ca5d0f",
                    "sense_definition": "vragend: naast wat?, naast welk?",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vragend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Waarnaast</w> staat die bank precies?",
                            "target_lang_translations": {
                                "en": "<w>Next to what</w> exactly is that sofa located?"
                            }
                        },
                        {
                            "text": "Ik weet niet <w>waarnaast</w> ik mijn auto moet parkeren.",
                            "target_lang_translations": {
                                "en": "I don't know <w>next to what</w> I should park my car."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waarnaast staat"
                    ],
                    "target_lang_definitions": {
                        "en": "interrogative: next to what?, beside what?"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "next to what",
                                "target_lang_sense_clarification": "asking about the position relative to an object"
                            },
                            {
                                "target_lang_word": "beside what",
                                "target_lang_sense_clarification": "asking about the location next to something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b137b796-f4c7-3c2d-852f-c1f951c634b3",
                    "sense_definition": "betrekkelijk: naast wat, naast hetwelk",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "betrekkelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is de bank <w>waarnaast</w> het nieuwe museum gebouwd wordt.",
                            "target_lang_translations": {
                                "en": "This is the bank <w>next to which</w> the new museum is being built."
                            }
                        },
                        {
                            "text": "Het gebouw <w>waarnaast</w> wij wonen is erg oud.",
                            "target_lang_translations": {
                                "en": "The building <w>next to which</w> we live is very old."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gebouw waarnaast"
                    ],
                    "target_lang_definitions": {
                        "en": "relative: next to which, beside which"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "next to which",
                                "target_lang_sense_clarification": "referring back to a previously mentioned object"
                            },
                            {
                                "target_lang_word": "beside which",
                                "target_lang_sense_clarification": "referring to a position adjacent to something mentioned"
                            }
                        ]
                    }
                }
            ]
        }
    ]
