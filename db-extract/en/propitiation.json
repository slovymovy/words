                "senses": [
                    {
                        "sense_id": "958cc995-fb43-30dd-99de-0fc3137595cf",
                        "entry_id": "9ee23620-8d73-36fd-8f42-376790b0b446",
                        "glosses": [
                            "The act of propitiating; placation, atonement, similar to expiation but also involving the appeasement of anger."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d5bd081c-463a-489c-8f28-d76b729f1fbd",
                                "sense_id": "958cc995-fb43-30dd-99de-0fc3137595cf",
                                "text": "Whom God hath set forth to be a propitiation through faith in his blood, to declare his righteousness for the remission of sins that are past, through the forbearance of God"
                            },
                            {
                                "example_id": "3d40adac-8372-4764-bc28-8276ce619b18",
                                "sense_id": "958cc995-fb43-30dd-99de-0fc3137595cf",
                                "text": "At the base of the whole process by which divinities and demons were created, and rites for their propitiation and placation established, lay Fear - fear stimulating the imagination to fantastic activity."
                            }
                        ]
                    },
                    {
                        "sense_id": "b147d7d4-0ea9-348b-a00b-95a1e3e5e5ed",
                        "entry_id": "9ee23620-8d73-36fd-8f42-376790b0b446",
                        "glosses": [
                            "The death of Christ as a basis for the forgiveness of sin."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c94334e9-b1e7-4978-b24d-d55318ad2863",
                        "source_entry_id": "9ee23620-8d73-36fd-8f42-376790b0b446",
                        "source_sense_description": "the act of propitiating; placation, atonement, expiation",
                        "target_lang_word": "expier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3001d8a-3f38-3a76-a309-3850ef7825bb",
                                        "entry_id": "f81a293a-3ce6-3249-8d23-0df13a770716",
                                        "glosses": [
                                            "Réparer un crime, une faute par le repentir, ou une peine, un châtiment imposé ou accepté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60d0d57b-96ac-4ad1-863d-f0d7375ed61d",
                                                "sense_id": "d3001d8a-3f38-3a76-a309-3850ef7825bb",
                                                "text": "Lucas de Beaumanoir a décidé que la mort de la juive serait une offrande suffisante pour expier toutes les fautes amoureuses des chevaliers du Temple ; […]."
                                            },
                                            {
                                                "example_id": "c67aa234-caef-4eab-8072-cf71100472ac",
                                                "sense_id": "d3001d8a-3f38-3a76-a309-3850ef7825bb",
                                                "text": "J’apporte dans mon existence nouvelle un sentiment qu’il n’a jamais connu, celui d’expier une ancienne vie certainement nuisible et de racheter des torts dont je me sens encore aujourd’hui responsable, parce qu’il y a, selon moi, entre toutes les femmes également respectables, une solidarité instinctive de droits, d’honneur et de vertus."
                                            },
                                            {
                                                "example_id": "facd93bf-4c83-42d4-8e03-e00266ac1f4a",
                                                "sense_id": "d3001d8a-3f38-3a76-a309-3850ef7825bb",
                                                "text": "Dès l’Ite Missa est, la sacristine s'agita. Longue, plate et noire comme un staphyllin, desséchée par cinquante ans de célibat concentré, elle semble porter sur ses épaules étroites tout le deuil de la terre, expier tous les péchés du monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
