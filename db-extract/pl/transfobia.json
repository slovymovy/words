                    {
                        "sense_id": "413c2e51-26a3-3540-b479-ba724c2637d7",
                        "entry_id": "49846f81-265f-3a4a-92d9-f49dd9f38bdf",
                        "glosses": [
                            "dyskryminacja objawiająca się niechęcią lub agresją wobec osób transpłciowych"
                        ],
                        "tags": [
                            "psychology"
