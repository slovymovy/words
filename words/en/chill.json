    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43c2d05f-b999-3b0d-9153-9effd6769e7f",
                    "sense_definition": "To relax, calm down, or stop worrying.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_relax",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>chill</w> out and stop stressing about the exam results.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>расслабиться</w> и перестать нервничать из-за результатов экзамена.",
                                "tr": "Sınav sonuçları hakkında stres yapmayı bırakıp biraz <w>rahatlaman</w> gerekiyor.",
                                "zh": "你需要<w>放松</w>一下，别再为考试成绩感到压力了。"
                            }
                        },
                        {
                            "text": "I just want to go home, listen to music, and <w>chill</w> for the evening.",
                            "target_lang_translations": {
                                "ru": "Я просто хочу пойти домой, послушать музыку и <w>отдохнуть</w> вечером.",
                                "tr": "Sadece eve gitmek, müzik dinlemek ve akşam boyunca <w>keyfime bakmak</w> istiyorum.",
                                "zh": "我只想回家听听音乐，晚上<w>休息</w>一下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "relax",
                        "unwind",
                        "calm down",
                        "take it easy"
                    ],
                    "antonyms": [
                        "stress",
                        "panic"
                    ],
                    "common_phrases": [
                        "chill out",
                        "just chill"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common in spoken English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расслабиться, успокоиться или перестать волноваться.",
                        "tr": "Rahatlamak, sakinleşmek veya endişelenmeyi bırakmak.",
                        "zh": "放松、冷静下来或停止担忧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расслабляться",
                                "target_lang_sense_clarification": "отдыхать, снимать напряжение"
                            },
                            {
                                "target_lang_word": "остыть",
                                "target_lang_sense_clarification": "успокоиться, перестать нервничать"
                            },
                            {
                                "target_lang_word": "отдыхать",
                                "target_lang_sense_clarification": "проводить время без дел"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "rahatlamak",
                                "target_lang_sense_clarification": "stres atmak, gevşemek"
                            },
                            {
                                "target_lang_word": "sakinleşmek",
                                "target_lang_sense_clarification": "öfke veya endişeyi yatıştırmak"
                            },
                            {
                                "target_lang_word": "keyfine bakmak",
                                "target_lang_sense_clarification": "yavaşlayıp anın tadını çıkarmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放松",
                                "target_lang_sense_clarification": "缓解紧张情绪"
                            },
                            {
                                "target_lang_word": "冷静",
                                "target_lang_sense_clarification": "平复心情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7b09e5a-3853-34cd-982b-8fb0bb6a7e79",
                    "sense_definition": "To make something cold or to lower its temperature.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_temp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>chill</w> the white wine in the fridge before the guests arrive.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>охладить</w> белое вино в холодильнике до прихода гостей.",
                                "tr": "Misafirler gelmeden önce beyaz şarabı buzdolabında <w>soğutmalısın</w>.",
                                "zh": "客人来之前，你应该把白葡萄酒放在冰箱里<w>冷藏</w>。"
                            }
                        },
                        {
                            "text": "The strong wind began to <w>chill</w> us as soon as we stepped outside.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер начал <w>пробирать</w> нас холодом, как только мы вышли на улицу.",
                                "tr": "Dışarı adım atar atmaz güçlü rüzgar bizi <w>üşütmeye</w> başladı.",
                                "zh": "我们一走到外面，大风就开始让我们感到<w>寒冷</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cool",
                        "refrigerate",
                        "cool down"
                    ],
                    "antonyms": [
                        "heat",
                        "warm"
                    ],
                    "common_phrases": [
                        "chill the dough",
                        "chill the wine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-то холодным или понизить температуру.",
                        "tr": "Bir şeyi soğutmak veya sıcaklığını düşürmek.",
                        "zh": "使某物变冷或降低其温度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охлаждать",
                                "target_lang_sense_clarification": "понижать температуру чего-либо"
                            },
                            {
                                "target_lang_word": "студить",
                                "target_lang_sense_clarification": "делать холодным (часто о ветре или погоде)"
                            },
                            {
                                "target_lang_word": "остужать",
                                "target_lang_sense_clarification": "давать остыть"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "soğutmak",
                                "target_lang_sense_clarification": "derecesini düşürmek"
                            },
                            {
                                "target_lang_word": "serinletmek",
                                "target_lang_sense_clarification": "hafifçe soğuk hale getirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冷藏",
                                "target_lang_sense_clarification": "放入冰箱降温"
                            },
                            {
                                "target_lang_word": "冷却",
                                "target_lang_sense_clarification": "降低温度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24335aae-4c7d-3229-98d0-45d9ccc6776a",
                    "sense_definition": "To spend time socially with friends; to hang out.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We used to <w>chill</w> at the park every Saturday afternoon during the summer.",
                            "target_lang_translations": {
                                "ru": "Раньше мы каждое субботнее летнее утро <w>тусовались</w> в парке.",
                                "tr": "Yaz boyunca her cumartesi öğleden sonra parkta <w>takılırdık</w>.",
                                "zh": "夏天的时候，我们过去常在每个周六下午去公园<w>闲逛</w>。"
                            }
                        },
                        {
                            "text": "Are you free to <w>chill</w> with us later tonight?",
                            "target_lang_translations": {
                                "ru": "Ты свободен, чтобы <w>потусоваться</w> с нами сегодня вечером?",
                                "tr": "Bu gece ilerleyen saatlerde bizimle <w>takılmak</w> için müsait misin?",
                                "zh": "你今晚晚些时候有空和我们一起<w>聚会</w>吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "hang out",
                        "socialize"
                    ],
                    "common_phrases": [
                        "chill with friends",
                        "chill together"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common among younger speakers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить время с друзьями; тусоваться.",
                        "tr": "Arkadaşlarla sosyal olarak vakit geçirmek; takılmak.",
                        "zh": "与朋友社交；消磨时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тусоваться",
                                "target_lang_sense_clarification": "разг. проводить время в компании"
                            },
                            {
                                "target_lang_word": "проводить время",
                                "target_lang_sense_clarification": "общаться, отдыхать вместе"
                            },
                            {
                                "target_lang_word": "отдыхать",
                                "target_lang_sense_clarification": "ничего не делать в компании друзей"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "takılmak",
                                "target_lang_sense_clarification": "arkadaşlarla vakit geçirmek"
                            },
                            {
                                "target_lang_word": "vakit geçirmek",
                                "target_lang_sense_clarification": "birlikte zaman harcamak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闲逛",
                                "target_lang_sense_clarification": "随意地消磨时间"
                            },
                            {
                                "target_lang_word": "聚会",
                                "target_lang_sense_clarification": "与朋友在一起"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9802bb24-ae58-345c-9a90-ed1056af9ee1",
                    "sense_definition": "To discourage or depress enthusiasm or activity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_metaphorical_cold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strict censorship laws often <w>chill</w> public discourse and freedom of expression.",
                            "target_lang_translations": {
                                "ru": "Законы о жесткой цензуре часто <w>охлаждают</w> общественную дискуссию и свободу слова.",
                                "tr": "Sıkı sansür yasaları genellikle kamusal tartışmayı ve ifade özgürlüğünü <w>baltalarlar</w>.",
                                "zh": "严格的审查法往往会<w>抑制</w>公众讨论和言论自由。"
                            }
                        },
                        {
                            "text": "The sudden announcement seemed to <w>chill</w> the mood of the celebration.",
                            "target_lang_translations": {
                                "ru": "Внезапное объявление, казалось, <w>остудило</w> праздничное настроение.",
                                "tr": "Ani duyuru, kutlamanın neşesini <w>kaçırmış</w> gibi göründü.",
                                "zh": "那个突如其来的公告似乎让庆祝活动的气氛<w>冷淡</w>了下来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discourage",
                        "dampen"
                    ],
                    "antonyms": [
                        "encourage",
                        "stimulate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in legal or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Остудить пыл, подавить энтузиазм или активность.",
                        "tr": "Coşkuyu, hevesi veya faaliyeti yatıştırmak, kırmak.",
                        "zh": "抑制或打击热情或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остужать",
                                "target_lang_sense_clarification": "метаф. снижать интенсивность чувств или действий"
                            },
                            {
                                "target_lang_word": "охлаждать",
                                "target_lang_sense_clarification": "делать менее активным или восторженным"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hevesini kırmak",
                                "target_lang_sense_clarification": "coşkuyu azaltmak"
                            },
                            {
                                "target_lang_word": "soğutmak",
                                "target_lang_sense_clarification": "ilgi veya isteği azaltmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打击",
                                "target_lang_sense_clarification": "削弱积极性"
                            },
                            {
                                "target_lang_word": "抑制",
                                "target_lang_sense_clarification": "限制发展"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e8756647-2d7b-3b23-9528-0ec4456c61e9",
                    "sense_definition": "Relaxed, easygoing, and not easily upset.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_relax",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My new boss is really <w>chill</w> and doesn't mind if we take breaks.",
                            "target_lang_translations": {
                                "ru": "Мой новый начальник очень <w>спокойный</w> и не возражает, если мы делаем перерывы.",
                                "tr": "Yeni patronum gerçekten çok <w>rahat</w> biri ve mola vermemize aldırış etmiyor.",
                                "zh": "我的新老板非常<w>随和</w>，不介意我们休息。"
                            }
                        },
                        {
                            "text": "We had a very <w>chill</w> weekend watching movies and eating pizza.",
                            "target_lang_translations": {
                                "ru": "У нас были очень <w>расслабленные</w> выходные: мы смотрели фильмы и ели пиццу.",
                                "tr": "Film izleyip pizza yiyerek çok <w>sakin</w> bir hafta sonu geçirdik.",
                                "zh": "我们度过了一个非常<w>放松</w>的周末，看了电影，吃了披萨。"
                            }
                        }
