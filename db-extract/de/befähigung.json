                "senses": [
                    {
                        "sense_id": "eb3e2131-2cad-36d8-8f69-9bb6a036fc01",
                        "entry_id": "5b86928e-d432-3cb8-98fa-10cff236b0d5",
                        "glosses": [
                            "das Befähigtsein, die Eignung für eine bestimmte Aufgabe"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "aa74536d-73c5-4fbe-854c-4289adcadfb8",
                                "sense_id": "eb3e2131-2cad-36d8-8f69-9bb6a036fc01",
                                "text": "Die Vor- und Ausbildung der Lehrerinnen und Lehrer, die nicht die Befähigung zu einem Lehramt im Sinne dieses Gesetzes besitzen, wird aufgrund des § 15 Abs. 1 des Landesbeamtengesetzes durch Rechtsverordnung der Landesregierung geregelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edc28a56-ce19-44e6-98e0-312aec81b645",
                        "source_entry_id": "5b86928e-d432-3cb8-98fa-10cff236b0d5",
                        "source_sense_id": "eb3e2131-2cad-36d8-8f69-9bb6a036fc01",
                        "source_sense_description": "Plural selten: das Befähigtsein, die Eignung für eine bestimmte Aufgabe",
                        "target_lang_word": "compétence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compétence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "949c3908-def5-359c-afb2-9fb9df5cee1f",
                                        "entry_id": "c3e686f2-87b5-39eb-a646-ec11578f558d",
                                        "glosses": [
                                            "Fonction attribuée par la loi à une autorité publique, à un établissement public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ddf9b4-86b9-4afd-995b-2c993591e688",
                                                "sense_id": "949c3908-def5-359c-afb2-9fb9df5cee1f",
                                                "text": "Dans les communes, l’État ne délègue pas de représentants dotés de compétences générales, comme les préfets dans les départements et les régions."
                                            },
                                            {
                                                "example_id": "e645939d-4986-4c9b-a449-fc0800a897c3",
                                                "sense_id": "949c3908-def5-359c-afb2-9fb9df5cee1f",
                                                "text": "Le maire exerce des compétences déléguées par le conseil municipal et doit alors lui rendre compte de ses actes."
                                            },
                                            {
                                                "example_id": "e24d5098-728b-4d11-a9e5-a9fbf3aaaa2d",
                                                "sense_id": "949c3908-def5-359c-afb2-9fb9df5cee1f",
                                                "text": "Quant à la compétence ratione materiæ, elle était parfois considérable, mais impossible à ramener à des règles générales, car elle dépendait des clauses contenues aux titres qui les avaient constituées."
                                            },
                                            {
                                                "example_id": "5c8e52e7-d9da-49bb-b470-cca85e8f9645",
                                                "sense_id": "949c3908-def5-359c-afb2-9fb9df5cee1f",
                                                "text": "Vous pouvez en tant qu’Établissement public de coopération intercommunale (EPCI) ou Conseil départemental assurer vous même la gestion des aides à la pierre pour une durée de six ans. Vous devenez alors délégataires de compétence. La délégation de compétence comprend la gestion des aides à la pierre pour le logement social, les aides à l’amélioration des logements privés et les dispositifs de location-accession."
                                            },
                                            {
                                                "example_id": "ab976695-6c56-46e1-b297-abdbdc92ea3a",
                                                "sense_id": "949c3908-def5-359c-afb2-9fb9df5cee1f",
                                                "text": "Contrairement à vous, au niveau local, nous n’avons pas [en Albanie] la compétence pour les accueillir ou les faire venir. Tout est décidé par le Premier ministre, le ministre des finances et le gouvernement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4badcd70-69cb-38be-b06d-ac58d3e20dc7",
                                        "entry_id": "c3e686f2-87b5-39eb-a646-ec11578f558d",
                                        "glosses": [
                                            "Le droit qu’un tribunal, qu’un juge a de connaître de telle ou telle matière, de telle ou telle cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ef24810-1a8c-4a24-8f5d-203549c7169a",
                                                "sense_id": "4badcd70-69cb-38be-b06d-ac58d3e20dc7",
                                                "text": "Faire juger la compétence."
                                            },
                                            {
                                                "example_id": "d7b5a55a-76b6-483e-9d6a-6b5dd1bfc41b",
                                                "sense_id": "4badcd70-69cb-38be-b06d-ac58d3e20dc7",
                                                "text": "Cela n’est pas de sa compétence."
                                            },
                                            {
                                                "example_id": "db310a7e-a5d0-4d54-9dbc-7689ec512fa8",
                                                "sense_id": "4badcd70-69cb-38be-b06d-ac58d3e20dc7",
                                                "text": "Cette question, cette affaire est de la compétence de tel tribunal."
                                            },
                                            {
                                                "example_id": "2a87d54a-c214-40d3-aed4-795d530c41b4",
                                                "sense_id": "4badcd70-69cb-38be-b06d-ac58d3e20dc7",
                                                "text": "Il s’ensuit que cette action relève de la compétence des tribunaux de l’ordre judiciaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bee92e1-00e6-305f-a8a1-c40abcd34155",
                                        "entry_id": "c3e686f2-87b5-39eb-a646-ec11578f558d",
                                        "glosses": [
                                            "Aptitude d’une personne à travailler dans un domaine."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00c1e38a-57b7-41aa-a6ec-764595a0220f",
                                                "sense_id": "5bee92e1-00e6-305f-a8a1-c40abcd34155",
                                                "text": "Le commissaire aux comptes veille à ce que ses collaborateurs disposent des compétences appropriées à la bonne exécution des tâches qu’il leur confie et à ce qu’ils reçoivent et maintiennent un niveau de formation approprié."
                                            },
                                            {
                                                "example_id": "6f549a49-81e9-446a-b81f-5cdb9877be26",
                                                "sense_id": "5bee92e1-00e6-305f-a8a1-c40abcd34155",
                                                "text": "On était enclin déjà, je pense, à juger la qualité et la compétence d’un médecin par le prix qu’il fait payer : plus il prend cher, et plus il doit être savant. Ce critérium s’applique encore davantage aux médicastres, aux voyantes et aux charlatans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5406c080-8983-3a08-b0e3-72f3b47312bc",
                                        "entry_id": "c3e686f2-87b5-39eb-a646-ec11578f558d",
                                        "glosses": [
                                            "Aptitude d’une personne à juger d’un ouvrage ou à parler de façon pertinente d'un sujet."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49f42246-a906-43fa-b5f1-86929044b2cf",
                                                "sense_id": "5406c080-8983-3a08-b0e3-72f3b47312bc",
                                                "text": "Pour le seconder, il peut compter sur les compétences aiguisées de Youness Chtioui, lui aussi passé par le fameux Palace Jamaï."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c99a8dd-f8c5-3612-8c42-493d09956426",
                                        "entry_id": "c3e686f2-87b5-39eb-a646-ec11578f558d",
                                        "glosses": [
                                            "Aptitude d’une personne à résoudre un problème complexe."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a754103-aa1f-4226-889d-f3aa1aab4e86",
                                                "sense_id": "3c99a8dd-f8c5-3612-8c42-493d09956426",
                                                "text": "La résolution de problèmes est une compétence essentielle en mathématiques, car elle a pour but d’amener l’élève à donner du sens à la manipulation de données et aux opérations arithmétiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2a87562-758f-3d18-9726-bccbe8257948",
                                        "entry_id": "c3e686f2-87b5-39eb-a646-ec11578f558d",
                                        "glosses": [
                                            "Grandeur, en général sous la forme d’une valeur chiffrée, et définissant la capacité d’un personnage à gérer certaines situations."
                                        ],
                                        "tags": [
                                            "Jeux de rôle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7390762f-e16c-407c-86dc-f899a79aadbd",
                                                "sense_id": "a2a87562-758f-3d18-9726-bccbe8257948",
                                                "text": "Chaque caractéristique couvre un large éventail de capacités, y compris les compétences qu’un personnage ou un monstre peut maîtriser. Une compétence représente un aspect spécifique d’une valeur de caractéristique, et les compétences maîtrisées par un individu démontrent l’accent mis sur cet aspect spécifique (les compétences maîtrisées d’un personnage sont déterminées à la création de celui-ci, et les compétences maîtrisées d’un monstre apparaissent dans son bloc de stat)."
                                            },
                                            {
                                                "example_id": "f2a05f24-9225-4e65-b329-3235a5ef6d88",
                                                "sense_id": "a2a87562-758f-3d18-9726-bccbe8257948",
                                                "text": "Le système D6 repose sur des compétences et des caractéristiques exprimées en nombre de dés. Un personnage peut ainsi avoir 3D+2 en Intelligence et 5D en Survie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8fc8272-a50c-360f-baf0-2de9bf7f8445",
                                        "entry_id": "c3e686f2-87b5-39eb-a646-ec11578f558d",
                                        "glosses": [
                                            "Propriété d’une roche de se briser sous l’effet des contraintes tectoniques. → voir compétent"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1973c6bd-baa3-4a96-a46c-e25a2e98b569",
                                                "sense_id": "c8fc8272-a50c-360f-baf0-2de9bf7f8445",
                                                "text": "La compétence de la roche est son aptitude à résister à une déformation. Une roche compétente résiste peu à une déformation et se fracture rapidement …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5bb5e69-b435-4ef3-8947-5dff51178ebe",
                        "source_entry_id": "5b86928e-d432-3cb8-98fa-10cff236b0d5",
                        "source_sense_id": "eb3e2131-2cad-36d8-8f69-9bb6a036fc01",
                        "source_sense_description": "Plural selten: das Befähigtsein, die Eignung für eine bestimmte Aufgabe",
                        "target_lang_word": "aptitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aptitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99773c62-73e4-36fa-9905-a7f4676ae378",
                                        "entry_id": "98e0282e-1ece-3047-96c9-dd33ab8e5e3c",
                                        "glosses": [
                                            "Capacité, compétence, disposition naturelle à faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63420503-e781-4596-9443-659ce089ec50",
                                                "sense_id": "99773c62-73e4-36fa-9905-a7f4676ae378",
                                                "text": "Le grand jeune homme dégingandé, qui s’appelait Laurier, s’était apparemment institué chef en raison de sa position sociale et de ses aptitudes naturelles."
                                            },
                                            {
                                                "example_id": "edbf3f13-fcb7-4a74-a7e1-f6f7ce760086",
                                                "sense_id": "99773c62-73e4-36fa-9905-a7f4676ae378",
                                                "text": "Le canard de Rouen est des plus recommandables par sa taille, sa rusticité, sa précocité et son aptitude à l'engraissement. Il est aussi le plus répandu."
                                            },
                                            {
                                                "example_id": "0d1a7288-cab9-4284-ac5b-b29282e46d7a",
                                                "sense_id": "99773c62-73e4-36fa-9905-a7f4676ae378",
                                                "text": "Assez docilement se laissa-t-il convaincre : l’aptitude pour le dessin qu'il s'était découverte en croquant, au ministère, les binettes de ses voisins de pupitre, achevait de lui supprimer toute perplexité de vocation."
                                            },
                                            {
                                                "example_id": "f9ca8508-a0de-4517-ad1c-41ed5e2f9138",
                                                "sense_id": "99773c62-73e4-36fa-9905-a7f4676ae378",
                                                "text": "Mon père dit toujours que mon sens de l’orientation en forêt est troublant – tout comme mon aptitude à retrouver mon chemin jusqu'au point de départ – mais je ne m'y fiais pas à cet instant. Je m'arrêtai sous un arbre gigantesque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fe4b2df-cf02-379c-9b78-b4b4adc3140d",
                                        "entry_id": "98e0282e-1ece-3047-96c9-dd33ab8e5e3c",
                                        "glosses": [
                                            "Compétence à recevoir un legs."
