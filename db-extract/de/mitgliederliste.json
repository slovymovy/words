                        "glosses": [
                            "Liste, auf der die Mitglieder einer Organisation aufgeführt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97337c19-c35a-4c6e-8528-c3de1cfc2e3e",
                                "sense_id": "e5a3b13c-74be-3ae0-93ef-43b33f0228f2",
                                "text": "Der Vereinskassier übergab dem Vorsitzenden die aktualisierte Mitgliederliste."
                            },
                            {
                                "example_id": "1f9037f9-ec9b-4879-ac3e-f83e38e9b2a3",
                                "sense_id": "e5a3b13c-74be-3ae0-93ef-43b33f0228f2",
                                "text": "„Die Mitgliederliste umfasst alles, was in der Schweizer Musikszene Rang und Namen hat, von Adrian Stern über Stress bis zu Züri West.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
