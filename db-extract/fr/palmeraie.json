                "word": "palmeraie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9f8b5b83-208c-4f36-9f6d-87ea318cc34a",
                        "entry_id": "a9f2520c-a9a1-39d5-88d6-3ecf51666fa3",
                        "tags": [
                            "plural"
                        ],
                        "form": "palmeraies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "09b8e6e1-e049-33cb-9172-269590c2855b",
                        "entry_id": "a9f2520c-a9a1-39d5-88d6-3ecf51666fa3",
                        "glosses": [
                            "Lieu peuplé de palmiers."
                        ],
                        "tags": [
                            "Agronomie",
                            "Ethnobiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "150a8e8a-46f5-4387-a6c3-dd5256407e63",
                                "sense_id": "09b8e6e1-e049-33cb-9172-269590c2855b",
                                "text": "La permanence des noms de jardins dans la palmeraie ancienne ne doit pas laisser penser que celle-ci est immuable quant à sa structuration foncière."
                            },
                            {
                                "example_id": "eb784265-c364-4d4f-9b4f-f305e95600c4",
                                "sense_id": "09b8e6e1-e049-33cb-9172-269590c2855b",
                                "text": "Par intervalles, quand un rayon de lune, crevant d’argent les nuages gonflés de chaleur, lui fait croire au jeune soleil, une tourterelle roucoule dans les palmeraies."
                            },
                            {
                                "example_id": "33cb93a4-76b2-4613-8464-00cf970c6d63",
                                "sense_id": "09b8e6e1-e049-33cb-9172-269590c2855b",
                                "text": "Mais c'est surtout la reconstitution de palmeraies à usage intérieur qui est d'actualité aujourd'hui car l'extension du \"bayoud\" a provoqué d'importants mouvements de populations, incapable de subsister dans les zones contaminées."
                            },
                            {
                                "example_id": "ae838be9-0553-4191-8492-97e283fb8a12",
                                "sense_id": "09b8e6e1-e049-33cb-9172-269590c2855b",
                                "text": "Depuis plusieurs siècles, les aguedals ornent les cités de l'Atlas, tandis qu'à Tunis, à Bougie, à Tlemcen et dans les palmeraies de Biskra et d'ailleurs embaument les fleurs aux odeurs lourdes et aux couleurs d'argent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1744eed8-dac1-4173-a223-ffafb4e6800a",
                        "source_entry_id": "a9f2520c-a9a1-39d5-88d6-3ecf51666fa3",
