                ],
                "senses": [
                    {
                        "sense_id": "27e85ee5-639d-332d-97fe-82e6ed7f7346",
                        "entry_id": "a6d5a740-ff32-30c5-8dc8-922f4af4fc08",
                        "glosses": [
                            "Roughly spherical in shape; globe-shaped."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16a7bf12-117d-4953-b2c2-be6a2e16037b",
                                "sense_id": "27e85ee5-639d-332d-97fe-82e6ed7f7346",
                                "text": "\"Nary a spot,\" interrupted E. R. Coglan, flippantly. \"The terrestrial, globular, planetary hunk of matter, slightly flattened at the poles, and known as the Earth, is my abode.[…]\""
                            },
                            {
                                "example_id": "6440235a-9984-48e9-9a4d-d9dee2343acf",
                                "sense_id": "27e85ee5-639d-332d-97fe-82e6ed7f7346",
                                "text": "Podson's globular stare assured any woman that the bargain was sacred. It was solemn, intent, opaque; it was also slightly mesmeric, which is to say that it gave out everything and took in nothing."
                            },
                            {
                                "example_id": "6997024f-84e2-4562-8756-09038aca7663",
                                "sense_id": "27e85ee5-639d-332d-97fe-82e6ed7f7346",
                                "text": "Globular lights, painted a dark green, hang from under the fancy iron eaves, unlit for centuries . . ."
                            }
                        ]
                    },
                    {
                        "sense_id": "16448a32-5a6e-3eb2-aa0d-464fbc69779d",
                        "entry_id": "a6d5a740-ff32-30c5-8dc8-922f4af4fc08",
                        "glosses": [
                            "Comprising globules."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee152399-1b46-4406-8f9e-cbc1a094984e",
                        "source_entry_id": "a6d5a740-ff32-30c5-8dc8-922f4af4fc08",
                        "source_sense_description": "roughly spherical",
                        "target_lang_word": "globulaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "globulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c6bf8c6-c63e-39f9-8719-35076adddb29",
                                        "entry_id": "8640bdab-e0bf-34db-9e12-4ea37e1fe24b",
                                        "glosses": [
                                            "Qui a la forme d’un globe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a29992e-71c5-4624-9ab1-872f72f3b998",
                                                "sense_id": "9c6bf8c6-c63e-39f9-8719-35076adddb29",
                                                "text": "Les ollas d’époque califale sont des pièces globulaires à deux anses et fond convexe, présentant un décor incisé sur le haut de panse composé d’une ligne de stries parallèles et de vaguelettes (ollas 1, 2, 4, 5, 6)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34cb8513-5604-338e-aa54-d907832de227",
                                        "entry_id": "8640bdab-e0bf-34db-9e12-4ea37e1fe24b",
                                        "glosses": [
                                            "Qui évoque la forme d’un globe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e9fc92-623c-41cf-99ad-1e9bea4b56d2",
                                                "sense_id": "34cb8513-5604-338e-aa54-d907832de227",
                                                "text": "On assurait même que le conseil municipal des Andelys, après les doléances répétées de quelques notables ouvertement cocus, et terrorisés par la carrure, les biceps globulaires du sergent chef, avait demandé sa mutation dans une cité plus importante, et, par là, plus fournie en femmes de tout genre…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "globulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5cc9a21-e2dd-3d4c-a212-d30b3094814d",
                                        "entry_id": "c9a6e5e4-ffe1-36b4-b55e-0c72d6197120",
                                        "glosses": [
                                            "Genre de plantes dicotylédones qui tirent leur nom de ce que leurs fleurs sont ramassées en forme de petites boules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "812e244b-c4d8-4785-ad46-99b161958c59",
                                                "sense_id": "e5cc9a21-e2dd-3d4c-a212-d30b3094814d",
                                                "text": "La globulaire alypon ou globulaire turbith est appelée turbith blanc ou séné de Provence et, à tort, herbe terrible ou malherbe, elle purge doucement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
