{
    "word_family": [
        "observer",
        "observateur",
        "observable",
        "observatoire",
        "inobservable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d95fc383-4912-317c-a10f-6d6aca29f327",
                    "sense_definition": "Action de regarder attentivement, d'examiner ou de surveiller quelque chose ou quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "regard_et_surveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis ce poste d'<w>observation</w>, nous pouvons voir toute la vallée."
                        },
                        {
                            "text": "Ce guide a un excellent sens de l'<w>observation</w> pour repérer les oiseaux rares."
                        }
                    ],
                    "common_phrases": [
                        "poste d'observation",
                        "sens de l'observation"
                    ]
                },
                {
                    "sense_id": "d22b7b90-fa6a-36eb-8772-7695a39549a5",
                    "sense_definition": "Remarque, réflexion ou commentaire formulé sur quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "remarque_et_parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a écouté chaque avis et a fait une <w>observation</w> pertinente."
                        },
                        {
                            "text": "Avez-vous une autre <w>observation</w> à ajouter avant la fin de notre réunion ?"
                        }
                    ],
                    "common_phrases": [
                        "faire une observation",
                        "formuler une observation"
                    ]
                },
                {
                    "sense_id": "88cb9700-34fd-3cb7-907e-1103cdc05ef8",
                    "sense_definition": "Surveillance médicale attentive à laquelle est soumis un patient afin d'établir un diagnostic.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "regard_et_surveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa chute à vélo, le médecin a préféré le garder en <w>observation</w>."
                        },
                        {
                            "text": "Le patient a passé la nuit en <w>observation</w> au service des urgences."
                        }
                    ],
                    "common_phrases": [
                        "garder en observation",
                        "mettre en observation"
                    ]
                },
                {
                    "sense_id": "dcfe4140-26cb-30a4-83c7-bdc36b60791f",
                    "sense_definition": "Étude et examen attentif et méthodique de phénomènes scientifiques ou naturels.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regard_et_surveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>observation</w> attentive des étoiles permet aux astronomes de mieux comprendre l'univers."
                        },
                        {
                            "text": "Cette étude repose sur une <w>observation</w> scientifique rigoureuse des espèces marines."
                        }
                    ],
                    "common_phrases": [
                        "observation scientifique",
                        "champ d'observation"
                    ]
                },
                {
                    "sense_id": "ef6ce73f-f35f-3c50-8006-fd30b2e9fa39",
                    "sense_definition": "Remarque nuancée de reproche ou avertissement adressé à une personne sur son comportement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remarque_et_parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur lui a fait des <w>observations</w> sévères au sujet de ses retards répétés."
                        },
                        {
                            "text": "Elle n'a pas apprécié les <w>observations</w> de son responsable sur sa manière de travailler."
                        }
                    ],
                    "common_phrases": [
                        "faire des observations"
                    ]
                },
                {
                    "sense_id": "4e8e8718-e433-3ac6-a97c-add68f66e426",
                    "sense_definition": "Respect scrupuleux et mise en pratique d'une loi, d'une règle ou d'un engagement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conformite_norme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>observation</w> scrupuleuse des règles de sécurité permet d'éviter les accidents industriels."
                        },
                        {
                            "text": "La paix durable entre ces pays exige une parfaite <w>observation</w> du traité."
                        }
                    ],
                    "synonyms": [
                        "respect",
                        "observance"
                    ],
                    "common_phrases": [
                        "observation des lois",
                        "observation des règles"
                    ]
                }
            ]
        }
    ]
}