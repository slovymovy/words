                "senses": [
                    {
                        "sense_id": "621dfa57-cc66-3977-a441-5ce9109bf9dc",
                        "entry_id": "42dcdf5f-3478-38b6-afba-3f4250645e20",
                        "glosses": [
                            "Action de rendre hongrois, de donner le caractère magyar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d928f6fd-f65f-4c57-97e6-58acf72dcc9b",
                                "sense_id": "621dfa57-cc66-3977-a441-5ce9109bf9dc",
                                "text": "A partir du Compromis, ils [les révolutionnaires hongrois] ont entrepris à l’égard de leur propres minorités nationales une véritable politique de magyarisation, ce qui a eu pour conséquence d’« exacerber les sentiments nationaux des Slaves de l’Empire »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0a8011a-6ef1-4ccb-926c-1546962a1d93",
                        "source_entry_id": "42dcdf5f-3478-38b6-afba-3f4250645e20",
                        "source_sense_id": "621dfa57-cc66-3977-a441-5ce9109bf9dc",
                        "target_lang_word": "Magyarisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magyarisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c9c0105-8d7d-3628-be97-f4bc073e2e96",
                                        "entry_id": "ecf596dd-5fb7-3b23-bc93-ee47beb3995d",
                                        "glosses": [
                                            "gezielt geförderte Assimilation der nichtungarischen Bevölkerung; Anpassung an ungarische Gegebenheiten und Sitten"
                                        ],
                                        "tags": [
                                            "Frühe Neuzeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6711035-3bb6-4de9-8d1f-98616a4824c5",
                                                "sense_id": "9c9c0105-8d7d-3628-be97-f4bc073e2e96",
                                                "text": "„Die dunkelste Epoche erlebten die Deutschstämmigen in der ersten Hälfte des 20. Jahrhunderts: Erst waren sie gemeinsam mit den Slowaken einer rücksichtslosen Magyarisierung durch die ungarische Krone ausgesetzt […].“"
                                            },
                                            {
                                                "example_id": "e0670451-9a60-4b4d-bcff-a4b0de4d4cea",
                                                "sense_id": "9c9c0105-8d7d-3628-be97-f4bc073e2e96",
                                                "text": "„Zuerst kostete die Magyarisierung des Namens 5 Gulden, später ward die Gebühr auf 50 Kreuzer herabgesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "018378a1-e2e4-4f98-a299-e00e7929cd45",
                        "source_entry_id": "42dcdf5f-3478-38b6-afba-3f4250645e20",
