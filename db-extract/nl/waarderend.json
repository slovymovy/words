        "nl-extract.jsonl": [
            {
                "entry_id": "5fee5a4b-a799-38cc-99b5-a7132535849c",
                "word": "waarderend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f45d8ec4-2c5e-3995-b3a8-344ae3f08e5c",
                        "entry_id": "5fee5a4b-a799-38cc-99b5-a7132535849c",
                        "glosses": [
                            "uiting gevend aan het respect dat iemand heeft voor iemand anders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45563947-7233-4817-940e-05d645ec8c2e",
                                "sense_id": "f45d8ec4-2c5e-3995-b3a8-344ae3f08e5c",
                                "text": "Diederik Samsom bezong onlangs in NRC Handelsblad de schoonheid van het compromis. Hij vond het jammer dat hij de mensen hier niet warm voor had kunnen maken. Het leverde de voormalige PvdA-leider een waarderende tweet op van Han ten Broeke, Twentenaar en prominent VVD-Kamerlid."
                            },
                            {
                                "example_id": "c2b4e0c3-e1d2-4aa5-bb8e-51b43f99fe33",
                                "sense_id": "f45d8ec4-2c5e-3995-b3a8-344ae3f08e5c",
                                "text": "Het gaat om winnen, of je goed of slecht speelt doet er in feite niet toe. Het voelt geweldig, sprak Williams die waarderende woorden overhad voor haar tegenstandster."
                            },
                            {
                                "example_id": "a076e4e5-4051-462f-885a-5735bc47b24d",
                                "sense_id": "f45d8ec4-2c5e-3995-b3a8-344ae3f08e5c",
                                "text": "Ik ontving heel veel waarderende mailtjes en dat is altijd fijn.’’"
                            },
                            {
                                "example_id": "d0e4c49d-8cf3-4b1d-b278-a48b06bf427c",
                                "sense_id": "f45d8ec4-2c5e-3995-b3a8-344ae3f08e5c",
                                "text": "Hij luisterde vriendelijk waarderend, alsof wat ze zei iets was waar hij serieus overna moest denken."
                            }
                        ]
                    }
                ],
