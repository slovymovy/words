                "senses": [
                    {
                        "sense_id": "debfdfdc-1b48-38e9-ba39-6470b7dc27e7",
                        "entry_id": "b0883b14-934c-3ff5-b471-d3dc5cfdcf4d",
                        "glosses": [
                            "rechtsfähige Person oder Einheit; Subjekt, das vor dem Gesetz bindende Handlungen ausführen kann; Eigenschaft/Status eines Individuums oder einer Organisation, Rechtsfähigkeit zu besitzen"
                        ],
                        "tags": [
                            "Rechtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "ca9b20b4-14f6-4294-b138-9469caf64974",
                                "sense_id": "debfdfdc-1b48-38e9-ba39-6470b7dc27e7",
                                "text": "„Mit jener Verordnung soll ein einheitlicher rechtlicher Rahmen geschaffen werden, innerhalb dessen Genossenschaften und andere Rechtspersönlichkeiten und natürliche Personen aus verschiedenen Mitgliedstaaten in der Lage sein sollten, die Neuorganisation ihres Geschäftsbetriebs als Genossenschaft gemeinschaftsweit zu planen und durchzuführen.“"
                            },
                            {
                                "example_id": "19e700be-f63f-4c4a-aed3-40412cf1ec32",
                                "sense_id": "debfdfdc-1b48-38e9-ba39-6470b7dc27e7",
                                "text": "„Eine GmbH ist gem. § 13 Abs. 1 GmbHG eine Vereinigung mit eigener Rechtspersönlichkeit, d. h. eine juristische Person. Sie ist selbst Trägerin von Rechten und Pflichten; sie ist grundbuchfähig, besitzfähig, parteifähig (§ 50 ZPO), prozessfähig (§ 51 ZPO), insolvenzfähig (§§ 11 Abs. 1, 19 Abs. 1 InsO) und deliktsfähig, d. h. sie haftet für unerlaubte Handlungen ihrer Organe.“"
                            },
                            {
                                "example_id": "13ecf3f3-0ef8-4872-a882-454525852c81",
                                "sense_id": "debfdfdc-1b48-38e9-ba39-6470b7dc27e7",
                                "text": "Durch die Anerkennung der Rechtspersönlichkeit eines Vereins erlangt dieser die volle Rechtsfähigkeit."
                            },
                            {
                                "example_id": "0e476cb1-e68b-4eeb-b39f-ad78f75630d6",
                                "sense_id": "debfdfdc-1b48-38e9-ba39-6470b7dc27e7",
                                "text": "Der Verein wurde als Rechtspersönlichkeit anerkannt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
