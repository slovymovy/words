                            },
                            {
                                "target_lang_word": "реорганизовать",
                                "target_lang_sense_clarification": "структурно изменять"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "reviseren",
                                "target_lang_sense_clarification": "van motoren of machines"
                            },
                            {
                                "target_lang_word": "opknappen",
                                "target_lang_sense_clarification": "herstellen of vernieuwen"
                            },
                            {
                                "target_lang_word": "herzien",
