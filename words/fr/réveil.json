    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd7bd11d-7a01-3fb5-a46a-0434e6749a02",
                    "sense_definition": "Appareil d'horlogerie muni d'une sonnerie destiné à réveiller une personne à une heure déterminée.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "appareil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai acheté un nouveau <w>réveil</w> pour ma table de nuit."
                        },
                        {
                            "text": "N'oublie pas de mettre le <w>réveil</w> avant de te coucher."
                        }
                    ],
                    "synonyms": [
                        "réveille-matin"
                    ],
                    "common_phrases": [
                        "mettre le réveil",
                        "sonnerie du réveil"
                    ]
                },
                {
                    "sense_id": "dc579971-08f9-314b-95fa-50130a802c13",
                    "sense_definition": "Fait de cesser de dormir, retour à l'état de veille.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il boit toujours un grand verre d'eau au <w>réveil</w>."
                        },
                        {
                            "text": "Mon <w>réveil</w> a été particulièrement difficile ce matin à cause de la fatigue."
                        }
                    ],
                    "common_phrases": [
                        "au réveil",
                        "réveil difficile"
                    ]
                },
                {
                    "sense_id": "807819ed-279b-3915-9b97-002a4db289a0",
                    "sense_definition": "Prise de conscience soudaine ou regain d'activité intellectuelle, politique ou morale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La défaite électorale a provoqué un <w>réveil</w> brutal des militants du parti."
                        },
                        {
                            "text": "Cette crise économique marque le <w>réveil</w> de la conscience citoyenne dans le pays."
                        }
                    ],
                    "common_phrases": [
                        "réveil brutal"
                    ]
                },
                {
                    "sense_id": "8317b48c-c825-3b67-8947-2a290d816a0b",
                    "sense_definition": "Signal militaire sonore au clairon ou au tambour annonçant l'heure du lever aux troupes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le clairon de la caserne sonnait le <w>réveil</w> dès l'aube pour rassembler les troupes."
                        },
                        {
                            "text": "Les soldats devaient se rassembler dans la cour immédiatement après le <w>réveil</w>."
                        }
                    ],
                    "common_phrases": [
                        "sonner le réveil"
                    ]
                }
            ]
        }
    ]
