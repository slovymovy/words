                    {
                        "form_id": "d179ba5b-9663-4c88-8c1f-deaf7fdcabf7",
                        "entry_id": "235a00ad-d3ae-37f4-8c97-4f487462209a",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "kyoodled"
                    },
                    {
                        "form_id": "66fa076d-d5d6-4809-84fe-a14e7a0bbf9e",
                        "entry_id": "235a00ad-d3ae-37f4-8c97-4f487462209a",
                        "tags": [
                            "past"
                        ],
                        "form": "kyoodled"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0eaef33f-c5c2-3a15-b161-c04fd35154b3",
                        "entry_id": "235a00ad-d3ae-37f4-8c97-4f487462209a",
                        "glosses": [
                            "To make loud noises; to howl or holler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "317ba227-1d36-4031-9c80-ae7318878863",
                                "sense_id": "0eaef33f-c5c2-3a15-b161-c04fd35154b3",
                                "text": "Be known as a booster and crow like a rooster; don't yelp like a bow-wow that's tied to a can; laugh, sing and kyoodle, and blow in some boodle, and help things along like a nice little man."
                            },
                            {
                                "example_id": "7722b460-ec79-4a8a-9ff2-c47225f8544c",
                                "sense_id": "0eaef33f-c5c2-3a15-b161-c04fd35154b3",
                                "text": "And now the drought is broken, let's be joyful in our gains. Let's kyoodle, whoop, and holler for these miliion-dollar rains!"
                            },
                            {
                                "example_id": "4a4303e5-c47e-4bda-847e-fcdebb6b957e",
                                "sense_id": "0eaef33f-c5c2-3a15-b161-c04fd35154b3",
                                "text": "No living thing moved upon it, not even a medicine wolf to kyoodle to the invisible moon."
                            },
                            {
                                "example_id": "fb393b71-de78-4e23-b14e-7d7c6e535149",
                                "sense_id": "0eaef33f-c5c2-3a15-b161-c04fd35154b3",
                                "text": "There were many, he said, \"who unfold their ample jaws and yip and kyoodle about old John and the Cause of freedom,\" who, when faced with the modern struggle for reform, \"pull down their blinds [and] fasten the doors.\""
                            }
                        ]
                    }
                ],
