                ],
                "translations": [
                    {
                        "translation_id": "7612c975-7519-4c95-b31b-b71fa5478db9",
                        "source_entry_id": "c707ba7e-a31e-39fc-9cd3-e0d7a78c9b8b",
                        "source_sense_id": "3bbdb84f-cf63-37ba-aa87-60ed3de76f84",
                        "target_lang_word": "couch potato",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couch potato",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "370d0697-9ff2-3d97-b918-38460f109e5f",
                                        "entry_id": "6edbbf63-2060-38ef-a8ec-3ccb163306db",
                                        "glosses": [
                                            "A person who spends a lot of time sitting or lying down, often watching television, eating snacks or drinking alcohol."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e9002a6-a1db-486c-976f-d2e6a5be48ab",
                                                "sense_id": "370d0697-9ff2-3d97-b918-38460f109e5f",
                                                "text": "Being a couch potato won't let you help achieve your goals."
                                            },
                                            {
                                                "example_id": "cff94a3e-2e73-411e-bbfc-4f6caa7392c9",
                                                "sense_id": "370d0697-9ff2-3d97-b918-38460f109e5f",
                                                "text": "Bah! What lesson can a couch potato father teach his kids!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "143812d0-1146-48e8-b74c-252e489072c3",
                        "source_entry_id": "c707ba7e-a31e-39fc-9cd3-e0d7a78c9b8b",
                        "source_sense_id": "3bbdb84f-cf63-37ba-aa87-60ed3de76f84",
                        "target_lang_word": "Schlafmütze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlafmütze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62a8f12a-2b60-3d9d-b3fb-14b3a4ae2560",
                                        "entry_id": "aded0842-26b8-31d6-bdcd-b8fce87bbdfa",
                                        "glosses": [
                                            "Mütze, wie man sie früher nachts im Bett trug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66672df8-05bd-4247-ba87-548770550574",
                                                "sense_id": "62a8f12a-2b60-3d9d-b3fb-14b3a4ae2560",
                                                "text": "Der „deutsche Michel“ wird immer mit einer Schlafmütze dargestellt."
                                            },
                                            {
                                                "example_id": "ede4bc63-355c-4739-9e80-31f5318ad20d",
                                                "sense_id": "62a8f12a-2b60-3d9d-b3fb-14b3a4ae2560",
                                                "text": "„Sir Evelyn Blood, den Elefantenrücken gegen einen Kissenberg gelehnt, eine viktorianische Schlafmütze auf seinem fast kahlen Schädel, blätterte in einem Magazin mit Fotos von nackten athletischen Männerkörpern und versuchte gleichzeitig ein Gedicht zu machen.“"
                                            },
                                            {
                                                "example_id": "0071dfb2-6e4a-4618-9a7e-c7b7186b8636",
                                                "sense_id": "62a8f12a-2b60-3d9d-b3fb-14b3a4ae2560",
                                                "text": "„Der erste, dem Rostow hier begegnete, war ein kleines, dürres, einarmiges Männchen, das mit Schlafmütze und Spitalkittel, eine kurze Pfeife im Munde, im ersten Zimmer umherwanderte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1314a005-b617-3e54-82b9-56122bd438d0",
                                        "entry_id": "aded0842-26b8-31d6-bdcd-b8fce87bbdfa",
                                        "glosses": [
                                            "schläfriger Mensch, Langschläfer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11109dfe-393a-420c-889a-1c1d1905a903",
                                                "sense_id": "1314a005-b617-3e54-82b9-56122bd438d0",
                                                "text": "He, du alte Schlafmütze, aufwachen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1a10406c-96d9-3cf9-a98d-8842a4f50fd9",
                                        "entry_id": "aded0842-26b8-31d6-bdcd-b8fce87bbdfa",
                                        "glosses": [
                                            "geistig oder körperlich träger, langsamer Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0814f2a4-63dd-44c9-a217-33098f288bb5",
                                                "sense_id": "1a10406c-96d9-3cf9-a98d-8842a4f50fd9",
                                                "text": "Hast du schon wieder vergessen, das Wasser aufzufüllen? Du bist aber auch eine Schlafmütze!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2768b56f-4089-3b09-b2c2-c9c8acdb77b7",
                                        "entry_id": "aded0842-26b8-31d6-bdcd-b8fce87bbdfa",
                                        "glosses": [
                                            "Jargon-Ausdruck für Kronenkorken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b0aadf-1e61-43c9-b1f9-7ad8e977fd85",
                                                "sense_id": "2768b56f-4089-3b09-b2c2-c9c8acdb77b7",
                                                "text": "Mit Hilfe akustischer Signale wird die Schlafmütze zum Schwingen gebracht, um den richtigen Sitz zu überprüfen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecc1b60e-0eb0-4fb5-a6f2-d7103aa5aaef",
                        "source_entry_id": "c707ba7e-a31e-39fc-9cd3-e0d7a78c9b8b",
                        "source_sense_id": "3bbdb84f-cf63-37ba-aa87-60ed3de76f84",
                        "target_lang_word": "avachi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avachi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d25cb47-2e4b-3c0b-9a39-82e3bd7433eb",
                                        "entry_id": "86a81cab-2d49-34ab-96b8-428c45f11ad9",
                                        "glosses": [
                                            "Mou ; sans vigueur ; incapable de faire un effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5464b6f0-42df-4712-becd-520aa73991ac",
                                                "sense_id": "1d25cb47-2e4b-3c0b-9a39-82e3bd7433eb",
                                                "text": "Et au fond du cœur de tous ces misérables soldats, dont les feux sinistres du camp éclairaient les figures amaigries et les dos avachis, une même espérance régnait, l’espérance de la bataille prochaine, c’est-à-dire la fuite, la crosse en l’air et la forteresse allemande."
                                            },
                                            {
                                                "example_id": "abff0924-59bf-4371-a150-9f9a9c62f301",
                                                "sense_id": "1d25cb47-2e4b-3c0b-9a39-82e3bd7433eb",
                                                "text": "Léon-Louis Larose avait d’abord affiché une certitude triomphante. Enfin ! cette nation française avachie dans la paix, la guerre allait lui rendre les grandes vertus humaines de la conquête !"
                                            },
                                            {
                                                "example_id": "17d04531-b0b9-4916-970a-669c0cfa4122",
                                                "sense_id": "1d25cb47-2e4b-3c0b-9a39-82e3bd7433eb",
                                                "text": "Un modèle de bourgeois d’État, comme il devait en exister, quelques années avant la Révolution française, ces bourgeois érudits qui souhaitaient, coûte que coûte, émanciper le pays de sa noblesse avachie et profiteuse."
                                            },
                                            {
                                                "example_id": "6cafa244-17d3-4b91-ad36-c0a23f1fb1e1",
                                                "sense_id": "1d25cb47-2e4b-3c0b-9a39-82e3bd7433eb",
                                                "text": "Poutine nous rappelle, malgré nous, que l’histoire est tragique, et qu’une civilisation avachie et dévitalisée est prête à se laisser dominer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ed9ffe1-d03b-331d-b9fd-70c174fdeab5",
                                        "entry_id": "86a81cab-2d49-34ab-96b8-428c45f11ad9",
                                        "glosses": [
                                            "Déformé, en parlant d'un vêtement ou d'une chaussure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5f48737-9b61-4023-bf2a-ae9080109ef7",
                                                "sense_id": "6ed9ffe1-d03b-331d-b9fd-70c174fdeab5",
                                                "text": "Le visage pourtant n'avait pas dû être sans noblesse, à peu près comme la redingote avachie qui vêtait le malheureux et dont les pans traînaient sur le plancher gras n'avait pas dû être sans élégance."
                                            },
                                            {
                                                "example_id": "66fbf18c-d219-4fee-b057-728bd0bc9e22",
                                                "sense_id": "6ed9ffe1-d03b-331d-b9fd-70c174fdeab5",
                                                "text": "Lui-même chaussa en un tournemain ses vieux croquenots mal cirés, avachis et trop grands, puis enfila son pantalon qui lui pendait disgracieusement par derrière."
                                            },
                                            {
                                                "example_id": "825a1abc-e716-4ffb-a44d-3a7da02aa152",
                                                "sense_id": "6ed9ffe1-d03b-331d-b9fd-70c174fdeab5",
                                                "text": "Non seulement, il ne porte que des sabots ou des espadrilles de toile, comme un contrebandier, mais aussi un éternel pantalon avachi, tout rapetassé au fond et aux genoux, […]."
                                            },
                                            {
                                                "example_id": "d7b6bdd4-0155-4b73-b08c-a8e7b7030c65",
                                                "sense_id": "6ed9ffe1-d03b-331d-b9fd-70c174fdeab5",
                                                "text": "Sortant d’Auchan, un très vieil homme plié en deux, flottant dans un imperméable, avance tout doucement avec une canne en traînant des chaussures avachies. Sa tête tombe sur sa poitrine, je ne vois que son cou. De la main libre, il tient un cabas hors d’âge. Il m’émeut comme un scarabée admirable venu braver les dangers d’un territoire étranger pour rapporter sa nourriture."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "avachi",
                                "target_lang_code": "fr",
                                "target_senses": [
