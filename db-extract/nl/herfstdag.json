                "translations": [
                    {
                        "translation_id": "789c3f23-84cc-429a-9b93-0174fc126eae",
                        "source_entry_id": "7b5eb045-6419-3bdc-9e08-cad71e90ffeb",
                        "source_sense_id": "9246b224-769c-37c1-8f91-ab5f8dff3151",
                        "source_sense_description": "herfstdag",
                        "target_lang_word": "Herbsttag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herbsttag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c506898f-bad4-3d61-b3eb-37f1bb60fbaa",
                                        "entry_id": "6899cb86-b25a-3625-8fae-972b28776a36",
                                        "glosses": [
                                            "Tag im Herbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aa6950f-75f8-4ae3-98b1-b1be24967377",
                                                "sense_id": "c506898f-bad4-3d61-b3eb-37f1bb60fbaa",
                                                "text": "Erwin wurde an einem Herbsttag geboren."
                                            },
                                            {
                                                "example_id": "9a8cbe5c-4864-40d1-935e-1c104b42d60a",
                                                "sense_id": "c506898f-bad4-3d61-b3eb-37f1bb60fbaa",
                                                "text": "Wann ist für euch ein Herbsttag?"
                                            },
                                            {
                                                "example_id": "f94c1205-4f0f-4146-8050-051b699af533",
                                                "sense_id": "c506898f-bad4-3d61-b3eb-37f1bb60fbaa",
                                                "text": "„Ein strahlend sonniger Herbsttag lag dann im Park um das Schloss von Austerlitz.“"
                                            },
                                            {
                                                "example_id": "55e931e9-5ecc-4c22-8610-edc6e8a4c88f",
                                                "sense_id": "c506898f-bad4-3d61-b3eb-37f1bb60fbaa",
                                                "text": "„Es ist der erste Herbsttag in Paris.“"
                                            },
                                            {
                                                "example_id": "e2da5aa6-46f6-4ead-bc44-5f3e3c39e8f7",
                                                "sense_id": "c506898f-bad4-3d61-b3eb-37f1bb60fbaa",
                                                "text": "„Es war ein warmer Herbsttag, die oberen Knöpfe des seidenen Hemdes, das Jottpee trug, waren geöffnet, dort glänzte eine schwere goldene Kette.“"
                                            },
                                            {
                                                "example_id": "2b1f2b1d-3e56-4e2c-8520-c8f79d025f7b",
                                                "sense_id": "c506898f-bad4-3d61-b3eb-37f1bb60fbaa",
                                                "text": "„Er war noch nicht bei der im Bau befindlichen Verschanzung angelangt, als er in der abendlichen Dämmerung des trüben Herbsttages eine Anzahl Reiter auf sich zukommen sah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
