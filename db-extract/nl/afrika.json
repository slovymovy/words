                                    {
                                        "sense_id": "c0ead6a8-0750-36f0-b8be-2a3d7fa74ca4",
                                        "entry_id": "5fa9c53c-60b5-3c94-a49b-c05c18bacbab",
                                        "glosses": [
                                            "Continent situé au sud de l’Europe, à l’ouest de la mer Rouge, et rattaché à l’Asie au nord de l’Égypte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1b4f638-ad6d-40d7-bbd2-9036d23fbcbe",
                                                "sense_id": "c0ead6a8-0750-36f0-b8be-2a3d7fa74ca4",
                                                "text": "Comme exemple des premières : l’Afrique australe séparée par des désert de l’Afrique tropico-équatoriale, a vue se former de nombreux endémiques, […]."
                                            },
                                            {
                                                "example_id": "f375306a-bd2e-4025-b09c-7226efa3741b",
                                                "sense_id": "c0ead6a8-0750-36f0-b8be-2a3d7fa74ca4",
                                                "text": "En Afrique, quand un vieillard meurt, c’est une bibliothèque qui brûle."
                                            },
                                            {
                                                "example_id": "efe570fa-9f22-4892-9b1d-14ae36991a84",
                                                "sense_id": "c0ead6a8-0750-36f0-b8be-2a3d7fa74ca4",
                                                "text": "Ah ! belle Afrique ! Afrique purulente! Afrique à cinquante degrés ! Afrique où farandolent les rires et la faim. Afrique qui suinte et crie ! Afrique rongée et guérie par son soleil…"
                                            },
                                            {
                                                "example_id": "12866c6d-86a7-408a-88b8-d5bf62d0d698",
                                                "sense_id": "c0ead6a8-0750-36f0-b8be-2a3d7fa74ca4",
                                                "text": "Lorsqu'un membre de la jeune administration est critiqué en Europe pour avoir repris le slogan « l'Afrique aux Africains », Kennedy a ce commentaire : « Je ne vois pas à qui d'autre l'Afrique devrait être. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a38855f5-44d0-3e18-9ab4-db2b92d4c502",
                                        "entry_id": "5fa9c53c-60b5-3c94-a49b-c05c18bacbab",
                                        "glosses": [
                                            "Province de l’Empire romain située dans le nord de l’Afrique, la Tunisie et la Libye actuelle, qui donne son nom au continent entier."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
