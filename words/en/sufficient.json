{
    "word_family": [
        "suffice",
        "sufficiency",
        "sufficiently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "68c661c7-063d-33ec-8f8f-96fde262f455",
                    "sense_definition": "Enough for a particular purpose; satisfying a need or requirement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company has <w>sufficient</w> funds to expand its operations next year.",
                            "target_lang_translations": {
                                "ru": "У компании есть <w>достаточные</w> средства для расширения деятельности в следующем году.",
                                "de": "Das Unternehmen verfügt über <w>ausreichende</w> Mittel, um seine Geschäftstätigkeit im nächsten Jahr auszuweiten."
                            }
                        },
                        {
                            "text": "Her explanation was not <w>sufficient</w> to satisfy the teacher's curiosity.",
                            "target_lang_translations": {
                                "ru": "Ее объяснение не было <w>достаточным</w>, чтобы удовлетворить любопытство учителя.",
                                "de": "Ihre Erklärung war nicht <w>ausreichend</w>, um die Neugier des Lehrers zu befriedigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "adequate",
                        "enough"
                    ],
                    "antonyms": [
                        "insufficient"
                    ],
                    "common_phrases": [
                        "sufficient time",
                        "sufficient evidence",
                        "sufficient funds",
                        "sufficient reason"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удовлетворяющий определенной цели или потребности; имеющийся в нужном количестве.",
                        "de": "Genug für einen bestimmten Zweck; ein Bedürfnis oder eine Anforderung erfüllend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достаточный",
                                "target_lang_sense_clarification": "отвечающий требованиям"
                            },
                            {
                                "target_lang_word": "достаточно",
                                "target_lang_sense_clarification": "в значении сказуемого: хватает"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ausreichend",
                                "target_lang_sense_clarification": "genug für einen Zweck"
                            },
                            {
