                "senses": [
                    {
                        "sense_id": "a1065000-083d-39ab-8558-b9ba1a18111e",
                        "entry_id": "93d7d056-3b69-3304-8fee-254c2934171e",
                        "glosses": [
                            "„Hausmeister“ einer österreichischen Schule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58c20a58-d0f2-48b2-be0b-42dbb5bef2a4",
                                "sense_id": "a1065000-083d-39ab-8558-b9ba1a18111e",
                                "text": "„Wohnungen für den Schulleiter und die Lehrer sowie für den Schulwart können inner- oder außerhalb des Schulgebäudes vorgesehen werden.“"
                            },
                            {
                                "example_id": "da4fed6d-76f2-4afc-a004-f21d39a60b72",
                                "sense_id": "a1065000-083d-39ab-8558-b9ba1a18111e",
                                "text": "„Das Aufgabengebiet eines leitenden Schulwartes werde in der Dienstanweisung für Schulwarte, zuletzt wiederverlautbart mit Rundschreiben 40/1993, Zl. 466/11-III/11/93, geregelt.“"
                            },
                            {
                                "example_id": "66ac7205-3831-4e1b-8a3a-cff6336818fb",
                                "sense_id": "a1065000-083d-39ab-8558-b9ba1a18111e",
                                "text": "„Herr Szabo ist Schulwart in der Volksschule Oberwart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
