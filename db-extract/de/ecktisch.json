                ],
                "senses": [
                    {
                        "sense_id": "306ef24e-06c7-3cb5-94ea-73043bf2370b",
                        "entry_id": "61c07a72-2e53-3b29-94f2-79be5b8a993a",
                        "glosses": [
                            "Tisch, der in der Ecke eines Raumes steht (zum Beispiel in einem Lokal oder in der Wohnung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdb4963c-a780-41e9-a6ef-3fca25d32420",
                                "sense_id": "306ef24e-06c7-3cb5-94ea-73043bf2370b",
                                "text": "„Auf einen Ecktisch stellt Natalie ihre Hochzeitsbilder, die wie Buchumschläge in einem Doppelrahmen stehen.“"
                            },
                            {
                                "example_id": "29a6d3b1-ad9a-4a56-a523-b3a2189f38b4",
                                "sense_id": "306ef24e-06c7-3cb5-94ea-73043bf2370b",
                                "text": "„Wir gehen über weißen Kachelboden, der matt das Licht der Neonleuchten reflektiert, und nehmen an einem Ecktisch am anderen Ende des Raumes Platz.“"
                            },
                            {
                                "example_id": "b0392d9e-0d69-4818-b877-c6f8d38d21c4",
                                "sense_id": "306ef24e-06c7-3cb5-94ea-73043bf2370b",
                                "text": "„Sie bekamen einen Ecktisch in der Nähe der Tür.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b050adb8-621c-352f-aa55-a7b1a8b2da1c",
                        "entry_id": "61c07a72-2e53-3b29-94f2-79be5b8a993a",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "87f76ca1-be7c-4464-8065-8b0143c6168a",
                                "sense_id": "b050adb8-621c-352f-aa55-a7b1a8b2da1c",
                                "text": "„Es waren noch andere Gäste da gewesen, und er hatte sich an einen Ecktisch gesetzt und einen Rotwein getrunken.“"
                            }
                        ],
                        "sense_index_json": "\"11\""
                    }
