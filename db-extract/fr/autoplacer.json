                        "sense_id": "4a151083-9d74-343e-9591-5a43c5b3e8b2",
                        "entry_id": "156fb38d-4ff9-3364-a0be-02acbcccc338",
                        "glosses": [
                            "Faire se placer tout seul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7db7aa21-a4be-475a-9fd1-4c119d94b23d",
                                "sense_id": "4a151083-9d74-343e-9591-5a43c5b3e8b2",
                                "text": "Vous pouvez autoplacer des groupes définies du composant p. ex. seulement ceux du page de schéma 2 ou ceux qui sont rassemblés comme un module."
                            }
                        ]
                    },
                    {
                        "sense_id": "92fdbaca-ed66-35b5-9270-ee227e8211ca",
                        "entry_id": "156fb38d-4ff9-3364-a0be-02acbcccc338",
                        "glosses": [
                            "Se placer soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
