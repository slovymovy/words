                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2275eec9-01f6-31aa-b88a-dbd68a73044b",
                                        "entry_id": "5c267dda-a108-39e9-9a06-9ceaa6590520",
