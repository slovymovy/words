                        "glosses": [
                            "Of or relating to Friedrich Fröbel (or Froebel; 1782–1852), German pedagogue who laid the foundation for modern education based on the recognition that children have unique needs and capabilities."
                        ],
                        "tags": [],
                        "examples": [
                            {
