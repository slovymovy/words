                        "source_sense_description": "het geheel van masten en de verstaging van traditionele zeilschepen",
                        "target_lang_word": "agrès",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agrès",
