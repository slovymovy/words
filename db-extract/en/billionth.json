                                            {
                                                "example_id": "251f4b9e-5bfe-4799-8108-8d4ae07b9030",
                                                "sense_id": "d5ebca90-9aab-3fcf-aea9-c420babc7bb2",
                                                "text": "Le milliardième indien est né officiellement le 11 mai 2000, avec la naissance d’une petite fille prénommée Astha."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "milliardième",
