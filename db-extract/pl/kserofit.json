                                "target_senses": [
                                    {
                                        "sense_id": "7e90bf65-b699-3008-b2cb-ffc3d69c8546",
                                        "entry_id": "7a0d7a41-0fe8-3fae-aa8e-c9d0ed018c96",
                                        "glosses": [
                                            "Plante adaptée aux milieux secs tel que les Cactaceae, les Agavaceae ou les Euphorbiaceae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "276634d1-e5b8-4069-a99c-c8e1374011b0",
                                                "sense_id": "7e90bf65-b699-3008-b2cb-ffc3d69c8546",
                                                "text": "L’eau se perd dans les sables et les gouttes de rosée s’évaporent aussi vite qu’elles tombent des rares feuilles sèches des xérophytes."
                                            },
                                            {
                                                "example_id": "100543a5-8b1c-4416-a7bc-237b88170ac3",
                                                "sense_id": "7e90bf65-b699-3008-b2cb-ffc3d69c8546",
                                                "text": "Chez les xérophytes les racines sont très longues, attirées par l’humidité et la fraîcheur du sous-sol, et peuvent constituer jusqu’à 80 % de la biomasse."
                                            },
                                            {
                                                "example_id": "f0f41382-91fd-420c-8aa7-bf2410067d17",
                                                "sense_id": "7e90bf65-b699-3008-b2cb-ffc3d69c8546",
                                                "text": "Plus au sud, le tapis herbacé est de plus en plus discontinu et seuls les végétaux du désert, avec leur physionomie de xérophytes épineux ou de plantes en coussinets, résistent."
                                            }
                                        ]
                                    }
