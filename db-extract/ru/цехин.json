                                "target_senses": [
                                    {
                                        "sense_id": "a432ffdf-117a-349a-ad56-255df0e9e4ff",
                                        "entry_id": "471d7f4b-2e50-3dd7-9e51-b2fe44c7e42a",
                                        "glosses": [
                                            "Any of various gold coins produced in Italy or Turkey; a sequin."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655eb41c-28dc-48ce-a9e8-f31b1f4dbc41",
                                                "sense_id": "a432ffdf-117a-349a-ad56-255df0e9e4ff",
                                                "text": "[…] the noble armour, that was worth so many zecchins to Joseph Pareira, the armourer of Milan, besides seventy in the hundred of profits, he cares for it as little as if he had found it in the highways!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45526c7f-3691-4229-bae0-7882f85ee7d0",
                        "source_entry_id": "e6df74c5-006f-3987-aa92-d8bd2de44b6e",
                        "source_sense_id": "80d60550-bf77-3445-8a28-680513a79d56",
