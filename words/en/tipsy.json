{
    "word_family": [
        "tip",
        "tipsily",
        "tipsiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "05c8326d-9995-3342-b745-a43e35a02e7f",
                    "sense_definition": "Slightly drunk and unsteady or foolish as a result of drinking alcohol.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intoxicated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After only two glasses of wine, she started feeling a bit <w>tipsy</w>.",
                            "target_lang_translations": {
                                "es": "Después de solo dos copas de vino, empezó a sentirse un poco <w>achispada</w>."
                            }
                        },
                        {
                            "text": "He laughed loudly and spoke too much because he was slightly <w>tipsy</w>.",
                            "target_lang_translations": {
                                "es": "Se reía a carcajadas y hablaba demasiado porque estaba ligeramente <w>achispado</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "buzzed",
                        "merry",
                        "squiffy"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "common_phrases": [
                        "feel tipsy",
                        "a bit tipsy",
                        "slightly tipsy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used in informal conversation"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Ligeramente ebrio o alegre y algo inestable debido al consumo de alcohol."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "achispado",
                                "target_lang_sense_clarification": "ligeramente ebrio, alegre por el alcohol"
                            },
                            {
                                "target_lang_word": "piripi",
                                "target_lang_sense_clarification": "coloquial, alegre o mareado por la bebida"
                            },
                            {
                                "target_lang_word": "entonado",
                                "target_lang_sense_clarification": "que ha bebido un poco y se siente alegre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "681657da-cbd0-36b4-818d-f02ba7267512",
                    "sense_definition": "Unsteady, wobbly, or tilted to one side.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unsteady",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small wooden table had a <w>tipsy</w> leg that shook whenever someone leaned on it.",
                            "target_lang_translations": {
                                "es": "La mesita de madera tenía una pata <w>tambaleante</w> que temblaba cada vez que alguien se apoyaba en ella."
                            }
                        },
                        {
                            "text": "He tried to carry the <w>tipsy</w> tower of boxes across the room without dropping anything.",
                            "target_lang_translations": {
                                "es": "Intentó cruzar la habitación con la <w>inestable</w> torre de cajas sin que se cayera nada."
                            }
                        }
                    ],
                    "synonyms": [
                        "askew",
                        "off-kilter",
                        "precarious",
                        "rickety",
                        "tottering",
                        "wobbly"
                    ],
                    "antonyms": [
                        "stable",
                        "steady"
                    ],
                    "target_lang_definitions": {
                        "es": "Inestable, tambaleante o inclinado hacia un lado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tambaleante",
                                "target_lang_sense_clarification": "que se mueve de un lado a otro sin estabilidad"
                            },
                            {
                                "target_lang_word": "inestable",
                                "target_lang_sense_clarification": "que no tiene firmeza o equilibrio"
                            },
                            {
                                "target_lang_word": "torcido",
                                "target_lang_sense_clarification": "inclinado hacia un lado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d44a47f-354d-3494-ac59-5d92eb77e8e2",
                    "sense_definition": "Flavored with or containing alcohol, especially of food or desserts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intoxicated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prepared a <w>tipsy</w> cake soaked in sweet sherry for the holiday dinner.",
                            "target_lang_translations": {
                                "es": "Preparó un bizcocho <w>borracho</w> bañado en jerez dulce para la cena de fiestas."
                            }
                        },
                        {
                            "text": "The menu featured a traditional <w>tipsy</w> pudding filled with raisins and rum.",
                            "target_lang_translations": {
                                "es": "El menú incluía un tradicional pudín <w>borracho</w> relleno de pasas y ron."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tipsy cake",
                        "tipsy pudding"
                    ],
                    "target_lang_definitions": {
                        "es": "Borracho o empapado en licor, especialmente referido a postres o comidas con alcohol."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "borracho",
                                "target_lang_sense_clarification": "empapado o bañado en licor, referido a postres"
                            },
                            {
                                "target_lang_word": "alcohólico",
                                "target_lang_sense_clarification": "que contiene alcohol"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}