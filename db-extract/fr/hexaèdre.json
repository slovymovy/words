            {
                "entry_id": "4734ec4d-f0c0-38ec-a7e9-8edf2bb02e75",
                "word": "hexaèdre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "18d3f9dc-6948-41f6-a636-462e3f776797",
                        "entry_id": "4734ec4d-f0c0-38ec-a7e9-8edf2bb02e75",
                        "tags": [
                            "plural"
                        ],
                        "form": "hexaèdres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af9676c3-a9d7-31ea-8253-417c46326a28",
                        "entry_id": "4734ec4d-f0c0-38ec-a7e9-8edf2bb02e75",
                        "glosses": [
                            "Polyèdre à six faces, pouvant être régulier comme le cube, ou semi-régulier comme, par exemple, la pyramide à base pentagonale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28272e36-f435-4711-b406-3fb8a9637e39",
                                "sense_id": "af9676c3-a9d7-31ea-8253-417c46326a28",
                                "text": "Un dé à jouer est un hexaèdre."
                            },
                            {
                                "example_id": "294ef05e-2998-414e-a282-9543bd87d947",
                                "sense_id": "af9676c3-a9d7-31ea-8253-417c46326a28",
                                "text": "Je jouissais tranquillement des pirouettes fantastiques de la lumière sur les cristaux de glace suspendus à une hauteur infinie dans l’atmosphère, ou sur les hexaèdres microscopiques de la neige."
                            },
                            {
                                "example_id": "0f88b647-d3b9-46e4-baea-77ca4f369489",
                                "sense_id": "af9676c3-a9d7-31ea-8253-417c46326a28",
                                "text": "Alors que le nez est simplement indiqué par une planchette étroite, deux cylindres saillants d’environ huit centimètres forment les deux yeux, un hexaèdre, un peu plus bas, la bouche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "497f4690-cc18-4485-b0b0-8910da5f764a",
                        "source_entry_id": "4734ec4d-f0c0-38ec-a7e9-8edf2bb02e75",
                        "source_sense_id": "af9676c3-a9d7-31ea-8253-417c46326a28",
                        "source_sense_description": "Polyèdre à six faces (1) :",
                        "target_lang_word": "Hexaeder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hexaeder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce0916ab-a016-395e-8d4f-fdc17a3e2c9c",
                                        "entry_id": "740e56ea-71c2-3c74-a301-420c044c2c37",
                                        "glosses": [
                                            "Mathematik, Geometrie: dreidimensionales Polyeder, das von sechs Flächen begrenzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b5a36a-b84a-451b-b76e-7c62981a7365",
                                                "sense_id": "ce0916ab-a016-395e-8d4f-fdc17a3e2c9c",
                                                "text": "Man kann die geometrische Form des Hexaeders in der Struktur von Kristallen wiederfinden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf4e4571-6625-3901-9830-3cedef9a7077",
                                        "entry_id": "740e56ea-71c2-3c74-a301-420c044c2c37",
                                        "glosses": [
                                            "Mathematik, Geometrie, speziell: regelmäßiges Hexaeder [1], mit sechs (kongruenten) Quadraten als Begrenzungsflächen, zwölf (gleichlangen) Kanten und acht Ecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f7a1d4f-3546-4263-9e2b-ad80ff967e76",
                                                "sense_id": "bf4e4571-6625-3901-9830-3cedef9a7077",
                                                "text": "Der Hexaeder ist dual zum Oktaeder."
                                            },
                                            {
                                                "example_id": "16062b78-5e46-4674-bdc0-2f28eea96c05",
                                                "sense_id": "bf4e4571-6625-3901-9830-3cedef9a7077",
                                                "text": "„Dass auch dem Hexaeder eine Kugel ein- und umgeschrieben werden könne, ergiebt sich auf folgende Art.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
