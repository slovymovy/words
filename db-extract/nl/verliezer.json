                                                "sense_id": "e19284c8-1235-3525-8609-0eed082b9597",
                                                "text": "« On y est presque ! Plus que dix mille bornes… se moqua-t-il. Le premier à la porte aura droit à un baiser de la part du perdant ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93f5a9d7-aba7-32d7-9c36-82809c6c9d56",
                                        "entry_id": "94f2428a-7364-3203-98ab-765fba02d961",
                                        "glosses": [
                                            "Celui qui perd au jeu ou dans un sport."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab0acf3e-3f3b-4814-a57f-a84dba1f72f5",
                                                "sense_id": "93f5a9d7-aba7-32d7-9c36-82809c6c9d56",
                                                "text": "Vainqueur-né, Roger Federer part en perdant magnifique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "perdant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f203a235-8299-3b23-812f-8a4b3f1ad8e9",
