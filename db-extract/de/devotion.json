                            "singular"
                        ],
                        "form": "die Devotion"
                    },
                    {
                        "form_id": "3115e094-ed6f-44a7-a5c4-c4088eb68640",
                        "entry_id": "b426ea8b-b1a6-3d78-9a86-9874cca0c4d5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Devotionen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ebd6408-b0c0-32a1-8fc9-b4080c07c766",
                        "entry_id": "b426ea8b-b1a6-3d78-9a86-9874cca0c4d5",
                        "glosses": [
                            "unterwürfiges Verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df271f78-2ca1-42e7-b2c6-684cb20abcdb",
                                "sense_id": "2ebd6408-b0c0-32a1-8fc9-b4080c07c766",
                                "text": "„Flamininus genoss in vollen Zügen die ihm in hellenistischer Manier entgegengebrachte kultische Devotion.“"
                            },
                            {
                                "example_id": "a800b072-3b77-439c-810a-f8a7212d75b8",
                                "sense_id": "2ebd6408-b0c0-32a1-8fc9-b4080c07c766",
                                "text": "„Nur einer der Gäste, der, über seine Zeitung fort, von der anderen Seite des Balkons her das distinguierte Paar schon seit lange beobachtet hatte, stand auf, legte die Zeitung aus der Hand und grüßte mit besonderer Devotion, was seines Eindrucks auf die schöne Frau nicht verfehlte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "174ab0a0-cab5-3768-8f9a-413b7f424865",
                        "entry_id": "b426ea8b-b1a6-3d78-9a86-9874cca0c4d5",
                        "glosses": [
                            "Demut, Frömmigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5091cc1-7a90-4344-8203-8c2ead39511e",
                                "sense_id": "174ab0a0-cab5-3768-8f9a-413b7f424865",
                                "text": "„Man nennt uns Pfaffen, Fanatiker, Intolerante, Ultraclericale, Ultramontane, Gesindel, Bettelpartei c. und wir sollen in voller Devotion diese zarten Complimente hinnehmen?“ (1869)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "54e3a677-c77d-30cd-aa19-34422701e574",
                        "entry_id": "b426ea8b-b1a6-3d78-9a86-9874cca0c4d5",
                        "glosses": [
                            "Verbannung"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c762bee0-e03a-4438-b4f0-a02863f482fd",
                                "sense_id": "54e3a677-c77d-30cd-aa19-34422701e574",
                                "text": "„Wie einleuchtend letzteres an sich auch zu sein scheint, es ergeben sich Probleme daraus, daß der geographische Anwendungsbereich der evocatio begrenzter war als der des anderen Ritus, daß mithin Devotionen auch ohne vorhergehende Evokation vorkommen mußten und nach Macrobius tatsächlich auch vorkamen.“"
                            },
                            {
                                "example_id": "a3f6cdfb-db2b-4198-ade7-f8c6ce577739",
                                "sense_id": "54e3a677-c77d-30cd-aa19-34422701e574",
                                "text": "„Mit der Devotion stand die Erecration feindlicher Staaten, Städte, Heere oder einzelner Personen, über die die Priester Verwünschungen aussprachen, und die Evocation oder die Auffoderung an den Schutzgott einer Stadt, dieselbe zu verlassen und überzugehen, in Verbindung.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cde1783-6c59-4388-a384-67718a60bc4c",
                        "source_entry_id": "b426ea8b-b1a6-3d78-9a86-9874cca0c4d5",
                        "source_sense_id": "2ebd6408-b0c0-32a1-8fc9-b4080c07c766",
