                "senses": [
                    {
                        "sense_id": "923143a9-0680-3042-a1ce-b6cb21071802",
                        "entry_id": "a1e80618-36b3-3fb6-a801-17b9b03cf3e7",
                        "glosses": [
                            "Relatif au tennis, à sa pratique."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a88e6198-793b-42d1-b456-a602f8eb8d32",
                                "sense_id": "923143a9-0680-3042-a1ce-b6cb21071802",
                                "text": "L’actualité tennistique."
                            },
                            {
                                "example_id": "98dcdcbe-3651-4800-957e-5db2e7dadb48",
                                "sense_id": "923143a9-0680-3042-a1ce-b6cb21071802",
                                "text": "Sans parler davantage des avatars du vocabulaire tennistique, on ne saurait sous-estimer l'influence du sport dans la politique."
                            },
                            {
                                "example_id": "847ba3a2-aac8-4c5d-8b83-1f3ed1a56e61",
                                "sense_id": "923143a9-0680-3042-a1ce-b6cb21071802",
                                "text": "[…] le rédac chef avait parlé d’un reportage à Agen, pour suivre au championnat de France juniors la gloire tennistique locale."
                            },
                            {
                                "example_id": "3259418c-bc34-4963-a349-609892dd817e",
                                "sense_id": "923143a9-0680-3042-a1ce-b6cb21071802",
                                "text": "Car, en choisissant de dénoncer la supposée partialité des juges tout en annonçant son intention de déférer à leur convocation, François Fillon n’a pas seulement pris le risque d’apparaître contradictoire. Pour emprunter au vocabulaire tennistique, il a surtout donné le sentiment de commettre une « double faute » à un moment-clé."
                            }
                        ]
                    }
