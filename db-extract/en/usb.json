        "de-extract.jsonl": [
            {
                "entry_id": "f739e9f5-125e-3b1a-a5d0-d4dec2199db6",
                "word": "USB",
                "pos": "abbrev",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "34cf4eb7-4c0e-3027-819e-1877c542b844",
                        "entry_id": "f739e9f5-125e-3b1a-a5d0-d4dec2199db6",
                        "glosses": [
                            "Abkürzung für Universal Serial Bus, Universal Serial Bus bzw. universal serial bus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e8001eb-45c5-4d61-adf0-4912f0d8df9f",
                                "sense_id": "34cf4eb7-4c0e-3027-819e-1877c542b844",
                                "text": "„The Universal Serial Bus, more commonly known as USB, is a relatively new system for attaching keyboards, mice, printers, scanners, microphones, and lots of other kinds of devices to desktop and laptop computers.“",
                                "translation": "„Der universelle serielle Bus, besser als USB bekannt, ist ein relativ neues System zum Anschluss von Tastaturen, Mäusen, Druckern, Scannern, Mikrofonen und vielen anderen Gerätearten an einen Schreibtischcomputer oder Laptop.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "abcf2916-df9b-3a08-84d0-b7396d15af2a",
                        "entry_id": "f739e9f5-125e-3b1a-a5d0-d4dec2199db6",
                        "glosses": [
                            "Abkürzung für upper sideband"
                        ],
                        "tags": [
                            "Funktechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "aa83f264-8fdc-4481-82e1-ca538f751627",
                                "sense_id": "abcf2916-df9b-3a08-84d0-b7396d15af2a",
                                "text": "„In amateur radio, LSB is traditionally used below 10 MHz and USB is used above 10 MHz.“",
                                "translation": "„Im Amateurfunk wird für Frequenzen unterhalb 10 MHz traditionell das untere Seitenband und oberhalb 10 MHz OSB (das obere Seitenband) benutzt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b77ed97d-60bf-428c-a62d-a7d7e4182a4d",
                        "source_entry_id": "f739e9f5-125e-3b1a-a5d0-d4dec2199db6",
                        "source_sense_id": "34cf4eb7-4c0e-3027-819e-1877c542b844",
                        "source_sense_description": "Abkürzung für Universal Serial Bus",
                        "target_lang_word": "USB",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "USB",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05976259-6815-34d3-ab07-ee449cf3669c",
                                        "entry_id": "a1dcfdfc-c4bf-3a35-8650-18add1710b8d",
                                        "glosses": [
                                            "Standardisierte Schnittstelle zum Anschluss peripherer Geräte, wie Drucker, Tastatur, Maus, Massenspeicher usw., an einen Computer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b3ea842-f5ac-46e7-983a-8c709950360e",
                                                "sense_id": "05976259-6815-34d3-ab07-ee449cf3669c",
                                                "text": "„Über USB können heute zahlreiche Gerätetypen angeschlossen werden, die vor der USB-Einführung über eine größere Zahl verschiedener Schnittstellentypen angebunden wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d61a0bb-86c7-4fdc-acfa-28ca3d5aa892",
                        "source_entry_id": "f739e9f5-125e-3b1a-a5d0-d4dec2199db6",
                        "source_sense_id": "34cf4eb7-4c0e-3027-819e-1877c542b844",
                        "source_sense_description": "Abkürzung für Universal Serial Bus",
                        "target_lang_word": "USB",
