{
    "word_family": [
        "ряд",
        "рядовой",
        "рядышком"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c4b7aa38-0bc0-32e1-b21b-5d7332a31d13",
                    "sense_definition": "На небольшом расстоянии, вблизи, неподалёку.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя школа находится совсем <w>рядом</w> с домом.",
                            "target_lang_translations": {
                                "en": "My school is located very <w>close</w> to home.",
                                "zh": "我的学校就在家<w>附近</w>。"
                            }
                        },
                        {
                            "text": "Пожалуйста, сядь <w>рядом</w> и послушай меня внимательно.",
                            "target_lang_translations": {
                                "en": "Please sit <w>nearby</w> and listen to me carefully.",
                                "zh": "请坐到<w>旁边</w>，仔细听我说。"
                            }
                        }
                    ],
                    "synonyms": [
                        "близко",
                        "поблизости",
                        "неподалёку"
                    ],
                    "antonyms": [
                        "далеко"
                    ],
                    "common_phrases": [
                        "рядом с домом",
                        "совсем рядом",
                        "стоять рядом"
                    ],
                    "target_lang_definitions": {
                        "en": "At a short distance; close by or not far away.",
                        "zh": "在很近的距离内，不远的地方。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nearby",
                                "target_lang_sense_clarification": "adverb - close in position"
                            },
                            {
                                "target_lang_word": "next to",
                                "target_lang_sense_clarification": "preposition - adjacent to something or someone"
                            },
                            {
                                "target_lang_word": "close by",
                                "target_lang_sense_clarification": "adverb - in the immediate vicinity"
                            },
                            {
                                "target_lang_word": "beside",
                                "target_lang_sense_clarification": "preposition - at the side of"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附近",
                                "target_lang_sense_clarification": "副词 - 在不远的地方"
                            },
                            {
                                "target_lang_word": "旁边",
                                "target_lang_sense_clarification": "方位词 - 在侧面或附近"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da45d383-6614-30a6-b3ad-37324abfa275",
                    "sense_definition": "Бок о бок, непосредственно друг возле друга (о людях или предметах, расположенных вместе).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они шли <w>рядом</w> по улице и держались за руки.",
                            "target_lang_translations": {
                                "en": "They walked <w>side by side</w> down the street and held hands.",
                                "zh": "他们<w>并排</w>走在街上，手牵着手。"
                            }
                        },
                        {
                            "text": "На фотографии мы стоим <w>рядом</w> с известным актёром.",
                            "target_lang_translations": {
                                "en": "In the photo, we are standing <w>next to</w> a famous actor.",
                                "zh": "照片里我们正<w>挨着</w>一位著名演员站着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "бок о бок",
                        "близко"
                    ],
                    "antonyms": [
                        "поодаль"
                    ],
                    "common_phrases": [
                        "идти рядом",
                        "сидеть рядом",
                        "быть рядом"
                    ],
                    "target_lang_definitions": {
                        "en": "Side by side; positioned directly next to each other.",
                        "zh": "并排，紧挨着彼此（指人或物的位置）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "side by side",
                                "target_lang_sense_clarification": "phrase - close together and facing the same way"
                            },
                            {
                                "target_lang_word": "alongside",
                                "target_lang_sense_clarification": "preposition/adverb - close to the side of"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "并排",
                                "target_lang_sense_clarification": "副词 - 紧挨着排列"
                            },
                            {
                                "target_lang_word": "挨着",
                                "target_lang_sense_clarification": "动词 - 紧靠着"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10dcf74b-abe0-3d0c-95ed-2f60fcf43f2d",
                    "sense_definition": "Команда собаке идти у ноги хозяина.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хозяин громко скомандовал «<w>Рядом</w>!», и пёс сразу подошёл.",
                            "target_lang_translations": {
                                "en": "The owner loudly commanded \"<w>Heel</w>!\", and the dog approached immediately.",
                                "zh": "主人大声发出“<w>靠拢</w>！”的指令，狗立刻走了过来。"
                            }
                        },
                        {
                            "text": "Обучение команде «<w>рядом</w>» требует от владельца собаки терпения.",
                            "target_lang_translations": {
                                "en": "Training the \"<w>heel</w>\" command requires patience from the dog owner.",
                                "zh": "训练狗听从“<w>靠拢</w>”指令需要主人有耐心。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "команда рядом"
                    ],
                    "target_lang_definitions": {
                        "en": "A command given to a dog to walk close to the owner's leg.",
                        "zh": "训练狗紧随主人行走的指令。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "heel",
                                "target_lang_sense_clarification": "command - for a dog to walk by the owner's side"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "靠拢",
                                "target_lang_sense_clarification": "动词 - 狗的服从指令"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6cfefe5-80f8-3f13-a92e-beda1b761a80",
                    "sense_definition": "Творительный падеж единственного числа существительного <w>ряд</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы ошиблись <w>рядом</w> и сели на чужие места в театре.",
                            "target_lang_translations": {
                                "en": "We got the <w>row</w> wrong and sat in other people's seats in the theater.",
                                "zh": "我们在剧院弄错了<w>排</w>，坐到了别人的位子上。"
                            }
                        },
                        {
                            "text": "За этим длинным <w>рядом</w> домов начинается лес.",
                            "target_lang_translations": {
                                "en": "Behind this long <w>row</w> of houses, the forest begins.",
                                "zh": "在那一长<w>排</w>房子后面就是森林。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "noun form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The instrumental case form of the noun 'row' (ряд).",
                        "zh": "名词“排”的工具格形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "row",
                                "target_lang_sense_clarification": "noun - a line of things or people"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排",
                                "target_lang_sense_clarification": "名词 - 一列人或物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
