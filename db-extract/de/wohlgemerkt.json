                    },
                    {
                        "translation_id": "144af45e-594e-4cf1-884a-370ef457fa55",
                        "source_entry_id": "c0fc2ef2-6544-3d89-8e6d-726ae3964dd5",
                        "source_sense_id": "960ba7a9-5ed9-3d8e-b12e-c363b4822b17",
                        "source_sense_description": "betonender oder verstärkender Hinweis: man beachte",
                        "target_lang_word": "mind you",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mind you",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d968bdcd-7516-374d-bfe6-ead8cfbeaf47",
                                        "entry_id": "d0fc419f-5b8b-3e32-a247-7d35b7fa4e2f",
                                        "glosses": [
                                            "Used to introduce a qualification or contrastive statement, especially when toning down or rectifying"
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "510ace12-5dfc-45c2-a81e-31c2556e8129",
                                                "sense_id": "d968bdcd-7516-374d-bfe6-ead8cfbeaf47",
                                                "text": "These shirts are very expensive. Mind you, they are excellent quality."
                                            },
                                            {
                                                "example_id": "5a39686c-c1e9-4f21-86a3-104a97336285",
                                                "sense_id": "d968bdcd-7516-374d-bfe6-ead8cfbeaf47",
                                                "text": "Mind you, it was not an outing I would recommend as relaxing."
                                            },
                                            {
                                                "example_id": "f60068df-c0ff-4109-9622-2e37fa490f3f",
                                                "sense_id": "d968bdcd-7516-374d-bfe6-ead8cfbeaf47",
                                                "text": "Mind you, clothes were clothes in those days. There was a great deal of them, lavish both in material and in workmanship."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3bcea6c-d5cc-4b32-8e97-46f0359834b4",
                        "source_entry_id": "c0fc2ef2-6544-3d89-8e6d-726ae3964dd5",
                        "source_sense_id": "960ba7a9-5ed9-3d8e-b12e-c363b4822b17",
                        "source_sense_description": "betonender oder verstärkender Hinweis: man beachte",
                        "target_lang_word": "évidemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évidemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86a100c1-06d8-3eb7-ac3f-398e2c56a4ac",
                                        "entry_id": "fc7e787a-9bd1-3a6d-9d9f-460fe8f6df17",
                                        "glosses": [
                                            "D’une manière évidente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7542dfaf-8dbc-4715-a197-de21750b07f1",
                                                "sense_id": "86a100c1-06d8-3eb7-ac3f-398e2c56a4ac",
                                                "text": "Et il s’abîma en des recherches mentales, évidemment compliquées et très pénibles, s’il fallait en juger par les diverses grimaces qui se succédèrent sur son visage, […]."
                                            },
                                            {
                                                "example_id": "983f1358-f846-4882-a295-d98200f0489e",
                                                "sense_id": "86a100c1-06d8-3eb7-ac3f-398e2c56a4ac",
                                                "text": "L'abondante littérature idyllique des professeurs de rhétorique est évidem­ment une pure vanité."
                                            },
                                            {
                                                "example_id": "a9f6a998-cb59-43f3-8188-d3ec3418c60a",
                                                "sense_id": "86a100c1-06d8-3eb7-ac3f-398e2c56a4ac",
                                                "text": "De cela même que je pensais à douter de la vérité des autres choses, il suivait très évidemment et très certainement que j’étais."
                                            },
                                            {
                                                "example_id": "70786bc1-4541-4e73-8223-6a52097a4048",
                                                "sense_id": "86a100c1-06d8-3eb7-ac3f-398e2c56a4ac",
                                                "text": "Les uns veulent toujours croire aveuglément, les autres veulent toujours voir évidemment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a9c2024-e2bc-3959-9346-29ab7a244819",
                                        "entry_id": "fc7e787a-9bd1-3a6d-9d9f-460fe8f6df17",
                                        "glosses": [
                                            "Il est certain que… ; indiscutablement."
                                        ],
                                        "tags": [],
                                        "note": "Dans cette acception, il se met au commencement de la phrase",
                                        "examples": [
                                            {
                                                "example_id": "edb89f9f-f9cd-44f2-9170-d0b99d707b51",
                                                "sense_id": "9a9c2024-e2bc-3959-9346-29ab7a244819",
                                                "text": "Évidemment il a prouvé ce qu’il voulait démontrer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9ef0bf3-6617-494d-abe5-45b6b2fcf1d1",
                        "source_entry_id": "c0fc2ef2-6544-3d89-8e6d-726ae3964dd5",
                        "source_sense_id": "960ba7a9-5ed9-3d8e-b12e-c363b4822b17",
                        "source_sense_description": "betonender oder verstärkender Hinweis: man beachte",
                        "target_lang_word": "bien sûr",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bien sûr",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "089ed2ad-90c3-313e-bdc4-6feca814aac4",
                                        "entry_id": "6bc072f2-d9b5-30ba-ac49-7b5a86877329",
                                        "glosses": [
                                            "Évidemment ; avec évidence ; certainement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f0578c8-c239-4b44-9367-8c9ad27abd00",
                                                "sense_id": "089ed2ad-90c3-313e-bdc4-6feca814aac4",
                                                "text": "— Je pourrais peut-être vous donner un coup de main pour les travaux. Si ça vous dit, bien sûr, ajouta-t-il d’un ton bourru."
                                            },
                                            {
                                                "example_id": "4fdf2f22-dd38-4db0-b80f-a4928691c419",
                                                "sense_id": "089ed2ad-90c3-313e-bdc4-6feca814aac4",
                                                "text": "L’homme s’essuie soigneusement la bouche sur une serviette, […].\n— D’Indiens ? Vous venez d’une famille indienne ?\n— Non, monsieur, bien sûr que non. Des purs Écossais de père en fils."
                                            },
                                            {
                                                "example_id": "5fc38fce-6717-4d09-a9ad-64001b109e5d",
                                                "sense_id": "089ed2ad-90c3-313e-bdc4-6feca814aac4",
                                                "text": "Bien sûr, je ne peux pas garantir que ça durera éternellement."
                                            },
                                            {
                                                "example_id": "ccea8734-9dd5-4836-90a6-5aa71825ad19",
                                                "sense_id": "089ed2ad-90c3-313e-bdc4-6feca814aac4",
                                                "text": "« Tu connaissais déjà cette recette ?\n— Bien sûr, depuis longtemps ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7176944-2dbd-4430-9e66-5fd3947d747f",
                        "source_entry_id": "c0fc2ef2-6544-3d89-8e6d-726ae3964dd5",
                        "source_sense_id": "960ba7a9-5ed9-3d8e-b12e-c363b4822b17",
                        "source_sense_description": "betonender oder verstärkender Hinweis: man beachte",
                        "target_lang_word": "bien entendu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bien entendu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "064c88f1-8e9b-361f-b2a2-1a38ddcf38a5",
                                        "entry_id": "464d7acc-3619-3c41-9fa3-cf2a53623fb4",
                                        "glosses": [
                                            "Naturellement ; évidemment ; bien sûr."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7c907d3-e2c0-4099-9d7d-ad5c7e1429b1",
                                                "sense_id": "064c88f1-8e9b-361f-b2a2-1a38ddcf38a5",
                                                "text": "Puis ce fut le Salon de l'Aéronautique. La recordwoman du monde est, bien entendu, la fée du stand Caudron-Renault."
                                            },
                                            {
                                                "example_id": "67594922-5138-4da1-8f96-edefe7968221",
                                                "sense_id": "064c88f1-8e9b-361f-b2a2-1a38ddcf38a5",
                                                "text": "Tout le monde viendra me voir pendu,\nSauf les aveugles, bien entendu."
                                            },
                                            {
                                                "example_id": "664abe4c-9d14-4294-80c0-d07ad01d00a7",
                                                "sense_id": "064c88f1-8e9b-361f-b2a2-1a38ddcf38a5",
                                                "text": "Zarzavadjian avait appris à aimer l'univers enchevêtré des arrière-gares et des voies de triage. Tous les poteaux, les potences et les portiques et leurs signalisations suspendues. […]. Et bien entendu l'infinie arborescence des rails."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bien entendu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3fd4fb1-e732-315b-851b-d999d1b0f953",
                                        "entry_id": "f4f89963-2484-3044-a7c1-daa3a2aa2678",
                                        "glosses": [
                                            "Qui est bien assorti, fait avec art, avec goût, avec intelligence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "296bafc3-ae46-4031-ae2c-a95cc6cdab48",
                                                "sense_id": "b3fd4fb1-e732-315b-851b-d999d1b0f953",
                                                "text": "Un repas bien entendu."
                                            },
                                            {
                                                "example_id": "f354d275-f8f4-495a-b80b-0eef681c800b",
                                                "sense_id": "b3fd4fb1-e732-315b-851b-d999d1b0f953",
                                                "text": "Un aménagement bien entendu."
                                            },
                                            {
                                                "example_id": "2c2b4b82-7b27-44b9-a2cd-e7e9dc053743",
                                                "sense_id": "b3fd4fb1-e732-315b-851b-d999d1b0f953",
                                                "text": "Une installation bien entendue."
                                            },
                                            {
                                                "example_id": "74f2cbde-5e26-4b5e-8b81-ddbe759284bd",
                                                "sense_id": "b3fd4fb1-e732-315b-851b-d999d1b0f953",
                                                "text": "L’ordonnance de ce tableau, de ce discours est bien entendue."
                                            },
                                            {
                                                "example_id": "f87668de-ff35-42b8-8fd2-23508da10e7c",
                                                "sense_id": "b3fd4fb1-e732-315b-851b-d999d1b0f953",
                                                "text": "Rébufat abusait sans scrupule de cette petite parente pauvre qu’il gardait auprès de lui par une charité bien entendue. Elle payait dix fois de son travail cette dure hospitalité, et il ne se passait pas de journée qu’il ne lui reprochât le pain qu’elle mangeait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
