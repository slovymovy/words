                "senses": [
                    {
                        "sense_id": "c326c662-6a3f-3358-9548-9d685970cdd6",
                        "entry_id": "961f6c37-9706-3d90-8f03-8825899a3dcb",
                        "glosses": [
                            "verwant met het libertinisme, een levensfilosofie die absolute individuele vrijheid voorstaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc266aa6-31cf-4802-8050-9d5e822916be",
                                "sense_id": "c326c662-6a3f-3358-9548-9d685970cdd6",
                                "text": "Cultfiguur Jean-Pierre Van Rossem werd in de jaren 90 vooral bekend bij het grote publiek met zijn libertijnse partij ROSSEM. Ook kwam hij in opspraak met zijn beleggingsbedrijf Moneytron, waarmee hij miljarden doorsluisde naar Zwitserse bankrekeningen en het criminele circuit. Hij was ook eigenaar van het Formule 1-team Onyx."
                            },
                            {
                                "example_id": "1ecdfc2b-ae58-4c4c-ab1f-3ed4c97d3904",
                                "sense_id": "c326c662-6a3f-3358-9548-9d685970cdd6",
                                "text": "De opera scharniert om de ‘ontmaskering’ van de Hertogin als nymfomane met tegennatuurlijke behoeftes. Regisseur Mariusz Trelinski koos ervoor het operahart op de voorgrond te plaatsen: een messcherpe psychologische tekening van een libertijnse, gevierde en weer uitgekotste vrouw. De typering van publiekelijke schande en dubbele seksuele moraal maakt Powder her face onverminderd actueel."
                            }
                        ]
                    },
                    {
                        "sense_id": "521804a9-6516-34f6-9a7d-b81feaddc5a6",
                        "entry_id": "961f6c37-9706-3d90-8f03-8825899a3dcb",
                        "glosses": [
                            "verband houdend met een te grote (seksuele) vrijheid"
                        ],
                        "tags": [],
                        "examples": []
                    }
