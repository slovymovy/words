                "translations": [
                    {
                        "translation_id": "52d8e6ed-9051-43eb-b4f3-644dbda7a8b8",
                        "source_entry_id": "66c7fa1b-47dd-3508-8461-d16fdbd4e62a",
                        "source_sense_id": "a93cbf07-4aec-31ff-829f-9bcf0d5152ea",
                        "target_lang_word": "brunette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brunette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6d83801-2358-391b-ac29-fa8dd733dcec",
                                        "entry_id": "dbcb321e-32c5-3f46-8b17-2349fe2e7013",
                                        "glosses": [
                                            "Of a brown color or tone."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6be0d88-c81b-339f-8a6b-41b79457618d",
                                        "entry_id": "dbcb321e-32c5-3f46-8b17-2349fe2e7013",
                                        "glosses": [
                                            "Having brown hair."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "brunette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba924370-3a7d-358b-a422-7181922d82b2",
                                        "entry_id": "38585135-c8c8-3189-944e-0541b75b4d91",
                                        "glosses": [
                                            "A person, especially female, with brown hair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd4eb63-b658-4676-9593-e90bcf9c6aea",
                                                "sense_id": "ba924370-3a7d-358b-a422-7181922d82b2",
                                                "text": "The housekeeper, a very decorative brunette of thirty-five with a pseudo-English accent, greeted him with a mixture of grateful effusion and condescending patronage."
                                            },
                                            {
                                                "example_id": "a485d2dd-7a49-490f-a4ff-3d1f25e06ccd",
                                                "sense_id": "ba924370-3a7d-358b-a422-7181922d82b2",
                                                "text": "Brownheads or brunettes use a darker red than blondes and redheads."
                                            },
                                            {
                                                "example_id": "209413c0-dde1-4d80-99e7-9bf1b6aac9a2",
                                                "sense_id": "ba924370-3a7d-358b-a422-7181922d82b2",
                                                "text": "And M. [Henri-François-Alphonse] Esquiros, in describing the Dutch generally, speaks of beauties both blondes and brunettes, ‘for black hair is not uncommon in the Netherlands.’ These words seem to imply that black hair does not preponderate; and, if not, there must be a marked difference between the Dutch and the English. Here again is confirmation of the opinion that the modern English are somewhat more dark-haired than the ancient Saxons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "339e590f-3bdd-418b-b0b1-d5bd4eb5ec14",
                        "source_entry_id": "66c7fa1b-47dd-3508-8461-d16fdbd4e62a",
                        "source_sense_id": "a93cbf07-4aec-31ff-829f-9bcf0d5152ea",
                        "target_lang_word": "brune",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4aef4503-74df-35f7-bd6f-8eb2709b6522",
                                        "entry_id": "aff1127a-ccdc-3354-bac7-0f32b11bdf68",
                                        "glosses": [
                                            "Femme ou fille ayant une chevelure allant de marron à noir."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "579c53ef-93ef-4bf0-bfdf-8f1a343bd88e",
                                                "sense_id": "4aef4503-74df-35f7-bd6f-8eb2709b6522",
                                                "text": "Sur ces entrefaites elle a rencontré par hasard une de ses anciennes copines, une nommée Suzanne, une brune en minijupe, une sorte de grande sauterelle à la voix nasillarde."
                                            },
                                            {
                                                "example_id": "6df3f726-c28c-42da-95c5-3e6fcba72a34",
                                                "sense_id": "4aef4503-74df-35f7-bd6f-8eb2709b6522",
                                                "text": "Au bout d’une minute, la porte s’ouvrit et une fliquette en tenue, une brune plutôt mimi, mais gâchée par l’air sévère qu’elle se sentait obligée de prendre, sortit et avança vers la guérite."
                                            },
                                            {
                                                "example_id": "4e707dad-5510-43f7-9738-72860c83a665",
                                                "sense_id": "4aef4503-74df-35f7-bd6f-8eb2709b6522",
                                                "text": "La nature, pimpante et piquante comme une brune au printemps, devient mélancolique et douce comme une blonde, les gazons se dorent, les fleurs d’automne poussent leurs pâles corolles, ce n’est plus les marguerites qui percent les pelouses de leurs yeux blancs, mais de rares calices violâtres."
                                            },
                                            {
                                                "example_id": "f7b874de-24db-4ffb-a011-25b7a5e7eb0f",
                                                "sense_id": "4aef4503-74df-35f7-bd6f-8eb2709b6522",
                                                "text": "Lisbeth fut alors la brune piquante de l’ancien roman français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29fd7502-6660-3e90-ac35-64c17692b79a",
                                        "entry_id": "aff1127a-ccdc-3354-bac7-0f32b11bdf68",
                                        "glosses": [
                                            "Bière à forte fermentation, fabriquée à partir de malt très torréfié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a71f12d1-d976-406b-8d92-cec0965a4d2c",
                                                "sense_id": "29fd7502-6660-3e90-ac35-64c17692b79a",
                                                "text": "Sam entra, se frayant un passage à coups de coude pour fendre la foule. Le bruit était terrifiant. Il réussit à atteindre le bar et commanda une brune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3cc40a9-43ca-3ea4-a703-c8c4b0f24f28",
                                        "entry_id": "aff1127a-ccdc-3354-bac7-0f32b11bdf68",
                                        "glosses": [
                                            "Cigarette à base de tabac brun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c87c6e-9ee3-44f4-811a-b85c2c54a8f8",
                                                "sense_id": "b3cc40a9-43ca-3ea4-a703-c8c4b0f24f28",
                                                "text": "Il me serre la main et me propose de le suivre dans son bureau. L’odeur de tabac y est intense. D’après l’examen du cendrier, il fume des brunes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5573a1b4-31ab-3ce6-896a-8c174fc311d6",
                                        "entry_id": "aff1127a-ccdc-3354-bac7-0f32b11bdf68",
                                        "glosses": [
                                            "La brune désigne le moment de la journée où le soleil est en train de se coucher et n’est plus complètement visible. Lorsqu’il disparaît, mais que la lumière reste encore présente, il s’agit du crépuscule. À cette courte période de la journée correspond, le matin, l’aube, où le soleil est en train de se lever, sans être encore complètement visible. Le crépuscule correspond de même à l’aurore, lorsque la lumière commence avant que le soleil ne soit visible."
                                        ],
                                        "tags": [
                                            "dated",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a029e4f7-eaa2-4b70-9cf3-b7386109ed33",
                                                "sense_id": "5573a1b4-31ab-3ce6-896a-8c174fc311d6",
                                                "text": "Peu après la brune, le premier brame a brisé le silence ; il était à peine articulé, presque un mugissement."
                                            },
                                            {
                                                "example_id": "64acfa41-fa30-4205-9477-cb8244e6e24c",
                                                "sense_id": "5573a1b4-31ab-3ce6-896a-8c174fc311d6",
                                                "text": "En fermant l’écoutille, leur dernier regard a dû être pour la Marne et ses eaux encore brillantes à ce moment particulier d’avant le crépuscule qu’on appelle la brune."
                                            },
                                            {
                                                "example_id": "762dbbe4-19ea-4fb4-bcdf-fc7b9a7d0555",
                                                "sense_id": "5573a1b4-31ab-3ce6-896a-8c174fc311d6",
                                                "text": "Ces errants de la rue ne rentraient qu’à la brune, et si las !"
                                            },
                                            {
                                                "example_id": "13c62d7a-9c7a-4796-98ab-a94de30324f0",
                                                "sense_id": "5573a1b4-31ab-3ce6-896a-8c174fc311d6",
                                                "text": "Je regagnai le navire à la brune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53ae68c9-a0ce-3aed-9202-d304ce519108",
                                        "entry_id": "aff1127a-ccdc-3354-bac7-0f32b11bdf68",
                                        "glosses": [
                                            "Race laitière de grand taurin, originaire de Suisse, à robe brune et aux muqueuses noires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f9cf337-06b6-4921-8837-d6ab19c8110f",
                                                "sense_id": "53ae68c9-a0ce-3aed-9202-d304ce519108",
                                                "text": "Peu à peu, la Frisonne va s’imposer : on commence à voir deux ou trois Frisonnes dans un troupeau de Brunes, et avec le temps elles finissent par remplacer les « Schwitz » (1958-1965)."
                                            }
                                        ]
                                    }
                                ]
                            },
