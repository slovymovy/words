    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f9c08c9c-29b8-3dce-8693-8a7d1bf20b01",
                "word": "pentimento",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e916e7e3-a3ce-4dfa-a199-e2e170a10e05",
                        "entry_id": "f9c08c9c-29b8-3dce-8693-8a7d1bf20b01",
                        "tags": [
                            "plural"
                        ],
                        "form": "pentimenti"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "341df337-84a0-36a9-9008-c133296ed1d0",
                        "entry_id": "f9c08c9c-29b8-3dce-8693-8a7d1bf20b01",
                        "glosses": [
                            "The presence of traces of a previous work in an artistic or literary work; especially (painting) an image which has been painted over but is still detectable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa9131ed-045b-4e70-bf0b-5482f5cba5ca",
                                "sense_id": "341df337-84a0-36a9-9008-c133296ed1d0",
                                "text": "She thought of the painting in the shop, the pentimento. Her life, the one she had so carefully planned for herself had crumbled like the paint on the surface."
                            },
                            {
                                "example_id": "c25f5fcf-ba59-4e98-a731-6902bba7e132",
                                "sense_id": "341df337-84a0-36a9-9008-c133296ed1d0",
                                "text": "[T]he presence of a pentimento is an extremely valuable entity which supports the conclusion that a painting is an original composition – so, by inference, therefore, refuting any later suggestion that the painting could be the work of a copyist, who would have been engaged upon copying an existing painting as seen! The identification of a pentimento in an artwork can occur in one of two ways: by analytical interrogation of the subsurface using penetrative radiation such as IRR or XRD, or by direct visual observation, where the overlaying paint has worn away […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df5fe472-c8a9-4d9e-9a94-51fef5d295d4",
                        "source_entry_id": "f9c08c9c-29b8-3dce-8693-8a7d1bf20b01",
                        "source_sense_id": "341df337-84a0-36a9-9008-c133296ed1d0",
                        "source_sense_description": "presence of traces of a previous work in an artistic or literary work",
                        "target_lang_word": "pentimento",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6434e2e1-963b-4635-b7ae-9c00f7d693c4",
                        "source_entry_id": "f9c08c9c-29b8-3dce-8693-8a7d1bf20b01",
                        "source_sense_id": "341df337-84a0-36a9-9008-c133296ed1d0",
                        "source_sense_description": "presence of traces of a previous work in an artistic or literary work",
                        "target_lang_word": "repentir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repentir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "192897e7-45c2-34cf-a9a0-a5999e80fb6e",
                                        "entry_id": "82ef053d-ab46-38a2-80e3-83bee5d3a391",
                                        "glosses": [
                                            "Action de se repentir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7ada37b-9298-48ab-b619-6baac15cb5d3",
                                                "sense_id": "192897e7-45c2-34cf-a9a0-a5999e80fb6e",
                                                "text": "Aujourd'hui son bonheur se traduisait par un amour dans la tombe, une épouse dans l'ombre, nul enfant sous le toit et la richesse dans les bras : une vie au gré du destin. Et le cœur de Naalo devint un nid de repentirs."
                                            },
                                            {
                                                "example_id": "c373ce88-6ff6-440d-84bb-f98227061b72",
                                                "sense_id": "192897e7-45c2-34cf-a9a0-a5999e80fb6e",
                                                "text": "Ravir à l’homme la possibilité d’expier son forfait par son repentir ou par des actes de vertu […] est à mes yeux le plus horrible raffinement de la cruauté."
                                            },
                                            {
                                                "example_id": "7a108c37-0da4-4ba9-9cb3-9229fc9fb60d",
                                                "sense_id": "192897e7-45c2-34cf-a9a0-a5999e80fb6e",
                                                "text": "Alors, quand toutes les facultés sont suspendues, nous devenons semblables aux démons de l’enfer qui ressentent le remords, mais qui ignorent le repentir."
                                            },
                                            {
                                                "example_id": "06d89813-2efd-4d99-9f8c-aa826460a532",
                                                "sense_id": "192897e7-45c2-34cf-a9a0-a5999e80fb6e",
                                                "text": "J’ai ramené au bien et au repentir des misérables qui, un soir, au détour d’un chemin, avaient voulu m’assommer à coups de hache."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "799f7aab-59fa-3354-b4bf-03243e16c128",
                                        "entry_id": "82ef053d-ab46-38a2-80e3-83bee5d3a391",
                                        "glosses": [
                                            "Trace d’une première idée qu’on a voulu corriger."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70916715-405c-4048-8b21-d68bf9d5dcd7",
                                                "sense_id": "799f7aab-59fa-3354-b4bf-03243e16c128",
                                                "text": "Il y a des repentirs dans ce tableau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c102043-b523-34fc-a5b0-6aea68b4bdde",
                                        "entry_id": "82ef053d-ab46-38a2-80e3-83bee5d3a391",
                                        "glosses": [
                                            "Cheveux roulés en tire-bouchons, qui pendent des deux côtés du visage. (au pluriel uniquement)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ed1fdf-8688-494d-bdcc-4f3eb7b1949b",
                                                "sense_id": "5c102043-b523-34fc-a5b0-6aea68b4bdde",
                                                "text": "Malgré son étiquette si pompeuse, l’institution Ouly était une petite école pour rire, tenue par une vieille dame à repentirs, que les enfants appelaient : « bonne amie »."
                                            },
                                            {
                                                "example_id": "f1da15ef-05d3-4f99-8716-3e6f010ac968",
                                                "sense_id": "5c102043-b523-34fc-a5b0-6aea68b4bdde",
                                                "text": "Elle portait, à seize ans, des deux côtés de son blême visage, ces tombantes boucles que l’on nommait des \"repentirs\", et ses yeux bleus rêveurs s’étonnaient près de ses cheveux noirs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repentir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff4311a6-a3b9-37e7-9d4e-6f34697e4015",
                                        "entry_id": "e2cffd32-e7b5-3ea7-9ec5-3f2c5b7d6c24",
                                        "glosses": [
                                            "Utilisé uniquement dans se repentir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
