                        "glosses": [
                            "A small, juvenile, or baby owl; owlet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5db5c073-8221-4ad5-bc89-81d761bb658e",
                                "sense_id": "01736a15-0f7b-3da2-a8ac-dceb932bf373",
                                "text": "Owls are extra hungry then, there being a batch of Greatlings or Hornlings or Owlings or whatever Great Horned Owl babies are called sitting on the edge of a nest waiting on Pa and Ma Owl to bring home the bacon."
                            },
                            {
                                "example_id": "5494855d-117e-4c9e-8eba-0b764664f97b",
                                "sense_id": "01736a15-0f7b-3da2-a8ac-dceb932bf373",
                                "text": "Eumeus, who was sitting on the stairs, pointed to the roof of the stable. Perched on its top, huddled together, three owlings were ogling them."
                            },
                            {
                                "example_id": "4b7e07bd-2bef-4e5b-875e-87bb5c64d72d",
                                "sense_id": "01736a15-0f7b-3da2-a8ac-dceb932bf373",
                                "text": "But the spotted owl isn't at the top of the food chain. Instead, the larger great horned owl will eat spotted owls, owlings, or eggs whenever it can."
                            }
                        ]
                    }
                ],
