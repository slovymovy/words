                                    },
                                    {
                                        "sense_id": "13454ce0-276f-35cc-9d87-f02a5d888a9d",
                                        "entry_id": "f7ed0bf8-f5cf-3592-a5f4-c0814462667c",
                                        "glosses": [
                                            "Great; extreme; terrible."
