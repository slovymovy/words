                        "entry_id": "4819f560-8101-30c4-87bb-31798191aa58",
                        "glosses": [
                            "Chapeau d’enfant en paille, à larges bords, garni d’un ruban, porté au début du XXe siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ced14a86-4c4f-45c3-9813-718616d79be5",
                                "sense_id": "4ffb28e5-8947-3f82-9cc9-ba8aa3be3987",
                                "text": "Nous voyions de jeunes garçons, en costume marin au grand col bleu, coiffés de Jean-bart, à ruban flottant au vent, remuer du sable sur la plage de Trouville."
                            },
                            {
                                "example_id": "fe552c6f-6258-4894-a9bb-4f07f473a92f",
                                "sense_id": "4ffb28e5-8947-3f82-9cc9-ba8aa3be3987",
                                "text": "Je regardai la photographie agrandie de cet enfant vêtu d’un costume marin, coiffé d’un Jean-bart et tenant un cerceau."
                            },
                            {
                                "example_id": "d02bb311-d5ed-42cd-8d38-b7fe45b557d4",
                                "sense_id": "4ffb28e5-8947-3f82-9cc9-ba8aa3be3987",
                                "text": "Va-t’en jouer dehors te voilà tout palot\nseulement ne sors pas sans mettre ton jean-bart"
                            }
                        ]
                    }
