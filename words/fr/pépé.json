                    "sense_id": "8919ad00-d39c-3344-ab81-2df83c0f11fc",
                    "sense_definition": "Terme affectueux ou familier pour désigner un grand-père.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque dimanche, les enfants rendent visite à leur <w>pépé</w> pour écouter ses histoires.",
                            "target_lang_translations": {
                                "en": "Every Sunday, the children visit their <w>grandpa</w> to listen to his stories.",
                                "ru": "Каждое воскресенье дети навещают своего <w>дедушку</w>, чтобы послушать его истории.",
                                "de": "Jeden Sonntag besuchen die Kinder ihren <w>Opa</w>, um seinen Geschichten zuzuhören.",
                                "es": "Cada domingo, los niños visitan a su <w>abuelo</w> para escuchar sus historias.",
                                "zh": "孩子们每个星期天都去看望他们的<w>爷爷</w>，听他讲故事。"
                            }
                        },
                        {
                            "text": "Mon <w>pépé</w> passe des heures à soigner ses légumes dans le jardin.",
                            "target_lang_translations": {
                                "en": "My <w>grandpa</w> spends hours tending his vegetables in the garden.",
                                "ru": "Мой <w>дедушка</w> часами ухаживает за овощами в саду.",
                                "de": "Mein <w>Opa</w> verbringt Stunden damit, im Garten sein Gemüse zu pflegen.",
                                "es": "Mi <w>abuelo</w> pasa horas cuidando sus verduras en el jardín.",
                                "zh": "我的<w>爷爷</w>在花园里花好几个小时照料他的蔬菜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grand-père",
                        "papi",
                        "papy"
                    ],
                    "antonyms": [
                        "mémé",
                        "mamie"
                    ],
