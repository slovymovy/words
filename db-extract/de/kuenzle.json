                "senses": [
                    {
                        "sense_id": "c05514b1-8f18-3cd0-8851-34ba98e3819f",
                        "entry_id": "80dc8c37-ffe5-34f7-91a5-c806b3d3a185",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b394bc4-b819-4510-a120-8923b922a07b",
                                "sense_id": "c05514b1-8f18-3cd0-8851-34ba98e3819f",
                                "text": "Frau Kuenzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d56cbcd2-970e-45aa-91bd-aceefb0b402a",
                                "sense_id": "c05514b1-8f18-3cd0-8851-34ba98e3819f",
                                "text": "Herr Kuenzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d93a6d7c-40f6-4f44-8076-a825f4dc1766",
                                "sense_id": "c05514b1-8f18-3cd0-8851-34ba98e3819f",
                                "text": "Die Kuenzles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4e1d14dc-aea6-4f6a-b1a7-266fcb1f6d11",
                                "sense_id": "c05514b1-8f18-3cd0-8851-34ba98e3819f",
                                "text": "Der Kuenzle trägt nie die Schals, die die Kuenzle ihm strickt."
                            },
                            {
                                "example_id": "88060a43-416b-4cef-8939-79db5e29e23d",
                                "sense_id": "c05514b1-8f18-3cd0-8851-34ba98e3819f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kuenzle kommt, geht der Herr Kuenzle.“"
                            },
                            {
                                "example_id": "118d0b13-804a-4c1d-9ce2-c714ea3748e5",
                                "sense_id": "c05514b1-8f18-3cd0-8851-34ba98e3819f",
                                "text": "Kuenzle kommt und geht."
                            },
                            {
                                "example_id": "39dbbd4b-6b17-487f-b413-9fe38a34155b",
                                "sense_id": "c05514b1-8f18-3cd0-8851-34ba98e3819f",
                                "text": "Kuenzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
