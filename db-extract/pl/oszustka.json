                        ]
                    },
                    {
                        "translation_id": "247312d6-2270-4373-823d-16c2dc152b79",
                        "source_entry_id": "773b5f48-88e3-3bab-823b-46df9744cb6a",
                        "source_sense_id": "b526cab3-5a3a-3f4a-a108-c1cf6e28e6c9",
                        "target_lang_word": "плутовка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "плутовка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "edca5418-4665-350b-b533-27f5c4d61d63",
                                        "entry_id": "102f7e87-0c5e-3e61-b0f6-d9ce75dc7d4e",
                                        "glosses": [
                                            "женск. к плут; обманщица"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cd68e1a-a202-468b-bf55-740fb57db628",
                                                "sense_id": "edca5418-4665-350b-b533-27f5c4d61d63",
                                                "text": "― сказала ворона, сыр выпал и с ним была плутовка такова."
                                            },
                                            {
                                                "example_id": "c2b72c0d-4e53-4368-b280-bc3ff41f51db",
                                                "sense_id": "edca5418-4665-350b-b533-27f5c4d61d63",
                                                "text": "Ишь, плутовка, как хвостом машет, ― добавляет Оля, ― ласково так машет, но ты, сорока, ей не верь..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dda4e5fd-39ea-3f49-af5d-0f805e22f35a",
                                        "entry_id": "102f7e87-0c5e-3e61-b0f6-d9ce75dc7d4e",
                                        "glosses": [
                                            "перен., шутл. хитрая, лукавая женщина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bd7db95-f3a2-47e4-97ca-c233903c42ed",
                                                "sense_id": "dda4e5fd-39ea-3f49-af5d-0f805e22f35a",
                                                "text": "Погоди же ты, плутовка, Провела меня ты ловко!"
                                            },
                                            {
                                                "example_id": "0051c7fd-7c04-4628-a56b-7280117ec0d8",
                                                "sense_id": "dda4e5fd-39ea-3f49-af5d-0f805e22f35a",
                                                "text": "Главная героиня Елена (Е. Шигапова) ― отнюдь не плутовка, с легкостью манипулирующая интригой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
