                ],
                "senses": [
                    {
                        "sense_id": "d88bb0dc-2875-39e5-8e1c-5944722b4392",
                        "entry_id": "9d709f07-1220-31d6-a512-7c53f5a4a597",
                        "glosses": [
                            "weibliche Person, die einen anderen tauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21539b97-b703-484c-9db1-e75cd984c52f",
                                "sense_id": "d88bb0dc-2875-39e5-8e1c-5944722b4392",
                                "text": "„In Erinnerung an ihre eigene Taufe ging Bischof Franz-Josef Overbeck zu jeder neuen Taufspenderin und besprengte sie bei der Beauftragung im Gottesdienst mit einigen Tropfen Weihwasser.“"
                            },
                            {
                                "example_id": "60a45a67-5476-4725-b734-3464fcd7b6ab",
                                "sense_id": "d88bb0dc-2875-39e5-8e1c-5944722b4392",
                                "text": "„Auf diese sich weiter zuspitzende Situation reagieren wir durch die Beauftragung außerordentlicher Taufspenderinnen und -spender proaktiv, um insbesondere den jungen Familien auch weiterhin eine pastorale Begleitung und individuell gestaltete Tauffeiern ermöglichen zu können.“"
                            },
                            {
                                "example_id": "5d2990bf-db40-4eb3-976e-3a765d5f828a",
                                "sense_id": "d88bb0dc-2875-39e5-8e1c-5944722b4392",
                                "text": "„Sie ist vom Ruhrbischof als Taufspenderin beauftragt worden und steht kurz vor ihrer ersten Tauffeier.“"
                            },
                            {
                                "example_id": "fb400fc7-0361-440e-8207-9ba005761a13",
                                "sense_id": "d88bb0dc-2875-39e5-8e1c-5944722b4392",
                                "text": "„Tauffamilien wünschen sich heute eine immer individuellere Begleitung und Gestaltung der Tauffeier. Welche Rolle können da die neuen Taufspenderinnen spielen?“"
                            },
                            {
                                "example_id": "0d682476-6e0f-48af-a883-2f016f683419",
                                "sense_id": "d88bb0dc-2875-39e5-8e1c-5944722b4392",
                                "text": "„Angesichts der außerordentlich präzisen Terminologie scheint es daher nicht undenkbar, daß zölibatär lebende Frauen als Taufspenderinnen im Gallien des ausgehenden 5. Jahrhunderts zumindest geduldet wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
