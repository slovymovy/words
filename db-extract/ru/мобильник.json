                    {
                        "translation_id": "f0a033f6-cee5-411d-9352-b3a5bec8a324",
                        "source_entry_id": "5e964057-55d1-3ea4-8f23-297f1a6558e6",
                        "source_sense_id": "21e97fae-0359-335b-95c2-69bf6e1e74e7",
                        "target_lang_word": "амер.",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b333cb39-58e4-4b8c-8d56-d817bca792cd",
                        "source_entry_id": "5e964057-55d1-3ea4-8f23-297f1a6558e6",
                        "source_sense_id": "21e97fae-0359-335b-95c2-69bf6e1e74e7",
                        "target_lang_word": "Handy",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handy",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                        "entry_id": "722a8c93-4803-369a-89b3-76d78e64e3cc",
                                        "glosses": [
                                            "kleines, handliches, kabelloses Telefon (mit Zusatzfunktionen wie Text- und Bildübermittlung, Internetzugang), das per Funk mit dem Telefonnetz verbunden ist, dadurch ortsunabhängig verwendet und deshalb bei sich getragen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7708835-13b3-4037-b3f6-ddb0465881a1",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "Dank meines neuen Handys bin ich jetzt überall erreichbar."
                                            },
                                            {
                                                "example_id": "c59c4c6e-1351-421c-aa36-141f79555b90",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "Ein knallbuntes Handy lag unterm Weihnachtsbaum."
                                            },
                                            {
                                                "example_id": "60a62e5e-3f8d-4fc7-acde-f1d2bc7439ac",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Ein weiteres Handy wurde bei der Gendarmeriebrigade Raeren abgegeben.“"
                                            },
                                            {
                                                "example_id": "fcdb7b41-2f27-4afe-83f2-8a7a39a40961",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Ihr Handy in der Tasche piepte, und sie ging ein Stück beiseite, schaute zum Fenster hinaus auf den Hof, wo gerade zwei in der Acht geschlossene Frauen aus einem Polizeiauto gebracht wurden, eine der Frauen schrie und versuchte, eine Polizeibeamtin zu treten.“"
                                            },
                                            {
                                                "example_id": "fa48de1a-bd2f-41bd-9014-6399a4acad9e",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Bullenwannen, eine hinkende Frau mit Damenbart und einem Pappschild in der Hand »Bitte um Spende«, zwei Turbanmänner mit Handys, ein Dreadlock-Philosophiestudententyp mit Joint, eine Oma in einem flaschengrünen Kostüm, dazu weiße Gesundheitsschuhe, marschieren an ihm vorbei, und er hört diese Gesänge.“"
                                            },
                                            {
                                                "example_id": "e4102803-2bed-4cf1-94ba-4d34d545cf75",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Und so kann es vorkommen, daß ein kultivierter Franzose oder Italiener die Deutschen eher als Westgoten mit Handy erlebt.“"
                                            },
                                            {
                                                "example_id": "2614f870-c32a-4efc-a708-1f530d04f27d",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Im Zuge der neuen Verordnung darf ausschließlich der jeweils zuständige Finanzverwalter einer Behörde oder eines Ministeriums darüber beschließen, welche Angstellte bestimmter Abteilungen für die Ausübung ihrer offiziellen Tätigkeit ein Handy benötigen.“"
                                            },
                                            {
                                                "example_id": "4f0943f6-8a24-4819-ad33-43157ad4289a",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Ich habe sie mit dem Handy deines Vaters angerufen.“"
                                            },
                                            {
                                                "example_id": "9ec26902-b25f-4fc5-b01d-d72dad22e1a1",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Am liebsten hätte sie ihm abgesagt, aber sie konnte ihn nicht erreichen, er hatte sein Handy ausgeschaltet.“"
                                            },
                                            {
                                                "example_id": "ffee9db5-d17a-4bed-8386-8030d67bd2ee",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Anstatt mir also blöde Witze anzuhören, tippte ich die Nummer des Ashcroft-Mitarbeiterlokalisierungsbüros ins Handy.“"
                                            },
                                            {
                                                "example_id": "f7baa147-802f-40f6-8baf-07e88a5085ce",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Er las alle ihre Kurznachrichten, die er im Speicher des Handys aufbewahrt hatte.“"
                                            },
                                            {
                                                "example_id": "8be22d96-bca5-4fd7-a01b-3de760e8811f",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Der Anschluss an die Audio Guía Móvil (nur über Handy) lautet *8283, und dann die jeweilige Schlüsselnummer für den gewünschten Ort, die auf der Bodenplatte eingemeißelt ist; Código 233 gilt etwa für das San Martín-Denkmal, und 193 für den Obelisken.“"
                                            },
                                            {
                                                "example_id": "bdc60e32-5c0d-4d25-af39-d83516f5ec8d",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„In absehbarer Zeit kann sich jeder Handynutzer kurz das Aufladegerät vom Freund leihen oder alle seine Handys mit dem gleichen Gerät über USB-Anschluss aufladen.“"
                                            },
                                            {
                                                "example_id": "55d72a68-9b9a-4a1b-a6aa-d84b7e0b9ad7",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Lilith steht abseits und hält sich ihr Handy ans Ohr.“"
                                            },
                                            {
                                                "example_id": "fc08d0db-f75a-4d47-bab3-dc085b23e7ac",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„‚[…] Die Nutzung von Mitteilungsdiensten und insbesondere vom Onlinezugang per Handy steigt merklich an und wird durch gute Preis-Leistungs-Angebote intensiviert, inklusive bezahlbarer Smartphones‘, sagte Inaki Berroeta, Präsident und Geschäftsführer von Vodafone Rumänien.“"
                                            },
                                            {
                                                "example_id": "8ca720dc-7683-451b-9573-695e460be694",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Eigentlich versuchte Evelyn Paswall nur ihr Handy zurückzugeben.“"
                                            },
                                            {
                                                "example_id": "938fcb6a-3067-43bb-818d-10c2a1fe6ed7",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Mein Handy schlug an.“"
                                            },
                                            {
                                                "example_id": "71ff558d-06d9-4116-9369-5900359078e4",
                                                "sense_id": "2bc3d627-cb04-3749-ab14-e6cadb889884",
                                                "text": "„Sie laden ihre Handys auf und tauschen die neuesten Nachrichten aus, wer an welchem Checkpoint verhaftet, wessen Tochter verheiratet, wer getötet wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
