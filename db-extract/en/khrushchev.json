                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86c6f603-9d17-4493-b57e-b6e1f0752d12",
                                                "sense_id": "b0dddba6-9219-3377-8fbe-43efffacb507",
                                                "text": "Un exemple illustre le choix de la graphie en fonction du public que l’on vise : à l’époque où le journal le Monde citait le nom de Khrouchtchev, son confrère Paris-Presse orthographiait Kroutchev, afin de ménager l’œil de ses lecteurs jugés moins cultivés."
                                            },
                                            {
                                                "example_id": "328de4e1-7f33-49d3-ac2c-cf925ee5f2b1",
                                                "sense_id": "b0dddba6-9219-3377-8fbe-43efffacb507",
                                                "text": "Toujours est-il que si Khrouchtchev avait eu Sartre comme conseiller technique, il n'aurait pas dévoilé les crimes de Staline."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
