                "senses": [
                    {
                        "sense_id": "3e864c9c-80db-3f16-8790-a9162f13ef1f",
                        "entry_id": "6835d21b-43cc-36c6-b2cb-69fe7d3a2cbe",
                        "glosses": [
                            "het schijnbaar verdwijnen van de zon onder de horizon als de avond valt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e151f87-bf2f-4504-bc88-1a8bdb3e396e",
                                "sense_id": "3e864c9c-80db-3f16-8790-a9162f13ef1f",
                                "text": "Wij hebben samen de mooie zonsondergang bekeken."
                            },
                            {
                                "example_id": "0f3b8741-0b88-419d-9ee8-b6fd9ab76f9d",
                                "sense_id": "3e864c9c-80db-3f16-8790-a9162f13ef1f",
                                "text": "Waarom had ik geen donder gehoord of bliksem gezien tijdens mijn tocht omhoog? Wat had ik nu spijt van het plan om de zonsondergang en zonsopkomst vanaf de top te willen gaan bekijken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1630544a-bf92-4224-aa37-945ce43d5f79",
                        "source_entry_id": "6835d21b-43cc-36c6-b2cb-69fe7d3a2cbe",
                        "source_sense_id": "3e864c9c-80db-3f16-8790-a9162f13ef1f",
                        "source_sense_description": "het ondergaan van de zon",
                        "target_lang_word": "Sonnenuntergang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenuntergang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "391c6870-9df8-3e94-8745-85f2651ece02",
                                        "entry_id": "9a80b7fb-a996-3edf-a872-4abf342f4b3c",
                                        "glosses": [
                                            "das scheinbare Abtauchen der Sonne unter den Horizont"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27994fd9-4c34-43c0-88bc-3d857e150393",
                                                "sense_id": "391c6870-9df8-3e94-8745-85f2651ece02",
                                                "text": "Am 22. September und am 21. März ist der Sonnenuntergang um 18:00 Uhr Ortszeit."
                                            },
                                            {
                                                "example_id": "86d8ff1d-a684-4e70-a097-768719dc4d2b",
                                                "sense_id": "391c6870-9df8-3e94-8745-85f2651ece02",
                                                "text": "„Bei Sonnenuntergang kam er mit einem Truthahn zurück, der eine ganze Schiffsmannschaft sattgemacht hätte, einem Sack Melonen, Beeren und Wurzeln.“"
                                            },
                                            {
                                                "example_id": "becafd60-1c9e-4e83-a366-ce7cd2ab87f3",
                                                "sense_id": "391c6870-9df8-3e94-8745-85f2651ece02",
                                                "text": "„Die Sonne hatte den Horizont erreicht, wer hier neu ist, kommt in den ersten drei Tagen an diese Stelle, um den Sonnenuntergang zu betrachten, später kommen sie nicht mehr, sie haben sich an die Pracht gewöhnt.“"
                                            },
                                            {
                                                "example_id": "88922df2-b990-49ac-bd1d-ad3af3760e64",
                                                "sense_id": "391c6870-9df8-3e94-8745-85f2651ece02",
                                                "text": "„Kurz vor Sonnenuntergang sahen wir im Osten einige Granitspitzen aus der Ebene ragen.“"
                                            },
                                            {
                                                "example_id": "dd73f30f-8730-41e6-9b53-ba6a8ca3e2f2",
                                                "sense_id": "391c6870-9df8-3e94-8745-85f2651ece02",
                                                "text": "„Die wogende Masse Mensch singt und tanzt bis Sonnenuntergang.“"
                                            },
                                            {
                                                "example_id": "c24327f1-573d-46af-bcd3-d5928a643ea4",
                                                "sense_id": "391c6870-9df8-3e94-8745-85f2651ece02",
                                                "text": "[Saharastaub:] „Die Trübung hat aber auch ihre guten Seiten: Die vielen Partikel in der Luft sorgen für spektakuläre Sonnenauf- und -untergänge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b15ac4ab-90bd-4b0a-b5af-a38a5ab0bcaf",
                        "source_entry_id": "6835d21b-43cc-36c6-b2cb-69fe7d3a2cbe",
