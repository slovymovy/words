                        "entry_id": "fef0af93-6ac5-3db8-ae15-c292d58bbf46",
                        "glosses": [
                            "A technique of interweaving living and dead branches through a hedge for stock control; plashing."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b3b86a83-246e-4178-9ee1-662f33f22f9f",
                                "sense_id": "5b149e73-101d-3f94-9b50-ba9ac44edf9c",
                                "text": "Osage thorn hedge should not be pleached during severe freezing weather, but pleaching may be done in mild weather, when there is but little frost in the wood, and in the winter in southern latitudes."
                            }
                        ]
                    }
