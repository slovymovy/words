                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45dc0cf5-a153-4c34-aeae-53802693394e",
                                "sense_id": "d404cea3-a6d7-36bc-b1df-3cfcaee5eb7b",
                                "text": "Het Rheinisches Landesmuseum. Ik had net zo goed de ene zaal na de andere van bejaardenhuis Altenheim Trierelier kunnen afdweilen. Ik had evenveel antiek te zien gekregen."
                            },
                            {
                                "example_id": "9bada5d2-451b-47a6-aaf3-7189b2568cd2",
                                "sense_id": "d404cea3-a6d7-36bc-b1df-3cfcaee5eb7b",
                                "text": "Het kan niet dat mensen apotheken moeten afdweilen om aan hun medicatie te geraken', aldus Sensoa-woordvoerder Boris Cruyssaert."
                            }
                        ]
                    },
