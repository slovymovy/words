    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8991db68-f4a7-3209-a60d-4f1ad2bdb06f",
                    "sense_definition": "A piece of jewelry worn on the ear.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "jewelry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to wear a gold <w>earring</w> in each ear for the party.",
                            "target_lang_translations": {
                                "ru": "Она решила надеть по золотой <w>серьге</w> в каждое ухо на вечеринку."
                            }
                        },
                        {
                            "text": "He lost his favorite silver <w>earring</w> while he was swimming in the ocean.",
                            "target_lang_translations": {
                                "ru": "Он потерял свою любимую серебряную <w>серёжку</w>, когда плавал в океане."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gold earring",
                        "silver earring",
                        "pair of earrings",
                        "wear an earring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ювелирное украшение, которое носят на ухе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серьга",
                                "target_lang_sense_clarification": "основное название украшения"
                            },
                            {
                                "target_lang_word": "серёжка",
                                "target_lang_sense_clarification": "уменьшительная или разговорная форма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa766c5d-0af4-3c8a-845c-7c0fd382dd00",
                    "sense_definition": "Alternative form of <w>earing</w>, referring to a manufacturing defect where sheet metal edges form a wave pattern.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manufacturing_defects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer noted that significant <w>earring</w> occurred during the deep drawing process of the aluminum sheet.",
                            "target_lang_translations": {
                                "ru": "Инженер отметил, что в процессе глубокой вытяжки алюминиевого листа возникло значительное <w>фестонообразование</w>."
                            }
                        },
                        {
                            "text": "To minimize <w>earring</w> in the final product, the metallurgical properties of the alloy must be carefully controlled.",
                            "target_lang_translations": {
                                "ru": "Чтобы свести к минимуму <w>образование фестонов</w> в конечном продукте, необходимо тщательно контролировать металлургические свойства сплава."
                            }
                        }
                    ],
                    "synonyms": [
                        "earing"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of earing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дефект производства, при котором края листового металла образуют волнообразный узор при вытяжке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фестонообразование",
                                "target_lang_sense_clarification": "технический термин для волнообразных краев"
                            },
                            {
                                "target_lang_word": "образование фестонов",
                                "target_lang_sense_clarification": "процесс возникновения дефекта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
