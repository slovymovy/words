                            "target_lang_translations": {
                                "en": "First-grade students learned <w>addition</w> and subtraction in math class."
                            }
                        },
                        {
                            "text": "Простое <w>сложение</w> двух чисел помогает быстро посчитать общий расход.",
                            "target_lang_translations": {
