    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67c6502c-e263-326f-accb-a9dc53252622",
                    "sense_definition": "snel omhoog bewegen door af te zetten met de voeten",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kat <w>sprong</w> plotseling <w>op</w> toen hij een vogel in de tuin zag.",
                            "target_lang_translations": {
                                "it": "Il gatto è <w>balzato</w> su improvvisamente quando ha visto un uccello in giardino."
                            }
                        },
                        {
                            "text": "Hij <w>sprong</w> <w>op</w> van vreugde toen hij het goede nieuws hoorde.",
                            "target_lang_translations": {
                                "it": "È <w>saltato</w> su dalla gioia quando ha sentito la buona notizia."
                            }
                        }
                    ],
                    "synonyms": [
                        "opveren"
                    ],
                    "common_phrases": [
                        "opspringen van vreugde"
                    ],
                    "target_lang_definitions": {
                        "it": "Muoversi rapidamente verso l'alto spingendosi con i piedi."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "saltare su",
                                "target_lang_sense_clarification": "Movimento improvviso verso l'alto o scatto in piedi."
                            },
                            {
                                "target_lang_word": "balzare",
                                "target_lang_sense_clarification": "Movimento rapido e scattante, spesso usato per animali o reazioni emotive."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cabf10f1-568e-3404-a90c-0c5ac23c6d25",
                    "sense_definition": "omhoog veren of stuiteren",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bal <w>sprong</w> <w>op</w> tegen de muur.",
                            "target_lang_translations": {
                                "it": "La palla è <w>rimbalzata</w> contro il muro."
                            }
                        },
                        {
                            "text": "Het deksel <w>sprong</w> <w>op</w> door de druk in de pan.",
                            "target_lang_translations": {
                                "it": "Il coperchio è <w>saltato</w> via a causa della pressione nella pentola."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Rimbalzare o scattare verso l'alto a causa di una forza o pressione."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "rimbalzare",
                                "target_lang_sense_clarification": "Tornare indietro dopo aver colpito una superficie."
                            },
                            {
                                "target_lang_word": "saltare via",
                                "target_lang_sense_clarification": "Staccarsi o aprirsi bruscamente a causa di una pressione."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}