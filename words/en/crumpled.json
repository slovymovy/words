    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "79a77755-f93c-331c-bb4a-19e7759ea932",
                    "sense_definition": "Squeezed into a compact mass by irregular folds.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He threw the <w>crumpled</w> paper into the trash can.",
                            "target_lang_translations": {
                                "ru": "Он выбросил <w>скомканную</w> бумагу в мусорное ведро.",
                                "it": "Gettò la carta <w>appallottolata</w> nel cestino."
                            }
                        },
                        {
                            "text": "She tried to smooth out her <w>crumpled</w> clothes before the interview.",
                            "target_lang_translations": {
                                "ru": "Она попыталась разгладить свою <w>мятую</w> одежду перед собеседованием.",
                                "it": "Cercò di stirare con le mani i suoi vestiti <w>sgualciti</w> prima del colloquio."
                            }
                        }
                    ],
                    "synonyms": [
                        "rumpled",
                        "wrinkled",
                        "creased",
                        "crinkly"
                    ],
                    "antonyms": [
                        "smooth",
                        "flat",
                        "ironed"
                    ],
                    "common_phrases": [
                        "crumpled paper",
                        "crumpled clothes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сжатый в компактную массу с образованием неровных складок.",
                        "it": "Schiacciato o piegato in modo disordinato, pieno di pieghe e grinze."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мятый",
                                "target_lang_sense_clarification": "о бумаге или одежде"
                            },
                            {
                                "target_lang_word": "скомканный",
                                "target_lang_sense_clarification": "о бумаге, ткани"
                            },
                            {
                                "target_lang_word": "измятый",
                                "target_lang_sense_clarification": "сильно помятый"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "sgualcito",
                                "target_lang_sense_clarification": "detto di vestiti o carta spiegazzata"
                            },
                            {
                                "target_lang_word": "appallottolato",
                                "target_lang_sense_clarification": "ridotto a forma di palla o grumo, spec. di carta"
                            },
                            {
                                "target_lang_word": "stropicciato",
                                "target_lang_sense_clarification": "pieno di grinze o pieghe disordinate"
                            },
                            {
                                "target_lang_word": "accartocciato",
                                "target_lang_sense_clarification": "piegato e schiacciato su se stesso"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "755951be-56f3-3dbf-85d0-e3eb91c90fc3",
                    "sense_definition": "Simple past and past participle of <w>crumple</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>crumpled</w> the letter in frustration and tossed it away.",
                            "target_lang_translations": {
                                "ru": "Она в расстройстве <w>скомкала</w> письмо и выбросила его.",
                                "it": "Lei <w>accartocciò</w> la lettera per la frustrazione e la gettò via."
                            }
                        },
                        {
                            "text": "The front of the car <w>crumpled</w> upon impact with the wall.",
                            "target_lang_translations": {
                                "ru": "Передняя часть машины <w>смялась</w> при ударе о стену.",
                                "it": "La parte anteriore dell'auto <w>si accartocciò</w> al momento dell'impatto con il muro."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола crumple (мять, сминать, комкать).",
                        "it": "Passato e participio passato del verbo crumple: accartocciare, sgualcire, o deformarsi per un urto."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скомкал",
