                                            {
                                                "example_id": "12dddf0f-87b2-4811-aa42-8e672b7f6aa7",
                                                "sense_id": "58cf1226-1238-3dbf-a9d4-2515bff62d4e",
                                                "text": "This is important, since the brief protologus of A. flava published in the Edinburgh Catalogus included only the first four lines from Solander’s original manuscript (our translation of Solander’s protologue: “calyx ovate, half the length of the upper petal claws, blade cordate-subrotund, stamens curved”) and therefore was incomplete and is inadequate for typification."
                                            }
