                            },
                            {
                                "example_id": "2478d7a2-bad4-4d5a-b17b-11fda5e86678",
                                "sense_id": "e432e636-8651-3021-8d02-197cd5534360",
                                "text": "внуша́ть мысль кому́-либо",
