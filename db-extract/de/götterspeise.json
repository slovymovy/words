                        ],
                        "form": "die Götterspeisen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c414c38-c5ad-3cae-9439-de1d5230489d",
                        "entry_id": "28a07f27-9a91-3b8d-a232-9a53160573b5",
                        "glosses": [
                            "Süßspeise aus Gelatine oder anderen Geliermitteln, Zucker, Aroma- und Farbstoffen"
                        ],
                        "tags": [
                            "Lebensmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "64e3afc5-41df-41f8-b301-e0ab947ca248",
                                "sense_id": "5c414c38-c5ad-3cae-9439-de1d5230489d",
                                "text": "Zum Geburtstag gab es Vanillepudding mit Schokoladensoße oder Götterspeise mit Vanillesoße."
                            },
                            {
                                "example_id": "4aeb010d-1482-4ea6-b59e-6a040c5b2df3",
                                "sense_id": "5c414c38-c5ad-3cae-9439-de1d5230489d",
                                "text": "„Die ‚Götterspeise‘ ist eine beliebte Süßspeise im europäischen Raum; in Deutschland etwa wird ein Wackelpudding als ‚Götterspeise‘ bezeichnet, in der Schweiz eine geschichtete Mischung von Zwieback, Vanillepudding, Fruchtkompott und Schlagsahne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f05ffab2-14d7-3878-8ad9-65389ad97b7b",
                        "entry_id": "28a07f27-9a91-3b8d-a232-9a53160573b5",
                        "glosses": [
                            "andere Bezeichnung für die Frucht namens Kaki"
                        ],
                        "tags": [
                            "Frucht"
                        ],
                        "examples": [
                            {
                                "example_id": "626517f6-72a5-4e9b-a9c5-1cf219aafd0b",
                                "sense_id": "f05ffab2-14d7-3878-8ad9-65389ad97b7b",
                                "text": "Der Gattungsname Diospyros bedeutet „Götterfrucht“ oder „Götterspeise“."
                            },
                            {
                                "example_id": "2d330ae9-586c-4343-b4cc-f6bf72e182fa",
                                "sense_id": "f05ffab2-14d7-3878-8ad9-65389ad97b7b",
                                "text": "„Nach Linné wird auch mit dem Worte Ambrosia (Götterspeise) eine Pflanzengattung benannt, welche unter die Familie der Compositen gehört, u. Götterbaum oder Götterspeise genannt wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6b463bd9-d6c3-31a9-b910-9de7bc4512a1",
                        "entry_id": "28a07f27-9a91-3b8d-a232-9a53160573b5",
                        "glosses": [
                            "wohlschmeckende Speise überhaupt"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "1b896c4b-facd-419f-96a8-bbf7160a74a6",
                                "sense_id": "6b463bd9-d6c3-31a9-b910-9de7bc4512a1",
                                "text": "„Das fein marmorierte Steak ist butterzart, besonders aromatisch, schlicht eine Götterspeise, allerdings auch zu überirdischen Preisen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "31076401-994d-344c-aa00-93e83b20fa40",
                        "entry_id": "28a07f27-9a91-3b8d-a232-9a53160573b5",
                        "glosses": [
                            "die unsterblich machende Speise der olympischen Götter; Ambrosia"
                        ],
                        "tags": [
                            "griechische Mythologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ebdf4033-5e7a-4821-94af-bd175e4d2591",
                                "sense_id": "31076401-994d-344c-aa00-93e83b20fa40",
                                "text": "„Dass ich sterblich bin weiß ich, und dass meine Tage gezählt sind; aber wenn ich im Geiste den vielfach verschlungen Kreisbahnen der Gestirne nachspüre, dann berühre ich mit den Füßen nicht mehr die Erde: am Tische des Zeus selbst labt mich Ambrosia, die Götterspeise.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "c7c3fab3-9664-35cc-a502-cdfd24f3ac10",
                        "entry_id": "28a07f27-9a91-3b8d-a232-9a53160573b5",
                        "glosses": [
                            "von Gott oder den Göttern selbst gegebene Speise"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "5d365df6-0441-43f7-ad50-a8ad2185adf6",
                                "sense_id": "c7c3fab3-9664-35cc-a502-cdfd24f3ac10",
