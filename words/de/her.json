                    "sense_id": "1b78799b-0743-380a-8ed3-a1c98aaf5010",
                    "sense_definition": "drückt eine räumliche Bewegung in Richtung der sprechenden Person oder zu einem Bezugspunkt hin aus",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lokal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Komm bitte sofort zu mir <w>her</w>, damit wir das Problem gemeinsam lösen können."
                        },
                        {
                            "text": "Gib mir sofort den Schlüssel <w>her</w>, bevor du ihn noch verlierst!"
                        }
                    ],
                    "synonyms": [
                        "hierher",
                        "herbei"
                    ],
                    "antonyms": [
                        "hin"
                    ],
                    "common_phrases": [
                        "komm her",
                        "her damit"
                    ]
                },
                {
                    "sense_id": "79a415bc-9e61-3d2b-8da4-6fa88304eb5f",
                    "sense_definition": "drückt aus, dass ein bestimmtes Ereignis zeitlich zurückliegt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temporal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es ist schon viele Jahre <w>her</w>, dass wir unsere alte Schule besucht haben."
                        },
                        {
                            "text": "Mein letzter Urlaub am Meer ist leider schon eine ganze Weile <w>her</w>."
                        }
                    ],
                    "common_phrases": [
