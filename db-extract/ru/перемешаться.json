                ],
                "senses": [
                    {
                        "sense_id": "c8a3363b-e065-3552-a4f7-e186616f4349",
                        "entry_id": "4b4979f8-f7ec-39cc-b974-383b482332c7",
                        "glosses": [
                            "смешаться с чем-нибудь другим, соединиться в одно с чем-нибудь разнородным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "581c5c2b-fe8c-40ec-a111-009e360d9533",
                                "sense_id": "c8a3363b-e065-3552-a4f7-e186616f4349",
                                "text": "Два сорта муки перемешались."
                            }
                        ]
                    },
                    {
                        "sense_id": "0873ef1a-4cac-3e04-b1db-34fe88d0bff1",
                        "entry_id": "4b4979f8-f7ec-39cc-b974-383b482332c7",
                        "glosses": [
                            "переместиться внутри чего-нибудь, изменить свое положение (об отдельных частях чего-нибудь)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35045a4b-c492-4f3e-87f2-54f5635d51db",
                                "sense_id": "0873ef1a-4cac-3e04-b1db-34fe88d0bff1",
                                "text": "Перемешавшись полками, стрельцы добежали до Грановитой палаты."
                            },
                            {
                                "example_id": "2a1ae09f-d42e-4a28-9b6a-23ebbd6c3734",
                                "sense_id": "0873ef1a-4cac-3e04-b1db-34fe88d0bff1",
                                "text": "Карты перемешались."
                            },
                            {
                                "example_id": "a9763cac-4c93-4f56-925f-75fdc3b4ca20",
                                "sense_id": "0873ef1a-4cac-3e04-b1db-34fe88d0bff1",
                                "text": "Все рукописи перемешались, ничего найти не могу."
                            }
                        ]
                    },
                    {
                        "sense_id": "7844af42-3c24-3c1b-bc2f-9f84d1f6dc63",
                        "entry_id": "4b4979f8-f7ec-39cc-b974-383b482332c7",
                        "glosses": [
                            "перен. перепутаться, стать хаотическим, неясным, беспорядочным (о мыслях, впечатлениях)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e633a29f-d85c-47f6-a440-5ea5c4fe19ed",
                                "sense_id": "7844af42-3c24-3c1b-bc2f-9f84d1f6dc63",
                                "text": "Всё у него в голове перемешалось."
                            }
                        ]
                    }
                ],
