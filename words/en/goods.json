                },
                {
                    "sense_id": "d87902f8-2a0a-31fc-8127-707e73637bd1",
                    "sense_definition": "Authentic information, especially incriminating evidence about someone, or the expected results.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "idiom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective finally managed to get the <w>goods</w> on the suspect.",
                            "target_lang_translations": {
                                "ru": "Детективу наконец удалось найти <w>компромат</w> на подозреваемого.",
                                "cs": "Detektivovi se nakonec podařilo získat na podezřelého <w>důkazy</w>.",
                                "tr": "Dedektif sonunda şüpheli hakkındaki <w>delilleri</w> elde etmeyi başardı."
                            }
                        },
                        {
                            "text": "We need a manager who can really deliver the <w>goods</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужен менеджер, который действительно может показать <w>результат</w>.",
                                "cs": "Potřebujeme manažera, který dokáže opravdu <w>přinést výsledky</w>.",
                                "tr": "Gerçekten beklenen <w>sonucu</w> verebilecek bir yöneticiye ihtiyacımız var."
                            }
                        }
                    ],
                    "synonyms": [
                        "evidence",
                        "fact"
                    ],
                    "common_phrases": [
                        "deliver the goods",
                        "get the goods on"
