{
    "word_family": [
        "dissembler",
        "dissemblance",
        "dissemblingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0c8dc86d-655f-378a-a230-c24479b1cce3",
                    "sense_definition": "To hide one's true motives, feelings, or beliefs by pretending they are different.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician had to <w>dissemble</w> his true intentions to gain the support of the conservative voters.",
                            "target_lang_translations": {
                                "ru": "Политику пришлось <w>скрывать</w> свои истинные намерения, чтобы заручиться поддержкой консервативных избирателей."
                            }
                        },
                        {
                            "text": "She found it difficult to <w>dissemble</w> her disappointment when she learned she did not get the promotion.",
                            "target_lang_translations": {
                                "ru": "Ей было трудно <w>скрыть</w> свое разочарование, когда она узнала, что не получила повышения."
                            }
                        }
                    ],
                    "antonyms": [
                        "reveal",
                        "disclose",
                        "expose"
                    ],
                    "common_phrases": [
                        "dissemble one's feelings",
                        "dissemble true intentions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрывать свои истинные мотивы, чувства или убеждения, притворяясь кем-то другим или демонстрируя иное отношение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицемерить",
                                "target_lang_sense_clarification": "быть неискренним"
                            },
                            {
                                "target_lang_word": "притворяться",
                                "target_lang_sense_clarification": "принимать ложный вид"
                            },
                            {
                                "target_lang_word": "кривить душой",
                                "target_lang_sense_clarification": "говорить не то, что думаешь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e4f4103-4d3a-3de8-87f3-286af2f5b4be",
                    "sense_definition": "To disguise or conceal the real nature of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>dissemble</w> his grief with a forced smile during the dinner party.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>замаскировать</w> свое горе натянутой улыбкой во время званого ужина."
                            }
                        },
                        {
                            "text": "The spy was trained to <w>dissemble</w> his identity while working deep undercover in a foreign country.",
                            "target_lang_translations": {
                                "ru": "Шпиона учили <w>скрывать</w> свою личность во время глубокого внедрения в чужой стране."
                            }
                        }
                    ],
                    "antonyms": [
                        "manifest",
                        "display"
                    ],
                    "common_phrases": [
                        "dissemble the truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маскировать или утаивать истинную природу чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрывать",
                                "target_lang_sense_clarification": "делать незаметным или неизвестным"
                            },
                            {
                                "target_lang_word": "утаивать",
                                "target_lang_sense_clarification": "не разглашать правду"
                            },
                            {
                                "target_lang_word": "маскировать",
                                "target_lang_sense_clarification": "скрывать под внешним видом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf1333a3-03da-3f5f-8b59-af94e0ae0eee",
                    "sense_definition": "To feign or simulate a state or condition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feigning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exhausted soldier attempted to <w>dissemble</w> sleep to avoid being picked for the night watch.",
                            "target_lang_translations": {
                                "ru": "Измученный солдат попытался <w>притвориться</w> спящим, чтобы его не выбрали для ночного караула."
                            }
                        },
                        {
                            "text": "She would often <w>dissemble</w> illness whenever she wanted to avoid attending social gatherings.",
                            "target_lang_translations": {
                                "ru": "Она часто <w>симулировала</w> болезнь, когда хотела избежать посещения светских мероприятий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dissemble sleep",
                        "dissemble an illness"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with an object representing the state being feigned"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Симулировать или имитировать определенное состояние или условие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притворяться",
                                "target_lang_sense_clarification": "симулировать состояние"
                            },
                            {
                                "target_lang_word": "симулировать",
                                "target_lang_sense_clarification": "создавать видимость болезни или сна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0c9b8ac-29c5-3281-90d1-1f0e2f059cde",
                    "sense_definition": "To deliberately ignore something or pretend not to notice it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ignoring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was easier for the manager to <w>dissemble</w> the minor infractions than to file a formal report.",
                            "target_lang_translations": {
                                "ru": "Менеджеру было проще <w>проигнорировать</w> мелкие нарушения, чем подавать официальный отчет."
                            }
                        },
                        {
                            "text": "He chose to <w>dissemble</w> the insult and continued the conversation as if nothing had happened.",
                            "target_lang_translations": {
                                "ru": "Он предпочел <w>не заметить</w> оскорбление и продолжил разговор так, будто ничего не произошло."
                            }
                        }
                    ],
                    "synonyms": [
                        "ignore",
                        "disregard",
                        "neglect",
                        "shrug off"
                    ],
                    "antonyms": [
                        "notice",
                        "acknowledge"
                    ],
                    "common_phrases": [
                        "dissemble a slight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно игнорировать что-либо или делать вид, что не замечаешь этого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игнорировать",
                                "target_lang_sense_clarification": "умышленно не замечать"
                            },
                            {
                                "target_lang_word": "делать вид, что не замечаешь",
                                "target_lang_sense_clarification": "пренебрегать чем-либо"
                            },
                            {
                                "target_lang_word": "оставлять без внимания",
                                "target_lang_sense_clarification": "не реагировать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
