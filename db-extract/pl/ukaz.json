                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41580e3d-b675-4db0-81f4-dd8746940d08",
                                                "sense_id": "6441b116-26d2-3dad-9b31-17d10dad57fa",
                                                "text": "Am nächsten Tag wurde der Ukas öffentlich ausgehängt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2c85f1ae-d388-3efc-af1c-56adf6ebebc8",
                                        "entry_id": "3b20db6b-ece3-3853-942c-1910726a473e",
                                        "glosses": [
                                            "Erlass des (russischen) Zaren bzw. allgemeiner Obrigkeiten in Russland und der Sowjetunion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8026dfe9-28b2-4e40-9f11-5e7060993585",
                                                "sense_id": "2c85f1ae-d388-3efc-af1c-56adf6ebebc8",
                                                "text": "„Nach einem weiteren Fall 1816 in Hrodna verbot Zar Alexander I. mit einem Ukas am 6. März 1817, Juden künftig ohne hinreichende Indizien und nur wegen der abergläubischen Ritualmordlegende anzuklagen.“"
                                            },
                                            {
                                                "example_id": "badce5e4-233b-44cc-9200-7b8bd720f609",
                                                "sense_id": "2c85f1ae-d388-3efc-af1c-56adf6ebebc8",
                                                "text": "„Wäre der damalige Kultusminister ein witziger und boshafter Mann gewesen, dann hätte er mit Vergnügen den Antrag der Rabbiner in einen zaristischen Ukas verwandelt und damit mit einem Schlag das kulturelle Leben der jüdischen Gemeinden vernichtet.“"
                                            },
                                            {
                                                "example_id": "876ce462-7709-43d2-b91d-d2b30f154dac",
                                                "sense_id": "2c85f1ae-d388-3efc-af1c-56adf6ebebc8",
                                                "text": "„Es ist Tatsache, daß man zu meiner Zeit an der Unfehlbarkeit eines Ukas nicht zweifeln durfte; wer es wagte, einen Ukas, wie man dort einen Erlaß nennt, für undurchführbar zu halten, wurde der Majestätsbeleidigung beschuldigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
