                "senses": [
                    {
                        "sense_id": "8ceb4bae-a31e-3255-9eda-f9c7d3c6a7f8",
                        "entry_id": "a4d6e9b5-9be6-377a-a34e-6884c5746bdc",
                        "glosses": [
                            "Knappheit an freien Wohnungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "925a9432-4949-4a2f-b349-bd76d61ef3a9",
                                "sense_id": "8ceb4bae-a31e-3255-9eda-f9c7d3c6a7f8",
                                "text": "„Was die soziale Wirklichkeit der DDR in ihren späten Jahren vor allem kennzeichnete, waren häufige Altersarmut und grassierende Wohnungsnot, wachsender Pflegenotstand und die zunehmende Überforderung des Gesundheitswesens.“"
                            },
                            {
                                "example_id": "9655acd2-76bb-47c6-adb1-a9c573796a48",
                                "sense_id": "8ceb4bae-a31e-3255-9eda-f9c7d3c6a7f8",
                                "text": "„Warum, fragt er, müssten in Zeiten der Wohnungsnot drei Bauhaus-Museen gebaut werden?“"
                            },
                            {
                                "example_id": "c8b988d1-0972-4938-897c-8ce421c8b49e",
                                "sense_id": "8ceb4bae-a31e-3255-9eda-f9c7d3c6a7f8",
                                "text": "„Die Ruinen verchwanden nach und nach, die Wohnungsnot ebbte ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
