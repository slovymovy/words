                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6724a7d9-b5a0-4981-a9b3-653e27105733",
                                "sense_id": "e11bb114-2dd4-3d74-8c9f-c5c8d086663e",
                                "text": "„An der Wurzelspitze hat sich auf Grund einer Kanalverzweigung ein Entzündungsprozeß gebildet.“"
                            },
                            {
                                "example_id": "7e9615df-82a4-480e-b31a-11789805e6c2",
                                "sense_id": "e11bb114-2dd4-3d74-8c9f-c5c8d086663e",
                                "text": "„Ansicht der Kanalverzweigung zur 2. Fahrt Lüdinghausen-Senden, Hintergrund die beiden Berenbrocker-Brücken.“"
                            },
                            {
                                "example_id": "3f0921c1-de85-41a1-9ccf-711f9911d855",
                                "sense_id": "e11bb114-2dd4-3d74-8c9f-c5c8d086663e",
                                "text": "„Die Fühler sollten nicht in turbulenzreichen Zonen wie Kanalverzweigungen plaziert werden.“"
                            },
                            {
                                "example_id": "74f808f4-3efb-4787-b426-69374290fc0b",
                                "sense_id": "e11bb114-2dd4-3d74-8c9f-c5c8d086663e",
                                "text": "„Durch die nachfolgende Bildung von Kanalverzweigungen wird die Schmelze fragmentiert und erstarrt in Form eines porösen Festkörpers.“"
                            }
                        ],
