                "senses": [
                    {
                        "sense_id": "58d02528-8178-3918-a3c3-6bb01d812196",
                        "entry_id": "1e273ff5-b326-3d82-8d2d-c85a780f3cc0",
                        "glosses": [
                            "Small pastries filled with finely chopped meat, vegetables or fruit baked or fried, from eastern European cuisine, or a serving of these."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "97e07f91-1e67-4f60-a31e-0387dd8642ea",
                                "sense_id": "58d02528-8178-3918-a3c3-6bb01d812196",
                                "text": "Nica handed Mark a pirazhok.\nMaybe from the extra excitement, maybe because the pirozhki really were delicious, she swallowed them both immediately."
                            },
                            {
                                "example_id": "932235c9-7c0d-43b8-bb4d-cd87b7ec5ae2",
                                "sense_id": "58d02528-8178-3918-a3c3-6bb01d812196",
                                "text": "I have found that, at every reception or cocktail party given at our embassy, pirozhki is a favourite, second only to our Russian caviar and vodka."
                            },
                            {
                                "example_id": "268ea5db-634f-4f31-a3ac-3efee62ac160",
                                "sense_id": "58d02528-8178-3918-a3c3-6bb01d812196",
                                "text": "In the morning the people wished Yefim good-speed; they loaded him with pirozhki for his journey, and they went to their work: and Yefim started on his way."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d99f733-1955-33aa-b708-24ad8a0aeb75",
                        "entry_id": "1e273ff5-b326-3d82-8d2d-c85a780f3cc0",
                        "glosses": [
                            "A single such pastry."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f52ac698-6804-4d52-982d-6e5849442844",
                        "source_entry_id": "1e273ff5-b326-3d82-8d2d-c85a780f3cc0",
                        "source_sense_description": "small pastries",
                        "target_lang_word": "pirojki",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pirojki",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69124d98-be7d-39ca-957d-e803028a5d1f",
                                        "entry_id": "f132dbdf-d357-3cf5-a3a3-28082e41d08b",
                                        "glosses": [
                                            "Pâte fourrée d'ingrédients variés : viande et oignons, pommes de terre et œufs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c1e408f-40d1-453f-a6b5-a9b17e640a7e",
                                                "sense_id": "69124d98-be7d-39ca-957d-e803028a5d1f",
                                                "text": "– Passons chez l’Arménien. Nous lui achèterons des pirojki, de la vodka, nous ferons un repas russe à tout casser !"
                                            },
                                            {
                                                "example_id": "8bc037e4-77ce-4567-8c72-1ff10d2c3d9e",
                                                "sense_id": "69124d98-be7d-39ca-957d-e803028a5d1f",
                                                "text": "Il consultait la carte. Blinis et caviar. Du Krug. Quelques pirojki en attendant."
                                            },
                                            {
                                                "example_id": "bb386bee-7109-4369-9b8b-471f7c27f504",
                                                "sense_id": "69124d98-be7d-39ca-957d-e803028a5d1f",
                                                "text": "Il y baigne dans ses souvenirs du Quartier latin, et nous dans l'odeur de chou. On nous y sert un bortch où de rares légumes nagent dans l'eau chaude et des pirojkis rassis, mais au son des balalaïkas, dans un décor à la Boris Godounov."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pirojki",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39120221-dbeb-3c51-a0e9-84c8fa63c1d1",
                                        "entry_id": "974b55d5-486c-39c1-8faf-08606f2ec833",
                                        "glosses": [
                                            "Pluriel de pirojok."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afd7c8a8-cce0-47c4-a622-67377ade2de1",
                        "source_entry_id": "1e273ff5-b326-3d82-8d2d-c85a780f3cc0",
                        "source_sense_description": "small pastries",
                        "target_lang_word": "Pirogge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pirogge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb82aadf-8361-3f05-b25c-62adf81f8239",
                                        "entry_id": "8aa8ad83-662c-3045-9612-023e4e8ad15f",
                                        "glosses": [
                                            "gefüllte Teigtasche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66eb8706-69c4-427b-b101-2ef72c5fb020",
                                                "sense_id": "cb82aadf-8361-3f05-b25c-62adf81f8239",
                                                "text": "„Wir bekommen Mittagessen, ausgezeichnetes gebratenes Hammelfleisch und ausgezeichnete Suppe, hinterher bekommen wir sogar delikate Piroggen.“"
                                            },
                                            {
                                                "example_id": "d9cd9914-d259-4b49-8ac1-c642b6a7e96f",
                                                "sense_id": "cb82aadf-8361-3f05-b25c-62adf81f8239",
                                                "text": "„Es gab Piroggi mit saurer Sahne und zerlassener Butter.“"
                                            },
                                            {
                                                "example_id": "92e6711e-3f0e-4577-8572-1dfab9fb36b0",
                                                "sense_id": "cb82aadf-8361-3f05-b25c-62adf81f8239",
                                                "text": "„Zuletzt gibt es auch Piroggi, die polnische Nudeln, auf der Karte! Schön.“"
                                            },
                                            {
                                                "example_id": "7b9ab86b-f6f7-42e3-98f7-1fffd7524d21",
                                                "sense_id": "cb82aadf-8361-3f05-b25c-62adf81f8239",
                                                "text": "„Alik: ‚[…] Nach der Pirogge ißt man nicht Suppe.‘ […] VI.: ‚Ich esse aber lieber zuerst Pirogge.‘ Walja (verwirrt): ‚Alik, gib Jelena Abramowna Pirogge.‘ Alik (lachend): ‚Wer die Suppe nicht ißt, bekommt auch keine Pirogge.‘ […] Walja: ‚[…] Die Pirogge muß ich noch fertig machen.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
