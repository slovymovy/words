    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ee1c1f7-96a3-3637-9add-0e0690cabee1",
                    "sense_definition": "A witty, smart, or sarcastic remark or comeback.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quip_joke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She responded to the journalist's rude question with a clever <w>quip</w> that made everyone laugh.",
                            "target_lang_translations": {
                                "nl": "Ze reageerde op de onbeleefde vraag van de journalist met een gevatte <w>kwinkslag</w> die iedereen aan het lachen maakte."
                            }
                        },
                        {
                            "text": "His speech was full of amusing <w>quips</w>, keeping the audience entertained from start to finish.",
                            "target_lang_translations": {
                                "nl": "Zijn toespraak zat vol vermakelijke <w>kwinkslagen</w>, waardoor het publiek van begin tot eind vermaakt bleef."
                            }
                        }
                    ],
                    "synonyms": [
                        "witticism",
                        "wisecrack",
                        "gibe",
                        "retort",
                        "jest"
                    ],
                    "common_phrases": [
                        "clever quip",
                        "witty quip"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gevatte, scherpe of sarcastische opmerking of repliek."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kwinkslag",
                                "target_lang_sense_clarification": "gevatte, grappige opmerking"
                            },
                            {
                                "target_lang_word": "snedige opmerking",
                                "target_lang_sense_clarification": "scherpe, gevatte repliek"
                            },
                            {
                                "target_lang_word": "steekspel",
                                "target_lang_sense_clarification": "verbale spitsvondigheid"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f57629a4-cdce-3111-81f5-f5c1674d7e16",
                    "sense_definition": "To make a witty, clever, or sarcastic remark.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quip_joke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"I guess Monday came early this week,\" he <w>quipped</w> as the meeting dragged on.",
                            "target_lang_translations": {
                                "nl": "\"Maandag is zeker vroeg gekomen deze week,\" <w>grapte</w> hij terwijl de vergadering maar voortsleepte."
                            }
                        },
                        {
                            "text": "She couldn't help but <w>quip</w> about the terrible weather ruining their outdoor party.",
                            "target_lang_translations": {
                                "nl": "Ze kon het niet laten om een gevatte <w>opmerking te maken</w> over het vreselijke weer dat hun buitenfeest verpestte."
                            }
                        }
                    ],
                    "synonyms": [
                        "wisecrack",
                        "joke",
                        "jest"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gevatte, scherpzinnige of sarcastische opmerking maken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "grappen",
                                "target_lang_sense_clarification": "een gevatte grap of opmerking maken"
                            },
                            {
                                "target_lang_word": "opmerken",
                                "target_lang_sense_clarification": "snedig of gevat zeggen"
                            },
                            {
                                "target_lang_word": "een kwinkslag maken",
                                "target_lang_sense_clarification": "gevat reageren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e4e601e-1760-3cf2-877f-7629b3582649",
                    "sense_definition": "To taunt or mock someone with sarcastic remarks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The older boys liked to <w>quip</w> him whenever he made a minor mistake during practice.",
                            "target_lang_translations": {
                                "nl": "De oudere jongens hielden ervan hem te <w>jennen</w> wanneer hij een klein foutje maakte tijdens de training."
                            }
                        },
                        {
                            "text": "He grew accustomed to being <w>quipped</w> by his colleagues about his old-fashioned clothes.",
                            "target_lang_translations": {
                                "nl": "Hij raakte eraan gewend om door zijn collega's te worden <w>bespot</w> over zijn ouderwetse kleding."
                            }
                        }
                    ],
                    "synonyms": [
                        "taunt",
                        "jeer",
                        "mock",
                        "gibe"
                    ],
                    "traits": [
