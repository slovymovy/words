    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0a64e521-fb93-3b5f-920c-d20041fe559e",
                "word": "unread",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4c94c1b5-35c3-3227-8350-51f3a160ea03",
                        "entry_id": "0a64e521-fb93-3b5f-920c-d20041fe559e",
                        "glosses": [
                            "Not having been read."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "70c6a0fc-6139-4e51-9d1e-bd0fbd8ea017",
                                "sense_id": "4c94c1b5-35c3-3227-8350-51f3a160ea03",
                                "text": "1700, Charles Hopkins, The Art of Love, (after Ovid’s Ars Amatoria), London: Joseph Wild, “The Muse,” p. 36,\nAt first, perhaps, unread your Note’s return’d,\nYour Person slighted, and your Passion scorn’d."
                            },
                            {
                                "example_id": "610d5bd5-c557-4d21-856b-08d6ea854ac1",
                                "sense_id": "4c94c1b5-35c3-3227-8350-51f3a160ea03",
                                "text": "‘PRIVATE: for the hands of J. G. Utterson ALONE and in case of his predecease to be destroyed unread,’ so it was emphatically superscribed; and the lawyer dreaded to behold the contents."
                            },
                            {
                                "example_id": "3c265d84-b0c1-4104-ae9b-856a3f714957",
                                "sense_id": "4c94c1b5-35c3-3227-8350-51f3a160ea03",
                                "text": "The book I got for my 18th birthday remained unread until my retirement."
                            }
                        ]
                    },
                    {
                        "sense_id": "11782d8f-eba1-3880-a8f0-3bde8b939f4e",
                        "entry_id": "0a64e521-fb93-3b5f-920c-d20041fe559e",
                        "glosses": [
                            "Not having read; uneducated."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "fb4e4d4a-0295-441c-933a-54f51f65c9a7",
                                "sense_id": "11782d8f-eba1-3880-a8f0-3bde8b939f4e",
                                "text": "In fortune’s love […] the bold and coward,\nThe wise and fool, the artist and unread,\nThe hard and soft seem all affined and kin:\nBut, in the wind and tempest of her frown,\nDistinction, with a broad and powerful fan,\nPuffing at all, winnows the light away;"
                            },
                            {
                                "example_id": "0c4bf66c-13fd-449f-8a6d-2fa24d48697c",
                                "sense_id": "11782d8f-eba1-3880-a8f0-3bde8b939f4e",
                                "text": "1796, Elizabeth Inchbald, Nature and Art, Dublin: P. Wogan et al., Chapter 22, p. 111,\nThe only child of two doating parents, she never had been taught the necessity of resignation—untutored, unread, unused to reflect, but knowing how to feel […]"
                            },
                            {
                                "example_id": "468a467a-f569-4f84-bb5d-68615ea8d769",
                                "sense_id": "11782d8f-eba1-3880-a8f0-3bde8b939f4e",
                                "text": "1890, Frances Willard, Address before the Seventeenth Convention of the World Woman’s Christian Temperance Union at Atlanta, Georgia, in William Jennings Bryan (editor), The World’s Famous Orations, New York: Funk & Wagnalls, 1906, Volume 10, p. 162,\n[…] only those unread in the biography of genius imagine themselves to be original."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8679792-71fe-4e47-83fa-90e2f1c5c972",
                        "source_entry_id": "0a64e521-fb93-3b5f-920c-d20041fe559e",
                        "source_sense_description": "not having been read",
                        "target_lang_word": "ongelezen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongelezen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c941c1c6-5b10-367c-854f-f2e74e07f580",
                                        "entry_id": "eec9e1a2-7b10-3ed6-88f8-74e54cbf83f2",
                                        "glosses": [
                                            "van een tekst dat die tekst niet gelezen is en waarvan de inhoud dus onbekend is gebleven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebdf6105-78fd-4756-bda1-f3f7b2c5ba50",
                                                "sense_id": "c941c1c6-5b10-367c-854f-f2e74e07f580",
                                                "text": "Het boek had vele jaren ongelezen in de boekenkast gestaan."
                                            },
                                            {
                                                "example_id": "b5bf50af-5a88-4b3f-9395-647c2fe9cc5b",
                                                "sense_id": "c941c1c6-5b10-367c-854f-f2e74e07f580",
                                                "text": "Dodsworth was de film waar Astor aan werkte tijdens haar beruchte rechtszaak. De lange arm van de filmstudio’s reikte ver in die jaren: Louis B. Mayer van MGM wilde koste wat kost voorkomen dat het dagboek naar buiten zou komen en een hernieuwde campagne tegen de morele verdorvenheid van Hollywood zou losmaken. Mayer had goede banden met de rechter in de zaak, Goodwin Knight, die niet toestond dat het dagboek werd ingebracht als bewijsmateriaal. Het verdween achter slot en grendel en werd twintig jaar later ongelezen verbrand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ae24b47-1629-473f-86a9-9ff0fa0801c6",
