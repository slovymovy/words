                "senses": [
                    {
                        "sense_id": "669c4c8e-58fd-30b2-9f4a-581545f574cf",
                        "entry_id": "1079b3f9-345f-3e0e-a6cc-de93e793a7f0",
                        "glosses": [
                            "Kleid, das anlässlich eines Trauerfalls getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9332bdd-4f7b-4741-9d82-73a3f045098a",
                                "sense_id": "669c4c8e-58fd-30b2-9f4a-581545f574cf",
                                "text": "„Als es Essenszeit war, führte der Wirt diesen Fremden in einen schönen tapezierten Saal. Man trug auf, und alsbald kam unter den Tapeten das schönste Frauenzimmer von der Welt hervorgetreten, aber mit einem kahlbeschornen Haupte und in einem nach deutscher Manier gemachten schwarzen Trauerkleide.“"
                            },
                            {
                                "example_id": "b831200b-f8ff-43f0-b869-e37431df0159",
                                "sense_id": "669c4c8e-58fd-30b2-9f4a-581545f574cf",
                                "text": "„In diesem Augenblick kam ein Mann heran, der wie ein Stier aussah, der Trauerkleider trug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
