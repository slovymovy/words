                "senses": [
                    {
                        "sense_id": "ee4c8244-7c36-30e2-8924-b6a4b5311a9b",
                        "entry_id": "1c0c4752-5bff-3568-bedd-d18cdf10b7df",
                        "glosses": [
                            "Dispositif pour éviter le brouillage des signaux directionnels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5a4c158-7531-4e96-ae73-c5112950e74f",
                                "sense_id": "ee4c8244-7c36-30e2-8924-b6a4b5311a9b",
                                "text": "Ce missile, équipé d'une charge creuse en tandem, possède des moyens électroniques d'antibrouillage."
                            },
                            {
                                "example_id": "60f5e9d0-8dcb-475b-8d4c-ceaf54cdb885",
                                "sense_id": "ee4c8244-7c36-30e2-8924-b6a4b5311a9b",
                                "text": "5 septembre 1941 – Nous étions groupés autour du poste, le cadre antibrouillage en bonne place quand brusquement, un coup de poing d’une fameuse violence a ébranlé la fenêtre et une voix allemande a crié quelque chose."
                            },
                            {
                                "example_id": "e4dbdc5e-4598-4126-b523-b12bfdc73b3e",
                                "sense_id": "ee4c8244-7c36-30e2-8924-b6a4b5311a9b",
                                "text": "Elles étaient destinées aux télécommunications militaires, une conséquence naturelle d’une guerre électronique de brouillage et d’antibrouillage, mais aussi aux systèmes guidés."
                            }
                        ]
                    }
