                "senses": [
                    {
                        "sense_id": "d7cee276-f501-3a02-953e-9a8a5a584e20",
                        "entry_id": "db3e59b9-ea1a-3ee5-bbee-f27a9fdfd458",
                        "glosses": [
                            "Très pauvre, qui confine à la misère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c03dd35-6437-499c-82ff-bf716598925d",
                                "sense_id": "d7cee276-f501-3a02-953e-9a8a5a584e20",
                                "text": "Maman retrouva du travail chez des frères noirs, pour un salaire crève-la-dalle, mais elle était fière de participer au développement du Cameroun et de payer sa quote-part à l’indépendance tcha-tcha."
                            },
                            {
                                "example_id": "1448cb1b-d18d-4bf5-a9dc-688113aa4ba8",
                                "sense_id": "d7cee276-f501-3a02-953e-9a8a5a584e20",
                                "text": "A vrai dire, après plus d’un demi-siècle d’attente, il y a bien mieux à proposer aux peuples et pays africains que des miettes, de petits projets crève-la-dalle à grignoter …"
                            }
                        ]
                    }
                ],
