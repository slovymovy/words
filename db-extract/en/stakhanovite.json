                        "translation_id": "fc3da1c3-3f48-4497-b03e-5d2ccf3baa5e",
                        "source_entry_id": "0db3403b-5032-371a-8a27-ca583e67af10",
                        "source_sense_id": "f3c1585c-b572-36ee-b962-dc3a46688cf9",
                        "source_sense_description": "(USSR) pertaining to a Stakhanovite; heroically hard-working",
                        "target_lang_word": "stakhanoviste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stakhanoviste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99a7276c-1251-330e-803c-99509329fe65",
                                        "entry_id": "630bd2c1-7316-3890-a336-2643f453c582",
                                        "glosses": [
                                            "Relatif au stakhanovisme, à l’apologie du travail intensif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df443072-e33a-48cb-9319-ee70c6ed4e88",
                                                "sense_id": "99a7276c-1251-330e-803c-99509329fe65",
                                                "text": "Ces acteurs stakhanovistes qui monopolisent les écrans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stakhanoviste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61e7ee91-de61-31e3-b0aa-59765eeda35d",
                                        "entry_id": "1bebb75f-e83d-31e7-b670-919df382e86c",
                                        "glosses": [
                                            "Travailleur de l’URSS, dévoué à son travail et très productif, modèle du stakhanovisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd6b3b8-ccee-4923-a42c-47e446c1a1cf",
                                                "sense_id": "61e7ee91-de61-31e3-b0aa-59765eeda35d",
                                                "text": "Dans une des usines que nous visitons, qui fonctionne à merveille […] on me présente un stakhanoviste, dont j’avais vu le portrait énorme affiché sur le mur. Il est parvenu me dit-on, à faire en cinq heures le travail de huit jours […]. Je me hasarde à demander si cela ne revient pas à dire que, d’abord, il mettait huit jours à faire le travail de cinq heures ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c9a0891-f36e-3f6f-a702-7c5ddbf32b59",
                                        "entry_id": "1bebb75f-e83d-31e7-b670-919df382e86c",
                                        "glosses": [
                                            "Travailleur acharné."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b5bbe3b-5548-4df0-a42d-f72d69fdfe4b",
                                                "sense_id": "9c9a0891-f36e-3f6f-a702-7c5ddbf32b59",
                                                "text": "Lorsqu’elle arrive à l’abattoir, usée par trois ans de service, cette stakhanoviste de la mise bas a passé la moitié de sa vie dans un box minuscule, avec pour seule occupation de lécher les barreaux de sa cage et de se charger en métaux lourds. — (« Truies : Le porc de l’angoisse », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 81)"
                                            },
                                            {
                                                "example_id": "968fe639-8f2e-4720-b411-ac3f1727d929",
                                                "sense_id": "9c9a0891-f36e-3f6f-a702-7c5ddbf32b59",
                                                "text": "Triplement étoilé depuis vingt ans, désigné cinq fois « meilleure table du monde », à 69 ans, le chef isérois est un stakhanoviste du travail bien fait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
