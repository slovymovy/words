                                        "sense_id": "b51ba7ca-3975-3a2d-82f4-78a810c81683",
                                        "entry_id": "98897398-94bb-3a37-90cd-02f72ac556db",
                                        "glosses": [
                                            "A country on the Balkan Peninsula in Southeast Europe. Official name: Republic of Croatia. Capital and largest city: Zagreb. Part of Yugoslavia until 1991."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e74b84c-49df-4972-ac94-7b9d3bf10598",
                                                "sense_id": "b51ba7ca-3975-3a2d-82f4-78a810c81683",
                                                "text": "The violence began when Serbian troops went into Croatia ostensibly to aid armed ethnic Serbians trying to create their own autonomous states there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
