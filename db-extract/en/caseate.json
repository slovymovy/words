                        "glosses": [
                            "To undergo caseation, a necrotic degeneration into a cheese-like state."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a71d4290-6eed-40f2-9c51-800206ab2c07",
                                "sense_id": "c8140b58-8d57-35fc-b75b-a08534de181f",
                                "text": "But very commonly the cell-growth degenerates, breaks down into pus, or caseates and perhaps subsequently softens."
                            },
                            {
                                "example_id": "01cad4c1-48f0-46cc-a031-bd7f1297f81d",
                                "sense_id": "c8140b58-8d57-35fc-b75b-a08534de181f",
                                "text": "Extensive lumpy infiltrates with a tendency to caseate and to form fistulas with purulent secretions appear, mainly in the anogenital region."
                            }
                        ]
                    }
                ],
