                "senses": [
                    {
                        "sense_id": "bddd2be4-50be-3a2e-b7e7-3f2e4a226a0a",
                        "entry_id": "68f0bea0-a494-37ee-adfc-22ce682d14e4",
                        "glosses": [
                            "A wavy underline used to indicate an error in text or source code."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "1bedeec0-6703-4020-9190-05d5ed27b16f",
                                "sense_id": "bddd2be4-50be-3a2e-b7e7-3f2e4a226a0a",
                                "text": "If you have dynamic spell checking enabled, your pamphlet will become a sea of red squigglies."
                            },
                            {
                                "example_id": "867aae3b-08f7-43f0-88e6-45b9c1f0170c",
                                "sense_id": "bddd2be4-50be-3a2e-b7e7-3f2e4a226a0a",
                                "text": "Coding errors have colored squigglies beneath them to indicate the kind of error. For example, syntax errors appear with red squigglies beneath them..."
                            },
                            {
                                "example_id": "2725a3e4-dd52-44db-991f-974e86392126",
                                "sense_id": "bddd2be4-50be-3a2e-b7e7-3f2e4a226a0a",
                                "text": "The next blue squiggly is in the word Dimm. That should be an easy fix. Change it to Dim. Again, that swats two bugs with one fix."
                            }
                        ]
                    }
