                                        "sense_id": "e63bbe4c-c5da-3c8c-aa26-a410a46f502a",
                                        "entry_id": "cfde940d-e245-36a4-9cb5-6866050062c4",
                                        "glosses": [
                                            "Willing to comply with the commands, orders, or instructions of those in authority; biddable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cec5ad2-fe91-4fd8-84e1-f25fcb367d10",
                                                "sense_id": "e63bbe4c-c5da-3c8c-aa26-a410a46f502a",
                                                "text": "Jessica was so intensely obedient of her parents that her brother sometimes thought she was a robot."
                                            }
