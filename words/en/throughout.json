        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "4b346e16-4a72-30cf-9c0f-209bb7039991",
                    "sense_definition": "In every part of a place or during the whole of a period of time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "extent_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Snow fell heavily <w>throughout</w> the night, covering the roads completely.",
                            "target_lang_translations": {
                                "ru": "Снег сильно шел <w>всю</w> ночь, полностью покрывая дороги.",
                                "tr": "Gece <w>boyunca</w> yoğun kar yağdı ve yolları tamamen kapladı.",
                                "zh": "雪<w>整</w>夜下个不停，把道路完全覆盖了。"
                            }
                        },
                        {
                            "text": "There are small coffee shops located <w>throughout</w> the city center.",
                            "target_lang_translations": {
                                "ru": "Небольшие кофейни расположены <w>по всему</w> центру города.",
                                "tr": "Şehir merkezinin <w>her yerinde</w> küçük kafeler yer almaktadır.",
                                "zh": "市中心<w>遍布</w>着小型咖啡馆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "across",
                        "during",
                        "all through",
                        "all over"
                    ],
                    "common_phrases": [
