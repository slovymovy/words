        "ru-extract.jsonl": [
            {
                "entry_id": "01a47826-496a-3a77-8e00-c1e6496ecbbe",
                "word": "явственно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9990dde1-09bd-326a-a807-a9d1a7a0632f",
                        "entry_id": "01a47826-496a-3a77-8e00-c1e6496ecbbe",
                        "glosses": [
                            "книжн. наречие к явственный; чётко, отчётливо, несомненно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "78b78cc8-858b-4320-a5ed-f34c0bbe233a",
                                "sense_id": "9990dde1-09bd-326a-a807-a9d1a7a0632f",
                                "text": "Поднялся ропот, и я услышал явственно слово: молокосос, произнесенное кем-то вполголоса."
                            },
                            {
                                "example_id": "bfe10c4f-96af-41c6-9f5b-d0449d8823dc",
                                "sense_id": "9990dde1-09bd-326a-a807-a9d1a7a0632f",
                                "text": "Быстрые, лёгкие, но осторожные шаги явственно раздавались в саду."
                            },
                            {
                                "example_id": "1ab3e019-3693-4965-aa8e-0b75af805157",
                                "sense_id": "9990dde1-09bd-326a-a807-a9d1a7a0632f",
                                "text": "Опять надвинулся туман, и вдруг из этого тумана, начиная с белых, кверху приподнятых волос, явственно стала вырисовываться голова старика Дессерта!"
                            },
                            {
                                "example_id": "28686623-474d-4093-afc5-10e3b7468cc3",
                                "sense_id": "9990dde1-09bd-326a-a807-a9d1a7a0632f",
                                "text": "Он взял руку — она была бледна, холодна, синие жилки на ней видны явственно."
                            }
                        ]
                    }
                ],
