                    "frequency": "High",
                    "semantic_group_id": "sentiments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants du village nous ont réservé un accueil très <w>chaleureux</w> dès notre arrivée."
                        },
                        {
                            "text": "Elle a adressé des remerciements <w>chaleureux</w> à tous les invités présents à la fête."
                        }
                    ],
                    "synonyms": [
                        "accueillant",
                        "amical",
                        "bienveillant",
                        "cordial"
                    ],
                    "antonyms": [
                        "distant",
                        "froid",
                        "glacial"
                    ],
                    "common_phrases": [
