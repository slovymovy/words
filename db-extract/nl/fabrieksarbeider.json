                "translations": [
                    {
                        "translation_id": "9733c678-37b7-47f3-9ad2-fffa54b4e3ac",
                        "source_entry_id": "1b70bac3-e745-3004-b3ec-9d2682bd5ffe",
                        "source_sense_id": "9fb0ffa7-e4b8-394e-857b-c4ecbe6c01aa",
                        "target_lang_word": "Fabrikarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fabrikarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fee45bc-f972-389d-974f-9f394d370fa5",
                                        "entry_id": "600d4975-dda2-3f10-bf74-45463a28e703",
                                        "glosses": [
                                            "jemand, der in einer Fabrik als Arbeiter beschäftigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c6e3f7-ad14-4833-8553-bd33a54b62a2",
                                                "sense_id": "5fee45bc-f972-389d-974f-9f394d370fa5",
                                                "text": "„Die neuen Arbeiter sind im Gegensatz zum traditionellen Fabrikarbeiter natürlich viel qualifizierter, sie werden künftig auch eine stärkere Verhandlungsmacht im Unternehmen haben, da ihr Einfluss auf den Produktionsprozess steigt.“"
                                            },
                                            {
                                                "example_id": "333f4673-7d8f-40f7-998b-99f13760703d",
                                                "sense_id": "5fee45bc-f972-389d-974f-9f394d370fa5",
                                                "text": "„Auf die rigide gegliederte Gesellschaft des Kaiserreichs musste die Verbindung ohnehin brüskierend wirken: Ernst Georg Jünger, Sohn eines Hannoveraner Gymnsiallehrers, entstammt dem Bildungsbürgertum, Lilys Vater ist Fabrikarbeiter, ihre Mutter Bäuerin.“"
                                            },
                                            {
                                                "example_id": "fb4f2f60-1060-417c-a0ba-8ac4a863f3d6",
                                                "sense_id": "5fee45bc-f972-389d-974f-9f394d370fa5",
                                                "text": "„Auf den Bänken vor den Tischen sassen etwa zehn Fabrikarbeiter in dem kleinen schmutzigen Zimmer.“"
                                            },
                                            {
                                                "example_id": "160704bf-53e0-463f-b88c-071b2e17e8cc",
                                                "sense_id": "5fee45bc-f972-389d-974f-9f394d370fa5",
                                                "text": "„Er wurde Verkäufer, Tagelöhner, Knecht, Lastträger und Fabrikarbeiter.“"
                                            },
                                            {
                                                "example_id": "e1df83ed-a091-4688-a422-7af0a47e46db",
                                                "sense_id": "5fee45bc-f972-389d-974f-9f394d370fa5",
                                                "text": "„Seinen Wahlerfolg in Westpakistan 1970 verdankte er vor allem den Stimmen der Landlosen, Fabrikarbeiter und Handwerker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
