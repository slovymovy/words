                "senses": [
                    {
                        "sense_id": "dc3f82d5-491f-32fe-a313-3b7f5df55321",
                        "entry_id": "597dba36-b8d2-33e7-bba1-e56bb1c29127",
                        "glosses": [
                            "verschiedenfarbiges Gewicht im Kraftsport"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26a2e21d-2304-41cd-aa51-08be8ae9f65c",
                                "sense_id": "dc3f82d5-491f-32fe-a313-3b7f5df55321",
                                "text": "Jeweils eine Hantelscheibe, die 2 kg oder weniger wiegt, wird außerhalb der Verschlussschrauben auf die Hantel aufgeschoben."
                            },
                            {
                                "example_id": "a7be36f1-dbf6-4a09-98b5-0e07b7757630",
                                "sense_id": "dc3f82d5-491f-32fe-a313-3b7f5df55321",
                                "text": "„Packen Sie die Hantelscheibe mit beiden Händen am oberen Rand und halten Sie sie auf Brusthöhe.“"
                            },
                            {
                                "example_id": "9371b79c-058b-46f4-8e1e-3ccd0564f93b",
                                "sense_id": "dc3f82d5-491f-32fe-a313-3b7f5df55321",
                                "text": "„Um das Band an einem Ende zu beschweren, wenn er es auf den Rasen legte, hatte er von zu Hause eine Hantelscheibe in seiner Sporttasche mitgebracht.“"
                            },
                            {
                                "example_id": "7ae3b4dd-1b62-4e12-8f0d-6b1afba728ee",
                                "sense_id": "dc3f82d5-491f-32fe-a313-3b7f5df55321",
                                "text": "„Der Eigentümer entdeckt, dass zwei türkisblaue Hantelscheiben mit dem Aufdruck ‚City-Studio‘ fehlen, was er sich nicht erklären kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
