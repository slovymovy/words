    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ca683de4-2cad-3768-9a4d-9894787f8c6a",
                "word": "misconception",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4e007b1e-8d8a-461c-8af1-744728e1876b",
                        "entry_id": "ca683de4-2cad-3768-9a4d-9894787f8c6a",
                        "tags": [
                            "plural"
                        ],
                        "form": "misconceptions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3eda9c70-f40b-32d6-bbf8-a95350764886",
                        "entry_id": "ca683de4-2cad-3768-9a4d-9894787f8c6a",
                        "glosses": [
                            "A mistaken belief, a wrong idea."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3fb2cc6f-5d0f-4034-9070-2af59a763a9e",
                                "sense_id": "3eda9c70-f40b-32d6-bbf8-a95350764886",
                                "text": "There are several common misconceptions about the theory of relativity."
                            },
                            {
                                "example_id": "342dec9b-ccfb-4b35-840f-2c38a0aad385",
                                "sense_id": "3eda9c70-f40b-32d6-bbf8-a95350764886",
                                "text": "You're obviously under the misconception that I care about your problems."
                            },
                            {
                                "example_id": "0dd35d7d-abc3-4631-9cf4-6d1458ab17dd",
                                "sense_id": "3eda9c70-f40b-32d6-bbf8-a95350764886",
                                "text": "He had the misconception that the word \"misconception\" meant becoming pregnant with a girl."
                            },
                            {
                                "example_id": "da39fe70-d32c-42e0-856b-e519d8eddf04",
                                "sense_id": "3eda9c70-f40b-32d6-bbf8-a95350764886",
                                "text": "From November 28 to December 8, 1958, the CCP Central Committee held its sixth plenum in Wuhan, Hopei^([sic – meaning Hupei]), and at the end of the session it issued a revealing resolution that declared there had been some misconception about the system and that party committees throughout the countryside should make full use of the five months from December 1958 to April 1959 to tidy up the communes."
                            },
                            {
                                "example_id": "f16a57e8-3ad3-4fc6-ab97-d6aa14eb70ae",
                                "sense_id": "3eda9c70-f40b-32d6-bbf8-a95350764886",
                                "text": "It is a common misconception that anal intercourse is an exclusively homosexual male practice. […] As elsewhere in Africa, little data exist on the role of anal sex in HIV acquisition in women in the general population […]"
                            },
                            {
                                "example_id": "10ced18a-2153-40d1-8100-80a68b6c7c95",
                                "sense_id": "3eda9c70-f40b-32d6-bbf8-a95350764886",
                                "text": "We also found that because of the prevalence of cannabis in serious and fatal crashes, the changes in state laws regarding its legal use, and the public’s misconceptions about its impairing effects on driving, educating drivers on the impairing effects of cannabis use and the illegality of driving under its influence is critical to highway safety."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ae32f1a-b90e-4c2c-806a-19c0b8a4cf1e",
                        "source_entry_id": "ca683de4-2cad-3768-9a4d-9894787f8c6a",
                        "source_sense_id": "3eda9c70-f40b-32d6-bbf8-a95350764886",
                        "source_sense_description": "a mistaken belief",
                        "target_lang_word": "idée erronée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "78fc451b-03c6-4c35-a805-d37431b78338",
                        "source_entry_id": "ca683de4-2cad-3768-9a4d-9894787f8c6a",
                        "source_sense_id": "3eda9c70-f40b-32d6-bbf8-a95350764886",
                        "source_sense_description": "a mistaken belief",
                        "target_lang_word": "Missverständnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Missverständnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                        "entry_id": "b510f009-a394-3a16-8171-6d541f53989e",
                                        "glosses": [
                                            "unabsichtliches falsches Verstehen, falsches Interpretieren einer Handlung oder Aussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f742bd6a-0a02-445d-b33a-9712f1c3d23a",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "Das war ein Missverständnis. Er wollte eine Tafel Schokolade, kein Schokoladengetränk."
                                            },
                                            {
                                                "example_id": "0e21deb6-3de6-426a-8526-e3875716013d",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "„Sehen wir uns zunächst an, wie die Missverständnisse aussehen.“"
                                            },
                                            {
                                                "example_id": "2b963c5b-5f25-4149-b931-d7431f10088b",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "Lass uns erst einmal alle Missverständnisse aus dem Wege räumen."
                                            },
                                            {
                                                "example_id": "f9ed52fd-d53d-4248-b35b-761fc7c9febe",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "Darf ich das Missverständnis aufklären?"
                                            },
                                            {
                                                "example_id": "22329f62-7ed6-46aa-a507-79e649bbbe3e",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "Das muss sich hier um ein Missverständnis handeln, ich habe gar nichts getan."
                                            },
                                            {
                                                "example_id": "4aa08374-e8fa-4b66-b12a-2c1e2b17f691",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "„Gehen wir noch zwei weiteren Missverständnissen aus dem Weg, denn wir reden hier vom Reisen als größerem Vorhaben.“"
                                            },
                                            {
                                                "example_id": "137dc752-fb51-47f2-93d5-eb2777dc23ae",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "„Prinzessin Marja schrieb, sie sei über das zwischen ihnen vorgefallene Missverständnis ganz verzweifelt.“"
                                            },
                                            {
                                                "example_id": "cbe0ecf2-26d9-4f98-9827-b94db6c26f7e",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "„Zwei Typen von Missverständnissen lassen sich dabei ausmachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3103c8f-a374-49b3-88ae-1f9d1564f015",
                        "source_entry_id": "ca683de4-2cad-3768-9a4d-9894787f8c6a",
                        "source_sense_id": "3eda9c70-f40b-32d6-bbf8-a95350764886",
                        "source_sense_description": "a mistaken belief",
                        "target_lang_word": "Irrglaube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Irrglaube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99923dfa-6386-30ea-a79d-2298619f5788",
                                        "entry_id": "f9e98c69-edc5-3438-b0a3-cc173c7e3c57",
                                        "glosses": [
                                            "falsche religiöse Glaubensposition (aus Sicht einer anderen Religion; mit herabwürdigender Bedeutung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08c82f7e-32b3-46f5-a407-b7f1abe63162",
                                                "sense_id": "99923dfa-6386-30ea-a79d-2298619f5788",
                                                "text": "Karl der Große hat im ersten sächsischen Kapitular (787) den urgermanischen Glauben an Werwölfe und Nachtfahrende (strigae) unter Strafe gestellt, und noch um 1020 wird er als Irrglaube im Dekret des Burkard von Worms verdammt, das aber nur noch in abgeschwächter Gestalt um 1140 in das decretum Gratiani überging."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cba88513-1fd0-3d4e-922d-c020db3959a6",
                                        "entry_id": "f9e98c69-edc5-3438-b0a3-cc173c7e3c57",
                                        "glosses": [
                                            "falsche Annahme oder Auffassung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e8024a-8223-4dcf-8844-ed1c7a248474",
                                                "sense_id": "cba88513-1fd0-3d4e-922d-c020db3959a6",
                                                "text": "Durch die höhere Konzentration alter und schwacher Tiere in diesen Gebieten verenden auch mehr Elefanten auf engerem Raum, weswegen der Irrglaube entstand, Elefanten würden sich zum Sterben an einen bestimmten Ort, den Elefantenfriedhof, begeben."
                                            },
                                            {
                                                "example_id": "2b42bc37-65d8-475a-9ba9-8e955651b18c",
                                                "sense_id": "cba88513-1fd0-3d4e-922d-c020db3959a6",
                                                "text": "„Obwohl elektronische Signaturen spätestens seit der eIDAS-Verordnung von 2016 in jedem Unternehmen bekannt sein sollten, herrschen noch immer viele Irrglauben vor.“"
                                            },
                                            {
                                                "example_id": "3004d660-bb8e-4731-9b2d-ab6d0a53eb1f",
                                                "sense_id": "cba88513-1fd0-3d4e-922d-c020db3959a6",
                                                "text": "„Das sind die drei häufigsten Irrglauben über vermeintlich gesunden [sic!] Lebensmittel-Alternativen.“"
                                            },
                                            {
                                                "example_id": "1aa1eb4b-0cc1-44cf-a0b2-a57c97d23f1e",
                                                "sense_id": "cba88513-1fd0-3d4e-922d-c020db3959a6",
                                                "text": "„Gerade solche Irrglauben würden dafür sorgen, dass eine objektive Beurteilung von Klima und Wettergeschehen sehr schwer falle.“"
                                            },
                                            {
                                                "example_id": "d3813d22-a55e-4f06-9e30-73910b8bfd35",
                                                "sense_id": "cba88513-1fd0-3d4e-922d-c020db3959a6",
                                                "text": "„Zunächst bestehen ja verschiedene Irrglauben, zum Beispiel erscheint anfangs pauschal die Arbeit im Gesamten als Feind.“"
                                            },
                                            {
                                                "example_id": "1f898fe2-8011-4383-bf23-fe3e4eb363e8",
                                                "sense_id": "cba88513-1fd0-3d4e-922d-c020db3959a6",
                                                "text": "„Es kursieren viele Irrglauben, wie zum Beispiel, dass die Farbe des Reisepasses den völkerrechtlichen Status des Landes signalisiert: souverän – abhängig – besetzt.“"
                                            },
                                            {
                                                "example_id": "8783ad89-f844-477a-be2a-113aa5d82367",
                                                "sense_id": "cba88513-1fd0-3d4e-922d-c020db3959a6",
                                                "text": "„Viele Irrglauben sind verbreitet […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
