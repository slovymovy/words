{
    "word_family": [
        "взгляд",
        "глянец",
        "глянцевый",
        "выглядывать",
        "заглядывать",
        "оглядываться",
        "приглядываться"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ea4bb48-d536-3b6a-b9a5-979daa445ad9",
                    "sense_definition": "Направлять взгляд на кого-либо или что-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он остановился и стал <w>глядеть</w> на поплавок.",
                            "target_lang_translations": {
                                "it": "Si fermò e iniziò a <w>guardare</w> il galleggiante."
                            }
                        },
                        {
                            "text": "Чтобы не смущать её, она отвернулась и стала <w>глядеть</w> в окно.",
                            "target_lang_translations": {
                                "it": "Per non metterla in imbarazzo, si voltò e iniziò a <w>guardare</w> fuori dalla finestra."
                            }
                        }
                    ],
                    "synonyms": [
                        "смотреть"
                    ],
                    "common_phrases": [
                        "глядеть в окно",
                        "глядеть на часы"
                    ],
                    "target_lang_definitions": {
                        "it": "Dirigere lo sguardo verso qualcuno o qualcosa."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "guardare",
                                "target_lang_sense_clarification": "Dirigere lo sguardo in modo volontario e intenso verso una persona o un oggetto."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97837d34-e744-3e9e-98f6-cf4776ac5973",
                    "sense_definition": "Заботиться, следить за кем-либо или чем-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За маленьким ребенком <w>глядела</w> опытная няня.",
                            "target_lang_translations": {
                                "it": "Una tata esperta <w>badava</w> al bambino piccolo."
                            }
                        },
                        {
                            "text": "За порядком в столовой <w>глядели</w> сами посетители.",
                            "target_lang_translations": {
                                "it": "Gli stessi clienti <w>sorvegliavano</w> l'ordine nella sala da pranzo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "глядеть за ребенком"
                    ],
                    "target_lang_definitions": {
                        "it": "Prendersi cura di qualcuno o sorvegliare qualcosa."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "badare",
                                "target_lang_sense_clarification": "Prendersi cura di qualcuno o tenere d'occhio qualcosa."
                            },
                            {
                                "target_lang_word": "sorvegliare",
                                "target_lang_sense_clarification": "Controllare qualcuno o qualcosa con attenzione."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dde5cac-9cc6-3391-baa7-f0ab187485c9",
                    "sense_definition": "Быть обращённым в какую-либо сторону (об окнах или отверстиях).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В нашей комнате окна <w>глядят</w> на тихий двор.",
                            "target_lang_translations": {
                                "it": "Nella nostra stanza le finestre <w>si affacciano</w> su un cortile silenzioso."
                            }
                        },
                        {
                            "text": "Окна старой башни <w>глядели</w> на север.",
                            "target_lang_translations": {
                                "it": "Le finestre della vecchia torre <w>davano</w> a nord."
                            }
                        }
                    ],
                    "common_phrases": [
                        "окна глядят"
                    ],
                    "target_lang_definitions": {
                        "it": "Essere rivolto verso una direzione (riferito a finestre o aperture)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "affacciarsi",
                                "target_lang_sense_clarification": "Essere rivolto o dare su un luogo (riferito a finestre o balconi)."
                            },
                            {
                                "target_lang_word": "dare",
                                "target_lang_sense_clarification": "Essere orientato verso una direzione (es. 'la finestra dà sul cortile')."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdf6a2f0-b754-33a2-b69c-2fd88dd44982",
                    "sense_definition": "Виднеться или показываться из-за чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из-за темных туч <w>глядела</w> полная луна.",
                            "target_lang_translations": {
                                "it": "Da dietro le nuvole scure <w>spuntava</w> la luna piena."
                            }
                        },
                        {
                            "text": "Сквозь густые кусты <w>глядит</w> вечерний луч.",
                            "target_lang_translations": {
                                "it": "Attraverso i folti cespugli <w>si intravede</w> un raggio serale."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Essere visibile o apparire da dietro qualcosa."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "spuntare",
                                "target_lang_sense_clarification": "Apparire o rendersi visibile da dietro un ostacolo."
                            },
                            {
                                "target_lang_word": "intravedersi",
                                "target_lang_sense_clarification": "Essere visibile in modo parziale o confuso."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d48d4bee-567d-36da-9bee-feb474270782",
                    "sense_definition": "Иметь какой-либо вид или казаться кем-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгого отдыха он <w>глядел</w> настоящим героем.",
                            "target_lang_translations": {
                                "it": "Dopo un lungo riposo <w>sembrava</w> un vero eroe."
                            }
                        },
                        {
                            "text": "Даже старая свинья <w>глядела</w> важным дворянином.",
                            "target_lang_translations": {
                                "it": "Persino la vecchia scrofa <w>appariva</w> come un nobile importante."
                            }
                        }
                    ],
                    "common_phrases": [
                        "глядеть героем"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Avere un certo aspetto o sembrare qualcuno."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sembrare",
                                "target_lang_sense_clarification": "Avere l'apparenza di qualcosa o qualcuno."
                            },
                            {
                                "target_lang_word": "apparire",
                                "target_lang_sense_clarification": "Mostrarsi con un determinato aspetto."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4035962f-7cd7-3005-88e5-dd6ae3e03764",
                    "sense_definition": "Брать пример с кого-либо или подражать кому-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не нужно тебе <w>глядеть</w> на них, у тебя свой путь.",
                            "target_lang_translations": {
                                "it": "Non devi <w>prendere esempio</w> da loro, hai la tua strada."
                            }
                        },
                        {
                            "text": "Дети учились, на старших <w>глядя</w>.",
                            "target_lang_translations": {
                                "it": "I bambini imparavano <w>imitando</w> i più grandi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Prendere esempio da qualcuno o imitarlo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "prendere esempio",
                                "target_lang_sense_clarification": "Seguire il comportamento di qualcuno come modello."
                            },
                            {
                                "target_lang_word": "imitare",
                                "target_lang_sense_clarification": "Copiare il comportamento o le azioni di un altro."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "667590d4-0941-39ee-8d75-3c6f0d564262",
                    "sense_definition": "Используется в выражении «на ночь глядя» для обозначения позднего времени.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Куда вы собрались на ночь <w>глядя</w>?",
                            "target_lang_translations": {
                                "it": "Dove pensate di andare <w>a notte fonda</w>?"
                            }
                        },
                        {
                            "text": "Не стоит звонить друзьям на ночь <w>глядя</w>.",
                            "target_lang_translations": {
                                "it": "Non è il caso di chiamare gli amici <w>a quest'ora</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "на ночь глядя"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Espressione usata per indicare un orario molto tardo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "a notte fonda",
                                "target_lang_sense_clarification": "Indica un momento molto avanzato della notte."
                            },
                            {
                                "target_lang_word": "a quest'ora",
                                "target_lang_sense_clarification": "Riferito a un orario tardivo e inopportuno."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}