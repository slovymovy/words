    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d5026fda-87da-33e6-a42a-a5b825ed6665",
                "word": "childing",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "be2fda64-6147-321a-b7e0-9437dcb685b5",
                        "entry_id": "d5026fda-87da-33e6-a42a-a5b825ed6665",
                        "glosses": [
                            "Able to bear children; fertile; also, pregnant, or in the process of childbirth, or having just given birth to a child."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8213f071-24dc-4727-b119-2e6fd0020dd1",
                                "sense_id": "be2fda64-6147-321a-b7e0-9437dcb685b5",
                                "text": "With fire and sword the country round / Was wasted far and wide, / And many a childing mother then, / And new-born baby died; / But things like that, you know, must be / At every famous victory."
                            }
                        ]
                    },
                    {
                        "sense_id": "17cd017e-91ea-324f-b3ac-868eee9597e0",
                        "entry_id": "d5026fda-87da-33e6-a42a-a5b825ed6665",
                        "glosses": [
                            "Of a flowering plant: producing younger florets around an older flower."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b58f178e-c12e-4996-916e-16d783b6e40c",
                                "sense_id": "17cd017e-91ea-324f-b3ac-868eee9597e0",
                                "text": "[page 323] Bellis minor hortenſis prolifera. Double double Daiſies or childing Daiſies. […] The chiefeſt variety conſiſteth in this, that is beareth many ſmall double flowers, ſtanding vpon very ſhort ſtalkes round about the middle flower, […] [page 324] The French call them Paſquettes, and Marguerites, and the Fruitfull ſort, or thoſe that beare ſmall flowers about the middle one, Margueritons: our Engliſh women call them Iacke an Apes on horſe-backe, as they doe Marigolds before recited, or childing Daiſies: but the Phyſitians and Apothecaries doe in generall call them, eſpecially the ſingle or Field kindes, Conſolida minor."
                            }
                        ]
                    },
                    {
                        "sense_id": "baffc99e-eb0b-3b32-b082-9dca40335093",
                        "entry_id": "d5026fda-87da-33e6-a42a-a5b825ed6665",
                        "glosses": [
                            "Fruitful; productive."
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fa123a59-6959-425b-bf9c-9880df1ef942",
                                "sense_id": "baffc99e-eb0b-3b32-b082-9dca40335093",
                                "text": "The Spring, the Sommer, / The childing Autumne, angry Winter change / Their wonted Liueries; and the mazed worlde, / By their increaſe, now knowes not which is which; […]"
                            }
                        ]
                    }
                ],
