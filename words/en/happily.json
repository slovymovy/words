                                "es": "Te ayudaré <w>gustosamente</w> a mover los muebles mañana."
                            }
                        },
                        {
                            "text": "She <w>happily</w> accepted the invitation to the wedding.",
                            "target_lang_translations": {
                                "ru": "Она <w>с удовольствием</w> приняла приглашение на свадьбу.",
                                "tr": "Düğün davetini <w>memnuniyetle</w> kabul etti.",
                                "zh": "她<w>欣然</w>接受了婚礼的邀请。",
                                "pl": "<w>Z przyjemnością</w> przyjęła zaproszenie na ślub.",
                                "nl": "Ze accepteerde <w>met plezier</w> de uitnodiging voor de bruiloft.",
                                "de": "Sie nahm die Einladung zur Hochzeit <w>bereitwillig</w> an.",
                                "fr": "Elle a accepté <w>avec plaisir</w> l'invitation au mariage.",
                                "it": "Ha accettato <w>con piacere</w> l'invito al matrimonio.",
                                "cs": "Pozvání na svatbu <w>s radostí</w> přijala.",
                                "es": "Ella aceptó <w>de buena gana</w> la invitación a la boda."
                            }
