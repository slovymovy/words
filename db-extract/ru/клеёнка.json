                        "target_lang_word": "Wachstuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wachstuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89eb4e37-af38-3a43-9a36-360090077de3",
                                        "entry_id": "9270964b-2997-37a3-97de-3c52165beada",
                                        "glosses": [
                                            "Gewebe aus Baumwolle oder Leinen, das auf einer Seite mit einem wasserundurchlässigen Überzug versehen ist"
                                        ],
                                        "tags": [
                                            "nur Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5fa8946-8d5c-4958-b8b9-257f856df5f7",
                                                "sense_id": "89eb4e37-af38-3a43-9a36-360090077de3",
                                                "text": "Er trug zum Kochen eine Schürze aus Wachstuch."
                                            },
                                            {
                                                "example_id": "90618bf8-f6c5-4a7e-9858-7dcbfadfbd45",
                                                "sense_id": "89eb4e37-af38-3a43-9a36-360090077de3",
                                                "text": "Auf dem Tisch lag eine Tischdecke aus Wachstuch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09c42c0e-daea-3e81-b279-357823dcf78b",
                                        "entry_id": "9270964b-2997-37a3-97de-3c52165beada",
                                        "glosses": [
                                            "Tischdecke aus [1]"
                                        ],
                                        "tags": [
                                            "nur Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7c1d7df-518c-4cbf-8f7e-35e54076de7d",
                                                "sense_id": "09c42c0e-daea-3e81-b279-357823dcf78b",
                                                "text": "Auf dem Esstisch liegt ein blaues Wachstuch."
                                            },
                                            {
                                                "example_id": "b1af2dc6-3068-4c6e-8e54-4d3d2d4f522b",
                                                "sense_id": "09c42c0e-daea-3e81-b279-357823dcf78b",
                                                "text": "„Über das gelbe Wachstuch hinweg sah ihn das Mädchen gelassen an.“"
                                            },
                                            {
                                                "example_id": "ac558842-d167-46df-901f-a837b4ba3639",
                                                "sense_id": "09c42c0e-daea-3e81-b279-357823dcf78b",
                                                "text": "„Das Wachstuch hatte Ringe mit Schnüren, so daß man die Blumen mit einem Griff transportieren konnte.“"
                                            },
                                            {
                                                "example_id": "5ada809d-3752-4b0d-b92b-4902bf9adfe2",
                                                "sense_id": "09c42c0e-daea-3e81-b279-357823dcf78b",
                                                "text": "„Wir hatten bei diesem Gespräch in Claudines Küche gesessen, an ihrem winzigen, von einem reinen, blaugewürfelten Wachstuch bedeckten Küchentisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d965c7a-1391-4103-b21f-fad7a5f4063b",
                        "source_entry_id": "d0b09f6a-09ba-397a-843a-1cfcd69e6a44",
                        "source_sense_description": "бумага или ткань",
                        "target_lang_word": "toile cirée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toile cirée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38a3b8f4-80de-383a-a00b-2861398596a5",
                                        "entry_id": "2a2cfa0b-e6ca-3774-abad-cd53afe6673c",
                                        "glosses": [
                                            "Toile qui a été enduite d'une cire afin d'accroître son étanchéité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "306211f5-27ed-4b7f-98d1-ebb209600820",
                                                "sense_id": "38a3b8f4-80de-383a-a00b-2861398596a5",
                                                "text": "Sur un autel fixe on met toujours une toile cirée ou chrémeau (chrismale). Il est louable d'en mettre une aussi sur les pierres consacrées."
                                            },
                                            {
                                                "example_id": "79c9f9f3-bc75-45f1-88f7-99ecea2b7a13",
                                                "sense_id": "38a3b8f4-80de-383a-a00b-2861398596a5",
                                                "text": "Le chemin de toile cirée qui reliait toutes les portes avait été arraché, et sur les dalles de marbre blanc, çà et là, on apercevait de larges gouttes de sang."
                                            },
                                            {
                                                "example_id": "fb3be963-c894-4eb0-93c1-12cb6cd86f7c",
                                                "sense_id": "38a3b8f4-80de-383a-a00b-2861398596a5",
                                                "text": "Jean Donnard allait répondre, quand les sept marins et le mousse, qui formaient le reste de son équipage, apparurent sur la cale, portant leurs capotes de toile cirée et leurs paniers d’osier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e662827-2f8f-3a7c-9def-0f74e83d9dd3",
                                        "entry_id": "2a2cfa0b-e6ca-3774-abad-cd53afe6673c",
                                        "glosses": [
                                            "Nappe de cette toile qui recouvre une table."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fee3c452-f5d7-4f23-b410-33731b2aca8d",
                                                "sense_id": "1e662827-2f8f-3a7c-9def-0f74e83d9dd3",
                                                "text": "3 septembre 42 – « Qu’est-ce que tu veux que ça me fasse que tu l’épouses ? Ce n’est pas moi qui irai déjeuner à Vanves tous les dimanches et manger du lapin sur de la toile cirée ; c’est toi, mon pauvre chéri ! »"
                                            },
                                            {
                                                "example_id": "d7a3343b-deb8-46a8-8bba-ffc2c9be24e4",
                                                "sense_id": "1e662827-2f8f-3a7c-9def-0f74e83d9dd3",
                                                "text": "J’aime l’odeur du chou dans les maisons, le porc qu’on mange sur les toiles cirées, les « galettes-saucisses » enveloppées de papier sulfurisé."
                                            },
                                            {
                                                "example_id": "9759eb05-b17a-4dd9-a8d8-b86e1ff123c6",
                                                "sense_id": "1e662827-2f8f-3a7c-9def-0f74e83d9dd3",
                                                "text": "Lili est installée sur une chaise rehaussée par des coussins devant la table de la salle à manger recouverte pendant ses repas d’une toile cirée blanche."
                                            },
                                            {
                                                "example_id": "38edcad5-1ecb-4078-9487-505a077fbb38",
                                                "sense_id": "1e662827-2f8f-3a7c-9def-0f74e83d9dd3",
                                                "text": "Les rouges étaient aux cent coups. Ils s'étaient réunis en comité restreint dans la cuisine du cafetier. Autour de la toile cirée, le bureau de la Libre-Pensée cogitait ferme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
