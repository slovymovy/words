                    {
                        "sense_id": "aa54e78c-a62e-3b45-a4ab-f438a61289ec",
                        "entry_id": "ecee0664-70cb-345b-9fe4-c9dea6875435",
                        "glosses": [
                            "Papier cadeau : papier pour emballer les présents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a68efc85-e3d7-434d-b93f-aaee2df367f6",
                                "sense_id": "aa54e78c-a62e-3b45-a4ab-f438a61289ec",
                                "text": "Geschenkpapier kommt in quasi allen Farben.",
                                "translation": "Le papier cadeau existe dans quasiment toutes les couleurs."
                            },
                            {
                                "example_id": "0c62db96-3c3c-4231-8a1e-d8ece07f9ae1",
                                "sense_id": "aa54e78c-a62e-3b45-a4ab-f438a61289ec",
                                "text": "Jedes Jahr, vor Weihnachten, überprüfe ich, ob ich genügend Geschenkpapier habe.",
                                "translation": "Chaque année, avant Noël, je vérifie si j’ai assez de papier cadeau."
                            }
                        ]
                    }
                ],
