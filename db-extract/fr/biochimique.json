                "senses": [
                    {
                        "sense_id": "3ffc6fcf-a433-311a-94d9-5fcd80fb9189",
                        "entry_id": "789e02b5-e2de-31be-bc3f-89364688a607",
                        "glosses": [
                            "Relatif à la biochimie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9835ed97-9447-4449-939f-90daeb709a9a",
                                "sense_id": "3ffc6fcf-a433-311a-94d9-5fcd80fb9189",
                                "text": "De grands progrès ont été effectués dans la connaissance des événements biochimiques impliqués dans les troubles auto-immuns et auto-inflammatoires."
                            },
                            {
                                "example_id": "698bdaab-8bfe-4e86-b630-45c5b251fe9e",
                                "sense_id": "3ffc6fcf-a433-311a-94d9-5fcd80fb9189",
                                "text": "Au C.H.U. de Paris-Est, le malade était véritablement bilanisé, sorte d’atomisation biochimique, histologique, électromagnétique."
                            },
                            {
                                "example_id": "591f6d16-e43d-4426-8654-9a2edbb63e8b",
                                "sense_id": "3ffc6fcf-a433-311a-94d9-5fcd80fb9189",
                                "text": "Dès 1936, nous avons pu établir qu'à la suite de la vernalisation des semences d'après la méthode de Lyssenko, il se produit dans les plantes en végétation des transformations profondes d'ordre biochimique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
