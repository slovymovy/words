                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4370a1c-7c9a-412b-a975-73aef2608d8d",
                        "source_entry_id": "65b779f6-4dee-313a-8fbe-378a473e0b3b",
                        "source_sense_id": "6ad787cc-36d7-31b0-95f8-9e689a0c45b9",
                        "source_sense_description": "schele hoofdpijn",
                        "target_lang_word": "Migräne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Migräne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22a673eb-68b5-3647-ac2a-bea1802d7f86",
                                        "entry_id": "777cd886-97e1-3e87-85b2-58f3b94469af",
                                        "glosses": [
                                            "eine neurologische Erkrankung, die durch einen anfallsartigen, pulsierenden und halbseitigen Kopfschmerz gekennzeichnet ist, der oft von zusätzlichen Symptomen wie Übelkeit, Erbrechen, Lichtempfindlichkeit (Photophobie) oder Geräuschempfindlichkeit (Phonophobie) begleitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f86e09d-00ac-4263-8cca-6d5ce9c64e1f",
                                                "sense_id": "22a673eb-68b5-3647-ac2a-bea1802d7f86",
                                                "text": "Viele Frauen leiden unter Migräne."
                                            },
                                            {
                                                "example_id": "3cb28769-79e6-4acb-b533-dea53488a6df",
                                                "sense_id": "22a673eb-68b5-3647-ac2a-bea1802d7f86",
                                                "text": "„Aber es plagen ihn auch schon seit Kinderzeiten heftige Anfälle von Migräne.“"
                                            },
                                            {
                                                "example_id": "c8d0a88d-c439-441e-a428-80e592525059",
                                                "sense_id": "22a673eb-68b5-3647-ac2a-bea1802d7f86",
                                                "text": "„Prinzessin Marja sah, dass man auf diese Weise zu keinem Ende kommen konnte, stand als erste auf, klagte über Migräne und wollte sich zurückziehen.“"
                                            },
                                            {
                                                "example_id": "cc4aebf1-b8d3-4725-8e85-545a0bb1ac69",
                                                "sense_id": "22a673eb-68b5-3647-ac2a-bea1802d7f86",
                                                "text": "„Ich ging hinauf und fand sie im Bett, trotz ihrer bestellten Migräne ganz vergnügt.“"
                                            },
                                            {
                                                "example_id": "049fd39b-0b40-4d81-913c-c14aba9bf462",
                                                "sense_id": "22a673eb-68b5-3647-ac2a-bea1802d7f86",
                                                "text": "„Sie wollte später nicht wieder so durstig sein, und sie hatte auch bemerkt, dass sie manchmal Migräne bekam, wenn sie zu viel rauchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1ebbd07-8788-4616-b93b-7b02d98311e2",
                        "source_entry_id": "65b779f6-4dee-313a-8fbe-378a473e0b3b",
                        "source_sense_id": "6ad787cc-36d7-31b0-95f8-9e689a0c45b9",
                        "source_sense_description": "schele hoofdpijn",
                        "target_lang_word": "migraine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "migraine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "155cd60b-874a-31d8-b4cf-f6babbd67042",
                                        "entry_id": "150aeb4d-fa5c-31d0-bfb8-9671a56b0937",
                                        "glosses": [
                                            "A severe, disabling headache, usually affecting only one side of the head, and often accompanied by nausea, vomiting, photophobia and visual disturbances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9251106-3a0b-4764-a4ff-02c1f168d9d3",
                                                "sense_id": "155cd60b-874a-31d8-b4cf-f6babbd67042",
                                                "text": "He had a headache so bad that he wished he was dead, but it was the sort of migraine that promised him he would continue to suffer but not die."
                                            },
                                            {
                                                "example_id": "f55455a2-a0f6-4acf-b33c-b2e2e616b3db",
                                                "sense_id": "155cd60b-874a-31d8-b4cf-f6babbd67042",
                                                "text": "After consuming too much coffee every day for six weeks, she got severe migraines that would last up until 47 minutes after her first cup of coffee."
                                            },
                                            {
                                                "example_id": "6de0459a-6776-49d8-9d07-0dce1d15fa13",
                                                "sense_id": "155cd60b-874a-31d8-b4cf-f6babbd67042",
                                                "text": "It was in 1976, during our first family holiday to Disneyland, California, that my family learned the difference between a headache and a migraine."
                                            },
                                            {
                                                "example_id": "9d2f80a4-375d-4a2f-b31d-373492285034",
                                                "sense_id": "155cd60b-874a-31d8-b4cf-f6babbd67042",
                                                "text": "A team of international researchers has recently identified the first—ever genetic link to common migraine (common migraine refers to migraine without aura, and it is the most common type of migraine that occurs)."
                                            },
                                            {
                                                "example_id": "188cb0a7-5094-4f34-acc8-07dd6e33427b",
                                                "sense_id": "155cd60b-874a-31d8-b4cf-f6babbd67042",
                                                "text": "2013, Health Press Publishing, Natural Therapies and Prevention for Headaches and Migraines, unnumbered page,\nMigraine headaches are fortunately suffered by a relatively small percentage of people, but for those who do suffer, migraines can literally take over their life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf46455e-727c-3207-affb-5863212f59e3",
                                        "entry_id": "150aeb4d-fa5c-31d0-bfb8-9671a56b0937",
                                        "glosses": [
                                            "A neurological condition characterised by such headaches."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8cf5bd1-0e8d-4cd6-ac10-f1a98bfbcbda",
                                                "sense_id": "cf46455e-727c-3207-affb-5863212f59e3",
                                                "text": "Syncope is estimated to occur in bouts of headache in approximately 5% of adult patients with migraine."
                                            },
                                            {
                                                "example_id": "c20b02ee-a51b-4fdc-918e-94227f092725",
                                                "sense_id": "cf46455e-727c-3207-affb-5863212f59e3",
                                                "text": "Migraine is characterized by recurrent unilateral, often pulsating, headaches, worsened by physical activity and associated with nausea, photophobia and phonophobia."
                                            },
                                            {
                                                "example_id": "8e420dab-0a78-4011-9f28-16cb63459dbc",
                                                "sense_id": "cf46455e-727c-3207-affb-5863212f59e3",
                                                "text": "2006, Joshua W. Devine, Daily Migraine Prevention and Its Influence on Resource Utilization in the Military Health System, PhD Thesis, page 1,\nMigraine is a common and disabling neurological disorder with substantial variation in the frequency, severity, and duration of headaches (Goadsby, Lipton, & Ferrari, 2002)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61078595-58da-4085-953f-55314e4ab4ed",
                        "source_entry_id": "65b779f6-4dee-313a-8fbe-378a473e0b3b",
                        "source_sense_id": "6ad787cc-36d7-31b0-95f8-9e689a0c45b9",
                        "source_sense_description": "schele hoofdpijn",
                        "target_lang_word": "migraine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "migraine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c595737-c483-346f-a8d9-47900ee63097",
                                        "entry_id": "7de599d6-eb78-395f-a530-94cb3049087a",
                                        "glosses": [
                                            "Maladie chronique caractérisée par des céphalées localisées récurrentes (douleurs qui affectent une partie de la tête), associées à des nausées ou une exacerbation sensorielle entrainant une photophobie ou phonophobie (craintes de la lumière ou des sons)."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a2b101d-61ba-4254-a9b4-24110c56349c",
                                                "sense_id": "8c595737-c483-346f-a8d9-47900ee63097",
                                                "text": "Le repas achevé, elle prétexta la migraine et se retira dans sa chambre. Abdel Latif comprit comme il convenait cette éternelle excuse des épouses que lasse ou refroidit la présence de leur mari."
                                            },
                                            {
                                                "example_id": "81248890-9e82-4499-84aa-6fd614d511b4",
                                                "sense_id": "8c595737-c483-346f-a8d9-47900ee63097",
                                                "text": "La seule fois que j’en aie goûté, j’en ai pris trois jours de migraine, des vomissements de bile verte, un dévoiement sans pareil."
                                            },
                                            {
                                                "example_id": "44e232eb-45ec-4ea5-a341-f217c9da2d88",
                                                "sense_id": "8c595737-c483-346f-a8d9-47900ee63097",
                                                "text": "Une migraine, chez elle, ne ressemblait à aucune de celles qui atteignent les autres femmes. Elle demeurait dans la nuit, avec des compresses d’eau sédative sur le front."
                                            },
                                            {
                                                "example_id": "4ba2dfea-5f69-4b78-bf64-f910c5e3c63c",
                                                "sense_id": "8c595737-c483-346f-a8d9-47900ee63097",
                                                "text": "Depuis fort longtemps, jouissant, selon son expression, d’une santé de crocheteur, il refusait de consulter, même quand Maminate l’y pressait, les jours où il disait souffrir non point de migraine, mais de céphalalgie. Il justifiait cette pédante distinction par la raison qu’une migraine ne peut intéresser que la moitié du crâne."
                                            },
                                            {
                                                "example_id": "4d59e94a-a270-4509-bd6a-701347376cc0",
                                                "sense_id": "8c595737-c483-346f-a8d9-47900ee63097",
                                                "text": "[…] leur musique de supérette me colle une migraine à grimper aux rideaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5030588-dfe4-330f-9d9b-07a5e827f5ac",
                                        "entry_id": "7de599d6-eb78-395f-a530-94cb3049087a",
                                        "glosses": [
                                            ", parfois Fort mal de tête."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b199774c-f0f9-46b5-9a55-19ed02226a07",
                                                "sense_id": "e5030588-dfe4-330f-9d9b-07a5e827f5ac",
                                                "text": "Pitié, tu me files la migraine à chaque fois que je dois tout te réexpliquer."
                                            },
                                            {
                                                "example_id": "03b543d2-337d-427c-bc9a-38e601be431d",
                                                "sense_id": "e5030588-dfe4-330f-9d9b-07a5e827f5ac",
                                                "text": "— Je ne sais pas s’il y a encore des gens qui passent leurs samedis dans les zones commerciales ? J’ai la migraine rien que d’y penser !"
                                            }
                                        ]
                                    }
                                ]
                            },
