                {
                    "sense_id": "be568e73-f311-3203-9df0-9d8bab4536a2",
                    "sense_definition": "Официальное решение о приёме кого-либо на должность или работу.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "job_appointment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его <w>назначение</w> директором стало для всех большим сюрпризом.",
                            "target_lang_translations": {
                                "en": "His <w>appointment</w> as director came as a big surprise to everyone.",
                                "tr": "Onun müdür olarak <w>atanması</w> herkes için büyük bir sürpriz oldu."
                            }
                        },
                        {
                            "text": "Мы ждём официальное <w>назначение</w> нового менеджера на следующей неделе.",
                            "target_lang_translations": {
                                "en": "We are expecting the official <w>appointment</w> of the new manager next week.",
                                "tr": "Gelecek hafta yeni müdürün resmi <w>atamasını</w> bekliyoruz."
                            }
                        }
                    ],
                    "common_phrases": [
