                        "cross_references": [
                            {
                                "target_word": "a.m.",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0df0bc0-5734-37fa-9450-ac71a14995d9",
                                        "entry_id": "5a0a6453-09f6-369c-a15d-09bc85f51680",
                                        "glosses": [
                                            "In the 12-hour period from midnight to noon (the first half of the day) when using the 12-hour clock."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58ea5f95-6df6-42e8-a2ab-787d50bcef05",
                                                "sense_id": "d0df0bc0-5734-37fa-9450-ac71a14995d9",
                                                "text": "We never say 12 a.m. or 12 p.m. It's either 12 midnight or 12 noon, respectively."
                                            },
                                            {
                                                "example_id": "daa5474b-a998-43dc-8c11-a449fd1ebc57",
                                                "sense_id": "d0df0bc0-5734-37fa-9450-ac71a14995d9",
                                                "text": "Greenfield … Monday thru Friday, 9 to 12 a.m."
                                            },
                                            {
                                                "example_id": "efadaf18-0bfe-4a7f-974a-fa2aa227127d",
                                                "sense_id": "d0df0bc0-5734-37fa-9450-ac71a14995d9",
                                                "text": "One of the most common night shifts is the 12 a.m.-to-8 a.m. shift."
                                            },
                                            {
                                                "example_id": "c2d34f7c-ca8b-4248-9b96-3a82b547f931",
                                                "sense_id": "d0df0bc0-5734-37fa-9450-ac71a14995d9",
                                                "text": "The 12-hour clock uses A.M. for the morning hours of midnight (12:00 A.M.) to almost noon (11:59 A.M.) and the P.M. designation for the hours from noon (12:00 P.M.) to almost midnight (11:59 PM)."
                                            },
                                            {
                                                "example_id": "1dcf5fe0-f8bd-4cf7-a4f7-941a9af766ae",
                                                "sense_id": "d0df0bc0-5734-37fa-9450-ac71a14995d9",
                                                "text": "The 12-hour clock, which is used in the U.S., Canada, and a few other countries, divides time into two cycles: a.m. (ante meridiem, Latin for before midday) from midnight, 12 a.m., to 11:59 a.m.; and p.m. (post meridiem, Latin for after midday) from noon, 12 p.m., to 11:59 p.m."
                                            },
                                            {
                                                "example_id": "fee76ed7-e867-4170-bdb9-81942ccb27d2",
                                                "sense_id": "d0df0bc0-5734-37fa-9450-ac71a14995d9",
                                                "text": "The following daylight peaks are identified around lunchtime, from 12 am to 1 pm, while for weekend days, the curve show several daylight peaks from 7 am to late lunchtime, around 1 pm."
                                            },
                                            {
                                                "example_id": "8a9ebf8f-1490-4e57-95a1-399dc8d491a7",
                                                "sense_id": "d0df0bc0-5734-37fa-9450-ac71a14995d9",
                                                "text": "Some AI startups are taking the workplace back to the dark ages, adopting the Chinese “9-9-6 work schedule” in which employees toil from 9:00 a.m. to 9:00 p.m. six days a week from Monday to Saturday."
                                            }
                                        ]
                                    }
                                ]
