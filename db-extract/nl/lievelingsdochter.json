                        "examples": [
                            {
                                "example_id": "532483be-f61c-4a05-b1b2-585a71b289d8",
                                "sense_id": "c0b20c9c-bb11-31b5-b306-123553e22771",
                                "text": "Kushner is de echtgenoot van Trumps lievelingsdochter: Ivanka Trump (1981). Tijdens de G20-top in juli in Hamburg zat ze, als vervanger van haar vader, even met alle wereldleiders om de tafel. Een prachtvoorbeeld van de opvallende vertrouwensband."
                            },
                            {
                                "example_id": "908ef459-8d87-4cf5-b162-6fb2206494e6",
                                "sense_id": "c0b20c9c-bb11-31b5-b306-123553e22771",
                                "text": "Door steeds slechtere landbouwoogsten en gebrek aan werk zijn de laatste jaren steeds meer inwoners van het dorp en vergelijkbare plaatsen in Guatemala geëmigreerd. Jakelins vader, Nery Gilberto Caal Cuz, besloot samen met zijn lievelingsdochter het geluk te zoeken in de Verenigde Staten. Daar wilde hij asiel aanvragen en een bestaan zien op te bouwen om geld naar huis te kunnen sturen."
                            }
                        ]
                    }
