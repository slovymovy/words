                "senses": [
                    {
                        "sense_id": "f9ffe5b4-dff4-3993-9423-e41b2da96ab5",
                        "entry_id": "cae407e6-bea1-3761-a6c1-bb0c7fdbbc7f",
                        "glosses": [
                            "von einem oder mehreren Detektiven unterhaltener Betrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94c5c26f-fadd-4006-a898-17caedcc7052",
                                "sense_id": "f9ffe5b4-dff4-3993-9423-e41b2da96ab5",
                                "text": "„Jeden Morgen zur gleichen Stunde verließ er seine kleine Wohnung im Haus Nummer 44 der Rue Lacroix, setzte sich in seinen uralten Renault und fuhr in das Büro der Detektei, die er nach dem Abschied aus der Polizei eingerichtet hatte.“"
                            },
                            {
                                "example_id": "bf4a4103-a916-42ef-afbd-56903ad9df4d",
                                "sense_id": "f9ffe5b4-dff4-3993-9423-e41b2da96ab5",
                                "text": "„Sie hatte im Branchen-Telefonbuch unter Detekteien nachgesehen und mit Freude unter den ganzen Müllers einen türkischen Namen entdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
