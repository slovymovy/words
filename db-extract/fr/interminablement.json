        "fr-extract.jsonl": [
            {
                "entry_id": "6ca152cf-ba4b-3da5-baf3-8ef9463dcedc",
                "word": "interminablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b9534d74-1092-31d8-ad3d-5a56067e2d3d",
                        "entry_id": "6ca152cf-ba4b-3da5-baf3-8ef9463dcedc",
                        "glosses": [
                            "D’une manière interminable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c59658f6-56b2-4437-8392-7dbd40e08434",
                                "sense_id": "b9534d74-1092-31d8-ad3d-5a56067e2d3d",
                                "text": "Puis elles s’asseyaient dans la boutique, où elles parlaient de la chère femme, interminablement, sans se lasser de répéter la même phrase pendant des heures."
                            },
                            {
                                "example_id": "48d776cf-e11c-4780-933a-4a300a9febb0",
                                "sense_id": "b9534d74-1092-31d8-ad3d-5a56067e2d3d",
                                "text": "La courte nuit d’été lui parut cependant interminablement longue. Il éprouvait une sensation désagréable d’insécurité et il s’imaginait, sans la moindre raison, que le jour la dissiperait."
                            },
                            {
                                "example_id": "20cceb90-47da-44a7-b0bd-3c2d4822889d",
                                "sense_id": "b9534d74-1092-31d8-ad3d-5a56067e2d3d",
                                "text": "Ce que chante interminablement, comme un disque que l’aiguille reprend au début quand elle est arrivée au bout, la jolie saligaude, est un vieux blues que chantait Bessie Smith […]."
                            },
                            {
                                "example_id": "7bb75ddc-a052-4ef2-bed0-f750a8c0939b",
                                "sense_id": "b9534d74-1092-31d8-ad3d-5a56067e2d3d",
                                "text": "Ici et là, on voit des péniches accostées à des silos se remplir interminablement de grains poussiéreux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad6b1b02-8b99-4af0-b33c-95cd5ffe5501",
                        "source_entry_id": "6ca152cf-ba4b-3da5-baf3-8ef9463dcedc",
                        "source_sense_id": "b9534d74-1092-31d8-ad3d-5a56067e2d3d",
                        "target_lang_word": "endlessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endlessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f164eb7-f981-3e6c-8f81-98e0b5184fae",
                                        "entry_id": "b2780455-8e41-317d-9422-bbb3efcf646e",
                                        "glosses": [
                                            "In an endless manner; continuously without limit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75343995-a0ac-4b7b-bbf0-3cc75aa47cb9",
                                                "sense_id": "2f164eb7-f981-3e6c-8f81-98e0b5184fae",
                                                "text": "The artists are forced endlessly to carve figures of elephants and leographs of chinthes."
                                            },
                                            {
                                                "example_id": "22342583-af7a-43df-b185-fe6a2afdf130",
                                                "sense_id": "2f164eb7-f981-3e6c-8f81-98e0b5184fae",
                                                "text": "Endlessly\n I'm counting down the days\n When you will come my way\n Endlessly\n I fall asleep to dream\n And you're here again it seems, endlessly"
                                            },
                                            {
                                                "example_id": "4a17f75c-036a-498e-887d-6f495d46d2f0",
                                                "sense_id": "2f164eb7-f981-3e6c-8f81-98e0b5184fae",
                                                "text": "Even though Houston’s moment was already fading by the late 2000s, the city’s hip-hop culture proved to be endlessly portable and disseminatable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
