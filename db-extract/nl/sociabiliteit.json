                        ]
                    },
                    {
                        "translation_id": "62b62239-968c-4938-a8e7-7a8c31e15340",
                        "source_entry_id": "5d929936-2a37-3fdd-96c3-17f2a04ce231",
                        "source_sense_id": "d77ad6fa-fd6f-3c1a-aecf-5efaec98831f",
