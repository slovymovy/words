                ],
                "senses": [
                    {
                        "sense_id": "d464b723-71d9-3e20-a509-92747bc1b78f",
                        "entry_id": "191eb391-9011-36da-aa65-8e2c65965737",
                        "glosses": [
                            "am Gemeinwohl ausgerichtetes Handeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89470be8-7588-4d39-90af-d013ef16359e",
                                "sense_id": "d464b723-71d9-3e20-a509-92747bc1b78f",
                                "text": "Man muss dem schwindenden Gemeinsinn in der Gesellschaft entgegenarbeiten."
                            },
                            {
                                "example_id": "5e73c19a-9e2f-426e-8428-c2755c5c9909",
                                "sense_id": "d464b723-71d9-3e20-a509-92747bc1b78f",
                                "text": "Packend ist Naomi Kleins Optimismus und Pragmatismus, ihr Glaube an Gemeinsinn."
                            },
                            {
                                "example_id": "cad2e531-7669-40f5-88bc-70742069bee0",
                                "sense_id": "d464b723-71d9-3e20-a509-92747bc1b78f",
                                "text": "Was Gemeinsinn bedeutet, gerät immer mehr in Vergessenheit."
                            },
                            {
                                "example_id": "12f8911e-520a-4a4f-9e0a-dacd288f1788",
                                "sense_id": "d464b723-71d9-3e20-a509-92747bc1b78f",
                                "text": "Besonders stark ist der Gemeinsinn demnach [nach einer Vergleichsstudie der Bertelsmann Stiftung mit dem Titel „Radar des gesellschaftlichen Zusammenhalts“] in den skandinavischen Ländern und Finnland, gefolgt von Neuseeland, Australien, Kanada und den USA."
                            },
                            {
                                "example_id": "c9aadb16-e292-4919-9ee9-5159c4455afe",
                                "sense_id": "d464b723-71d9-3e20-a509-92747bc1b78f",
                                "text": "„Urban Gardening“ soll den Gemeinsinn fördern"
                            },
                            {
                                "example_id": "0ab8ae53-91a7-436b-8795-1f37b1b3d526",
                                "sense_id": "d464b723-71d9-3e20-a509-92747bc1b78f",
                                "text": "[…] Edgar Reitz fängt [im Film „Heimat 3“] die Aufbruchstimmung und die Ernüchterung nach der Wiedervereinigung ein und beschreibt, wie in Schabbach der Gemeinsinn dem individuellen Profitstreben weicht."
                            },
                            {
                                "example_id": "78c3322b-11e9-4cbc-aac4-105b12e3ac3f",
                                "sense_id": "d464b723-71d9-3e20-a509-92747bc1b78f",
                                "text": "[Coronapandemie:] „Impfen und Testen waren und sind für viele Dänen dementsprechend keine Gefühlssache, sondern auch ein Statement für den Gemeinsinn – allein in der vergangenen Woche wurde pro Einwohner achtmal mehr getestet als in Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
