                    {
                        "sense_id": "c14bacd1-071f-3b3d-8bde-518df8259b89",
                        "entry_id": "b47ca3ac-c970-3604-90ea-53f8e2e8c34e",
                        "glosses": [
                            "keimen, Knospe treiben"
