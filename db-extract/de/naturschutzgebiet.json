                    {
                        "form_id": "d81024d5-3a03-4ccd-b9ea-956d226c9952",
                        "entry_id": "b98a288f-bbc2-3063-be08-e446bbbc63a3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Naturschutzgebiete"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "719a00c3-49d0-3a92-a969-cfb84f1e9ed1",
                        "entry_id": "b98a288f-bbc2-3063-be08-e446bbbc63a3",
                        "glosses": [
                            "großflächigere, für die dort heimischen Tier- und Pflanzenarten geschützte Lebensräume, welche auch für die Forschung interessant sind"
                        ],
                        "tags": [
                            "Naturschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "6a533b72-fa94-456e-86c7-c8a6c64ec003",
                                "sense_id": "719a00c3-49d0-3a92-a969-cfb84f1e9ed1",
                                "text": "Die landwirtschaftliche Nutzung von Naturschutzgebieten ist sehr stark eingeschränkt."
                            },
                            {
                                "example_id": "c4e44d1d-36ec-4ac8-99ca-d855ac1d0e76",
                                "sense_id": "719a00c3-49d0-3a92-a969-cfb84f1e9ed1",
                                "text": "\"Naturschutzgebiete sperren den Menschen nicht aus, jedoch sind Regeln, die den Schutz der Natur gewährleisten, zu beachten.\""
                            },
                            {
                                "example_id": "a3be1315-69ad-4493-b636-f0bfea66da2a",
                                "sense_id": "719a00c3-49d0-3a92-a969-cfb84f1e9ed1",
                                "text": "„Die vorgeschlagenen Exkursionen führen in ausgewählte Naturschutzgebiete.“"
                            },
                            {
                                "example_id": "c839c8d7-5bdb-4ea5-9f42-76cf34b15341",
                                "sense_id": "719a00c3-49d0-3a92-a969-cfb84f1e9ed1",
                                "text": "„Vor dem Fenster ist das Naturschutzgebiet, das Tal und die Berge, hell- und dunkelgrün und blattgrün und grüngelb bewachsen wie mit Blumenkohlrosen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ade7e428-da05-48ed-a14e-8c642aa354e9",
                        "source_entry_id": "b98a288f-bbc2-3063-be08-e446bbbc63a3",
                        "source_sense_id": "719a00c3-49d0-3a92-a969-cfb84f1e9ed1",
                        "target_lang_word": "nature reserve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nature reserve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13a82837-0d3f-32a8-a553-1f15a6ea498c",
                                        "entry_id": "5aa5e247-16ad-371a-9a26-12e511b1a14d",
                                        "glosses": [
                                            "An area of land managed to conserve wildlife or plant habitat or other natural features."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "976eb434-92e0-4a04-8a8a-5763985482ea",
                                                "sense_id": "13a82837-0d3f-32a8-a553-1f15a6ea498c",
                                                "text": "The whole area is a network of nature reserves among estuaries and marshes, and a paradise for a moocher like me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e35bb1b-c598-47bb-9f6c-2ce9da21e612",
                        "source_entry_id": "b98a288f-bbc2-3063-be08-e446bbbc63a3",
                        "source_sense_id": "719a00c3-49d0-3a92-a969-cfb84f1e9ed1",
                        "target_lang_word": "nature protection area",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "09f9b31a-033c-46bd-98b6-4c4eac5253e5",
                        "source_entry_id": "b98a288f-bbc2-3063-be08-e446bbbc63a3",
                        "source_sense_id": "719a00c3-49d0-3a92-a969-cfb84f1e9ed1",
                        "target_lang_word": "réserve naturelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réserve naturelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf8fbc2a-9975-3b1c-b03e-4b1c1edbfda8",
                                        "entry_id": "6eed2a6e-5c98-3d7f-a59c-7db70b2b3f5c",
                                        "glosses": [
                                            "Type particulier de réserve pour protéger la nature, spécialement la faune et la flore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e098625-94f1-4b6e-9aef-51c3e4b3215e",
                                                "sense_id": "cf8fbc2a-9975-3b1c-b03e-4b1c1edbfda8",
                                                "text": "Sur sa puissante moto, il avait fait ce qu’il appelait sa promenade des plans d’eau, empruntant de petites routes sinueuses pour gagner l’étang de Léon, celui de Soustons, puis le Hardy, et enfin l’étang Blanc qui se trouvait dans une réserve naturelle au-dessus de Seignosse."
                                            },
                                            {
                                                "example_id": "32b1a958-8d6b-41b9-a0f2-0cf9b82cca34",
                                                "sense_id": "cf8fbc2a-9975-3b1c-b03e-4b1c1edbfda8",
                                                "text": "Dès le printemps, Julien, accompagné de son chien Fax, emmène les chèvres gambader sur le terril. C'est la transhumance. Les biquettes se nourrissent des broussailles. Elles permettent l'entretien de la végétation de cette réserve naturelle."
                                            },
                                            {
                                                "example_id": "586d8482-879d-4f64-8564-329015330b53",
                                                "sense_id": "cf8fbc2a-9975-3b1c-b03e-4b1c1edbfda8",
                                                "text": "C’est le paradoxe de la France : on peut chasser dans quasiment toutes les réserves naturelles, regrette Suzanne Forêt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
