{
    "word_family": [
        "retainer",
        "retention",
        "retentive",
        "retainment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dbf9d899-f794-32d3-8aaf-9a2a7b9e9f7f",
                    "sense_definition": "to keep something in one's possession or control; to continue to have something",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company managed to <w>retain</w> its market share despite the new competition.",
                            "target_lang_translations": {
                                "ru": "Компании удалось <w>сохранить</w> свою долю рынка, несмотря на новую конкуренцию."
                            }
                        },
                        {
                            "text": "You should <w>retain</w> a copy of the contract for your own records.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>оставить</w> копию контракта для собственного архива."
                            }
                        }
                    ],
                    "common_phrases": [
                        "retain control",
                        "retain a copy",
                        "retain ownership"
                    ],
                    "target_lang_definitions": {
                        "ru": "сохранять что-либо в своем владении или под контролем; продолжать обладать чем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "оставлять при себе, не теряя"
                            },
                            {
                                "target_lang_word": "удерживать",
                                "target_lang_sense_clarification": "сохранять контроль или долю"
                            },
                            {
                                "target_lang_word": "оставлять",
                                "target_lang_sense_clarification": "не отдавать, сохранять за собой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24328770-aa45-3bad-b104-67b99e4f0173",
                    "sense_definition": "to keep information or memories in the mind; to remember",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some students find it difficult to <w>retain</w> information during long lectures.",
                            "target_lang_translations": {
                                "ru": "Некоторым студентам трудно <w>удерживать</w> информацию в памяти во время длинных лекций."
                            }
                        },
                        {
                            "text": "He was able to <w>retain</w> facts easily because he had a photographic memory.",
                            "target_lang_translations": {
                                "ru": "Он легко <w>запоминал</w> факты, потому что у него была фотографическая память."
                            }
                        }
                    ],
                    "common_phrases": [
                        "retain information",
                        "retain facts",
                        "retain in memory"
                    ],
                    "target_lang_definitions": {
                        "ru": "удерживать информацию или воспоминания в уме; помнить"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удерживать",
                                "target_lang_sense_clarification": "в памяти"
                            },
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "информацию в уме"
                            },
                            {
                                "target_lang_word": "помнить",
                                "target_lang_sense_clarification": "не забывать факты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1cda8a4-555d-3bc9-97b7-e16d14ff0e61",
                    "sense_definition": "to keep something in place or use instead of removing it; to preserve",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old building will <w>retain</w> its original features after the renovation.",
                            "target_lang_translations": {
                                "ru": "Старое здание <w>сохранит</w> свои первоначальные черты после реконструкции."
                            }
                        },
                        {
                            "text": "The committee decided to <w>retain</w> the current policy for another year.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>оставить</w> текущую политику в силе еще на один год."
                            }
                        }
                    ],
                    "common_phrases": [
                        "retain features",
                        "retain the status-quo"
                    ],
                    "target_lang_definitions": {
                        "ru": "оставлять что-либо на месте или в использовании вместо удаления; сохранять"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "поддерживать в неизменном виде"
                            },
                            {
                                "target_lang_word": "оставлять",
                                "target_lang_sense_clarification": "не менять, не удалять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2183ecec-8441-3078-9052-eb245803cf77",
                    "sense_definition": "to hold or keep something inside; to contain or absorb",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "containment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Darker colors tend to <w>retain</w> heat more than lighter ones.",
                            "target_lang_translations": {
                                "ru": "Темные цвета, как правило, <w>удерживают</w> тепло лучше, чем светлые."
                            }
                        },
                        {
                            "text": "The soil in this area does not <w>retain</w> water very well.",
                            "target_lang_translations": {
                                "ru": "Почва в этой местности не очень хорошо <w>задерживает</w> воду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "retain heat",
                        "retain moisture",
                        "retain water"
                    ],
                    "target_lang_definitions": {
                        "ru": "удерживать что-либо внутри; содержать или поглощать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удерживать",
                                "target_lang_sense_clarification": "влагу, тепло"
                            },
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "тепло"
                            },
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "воду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1fe24b5-bc8c-361b-9cfc-1c7f94ba92e5",
                    "sense_definition": "to employ someone, especially a lawyer, by paying a preliminary fee",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family decided to <w>retain</w> a lawyer to handle the estate.",
                            "target_lang_translations": {
                                "ru": "Семья решила <w>нанять</w> адвоката для ведения дел с наследством."
                            }
                        },
                        {
                            "text": "He was <w>retained</w> as a consultant for the duration of the project.",
                            "target_lang_translations": {
                                "ru": "Его <w>привлекли</w> в качестве консультанта на время реализации проекта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "retain a lawyer",
                        "retain services"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in legal or professional contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "нанимать кого-либо, особенно адвоката, выплачивая предварительный гонорар"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нанимать",
                                "target_lang_sense_clarification": "адвоката или консультанта"
                            },
                            {
                                "target_lang_word": "привлекать",
                                "target_lang_sense_clarification": "услуги специалиста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "695f5429-391c-3c6d-98f7-5a088f4469b9",
                    "sense_definition": "to declare that a sin is not forgiven",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the scripture, it is said that whose sins you <w>retain</w>, they are <w>retained</w>.",
                            "target_lang_translations": {
                                "ru": "В Писании сказано: кому <w>оставите</w> грехи, на том <w>останутся</w>."
                            }
                        },
                        {
                            "text": "The priest has the authority to either remit or <w>retain</w> sins.",
                            "target_lang_translations": {
                                "ru": "Священник имеет власть либо отпускать, либо <w>удерживать</w> грехи."
                            }
                        }
                    ],
                    "antonyms": [
                        "remit"
                    ],
                    "common_phrases": [
                        "retain sins"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in religious or biblical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "объявлять грех непрощенным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставлять",
                                "target_lang_sense_clarification": "грехи непрощенными"
                            },
                            {
                                "target_lang_word": "удерживать",
                                "target_lang_sense_clarification": "грехи"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e7f5ab3-19fb-3355-854f-5868f34eade0",
                    "sense_definition": "the act of holding or keeping something; a possession",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "possession_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal document confirmed his <w>retain</w> of the property.",
                            "target_lang_translations": {
                                "ru": "Юридический документ подтвердил его <w>владение</w> имуществом."
                            }
                        },
                        {
                            "text": "In some old texts, the word refers to the <w>retain</w> of one's dignity.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых текстах это слово относится к <w>сохранению</w> собственного достоинства."
                            }
                        }
                    ],
                    "synonyms": [
                        "retainment",
                        "retaining"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "акт удержания или сохранения чего-либо; владение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удержание",
                                "target_lang_sense_clarification": "владение имуществом"
                            },
                            {
                                "target_lang_word": "сохранение",
                                "target_lang_sense_clarification": "акт сбережения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "687ca21d-e260-39cf-8ad5-348b2ae3ff43",
                    "sense_definition": "a group of attendants or servants accompanying an important person",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The duke arrived at the castle with a large <w>retain</w> of followers.",
                            "target_lang_translations": {
                                "ru": "Герцог прибыл в замок с большой <w>свитой</w> последователей."
                            }
                        },
                        {
                            "text": "The king's <w>retain</w> occupied the entire wing of the palace.",
                            "target_lang_translations": {
                                "ru": "<w>Сопровождение</w> короля заняло целое крыло дворца."
                            }
                        }
                    ],
                    "synonyms": [
                        "retinue"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "synonym of retinue"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "группа слуг или сопровождающих важное лицо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свита",
                                "target_lang_sense_clarification": "сопровождающие лица"
                            },
                            {
                                "target_lang_word": "сопровождение",
                                "target_lang_sense_clarification": "группа слуг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}