                            "Suriname, Nederlandse Antillen"
                        ],
                        "examples": [
                            {
                                "example_id": "e3c07da8-8f71-4e85-a911-ffdb85152007",
                                "sense_id": "018f399f-323a-3776-9bd5-12228e8ecbd8",
                                "text": "Vreede werd vier maal gekozen tot Statenlid namens de NPS voor de kieskring Brokopondo."
                            }
                        ]
                    }
