                            "accusative",
                            "singular"
                        ],
                        "form": "die Wärmequelle"
                    },
                    {
                        "form_id": "e1a7adcf-4d7a-498f-bfd5-e39c319da9e3",
                        "entry_id": "02d28903-0274-32c0-8ea3-5b90234ba856",
                        "tags": [
