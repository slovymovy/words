                        "entry_id": "84e13229-9462-3faf-90f4-ed348516ba63",
                        "glosses": [
                            "Retirer le caractère cuirassé de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eda870ed-ad88-4a26-a516-9f7af28255ba",
                                "sense_id": "c6012772-c9fc-3ac2-b3c3-8ec13fc605c1",
                                "text": "C'est du moins l'avis du savant ingénieur dont nous analysons le livre. Il ne craint pas, dans ses conclusions motivées, de conseiller de décuirasser nos navires."
                            },
                            {
                                "example_id": "27e917ef-4cf3-4338-8e50-0cf3bae31dcf",
                                "sense_id": "c6012772-c9fc-3ac2-b3c3-8ec13fc605c1",
                                "text": "Son cœur décuirassé Ouvre aux poignards vengeurs un chemin plus aisé."
                            }
                        ]
                    },
                    {
                        "sense_id": "6060cb83-6e5f-3702-950b-32e6e786cbcf",
                        "entry_id": "84e13229-9462-3faf-90f4-ed348516ba63",
                        "glosses": [
                            "Enlever la cuirasse de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f0807f9-014e-44fb-a1ca-21a996db0a7e",
                                "sense_id": "6060cb83-6e5f-3702-950b-32e6e786cbcf",
                                "text": "Alexandre dut décuirasser une partie de ses hoplites pour leur permettre de se mesurer à égalité avec leurs agiles adversaires en des combats de harcèlement de détail."
                            }
                        ]
