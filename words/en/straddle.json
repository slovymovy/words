{
    "word_family": [
        "straddler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4747b31d-f844-3b07-a9f0-97982fda33bb",
                    "sense_definition": "To sit or stand with a leg on each side of something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "positioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child decided to <w>straddle</w> the wooden fence to get a better view.",
                            "target_lang_translations": {
                                "pl": "Dziecko postanowiło <w>usiąść okrakiem</w> na drewnianym płocie, żeby mieć lepszy widok."
                            }
                        },
                        {
                            "text": "He had to <w>straddle</w> the narrow stream to keep his boots dry.",
                            "target_lang_translations": {
                                "pl": "Musiał <w>stanąć okrakiem</w> nad wąskim strumieniem, żeby nie zamoczyć butów."
                            }
                        }
                    ],
                    "synonyms": [
                        "stride",
                        "arch",
                        "traverse"
                    ],
                    "target_lang_definitions": {
                        "pl": "Siedzieć lub stać okrakiem na czymś, mając nogi po obu stronach."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "siedzieć okrakiem",
                                "target_lang_sense_clarification": "pozycja ciała z nogami po obu stronach obiektu"
                            },
                            {
                                "target_lang_word": "stać okrakiem",
                                "target_lang_sense_clarification": "pozycja stojąca z nogami po obu stronach obiektu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df4d6307-8be9-3bf6-baa2-0a2e9da924da",
                    "sense_definition": "To be located on both sides of a boundary or to span across different regions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "positioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small village <w>straddles</w> the border between the two countries.",
                            "target_lang_translations": {
                                "pl": "Mała wioska <w>rozciąga się po obu stronach</w> granicy między dwoma krajami."
                            }
                        },
                        {
                            "text": "The new highway <w>straddles</w> the valley and connects the two mountain towns.",
                            "target_lang_translations": {
                                "pl": "Nowa autostrada <w>rozciąga się przez</w> dolinę i łączy dwa górskie miasteczka."
                            }
                        }
                    ],
                    "synonyms": [
                        "traverse"
                    ],
                    "target_lang_definitions": {
                        "pl": "Znajdować się po obu stronach granicy lub rozciągać się na różne obszary."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozciągać się po obu stronach",
                                "target_lang_sense_clarification": "dotyczy położenia geograficznego lub zasięgu"
                            },
                            {
                                "target_lang_word": "leżeć po obu stronach",
                                "target_lang_sense_clarification": "dotyczy lokalizacji obiektu względem granicy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2af8d8a-2ab0-3d4c-ab43-0d46383e4d8a",
                    "sense_definition": "To avoid taking a clear position by appearing to favor two opposing sides.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician tried to <w>straddle</w> the issue to keep voters from both parties happy.",
                            "target_lang_translations": {
                                "pl": "Polityk próbował <w>lawirować</w> w tej kwestii, aby zadowolić wyborców obu partii."
                            }
                        },
                        {
                            "text": "It is difficult to <w>straddle</w> the fence when a firm decision is required.",
                            "target_lang_translations": {
                                "pl": "Trudno jest <w>siedzieć okrakiem na płocie</w>, gdy wymagana jest stanowcza decyzja."
                            }
                        }
                    ],
                    "common_phrases": [
                        "straddle the fence"
                    ],
                    "target_lang_definitions": {
                        "pl": "Unikać zajęcia jasnego stanowiska, próbując zadowolić dwie przeciwne strony."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "lawirować",
                                "target_lang_sense_clarification": "unikanie jednoznacznej opinii"
                            },
                            {
                                "target_lang_word": "siedzieć okrakiem na płocie",
                                "target_lang_sense_clarification": "idiomatyczne określenie braku zdecydowania"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "21f1a5b6-721f-33b3-b7ab-a92ae7f9721e",
                    "sense_definition": "A physical posture where one leg is placed on each side of an object.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "positioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He maintained a wide <w>straddle</w> while balancing on the beam.",
                            "target_lang_translations": {
                                "pl": "Utrzymywał szeroki <w>rozkrok</w>, balansując na belce."
                            }
                        },
                        {
                            "text": "The gymnast performed a jump into a perfect <w>straddle</w>.",
                            "target_lang_translations": {
                                "pl": "Gimnastyczka wykonała skok do idealnego <w>rozkroku</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Postawa fizyczna, w której jedna noga znajduje się po każdej stronie obiektu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozkrok",
                                "target_lang_sense_clarification": "pozycja ciała z szeroko rozstawionymi nogami"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}