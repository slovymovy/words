                "senses": [
                    {
                        "sense_id": "b686cd23-0de8-393b-85fd-c4f34f29f5b5",
                        "entry_id": "284d9908-24b7-35e2-9a06-3f02deac6b04",
                        "glosses": [
                            "eng anliegende, elastische Hose, die speziell fürs Laufen konzipiert ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "6b8a8a34-ed37-4720-8a76-ab21fd7f1cf2",
                                "sense_id": "b686cd23-0de8-393b-85fd-c4f34f29f5b5",
                                "text": "„Unter 0 Grad ziehe ich unter der Laufhose noch eine kurze Lauftight drunter.“"
                            },
                            {
                                "example_id": "3689aec4-5345-4a1f-830f-aa20d9dc4747",
                                "sense_id": "b686cd23-0de8-393b-85fd-c4f34f29f5b5",
                                "text": "„Ich habe eine Lauftight von Formbelt, glaube ich, jedenfalls mit integriertem Laufgürtel für Handy, Schlüssel etc. und die ist super!“"
                            },
                            {
                                "example_id": "55adb879-9dff-42db-a099-a8649799e726",
                                "sense_id": "b686cd23-0de8-393b-85fd-c4f34f29f5b5",
                                "text": "„Die lange Lauftight eignet sich am besten für den saisonalen Übergang.“"
                            },
                            {
                                "example_id": "e759b851-f77c-4fd1-b24b-5fdf1a44f522",
                                "sense_id": "b686cd23-0de8-393b-85fd-c4f34f29f5b5",
                                "text": "„Egal, ob du morgendliche Runden in der Nachbarschaft drehst oder den Tag mit einem entspannenden Lauf ausklingen lässt, diese adidas Lauftight ist der perfekte Begleiter für dein tägliches Training.“"
                            },
                            {
                                "example_id": "e06fd123-8ef1-4b2d-80b1-e0a60e4528da",
                                "sense_id": "b686cd23-0de8-393b-85fd-c4f34f29f5b5",
                                "text": "„Die kurze Lauftight bietet über 15 Grad Außentemperatur ein großes Einsatzspektrum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
