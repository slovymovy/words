                ],
                "senses": [
                    {
                        "sense_id": "df9181ad-f19b-310d-b8d5-75b20e1d9c9a",
                        "entry_id": "b3162072-980f-3b98-9c7a-8c7258db3a93",
                        "glosses": [
                            "kompakte Masse aus Fleisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47ead614-ced0-45d9-a6a0-efbc8221dab3",
                                "sense_id": "df9181ad-f19b-310d-b8d5-75b20e1d9c9a",
                                "text": "„Ihre Arme und Beine wogten in wahren Fleischklumpen aus dem blauen Kleidchen hervor und glichen Vanille-Eis-Gebirgen, die zu schmelzen anfangen.“"
                            },
                            {
                                "example_id": "a1a4c65f-b740-49a3-bf71-9ca3536cb4d8",
                                "sense_id": "df9181ad-f19b-310d-b8d5-75b20e1d9c9a",
                                "text": "„Hier hingen sie, diese rasierten, ausgebluteten, aufgeschlitzten menschlichen Fleischklumpen, wie Fische ausgeweidet und fertig zum Verzehr.“"
                            },
                            {
                                "example_id": "365049f2-6bd8-44b8-a795-21adb7380de9",
                                "sense_id": "df9181ad-f19b-310d-b8d5-75b20e1d9c9a",
                                "text": "„Ich hebe Extremitäten und Fleischklumpen auf, inspiziere sie und stecke die frischeren Teile in meinen Rucksack.“"
                            },
                            {
                                "example_id": "722b3249-6139-43d5-b27a-67d345417103",
                                "sense_id": "df9181ad-f19b-310d-b8d5-75b20e1d9c9a",
                                "text": "„Noch erschütternder waren die Erzeugnisse mancher Experimente - grausige Fleischklumpen, die tot gewesen waren, die West jedoch zu einem blinden, hirnlosen, ekelerregenden Leben erweckt hatte.“"
                            },
                            {
                                "example_id": "4e1b3549-d7b8-4ce5-9e2e-f93fb8dc5f65",
                                "sense_id": "df9181ad-f19b-310d-b8d5-75b20e1d9c9a",
                                "text": "„Noch schlimmer als der Anblick jenes gräulichen, halb dinghaften Fleischklumpens waren die Geräusche, welche durch die Wände, die Bell umgaben, und selbst über die freigeschaltete Sprechanlage an sein Ohr drangen.“"
                            },
                            {
                                "example_id": "b23b2a90-cf61-4997-882d-03b69e3dbae3",
                                "sense_id": "df9181ad-f19b-310d-b8d5-75b20e1d9c9a",
                                "text": "„Und er sieht in Toris Mund den Fleischklumpen, den sie genießerisch kaut, wie sie erst kurz vorher die gefüllten Champignons genossen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
