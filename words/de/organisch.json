                    "frequency": "High",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bakterien zersetzen totes <w>organisches</w> Material im Boden und verwandeln es in fruchtbaren Humus."
                        },
                        {
                            "text": "In der braunen Tonne werden ausschließlich <w>organische</w> Abfälle aus Küche und Garten gesammelt."
