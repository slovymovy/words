                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b8db2c8-bcc0-42dc-8dee-7e63fb362300",
                                                "sense_id": "fa3b8ccc-d9bd-3e04-a69a-2262a7e6bc89",
                                                "text": "Aufgrund der Asexualität von Schleimlingen, müssen diese sich durch Hormogonien fortpflanzen."
