                "senses": [
                    {
                        "sense_id": "9303fd09-12c9-368f-af43-f219b2039a10",
                        "entry_id": "85766791-f71f-308e-b4a9-02db36ca28c7",
                        "glosses": [
                            "margin; edge"
                        ],
                        "tags": [
                            "obsolete",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "5af0cd06-7b36-4662-acee-1f292c0e47e4",
                                "sense_id": "9303fd09-12c9-368f-af43-f219b2039a10",
                                "text": "Nothing but this! Yes, as much love in rime\nAs would be cramm'd up in a sheet of paper\nWrit o' both sides the leaf, margent and all,\nThat he was fain to seal on Cupid's name."
                            },
                            {
                                "example_id": "b88c075e-26f9-4cf6-99c9-b0660cf53cb8",
                                "sense_id": "9303fd09-12c9-368f-af43-f219b2039a10",
                                "text": "Examine every married lineament,\nAnd see how one another lends content\nAnd what obscured in this fair volume lies\nFind written in the margent of his eyes."
                            },
                            {
                                "example_id": "464dfc41-66c1-4d09-89ed-368d376999de",
                                "sense_id": "9303fd09-12c9-368f-af43-f219b2039a10",
                                "text": "Sweet Echo, sweetest nymph, that liv'st unseen\nWithin thy airy shell\nBy slow Meander's margent green",
                                "translation": "Comus",
                                "english": "Comus"
                            },
                            {
                                "example_id": "a5455c8e-c86b-4239-95a8-6ae345e85c25",
                                "sense_id": "9303fd09-12c9-368f-af43-f219b2039a10",
                                "text": "All the ancient Inscriptions are entertoilees with Snakes, e. g. as in the margent."
                            }
                        ]
                    }
                ],
