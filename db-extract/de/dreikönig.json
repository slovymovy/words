                        "examples": [
                            {
                                "example_id": "59cb9a50-f30f-4fce-91d9-72f438b4f235",
                                "sense_id": "0d278e58-1de0-3797-b356-7d266812a0fc",
                                "text": "Dreikönig fällt dieses Jahr auf einen Montag."
                            },
                            {
                                "example_id": "896d1933-f1c6-4ad2-abdd-5f04ea61b97a",
                                "sense_id": "0d278e58-1de0-3797-b356-7d266812a0fc",
                                "text": "Die Schulferien dauerten bis Dreikönig."
                            },
                            {
                                "example_id": "ab194b88-20be-46e3-8f7d-7a5b27d353cd",
                                "sense_id": "0d278e58-1de0-3797-b356-7d266812a0fc",
                                "text": "An Dreikönig schien die Sonne und Tante Magda besuchte ihre geliebten Kinder."
                            },
                            {
                                "example_id": "1afc9134-a0a8-44ff-82d8-47e336752408",
                                "sense_id": "0d278e58-1de0-3797-b356-7d266812a0fc",
                                "text": "„Dreikönige fallen/fällt auf einen Sonntag“."
                            }
                        ],
