                    },
                    {
                        "translation_id": "1d3d76df-6797-4f5c-9e2d-67d03ee5267f",
                        "source_entry_id": "24670ed4-7b86-3fd5-ab7b-0b302b1de433",
                        "source_sense_id": "fc19082d-f7b3-39c3-864f-3abe4f871020",
                        "source_sense_description": "Film, dessen Handlung erfunden ist und zur Unterhaltung dient",
                        "target_lang_word": "long métrage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "long métrage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e54c31e-cf31-3d19-851a-b4c896bb54a0",
                                        "entry_id": "20d18bec-b2a0-3a30-ac26-cccc0a32b28f",
                                        "glosses": [
                                            "Film d’une durée significative (en France, dont la durée est supérieure à 58 minutes et 29 secondes, c’est-à-dire l’équivalent d’une bobine de film de 35 mm)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab0598e5-7571-4f51-a644-8eea3e64c5ba",
                                                "sense_id": "0e54c31e-cf31-3d19-851a-b4c896bb54a0",
                                                "text": "En 1996, la productrice française Sophie Goupil choisit de coproduire La Cinquième Saison, première coproduction franco-iranienne de long métrage, avec une institution publique, la fondation Fârâbi."
                                            },
                                            {
                                                "example_id": "8b21f97e-b926-4266-995f-e36487724327",
                                                "sense_id": "0e54c31e-cf31-3d19-851a-b4c896bb54a0",
                                                "text": "Un Roman policier, mon premier long métrage, est né du désir de retravailler avec les comédiens de mon deuxième court métrage (Hymne à la gazelle), Abdelhafid Metalsi et Marie-Laure Descoureaux, et de l'envie de raconter une histoire avec de l’action."
                                            },
                                            {
                                                "example_id": "7c946bf4-aec0-4e71-9b30-81e3967a84e2",
                                                "sense_id": "0e54c31e-cf31-3d19-851a-b4c896bb54a0",
                                                "text": "Le deuxième long métrage de Laurent Larivière, À propos de Joan, présenté à la Berlinale cette année, met en lumière une Isabelle Huppert bouleversante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
