                "senses": [
                    {
                        "sense_id": "8e979c52-9a6c-3003-9a49-b0bcd7b4ff67",
                        "entry_id": "f07acd8d-5652-3829-93d5-1abb9431c890",
                        "glosses": [
                            "Person, die – in erster Linie in der Natur – nach Fährten von Tieren oder Menschen sucht und diese gegebenenfalls verfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a06c6962-a8fb-453e-aa5f-051c17b27851",
                                "sense_id": "8e979c52-9a6c-3003-9a49-b0bcd7b4ff67",
                                "text": "Der Fährtensucher der Cherokee-Indianer kniete am Boden des Waldes und untersuchte die frische Spur eines Grizzlybären."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "021d169e-4bc4-4307-b3bb-4ea4327c4778",
                        "source_entry_id": "f07acd8d-5652-3829-93d5-1abb9431c890",
                        "source_sense_id": "8e979c52-9a6c-3003-9a49-b0bcd7b4ff67",
                        "target_lang_word": "tracker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tracker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f88c8d0-f114-3554-9b17-a9c4bcb57517",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "Agent noun of track; one who, or that which, tracks or pursues, as a man or dog that follows game."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f383798b-3baa-43af-9b5f-759e964ae0e4",
                                                "sense_id": "8f88c8d0-f114-3554-9b17-a9c4bcb57517",
                                                "text": "On Friday night, eight US Air Force KC-135 Stratotankers took off from Altus, Oklahoma, according to data from FlightRadar24. Over Kansas the tankers refueled two groups of planes, identified on air traffic control audio by their callsigns MYTEE11 FLT and MYTEE21 FLT. The callsign MYTEE has previously been associated with special activity flights by B-2 bombers, and multiple flight trackers on social media said the planes being refueled were B-2 bombers out of Whiteman Air Force Base in Missouri."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "146e0944-2560-3357-9ac4-7c01515cfae0",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "Agent noun of track; one who, or that which, tracks or pursues, as a man or dog that follows game.",
                                            "A person employed to follow and monitor a political rival."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d21312d5-319f-41b5-bee8-7941b31acc6f",
                                                "sense_id": "146e0944-2560-3357-9ac4-7c01515cfae0",
                                                "text": "While she and Mr. Fetterman were often in different places, she would turn up at events early so she could shoot and post photos of the crowds, the lines, the people. At most events there was a tracker: a guy from the Oz team who monitored the goings-on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4c48db4-156b-3fbc-995b-b8865d0b95fd",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "In an organ, a light strip of wood connecting (in path) a key and a pallet, to communicate motion by pulling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cd5f5be-00c9-3dd7-9b75-e0023847101b",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "A type of computer software for composing music by aligning notes or samples on parallel timelines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60336015-1bb1-4f14-bd26-d052ce431c83",
                                                "sense_id": "2cd5f5be-00c9-3dd7-9b75-e0023847101b",
                                                "text": "Trackers have broken out of the demoscene, are are^([sic]) now in use by thousands of professional musicians. It's not uncommon to hear about people using trackers on DJ forums, and electronic music production communities[…]"
                                            },
                                            {
                                                "example_id": "a6883673-5bb5-4845-8b1e-f9b1b8ba473c",
                                                "sense_id": "2cd5f5be-00c9-3dd7-9b75-e0023847101b",
                                                "text": "Although there were a few game companies outside the Amiga scene that used a tracker format (Epic Mega-Games, for instance), the majority used the better-supported MIDI."
                                            },
                                            {
                                                "example_id": "994b5dfc-2a00-4b88-b4c9-90c19196192e",
                                                "sense_id": "2cd5f5be-00c9-3dd7-9b75-e0023847101b",
                                                "text": "At the time, tracking chiptunes (i.e. using trackers) was the fundamental method of chipmusic-making."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b0f7951-9d4a-3cb9-8e74-748a924bcedb",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "A musician who writes music in a tracker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80bbadf5-5cdf-4495-b951-002f100f5c41",
                                                "sense_id": "2b0f7951-9d4a-3cb9-8e74-748a924bcedb",
                                                "text": "You can always find musicians. There are more trackers than coders, pixelers, organizers, couriers, and designers combined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00bff621-c980-306a-b8e6-2fc2d7d82aa2",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "A computer program that monitors something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbf882be-4eb8-3797-971c-442bcfef1902",
                                        "entry_id": "cf0b002e-b953-3fc0-9417-5bd5cb396d5c",
                                        "glosses": [
                                            "A computer program that monitors something.",
                                            "Server software that coordinates peers in the BitTorrent protocol."
                                        ],
                                        "tags": [],
