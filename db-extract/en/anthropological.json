                                        "entry_id": "a48c9bf8-857e-33ff-9400-b7b1e3ba3c6e",
                                        "glosses": [
                                            "die Wissenschaft vom Menschen, seinem Wesen und seiner Entwicklung (Anthropologie) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84e8bff3-2565-4881-8166-54b846f0d86c",
                                                "sense_id": "61c24cc2-aa4a-3b3c-8652-611e9ee3db84",
                                                "text": "Das antike Ägypten ist Gegenstand anthropologischer Forschung."
                                            },
                                            {
                                                "example_id": "883f01f6-bcb9-4731-8584-5ddf5d000691",
                                                "sense_id": "61c24cc2-aa4a-3b3c-8652-611e9ee3db84",
                                                "text": "„Es war ein im akademischen Sinne todernstes Buch, vollgepackt mit den linguistischen und anthropologischen Erkenntnissen, die er am Amazonas gesammelt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
