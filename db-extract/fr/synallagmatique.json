                ],
                "senses": [
                    {
                        "sense_id": "bafb1a73-ee1f-36c8-821d-fbd482e7b8e2",
                        "entry_id": "6ea37641-00f0-375f-ae99-48b820639252",
                        "glosses": [
                            "Qualifie les contrats qui contiennent une obligation réciproque entre les parties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc1f235f-3e5e-46cd-814d-10fa56f611cd",
                                "sense_id": "bafb1a73-ee1f-36c8-821d-fbd482e7b8e2",
                                "text": "Les actes sous seing privé qui contiennent des conventions synallagmatiques ne sont valables qu’autant qu’ils ont été faits en autant d’originaux qu’il y a de parties ayant un intérêt distinct."
                            },
                            {
                                "example_id": "27034e14-6c35-4a4e-8dcd-5cdde9f4c453",
                                "sense_id": "bafb1a73-ee1f-36c8-821d-fbd482e7b8e2",
                                "text": "L’accord des volontés étant réalisé, le contrat devient parfait et synallagmatique quoique verbal !"
                            },
                            {
                                "example_id": "26c22dd0-b8bb-4cc7-8211-c8f049f7ef09",
                                "sense_id": "bafb1a73-ee1f-36c8-821d-fbd482e7b8e2",
                                "text": "Le contrat peut n’être pas écrit, il n’en existe pas moins juridiquement : il est synallagmatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a23d0b2-6b8b-4a5d-928e-726c5b986702",
                        "source_entry_id": "6ea37641-00f0-375f-ae99-48b820639252",
