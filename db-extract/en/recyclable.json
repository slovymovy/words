                    {
                        "translation_id": "d778e7e9-3ea0-45b8-a929-5b9359a40af0",
                        "source_entry_id": "5c2d9bb8-8dbc-3214-a985-58df2f5f4d3d",
                        "source_sense_id": "dcb30761-d90a-3f5e-bb85-4addbe3a98b0",
                        "source_sense_description": "able to be recycled",
                        "target_lang_word": "wiederverwertbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wiederverwertbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                        "entry_id": "d22b69e1-085b-307c-8cf1-4b28d4fb1017",
                                        "glosses": [
                                            "so, dass eine erneute Nutzung möglich ist"
                                        ],
                                        "tags": [
                                            "Recycling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddda4540-7c9d-4666-8dde-7ad9a4997ec9",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "„Eine modifizierte, geflügelte und wiederverwertbare Raketenstufe Saturn-IC (S-IC) sollte als Booster für das Space Shuttle verwendet werden.“"
                                            },
                                            {
                                                "example_id": "0392af90-79aa-4c52-a04c-9df65371f43f",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "„Jedes Produkt soll so hergestellt werden, dass es wiederverwertbar ist.“"
                                            },
                                            {
                                                "example_id": "2196228e-8a44-4277-8939-7c5f88fdb949",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "„Stahl ist einer der vielseitigsten Konstruktionswerkstoffe und ist nahezu unbegrenzt wiederverwertbar.“"
                                            },
                                            {
                                                "example_id": "b809a5d2-e132-45a3-9fcc-89415e4fd778",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "„Auch Plastik wäre kein Problem - wenn es hochwertig und wiederverwertbar wäre.“"
                                            },
                                            {
                                                "example_id": "abd69511-fc55-4edb-a0e8-dff7f9b2a157",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "[Verpackungsgesetz:] „Das Gesetz richtet sich an Hersteller, Online-Händler und Unternehmen, die wiederverwertbare Verpackungen in Umlauf bringen.“"
                                            },
                                            {
                                                "example_id": "633d4622-d689-46d4-8807-2937c850497d",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "„Kaffee zum Mitnehmen oder Bier im Stadion - wir trinken gern unterwegs. Meist gibt's das Getränk im Plastik- oder Pappbecher. Wäre Glas oder Keramik nicht umweltfreundlicher, da wiederverwertbar?“"
                                            },
                                            {
                                                "example_id": "cf5411c7-7965-473e-8403-6fa6b9d77022",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "„Die Post testet im nächsten Jahr neue Verpackungen von Paketen. Die Bestellungen bei fünf ausgewählten Onlinehändlern werden dann in Paketen aus wiederverwertbaren Materialien zugestellt. Damit soll unter anderem Müll vermieden werden.“"
                                            },
                                            {
                                                "example_id": "331a8326-00af-45e8-b453-2814005eeab9",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "„Bis zum Jahr 2015 hatte man sich zum Ziel gesetzt, ein Viertel der verkauften Getränke in wiederverwertbare Becher abzufüllen. Im Jahr 2011 war die Bilanz kläglich: Gerade einmal 1,9 Prozent der Kaffeegetränke wanderten in die \"Umwelt-Becher\".“"
                                            },
                                            {
                                                "example_id": "c681f781-9874-405b-8332-465a0a8a7d4e",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "„Vom Restmüll sind bis zu 20 Prozent gut wiederverwertbar und zu schade zum Verbrennen. Kunststoffbehälter, Glas, Dosen aus Eisenblech und vieles mehr werden stofflich wiederverwertet.“"
                                            },
                                            {
                                                "example_id": "64f4e86d-6cf6-42b9-b4a5-db35b7dc5f88",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "„Zwei Aargauer Jungunternehmer möchten mit Abfallrecycling Geld verdienen und haben dazu das Unternehmen Recyclingfux gegründet. Es holt wiederverwertbare Abfälle bei Betagten und beruflich eingespannten Menschen ab.“"
                                            },
                                            {
                                                "example_id": "ce2df94f-39a1-4a41-bbf7-1a9cec225ac6",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "[…] „Seit Januar 2021 ist der Export von nicht wiederverwertbaren Abfällen nach dem \"Basler Übereinkommen über die Kontrolle der grenzüberschreitenden Verbringung gefährlicher Abfälle und ihre Entsorgung\" verboten. EU-Firmen dürften nur noch saubere und gut sortierte Kunststoffabfälle zum Recyceln exportieren.“"
                                            },
                                            {
                                                "example_id": "07e81f17-25ca-4fc2-85e2-b96737ec95b7",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "„Exporteure, auch solche aus dem Vereinigten Königreich, machten Gewinn damit, dass sie Zwischenhändlern und Unternehmern die Übernahme von wiederverwertbarem Plastikmüll bescheinigen und dies in Rechnung stellten.“"
                                            },
                                            {
                                                "example_id": "b481302e-93d7-46ce-aba4-97308570294e",
                                                "sense_id": "cecf552c-7f3d-3ed2-9921-ea0a62ea97d7",
                                                "text": "„Läuft alles nach Plan, kehrt das wiederverwertbare Raumschiff zur Erde zurück und landet im US-Bundesstaat New Mexico in der Wüste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
