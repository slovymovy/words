                                "sense_id": "8b9e1dfe-3a24-3284-ac69-4b7f8457b15c",
                                "text": "Amulet ma dawną tradycję, znany jest na całym świecie oraz przybiera różne formy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
