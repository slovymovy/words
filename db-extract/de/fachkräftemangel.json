                "senses": [
                    {
                        "sense_id": "21f426a6-6eff-3184-a0d8-edfb208dc891",
                        "entry_id": "2614dbdc-4fd5-3836-a0d1-e6807128f13a",
                        "glosses": [
                            "Manque, pénurie de personnel qualifié."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "0cc4cab4-f037-4c63-9618-b021f3fab273",
                                "sense_id": "21f426a6-6eff-3184-a0d8-edfb208dc891",
                                "text": "Im Bausektor herrscht zurzeit ein starker Fachkräftemangel.",
                                "translation": "Actuellement, il règne dans le secteur de la construction une forte pénurie de personnel qualifié."
                            },
                            {
                                "example_id": "18078770-d876-4e1b-a886-686e1d4682a1",
                                "sense_id": "21f426a6-6eff-3184-a0d8-edfb208dc891",
                                "text": "Angesichts des Fachkräftemangels würde ich ja gern Werbung machen, aber: Ausbildung im Handwerk ist scheiße.",
                                "translation": "Face à la pénurie de main-d'œuvre qualifiée, j'aimerais bien faire de la publicité, mais : la formation dans l’artisanat, ça craint."
                            },
                            {
                                "example_id": "1cff4872-a87c-44dc-9061-3431de86001f",
                                "sense_id": "21f426a6-6eff-3184-a0d8-edfb208dc891",
                                "text": "Die beiden Verbrecher sprengten (...) keinen Geldautomaten, sondern einen Kontoauszugdrucker (...) Der gescheiterte Diebstahl sorgt für Häme in den sozialen Netzwerken. Vom \"Fachkräftemangel auch bei Dieben\" ist die Rede, und von \"verständlicher\" Aggression gegen kaputte Drucker.",
                                "translation": "Les deux criminels n'ont pas fait exploser un distributeur automatique de billets (...) mais une imprimante de relevés bancaires (...) Le vol raté suscite la moquerie sur les réseaux sociaux. On parle d’une « pénurie de main-d'œuvre qualifiée, même chez les voleurs » et d’une agressivité « compréhensible » contre les imprimantes cassées."
                            }
                        ]
                    }
                ],
