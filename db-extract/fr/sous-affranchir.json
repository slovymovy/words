                ],
                "senses": [
                    {
                        "sense_id": "44a0724a-bb7a-32d7-bfd5-6eab96bc9337",
                        "entry_id": "d3011239-3b6e-33a1-ae23-51d14c703f58",
                        "glosses": [
                            "Affranchir (un courrier) à un tarif inférieur au tarif normal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9391e700-2fc8-4569-bfe1-38de2370bd93",
                                "sense_id": "44a0724a-bb7a-32d7-bfd5-6eab96bc9337",
                                "text": "Kascynski avait même été jusqu'à sous-affranchir son paquet, afin qu'il soit « retourné à l'expéditeur »."
                            },
                            {
                                "example_id": "658d8bf9-4d14-4871-82e4-87c480e1225c",
                                "sense_id": "44a0724a-bb7a-32d7-bfd5-6eab96bc9337",
                                "text": "Je trouve irresponsable qu'un PRO, qui est censé avoir une certaine éthique et un certain respect de ses clients, puisse sous-affranchir un envoi dans le but du profit immédiat tout en prenant le risque qu'une lettre se perde ou que le client ait à payer une surtaxe."
                            },
                            {
                                "example_id": "1bff909a-3004-4063-b7fb-162cfc09a76a",
                                "sense_id": "44a0724a-bb7a-32d7-bfd5-6eab96bc9337",
                                "text": "Si je sous-affranchis mon enveloppe, dans 99 cas sur 100 elle arrive quand même au destinataire."
                            }
                        ]
                    }
                ],
