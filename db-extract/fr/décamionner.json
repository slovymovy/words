                "senses": [
                    {
                        "sense_id": "4fd68e01-8d4f-3b62-9fb6-d73e5d83fcae",
                        "entry_id": "41ee0498-82e1-3011-a0ae-3c9b28c72633",
                        "glosses": [
                            "Enlever du camion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8765450-3483-4fc0-ad3c-dac836867fb4",
                                "sense_id": "4fd68e01-8d4f-3b62-9fb6-d73e5d83fcae",
                                "text": "C'est pas tant qu'il faille déneiger, il faut aussi décamionner, après."
                            },
                            {
                                "example_id": "1707aaa1-07d6-4f6c-8f24-6a904bcfc3b3",
                                "sense_id": "4fd68e01-8d4f-3b62-9fb6-d73e5d83fcae",
                                "text": "J'imagine l'éducatrice qui m'aimerait tellement d'être obligé de le « décamionner » à chaque fois qu'il veut aller sur le pot (ce qui est environ aux 8 minutes, et à ce jour, TOUJOURS une fausse alerte.)"
                            },
                            {
                                "example_id": "e720f168-72ba-4f5a-86e6-32c7bb44c63f",
                                "sense_id": "4fd68e01-8d4f-3b62-9fb6-d73e5d83fcae",
                                "text": "Je le décamionne, je le déprocède (je commence à m'énerver, il faut en finir), je l'enkepse, je le flashballise, je le detasere Et l'introduis dans une cellule."
                            }
                        ]
                    }
