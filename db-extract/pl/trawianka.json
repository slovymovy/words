                        "glosses": [
                            "Perccottus glenii, gatunek ryby okoniokształtnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddb39714-1814-4173-bd30-8cba1e51f968",
                                "sense_id": "af3cccbf-52b9-37f4-94e1-495667e72afe",
                                "text": "Trawianka może przenosić choroby na rodzime gatunki, ale także potencjalnie wypierać je lokalnie poprzez zjadanie ich pożywienia."
                            },
                            {
                                "example_id": "76392a5b-f79b-42af-bf1f-1f07d9066fb5",
                                "sense_id": "af3cccbf-52b9-37f4-94e1-495667e72afe",
                                "text": "Trawianki są odporne na przemarzanie i przesychanie stawów, więc potrafią przetrwać w miejscach, w których inne ryby nie przeżywają"
                            }
                        ],
