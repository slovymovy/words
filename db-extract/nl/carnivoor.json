                    {
                        "translation_id": "84388cce-de9e-4f48-a3a3-d24882f038a2",
                        "source_entry_id": "d128d273-048c-3939-a36d-8b0d97f53521",
                        "source_sense_id": "1c1b7c15-fcf4-3bd2-9188-4d7513b63e5e",
                        "source_sense_description": "een vleesetend dier",
                        "target_lang_word": "Fleischfresser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fleischfresser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "072b0a0d-80f7-3202-9d41-35fdd4be1e56",
                                        "entry_id": "f1d061a4-b670-35b6-8658-afde8829d15d",
                                        "glosses": [
                                            "ein Lebewesen, das ausschließlich, hauptsächlich oder teilweise aus tierischen Organismen seine Nahrung bezieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73568b3a-16cc-4e97-83cf-02c6df7ea365",
                                                "sense_id": "072b0a0d-80f7-3202-9d41-35fdd4be1e56",
                                                "text": "Das Krokodil ist ein Fleischfresser."
                                            },
                                            {
                                                "example_id": "d98e5d93-a791-481c-85a7-6703e16def76",
                                                "sense_id": "072b0a0d-80f7-3202-9d41-35fdd4be1e56",
                                                "text": "Pflanzenfresser haben ein anderes Gebiss als Fleischfresser."
                                            },
                                            {
                                                "example_id": "869a3cda-cfae-4b31-8995-82485ec8d843",
                                                "sense_id": "072b0a0d-80f7-3202-9d41-35fdd4be1e56",
                                                "text": "Der Mensch ist nicht nur Fleischfresser, sondern ein Allesfresser, vermutlich weil seine Ahnen Aasfresser waren."
                                            },
                                            {
                                                "example_id": "e7a7740a-e0fd-413b-b774-a9240b1386a3",
                                                "sense_id": "072b0a0d-80f7-3202-9d41-35fdd4be1e56",
                                                "text": "„Jetzt, wo auf der Welt und vor allem in deutschen Küchen und Restaurants das Veganertum ausgebrochen ist, habe ich den folgenden Stoßseufzer eines hartnäckigen Fleischfressers gefunden, mit dem ich diesen philosophischen Ekurs über Fressen und Gefressenwerden beenden möchte.“"
                                            },
                                            {
                                                "example_id": "bece221a-b66e-4a5c-801e-2b4c3fa91182",
                                                "sense_id": "072b0a0d-80f7-3202-9d41-35fdd4be1e56",
                                                "text": "„Obwohl die jungen Fleischfresser fast doppelt so groß waren wie der Pflanzenfresser, hielten sie Abstand und wagten nur zaghafte Angriffe während ihre Beute sich zusammenkauerte und ihre Verteidigungswaffen gegen sie richtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcc8a1b3-0eaa-4252-8e70-c6bfeca57d61",
                        "source_entry_id": "d128d273-048c-3939-a36d-8b0d97f53521",
                        "source_sense_id": "1c1b7c15-fcf4-3bd2-9188-4d7513b63e5e",
                        "source_sense_description": "een vleesetend dier",
                        "target_lang_word": "carnivore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carnivore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae84106c-68c3-3a63-96bc-a74399fcc81e",
                                        "entry_id": "e6a7937d-4e80-3e2f-9724-0c8ec334a288",
                                        "glosses": [
                                            "An organism that feeds chiefly on animals; an animal that feeds on meat as the main part of its diet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0901356-754a-4c47-8921-18c489bbe63f",
                                                "sense_id": "ae84106c-68c3-3a63-96bc-a74399fcc81e",
                                                "text": "As juveniles the crocodiles are frequently predated by larger carnivores."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fde636d8-548c-3c81-9bf8-178482320960",
                                        "entry_id": "e6a7937d-4e80-3e2f-9724-0c8ec334a288",
                                        "glosses": [
                                            "A mammal belonging to the order Carnivora."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "233ed905-7d84-4c47-8a1c-b2804e6f008c",
                                                "sense_id": "fde636d8-548c-3c81-9bf8-178482320960",
                                                "text": "The panda and the panther are both carnivores."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66ba0a0-d804-3bf1-97ae-75f602a0e69e",
                                        "entry_id": "e6a7937d-4e80-3e2f-9724-0c8ec334a288",
                                        "glosses": [
                                            "A person who is not a vegetarian."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b12de542-ada5-421a-b159-82c4133ebedb",
                                                "sense_id": "b66ba0a0-d804-3bf1-97ae-75f602a0e69e",
                                                "text": "Well, she has now gone / From this unhappy planet / With all the carnivores / And the destructors on it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b74c7d5-5aef-38de-a404-d1b0a2bb0131",
                                        "entry_id": "e6a7937d-4e80-3e2f-9724-0c8ec334a288",
                                        "glosses": [
                                            "A follower of the carnivore diet."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85e04ebc-a0f8-459c-b340-10e3bccd93e2",
                        "source_entry_id": "d128d273-048c-3939-a36d-8b0d97f53521",
                        "source_sense_id": "1c1b7c15-fcf4-3bd2-9188-4d7513b63e5e",
                        "source_sense_description": "een vleesetend dier",
                        "target_lang_word": "carnivore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carnivore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d765753-29e6-39f2-bc7c-ab2af6537603",
                                        "entry_id": "bf3c3b27-374e-36dc-b4b1-77f52d19df36",
                                        "glosses": [
                                            "Qui consomme de la viande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1963d670-b972-463a-9581-b289f5cf1ae1",
                                                "sense_id": "9d765753-29e6-39f2-bc7c-ab2af6537603",
                                                "text": "Le chimpanzé est omnivore, et il est occasionnellement carnivore. Il pratique occasionnellement la chasse."
                                            },
                                            {
                                                "example_id": "d52a4f22-bf07-47e6-bc44-8057894b345c",
                                                "sense_id": "9d765753-29e6-39f2-bc7c-ab2af6537603",
                                                "text": "La concentration des métaux lourds dans les poissons carnivores du sommet de la chaîne alimentaire est un autre problème lié aux pollutions industrielles."
                                            },
                                            {
                                                "example_id": "6eaa2ab8-d578-46ba-a9f7-307de00538f1",
                                                "sense_id": "9d765753-29e6-39f2-bc7c-ab2af6537603",
                                                "text": "Une nouvelle espèce éteinte de marsupial carnivore qui chassait dans les forêts australiennes il y a cinq millions d'années a été identifiée sur un site recelant des fossiles récemment découverts, ont annoncé mardi des scientifiques."
                                            },
                                            {
                                                "example_id": "83f899b2-4dcd-4875-86f4-f1899c91f615",
                                                "sense_id": "9d765753-29e6-39f2-bc7c-ab2af6537603",
                                                "text": "Pour assouvir son appétit carnivore, l’homme a rasé une surface équivalant à celle du continent africain afin de nourrir et d’élever des bêtes destinées à l’abattage."
                                            },
                                            {
                                                "example_id": "db13356f-1cd0-4b41-985d-175d3e92c753",
                                                "sense_id": "9d765753-29e6-39f2-bc7c-ab2af6537603",
                                                "text": "L’explosion cambrienne a également donné naissance aux premiers prédateurs particulièrement redoutables. Ces tueurs carnivores sont connus sous le nom de « radiodontes », en référence à la bouche en forme de scie circulaire située sous leur tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb8d6c47-6096-398f-b928-41889ac13c4d",
                                        "entry_id": "bf3c3b27-374e-36dc-b4b1-77f52d19df36",
                                        "glosses": [
                                            "Qualifie une plante ayant la capacité de s’emparer et de digérer les animaux de petite taille."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54a7341e-0b9a-4af7-9ca6-306bee3fa014",
                                                "sense_id": "fb8d6c47-6096-398f-b928-41889ac13c4d",
                                                "text": "Cette plante est astringente et caustique; nos paysans l’emploient, en infusion, contre les toux invétérées. Elle est considérée comme carnivore, vu sa faculté d’agir sur les matières azotées, à la façon du suc gastrique; les cils glanduleux irritables de ses feuilles se replient sur le limbe au contact d’un corps étranger."
                                            },
                                            {
                                                "example_id": "50dcaf5c-71a9-40ca-a202-49243cccdaab",
                                                "sense_id": "fb8d6c47-6096-398f-b928-41889ac13c4d",
                                                "text": "Les plus intéressantes d’entre elles sont sans doute les Drosera qui partagent avec les grassettes (Pinguicula vulgaris, Pinguicula alpina) le fait d’être carnivores, de capturer puis de digérer les petits insectes en excrétant des enzymes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "carnivore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56c18fab-f8c9-3d20-ac26-f49980f81fb9",
                                        "entry_id": "e279aa6b-e028-34cf-b06b-510abe042927",
                                        "glosses": [
                                            "Animal mangeur de viande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "067119b6-61c9-4661-8fe9-85ea8d5c45cc",
                                                "sense_id": "56c18fab-f8c9-3d20-ac26-f49980f81fb9",
                                                "text": "On a observé que les frugivores vicioient moins l’air que les carnivores."
                                            },
                                            {
                                                "example_id": "aa1ff0ba-a2fb-4642-be85-798689ef3463",
                                                "sense_id": "56c18fab-f8c9-3d20-ac26-f49980f81fb9",
                                                "text": "Les requins sont les plus célèbres carnivores du milieu aquatique."
                                            },
                                            {
                                                "example_id": "a616e47c-4452-4532-847b-925df43d51a9",
                                                "sense_id": "56c18fab-f8c9-3d20-ac26-f49980f81fb9",
                                                "text": "Il vivait il y a 140 millions d’années dans une région d’Argentine où les découvertes de dinosaures sont fréquentes, comme celle du Giganotosaurus Carolinii, en 1993, considéré comme le plus gros carnivore de tous les temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37c0e621-04ad-363d-a159-751b8b25466f",
                                        "entry_id": "e279aa6b-e028-34cf-b06b-510abe042927",
                                        "glosses": [
                                            "Ordre de mammifères placentaires du super-ordre des Laurasiathériens qui se distinguent par une mâchoire et une denture qui leur permet de chasser et de manger d’autres animaux."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "520e788c-5303-4049-8d65-1ecd3000c0cf",
                                                "sense_id": "37c0e621-04ad-363d-a159-751b8b25466f",
                                                "text": "Mais ces noms sont parfois trompeurs, comme c’est le cas par exemple pour les pandas, qui sont classés dans l’ordre des carnivores, alors qu’ils se nourrissent presque exclusivement de bambous."
                                            },
                                            {
                                                "example_id": "9f8f5615-b0e2-4a56-ae9d-15c3aa451b0d",
                                                "sense_id": "37c0e621-04ad-363d-a159-751b8b25466f",
                                                "text": "Ces nouveaux fossiles «permettent une meilleure compréhension de l’origine, de la variabilité et de l’écologie des premiers carnivoraformes et de l’histoire évolutive des carnivores » explique Floréal Solé de l’Institut Royal de sciences naturelles de Belgique et auteur d’un article publié dans le Journal of Vertebrate Paleontology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8754779-cf78-3d19-8afc-7e938c1dca98",
                                        "entry_id": "e279aa6b-e028-34cf-b06b-510abe042927",
                                        "glosses": [
                                            "Mammifère de l’ordre Carnivora."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5412888e-557e-445c-a7cd-5682fc5ee239",
                                                "sense_id": "d8754779-cf78-3d19-8afc-7e938c1dca98",
                                                "text": "Le chien, le chat, l’ours, l’otarie et le phoque sont des carnivores."
                                            },
                                            {
                                                "example_id": "a7aae20b-e4b9-49c1-9814-336e4ccda9ba",
                                                "sense_id": "d8754779-cf78-3d19-8afc-7e938c1dca98",
                                                "text": "Mais attention, l’association Picardie Nature, met en garde : « Un dérangement intentionnel, c’est forcément une amende. S’approcher trop près, à moins de 300 mètres, c’est déranger l’espèce et surtout, les phoques sont des carnivores. Ils ont des dents », prévient Éric Hugentobler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d510bd15-062c-3092-ba4e-0f9a24c5506a",
                                        "entry_id": "e279aa6b-e028-34cf-b06b-510abe042927",
                                        "glosses": [
                                            "Humain qui fait entrer la viande dans son régime alimentaire."
                                        ],
                                        "tags": [
                                            "Nutrition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa638704-3eed-4d53-b930-f989235df27f",
                                                "sense_id": "d510bd15-062c-3092-ba4e-0f9a24c5506a",
