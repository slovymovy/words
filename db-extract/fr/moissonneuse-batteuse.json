                    }
                ],
                "senses": [
                    {
                        "sense_id": "b00aaad0-c173-319b-9f99-c18acf0c99fe",
                        "entry_id": "78ffae23-1a53-35e7-bbec-09a02c1b403c",
                        "glosses": [
                            "Machine agricole destinée à la récolte au champ des grains (blé, orge, escourgeon, maïs…) ou des graines (pois sec, colza, tournesol…), qui remplit les deux fonctions de moissonner, puis de battre la récolte, et de séparer les grains et graines des pailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600762db-a8b5-495e-8951-b4423f1745dd",
                                "sense_id": "b00aaad0-c173-319b-9f99-c18acf0c99fe",
                                "text": "Des voitures à perte de vue, mais aussi des bus, des tracteurs, des camping-cars et même des moissonneuses-batteuses."
                            },
                            {
                                "example_id": "997a6e38-a46f-4af9-8d8c-ce2733009020",
                                "sense_id": "b00aaad0-c173-319b-9f99-c18acf0c99fe",
                                "text": "Dans le champ tout proche, une moissonneuse-batteuse effectuait des coupes en cette fin de journée dominicale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3db8974-1c02-44db-abc3-31d06cc937db",
                        "source_entry_id": "78ffae23-1a53-35e7-bbec-09a02c1b403c",
                        "source_sense_id": "b00aaad0-c173-319b-9f99-c18acf0c99fe",
                        "target_lang_word": "Mähdrescher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mähdrescher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6aacc049-f16f-3ea2-b86d-a477c21bc8f4",
                                        "entry_id": "f6e479c1-0492-37bc-89b2-b1e3a268a056",
                                        "glosses": [
                                            "Maschine zur Ernte von Getreide, Mais und anderen Körnerfrüchten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "542672db-8d76-4e44-b6d3-f5a9f67d7b64",
                                                "sense_id": "6aacc049-f16f-3ea2-b86d-a477c21bc8f4",
                                                "text": "Ein Mähdrescher erleichtert die Getreideernte enorm."
                                            },
                                            {
                                                "example_id": "1623b90f-0c3f-4d9c-86db-55001c03baa3",
                                                "sense_id": "6aacc049-f16f-3ea2-b86d-a477c21bc8f4",
                                                "text": "„Vom Erlös ihrer Produktion wollen sie moderne Traktoren und Mähdrescher anschaffen und in einigen Jahren tausend Hektar ihr Eigen nennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
