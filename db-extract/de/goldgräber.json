                "senses": [
                    {
                        "sense_id": "5a5c91ab-702f-3c55-902e-9e111934cb9e",
                        "entry_id": "4d9c54e2-ec84-3bc1-9025-78b543b5cbeb",
                        "glosses": [
                            "Person, die nach Goldstaub oder Goldnuggets sucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b245ff53-ceb3-4100-adbd-739812aa90b8",
                                "sense_id": "5a5c91ab-702f-3c55-902e-9e111934cb9e",
                                "text": "Einige Goldgräber gehen bei der Suche nach dem kostbaren Metall nicht umweltfreundlich vor."
                            },
                            {
                                "example_id": "4e10380a-4a98-4802-bc91-b865b204b9ac",
                                "sense_id": "5a5c91ab-702f-3c55-902e-9e111934cb9e",
                                "text": "„Wer zu den Goldgräbern will, muss zuerst hierher, nach Njurguilahti.“"
                            },
                            {
                                "example_id": "ee5c39f0-e892-450b-ac94-439b7b0c7e3b",
                                "sense_id": "5a5c91ab-702f-3c55-902e-9e111934cb9e",
                                "text": "„Der amerikanische Reisebuchautor Hassoldt Davis besuchte die Gegend und erzählt in seinem Buch von der Begegnung mit Fanfan, einem kreolischen Goldgräber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de79fe9c-d925-470e-b60c-016079dfcbb7",
                        "source_entry_id": "4d9c54e2-ec84-3bc1-9025-78b543b5cbeb",
                        "source_sense_id": "5a5c91ab-702f-3c55-902e-9e111934cb9e",
                        "source_sense_description": "Person, die nach Goldstaub oder Goldnuggets sucht",
