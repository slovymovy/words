                    },
                    {
                        "translation_id": "cb758e03-7ede-4b60-ac62-c9eaf3cf3cb9",
                        "source_entry_id": "2967d6e3-3364-3fa8-9a51-cc05a5ea629d",
                        "source_sense_description": "Russian unit of mass",
                        "target_lang_word": "poud",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
