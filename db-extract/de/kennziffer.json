                "senses": [
                    {
                        "sense_id": "c4662e73-2cf1-380c-8992-bb0d47418a82",
                        "entry_id": "7bb5102c-0e04-366e-a5f7-f9336dbd5e7d",
                        "glosses": [
                            "mathematische Größe, die über einen bestimmten Sachverhalt eine Auskunft gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c302c1e-2bc8-4133-ac1e-68e2b85d6e54",
                                "sense_id": "c4662e73-2cf1-380c-8992-bb0d47418a82",
                                "text": "Die Kennziffern weisen ja darauf hin, dass wir auf dem richtigen Weg sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f33305d9-6bdd-332c-992c-51e7fa7b519f",
                        "entry_id": "7bb5102c-0e04-366e-a5f7-f9336dbd5e7d",
                        "glosses": [
                            "willkürlich zugeordnete Zahl, um einen Unterschied zwischen Varianten/Objekten kenntlich zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7dd7e03-1572-486a-ab07-9f90572feb12",
                                "sense_id": "f33305d9-6bdd-332c-992c-51e7fa7b519f",
                                "text": "Das Exponat mit der Kennziffer 622 wird erst nächste Woche in die Auktion gehen."
                            },
                            {
                                "example_id": "5faf5efb-5f58-43aa-87b0-1a8be284fde1",
                                "sense_id": "f33305d9-6bdd-332c-992c-51e7fa7b519f",
                                "text": "„Der Archivar erblickte einen Schwarm emsiger Buchhalter und Buchhalterinnen, die die Kennziffern der Belegschaftsmitglieder sorgfältig aufschrieben und sorgfältig ausradierten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4ab2ad02-e0f7-377b-a611-6782cdd93e61",
                        "entry_id": "7bb5102c-0e04-366e-a5f7-f9336dbd5e7d",
                        "glosses": [
                            "vor dem Komma stehende Zahl (im Logarithmus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad6128d6-f570-4d9a-9078-acad96cd50bb",
                                "sense_id": "4ab2ad02-e0f7-377b-a611-6782cdd93e61",
                                "text": "„Die Kennziffer aller Dezimalzahlen unter 1 ist gleich der Anzahl der Nullen vor der ersten geltenden Ziffer, und zwar negativ genommen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
