                "senses": [
                    {
                        "sense_id": "9e0c7c5b-6f88-341c-b43e-7fecd375fbcd",
                        "entry_id": "9fc3247a-dfcd-3832-9303-ed4fb2ec3ff3",
                        "glosses": [
                            "Transmettre le phylloxéra à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0caa7e4f-d7e2-450f-a61b-e7f06ce12777",
                                "sense_id": "9e0c7c5b-6f88-341c-b43e-7fecd375fbcd",
                                "text": "Donc M. Berkmans n’a pu phylloxérer ni la Gironde, ni le Gard, ni l’Hérault, (...)"
                            },
                            {
                                "example_id": "6eea1d10-33de-481c-be21-aa9a318e2236",
                                "sense_id": "9e0c7c5b-6f88-341c-b43e-7fecd375fbcd",
                                "text": "Dans les villes, les républicains aigris, ceux qui demandaient au gouvernement des réformes ou simplement des places, et qui ne les ont pas obtenues, sont boulangistes; dans les campagnes, le paysan qui a perdu un veau dans l'année, ou dont la vigne a été phylloxérée, est boulangiste, sans se douter qu’il remplace ainsi un phylloxéra par un autre."
                            }
                        ]
                    }
