                    {
                        "sense_id": "02626ed8-384e-3eef-b381-7662fa37f5d9",
                        "entry_id": "70686f5d-f300-35ea-a7df-93cdaa54f166",
                        "glosses": [
                            "een ruimte in een rooms-katholieke kerk, waarin men alles bewaart dat nodig kan zijn om een kerkdienst te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7044644f-b0ae-4842-be53-34b485d235a2",
                                "sense_id": "02626ed8-384e-3eef-b381-7662fa37f5d9",
                                "text": "In de sacristie van een kerk worden de liturgische kleding, het vaatwerk en de boeken voor de vieringen bewaard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a505240-bf16-4627-839c-ad454675b835",
                        "source_entry_id": "70686f5d-f300-35ea-a7df-93cdaa54f166",
                        "source_sense_id": "02626ed8-384e-3eef-b381-7662fa37f5d9",
                        "source_sense_description": "een ruimte in een rooms-katholieke kerk, waarin men alles bewaart dat nodig kan zijn om een kerkdienst te houden.",
                        "target_lang_word": "Sakristei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sakristei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                        "entry_id": "9d89371e-0a63-3d2f-938d-f210dbc5a03f",
                                        "glosses": [
                                            "Nebenraum einer Kirche, in dem aufbewahrt wird, was für den Gottesdienst benötigt wird; dient auch als Vorbereitungsraum für die Geistlichen"
                                        ],
                                        "tags": [
                                            "Christentum; Kirchengebäude"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e15c88-2f86-47ca-b4a0-8e8c2b541ff4",
                                                "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                                "text": "„Auch das heutige an der Nordseite erbaute Querhaus entstand im Wesentlichen in diesen Jahren, um dort die Sakristei und die Bibliothek unterzubringen.“"
                                            },
                                            {
                                                "example_id": "38b804de-749f-4996-aba6-33b1fdf1b7ba",
                                                "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                                "text": "„Die Sakristei befand sich neben dem Sanktuarium (Altarraum) und an der dem kleinen Kreuzgang abgewandten Seite.“"
                                            },
                                            {
                                                "example_id": "e8d9ca9a-43dc-4e3a-bf42-87bbfe906bfa",
                                                "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                                "text": "„Auf der Suche nach einem Fluchtweg öffnete er die Seitentüre zur Sakristei und versteckte sich in einem Beichtstuhl.“"
                                            },
                                            {
                                                "example_id": "9a071535-66ad-47c0-9e02-55554f697a91",
                                                "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                                "text": "„Ich saß noch bei Tisch mit der ganzen erlauchten Gesellschaft, als ein Geistlicher erschien und mich daran erinnerte, daß man mich in der Sakristei erwarte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa320dee-a9ae-4378-952d-4de1b37accd3",
                        "source_entry_id": "70686f5d-f300-35ea-a7df-93cdaa54f166",
                        "source_sense_id": "02626ed8-384e-3eef-b381-7662fa37f5d9",
