                    },
                    {
                        "translation_id": "21a2550a-afb9-413b-a6a5-e9f4b70f53ff",
                        "source_entry_id": "2d23dd26-7f5f-3a37-af13-db100d2439e5",
                        "source_sense_id": "16fc5270-967c-3710-a4c8-7f5e31582c1b",
                        "target_lang_word": "génératrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "génératrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c325809-1218-3963-a145-cc5f4008a9f0",
                                        "entry_id": "270fc4bf-880b-32a9-a1ed-b1fe7e2aa3d9",
                                        "glosses": [
                                            "Génitrice."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d27aeec-257e-4e3c-8dd9-5b0dd7a2f5f0",
                                                "sense_id": "2c325809-1218-3963-a145-cc5f4008a9f0",
                                                "text": "Fît-on abstraction de cette dernière circonstance, il est clair que Palès, dans cette hypothèse, aurait été la grande génératrice, la mère par excellence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbe9a9d5-4473-3a1f-84ce-e77254f8f247",
                                        "entry_id": "270fc4bf-880b-32a9-a1ed-b1fe7e2aa3d9",
                                        "glosses": [
                                            "Machine produisant du courant électrique, généralement à partir d’énergie mécanique."
                                        ],
                                        "tags": [
                                            "Électrotechnique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c798f8f2-525d-4984-a4f9-67af8069cdcc",
                                                "sense_id": "cbe9a9d5-4473-3a1f-84ce-e77254f8f247",
                                                "text": "Je déclenchai la génératrice du girorector, qui permet de voler dans la brume."
                                            },
                                            {
                                                "example_id": "9c46934f-9af2-4b30-92e8-f748f0a7f598",
                                                "sense_id": "cbe9a9d5-4473-3a1f-84ce-e77254f8f247",
                                                "text": "Son dernier espoir, il l’avait placé dans cette folie, cette génératrice électrique de la mare aux Aigrettes, qui devait apporter le progrès à tout l’ouest de l’île et qui n’était plus qu’un tas de ferrailles englouti dans la boue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ded0c401-9fb3-34bb-a6a7-f71764dc561b",
                                        "entry_id": "270fc4bf-880b-32a9-a1ed-b1fe7e2aa3d9",
                                        "glosses": [
                                            "Courbe dont la révolution autour d’un axe forme un solide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14214ecb-c642-4676-87bb-964cff40593b",
                                                "sense_id": "ded0c401-9fb3-34bb-a6a7-f71764dc561b",
                                                "text": "[…], et, à l’aide d’un couteau émoussé, on coupe la nappe dans la partie du tambour non garni d’aiguilles et suivant une génératrice de ce tambour."
                                            },
                                            {
                                                "example_id": "db1de6e7-cb99-4a3f-b8f9-1b49feb99eda",
                                                "sense_id": "ded0c401-9fb3-34bb-a6a7-f71764dc561b",
                                                "text": "Le tuyau Bonna en acier soudé avec double revêtement en béton armé , comprend :\n— un tube médian en tôle d’acier terminé par les pièces de joint ;\n— un revêtement intérieur en béton centrifugé, armé ou non ;\n— un revêtement extérieur en béton vibré, armé de spires et de génératrices."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "génératrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11108806-815c-3125-b9f0-b07ced5a9dab",
                                        "entry_id": "3ac1bc2f-c054-3d17-9818-d890afad1c2c",
                                        "glosses": [
                                            "Féminin singulier de générateur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9abf1fb-dc91-4e71-abf4-3bc9797d0a6c",
                                                "sense_id": "11108806-815c-3125-b9f0-b07ced5a9dab",
                                                "text": "Šklovskij et ses amis s’élèvent contre l’idée d’une langue normative, comme par la suite Asmus s’élèvera contre l’idée d’une esthétique normative. Cette normativité simplificatrice est génératrice de schématisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
