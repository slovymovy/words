                    {
                        "sense_id": "624835d6-524a-3c66-919b-fc607a58d206",
                        "entry_id": "064468df-8075-302d-9a79-d7e9768b54e0",
                        "glosses": [
                            "opening aan het eind van de endeldarm en aan het eind van het spijsverteringskanaal waardoor afvalstoffen het lichaam verlaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "057c57dd-ce17-4bd3-b4ac-d161b6a8d03e",
                                "sense_id": "624835d6-524a-3c66-919b-fc607a58d206",
                                "text": "Uit je anus komt je poep."
                            },
                            {
                                "example_id": "4c591b49-dc16-4dab-8c3a-1440fcbd4360",
                                "sense_id": "624835d6-524a-3c66-919b-fc607a58d206",
                                "text": "Fijn sabbelen op zijn voetfungus, terwijl buurvrouw Betty je intens masturberend ligt aan te kijken en Vieze Gerrit van op de hoek in je anus op zoek is naar je derde oog."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecda88b8-d8f6-4546-a446-21b185700db0",
                        "source_entry_id": "064468df-8075-302d-9a79-d7e9768b54e0",
                        "source_sense_id": "624835d6-524a-3c66-919b-fc607a58d206",
                        "source_sense_description": "opening aan het eind van de endeldarm en aan het eind van het spijsverteringskanaal",
                        "target_lang_word": "After",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "After",
