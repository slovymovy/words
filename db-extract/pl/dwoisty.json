                        "source_sense_id": "5797a2bd-8dd1-3451-bfe1-8f056b890546",
                        "target_lang_word": "dual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "493715e6-61ba-3378-a228-5746ba1a789f",
                                        "entry_id": "ddf4d2b8-fd85-3942-a308-3d95c69510b9",
                                        "glosses": [
                                            "Characterized by having two (usually equivalent) components."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5bdfeeb-18f7-4182-a47e-28402f52ce23",
                                                "sense_id": "493715e6-61ba-3378-a228-5746ba1a789f",
                                                "text": "a dual-motor vehicle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b2b4c87-93ba-36da-816f-6f58f9773409",
                                        "entry_id": "ddf4d2b8-fd85-3942-a308-3d95c69510b9",
                                        "glosses": [
                                            "Pertaining to two, pertaining to a pair of."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7c358a9-d2e0-48ca-b75c-1cf6c7c3854e",
                                                "sense_id": "8b2b4c87-93ba-36da-816f-6f58f9773409",
                                                "text": "dual engine failure"
                                            },
                                            {
                                                "example_id": "7c2441af-af9c-4e42-b44f-a1e211629b89",
                                                "sense_id": "8b2b4c87-93ba-36da-816f-6f58f9773409",
                                                "text": "dual citizenship"
                                            },
                                            {
                                                "example_id": "419bc9d0-e398-4b39-976a-8a8811db9447",
                                                "sense_id": "8b2b4c87-93ba-36da-816f-6f58f9773409",
                                                "text": "Both Deborah and Samuel held dual roles as judges and prophets."
                                            },
                                            {
                                                "example_id": "46517b78-d864-4943-9317-5e76acdaabb5",
                                                "sense_id": "8b2b4c87-93ba-36da-816f-6f58f9773409",
                                                "text": "And some Asian countries are tightening their immigration laws. Japan reinforced its strict stance in January when a court upheld the country’s ban against dual citizenship, rejecting a lawsuit filed by Japanese citizens living in Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7e82cf3-d7c5-3656-86cc-065a68f6bca7",
                                        "entry_id": "ddf4d2b8-fd85-3942-a308-3d95c69510b9",
                                        "glosses": [
                                            "Pertaining to a grammatical number in certain languages that refers to two of something, such as a pair of shoes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5881fa5-54b5-4217-b1b3-cb1f09f62f6c",
                                                "sense_id": "e7e82cf3-d7c5-3656-86cc-065a68f6bca7",
                                                "text": "Modern Arabic displays a dual number, as did Homeric Greek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60655ad3-13f6-3efe-9432-928ee4f44e16",
                                        "entry_id": "ddf4d2b8-fd85-3942-a308-3d95c69510b9",
                                        "glosses": [
                                            "Exhibiting duality."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20c4f951-f682-3110-8142-cfb1defc063b",
                                        "entry_id": "ddf4d2b8-fd85-3942-a308-3d95c69510b9",
                                        "glosses": [
                                            "Being the space of all linear functionals of (some other space)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd16fc5-1785-463b-a33a-2f3408d61a69",
                                                "sense_id": "20c4f951-f682-3110-8142-cfb1defc063b",
                                                "text": "Accordingly, a hyperplane in the sample space is dual to a subspace in the variable space."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f72a3d4-b843-32eb-9c9b-bc906d428871",
                                        "entry_id": "ddf4d2b8-fd85-3942-a308-3d95c69510b9",
                                        "glosses": [
                                            "Being the dual of some other category; containing the same objects but with source and target reversed for all morphisms."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cfe452c-1eac-4980-af4e-e1e0a1865d60",
                                                "sense_id": "5f72a3d4-b843-32eb-9c9b-bc906d428871",
                                                "text": "Every category is dual to its own dual, so if a statement holds in all categories so does its dual."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04630c4a-82fe-3d7f-87b8-e0d81cf30a70",
                                        "entry_id": "61686e96-75c7-3f99-add1-854adf31f8c4",
                                        "glosses": [
                                            "Of an item that is one of a pair, the other item in the pair."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d946abbc-c33d-3751-8022-f90b671fa186",
                                        "entry_id": "61686e96-75c7-3f99-add1-854adf31f8c4",
                                        "glosses": [
                                            "Of a regular polyhedron with V vertices and F faces, the regular polyhedron having F vertices and V faces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62886b34-24ef-478d-9389-fafc1bdac938",
                                                "sense_id": "d946abbc-c33d-3751-8022-f90b671fa186",
                                                "text": "The octahedron is the dual of the cube."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e69de12-0bd7-3d1e-a0e5-cf2d5af5e848",
                                        "entry_id": "61686e96-75c7-3f99-add1-854adf31f8c4",
                                        "glosses": [
                                            "The dual number."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bb772df-58a0-3af4-946e-d6b5bac0fdd3",
                                        "entry_id": "61686e96-75c7-3f99-add1-854adf31f8c4",
                                        "glosses": [
                                            "Of a vector in an inner product space, the linear functional corresponding to taking the inner product with that vector. The set of all duals is a vector space called the dual space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ff3aac5-40e2-3f11-81dc-14fcda4c320d",
                                        "entry_id": "61686e96-75c7-3f99-add1-854adf31f8c4",
                                        "glosses": [
                                            "A head-to-head match or meet between two teams, such as two high schools or colleges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8307fce3-ba92-422a-b51a-32bf8f7ac5f5",
                                                "sense_id": "9ff3aac5-40e2-3f11-81dc-14fcda4c320d",
                                                "text": "Wrestling duals and meets take place at the Wisconsin Field House. There are no advance single event ticket sales."
                                            },
                                            {
                                                "example_id": "09931d94-82e9-4c8f-bddd-85bcc4f41522",
                                                "sense_id": "9ff3aac5-40e2-3f11-81dc-14fcda4c320d",
                                                "text": "But Dave agreed to participate in the Bulgarian dual, and that trapped me into having to wrestle, too."
                                            },
                                            {
                                                "example_id": "f2ab50c3-c8cb-4283-a9ab-b95b7dfccaf8",
                                                "sense_id": "9ff3aac5-40e2-3f11-81dc-14fcda4c320d",
                                                "text": "Early in 2021, she became the first female to compete and win a match at the Ter-Hark Cup wrestling dual, helping her squad to victory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "683335a7-3cbb-3c89-a327-8aaf387cab49",
                                        "entry_id": "21f1d285-0d8b-3f07-8bec-c2ea9557cd73",
                                        "glosses": [
                                            "To convert from single to dual; specifically, to convert a single-carriageway road to a dual carriageway."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d6e46bc-a41e-4466-a3a8-edaecd7e910f",
                                                "sense_id": "683335a7-3cbb-3c89-a327-8aaf387cab49",
                                                "text": "I have to declare an interest and I do so with some ambivalence because if the road is dualled it is likely to take half of my front garden."
                                            },
                                            {
                                                "example_id": "7c36587a-ce3d-4b3d-a54c-2d73c0eb3f95",
                                                "sense_id": "683335a7-3cbb-3c89-a327-8aaf387cab49",
                                                "text": "The power generation and propulsion systems are dualled to accommodate component failure and maintain propulsion at reduced speed should any part of one system be lost."
                                            },
                                            {
                                                "example_id": "84e553ad-c4ce-4e3d-873e-5ed8a09d1078",
                                                "sense_id": "683335a7-3cbb-3c89-a327-8aaf387cab49",
                                                "text": "The investment will allow Nexus to increase service frequencies, reduce journey times, and improve reliability by dualling three sections of line between Pelaw and South Shields."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
