                    },
                    {
                        "sense_id": "0db2af7f-a52e-3bc3-8570-32484891c3c2",
                        "entry_id": "7398090f-cf48-3bd7-96dc-ca5dc56ba58b",
                        "glosses": [
                            "Dont l’histogramme est saturé en blanc pur, en parlant d’une photo."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4190fe4e-1f8b-389c-a227-c01558c2a598",
                        "entry_id": "7398090f-cf48-3bd7-96dc-ca5dc56ba58b",
                        "glosses": [
                            "Dont l’identité ou les intentions ont été découvertes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50bfeec0-c244-4b7b-8637-a3fda3e9e3e8",
                                "sense_id": "4190fe4e-1f8b-389c-a227-c01558c2a598",
                                "text": "Un espion cramé."
                            }
                        ]
                    },
                    {
                        "sense_id": "05dfe687-b690-3ffd-97b8-833a18c813de",
                        "entry_id": "7398090f-cf48-3bd7-96dc-ca5dc56ba58b",
                        "glosses": [
                            "Qui a perdu l’esprit, fou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3216d429-e9b0-4663-a3c8-46b80f2ae970",
                                "sense_id": "05dfe687-b690-3ffd-97b8-833a18c813de",
                                "text": "Non mais qu’est-ce que vous avez dans la tête ! Vous êtes malade ! Complètement cramé !"
                            }
                        ]
                    },
                    {
                        "sense_id": "f2fd4ad0-390c-35f6-9195-7cbd9684f80e",
                        "entry_id": "7398090f-cf48-3bd7-96dc-ca5dc56ba58b",
                        "glosses": [
                            "Fatigué, épuisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27ff6313-9781-4635-8441-0707dc571cac",
                                "sense_id": "f2fd4ad0-390c-35f6-9195-7cbd9684f80e",
                                "text": "« Si tu ne sors pas trop cramé du Tour, tu as la force et l’endurance de ton côté », ajoute le Costarmoricain Julien Simon 5ᵉ de l’épreuve en 2018 après son 6ᵉ Tour de France."
                            },
                            {
                                "example_id": "2ac93ca8-e3ce-41da-a8cd-5361d37c2899",
                                "sense_id": "f2fd4ad0-390c-35f6-9195-7cbd9684f80e",
                                "text": "Il y a beaucoup trop de matchs, les joueurs sont plus que cramés."
                            }
                        ]
                    },
                    {
                        "sense_id": "21c4cc32-3b32-347f-b747-8e23985c74f8",
                        "entry_id": "7398090f-cf48-3bd7-96dc-ca5dc56ba58b",
                        "glosses": [
                            "Ivre, saoul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b598244a-afd5-4cce-9436-93e42546f705",
                                "sense_id": "21c4cc32-3b32-347f-b747-8e23985c74f8",
                                "text": "\"Quoi ? Toi, saoul ? Mais moi j’étais rond comme une queue de pelle, cramé comme une torche ! Non, tout ça c’est à cause de tout ce que me met Susanna dans le crâne depuis toutes ces années… Et aussi Ma Cornelia avant elle…\""
                            },
                            {
                                "example_id": "3185fbd8-beff-4807-8178-97bda3804350",
                                "sense_id": "21c4cc32-3b32-347f-b747-8e23985c74f8",
                                "text": "Manfred me coupa sans précaution : « Non, Laurent,… Je ne suis pas « bourré », ou « cuit », ou « cramé », comme on dit chez vous. Et je n'ai pas l'intention de l'être. »"
                            }
                        ]
                    }
