                "translations": [
                    {
                        "translation_id": "57e1ec37-e0da-4c40-a756-a52473676e72",
                        "source_entry_id": "f94576e4-b9e2-3c25-8020-a90563c4861f",
                        "source_sense_id": "5a9048a6-066f-3b6c-b381-b983f606ac20",
                        "target_lang_word": "unmarried",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmarried",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adc11ca2-2fa3-3486-ad7b-74ba2e4111a5",
                                        "entry_id": "b6d55b56-00c7-34ce-8625-b30d5391eefc",
                                        "glosses": [
                                            "Having no husband or wife."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94f0edeb-3a84-4592-8a39-ef8fd775b7dc",
                                                "sense_id": "adc11ca2-2fa3-3486-ad7b-74ba2e4111a5",
                                                "text": "Her young parents, who worked in a pottery factory in Rongchang in present-day Chongqing municipality, conceived her while unmarried."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unmarried",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4aeb2b8f-efb3-3316-b8fd-3498e438aa53",
                                        "entry_id": "a9c8265b-5d21-38dc-ab46-9ba40e8d3f21",
                                        "glosses": [
                                            "An unmarried person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c415c2cb-572e-4684-b845-c20c77dcd6aa",
                        "source_entry_id": "f94576e4-b9e2-3c25-8020-a90563c4861f",
                        "source_sense_id": "5a9048a6-066f-3b6c-b381-b983f606ac20",
                        "target_lang_word": "single",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "single",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "903b2e0a-9a5c-3d13-8c83-1242e16d577b",
                                        "entry_id": "437e8ff7-31f5-33ce-9624-b01652b8e9f6",
                                        "glosses": [
                                            "Not accompanied by anything else; one in number."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baf9f2be-6b55-431f-955e-c6e19aadf172",
                                                "sense_id": "903b2e0a-9a5c-3d13-8c83-1242e16d577b",
                                                "text": "Can you give me a single reason not to leave right now?"
                                            },
                                            {
                                                "example_id": "a7bb4150-9c06-4dc5-a881-9b647de62e24",
                                                "sense_id": "903b2e0a-9a5c-3d13-8c83-1242e16d577b",
                                                "text": "The vase contained a single long-stemmed rose."
                                            },
                                            {
                                                "example_id": "a665f655-7367-4efe-851e-124c42cb17d3",
                                                "sense_id": "903b2e0a-9a5c-3d13-8c83-1242e16d577b",
                                                "text": "The single-imaging optic of the mammalian eye offers some distinct visual advantages. Such lenses can take in photons from a wide range of angles, increasing light sensitivity. They also have high spatial resolution, resolving incoming images in minute detail. It’s therefore not surprising that most cameras mimic this arrangement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2d05405-a637-333d-a93d-cd60ebb669ca",
                                        "entry_id": "437e8ff7-31f5-33ce-9624-b01652b8e9f6",
                                        "glosses": [
                                            "Not divided in parts."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1b18f91-728e-4a88-863b-d72e4d84bb4b",
                                                "sense_id": "f2d05405-a637-333d-a93d-cd60ebb669ca",
                                                "text": "The potatoes left the spoon and landed in a single big lump on the plate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c28247c-f384-3fe1-ac77-a23e824259a9",
                                        "entry_id": "437e8ff7-31f5-33ce-9624-b01652b8e9f6",
                                        "glosses": [
                                            "Designed for the use of only one."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3138ade2-76d1-4c14-893b-6f5f0e029372",
                                                "sense_id": "5c28247c-f384-3fe1-ac77-a23e824259a9",
                                                "text": "a single room"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a31684-bf22-3b56-9102-5f40be299381",
                                        "entry_id": "437e8ff7-31f5-33ce-9624-b01652b8e9f6",
                                        "glosses": [
                                            "Performed by one person, or one on each side."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "781c55fb-bc1c-4790-b5e4-2d8e8e2d6f8c",
                                                "sense_id": "d0a31684-bf22-3b56-9102-5f40be299381",
                                                "text": "a single combat"
                                            },
                                            {
                                                "example_id": "7852ce54-4e31-4a0d-8fa9-bbf0442f6c6a",
                                                "sense_id": "d0a31684-bf22-3b56-9102-5f40be299381",
                                                "text": "These shifts refuted, answer thy appellant, […] / Who now defies thee thrice to single fight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ad73ab2-1d07-3b38-ac51-aede53157d05",
                                        "entry_id": "437e8ff7-31f5-33ce-9624-b01652b8e9f6",
                                        "glosses": [
                                            "Not married, and (in modern times) not dating or without a significant other."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59f25c32-f59f-4601-bd58-3b56676844d2",
                                                "sense_id": "2ad73ab2-1d07-3b38-ac51-aede53157d05",
                                                "text": "Forms often ask if a person is single, married, divorced, or widowed. In this context, a person who is dating someone but who has never married puts \"single\"."
                                            },
                                            {
                                                "example_id": "c7d63bee-5cfa-498b-8c10-a281c3c7e04f",
                                                "sense_id": "2ad73ab2-1d07-3b38-ac51-aede53157d05",
                                                "text": "Josh put down that he was a single male on the dating website."
                                            },
                                            {
                                                "example_id": "75e6a6f3-f969-458e-bb57-950751855dec",
                                                "sense_id": "2ad73ab2-1d07-3b38-ac51-aede53157d05",
                                                "text": "To undergo such maiden pilgrimage.\nBut earthlier happy is the rose distilled\nThan that which, withering on the virgin thorn,\nGrows, lives, and dies in single blessedness."
                                            },
                                            {
                                                "example_id": "5af31ca2-15b0-470b-b6da-4ddb56adefa9",
                                                "sense_id": "2ad73ab2-1d07-3b38-ac51-aede53157d05",
                                                "text": "Single chose to live, and shunned to wed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7b52c05-c48f-3b18-8f9c-0a2330adf44a",
                                        "entry_id": "437e8ff7-31f5-33ce-9624-b01652b8e9f6",
                                        "glosses": [
                                            "Having only one rank or row of petals."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe92b129-d902-3576-8513-dd3cba6e3fc0",
                                        "entry_id": "437e8ff7-31f5-33ce-9624-b01652b8e9f6",
                                        "glosses": [
                                            "Simple and honest; sincere, without deceit."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdfb04b9-70ec-44b1-b863-d8f37f37b326",
                                                "sense_id": "fe92b129-d902-3576-8513-dd3cba6e3fc0",
                                                "text": "Therefore, when thyne eye is single: then is all thy boddy full off light. Butt if thyne eye be evyll: then shall all thy body be full of darknes?"
                                            },
                                            {
                                                "example_id": "4f31985c-ed52-4ca8-93de-8eff2ac7733c",
                                                "sense_id": "fe92b129-d902-3576-8513-dd3cba6e3fc0",
                                                "text": "I speak it with a single heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e508d64d-9b87-3faf-bdc5-050feaab3166",
                                        "entry_id": "437e8ff7-31f5-33ce-9624-b01652b8e9f6",
                                        "glosses": [
                                            "Uncompounded; pure; unmixed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b626d19e-bd78-4b8f-8d52-a7a88eacaf56",
                                                "sense_id": "e508d64d-9b87-3faf-bdc5-050feaab3166",
                                                "text": "simple ideas are opposed to complex , and single ideas to compound."
                                            },
                                            {
                                                "example_id": "07cf804a-f669-4227-b5d6-bdd595b3e458",
                                                "sense_id": "e508d64d-9b87-3faf-bdc5-050feaab3166",
                                                "text": "The most that is required is, that the passage of Scripture, selected as the foundation of the sacred oration, should, like the oration itself, be single, full, and unsuperfluous in its character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f5c8483-382b-3cb9-b48e-774bb162f146",
                                        "entry_id": "437e8ff7-31f5-33ce-9624-b01652b8e9f6",
                                        "glosses": [
                                            "Simple; foolish; weak; silly."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d38fb70e-7c97-4a3c-8a35-b2b94f0500d7",
                                                "sense_id": "1f5c8483-382b-3cb9-b48e-774bb162f146",
                                                "text": "He utters such single matter in so infantly a voice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "single",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "387c0571-2784-3446-a663-37dc30f6285f",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A 45 RPM vinyl record with one song on side A and one on side B."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ccd57c5-4ee5-38e7-b9da-7edebbc8f64f",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A popular song released and sold (on any format) nominally on its own though usually having at least one extra track."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbd064fe-630f-44e5-a6b6-8c5d14025d28",
                                                "sense_id": "9ccd57c5-4ee5-38e7-b9da-7edebbc8f64f",
                                                "text": "The Offspring released four singles from their most recent album."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "243cbb40-cdc2-38e6-a487-eab5bfd4eec9",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "One who is not married or does not have a romantic partner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f92eb171-1e51-46e1-8f14-03318ddfb910",
                                                "sense_id": "243cbb40-cdc2-38e6-a487-eab5bfd4eec9",
                                                "text": "He went to the party, hoping to meet some friendly singles there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21630ece-c44c-303d-b914-1ec1760e5ba4",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A score of one run."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fc1c129-4c99-4e03-956a-b4e52e048afe",
                                                "sense_id": "21630ece-c44c-303d-b914-1ec1760e5ba4",
                                                "text": "He refused to take a single as the ball was dropped by his opponent's best fielder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4e05444-596c-3c24-b96d-eadd7f8e4f1e",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A hit in baseball where the batter advances to first base."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f3b6663-6870-3dcd-86e8-c5e8be08a6b6",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A tile that has a different value (i.e. number of pips) at each end."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de37b03c-a311-3b33-a10e-72135196c7e0",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A bill valued at $1."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "163e3a19-4b35-4a3f-b536-c7b61a356fee",
                                                "sense_id": "de37b03c-a311-3b33-a10e-72135196c7e0",
                                                "text": "I don't have any singles, so you'll have to make change."
                                            },
                                            {
                                                "example_id": "cd1ec8f1-b54b-43d8-b08f-0725c5560e85",
                                                "sense_id": "de37b03c-a311-3b33-a10e-72135196c7e0",
                                                "text": "She looked in her purse, found a ten and a single, gave him the ten. ‘I'll spend it on booze,’ he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1db13047-8751-3f0b-b62a-1b30244e73a6",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A one-way ticket."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4c1988f-64d6-4c6c-93b6-fca919ac1402",
                                                "sense_id": "1db13047-8751-3f0b-b62a-1b30244e73a6",
                                                "text": "‘I want to know, Mr Stone, if, in the course of the day, you have issued any tickets to a person dressed in Arab costume?’\nHis reply was prompt.\n‘I have — by the last train, the 7.25, — three singles.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a785d63d-2dcf-3a95-a7c8-2914de840746",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A score of one point, awarded when a kicked ball is dead within the non-kicking team's end zone or has exited that end zone."
                                        ],
                                        "tags": [
                                            "Canadian"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37c10f22-2ff3-3b06-b63f-ef5d237d46f6",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A game with one player on each side, as in tennis."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "318aaf31-339f-4bbc-be77-09e054bbcc24",
                                                "sense_id": "37c10f22-2ff3-3b06-b63f-ef5d237d46f6",
                                                "text": "After tea, Mrs. Inglethorp went to lie down to rest before her efforts in the evening and I challenged Mary Cavendish to a single at tennis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40f9142a-16cf-381b-be58-2ec962b60f05",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "One of the reeled filaments of silk, twisted without doubling to give them firmness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6423cf7e-ff09-3d21-bc68-e417d7dee465",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A handful of gleaned grain."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c42ed041-6b2d-3aec-858c-eebc25d56bb6",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A floating-point number having half the precision of a double-precision value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9886185-c284-4fb1-a747-9e3f6484dd57",
                                                "sense_id": "c42ed041-6b2d-3aec-858c-eebc25d56bb6",
                                                "text": "If you want to be a scientist or an engineer, learn to say “no” to singles and floats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3409394-550b-3ca4-870f-88e9d82863a0",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A shot of only one character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9596aad8-40f7-4278-b911-6c7fc4ef2eaa",
                                                "sense_id": "b3409394-550b-3ca4-870f-88e9d82863a0",
                                                "text": "But if the same scene is shot in singles (or “over-the-shoulder” shots where one of the actors is only a lumpy shoulder in the foreground), the editor and the director can almost redirect the scene on film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "763d860d-81ce-36e8-86c5-47a102b971ee",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "A single cigarette."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da2ee310-78ab-3ec6-a944-1c5218877a1b",
                                        "entry_id": "a6b8e1bf-281e-3379-8cc4-e625fe8302f9",
                                        "glosses": [
                                            "Synonym of single-driver."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdcf35e0-9b3c-450e-998f-da09f4bc03b9",
                                                "sense_id": "da2ee310-78ab-3ec6-a944-1c5218877a1b",
                                                "text": "A few such examples have been preserved, as is well known, such as one of the Stirling 8-ft. singles of the late Great Northern Railway, the Great Western 4-4-0 City of Truro, ex-Caledonian single-driver No. 123, the Brighton 0-4-2 Gladstone, and others."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "single",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d293ee8-5ed6-3248-b5e3-82e7996b8fa9",
                                        "entry_id": "e0900fb0-d6d5-3ba3-9ffc-d3d685b66425",
                                        "glosses": [
                                            "To get a hit that advances the batter exactly one base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f693e909-354f-4a1d-b17d-b21c2a2f0f60",
                                                "sense_id": "9d293ee8-5ed6-3248-b5e3-82e7996b8fa9",
                                                "text": "Pedro singled in the bottom of the eighth inning, which, if converted to a run, would put the team back into contention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "006884c8-4e77-3b8c-9bb2-29a6377c723e",
                                        "entry_id": "e0900fb0-d6d5-3ba3-9ffc-d3d685b66425",
                                        "glosses": [
                                            "To thin out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1829744-4804-4517-916e-a49eecfbceef",
                                                "sense_id": "006884c8-4e77-3b8c-9bb2-29a6377c723e",
                                                "text": "Paul went joyfully, and spent the afternoon helping to hoe or to single turnips with his friend."
                                            },
                                            {
                                                "example_id": "159bf04f-44d0-43d0-a32b-8084df9e212e",
                                                "sense_id": "006884c8-4e77-3b8c-9bb2-29a6377c723e",
                                                "text": "The seeds did not germinate in many parts of a row until rains in end of June and thunderplumps in first week of July brought them up later in patches, so that no second sowing was necessary, but singling was done by stages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcc3ba1e-05e2-3825-9aa1-0918a9224b37",
                                        "entry_id": "e0900fb0-d6d5-3ba3-9ffc-d3d685b66425",
                                        "glosses": [
                                            "To take the irregular gait called singlefoot."
                                        ],
                                        "tags": [
                                            "of a horse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1cef389-3758-4893-8f50-9af5b5075b67",
                                                "sense_id": "dcc3ba1e-05e2-3825-9aa1-0918a9224b37",
                                                "text": "Many very fleet horses, when overdriven, adopt a disagreeable gait, which seems to be a cross between a pace and a trot, in which the two legs of one side are raised almost but not quite, simultaneously. Such horses are said to single, or to be single-footed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bba05ef0-2e59-389c-9976-46626da1d72a",
                                        "entry_id": "e0900fb0-d6d5-3ba3-9ffc-d3d685b66425",
                                        "glosses": [
                                            "To sequester; to withdraw; to retire."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06cbdd7c-7053-4a9d-955d-21631a8b9796",
                                                "sense_id": "bba05ef0-2e59-389c-9976-46626da1d72a",
                                                "text": "an agent singling itself from consorts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c29a0ce1-c022-308a-8f53-1233853cc662",
                                        "entry_id": "e0900fb0-d6d5-3ba3-9ffc-d3d685b66425",
                                        "glosses": [
                                            "To take alone, or one by one; to single out."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c65c4c18-4d4c-4bc5-ba78-6c4490da47bf",
                                                "sense_id": "c29a0ce1-c022-308a-8f53-1233853cc662",
                                                "text": "men […] commendable when they are singled"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ca825da-8a56-3112-8ee3-99562291139f",
                                        "entry_id": "e0900fb0-d6d5-3ba3-9ffc-d3d685b66425",
                                        "glosses": [
                                            "To reduce (a railway) to single track."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80a9a069-b5e6-4edf-83a4-a4fc62841ce8",
                                                "sense_id": "9ca825da-8a56-3112-8ee3-99562291139f",
                                                "text": "In the east of Yorkshire, Mr. A. M. Ross reports the belief of local railwaymen that the N.E.R. plans to single the York-Beverley line, leaving an adequate provision of passing loops, and to operate it by C.T.C. from York; […]"
                                            },
                                            {
                                                "example_id": "f27ff00e-55e2-4ea1-a4fa-60ee0beb630c",
                                                "sense_id": "9ca825da-8a56-3112-8ee3-99562291139f",
                                                "text": "The Henley branch, recently singled and fully track-circuited, is worked by acceptance lever between Twyford and Shiplake cabins."
                                            },
                                            {
                                                "example_id": "ba76d29f-e8ed-4fe2-a1f9-56f2a59df67a",
                                                "sense_id": "9ca825da-8a56-3112-8ee3-99562291139f",
                                                "text": "Sadly, it's not the quickest route as much of it has been singled, but it still boasts some attractive stations as well as an active Community Rail Partnership, one of the first in the country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
