                "senses": [
                    {
                        "sense_id": "eeb2cc03-5292-35da-87bc-c16f94905fbf",
                        "entry_id": "cecfe663-997a-39fb-a831-8ac4622c5cc4",
                        "glosses": [
                            "drunk, drunkard (person who is habitually drunk)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d55c88bb-919c-454e-b48f-7219b8ab0638",
                                "sense_id": "eeb2cc03-5292-35da-87bc-c16f94905fbf",
                                "text": "Таки́е ли́чности охо́тно поддаю́тся вся́кому влия́нию и мо́гут сде́латься чем уго́дно: пропо́йцами, попроша́йками, шута́ми и да́же престу́пниками.",
                                "translation": "Such persons succumb readily to any influence and may become anything – drunkards, spongers, jesters, criminals even...",
                                "english": "Such persons succumb readily to any influence and may become anything – drunkards, spongers, jesters, criminals even..."
                            },
                            {
                                "example_id": "4bc34f03-0261-4ce0-85e7-635b5c74bda4",
                                "sense_id": "eeb2cc03-5292-35da-87bc-c16f94905fbf",
                                "text": "— Ско́лько возьмёте за э́то? — спроси́л он, рассма́тривая де́тские рису́нки.\n— Дава́йте двугри́венный, — отве́тила ба́ба с лицо́м пропо́йцы.",
                                "translation": "Konstantin Vaginov",
                                "english": "Konstantin Vaginov"
                            }
                        ]
                    }
                ],
