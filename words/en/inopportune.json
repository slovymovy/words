            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "df904497-67e6-3276-a7a0-6008fd894619",
                    "sense_definition": "Happening or done at an inconvenient, inappropriate, or badly chosen time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The phone rang at an <w>inopportune</w> moment, right as I was about to fall asleep.",
                            "target_lang_translations": {
                                "ru": "Телефон зазвонил в самый <w>неподходящий</w> момент, как раз когда я уже засыпал."
                            }
                        },
                        {
                            "text": "His sudden question arrived at a highly <w>inopportune</w> time during the private meeting.",
                            "target_lang_translations": {
                                "ru": "Его неожиданный вопрос прозвучал в крайне <w>несвоевременный</w> момент во время закрытой встречи."
                            }
                        }
                    ],
                    "synonyms": [
                        "ill-timed",
                        "untimely"
                    ],
                    "antonyms": [
                        "opportune",
                        "timely"
                    ],
                    "common_phrases": [
                        "inopportune moment",
                        "inopportune time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или совершаемый в неудобное, неподходящее или неудачно выбранное время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несвоевременный",
                                "target_lang_sense_clarification": "о времени или моменте"
                            },
                            {
                                "target_lang_word": "неуместный",
                                "target_lang_sense_clarification": "не подходящий к моменту"
                            },
                            {
                                "target_lang_word": "неподходящий",
                                "target_lang_sense_clarification": "о времени или обстоятельстве"
                            },
                            {
                                "target_lang_word": "некстати",
                                "target_lang_sense_clarification": "в значении предикатива / неподходящий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b71b958-5a60-3272-9369-642633062f63",
                    "sense_definition": "Unsuitable or inappropriate for a particular purpose or situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold and muddy field proved to be an <w>inopportune</w> place for an outdoor wedding.",
                            "target_lang_translations": {
                                "ru": "Холодное и грязное поле оказалось крайне <w>неподходящим</w> местом для свадьбы на открытом воздухе."
                            }
                        },
                        {
                            "text": "Choosing such a crowded café was an <w>inopportune</w> setting for a sensitive business negotiation.",
                            "target_lang_translations": {
                                "ru": "Выбор столь многолюдного кафе был <w>неудачным</w> местом для деликатных деловых переговоров."
                            }
                        }
                    ],
                    "synonyms": [
                        "inappropriate",
                        "unfit",
                        "unsuitable"
                    ],
                    "antonyms": [
                        "appropriate",
                        "fitting",
                        "suitable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неподходящий или неудобный для конкретной цели, места или ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неподходящий",
                                "target_lang_sense_clarification": "для определенной цели или места"
                            },
                            {
                                "target_lang_word": "неудачный",
                                "target_lang_sense_clarification": "о выборе места, обстановки"
                            },
                            {
                                "target_lang_word": "неудобный",
                                "target_lang_sense_clarification": "неприспособленный для ситуации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
