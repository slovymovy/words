                    }
                ],
                "senses": [
                    {
                        "sense_id": "5df9f4bc-131f-32b5-a803-0ef988b5d77a",
                        "entry_id": "1995ff72-2075-3817-88c4-dc2cd7b79fd8",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32eb237c-37d9-477a-bc4a-4bb52c414519",
                                "sense_id": "5df9f4bc-131f-32b5-a803-0ef988b5d77a",
                                "text": "Un soir pluvieux, Corinne laissa entendre qu'elle était amoureuse. J'allais m'en montrer consterné mais je craignis que ma consternation ne prêtât à confusion et ne fût mal interprétée : il ne fallait pas qu'elle m’imaginât épris d'elle."
                            },
                            {
                                "example_id": "03263801-1102-48bc-aef0-6b1ea59c5996",
                                "sense_id": "5df9f4bc-131f-32b5-a803-0ef988b5d77a",
                                "text": "Je m’en voudrais d’oublier ici les deux interprètes sans qui rien n’eût été possible, Anne-Marie Bisaro et Corinne Gache."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd67f8ef-54e3-4d89-910f-39b0090a9cec",
                        "source_entry_id": "1995ff72-2075-3817-88c4-dc2cd7b79fd8",
                        "source_sense_id": "5df9f4bc-131f-32b5-a803-0ef988b5d77a",
                        "target_lang_word": "Corinna",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c5320ca2-93d7-48d4-9574-b439a2c9fa9e",
                        "source_entry_id": "1995ff72-2075-3817-88c4-dc2cd7b79fd8",
                        "source_sense_id": "5df9f4bc-131f-32b5-a803-0ef988b5d77a",
                        "target_lang_word": "Corinna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Corinna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5d0110a-6251-31d5-a3dd-04c6a06dd914",
                                        "entry_id": "d475fd3f-e6bf-3b38-9c8a-6e2baf85ad62",
                                        "glosses": [
                                            "An ancient Greek poetess."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e27b70e1-cd6f-4674-b0a2-37e8705a748e",
                                                "sense_id": "e5d0110a-6251-31d5-a3dd-04c6a06dd914",
                                                "text": "During this period he became acquainted with the poetess Corinna, who was likewiſe a ſtudent under Myrtis, and, Pauſanias ſays, was one of the moſt beautiful women of her time."
                                            },
                                            {
                                                "example_id": "c9db4c37-0782-4a98-beae-55f52aea550f",
                                                "sense_id": "e5d0110a-6251-31d5-a3dd-04c6a06dd914",
                                                "text": "The most renowned poetess of ancient Greece, after Sappho, was Corinna, who came from a town in Boeotia named Tanagra."
                                            },
                                            {
                                                "example_id": "92f36f96-fd47-4523-a79e-0e978b6772fd",
                                                "sense_id": "e5d0110a-6251-31d5-a3dd-04c6a06dd914",
                                                "text": "[…]it may not be going too far, in other words, to characterize Corinna's poetry as significantly \"woman-identified,\" to use Rayor's term."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dac44e7-c55b-3d9a-a4bc-1b7721624bb8",
                                        "entry_id": "d475fd3f-e6bf-3b38-9c8a-6e2baf85ad62",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd08cc8-d25e-49c1-8f45-3c66de50c865",
                                                "sense_id": "4dac44e7-c55b-3d9a-a4bc-1b7721624bb8",
                                                "text": "1601, Thomas Campion, When to Her Lute Corinna Sings, A Book of Ayres, 2006, Jay Parini (editor), The Wadsworth Anthology of Poetry, page 614,\nWhen to her lute Corinna sings, / Her voice revives the leaden strings,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
