                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f00fa16b-2e5f-3a26-a293-c16246085343",
                                        "entry_id": "3dfd559e-c11e-3387-b068-2cc961f5b48f",
                                        "glosses": [
                                            "The chemical element (symbol B) with an atomic number of 5, which is a metalloid found in its pure form as a dark amorphous powder."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8774fdc-b605-4571-a4c5-5fbcfb9c7998",
                                                "sense_id": "f00fa16b-2e5f-3a26-a293-c16246085343",
                                                "text": "The B₆-type octahedral borons are each bonded to five other boron atoms; four are part of the same octahedron, and one is external to this octahedron."
                                            },
                                            {
                                                "example_id": "34d3be0a-3d8c-4301-ad30-5a235490085b",
                                                "sense_id": "f00fa16b-2e5f-3a26-a293-c16246085343",
                                                "text": "PIRG noted the European Union has a limit of 300 ppm for boron and that there should be a “full-fledged investigation to determine if limits should be established” in the US."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f7e5539-46a7-3ec5-a63d-529b63e881ea",
                                        "entry_id": "3dfd559e-c11e-3387-b068-2cc961f5b48f",
                                        "glosses": [
                                            "A single atom of this element."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4db8dfda-67d4-4935-be22-110abc38abbf",
                                                "sense_id": "5f7e5539-46a7-3ec5-a63d-529b63e881ea",
                                                "text": "For each X point, four borons in the same plane composing a B₆ cluster provide these orbitals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
