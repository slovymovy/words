                    },
                    {
                        "form_id": "b03ecbb2-ccee-48a9-bceb-7ef54bfd8bd9",
                        "entry_id": "ef7a64b4-8090-3d29-b9b8-91198d76f935",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Insektenschutz"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "41f798fa-74e0-3452-a6f6-553d55cbafeb",
                        "entry_id": "ef7a64b4-8090-3d29-b9b8-91198d76f935",
                        "glosses": [
                            "Maßnahmen, die den Erhalt von Insekten zum Ziel haben (beispielsweise durch den Erhalt von Lebensräumen für Insekten, Verbot von Insektiziden)"
                        ],
                        "tags": [
                            "Schutz von Insekten"
                        ],
                        "examples": [
                            {
                                "example_id": "aabdbc96-35f2-4035-aca8-8dd4680a2745",
                                "sense_id": "41f798fa-74e0-3452-a6f6-553d55cbafeb",
                                "text": "„Insektenschutz geht alle an.“"
                            },
                            {
                                "example_id": "fb9f9af8-528f-4c52-afc0-975ab9acda75",
                                "sense_id": "41f798fa-74e0-3452-a6f6-553d55cbafeb",
                                "text": "Man kann im eigenen Garten Insektenschutz betreiben, indem man die Rasenfläche nur zweimal im Jahr mäht."
                            },
                            {
                                "example_id": "d4318f46-2e6d-4735-ac0a-fca91d00200b",
                                "sense_id": "41f798fa-74e0-3452-a6f6-553d55cbafeb",
                                "text": "Blühstreifen an Ackerrändern sind ein guter Insektenschutz."
                            },
                            {
                                "example_id": "4fe6266f-f6b7-440d-b8c3-21e1f04a597d",
                                "sense_id": "41f798fa-74e0-3452-a6f6-553d55cbafeb",
                                "text": "Für einen wirkungsvollen Insektenschutz wäre es sehr hilfreich, künstliche Lichtquellen nachts einfach auszuschalten."
                            },
                            {
                                "example_id": "089e8aea-d7e1-4630-8b0f-084bae19381c",
                                "sense_id": "41f798fa-74e0-3452-a6f6-553d55cbafeb",
                                "text": "„Insektenschutz ja, aber muss man auch Fliegen schützen?“"
                            },
                            {
                                "example_id": "4c902fd0-e01e-4324-972a-23acd252cd78",
                                "sense_id": "41f798fa-74e0-3452-a6f6-553d55cbafeb",
                                "text": "„»Wenn wir Insektenschutz ernst meinen, müssen wir den Einsatz von Pestiziden aller Art deutlich verringern«, so Ministerin Schulze.“"
                            },
                            {
                                "example_id": "05e160b2-a46e-4b8e-a256-810e2bf7b9ca",
                                "sense_id": "41f798fa-74e0-3452-a6f6-553d55cbafeb",
                                "text": "„Bundestag und Bundesrat haben ein umfassendes Maßnahmenpaket für den Insektenschutz beschlossen: Das Insektenschutzgesetz des Bundesumweltministeriums sieht unter anderem den Schutz von für Insekten wichtigen Biotopen wie Streuobstwiesen vor sowie ein Vorgehen zur Verringerung der insektenschädlichen Lichtverschmutzung.“"
                            },
                            {
                                "example_id": "b4a598fa-47c3-4dcd-b511-121077ee2ee4",
                                "sense_id": "41f798fa-74e0-3452-a6f6-553d55cbafeb",
                                "text": "„Um überleben zu können, brauchen Wildbienen und andere Insekten möglichst viele Blühflächen. Jeder Einzelne kann dabei viel für den Insektenschutz tun. Heimische Blumen und Stauden sowie Kräuter wie Lavendel, Thymian und Oregano sind die besten Nahrungsquellen für Insekten. Eine Königskerze zum Beispiel ernährt 80 verschiedene Insektenarten.“"
                            },
                            {
                                "example_id": "b1a01721-9ea1-4eb9-9d10-02eafad87a58",
                                "sense_id": "41f798fa-74e0-3452-a6f6-553d55cbafeb",
                                "text": "„2019 reagierte die Bundesregierung auf das festgestellte, massive Insektensterben mit einem Aktionsprogramm Insektenschutz, das allerdings wiederum von Wissenschaftlern als wenig ambitioniert bezeichnet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "714cbf74-e63f-39ab-aa60-206711956938",
                        "entry_id": "ef7a64b4-8090-3d29-b9b8-91198d76f935",
                        "glosses": [
                            "Maßnahmen, die Insekten töten, fernhalten oder vertreiben (beispielsweise durch Einsatz von Insektiziden, Fliegengittern)"
                        ],
                        "tags": [
                            "Schutz vor Insekten"
                        ],
                        "examples": [
                            {
                                "example_id": "687ff273-9f80-4f08-ad2f-c3b4b0205703",
                                "sense_id": "714cbf74-e63f-39ab-aa60-206711956938",
                                "text": "„Die Europäische Behörde für Lebensmittelsicherheit (EFSA) hat die Maissorte 1507 unter anderem daraufhin untersucht, ob der per Gentechnik erzeugte Insektenschutz auch andere Tiere, außer Maisschädlinge, gefährdet.“"
                            },
                            {
                                "example_id": "0535c0d3-f6e1-47d8-85bc-11156d61af56",
                                "sense_id": "714cbf74-e63f-39ab-aa60-206711956938",
                                "text": "„Bevor man sich“ […] „mit Insektenschutz einsprüht, ist es immer erstmal sinnvoll, sich entsprechend so zu kleiden, dass man nicht gestochen wird.“"
                            },
                            {
                                "example_id": "c6656662-cac8-4744-b955-446636d98a93",
                                "sense_id": "714cbf74-e63f-39ab-aa60-206711956938",
                                "text": "„Es gibt darüber hinaus verschiedene Einzelmaßnahmen des Insektenschutzes, mit denen man sich vor Mückenstichen schützen kann.“"
                            },
                            {
                                "example_id": "e6bb45c1-7515-45b8-9cff-d5c56fcbfc45",
                                "sense_id": "714cbf74-e63f-39ab-aa60-206711956938",
                                "text": "[Malaria:] „Der Insektenschutz (als Expositionsprophylaxe) ist der wichtigste Bestandteil der Malariavorbeugung. Dazu zählt das Tragen heller, hautbedeckender, langer Kleidung, der Aufenthalt in mückensicheren Räumen (insbesondere nachts; Klimaanlage, Fliegengitter, Moskitonetz) sowie die Behandlung von Haut und Kleidung mit moskitoabweisenden Mitteln, sogenannten Repellentien (z. B. Icaridin oder DEET).“"
                            },
                            {
                                "example_id": "765dd014-4bea-4f70-9c08-ee5bad52f345",
                                "sense_id": "714cbf74-e63f-39ab-aa60-206711956938",
                                "text": "[Hämorrhagisches Fieber:] „Am hilfreichsten allerdings ist die Vorbeugung durch Insektenschutz und Einhaltung hygienischer Grundregeln.“"
                            },
                            {
                                "example_id": "8bc256c6-d160-4428-8ccf-12db7e699c68",
                                "sense_id": "714cbf74-e63f-39ab-aa60-206711956938",
                                "text": "[Neuseeland:] „Insektenschutz und Sonnenschutz sollten in keinem Reisegepäck fehlen“"
                            },
                            {
                                "example_id": "22539959-3a5d-4127-9a30-913db2ce99d7",
                                "sense_id": "714cbf74-e63f-39ab-aa60-206711956938",
                                "text": "[Khao Lak:] […] „Wasserfälle in der Low Season (Regenzeit) sind sehr schön, aber mitunter tagelang im Regen versunken, was sehr reizvoll sein kann. Gutes Schuhwerk sowie Insektenschutz sind angeraten.“"
                            },
                            {
                                "example_id": "3fd8f3b0-2d42-4f4e-91dd-98cfc8e48dd5",
                                "sense_id": "714cbf74-e63f-39ab-aa60-206711956938",
                                "text": "[Tikal:] „Insektenschutz und Kopfbedeckung gehören ebenfalls zur Grundausstattung.“"
                            },
                            {
                                "example_id": "f2993205-3a5e-4bde-95f2-879d2266b68a",
                                "sense_id": "714cbf74-e63f-39ab-aa60-206711956938",
                                "text": "[Schlagzeile:] „Welcher Insektenschutz funktioniert tatsächlich?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
