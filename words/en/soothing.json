                },
                {
                    "sense_id": "c2ee9dc8-c9ce-3b1a-9642-61817ae72551",
                    "sense_definition": "Present participle and gerund of <w>sooth</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient chronicler spent hours <w>soothing</w> his patrons with tales confirming their supposed lineage.",
                            "target_lang_translations": {
                                "pl": "Starożytny kronikarz spędzał godziny na <w>pochlebianiu</w> swoim mecenasom opowieściami potwierdzającymi ich rzekome pochodzenie."
                            }
                        },
                        {
                            "text": "By constantly <w>soothing</w> the suspicious ruler, the courtier managed to stay in power.",
                            "target_lang_translations": {
                                "pl": "Poprzez nieustanne <w>przypochlebianie się</w> podejrzliwemu władcy, dworzanin zdołał utrzymać się przy władzy."
                            }
                        }
