                "translations": [
                    {
                        "translation_id": "61ee2171-0203-40ae-b99f-ba45b5ada4d1",
                        "source_entry_id": "9fea4fc2-06aa-3e0b-8a20-d2eb30566aa0",
                        "target_lang_word": "Entbindung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entbindung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed3a22bb-b380-336b-a006-fbb2cb93760d",
                                        "entry_id": "be249753-54d4-3ba3-8138-0a61be04fe6e",
                                        "glosses": [
                                            "die Befreiung von etwas, insbesondere von einer Verpflichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08946a0e-a50e-494f-b55b-94f19e424120",
                                                "sense_id": "ed3a22bb-b380-336b-a006-fbb2cb93760d",
                                                "text": "Nach den Extravaganzen, die er sich geleistet hatte, war die Entbindung vom Amt des Schatzmeisters nur eine Frage der Zeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "72b0774b-861e-3782-972b-7f9674d68540",
                                        "entry_id": "be249753-54d4-3ba3-8138-0a61be04fe6e",
                                        "glosses": [
                                            "die Geburt eines Kindes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a2da0b6-8842-4144-b3ef-b969fcecd321",
                                                "sense_id": "72b0774b-861e-3782-972b-7f9674d68540",
                                                "text": "Zwei Wochen nach der Entbindung war sie schon wieder topfit."
                                            },
                                            {
                                                "example_id": "9a1b1a9a-89c5-4e62-9370-adebbac68d32",
                                                "sense_id": "72b0774b-861e-3782-972b-7f9674d68540",
                                                "text": "„Sie hatte beschlossen, ihr nichts zu sagen, und hatte auch ihren Vater überredet, der jungen Frau die schreckliche Nachricht bis nach ihrer unmittelbar bevorstehenden Entbindung zu verheimlichen.“"
                                            },
                                            {
                                                "example_id": "27ccee56-0479-4821-aef3-6b011af245c8",
                                                "sense_id": "72b0774b-861e-3782-972b-7f9674d68540",
                                                "text": "„Ich fragte sie nach ihrem Befinden, und ob sie im Zusammenhang mit ihrer Entbindung Beschwerden habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
