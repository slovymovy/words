                "senses": [
                    {
                        "sense_id": "399555d9-c249-39ea-b8f4-a9968e3d1094",
                        "entry_id": "e0dca7c3-0137-3f21-b2ad-509a53bdec89",
                        "glosses": [
                            "Verwirrung der Sinne, durch den äußeren Schein abgelenkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5239285-a4b4-491d-8cc8-fb9f2afcfffe",
                                "sense_id": "399555d9-c249-39ea-b8f4-a9968e3d1094",
                                "text": "In seiner Verblendung hat er dieser Wunderheilerin sein ganzes Geld gegeben."
                            },
                            {
                                "example_id": "6419d33d-0f2a-4a43-aa99-5e442d188878",
                                "sense_id": "399555d9-c249-39ea-b8f4-a9968e3d1094",
                                "text": "In ihrer Verblendung hat sie nicht einmal gemerkt, dass er nie von seiner Familie sprach."
                            },
                            {
                                "example_id": "ffb91fa5-1612-4bd7-8c7c-28b3e03f3b31",
                                "sense_id": "399555d9-c249-39ea-b8f4-a9968e3d1094",
                                "text": "„Ich muß auch sagen, daß Sophies Verblendung weniger grotesk war, als es den Anschein hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e2c7b4b9-c5c2-3e0a-bbcd-2cae1f0ec853",
                        "entry_id": "e0dca7c3-0137-3f21-b2ad-509a53bdec89",
                        "glosses": [
                            "äußere Verkleidung von etwas, zum Beispiel eines Mauerwerks oder Zahnes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b535889-4915-4721-a20d-3a18d2e33512",
                                "sense_id": "e2c7b4b9-c5c2-3e0a-bbcd-2cae1f0ec853",
                                "text": "Eine Verblendung der Kauflächen ist im Leistungskatalog der Gesetzlichen Krankenversicherung nicht vorgesehen."
                            },
                            {
                                "example_id": "884e5bd7-db5b-497e-bee8-5a53cf7a7268",
                                "sense_id": "e2c7b4b9-c5c2-3e0a-bbcd-2cae1f0ec853",
                                "text": "Die Garage bekam dann noch eine Verblendung mit gelbem Klinker."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
