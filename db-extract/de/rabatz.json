                        "form": "dem Rabatz"
                    },
                    {
                        "form_id": "2f4cea88-bafc-4244-9413-1b7464164ed0",
                        "entry_id": "944f109c-6386-3db9-8adf-ea11b00e95f9",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Rabatz"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92e57b79-6ccb-360d-9f67-827fa66fd1f7",
                        "entry_id": "944f109c-6386-3db9-8adf-ea11b00e95f9",
                        "glosses": [
                            "lautes Treiben, Aufruhr, Krach (auch als Ausdruck von Protest)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2532ea62-a9ba-4332-8e57-76dcd7dccebf",
                                "sense_id": "92e57b79-6ccb-360d-9f67-827fa66fd1f7",
                                "text": "Kinder, hört endlich mit dem Rabatz auf!"
                            },
                            {
                                "example_id": "062fb53a-e601-4de8-bbb9-0ea01ff7039b",
                                "sense_id": "92e57b79-6ccb-360d-9f67-827fa66fd1f7",
                                "text": "Es gab großen Rabatz, als die Entscheidung bekannt wurde."
                            },
                            {
                                "example_id": "bab377ab-d878-4652-bb4b-10738fcc28a9",
                                "sense_id": "92e57b79-6ccb-360d-9f67-827fa66fd1f7",
                                "text": "Bunt geschminkt als wilde Tiere zogen sie anschließend mit viel Rabatz durch die Stadt. (Internetbeleg)"
                            },
                            {
                                "example_id": "3fcb6931-7801-4bc5-bdff-e69e02092c91",
                                "sense_id": "92e57b79-6ccb-360d-9f67-827fa66fd1f7",
                                "text": "„Sie machte richtig Rabatz in der Karre.“"
                            },
                            {
                                "example_id": "7d36e2ba-1623-4da6-baab-adc53729fe21",
                                "sense_id": "92e57b79-6ccb-360d-9f67-827fa66fd1f7",
                                "text": "„In der Spiegelgasse 1 wurde das \"Cabaret Voltaire\" eröffnet. Das war eine Ansammlung von jungen Leuten, die kreativ waren und Rabatz machen wollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "508ffbaf-5fd0-42e3-856b-c8b64191fd5d",
                        "source_entry_id": "944f109c-6386-3db9-8adf-ea11b00e95f9",
                        "source_sense_id": "92e57b79-6ccb-360d-9f67-827fa66fd1f7",
                        "source_sense_description": "lautes Treiben, Aufruhr, Krach",
                        "target_lang_word": "шум",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шум",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b85543bd-9888-3f00-8a96-9381d89a2966",
                                        "entry_id": "127a6871-538d-3f89-954a-a1c5adb39671",
                                        "glosses": [
                                            "громкие звуки, сливающиеся в нечто неясное и нестройное или воспринимаемые как помеха"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f55b7a24-d5a9-443e-ab0f-30718d6a9e9a",
                                                "sense_id": "b85543bd-9888-3f00-8a96-9381d89a2966",
                                                "text": "Тут я препроводил праздники столь весело, сколько в шуму и чаду веселиться можно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7351a911-8f3d-3117-803e-e43f5cc5115d",
                                        "entry_id": "127a6871-538d-3f89-954a-a1c5adb39671",
                                        "glosses": [
                                            "перен. оживлённое обсуждение чего-либо в обществе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fb6f76a-1fb3-48c7-bae3-906bb7600079",
                                                "sense_id": "7351a911-8f3d-3117-803e-e43f5cc5115d",
                                                "text": "Его поступок наделал шуму."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12b8876a-8b5d-382d-acf8-d31687b9d096",
                                        "entry_id": "127a6871-538d-3f89-954a-a1c5adb39671",
                                        "glosses": [
                                            "перен. громкая ссора"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c2f7fd-ede7-4563-9311-95efa4e946c5",
                                                "sense_id": "12b8876a-8b5d-382d-acf8-d31687b9d096",
                                                "text": "Сначала всё шло мирно, но потом поднялся шум."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "шум",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "efe8b540-b903-3967-86e0-a185c6d0c407",
                                        "entry_id": "40085c96-7abd-381d-84e6-8fa09070e4d8",
                                        "glosses": [
                                            "мед. неясно выраженная тональность при прослушивании организма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad7f4c0a-2708-4717-b596-8f96ffdaffcb",
                                                "sense_id": "efe8b540-b903-3967-86e0-a185c6d0c407",
                                                "text": "Шумы в сердце."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0cba85b-373b-3268-95c2-66fe24170bdc",
                                        "entry_id": "40085c96-7abd-381d-84e6-8fa09070e4d8",
                                        "glosses": [
                                            "физ. помехи, затрудняющие восприятие информационного сигнала"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8111ee83-89a9-4634-8c6d-f56d563de040",
                                                "sense_id": "e0cba85b-373b-3268-95c2-66fe24170bdc",
                                                "text": "Соотношение сигнал — шум было очень высоким."
                                            },
                                            {
                                                "example_id": "6bbb6343-9a32-4b10-9f9a-f87637161f97",
                                                "sense_id": "e0cba85b-373b-3268-95c2-66fe24170bdc",
                                                "text": "Шумы забивают передачу."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "шум",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e147e905-4821-3fe7-a70e-3c8f65fd50a3",
                                        "entry_id": "472cfa64-fb36-30ff-9e71-0339da5e6c32",
                                        "glosses": [
                                            "кулин. пена, возникающая при варке супа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e947bfc-1275-4b6c-b821-48077c3f6fcf",
                                                "sense_id": "e147e905-4821-3fe7-a70e-3c8f65fd50a3",
                                                "text": "Когда закипит не забудь снять ложкой шум (это серая пена) и выбросить"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
