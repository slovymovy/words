                ],
                "senses": [
                    {
                        "sense_id": "d790db26-c069-39a4-8a83-912a67bf8ab5",
                        "entry_id": "01f4c31c-256e-3e8d-a54d-7d08438fbbd3",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd367fcd-fd3d-4c1f-bac6-70dd836dc098",
                                "sense_id": "d790db26-c069-39a4-8a83-912a67bf8ab5",
                                "text": "Frau Bechter ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dbb233d5-3114-4452-bf24-7351847aa833",
                                "sense_id": "d790db26-c069-39a4-8a83-912a67bf8ab5",
                                "text": "Herr Bechter wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4df10658-ac8c-421b-8b6a-d0f93a492891",
                                "sense_id": "d790db26-c069-39a4-8a83-912a67bf8ab5",
                                "text": "Die Bechters fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4a9f1593-8b10-4050-8fc3-1a1f97ef5211",
                                "sense_id": "d790db26-c069-39a4-8a83-912a67bf8ab5",
                                "text": "Der Bechter trägt nie die Schals, die die Bechter ihm strickt."
                            },
                            {
                                "example_id": "51dd9b49-1f65-471a-a9fa-b4d91e12f505",
                                "sense_id": "d790db26-c069-39a4-8a83-912a67bf8ab5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bechter kommt, geht der Herr Bechter.“"
                            },
                            {
                                "example_id": "7fdb6dbc-992c-4736-92da-5dcdb10030a7",
                                "sense_id": "d790db26-c069-39a4-8a83-912a67bf8ab5",
                                "text": "Bechter kommt und geht."
                            },
                            {
                                "example_id": "32bd9f77-ced0-4b48-a9aa-b099b203d4b8",
                                "sense_id": "d790db26-c069-39a4-8a83-912a67bf8ab5",
                                "text": "Bechters kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
