                                "target_senses": [
                                    {
                                        "sense_id": "700225eb-0837-3667-9690-f48b5c9e9147",
                                        "entry_id": "4d3daa84-99fd-3bcf-9e0b-4d640e5335e8",
                                        "glosses": [
                                            "Province du Canada (abréviation : C.-B. ; symbole postal BC), bordée par le Yukon et les Territoires du Nord-Ouest au nord, l’Alberta à l’est, les États-Unis (États de Washington, Idaho et Montana) au sud, et l’océan Pacifique Nord et l’Alaska à l’ouest, et dont la capitale est Victoria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d68d4861-6553-4185-a592-df8f3b81b0bd",
                                                "sense_id": "700225eb-0837-3667-9690-f48b5c9e9147",
                                                "text": "Le gouvernement de la Colombie-Britannique."
                                            },
                                            {
                                                "example_id": "613c1f29-bc96-456f-899d-ea5917eaf232",
                                                "sense_id": "700225eb-0837-3667-9690-f48b5c9e9147",
                                                "text": "Vous ne pouvez pas vous sentir plus loin du Québec — sans quitter le Canada — autrement qu’en vivant à Victoria, en Colombie-Britannique."
                                            },
                                            {
                                                "example_id": "da6e87aa-be06-4c4d-9b59-91b5b7b48284",
                                                "sense_id": "700225eb-0837-3667-9690-f48b5c9e9147",
                                                "text": "En Colombie-Britannique, un tel système serait nuisible, car cette province de 4,3 millions d’habitants, déjà sous-représentée aux Communes, ne compte que six sénateurs."
                                            },
                                            {
                                                "example_id": "fa979a02-61a4-47c0-b8c3-4073cf2f132e",
                                                "sense_id": "700225eb-0837-3667-9690-f48b5c9e9147",
                                                "text": "J’habite en Colombie-Britannique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
