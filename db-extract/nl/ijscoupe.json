                        "sense_id": "21cc57c6-49a1-385b-9472-7a0decaea2a9",
                        "entry_id": "d63fbf32-cd46-3994-96a2-1cd758a1fa16",
                        "glosses": [
                            "een glazen schaaltje op een pootje waarin consumptieijs zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65664fad-4517-4f2d-a22f-d424ad508979",
                                "sense_id": "21cc57c6-49a1-385b-9472-7a0decaea2a9",
                                "text": "Bij de vakantie hoort vaak een ijsje. Niks heerlijkers dan een enorme ijscoupe op een terras. Als afsluiting van een heerlijke vakantieweek bijvoorbeeld."
                            },
                            {
                                "example_id": "0227f75c-20d3-4919-b555-8d17549c07ff",
                                "sense_id": "21cc57c6-49a1-385b-9472-7a0decaea2a9",
                                "text": "Het zal niet verrassend zijn dat de grootste ijscoupe die ooit werd gemaakt, in de Verenigde Staten is geproduceerd."
                            },
                            {
                                "example_id": "fe9d5817-35d4-448b-8f4e-2e868a9baa38",
                                "sense_id": "21cc57c6-49a1-385b-9472-7a0decaea2a9",
                                "text": "Wij zijn inmiddels ook toe aan een versnapering. Voor een flinke ijscoupe rijden we via een omweg naar het nabijgelegen Haslach en ook al is de rit van korte duur, het variërende landschap maakt indruk. Naast bossen en heuvels zien we indrukwekkende valleien met daarin meren en dorpjes."
                            }
                        ]
                    }
