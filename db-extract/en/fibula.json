                    {
                        "translation_id": "33a47571-f6d6-4d23-a787-bcd09a12f04f",
                        "source_entry_id": "6d27bc9c-0b77-3b98-9c10-5228e5489384",
                        "source_sense_description": "ancient brooch",
                        "target_lang_word": "Fibel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fibel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d1bba02-2121-3f5f-98bb-d8ed9e4b0fb9",
                                        "entry_id": "c320b175-d858-3504-ad5f-d172e7683653",
                                        "glosses": [
                                            "leicht verständliches, häufig bebildertes Kinderbuch zum Lesenlernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0166dc19-3dc6-45ee-b998-6b9b31018a4c",
                                                "sense_id": "4d1bba02-2121-3f5f-98bb-d8ed9e4b0fb9",
                                                "text": "Ich kann dir diese Fibel empfehlen. Unsere Tochter hat damit sehr schnell lesen gelernt."
                                            },
                                            {
                                                "example_id": "d2b23564-becb-4685-9f14-93b2861b47c9",
                                                "sense_id": "4d1bba02-2121-3f5f-98bb-d8ed9e4b0fb9",
                                                "text": "„In den Jahren 2009 und 2010 kamen im Zuge von Renaturierungsmaßnahmen am Flussbett Fibeln vom Ende der Hallstattzeit und vom Beginn der Latènezeit zutage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9eb52611-7c46-30f5-a512-e07c8631585b",
                                        "entry_id": "c320b175-d858-3504-ad5f-d172e7683653",
                                        "glosses": [
                                            "Bezeichnung für ein Lehrbuch, Nachschlagewerk, Handbuch zu einem bestimmtem Thema"
                                        ],
                                        "tags": [
                                            "aus [1] übertragen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cabf3f6e-7d58-46c4-a8c7-fee6e32e37d8",
                                                "sense_id": "9eb52611-7c46-30f5-a512-e07c8631585b",
                                                "text": "In allgemeinem Sprachgebrauch wird der Begriff Fibel heute auch zum Synonym für ein mehr oder weniger umfassendes Sachbuch, Ratgeberbuch, Nachschlagewerk, Handbuch, Fachbuch, Kompendium oder gar Lexikon."
                                            },
                                            {
                                                "example_id": "055a42af-6779-425b-b89d-94dcc1fa83a9",
                                                "sense_id": "9eb52611-7c46-30f5-a512-e07c8631585b",
                                                "text": "Im ganzen liest sich seine \"Verteidigung des Individualismus\" wie eine Fibel des demokratischen Republikanismus, der, soweit es die Ökonomie erlaubt, auch vor den sozialen Härten zu schützen hat."
                                            },
                                            {
                                                "example_id": "38b59649-7ba9-4714-b240-2f3f86c68f85",
                                                "sense_id": "9eb52611-7c46-30f5-a512-e07c8631585b",
                                                "text": "„An die Stelle der deutschen Rhetorik und des Formularbuchs trat nun der Katechismus: aus dem ABC-Buch wurde durch Aufnahme von biblischen Lesestücken die Fibel.“"
                                            },
                                            {
                                                "example_id": "effeb5d6-4651-4d13-8bb4-22b4755ec547",
                                                "sense_id": "9eb52611-7c46-30f5-a512-e07c8631585b",
                                                "text": "„Vorne auf der Fibel waren ein Mädchen und ein Junge, die mit Ranzen auf zur Schule gingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c34e316a-1e42-3263-b614-6f92c24f4efc",
                                        "entry_id": "c320b175-d858-3504-ad5f-d172e7683653",
                                        "glosses": [
                                            "verzierte Kleiderspange zum Zusammenhalten eines Gewandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25fc7f09-1441-4ed1-bb00-bc5c2ed33140",
                                                "sense_id": "c34e316a-1e42-3263-b614-6f92c24f4efc",
                                                "text": "Eine mittelalterliche Fibel erinnert an eine heutige Sicherheitsnadel."
                                            },
                                            {
                                                "example_id": "47cf51ff-d035-4cb3-ae53-42eaf6ed4884",
                                                "sense_id": "c34e316a-1e42-3263-b614-6f92c24f4efc",
                                                "text": "Bis ins hohe Mittelalter hinein waren Fibeln in Mitteleuropa die einzigen Kleidungsverschlüsse und kamen erst mit Aufkommen des Knopfes aus der Mode."
                                            },
                                            {
                                                "example_id": "d599523a-fd54-4384-91ac-56febbbbb67c",
                                                "sense_id": "c34e316a-1e42-3263-b614-6f92c24f4efc",
                                                "text": "„Die bei den Kelten beliebten Fibeln wurden durch das Ziehen von Draht hergestellt.“"
                                            },
                                            {
                                                "example_id": "f99a727a-71b6-403c-9aba-13056f1b99d4",
                                                "sense_id": "c34e316a-1e42-3263-b614-6f92c24f4efc",
                                                "text": "„Die Fibeln wurden sowohl als Sicherheitsnadel benutzt als auch als Schmuckstück getragen.“"
                                            },
                                            {
                                                "example_id": "d877b253-6b1d-436a-aedd-dbdbb925345f",
                                                "sense_id": "c34e316a-1e42-3263-b614-6f92c24f4efc",
                                                "text": "„Aus Gold waren ein Halsring, zwei Armringe und mehrere Fingerringe, dazu kamen Fibeln aus Gold und Perlen aus Glas und Bernstein, ein Bernsteinstab und ein Eisenmesser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
