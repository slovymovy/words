            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f30e9dc9-da43-3c36-b50c-4819bd275079",
                    "sense_definition": "Rendre stupide, hébété ou incapable de réflexion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stupidite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regarder ces programmes insipides pendant des heures finit par <w>abrutir</w> les jeunes téléspectateurs."
                        },
                        {
                            "text": "Les régimes autoritaires utilisent souvent la propagande pour <w>abrutir</w> l'esprit critique de la population."
                        }
                    ],
                    "synonyms": [
                        "hébéter",
                        "abêtir"
                    ],
                    "antonyms": [
                        "stimuler",
                        "éveiller"
                    ],
                    "common_phrases": [
                        "abrutir l'esprit",
                        "abrutir les masses"
                    ]
                },
                {
                    "sense_id": "fd2d45f0-3422-3612-9b6b-3e7cf92b4019",
                    "sense_definition": "Accabler, étourdir ou épuiser mentalement ou physiquement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "epuisement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette chaleur étouffante finit par <w>abrutir</w> tous les employés dans ce bureau non climatisé."
                        },
                        {
                            "text": "Le bruit incessant des marteaux-piqueurs dans la rue m'<w>abrutit</w> complètement depuis ce matin."
                        }
                    ],
                    "synonyms": [
                        "assommer",
                        "éreinter"
                    ],
                    "antonyms": [
                        "revigorer",
                        "délasser"
                    ]
                },
                {
                    "sense_id": "3ab39aab-ceed-362d-ab7a-a25dd76456fe",
                    "sense_definition": "Perdre sa lucidité ou s'engourdir l'esprit, généralement à la forme pronominale.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stupidite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une dure journée de travail, il préfère s'<w>abrutir</w> devant des vidéos stupides sur son téléphone."
                        },
                        {
                            "text": "Pour échapper à ses souvenirs douloureux, elle s'<w>abrutissait</w> de tâches répétitives jusqu'à l'aube."
                        }
                    ],
                    "synonyms": [
                        "s'hébéter",
                        "s'abêtir"
                    ],
                    "antonyms": [
                        "s'épanouir"
                    ],
                    "common_phrases": [
                        "s'abrutir de travail",
                        "s'abrutir devant la télé"
                    ]
                }
            ]
        }
    ]
