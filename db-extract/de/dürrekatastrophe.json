                ],
                "senses": [
                    {
                        "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                        "entry_id": "06a7a4d1-6aea-357f-895c-825aa452f8cb",
                        "glosses": [
                            "langanhaltende Dürre (= fehlender Regen), die extreme Folgen hat (beispielsweise Missernten, Hunger, Sterben von Menschen, Tieren und Pflanzen)"
                        ],
                        "tags": [
                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "febf835d-95cf-4b5d-9e3c-808f1604f7bf",
                                "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                                "text": "„Der indische Bundesstaat Rajasthan erlebte 1986 eine Dürrekatastrophe.“"
                            },
                            {
                                "example_id": "b36378d9-8310-4332-8d7a-02af3d6464a2",
                                "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                                "text": "[Sahara:] „»Fatale Auswirkungen hatten die Dürrekatastrophen der Jahre 1973/74 und 1984/85. Sehr viele Menschen kamen ums Leben.«“"
                            },
                            {
                                "example_id": "e65002df-3765-4d40-9da2-1afab52ea879",
                                "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                                "text": "[Kapverdische Inseln:] „Es kam immer wieder zu Dürrekatastrophen auf dem Archipel, der oft als Teil der Sahelzone betrachtet wird, so in den Jahren 1773–76, 1863–66, 1903–04 und Ende der 1960er Jahre.“"
                            },
                            {
                                "example_id": "c49934ab-072b-42a1-b2ae-7d63144e71b3",
                                "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                                "text": "[Australien:] „Durch die seit 18 Monaten währende Dürrekatastrophe sind weite Landstriche knochentrocken und zusätzlich brandanfällig.“"
                            },
                            {
                                "example_id": "c9ed67c3-eb41-4e13-ab0e-78f3a2f7be2a",
                                "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                                "text": "[Montana/USA:] „1988 traf das Land die schwerste Dürrekatastrophe seit den 1930er Jahren.“"
                            },
                            {
                                "example_id": "f5bbe6c5-9ecc-411e-bb9e-a031ea68cd98",
                                "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                                "text": "„Die Dürrekatastrophe im südlichen Afrika und Ostafrika führte 2015 und 2016, gebietsweise auch 2017, zur Ausrufung des Ausnahmezustands in mehreren Staaten.“"
                            },
                            {
                                "example_id": "c448a5a7-4711-4403-8460-bdbd2280124b",
                                "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                                "text": "[Lago Maggiore:] „Die historische Dürrekatastrophe verschärft den Konflikt.“"
                            },
                            {
                                "example_id": "6999d105-07ec-4bae-a4ab-396aadb3bbb5",
                                "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                                "text": "[Kreis Segeberg, Schleswig-Holstein:] „Die Wasserversorgung ist noch nicht gefährdet, aber die Landwirte machen sich Sorgen. Sie haben Angst, dass sich wegen der anhaltenden Schönwetterlage die Dürrekatastrophe des Sommers 2018 wiederholen könnte.“"
                            },
                            {
                                "example_id": "13f7e306-a601-4c64-82e0-9d3b1b10769e",
                                "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                                "text": "[Es ist] „definitiv zu früh, die Dürrekatastrophe für die Landwirtschaft auszurufen, sagte Klima-Experte Andreas Marx.“"
                            },
                            {
                                "example_id": "55817f91-289e-4e16-9f16-305aeba10ebc",
                                "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                                "text": "„Das Projekt generierte Millionen von Dollar für die Opfer der Dürrekatastrophe in Äthiopien.“"
                            },
                            {
                                "example_id": "60661392-ac62-4dd5-b0e2-f4e703441861",
                                "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                                "text": "„Das ist eine entlegene Nomaden-Region im Norden Kenias, wo die Menschen besonders heftig von der aktuellen Dürrekatastrophe betroffen sind.“"
                            },
                            {
                                "example_id": "43cae32e-137a-49e6-afd5-ca6831965ce6",
                                "sense_id": "3339bac8-2e1e-3042-bf93-363aea7df94c",
                                "text": "„Erstmals hat eine wissenschaftliche Studie das Ausmaß der Dürrekatastrophe 2010 bis 2012 in Somalia erhoben: Bei der Hungersnot“ […] „kamen demnach fast 260.000 Menschen ums Leben. 133.000 Todesopfer, und damit mehr als Hälfte, waren Kinder unter fünf Jahren. Die UNO räumte Fehler ein: »Wir hätten mehr tun sollen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
