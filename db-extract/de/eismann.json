                "senses": [
                    {
                        "sense_id": "22b43222-49c1-32d9-9de1-6df37b182939",
                        "entry_id": "410a47ba-6e91-3f97-a700-cc2e239d8e6d",
                        "glosses": [
                            "Verkäufer von Speiseeis, der häufig mobil oder zu Fuß tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ababa542-1736-464d-84cb-17639a4e51e6",
                                "sense_id": "22b43222-49c1-32d9-9de1-6df37b182939",
                                "text": "Der Eismann kommt, lasst uns hingehen und uns etwas kaufen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecf65678-9d79-4778-9e43-7221ac0ebfa0",
                        "source_entry_id": "410a47ba-6e91-3f97-a700-cc2e239d8e6d",
                        "source_sense_id": "22b43222-49c1-32d9-9de1-6df37b182939",
                        "source_sense_description": "Verkäufer von Speiseeis, der häufig mobil oder zu Fuß tätig ist",
                        "target_lang_word": "ijscoman",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ijscoman",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c645504a-0c3a-3088-ac2a-794300544d5c",
                                        "entry_id": "006c31b9-ab4f-34cf-a517-0158949a0039",
                                        "glosses": [
                                            "iemand die consumptie-ijs verkoopt vanuit een ijskraam"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9e8149a-2b44-45ad-8ef0-b3d688b06bca",
                                                "sense_id": "c645504a-0c3a-3088-ac2a-794300544d5c",
                                                "text": "De trekker met een ijscokraam erachter en aanstormende kinderen is een mooi tafereel. Als ze van koude lekkernijen zijn voorzien, springt de ijscoman weer op zijn trekker en rijdt hij een paar meter verder."
                                            },
                                            {
                                                "example_id": "b591b973-9547-47e3-8f5b-de8402e8052c",
                                                "sense_id": "c645504a-0c3a-3088-ac2a-794300544d5c",
                                                "text": "Toen zelfs haar liaison match made in heaven met nota bene een ijscoman mislukte, vreesde ik even dat er toch een kern van waarheid in moest zitten, maar ik houd toch liever vast aan mijn ervaringen met haar als jarenlange collega bij ‘SBS Shownieuws’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d6f6ea0-81de-4199-b236-160765e64a47",
                        "source_entry_id": "410a47ba-6e91-3f97-a700-cc2e239d8e6d",
                        "source_sense_id": "22b43222-49c1-32d9-9de1-6df37b182939",
                        "source_sense_description": "Verkäufer von Speiseeis, der häufig mobil oder zu Fuß tätig ist",
                        "target_lang_word": "мороженщик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мороженщик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ba6e1f9a-3b57-3743-a5ce-95a22a0b9449",
                                        "entry_id": "8da27571-59b7-3fc1-adfe-af4f7804351a",
                                        "glosses": [
                                            "разг. продавец мороженого"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "650124c0-2f0a-40df-8b0d-6e0ec0c09354",
                                                "sense_id": "ba6e1f9a-3b57-3743-a5ce-95a22a0b9449",
                                                "text": "— Мороженое хорошее! ❬…❭ Подходите! Угощу прохладительным! — выкрикивает мороженщик."
                                            },
                                            {
                                                "example_id": "0594e9a4-ed02-4f65-9745-406769f4e823",
                                                "sense_id": "ba6e1f9a-3b57-3743-a5ce-95a22a0b9449",
                                                "text": "Видел мороженщика Григория. ❬…❭ Я купил у него мороженого, заплатив впятеро .."
                                            },
                                            {
                                                "example_id": "436364de-3197-4698-b070-2f3a51989472",
                                                "sense_id": "ba6e1f9a-3b57-3743-a5ce-95a22a0b9449",
                                                "text": "А на улицах продрогшие мороженщики сиплыми от мороза голосами навязывают свой товар. Почти никто его не покупает, но мороженщики не хотят отступать от традиции. Из года в год заведено, что мороженое начинают продавать с первого дня Пасхи."
                                            },
                                            {
                                                "example_id": "d104f0f6-54ce-4a8a-98b5-fee8613e88b7",
                                                "sense_id": "ba6e1f9a-3b57-3743-a5ce-95a22a0b9449",
                                                "text": "В Троицын день мороженщики торговали, как никогда раньше. Даже мороженщики, торгующие в Петербурге 20 — 30 лет, не помнят такой хорошей торговли мороженым. У многих «мороженщиков» не хватило товара через два-три часа."
                                            },
                                            {
                                                "example_id": "5559b4c9-b4dd-4fa9-b0ac-a47a8df7e94f",
                                                "sense_id": "ba6e1f9a-3b57-3743-a5ce-95a22a0b9449",
                                                "text": "В столице появились уже мороженщики, продающие на улицах мороженое."
                                            },
                                            {
                                                "example_id": "f87bcfe2-3412-4bdb-8687-077c3daec923",
                                                "sense_id": "ba6e1f9a-3b57-3743-a5ce-95a22a0b9449",
                                                "text": "Когда я был маленький, я очень любил мороженое. ❬…❭ И когда, например, ехал по улице мороженщик со своей тележкой, у меня прямо начиналось головокружение: до того мне хотелось покушать то, что продавал мороженщик."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
