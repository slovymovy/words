                                            {
                                                "example_id": "e9662ce5-145e-4d78-b614-96a8506f5809",
                                                "sense_id": "19dfd7df-65d8-3173-8a78-eab3d2f05c61",
                                                "text": "On n'en trouve pas moins des locuteurs qui prononcent ce mot [atlas], avec /tl/ en attaque de la deuxième syllabe, ce qui contribue à dévoiser le /!/."
                                            }
                                        ]
                                    }
