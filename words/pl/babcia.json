                            "text": "Do autobusu weszła jakaś <w>babcia</w> z siatkami pełnymi zakupów.",
                            "target_lang_translations": {
                                "ru": "В автобус вошла какая-то <w>бабушка</w> с сумками, полными покупок.",
                                "en": "An <w>old woman</w> got on the bus with bags full of groceries."
                            }
                        },
                        {
                            "text": "Pomogłem tej <w>babci</w> przejść bezpiecznie przez ulicę.",
                            "target_lang_translations": {
                                "ru": "Я помог этой <w>бабушке</w> безопасно перейти улицу.",
                                "en": "I helped that <w>elderly woman</w> cross the street safely."
                            }
                        }
