                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed4509d1-da9f-4eb6-81c5-124d6d94620d",
                                                "sense_id": "3f9eb615-db95-3f12-9952-acac6994499e",
                                                "text": "[…] die tatsächliche Wirksamkeit von Homöopathie ist jedoch umstritten."
                                            },
                                            {
                                                "example_id": "d02ff1c5-f737-47d6-9553-0aeaec19fb55",
                                                "sense_id": "3f9eb615-db95-3f12-9952-acac6994499e",
                                                "text": "„An der östlichen Schwarzmeerküste ist Erdogan ein Ja zur umstrittenen Verfassungsänderung sicher.“"
                                            },
                                            {
                                                "example_id": "051f0527-c932-4ff1-aac7-a5193c9f442a",
                                                "sense_id": "3f9eb615-db95-3f12-9952-acac6994499e",
                                                "text": "„Im Zuge des hoch umstrittenen Projekts Stuttgart soll aus dem Stuttgarter Kopfbahnhof ein Tiefbahnhof werden.“"
                                            },
                                            {
                                                "example_id": "93942733-9b97-4f4b-9d03-0c3cbf8a154c",
                                                "sense_id": "3f9eb615-db95-3f12-9952-acac6994499e",
                                                "text": "„Der Begriff Krisenmanagement entstand im politischen Bereich, wobei dessen erstmalige Verwendung dort umstritten ist, mehrheitlich aber J.F. Kennedy im Zusammenhang mit der Kuba-Krise 1962 zugeschrieben wird.“"
                                            },
                                            {
                                                "example_id": "92764372-23d3-45ad-9a29-4b8e6468a792",
                                                "sense_id": "3f9eb615-db95-3f12-9952-acac6994499e",
                                                "text": "„Mit umstrittenen Urteilen zum Waffenrecht, Klimaschutz und Abtreibungen war der US-Supreme Court in den Schlagzeilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
