                "senses": [
                    {
                        "sense_id": "1737a1f9-2567-3346-8bdd-7c7f68a34800",
                        "entry_id": "5722efcc-e3af-3531-837d-0de56381ff5d",
                        "glosses": [
                            "człowiek kochający swoją ojczyznę, gotów do poświęceń dla niej"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b71fdf3-8727-4ab0-ae63-80beec3ee18c",
                        "source_entry_id": "5722efcc-e3af-3531-837d-0de56381ff5d",
                        "source_sense_id": "1737a1f9-2567-3346-8bdd-7c7f68a34800",
                        "target_lang_word": "patriot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patriot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e902f42-0b99-3b2b-a60e-3cf7f362d881",
                                        "entry_id": "7ba70301-65d5-3ce9-964a-c5e4cc39ae79",
                                        "glosses": [
                                            "A person who loves and zealously supports and defends their country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d3aeb09-5837-4e89-8974-2c48c99dd5ec",
                                                "sense_id": "9e902f42-0b99-3b2b-a60e-3cf7f362d881",
                                                "text": "Here Tears ſhall flovv from a more gen'rous Cauſe, / Such Tears as Patriots ſhed for dying Lavvs: […]"
                                            },
                                            {
                                                "example_id": "833c80db-235e-4f00-a64c-573338fdf140",
                                                "sense_id": "9e902f42-0b99-3b2b-a60e-3cf7f362d881",
                                                "text": "'My country, right or wrong,' is a thing that no patriot would think of saying except in a desperate case. It is like saying, 'My mother, drunk or sober.'"
                                            },
                                            {
                                                "example_id": "e0ac2de1-634b-4ce2-a635-36b3fa70ed27",
                                                "sense_id": "9e902f42-0b99-3b2b-a60e-3cf7f362d881",
                                                "text": "The difference between patriotism and nationalism is that the patriot is proud of his country for what it does, and the nationalist is proud of his country no matter what it does; the first attitude creates a feeling of responsibility, but the second a feeling of blind arrogance that leads to war."
                                            },
                                            {
                                                "example_id": "59c62be8-61e8-41e7-845e-049d5ad0031c",
                                                "sense_id": "9e902f42-0b99-3b2b-a60e-3cf7f362d881",
                                                "text": "Nothing beats a gunboat. HMS Illustrious glided out of Portsmouth on Monday, past HMS Victory and cheering crowds of patriots. Within a week it will be off Gibraltar, a mere cannon shot from Cape Trafalgar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1189f0c-c43a-37ae-b42b-781b64ddc799",
                                        "entry_id": "7ba70301-65d5-3ce9-964a-c5e4cc39ae79",
                                        "glosses": [
                                            "A fellow countryman, a compatriot."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e60e19af-8321-4d46-a2aa-1dbff9388168",
                                                "sense_id": "f1189f0c-c43a-37ae-b42b-781b64ddc799",
                                                "text": "The aim of patriots, therefore, was to set limits to the power which the ruler should be allowed to exercise over the community."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
