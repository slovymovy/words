                                    {
                                        "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                        "entry_id": "d7276746-22d6-3c58-bedc-4f7444ea6ca5",
                                        "glosses": [
                                            "Kind, das einen Kindergarten besucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "799b6b7f-97b9-4e1c-966f-e35a9b932f14",
                                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                                "text": "Die Kindergartenkinder stehen vor dem Affengehege und beobachten das Gorillamännchen."
                                            },
                                            {
                                                "example_id": "1b67cce1-3da9-43de-959d-54aee88dff27",
                                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                                "text": "Ein Kindergartenkind spielt im Sand, ein anderes schaukelt."
                                            },
                                            {
                                                "example_id": "f9850a83-c610-4a56-b37a-b0fb705e4970",
                                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                                "text": "„Ich habe mich schon als Kindergartenkind auf die Schule gefreut.“"
                                            },
                                            {
                                                "example_id": "bf7249fd-8b56-4ae2-a979-c88cbd8285f7",
                                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                                "text": "„Kindergartenkinder lernten schneller, die waren in sechs Monaten fertig.“"
                                            },
                                            {
                                                "example_id": "26f4c2a1-3c3d-4c72-a85e-e4187985dc31",
                                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                                "text": "„Auch die Untersuchung von Shields (1976) befaßt sich mit konversationellen Fähigkeiten, vor allem mit der Entwicklung des Dialogs bei drei- bis fünfjährigen Kindergartenkindern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c104f18-c4c5-42cd-a139-889992aada96",
                        "source_entry_id": "11bd5505-12e4-364d-a2a3-08765abd68e9",
