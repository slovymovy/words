            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "34decd9a-65eb-3d8b-868d-dfdf84007e7c",
                    "sense_definition": "zustimmend oder befürwortend gegenüber einem Vorschlag, Plan oder einer Entscheidung",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die meisten Mitglieder im Verein waren <w>dafür</w>, den Beitrag nicht zu erhöhen."
                        },
                        {
                            "text": "Alle Kollegen stimmten <w>dafür</w>, das neue Projekt sofort zu starten."
                        }
                    ],
                    "antonyms": [
                        "dagegen"
                    ],
                    "common_phrases": [
                        "dafür sein",
                        "dafür stimmen"
                    ]
                },
                {
                    "sense_id": "f39216a8-942f-3367-9f69-ed5f67b3da16",
                    "sense_definition": "in Bezug auf eine bestimmte Sache oder einen zuvor genannten Sachverhalt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat den Fehler bemerkt und sorgt nun <w>dafür</w>, dass alles wieder funktioniert."
                        },
                        {
                            "text": "Der Fahrer war ganz allein <w>dafür</w> verantwortlich, dass der Bus pünktlich abfuhr."
                        }
                    ],
                    "common_phrases": [
                        "dafür sorgen",
                        "dafür verantwortlich sein"
                    ]
                },
                {
                    "sense_id": "38d19018-687f-3be8-9441-010614b0735c",
                    "sense_definition": "zu diesem Zweck oder für dieses bestimmte Vorhaben",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich möchte mir ein Fahrrad kaufen, doch <w>dafür</w> fehlt mir noch das nötige Geld."
                        },
                        {
                            "text": "Wenn du ein neues Instrument lernen möchtest, musst du dir Zeit <w>dafür</w> nehmen."
                        }
                    ],
                    "common_phrases": [
                        "Geld dafür brauchen",
                        "Zeit dafür nehmen"
                    ]
                },
                {
                    "sense_id": "c98c076f-aa26-3581-836a-a9a1cbf16c31",
                    "sense_definition": "als Ausgleich, Entschädigung oder Gegenleistung für etwas",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Hotelzimmer war recht klein, aber <w>dafür</w> lag es direkt am Strand."
                        },
                        {
                            "text": "Ich habe ihm beim Umzug geholfen und <w>dafür</w> ein leckeres Abendessen bekommen."
                        }
                    ],
                    "common_phrases": [
                        "etwas dafür bekommen",
                        "als Ausgleich dafür"
                    ]
                }
            ]
        }
    ]
