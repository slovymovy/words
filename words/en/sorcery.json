{
    "word_family": [
        "sorcerer",
        "sorceress"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55ff9e00-9502-3dbb-b646-321e2e5a1539",
                    "sense_definition": "The use of magical powers or witchcraft.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old legend tells of a king who gained his throne through dark <w>sorcery</w>.",
                            "target_lang_translations": {
                                "ru": "Старая легенда рассказывает о короле, который получил свой трон с помощью темного <w>колдовства</w>."
                            }
                        },
                        {
                            "text": "Many ancient cultures believed that <w>sorcery</w> could influence the weather and harvest.",
                            "target_lang_translations": {
                                "ru": "Многие древние культуры верили, что <w>магия</w> может влиять на погоду и урожай."
                            }
                        }
                    ],
                    "synonyms": [
                        "magic",
                        "witchcraft",
                        "wizardry"
                    ],
                    "common_phrases": [
                        "practice sorcery",
                        "dark sorcery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование магических сил или колдовство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колдовство́",
                                "target_lang_sense_clarification": "общее понятие магических действий и обрядов"
                            },
                            {
                                "target_lang_word": "ма́гия",
                                "target_lang_sense_clarification": "совокупность обрядов и действий, основанных на вере в сверхъестественные силы"
                            },
                            {
                                "target_lang_word": "волшебство́",
                                "target_lang_sense_clarification": "магическое воздействие, часто в сказочном контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6661dbb-b9ec-3f45-b576-7579814d6b69",
                    "sense_definition": "The practice of black magic.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain was feared for his mastery of <w>sorcery</w> and forbidden rituals.",
                            "target_lang_translations": {
                                "ru": "Злодея боялись из-за его мастерства в <w>чернокнижии</w> и запретных ритуалах."
                            }
                        },
                        {
                            "text": "She studied ancient texts to protect her village from the effects of <w>sorcery</w>.",
                            "target_lang_translations": {
                                "ru": "Она изучала древние тексты, чтобы защитить свою деревню от последствий <w>колдовства</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "black magic",
                        "hexcraft"
                    ],
                    "common_phrases": [
                        "evil sorcery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практика черной магии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернокни́жие",
                                "target_lang_sense_clarification": "занятие черной магией, колдовство с использованием запретных знаний"
                            },
                            {
                                "target_lang_word": "ворожба́",
                                "target_lang_sense_clarification": "устаревшее обозначение колдовства или гадания"
                            },
                            {
                                "target_lang_word": "чароде́йство",
                                "target_lang_sense_clarification": "книжный термин для обозначения магических практик"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}