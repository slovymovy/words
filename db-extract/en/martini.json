                        "sense_id": "46ec405d-d44c-37bc-b6e6-b389163401cf",
                        "entry_id": "df7a88d7-2f60-355c-8d5a-7c45df042259",
                        "glosses": [
                            "Alternative letter-case form of martini (a cocktail made with gin or vodka and vermouth)."
                        ],
                        "tags": [
                            "alt-of",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "38393284-613f-4d54-90b9-a4e8a4877b5b",
                                "sense_id": "46ec405d-d44c-37bc-b6e6-b389163401cf",
                                "text": "Only the priest and Major Hugh Edwards, a blind Englishman, drank Martini or something cheaper in the hot hours after noon and before the clumping sabots announced the working day’s end."
                            },
                            {
                                "example_id": "23149c3b-4ba5-43d6-a080-e14859d6026c",
                                "sense_id": "46ec405d-d44c-37bc-b6e6-b389163401cf",
                                "text": "They would talk while Mrs Costello smoked and drank Martini, and then there would be the sudden, jolting sound of the hoover being switched on."
                            },
                            {
                                "example_id": "50fa43c9-25c8-4dc2-9c04-8b94c748bf71",
                                "sense_id": "46ec405d-d44c-37bc-b6e6-b389163401cf",
                                "text": "My father and mother drank Martini while I had orange juice."
                            }
                        ]
                    },
