                    ]
                },
                {
                    "sense_id": "a2ad166c-ca05-36b5-afdc-e047cd099977",
                    "sense_definition": "Rassembler des unités ou des forces militaires pour une opération.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commandant a ordonné de <w>regrouper</w> les troupes près de la frontière avant la nuit."
