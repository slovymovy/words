                    {
                        "translation_id": "faec81ed-6f9f-4b47-b7b4-9e6843a1fdaf",
                        "source_entry_id": "66b49274-2362-30ed-9782-3c32d4b4df29",
                        "source_sense_id": "cafe6aaa-7f24-3d7b-b264-96c4f5703394",
                        "source_sense_description": "blind pouch connected to the large intestine",
                        "target_lang_word": "Blinddarm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blinddarm",
                                "target_lang_code": "de",
