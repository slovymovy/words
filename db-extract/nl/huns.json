                        ],
                        "examples": [
                            {
                                "example_id": "0cfadc99-27ed-4b1b-b035-d53a23519f86",
                                "sense_id": "ce3eea44-4a73-3e27-8643-d2a3d69e9e86",
                                "text": "Wat wreedheid schijnt is weldaad vaak, ja zeker de jagers hebben eene delicate taak en ze zijn er niet om huns wil."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
