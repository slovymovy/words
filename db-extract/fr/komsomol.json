                "senses": [
                    {
                        "sense_id": "41ff1800-f024-3a20-867c-f542ae6ed917",
                        "entry_id": "52ed52fa-6efb-3f2e-862e-79b1c6d6b2b2",
                        "glosses": [
                            "Membre du Komsomol, organisation de la jeunesse communiste en Union Soviétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce47fc26-625c-4a5a-822f-3364647ab1b9",
                                "sense_id": "41ff1800-f024-3a20-867c-f542ae6ed917",
                                "text": "Olègue, le personnage que je joue, est un mauvais Komsomol, un individualiste qui ose s'affirmer tel. Ce noyau, réfractère à l'unité de la cellule, a bien entendu, tous les défauts. On le moque, on le lapide même. Le pauvre vit à la traîne, un peu en marge, boudeur, renfermé."
                            },
                            {
                                "example_id": "d3bf47e7-66b3-4277-82a8-9389b3df0769",
                                "sense_id": "41ff1800-f024-3a20-867c-f542ae6ed917",
                                "text": "Je suis un komsomol, un communiste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02b1bc73-ea1a-4a1e-af50-e07dea65b459",
                        "source_entry_id": "52ed52fa-6efb-3f2e-862e-79b1c6d6b2b2",
                        "source_sense_id": "41ff1800-f024-3a20-867c-f542ae6ed917",
