                    "sense_id": "ef10599c-c653-3c4b-b343-85c2d9633d99",
                    "sense_definition": "Chacun des personnages venus d'Orient pour rendre hommage et apporter des présents à l'enfant Jésus.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La tradition chrétienne raconte que les rois <w>mages</w> ont suivi une étoile brillante."
                        },
                        {
                            "text": "À l'Épiphanie, les enfants célèbrent la visite des trois <w>mages</w> à Bethléem."
                        }
                    ],
                    "common_phrases": [
