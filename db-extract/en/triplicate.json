                        "sense_id": "464d5b83-a27d-3260-b5b6-b720fe392363",
                        "entry_id": "e3e7da23-b7ab-3d4d-be2f-65654d2b5cf6",
                        "glosses": [
                            "Each of a set of three identical objects or copies."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ce1f96bd-5fa3-4cd3-9457-26fe96edd04c",
                                "sense_id": "464d5b83-a27d-3260-b5b6-b720fe392363",
                                "text": "Among the six bottles, three of them were pumped every 30 minutes and the three others every 60 minutes. This provided a triplicate of each condition (30 or 60 minutes idle time between pumping)."
                            }
                        ]
                    }
