{
    "word_family": [
        "полисный",
        "полицейский"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4469e351-fae2-33e5-a4e3-3be61a25becb",
                    "sense_definition": "Официальный документ, подтверждающий договор страхования между страховой компанией и клиентом.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "insurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для получения визы необходимо оформить медицинский страховой <w>полис</w>.",
                            "target_lang_translations": {
                                "en": "To obtain a visa, you must take out a medical insurance <w>policy</w>."
                            }
                        },
                        {
                            "text": "Страховой <w>полис</w> гарантирует возмещение ущерба при наступлении страхового случая.",
                            "target_lang_translations": {
                                "en": "An insurance <w>policy</w> guarantees compensation for damages in the event of an insured incident."
                            }
                        }
                    ],
                    "synonyms": [
                        "страховка"
                    ],
                    "common_phrases": [
                        "страховой полис",
                        "оформить полис"
                    ],
                    "target_lang_definitions": {
                        "en": "An official document confirming an insurance contract between an insurance company and a client."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "insurance policy",
                                "target_lang_sense_clarification": "The specific document certifying an insurance contract."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24b47d41-7402-3405-b934-cee1e93ccf3d",
                    "sense_definition": "То же, что страховой полис.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "insurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Внимательно прочитайте условия, указанные в вашем <w>полисе</w>.",
                            "target_lang_translations": {
                                "en": "Read the terms and conditions stated in your <w>policy</w> carefully."
                            }
                        },
                        {
                            "text": "Срок действия этого <w>полиса</w> истекает в конце года.",
                            "target_lang_translations": {
                                "en": "The validity period of this <w>policy</w> expires at the end of the year."
                            }
                        }
                    ],
                    "synonyms": [
                        "страховка"
                    ],
                    "common_phrases": [
                        "номер полиса"
                    ],
                    "target_lang_definitions": {
                        "en": "Same as an insurance policy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "policy",
                                "target_lang_sense_clarification": "Shortened form referring to an insurance contract document."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19431f26-49f0-3c17-a743-59bdeb1b11e1",
                    "sense_definition": "Город-государство в Древней Греции и Италии, представляющий собой особую форму социально-политической организации.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Афинский <w>полис</w> считается колыбелью античной демократии.",
                            "target_lang_translations": {
                                "en": "The Athenian <w>polis</w> is considered the cradle of ancient democracy."
                            }
                        },
                        {
                            "text": "Граждане принимали активное участие в управлении своим <w>полисом</w>.",
                            "target_lang_translations": {
                                "en": "Citizens took an active part in the governance of their <w>polis</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A city-state in Ancient Greece and Italy, representing a specific form of socio-political organization."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "polis",
                                "target_lang_sense_clarification": "Historical term for an ancient Greek city-state."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f6947ec-3c18-31aa-8d9f-cf5e5835ef14",
                    "sense_definition": "То же, что полис (город-государство).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждый <w>полис</w> имел свои законы и систему управления.",
                            "target_lang_translations": {
                                "en": "Each <w>polis</w> had its own laws and system of government."
                            }
                        },
                        {
                            "text": "Экономика <w>полиса</w> основывалась на труде свободных граждан и рабов.",
                            "target_lang_translations": {
                                "en": "The economy of the <w>polis</w> was based on the labor of free citizens and slaves."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Same as polis (city-state)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "polis",
                                "target_lang_sense_clarification": "Historical term for an ancient Greek city-state."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4bb43093-65d6-3f31-a067-4df467105e96",
                    "sense_definition": "Органы охраны правопорядка, полиция.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "law_enforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На место происшествия оперативно прибыла местная <w>полис</w>.",
                            "target_lang_translations": {
                                "en": "The local <w>police</w> arrived promptly at the scene of the incident."
                            }
                        },
                        {
                            "text": "Граждане обратились в <w>полис</w> за помощью после ограбления.",
                            "target_lang_translations": {
                                "en": "Citizens turned to the <w>police</w> for help after the robbery."
                            }
                        }
                    ],
                    "synonyms": [
                        "полиция",
                        "милиция"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Устаревшее или просторечное употребление в значении полиция."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Law enforcement agencies, police."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "police",
                                "target_lang_sense_clarification": "Colloquial or non-standard usage in Russian; refers to the police force."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "854fb5ef-4193-3bb9-9944-501de037454e",
                    "sense_definition": "Отделение милиции или сотрудники правоохранительных органов.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "law_enforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нам пришлось идти в <w>полис</w>, чтобы написать заявление.",
                            "target_lang_translations": {
                                "en": "We had to go to the <w>police station</w> to file a report."
                            }
                        },
                        {
                            "text": "Всю ночь в <w>полисе</w> горел свет.",
                            "target_lang_translations": {
                                "en": "The lights were on in the <w>police station</w> all night."
                            }
                        }
                    ],
                    "synonyms": [
                        "отделение"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Региональное или устаревшее просторечие."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A police station or law enforcement officers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "police station",
                                "target_lang_sense_clarification": "The building or office of the police."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2a3c000-3d46-3033-86a2-325c07a00e9c",
                    "sense_definition": "Пост дорожной инспекции.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "law_enforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Машину остановили на ближайшем <w>полисе</w> для проверки документов.",
                            "target_lang_translations": {
                                "en": "The car was stopped at the nearest <w>checkpoint</w> for a document check."
                            }
                        },
                        {
                            "text": "Водитель притормозил перед <w>полисом</w> на трассе.",
                            "target_lang_translations": {
                                "en": "The driver slowed down before the <w>checkpoint</w> on the highway."
                            }
                        }
                    ],
                    "synonyms": [
                        "пост"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Жаргонное употребление."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A traffic police checkpoint."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "checkpoint",
                                "target_lang_sense_clarification": "A location where traffic is stopped for inspection."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}