                        "target_lang_word": "Sprung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8c38938-a105-3c4a-8f8f-e55ac264f08c",
                                        "entry_id": "9ca21914-5193-3a27-82fa-b0b26d80bc67",
                                        "glosses": [
                                            "feiner Riss in einem festen Material"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62af5dd0-8b81-4849-83fe-46d8d5d3a71c",
                                                "sense_id": "b8c38938-a105-3c4a-8f8f-e55ac264f08c",
                                                "text": "Diese Wand hat einen gefährlichen Sprung."
                                            },
                                            {
                                                "example_id": "9a7c3721-d306-4633-ad98-45fe4946ff52",
                                                "sense_id": "b8c38938-a105-3c4a-8f8f-e55ac264f08c",
                                                "text": "Die Teetasse hat einen Sprung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a8ca668-b14f-3064-a0e2-bd85bf70b0cf",
                                        "entry_id": "9ca21914-5193-3a27-82fa-b0b26d80bc67",
                                        "glosses": [
                                            "Bewegung eines Lebewesens durch die Luft durch Abspringen mit dem Bein/den Beinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4226450-7989-4409-adfe-ecfbb745f8cd",
                                                "sense_id": "4a8ca668-b14f-3064-a0e2-bd85bf70b0cf",
                                                "text": "Er machte einen großen Sprung über die Schlucht."
                                            },
                                            {
                                                "example_id": "262f9a11-ef11-4ac5-a5a7-8c95f258de10",
                                                "sense_id": "4a8ca668-b14f-3064-a0e2-bd85bf70b0cf",
                                                "text": "„Der machte ein paar lange Sprünge ans Mikrofon.“"
                                            },
                                            {
                                                "example_id": "0b55830c-9090-40e2-9e73-b3e53304249e",
                                                "sense_id": "4a8ca668-b14f-3064-a0e2-bd85bf70b0cf",
                                                "text": "„Mit ihrem Sprung am Gummiseil war das Bungee-Jumping in Neuseeland geboren und verbreitete sich wie ein Lauffeuer auf der ganzen Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e1deb8ef-e27c-3399-b164-315bd84a93ed",
                                        "entry_id": "9ca21914-5193-3a27-82fa-b0b26d80bc67",
                                        "glosses": [
                                            "eine Übung in einer bestimmten Disziplin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "795c3d55-a590-4b8d-ab01-01faf058c511",
                                                "sense_id": "e1deb8ef-e27c-3399-b164-315bd84a93ed",
                                                "text": "Seine Beinmuskulatur ist sehr gut, weshalb jeder seiner Sprünge exzellent ist."
                                            },
                                            {
                                                "example_id": "a4f9086a-87b3-4394-aa37-3569a1ea9137",
                                                "sense_id": "e1deb8ef-e27c-3399-b164-315bd84a93ed",
                                                "text": "Beim nächsten Sprung wird sie ganz sicher die 100-m-Marke passieren."
                                            },
                                            {
                                                "example_id": "4a1c0b4b-1f05-400a-82cb-d330a2c3b8cd",
                                                "sense_id": "e1deb8ef-e27c-3399-b164-315bd84a93ed",
                                                "text": "„Sie tanzt einen akrobatischen Tanz, mit Saltos, Handständen und hohen Sprüngen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c755bd08-069d-3389-a2a2-c2285e486bb0",
                                        "entry_id": "9ca21914-5193-3a27-82fa-b0b26d80bc67",
                                        "glosses": [
                                            "plötzliche Änderung oder deutlicher Unterschied, der durch Unterbrechung der Kontinuität entstanden ist"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8764550-9d65-43a1-b4cc-3e595b0962d7",
                                                "sense_id": "c755bd08-069d-3389-a2a2-c2285e486bb0",
                                                "text": "Hörst du das? Die Platte hat einen Sprung."
                                            },
                                            {
                                                "example_id": "1a129837-799e-4a72-992a-c39b370d1449",
                                                "sense_id": "c755bd08-069d-3389-a2a2-c2285e486bb0",
                                                "text": "Machen wir nun einen Sprung in das vergangene Jahrhundert."
                                            },
                                            {
                                                "example_id": "a66799ec-cd0e-48a4-8fc5-cbaf75470354",
                                                "sense_id": "c755bd08-069d-3389-a2a2-c2285e486bb0",
                                                "text": "„Zwischen dem 2. und 3. Lebensjahr macht die Sprachentwicklung einen besonders großen Sprung.“"
                                            },
                                            {
                                                "example_id": "fe96fe69-2977-43a8-b1f4-9111c13804f4",
                                                "sense_id": "c755bd08-069d-3389-a2a2-c2285e486bb0",
                                                "text": "Am Ende des Buches, in der letzten, der 15. Geschichte gibt es einen Sprung ins 7. Jahrhundert zur einzigen chinesischen Kaiserin, Wu Zetian."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "18eae870-34a2-3339-81c7-fb661a0bbf20",
                                        "entry_id": "9ca21914-5193-3a27-82fa-b0b26d80bc67",
                                        "glosses": [
                                            "drückt in adverbieller Verwendung Zeitknappheit oder Nähe aus"
                                        ],
                                        "tags": [
                                            "in einigen festen Wortverbindungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "588531c6-a33e-4c33-8e35-41c4f49ed486",
                                                "sense_id": "18eae870-34a2-3339-81c7-fb661a0bbf20",
                                                "text": "Kannst du morgen auf einen Sprung zu mir kommen?"
                                            },
                                            {
                                                "example_id": "cea91d11-6057-4094-a812-73d3e8f2bd36",
                                                "sense_id": "18eae870-34a2-3339-81c7-fb661a0bbf20",
                                                "text": "Ich habe gerade gar keine Zeit, ich bin auf dem Sprung in die Uni."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "bc92cc1d-ecc3-3fa7-8fd7-e352340b10d0",
                                        "entry_id": "9ca21914-5193-3a27-82fa-b0b26d80bc67",
                                        "glosses": [
                                            "eine Verwerfung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82b5775a-5475-463f-a72e-07931c33a384",
                                                "sense_id": "bc92cc1d-ecc3-3fa7-8fd7-e352340b10d0",
                                                "text": "Der Mittelsprung im Luxemburgischen und in Deutsch-Lothringen folgt dem Other Sprung in einer Entfernung von etwa 2 km fast parallel."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "3c713d28-5323-3fde-8db4-6b958a68b1a8",
                                        "entry_id": "9ca21914-5193-3a27-82fa-b0b26d80bc67",
