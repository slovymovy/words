                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e51d8005-ad42-4a9e-807a-03f952ce117b",
                                "sense_id": "0bc51250-6e65-3b1e-b0b8-e58828555b97",
                                "text": "Turners and Cutlers, if I mistake not the matter, doe call this wood Dudgeon, wherewith they make Dudgeon hafted daggers."
                            }
                        ]
                    },
                    {
                        "sense_id": "790badff-6611-37b3-86f6-a724d2f38323",
                        "entry_id": "ca516aeb-8109-3ac8-8d64-0462d3e08c2f",
                        "glosses": [
                            "A hilt made of this wood."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "149ec1fc-627c-4409-a643-9ea99ee8f4c9",
                                "sense_id": "790badff-6611-37b3-86f6-a724d2f38323",
                                "text": "And on thy blade and dudgeon gouts of blood"
                            }
                        ]
                    },
                    {
                        "sense_id": "11cd1f1c-b7cf-3ad3-a7e7-4c3381d47b06",
                        "entry_id": "ca516aeb-8109-3ac8-8d64-0462d3e08c2f",
                        "glosses": [
                            "A dagger which has a dudgeon hilt."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64299180-0242-442f-93b3-720861640821",
                        "source_entry_id": "ca516aeb-8109-3ac8-8d64-0462d3e08c2f",
                        "source_sense_description": "wood of the box tree",
                        "target_lang_word": "Buchsbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchsbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85f4fcde-5ccd-31ac-9636-25cedeacc433",
                                        "entry_id": "fc1821ea-ad3d-3147-916a-0a127e45280b",
                                        "glosses": [
                                            "immergrünes Zier- und Nutzgehölz (Buxus sempervirens) aus der Familie der Buchsbaumgewächse (Buxaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f595887-9029-45c3-abca-7847419005e7",
                                                "sense_id": "85f4fcde-5ccd-31ac-9636-25cedeacc433",
                                                "text": "Der Buchsbaum gehört zu den beliebtesten Gestaltungselementen."
                                            },
                                            {
                                                "example_id": "aa00f905-3ed7-4c8c-bfcf-3c60b930a39f",
                                                "sense_id": "85f4fcde-5ccd-31ac-9636-25cedeacc433",
                                                "text": "Im Garten dient der Buchsbaum auch als Begrenzung zum Nachbarn."
                                            },
                                            {
                                                "example_id": "1cfafb50-a8ce-4df1-9d5d-6fb7ddd27501",
                                                "sense_id": "85f4fcde-5ccd-31ac-9636-25cedeacc433",
                                                "text": "„Die dicht vor dem Salon gelegene Gartenanlage bestand aus einem Rondeel mit Sonnenuhr, um das herum, in meist dreieckigen und von Buchsbaum eingefaßten Beeten, allerlei Sommerblumen blühten: Reseda und Rittersporn und Lilien und Levkojen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a253267f-cfb1-3ec2-9183-0d8328ece428",
                                        "entry_id": "fc1821ea-ad3d-3147-916a-0a127e45280b",
                                        "glosses": [
                                            "Hartholz von [1]"
                                        ],
                                        "tags": [
                                            "Holzverarbeitung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6069ebd5-9ca9-435b-80db-89be3035fac4",
                                                "sense_id": "a253267f-cfb1-3ec2-9183-0d8328ece428",
                                                "text": "Als langsam wachsendes Holz ist Buchsbaum sehr wertvoll."
                                            },
                                            {
                                                "example_id": "60ce0430-bc1c-4c9f-94b7-2ff3143cac95",
                                                "sense_id": "a253267f-cfb1-3ec2-9183-0d8328ece428",
                                                "text": "Aus Buchsbaum werden hochwertige Schachfiguren gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
