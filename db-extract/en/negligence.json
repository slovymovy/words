                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "0fc6ac3d-b845-437b-a6d7-306490fb0b9a",
                                "sense_id": "1935a1d1-625c-3f63-90df-1738be57e51f",
                                "text": "negligence while driving"
                            },
                            {
                                "example_id": "f1ae1a9d-a15b-4ec3-a96a-4cc14e47149c",
                                "sense_id": "1935a1d1-625c-3f63-90df-1738be57e51f",
                                "text": "The Woodwalton signalman, Rose, who was severely censured in Captain Tyler's report, behaved with great negligence."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf7de9d4-f629-3c22-bfe3-0daee8f29b59",
                        "entry_id": "6b8ba047-5b8f-3602-aa65-8016019a0a0e",
                        "glosses": [
                            "The tort whereby a duty of reasonable care was breached, causing damage: any conduct short of intentional or reckless action that falls below the legal standard for preventing unreasonable injury."
                        ],
                        "tags": [
                            "singular",
                            "singular-only",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a2391426-0d6d-36a5-ac40-9cb8cbcbeef8",
                        "entry_id": "6b8ba047-5b8f-3602-aa65-8016019a0a0e",
                        "glosses": [
                            "The breach of a duty of care: the failure to exercise a standard of care that a reasonable person would have in a similar situation."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e629ca2-e237-4a77-8e1d-8f88ab79e606",
                        "source_entry_id": "6b8ba047-5b8f-3602-aa65-8016019a0a0e",
                        "source_sense_description": "state of being negligent",
                        "target_lang_word": "Nachlässigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachlässigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                        "entry_id": "2e38d0bf-628c-3271-a3b9-39eeedf6ca37",
                                        "glosses": [
                                            "kritisierbares Handeln, das darin besteht, dass etwas nicht in der an sich erforderlichen Weise getan wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13a2f0a0-58d5-4c91-bdbf-90afe75fcb6f",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Es wäre eine Nachlässigkeit von mir, den Hügel nicht zu erwähnen, der sich auf der Grenze zwischen dem Moorgelände und der Hauswiese befindet.“"
                                            },
                                            {
                                                "example_id": "3e20e9f0-c18e-4bf6-bb4d-350307f8b930",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Evolutionsbiologen erläutern diese Nachlässigkeit der Natur gerne mit dem Beispiel unserer Autos.“"
                                            },
                                            {
                                                "example_id": "589906a1-7b40-4b2a-8277-bf2e08dfd7d7",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Elaine fragt sich, ob eine derartige Nachlässigkeit in der Zeichensetzung ein Hinweis auf ein fehlendes emotionales Interesse an ihrem Leben sein könnte (obwohl sie ihrem Freund davon nichts erzählt.“"
                                            },
                                            {
                                                "example_id": "b5bfa3b5-53bb-4d26-a476-82b2de56b806",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Germaine war nicht fortgegangen, und Gorju kam ab und zu, um den Garten umzugraben; denn aus Nachlässigkeit, aus Gleichgültigkeit gegen die materiellen Dinge hatten sie nachgegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33c9a39e-71ef-4980-b473-48917b99c538",
                        "source_entry_id": "6b8ba047-5b8f-3602-aa65-8016019a0a0e",
                        "source_sense_description": "state of being negligent",
                        "target_lang_word": "Unachtsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unachtsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                                        "entry_id": "97ce76f5-fd05-37d5-ba4a-d5433f8b38dd",
                                        "glosses": [
                                            "Handlung mit mangelnder Sorgfalt, auch deren Ursache und Ergebnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf44aae1-e653-4f80-8de5-04f588ea896d",
                                                "sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                                                "text": "„Grund für den Unfall war eine Unachtsamkeit des Fahrers, teilen nun Staatsanwaltschaft und Polizei mit.“"
                                            },
                                            {
                                                "example_id": "9e2c6509-1a0d-42ba-8905-e2ebd9ed4d36",
                                                "sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                                                "text": "„Jede Art von Unachtsamkeit kann die Ursache für Unglücke, Missgeschicke, falsche Lebensführung, Verletzung und Missachtung von Regeln und Gesetzen werden.“"
                                            },
                                            {
                                                "example_id": "554599d0-fe71-4748-9ef3-70d0495a3c60",
                                                "sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                                                "text": "„Schon die Unachtsamkeit eines einzigen Mannes beim Pfeiferauchen konnte einen Brand auslösen, von dem Übermut der Siegesfeiern, bei denen sich Wodka und französischer Wein mischten, ganz zu schweigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
