                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf896244-6383-4e0b-a4ea-ef82e3a5d51f",
                                "sense_id": "eeca050e-fedd-30a2-bde3-76910b87e629",
                                "text": "Attention, on est en train de se footballiser !"
                            },
                            {
                                "example_id": "fda98bed-660f-41fd-8215-736bb99f1290",
                                "sense_id": "eeca050e-fedd-30a2-bde3-76910b87e629",
                                "text": "Un dénommé \"Majupra\" a eu l'idée amusante de \"footballiser\" les maillots des franchises NHL, la Ligue Nord Américaine de hockey sur glace."
                            },
                            {
                                "example_id": "a133fe40-bb05-4779-b705-2f1f70f05464",
                                "sense_id": "eeca050e-fedd-30a2-bde3-76910b87e629",
                                "text": "Maintenant on va footballiser la politique."
                            },
