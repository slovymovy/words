        "fr-extract.jsonl": [
            {
                "entry_id": "b42db186-9123-3f44-b628-16965fce7661",
                "word": "substitution",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3f728ada-b0f6-4467-8653-3c89cde602f2",
                        "entry_id": "b42db186-9123-3f44-b628-16965fce7661",
                        "tags": [
                            "plural"
                        ],
                        "form": "substitutions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b66b439-a8af-377e-a4e5-1ac48e4617fb",
                        "entry_id": "b42db186-9123-3f44-b628-16965fce7661",
                        "glosses": [
                            "Action de substituer, de remplacer une personne ou une chose à la place d’une autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b7cbf7-d067-46d4-8747-be968ae68dec",
                                "sense_id": "3b66b439-a8af-377e-a4e5-1ac48e4617fb",
                                "text": "La veulerie des hommes de ce temps fut si grande que parfois la substitution du nouveau personnel à l'ancien prenait des allures bouffonnes."
                            },
                            {
                                "example_id": "2affa4bd-e736-4a83-bd5d-bd80d6af5838",
                                "sense_id": "3b66b439-a8af-377e-a4e5-1ac48e4617fb",
                                "text": "Ensuite celle-là n'est qu'une substitution de termes, car entre l’innéité et la primordialité, il n'y a pas de différence pratique, et les adversaires de l'une sont nécessairement ceux de l'autre aussi."
                            },
                            {
                                "example_id": "06187e96-4eec-42b7-8a82-969955042dbd",
                                "sense_id": "3b66b439-a8af-377e-a4e5-1ac48e4617fb",
                                "text": "Il n'en demeure pas moins que la substitution des archives judiciaires aux archives notariales amène un changement de tonalité dans l'éclairage : à une vision « lisse » se substitue une vision « rugueuse » des relations sociales."
                            }
                        ]
                    },
                    {
                        "sense_id": "1aadf179-1769-3ab0-be50-26e7b385b209",
                        "entry_id": "b42db186-9123-3f44-b628-16965fce7661",
                        "glosses": [
                            "Remplacement d’un atome ou d'un radical par un autre dans une molécule."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5673c88b-7ebd-461e-bcb4-cb8bc1511084",
                                "sense_id": "1aadf179-1769-3ab0-be50-26e7b385b209",
                                "text": "Le formène est surtout intéressant par les dérivés de substitution qu'il forme avec les halogènes Cl, Br, I."
                            }
                        ]
                    },
                    {
                        "sense_id": "49e65d6f-9174-3521-9533-75a24fcc95db",
                        "entry_id": "b42db186-9123-3f44-b628-16965fce7661",
                        "glosses": [
                            "Disposition par laquelle on appelle à sa succession un ou plusieurs héritiers successivement, après celui qu’on a institué, de manière que celui-ci ne peut aliéner les biens sujets à la substitution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74f113a-1609-4e79-b2b2-39bc54591822",
                                "sense_id": "49e65d6f-9174-3521-9533-75a24fcc95db",
                                "text": "Dans le même souci de protection du lignage, le père pouvait cependant, s'il se méfiait de ses enfants, les obliger à conserver le patrimoine pour leurs propres enfants : c'est la substitution si répandue dans notre ancien régime."
                            },
                            {
                                "example_id": "0de83937-3517-4a34-ad29-94c75a27289e",
                                "sense_id": "49e65d6f-9174-3521-9533-75a24fcc95db",
                                "text": "Extrêmement fréquent suivant les pratiques nobles est en Forez aux XVIIᵉ et XVIIIᵉ siècles l’usage des substitutions, qui prolonge une tradition bien ancrée dès la période médiévale."
                            }
                        ]
                    }
                ],
