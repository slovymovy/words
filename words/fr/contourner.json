                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les automobilistes ont dû <w>contourner</w> le centre-ville à cause des travaux sur la route principale."
                        },
                        {
                            "text": "Le sentier de randonnée permet de <w>contourner</w> un obstacle rocheux sans prendre le moindre risque."
                        }
                    ],
                    "synonyms": [
