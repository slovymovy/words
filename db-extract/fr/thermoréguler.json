                "senses": [
                    {
                        "sense_id": "fae6f1a9-1acd-3f3f-8760-a10b468bde76",
                        "entry_id": "1def2986-f71b-3233-b0a0-d3db6d684e11",
                        "glosses": [
                            "Assurer la thermorégulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68799904-1793-4f37-a3ac-bd5bb8fb2eb4",
                                "sense_id": "fae6f1a9-1acd-3f3f-8760-a10b468bde76",
                                "text": "Il y a l’égrappage, un léger foulage, puis on presse les grains et le jus est placé dans ces cuves en inox, qui sont thermorégulées."
                            },
                            {
                                "example_id": "b4641dd8-bcbc-498d-b64c-b91fd9040a8d",
                                "sense_id": "fae6f1a9-1acd-3f3f-8760-a10b468bde76",
                                "text": "En résumé, dans des conditions de neutralité thermique ou d’ambiance modérément chaude, l’enfant thermorégule aussi bien que l’adulte, bien qu’il utilise des stratégies différentes."
                            }
                        ]
                    }
