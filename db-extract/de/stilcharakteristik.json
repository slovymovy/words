                ],
                "senses": [
                    {
                        "sense_id": "ab2364a1-aa9c-3841-bd77-925864469176",
                        "entry_id": "dae3c29c-d5c0-3948-9677-19d5bc3a75fd",
                        "glosses": [
                            "Erfassung, Beschreibung der (typischen) Eigenschaften eines Stils"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2b5e77a-9ac7-430f-b09e-8762e37fc077",
                                "sense_id": "ab2364a1-aa9c-3841-bd77-925864469176",
                                "text": "„Die \"Grundbegriffe\" sind hervorgegangen aus dem Bedürfnis, der kunsthistorischen Charakteristik eine festere Basis zu geben; nicht dem Werturteil - davon ist hier gar nicht die Rede -, sondern der Stilcharakteristik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0afe31dd-537b-3ed6-9d0c-67b354974a7d",
                        "entry_id": "dae3c29c-d5c0-3948-9677-19d5bc3a75fd",
                        "glosses": [
                            "zahlenmäßig erfasste Stileigenschaft"
                        ],
                        "tags": [
                            "Quantitative Stilistik"
                        ],
                        "examples": [
                            {
                                "example_id": "aba35e14-4f1a-4687-b242-862f6b10eb5a",
                                "sense_id": "0afe31dd-537b-3ed6-9d0c-67b354974a7d",
                                "text": "„Fucks untersucht insbesondere Stilcharakteristiken, die sich aus den Silben des Textes ergeben: die mittlere Silbenzahl pro Wort und eine daraus zu berechnende Größe, die »Textentropie« genannt wird.“"
                            },
                            {
                                "example_id": "9487d3db-22c2-4b22-bb99-8cf1903ce59d",
                                "sense_id": "0afe31dd-537b-3ed6-9d0c-67b354974a7d",
                                "text": "„Stark verschiedene Zahlenwerte werden wir für unsere Stilcharakteristiken erwarten, wenn wir Werke untersuchen, von denen man bereits weiß, daß ihr Stil sehr verschieden ist.“"
                            },
                            {
                                "example_id": "9f4cc7d4-4393-4aed-8c2f-799565012db6",
                                "sense_id": "0afe31dd-537b-3ed6-9d0c-67b354974a7d",
                                "text": "„Inzwischen wurden verschiedene Methoden entwickelt, mit denen sprach-, gattungs-, epochen-, autor- und werkspezifische Stilcharakteristiken ermittelt werden können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
