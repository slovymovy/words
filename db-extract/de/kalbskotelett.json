                "senses": [
                    {
                        "sense_id": "97513a27-d19d-3167-8cb7-b51204449946",
                        "entry_id": "8262842b-6f47-3d3e-a913-efb0f2227625",
                        "glosses": [
                            "Kotelett aus Kalbsfleisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb44b434-2611-419c-ba92-22e6f9294bd5",
                                "sense_id": "97513a27-d19d-3167-8cb7-b51204449946",
                                "text": "„Und hätte man Mr. Lawrence nicht am Tag zuvor in einem Supermarkt in Bolton Hill beim Klauen von ein paar Kalbskoteletts erwischt, wäre sein Name auch nicht mit einem im Polizeicomputer von Baltimore registrierten Verbrechen in Zusammenhang gebracht worden.“"
                            },
                            {
                                "example_id": "05b85379-0dcc-46ff-89f0-54320164359e",
                                "sense_id": "97513a27-d19d-3167-8cb7-b51204449946",
                                "text": "„Dann verschafften sie sich alte Sardinenbüchsen, taten Kalbskoteletts hinein und legten sie in ein Wasserbad.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
