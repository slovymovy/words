    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "71765517-de1e-395c-910b-517d37c9af7f",
                    "sense_definition": "odczuwający żal z powodu popełnionych błędów lub złych uczynków",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chłopiec wyglądał na bardzo <w>skruszonego</w> po tym, jak przyznał się do zniszczenia wazonu.",
                            "target_lang_translations": {
                                "ru": "Мальчик выглядел очень <w>раскаявшимся</w> после того, как признался в том, что разбил вазу."
                            }
                        },
                        {
                            "text": "Przyszedł do nas <w>skruszony</w> i szczerze przeprosił za swoje wcześniejsze zachowanie.",
                            "target_lang_translations": {
                                "ru": "Он пришел к нам <w>раскаявшимся</w> и искренне извинился за свое прежнее поведение."
                            }
                        }
                    ],
                    "synonyms": [
                        "skruszony",
                        "żałujący",
                        "przepraszający"
                    ],
                    "antonyms": [
                        "bezwstydny",
                        "nieugięty"
                    ],
                    "common_phrases": [
                        "wyglądać na skruszonego",
                        "być szczerze skruszonym"
                    ],
                    "target_lang_definitions": {
                        "ru": "испытывающий раскаяние или сожаление о совершенных ошибках или плохих поступках"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскаявшийся",
                                "target_lang_sense_clarification": "человек, который осознал свою вину и сожалеет о ней"
                            },
                            {
                                "target_lang_word": "сокрушенный",
                                "target_lang_sense_clarification": "выражающий глубокое огорчение или раскаяние"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d5ae3da7-c705-30a8-b3c3-8a3eb88cafc8",
                    "sense_definition": "imiesłów przymiotnikowy bierny od czasownika <w>skruszyć</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kamień został <w>skruszony</w> na drobne kawałki przez ciężką maszynę.",
                            "target_lang_translations": {
                                "ru": "Камень был <w>раздроблен</w> на мелкие куски тяжелой машиной."
                            }
                        },
                        {
                            "text": "Lód na jeziorze został <w>skruszony</w> przez lodołamacz.",
                            "target_lang_translations": {
                                "ru": "Лед на озере был <w>раздроблен</w> ледоколом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zostać skruszonym"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forma gramatyczna"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "раздробленный на мелкие части, измельченный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздробленный",
                                "target_lang_sense_clarification": "разделенный на мелкие куски"
                            },
                            {
                                "target_lang_word": "измельченный",
                                "target_lang_sense_clarification": "превращенный в мелкую массу или крошку"
