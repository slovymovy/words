                "senses": [
                    {
                        "sense_id": "016df46d-b022-3ea4-98c5-28aefe73be4f",
                        "entry_id": "2c32f283-88e3-3825-9415-d6055654ba88",
                        "glosses": [
                            "heen en weer bewegen bij staan of zitten"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "3820c387-a601-4254-b6f0-6870309a461b",
                                "sense_id": "016df46d-b022-3ea4-98c5-28aefe73be4f",
                                "text": "Het onrustige kind wiebelde de hele dag op haar stoel."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5551b14-4367-3369-84e7-f872f0b70c04",
                        "entry_id": "2c32f283-88e3-3825-9415-d6055654ba88",
                        "glosses": [
                            "onzeker staan"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "77b96ec9-1f16-419e-a359-36832743d52b",
                                "sense_id": "d5551b14-4367-3369-84e7-f872f0b70c04",
                                "text": "De vaas wiebelde en viel in stukken op de grond."
                            },
                            {
                                "example_id": "20c18f98-4170-41fe-bd08-5153b9c82b98",
                                "sense_id": "d5551b14-4367-3369-84e7-f872f0b70c04",
                                "text": "Die op elkaar gepakte suikerdoosjes van huizen in Trovill, die wiebelden als je de deur dichtsloeg en waar ze geen eigen water hadden, stelden niets voor."
                            }
                        ]
                    }
                ],
