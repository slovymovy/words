                ],
                "senses": [
                    {
                        "sense_id": "f39fe579-2c84-30b0-bbf9-8f0b6f32c51a",
                        "entry_id": "0c910a2b-6f71-3484-b2de-00816618ff63",
                        "glosses": [
                            "dreiteiliges Bild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5eeb008-cf63-43ea-8ebb-cf9c3c07176c",
                                "sense_id": "f39fe579-2c84-30b0-bbf9-8f0b6f32c51a",
                                "text": "Das Triptychon hatte die meiste Aufmerksamkeit."
                            },
                            {
                                "example_id": "69c186d7-c9b1-49f4-b63e-95a5d7898a85",
                                "sense_id": "f39fe579-2c84-30b0-bbf9-8f0b6f32c51a",
                                "text": "„An zwei gegenüberliegenden Wänden hingen Triptychen mit Frauenköpfen.“"
                            },
                            {
                                "example_id": "4a497cea-42c2-48f0-8d61-aa5abc3bf675",
                                "sense_id": "f39fe579-2c84-30b0-bbf9-8f0b6f32c51a",
                                "text": "„So sieht der Teufelspakt auf einem Seitenflügel vom »Garten der Lüste« aus, einem um 1500 entstandenen Triptychon des Hieronymus Bosch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "375605a1-109f-41ad-ac56-9222e5c387e2",
                        "source_entry_id": "0c910a2b-6f71-3484-b2de-00816618ff63",
                        "source_sense_id": "f39fe579-2c84-30b0-bbf9-8f0b6f32c51a",
                        "source_sense_description": "dreiteiliges Bild",
                        "target_lang_word": "triptych",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "triptych",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2365ee8-b14c-3dbc-92ac-9f675e870f8d",
                                        "entry_id": "72462371-1732-3441-b8f2-386084edcd43",
                                        "glosses": [
                                            "A picture or series of pictures painted on three tablets connected by hinges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32bf6257-380f-4eeb-b5c1-1c29f22189c3",
                                                "sense_id": "f2365ee8-b14c-3dbc-92ac-9f675e870f8d",
                                                "text": "I never thought breastfeeding would be hard. When I thought about it at all, my mind conjured beatific scenes suffused with a sort of religious glow. […] These days I envisage more of a triptych: the infant Jesus spluttering at the breast, face purple with hangry fury; the infant Jesus possetting milk down Mary’s front; the infant Jesus and the nappy explosion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2cfd6ab-28cb-365f-94a2-ac6d63955a82",
                                        "entry_id": "72462371-1732-3441-b8f2-386084edcd43",
                                        "glosses": [
                                            "A group of three people or works, especially when considered representative of a particular field or theme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbf3528e-5657-4297-9722-d09db04d4aee",
                                                "sense_id": "b2cfd6ab-28cb-365f-94a2-ac6d63955a82",
                                                "text": "Thus, with the passing years, Papa Wemba, a hardworking and introverted man, has come to embody “African pop,” forming a triptych with Youssou N’Dour and Salif Keita."
                                            },
                                            {
                                                "example_id": "d15565d2-3792-4e87-9dcd-02f8574069e5",
                                                "sense_id": "b2cfd6ab-28cb-365f-94a2-ac6d63955a82",
                                                "text": "Woodson, the recipient of four Newbery Honor awards, has written her first adult novel in 20 years, returning to the Brooklyn setting of “Autobiography of a Family Photo” (1995) and her recent award-winning memoir, “Brown Girl Dreaming.” These works form a triptych of bildungsromans taking place in the author’s hometown and tracking her generation’s coming to adulthood."
                                            },
                                            {
                                                "example_id": "e3efd865-32fd-4bf2-9931-830fb63790ec",
                                                "sense_id": "b2cfd6ab-28cb-365f-94a2-ac6d63955a82",
                                                "text": "The show was the first in a triptych of excellent Australian dramas produced by John Edwards that tapped into the sensibility of a generation. It was followed by the thirtysomething drama, Love My Way, and Tangle, which focused on fortysomethings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acc05112-8918-38a3-9a1b-4185457a5c4b",
                                        "entry_id": "72462371-1732-3441-b8f2-386084edcd43",
                                        "glosses": [
                                            "A group of three people or works, especially when considered representative of a particular field or theme.",
                                            "A film or video sequence intended to be shown on a triple screen with the use of linked projectors."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9c515cf-765f-4435-916a-db4115d07bf8",
                                                "sense_id": "acc05112-8918-38a3-9a1b-4185457a5c4b",
                                                "text": "The centerpiece of the show is a poised, luminous, tender, and diabolically clever video installation, “Le Triptyque de Noirmoutier” (The Noirmoutier Triptych), which Varda shot on 35-mm. film[…]. The man gets himself a bottle of beer; the older woman heads with dishes from the sink toward the cupboard—and crosses the dividing line of the triptych exactly like crossing a threshold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6165f401-ada2-3aee-9cc8-05bdaadb7f41",
                                        "entry_id": "72462371-1732-3441-b8f2-386084edcd43",
                                        "glosses": [
                                            "A group of three people or works, especially when considered representative of a particular field or theme.",
                                            "A set of three se-tenant postage stamps that form a composite picture."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36e92942-af45-3651-9b41-26f83d5f604b",
                                        "entry_id": "72462371-1732-3441-b8f2-386084edcd43",
                                        "glosses": [
                                            "Any set of three closely connected ideas or objects."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6136bad9-40af-4191-b8fe-0b9f58ad7a5c",
                                                "sense_id": "36e92942-af45-3651-9b41-26f83d5f604b",
                                                "text": "Witchcraft, heresy, and counterfeiting formed a triptych in popular imagination and in the law."
                                            },
                                            {
                                                "example_id": "fcfac2b9-8a15-4ed9-8a3e-af55ea78307f",
                                                "sense_id": "36e92942-af45-3651-9b41-26f83d5f604b",
                                                "text": "The interest here is […] to construct for heuristic purposes a triptych of different “roads to salvation” as reflected in domains of preaching of contemporary Egypt."
                                            },
                                            {
                                                "example_id": "ae214f04-165c-402f-bb51-c89d35a4679a",
                                                "sense_id": "36e92942-af45-3651-9b41-26f83d5f604b",
                                                "text": "There was nothing quite like Hanalei Bay, that great horseshoe of protected water fed by the thick artery of the Hanalei River and framed by a triptych of mountains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da648ffa-bac7-4d47-8b68-6cd637022e2e",
                        "source_entry_id": "0c910a2b-6f71-3484-b2de-00816618ff63",
                        "source_sense_id": "f39fe579-2c84-30b0-bbf9-8f0b6f32c51a",
                        "source_sense_description": "dreiteiliges Bild",
                        "target_lang_word": "triptyque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "triptyque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "714dbcc3-5067-356a-a49c-c46b80f4a6e9",
                                        "entry_id": "6d98459a-7e80-370c-a82c-2f5a1cae6f68",
                                        "glosses": [
                                            "Pièce d’ivoire ou d’orfèvrerie ou peinture à trois battants : un panneau central sur lequel se replient deux volets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3d10098-df35-4227-8120-e57e42c286a5",
                                                "sense_id": "714dbcc3-5067-356a-a49c-c46b80f4a6e9",
                                                "text": "On ne peut comprendre la vogue des triptyques au Moyen Âge, sans faire référence à la Sainte Trinité connue par la chrétienté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2902cbf2-a8d6-3448-973f-7e32015f290b",
                                        "entry_id": "6d98459a-7e80-370c-a82c-2f5a1cae6f68",
                                        "glosses": [
                                            "Œuvre littéraire ternaire, trilogie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "185eb7f0-ded6-4a28-890d-cc5a6be5718d",
                                                "sense_id": "2902cbf2-a8d6-3448-973f-7e32015f290b",
                                                "text": "La Divine Comédie de Dante où trois pôles se distinguent : l'Enfer, le Purgatoire et le Paradis, est un triptyque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc1c2f1d-76b4-3a9e-9fda-032866833838",
                                        "entry_id": "6d98459a-7e80-370c-a82c-2f5a1cae6f68",
                                        "glosses": [
                                            "Document administratif de trois pages (souvent carbone)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9484b2dd-74f5-45df-8503-13ed382cf560",
                                                "sense_id": "fc1c2f1d-76b4-3a9e-9fda-032866833838",
                                                "text": "Les documents accompagnant une livraison sont souvent équipés de triptyque, une page expéditeur, une page destinataire, une page livreur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9318b67-99f4-35d2-b8d8-1074aa9b698b",
                                        "entry_id": "6d98459a-7e80-370c-a82c-2f5a1cae6f68",
                                        "glosses": [
                                            "Ce qui est composé de trois parties constitutives."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea85d5a6-8f20-4920-b095-bd486674720e",
                                                "sense_id": "e9318b67-99f4-35d2-b8d8-1074aa9b698b",
                                                "text": "L’émergence des premières sociétés à caractère compagnonnique se situe bien dans ce champ de l'histoire où le triptyque corporations-cathédrales-croisades contribue fondamentalement à forger la première identité compagnonnale."
                                            },
                                            {
                                                "example_id": "5c57fd87-df8c-4714-a84d-c25447218c03",
                                                "sense_id": "e9318b67-99f4-35d2-b8d8-1074aa9b698b",
                                                "text": "Le modèle économique actuel de l'internet repose sur un triptyque : gratuité de l'accès, publicités ciblées et revente ou utilisation peu claire des données personnelles connectées."
                                            },
                                            {
                                                "example_id": "a825acd2-3ff5-4e75-ab87-4364e1af6fcd",
                                                "sense_id": "e9318b67-99f4-35d2-b8d8-1074aa9b698b",
                                                "text": "Pour en finir avec le système féodal des propriétés simultanées, composé de liens de dépendance et d’obligations mutuelles, de droits coutumiers d’accès et d’usage, la bourgeoisie française s’octroie à la Révolution un « super droit réel » fondé sur le fameux triptyque « usus, fructus, abusus » [Vanuxem, 2018]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9a2b524-27fd-4a60-a0e6-f914217363c3",
