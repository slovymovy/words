                    },
                    {
                        "translation_id": "87265374-191f-4c98-bfa9-42a3801d170c",
                        "source_entry_id": "521ff0ac-f31d-35d9-8170-36703040c1b4",
                        "target_lang_word": "oppose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oppose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "245ac55b-b68b-322a-bf7b-a01ba579ff06",
                                        "entry_id": "39b1c92d-d4e7-3fb2-8117-dfe72914857b",
                                        "glosses": [
                                            "To attempt to stop the progression of; to resist or antagonize by physical means, or by arguments, etc.; to contend against."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f217698f-101f-4ef7-8f02-c7f3838d403c",
                                                "sense_id": "245ac55b-b68b-322a-bf7b-a01ba579ff06",
                                                "text": "to oppose the king in battle"
                                            },
                                            {
                                                "example_id": "3658eab1-f77b-41a2-a42e-74d166bec1d0",
                                                "sense_id": "245ac55b-b68b-322a-bf7b-a01ba579ff06",
                                                "text": "to oppose a bill in Congress"
                                            },
                                            {
                                                "example_id": "f005c482-e65b-4932-b067-8d681627b4c2",
                                                "sense_id": "245ac55b-b68b-322a-bf7b-a01ba579ff06",
                                                "text": "There is still time to oppose this plan."
                                            },
                                            {
                                                "example_id": "47658208-acc4-4768-99ec-bd224e3b42cc",
                                                "sense_id": "245ac55b-b68b-322a-bf7b-a01ba579ff06",
                                                "text": "I am […] too weak / To oppose your cunning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "478b6674-0842-3386-8b88-df76040b8de9",
                                        "entry_id": "39b1c92d-d4e7-3fb2-8117-dfe72914857b",
                                        "glosses": [
                                            "To object to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c050847-b600-4d55-917c-d6c0ddc78710",
                                                "sense_id": "478b6674-0842-3386-8b88-df76040b8de9",
                                                "text": "Many religious leaders oppose cloning humans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe6c551e-2295-3185-93df-1593cb21e1a0",
                                        "entry_id": "39b1c92d-d4e7-3fb2-8117-dfe72914857b",
                                        "glosses": [
                                            "To present or set up in opposition; to pose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5bb437c-7b8e-4a8a-8dbd-cd9b523a3bcd",
                                                "sense_id": "fe6c551e-2295-3185-93df-1593cb21e1a0",
                                                "text": "They are opposed to any form of hierarchy."
                                            },
                                            {
                                                "example_id": "9921a917-075c-448a-b050-c5b7285f7e3f",
                                                "sense_id": "fe6c551e-2295-3185-93df-1593cb21e1a0",
                                                "text": ", Book I\nI may […] oppose my single opinion to his."
                                            },
                                            {
                                                "example_id": "0bdfad5d-fdf5-4c29-9143-600b2d33563e",
                                                "sense_id": "fe6c551e-2295-3185-93df-1593cb21e1a0",
                                                "text": "[T]hree walls had been left standing, with large intervals between each; and they would certainly oppose a most formidable interruption to an invader."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82921eab-01d8-3928-b906-17c6f8c899f2",
                                        "entry_id": "39b1c92d-d4e7-3fb2-8117-dfe72914857b",
                                        "glosses": [
                                            "To place in front of, or over against; to set opposite; to exhibit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c7903d-f619-4c8c-aa04-789649ca7b01",
                                                "sense_id": "82921eab-01d8-3928-b906-17c6f8c899f2",
                                                "text": "Her grace sat down […] / In a rich chair of state; opposing freely / The beauty of her person to the people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06e13398-2a85-45cb-ae75-53ab1e69b06e",
                        "source_entry_id": "521ff0ac-f31d-35d9-8170-36703040c1b4",
                        "target_lang_word": "fight back",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fight back",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21ab2edd-77ef-3ce4-994b-0736dffb6e9d",
                                        "entry_id": "398ebc22-23e4-3b99-9461-c925d2384069",
                                        "glosses": [
                                            "To defend oneself by fighting."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce055037-eeb1-4825-a258-799ffdf4e742",
                                                "sense_id": "21ab2edd-77ef-3ce4-994b-0736dffb6e9d",
                                                "text": "The bully hadn't been expecting his victim to fight back, and now the bully has quadriplegia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "245e439a-fce3-3562-8c52-77ecc77536b3",
                                        "entry_id": "398ebc22-23e4-3b99-9461-c925d2384069",
                                        "glosses": [
                                            "To defend oneself by fighting.",
                                            "To counterattack (counterstrike); to resist an attack or respond after one."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53007da0-6366-4875-b1c8-b98542e91210",
                                                "sense_id": "245e439a-fce3-3562-8c52-77ecc77536b3",
                                                "text": "During the Pearl Harbor attack, the U.S. Navy began fighting back, and it wouldn't stop until August 1945."
                                            },
                                            {
                                                "example_id": "2ed03221-5f0d-4fbd-a0ec-8eeae5023e2e",
                                                "sense_id": "245e439a-fce3-3562-8c52-77ecc77536b3",
                                                "text": "KIRA: You can change their minds. Convince your fellow Cardassians to go on the offensive.\nDUKAT: No, I'd be wasting my breath. They wouldn't listen to me. No one wants to fight. There was a time when the mere mention of my race inspired fear. And now we're beaten people, afraid to fight back because we don't want to lose what little is left."
                                            },
                                            {
                                                "example_id": "27e0d4ff-62c7-4382-bb79-6b4fc26ba0dc",
                                                "sense_id": "245e439a-fce3-3562-8c52-77ecc77536b3",
                                                "text": "With Scott and the outstanding Claire Rafferty in particular fighting back, all was not lost."
                                            },
                                            {
                                                "example_id": "fc290382-2466-428c-8688-0e9b8e639cb5",
                                                "sense_id": "245e439a-fce3-3562-8c52-77ecc77536b3",
                                                "text": "The 1928 Royal Commission on Transport not only set some controls for the road haulage industry, it also gave the railway companies the opportunity to fight back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d70010e2-cbe4-37c3-91b7-9d8242d39252",
                                        "entry_id": "398ebc22-23e4-3b99-9461-c925d2384069",
                                        "glosses": [
                                            "to repress; to struggle to repress."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b0b0073-ca81-4d66-896b-7bbf64b7204f",
                                                "sense_id": "d70010e2-cbe4-37c3-91b7-9d8242d39252",
                                                "text": "fight back tears"
                                            },
                                            {
                                                "example_id": "0697a802-fff4-4e90-b911-b5a18949be31",
                                                "sense_id": "d70010e2-cbe4-37c3-91b7-9d8242d39252",
                                                "text": "She tried to fight back her laughter."
                                            },
                                            {
                                                "example_id": "464ead3f-9e8d-4413-9092-2fe576cff238",
                                                "sense_id": "d70010e2-cbe4-37c3-91b7-9d8242d39252",
                                                "text": "It was especially after the Battle of Midway that the U.S. was able to fight the Japanese back toward their home islands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "746f52db-5c30-3d03-b978-073546256a06",
                                        "entry_id": "398ebc22-23e4-3b99-9461-c925d2384069",
                                        "glosses": [
                                            "To overturn a losing deficit."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
