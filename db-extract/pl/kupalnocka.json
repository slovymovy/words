                        "sense_id": "c99b563c-d9e9-3859-bd84-b86f2c857601",
                        "entry_id": "d1416383-1bb2-354b-b3d3-78c49548fea9",
                        "glosses": [
                            "reg. (Warmia, Mazury, Kurpie i Podlasie) Noc Świętojańska"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8da3cf41-2026-4cb7-92e7-c447c181c855",
                                "sense_id": "c99b563c-d9e9-3859-bd84-b86f2c857601",
                                "text": "[…] ale kto wie, czy nie jest po prostu opisem jakiegoś smutnego wypadku, który się gdzieś wydarzył, może przed kilku wiekami, przy obchodzie Kupalnocki"
                            },
                            {
                                "example_id": "54125fab-5632-43e5-9690-1d11a5c01268",
                                "sense_id": "c99b563c-d9e9-3859-bd84-b86f2c857601",
                                "text": "Te sześć wierszy śpiewają także u Kurpiów w czasie Kupalnocki czyli Sobótki"
                            },
                            {
                                "example_id": "f190f8a0-d8b1-4fbb-a96f-c7086836db96",
                                "sense_id": "c99b563c-d9e9-3859-bd84-b86f2c857601",
                                "text": "Lud np. mazowiecki i podlaski, nad Narwią i Bugiem zamieszkały, obrzęd ten znał tylko pod mianem Kupalnocki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
