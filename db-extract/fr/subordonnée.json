                    {
                        "form_id": "33bca27b-c88d-4caa-b9ab-921d03ef1624",
                        "entry_id": "cb00d88b-dc89-3999-b7e8-809c4216f055",
                        "tags": [
                            "plural"
                        ],
                        "form": "subordonnées"
