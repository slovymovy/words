                        "entry_id": "fd357363-33a9-3987-8abf-b89a7ec30333",
                        "glosses": [
                            "Mouvement ouvrier opposé à la machinisation pour protéger emplois et bien-être."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdc6d394-8173-4879-900a-1050d5e3fc5d",
                                "sense_id": "53ebabdc-3d0b-31ce-8a2e-16483a171f70",
                                "text": "Le Luddisme fut parmi ces mouvements le plus tumultueux, le plus intense, mais aussi le plus réprimé."
                            },
                            {
                                "example_id": "9b582346-ba18-4973-b860-0658d7ad1179",
                                "sense_id": "53ebabdc-3d0b-31ce-8a2e-16483a171f70",
                                "text": "Le luddisme est d’un autre temps, d’un temps où les ouvriers ne voyaient pas au-delà de la machine."
                            }
                        ]
                    }
                ],
                "translations": [
