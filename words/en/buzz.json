{
    "word_family": [
        "buzzer",
        "buzzcut",
        "buzzword",
        "buzzing",
        "buzz-kill"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2c7f016-0618-363b-b536-ab81cdd9e74c",
                    "sense_definition": "To make a low, continuous, humming or sibilant sound, like that made by bees with their wings.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could hear a fly <w>buzzing</w> against the window pane all afternoon.",
                            "target_lang_translations": {
                                "ru": "Весь день я слышал, как муха <w>жужжит</w>, бьясь об оконное стекло.",
                                "zh": "整个下午我都能听到一只苍蝇在窗玻璃上<w>嗡嗡叫</w>。"
                            }
                        },
                        {
                            "text": "The bees <w>buzz</w> around the flowers in the garden during the summer.",
                            "target_lang_translations": {
                                "ru": "Летом пчелы <w>жужжат</w> вокруг цветов в саду.",
                                "zh": "夏天，蜜蜂在花园的花丛中<w>嗡嗡</w>飞舞。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "buzz around",
                        "bees buzz"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать низкий, непрерывный, гудящий или свистящий звук, подобный звуку крыльев пчелы.",
                        "zh": "发出像蜜蜂翅膀振动那样的低沉、连续的嗡嗡声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жужжать",
                                "target_lang_sense_clarification": "о насекомых или механизмах"
                            },
                            {
                                "target_lang_word": "гудеть",
                                "target_lang_sense_clarification": "о монотонном звуке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嗡嗡叫",
                                "target_lang_sense_clarification": "指昆虫或机械发出的声音"
                            },
                            {
                                "target_lang_word": "嗡嗡作响",
                                "target_lang_sense_clarification": "形容持续的低沉声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc153e11-a3d2-342a-b990-51fedde8858e",
                    "sense_definition": "To show a high level of activity and haste, or to be full of excitement and energy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen was <w>buzzing</w> with activity as the chefs prepared for the dinner rush.",
                            "target_lang_translations": {
                                "ru": "Кухня <w>гудела</w> от работы, пока повара готовились к вечернему наплыву посетителей.",
                                "zh": "厨师们正为晚餐高峰做准备，厨房里<w>忙得不可开交</w>。"
                            }
                        },
                        {
                            "text": "The whole city began to <w>buzz</w> with excitement before the festival started.",
                            "target_lang_translations": {
                                "ru": "Весь город начал <w>оживляться</w> от волнения перед началом фестиваля.",
                                "zh": "节日开始前，整个城市都因兴奋而<w>沸腾</w>了起来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "buzz with activity",
                        "buzz with excitement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявлять высокий уровень активности и спешки или быть полным волнения и энергии.",
                        "zh": "表现出高度的活跃和忙碌，或充满兴奋和活力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гудеть",
                                "target_lang_sense_clarification": "о месте, полном людей или активности"
                            },
                            {
                                "target_lang_word": "кипеть",
                                "target_lang_sense_clarification": "о бурной деятельности"
                            },
                            {
                                "target_lang_word": "оживляться",
                                "target_lang_sense_clarification": "наполняться движением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忙得不可开交",
                                "target_lang_sense_clarification": "形容地方充满活动"
                            },
                            {
                                "target_lang_word": "沸腾",
                                "target_lang_sense_clarification": "形容充满兴奋和活力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4787477-5e9c-3a41-aab6-2e5416ebf298",
                    "sense_definition": "To communicate with or signal a person by means of a buzzer or electronic signal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>buzz</w> me in when you get to the front door of the apartment.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>позвони</w> мне (в домофон), когда подойдешь к входной двери дома.",
                                "zh": "你到了公寓前门时，请<w>按门铃</w>让我进去。"
                            }
                        },
                        {
                            "text": "The manager <w>buzzed</w> his assistant to ask for the latest report.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>вызвал</w> своего ассистента по селектору, чтобы попросить последний отчет.",
                                "zh": "经理<w>呼叫</w>了他的助理，询问最新的报告。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "buzz someone in",
                        "buzz the intercom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связаться с кем-либо или подать сигнал с помощью зуммера или электронного сигнала.",
                        "zh": "通过蜂鸣器或电子信号与某人联系或发出信号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позвонить",
                                "target_lang_sense_clarification": "в домофон или по селектору"
                            },
                            {
                                "target_lang_word": "просигналить",
                                "target_lang_sense_clarification": "подать звуковой сигнал"
                            },
                            {
                                "target_lang_word": "вызвать",
                                "target_lang_sense_clarification": "через кнопку вызова"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "按门铃",
                                "target_lang_sense_clarification": "指通过门禁系统呼叫"
                            },
                            {
                                "target_lang_word": "呼叫",
                                "target_lang_sense_clarification": "指通过电子设备联系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cf984f8-65e5-3fa2-a816-c1123faa49c9",
                    "sense_definition": "To fly at high speed and at a very low altitude over a specified area.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fighter jets <w>buzzed</w> the tower during the military exercise.",
                            "target_lang_translations": {
                                "ru": "Истребители <w>пронеслись на бреющем полёте</w> над диспетчерской вышкой во время военных учений.",
                                "zh": "军事演习期间，战斗机在塔台上方<w>低空掠过</w>。"
                            }
                        },
                        {
                            "text": "We watched as a small plane <w>buzzed</w> the field at a dangerously low height.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как маленький самолет <w>пролетел</w> над полем на опасной низкой высоте.",
                                "zh": "我们看着一架小型飞机在危险的低空<w>掠过</w>田野。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "buzz the tower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пролетать на высокой скорости и на очень малой высоте над определенной территорией.",
                        "zh": "在特定区域上空高速且极低地飞行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лететь на бреющем полёте",
                                "target_lang_sense_clarification": "авиационный термин"
                            },
                            {
                                "target_lang_word": "пронестись",
                                "target_lang_sense_clarification": "на низкой высоте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "低空掠过",
                                "target_lang_sense_clarification": "指飞机在极低高度飞行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59b300cb-5167-374c-aa96-25f2934bcc44",
                    "sense_definition": "To cut hair very short using electric clippers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grooming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>buzz</w> his hair off before starting basic training.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>постричься под машинку</w> перед началом начальной военной подготовки.",
                                "zh": "他决定在开始基础训练前把头发<w>剃平头</w>。"
                            }
                        },
                        {
                            "text": "The barber <w>buzzed</w> the back of my neck to make it look neat.",
                            "target_lang_translations": {
                                "ru": "Парикмахер <w>подбрил</w> мне затылок машинкой, чтобы всё выглядело аккуратно.",
                                "zh": "理发师帮我把后颈的头发<w>推短</w>，看起来更整洁。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "buzz your hair"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used for short haircuts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень коротко подстричь волосы с помощью электрической машинки.",
                        "zh": "用电动理发器将头发剪得极短。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стричь под машинку",
                                "target_lang_sense_clarification": "очень коротко"
                            },
                            {
                                "target_lang_word": "побрить",
                                "target_lang_sense_clarification": "почти налысо"
                            },
                            {
                                "target_lang_word": "обкорнать",
                                "target_lang_sense_clarification": "разговорное, коротко подстричь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剃平头",
                                "target_lang_sense_clarification": "指用推子剪短发"
                            },
                            {
                                "target_lang_word": "推光",
                                "target_lang_sense_clarification": "指剪得非常短"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "521a27ef-748a-3b59-94fa-fa90a2c580da",
                    "sense_definition": "A continuous humming noise, like that of bees or a low murmur of conversation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a constant <w>buzz</w> of conversation coming from the crowded cafe.",
                            "target_lang_translations": {
                                "ru": "Из переполненного кафе доносился постоянный <w>гул</w> голосов.",
                                "zh": "拥挤的咖啡馆里传来持续不断的谈话<w>嘈杂声</w>。"
                            }
                        },
                        {
                            "text": "The low <w>buzz</w> of the refrigerator was the only sound in the quiet kitchen.",
                            "target_lang_translations": {
                                "ru": "Тихое <w>жужжание</w> холодильника было единственным звуком на тихой кухне.",
                                "zh": "安静的厨房里，只有冰箱发出的低沉<w>嗡嗡声</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fizz-buzz"
                    ],
                    "antonyms": [
                        "silence"
                    ],
                    "common_phrases": [
                        "low buzz",
                        "constant buzz"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывный гудящий шум, например, от пчел или негромкий гул разговоров.",
                        "zh": "连续的嗡嗡声，如蜜蜂的叫声或低沉的谈话声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жужжание",
                                "target_lang_sense_clarification": "звук насекомых или приборов"
                            },
                            {
                                "target_lang_word": "гул",
                                "target_lang_sense_clarification": "шум толпы или техники"
                            },
                            {
                                "target_lang_word": "гудение",
                                "target_lang_sense_clarification": "монотонный звук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嗡嗡声",
                                "target_lang_sense_clarification": "指昆虫或机器的声音"
                            },
                            {
                                "target_lang_word": "嘈杂声",
                                "target_lang_sense_clarification": "指人群的低语声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "557a69ce-e6b5-32ca-b995-d4a5091c7759",
                    "sense_definition": "A widespread rumor or a major topic of excited conversation and interest.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a lot of <w>buzz</w> about the new movie coming out next week.",
                            "target_lang_translations": {
                                "ru": "Вокруг нового фильма, выходящего на следующей неделе, поднялся большой <w>ажиотаж</w>.",
                                "zh": "关于下周上映的新电影，外界有很多<w>热议</w>。"
                            }
                        },
                        {
                            "text": "The marketing team worked hard to create a <w>buzz</w> around the product launch.",
                            "target_lang_translations": {
                                "ru": "Команда по маркетингу усердно работала, чтобы создать <w>шумиху</w> вокруг запуска продукта.",
                                "zh": "营销团队努力为产品发布制造<w>炒作</w>声势。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "create a buzz",
                        "media buzz"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in media and marketing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко распространенный слух или главная тема оживленных разговоров и интереса.",
                        "zh": "广泛流传的传闻或引起热烈讨论和关注的话题。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ажиотаж",
                                "target_lang_sense_clarification": "вокруг события или продукта"
                            },
                            {
                                "target_lang_word": "слухи",
                                "target_lang_sense_clarification": "распространяемая информация"
                            },
                            {
                                "target_lang_word": "молва",
                                "target_lang_sense_clarification": "общественное обсуждение"
                            },
                            {
                                "target_lang_word": "шумиха",
                                "target_lang_sense_clarification": "интенсивное обсуждение в СМИ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "热议",
                                "target_lang_sense_clarification": "指公众讨论的话题"
                            },
                            {
                                "target_lang_word": "炒作",
                                "target_lang_sense_clarification": "指媒体或营销制造的声势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bdf9ca8-87fc-310f-89c8-a94d53bda9a4",
                    "sense_definition": "A feeling of excitement, energy, or slight intoxication.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She got a real <w>buzz</w> from performing on stage in front of the large crowd.",
                            "target_lang_translations": {
                                "ru": "Она получила настоящий <w>кайф</w> от выступления на сцене перед огромной толпой.",
                                "zh": "在观众面前登台表演让她获得了极大的<w>快感</w>。"
                            }
                        },
                        {
                            "text": "The morning coffee gave him a much-needed <w>buzz</w> to start his workday.",
                            "target_lang_translations": {
                                "ru": "Утренний кофе дал ему необходимый <w>заряд</w> энергии для начала рабочего дня.",
                                "zh": "早晨的咖啡给了他开始工作所急需的<w>兴奋劲儿</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get a buzz",
                        "caffeine buzz"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal way to describe a rush of energy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство возбуждения, энергии или легкого опьянения.",
                        "zh": "一种兴奋、充满活力或轻微陶醉的感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кайф",
                                "target_lang_sense_clarification": "сленг, удовольствие и энергия"
                            },
                            {
                                "target_lang_word": "задор",
                                "target_lang_sense_clarification": "пыл и воодушевление"
                            },
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "прилив сил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快感",
                                "target_lang_sense_clarification": "指兴奋和愉悦"
                            },
                            {
                                "target_lang_word": "兴奋劲儿",
                                "target_lang_sense_clarification": "指充满活力的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d37d11c8-f84e-3b3a-81a9-b1664c3e283c",
                    "sense_definition": "A telephone call.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will give you a <w>buzz</w> later this evening to discuss our plans.",
                            "target_lang_translations": {
                                "ru": "Я <w>звякну</w> тебе сегодня вечером, чтобы обсудить наши планы.",
                                "zh": "我今晚晚些时候给你打个<w>电话</w>讨论我们的计划。"
                            }
                        },
                        {
                            "text": "If you need any help with the project, just give me a <w>buzz</w>.",
                            "target_lang_translations": {
                                "ru": "Если тебе понадобится помощь с проектом, просто <w>позвони</w> мне.",
                                "zh": "如果项目需要任何帮助，直接给我打个<w>电话</w>就行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give someone a buzz"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Mainly British and Australian informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Телефонный звонок.",
                        "zh": "一个电话。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звонок",
                                "target_lang_sense_clarification": "по телефону"
                            },
                            {
                                "target_lang_word": "набор",
                                "target_lang_sense_clarification": "вызов абонента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电话",
                                "target_lang_sense_clarification": "指通话"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0db037de-dc77-3a54-8ef8-b48d1ab68539",
                    "sense_definition": "A male given name, often used as a nickname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
