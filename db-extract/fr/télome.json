                        "entry_id": "03c1d8ce-0e5f-30f7-9a6d-3a9e90b6daf1",
                        "glosses": [
                            "Unité morphologique fondamentale des axes végétatifs primitifs, formée d’un segment terminal indifférencié, selon la théorie de Zimmermann."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "514895f0-021e-46f6-a0ee-284668d7003c",
                                "sense_id": "ed31656b-9e83-33b3-af38-ddd1a1197c2a",
                                "text": "La théorie du télome, telle que formulée par Zimmermann en 1930, est toujours considérée comme valable aujourd'hui en ce qu'elle résume en réalité les stades de développement observés dans un schéma phylogénétiquement plausible."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d50d63c-2251-3905-97da-a8c4a157c115",
                        "entry_id": "03c1d8ce-0e5f-30f7-9a6d-3a9e90b6daf1",
                        "glosses": [
                            "(Par extension) Partie terminale d’un rameau ou d’un axe de croissance chez certaines plantes primitives, représentant le point végétatif de terminaison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39fd6065-c37d-43d9-adf3-eb4945761d23",
                                "sense_id": "0d50d63c-2251-3905-97da-a8c4a157c115",
                                "text": "...le télome représente le point végétatif de terminaison d'une structure végétale, jouant un rôle clé dans la compréhension de l'évolution et de la forme des plantes."
                            }
                        ]
                    }
