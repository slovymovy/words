                    {
                        "sense_id": "d5efda2d-e3ea-306c-97d5-780e1fbe8232",
                        "entry_id": "15406602-3795-38df-a4a3-ad9118c350f9",
                        "glosses": [
                            "Staub, der auf einer Straße liegt oder von ihr stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b019f56-a55f-4c83-af79-ea401b79a427",
                                "sense_id": "d5efda2d-e3ea-306c-97d5-780e1fbe8232",
                                "text": "„Nach dem Unfall am Friedhofstor gab der Schädel seine Wanderschaft auf und ruhte ruhig im Straßenstaub.“"
                            },
                            {
                                "example_id": "1a2c2145-55a2-40fe-94ac-83b499cfc45d",
                                "sense_id": "d5efda2d-e3ea-306c-97d5-780e1fbe8232",
                                "text": "„Und darauf ging der junge Mann nun langsam zu, wobei er beobachtete, wie jeder seiner Schritte den Straßenstaub in rasch verfliegenden Wirbeln vor sich herstieß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
