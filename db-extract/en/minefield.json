                        ],
                        "examples": [
                            {
                                "example_id": "88026fc2-6eae-4ec7-906d-2ed1fc695b4e",
                                "sense_id": "ad33e354-3db5-34e7-88bc-a2b38cf8e874",
                                "text": "Be careful. Foreign property investments are a minefield, and some people have lost a lot of money."
                            },
                            {
                                "example_id": "8504e922-92ed-4a5c-b91e-545bab685fce",
                                "sense_id": "ad33e354-3db5-34e7-88bc-a2b38cf8e874",
                                "text": "Russian grammar can be a minefield."
                            },
                            {
                                "example_id": "73d1b5fa-d343-43e0-a0ca-d93e1ff6ad68",
                                "sense_id": "ad33e354-3db5-34e7-88bc-a2b38cf8e874",
                                "text": "Political minefield awaits Prayut government including threat from an old foe"
                            }
                        ]
