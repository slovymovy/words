                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f17637b-339d-489f-ba2c-49a3e8ae9d13",
                                "sense_id": "2ad5b036-fe47-33f1-9cf8-0a9315b84607",
                                "text": "„Der Antareaner hob einen seiner fünf Arme, der in zwei fingerartigen, mit unzähligen, in jede Richtung beweglichen Gelenken versehenen Fortsätzen endete, und berührte einen dünnen Draht, der sich über seinem Kopf zwischen den beiden Stäben spannte.“"
                            }
                        ],
