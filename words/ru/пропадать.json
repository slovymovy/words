{
    "word_family": [
        "пропажа",
        "пропащий"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d090b13-c4f3-3947-9de8-f91e48484299",
                    "sense_definition": "Переставать быть видимым или слышимым, исчезать из поля зрения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "исчезновение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солнце <w>пропадает</w> за горизонтом каждый вечер.",
                            "target_lang_translations": {
                                "en": "The sun <w>disappears</w> behind the horizon every evening."
                            }
                        },
                        {
                            "text": "Все <w>пропадающие</w> звуки постепенно стихли в ночной тишине.",
                            "target_lang_translations": {
                                "en": "All the <w>fading</w> sounds gradually died away in the night silence."
                            }
                        }
                    ],
                    "synonyms": [
                        "исчезать"
                    ],
                    "antonyms": [
                        "появляться"
                    ],
                    "common_phrases": [
                        "пропадать из виду"
                    ],
                    "target_lang_definitions": {
                        "en": "To cease to be visible or audible; to disappear from view."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disappear",
                                "target_lang_sense_clarification": "general term for ceasing to be visible"
                            },
                            {
                                "target_lang_word": "vanish",
                                "target_lang_sense_clarification": "to disappear suddenly or completely"
                            },
                            {
                                "target_lang_word": "fade away",
                                "target_lang_sense_clarification": "to disappear gradually, often used for sounds or light"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea0ffbd5-5841-3788-a2dd-2353bc1031a6",
                    "sense_definition": "Теряться, утрачиваться или погибать в трудных условиях.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "гибель",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Без должного ухода растения могут быстро <w>пропадать</w>.",
                            "target_lang_translations": {
                                "en": "Without proper care, plants can quickly <w>wither</w>."
                            }
                        },
                        {
                            "text": "Талантливые люди не должны <w>пропадать</w> из-за отсутствия поддержки.",
                            "target_lang_translations": {
                                "en": "Talented people should not <w>be lost</w> due to a lack of support."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be lost, perish, or die under difficult conditions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "perish",
                                "target_lang_sense_clarification": "to die or be destroyed, often in harsh conditions"
                            },
                            {
                                "target_lang_word": "wither away",
                                "target_lang_sense_clarification": "to decline or die, often used for plants or potential"
                            },
                            {
                                "target_lang_word": "be lost",
                                "target_lang_sense_clarification": "to fail to thrive or be wasted"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b813f538-04e3-33d9-95cf-4329c002658f",
                    "sense_definition": "Расходоваться впустую, проходить безрезультатно.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "трата",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не позволяй своему свободному времени <w>пропадать</w> зря.",
                            "target_lang_translations": {
                                "en": "Don't let your free time <w>go to waste</w>."
                            }
                        },
                        {
                            "text": "Из-за плохой упаковки продукты <w>пропадают</w> раньше срока.",
                            "target_lang_translations": {
                                "en": "Due to poor packaging, food <w>spoils</w> ahead of time."
                            }
                        }
                    ],
                    "common_phrases": [
                        "пропадать зря"
                    ],
                    "target_lang_definitions": {
                        "en": "To be wasted or spent without result."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go to waste",
                                "target_lang_sense_clarification": "to be unused or thrown away"
                            },
                            {
                                "target_lang_word": "be wasted",
                                "target_lang_sense_clarification": "to be spent without achieving a result"
                            },
                            {
                                "target_lang_word": "spoil",
                                "target_lang_sense_clarification": "to decay or become unusable, specifically for food"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60c89ac6-7012-3eec-a5e0-fbeadf929dd8",
                    "sense_definition": "Долгое время отсутствовать, находиться где-то вне дома.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "отсутствие",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Где ты <w>пропадаешь</w> целыми днями?",
                            "target_lang_translations": {
                                "en": "Where have you <w>been hanging out</w> all day?"
                            }
                        },
                        {
                            "text": "Сын <w>пропадал</w> на тренировках до самого позднего вечера.",
                            "target_lang_translations": {
                                "en": "My son <w>was away</w> at training until late in the evening."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be absent for a long time; to be away from home."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be out",
                                "target_lang_sense_clarification": "to be away from home or one's usual place"
                            },
                            {
                                "target_lang_word": "hang out",
                                "target_lang_sense_clarification": "to spend time somewhere (colloquial)"
                            },
                            {
                                "target_lang_word": "be missing",
                                "target_lang_sense_clarification": "to be away and unaccounted for"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}