                ],
                "senses": [
                    {
                        "sense_id": "8aebe9c6-d4e1-341b-9cf2-e26841238ecd",
                        "entry_id": "6862827f-4678-31ac-be64-fc3bbf51f246",
                        "glosses": [
                            "Annuler les effets de la corrosion de (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49e7b5b7-fe47-40a1-a260-4307df56ce38",
                                "sense_id": "8aebe9c6-d4e1-341b-9cf2-e26841238ecd",
                                "text": "Il est vrai qu’il a employé Chaboissière à faire les distillations, comme aussi à l’égard des fioles, demeure d’accord d’y avoir mis du safran pour le décorroder, et du soufre d’or, et elles furent portées chez Cadelan."
                            },
                            {
                                "example_id": "b907d8ab-7388-45f9-9f4c-eb1010b8394f",
                                "sense_id": "8aebe9c6-d4e1-341b-9cf2-e26841238ecd",
                                "text": "Et connaissez-vous aujourd'hui beaucoup d’écrivains capables de tourner autour d’un mot banal pendant une heure, sans perdre une once de la volonté d’en bouffer la moelle, c’est-à-dire, au fond, d’en décorroder le sens ?"
                            },
                            {
                                "example_id": "a22be554-9b52-4e3d-a781-44c739fe1041",
                                "sense_id": "8aebe9c6-d4e1-341b-9cf2-e26841238ecd",
                                "text": "Les ressorts sont décorrodés et au besoin remplacés."
                            }
                        ]
                    }
                ],
