                "senses": [
                    {
                        "sense_id": "72e5d9e5-b140-36f9-94ed-da84abd4118d",
                        "entry_id": "a571ecc0-1829-33cd-be02-1916042051de",
                        "glosses": [
                            "Messung zur Ermittlung der Pulsfrequenz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55aa5d81-68b6-4c19-984e-fa95876dcdb0",
                                "sense_id": "72e5d9e5-b140-36f9-94ed-da84abd4118d",
                                "text": "„Der Gast wird gewogen, gemessen und zu Ernährungsgewohnheiten und Gesundheitsproblemen befragt. Später folgen Körperfettmessung, Fitnesstest und Pulsmessung.“"
                            },
                            {
                                "example_id": "a91fab90-dbb0-48da-8411-6bdb8128c8ea",
                                "sense_id": "72e5d9e5-b140-36f9-94ed-da84abd4118d",
                                "text": "„Eine Pulsmessung schützt vor gefährlichen Überlastungen: Schlägt das Herz schneller als vom Arzt erlaubt, wird die Motorunterstützung deutlich erhöht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
