        "fr-extract.jsonl": [
            {
                "entry_id": "c74adcbe-805f-30d7-9ba0-db1d4eb3fb3e",
                "word": "vêture",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8ba99647-ae77-433e-b607-39654fae3b2d",
                        "entry_id": "c74adcbe-805f-30d7-9ba0-db1d4eb3fb3e",
                        "tags": [
                            "plural"
                        ],
                        "form": "vêtures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "39494a7c-b6bb-3b95-b425-5a5ea87fbd31",
                        "entry_id": "c74adcbe-805f-30d7-9ba0-db1d4eb3fb3e",
                        "glosses": [
                            "Cérémonie qui se fait dans les couvents, lorsque l’on donne l’habit à un religieux, à une religieuse, et qui précède communément d’une année la profession solennelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46903a62-88a4-4f65-bfa4-8d7579221ac2",
                                "sense_id": "39494a7c-b6bb-3b95-b425-5a5ea87fbd31",
                                "text": "Assister à une vêture."
                            },
                            {
                                "example_id": "25cf819c-becd-4ea4-a012-852c318bb9ba",
                                "sense_id": "39494a7c-b6bb-3b95-b425-5a5ea87fbd31",
                                "text": "Prêcher une vêture."
                            },
                            {
                                "example_id": "8fcfd664-2462-4ba7-b42b-01a69a3bd0ec",
                                "sense_id": "39494a7c-b6bb-3b95-b425-5a5ea87fbd31",
                                "text": "À Cahors, une des plus jolies filles de la ville s’est faite religieuse ; quand elle parut dans l’église le jour de sa vêture en vêtements blancs de mariée, les hommes murmuraient, s’indignaient : « Quel dommage ! C’est un meurtre. » — Le tumulte a été tel, qu’on n’a pu achever la cérémonie."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae37ca7b-3923-3415-986f-eead0a5fa3e4",
                        "entry_id": "c74adcbe-805f-30d7-9ba0-db1d4eb3fb3e",
                        "glosses": [
                            "Action de fournir des vêtements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "935dc5fd-df0b-4e15-9373-5977903577a2",
                                "sense_id": "ae37ca7b-3923-3415-986f-eead0a5fa3e4",
                                "text": "La vêture des enfants assistés."
                            }
                        ]
                    },
                    {
                        "sense_id": "519b36e6-12a6-3ca7-a2fc-e47e94082bd3",
                        "entry_id": "c74adcbe-805f-30d7-9ba0-db1d4eb3fb3e",
                        "glosses": [
                            "Vêtements eux-mêmes que l’on fournit à des indigents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8afbf477-b300-4a34-b5d3-77e7587d4b87",
                                "sense_id": "519b36e6-12a6-3ca7-a2fc-e47e94082bd3",
                                "text": "Il est déposé dans les bureaux du secrétariat général de l’Assistance publique un échantillon type de chacune des layettes et vêtures affectées au service des enfants assistés."
                            },
                            {
                                "example_id": "b85393db-0ae3-45d2-8239-843b5746cb34",
                                "sense_id": "519b36e6-12a6-3ca7-a2fc-e47e94082bd3",
                                "text": "Liste pour la vêture d’une fille de l'assistance publique de 6 ans édité par le Magasins des Vêtures de l’AP"
                            }
                        ]
                    },
                    {
                        "sense_id": "48f34e55-1648-32be-872e-d7fe7de32089",
                        "entry_id": "c74adcbe-805f-30d7-9ba0-db1d4eb3fb3e",
                        "glosses": [
                            "L’ensemble des vêtements que porte une personne."
                        ],
                        "tags": [
                            "Simplement"
                        ],
                        "examples": [
                            {
                                "example_id": "71e67638-6b24-469a-afad-2fe085d44a83",
                                "sense_id": "48f34e55-1648-32be-872e-d7fe7de32089",
                                "text": "Ne pensez-vous pas qu’au point de vue des emblèmes parlants, la vêture de la congrégation des Annonciades fut la plus éloquente ? car ces moniales étaient habillées, de gris, de blanc et de rouge."
                            },
                            {
                                "example_id": "d88a2ff2-d134-4489-b672-409c00375156",
                                "sense_id": "48f34e55-1648-32be-872e-d7fe7de32089",
                                "text": "Je ne sais qui de la Thomassine ou de moi porta l’autre dessus le lit, mais nous y fûmes en un battement de cils, notre vêture ôtée et jetée à la diable et les rouges rideaux refermés sur nous comme sur l’enfantelet futur le ventre de sa mère."
                            },
                            {
                                "example_id": "50f9b019-b918-4c12-a96d-edf50e5401e1",
                                "sense_id": "48f34e55-1648-32be-872e-d7fe7de32089",
                                "text": "— Tout de même, Il maniait les hommes qu’impressionne toujours la raison quand elle a pour vêture l’éloquence."
                            },
                            {
                                "example_id": "daac73fb-1f5f-42d5-84d5-2a920906f498",
                                "sense_id": "48f34e55-1648-32be-872e-d7fe7de32089",
                                "text": "– La souris rouge. De tifs et de vêture."
                            }
                        ]
                    },
                    {
                        "sense_id": "c33de898-1dc2-32ab-a07b-1fef9a47781c",
                        "entry_id": "c74adcbe-805f-30d7-9ba0-db1d4eb3fb3e",
                        "glosses": [
                            "Système d’isolation de façade constitué d’éléments préfabriqués comprenant un isolant et une plaque de parement, à fixer sur l’extérieur du mur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acc03c98-f46c-4c63-8baf-04bfafff14d3",
                                "sense_id": "c33de898-1dc2-32ab-a07b-1fef9a47781c",
                                "text": "La vêture extérieure est constituée d’un bardage de chêne et les menuiseries sont en châtaignier lamellé-collé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b85cb9fe-799c-4014-b362-e42470cde58b",
                        "source_entry_id": "c74adcbe-805f-30d7-9ba0-db1d4eb3fb3e",
                        "target_lang_word": "Kleidung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleidung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb698cd-c38f-33b9-a5a5-1a67f3929cbc",
                                        "entry_id": "a6649ac6-7b6d-373f-8da2-3d1bfe5091ae",
                                        "glosses": [
                                            "Gesamtheit der Kleider, der Kleidungsstücke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd3e08b1-4a70-4392-afea-7e7bc8d0e083",
                                                "sense_id": "dbb698cd-c38f-33b9-a5a5-1a67f3929cbc",
                                                "text": "Wetterfeste Kleidung und Schuhwerk sind in jedem Fall angesagt."
                                            },
                                            {
                                                "example_id": "f719fc75-267d-43f1-bf2f-aae3fa73f9b8",
                                                "sense_id": "dbb698cd-c38f-33b9-a5a5-1a67f3929cbc",
                                                "text": "Natürlich muss man da in einer angemessenen Kleidung auftreten, das verlangt ja schon der historische Rahmen."
                                            },
                                            {
                                                "example_id": "dfdbca6b-dbc8-4f8a-9463-fdfdd14c6c6b",
                                                "sense_id": "dbb698cd-c38f-33b9-a5a5-1a67f3929cbc",
                                                "text": "„Es bleibt keine Zeit, weder fürs Einpacken von Waschzeug und Kleidung, noch für Umarmung und Abschied.“"
                                            },
                                            {
                                                "example_id": "cc9bab40-061c-40af-b7ca-d088979824e7",
                                                "sense_id": "dbb698cd-c38f-33b9-a5a5-1a67f3929cbc",
                                                "text": "„Als ich glaubte, genug Kleidung gesammelt zu haben, schnürte ich alles zu einem Bündel zusammen und trug es zum Schoner.“"
                                            },
                                            {
                                                "example_id": "b3751762-2c74-451a-915d-450499bc323b",
                                                "sense_id": "dbb698cd-c38f-33b9-a5a5-1a67f3929cbc",
                                                "text": "„Er ließ ihn vollständig neu mit Kleidung, Schuhwerk und Kopfbedeckung versehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
