{
    "word_family": [
        "verstopping",
        "verstoppertje",
        "verstopplek"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e7f46e7a-8f14-305a-a11b-e61696fbe573",
                    "sense_definition": "iets op een plek leggen waar anderen het niet kunnen zien of vinden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verbergen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen wilden de paaseieren in de tuin <w>verstoppen</w> voor hun ouders.",
                            "target_lang_translations": {
                                "en": "The children wanted to <w>hide</w> the Easter eggs in the garden from their parents."
                            }
                        },
                        {
                            "text": "Je moet je geld goed <w>verstoppen</w> als je op reis gaat naar een drukke stad.",
                            "target_lang_translations": {
                                "en": "You should <w>hide</w> your money well when traveling to a busy city."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbergen"
                    ],
                    "antonyms": [
                        "onthullen"
                    ],
                    "common_phrases": [
                        "geld verstoppen",
                        "iets goed verstoppen"
                    ],
                    "target_lang_definitions": {
                        "en": "to put something in a place where others cannot see or find it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hide",
                                "target_lang_sense_clarification": "to put something out of sight"
                            },
                            {
                                "target_lang_word": "stash",
                                "target_lang_sense_clarification": "to store away for later use, often secretly"
                            },
                            {
                                "target_lang_word": "conceal",
                                "target_lang_sense_clarification": "to keep something from being observed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7ff5ce4-92e7-336d-91fa-4f8367fcb89b",
                    "sense_definition": "zichzelf op een onzichtbare plek plaatsen om niet gevonden te worden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verbergen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had <w>zich</w> achter de bank <w>verstopt</w> tijdens het spelletje.",
                            "target_lang_translations": {
                                "en": "He had <w>hidden</w> behind the couch during the game."
                            }
                        },
                        {
                            "text": "De dief probeerde <w>zich</w> in de donkere steeg te <w>verstoppen</w> voor de politie.",
                            "target_lang_translations": {
                                "en": "The thief tried to <w>hide</w> in the dark alley from the police."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbergen"
                    ],
                    "common_phrases": [
                        "zich verstoppen voor",
                        "zich ergens verstoppen"
                    ],
                    "target_lang_definitions": {
                        "en": "to place oneself in an invisible spot to avoid being found"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hide",
                                "target_lang_sense_clarification": "to put oneself out of sight"
                            },
                            {
                                "target_lang_word": "hide out",
                                "target_lang_sense_clarification": "to stay in a secret place to avoid detection"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e1cdee5-8c17-3346-bdaf-3b9e7a9f4ec1",
                    "sense_definition": "een doorgang of buis blokkeren zodat er niets meer doorheen kan",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "blokkeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De afvoer van het toilet <w>verstopte</w> doordat er te veel papier in gegooid was.",
                            "target_lang_translations": {
                                "en": "The toilet drain <w>clogged</w> because too much paper had been thrown in."
                            }
                        },
                        {
                            "text": "Je moet voorzichtig zijn dat vetresten de gootsteen niet <w>verstoppen</w>.",
                            "target_lang_translations": {
                                "en": "You must be careful that grease residues do not <w>clog</w> the sink."
                            }
                        }
                    ],
                    "synonyms": [
                        "blokkeren"
                    ],
                    "antonyms": [
                        "ontstoppen"
                    ],
                    "common_phrases": [
                        "de afvoer verstoppen",
                        "de gootsteen verstoppen"
                    ],
                    "target_lang_definitions": {
                        "en": "to block a passage or pipe so that nothing can pass through anymore"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clog",
                                "target_lang_sense_clarification": "to block a pipe or drain with dirt or grease"
                            },
                            {
                                "target_lang_word": "block",
                                "target_lang_sense_clarification": "to obstruct a passage"
                            },
                            {
                                "target_lang_word": "plug",
                                "target_lang_sense_clarification": "to stop up a hole or opening"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}