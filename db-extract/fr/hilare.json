                "senses": [
                    {
                        "sense_id": "f344f5e0-44e6-35e4-95c3-779dca24bdb0",
                        "entry_id": "e522a00f-30bc-3b9e-a50a-aa860c67f81b",
                        "glosses": [
                            "Qui est gai, riant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "692ba403-d57e-44f0-a620-c1c0c654b6f2",
                                "sense_id": "f344f5e0-44e6-35e4-95c3-779dca24bdb0",
                                "text": "De volumineux autobus arrivent, chargés à craquer : leur toit est même garni de paysans hilares assis en rang, à la place des marchandises, comme sur une impériale."
                            },
                            {
                                "example_id": "7736a622-e9a0-4696-a9ae-122dd4fbf1e8",
                                "sense_id": "f344f5e0-44e6-35e4-95c3-779dca24bdb0",
                                "text": "Il regagna sa place au volant et démarra fissa. Au bout de quelques mètres, il eut l'idée de brancher la sirène pour ne plus entendre la rumeur hilare qui se propageait dans les équipes de pétanquistes de la paisible place des Moulins."
                            },
                            {
                                "example_id": "2a0a658b-c1d4-4142-9699-1b572f980ee0",
                                "sense_id": "f344f5e0-44e6-35e4-95c3-779dca24bdb0",
                                "text": "L'Allemand éclata de rire et se retourna vers ses confrères, eux-mêmes hilares."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
