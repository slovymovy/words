                    }
                ],
                "senses": [
                    {
                        "sense_id": "d77787bc-b3b1-373d-af7c-1735c2cda595",
                        "entry_id": "c88897eb-d77e-391b-9e07-f5984a14f506",
                        "glosses": [
                            "To perform better than something or someone."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5a93dbc0-731a-4a3d-8c5b-2647f2d2ba83",
                                "sense_id": "d77787bc-b3b1-373d-af7c-1735c2cda595",
                                "text": "The strategy depends on an ability to outperform the market consistently, which many economists regard as virtually impossible."
                            },
                            {
                                "example_id": "d146dd12-8789-497a-815b-f80a94692d8f",
                                "sense_id": "d77787bc-b3b1-373d-af7c-1735c2cda595",
                                "text": "Rail has continued to outperform bus operations, where a decline in ridership continues."
                            },
                            {
                                "example_id": "e9b9431d-56e6-4213-90d5-4f1fa78ea7ab",
                                "sense_id": "d77787bc-b3b1-373d-af7c-1735c2cda595",
                                "text": "ChatGPT performs well at writing argumentative student essays and outperforms the quality of the human-written essays significantly."
                            },
                            {
                                "example_id": "12fef830-d1e2-448e-b7bf-6bb32f66735f",
                                "sense_id": "d77787bc-b3b1-373d-af7c-1735c2cda595",
                                "text": "It[China] had a buoyant economy outperforming forecasts. Its unemployment rate was among the lowest in years. While consolidating his power for a second term, Mr Xi proudly pointed to China's \"flourishing\" growth model as something other countries could emulate."
                            },
                            {
                                "example_id": "dee7dfb9-c600-44c8-8ba4-cb33d0dd6878",
                                "sense_id": "d77787bc-b3b1-373d-af7c-1735c2cda595",
                                "text": "When GPT-4 was tested by medical experts from Microsoft without any specialized prompt crafting, it exceeded the passing score on USMLE by over 20 points and outperformed earlier general-purpose models (GPT-3.5) as well as models specifically fine-tuned on medical knowledge (Med-PaLM, a prompt-tuned version of Flan-PaLM 540B) [13]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e90247d-56f2-4614-9997-ff5fc839c4b5",
                        "source_entry_id": "c88897eb-d77e-391b-9e07-f5984a14f506",
                        "source_sense_id": "d77787bc-b3b1-373d-af7c-1735c2cda595",
                        "source_sense_description": "Translations",
                        "target_lang_word": "superar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0649f267-2944-3a56-a406-ffb8c654d3a3",
                                        "entry_id": "37a95693-32b9-3952-b7c5-75292bd671e2",
                                        "glosses": [
                                            "Ser más, ser mejor, tener una cualidad superior a quien o aquello con que se compara."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c3af79d-0911-4404-a136-5a500603b9f6",
                                                "sense_id": "0649f267-2944-3a56-a406-ffb8c654d3a3",
                                                "text": "«Es evidente que una fuerza cualquiera, aplicada en determinada dirección, disminuye el valor máximo de cualquier otra posible fuerza aplicada en otra dirección, pues la resultante de ambas no puede superar el valor máximo (…)»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f06677e-0c93-380a-9a55-41c9905628cc",
                                        "entry_id": "37a95693-32b9-3952-b7c5-75292bd671e2",
                                        "glosses": [
                                            "Ir más allá del obstáculo o dificultad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16917e30-cbc3-471d-8926-312cc797fed9",
                                                "sense_id": "0f06677e-0c93-380a-9a55-41c9905628cc",
                                                "text": "«Es posible imaginar las fuerzas que se agitaban en el pecho de este joven cuando dejó su parroquia provinciana en Oaxaca. Un rasgo de fatalidad indígena le permitiría soportar muchas derrotas. Aunque formado en el medio de un pobre clérigo católico, Juárez adquiriría, con la profesión legal, una voluntad feroz de superar los obstáculos que le impedían a México convertirse en una nación moderna e independiente, entre ellos el poder excesivo de la Iglesia»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ad836975-9349-3212-9a62-5ad36b666a35",
                                        "entry_id": "37a95693-32b9-3952-b7c5-75292bd671e2",
                                        "glosses": [
                                            "Llegar más allá del límite impuesto o estimado como norma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55a4a1b9-7d0e-40ba-895d-2d358f1ace63",
                                                "sense_id": "ad836975-9349-3212-9a62-5ad36b666a35",
                                                "text": "«Eso es así porque la descolonización del pensamiento no se obtiene meramente con la preservación de la lengua y la cultura autóctona. Tan importante como lo primero es recobrar la fe y la esperanza en las posibilidades de su pueblo y superar la negación como ser humano a la cual nos tiene sometidos el colonialismo»."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdeecfb7-46a2-4103-8002-5247fcf2f66f",
                        "source_entry_id": "c88897eb-d77e-391b-9e07-f5984a14f506",
