                        "source_sense_id": "2a91f07d-767b-356f-9f09-f193539e1a83",
                        "source_sense_description": "Ware aus Glas",
                        "target_lang_word": "verrerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verrerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57487108-728e-394e-b4df-a12b72e41e3c",
                                        "entry_id": "9cca3ca5-9ed8-37dd-9156-bdce1d9e8959",
                                        "glosses": [
                                            "Fabrique de verre ou d’ouvrages de verre."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a11421b9-e684-4853-a865-878772c1d329",
                                                "sense_id": "57487108-728e-394e-b4df-a12b72e41e3c",
                                                "text": "Lorsqu'il fut à La-Val-Dieu, il s'approcha d'une verrerie dont les ouvreaux flamboyaient de rouges lueurs et dans la grande cour de laquelle il aperçut deux ouvriers."
                                            },
                                            {
                                                "example_id": "23c08c32-5bdb-403d-9ab3-dd97b8d3b346",
                                                "sense_id": "57487108-728e-394e-b4df-a12b72e41e3c",
                                                "text": "La verrerie de Nancy est de fondation récente, puisqu’elle date de 1875 seulement."
                                            },
                                            {
                                                "example_id": "98833e15-d0b6-4025-819f-825ae130a9a0",
                                                "sense_id": "57487108-728e-394e-b4df-a12b72e41e3c",
                                                "text": "En France, les premières grandes verreries chauffées au charbon ouvrent leurs portes dans les régions de Bordeaux et de Rouen autour de 1725."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb0da6cb-8bda-306f-883f-08e1302806e2",
                                        "entry_id": "9cca3ca5-9ed8-37dd-9156-bdce1d9e8959",
                                        "glosses": [
                                            "Art du verrier."
                                        ],
                                        "tags": [
                                            "Verrerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97f69cfe-4d25-42d3-a365-3d2159427e6b",
                                                "sense_id": "eb0da6cb-8bda-306f-883f-08e1302806e2",
                                                "text": "La verrerie et la cristallerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6543a8e4-1bd5-3e02-be23-5c18562c18ab",
                                        "entry_id": "9cca3ca5-9ed8-37dd-9156-bdce1d9e8959",
                                        "glosses": [
                                            "Commerce d’objets en verre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49ac1916-da12-4891-a675-2c52a3ebcd2f",
                                                "sense_id": "6543a8e4-1bd5-3e02-be23-5c18562c18ab",
                                                "text": "Vous trouverez les flûtes à champagne au rayon de verrerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71b01b3f-0cfc-34e4-b1e8-ee3a2b345040",
                                        "entry_id": "9cca3ca5-9ed8-37dd-9156-bdce1d9e8959",
                                        "glosses": [
                                            "Toute sorte d’ouvrages de verre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498ad833-9b34-4bf9-9280-1f574add6f95",
                                                "sense_id": "71b01b3f-0cfc-34e4-b1e8-ee3a2b345040",
