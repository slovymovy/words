                        "entry_id": "1c382d44-9b9e-3599-91ee-c61a7ad8cb4f",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "жи́листы"
                    },
                    {
                        "form_id": "9cfcad68-944d-4893-b59f-dcd48fe21eba",
                        "entry_id": "1c382d44-9b9e-3599-91ee-c61a7ad8cb4f",
                        "tags": [
                            "comparative"
                        ],
                        "form": "жи́листее"
                    },
                    {
                        "form_id": "267c1c16-1db0-4c42-84c2-01ed1237c99d",
                        "entry_id": "1c382d44-9b9e-3599-91ee-c61a7ad8cb4f",
                        "tags": [
                            "comparative"
                        ],
                        "form": "жи́листей"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fdb08d54-9c23-38dc-93b8-5edf5d1fd44a",
                        "entry_id": "1c382d44-9b9e-3599-91ee-c61a7ad8cb4f",
                        "glosses": [
                            "имеющий заметно выступающие жилы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3be13d72-fbfc-4b0d-a99c-642debcdd06a",
                                "sense_id": "fdb08d54-9c23-38dc-93b8-5edf5d1fd44a",
                                "text": "Жилистая толстая шея была, как у быка, покрыта клетчатыми складками."
                            },
                            {
                                "example_id": "de4b8441-d668-4370-8208-3c6c8291aaa0",
                                "sense_id": "fdb08d54-9c23-38dc-93b8-5edf5d1fd44a",
                                "text": "Это были страшные руки, худые, жилистые, костлявые, с распухшими оконечностями пальцев."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffad8b82-d2c8-3a23-ac46-ff57596beefa",
                        "entry_id": "1c382d44-9b9e-3599-91ee-c61a7ad8cb4f",
                        "glosses": [
                            "имеющий много жил, сухожилий (о мясе)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b61aa5ea-ea8d-4ad1-91ad-1089c82db635",
                                "sense_id": "ffad8b82-d2c8-3a23-ac46-ff57596beefa",
                                "text": "Действуя неторопливо, но споро, она исправно жевала даже и довольно жилистое мясо, данное на второе тоже под каким-то французско-кулинарным названием: вставные челюсти ее действовали хорошо."
                            },
                            {
                                "example_id": "9d0994c8-b35c-4e58-8e7a-684a44d2958f",
                                "sense_id": "ffad8b82-d2c8-3a23-ac46-ff57596beefa",
                                "text": "Курицу нельзя было достать; жарили и варили старых, лиловых, жилистых петухов."
                            },
                            {
                                "example_id": "4f024b5d-ca5e-473b-a8ea-ca6769e1615a",
                                "sense_id": "ffad8b82-d2c8-3a23-ac46-ff57596beefa",
                                "text": "Меня любой гадюке кусать резона нет, у меня мясо старое, жилистое, да к тому же от меня козлом воняет, ― потому как Трофим рядом со мной часто спит на сеновале, ― а гадюки козлиного духа не любят."
                            }
                        ]
                    },
                    {
                        "sense_id": "34e56bbd-6981-3afb-82f5-58ab1850b6a9",
                        "entry_id": "1c382d44-9b9e-3599-91ee-c61a7ad8cb4f",
                        "glosses": [
                            "перен. сухощавый, мускулистый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ada26cb9-d506-4f1f-9ee5-484704393526",
                                "sense_id": "34e56bbd-6981-3afb-82f5-58ab1850b6a9",
                                "text": "По движениям небольшой ноги, обутой в татарский, шитый серебром, сапожок, по твердому налеганию жилистой, сухощавой руки видна была в князе еще упорная и много выдерживающая сила свежей старости."
                            },
                            {
                                "example_id": "a21fd1af-81cf-4c40-b55a-35ccb29d91f0",
                                "sense_id": "34e56bbd-6981-3afb-82f5-58ab1850b6a9",
                                "text": "Святослав казался человеком среднего роста, но жилистые руки его, огромная голова, широкие плечи показывали необычайную силу его."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a58e336-4aad-3751-a3bb-0b660cb90d02",
                        "entry_id": "1c382d44-9b9e-3599-91ee-c61a7ad8cb4f",
                        "glosses": [
                            "перен. сильный, крепкий, выносливый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efca444a-6917-4cd5-b797-41e08dd888b5",
                                "sense_id": "0a58e336-4aad-3751-a3bb-0b660cb90d02",
                                "text": "В это же самое мгновение она почувствовала крепкие, жилистые руки свёкра вокруг своего стана, покрытого одною холщовой рубашкой."
                            },
                            {
                                "example_id": "6e1f3f2f-c59c-440a-bd75-a28081596777",
                                "sense_id": "0a58e336-4aad-3751-a3bb-0b660cb90d02",
                                "text": "Метал сам Круковский, невысокий, худой, но крепкий, как сталь, и жилистый мужчина, совершенно неопределенного возраста."
                            },
                            {
                                "example_id": "0b7aded9-4196-4c5c-b108-f71dd1214b49",
                                "sense_id": "0a58e336-4aad-3751-a3bb-0b660cb90d02",
                                "text": "Это был худой, длинный, жилистый, большой физической силы человек; на вид ему было за тридцать."
                            }
                        ]
                    }
                ],
