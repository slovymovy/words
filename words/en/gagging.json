                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gagging</w> smell of the rotten garbage filled the entire room.",
                            "target_lang_translations": {
