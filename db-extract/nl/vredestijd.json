                        "cross_references": []
                    },
                    {
                        "translation_id": "d39c2ab1-bfe8-4401-92cb-76addfeaa5cd",
                        "source_entry_id": "d9a5263e-4576-353b-b187-4f93f2b4a952",
                        "source_sense_id": "e7aaa87f-b573-3608-b380-fa895799239d",
                        "target_lang_word": "peace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c555cc7-693b-37f8-9e90-14d459a301a9",
                                        "entry_id": "821f5e45-8910-365b-9dd3-49191e078ba9",
                                        "glosses": [
                                            "A state of tranquility, quiet, and harmony. For instance, a state free from civil disturbance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e366b3aa-5b95-4924-8981-cfdde3e5e0a2",
                                                "sense_id": "4c555cc7-693b-37f8-9e90-14d459a301a9",
                                                "text": "Our lounge strives to maintain an environment of peace for the comfort of our customers."
                                            },
                                            {
                                                "example_id": "5946199f-7a29-41f0-b03a-8be4f3c5159a",
                                                "sense_id": "4c555cc7-693b-37f8-9e90-14d459a301a9",
                                                "text": "*Thinke not that I am come to ſend peace on earth: I came not to ſend peace, but a ſword."
                                            },
                                            {
                                                "example_id": "94f5ddf9-5e30-44ab-b53b-b936d3987578",
                                                "sense_id": "4c555cc7-693b-37f8-9e90-14d459a301a9",
                                                "text": "Naomi boasted in nothing but the God of Israel. And she found peace even in the midst of chaos when she went to Him in prayer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb25c660-f562-3074-b4df-299c5f63cf8a",
                                        "entry_id": "821f5e45-8910-365b-9dd3-49191e078ba9",
                                        "glosses": [
                                            "A state free of oppressive and unpleasant thoughts and emotions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a71de7a9-a864-407b-8c9b-dd2f8150872d",
                                                "sense_id": "eb25c660-f562-3074-b4df-299c5f63cf8a",
                                                "text": "The safety equipment will give me some peace of mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcd242c1-ec49-38fd-9484-8aa945c268b0",
                                        "entry_id": "821f5e45-8910-365b-9dd3-49191e078ba9",
                                        "glosses": [
                                            "Death."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b530926-5abc-45e4-86f4-59fc49866c6d",
                                                "sense_id": "dcd242c1-ec49-38fd-9484-8aa945c268b0",
                                                "text": "’Twere best at once to sink to peace,\n⁠Like birds the charming serpent draws,\n⁠To drop head-foremost in the jaws\nOf vacant darkness and to cease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32bf9828-e3ee-36fd-8618-4a74bbbd9d56",
                                        "entry_id": "821f5e45-8910-365b-9dd3-49191e078ba9",
                                        "glosses": [
                                            "Harmony in personal relations."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ecf08f3-c10f-34f4-979a-feb8280587b0",
                                        "entry_id": "821f5e45-8910-365b-9dd3-49191e078ba9",
                                        "glosses": [
                                            "A state free of war, in particular war between different countries."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06eb4377-0c10-42a4-a694-96c64bfdbde4",
                                                "sense_id": "1ecf08f3-c10f-34f4-979a-feb8280587b0",
                                                "text": "1969 March 31, John Lennon, Bagism Press Conference at Sacher Hotel, Vienna\nNow, a lot of cynics have said, “Oh, it’s easy to sit in bed for seven days,” but I’d like some of them to try it, and talk for seven days about peace. All we’re saying is give peace a chance."
                                            },
                                            {
                                                "example_id": "b3ab495a-82a1-4f37-9530-3fbb4f56d975",
                                                "sense_id": "1ecf08f3-c10f-34f4-979a-feb8280587b0",
                                                "text": "1993, Mark Berry as \"King Harkinian\", a character in Animation Magic, Link: The Faces of Evil, Philips Interactive Media (publ.).\nMy boy, this peace is what all true warriors strive for."
                                            },
                                            {
                                                "example_id": "62662af9-cc1b-43e4-9161-9fda7e8bb867",
                                                "sense_id": "1ecf08f3-c10f-34f4-979a-feb8280587b0",
                                                "text": "An uneasy peace descended upon Northern Ireland when the IRA agreed to a ceasefire in August 1994."
                                            },
                                            {
                                                "example_id": "bf44149c-e849-42be-a25e-d8ec8dd9776e",
                                                "sense_id": "1ecf08f3-c10f-34f4-979a-feb8280587b0",
                                                "text": "Whether modern, industrial man is less or more warlike than his hunter-gatherer ancestors is impossible to determine.[…]One thing that is true, though, is that murder rates have fallen over the centuries, as policing has spread and the routine carrying of weapons has diminished. Modern society may not have done anything about war. But peace is a lot more peaceful."
                                            },
                                            {
                                                "example_id": "5407053c-2bb1-4bba-9db6-900f183dbc25",
                                                "sense_id": "1ecf08f3-c10f-34f4-979a-feb8280587b0",
                                                "text": "May there be peace in our time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2fbc7ec-afd6-3dc0-8b6c-f5b1e5113a49",
                                        "entry_id": "f91e0cdf-58f2-3b02-b356-9cc7505594b5",
                                        "glosses": [
                                            "Shut up!, silence!; be quiet, be silent."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7008ee4b-f731-48ce-8ddf-bc9f2d4fb222",
                                                "sense_id": "e2fbc7ec-afd6-3dc0-8b6c-f5b1e5113a49",
                                                "text": "“Hark!” said the old woman, triumphantly. “I hear a step coming. […] Do you hear him?”\n“I believe you are right, mother,” replied Alice, in a low voice. “Peace! open the door.”"
                                            },
                                            {
                                                "example_id": "1f930480-c89c-4d38-b0fd-a975a0bce8ae",
                                                "sense_id": "e2fbc7ec-afd6-3dc0-8b6c-f5b1e5113a49",
                                                "text": "\"Peace, my lord, thou utterest treason! Hast forgot the king's command? Remember I am party to thy crime, if I but listen.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa5abdb6-bc3d-304c-9c0e-62e484c4e741",
                                        "entry_id": "f91e0cdf-58f2-3b02-b356-9cc7505594b5",
                                        "glosses": [
                                            "Peace out; goodbye."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "peace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa4b7ace-4589-33a2-b23d-82f2db976732",
                                        "entry_id": "4d386e0b-726e-3d82-80d3-5fc751972073",
                                        "glosses": [
                                            "To make peace; to put at peace; to be at peace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18e97b25-a496-450c-bcf2-cece613d5d6d",
                                                "sense_id": "aa4b7ace-4589-33a2-b23d-82f2db976732",
                                                "text": "Within every hood they have to be peacing with themselves. Then when you're living in peace with yourself, [...]"
                                            },
                                            {
                                                "example_id": "ac9b2d87-f8fa-4b17-944d-925bb28ae2db",
                                                "sense_id": "aa4b7ace-4589-33a2-b23d-82f2db976732",
                                                "text": "In another northern species, ptarmigan, such a see-saw pattern between warring and peacing has indeed been observed by researchers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4d5f381-a321-37e7-96e9-aea320b8c2cb",
                                        "entry_id": "4d386e0b-726e-3d82-80d3-5fc751972073",
                                        "glosses": [
                                            "To peace out."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfc4c6da-1747-4ee7-a153-f2c5b8687786",
                                                "sense_id": "b4d5f381-a321-37e7-96e9-aea320b8c2cb",
                                                "text": "Fuck, man. Yeah, I know. He crashed with this guy, Eddie. Then the cops called me in. That's when he peaced. I swear on my father's grave, I don't know where he went. I swear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af79f0b3-c08d-449a-a086-8ce753865879",
                        "source_entry_id": "d9a5263e-4576-353b-b187-4f93f2b4a952",
                        "source_sense_id": "e7aaa87f-b573-3608-b380-fa895799239d",
