{
    "word_family": [
        "youthful",
        "youthfully",
        "youthfulness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e774d6ee-2775-3731-be3f-2866382f8578",
                    "sense_definition": "The period of life between childhood and adulthood.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She traveled to many different countries in her <w>youth</w>.",
                            "target_lang_translations": {
                                "ru": "Она путешествовала по многим странам в <w>молодости</w>.",
                                "zh": "她在<w>青春</w>时代去过许多不同的国家。"
                            }
                        },
                        {
                            "text": "He regrets that he wasted his <w>youth</w> on unimportant things.",
                            "target_lang_translations": {
                                "ru": "Он жалеет, что потратил свою <w>молодость</w> на неважные вещи.",
                                "zh": "他后悔把<w>青春</w>浪费在无关紧要的事情上。"
                            }
                        }
                    ],
                    "antonyms": [
                        "old age",
                        "age"
                    ],
                    "common_phrases": [
                        "in my youth",
                        "days of youth",
                        "misspent youth",
                        "bloom of youth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период жизни между детством и взрослостью.",
                        "zh": "从童年到成年之间的生命阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молодость",
                                "target_lang_sense_clarification": "период жизни"
                            },
                            {
                                "target_lang_word": "юность",
                                "target_lang_sense_clarification": "ранняя молодость, отрочество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "青春",
                                "target_lang_sense_clarification": "指青年时期，常带有美好的色彩"
                            },
                            {
                                "target_lang_word": "年轻时代",
                                "target_lang_sense_clarification": "指年轻的那段时光"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c6e4043-807f-3477-aff8-64d1a5e29afa",
                    "sense_definition": "Young people considered as a group.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>youth</w> of today are very comfortable with modern technology.",
                            "target_lang_translations": {
                                "ru": "Современная <w>молодёжь</w> очень уверенно пользуется современными технологиями.",
                                "zh": "当代的<w>年轻人</w>非常适应现代科技。"
                            }
                        },
                        {
                            "text": "We need to provide more job opportunities for the nation's <w>youth</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужно создать больше рабочих мест для <w>молодёжи</w> страны.",
                                "zh": "我们需要为国家的<w>青年</w>提供更多的就业机会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "young people",
                        "adolescents",
                        "teenagers",
                        "youngsters",
                        "kids",
                        "younger generation"
                    ],
                    "common_phrases": [
                        "youth culture",
                        "youth club",
                        "youth hostel",
                        "today's youth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодые люди как социальная группа.",
                        "zh": "作为一个群体的年轻人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молодёжь",
                                "target_lang_sense_clarification": "собирательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "年轻人",
                                "target_lang_sense_clarification": "指代年轻人群体"
                            },
                            {
                                "target_lang_word": "青年",
                                "target_lang_sense_clarification": "指代青年一代"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "526006a2-7d25-3cef-acac-9d12b7144f3d",
                    "sense_definition": "The quality or state of being young.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her energy and <w>youth</w> made her popular with everyone in the office.",
                            "target_lang_translations": {
                                "ru": "Её энергия и <w>молодость</w> сделали её популярной среди всех в офисе.",
                                "zh": "她的活力和<w>年轻</w>使她在办公室里很受欢迎。"
                            }
                        },
                        {
                            "text": "He tried to maintain his <w>youth</w> by exercising every day.",
                            "target_lang_translations": {
                                "ru": "Он пытался сохранить <w>молодость</w>, тренируясь каждый день.",
                                "zh": "他试图通过每天锻炼来保持<w>年轻</w>的状态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "youthfulness",
                        "youngness"
                    ],
                    "antonyms": [
                        "age",
                        "old age"
                    ],
                    "common_phrases": [
                        "fountain of youth",
                        "eternal youth",
                        "restore youth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние молодости.",
                        "zh": "年轻的品质或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молодость",
                                "target_lang_sense_clarification": "состояние"
                            },
                            {
                                "target_lang_word": "юность",
                                "target_lang_sense_clarification": "свойство, свежесть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "年轻",
                                "target_lang_sense_clarification": "指状态或特质"
                            },
                            {
                                "target_lang_word": "青春活力",
                                "target_lang_sense_clarification": "指年轻所带来的生命力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e6a42e5-dbee-3f5d-966d-4d7e45cf48c1",
                    "sense_definition": "A young person, especially a male adolescent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>youth</w> was seen running away from the scene of the accident.",
                            "target_lang_translations": {
                                "ru": "Видели, как с места происшествия убегал <w>юноша</w>.",
                                "zh": "有人看到一个<w>少年</w>从事故现场跑开。"
                            }
                        },
                        {
                            "text": "The police arrested a <w>youth</w> in connection with the robbery.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала <w>юношу</w> в связи с ограблением.",
                                "zh": "警方逮捕了一名与抢劫案有关的<w>小伙子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adolescent",
                        "teenager",
                        "youngster",
                        "lad",
                        "young man",
                        "boy"
                    ],
                    "antonyms": [
                        "adult",
                        "grown-up"
                    ],
                    "common_phrases": [
                        "gang of youths",
                        "local youth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодой человек, особенно юноша-подросток.",
                        "zh": "一个年轻人，尤指男性青少年。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "юноша",
                                "target_lang_sense_clarification": "лицо мужского пола"
                            },
                            {
                                "target_lang_word": "молодой человек",
                                "target_lang_sense_clarification": "парень"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "少年",
                                "target_lang_sense_clarification": "指青少年"
                            },
                            {
                                "target_lang_word": "小伙子",
                                "target_lang_sense_clarification": "指年轻男性"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}