                "senses": [
                    {
                        "sense_id": "00e34ba3-86b5-3d36-b843-518bb219b599",
                        "entry_id": "28896568-f421-37f8-8831-b7efe25c0615",
                        "glosses": [
                            "Instrument ayant la forme d'un clavecin mais où les sons sont produits par le frottement de lames de laiton contre un cylindre d'acier tournant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95ed36be-0bf1-4b53-ab8b-adedc94ff458",
                                "sense_id": "00e34ba3-86b5-3d36-b843-518bb219b599",
                                "text": "Instrument à clavier, comme un piano, avec un registre du flûte. Le Mélodica descend jusqu'au sol grave de violon ; il a été inventé par André Stein d'Augsbourg."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc461f1c-0740-31d2-9003-f659b42b9b00",
                        "entry_id": "28896568-f421-37f8-8831-b7efe25c0615",
                        "glosses": [
                            "Instrument à vent apparenté à un harmonica mais comportant un clavier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8486f13-bd4c-40c5-b331-f642f9cdb3c4",
                                "sense_id": "bc461f1c-0740-31d2-9003-f659b42b9b00",
                                "text": "Mélodica et accordina sont des instruments à anches libres insufflés à la bouche"
                            },
                            {
                                "example_id": "f64bffce-364d-4bdb-be81-fe9063182c8c",
                                "sense_id": "bc461f1c-0740-31d2-9003-f659b42b9b00",
                                "text": "Sur un rythme alangui, Albarn se débarrasse de l’instrumentation rock qui marquait jusqu’ici l’essentiel de ses enregistrements et opte pour le mélodica comme instrument prédominant."
                            }
                        ]
                    }
