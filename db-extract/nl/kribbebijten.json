                                    {
                                        "sense_id": "23997707-4fae-3e89-bc2f-707cce142237",
                                        "entry_id": "70874551-e9a8-31b4-a959-b0af030d4dfd",
                                        "glosses": [
                                            "Qualifie un cheval ou une jument qui tique."
