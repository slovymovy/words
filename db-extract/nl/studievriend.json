                            {
                                "example_id": "e6d40e3d-d943-49f9-bbb9-aed27d0f739a",
                                "sense_id": "e2ba34b4-df1c-32f4-8695-ea530f72a1b7",
                                "text": "Levin was tijdens zijn verblijf in Moskou opnieuw in nauw contact gekomen met zijn vroegere studievriend professor Katavasov die hij sinds zijn huwelijk niet meer had gesproken."
                            },
                            {
                                "example_id": "17df86ec-6754-4d6a-8d6a-eeb182e520ef",
                                "sense_id": "e2ba34b4-df1c-32f4-8695-ea530f72a1b7",
                                "text": "Een studievriend van de man die tot de doodstraf is veroordeeld voor de bomaanslag tijdens de marathon van Boston, heeft een celstraf van zes jaar gekregen voor het verduisteren van bewijs. Dias Kadyrbajev (21) heeft bekend dat hij de rechtsgang heeft verstoord door spullen weg te halen uit de kamer van Tsarnajev, nadat hij hem had herkend op foto's van de FBI."
                            }
                        ]
