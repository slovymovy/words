                "senses": [
                    {
                        "sense_id": "b4b2b98e-1dfe-3ba4-adcd-86cdfc194fb5",
                        "entry_id": "c486a82a-e84c-3c10-9f3c-e9e4b41c6186",
                        "glosses": [
                            "Qualifie ce qui nivèle."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "13040c3a-36a4-4444-b631-ada39abd0ada",
                                "sense_id": "b4b2b98e-1dfe-3ba4-adcd-86cdfc194fb5",
                                "text": "La démocratie recèle cependant une étonnante capacité à contenir comme à trivialiser la révolte. À la contenir, tant le pouvoir niveleur de l’égalité est, au fond, antihéroïque."
                            },
                            {
                                "example_id": "2726e442-e697-4ad1-ab99-3fda55bdea0e",
                                "sense_id": "b4b2b98e-1dfe-3ba4-adcd-86cdfc194fb5",
                                "text": "Toutes ces vieilles coutumes ajoutent une note pittoresque à la vie de Santa-Cruz ; mais elles finiront probablement bientôt par disparaître, emportées par le modernisme niveleur."
                            }
                        ]
                    }
