{
    "word_family": [
        "lunch"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "026e759f-a445-345d-a129-def33852aad6",
                    "sense_definition": "A midday meal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Have you already had your <w>luncheon</w> today?",
                            "target_lang_translations": {
                                "nl": "Heb je vandaag al <w>geluncht</w>?"
                            }
                        },
                        {
                            "text": "We decided to meet for a quick <w>luncheon</w> at the park.",
                            "target_lang_translations": {
                                "nl": "We besloten om af te spreken voor een snelle <w>lunch</w> in het park."
                            }
                        }
                    ],
                    "common_phrases": [
                        "midday luncheon"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een maaltijd rond het middaguur."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "lunch",
                                "target_lang_sense_clarification": "De meest gebruikelijke term voor een maaltijd rond het middaguur."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a4189a9-2282-3951-8173-c5bac7abecdc",
                    "sense_definition": "A formal meal served in the middle of the day.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hosted a formal <w>luncheon</w> to celebrate the new partnership.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf organiseerde een formele <w>lunch</w> om het nieuwe partnerschap te vieren."
                            }
                        },
                        {
                            "text": "Guests were invited to a charity <w>luncheon</w> held at the grand hotel.",
                            "target_lang_translations": {
                                "nl": "Gasten werden uitgenodigd voor een liefdadigheids<w>lunch</w> in het grote hotel."
                            }
                        }
                    ],
                    "common_phrases": [
                        "formal luncheon"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een formele maaltijd die rond het middaguur wordt geserveerd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "middaglunch",
                                "target_lang_sense_clarification": "Een formele lunchbijeenkomst."
                            },
                            {
                                "target_lang_word": "feestelijke lunch",
                                "target_lang_sense_clarification": "Een formele of feestelijke maaltijd overdag."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29c09bf8-2f21-3549-ad82-4245571d146f",
                    "sense_definition": "A type of cheap, processed sausage served in thin slices.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a simple sandwich using bread and a few slices of <w>luncheon</w>.",
                            "target_lang_translations": {
                                "nl": "Hij maakte een simpele boterham met brood en een paar plakjes <w>boterhamworst</w>."
                            }
                        },
                        {
                            "text": "The deli counter sells various types of <w>luncheon</w> meat.",
                            "target_lang_translations": {
                                "nl": "De toonbank van de delicatessenwinkel verkoopt verschillende soorten <w>vleeswaren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Belgium",
                        "devon",
                        "fritz",
                        "polony"
                    ],
                    "common_phrases": [
                        "luncheon meat"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Australia and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een soort goedkope, bewerkte worst die in dunne plakjes wordt geserveerd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "boterhamworst",
                                "target_lang_sense_clarification": "Een type bewerkte vleeswaar voor op brood."
                            },
                            {
                                "target_lang_word": "lunchworst",
                                "target_lang_sense_clarification": "Een algemene term voor bewerkte vleeswaren."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9960b889-f1ce-3612-a67a-e5b3a74c6c13",
                    "sense_definition": "To eat a midday meal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The colleagues decided to <w>luncheon</w> at the nearby bistro.",
                            "target_lang_translations": {
                                "nl": "De collega's besloten te <w>lunchen</w> bij de bistro in de buurt."
                            }
                        },
                        {
                            "text": "They were <w>luncheoning</w> together when the news arrived.",
                            "target_lang_translations": {
                                "nl": "Ze waren samen aan het <w>lunchen</w> toen het nieuws binnenkwam."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een maaltijd rond het middaguur nuttigen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "lunchen",
                                "target_lang_sense_clarification": "Het werkwoord voor het eten van een lunch."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}