                                    {
                                        "sense_id": "75b1aea7-f37c-3bc4-b367-3527cdcd18d2",
                                        "entry_id": "45669be3-6aef-36d8-8723-a63c1356e133",
                                        "glosses": [
                                            "Buch mit Liedern und Liedtexten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60b06f26-3f8d-4b34-b879-f64c91dc0f41",
                                                "sense_id": "75b1aea7-f37c-3bc4-b367-3527cdcd18d2",
                                                "text": "Wir singen jetzt Lied Nr. 140 aus dem Liederbuch."
                                            },
                                            {
                                                "example_id": "0157d0ab-fa8d-45b9-b5cb-d19c030d350d",
                                                "sense_id": "75b1aea7-f37c-3bc4-b367-3527cdcd18d2",
                                                "text": "„Erst da spaltete sich die Versammlung; in Färinger, die gerne sangen, und in Isländer, die als ausgesprochene Leseratten viel lieber den Text vom Blatt ablasen und sich völlig über dem kopierten Liederbuch vergaßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
