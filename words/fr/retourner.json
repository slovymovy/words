{
    "word_family": [
        "retour",
        "retournement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4fc57e33-b151-388b-ac60-173443448e2f",
                    "sense_definition": "Revenir à l'endroit où l'on était auparavant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après les vacances, nous devons <w>retourner</w> au travail dès lundi matin."
                        },
                        {
                            "text": "Il a oublié ses clés et doit <w>retourner</w> chez lui pour les prendre."
                        }
                    ],
                    "synonyms": [
                        "revenir",
                        "rentrer"
                    ],
                    "antonyms": [
                        "partir",
                        "quitter"
                    ],
                    "common_phrases": [
                        "retourner chez soi",
                        "retourner au travail"
                    ]
                },
                {
                    "sense_id": "f4a75767-e2bc-3144-a42f-99d99dbfe95b",
                    "sense_definition": "Changer l'orientation ou la face visible d'un objet en le tournant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>retourner</w> la crêpe dans la poêle pour cuire l'autre côté."
                        },
                        {
                            "text": "Le joueur <w>retourne</w> la première carte du paquet devant tous ses adversaires."
                        }
                    ],
                    "synonyms": [
                        "inverser"
                    ],
                    "common_phrases": [
                        "retourner une crêpe",
                        "retourner une carte"
                    ]
                },
                {
                    "sense_id": "0347e7bc-cbce-3f86-a97d-c754e1e15ba3",
                    "sense_definition": "Tourner son corps ou sa tête en arrière ou dans une autre direction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En entendant ce bruit étrange, elle se <w>retourne</w> pour regarder derrière elle."
                        },
                        {
                            "text": "Le conducteur s'est <w>retourné</w> brusquement pour parler aux passagers assis à l'arrière."
                        }
                    ],
                    "common_phrases": [
                        "se retourner brusquement",
                        "se retourner pour regarder"
                    ]
                },
                {
                    "sense_id": "0275eeef-4c47-3a63-8a0e-73300b3c2924",
                    "sense_definition": "Renvoyer un colis, une marchandise ou un document à son expéditeur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "renvoi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vêtement est trop grand, je vais donc <w>retourner</w> le colis demain matin."
                        },
                        {
                            "text": "Veuillez signer et <w>retourner</w> ce formulaire par courrier avant la fin du mois."
                        }
                    ],
                    "synonyms": [
                        "renvoyer",
                        "restituer"
                    ],
                    "antonyms": [
                        "garder",
                        "conserver"
                    ],
                    "common_phrases": [
                        "retourner un colis",
                        "retourner un article"
                    ]
                },
                {
                    "sense_id": "01338dfa-c7c0-36d6-8934-694c7bd8a604",
                    "sense_definition": "Mettre en désordre complet un lieu en cherchant partout avec insistance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recherche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les cambrioleurs ont <w>retourné</w> toute la maison pour trouver des bijoux de valeur."
                        },
                        {
                            "text": "J'ai dû <w>retourner</w> ma chambre pendant des heures pour retrouver mon passeport égaré."
                        }
                    ],
                    "synonyms": [
                        "fouiller",
                        "saccager"
                    ],
                    "antonyms": [
                        "ranger"
                    ],
                    "common_phrases": [
                        "retourner une pièce",
                        "retourner la maison"
                    ]
                },
                {
                    "sense_id": "841ec9e7-74ba-3900-9200-8f9faf602f1b",
                    "sense_definition": "Bêcher ou labourer la terre pour l'aérer ou la préparer aux cultures.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier commence à <w>retourner</w> la terre avant d'y planter les légumes de printemps."
                        },
                        {
                            "text": "Il a passé l'après-midi à <w>retourner</w> le sol du potager avec sa bêche."
                        }
                    ],
                    "synonyms": [
                        "bêcher",
                        "labourer"
                    ],
                    "common_phrases": [
                        "retourner la terre",
                        "retourner le sol"
                    ]
                },
                {
                    "sense_id": "152771e4-9fe3-39fd-99c6-fb6875638cc4",
                    "sense_definition": "Émouvoir vivement, troubler ou bouleverser quelqu'un sur le plan émotionnel ou physique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette terrible nouvelle a complètement <w>retourné</w> toute la famille pendant plusieurs jours."
                        },
                        {
                            "text": "L'odeur insupportable de ce plat avarié m'a tout de suite <w>retourné</w> l'estomac."
                        }
                    ],
                    "synonyms": [
                        "bouleverser",
                        "troubler"
                    ],
                    "antonyms": [
                        "apaiser",
                        "rassurer"
                    ],
                    "common_phrases": [
                        "retourner l'estomac",
                        "retourner le cœur"
                    ]
                },
                {
                    "sense_id": "abfb6bc2-6e39-3ae4-865e-c0ad1115b0a1",
                    "sense_definition": "Trouver un moyen d'action ou s'adapter face à des circonstances imprévues.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son entreprise a fait faillite, mais il a vite su se <w>retourner</w> financièrement."
                        },
                        {
                            "text": "L'annonce soudaine de son départ ne nous a pas laissé le temps de nous <w>retourner</w>."
                        }
                    ],
                    "synonyms": [
                        "s'adapter",
                        "s'organiser"
                    ],
                    "common_phrases": [
                        "avoir le temps de se retourner",
                        "savoir comment se retourner"
                    ]
                },
                {
                    "sense_id": "7e687303-992e-31ee-88e8-4993c05d52aa",
                    "sense_definition": "S'agir de quelque chose, dans la formule « savoir de quoi il retourne ».",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de prendre une décision définitive, je tiens à savoir de quoi il <w>retourne</w> exactement."
                        },
                        {
                            "text": "Les enquêteurs ont fini par comprendre de quoi il <w>retournait</w> dans cette affaire complexe."
                        }
                    ],
                    "common_phrases": [
                        "savoir de quoi il retourne",
                        "ignorer de quoi il retourne"
                    ]
                },
                {
                    "sense_id": "255cc66e-523e-3a9d-948d-2082cb0eb482",
                    "sense_definition": "Amener une personne ou un groupe à changer d'avis, de camp ou de loyauté.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à son discours captivant, l'orateur a réussi à <w>retourner</w> l'opinion de la foule hostile."
                        },
                        {
                            "text": "Les services secrets ont tenté de <w>retourner</w> cet espion ennemi en lui offrant l'immunité."
                        }
                    ],
                    "synonyms": [
                        "rallier"
                    ],
                    "common_phrases": [
                        "retourner l'opinion",
                        "retourner un agent"
                    ]
                }
            ]
        }
    ]
}