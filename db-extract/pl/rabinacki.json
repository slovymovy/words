                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da970083-23de-4172-a7df-9494f31b84fe",
                        "source_entry_id": "41c76f40-6235-37aa-8f94-7e756c94b8a5",
                        "source_sense_id": "061f5397-2923-3f9e-a719-53a47b86fd2f",
                        "target_lang_word": "rabbinic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rabbinic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "255b1c57-c62a-3bd0-b730-8c1d30a39fcc",
                                        "entry_id": "0d7d727d-bd77-359b-be53-33c533b022d2",
                                        "glosses": [
                                            "Relating to rabbis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9503d8d7-0bed-4549-93f2-f60d7574303c",
                                                "sense_id": "255b1c57-c62a-3bd0-b730-8c1d30a39fcc",
                                                "text": "Yoni was hired as the shul's cantor, but he has a very rabbinic attitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5327032-f584-3799-ae0d-de40412c27d6",
                                        "entry_id": "0d7d727d-bd77-359b-be53-33c533b022d2",
                                        "glosses": [
                                            "Formulated or enacted by rabbis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "607cceb4-6b76-48bc-b81f-c45c38b4f265",
                                                "sense_id": "d5327032-f584-3799-ae0d-de40412c27d6",
                                                "text": "Even though some modern Jews are less interested in rabbinic enactments than the traditions that have explicit roots in Biblical law, most still practice customs that would not exist without rabbinic innovation."
                                            },
                                            {
                                                "example_id": "fe88bb4b-b2ff-4618-99d9-e762ea193f6f",
                                                "sense_id": "d5327032-f584-3799-ae0d-de40412c27d6",
                                                "text": "The book significantly extends on Rosenstein’s monumental 1990 work, “The Unbroken Chain,” which focused on the genealogies of the major Ashkenazi rabbinic dynasties from medieval times to the present."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b47f17a3-4bf4-4d85-b733-819b67d8e114",
                        "source_entry_id": "41c76f40-6235-37aa-8f94-7e756c94b8a5",
                        "source_sense_id": "061f5397-2923-3f9e-a719-53a47b86fd2f",
                        "target_lang_word": "rabbinical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rabbinical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29784af4-e56e-3260-b406-c9de7221ef19",
                                        "entry_id": "e20eb77d-e6ed-3e03-8ff2-a79c9b4de15a",
                                        "glosses": [
                                            "Of or relating to rabbis, their writings, or their work."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5155621-1808-4eac-836b-634c2a87adc8",
                                                "sense_id": "29784af4-e56e-3260-b406-c9de7221ef19",
                                                "text": "1581, Robert Parsons, A Brief Censure vppon Two Bookes Written in Answere to M. Edmonde Campions Offer of Disputation, Doway: John Lyon, “Towching the Societie,” section heading,\nThree kyndes of Rabbinical expositions of the Law."
                                            },
                                            {
                                                "example_id": "9c13d556-f5e3-42ff-b1d6-29ba25f70454",
                                                "sense_id": "29784af4-e56e-3260-b406-c9de7221ef19",
                                                "text": "to gain a little Rabbinical Learning, and find out some unobvious signification of a Word or Phrase, he must devour the tedious and voluminous Rhapsodies that make up the Talmud, in many of which he can scarce learn any thing but the Art of saying nothing in a multitude of words;"
                                            },
                                            {
                                                "example_id": "b81b39d8-4bb7-476b-8dd8-ed0f85d2888a",
                                                "sense_id": "29784af4-e56e-3260-b406-c9de7221ef19",
                                                "text": "1766, Elizabeth Griffith, The Double Mistake, London: J. Almon et al., Act I, Scene 3,\nHer father was a very learned divine, and who can tell but she may understand the rabbinical text?"
                                            },
                                            {
                                                "example_id": "e0659497-935c-4f8a-a5be-2e78971112d8",
                                                "sense_id": "29784af4-e56e-3260-b406-c9de7221ef19",
                                                "text": "Deronda was reading a piece of rabbinical Hebrew under Ezra’s correction and comment […]"
                                            },
                                            {
                                                "example_id": "888ab85c-ed5d-49a5-b020-013d2a5bceaf",
                                                "sense_id": "29784af4-e56e-3260-b406-c9de7221ef19",
                                                "text": "Oh, please, […] I’m a big boy now—so you can knock off the rabbinical righteousness. It turns out to be a little laughable at this stage of the game."
                                            },
                                            {
                                                "example_id": "85560752-1412-4c67-98ed-751824bef6ac",
                                                "sense_id": "29784af4-e56e-3260-b406-c9de7221ef19",
                                                "text": "The new book enlarges the genealogical pyramid, connecting it to Rabbi Jehiel Lurie, head of the 13th-century rabbinical court in Brest-Litovsk, then back to Rashi and beyond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59619a3f-f151-4644-a86d-c8249844c5cc",
                        "source_entry_id": "41c76f40-6235-37aa-8f94-7e756c94b8a5",
                        "source_sense_id": "061f5397-2923-3f9e-a719-53a47b86fd2f",
                        "target_lang_word": "rabínský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rabínský",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2ef74002-7638-33da-bbd3-af2e9b3c5596",
                                        "entry_id": "7cc7a7e1-b415-39b7-b98e-96222b70bbef",
                                        "glosses": [
                                            "vztahující se k rabínovi, rabínům nebo rabínství"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8071ed47-517a-419b-998c-b5bf7ec13e28",
                                                "sense_id": "2ef74002-7638-33da-bbd3-af2e9b3c5596",
                                                "text": "U náměstí stojí rabínský dům."
                                            },
                                            {
                                                "example_id": "12e2b8c4-e149-43fc-958f-1e3b37e3ec2e",
                                                "sense_id": "2ef74002-7638-33da-bbd3-af2e9b3c5596",
                                                "text": "Izák ben Jákob ha-Laban (z „Albis“, Labe) byl rabínský učitel v Praze a bratr Pethajaha z Řezna, který se na své cesty vydával z Prahy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87b8dd5a-d76f-3152-8a2b-d0e999e0eadf",
                                        "entry_id": "7cc7a7e1-b415-39b7-b98e-96222b70bbef",
                                        "glosses": [
                                            "vztahující se k náboženským předpisům, které nepocházejí přímo od Boha, ale byly vytvořeny lidmi"
                                        ],
                                        "tags": [
                                            "v judaismu"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc8f3cb5-7379-4b87-b093-9999d39d98a9",
                                                "sense_id": "87b8dd5a-d76f-3152-8a2b-d0e999e0eadf",
                                                "text": "Ve sbírkách ŽMP však najdeme jeden povijan, který biblický a rabínský zákaz směšování lnu a vlny porušuje: na lněném plátně je výšivka provedena vlněnou přízí."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90c231d0-a284-3e19-814f-eed3eb3471dc",
                                        "entry_id": "7cc7a7e1-b415-39b7-b98e-96222b70bbef",
                                        "glosses": [
                                            "vztahující se k variantě judaismu, která uznává závaznost ústní tóry, případně k období, ve kterém tato varianta převažuje"
                                        ],
                                        "tags": [
                                            "v judaismu"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcdf1bb0-d3cb-4094-ad31-b336feb43e04",
                        "source_entry_id": "41c76f40-6235-37aa-8f94-7e756c94b8a5",
                        "source_sense_id": "061f5397-2923-3f9e-a719-53a47b86fd2f",
                        "target_lang_word": "rabbinique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rabbinique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0bafb015-89c0-36f8-904d-627e33f1e151",
                                        "entry_id": "51615489-e89f-3eb5-99e9-cc30de44174a",
                                        "glosses": [
                                            "Relatif aux rabbins, particulier aux rabbins."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ec8caf4-4636-4f0d-bc77-9d9054bb1156",
                                                "sense_id": "0bafb015-89c0-36f8-904d-627e33f1e151",
                                                "text": "Hébreu rabbinique, hébreu post-biblique."
                                            },
                                            {
                                                "example_id": "15ca3921-b99e-4c38-a13e-06fbe43b405d",
                                                "sense_id": "0bafb015-89c0-36f8-904d-627e33f1e151",
                                                "text": "Le caractère rabbinique est différent de l’hébraïque ordinaire."
                                            },
                                            {
                                                "example_id": "3d4db122-3ae1-4401-82e0-7c3c61b82397",
                                                "sense_id": "0bafb015-89c0-36f8-904d-627e33f1e151",
                                                "text": "Mais qui es-tu pour croire que tu peux parler des Écritures ! Qui es-tu pour donner des conseils aux autres ? As-tu fait une école rabbinique ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77615249-4d47-32f3-846e-816a65cb7664",
                                        "entry_id": "51615489-e89f-3eb5-99e9-cc30de44174a",
                                        "glosses": [
                                            "Qui a été formulé par les rabbins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec72aa6a-6aee-49a0-9a10-53a379619b27",
                                                "sense_id": "77615249-4d47-32f3-846e-816a65cb7664",
                                                "text": "Interprétation rabbinique."
                                            },
                                            {
                                                "example_id": "f7041274-7113-481f-90f5-d89ecd443754",
                                                "sense_id": "77615249-4d47-32f3-846e-816a65cb7664",
                                                "text": "— Je soutiendrai envers et contre tous que le Toldos-jeschu, où cet ignorant pasquin de Voltaire a puisé tant de sottes fables, dignes des Mille et une Nuits, n’est qu’une méchante ineptie rabbinique, indigne de figurer dans la bibliothèque d’un savant !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
