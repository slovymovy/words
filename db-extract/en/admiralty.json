        "de-extract.jsonl": [
            {
                "entry_id": "e9ed806d-d699-398f-9879-19b767136a9f",
                "word": "admiralty",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d8a7b035-18fe-30f5-99a4-c3caad21d46d",
                        "entry_id": "e9ed806d-d699-398f-9879-19b767136a9f",
                        "glosses": [
                            "ehemals oberste Behörde der Marine; Admiralität"
                        ],
                        "tags": [
                            "British",
                            "historical"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01e67fd7-1919-4210-9ab6-3c7d058867ef",
                        "source_entry_id": "e9ed806d-d699-398f-9879-19b767136a9f",
                        "source_sense_id": "d8a7b035-18fe-30f5-99a4-c3caad21d46d",
                        "source_sense_description": "britisch, historisch: ehemals oberste Behörde der Marine; Admiralität",
                        "target_lang_word": "Admiralität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Admiralität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce2a50ba-525d-37bd-9036-19b06919dadf",
                                        "entry_id": "a2868e35-3aa5-3364-9652-302d6762493b",
                                        "glosses": [
                                            "oberste Behörde für das Kommando und die Verwaltung der Kriegsmarine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af3d517-aa61-4d56-bd01-12ea3d0c2826",
                                                "sense_id": "ce2a50ba-525d-37bd-9036-19b06919dadf",
                                                "text": "„Am Heck wehte die Flagge der britischen Admiralität.“"
                                            },
                                            {
                                                "example_id": "929c38c7-8e2d-4ed4-aeaf-2f2876ad57c9",
                                                "sense_id": "ce2a50ba-525d-37bd-9036-19b06919dadf",
                                                "text": "„Cook hatte drei Jahrzehnte auf See verbracht, hatte ein volles und strapaziöses Berufsleben in der Schifffahrt hinter sich, wie schon aus der Tatsache zu ersehen ist, dass die Admiralität ihm anfänglich einen komfortablen Alterssitz im Hospital von Greenwich gewährt hatte.“"
                                            },
                                            {
                                                "example_id": "3f022fd7-27d9-4591-bab3-90bb14f06c5d",
                                                "sense_id": "ce2a50ba-525d-37bd-9036-19b06919dadf",
                                                "text": "„Ein Ort, wie geschaffen für die Admiralität und die deutsche Kriegsmarine, die ihren Stützpunkt im nur 14 Kilometer entfernten Hafen von Saint-Nazaire einrichtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "567e09c0-64a8-31ab-bfea-c6be08da8190",
                                        "entry_id": "a2868e35-3aa5-3364-9652-302d6762493b",
                                        "glosses": [
                                            "Gesamtheit der Admirale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "affb767c-1e67-420b-bc98-6a3869152f6e",
                                                "sense_id": "567e09c0-64a8-31ab-bfea-c6be08da8190",
                                                "text": "„Bald ist der sonnendurchleuchtete Raum gefüllt. Die gesamte Admiralität und die in Berlin anwesende Generalität war in der Trauerversammlung vertreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
