                        "cross_references": [
                            {
                                "target_word": "repercussion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f679a34c-3a02-34be-a353-c3cd05bba3ab",
                                        "entry_id": "8e2ae690-98b7-39d8-8b04-c1dfe54289ac",
                                        "glosses": [
                                            "A consequence or ensuing result of some action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb1073ef-3cf6-4a63-8104-73bb1057212f",
                                                "sense_id": "f679a34c-3a02-34be-a353-c3cd05bba3ab",
                                                "text": "You realize this little stunt of yours is going to have some pretty serious repercussions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a19a0064-303c-3cfb-bb95-178f2f6c2582",
                                        "entry_id": "8e2ae690-98b7-39d8-8b04-c1dfe54289ac",
                                        "glosses": [
                                            "The act of driving back, or the state of being driven back; reflection; reverberation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b0946ca-9ce3-4bd7-afd6-ead667ce645b",
                                                "sense_id": "a19a0064-303c-3cfb-bb95-178f2f6c2582",
                                                "text": "the repercussion of sound"
                                            },
                                            {
                                                "example_id": "9d3e5bf8-7e36-47c8-9d50-0081cfc1495c",
                                                "sense_id": "a19a0064-303c-3cfb-bb95-178f2f6c2582",
                                                "text": "Ever echoing back in endless repercussion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5638ecd2-cdf3-3a71-a07e-9ee684a6ed62",
                                        "entry_id": "8e2ae690-98b7-39d8-8b04-c1dfe54289ac",
                                        "glosses": [
                                            "Rapid reiteration of the same sound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9c485b9-16ce-3dc0-8768-10f45c427007",
                                        "entry_id": "8e2ae690-98b7-39d8-8b04-c1dfe54289ac",
                                        "glosses": [
                                            "The subsidence of a tumour or eruption by the action of a repellent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "132e48e7-37c7-363a-9ac4-633279cd7e5c",
                                        "entry_id": "8e2ae690-98b7-39d8-8b04-c1dfe54289ac",
                                        "glosses": [
                                            "In a vaginal examination, the act of imparting through the uterine wall with the finger a shock to the foetus, so that it bounds upward, and falls back again against the examining finger."
                                        ],
                                        "tags": [
