        "fr-extract.jsonl": [
            {
                "entry_id": "b022619c-87e3-357d-bc22-adb3f7db5477",
                "word": "consternation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "73fcd8eb-1aad-440b-a61b-825bbb69cf83",
                        "entry_id": "b022619c-87e3-357d-bc22-adb3f7db5477",
                        "tags": [
                            "plural"
                        ],
                        "form": "consternations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                        "entry_id": "b022619c-87e3-357d-bc22-adb3f7db5477",
                        "glosses": [
                            "Abattement profond à la suite de quelque accident inattendu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c104d68-03d1-4122-b35f-251562b46aa4",
                                "sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                                "text": "Valère regardait la planche-contact avec une certaine consternation."
                            },
                            {
                                "example_id": "1bbffe2d-bba3-44a1-9e86-defe4e013b87",
                                "sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                                "text": "Le 10 de ce mois, un triste accident a jeté la consternation dans un des quartiers de la paroisse St.-Jacques."
                            },
                            {
                                "example_id": "8d18f0ee-5f93-41f5-bfb6-275d742f87d5",
                                "sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                                "text": "Un soir pluvieux, Corinne laissa entendre qu'elle était amoureuse. J'allais m'en montrer consterné mais je craignis que ma consternation ne prêtât à confusion et ne fût mal interprétée : il ne fallait pas qu'elle m’imaginât épris d'elle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d0df85b-0b92-469c-8d5f-79252e327550",
                        "source_entry_id": "b022619c-87e3-357d-bc22-adb3f7db5477",
                        "source_sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                        "target_lang_word": "consternation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consternation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                        "entry_id": "c953c29d-b9c5-3f61-852f-825947492f3a",
                                        "glosses": [
                                            "Amazement or horror that confounds the faculties, and incapacitates for reflection; terror, combined with amazement; dismay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098bfb65-8e1b-4454-bae9-e14445728e4d",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "\"Out!\" exclaimed her husband, with something like genuine consternation in his voice."
                                            },
                                            {
                                                "example_id": "602baf81-173e-4c3e-9592-ba81593c7eac",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "Their audience had been listening in increasing consternation."
                                            },
                                            {
                                                "example_id": "48b24c20-55c4-46c7-89d5-0265fe6cc51c",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "It was probably worth four millennia of consternation and regret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "596a1636-1830-451c-be35-62df0b1315be",
                        "source_entry_id": "b022619c-87e3-357d-bc22-adb3f7db5477",
                        "source_sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                        "target_lang_word": "dismay",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dismay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfc704a7-3f12-36b4-95f4-8d0efec65315",
                                        "entry_id": "7f3e1e92-46ed-36ea-8cc8-ba9defd725cb",
                                        "glosses": [
                                            "To cause to feel apprehension; great sadness, or fear; to deprive of energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36d314cf-7be3-4555-a1f8-9648e3ebf221",
                                                "sense_id": "bfc704a7-3f12-36b4-95f4-8d0efec65315",
                                                "text": "Be not afraid, neither be thou dismayed."
                                            },
                                            {
                                                "example_id": "d6d2b110-d2b1-4e4a-b566-5c58837a2780",
                                                "sense_id": "bfc704a7-3f12-36b4-95f4-8d0efec65315",
                                                "text": "What words be these? What fears do you dismay?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3056caa-657b-3d5c-bd5f-a834eca5e1c5",
                                        "entry_id": "7f3e1e92-46ed-36ea-8cc8-ba9defd725cb",
                                        "glosses": [
                                            "To render lifeless; to subdue; to disquiet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d07f4ed9-f3c4-4f09-8829-f01a1f33bf86",
                                                "sense_id": "f3056caa-657b-3d5c-bd5f-a834eca5e1c5",
                                                "text": "Do not dismay yourself for this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b34f5327-0163-3585-a4e7-fef649c21eb5",
                                        "entry_id": "7f3e1e92-46ed-36ea-8cc8-ba9defd725cb",
                                        "glosses": [
                                            "To take dismay or fright; to be filled with dismay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70af600d-8ab3-4088-a87f-9a577f06124c",
                                                "sense_id": "b34f5327-0163-3585-a4e7-fef649c21eb5",
                                                "text": "Dismay not, princes, at this accident,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dismay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48110e1d-c82a-30fe-abc2-f23c0f061566",
                                        "entry_id": "353dfac1-fd15-36c4-bc25-c648643bbd3b",
                                        "glosses": [
                                            "A sudden or complete loss of courage and firmness in the face of trouble or danger; overwhelming and disabling terror; a sinking of the spirits"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8d6ac20-57d5-42fa-827e-c0671d02d302",
                                                "sense_id": "48110e1d-c82a-30fe-abc2-f23c0f061566",
                                                "text": "He looked in dismay at the destruction of the town caused by the hurricane."
                                            },
                                            {
                                                "example_id": "7264483d-80c3-4663-bbb3-60a72d494b03",
                                                "sense_id": "48110e1d-c82a-30fe-abc2-f23c0f061566",
                                                "text": "Come on: in this there can be no dismay;\nMy ships come home a month before the day."
                                            },
                                            {
                                                "example_id": "88420146-ceb4-4dd3-905b-70ad826674c4",
                                                "sense_id": "48110e1d-c82a-30fe-abc2-f23c0f061566",
                                                "text": "US reputational damage is not confined to Europe. There was dismay among the G7 countries that a joint statement on tackling the pandemic could not be agreed because Trump insisted on calling it the “Wuhan virus” – his crude way of pinning sole blame on China."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62cdbba9-a066-3b74-8684-c4db6eb5ae5b",
                                        "entry_id": "353dfac1-fd15-36c4-bc25-c648643bbd3b",
                                        "glosses": [
                                            "Condition fitted to dismay; ruin."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
