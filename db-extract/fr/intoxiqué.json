                        "entry_id": "5e1e1935-df03-3166-9488-fa179ae28174",
                        "glosses": [
                            "Personne qui se trouve sous l'emprise de substances toxiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08acc931-ba1b-4845-aaaf-8933efee912f",
                                "sense_id": "f4aa2738-176e-3ef7-8882-e93783d8088e",
                                "text": "Ah! si, tout de même, un intoxiqué : le petit frère du blessé grave."
                            },
                            {
                                "example_id": "3b910932-ad5a-4204-9b0f-ed4551942dc9",
                                "sense_id": "f4aa2738-176e-3ef7-8882-e93783d8088e",
                                "text": "Pourtant, ne faisait-elle pas un petit effort secret pour se persuader que sur trois jours à Paris, avec Alain, elle devait en passer un à la préfecture de police, après avoir été ramassée avec lui dans une tanière d’intoxiqués ?"
                            }
                        ]
                    }
