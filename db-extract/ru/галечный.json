                "senses": [
                    {
                        "sense_id": "9c57af56-eb7f-37bb-a365-2715e1ecbb8e",
                        "entry_id": "c38ce53e-75bc-3de8-a3d7-06fee2d8b6ac",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным галька"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdb26d77-c5ad-4f34-836c-f7a3ac16d50c",
                                "sense_id": "9c57af56-eb7f-37bb-a365-2715e1ecbb8e",
                                "text": "И снова, и снова утаскивал галечный грохот в пучину."
                            }
                        ]
                    },
                    {
                        "sense_id": "2349b1d0-a23d-3373-9626-bd3b8f269e00",
                        "entry_id": "c38ce53e-75bc-3de8-a3d7-06fee2d8b6ac",
                        "glosses": [
                            "состоящий из гальки, содержащий гальку, покрытый галькой и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1370389-b81b-4611-86c9-d65f012c566c",
                                "sense_id": "2349b1d0-a23d-3373-9626-bd3b8f269e00",
                                "text": "С боков медленно выправлялась, вылезала из-под песчаных и галечных наносов июльская густосочная трава."
                            },
                            {
                                "example_id": "d7de0779-51bf-41b3-b85f-6aa0b220067c",
                                "sense_id": "2349b1d0-a23d-3373-9626-bd3b8f269e00",
                                "text": "Дно пруда, песчаное, галечное, очень чистое, надвинулось быстро, и я встал на него и оттолкнулся…"
                            },
                            {
                                "example_id": "53787cd6-2b02-48a0-9834-2d7bd48758dd",
                                "sense_id": "2349b1d0-a23d-3373-9626-bd3b8f269e00",
                                "text": "Мыс Херсонес каменными обрывами уходит в море, но под обрывами ещё тянется узкая полоска галечного пляжа."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5850e05e-dc22-44d2-93d2-882889806974",
                        "source_entry_id": "c38ce53e-75bc-3de8-a3d7-06fee2d8b6ac",
                        "source_sense_description": "состоящий из гальки, покрытый галькой",
                        "target_lang_word": "pebble",
                        "target_lang_code": "en",
