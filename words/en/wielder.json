{
    "word_family": [
        "wield"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "80431e32-2e59-39a4-807a-8bcd2ad1d738",
                    "sense_definition": "A person who holds and uses a tool, weapon, or power.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "user",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wielder</w> of the sword defended the kingdom against the invaders.",
                            "target_lang_translations": {
                                "zh": "这把剑的<w>持有者</w>保卫了王国，抵御了入侵者。"
                            }
                        },
                        {
                            "text": "As the <w>wielder</w> of great political influence, she made many important decisions.",
                            "target_lang_translations": {
                                "zh": "作为巨大政治影响力的<w>持有者</w>，她做出了许多重要的决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "user",
                        "handler",
                        "operator"
                    ],
                    "common_phrases": [
                        "wielder of power",
                        "wielder of the sword"
                    ],
                    "target_lang_definitions": {
                        "zh": "指持有并使用工具、武器或权力的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使用者",
                                "target_lang_sense_clarification": "指使用工具或设备的人。"
                            },
                            {
                                "target_lang_word": "持有者",
                                "target_lang_sense_clarification": "指拥有或掌握某种权力、武器或物品的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0670b667-0abd-3b48-8251-444835921d8a",
                    "sense_definition": "A person who manages or directs an organization or activity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "user",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wielder</w> of the company's resources decided to cut the budget.",
                            "target_lang_translations": {
                                "zh": "公司资源的<w>掌权者</w>决定削减预算。"
                            }
                        },
                        {
                            "text": "He acted as the primary <w>wielder</w> of authority during the crisis.",
                            "target_lang_translations": {
                                "zh": "在危机期间，他充当了主要的权力<w>掌权者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "manager",
                        "director",
                        "administrator"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is rare and often considered archaic or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指管理或指导组织或活动的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "掌权者",
                                "target_lang_sense_clarification": "指掌握权力或控制资源的人。"
                            },
                            {
                                "target_lang_word": "管理者",
                                "target_lang_sense_clarification": "指负责管理组织或资源的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}