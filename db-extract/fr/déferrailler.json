                "senses": [
                    {
                        "sense_id": "395641cd-0385-393f-93a9-40c564180609",
                        "entry_id": "c891d3a7-ac65-364b-98bd-6f105f66c6d1",
                        "glosses": [
                            "Ôter la ferraille d'un amas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "217c9308-a178-40a0-a852-2543e7eebc72",
                                "sense_id": "395641cd-0385-393f-93a9-40c564180609",
                                "text": "Le mâchefer résultant de l'incinération des ordures ménagères pourrait être déferraillé, mais le prix de vente est trop faible pour justifier une telle opération, dont la technique n'est du reste qu'au stade de l'expérimentation et dont le rendement est encore réduit."
                            },
                            {
                                "example_id": "c6469945-f8d0-4e11-a9cc-413a0c482ec5",
                                "sense_id": "395641cd-0385-393f-93a9-40c564180609",
                                "text": "— L'Agence Nationale pour la Récupération des Déchets (ANRED) souligne que « deux tiers des centres de traitement des ordures ménagères ne déferraillent pas encore."
                            },
                            {
                                "example_id": "eadaac91-9756-4900-822f-9621f4e20b13",
                                "sense_id": "395641cd-0385-393f-93a9-40c564180609",
                                "text": "Les mâchefers doivent être traités avant évacuation. Il faut les refroidir, les broyer, les déferrailler."
                            }
                        ]
                    }
