                ],
                "senses": [
                    {
                        "sense_id": "f6012f01-30db-3c72-a0f6-c9912b233e5c",
                        "entry_id": "67290b52-9f72-3006-9158-800537ffbc75",
                        "glosses": [
                            "Person/Organisation oder Sache, die als „zweite Wahl“ die Funktion/Rolle einer anderen übernimmt, die diese Funktion/Rolle aus irgendeinem Grund nicht ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68e78546-e480-441a-82ab-e9af93980183",
                                "sense_id": "f6012f01-30db-3c72-a0f6-c9912b233e5c",
                                "text": "Ich werde Susi nicht zum Abschlussball begleiten. Ich habe keine Lust, nur der Lückenbüßer zu sein."
                            },
                            {
                                "example_id": "19209bef-e230-4e10-990d-67778e5b1660",
                                "sense_id": "f6012f01-30db-3c72-a0f6-c9912b233e5c",
                                "text": "Im Interview spricht er über Nervosität vor dem Spitzenspiel und sagt, warum er sich nicht als Lückenbüßer sieht."
                            },
                            {
                                "example_id": "d211eb37-17eb-469a-83e0-52ca13ca5925",
                                "sense_id": "f6012f01-30db-3c72-a0f6-c9912b233e5c",
                                "text": "Wärst du ein Mann, so hätte ich dich schon auf Wege geführt, die einen Lebensinhalt gewährleisten, aber so – – du bist nur ein Mädchen - nur für einen einzigen Beruf bestimmt, – alle anderen wären doch nichts als traurige Lückenbüßer."
                            },
                            {
                                "example_id": "90bb6658-73fc-4a26-8cd6-3c7a405d1721",
                                "sense_id": "f6012f01-30db-3c72-a0f6-c9912b233e5c",
                                "text": "„Agata wandte immer ein, daß ich, wie alle Welt wisse, die Corticelli aushalte, und daß sie sich um alles Gold der Welt nicht den Vorwurf zuziehen wolle, sie sei der Lückenbüßer für meine Mätresse, die zu besuchen die Verhältnisse mich hinderten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e49b41e4-3e37-461b-bb07-c29946dc0b0f",
                        "source_entry_id": "67290b52-9f72-3006-9158-800537ffbc75",
                        "source_sense_id": "f6012f01-30db-3c72-a0f6-c9912b233e5c",
                        "target_lang_word": "stopgap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stopgap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93c3e5f3-15be-3ef4-ab27-6ca80d9905a4",
                                        "entry_id": "0ec0960b-2586-393e-9076-7dc3410e62a4",
                                        "glosses": [
                                            "That which stops up or fills a gap or hole."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d26261b-fe2a-4ae4-8cb2-93f079a97c07",
                                                "sense_id": "93c3e5f3-15be-3ef4-ab27-6ca80d9905a4",
                                                "text": "[A] bit of ink and paper which has long been an innocent wrapping or stop-gap may at last be laid open under the one pair of eyes which have knowledge enough to turn it into the opening of a catastrophe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb610c3-064d-399a-928e-d7b67930b10f",
                                        "entry_id": "0ec0960b-2586-393e-9076-7dc3410e62a4",
                                        "glosses": [
                                            "Something spoken to fill up an uncomfortable pause in speech; a filled pause or filler."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18c0e94a-8b62-305f-83c4-c0ad936a1595",
                                        "entry_id": "0ec0960b-2586-393e-9076-7dc3410e62a4",
                                        "glosses": [
                                            "A short-term fix or temporary measure used until something better can be obtained; that which serves as an expedient in an emergency; a band-aid solution."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08ffc7c1-1ddd-499a-ae76-ee2c4837eef4",
                                                "sense_id": "18c0e94a-8b62-305f-83c4-c0ad936a1595",
                                                "text": "The small company used their old product with a few kludged enhancements as a stopgap until they could develop a new product."
                                            },
                                            {
                                                "example_id": "ee1f8ba7-bd5d-4fe5-9b86-40a727a6e094",
                                                "sense_id": "18c0e94a-8b62-305f-83c4-c0ad936a1595",
                                                "text": "Perhaps I shall be told that this wintry exhibition is a mere stopgap and makeshift, until a fresh supply of bright new paintings can be procured, and that it is ultra vires to obtain such for love or money before the merry month of May."
                                            },
                                            {
                                                "example_id": "27d00607-bf1f-444f-b8f4-a47621084483",
                                                "sense_id": "18c0e94a-8b62-305f-83c4-c0ad936a1595",
                                                "text": "It is often argued that the HST saved BR's InterCity market. It was only ever intended as a stopgap, but it proved to be a winner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "980b4c16-1f31-382d-90dc-dedc142cf798",
                                        "entry_id": "0ec0960b-2586-393e-9076-7dc3410e62a4",
                                        "glosses": [
                                            "A short-term fix or temporary measure used until something better can be obtained; that which serves as an expedient in an emergency; a band-aid solution.",
                                            "A person appointed or hired to fill a position temporarily until a permanent appointment or hire can be made; a temp."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69a8460-81f4-411f-949d-1b36f566399b",
                                                "sense_id": "980b4c16-1f31-382d-90dc-dedc142cf798",
                                                "text": "As witness the following. Mr Strudwick, the regular master of the form, happened on one occasion to be away for a couple of days, and a stop-gap was put in in his place. The name of the stop-gap was Mr Somerville Smith. He and Farnie exchanged an unspoken declaration of war almost immediately."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stopgap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3052ad1a-e16b-328e-915e-9fd6d52b8e02",
                                        "entry_id": "1b28cf02-6114-31a9-9a55-faeba89f5843",
                                        "glosses": [
                                            "Short-term; temporary."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fe3f93f-6b43-4224-b01a-f4bd9c1f8693",
                                                "sense_id": "3052ad1a-e16b-328e-915e-9fd6d52b8e02",
                                                "text": "They put a stopgap solution in place, but need something more permanent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f310e30-4ee5-3758-a6a7-70fd828f2b76",
                                        "entry_id": "1b28cf02-6114-31a9-9a55-faeba89f5843",
                                        "glosses": [
                                            "Filling a gap or pause."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stopgap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61cc2cef-dbe8-3808-9dd5-9126ea3f9dfc",
                                        "entry_id": "49d67dcc-a8f2-3430-8001-535141c47431",
                                        "glosses": [
                                            "To stop up or fill (a physical gap or hole, or a hiatus)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5914266-c7b4-3aa7-82ca-21883df89aba",
                                        "entry_id": "49d67dcc-a8f2-3430-8001-535141c47431",
                                        "glosses": [
                                            "To use something as a short-term fix or temporary measure until a better alternative can be obtained."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0afa525b-cb57-30d8-8668-82a0e20d24fd",
                                        "entry_id": "49d67dcc-a8f2-3430-8001-535141c47431",
                                        "glosses": [
                                            "To use something as a short-term fix or temporary measure until a better alternative can be obtained.",
                                            "To work at a position temporarily until a permanent appointment or hire is made."
                                        ],
                                        "tags": [
