        "fr-extract.jsonl": [
            {
                "entry_id": "f4198fcd-0308-3313-8a40-9bcd75f65cc0",
                "word": "garde-à-vous",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6170d2fc-64a7-3139-8fe5-add131bb8363",
                        "entry_id": "f4198fcd-0308-3313-8a40-9bcd75f65cc0",
                        "glosses": [
                            "Variante orthographique de garde à vous."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "10aa3047-8d7c-4001-871f-6625d9b01af5",
                                "sense_id": "6170d2fc-64a7-3139-8fe5-add131bb8363",
                                "text": "Depuis ce temps, plusieurs d’entre nous sont entrés dans la tombe étroite, dans le garde-à-vous solennel de l’au-delà."
                            },
                            {
                                "example_id": "99af6362-93a3-4b82-b00f-e4ac13010632",
                                "sense_id": "6170d2fc-64a7-3139-8fe5-add131bb8363",
                                "text": "Ce qui importait était de les faire entrer dans le rang. Le nôtre, bien entendu. La première vertu révolutionnaire, c’est l’art de faire foutre les autres au garde-à-vous."
                            },
                            {
                                "example_id": "05366386-905c-408d-9f37-55684fbd0d3a",
                                "sense_id": "6170d2fc-64a7-3139-8fe5-add131bb8363",
                                "text": "Tous les hommes se tenaient au garde-à-vous, face au drapeau bleu blanc rouge sur lequel étaient inscrits en lettres dorées les mots Honneur et Fidélité. Puis venait le casse-croûte : pain, salami et quart de gros rouge qui tache."
                            },
                            {
                                "example_id": "3753889b-2c06-44fb-ad8b-77dde4f58108",
                                "sense_id": "6170d2fc-64a7-3139-8fe5-add131bb8363",
                                "text": "J’ai remarqué que toutes les personnes que j’ai haïes avaient l’apparence d’hommes au garde-à-vous."
                            },
                            {
                                "example_id": "120096e8-ae88-4d7e-b35a-e39cf9c1179f",
                                "sense_id": "6170d2fc-64a7-3139-8fe5-add131bb8363",
                                "text": "J’avais l’impression que lorsque Françoise faisait un bon mot toute la troupe se mettait à rire comme des soldats au garde-à-vous."
                            },
                            {
                                "example_id": "d79d7994-b633-49c8-b0a9-918739930ee1",
                                "sense_id": "6170d2fc-64a7-3139-8fe5-add131bb8363",
                                "text": "L’atelier donnait sur l’arrière-cour de l’immeuble, où quatre apprentis patientaient au garde-à-vous."
                            }
                        ]
                    }
                ],
