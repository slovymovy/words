                },
                {
                    "sense_id": "5d614033-a3c9-37cf-8102-8188a2dcfd2b",
                    "sense_definition": "A historical type of jelly-like sweetmeat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The banquet featured a traditional <w>leach</w> served on silver platters.",
                            "target_lang_translations": {
                                "ru": "На банкете подавали традиционный <w>лич</w>, сервированный на серебряных блюдах."
                            }
                        },
                        {
                            "text": "Recipes for the sweet <w>leach</w> were common in fifteenth-century cookbooks.",
                            "target_lang_translations": {
                                "ru": "Рецепты сладкого десерта <w>лич</w> были обычным делом в кулинарных книгах пятнадцатого века."
                            }
                        }
