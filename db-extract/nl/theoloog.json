                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "c9897e50-e168-463d-87c7-c07cfb20a86e",
                                "sense_id": "5ce5c2b8-93da-3bad-a862-b193ddd7e279",
                                "text": "Een theoloog houdt zich bezig met godsdiensten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "553bc1b8-850a-462c-bbf0-2f85f30254b3",
                        "source_entry_id": "0b6ee791-6068-3954-98ef-fa14057b32d6",
                        "source_sense_id": "5ce5c2b8-93da-3bad-a862-b193ddd7e279",
                        "source_sense_description": "een beoefenaar van de theologie",
                        "target_lang_word": "Theologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e865fd85-758f-3454-b478-f128b60b89a7",
                                        "entry_id": "06b4578c-b4e4-3b4f-87e0-8cac2c7f68b9",
                                        "glosses": [
                                            "Person, die Theologie studiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5374048-70c6-44a4-a463-320c92144abd",
                                                "sense_id": "e865fd85-758f-3454-b478-f128b60b89a7",
                                                "text": "„Christliche Theologen in der Alten Kirche waren häufig Bischöfe, im Mittelalter in der Regel Ordensleute.“"
                                            },
                                            {
                                                "example_id": "affb2792-9850-47ff-880f-075434200212",
                                                "sense_id": "e865fd85-758f-3454-b478-f128b60b89a7",
                                                "text": "„Dieses pessimistische Gelichter (vergib mir, meine geliebte französische Sprache!) kann nur im Kreise erbärmlicher Philosophen und durchtriebener oder sauertöpfischer Theologen Bestand haben.“"
                                            },
                                            {
                                                "example_id": "0c6ddd00-b4f0-4712-aa14-fa899b1f1736",
                                                "sense_id": "e865fd85-758f-3454-b478-f128b60b89a7",
                                                "text": "„Damals diskutierten Theologen und Propheten das Weltende und spekulierten über dessen Datum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c820582-0b81-45b2-9523-8ca7e8a8ed42",
                        "source_entry_id": "0b6ee791-6068-3954-98ef-fa14057b32d6",
                        "source_sense_id": "5ce5c2b8-93da-3bad-a862-b193ddd7e279",
                        "source_sense_description": "een beoefenaar van de theologie",
                        "target_lang_word": "theologian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theologian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79c2a68b-e279-3cc6-8cff-a2d87034617d",
                                        "entry_id": "fca4bb3f-8009-30ad-b463-2ccbaa905bed",
                                        "glosses": [
                                            "One who studies theology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e50c5e-2795-40d5-806e-a6110c0fea44",
                                                "sense_id": "79c2a68b-e279-3cc6-8cff-a2d87034617d",
                                                "text": "During a burping contest to celebrate wonderfully cold soft drinks after a long hike one hot afternoon, one little girl said, \"My dad can outburp any of you!\" Her father is a distinguished theologian and church leader whom I will not name here."
                                            },
                                            {
                                                "example_id": "ad196118-509d-4a93-a034-59c727e2c6a9",
                                                "sense_id": "79c2a68b-e279-3cc6-8cff-a2d87034617d",
                                                "text": "Cone, who once called himself “the angriest theologian in America,” is still angry. […] Niebuhr’s decision not to speak out against lynching encouraged other white theologians and ministers to follow suit, Cone said, because Niebuhr was considered the nation’s greatest theologian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d62b7aa1-ba6a-386e-8176-50aa7fbedaec",
                                        "entry_id": "fca4bb3f-8009-30ad-b463-2ccbaa905bed",
                                        "glosses": [
                                            "In Roman Catholic usage, a theological lecturer attached to a cathedral church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cabafd9-71c8-4094-8fc7-c6a9eec18c37",
                                                "sense_id": "d62b7aa1-ba6a-386e-8176-50aa7fbedaec",
                                                "text": "Of all the theologians of his age, Hooker was the most unpuritan; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d89480f6-832a-343f-a7c6-a4df57ffb1df",
                                        "entry_id": "fca4bb3f-8009-30ad-b463-2ccbaa905bed",
                                        "glosses": [
                                            "In Eastern Orthodox usage, a person who has had direct experience of and unity with God."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86bcf831-8eb0-4003-9310-22fa39b6806a",
                        "source_entry_id": "0b6ee791-6068-3954-98ef-fa14057b32d6",
                        "source_sense_id": "5ce5c2b8-93da-3bad-a862-b193ddd7e279",
                        "source_sense_description": "een beoefenaar van de theologie",
                        "target_lang_word": "théologien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théologien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a33246a-efc4-3346-bb79-78e9cd65331a",
                                        "entry_id": "3d4ddb4d-6eb3-3c0c-9e29-c4f9542ace42",
                                        "glosses": [
                                            "Celui qui s’occupe de théologie, qui écrit sur la théologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78850de6-eadb-4362-a815-217b9b399e82",
                                                "sense_id": "3a33246a-efc4-3346-bb79-78e9cd65331a",
                                                "text": "Quant aux théologiens, je ferais peut-être bien de n’en rien dire : il n'est pas prudent de toucher ni de remuer ce qui sent mauvais. Ce sont des gens qui n’entendent pas raillerie, et qui prennent feu pour une bagatelle."
                                            },
                                            {
                                                "example_id": "3c957ef7-efb2-47cb-94a9-53438d3575ab",
                                                "sense_id": "3a33246a-efc4-3346-bb79-78e9cd65331a",
                                                "text": "Les philosophes, les théologiens et la plupart des héros d’arguments ont le génie de la nation française : ils attaquent vigoureusement, mais sont perdus s’ils sont réduits à la guerre défensive."
                                            },
                                            {
                                                "example_id": "504c3742-2b1c-48fe-a4d4-a6fbc96d25ea",
                                                "sense_id": "3a33246a-efc4-3346-bb79-78e9cd65331a",
                                                "text": "Comme aucun Théologien Luthérien n'étoit plus zélé pour l'ancienne doctrine que MATHIEU FLACIUS , l'ennemi invétéré de MÉLANCTHON , & de tous les Philippistes, il fut nommé, l'an 1557, Professeur de Théologie à Jene. Les suites de cette nomination furent des plus déplorables : […]."
                                            },
                                            {
                                                "example_id": "12f082ce-104c-4d32-a9c9-4cd2fca8ed4b",
                                                "sense_id": "3a33246a-efc4-3346-bb79-78e9cd65331a",
                                                "text": "On peut dire que nous sommes ici sur le terrain de la morale des consommateurs; il ne faut pas s'étonner si les théologiens catholiques trouvent encore la morale d'Aristote excellente, car ils se placent, eux aussi, au même point de vue des consommateurs."
                                            },
                                            {
                                                "example_id": "bcebc780-3a70-44a8-a462-afdf28d42954",
                                                "sense_id": "3a33246a-efc4-3346-bb79-78e9cd65331a",
                                                "text": "Le Wahhabites, en Arabie, à la fin du XVIIIᵉ siècle, par exemple, recourant à l’autorité de certains théologiens médiévaux, lancèrent un mouvement virulent d’islam purifié —et puritain— fondé strictement sur les enseignements du Coran et sur la sunna du Prophète, débarrassé des additions séculaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
