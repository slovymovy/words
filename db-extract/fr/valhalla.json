                "senses": [
                    {
                        "sense_id": "c134f2d0-2286-3050-92d0-1072978914f3",
                        "entry_id": "a3ac9242-c06a-3ced-8735-977cd92346b8",
                        "glosses": [
                            "Au-delà de la mythologie nordique, où les Valkyries emmènent les âmes des guerriers les plus valeureux morts au combat pour que le dieu Odin les prépare à la bataille ultime du Ragnarök."
                        ],
                        "tags": [
                            "Mythologie nordique"
                        ],
                        "examples": [
                            {
                                "example_id": "75b4178f-1db5-45b5-b50f-efad3fac0952",
                                "sense_id": "c134f2d0-2286-3050-92d0-1072978914f3",
                                "text": "Va ! Je bois l’hydromel dans la coupe des forts ;\nLe ciel du Valhalla fait resplendir mon glaive,\nEt la voix des vivants est odieuse aux morts."
                            }
                        ]
                    },
                    {
                        "sense_id": "98e92feb-857b-3550-8368-c3b0979cbbf2",
                        "entry_id": "a3ac9242-c06a-3ced-8735-977cd92346b8",
                        "glosses": [
                            "Cratère d’impact multi-annulaire sur la surface de Callisto et le plus grand du système solaire."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6f39306-5064-4330-8f22-6bcac3852ae2",
                        "source_entry_id": "a3ac9242-c06a-3ced-8735-977cd92346b8",
                        "target_lang_word": "Walhall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Walhall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f449836-e6a5-3d41-8268-fa77b71bc098",
                                        "entry_id": "79d92e85-eae5-3a54-a821-26b32f53258a",
                                        "glosses": [
                                            "Ort, an den in der Schlacht gefallene Krieger kommen"
                                        ],
                                        "tags": [
                                            "germanische Mythologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "364f6edf-4205-4ef3-b4a3-264f08d1a486",
                                                "sense_id": "4f449836-e6a5-3d41-8268-fa77b71bc098",
                                                "text": "„Die Walküren führen all jene Männer nach Walhall, die im Krieg ihren Mut bewiesen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "504f3cbf-fb1a-4bff-a708-b3c999a8e1aa",
                        "source_entry_id": "a3ac9242-c06a-3ced-8735-977cd92346b8",
                        "target_lang_word": "Walhalla",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Walhalla",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97dee05e-dfc6-3841-bfee-c2628a4a5c01",
                                        "entry_id": "5e56bddc-2b3e-31a5-ba8e-e820b1823abd",
                                        "glosses": [
                                            "von König Ludwig I. erbauter Tempel in Bayern, in dem heute Büsten bedeutender Persönlichkeiten aufgestellt werden"
                                        ],
                                        "tags": [
                                            "die Walhalla"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3149a3fe-1826-4801-8937-7b58ff24c93c",
                                                "sense_id": "97dee05e-dfc6-3841-bfee-c2628a4a5c01",
                                                "text": "Die Walhalla gilt als das Hauptwerk aller Kunstschöpfungen des bayerischen König Ludwig I. (1825-1848)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1be32058-f204-3458-855b-259004d8a0b2",
                                        "entry_id": "5e56bddc-2b3e-31a5-ba8e-e820b1823abd",
                                        "glosses": [
                                            "in der germanischen Mythologie der Ort, an den in der Schlacht gefallene Krieger kommen"
                                        ],
                                        "tags": [
                                            "ohne Artikel oder die/das Walhalla"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86f5ed5e-ae53-434b-9e59-bd2f0f96d1ee",
                                                "sense_id": "1be32058-f204-3458-855b-259004d8a0b2",
                                                "text": "In der altnordischen Mythologie ist Walhalla die große Halle des Gottes Odin in Asgard."
                                            },
                                            {
                                                "example_id": "f272f51f-e9e0-415c-bc6f-d9ef118ac82e",
                                                "sense_id": "1be32058-f204-3458-855b-259004d8a0b2",
                                                "text": "„In der germanischen Mythologie bezeichnet Walhalla die postmortale Wohngemeinschaft der gefallenen Krieger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99187419-b364-4aa8-aa9e-9b186db9db1c",
                        "source_entry_id": "a3ac9242-c06a-3ced-8735-977cd92346b8",
