                    {
                        "sense_id": "27080f9c-db51-343a-910b-87a28e34880e",
                        "entry_id": "293292e2-04f9-315a-b38d-df6656300719",
                        "glosses": [
                            "związany z postacią rzymskiego wodza Gnejusza Pompejusza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d1a7032-b3ff-4ca6-a182-3f41fdb34548",
                                "sense_id": "27080f9c-db51-343a-910b-87a28e34880e",
                                "text": "Cezar twierdził również, że zginęło tam wtedy piętnaście tysięcy pompejańskich żołnierzy, a dwadzieścia cztery tysiące zostało pojmanych. To zniekształcenie prawdy miało też na celu zatuszowanie faktu, że tak wielu żołnierzom Pompejusza udało się uciec; ogółem osiemnastu tysiącom"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
