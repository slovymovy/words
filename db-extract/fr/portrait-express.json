                        "glosses": [
                            "Portrait réalisé très rapidement par un peintre, à la demande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e407939-d6ea-487d-a7ec-298d632a55bb",
                                "sense_id": "9eb2ac3b-c8f7-3c3e-8ccc-436f3ed238c1",
                                "text": "Le tableau représente un gars à l’air inspiré, avec une grande force de concentration dans la barbouze, le pinceau à la main, prêt à prendre le départ pour l’épreuve du portrait-express de la Foire aux Croûtes."
                            },
                            {
                                "example_id": "68d144c4-42bf-4a31-b181-ee4fcec73ba2",
                                "sense_id": "9eb2ac3b-c8f7-3c3e-8ccc-436f3ed238c1",
                                "text": "La préface de Gaspard ne nous apprend pas grand-chose sur le patronage de Callot, présenté comme l’une des « deux faces antithétiques de l’art » ; le jugement de Bertrand sur le graveur lorrain se résume à une transposition d’art, le poète s’efforçant de créer un portrait-express semblable aux croquis rapides du graveur lorrain."
                            }
                        ]
                    }
