                "senses": [
                    {
                        "sense_id": "84b0a8fa-96d0-323d-9e95-2ddf23f91961",
                        "entry_id": "7c259e27-ad3f-31db-a65b-b50ab53a4094",
                        "glosses": [
                            "syntaktisch übergeordneter Teilsatz, von dem ein anderer, untergeordneter Teilsatz abhängig ist"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "674e925b-fa0f-4854-9746-a68f608101a0",
                                "sense_id": "84b0a8fa-96d0-323d-9e95-2ddf23f91961",
                                "text": "In dem Satz \"Peter kam, obwohl er sich schlecht fühlte\" ist \"Peter kam\" der Trägersatz. In dem Satz \"Peter kam, obwohl er sich schlecht fühlte, nachdem er sich angesteckt hatte\" ist außer \"Peter kam\" auch noch \"obwohl er sich schlecht fühlte\" ein Trägersatz."
                            },
                            {
                                "example_id": "1571c5f8-f3ee-46e0-8416-00f7f37d603c",
                                "sense_id": "84b0a8fa-96d0-323d-9e95-2ddf23f91961",
                                "text": "Nebensätze benötigen einen Trägersatz, von dem sie abhängig sind. Der Trägersatz kann selbst wieder ein Nebensatz oder aber auch ein Hauptsatz sein."
                            },
                            {
                                "example_id": "d7f5ec7b-9140-4003-8332-943bcf6649f4",
                                "sense_id": "84b0a8fa-96d0-323d-9e95-2ddf23f91961",
                                "text": "Für Bünting und Bergenholtz ist ein Trägersatz ein „übergeordneter Teilsatz in einem Matrixsatz“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
