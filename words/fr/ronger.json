                        "ronger un os"
                    ]
                },
                {
                    "sense_id": "6e79d816-98cc-3b4d-bcf0-06e45de77565",
                    "sense_definition": "Attaquer, miner ou détruire progressivement une matière par une action physique ou chimique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction_progressive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'humidité persistante finit par <w>ronger</w> les poutres en bois de la cave."
                        },
                        {
                            "text": "Le vieux portail métallique est complètement <w>rongé</w> par la rouille depuis des années."
                        }
                    ],
                    "synonyms": [
                        "attaquer",
                        "corroder",
                        "éroder"
                    ],
                    "common_phrases": [
