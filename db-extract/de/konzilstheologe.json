                                "example_id": "1b9d02fa-2f78-4a2e-a632-ed590b9dda93",
                                "sense_id": "c08cfeab-68ce-3248-af83-5a9e0155ac38",
                                "text": "Konzilstheologen sind zumeist Priester."
                            },
                            {
                                "example_id": "729888ab-d2fb-47a9-9ac5-239eed6424af",
                                "sense_id": "c08cfeab-68ce-3248-af83-5a9e0155ac38",
                                "text": "Bei den Konzilstheologen, die am Zweiten Vatikanischen Konzil (1962–1965) mitwirkten, ist zwischen den von Papst ernannten Theologen und den Beratern der Konzilsväter zu unterscheiden."
                            }
                        ],
