{
    "word_family": [
        "deprecate",
        "deprecation",
        "deprecatory"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3fb5995a-a57d-3623-8315-e18b6dbdc1c3",
                    "sense_definition": "Describing a software feature or function that is outdated and planned for removal, though still available for use.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>deprecated</w> function still works but will be removed in the next update.",
                            "target_lang_translations": {
                                "nl": "De <w>verouderde</w> functie werkt nog wel, maar zal in de volgende update worden verwijderd."
                            }
                        },
                        {
                            "text": "Developers should avoid using <w>deprecated</w> code in new projects.",
                            "target_lang_translations": {
                                "nl": "Ontwikkelaars moeten het gebruik van <w>verouderde</w> code in nieuwe projecten vermijden."
                            }
                        }
                    ],
                    "synonyms": [
                        "obsolete",
                        "outdated",
                        "legacy"
                    ],
                    "antonyms": [
                        "current"
                    ],
                    "common_phrases": [
                        "deprecated feature",
                        "deprecated function"
                    ],
                    "target_lang_definitions": {
                        "nl": "Verwijzend naar een softwarefunctie of onderdeel dat verouderd is en gepland staat om te worden verwijderd, hoewel het nog wel beschikbaar is voor gebruik."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verouderd",
                                "target_lang_sense_clarification": "Algemene term voor iets dat niet meer actueel is."
                            },
                            {
                                "target_lang_word": "afgekeurd",
                                "target_lang_sense_clarification": "In technische context gebruikt om aan te geven dat een functie niet langer wordt ondersteund."
                            },
                            {
                                "target_lang_word": "gedeprecieerd",
                                "target_lang_sense_clarification": "Vakterm in de informatica voor functies die niet langer worden aanbevolen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe57c40a-363d-305d-bf7e-2fca8531f0a1",
                    "sense_definition": "Strongly disapproved of or criticized.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disapproval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Such behavior is highly <w>deprecated</w> by the committee members.",
                            "target_lang_translations": {
                                "nl": "Dergelijk gedrag wordt door de commissieleden sterk <w>afgekeurd</w>."
                            }
                        },
                        {
                            "text": "The practice of using jargon in formal writing is widely <w>deprecated</w>.",
                            "target_lang_translations": {
                                "nl": "Het gebruik van jargon in formele teksten wordt algemeen <w>afgekeurd</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disfavored",
                        "condemned"
                    ],
                    "antonyms": [
                        "praised"
                    ],
                    "target_lang_definitions": {
                        "nl": "Sterk afgekeurd of bekritiseerd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afgekeurd",
                                "target_lang_sense_clarification": "Iets waar men expliciet negatief over oordeelt."
                            },
                            {
                                "target_lang_word": "bekritiseerd",
                                "target_lang_sense_clarification": "Onderworpen aan kritiek."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "77369315-b3fc-3592-a586-1b675445d0d1",
                    "sense_definition": "Simple past and past participle of <w>deprecate</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager <w>deprecated</w> the team's risky strategy during the meeting.",
                            "target_lang_translations": {
                                "nl": "De manager <w>keurde</w> de riskante strategie van het team tijdens de vergadering <w>af</w>."
                            }
                        },
                        {
                            "text": "The software company <w>deprecated</w> the old API last year.",
                            "target_lang_translations": {
                                "nl": "Het softwarebedrijf heeft vorig jaar de oude API <w>gedeprecieerd</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb deprecate."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van 'deprecate' (afkeuren of verouderd verklaren)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afgekeurd",
                                "target_lang_sense_clarification": "Voltooid deelwoord van afkeuren."
                            },
                            {
                                "target_lang_word": "gedeprecieerd",
                                "target_lang_sense_clarification": "Voltooid deelwoord van de technische term voor het uitfaseren van software."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}