                "senses": [
                    {
                        "sense_id": "f909971f-a90c-3beb-92f0-91d24ad3191f",
                        "entry_id": "bc3ad025-ac34-3a37-b387-811416dac76c",
                        "glosses": [
                            "свойство по значению прилагательного пристойный"
                        ],
