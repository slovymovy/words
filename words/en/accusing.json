    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7fef8a62-cb80-374e-b7f5-3def6fd87e0e",
                    "sense_definition": "Expressing or implying that someone has done something wrong.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accusatory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave him an <w>accusing</w> look when he arrived late for the meeting.",
                            "target_lang_translations": {
                                "ru": "Она бросила на него <w>обвиняющий</w> взгляд, когда он опоздал на встречу."
                            }
                        },
                        {
                            "text": "The detective pointed an <w>accusing</w> finger at the suspect during the trial.",
                            "target_lang_translations": {
                                "ru": "Во время суда детектив указал <w>обвиняющим</w> перстом на подозреваемого."
                            }
                        }
                    ],
                    "synonyms": [
                        "accusatory",
                        "blaming"
                    ],
                    "common_phrases": [
                        "accusing look",
                        "accusing finger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий или подразумевающий, что кто-то совершил что-то предосудительное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обвиняющий",
                                "target_lang_sense_clarification": "выражающий обвинение (о взгляде, жесте)"
                            },
                            {
                                "target_lang_word": "укоризненный",
                                "target_lang_sense_clarification": "выражающий упрек или осуждение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44952238-523e-3524-ae84-ea01f08f32cf",
                    "sense_definition": "Present participle and gerund of <w>accuse</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "accuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire afternoon <w>accusing</w> his brother of breaking the vase.",
                            "target_lang_translations": {
                                "ru": "Он весь день <w>обвинял</w> своего брата в том, что тот разбил вазу."
                            }
                        },
                        {
                            "text": "Stop <w>accusing</w> me of things I did not do.",
                            "target_lang_translations": {
