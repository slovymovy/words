                "senses": [
                    {
                        "sense_id": "50429095-c92f-38c3-9778-ab21e8a469df",
                        "entry_id": "b54bf1f0-da29-3ff7-bcfc-3c5de7033083",
                        "glosses": [
                            "Person, die etwas interpretiert, ausdeutet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94592b23-de5d-4885-86ef-0cdfb9a53d62",
                                "sense_id": "50429095-c92f-38c3-9778-ab21e8a469df",
                                "text": "„Der beste Deuter eines Traums ist der Träumer.“"
                            },
                            {
                                "example_id": "21dbca03-d2c4-4c3c-a8aa-475d379e2db8",
                                "sense_id": "50429095-c92f-38c3-9778-ab21e8a469df",
                                "text": "„Ein ungemein genauer Beobachter seiner Zeit wurde er, ein radikaler, aber unideologischer Deuter der Politik, ein Menschenfreund, der auf Distanz blieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
