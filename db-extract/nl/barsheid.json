                "entry_id": "ab264fcb-24b5-37e6-b847-54567ed6e222",
                "word": "barsheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "3e6638ef-783c-438f-b746-0deb038c9f30",
                        "entry_id": "ab264fcb-24b5-37e6-b847-54567ed6e222",
                        "tags": [
                            "plural"
                        ],
                        "form": "barsheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1cd55da4-fd83-3e96-8925-4214f9b1d534",
                        "entry_id": "ab264fcb-24b5-37e6-b847-54567ed6e222",
                        "glosses": [
                            "het boos, lomp en onvriendelijk zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33357214-4067-4d80-afe5-7347d0b711d8",
                                "sense_id": "1cd55da4-fd83-3e96-8925-4214f9b1d534",
                                "text": "In mei leer ik een dadaïst kennen en niets verandert\nIk blijf ongepast, ik blijf obscene gedichten schrijven\nOver sponzenverkopers en over vogelwichelaars,\nOver gekwelde okapi’s en over uitgekiende meeuwen\nDie mij vrede brengen, ik heb vrede met mijn barsheid."
                            },
                            {
                                "example_id": "6fe472f6-8e45-4d7b-828e-4d6644766c1e",
                                "sense_id": "1cd55da4-fd83-3e96-8925-4214f9b1d534",
                                "text": "Maar het is taaie kost. Je voelt het in alles. Die barsheid van de strijkers. De dwarse ritmiek die steeds op het verkeerde been zet. De maatschappijkritische, bozige teksten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "999216f1-ddd7-4476-86c4-06225f5fbc43",
                        "source_entry_id": "ab264fcb-24b5-37e6-b847-54567ed6e222",
                        "source_sense_id": "1cd55da4-fd83-3e96-8925-4214f9b1d534",
                        "source_sense_description": "het boos, lomp en onvriendelijk zijn",
                        "target_lang_word": "grimness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grimness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1f9f933-44ec-303c-94a5-4e652c388430",
                                        "entry_id": "ef9b3b75-c33b-38ce-b79d-f5265fa7f11f",
                                        "glosses": [
                                            "The characteristic or quality of being grim."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "734a2018-a631-4e44-99f1-712c8af13acd",
                                                "sense_id": "b1f9f933-44ec-303c-94a5-4e652c388430",
                                                "text": "This one was almost featureless, as if still in the making, with an aspect of monotonous grimness."
                                            },
                                            {
                                                "example_id": "be3864d8-80e7-47b7-a1fc-ac9933d9af36",
                                                "sense_id": "b1f9f933-44ec-303c-94a5-4e652c388430",
                                                "text": "This is a good example of Huxley's method of setting off against each other the frivolities of the artificial world and the grimnesses of the real one […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7130db62-68bf-4a66-98f0-9f9e5d6250c9",
                        "source_entry_id": "ab264fcb-24b5-37e6-b847-54567ed6e222",
                        "source_sense_id": "1cd55da4-fd83-3e96-8925-4214f9b1d534",
                        "source_sense_description": "het boos, lomp en onvriendelijk zijn",
                        "target_lang_word": "harshness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harshness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7212fcc6-81b3-3742-9872-87245dce33c8",
                                        "entry_id": "ebbe658f-30fb-345e-8d26-f3cb8c06bfcc",
                                        "glosses": [
                                            "The quality of being harsh."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36c88f5d-ea3c-4336-bc89-80716edac67b",
                                                "sense_id": "7212fcc6-81b3-3742-9872-87245dce33c8",
                                                "text": "And yet these harshnesses are tenderness itself when compared with the universal harshness out of which they grow; the harshness of the position towards the temperament, of the means towards the aims, of to-day towards yesterday, of hereafter towards to-day."
                                            },
                                            {
                                                "example_id": "d06d9a76-a1af-47b3-b315-51a21e681c54",
                                                "sense_id": "7212fcc6-81b3-3742-9872-87245dce33c8",
                                                "text": "She wakened in sharp panic, bewildered by the grotesquerie of some half-remembered dream in contrast with the harshness of inclement fact, drowsily realizing that since she had fallen asleep it had come on to rain smartly out of a shrouded sky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
