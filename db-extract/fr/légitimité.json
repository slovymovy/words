                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legitimacy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58e71e95-641f-334c-99ab-e8f9ea927107",
                                        "entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                                        "glosses": [
                                            "The quality or state of being legitimate or valid; validity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ef5f11f-3f2b-4791-9bd3-713eb1963034",
                                                "sense_id": "58e71e95-641f-334c-99ab-e8f9ea927107",
                                                "text": "The legitimacy based on a revolutionary essence was replaced by legitimacy with an ultranational, ultra-Yugoslav character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                                        "entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                                        "glosses": [
                                            "The quality or state of being legitimate or valid; validity.",
                                            "Public acceptance of an institution, such as a polity or societal system."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0177e105-988a-4f17-b3a8-95a38c9b40db",
                                                "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                                                "text": "After decades of inequality and oppression, the regime had lost legitimacy with its own population."
                                            },
                                            {
                                                "example_id": "38c2d484-7fbd-4b13-955e-077c2feb3093",
                                                "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                                                "text": "The fall of the Soviet Union in 1991 was seen by many as proof of capitalism’s legitimacy over communism."
                                            },
                                            {
                                                "example_id": "6911b180-09f5-482f-b06d-d45d9cea0823",
                                                "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                                                "text": "Democracy’s legitimacy stems from the consent of the governed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc2377d0-86f7-3f20-ab8e-a17dc72aceeb",
                                        "entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                                        "glosses": [
                                            "Lawfulness of birth or origin; directness of descent as affecting the royal succession."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
