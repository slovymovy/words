{
    "word_family": [
        "Evakuierung",
        "Evakuierter",
        "Vakuum"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4cb4a790-59e2-3cb5-9fd7-1e9b17dde91d",
                    "sense_definition": "einen gefährdeten Ort oder ein Gebäude aus Sicherheitsgründen räumen und absichern",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gefahr_abwenden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen des drohenden Hochwassers mussten die Behörden das gesamte Viertel <w>evakuieren</w>."
                        },
                        {
                            "text": "Nach dem plötzlichen Feueralarm wurde das Gebäude zügig und ohne Panik <w>evakuiert</w>."
                        }
                    ],
                    "synonyms": [
                        "räumen"
                    ],
                    "common_phrases": [
                        "ein Gebäude evakuieren",
                        "eine Stadt evakuieren"
                    ]
                },
                {
                    "sense_id": "3c20ac1a-1c8d-3b69-80f6-90edec43273c",
                    "sense_definition": "Menschen aus einem bedrohten Gebiet an einen sicheren Ort bringen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gefahr_abwenden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Rettungskräfte <w>evakuierten</w> die Bewohner des brennenden Hauses rechtzeitig."
                        },
                        {
                            "text": "Tausende Menschen wurden vor dem herannahenden Sturm in sichere Notunterkünfte <w>evakuiert</w>."
                        }
                    ],
                    "synonyms": [
                        "in Sicherheit bringen"
                    ],
                    "common_phrases": [
                        "die Bewohner evakuieren",
                        "die Bevölkerung evakuieren"
                    ]
                },
                {
                    "sense_id": "511ef76f-ce2f-354c-bf01-b1aceaa60bf4",
                    "sense_definition": "bewegliche Güter, Vorräte oder Kunstwerke zum Schutz vor Zerstörung fortschaffen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gefahr_abwenden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Während des Krieges versuchte man, wertvolle Kunstwerke aus der Stadt zu <w>evakuieren</w>."
                        },
                        {
                            "text": "Wichtige Dokumente wurden vor der Überflutung vorsorglich in das Zentralarchiv <w>evakuiert</w>."
                        }
                    ],
                    "synonyms": [
                        "fortschaffen",
                        "verlagern",
                        "wegschaffen"
                    ],
                    "common_phrases": [
                        "wertvolle Bestände evakuieren"
                    ]
                },
                {
                    "sense_id": "c5708a87-4e6c-3c91-a7ce-0e1ac7ec472d",
                    "sense_definition": "ein Gas aus einem geschlossenen Behälter absaugen, um ein Vakuum herzustellen",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für das physikalische Experiment muss man den Glasbehälter vollständig <w>evakuieren</w>."
                        },
                        {
                            "text": "Vor der Messung wurde die Kammer mit einer Vakuumpumpe sorgfältig <w>evakuiert</w>."
                        }
                    ],
                    "synonyms": [
                        "entleeren"
                    ],
                    "common_phrases": [
                        "einen Behälter evakuieren"
                    ]
                }
            ]
        }
    ]
