                ],
                "senses": [
                    {
                        "sense_id": "30d30d8c-a4f4-3c28-ba7a-79bf814c13aa",
                        "entry_id": "7df51686-fbad-3656-b9f4-b5bce9b3c0c2",
                        "glosses": [
                            "немецкая фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cecbe611-8102-4a92-b84c-870687cd34f8",
                                "sense_id": "30d30d8c-a4f4-3c28-ba7a-79bf814c13aa",
                                "text": "— Осмелюсь вас спросить, кто этот молодой человек в простом немецком кафтане и с такой выразительной физиономиею, вон тот, что сидит в первом ряду с краю? — Это Моцарт. Моцарт! — повторил я."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db474431-19c5-4a05-9d3a-96db5b5fad2b",
                        "source_entry_id": "7df51686-fbad-3656-b9f4-b5bce9b3c0c2",
                        "source_sense_id": "30d30d8c-a4f4-3c28-ba7a-79bf814c13aa",
                        "target_lang_word": "Mozart",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mozart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4373fa6-5f15-371a-83db-4c6b31a7c5a3",
                                        "entry_id": "1c7f1322-c177-3932-b0c0-c37844a8b28c",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e66e00ad-6c4e-48b6-9f93-3b7084d428f0",
                                                "sense_id": "a4373fa6-5f15-371a-83db-4c6b31a7c5a3",
                                                "text": "„Weitere Säle sind das Konferenz- oder Ratszimmer, in welchem Mozart im Alter von sechs Jahren sein erstes Hofkonzert aufführte, […].“"
                                            },
                                            {
                                                "example_id": "12ebae19-0f2d-4d22-a0b6-626e2ee1e2bc",
                                                "sense_id": "a4373fa6-5f15-371a-83db-4c6b31a7c5a3",
                                                "text": "„Mozart komponierte 1778 die beiden Flötenkonzerte D-Dur und G-Dur.“"
                                            },
                                            {
                                                "example_id": "e4d164cd-3ec6-48ac-93c9-b98a2ab53520",
                                                "sense_id": "a4373fa6-5f15-371a-83db-4c6b31a7c5a3",
                                                "text": "„Augsburg war nicht nur die Geburtsstadt von Mozarts Vater Leopold, sondern auch der Wohnort von ‚Bäsle‘ Anna Maria Thekla Mozart, der ersten Liebe des großen Komponisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
