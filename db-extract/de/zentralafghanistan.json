                "senses": [
                    {
                        "sense_id": "166bad3d-cf7d-313c-a00f-09649adddb76",
                        "entry_id": "b908cc3c-7eb9-376d-9c3d-686f1cbd8cba",
                        "glosses": [
                            "zentraler, mittig gelegener Teil Afghanistans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60d24894-4653-45e2-beb4-6c0353d3b4ef",
                                "sense_id": "166bad3d-cf7d-313c-a00f-09649adddb76",
                                "text": "„In der pakistanischen Gesellschaft finden sich archaische neben modernen Gesellschaftsformen. So liegen einerseits entlang des Indus die Winterweidegebiete paschtunischer Nomaden, die nach wie vor im Laufe des Jahres auf festen Routen bis nach Zentralafghanistan ziehen und weitgehend an ihren Bräuchen festhalten.“"
                            },
                            {
                                "example_id": "1df5c5c7-c677-4be5-979f-3dac68d0d3fa",
                                "sense_id": "166bad3d-cf7d-313c-a00f-09649adddb76",
                                "text": "„So erhielten Paschtunen generell die ertragreichsten Ackerflächen zugewiesen und wurden paschtunische Nomaden in Zentralafghanistan auf Kosten der Hazaras mit den besten Weidegründen ausgestattet.“"
                            },
                            {
                                "example_id": "b2f7f120-628f-4f58-8a83-9d8d2870680b",
                                "sense_id": "166bad3d-cf7d-313c-a00f-09649adddb76",
                                "text": "„Im Januar kam es zu schweren Kämpfen zwischen den Taliban und der Vereinigten Front um die Kontrolle über die Region Hasarajat in Zentralafghanistan, wo die ethnische Gruppe der Hasaras lebt, schiitische Muslime, die von den sunnitischen Taliban gehasst werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
