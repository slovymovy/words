                        "examples": [
                            {
                                "example_id": "997f845f-3bec-4742-bd7c-c73c3532399a",
                                "sense_id": "797a01aa-def6-3dd5-878f-1f4389952ce8",
                                "text": "„Um die Herstellung und Wahrung des Weltfriedens und der internationalen Sicherheit so zu fördern, daß von den menschlichen und wirtschaftlichen Hilfsquellen der Welt möglichst wenig für Rüstungszwecke abgezweigt wird, ist der Sicherheitsrat beauftragt, mit Unterstützung des in Artikel 47 vorgesehenen Generalstabsausschusses Pläne auszuarbeiten, die den Mitgliedern der Vereinten Nationen zwecks Errichtung eines Systems der Rüstungsregelung vorzulegen sind.“"
                            }
                        ],
