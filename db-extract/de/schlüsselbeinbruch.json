                        "sense_id": "8846d986-009a-3188-9f1b-1b57773f2f54",
                        "entry_id": "6a523901-340d-373b-9c01-4bd35a167e90",
                        "glosses": [
                            "Bruch des Schlüsselbeins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82cf16e6-5705-4038-b5d4-813dc481b6a0",
                                "sense_id": "8846d986-009a-3188-9f1b-1b57773f2f54",
                                "text": "Die meisten Schlüsselbeinbrüche liegen in der Mitte des Knochens und heilen ohne OP gut und ohne wesentliche Spätfolgen aus."
                            },
                            {
                                "example_id": "9555bbc6-79bb-4a1c-acba-e846a887a3ca",
                                "sense_id": "8846d986-009a-3188-9f1b-1b57773f2f54",
                                "text": "„Auch sonst kamen die Sachen des Doctors uns auf andere, erfreulichere Art, als beabsichtigt war, zu Nutze; die Pflaster, die uns bei einem Schlüsselbeinbruche dienen sollten, fanden ebenfalls praktische Verwendung, da wir ausfindig machten, daß sich die Fugen der Kajaks mit dem Klebestoffe vorzüglich verkitten ließen.“ (1898)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
