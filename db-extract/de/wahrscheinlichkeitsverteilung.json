                "senses": [
                    {
                        "sense_id": "6139ee8e-0c35-3779-8c51-fc6a619dbba6",
                        "entry_id": "7edbfe99-1423-30a8-93be-78ea7d548427",
                        "glosses": [
                            "funktionale Darstellung der Häufigkeit des Zutreffens eines Zufallswertes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9f2a173-e995-4592-b65e-0ced8f244ebe",
                                "sense_id": "6139ee8e-0c35-3779-8c51-fc6a619dbba6",
                                "text": "„Zwei Zufallvariablen X und Y können, obwohl sie verschieden sind und möglicherweise auf ganz unterschiedliche Wahrscheinlichkeitsräume definiert sind, doch dieselbe Wahrscheinlichkeitsverteilung haben.“"
                            },
                            {
                                "example_id": "613e3214-89a8-4dad-8403-9bfc65be6c94",
                                "sense_id": "6139ee8e-0c35-3779-8c51-fc6a619dbba6",
                                "text": "„Legt man dem potenziellen Anleger jedoch eine kumulative Wahrscheinlichkeitsverteilung vor, wird seine Präferenz für Investments mit rechtsschiefer Verteilung (Lotto, Not leidende Wertpapiere etc.) intensiviert.“"
                            },
                            {
                                "example_id": "49d8e61b-e3cc-4ca1-8dfc-d660517ab8ff",
                                "sense_id": "6139ee8e-0c35-3779-8c51-fc6a619dbba6",
                                "text": "„Besondere Vorsicht ist geboten im Umgang mit ähnlichen Begriffen: die kumulative Verteilungsfunktion (oder kurz: Verteilungsfunktion) gibt die Werte P(X ≤ x), die Wahrscheinlichkeitsverteilung hingegen die Werte P(X = xᵢ) an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
