                                        "glosses": [
                                            "A community-operated workspace where people with common interests, often in computers, machining, science, and digital or electronic art, can meet to socialize and collaborate on projects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eaae8a0-ed24-482a-8601-259db342c6ce",
                                                "sense_id": "7dd07807-1c55-3222-b476-08ad4bdaabd4",
                                                "text": "'Citizen science projects', along with 'hackerspaces' and 'makerspaces', have grown increasingly popular since the 1990s, providing opportunities for dedicated non-specialists to carry out research projects."
                                            }
