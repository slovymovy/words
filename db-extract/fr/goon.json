                "translations": [
                    {
                        "translation_id": "13060021-95a2-4225-b7e7-1e16430a5a46",
                        "source_entry_id": "cbe5b966-9c0f-3de2-9be1-3f004a44f0d6",
                        "source_sense_id": "130c3b16-813d-3c9c-8b32-749f3cf1f0f9",
