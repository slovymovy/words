                    },
                    {
                        "sense_id": "350979bd-e6a1-320f-8614-2d7846474137",
                        "entry_id": "256948a0-67f7-3d38-bcbb-c8ec87c246eb",
                        "glosses": [
                            "A discrete bundle of vascular tissue."
