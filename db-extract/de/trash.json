                "senses": [
                    {
                        "sense_id": "2d10a519-0cba-31d8-8ffe-5fcefcb3f28c",
                        "entry_id": "87ba99cc-a77e-3fc1-85d2-edfd6bf796ef",
                        "glosses": [
                            "minderwertiges Produkt, Schund, Ramsch"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "4e6ff308-4755-4218-a84a-5749d9571902",
                                "sense_id": "2d10a519-0cba-31d8-8ffe-5fcefcb3f28c",
                                "text": "Im Urlaub kauft Helga gern irgendwelchen Trash, um ihn dann zu Hause ihren Freunden und Verwandten aufzudrängen."
                            },
                            {
                                "example_id": "57eeba4b-d6f1-4f76-b6c8-965bc3f6932d",
                                "sense_id": "2d10a519-0cba-31d8-8ffe-5fcefcb3f28c",
                                "text": "„Es gibt dort nämlich nicht nur Trash, sondern durchaus europataugliche Sachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "83da828b-c0e3-33f2-a561-794023dc2bc0",
                        "entry_id": "87ba99cc-a77e-3fc1-85d2-edfd6bf796ef",
                        "glosses": [
                            "Form der Unterhaltung, Literatur oder Kunst ohne hohen geistigen Anspruch, die sich oft auch durch eine (bewusst) einfache Machart auszeichnet"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "4e044c14-4b3a-48ab-8a5b-f265cbd2086e",
                                "sense_id": "83da828b-c0e3-33f2-a561-794023dc2bc0",
                                "text": "Heute kommt wieder nur Trash im Fernsehen."
                            },
                            {
                                "example_id": "d43435de-e0bf-40d5-895d-7bb6e2187230",
                                "sense_id": "83da828b-c0e3-33f2-a561-794023dc2bc0",
                                "text": "Wir besuchen die Ausstellung eines Künstlers, der recht dekorativen Trash herstellt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8485b345-36c5-3b8c-91b6-48b5e24748dd",
                        "entry_id": "87ba99cc-a77e-3fc1-85d2-edfd6bf796ef",
                        "glosses": [
                            "(US-amerikanische) Unterschicht"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "daa5d546-893e-4e06-a48e-e80a2d676d84",
                                "sense_id": "8485b345-36c5-3b8c-91b6-48b5e24748dd",
                                "text": "Sam stammt aus dem weißen Trash Detroits."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "66d6ceda-b6a7-3778-8267-91a4129a9851",
