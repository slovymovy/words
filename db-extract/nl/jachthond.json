                "translations": [
                    {
                        "translation_id": "872581cd-a1ad-45af-86ea-76ca000ddb8d",
                        "source_entry_id": "57f7ebb6-4973-359d-9279-26f1c008c93a",
                        "source_sense_id": "82c9e7b2-14e7-32ee-9972-67f434bdfa45",
                        "source_sense_description": "hond die speciaal gefokt wordt voor de jacht",
                        "target_lang_word": "Jagdhund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jagdhund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9145e35-ef7b-3d89-a743-d337838a4248",
                                        "entry_id": "7f28aef3-639d-3375-9d51-12cef6dbb5a3",
                                        "glosses": [
                                            "ein Hund, der speziell für die Jagd ausgebildet und trainiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b630ab4-ce52-452d-881c-5a70ffa55a91",
                                                "sense_id": "c9145e35-ef7b-3d89-a743-d337838a4248",
                                                "text": "Auch Jagdhunde müssen zu bestimmten Zeiten im Wald an die Leine."
                                            },
                                            {
                                                "example_id": "f0a06942-d4bb-4547-9307-2c7a6330e0fc",
                                                "sense_id": "c9145e35-ef7b-3d89-a743-d337838a4248",
                                                "text": "„Hill streunt durch das Leben wie ein Jagdhund, immer mit der Nase auf der Erde und mit aufgestellten Ohren.“"
                                            },
                                            {
                                                "example_id": "3812dd5c-7dbd-489a-a69a-63740564f911",
                                                "sense_id": "c9145e35-ef7b-3d89-a743-d337838a4248",
                                                "text": "„Wieder sah sie das Bild vor sich, wie sich die Jagdhunde geifernd und gierig auf ihren eigenen Herrn stürzten.“"
                                            },
                                            {
                                                "example_id": "402168ff-8885-42cd-8fe6-4651a6e029d9",
                                                "sense_id": "c9145e35-ef7b-3d89-a743-d337838a4248",
                                                "text": "„Der Jagdhund wedelte um das Haus herum.“"
                                            },
                                            {
                                                "example_id": "b09b10af-cd52-4f65-b0dc-137bdb8b9e1a",
                                                "sense_id": "c9145e35-ef7b-3d89-a743-d337838a4248",
                                                "text": "„Die Förster und Jäger auf dem Gut sollen sich über die gut ausgebildeten Jagdhunde gefreut haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56aa5c23-13e1-4726-994d-9dbe2685985c",
                        "source_entry_id": "57f7ebb6-4973-359d-9279-26f1c008c93a",
                        "source_sense_id": "82c9e7b2-14e7-32ee-9972-67f434bdfa45",
                        "source_sense_description": "hond die speciaal gefokt wordt voor de jacht",
                        "target_lang_word": "hound",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b27e4389-d3c9-3736-86b1-65722c5fc09c",
                                        "entry_id": "3385c52b-31a4-30f8-b33d-18ac4a74698a",
                                        "glosses": [
                                            "A dog, particularly a breed with a good sense of smell developed for hunting other animals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5495ea1a-1813-395e-b929-01ab04d5a87e",
                                        "entry_id": "3385c52b-31a4-30f8-b33d-18ac4a74698a",
                                        "glosses": [
                                            "Any canine animal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8e16dd7-3ca5-362e-bae8-1a769792aa64",
                                        "entry_id": "3385c52b-31a4-30f8-b33d-18ac4a74698a",
                                        "glosses": [
                                            "Someone who seeks something."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3c57362-7fdf-433f-ac7d-0a3ea672e75d",
                                                "sense_id": "e8e16dd7-3ca5-362e-bae8-1a769792aa64",
                                                "text": "On the way out of the building I was asked for my autograph. If I'd known who the signature hound thought I was, I would've signed appropriately."
                                            },
                                            {
                                                "example_id": "4dbda17a-5ca5-4d94-aa7d-8fc83029c98a",
                                                "sense_id": "e8e16dd7-3ca5-362e-bae8-1a769792aa64",
                                                "text": "I still do not know if he's taken on this case because he's a glory hound, because he wants the PR, or if he simply wanted to help Anna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8baa22c0-53a6-3307-a020-182b7c004b39",
                                        "entry_id": "3385c52b-31a4-30f8-b33d-18ac4a74698a",
                                        "glosses": [
                                            "A male who constantly seeks the company of desirable women."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01574c69-c1e7-433e-8962-1c32dbfc2da5",
                                                "sense_id": "8baa22c0-53a6-3307-a020-182b7c004b39",
                                                "text": "\"She had a good many successors, John.\"\n\"You are such a hound, in that respect, Goodson,\" said Claywell, \"and you have always been such a hound, that it astounds me to find you—unaccompanied.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f8d5b7e-cebb-3675-a416-270dbbc6aaff",
                                        "entry_id": "3385c52b-31a4-30f8-b33d-18ac4a74698a",
                                        "glosses": [
                                            "A despicable person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d35418d3-c14c-43b0-aa4a-5e82bbd9bd99",
                                                "sense_id": "3f8d5b7e-cebb-3675-a416-270dbbc6aaff",
                                                "text": "Boy! false hound!"
                                            },
                                            {
                                                "example_id": "07b849b7-bab9-4760-8fb1-9306a767ce06",
                                                "sense_id": "3f8d5b7e-cebb-3675-a416-270dbbc6aaff",
                                                "text": "I turned away and left her to finish her journey in peace, feeling, but only for a moment or two, that I had been an unutterably mean hound."
                                            },
                                            {
                                                "example_id": "a71af095-61aa-4e64-a317-6483278cec04",
                                                "sense_id": "3f8d5b7e-cebb-3675-a416-270dbbc6aaff",
                                                "text": "'You blackmailing hound,' the parrot said distinctly, in what Hodges recognized as General Derby's voice. Anstruther turned pale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19f185fa-fa05-3afa-b672-a44955da97e4",
                                        "entry_id": "3385c52b-31a4-30f8-b33d-18ac4a74698a",
                                        "glosses": [
                                            "A houndfish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c66aab9e-88fd-3562-a589-dbf4ef6f0bae",
                                        "entry_id": "cc625bd4-333d-3aa6-b964-a4b855170f25",
                                        "glosses": [
                                            "To persistently harass doggedly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "415e891e-ef85-4916-93d7-cef1b3b83031",
                                                "sense_id": "c66aab9e-88fd-3562-a589-dbf4ef6f0bae",
                                                "text": "He hounded me for weeks, but I was simply unable to pay back his loan."
                                            },
                                            {
                                                "example_id": "d2d44cfb-fd48-44df-929f-1f0ee8806603",
                                                "sense_id": "c66aab9e-88fd-3562-a589-dbf4ef6f0bae",
                                                "text": "More pertinently for the plot, another marked difference from history is that the United Kingdom of this 1982 is precociously computerised. Instead of having been hounded to death for his homosexuality, the scientist Alan Turing is thriving and lauded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99a4ccf8-2ef9-3d48-bfc9-7f6dabc4d73b",
                                        "entry_id": "cc625bd4-333d-3aa6-b964-a4b855170f25",
                                        "glosses": [
                                            "To urge on against; to set (dogs) upon in hunting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "470b44fa-35dc-4a2c-bdab-69eb9c40c670",
                                                "sense_id": "99a4ccf8-2ef9-3d48-bfc9-7f6dabc4d73b",
                                                "text": "We both thought we saw what had the appearance to be a fox, and hounded the dogs at it, but they would not pursue it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4869d852-a163-3438-a7a5-17aa4346ad8e",
                                        "entry_id": "bb786775-3a12-373f-8426-acc7b28929ee",
                                        "glosses": [
