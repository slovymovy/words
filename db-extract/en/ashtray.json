                    {
                        "translation_id": "51c49031-c937-4beb-8e5c-1a85651360de",
                        "source_entry_id": "e7e3f84c-bb55-37c8-a998-35d0dc1c69f6",
                        "source_sense_id": "083ac73e-4836-35b8-815b-49f02d157582",
