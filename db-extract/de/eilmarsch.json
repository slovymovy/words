                "senses": [
                    {
                        "sense_id": "89f9064c-d59f-3a30-936d-080c5fe8d06e",
                        "entry_id": "fb651f22-3c83-3686-8231-e48b45bc5f55",
                        "glosses": [
                            "Marsch in einem hohen Tempo"
                        ],
                        "tags": [
                            "meist Militär"
                        ],
                        "examples": [
                            {
                                "example_id": "16e8545a-3f0a-4170-8536-b359a1246eed",
                                "sense_id": "89f9064c-d59f-3a30-936d-080c5fe8d06e",
                                "text": "„Nun strebte man in Eilmärschen der rettenden »Alpenfestung« entgegen.“"
                            },
                            {
                                "example_id": "e72490ad-f0ad-4171-a264-c17c4858a1c2",
                                "sense_id": "89f9064c-d59f-3a30-936d-080c5fe8d06e",
                                "text": "„Nach Eilmärschen durch die Argonnen trafen die Truppen bei Beaumont auf das Heer Mac Mahons, die es gegen die belgische Grenze zurückwarf.“"
                            },
                            {
                                "example_id": "08102d49-dc0c-4ddd-9ca5-b66e3914732a",
                                "sense_id": "89f9064c-d59f-3a30-936d-080c5fe8d06e",
                                "text": "„Die Franzosen hatten, wie der Kundschafter meldete, die Wiener Donaubrücke überschritten und rückten jetzt in Eilmärschen auf Znaim zu, das an Kutusows Rückzugstrasse lag, und zwar etwas über hundert Werst vor ihm.“"
                            },
                            {
                                "example_id": "2526d63e-e12c-41a4-89f0-34d2624b1b07",
                                "sense_id": "89f9064c-d59f-3a30-936d-080c5fe8d06e",
                                "text": "„Nun ging's im Eilmarsch Nine Elms hinunter, bis wir zu Roderick & Nelsons großem Holzlager kamen, gleich hinter dem Gasthaus zum Weißen Adler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
