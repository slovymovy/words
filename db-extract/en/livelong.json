{
    "word": "livelong",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7980ca6a-59e0-3b8b-b8b0-447e96936e5a",
                "word": "livelong",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6196cd68-56c4-3b8c-9257-244b057377ab",
                        "entry_id": "7980ca6a-59e0-3b8b-b8b0-447e96936e5a",
                        "glosses": [
                            "total, complete, whole"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd96b5df-b921-4e41-92c6-160b4775dd31",
                                "sense_id": "6196cd68-56c4-3b8c-9257-244b057377ab",
                                "text": "I've been working on the railroad, all the livelong day."
                            },
                            {
                                "example_id": "32473189-966f-440f-b0b6-99ef1774b5b9",
                                "sense_id": "6196cd68-56c4-3b8c-9257-244b057377ab",
                                "text": "How dreary to be somebody! / How public, like a frog / To tell your name the livelong day / To an admiring bog!"
                            },
                            {
                                "example_id": "d49a195f-3c76-4a10-a1bb-5195265ba498",
                                "sense_id": "6196cd68-56c4-3b8c-9257-244b057377ab",
                                "text": "[…] so they might spend the livelong day as befitteth high holiday, in pleasure and action without care, and thereafter revel in the lofty presence chamber till night grew old with eating and drinking and all delight."
                            }
                        ]
                    },
                    {
                        "sense_id": "769b15ff-d2c5-3d80-a908-75bdc2619aba",
                        "entry_id": "7980ca6a-59e0-3b8b-b8b0-447e96936e5a",
                        "glosses": [
                            "lasting; durable."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1c6e2d90-6c7b-4a6d-81e1-8481af0193c5",
                                "sense_id": "769b15ff-d2c5-3d80-a908-75bdc2619aba",
                                "text": "Thou, in our wonder and astonishment, Thou hast built thyself a live-long monument."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4789d178-1f09-4a1a-b76b-c5b4ebaca781",
                        "source_entry_id": "7980ca6a-59e0-3b8b-b8b0-447e96936e5a",
                        "source_sense_description": "total, complete, whole",
                        "target_lang_word": "це́лый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a21fa5f7-beb2-4d54-9f3b-5d59d1438055",
                        "source_entry_id": "7980ca6a-59e0-3b8b-b8b0-447e96936e5a",
                        "source_sense_description": "total, complete, whole",
                        "target_lang_word": "весь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "весь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "93e9fbc8-efed-3271-9ce4-fad84fb3ac9b",
                                        "entry_id": "b4dff911-57db-3156-b776-a310b04bba72",
                                        "glosses": [
                                            "целый, полный, без изъятия, без исключений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45c1abe8-b566-4eac-b353-6f231cf5985e",
                                                "sense_id": "93e9fbc8-efed-3271-9ce4-fad84fb3ac9b",
                                                "text": "Весь день."
                                            },
                                            {
                                                "example_id": "6192c222-5653-42b4-b01d-b1b409944f5f",
                                                "sense_id": "93e9fbc8-efed-3271-9ce4-fad84fb3ac9b",
                                                "text": "Весь мир."
                                            },
                                            {
                                                "example_id": "1296aaa1-ab8b-4c1d-8324-73b6317fd65f",
                                                "sense_id": "93e9fbc8-efed-3271-9ce4-fad84fb3ac9b",
                                                "text": "Вся Москва."
                                            },
                                            {
                                                "example_id": "f8bf8ea3-46ea-4267-88fe-d6241edcd634",
                                                "sense_id": "93e9fbc8-efed-3271-9ce4-fad84fb3ac9b",
                                                "text": "Все люди смертны."
                                            },
                                            {
                                                "example_id": "ecb7deeb-d34c-43fe-aef2-15055a225dd6",
                                                "sense_id": "93e9fbc8-efed-3271-9ce4-fad84fb3ac9b",
                                                "text": "Запачкал всё пальто."
                                            },
                                            {
                                                "example_id": "a747c7eb-46ca-45d1-825d-ae64ce3e74c6",
                                                "sense_id": "93e9fbc8-efed-3271-9ce4-fad84fb3ac9b",
                                                "text": "Все руки исцарапаны."
                                            },
                                            {
                                                "example_id": "0fd7205a-4a02-4702-a469-e6badbb1ea79",
                                                "sense_id": "93e9fbc8-efed-3271-9ce4-fad84fb3ac9b",
                                                "text": "Отсюда до города километров тридцать пять, а то и все сорок."
                                            },
                                            {
                                                "example_id": "fcd85a9d-001d-435e-8685-65a678ab4244",
                                                "sense_id": "93e9fbc8-efed-3271-9ce4-fad84fb3ac9b",
                                                "text": "Все счастливые семьи похожи друг на друга, каждая несчастливая семья несчастлива по-своему."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9814c7a2-4d55-3663-bf5d-59dfb3e4b964",
                                        "entry_id": "b4dff911-57db-3156-b776-a310b04bba72",
                                        "glosses": [
                                            "совершенно, целиком"
                                        ],
                                        "tags": [
                                            "в составе сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9bff23a-e869-4ce3-be65-e82dec9cdc9c",
                                                "sense_id": "9814c7a2-4d55-3663-bf5d-59dfb3e4b964",
                                                "text": "Я весь измучился."
                                            },
                                            {
                                                "example_id": "badaf9c3-1e44-4f47-b707-83a41c8fa7b0",
                                                "sense_id": "9814c7a2-4d55-3663-bf5d-59dfb3e4b964",
                                                "text": "Лицо всё в крови."
                                            },
                                            {
                                                "example_id": "f317ca3e-3767-40c5-9f95-d26035b70e95",
                                                "sense_id": "9814c7a2-4d55-3663-bf5d-59dfb3e4b964",
                                                "text": "Нет, весь я не умру — душа в заветной лире // Мой прах переживёт и тленья убежит — // И славен буду я, доколь в подлунном мире // Жив будет хоть один пиит."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab6685c4-846b-35c8-9827-10d56a4ae537",
                                        "entry_id": "b4dff911-57db-3156-b776-a310b04bba72",
                                        "glosses": [
                                            "разг., : кончиться, израсходоваться целиком"
                                        ],
                                        "tags": [
                                            "часто с гл. выйти"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0db672f-9c82-453b-a335-c1cd66fdc222",
                                                "sense_id": "ab6685c4-846b-35c8-9827-10d56a4ae537",
                                                "text": "Сахар весь вышел."
                                            },
                                            {
                                                "example_id": "c75a3d29-4674-4d0c-965e-eae147cc66f9",
                                                "sense_id": "ab6685c4-846b-35c8-9827-10d56a4ae537",
                                                "text": "Хлеб весь."
                                            },
                                            {
                                                "example_id": "1d2b5721-772b-49c1-ad46-5fd577ece3b9",
                                                "sense_id": "ab6685c4-846b-35c8-9827-10d56a4ae537",
                                                "text": "Молоко-то у нас всё."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89743312-41ed-38c9-8eac-abe4b61ad6aa",
                                        "entry_id": "b4dff911-57db-3156-b776-a310b04bba72",
                                        "glosses": [
                                            "субстантивир., то, что есть, целиком, без исключения"
                                        ],
                                        "tags": [
                                            "всё, всего́, ед. ч., ср. р."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98e0557f-a6e0-4a34-b936-280540072dfb",
                                                "sense_id": "89743312-41ed-38c9-8eac-abe4b61ad6aa",
                                                "text": "Всего он боится."
                                            },
                                            {
                                                "example_id": "d5b39d57-8a09-4489-9b56-986b35b04ae4",
                                                "sense_id": "89743312-41ed-38c9-8eac-abe4b61ad6aa",
                                                "text": "Всегда всем доволен."
                                            },
                                            {
                                                "example_id": "aafa5bde-f0d4-4df9-8e58-8cce492b5bb8",
                                                "sense_id": "89743312-41ed-38c9-8eac-abe4b61ad6aa",
                                                "text": "Переговорили обо всём."
                                            },
                                            {
                                                "example_id": "4d7f33cf-75d8-4e46-8a2c-178396f862ac",
                                                "sense_id": "89743312-41ed-38c9-8eac-abe4b61ad6aa",
                                                "text": "За всё, за всё тебя благодарю я."
                                            },
                                            {
                                                "example_id": "a76c5db5-3d5e-44af-8d42-90583c846dca",
                                                "sense_id": "89743312-41ed-38c9-8eac-abe4b61ad6aa",
                                                "text": "Всё смешалось в доме Облонских."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cd0fb57-d9be-3fde-871e-54d8bb224740",
                                        "entry_id": "b4dff911-57db-3156-b776-a310b04bba72",
                                        "glosses": [
                                            "субстантивир., : в полном составе, без исключения (о людях)"
                                        ],
                                        "tags": [
                                            "все, всех, мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02977bd2-72ae-4291-ad33-c6d52a865d53",
                                                "sense_id": "8cd0fb57-d9be-3fde-871e-54d8bb224740",
                                                "text": "Матюшенко, а за ним и все остальные поют боевую песню: «Один за всех и все за одного»."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "весь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "adaf0ac8-c375-3dc5-aa28-14fa6bfad301",
                                        "entry_id": "f330076b-731b-301e-a00f-51a2c77c3060",
                                        "glosses": [
                                            "устар. деревня, селение, село"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f01c634-da5a-4939-813f-fd569ad42d45",
                                                "sense_id": "adaf0ac8-c375-3dc5-aa28-14fa6bfad301",
                                                "text": "Крестьяне, тянувшие в податном отношении к селу, жили в деревнях или весях — поселениях в один или несколько дворов."
                                            },
                                            {
                                                "example_id": "8a9adb77-7a0e-4139-8a14-960bc53593c1",
                                                "sense_id": "adaf0ac8-c375-3dc5-aa28-14fa6bfad301",
                                                "text": "Повторяю: веси приуныли и запустели; в весях делать нечего, потому что всё равно ничего не выйдет."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "весь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "75d58b34-fe2c-3278-978d-390c0e1e10d4",
                                        "entry_id": "d3585060-9584-30c1-a1fd-63b33ccfbdbb",
                                        "glosses": [
                                            "истор. прибалтийско-финское племя на территории Межозёрья"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69c31931-64fe-4aa1-a9c7-f34d9892a039",
                                                "sense_id": "75d58b34-fe2c-3278-978d-390c0e1e10d4",
                                                "text": "Главные финские племена: чудь — около Финского залива; далее по верхнему и среднему течению Волги — весь, меря, мурома, мордва и черемисы."
                                            }
                                        ]
                                    }
                                ]
                            },
