                                        "glosses": [
                                            "Very bad and undesirable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49e9dc03-4641-4997-afab-dae33819c51e",
                                                "sense_id": "d9190ed8-c46e-30d4-8ff2-b202bf756802",
                                                "text": "I have a stinking cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a435e18-60dd-3969-b248-b61bfd358cce",
                                        "entry_id": "45e6b9fc-d1dd-3491-b621-b9ec936cc912",
                                        "glosses": [
                                            "Very drunk."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99a97a29-81e7-45cc-ab5a-660cd813467b",
                                                "sense_id": "9a435e18-60dd-3969-b248-b61bfd358cce",
                                                "text": "Oh, I got stinking—and, worse, acted like the world's worst heel to top it off. I passed out mentally about the time we left the club—which must have been around 2:30—but unfortunately didn't pass out physically."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01660e27-8ff9-3f26-9636-33b7a3f822fc",
                                        "entry_id": "45e6b9fc-d1dd-3491-b621-b9ec936cc912",
                                        "glosses": [
                                            "An intensifier, a hypallage."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9a16b35-623d-4adc-8f08-634bf612ec19",
                                                "sense_id": "01660e27-8ff9-3f26-9636-33b7a3f822fc",
                                                "text": "We don’t need your stinking sympathy."
                                            }
                                        ]
                                    }
                                ]
                            },
