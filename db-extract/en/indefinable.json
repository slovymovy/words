                                        "entry_id": "a2635107-2b89-3575-bc6c-882588459089",
                                        "glosses": [
                                            "niejasny, nieprecyzyjny, niezupełnie zdefiniowany, niezupełnie określony"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5a904c2-388b-4f3c-ab7b-ed9aabddcc50",
                                                "sense_id": "654e9991-60b3-3432-9aae-e318bd08ca67",
                                                "text": "To pływające dziwactwo o nieokreślonych kształtach to nowy, nieznany dotąd gatunek meduzy."
                                            },
                                            {
                                                "example_id": "f1f55fa7-04b7-4b08-98b6-136d55b3f194",
                                                "sense_id": "654e9991-60b3-3432-9aae-e318bd08ca67",
                                                "text": "Jak dotąd prawa statystyk kwantowych zastosowaliśmy wyłącznie do fotonów i fononów, a więc cząstek, które mogą powstawać i znikać i liczba ich tym samym jest nieokreślona."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
