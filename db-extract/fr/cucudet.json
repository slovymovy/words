                        "examples": [
                            {
                                "example_id": "e95379cf-bb01-477d-a1ea-9bebb56dd25b",
                                "sense_id": "fdc12edc-944d-3581-b90f-65e27bd258ca",
                                "text": "Bougre de cucudet, si j'étais là, je te botterais les fesses. As-tu bien appris ta carte par cœur, au moins ?"
                            },
                            {
                                "example_id": "8c76ec97-d660-431a-83f4-a82288fb64ca",
                                "sense_id": "fdc12edc-944d-3581-b90f-65e27bd258ca",
                                "text": "—C'est pareil que begaut, mais plus près de gille gobeur. Aliboron presque mais plutot cucudet ,ça , c'est sûr, si tu vois ce que je veux dire.\n— Non , justement !\n— Eh bien , bobelin , lourdois , chalefre ?\n—Stupide , intervient Faerydae . Je ne suis pas stupide , alors qu'est - ce que tu me caches ?"
                            },
                            {
                                "example_id": "1269da06-49f8-4977-990a-6d59cdd36537",
                                "sense_id": "fdc12edc-944d-3581-b90f-65e27bd258ca",
                                "text": "Pour l'apprivoiser, je lui plaque des baisers (un cucudet écrirait \"des bisous\") dans le cou."
                            }
                        ]
                    }
