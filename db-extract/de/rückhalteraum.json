                "senses": [
                    {
                        "sense_id": "94d10900-6bb5-3090-b28a-4d1673136bc3",
                        "entry_id": "c1346164-1b5c-3155-bd3f-c5f255924f1b",
                        "glosses": [
                            "natürlicher oder auch teils künstlich geschaffener Freiraum zur vorübergehenden (auch längerfristigen) Speicherung übergroßer Mengen Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebaa37f2-f8e8-4002-8631-951484e92f48",
                                "sense_id": "94d10900-6bb5-3090-b28a-4d1673136bc3",
                                "text": "„Umweltminister Eckhard Uhlenberg (CDU) hat am Mittwoch in Niederkassel-Lülsdorf den ersten steuerbaren Rückhalteraum in Nordrhein-Westfalen in Betrieb genommen.“"
                            },
                            {
                                "example_id": "95e6da47-3805-4a72-be9c-249b06449672",
                                "sense_id": "94d10900-6bb5-3090-b28a-4d1673136bc3",
                                "text": "„Der Rückhalteraum ist zu 67 % bewaldet (Bellenkopf, Äußerer Kastenwört und Rappenwört) und steht als NATURA 2000 Gebiet unter dem Schutz der EU.“"
                            },
                            {
                                "example_id": "e9b65da1-f5db-4c95-bd25-3385878f2107",
                                "sense_id": "94d10900-6bb5-3090-b28a-4d1673136bc3",
                                "text": "„Über einen neuen, 390 Meter langen unterirdischen Zuflusskanal fliesst dieses Wasser dann in den Rückhalteraum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
