                    "frequency": "High",
                    "semantic_group_id": "succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe espère bien <w>enchaîner</w> les victoires jusqu'à la fin de la saison."
                        },
                        {
                            "text": "Ce conférencier sait <w>enchaîner</w> ses arguments avec une grande clarté."
                        }
                    ],
                    "synonyms": [
                        "concaténer"
                    ],
                    "common_phrases": [
