                "senses": [
                    {
                        "sense_id": "b884f755-868f-359a-b50e-a50e41a5cba8",
                        "entry_id": "fa7f2981-6d4b-336a-939f-bcdeb159e542",
                        "glosses": [
                            "Qui a lieu entre plusieurs départements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2b4c941-2486-443b-ac73-29a343f6e2ed",
                                "sense_id": "b884f755-868f-359a-b50e-a50e41a5cba8",
                                "text": "Sous la direction de Jean-David Desforges, le Service archéologique interdépartemental des Yvelines et des Hauts-de-Seine (S.A.I. 78-92) a mené depuis la mi-septembre des fouilles préventives dans l’ancienne caserne construite entre 1825 et 1827 pour accueillir des gardes du roi Charles X."
                            },
                            {
                                "example_id": "fed1d90e-455b-41fb-9fc3-594b22ca05fb",
                                "sense_id": "b884f755-868f-359a-b50e-a50e41a5cba8",
                                "text": "Explications de Reynald Belot, responsable du district de Remiremont à la direction interdépartementale des routes, qui s'étend de Bayon (54) à Besançon (25)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bae4084-4131-49e3-b11d-d65ceca2a826",
                        "source_entry_id": "fa7f2981-6d4b-336a-939f-bcdeb159e542",
                        "source_sense_id": "b884f755-868f-359a-b50e-a50e41a5cba8",
                        "target_lang_word": "abteilungsübergreifend",
