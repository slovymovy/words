                "senses": [
                    {
                        "sense_id": "676bc431-fe0d-358a-bbf4-d739fed36065",
                        "entry_id": "70f5a446-fa00-3c0b-a4f3-95aa478224ea",
                        "glosses": [
                            "Vereinbarung, mit der die Zusammenarbeit der Partner in einer Koalition geregelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f78a80f-ff5f-46a3-bda4-816034f8d39c",
                                "sense_id": "676bc431-fe0d-358a-bbf4-d739fed36065",
                                "text": "„Zehn Fragen an das Salzamt, zehn Antworten von Radio Eriwan (\"Im Prinzip ja, aber…\") und demnächst statt eines Koalitionsabkommens eben zehn Gebote, die als Grundlage einer neuen Regierungsethik taugen müssen.“"
                            },
                            {
                                "example_id": "a257e803-f074-4dbe-913d-904649ffe05b",
                                "sense_id": "676bc431-fe0d-358a-bbf4-d739fed36065",
                                "text": "„Nach Meinung des Kanzlers ist alles, was derzeit diskutiert werde, klar im Koalitionsabkommen verankert.“"
                            },
                            {
                                "example_id": "7c5a7309-f4c2-46fa-ade2-435bba9781a1",
                                "sense_id": "676bc431-fe0d-358a-bbf4-d739fed36065",
                                "text": "„In ihrem Koalitionsabkommen sprachen sich Rechtsliberale und Sozialdemokraten für ein starkes Europa aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
