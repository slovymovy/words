                },
                {
                    "sense_id": "f64c08b5-2341-3b78-8ffa-7f7c4c8ce6a3",
                    "sense_definition": "An arch rising from the rim of a crown and meeting others at its center.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crown_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each <w>diadem</w> of the royal crown was decorated with intricate gold filigree."
                        },
                        {
                            "text": "The jeweler carefully inspected the curved <w>diadem</w> supporting the central globe."
                        }
                    ],
                    "synonyms": [
