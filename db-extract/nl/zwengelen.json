                ],
                "senses": [
                    {
                        "sense_id": "78b6c574-b65e-3c76-9ca0-704675c191eb",
                        "entry_id": "839a9a82-52cb-3883-9fc7-e2c46041019b",
                        "glosses": [
                            "slingeren"
                        ],
                        "tags": [
                            "laten"
                        ],
                        "examples": [
                            {
                                "example_id": "809ad319-e457-4c57-9e81-39a9cdd7b776",
                                "sense_id": "78b6c574-b65e-3c76-9ca0-704675c191eb",
                                "text": "Zwijgen, of..... zei het personaadje, en hij sloeg de hand op het handvest van een zwaren slagdegen die, aan zijne zijde, aan een lederen band zwengelde."
                            },
                            {
                                "example_id": "929b21e3-fd94-4427-bb14-4d3c7fc84ff0",
                                "sense_id": "78b6c574-b65e-3c76-9ca0-704675c191eb",
                                "text": "Miete haalde haar schouders op, zwengelde haar slanke beenen heen en weer en vervolgde koppig."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0bef087-0a75-3d75-83c4-947cf02fb9f0",
                        "entry_id": "839a9a82-52cb-3883-9fc7-e2c46041019b",
                        "glosses": [
                            "aan een zwengel draaien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68f7311a-6b23-4669-b75e-04890dee193a",
                                "sense_id": "e0bef087-0a75-3d75-83c4-947cf02fb9f0",
                                "text": "De oude man zwengelde aan de waterpomp."
                            },
                            {
                                "example_id": "10c40e1b-9d8c-4b97-961f-379fe5cf94ed",
                                "sense_id": "e0bef087-0a75-3d75-83c4-947cf02fb9f0",
                                "text": "Zoo was het, in een geval waarvoor de schrijver instaat, voorgekomen dat een vijf en zestig jarig priester, nadat men in zijn kelders en kerktoren vergeefs naar wapenen gezocht had, gedwongen werd eenige uren de pomp te zwengelen, om de soldaten bij het wasschen te helpen."
                            }
                        ]
                    },
                    {
                        "sense_id": "47de04dc-102d-3506-8d2a-298346d24d9d",
                        "entry_id": "839a9a82-52cb-3883-9fc7-e2c46041019b",
                        "glosses": [
                            "braken van vlas, d.w.z. de aanhangende houtdeeltjes met een zwengel verwijderen"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
