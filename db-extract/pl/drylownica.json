                                                "sense_id": "950f1036-33b1-36f2-9784-e1f8a04e13eb",
                                                "text": "Dénoyauteur de cerises."
                                            },
                                            {
                                                "example_id": "20cc8de6-4338-4b7a-a4b5-dcbdbf6387d5",
                                                "sense_id": "950f1036-33b1-36f2-9784-e1f8a04e13eb",
                                                "text": "Voilà le dénoyauteur à cerises, c’est si bien fait que tu vois même pas le trou dans la cerise, je vous prie de bien noter ceci, véritable tour de force, merveille de la science française, vous posez la cerise là, comme ceci, oui, oui, vous."
                                            },
                                            {
                                                "example_id": "8524b68f-ca79-4f91-b9dd-8304520f54e9",
                                                "sense_id": "950f1036-33b1-36f2-9784-e1f8a04e13eb",
                                                "text": "Allonge-toi sur la table de la cuisine, je vais chercher mon dénoyauteur multifruits."
                                            }
                                        ]
