                                "example_id": "9330d221-cc55-4622-81e8-4ede2a64a632",
                                "sense_id": "cc4ff32d-f086-3285-ae4b-388a165457bd",
                                "text": "Przygotowujący się do pracy singulator musiał się objawiać odległym astronomom fenomenem w rodzaju czarnej dziury, tworząc z zasysanych, długich dżetów krótkookresowy asymetryczny dysk akrecyjny"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b72c893-2fc7-4837-8f5f-baa929dab9d5",
                        "source_entry_id": "8633723b-9d9e-38cc-b513-f6138846e8ad",
                        "source_sense_id": "cc4ff32d-f086-3285-ae4b-388a165457bd",
                        "target_lang_word": "accretive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accretive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7289ba1c-d84f-3f33-9bb5-a1dedcf5c955",
                                        "entry_id": "21b1d1f5-9ac4-393f-8506-2d0b1be01bfb",
                                        "glosses": [
                                            "Relating to accretion; increasing, or adding to, by growth."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adcbc30e-0f0a-4ccd-8c0d-01f0bea12c1e",
                                                "sense_id": "7289ba1c-d84f-3f33-9bb5-a1dedcf5c955",
                                                "text": "[…] Vegetables spring up from their Mother Earth; and we can no more discern their accretive Motion, then we can their most hidden cause."
                                            },
                                            {
                                                "example_id": "92f5d90c-fef3-4c02-bc58-233acaf45099",
                                                "sense_id": "7289ba1c-d84f-3f33-9bb5-a1dedcf5c955",
                                                "text": "There could be no rest-houses for revolt, no dividend of joy paid out. Its spirit was accretive, to endure as far as the senses would endure, and to use each advance as base for further adventure, deeper privation, sharper pain."
                                            },
                                            {
                                                "example_id": "a7ca6450-6893-4703-9de4-d6620a99f584",
                                                "sense_id": "7289ba1c-d84f-3f33-9bb5-a1dedcf5c955",
                                                "text": "The deal, expected to be completed by the summer, would be immediately accretive to cashflow and earnings per share while giving BP an extra 500,000 barrels per day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
