                        ]
                    },
                    {
                        "translation_id": "8a4c8a47-9361-4b60-b187-d02eaec97110",
                        "source_entry_id": "ddc92c05-f0ad-3e7c-8c54-13fd2a7b61bb",
                        "source_sense_id": "30bc94f2-4db0-3265-b148-f94fe669ff20",
                        "target_lang_word": "restlessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restlessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bfcbfa5-4033-3aea-a409-519ffdffd4bb",
                                        "entry_id": "308f1763-62e2-3426-b8a0-1af94c01260b",
                                        "glosses": [
                                            "The state or condition of being restless; an inability to be still, quiet, at peace or comfortable."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d18c12b6-2745-4a5b-bf95-a7b088601d40",
                                                "sense_id": "0bfcbfa5-4033-3aea-a409-519ffdffd4bb",
                                                "text": "She sat and fidgeted out of restlessness as she waited."
                                            },
                                            {
                                                "example_id": "933c7f4b-f2a9-404c-9364-de2818fe9c63",
                                                "sense_id": "0bfcbfa5-4033-3aea-a409-519ffdffd4bb",
                                                "text": "A feeling of restlessness and an urge to move in your arms, legs or torso is a state of hyperarousal and can keep you from a good night’s sleep, she said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "034309a8-7fda-4b88-a029-85a5a4e1cf64",
                        "source_entry_id": "ddc92c05-f0ad-3e7c-8c54-13fd2a7b61bb",
                        "source_sense_id": "30bc94f2-4db0-3265-b148-f94fe669ff20",
                        "target_lang_word": "netrpělivost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "netrpělivost",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "402a5700-d34d-3274-a70c-ea3f2ac594c5",
                                        "entry_id": "a848c2aa-169b-378b-b47c-0f3569306f56",
                                        "glosses": [
                                            "neochota dlouho klidně čekat resp. opakovaně vykonávat určitou činnost, než se dostaví žádoucí výsledek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "694d52bd-23d1-4ca8-a80a-550a85f0f797",
                                                "sense_id": "402a5700-d34d-3274-a70c-ea3f2ac594c5",
                                                "text": "Proč Západ nezvolil stejnou taktiku? Protože něco takového je v rozporu s jeho kulturou netrpělivosti, touhou řešit všechny problémy rychle, s co nejmenšími náklady a zátěží. Ale jak se ukázalo tenhle přístup s covidem nefunguje. „Podle mého názoru souvisí netrpělivost s ideologickým přístupem, který za nejhodnotnější cíl lidského života považuje ekonomický úspěch, dosažený co nejrychleji to jde,“ píše Milanović."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5f12f37-fa64-4f60-b3dd-0747f807a3bf",
                        "source_entry_id": "ddc92c05-f0ad-3e7c-8c54-13fd2a7b61bb",
                        "source_sense_id": "30bc94f2-4db0-3265-b148-f94fe669ff20",
                        "target_lang_word": "impatience",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impatience",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72f13485-d3dc-38a4-9323-fb6b8e32c6be",
                                        "entry_id": "bb69a4ae-a69f-352d-b619-18bec7935d32",
                                        "glosses": [
                                            "Manque de patience, sentiment d’inquiétude ou d’irritation que l’on éprouve, soit dans la souffrance d’un mal, soit dans l’attente de quelque bien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8205734-26ea-4a9b-b222-77eb6fbcbd5d",
                                                "sense_id": "72f13485-d3dc-38a4-9323-fb6b8e32c6be",
                                                "text": "Maintenant, toutes les jeunes filles, romanesques ou non, peuvent imaginer dans quelle impatience vécut Modeste pendant quelques jours !"
                                            },
                                            {
                                                "example_id": "0d04f94c-b21b-49c9-bae0-88ea23c33fd4",
                                                "sense_id": "72f13485-d3dc-38a4-9323-fb6b8e32c6be",
                                                "text": "Pendant une conversation donner les signes d'impatience."
                                            },
                                            {
                                                "example_id": "f0478468-27fb-48e4-9147-3ebb7ecae435",
                                                "sense_id": "72f13485-d3dc-38a4-9323-fb6b8e32c6be",
                                                "text": "Et maintenant, parti dès l'aube par la belle route de Lambèse, il pressait son cheval, pris d'une impatience qui l'étonnait lui-même."
                                            },
                                            {
                                                "example_id": "94ec418b-d4a3-4ebf-b6da-d5eb44368509",
                                                "sense_id": "72f13485-d3dc-38a4-9323-fb6b8e32c6be",
                                                "text": "Ainsi pour mon malheur, toujours brûlant des ardeurs de l’impatience, je dois soupirer sans cesse après ma santé, la demander instamment, et ne rien omettre pour l’obtenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b3e2cbc-4b0c-3736-98a1-71f48e5fbf01",
                                        "entry_id": "bb69a4ae-a69f-352d-b619-18bec7935d32",
                                        "glosses": [
                                            "Sorte d’irritation nerveuse que cause l’impatience."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "311aed1d-d49c-4037-9e22-185569460f7d",
                                                "sense_id": "2b3e2cbc-4b0c-3736-98a1-71f48e5fbf01",
                                                "text": "Cet homme parle avec une lenteur qui donne des impatiences à ceux qui l’écoutent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bdfb43a-a761-3b62-bfae-63b2ba93845b",
                                        "entry_id": "bb69a4ae-a69f-352d-b619-18bec7935d32",
                                        "glosses": [
                                            "Sorte de démangeaison."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bed3b9a1-7eaa-4a8e-9dfa-641c22b51215",
                                                "sense_id": "1bdfb43a-a761-3b62-bfae-63b2ba93845b",
                                                "text": "Les impatiences, encore dénommées le syndrome des jambes sans repos, provoquent des manifestations désagréables dans les jambes qui peuvent être modérées ou très invalidantes. Celles-ci surviennent davantage le soir et au cours de la nuit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
