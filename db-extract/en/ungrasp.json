                        "glosses": [
                            "The act of ungrasping; the release of something that is grasped."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "912ab3e9-d1a0-49f2-b6d5-8f0f84f91930",
                                "sense_id": "cfe00045-5b3a-3a60-87e3-e446d8b30a01",
                                "text": "This means that the ungrasp of the object constraints the grasping."
                            },
                            {
                                "example_id": "2a595c8f-8630-4b2f-8350-1f5096afab67",
                                "sense_id": "cfe00045-5b3a-3a60-87e3-e446d8b30a01",
                                "text": "For example, the system will select a grasp point for an object without concerning itself about possible problems during the ungrasp that is to be performed many steps in the future."
                            },
                            {
                                "example_id": "0f3a1654-1aaa-4560-b343-e38fdfe949ef",
                                "sense_id": "cfe00045-5b3a-3a60-87e3-e446d8b30a01",
                                "text": "After the grasping orientation has been decided, find the proper locations for the grasp and ungrasp of the gripper."
                            }
                        ]
                    }
