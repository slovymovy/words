{
    "word_family": [
        "oppervlak",
        "oppervlakte",
        "oppervlakkigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec436a6d-e69c-3e5e-8dec-4b41e8dbda23",
                    "sense_definition": "zich aan de oppervlakte bevindend en niet diep in het lichaam of een object",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts stelde vast dat het slechts een <w>oppervlakkige</w> wond was die snel zou genezen.",
                            "target_lang_translations": {
                                "en": "The doctor determined that it was only a <w>superficial</w> wound that would heal quickly."
                            }
                        },
                        {
                            "text": "Tijdens het onderzoek werden alleen <w>oppervlakkige</w> beschadigingen aan de buitenkant van de auto gevonden.",
                            "target_lang_translations": {
                                "en": "During the inspection, only <w>surface</w> damage was found on the exterior of the car."
                            }
                        }
                    ],
                    "antonyms": [
                        "diep"
                    ],
                    "common_phrases": [
                        "oppervlakkige wond",
                        "oppervlakkige beschadiging"
                    ],
                    "target_lang_definitions": {
                        "en": "located on the surface and not deep within the body or an object"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "superficial",
                                "target_lang_sense_clarification": "relating to the surface of the body or an object"
                            },
                            {
                                "target_lang_word": "surface",
                                "target_lang_sense_clarification": "occurring only on the outer layer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57d9a5af-3a30-3e6c-b967-fecac681119a",
                    "sense_definition": "zonder veel aandacht voor details of diepgang; niet grondig",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mentaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar heeft dat moeilijke probleem slechts een <w>oppervlakkige</w> behandeling gegeven.",
                            "target_lang_translations": {
                                "en": "The teacher gave that difficult problem only a <w>superficial</w> treatment."
                            }
                        },
                        {
                            "text": "Na een <w>oppervlakkige</w> blik op het rapport besloot de directeur het plan goed te keuren.",
                            "target_lang_translations": {
                                "en": "After a <w>cursory</w> glance at the report, the director decided to approve the plan."
                            }
                        }
                    ],
                    "synonyms": [
                        "terloops",
                        "vluchtig"
                    ],
                    "antonyms": [
                        "grondig",
                        "diepgaand"
                    ],
                    "common_phrases": [
                        "oppervlakkige blik",
                        "oppervlakkige kennis"
                    ],
                    "target_lang_definitions": {
                        "en": "without much attention to detail or depth; not thorough"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "superficial",
                                "target_lang_sense_clarification": "not thorough or complete"
                            },
                            {
                                "target_lang_word": "cursory",
                                "target_lang_sense_clarification": "hasty and therefore not thorough"
                            },
                            {
                                "target_lang_word": "shallow",
                                "target_lang_sense_clarification": "lacking intellectual depth"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc55a2da-cb56-3794-ae57-d9c36faf2610",
                    "sense_definition": "geen diepe gevoelens of serieuze gedachten tonend; niet diepzinnig als persoon",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is nu eenmaal een <w>oppervlakkig</w> mens die alleen om uiterlijk en geld geeft.",
                            "target_lang_translations": {
                                "en": "He is simply a <w>shallow</w> person who only cares about looks and money."
                            }
                        },
                        {
                            "text": "Onze gesprekken blijven altijd erg <w>oppervlakkig</w> en gaan nooit over wat ons echt bezighoudt.",
                            "target_lang_translations": {
                                "en": "Our conversations always remain very <w>superficial</w> and never touch on what truly concerns us."
                            }
                        }
                    ],
                    "antonyms": [
                        "diepzinnig"
                    ],
                    "common_phrases": [
                        "oppervlakkig mens",
                        "oppervlakkig gesprek"
                    ],
                    "target_lang_definitions": {
                        "en": "showing no deep feelings or serious thoughts; not profound as a person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "superficial",
                                "target_lang_sense_clarification": "lacking depth of character or substance"
                            },
                            {
                                "target_lang_word": "shallow",
                                "target_lang_sense_clarification": "not exhibiting, indicating, or capable of serious thought"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}