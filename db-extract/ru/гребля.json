                            {
                                "target_word": "rowing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85c975cb-6c50-3503-904d-b8a1cad21a70",
                                        "entry_id": "fd3e9dbe-e138-35a2-a883-d59acb20eb50",
                                        "glosses": [
                                            "The act of having a row, or argument."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b564f0d-0773-4353-8a0b-f203f77dd6d0",
                                                "sense_id": "85c975cb-6c50-3503-904d-b8a1cad21a70",
                                                "text": "She and Ricketts — that's his father — just disgraced the neighbourhood with their rowings and their sprees […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72fd62e6-979a-4cd0-91ae-d1439c22daf7",
                        "source_entry_id": "0e03f6e5-5ead-3c05-b322-af895b3b5f14",
                        "source_sense_description": "действие",
                        "target_lang_word": "canotage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canotage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f35cd49-4659-34e2-9a60-4d25ff53a03b",
                                        "entry_id": "0a0db878-babd-317a-9998-8b2574c0e1ad",
                                        "glosses": [
                                            "Action de canoter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7696fece-c5b4-40c1-b04f-5a420e1333f6",
                                                "sense_id": "0f35cd49-4659-34e2-9a60-4d25ff53a03b",
                                                "text": "Nous ne voulons pas entrer dans la vie privée de beaucoup de canotiers; mais à en croire les apparences, le canotage ne serait, pour quelques amateurs, qu'un prétexte d'orgies, une occasion de plaisirs faciles, au lieu d'un amusement salutaire et convenable à la dignité de l'homme."
                                            },
                                            {
                                                "example_id": "40cbd7ce-682a-485c-8768-e3780790e2dc",
                                                "sense_id": "0f35cd49-4659-34e2-9a60-4d25ff53a03b",
                                                "text": "Je l'entends dans les mêmes bouches depuis la constitution de la Ligue pour l'éducation physique à propos des rallie-papier, du canotage et du bicycle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffdb4627-5cab-3396-ad0d-476f9c863230",
                                        "entry_id": "0a0db878-babd-317a-9998-8b2574c0e1ad",
