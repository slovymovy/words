                "senses": [
                    {
                        "sense_id": "00271d82-9908-3e86-9b83-fe5c0d3c0554",
                        "entry_id": "14d5483f-fff9-3337-becd-3f21d3a9cbda",
                        "glosses": [
                            "Défaire de l’influence des Bourbons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89e4d5ee-a281-4cbe-b618-68402dd9c290",
                                "sense_id": "00271d82-9908-3e86-9b83-fe5c0d3c0554",
                                "text": "À l’occasion d’une réception officielle aux Ormes, le marquis de Voyer avait osé déclarer qu’il fallait « débourboniser la France » (cf. Mémoires du duc des Cars, 1850, t. I)."
                            },
                            {
                                "example_id": "c9037171-49cf-4ba0-b260-f356929b913a",
                                "sense_id": "00271d82-9908-3e86-9b83-fe5c0d3c0554",
                                "text": "Laffitte cherche à rassurer son interlocuteur en prétendant que, depuis 1789, le prince s’est « débourbonisé » (en quoi il se trompe lourdement) et que, par mesure de précaution, il faudra le « garrotter »."
                            }
                        ]
                    }
