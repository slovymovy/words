                "senses": [
                    {
                        "sense_id": "c90ff5b3-a5a3-3305-b850-0604ce4731d1",
                        "entry_id": "13da58bc-130f-3181-a13e-420124116767",
                        "glosses": [
                            "Qui pinaille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c407b995-a757-4a7a-8c86-51c723ae1d87",
                                "sense_id": "c90ff5b3-a5a3-3305-b850-0604ce4731d1",
                                "text": "D'apparence purement technique, et souvent caricaturé comme pinailleur et ennuyeux, ce développement a en réalité nécessité des années d'âpres négociations politiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf5f62d2-0e16-45cb-93c5-2325aaabdcb2",
                        "source_entry_id": "13da58bc-130f-3181-a13e-420124116767",
                        "source_sense_id": "c90ff5b3-a5a3-3305-b850-0604ce4731d1",
                        "target_lang_word": "pingelig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pingelig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c84d4e00-76e2-3f96-a5c6-78b3531398da",
                                        "entry_id": "27dc4380-97b6-38fa-b730-0ff1a6836847",
                                        "glosses": [
                                            "sehr differenziert, sehr genau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a01629-335a-4011-ba58-cfb5c3446bfe",
                                                "sense_id": "c84d4e00-76e2-3f96-a5c6-78b3531398da",
                                                "text": "„Unser neuer Chef ist aber pingelig!“"
                                            },
                                            {
                                                "example_id": "9095e356-51e4-4eab-b185-a0db4d7b87c1",
                                                "sense_id": "c84d4e00-76e2-3f96-a5c6-78b3531398da",
                                                "text": "„Da muss ich nun aber zunächst etwas pingelig ins Lautliche einsteigen, weil dieses hier mit dem Inhaltlichen, wie mir scheint, zu tun hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00cdaf3c-38af-436d-b492-ac4cd9a46f6b",
                        "source_entry_id": "13da58bc-130f-3181-a13e-420124116767",
                        "source_sense_id": "c90ff5b3-a5a3-3305-b850-0604ce4731d1",
                        "target_lang_word": "rabulistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rabulistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb64f88c-d2fe-34dc-8c15-f447ed595b77",
                                        "entry_id": "12f20cef-e5ba-3c15-b06b-5085e4ba9d3f",
                                        "glosses": [
                                            "haarspalterisch, spitzfindig, sophistisch"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2823ef9-d53b-492e-b41d-0a75525291ea",
                                                "sense_id": "bb64f88c-d2fe-34dc-8c15-f447ed595b77",
                                                "text": "Seine rabulistische Art konnte jeden innerhalb kürzester Zeit zur Weißglut bringen."
                                            },
                                            {
                                                "example_id": "e19af4c1-1212-4a39-ac53-92a8ff360550",
                                                "sense_id": "bb64f88c-d2fe-34dc-8c15-f447ed595b77",
                                                "text": "„Ich sage nämlich: es ist mit seiner Erlaubnis, Einwürfe gegen Religion und Bibel, gegen das, was er Religion und Bibel nennt, machen zu dürfen, nur Larifari. Er gibt sie und gibt sie nicht: denn er verklausuliert sie von allen Seiten so streng und rabulistisch, daß man sich, Gebrauch davon zu machen, wohl hüten muß.“"
                                            },
                                            {
                                                "example_id": "ec2e2c05-6a7c-4e1b-a207-db5ce896c758",
                                                "sense_id": "bb64f88c-d2fe-34dc-8c15-f447ed595b77",
                                                "text": "„Und vollends Augustinus hatte schon, im Buche gegen die Skeptiker (Gegen die Akademiker), rabulistisch darauf hingewiesen, daß man nichts wahrscheinlich, verisimilis, nennen dürfe, wenn man die Wahrheit selbst nicht kenne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00bab981-d858-4016-bcb0-de582cdc58d1",
                        "source_entry_id": "13da58bc-130f-3181-a13e-420124116767",
                        "source_sense_id": "c90ff5b3-a5a3-3305-b850-0604ce4731d1",
                        "target_lang_word": "rechthaberisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rechthaberisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2077eb5e-bbb0-331b-bd5b-c1e4be6788e8",
                                        "entry_id": "50695f61-e4b4-3288-bfc8-ece5f45a2849",
                                        "glosses": [
                                            "den eigenen Standpunkt gegen alle anderen durchsetzen wollend oder auf der eigenen Meinung beharrend, auch wenn das Gegenteil bewiesen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ac3555-92ee-427f-bba9-1127eef18a86",
                                                "sense_id": "2077eb5e-bbb0-331b-bd5b-c1e4be6788e8",
                                                "text": "Und Sie, Mylord, verzeihen Sie, sind noch immer so pedantisch, so rechthaberisch, als Sie waren.<"
                                            },
                                            {
                                                "example_id": "38455575-3362-4653-9ef3-576459f1497b",
                                                "sense_id": "2077eb5e-bbb0-331b-bd5b-c1e4be6788e8",
                                                "text": "Selbstverständlich und höchst gleichgültig, daß er oft dabei in seiner Begeisterung danebenhieb, daß er oft in Unrecht geriet, daß er oft rechthaberisch, bös, eitel, unversöhnlich und bitter werden konnte, daß er oft von Dingen sprach, die er nicht ganz verstand, daß er vieles nur von einer Seite sah, daß er nicht alles genügend durchdenken konnte, daß er sich und seiner heiligen stets wachen Selbsttreue oft hereinfiel."
                                            },
                                            {
                                                "example_id": "668f6bd5-9f86-4460-ac59-375af5d21bbf",
                                                "sense_id": "2077eb5e-bbb0-331b-bd5b-c1e4be6788e8",
                                                "text": "Das Hauptübel bei Capefigue ist, daß er den Charakter Luthers nicht versteht, daß er nicht begreift, daß man so rechthaberisch, so heftig, so unbillig als Luther und doch zugleich ein wahrhaft Begeisterter sein kann."
                                            },
                                            {
                                                "example_id": "c73f65f9-7f3e-4fd3-ad86-ae7d291f9440",
                                                "sense_id": "2077eb5e-bbb0-331b-bd5b-c1e4be6788e8",
                                                "text": "Wenige Minuten darauf wird vielleicht ein ernsthaftes Thema angeschlagen aus der Politik, der Volkswirtschaft, der Soziologie, der Rechtsprechung, es sei, was es wolle, Einstein wird jeden Gedankenfaden fortspinnen, mit feiner Einfühlung in den Gesprächspartner, mit Aufstellung eigener Perspektiven, nie rechthaberisch, stets anregend, mit voller Sympathie für den Gegenstand und für alle Denkformen, worin er sich spiegelt, das Modell eines Wissenden, den Terenz sprechen läßt: Ich bin ein Mensch, nichts Menschliches ist mir fremd!"
                                            },
                                            {
                                                "example_id": "ce8643ab-d441-45c4-9b14-21a5700af33d",
                                                "sense_id": "2077eb5e-bbb0-331b-bd5b-c1e4be6788e8",
                                                "text": "»… Ja, sie wird's« – setzte die Mutter rechthaberisch hinzu, als Celita ungläubig mit dem Kopf schüttelte, »den Doctor reizen die Häuser in Guajaquil und Quito, ihn lockt das baare Geld, das sie im Kasten liegen hat, und er ist gerade der rechte Mann, hartnäckig und unermüdlich dahinter her zu sein – kenn' ich ihn doch von früher gut genug.«"
                                            },
                                            {
                                                "example_id": "38b7084c-f9f7-4a3a-a624-19286efcd9be",
                                                "sense_id": "2077eb5e-bbb0-331b-bd5b-c1e4be6788e8",
                                                "text": "Wie kann ich Sie trösten, ohne dass es rechthaberisch klänge?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b770b9b-6db0-408e-9996-56103e77464a",
                        "source_entry_id": "13da58bc-130f-3181-a13e-420124116767",
                        "source_sense_id": "c90ff5b3-a5a3-3305-b850-0604ce4731d1",
                        "target_lang_word": "doryphore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doryphore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "583bc0e9-70f6-3f09-bb0e-9f0b9f581ca9",
                                        "entry_id": "dc278bbd-9bd2-3c9b-b3de-cac7305aa315",
                                        "glosses": [
                                            "A petty pedant, a person who complains about minor mistakes."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "824c2498-5c2f-420a-bc3b-be65b13e0654",
                                                "sense_id": "583bc0e9-70f6-3f09-bb0e-9f0b9f581ca9",
                                                "text": "Often have I tried to supplement my vocabulary by inventing words, such as ‘couth’, or ‘doriphore’, or ‘hypoulic’, feeling that it is the duty as well as the pastime of a professional writer to make two words bloom where only one bloomed before."
                                            },
                                            {
                                                "example_id": "b8ba6236-7049-4aa8-9205-b63055abdd81",
                                                "sense_id": "583bc0e9-70f6-3f09-bb0e-9f0b9f581ca9",
                                                "text": "The idiomatic implications of such a word as doryphore in his own text is left for the ignorant to guess. (It means a Colorado beetle and, hence, a pest.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
