                    {
                        "form_id": "5a6de288-dce7-424e-8a65-f739cac66473",
                        "entry_id": "ddb5cafa-ec92-32d3-a613-db7432290f82",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "избу́шках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f7b792d-4170-395a-ad3f-488237174d8d",
                        "entry_id": "ddb5cafa-ec92-32d3-a613-db7432290f82",
                        "glosses": [
                            "разг. уменьш.-ласк. к изба небольшая изба"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d6a9764-063e-403b-8f15-2d433271ccd8",
                                "sense_id": "4f7b792d-4170-395a-ad3f-488237174d8d",
                                "text": "Наискось стояло несколько избушек; по улице бродило несколько куриц."
                            },
                            {
                                "example_id": "3e7fd0ca-c3d6-4b7d-9fbf-3db4f64c4c89",
                                "sense_id": "4f7b792d-4170-395a-ad3f-488237174d8d",
                                "text": "Юдины выселки состояли из шести низеньких и маленьких избушек, уже успевших скривиться набок, хотя их, вероятно, поставили недавно: дворы не у всех были обнесены плетнём."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de4b814f-5592-40b4-b444-f4b910a2b61c",
                        "source_entry_id": "ddb5cafa-ec92-32d3-a613-db7432290f82",
                        "source_sense_id": "4f7b792d-4170-395a-ad3f-488237174d8d",
                        "target_lang_word": "hut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fca7571a-fd0a-387c-9892-f29426e02eba",
                                        "entry_id": "9a726c81-f84f-3a2d-8ba8-deecae597d95",
                                        "glosses": [
                                            "To provide (someone) with shelter in a hut."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baa44e22-6697-40da-ba98-f259950d29e4",
                                                "sense_id": "fca7571a-fd0a-387c-9892-f29426e02eba",
                                                "text": "to hut troops in winter quarters"
                                            },
                                            {
                                                "example_id": "29e58228-c729-4b49-89be-814ceb971880",
                                                "sense_id": "fca7571a-fd0a-387c-9892-f29426e02eba",
                                                "text": "[…] commonly the Captaines, after their souldiers are hutted, build Hutts in the place, where their tents stood,"
                                            },
                                            {
                                                "example_id": "97e1381d-46b0-4379-9007-022278b12c6f",
                                                "sense_id": "fca7571a-fd0a-387c-9892-f29426e02eba",
                                                "text": "[…] the scite of the New Town, where divisions of the 17th and 20th light dragoons had hutted themselves."
                                            },
                                            {
                                                "example_id": "a0f0033e-e740-4699-9fbc-0e0309136265",
                                                "sense_id": "fca7571a-fd0a-387c-9892-f29426e02eba",
                                                "text": "His troops, hutted among the heights of Morristown, were half fed, half clothed, and inferior in number to the garrison of New York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9308bda5-47b7-36cb-92ee-39a0ae62321c",
                                        "entry_id": "9a726c81-f84f-3a2d-8ba8-deecae597d95",
                                        "glosses": [
                                            "To take shelter in a hut."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a86b8c87-1340-4348-bd06-06f443abba8c",
                                                "sense_id": "9308bda5-47b7-36cb-92ee-39a0ae62321c",
                                                "text": "1653, Newsletter sent from London to Edward Nicholas dated 17 June, 1653, in William Dunn Macray (ed.), Calendar of the Clarendon State Papers, Oxford: Clarendon Press, 1869, Volume 2, p. 219,\nSeven boatfuls of Dutch prisoners have been taken to Chelsea College, where they are to hut under the walls."
                                            },
                                            {
                                                "example_id": "b45d7a92-ae9a-424d-be1e-1c6e4c93866f",
                                                "sense_id": "9308bda5-47b7-36cb-92ee-39a0ae62321c",
                                                "text": "He removed with the troops, on the 19th, to Valley-forge, where they hutted, about sixteen miles from Philadelphia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5cc5abc-77f5-3c25-9d84-29ab4206752b",
                                        "entry_id": "9a726c81-f84f-3a2d-8ba8-deecae597d95",
                                        "glosses": [
                                            "To stack (sheaves of grain)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5025d313-53d1-4412-aacd-6438f161c492",
                                                "sense_id": "f5cc5abc-77f5-3c25-9d84-29ab4206752b",
                                                "text": "The method of endeavouring to save corn in bad harvests, by hutting it in the field, is often practised in the north and west of Scotland,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03ac694b-a448-3ab8-9f45-3300a43ebeb8",
                                        "entry_id": "6fda4bc9-1aaf-39e9-9856-2933a1dd2f72",
                                        "glosses": [
                                            "Called by the quarterback to prepare the team for a play."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6c65429-ed28-3eaf-a58c-22a6b3886d4a",
                                        "entry_id": "7ed16b60-2bb1-3057-a64b-a4fdd8810d0b",
                                        "glosses": [
                                            "A small, simple one-storey dwelling or shelter, often with just one room, and generally built of readily available local materials."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29f19c28-3968-4fa4-8461-cee71f575278",
                                                "sense_id": "b6c65429-ed28-3eaf-a58c-22a6b3886d4a",
                                                "text": "a thatched hut; a mud hut; a shepherd’s hut"
                                            },
                                            {
                                                "example_id": "72d092f0-a83c-47a1-870e-c1531cbbdbaa",
                                                "sense_id": "b6c65429-ed28-3eaf-a58c-22a6b3886d4a",
                                                "text": "And in his Hut, when hee to rest doth take him,\nHee sleeps, till Drums or deadlie Pellets wake him."
                                            },
                                            {
                                                "example_id": "70fb44a0-c7b3-4079-bff7-bb22702bb749",
                                                "sense_id": "b6c65429-ed28-3eaf-a58c-22a6b3886d4a",
                                                "text": "1751, Samuel Johnson, The Rambler, No. 186, 28 December, 1751, Volume 6, London: J. Payne and J. Bouquet, 1752, pp. 108-109,\n[…] love, that extends his dominion wherever humanity can be found, perhaps exerts the same power in the Greenlander’s hut, as in the palaces of eastern monarchs."
                                            },
                                            {
                                                "example_id": "1689b477-7107-4758-b5c2-8e87d0cef139",
                                                "sense_id": "b6c65429-ed28-3eaf-a58c-22a6b3886d4a",
                                                "text": "[…] I was a hired-out shepherd in a solitary hut, not seeing no faces but faces of sheep till I half forgot wot men’s and women’s faces wos like,"
                                            },
                                            {
                                                "example_id": "ac4bfbb6-4d40-46ac-a888-75c9de6795d3",
                                                "sense_id": "b6c65429-ed28-3eaf-a58c-22a6b3886d4a",
                                                "text": "There was an oil lamp in all the four huts on Okonkwo’s compound, and each hut seen from the others looked like a soft eye of yellow half-light set in the solid massiveness of night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12e6e340-f129-3538-81c5-9d48a31fe60b",
                                        "entry_id": "7ed16b60-2bb1-3057-a64b-a4fdd8810d0b",
                                        "glosses": [
                                            "A small wooden shed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50e8b3b-0b84-4003-a849-4f699b5fb771",
                                                "sense_id": "12e6e340-f129-3538-81c5-9d48a31fe60b",
                                                "text": "a groundsman’s hut"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03f9c5b0-d2b0-33f6-b03d-22df7971a00e",
                                        "entry_id": "7ed16b60-2bb1-3057-a64b-a4fdd8810d0b",
                                        "glosses": [
                                            "A small stack of grain."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
