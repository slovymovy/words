                "senses": [
                    {
                        "sense_id": "ab012fbb-ded6-344c-92ae-58865cd627bb",
                        "entry_id": "cbc8388c-8082-3680-a6c7-876822dc2f45",
                        "glosses": [
                            "Donner un caractère corinthien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57a13eff-71b0-4172-a9d3-2633375a3e90",
                                "sense_id": "ab012fbb-ded6-344c-92ae-58865cd627bb",
                                "text": "Les chapiteaux des pilastres qui engendrent l’abside corinthisent encore, mais c’est en faisant sortir de l’astragale deux tiges qui vont éployer, aux angles et au sortir d'une bague, six feuilles retombantes et pennatifides."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfda94fc-e2f5-3989-a51a-5145eb233953",
                        "entry_id": "cbc8388c-8082-3680-a6c7-876822dc2f45",
                        "glosses": [
                            "Se livrer à la débauche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c3c6535-b26d-45b9-b70c-6544b77b5979",
                                "sense_id": "bfda94fc-e2f5-3989-a51a-5145eb233953",
                                "text": "Depuis des mois, des désordres graves perturbaient la communauté de Corinthe : des chrétiens se rendaient sur l’acrocorinthe pour « corinthiser » avec les prostituées sacrées du temple d’Aphrodite."
                            },
                            {
                                "example_id": "6d4b5f0e-4f12-4336-bfcc-fde2b3728b41",
                                "sense_id": "bfda94fc-e2f5-3989-a51a-5145eb233953",
                                "text": "Vivre comme un Corinthien, se “ corinthiser ”, finit par signifier vivre dans la débauche."
                            }
                        ]
                    }
                ],
