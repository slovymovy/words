                    {
                        "translation_id": "8ef76221-9ac8-4e3f-9a2b-2f5e279f49c4",
                        "source_entry_id": "af4918d3-272b-371d-849e-f66355c31edc",
                        "source_sense_id": "16b8ac66-a43f-3f18-8a79-96a2797b5c73",
                        "source_sense_description": "religious movement",
                        "target_lang_word": "Réforme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Réforme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fe45b9a-5d09-3b39-bb2b-6b8301953eee",
                                        "entry_id": "91c29483-c0f6-3c4a-92b7-2b855655edcf",
                                        "glosses": [
                                            "Mouvement religieux instauré par Martin Luther au XVIᵉ siècle dans le but de réformer l'Église catholique et ayant finalement pris la forme d'un schisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97549377-27e8-4ee1-9388-58a8f53cfa84",
                                                "sense_id": "6fe45b9a-5d09-3b39-bb2b-6b8301953eee",
                                                "text": "La réforme protestante, souvent appelée simplement la « Réforme », se voulait un retour aux sources du christianisme."
                                            },
                                            {
                                                "example_id": "6263ff8e-439b-4e75-a0a8-87de2dbda746",
                                                "sense_id": "6fe45b9a-5d09-3b39-bb2b-6b8301953eee",
                                                "text": "Si les églises issues de la Réforme luthérienne diffèrent considérablement de l’Église catholique, on n’en assista pas moins à une certaine « recatholisation » par rapport aux objectifs radicaux de 1517-1525, particulièrement sensible dans la pastorale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23eac4cb-d5e6-4cf2-8143-9b05f883f93d",
                        "source_entry_id": "af4918d3-272b-371d-849e-f66355c31edc",
                        "source_sense_id": "16b8ac66-a43f-3f18-8a79-96a2797b5c73",
