        "ru-extract.jsonl": [
            {
                "entry_id": "8152274b-a3af-30cf-a007-45029c5c96a8",
                "word": "НАСА",
                "pos": "abbrev",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a79724ff-5736-347a-a848-832b16acfea5",
                        "entry_id": "8152274b-a3af-30cf-a007-45029c5c96a8",
                        "glosses": [
                            "то же, что Национальное управление США по воздухоплаванию и исследованию космического пространства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "475fecc6-0a6e-449b-b7f0-d61651033b9f",
                                "sense_id": "a79724ff-5736-347a-a848-832b16acfea5",
                                "text": "Сейчас, по оценке НАСА, на околоземной орбите находится около полумиллиона объектов, которые достаточно велики и движутся с очень большой скоростью, а потому могут причинить ущерб и спутникам, и космическим кораблям."
                            },
                            {
                                "example_id": "82b6c968-b6e7-452b-b05e-5008866dbd06",
                                "sense_id": "a79724ff-5736-347a-a848-832b16acfea5",
                                "text": "При этом в НАСА входят 10 научных центров, и они отвечают полностью за научно-техническую политику в области аэрокосмических исследований."
                            },
                            {
                                "example_id": "af373b0a-4976-4570-8ebd-98b795c2afee",
                                "sense_id": "a79724ff-5736-347a-a848-832b16acfea5",
                                "text": "Например, НАСА намеревалось за 400 млн долларов купить у России космическую технику, хотя её стоимость на мировом рынке была в 3-4 раза дороже."
                            },
                            {
                                "example_id": "d8749f31-d209-4885-a72f-9efd84c8ee6f",
                                "sense_id": "a79724ff-5736-347a-a848-832b16acfea5",
                                "text": "Специалисты американского космического агентства НАСА подумывают о посылке таких устройств к спутнику Юпитера ― Европе, чтобы поискать там океаны воды под поверхностью."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "245b6b0c-cb83-49d9-9ad2-530bebd68d37",
                        "source_entry_id": "8152274b-a3af-30cf-a007-45029c5c96a8",
                        "source_sense_id": "a79724ff-5736-347a-a848-832b16acfea5",
                        "target_lang_word": "NASA",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "NASA",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a40feb4-9522-3898-869a-3ecfef4ba5ff",
                                        "entry_id": "4adf3101-54f0-3efd-9bb6-ca02a5317f1f",
                                        "glosses": [
                                            "Acronym of National Aeronautics and Space Administration."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "acronym",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e6b610f-9b7a-4460-b56e-cc0f035ddc4d",
                                                "sense_id": "0a40feb4-9522-3898-869a-3ecfef4ba5ff",
                                                "text": "NASA was often accused of talking over the public's head."
                                            },
                                            {
                                                "example_id": "6d1a656e-5650-44e6-a839-87f625023fca",
                                                "sense_id": "0a40feb4-9522-3898-869a-3ecfef4ba5ff",
                                                "text": "Researchers at NASA have taken an interest in 'mycotecture' and its potential role in growing structures on the Moon."
                                            },
                                            {
                                                "example_id": "b89e801d-04ce-42e2-bbec-597cf2840464",
                                                "sense_id": "0a40feb4-9522-3898-869a-3ecfef4ba5ff",
                                                "text": "A NASA spokesperson said in a statement “employees would be placed on temporary remote work agreements while NASA seeks and evaluates options for a new space for the GISS team.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68aef06d-f4b2-319f-9c74-aa21a892d937",
                                        "entry_id": "4adf3101-54f0-3efd-9bb6-ca02a5317f1f",
                                        "glosses": [
                                            "Acronym of National Auto Sport Association"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "acronym",
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
