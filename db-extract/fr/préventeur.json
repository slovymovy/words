                        "entry_id": "73449d5c-7431-3cd3-80bb-9f4976ec721d",
                        "glosses": [
                            "Celui qui est chargé de la prévention des accidents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52103812-8585-43d0-8733-84737e26dc04",
                                "sense_id": "9d0045cd-eec0-3f92-bef3-1ee2a1ec1e10",
                                "text": "Chaque préventeur peut en effet tâter de ses techniques sans courir le risque de s’opposer à l’Inspection officielle, dont les effectifs sont insuffisants."
                            },
                            {
                                "example_id": "6def10ca-29c1-4e5a-b573-4fe9bb3b2256",
                                "sense_id": "9d0045cd-eec0-3f92-bef3-1ee2a1ec1e10",
                                "text": "C’est pourquoi ma première initiative comme préventeur fut de trouver une solution à ce problème avec les électriciens."
                            },
                            {
                                "example_id": "b74c6939-e41b-4fa3-b376-2a7a506f6dd9",
                                "sense_id": "9d0045cd-eec0-3f92-bef3-1ee2a1ec1e10",
                                "text": "Nous avions une ébauche du guide dès le 20 mars, puis avons travaillé avec des préventeurs, des médecins et autres experts pour le compléter et valider certains principes."
                            }
                        ]
                    }
