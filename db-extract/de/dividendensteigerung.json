                "senses": [
                    {
                        "sense_id": "cb325a1c-5c16-3138-8098-9d40b40d0e3b",
                        "entry_id": "8e9b2535-d616-3a7c-88c8-d1cd9fe69efb",
                        "glosses": [
                            "Heraufsetzung der ausbezahlten Dividende; Erhöhung des Betrags der als Dividende ausgeschüttet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bee276b7-3dc3-4a88-8871-9935a3e7927b",
                                "sense_id": "cb325a1c-5c16-3138-8098-9d40b40d0e3b",
                                "text": "„Mit der 50-prozentigen Dividendensteigerung, über die endgültig die Hauptversammlung am 9. April in Berlin entscheiden muss, habe Konzernchef Jürgen Schrempp signalisieren wollen, dass man die geplanten Zwischenschritt erreicht habe und sich zutraue, auch das schwere Jahr 2003 meistern zu können, war aus dem Konzern zu erfahren.“"
                            },
                            {
                                "example_id": "5a036c25-5f16-418e-8186-7c244616de2c",
                                "sense_id": "cb325a1c-5c16-3138-8098-9d40b40d0e3b",
                                "text": "„Der Wafer-Hersteller schlug nach einem Gewinnsprung eine deutliche Dividendensteigerung vor und will 2022 trotz steigender Kosten profitabler werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
