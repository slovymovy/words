                                        "glosses": [
                                            "A museum featuring lifelike statues made of wax."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7995eeee-15a0-45fc-b87b-83e1c7435f00",
                                                "sense_id": "8465cb53-f37e-3dd3-aa83-4db4c4b3ca72",
                                                "text": "On the eve of selling his London wax museum to American Amos Burns, Claude Dupree is murdered by his Jack the Ripper figure, which apparently comes to life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
