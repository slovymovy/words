                                "example_id": "67d68f72-c36a-4c08-bfc4-4164486d4cb6",
                                "sense_id": "328d9044-a5af-378e-811e-fb3999846e36",
                                "text": "Voortdurend, in de loop van tweeduizend jaar, hebben de christenen - met name heiligen – de geschiedenis vruchtdragend gemaakt met hun beleving van Pasen."
                            }
                        ]
                    }
