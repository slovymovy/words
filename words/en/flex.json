{
    "word_family": [
        "flexible",
        "flexibility",
        "reflex",
        "deflect",
        "inflection",
        "reflection",
        "circumflex",
        "flexor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6cd293a4-b0a5-3fb6-b0db-f3f3bdd56588",
                    "sense_definition": "To bend a body part or tighten a muscle, often to show strength or prepare for movement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bodybuilder <w>flexed</w> his muscles to impress the crowd.",
                            "target_lang_translations": {
                                "ru": "Бодибилдер <w>напряг</w> мышцы, чтобы впечатлить толпу.",
                                "zh": "健美运动员<w>收紧</w>肌肉以吸引观众的注意。"
                            }
                        },
                        {
                            "text": "You should <w>flex</w> your knees slightly when you land to absorb the shock.",
                            "target_lang_translations": {
                                "ru": "При приземлении следует слегка <w>согнуть</w> колени, чтобы смягчить удар.",
                                "zh": "着陆时你应该稍微<w>弯曲</w>膝盖以缓冲冲击力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bend",
                        "contract",
                        "tighten"
                    ],
                    "antonyms": [
                        "straighten",
                        "extend",
                        "relax"
                    ],
                    "common_phrases": [
                        "flex a muscle",
                        "flex your biceps"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сгибать часть тела или напрягать мышцу, часто чтобы показать силу или подготовиться к движению.",
                        "zh": "指弯曲身体部位或收紧肌肉，通常是为了展示力量或为动作做准备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напрягать",
                                "target_lang_sense_clarification": "о мышцах"
                            },
                            {
                                "target_lang_word": "сгибать",
                                "target_lang_sense_clarification": "о суставах"
                            },
                            {
                                "target_lang_word": "играть",
                                "target_lang_sense_clarification": "мускулами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收紧",
                                "target_lang_sense_clarification": "指肌肉"
                            },
                            {
                                "target_lang_word": "弯曲",
                                "target_lang_sense_clarification": "指关节"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9127aaa7-33d6-373a-8ca7-3ec4693e16b0",
                    "sense_definition": "To show off one's status, wealth, or abilities in a boastful manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "boast_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He loves to <w>flex</w> about how much money he makes online.",
                            "target_lang_translations": {
                                "ru": "Он обожает <w>хвастаться</w> тем, сколько денег он зарабатывает в интернете.",
                                "zh": "他很喜欢<w>炫耀</w>自己在网上赚了多少钱。"
                            }
                        },
                        {
                            "text": "She <w>flexed</w> her new designer bag on social media for everyone to see.",
                            "target_lang_translations": {
                                "ru": "Она <w>похвасталась</w> своей новой дизайнерской сумкой в социальных сетях у всех на виду.",
                                "zh": "她在社交媒体上<w>显摆</w>自己的新款名牌包，让所有人都能看到。"
                            }
                        }
                    ],
                    "synonyms": [
                        "show off",
                        "brag",
                        "boast",
                        "flaunt"
                    ],
                    "common_phrases": [
                        "flex on someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in youth culture and internet slang."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрировать свой статус, богатство или способности в хвастливой манере.",
                        "zh": "以炫耀的方式展示自己的地位、财富或能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флексить",
                                "target_lang_sense_clarification": "молодежный сленг"
                            },
                            {
                                "target_lang_word": "хвастаться",
                                "target_lang_sense_clarification": "выставлять напоказ"
                            },
                            {
                                "target_lang_word": "выпендриваться",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炫耀",
                                "target_lang_sense_clarification": "展示财富或能力"
                            },
                            {
                                "target_lang_word": "显摆",
                                "target_lang_sense_clarification": "口语，指爱出风头"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e08c75c0-cee2-36db-a7f9-d65e08d654c4",
                    "sense_definition": "An act of showing off or boasting, often considered impressive or arrogant.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "boast_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Buying that expensive sports car was a huge <w>flex</w>.",
                            "target_lang_translations": {
                                "ru": "Покупка этой дорогой спортивной машины была сплошным <w>выпендрёжем</w>.",
                                "zh": "买那辆昂贵的跑车简直是一种巨大的<w>炫耀</w>。"
                            }
                        },
                        {
                            "text": "It was a strange <w>flex</w>, but he seemed very proud of his collection.",
                            "target_lang_translations": {
                                "ru": "Это был странный <w>понт</w>, но он казался очень гордым своей коллекцией.",
                                "zh": "这是一种奇怪的<w>炫耀</w>，但他似乎对自己的收藏感到非常自豪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "boast",
                        "brag"
                    ],
                    "common_phrases": [
                        "weird flex",
                        "major flex"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in youth culture and internet slang."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт хвастовства или демонстрации превосходства, часто считающийся впечатляющим или высокомерным.",
                        "zh": "一种炫耀或吹嘘的行为，通常被认为令人印象深刻或傲慢。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпендрёж",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "понты",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炫耀",
                                "target_lang_sense_clarification": "名词，指炫耀的行为"
                            },
                            {
                                "target_lang_word": "装腔作势",
                                "target_lang_sense_clarification": "指傲慢的炫耀"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59706f68-bb94-3ff9-99af-7df288596014",
                    "sense_definition": "A flexible insulated electric cable used to connect an appliance to a power source.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "electrical_wire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>flex</w> on the old lamp was frayed and needed to be replaced.",
                            "target_lang_translations": {
                                "ru": "<w>Шнур</w> на старой лампе перетёрся, и его нужно было заменить.",
                                "zh": "旧台灯的<w>电源线</w>磨损了，需要更换。"
                            }
                        },
                        {
                            "text": "Make sure the <w>flex</w> is long enough to reach the socket behind the desk.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>провод</w> достаточно длинный, чтобы дотянуться до розетки за столом.",
                                "zh": "确保<w>电线</w>足够长，能连到桌子后面的插座。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cord",
                        "cable",
                        "wire"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гибкий изолированный электрический кабель для подключения прибора к источнику питания.",
                        "zh": "一种用于将电器连接到电源的柔性绝缘电缆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шнур",
                                "target_lang_sense_clarification": "электрический"
                            },
                            {
                                "target_lang_word": "провод",
                                "target_lang_sense_clarification": "кабель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电线",
                                "target_lang_sense_clarification": "通用电缆"
                            },
                            {
                                "target_lang_word": "电源线",
                                "target_lang_sense_clarification": "连接电器的线"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e1c0bcc-ef3b-3924-92c2-d6d435bf2238",
                    "sense_definition": "The action of bending a joint or tightening a muscle.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a quick <w>flex</w> of his arm, he demonstrated his strength.",
                            "target_lang_translations": {
                                "ru": "Быстрым <w>напряжением</w> руки он продемонстрировал свою силу.",
                                "zh": "他快速地<w>收紧</w>手臂，展示了自己的力量。"
                            }
                        },
                        {
                            "text": "The slight <w>flex</w> in the material allowed it to withstand the pressure.",
                            "target_lang_translations": {
                                "ru": "Легкая <w>податливость</w> материала позволила ему выдержать давление.",
                                "zh": "材料轻微的<w>弯曲</w>使其能够承受压力。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие сгибания сустава или напряжения мышцы.",
                        "zh": "弯曲关节或收紧肌肉的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напряжение",
                                "target_lang_sense_clarification": "мышц"
                            },
                            {
                                "target_lang_word": "сгибание",
                                "target_lang_sense_clarification": "суставов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收紧",
                                "target_lang_sense_clarification": "肌肉的动作"
                            },
                            {
                                "target_lang_word": "弯曲",
                                "target_lang_sense_clarification": "关节的动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}