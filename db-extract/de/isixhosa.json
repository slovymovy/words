                ],
                "senses": [
                    {
                        "sense_id": "1423f560-9fbb-3b72-bd26-8d7f935563e1",
                        "entry_id": "2c6557dc-5b93-337a-8d1f-84480763863e",
                        "glosses": [
                            "dem isiZulu nahverwandte, südliche Bantusprache mit aus den Khoisan-Sprachen entlehnten Schnalzlauten, die in Südafrika (dort Amtssprache), Botswana und Lesotho gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ea7fbf5-a5ed-4d91-aef4-5fa5be1ffbfd",
                                "sense_id": "1423f560-9fbb-3b72-bd26-8d7f935563e1",
                                "text": "Rund 9 Millionen Menschen sprechen isiXhosa."
                            },
                            {
                                "example_id": "f05ee8f5-72bd-4120-ade5-e19f44b1ae53",
                                "sense_id": "1423f560-9fbb-3b72-bd26-8d7f935563e1",
                                "text": "„Die Autoren stellen aber nicht die Frage, weshalb die über die Holdinggesellschaft Johnnic kontrollierte Times-Media-Gruppe in den drei Jahren, da die Besitzer und Mehrheitsaktionäre schwarz sind, keine Zeitung in isiXhosa oder Sesotho gegründet haben.“"
                            },
                            {
                                "example_id": "3acfc1ef-1ae7-42f3-9e8f-2360ff10f001",
                                "sense_id": "1423f560-9fbb-3b72-bd26-8d7f935563e1",
                                "text": "„Auf zwei Fernseh-Kanälen des öffentlich-rechtlichen SABC werden im Halbstundentakt Abendnachrichten abwechselnd in verschiedenen Sprachen gesendet, Afrikaans, isiXhosa, Zulu, und andere Regionalsprachen.“"
                            },
                            {
                                "example_id": "5dfba690-dbec-44b5-b8c6-3f75044e7acf",
                                "sense_id": "1423f560-9fbb-3b72-bd26-8d7f935563e1",
                                "text": "„Es wird auf isiXhosa übersetzt und durch Audio-Menüs auch Analphabeten zugänglich gemacht.“"
                            },
                            {
                                "example_id": "e5f37566-8801-4b08-8e8a-b5e372382c64",
                                "sense_id": "1423f560-9fbb-3b72-bd26-8d7f935563e1",
                                "text": "„isiXhosa hat eine einfache Struktur der Vokale, ist aber reich an ungewöhnlichen Konsonanten.“"
                            },
                            {
                                "example_id": "cd756834-f781-40f6-936d-0567317c5696",
                                "sense_id": "1423f560-9fbb-3b72-bd26-8d7f935563e1",
                                "text": "„1833 wurden erste Teile der Bibel in isiXhosa veröffentlicht, 1846 das gesamte Neue Testament und schließlich 1859 eine vollständige Ausgabe der Bibel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
